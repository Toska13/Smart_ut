#Область Интерфейс

// Формирует уведомления о необходимости перемещения гарантийных запчастей
// при поступлении (или планировании поступления) на склады из настроек обработки.
//
// Параметры:
//  Уведомление - СправочникСсылка.смартУведомления - элемент справочника уведомлений
//  Источник - ДокументСсылка - документ-источник события
//  ДопПараметры - Структура - дополнительные параметры события (не используется)
//
Процедура СформироватьУведомления(Уведомление, Источник = Неопределено, ДопПараметры = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройки = смартУведомления.ПолучитьНастройкиОбработкиВыполнения(Уведомление);
	
	Если Настройки.Склады.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(Источник);
	
	Если ТипИсточника = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		ТаблицаНоменклатуры = ПолучитьНоменклатуруПоПриходномуОрдеру(Источник, Настройки);
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ТаблицаНоменклатуры = ПолучитьНоменклатуруПоЗаказуНаПеремещение(Источник, Настройки);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТаблицаНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АдресаПолучателей = ПолучитьАдресаПолучателей(Настройки, "Получатель");
	АдресаПолучателейКопии = ПолучитьАдресаПолучателей(Настройки, "ВКопии");
	АдресаСкрытые = ПолучитьАдресаПолучателей(Настройки, "ВСкрытойКопии");
	
	Если АдресаПолучателей.Количество() = 0
		И АдресаПолучателейКопии.Количество() = 0
		И АдресаСкрытые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьУведомленияПоТаблицеНоменклатуры(ТаблицаНоменклатуры, Уведомление, АдресаПолучателей, АдресаПолучателейКопии, АдресаСкрытые);
	
КонецПроцедуры

// Возвращает описание настроек уведомления для загрузки в справочник смартУведомления.
//
// Возвращаемое значение:
//  Структура - наименование, идентификатор, вид уведомления, события объектов
//
Функция НастройкиУведомлений() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Наименование", "Уведомление о поступлении на склад гарантийных запчастей");
	Результат.Вставить("Идентификатор", "УведомлениеОПоступленииНаСкладГарантийныхЗапчастей");
	Результат.Вставить("ВидУведомления", Перечисления.смартВидыУведомлений.ПоСобытиям);
	
	События = Справочники.смартУведомления.ПустаяСсылка().СобытияОбъектов.Выгрузить();
	
	НоваяСтрока = События.Добавить();
	НоваяСтрока.Объект = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ПриходныйОрдерНаТовары);
	НоваяСтрока.ВидСобытия = Перечисления.смартВидыСобытийОбъектов.ПроведениеДокумента;
	
	НоваяСтрока = События.Добавить();
	НоваяСтрока.Объект = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Метаданные.Документы.ЗаказНаПеремещение);
	НоваяСтрока.ВидСобытия = Перечисления.смартВидыСобытийОбъектов.ПроведениеДокумента;
	
	Результат.Вставить("СобытияОбъектов", События);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Служебные

Функция СкладВСпискеНастроек(Склад, ТаблицаСкладов)
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ТаблицаСкладов.НайтиСтроки(Новый Структура("Склад", Склад)).Количество() > 0;
	
КонецФункции

Функция НоваяТаблицаНоменклатурыДляУведомления()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЗаказНаПеремещение");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("НомерЗаявкиНаГарантийныйРемонт");
	Результат.Колонки.Добавить("СкладПолучатель");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНоменклатуруПоПриходномуОрдеру(ПриходныйОрдер, Настройки)
	
	Результат = НоваяТаблицаНоменклатурыДляУведомления();
	
	Если Настройки.ДатаНачала > ПриходныйОрдер.Дата Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПриходныйОрдер.Статус <> Перечисления.СтатусыПриходныхОрдеров.Принят Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ СкладВСпискеНастроек(ПриходныйОрдер.Склад, Настройки.Склады) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПриходТовары.Номенклатура КАК Номенклатура,
	|	ПриходТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК ЗаявкаНаГарантийныйРемонт,
	|	ЕСТЬNULL(ЕСТЬNULL(Претензии.АналогОтПоставщика, Претензии.Номенклатура), ПриходТовары.Номенклатура) КАК НоменклатураДляПоиска
	|ПОМЕСТИТЬ ВТПриход
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК Претензии
	|		ПО ПриходТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Претензии.Ссылка
	|			И (ПриходТовары.Номенклатура = Претензии.Номенклатура
	|				ИЛИ ПриходТовары.Номенклатура = Претензии.АналогОтПоставщика)
	|ГДЕ
	|	ПриходТовары.Ссылка = &ПриходныйОрдер
	|	И ПриходТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка <> ЗНАЧЕНИЕ(Документ.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказНаПеремещениеТовары.Ссылка КАК ЗаказНаПеремещение,
	|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
	|	ВТПриход.ЗаявкаНаГарантийныйРемонт.Номер КАК НомерЗаявкиНаГарантийныйРемонт,
	|	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК СкладПолучатель
	|ИЗ
	|	ВТПриход КАК ВТПриход
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|		ПО ВТПриход.ЗаявкаНаГарантийныйРемонт = ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка
	|			И ВТПриход.НоменклатураДляПоиска = ЗаказНаПеремещениеТовары.Номенклатура
	|ГДЕ
	|	ЗаказНаПеремещениеТовары.Ссылка.Проведен
	|	И НЕ ЗаказНаПеремещениеТовары.Ссылка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ПриходныйОрдер", ПриходныйОрдер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНоменклатуруПоЗаказуНаПеремещение(ЗаказНаПеремещение, Настройки)
	
	Результат = НоваяТаблицаНоменклатурыДляУведомления();
	
	Если Настройки.ДатаНачала > ЗаказНаПеремещение.Дата Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ ЗаказНаПеремещение.смартЗапчастиГарантийные Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ СкладВСпискеНастроек(ЗаказНаПеремещение.СкладПолучатель, Настройки.Склады) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказНаПеремещениеТовары.Ссылка КАК ЗаказНаПеремещение,
	|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
	|	ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка.Номер КАК НомерЗаявкиНаГарантийныйРемонт,
	|	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК СкладПолучатель
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|ГДЕ
	|	ЗаказНаПеремещениеТовары.Ссылка = &ЗаказНаПеремещение
	|	И НЕ ЗаказНаПеремещениеТовары.Отменено
	|	И ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка <> ЗНАЧЕНИЕ(Документ.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка)";
	
	Запрос.УстановитьПараметр("ЗаказНаПеремещение", ЗаказНаПеремещение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьУведомленияПоТаблицеНоменклатуры(ТаблицаНоменклатуры, Уведомление, АдресаПолучателей, АдресаПолучателейКопии, АдресаСкрытые)
	
	ВидСобытияУведомления = "УведомлениеОПоступленииНаСкладГарантийныхЗапчастей";
	
	ТаблицаНоменклатуры.Свернуть("ЗаказНаПеремещение, Номенклатура, НомерЗаявкиНаГарантийныйРемонт, СкладПолучатель");
	
	ТаблицаЗаказов = ТаблицаНоменклатуры.Скопировать(, "ЗаказНаПеремещение, СкладПолучатель");
	ТаблицаЗаказов.Свернуть("ЗаказНаПеремещение, СкладПолучатель");
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказов Цикл
		
		ЗаказНаПеремещение = СтрокаЗаказа.ЗаказНаПеремещение;
		Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
			Продолжить;
		КонецЕсли;
		
		СуществующееУведомление = смартУведомления.ПолучитьИнформациюОПоследнемУведомлении(ЗаказНаПеремещение, ВидСобытияУведомления);
		Если ЗначениеЗаполнено(СуществующееУведомление.Объект) Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("ЗаказНаПеремещение", ЗаказНаПеремещение);
		СтрокиЗапчастей = ТаблицаНоменклатуры.НайтиСтроки(Отбор);
		Если СтрокиЗапчастей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СкладПолучатель = СтрокаЗаказа.СкладПолучатель;
		Тема = СтрШаблон("Заказ на перемещение запчастей на склад %1 №%2", СкладПолучатель, ЗаказНаПеремещение.Номер);
		Тело = СформироватьТелоУведомления(ЗаказНаПеремещение, СтрокиЗапчастей, СкладПолучатель);
		
		смартУведомления.ОтправитьПочтовоеУведомление(
			ЗаказНаПеремещение,
			ВидСобытияУведомления,
			Тема,
			Тело,
			АдресаПолучателей,
			АдресаПолучателейКопии,
			АдресаСкрытые,,
			ТипТекстаПочтовогоСообщения.HTML,,
			Уведомление,
			Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьАдресаПолучателей(Настройки, ИмяКолонки)
	
	Получатели = Настройки.ПолучателиУведомлений.Скопировать(Новый Структура(ИмяКолонки, Истина)).ВыгрузитьКолонку("Пользователь");
	Возврат смартОбщегоНазначения.ПолучитьАдресаПользователей(Получатели);
	
КонецФункции

Функция СформироватьТелоУведомления(ЗаказНаПеремещение, СтрокиЗапчастей, СкладПолучатель)
	
	ЗапчастиHTML = "";
	Для Каждого Строка Из СтрокиЗапчастей Цикл
		ЗапчастиHTML = ЗапчастиHTML
			+ ?(ЗначениеЗаполнено(ЗапчастиHTML), "<br>", "")
			+ Строка(Строка.Номенклатура) + " - " + Строка(Строка.НомерЗаявкиНаГарантийныйРемонт);
	КонецЦикла;
	
	НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ЗаказНаПеремещение);
	
	Тело = СтрШаблон(
		"<html><body>
		|<p>Уведомление.</p>
		|<p>По заказу на перемещение №%1 следует переместить на склад %2 следующие запчасти:</p>
		|<p>%3</p>
		|<p>ссылка в 1с <a href=""%4"">%4</a></p>
		|<p><font size=""2"">Письмо создано роботом и не требует ответа.</font></p>
		|</body></html>",
		ЗаказНаПеремещение.Номер,
		СкладПолучатель,
		ЗапчастиHTML,
		НавигационнаяСсылка);
	
	Возврат Тело;
	
КонецФункции

#КонецОбласти
