#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АдресНастроек") Тогда
		
		АдресНастроек = Параметры.АдресНастроек;
		
		Если ЭтоАдресВременногоХранилища(АдресНастроек) Тогда
			
			Настройки = ПолучитьИзВременногоХранилища(АдресНастроек);
			
			Попытка
				Склады.Загрузить(Настройки.Склады);
				ПолучателиУведомлений.Загрузить(Настройки.ПолучателиУведомлений);
				ДатаНачала = Настройки.ДатаНачала;
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.Свойство("ИдентификаторВладельца") Тогда
		ИдентификаторВладельца = Параметры.ИдентификаторВладельца;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	Результат = Новый Структура("АдресНастроек", СохранитьНастройкиВоВременноеХранилище());
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция СохранитьНастройкиВоВременноеХранилище()
	
	Настройки = Новый Структура;
	
	Настройки.Вставить("Склады", Склады.Выгрузить());
	Настройки.Вставить("ПолучателиУведомлений", ПолучателиУведомлений.Выгрузить());
	Настройки.Вставить("ДатаНачала", ДатаНачала);

	Возврат ПоместитьВоВременноеХранилище(Настройки, ИдентификаторВладельца);
	
КонецФункции

#КонецОбласти
