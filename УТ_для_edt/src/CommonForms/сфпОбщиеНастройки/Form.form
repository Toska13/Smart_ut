          <id>228</id>
          <items xsi:type="form:Decoration">
            <name>сфпДекорацияПерезаполнитьРегистрПоискаПоНомерам</name>
            <id>23</id>
            <title>
              <key>ru</key>
              <value>Перезаполнить регистр поиска по номерам</value>
            </title>
            <title>
              <key>en</key>
              <value>to fill in again register of search in numbers</value>
            </title>
            <visible>true</visible>
            <enabled>true</enabled>
            <userVisible>
              <common>true</common>
            </userVisible>
            <toolTip>
              <key>ru</key>
              <value>Перезаполняет регистр, в котором сопоставляются номера телефонов и абонентов.
Данный регистр используется для поиска абонента по номеру его телефона при входящем звонке.</value>
            </toolTip>
            <toolTip>
              <key>en</key>
              <value>Refills register which compares phone numbers and subscribers.
This register in used to search subscriber by phone number at incoming call.</value>
            </toolTip>
            <toolTipRepresentation>Button</toolTipRepresentation>
            <extendedTooltip>
              <name>сфпДекорацияПерезаполнитьРегистрПоискаПоНомерамExtendedTooltip</name>
