&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("МассивСтруктур") Тогда
		
		МассивСтруктур = Параметры.МассивСтруктур;
		
		Для Каждого ТекущаяСтрока Из МассивСтруктур Цикл
			
			НоваяСтрока = НомераЗаявок.Добавить();
			НоваяСтрока.ИДСтроки = Новый УникальныйИдентификатор;
			НоваяСтрока.НомерСтроки 	= ТекущаяСтрока.НомерСтроки;						
			НоваяСтрока.Номенклатура 	= ТекущаяСтрока.Номенклатура;
			// ++ 11.04.2021
			НоваяСтрока.КоличествоВДокументе = ТекущаяСтрока.Количество;

			Для Каждого ЭлементСоответствия Из ТекущаяСтрока.ТаблицаНомеров Цикл
				СтрокаОстаток = НоваяСтрока.ТаблицаНомеров.Добавить(); // Соответствие тут: НомерЗаявки - КоличествоОстаток
				СтрокаОстаток.НомерЗаявки = ЭлементСоответствия.Ключ;
				СтрокаОстаток.КоличествоОстаток = ЭлементСоответствия.Значение;
			КонецЦикла;
			// --
			НоваяСтрока.НомерЗаявки 	= ТекущаяСтрока.НомерЗаявки;
			//++ #Б1132 смарт: Шляпников 06.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			НоваяСтрока.Заявка 	= ТекущаяСтрока.Заявка;
			//-- #Б1132 смарт: Шляпников 06.11.2024
			
			СписокНомеров = ТекущаяСтрока.СписокНомеров;
			
			Если ТипЗнч(СписокНомеров) = Тип("СписокЗначений") Тогда
				
				НоваяСтрока.СписокВыбора = СписокНомеров;

				Если СписокНомеров.Количество() > 1 Тогда
					НоваяСтрока.СписокВыбораЗаполнен = Истина;
				КонецЕсли;
				
			КонецЕсли;		
		КонецЦикла;	
		
		НомераЗаявок.Сортировать("НомерСтроки");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокументИЗакрыть();
	
КонецПроцедуры

// ++ 18.03.2021
&НаКлиенте
Процедура ПеренестиВДокументИЗакрыть()
	
	МассивСтруктур = Новый Массив;
	
	Для Каждого Стр Из НомераЗаявок Цикл
		
		ТекущаяСтрока = Новый Структура;
		ТекущаяСтрока.Вставить("НомерСтроки", 	Стр.НомерСтроки);
		ТекущаяСтрока.Вставить("Номенклатура", 	Стр.Номенклатура);
		ТекущаяСтрока.Вставить("НомерЗаявки", 	Стр.НомерЗаявки);
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		ТекущаяСтрока.Вставить("Заявка", 	Стр.Заявка);
		//-- #Б1132 смарт: Шляпников 14.10.2024
		
		// ++ 11.04.2021
		ТекущаяСтрока.Вставить("КоличествоВДокументе", Стр.КоличествоВДокументе);
		// --
		
		МассивСтруктур.Добавить(ТекущаяСтрока);
		
	КонецЦикла;
	
	МожноЗакрыть = Истина;
	
	Закрыть(МассивСтруктур);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлемента(ВыбранныйЭлемент, СписокПараметров) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
        ОбщегоНазначенияКлиент.СообщитьПользователю("Номер заявки не выбран");
    Иначе
        ВыбранноеЗначение = ВыбранныйЭлемент.Значение;
		
		ТекущиеДанные = Элементы.НомераЗаявок.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			
			//++ #Б1132 смарт: Шляпников 06.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			ТекущиеДанные.НомерЗаявки = ВыбранныйЭлемент.Представление;
			ТекущиеДанные.Заявка = ВыбранноеЗначение;
			//-- #Б1132 смарт: Шляпников 14.10.2024
			
			// ++ 11.04.2021
			// Если по выбранной заявке количество меньше, чем требуется в документе, 
			// то строка разбивается на 2: по имеющемуся остатку и бесхозный хвостик
			Отбор = Новый Структура;
			Отбор.Вставить("НомерЗаявки", ВыбранноеЗначение);
			НайденныеСтроки = ТекущиеДанные.ТаблицаНомеров.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				КоличествоОстаток = НайденныеСтроки[0].КоличествоОстаток;
				
				Если КоличествоОстаток <> Неопределено 
					И КоличествоОстаток < ТекущиеДанные.КоличествоВДокументе Тогда
					Хвостик = ТекущиеДанные.КоличествоВДокументе -  КоличествоОстаток;
					ТекущиеДанные.КоличествоВДокументе = КоличествоОстаток;
					
					// Новая строка							
					ДобавитьСтроку(Хвостик, ТекущиеДанные.ИДСтроки);
					
				КонецЕсли;	
			КонецЕсли;
			// --
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// ++ 12.04.2021
&НаСервере
Процедура ДобавитьСтроку(Хвостик, ИДСтроки)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИДСтроки", ИДСтроки);
	НайденныеСтроки = НомераЗаявок.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ТекущаяСтрока = НайденныеСтроки[0];
		НоваяСтрока = НомераЗаявок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "ТаблицаНомеров");
		НоваяСтрока.ИДСтроки = Новый УникальныйИдентификатор;
		НоваяСтрока.ТаблицаНомеров.Загрузить(ТекущаяСтрока.ТаблицаНомеров.Выгрузить());
		
		Сч = НоваяСтрока.ТаблицаНомеров.Количество() - 1;
		
		Пока Сч >= 0 Цикл
			ТекСтрокаНомерЗаявки = НоваяСтрока.ТаблицаНомеров[Сч];
			
			//++ #Б1132 смарт: Шляпников 06.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Если ТекСтрокаНомерЗаявки.НомерЗаявки = ТекущаяСтрока.НомерЗаявки Тогда
			//	НоваяСтрока.ТаблицаНомеров.Удалить(ТекСтрокаНомерЗаявки);
			//	НоваяСтрока.СписокВыбора.Удалить(НоваяСтрока.СписокВыбора.НайтиПоЗначению(ТекущаяСтрока.НомерЗаявки));
			//КонецЕсли;
			Если ТекСтрокаНомерЗаявки.НомерЗаявки = ТекущаяСтрока.Заявка Тогда
				НоваяСтрока.ТаблицаНомеров.Удалить(ТекСтрокаНомерЗаявки);
				НоваяСтрока.СписокВыбора.Удалить(НоваяСтрока.СписокВыбора.НайтиПоЗначению(ТекущаяСтрока.Заявка));
			КонецЕсли;
			//-- #Б1132 смарт: Шляпников 06.11.2024
			
			Сч = Сч - 1;
		КонецЦикла;
		
		НоваяСтрока.КоличествоВДокументе = Хвостик;
		НоваяСтрока.НомерЗаявки = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомераЗаявокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "НомераЗаявокНомерЗаявки" Тогда
		
		ТекущиеДанные = Элементы.НомераЗаявок.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			Если ТекущиеДанные.СписокВыбора.Количество() = 0 Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("Нет доступных остатков по выбранной номенклатуре");
			Иначе
				Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтотОбъект);
				ТекущиеДанные.СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите номер заявки");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// ++ 18.03.2021
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если МожноЗакрыть <> Истина Тогда
		СтандартнаяОбработка = Ложь;
		ПеренестиВДокументИЗакрыть();
	КонецЕсли;
	
КонецПроцедуры

