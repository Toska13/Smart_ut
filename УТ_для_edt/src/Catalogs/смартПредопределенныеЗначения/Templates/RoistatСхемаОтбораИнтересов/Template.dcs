<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>ОсновнойНаборДанных</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Автор</dataPath>
			<field>Автор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ответственный</dataPath>
			<field>Ответственный</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОснование</dataPath>
			<field>ДокументОснование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПометкаУдаления</dataPath>
			<field>ПометкаУдаления</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Завершен</dataPath>
			<field>Завершен</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПричинаОтказа</dataPath>
			<field>ПричинаОтказа</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партнер</dataPath>
			<field>Партнер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СостояниеИнтереса</dataPath>
			<field>СостояниеИнтереса</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Состояние интереса</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Тема</dataPath>
			<field>Тема</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипУслуги</dataPath>
			<field>ТипУслуги</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип услуги</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипОбращения</dataPath>
			<field>ТипОбращения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Договор</dataPath>
			<field>Договор</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>смартПредварительнаяКвалификация</dataPath>
			<field>смартПредварительнаяКвалификация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Предварительная квалификация</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>смартИтоговаяКвалификация</dataPath>
			<field>смартИтоговаяКвалификация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Итоговая квалификация</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>смартИнтересКанал</dataPath>
			<field>смартИнтересКанал</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Канал (Интерес)</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>смартИнтересИсточник</dataPath>
			<field>смартИнтересИсточник</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Источник (Интерес)</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусRoistat</dataPath>
			<field>СтатусRoistat</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус roistat</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сценарий</dataPath>
			<field>Сценарий</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сценарий</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Интерес.Ссылка КАК Ссылка,
	Интерес.ПометкаУдаления КАК ПометкаУдаления,
	Интерес.ДокументОснование КАК ДокументОснование,
	Интерес.Завершен КАК Завершен,
	Интерес.Автор КАК Автор,
	Интерес.Организация КАК Организация,
	Интерес.Ответственный КАК Ответственный,
	Интерес.Партнер КАК Партнер,
	Интерес.ПричинаОтказа КАК ПричинаОтказа,
	Интерес.Тема КАК Тема,
	Интерес.ТипУслуги КАК ТипУслуги,
	Интерес.ТипОбращения КАК ТипОбращения,
	Интерес.Склад КАК Склад,
	Интерес.Контрагент КАК Контрагент,
	Интерес.Договор КАК Договор,
	Интерес.смартПредварительнаяКвалификация КАК смартПредварительнаяКвалификация,
	Интерес.смартИтоговаяКвалификация КАК смартИтоговаяКвалификация,
	Интерес.смартИнтересКанал КАК смартИнтересКанал,
	Интерес.смартИнтересИсточник КАК смартИнтересИсточник,
	ЕСТЬNULL(CRM_ИсторияСостоянийОбращенийСрезПоследних.смартСтатусRoistat, ЗНАЧЕНИЕ(Справочник.смартСтатусыRoistat.ПустаяСсылка)) КАК СтатусRoistat,
	ЕСТЬNULL(CRM_ИсторияСостоянийОбращенийСрезПоследних.Состояние, ЗНАЧЕНИЕ(Справочник.CRM_СостоянияИнтересов.ПустаяСсылка)) КАК СостояниеИнтереса,
	CRM_ИсторияСостоянийОбращенийСрезПоследних.Состояние.Родитель КАК Сценарий
{ВЫБРАТЬ
	Ссылка.*,
	ПометкаУдаления,
	ДокументОснование.*,
	Завершен,
	Автор.*,
	Организация.*,
	Ответственный.*,
	Партнер.*,
	ПричинаОтказа.*,
	Тема,
	ТипУслуги.*,
	ТипОбращения.*,
	Склад.*,
	Контрагент.*,
	Договор.*,
	смартПредварительнаяКвалификация.*,
	смартИтоговаяКвалификация.*,
	смартИнтересКанал.*,
	смартИнтересИсточник.*,
	СтатусRoistat.*,
	СостояниеИнтереса.*,
	Сценарий.*}
ИЗ
	Документ.CRM_Интерес КАК Интерес
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ИсторияСостоянийОбращений.СрезПоследних(, Обращение = &amp;ИнтересСсылка) КАК CRM_ИсторияСостоянийОбращенийСрезПоследних
		ПО (CRM_ИсторияСостоянийОбращенийСрезПоследних.Обращение = Интерес.Ссылка)
ГДЕ
	Интерес.Ссылка = &amp;ИнтересСсылка
{ГДЕ
	Интерес.Ссылка.*,
	Интерес.ПометкаУдаления,
	Интерес.ДокументОснование.*,
	Интерес.Завершен,
	Интерес.Автор.*,
	Интерес.Организация.*,
	Интерес.Ответственный.*,
	Интерес.Партнер.*,
	Интерес.ПричинаОтказа.*,
	Интерес.Тема,
	Интерес.ТипУслуги.*,
	Интерес.ТипОбращения.*,
	Интерес.Склад.*,
	Интерес.Контрагент.*,
	Интерес.Договор.*,
	Интерес.смартПредварительнаяКвалификация.*,
	Интерес.смартИтоговаяКвалификация.*,
	Интерес.смартИнтересКанал.*,
	Интерес.смартИнтересИсточник.*,
	(ЕСТЬNULL(CRM_ИсторияСостоянийОбращенийСрезПоследних.смартСтатусRoistat, ЗНАЧЕНИЕ(Справочник.смартСтатусыRoistat.ПустаяСсылка))).* КАК СтатусRoistat,
	CRM_ИсторияСостоянийОбращенийСрезПоследних.Состояние.Родитель.* КАК Сценарий}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
		<name>ИнтересСсылка</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Интерес ссылка</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:DocumentRef.CRM_Интерес</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Ссылка</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>ИнтересСсылка</dcscor:parameter>
					<dcscor:value xsi:nil="true"/>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>