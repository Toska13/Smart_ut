#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Схема = Справочники.смартПравилаДанныхКонструктора.ПолучитьМакет("УсловияКонструкторОборудования");
	НастройкиКомпоновки = Неопределено;
	
	Если НЕ Параметры.Ключ.Пустая() Тогда
		
		ОбъектИзБазы = РеквизитФормыВЗначение("Объект");
	
		СохраненныеНастройки = ОбъектИзБазы.Отбор.Получить();
		Если НЕ СохраненныеНастройки = Неопределено Тогда
			НастройкиКомпоновки = СохраненныеНастройки;
		КонецЕсли;
		
	Иначе
		Объект.Использовать = Истина;
	КонецЕсли;
	
	Если НастройкиКомпоновки = Неопределено Тогда
		НастройкиКомпоновки = Схема.НастройкиПоУмолчанию;
	КонецЕсли;
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(Схема, УникальныйИдентификатор));
	КомпоновщикНастроекУсловий.Инициализировать(ИсточникНастроек);
		
	КомпоновщикНастроекУсловий.ЗагрузитьНастройки(НастройкиКомпоновки);
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Отбор = Новый ХранилищеЗначения(КомпоновщикНастроекУсловий.Настройки, Новый СжатиеДанных(9));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ИспользоватьПриИзменении(Элемент)
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура НазначениеДанныхПриИзменении(Элемент)
	
	ПроверитьНомерПоПорядку();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОборудованияПриИзменении(Элемент)
	
	ПроверитьНомерПоПорядку();
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Процедура УстановитьВидимостьДоступность()
	
	Элементы.ГруппаШапка.ТолькоПросмотр = НЕ Объект.Использовать;
	Элементы.ГруппаУсловияПрименения.ТолькоПросмотр = НЕ Объект.Использовать;
	
КонецПроцедуры

Процедура ПроверитьНомерПоПорядку()
	
	Если Объект.НомерПоПорядку <> 0 Тогда
		Если Объект.НазначениеДанных <> объект.Ссылка.НазначениеДанных
			ИЛИ Объект.ВидОборудования <> объект.Ссылка.ВидОборудования Тогда
			
			Объект.НомерПоПорядку = 0;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти