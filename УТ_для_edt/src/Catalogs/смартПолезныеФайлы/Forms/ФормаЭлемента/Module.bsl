
&НаКлиенте
Процедура Добавить(Команда)
	
	ДобавитьФайл();	
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайл()
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);

КонецПроцедуры 

&НаКлиенте
Процедура ОбработатьВыборФайла(Результат, АдресВременногоХранилища, ВыбранноеИмя, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ПеренестиФайлВОбъект(АдресВременногоХранилища, ВыбранноеИмя);
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиФайлВОбъект(АдресВременногоХранилища, ПолныйПутьКФайлу)
	
	ОбъектФормы = РеквизитФормыВЗначение("Объект");
	
	ПозицияСлеша = СтрНайти(ПолныйПутьКФайлу, "\", НаправлениеПоиска.СКонца);
	
	Если ПозицияСлеша > 0 Тогда
		ИмяСРасширением = Сред(ПолныйПутьКФайлу, ПозицияСлеша + 1);
	Иначе
		ИмяСРасширением = ПолныйПутьКФайлу;
	КонецЕсли;
	
	ПозицияТочки = СтрНайти(ИмяСРасширением, ".", НаправлениеПоиска.СКонца);
	
	Если ПозицияТочки > 0 Тогда
		Расширение = НРег(Прав(ИмяСРасширением, СтрДлина(ИмяСРасширением) - ПозицияТочки));
		ИмяБезРасширения = Лев(ИмяСРасширением, ПозицияТочки - 1);
	Иначе
		Расширение = "";
		ИмяБезРасширения = ИмяСРасширением;
	КонецЕсли;
	
	Расширение = НРег(Расширение);

	ОбъектФормы.Наименование = ИмяБезРасширения;
	ОбъектФормы.Расширение = Расширение;
	ОбъектФормы.ИндексКартинки = РаботаСФайламиСлужебныйКлиентСервер.ПолучитьИндексПиктограммыФайла(Расширение);
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	ОбъектФормы.ФайлХранилище = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
	
	ОбъектФормы.Записать();
	
	ЗначениеВРеквизитФормы(ОбъектФормы, "Объект");
	
	УдалитьИзВременногоХранилища(АдресВременногоХранилища);
	
	Сообщить("Файл '" + ИмяБезРасширения + "' успешно загружен!");
	
КонецПроцедуры




