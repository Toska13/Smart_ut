Функция ПолучитьМассивПоляПоиска() Экспорт	
	
	Возврат смартДеловыеЛинии.МассивДвухЭлементов("code", "КодКЛАДР");
	
КонецФункции    

Функция ПолучитьСтруктуруПолейЗначений() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("name", "Наименование");	 
	Результат.Вставить("cityID", "ИДгорода");	 
		
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТаблицуПолейЗначений() Экспорт
	
	Результат = смартДеловыеЛинии.НоваяТаблицаПолейЗначений();
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "name", "Наименование", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "cityID", "ИДгорода", "Реквизит");	
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "terminals", "terminal", "Справочник", "ДЛ_Терминалы");	 
		
	Возврат Результат;
	
КонецФункции