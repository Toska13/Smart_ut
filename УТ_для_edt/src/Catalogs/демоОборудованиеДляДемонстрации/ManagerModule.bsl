//++ #Б-1650 смарт: Фролов 18.12.2024 //Доработка функционала Маркетингового мероприятия. Доработки.	
Функция смартПечатьРезервОборудования(ТабДок, ОбъектСсылка) Экспорт

    Макет = Документы.МаркетинговыеМероприятияДокумент.ПолучитьМакет("смартРезервОборудования");
	
	//++ #Б-1988 смарт: Лопато 20.02.2025 //Заявка на маркетинговое мероприятие. Резерв оборудования. Дополнение. Этап 4.  
	ТекущаяДата = ТекущаяДатаСеанса();

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ссылка.Дата КАК ДатаСобытия,
	|	Ссылка КАК Документ,
	|	Ссылка.ТипМероприятия КАК ТипМероприятия,
	|	Ссылка.ВремяНачалаПлан КАК ВремяНачалаПлан,
	|	Оборудование КАК Оборудование,
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.смартДатаНачала
	|		КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.ДатаНачалаПлан
	|		ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.смартДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.смартДатаОкончания
	|		КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА КОНЕЦПЕРИОДА(Ссылка.ДатаНачалаПлан, ДЕНЬ)
	|		ИНАЧЕ КОНЕЦПЕРИОДА(Ссылка.ЖелаемаяДатаИзготовления, ДЕНЬ)
	|	КОНЕЦ КАК ДатаОкончания
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации
	|ГДЕ
	|	Оборудование В(&Оборудование)
	|	И Ссылка.Проведен
	|	И Ссылка.ТипМероприятия.смартРезервироватьОборудование
	|	И (Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Новая)
	|	   ИЛИ Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.ПринятаВРаботу))	
	|	И (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	   КОНЕЦ >= &ДатаНачала
	|    ИЛИ
	|	   (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	    КОНЕЦ < &ДатаНачала
	|      И
	|	    ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА Ссылка.смартДатаОкончания
	|		   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА КОНЕЦПЕРИОДА(Ссылка.ДатаНачалаПлан, ДЕНЬ)
	|		   ИНАЧЕ КОНЕЦПЕРИОДА(Ссылка.ЖелаемаяДатаИзготовления, ДЕНЬ)
	|	    КОНЕЦ > &ДатаНачала))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания,
	|	ДатаСобытия,
	|	ТипМероприятия
	|АВТОУПОРЯДОЧИВАНИЕ");

	Запрос.УстановитьПараметр("ДатаНачала",   НачалоДня(ТекущаяДата));	
	Запрос.УстановитьПараметр("Оборудование", ОбъектСсылка);
	//-- #Б-1988 смарт: Лопато 20.02.2025
	
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

	ТабДок.Очистить();
	
	//++ #Б-1990 смарт: Лопато 19.02.2025 //Заявка на маркетинговое мероприятие. Активные заявки. Этап 5.
	ОбластьШапка.Параметры.ДатаФормирования = ТекущаяДата;
	//-- #Б-1990 смарт: Лопато 19.02.2025
	ТабДок.Вывести(ОбластьШапка);
	
	НомПП = 1;
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		//++ #Б-1990 смарт: Лопато 19.02.2025 //Заявка на маркетинговое мероприятие. Активные заявки. Этап 5.
		ОбластьСтрока.Параметры.ВремяНачала = Формат(Выборка.ДатаНачала, "ДЛФ=В");
		ОбластьСтрока.Параметры.ВремяОкочания = Формат(Выборка.ДатаОкончания, "ДЛФ=В");
        //-- #Б-1990 смарт: Лопато 19.02.2025
		ОбластьСтрока.Параметры.НомПП = НомПП;
		ТабДок.Вывести(ОбластьСтрока);
		
		НомПП = НомПП + 1;
		
	КонецЦикла;	
	
	ТабДок.ТолькоПросмотр = Истина;
	
	Возврат ТабДок;
	
КонецФункции //-- #Б-1650 смарт: Фролов 18.12.2024

//++ #Б-1990 смарт: Лопато 19.02.2025 //Заявка на маркетинговое мероприятие. Активные заявки. Этап 5.
Функция ПечатьАктивныеМероприятия(ТабДок, ОбъектСсылка) Экспорт
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
    Макет = ПолучитьМакет("АктивныеМероприятия");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ссылка КАК Документ,
	|	Ссылка.Дата КАК ДатаСобытия,
	|	Ссылка.ТипМероприятия КАК ТипМероприятия,
	|	Ссылка.ВремяНачалаПлан КАК ВремяНачалаПлан,
	|	Оборудование КАК Оборудование,
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.смартДатаНачала
	|		КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.ДатаНачалаПлан
	|		ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	КОНЕЦ КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.смартДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА Ссылка.смартДатаОкончания
	|		КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА КОНЕЦПЕРИОДА(Ссылка.ДатаНачалаПлан, ДЕНЬ)
	|		ИНАЧЕ КОНЕЦПЕРИОДА(Ссылка.ЖелаемаяДатаИзготовления, ДЕНЬ)
	|	КОНЕЦ КАК ДатаОкончания
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации
	|ГДЕ
	|	Оборудование = &Оборудование
	|	И Ссылка.Проведен
	|	И (Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Новая)
	|	   ИЛИ Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.ПринятаВРаботу))	
	|	И (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	   КОНЕЦ >= &ДатаНачала
	|    ИЛИ
	|	   (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	    КОНЕЦ < &ДатаНачала
	|      И
	|	    ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА Ссылка.смартДатаОкончания
	|		   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА КОНЕЦПЕРИОДА(Ссылка.ДатаНачалаПлан, ДЕНЬ)
	|		   ИНАЧЕ КОНЕЦПЕРИОДА(Ссылка.ЖелаемаяДатаИзготовления, ДЕНЬ)
	|	    КОНЕЦ > &ДатаНачала))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания,
	|	ДатаСобытия,
	|	ТипМероприятия
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДатаНачала",   НачалоДня(ТекущаяДата));	
	Запрос.УстановитьПараметр("Оборудование", ОбъектСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

	ТабДок.Очистить();
	
	ОбластьШапка.Параметры.ДатаФормирования = ТекущаяДата;
	
	ТабДок.Вывести(ОбластьШапка);
	
	НомПП = 1;
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.Заполнить(Выборка);

		ОбластьСтрока.Параметры.НомПП = НомПП;
		
		ОбластьСтрока.Параметры.ВремяНачала = Формат(Выборка.ДатаНачала, "ДЛФ=В");
		ОбластьСтрока.Параметры.ВремяОкочания = Формат(Выборка.ДатаОкончания, "ДЛФ=В");
			
		ТабДок.Вывести(ОбластьСтрока);
		
		НомПП = НомПП + 1;
		
	КонецЦикла;	
	
	ТабДок.ТолькоПросмотр = Истина;
	
	Возврат ТабДок;
	
КонецФункции //-- #Б-1990 смарт: Лопато 19.02.2025

