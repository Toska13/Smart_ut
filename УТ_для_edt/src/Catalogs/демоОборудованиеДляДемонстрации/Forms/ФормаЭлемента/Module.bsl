#Область ДействияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.ДатаЗапуска 				= ТекущаяДата();
		Объект.Пользователь 			= Пользователи.ТекущийПользователь();
		Объект.ГотовностьКДемонстрации 	= Перечисления.демоСтатусГотовностиОборудования.НеГотов;
	КонецЕсли;	
	
	УстановитьДоступностьЭлементовНаСервере();
	
	//++ #Б-1990 смарт: Лопато 19.02.2025 //Заявка на маркетинговое мероприятие. Активные заявки. Этап 5.
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды		

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//-- #Б-1990 смарт: Лопато 19.02.2025
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ОбновитьНаименование();
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();

	//++ #Б-1990 смарт: Лопато 19.02.2025 //Заявка на маркетинговое мероприятие. Активные заявки. Этап 5.
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	//-- #Б-1990 смарт: Лопато 19.02.2025
	
КонецПроцедуры

//++ #Б-1986 смарт: Лопато 18.02.2025 //Заявка на маркетинговое мероприятие. Оборудование демозала. Этап 3.  
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//++ #Б-1986 смарт: Лопато 18.02.2025 //Заявка на маркетинговое мероприятие. Оборудование демозала. Этап 3.  
	Если НЕ ТекущийОбъект.Ссылка.Пустая()
		 И ТекущийОбъект.ГотовностьКДемонстрации <> ТекущийОбъект.Ссылка.ГотовностьКДемонстрации Тогда
		
		ПроверитьЕстьАктивныеЗаявки(ТекущийОбъект.Ссылка, ТекущаяДатаСеанса(), Отказ);
		
	КонецЕсли;	
	//-- #Б-1986 смарт: Лопато 18.02.2025
	
КонецПроцедуры

