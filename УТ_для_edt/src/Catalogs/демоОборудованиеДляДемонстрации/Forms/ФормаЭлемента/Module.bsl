//++ #Б-1986 смарт: Лопато 18.02.2025 //Заявка на маркетинговое мероприятие. Оборудование демозала. Этап 3.  
Процедура ПроверитьЕстьАктивныеЗаявки(Оборудование, Дата, Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации
	|ГДЕ
	|	Оборудование = &Оборудование
	|	И Ссылка.Проведен
	|	И (Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Новая)
	|	   ИЛИ Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.ПринятаВРаботу))	
	|	И (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	   КОНЕЦ >= &ДатаНачала
	|    ИЛИ
	|	   (ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.смартДатаНачала
	|	   	   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|		   		ТОГДА Ссылка.ДатаНачалаПлан
	|	   	   ИНАЧЕ Ссылка.ЖелаемаяДатаИзготовления
	|	    КОНЕЦ < &ДатаНачала
	|      И
	|	    ВЫБОР
	|		   КОГДА НЕ Ссылка.смартДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА Ссылка.смартДатаОкончания
	|		   КОГДА НЕ Ссылка.ДатаНачалаПлан = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА КОНЕЦПЕРИОДА(Ссылка.ДатаНачалаПлан, ДЕНЬ)
	|		   ИНАЧЕ КОНЕЦПЕРИОДА(Ссылка.ЖелаемаяДатаИзготовления, ДЕНЬ)
	|	    КОНЕЦ > &ДатаНачала))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	Запрос.УстановитьПараметр("ДатаНачала",   НачалоДня(Дата));
	
	МассивАктивныхЗаявок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если МассивАктивныхЗаявок.Количество() > 0 Тогда

		СтрокаСообщенияЗаявки = "Необходимо закрыть следующие документы:" + Символы.ПС;
		ОбщегоНазначения.СообщитьПользователю(СтрокаСообщенияЗаявки, , , , Отказ);
		
		Для Каждого СтрЗаявка Из МассивАктивныхЗаявок Цикл
			ОбщегоНазначения.СообщитьПользователю(СокрЛП(СтрЗаявка.Ссылка), СтрЗаявка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры //-- #Б-1986 смарт: Лопато 18.02.2025

