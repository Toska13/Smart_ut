&НаСервере
Процедура ОбновитьНаименование()
	
	Оборудование 			= Строка(Объект.Номенклатура);
	ГотовностьКДемострации 	= ?(Объект.ГотовностьКДемонстрации.Пустая(), Строка(""), Строка(" / "+Объект.ГотовностьКДемонстрации));
	ДемоЗал					= ?(Объект.ДемоЗал.Пустая(), Строка(""), Строка(" ("+Объект.ДемоЗал+")"));
	
	Объект.Наименование = ?(Объект.Номенклатура.Пустая(), Строка(""), Оборудование+ДемоЗал+ГотовностьКДемострации);
	
