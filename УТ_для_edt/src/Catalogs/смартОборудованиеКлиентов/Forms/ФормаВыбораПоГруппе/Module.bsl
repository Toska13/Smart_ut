
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОтбор = Ложь;
	
	Если Параметры.Свойство("смартГруппаОтбора") Тогда
		
		ГруппаОтбора = Параметры.смартГруппаОтбора;
		
		Если ЗначениеЗаполнено(ГруппаОтбора) Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", ГруппаОтбора, ВидСравненияКомпоновкиДанных.ВИерархии,, Истина);			
			
			// Спрятать ненужную папку со всеми вложенными (либо ОБОРУДОВАНИЕ, либо ЧЕРНИЛА), 
			// т.к. отбор на ссылку выше не прячет пустые группы
			ДобавитьУсловноеОформлениеДинамическогоСписка(ГруппаОтбора);
			
			ЕстьОтбор = Истина;
		КонецЕсли;
		//смарт+ Вахов Владимир /398 / 17.03.2021   
	ИначеЕсли Параметры.Свойство("смартОтборПоПартнеру") Тогда
		
		Партнер = Параметры.смартОтборПоПартнеру;
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
		СписокОборудованияПартнера = Партнер.смартОборудованиеКлиентов.ВыгрузитьКолонку("смартОборудованиеКлиента");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", СписокОборудованияПартнера, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);			
		ЕстьОтбор = Истина;
		
		//смарт- Вахов Владимир /398 / 17.03.2021			
	КонецЕсли;
	
	Если Параметры.Свойство("смартЗаголовокФормы") Тогда
		ЭтотОбъект.Заголовок = Параметры.смартЗаголовокформы;
	КонецЕсли;
	
	Если НЕ ЕстьОтбор Тогда
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "Ссылка");
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформлениеДинамическогоСписка(ГруппаОтбора)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОборудованиеКлиентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартОборудованиеКлиентов КАК смартОборудованиеКлиентов
	|ГДЕ
	|	смартОборудованиеКлиентов.ЭтоГруппа
	|	И смартОборудованиеКлиентов.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|	И смартОборудованиеКлиентов.Ссылка <> &ГруппаОтбора";
	
	Запрос.УстановитьПараметр("ГруппаОтбора", ГруппаОтбора);
	
	МассивГруппДляПрятания = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	МассивГруппДляПрятанияСЗ = Новый СписокЗначений;
	МассивГруппДляПрятанияСЗ.ЗагрузитьЗначения(МассивГруппДляПрятания);
	
	Если МассивГруппДляПрятания.Количество() > 0 Тогда
		
		УО = Список.УсловноеОформление.Элементы;
		УО.Очистить();
		ЭлементУО = УО.Добавить();
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
		ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));		
		ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");		
		ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;		
		ЭлементУсловия.ПравоеЗначение = МассивГруппДляПрятанияСЗ;
		ЭлементУсловия.Использование = Истина;

	КонецЕсли;	
	
КонецПроцедуры


