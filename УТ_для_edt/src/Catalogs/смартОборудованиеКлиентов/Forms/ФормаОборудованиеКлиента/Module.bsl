&НаСервере
Функция ПараметрыТаблицыОборудование()

	ПараметрыТаблицыОборудование = Новый Структура;
	ПараметрыТаблицыОборудование.Вставить("смартНаименованиеОборудования", "");
	ПараметрыТаблицыОборудование.Вставить("смартОборудованиеКлиента", ПредопределенноеЗначение("Справочник.смартОборудованиеКлиентов.ПустаяСсылка"));
	ПараметрыТаблицыОборудование.Вставить("смартДатаДобавления", '00010101');
	ПараметрыТаблицыОборудование.Вставить("смартКомментарий", "");
	
	Возврат ПараметрыТаблицыОборудование;

КонецФункции // ПараметрыТаблицыОборудование()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если Не Параметры.Свойство("Партнер") Тогда
		Возврат;
	Конецесли;
		
	Партнер = Параметры.Партнер;
	
	ТаблицаОборудования.Загрузить(Партнер.смартОборудованиеКлиентов.Выгрузить());
	
	ЭтаФорма.Заголовок = ЭтаФорма.Заголовок + " " + Партнер.Наименование;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()
	
	мОбъектПартнер = Партнер.ПолучитьОбъект();
	мОбъектПартнер.смартОборудованиеКлиентов.Загрузить(ТаблицаОборудования.Выгрузить());
	
	Попытка
		
		мОбъектПартнер.Записать();
		
		ЭтаФорма.Модифицированность = Ложь;
		
		Возврат "Данные записаны";
		
	Исключение
		
		мОшибка = ОписаниеОшибки();
		
		ТекстОшибки = "Не удалось записать по причине: " + мОшибка;
		
		Возврат ТекстОшибки;
		
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура Записать(Команда)
	
	Если ЭтаФорма.Модифицированность Тогда
		
		РеузльтатЗаписи = ЗаписатьНаСервере();   
		
		Сообщить(РеузльтатЗаписи);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)

	смартРазрешитьРедактированиеОборудованияНаСервере();

КонецПроцедуры

&НаСервере
Процедура смартРазрешитьРедактированиеОборудованияНаСервере()
	
	Если АдминистраторСервисЦентра() Тогда
		
		Элементы.ТаблицаОборудования.ИзменятьСоставСтрок = Истина;
		Элементы.ТаблицаОборудования.ЦветФона = ЦветаСтиля.ЦветФонаПоля;  
		
		Элементы.ТаблицаОборудованиясмартНаименованиеОборудования.Доступность 	= Истина;
		Элементы.ТаблицаОборудованиясмартОборудованиеКлиента.Доступность 	= Истина;
		Элементы.ТаблицаОборудованиясмартДатаДобавления.Доступность 		= Истина;
		
		ЭтаФорма.Модифицированность = Истина;
		
	Иначе
		Сообщить("Изменение доступно не всем, обратитесь к администратору");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция АдминистраторСервисЦентра()

	АдминистраторСЦ = Пользователи.РолиДоступны("ПолныеПрава,смартИзменениеСоставаОборудованияПартнера");

	Возврат АдминистраторСЦ;
	
КонецФункции 