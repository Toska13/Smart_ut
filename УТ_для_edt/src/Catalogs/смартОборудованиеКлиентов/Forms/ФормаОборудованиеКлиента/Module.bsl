
&НаКлиенте
Процедура Добавить(Команда)
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Добавить оборудование");
	Кнопки.Добавить(КодВозвратаДиалога.Нет, "Вернуться назад");

	ТекстВопроса = НСтр("ru = 'Перед выбором убедитесь, что оборудования, которое вы хотите добавить, нет в списке'");

	Оповещение = Новый ОписаниеОповещения("ПослеОтветаНаВопросДобавитьОборудование", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 0,, "Добавление оборудования клиента");

	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросДобавитьОборудование(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		РасшСмарт_ОткрытьФормуВыбораОборудования();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура РасшСмарт_ОткрытьФормуВыбораОборудования()
	
	ПараметрЗаголовок = НСтр("ru = 'Добавление оборудования для %Справочник%'");
	Если ЗначениеЗаполнено(Партнер) Тогда
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Справочник%", Партнер);
	Иначе
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Справочник%", НСтр("ru='(новый клиент)'"));
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаДобавления", 	Дата(ТекущаяДата()));
	ПараметрыФормы.Вставить("Партнер", 			Партнер);
	  
	ПараметрыФормы.Вставить("смартТипОборудованияКлиента", ПредопределенноеЗначение("Перечисление.смартТипыОборудованияКлиента.Оборудование"));
	
	ПараметрыТовара = ПараметрыТаблицыОборудование();
	
	ОткрытьФорму("Справочник.Партнеры.Форма.РасшСмарт_ФормаДобавленияОборудования", 
				ПараметрыФормы, 
				ЭтаФорма, 
				УникальныйИдентификатор,
				,
				,
				Новый ОписаниеОповещения("ДобавитьОборудованиеКлиентаПослеВыбора", ЭтотОбъект, ПараметрыТовара),
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			
	Возврат;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОборудованиеКлиентаПослеВыбора(ПодобранноеОборудование, ДополнительныеПараметры) Экспорт 
	
	Если ПодобранноеОборудование = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьОборудованиеКлиентаЗавершение(ДополнительныеПараметры, ПодобранноеОборудование);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

