//++ смарт:ММ #082 397 25.12.2020 - Выгрузка при создании оборудования
Процедура ПередЗаписью(Отказ)
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
	//++ смарт:ММ #082 397 14.01.2021 - Выгрузка оборудования
	ПроверитьПорядокСортировки(Отказ);
	//-- смарт:ММ 14.01.2021
	
КонецПроцедуры //-- смарт:ММ 25.12.2020

//++ смарт:ММ #082 397 14.01.2021 - Выгрузка оборудования
Процедура ПроверитьПорядокСортировки(Отказ)
	
	// Реквизит ПорядокСортировкиДляВыгрузки (используется для групп) не должен повторяться в рамках групп в пределах корневого родителя 
	// (т.е. для подчиненных групп родителя ЧЕРНИЛА одна нумерация, для ОБОРУДОВАНИЯ - другая)
	
	// Проверка рассчитана на то, что в справочнике уровень иерархии не более 5
	
	Если ПорядокСортировкиДляВыгрузки = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА смартОборудованиеКлиентов.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА смартОборудованиеКлиентов.Ссылка
	|		КОГДА РодительСпр.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительСпр.Ссылка
	|		КОГДА РодительРодительСпр.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительРодительСпр.Ссылка
	|		КОГДА РодительРодительСпр.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительРодительСпр.Родитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|	КОНЕЦ КАК КорневойКаталог,
	|	смартОборудованиеКлиентов.Ссылка КАК Ссылка,
	|	смартОборудованиеКлиентов.ПорядокСортировкиДляВыгрузки КАК ПорядокСортировкиДляВыгрузки
	|ИЗ
	|	Справочник.смартОборудованиеКлиентов КАК смартОборудованиеКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартОборудованиеКлиентов КАК РодительСпр
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартОборудованиеКлиентов КАК РодительРодительСпр
	|			ПО РодительСпр.Родитель = РодительРодительСпр.Ссылка	
	|		ПО смартОборудованиеКлиентов.Родитель = РодительСпр.Ссылка
	|ГДЕ
	|	смартОборудованиеКлиентов.ЭтоГруппа
	|	И НЕ смартОборудованиеКлиентов.ПометкаУдаления
	|	И смартОборудованиеКлиентов.ПорядокСортировкиДляВыгрузки = &ПорядокСортировкиДляВыгрузки
	|	И смартОборудованиеКлиентов.Ссылка <> &Ссылка
	|	И ВЫБОР
	|		КОГДА смартОборудованиеКлиентов.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА смартОборудованиеКлиентов.Ссылка
	|		КОГДА РодительСпр.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительСпр.Ссылка
	|		КОГДА РодительРодительСпр.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительРодительСпр.Ссылка
	|		КОГДА РодительРодительСпр.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|			ТОГДА РодительРодительСпр.Родитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|	КОНЕЦ = &КорневойКаталог";
	
	КорневойКаталогТекущегоЭлемента = ПолучитьКорневойКаталогРекурсивно(Ссылка);
	
	Запрос.УстановитьПараметр("ПорядокСортировкиДляВыгрузки", ПорядокСортировкиДляВыгрузки);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("КорневойКаталог", КорневойКаталогТекущегоЭлемента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю("Порядок сортировки для выгрузки " + ПорядокСортировкиДляВыгрузки + " уже задан для группы " + Выборка.Ссылка, Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 14.01.2021

//++ смарт:ММ #082 397 14.01.2021 - Выгрузка оборудования
Функция ПолучитьКорневойКаталогРекурсивно(ТекСсылка)
	
	Если НЕ ЗначениеЗаполнено(ТекСсылка.Родитель) Тогда
		Возврат ТекСсылка;
	Иначе
		Возврат ПолучитьКорневойКаталогРекурсивно(ТекСсылка.Родитель);
	КонецЕсли;	
	
КонецФункции //-- смарт:ММ 14.01.2021

