		ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.CRM_Интерес"));
		
	ИначеЕсли РодительЭлемента = Справочники.CRM_ШаблоныАвтотекста.ИнтересЗначениеКолонок Тогда
		
