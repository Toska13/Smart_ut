
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Список.Параметры.УстановитьЗначениеПараметра("МассивНоменклатуры", Параметры.МассивНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
		
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
	ПараметрыВыбора.Вставить("ВидЦены", ТекущиеДанные.ВидЦены);
	
	Оповестить("ВыбраныНоменклатураИЦена", ПараметрыВыбора, ЭтаФорма);
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры
