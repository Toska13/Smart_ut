
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ТипЗнч(Параметры.Основание) = Тип("Структура") 
			И Параметры.Основание.Свойство("ЕдиницаИзмерения") Тогда
			Объект.ЕдиницаИзмерения = Параметры.Основание.ЕдиницаИзмерения;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры
