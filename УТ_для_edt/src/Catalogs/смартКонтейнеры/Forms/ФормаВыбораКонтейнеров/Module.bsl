
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СписокКонтейнеров") Тогда
		СК = Параметры.СписокКонтейнеров;
		МножественныйВыбор = Параметры.МножественныйВыбор;
		Если СК = Неопределено Тогда
			Отказ = истина;
			Возврат;
		Иначе	
			СписокКонтейнеров.Очистить();
			Для Каждого СтрСК Из СК Цикл     
				СписокКонтейнеров.Добавить(СтрСК.Значение,,СтрСК.Пометка);
			КонецЦикла;	
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКонтейнеры(Команда)
	Закрыть(СписокКонтейнеров);
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтейнеровПометкаПриИзменении(Элемент)
	Если Не МножественныйВыбор Тогда
		ТД = Элементы.СписокКонтейнеров.ТекущиеДанные;
		Для Каждого Контейнер Из СписокКонтейнеров Цикл
			Если Контейнер.Значение = ТД.Значение Тогда
				Контейнер.Пометка = истина;
			Иначе
				Контейнер.Пометка = ложь;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры
