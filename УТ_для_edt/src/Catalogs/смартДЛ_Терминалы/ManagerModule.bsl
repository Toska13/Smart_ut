Функция ПолучитьМассивПоляПоиска() Экспорт	
	
	Возврат смартДеловыеЛинии.МассивДвухЭлементов("id", "ИДтерминала");
	
КонецФункции    

Функция ПолучитьТаблицуПолейЗначений() Экспорт
	
	Результат = смартДеловыеЛинии.НоваяТаблицаПолейЗначений();
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "name", "Наименование", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "address", "Адрес", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "fullAddress", "ПолныйАдрес", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "latitude", "Широта", "Реквизит");
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "longitude", "Долгота", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "isOffice", "ТолькоОфис", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "receiveCargo", "Приемка", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "giveoutCargo", "Выдача", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "storage", "Хранение", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "cashOnDelivery", "ОплатаНаложенымПлатежом", "Реквизит");	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "addressCode", "", "ВложенныеРеквизиты", Новый Структура("street_code", "КодУлицы"));	 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "calcSchedule", "", "ВложенныеРеквизиты", Новый Структура("arrival, derival", "ГрафикПоВыдаче", "ГрафикПоПриему"));
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "default", "ПоУмолчанию", "Реквизит");
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "maxVolume", "МаксимальныйОбъем", "Реквизит");
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "maxWeight", "МаксимальныйВес", "Реквизит");
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "maxHeight", "МаксимальнаяВысота", "Реквизит"); 
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "maxWidth", "МаксимальнаяШирина", "Реквизит");
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "maxLength", "МаксимальнаяДлина", "Реквизит");   	
	
	МассивРежимРаботы = Новый Массив;
	МассивРежимРаботы.Добавить("ТабличнаяЧасть");
	МассивРежимРаботы.Добавить("РежимРаботыОтделов");
	МассивРежимРаботы.Добавить(Новый Структура("Отдел, РежимРаботы", "department", "timetable"));	
	
	смартДеловыеЛинии.ДобавитьСтрокуВТаблицуПолейЗначений(Результат, "worktables", "", "ВложенныеРеквизиты", Новый Структура("worktable", МассивРежимРаботы));
		
	Возврат Результат;
	
КонецФункции
