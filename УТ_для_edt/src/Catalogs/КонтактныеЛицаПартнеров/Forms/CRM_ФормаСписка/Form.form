  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ref</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
    СправочникКонтактныеЛицаПартнеров.Ссылка,
    СправочникКонтактныеЛицаПартнеров.ПометкаУдаления,
    СправочникКонтактныеЛицаПартнеров.Владелец,
    СправочникКонтактныеЛицаПартнеров.Наименование,
    СправочникКонтактныеЛицаПартнеров.CRM_Должность,
    СправочникКонтактныеЛицаПартнеров.CRM_Имя,
    СправочникКонтактныеЛицаПартнеров.CRM_НапоминатьОДнеРождения,
    СправочникКонтактныеЛицаПартнеров.CRM_Отчество,
    СправочникКонтактныеЛицаПартнеров.CRM_РольКонтактногоЛица,
    СправочникКонтактныеЛицаПартнеров.CRM_Состояние,
    СправочникКонтактныеЛицаПартнеров.CRM_УчаствуетВАнкетировании,
    СправочникКонтактныеЛицаПартнеров.CRM_Фамилия,
    СправочникКонтактныеЛицаПартнеров.CRM_Фотография,
    СправочникКонтактныеЛицаПартнеров.ДатаРегистрацииСвязи,
    СправочникКонтактныеЛицаПартнеров.ДатаРождения,
    СправочникКонтактныеЛицаПартнеров.Комментарий,
    СправочникКонтактныеЛицаПартнеров.Пол,
    СправочникКонтактныеЛицаПартнеров.сфпCoMagicID,
    СправочникКонтактныеЛицаПартнеров.сфпПользовательДляПереключенияЗвонков,
    СправочникКонтактныеЛицаПартнеров.КонтактнаяИнформация,
    СправочникКонтактныеЛицаПартнеров.ДополнительныеРеквизиты,
    СправочникКонтактныеЛицаПартнеров.CRM_ДополнительнаяИнформация,
    СправочникКонтактныеЛицаПартнеров.Предопределенный,
    ВЫБОР
        КОГДА НЕ СправочникКонтактныеЛицаПартнеров.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
            ТОГДА ВЫБОР
                    КОГДА МЕСЯЦ(&amp;ТекДата) - МЕСЯЦ(СправочникКонтактныеЛицаПартнеров.ДатаРождения) > 0
                        ТОГДА РАЗНОСТЬДАТ(СправочникКонтактныеЛицаПартнеров.ДатаРождения, &amp;ТекДата, ГОД)
                    КОГДА МЕСЯЦ(&amp;ТекДата) - МЕСЯЦ(СправочникКонтактныеЛицаПартнеров.ДатаРождения) = 0
                            И ДЕНЬ(&amp;ТекДата) - ДЕНЬ(СправочникКонтактныеЛицаПартнеров.ДатаРождения) >= 0
                        ТОГДА РАЗНОСТЬДАТ(СправочникКонтактныеЛицаПартнеров.ДатаРождения, &amp;ТекДата, ГОД)
                    ИНАЧЕ РАЗНОСТЬДАТ(СправочникКонтактныеЛицаПартнеров.ДатаРождения, &amp;ТекДата, ГОД) - 1
                КОНЕЦ
        ИНАЧЕ 0
    КОНЕЦ КАК Возраст,
    СправочникКонтактныеЛицаПартнеров.ИмяПредопределенныхДанных,
    ВЫБОР
        КОГДА CRM_ЗаполненностьРеквизитовОбъектов.ПроцентЗаполненностиОбщий &lt; 25
            ТОГДА 0
        КОГДА CRM_ЗаполненностьРеквизитовОбъектов.ПроцентЗаполненностиОбщий &lt; 50
            ТОГДА 1
        КОГДА CRM_ЗаполненностьРеквизитовОбъектов.ПроцентЗаполненностиОбщий &lt; 75
            ТОГДА 2
        КОГДА CRM_ЗаполненностьРеквизитовОбъектов.ПроцентЗаполненностиОбщий &lt; 90
            ТОГДА 3
        ИНАЧЕ 4
    КОНЕЦ КАК ЗаполненностьИнформации
ИЗ
    Справочник.КонтактныеЛицаПартнеров КАК СправочникКонтактныеЛицаПартнеров
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ЗаполненностьРеквизитовОбъектов КАК CRM_ЗаполненностьРеквизитовОбъектов
		ПО СправочникКонтактныеЛицаПартнеров.Ссылка = CRM_ЗаполненностьРеквизитовОбъектов.Объект    </queryText>
      <mainTable>Catalog.КонтактныеЛицаПартнеров</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
