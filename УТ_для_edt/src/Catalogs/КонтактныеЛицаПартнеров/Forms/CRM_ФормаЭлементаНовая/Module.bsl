&НаКлиенте
Процедура ДублиКлиентаПриИзменении(Элемент)
	ТекДанные = Элемент.ТекущиеДанные;
	СтрОригинал = ДублиКлиента.НайтиСтроки(Новый Структура("ЭтоОригинал", Истина));
	Если СтрОригинал.Количество() Тогда
