
&НаСервере
// Процедура - обработчик события "ПриСозданииНаСервере" 
// Если в параметры формы передать параметр СписокОтбора несколько партнеров в виде Списка значений,
// то в списке будут отобраны контактные лица, относящиеся к этим партнерам.
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СписокОтбора") Тогда
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ПравоеЗначение = Параметры.СписокОтбора; 
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Оповестить("ВыбраноКонтактноеЛицо",ВыбраннаяСтрока,ЭтаФорма);
КонецПроцедуры
