
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт") Тогда
		// Заполнение шапки
		ДокументОснование = ДанныеЗаполнения.Ссылка;
		Если НЕ СтрДлина(ДанныеЗаполнения.Номер)<10 Тогда
			Код=ДанныеЗаполнения.Номер;
			Наименование="Отчет по гарантии Мимаки (смарт) №"+ДанныеЗаполнения.Номер+" от "+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
		Иначе
			Наименование="Отчет по гарантии Мимаки (смарт)";
		КонецЕсли;
		Серия=ДанныеЗаполнения.Серия;	
		Оборудование=ДанныеЗаполнения.Оборудование;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	Если СтрДлина(Код)<10 Тогда
		ЭтотОбъект.УстановитьНовыйКод("PRE-");
		Наименование="Отчет по гарантии Мимаки (смарт) №"+Код+" от "+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	КонецЕсли;	
КонецПроцедуры
