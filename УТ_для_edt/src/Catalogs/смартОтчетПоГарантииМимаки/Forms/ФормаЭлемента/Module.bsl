
&НаСервере
Процедура СерияПриИзмененииНаСервере()
	Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                    |	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура
	                    |ИЗ
	                    |	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	                    |ГДЕ
	                    |	ПриобретениеТоваровУслугТовары.Серия = &Серия
	                    |	И ПриобретениеТоваровУслугТовары.Ссылка.Проведен");
	Запрос.УстановитьПараметр("Серия",Объект.Серия);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.Оборудование=Выборка.Номенклатура;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СерияПриИзменении(Элемент)
	СерияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                    |	смартОтчетПоГарантииМимаки.Ссылка КАК Ссылка
		                    |ИЗ
		                    |	Справочник.смартОтчетПоГарантииМимаки КАК смартОтчетПоГарантииМимаки
		                    |ГДЕ
		                    |	смартОтчетПоГарантииМимаки.ДокументОснование = &ДокументОснование
		                    |	И НЕ смартОтчетПоГарантииМимаки.ПометкаУдаления"); 
		Запрос.УстановитьПараметр("ДокументОснование",Объект.ДокументОснование);
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() ТОгда                                     
			Сообщить("По данному документу отчет уже существует, найтите отчет в связанных документах"); 
			Стандартнаяобработка=Ложь;
			Отказ=Истина;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	Если Объект.ПричинаПоломки=Перечисления.смартПричиныПоломки.HeadNozzle 
		ИЛИ Объект.ПричинаПоломки=Перечисления.смартПричиныПоломки.PrintQuality Тогда
		Элементы.Чернила.Видимость=Истина;
	Иначе
		Элементы.Чернила.Видимость=Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи) 
	Если НЕ ЭтаФорма.ВладелецФормы=Неопределено	Тогда
		ЭтаФорма.ВладелецФормы.ОтчетМимаки=Объект.Ссылка; 
		СтруктураПрефиксНомер = смартОбщегоНазначения.РазбитьСтрокуНаПрефиксИНомер(Объект.Код);
		ЭтаФорма.ВладелецФормы.ВнешнийНомер 	= СтруктураПрефиксНомер.Номер;
		ЭтаФорма.ВладелецФормы.Элементы.ВнешнийНомер.ТолькоПросмотр=Истина;
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ПричинаПоломкиПриИзменении(Элемент)
	Если Объект.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.HeadNozzle") 
		ИЛИ Объект.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.PrintQuality") Тогда
		Элементы.Чернила.Видимость=Истина;
	Иначе
		Элементы.Чернила.Видимость=Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если (Объект.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.HeadNozzle") 
		ИЛИ Объект.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.PrintQuality")) И Объект.Чернила.Количество()=0 Тогда
		Сообщить("Необходимо заполнить чернила!");
		Отказ=Истина;
		Возврат;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.Ссылка.Пустая() Тогда	
		Объект.Оборудование=ЭтаФорма.ВладелецФормы.Объект.Оборудование;
		Объект.Серия=ЭтаФорма.ВладелецФормы.Объект.Серия;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФотоОборудования(Команда)
	Оповещение = Новый ОписаниеОповещения("ВыборФайлаЗавершение", ЭтаФорма,Новый Структура("ТекстНаименования,ИмяРеквизита","Фото оборудования","ФотоОборудования"));
	ПараметрыВыбораФайла=Новый Структура;
	ПараметрыВыбораФайла.Вставить("МаксимальныйРазмер" , 0);
	ПараметрыВыбораФайла.Вставить("НеОткрыватьКарточку", Истина);
	ПараметрыВыбораФайла.Вставить("ФильтрДиалогаВыбора",  НСтр("ru = '(*.jpg)|*.jpg'"));
	РаботаСФайламиКлиент.ДобавитьФайл(Оповещение,ПолучитьСсылкуНаДокументОснование(),ЭтаФорма,2,ПараметрыВыбораФайла);
КонецПроцедуры 

