#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция РассчитатьСтатусRoistatПоСостояниюИнтереса(Интерес, СостояниеИнтереса) Экспорт
	
	СтатусRoistat = Неопределено;

	Если ЗначениеЗаполнено(Интерес) 
		И ЗначениеЗаполнено(СостояниеИнтереса) Тогда
		
		УстановитьПривилегированныйРежим(Истина);	
			
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Журнал.CRM_Интерес КАК Интерес,
			|	СостоянияЗаказов.Заказ,
			|	СостоянияЗаказов.ПроцентОплаты,
			|	СтатусыRoistat.Ссылка КАК СтатусRoistat,
			|	ВЫБОР
			|		КОГДА СтатусыRoistat.КонтрольОплаты ТОГДА
			|			ВЫБОР 
			|				КОГДА 
			|					СтатусыRoistat.ПолнаяОплата 
			|				 		И ЕСТЬNULL(СостоянияЗаказов.ПроцентОплаты, 0) = 100 ТОГДА 1
			|				КОГДА 
			|					ЕСТЬNULL(СостоянияЗаказов.ПроцентОплаты, 0) > 0 ТОГДА 2
			|			КОНЕЦ
			|		ИНАЧЕ 3
			|	КОНЕЦ КАК Приоритет
			|ИЗ
			|	РегистрСведений.CRM_ЖурналДокументов КАК Журнал
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказов
			|		ПО СостоянияЗаказов.Заказ = ВЫРАЗИТЬ(Журнал.Объект КАК Документ.ЗаказКлиента)
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.смартСтатусыRoistat.СостоянияИнтересовИУсловия КАК СтатусыRoistat
			|		ПО СтатусыRoistat.СостояниеИнтереса = &СостояниеИнтереса
			|			И ВЫБОР
			|					КОГДА СтатусыRoistat.КонтрольОплаты ТОГДА
			|						ВЫБОР КОГДА СтатусыRoistat.ПолнаяОплата ТОГДА 
			|							ЕСТЬNULL(СостоянияЗаказов.ПроцентОплаты, 0) = 100
			|						ИНАЧЕ 
			|							ЕСТЬNULL(СостоянияЗаказов.ПроцентОплаты, 0) > 0
			|						КОНЕЦ
			|					ИНАЧЕ 
			|						ИСТИНА
			|				КОНЕЦ
			|ГДЕ
			|	Журнал.CRM_Интерес = &Интерес
			|	И Журнал.ГлавнаяЗапись
			|
			|УПОРЯДОЧИТЬ ПО
			|	Приоритет";
		
		Запрос.УстановитьПараметр("Интерес", 		   Интерес);
		Запрос.УстановитьПараметр("СостояниеИнтереса", СостояниеИнтереса);
		
		ВыборкаРезультатаЗапроса = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаРезультатаЗапроса.Следующий() Тогда
			СтатусRoistat = ВыборкаРезультатаЗапроса.СтатусRoistat;
		КонецЕсли;
		
	КонецЕсли;	
	
	Возврат СтатусRoistat;
	
КонецФункции	

#КонецОбласти

#КонецЕсли