
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартКвалификацииМенеджеровПользователи.Пользователь КАК Менеджер
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи КАК смартКвалификацииМенеджеровПользователи
	|ГДЕ
	|	НЕ смартКвалификацииМенеджеровПользователи.Ссылка.НеАктуальна
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартКвалификацииМенеджеровПользователи.Пользователь.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартКвалификацииМенеджеров.Ссылка КАК КвалификацияМенеджера,
	|	смартКвалификацииМенеджеров.Наименование КАК Заголовок
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров КАК смартКвалификацииМенеджеров
	|ГДЕ
	|	НЕ смартКвалификацииМенеджеров.НеАктуальна
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартКвалификацииМенеджеров.Сортировка,
	|	смартКвалификацииМенеджеров.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартКвалификацииМенеджеровПользователи.Ссылка КАК КвалификацияМенеджера,
	|	смартКвалификацииМенеджеровПользователи.Пользователь КАК Менеджер
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи КАК смартКвалификацииМенеджеровПользователи
	|ГДЕ
	|	НЕ смартКвалификацииМенеджеровПользователи.Ссылка.НеАктуальна");
	МасРезльтатов = Запрос.ВыполнитьПакет();
	
	ТабМенеджеров = МасРезльтатов[0].Выгрузить();
	ТабКвалификаций.Загрузить(МасРезльтатов[1].Выгрузить());
	Для Каждого СтрТабКвалификаций Из ТабКвалификаций Цикл
		СтрТабКвалификаций.ИмяКолонки = СтрЗаменить(Строка(Новый УникальныйИдентификатор),"-","_");
	КонецЦикла;
	
	ТабЗаполнения = МасРезльтатов[2].Выгрузить();
	КолонкиДобавляемые = Новый Массив;
	Для Каждого СтрТабКвалификаций Из ТабКвалификаций Цикл
		
		Если ЭтаФорма.Элементы.Найти("Квалификация_"+СтрТабКвалификаций.ИмяКолонки) = Неопределено ТОгда
			КолонкиДобавляемые.Добавить(Новый РеквизитФормы("Квалификация_" + СтрТабКвалификаций.ИмяКолонки, Новый ОписаниеТипов("Булево"), "ТаблицаМенеджеров", СтрТабКвалификаций.Заголовок));
			КолонкиДобавляемые.Добавить(Новый РеквизитФормы("ЗаголовокКвалификации_" + СтрТабКвалификаций.ИмяКолонки, Новый ОписаниеТипов("Строка"), "ТаблицаМенеджеров", СтрТабКвалификаций.Заголовок));
		КонецЕсли;
		
	КонецЦикла;	
	
	ИзменитьРеквизиты(КолонкиДобавляемые,);
	
	Для Каждого СтрТабКвалификаций Из ЭтаФорма.ТабКвалификаций Цикл
		
		НоваяГруппа = Элементы.Добавить("Группа_" + СтрТабКвалификаций.ИмяКолонки, Тип("ГруппаФормы"), ЭтаФорма.Элементы.ТаблицаМенеджеров);
		НоваяГруппа.Группировка = ГруппировкаКолонок.ВЯчейке;
		
		НовыйЗаголовок = Элементы.Добавить("ЗаголовокКолонки_" + СтрТабКвалификаций.ИмяКолонки, Тип("ПолеФормы"), ЭтаФорма.Элементы["Группа_" + СтрТабКвалификаций.ИмяКолонки]);
		НовыйЗаголовок.ТолькоПросмотр = Истина;
		НовыйЗаголовок.ПутьКДанным = "ТаблицаМенеджеров" + "." + "ЗаголовокКвалификации_" + СтрТабКвалификаций.ИмяКолонки;
		НовыйЗаголовок.АвтоМаксимальнаяШирина = Ложь;
		НовыйЗаголовок.Ширина = 7;
		НовыйЗаголовок.МаксимальнаяШирина = 7;
		
		ДобавленнаяКвалификация = Элементы.Добавить("Колонка_" + СтрТабКвалификаций.ИмяКолонки, Тип("ПолеФормы"), ЭтаФорма.Элементы["Группа_" + СтрТабКвалификаций.ИмяКолонки]);
		ДобавленнаяКвалификация.Вид = ВидПоляФормы.ПолеФлажка;
		ДобавленнаяКвалификация.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ДобавленнаяКвалификация.ОтображатьВШапке = Ложь;
		ДобавленнаяКвалификация.ОтображатьВПодвале = Ложь;
		ДобавленнаяКвалификация.ПутьКДанным = "ТаблицаМенеджеров" + "." + "Квалификация_" + СтрТабКвалификаций.ИмяКолонки;
		ДобавленнаяКвалификация.Видимость = Истина;
		ДобавленнаяКвалификация.ТолькоПросмотр = НЕ Пользователи.РолиДоступны("смартДобавлениеИзменениеКвалификацийМенеджеров");
		ДобавленнаяКвалификация.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
		ДобавленнаяКвалификация.УстановитьДействие("ПриИзменении", "ТаблицаМенеджеровПриИзменении");
		
	КонецЦикла;
	
	Для Каждого СтрТабМенеджеров Из ТабМенеджеров Цикл
		
		СтрТаблицаМенеджеров = ТаблицаМенеджеров.Добавить();
		СтрТаблицаМенеджеров.Менеджер = СтрТабМенеджеров.Менеджер;
		Для Каждого СтрТабКвалификаций Из ТабКвалификаций Цикл
			СтрокиТабЗаполнения = ТабЗаполнения.НайтиСтроки(Новый Структура("Менеджер,КвалификацияМенеджера",СтрТабМенеджеров.Менеджер,СтрТабКвалификаций.КвалификацияМенеджера));
			Если СтрокиТабЗаполнения.Количество() > 0 ТОгда
				СтрТаблицаМенеджеров["Квалификация_"+СтрТабКвалификаций.ИмяКолонки] = Истина;	
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;
	
	Если НЕ Пользователи.РолиДоступны("смартДобавлениеИзменениеКвалификацийМенеджеров") ТОгда
		
		Элементы.ФормаЗакрыть.Доступность = Ложь;
		Элементы.ФормаСохранить.Доступность = Ложь;
		Элементы.ФормаСохранитьИЗакрыть.Доступность = Ложь;
		Элементы.ТаблицаМенеджеровПодборМенеджеров.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаМенеджеровПриИзменении(Элемент)
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ФормаЗакрыть(Команда)
	
	Если ЭтаФорма.Модифицированность ТОгда
		Режим = РежимДиалогаВопрос.ДаНетОтмена;
		Оповещение = Новый ОписаниеОповещения("смартПослеЗакрытияВопроса", ЭтаФорма);
		ПоказатьВопрос(Оповещение, "Данные были изменены, сохранить изменения квалификаций?", Режим, 0);
	Иначе	
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()
	
	Для Каждого СтрТабКвалификаций Из ТабКвалификаций Цикл
		
		ОбКвалификация = СтрТабКвалификаций.КвалификацияМенеджера.ПолучитьОбъект();
		ОбКвалификация.Пользователи.Очистить();
		
		Для Каждого СтрТаблицаМенеджеров Из ТаблицаМенеджеров Цикл
			
			Если СтрТаблицаМенеджеров["Квалификация_" + СтрТабКвалификаций.ИмяКолонки] ТОгда
				
				СтрПользователи=ОбКвалификация.Пользователи.Добавить();	
				СтрПользователи.Пользователь = СтрТаблицаМенеджеров.Менеджер;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОбКвалификация.Записать();
		
		ТаблицаДляКоэффициентов = смартСервер.СформироватьВыдачуЛидовПоКвалификации(ОбКвалификация.Ссылка);
		
		смартСервер.ЗаполнитьКоэффициентыМенеджеров(ТаблицаДляКоэффициентов);

	КонецЦикла;
	
	смартСервер.ОчиститьКоэффициентыИВыдачуЛидов();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	СохранитьНаСервере();
	ЭтаФорма.Закрыть();
КонецПроцедуры 

&НаКлиенте
Процедура смартПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
		ЭтаФорма.Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда	
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборМенеджеров(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора",				Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор",		Ложь);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",		Ложь);
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.Заголовок = "Подбор пользователей" Тогда
		СтрокиТаблицаМенеджеров = ЭтаФорма.ТаблицаМенеджеров.НайтиСтроки(Новый Структура("Менеджер",ВыбранноеЗначение));
		Если СтрокиТаблицаМенеджеров.Количество() = 0 Тогда
			СтрТаблицаМенеджеров = ТаблицаМенеджеров.Добавить();	
			СтрТаблицаМенеджеров.Менеджер = ВыбранноеЗначение;
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

