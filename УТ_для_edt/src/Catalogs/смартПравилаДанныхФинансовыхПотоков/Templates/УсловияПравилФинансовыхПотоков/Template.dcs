		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫРАЗИТЬ(&amp;Организация КАК Справочник.Организации) КАК Организация, 
	ВЫРАЗИТЬ(&amp;Автор КАК Справочник.Пользователи) КАК Автор,
	ВЫРАЗИТЬ(&amp;КтоЗаявил КАК Справочник.Пользователи) КАК КтоЗаявил,
	ВЫРАЗИТЬ(&amp;ХозяйственнаяОперация КАК Перечисление.ХозяйственныеОперации) КАК ХозяйственнаяОперация,
	ВЫРАЗИТЬ(&amp;ХозяйственнаяОперацияПоЗарплате КАК Перечисление.ХозяйственныеОперации) КАК ХозяйственнаяОперацияПоЗарплате,
	ВЫРАЗИТЬ(&amp;БанковскийСчетКонтрагента КАК Справочник.БанковскиеСчетаКонтрагентов) КАК БанковскийСчетКонтрагента,
	ВЫРАЗИТЬ(&amp;Банк КАК Справочник.КлассификаторБанков) КАК Банк,
	ВЫРАЗИТЬ(&amp;Контрагент КАК Справочник.Контрагенты) КАК Контрагент,
	&amp;Валюта КАК Валюта,
	&amp;СуммаДокумента КАК СуммаДокумента,
	Валюты.Ссылка КАК Ссылка
ИЗ
	Справочник.Валюты КАК Валюты</query>
