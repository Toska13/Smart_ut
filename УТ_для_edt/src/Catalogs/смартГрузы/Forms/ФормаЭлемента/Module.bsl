&НаКлиенте
Процедура ПослеВопросаОтменитьПриему(Результат,ДопПараметры)Экспорт
	Если Результат=КодВозвратаДиалога.Да Тогда 
		ОтменитьПриемГруза();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбработатьПриему(Результат,ДопПараметры)Экспорт 
	Если Результат=КодВозвратаДиалога.Да Тогда 
		ОбработатьПриемГруза();
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ОтменитьПриемГруза()
	
	Если НЕ Объект.Принят Тогда
		Сообщить("Груз не принят");
		Возврат;
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК ПоступлениеТоваровУслуг
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Груз = &Груз
	|	И ПоступлениеТоваровУслуг.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.Принят)
	|	И ПоступлениеТоваровУслуг.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеТоваров.Ссылка
	|ИЗ
	//++ смарт:ММ #016 161 23.01.2020 - обновление 11.4.7.150
	//|	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
	|	Документ.ПоступлениеТоваровНаСклад КАК ПоступлениеТоваров
	//-- смарт:ММ 23.01.2020
	|ГДЕ
	|	ПоступлениеТоваров.Проведен
	|	И ПоступлениеТоваров.Груз = &Груз
	|	И ПоступлениеТоваров.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.Принят)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеУслугПрочихАктивовРасходы.Ссылка КАК ПоступлениеУслугПрочихАктивовРасходы
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеУслугПрочихАктивов.Расходы КАК ПоступлениеУслугПрочихАктивовРасходы
	|		ПО ПоступлениеТоваровУслуг.Ссылка = ПоступлениеУслугПрочихАктивовРасходы.АналитикаРасходов
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Груз = &Груз
	|	И ПоступлениеТоваровУслуг.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.Принят)
	|	И НЕ ПоступлениеУслугПрочихАктивовРасходы.Ссылка ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеУслугПрочихАктивовРасходы.Ссылка";
	
	Запрос.УстановитьПараметр("Груз", Объект.Ссылка);
	Результат = Запрос.ВыполнитьПакет();
	Если Результат.Количество()=0 Тогда
		Возврат;
	Конецесли;	
	ВыборкаПоПоступлениям = Результат[0].Выбрать();
	ВыборкаПоДопРасходам =  Результат[1].Выбрать();
	НачатьТранзакцию();
	Пока ВыборкаПоПоступлениям.Следующий() Цикл
		ПоступлениеТоваровУслуг = ВыборкаПоПоступлениям.ПоступлениеТоваровУслуг;
		Если ПоступлениеТоваровУслуг.Проведен Тогда
			ДокументПоступленияТоваров = ПоступлениеТоваровУслуг.ПолучитьОбъект();
			Попытка
				ДокументПоступленияТоваров.Заблокировать();
			Исключение
				Сообщить("Нет возможности заблокировать документ: "+ПоступлениеТоваровУслуг+"  "+ОписаниеОшибки());
				ОтменитьТранзакцию();
				Возврат;
			КонецПопытки;	
			ДокументПоступленияТоваров.СтатусГруза = Перечисления.СтатусыГрузов.ВПути; 
			ДокументПоступленияТоваров.Записать(РежимЗаписиДокумента.Проведение);
			ДокументПоступленияТоваров.Разблокировать();
		КонецЕсли;
	КонецЦикла;
	Если ВыборкаПоДопРасходам.Количество() > 0 Тогда
		Пока ВыборкаПоДопРасходам.Следующий() Цикл
			ПоступлениеУслугПрочихАктивов = ВыборкаПоДопРасходам.ПоступлениеУслугПрочихАктивовРасходы;
			Если ПоступлениеУслугПрочихАктивов.Проведен Тогда
				ДокументДопРасходовОбъект = ПоступлениеУслугПрочихАктивов.ПолучитьОбъект();
				Попытка
					ДокументДопРасходовОбъект.УстановитьПометкуУдаления(Истина);
				Исключение
					ТекстОшибки = НСтр("ru='Не удалось установить пометку удаления для документа %Документ%. %ОписаниеОшибки%'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Документ%", ДокументДопРасходовОбъект);
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДокументДопРасходовОбъект);
				КонецПопытки;
				//ДокументДопРасходовОбъект.Удалить();
			КонецЕсли;
		КонецЦикла;
    КонецЕсли;
		
	
	Объект.Принят = Ложь;
	Элементы.Принят.Доступность = Истина;
	Записать();
	Элементы.ФормаПринятьГруз.Доступность = Истина;
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

