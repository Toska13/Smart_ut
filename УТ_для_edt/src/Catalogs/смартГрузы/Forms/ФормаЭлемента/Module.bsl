	Элементы.СкладПолучатель.ТолькоПросмотр = Объект.Принят;
	
	Если Параметры.Ключ.Пустая() Тогда 
		
		//++ #7624 смарт: Тимофеева 30.07.2026 / Справочник "Грузы". Добавить статус
		//Объект.СтатусГруза = ПредопределенноеЗначение("Перечисление.СтатусыГрузов.ВПути"); 
		Объект.СтатусГруза = ПредопределенноеЗначение("Перечисление.СтатусыГрузов.Формируется");
		//-- #7624 смарт: Тимофеева 30.07.2026 
		
		//++ #Б3634 смарт: Шляпников 26.06.2025 / Проставлять галочку в поле "Поступление одной датой" автоматически
		смартМенятьДатуВЗаказе=Истина;
		//-- #Б3634 смарт: Шляпников 26.06.2025
		
	Иначе
		
		//++#1374 смарт: Балашов 14.06.2023 //Разработать учет закупок в разрезе Контейнеров    
		Если Не ТипЗнч(Отказ) = Тип("Булево") Тогда 
			Отказ = Ложь; 
		КонецЕсли;
		
		смартПолучитьВсеКонтейнерыГруза(Отказ);
		//--#1374 смарт: Балашов 14.06.2023 
		
	КонецЕсли;
	
	//++ #1528 смарт: Фролов 26.10.2023 //смартГрузы версионирование
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	//-- #1528 смарт: Фролов 26.10.2023  
	
	//++ #1621 смарт: Мосолов 05.02.2024 //Грузы. Доработать ПрисоединеныеФайлы  
	
	НастроитьДинамическийСписок();
	
	Список.Параметры.УстановитьЗначениеПараметра("ВладелецФайлов", Объект.Ссылка);  
	
	ЗапрещенныеРасширения = РаботаСФайламиСлужебный.СписокЗапрещенныхРасширений();
	
	УстановитьВидимостьДоступность();
	//-- #1621 смарт: Мосолов 05.02.2024 

КонецПроцедуры

