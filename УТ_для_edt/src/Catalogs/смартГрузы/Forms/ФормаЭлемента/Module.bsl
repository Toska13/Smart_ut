//++ #1638 смарт: Ермаков 20.02.2024 / Грузы. Сделать связь объектов
// Выполняет поиск смежных грузов, в которых есть указанные в таблице контейнеры.
// Выводит дополнительных колонки в таблице СписокКонтейнеров, с гиперссылками на Грузы.
&НаСервере
Процедура СписокКонтейнеровОбновитьИнформациюОСмежныхГрузах()
	
	ТаблицаКонтейнеры = РеквизитФормыВЗначение("СписокКонтейнеров", Тип("ТаблицаЗначений"));
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("МассивКонтейнеров", ТаблицаКонтейнеры.ВыгрузитьКолонку("Контейнер"));
	Запрос.УстановитьПараметр("ТекущийГруз", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	Контейнер, Груз
	|ИЗ 
	|	РегистрСведений.смартСобытияКонтейнеров
	|ГДЕ
	|	Контейнер В (&МассивКонтейнеров) 
	|	И НЕ Контейнер = ЗНАЧЕНИЕ(Справочник.смартКонтейнеры.ПустаяСсылка)
	|	И НЕ Груз = &ТекущийГруз
	|	И НЕ Груз = ЗНАЧЕНИЕ(Справочник.смартГрузы.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	Контейнер ВОЗР, Груз.ДатаПоступления УБЫВ
	|ИТОГИ ПО Контейнер
	|";
	
	// Перебираем контейнеры
	ВыборкаКонтейнеров = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКонтейнеров.Следующий() Цикл
		
		// Находим строку в таблице СписокКонтейнеров
		НайденнаяСтрокаТаблицыКонтейнеры = ТаблицаКонтейнеры.Найти(ВыборкаКонтейнеров.Контейнер, "Контейнер");
		
		Нумератор = 1;
		МассивДобавляемыхРеквизитовФормы = Новый Массив;
		
		// Перебираем грузы, в которые входит контейнер
		ВыборкаГрузов = ВыборкаКонтейнеров.Выбрать();
		Пока ВыборкаГрузов.Следующий() Цикл
			
			ИмяКолонки = "Груз" + Строка(Нумератор); // Груз1
			ЗаголовокКолонки = "Груз - " + Строка(Нумератор); // Груз - 1
			
			// Добавляем в таблицу колонку, если ее нет
			Если ТаблицаКонтейнеры.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				ТаблицаКонтейнеры.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("СправочникСсылка.смартГрузы"), ЗаголовокКолонки);	
			КонецЕсли;
			
			// Присваиваем значение выбранной строке таблицы
			НайденнаяСтрокаТаблицыКонтейнеры[ИмяКолонки] = ВыборкаГрузов.Груз; 
			
			// Формируем реквизиты для таблицы формы СписокКонтейнеров
			РеквизитНайден = Ложь;
			МассивРеквизитов = ЭтаФорма.ПолучитьРеквизиты("СписокКонтейнеров");
			
			Для Каждого РеквизитФормы Из МассивРеквизитов Цикл
				
				Если РеквизитФормы.Имя = ИмяКолонки Тогда
					РеквизитНайден = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не РеквизитНайден Тогда
				
				// Добавляем реквизит (колонку) таблицы
				МассивДобавляемыхРеквизитовФормы.Добавить(
					Новый РеквизитФормы(
							ИмяКолонки, 
							Новый ОписаниеТипов("СправочникСсылка.смартГрузы"), 
							"СписокКонтейнеров", 
							ЗаголовокКолонки)
				);
								
			КонецЕсли;
			
			Нумератор = Нумератор + 1;
			
		КонецЦикла;
		
		Если МассивДобавляемыхРеквизитовФормы.Количество() > 0 Тогда
			
			ЭтаФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитовФормы);
			
			// Добавляем на форму элементы согласно добавленным реквизитам
			Для Каждого РеквизитФормы Из МассивДобавляемыхРеквизитовФормы Цикл
				
				НовыйЭлементФормы = ЭтаФорма.Элементы.Добавить(РеквизитФормы.Имя, Тип("ПолеФормы"), ЭтаФорма.Элементы.СписокКонтейнеров);
				НовыйЭлементФормы.ПутьКДанным = "СписокКонтейнеров." + РеквизитФормы.Имя;
				НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи;  
				НовыйЭлементФормы.ГиперссылкаЯчейки = Истина; 
				НовыйЭлементФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
				
			КонецЦикла;
			
		КонецЕсли;
				
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаКонтейнеры, "СписокКонтейнеров");
	
КонецПроцедуры //-- #1638 смарт: Ермаков 20.02.2024 

