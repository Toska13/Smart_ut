			Элемент.ТекущиеДанные.Груз = Объект.Ссылка;
			Элемент.ТекущиеДанные.Контейнер = ТекКонтейнер;
		КонецЕсли;
		Элементы.СобытияКонтейнера.ОтборСтрок = Новый ФиксированнаяСтруктура("Груз, Контейнер", Объект.Ссылка, ТекКонтейнер);	
	КонецЕсли;	
КонецПроцедуры //--#1374 смарт: Балашов 14.06.2023

//++#1374 смарт: Балашов 14.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Процедура смартПолучитьВсеКонтейнерыГруза(Отказ)
	//найдем все контейнеры груза 
	//проверим есть ли "пустые" контейнеры перед записью
//	Отмена = ложь; 
	Если Отказ Тогда Возврат КонецЕсли;

	Для Каждого текКонтейнер Из СписокКонтейнеров Цикл
		Если текКонтейнер.Контейнер = Справочники.смартКонтейнеры.ПустаяСсылка() Тогда 
			Сообщить("В списке контейнеров присутствует ""пустой"" контейнер. Запись невозможна.");
			Отказ = истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Если Отказ Тогда Возврат КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.смартСобытияКонтейнеров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Груз.Установить(Объект.Ссылка);
	НаборЗаписей.Прочитать(); 
	//Если НаборЗаписей.Количество() = 0 Тогда
	//	смартЗаписатьИсториюКонтейнеровНаСервере();
	//КонецЕсли;	
	//Если Не Объект.Ссылка = Справочники.смартГрузы.ПустаяСсылка() Тогда
		СобытияКонтейнера.Очистить();
		СписокКонтейнеров.Очистить(); 
	//КонецЕсли;	
	Для Каждого Запись Из НаборЗаписей Цикл
		Отбор = Новый Структура("Контейнер", Запись.Контейнер);
		СтрокиОтбора = СписокКонтейнеров.НайтиСтроки(Отбор);
		Если СтрокиОтбора.Количество() = 0 Тогда
			НовСтрока = СписокКонтейнеров.Добавить();
			НовСтрока.Контейнер = Запись.Контейнер;
		КонецЕсли;	
		//заполним Таблицу событий 
		Если ЗначениеЗаполнено(Запись.ДатаСобытия) Тогда
			НовСобытие = СобытияКонтейнера.Добавить();
			НовСобытие.Груз = Запись.Груз;
			НовСобытие.Контейнер = Запись.Контейнер;
			НовСобытие.ДатаСобытия = Запись.ДатаСобытия;
			НовСобытие.МестоСобытия = Запись.МестоСобытия;
			НовСобытие.СодержаниеСобытия = Запись.СодержаниеСобытия;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры//--#1374 смарт: Балашов 14.06.2023

//++#1374 смарт: Балашов 14.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Процедура смартЗаписатьИсториюКонтейнеровНаСервере()
	//очистим регистр истории по
	НаборЗаписей = РегистрыСведений.смартСобытияКонтейнеров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Груз.Установить(Объект.Ссылка);
	НаборЗаписей.Записать();
	//запишем события контейнеров по грузу
	Для Каждого Элемент Из СписокКонтейнеров Цикл
		//проверим есть ли записи в событиях
		Если ЗначениеЗаполнено(Элемент.Контейнер) Тогда
			СтрокиСобытий = СобытияКонтейнера.НайтиСтроки(Новый Структура("Груз, Контейнер", Объект.Ссылка, Элемент.Контейнер));	
			Если СтрокиСобытий.Количество() > 0 Тогда
				Для Каждого СтрокаСобытия Из СтрокиСобытий Цикл 
					НаборЗаписей.Отбор.Сбросить();
					НаборЗаписей.Отбор.Груз.Установить(Объект.Ссылка);
					НаборЗаписей.Отбор.Контейнер.Установить(Элемент.Контейнер); 
					НаборЗаписей.Отбор.ДатаСобытия.Установить(СтрокаСобытия.ДатаСобытия); 
					НаборЗаписей.Отбор.МестоСобытия.Установить(СтрокаСобытия.МестоСобытия); 
	                НаборЗаписей.Прочитать();
					Запись = НаборЗаписей.Добавить();
					Запись.Груз = Объект.Ссылка;
					Запись.Контейнер = Элемент.Контейнер;
					Запись.ДатаСобытия = СтрокаСобытия.ДатаСобытия;
					Запись.МестоСобытия = СтрокаСобытия.МестоСобытия;
					Запись.СодержаниеСобытия = СтрокаСобытия.СодержаниеСобытия;
					НаборЗаписей.Записать();
				КонецЦикла;	
			Иначе
				НаборЗаписей.Отбор.Сбросить();
				НаборЗаписей.Отбор.Груз.Установить(Объект.Ссылка);
				НаборЗаписей.Отбор.Контейнер.Установить(Элемент.Контейнер); 
	            НаборЗаписей.Прочитать();
				Если НаборЗаписей.Количество() = 0 Тогда
					Запись = НаборЗаписей.Добавить();
				Иначе
					Запись = НаборЗаписей[0];
				КонецЕсли;	
				Запись.Груз = Объект.Ссылка;
				Запись.Контейнер = Элемент.Контейнер;
				НаборЗаписей.Записать();
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры//--#1374 смарт: Балашов 14.06.2023

//++#1374 смарт: Балашов 14.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смартСобытияКонтейнераПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если ЭтотОбъект.СписокКонтейнеров.Количество() = 0 Тогда
		Сообщить("Контейнер не выбран. Добавить событие не возможно.");
		Отказ = истина;
		Возврат;
	Иначе
		ТекКонтейнер = Элементы.СписокКонтейнеров.ТекущиеДанные.Контейнер;
		Если Не ЗначениеЗаполнено(ТекКонтейнер) Тогда
