#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	Принят = Ложь;
	ПланируемаяДатаПоступления = ТекущаяДата();
	ДатаПоступления = Дата(1,1,1);
	СкладПолучатель = Справочники.Склады.ПустаяСсылка();

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("ЭтоНовый", ЭтоНовый());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Справочник.смартГрузы
	|ГДЕ
	|	Наименование = &Наименование
	|	И НЕ ПометкаУдаления
	|	И &ЭтоНовый";

	Если Не Запрос.Выполнить().Пустой() Тогда
		
		ОбщегоНазначения.СообщитьПользователю(
			"Груз с наименовнием " + Наименование + " уже существует. Введите другое наименование.",,,, Отказ);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Добавить("СтатусГруза");
	
КонецПроцедуры

