
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьВидимостьДоступность();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		// ... поля картинки и кнопок его панели
		ЕстьПравоРедактированияКартинки = ПравоДоступа("Редактирование", Метаданные.Справочники.смартIECHOКомплектующие.Реквизиты.ФайлКартинки);
		Элементы.ФайлКартинки.Доступность = ЕстьПравоРедактированияКартинки;
		Элементы.ДобавитьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
		Элементы.ИзменитьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
		Элементы.ОчиститьИзображение.Доступность = ЕстьПравоРедактированияКартинки;
		Элементы.ВыбратьКартинкуИзПрисоединенныхФайлов.Видимость = ЕстьПравоРедактированияКартинки;
		
		ОбновитьАдресКартинки(Ложь);
		
	Иначе
		ЗаполнитьПоПараметрам();
	КонецЕсли;

	//++ смарт:ММ 621 21.09.2021 
	ЭтаФорма.РегистрВопросы.Параметры.УстановитьЗначениеПараметра("ИсходнаяКомплектующая", Объект.Ссылка);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЭтаФорма.РегистрВопросы, "ИсходнаяКомплектующая", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно);
	//-- смарт:ММ 21.09.2021
	
КонецПроцедуры

// ++ 01.02.2021
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Размер = СокрЛП(Объект.Размер);
	Для Каждого СтрокаРазмер Из Объект.РазмерыДляИспользования Цикл
		СтрокаРазмер.Размер = СокрЛП(СтрокаРазмер.Размер);
	КонецЦикла;
	
КонецПроцедуры

// ++ 02.02.2021
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("смартIECHOКомплектующие_Запись");
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ДанныеФайлаКартинки) Тогда
		
		Если ЗначениеЗаполнено(ДанныеФайлаКартинки) Тогда
			
			ПараметрыФайлаКартинки = Новый Структура();
			ПараметрыФайлаКартинки.Вставить("Автор", Пользователи.АвторизованныйПользователь());
			ПараметрыФайлаКартинки.Вставить("ВладелецФайлов", ТекущийОбъект.Ссылка);
			ПараметрыФайлаКартинки.Вставить("ИмяБезРасширения", ДанныеФайлаКартинки.ИмяБезРасширения);
			ПараметрыФайлаКартинки.Вставить("РасширениеБезТочки", ДанныеФайлаКартинки.Расширение);
			ПараметрыФайлаКартинки.Вставить("ВремяИзмененияУниверсальное", ДанныеФайлаКартинки.УниверсальноеВремяИзменения);
			
			ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(
			ПараметрыФайлаКартинки,
			АдресКартинки,
			"",
			"смартIECHOКомплектующиеПрисоединенныеФайлы");
			
			ТекущийОбъект.ФайлКартинки = ПрисоединенныйФайл;
			
			ДанныеФайлаКартинки = Неопределено;
		КонецЕсли;
		
		ТекущийОбъект.Записать();
		Прочитать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоПараметрам()
		
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		
		СправочникОбъект = РеквизитФормыВЗначение("Объект");
		СправочникОбъект.Заполнить(Неопределено);
		//++#1337 смарт: Лопато 10.04.2023 //Ошибка при копировании комплектующих iECHO  
				
		// Новый элемент номенклатуры создан копированием, реквизиты формы заполняются
		// значениями реквизитов параметра копирования.
		ИсточникКопирования = Параметры.ЗначениеКопирования;
		ЗаполнитьЗначенияСвойств(СправочникОбъект, ИсточникКопирования, , "ФайлКартинки, Код, ПометкаУдаления, МоделиДляИспользования, Владелец");
		
		СправочникОбъект.МоделиДляИспользования.Загрузить(ИсточникКопирования.МоделиДляИспользования.Выгрузить());

		ЗначениеВРеквизитФормы(СправочникОбъект, "Объект");
		
		//Если ЗначениеЗаполнено(ИсточникКопирования.ФайлКартинки) Тогда
		//	
		//	СкопироватьПрисоединенныеФайлы(ИсточникКопирования.ФайлКартинки);
		//	
		//КонецЕсли;
		//--#1337 смарт: Лопато 10.04.2023

	КонецЕсли;
	
КонецПроцедуры

