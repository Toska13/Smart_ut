&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_Файл" 
		И Параметр.Свойство("ВладелецФайла") Тогда
		
		Если Параметр.ВладелецФайла = Объект.Ссылка Тогда
			Модифицированность = Истина;
			
			СсылкаНаФайл = ?(ТипЗнч(Источник) = Тип("Массив"), Источник[0], Источник);
							
			Объект.ФайлКартинки = СсылкаНаФайл;
			ОбновитьАдресКартинки(Истина);				
							
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.ОсновнаяКомплектующая Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Model) Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Поле ""Model"" не заполнено", Объект.Ссылка, "Model", "Объект");
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ОграничениеИспользованияПоМоделям Тогда
		Если Объект.МоделиДляИспользования.Количество() = 0 Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Таблица ""Модели для использования"" не заполнена", Объект.Ссылка, "МоделиДляИспользования", "Объект");
		КонецЕсли;	
	КонецЕсли;
	
	// ++ 01.02.2021
	Если Объект.ОграничениеИспользованияПоРазмеру Тогда
		Если Объект.РазмерыДляИспользования.Количество() = 0 Тогда
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Таблица ""Размеры для использования"" не заполнена", Объект.Ссылка, "РазмерыДляИспользования", "Объект");
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры


