			<dataPath>СуммаОстатокОтгрузка</dataPath>
			<field>СуммаОстатокОтгрузка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаОтгрузки</dataPath>
			<field>СуммаОтгрузки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Шаблон</dataPath>
			<field>Шаблон</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	CRM_ЖурналДокументов.CRM_Интерес КАК ОбъектДействия,
	CRM_ЖурналДокументов.CRM_Интерес.СостояниеИнтереса КАК СостояниеИнтереса,
	CRM_СчетНаОплатуПокупателю.Ссылка КАК Ссылка,
	CRM_СчетНаОплатуПокупателю.Проведен КАК Проведен,
	CRM_СчетНаОплатуПокупателю.ПометкаУдаления КАК ПометкаУдаления,
	CRM_СчетНаОплатуПокупателю.Дата КАК Дата,
	CRM_СчетНаОплатуПокупателю.Номер КАК Номер,
	CRM_СчетНаОплатуПокупателю.Автор КАК Автор,
	CRM_СчетНаОплатуПокупателю.БанковскийСчет КАК БанковскийСчет,
	CRM_СчетНаОплатуПокупателю.Важность КАК Важность,
	CRM_СчетНаОплатуПокупателю.Валюта КАК Валюта,
	CRM_СчетНаОплатуПокупателю.ВидСкидкиНаценки КАК ВидСкидкиНаценки,
	CRM_СчетНаОплатуПокупателю.ВидЦен КАК ВидЦен,
	CRM_СчетНаОплатуПокупателю.Договор КАК Договор,
	CRM_СчетНаОплатуПокупателю.ДокументОснование КАК ДокументОснование,
	CRM_СчетНаОплатуПокупателю.Комментарий КАК Комментарий,
	CRM_СчетНаОплатуПокупателю.КонтактноеЛицо КАК КонтактноеЛицо,
	CRM_СчетНаОплатуПокупателю.Кратность КАК Кратность,
	CRM_СчетНаОплатуПокупателю.Курс КАК Курс,
	CRM_СчетНаОплатуПокупателю.НеВыгружатьВБухгалтерию КАК НеВыгружатьВБухгалтерию,
	CRM_СчетНаОплатуПокупателю.Организация КАК Организация,
	CRM_СчетНаОплатуПокупателю.Ответственный КАК Ответственный,
	CRM_СчетНаОплатуПокупателю.Партнер КАК Партнер,
	CRM_СчетНаОплатуПокупателю.Проект КАК Проект,
	CRM_СчетНаОплатуПокупателю.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	CRM_СчетНаОплатуПокупателю.СуммаДокумента КАК СуммаДокумента,
	CRM_СчетНаОплатуПокупателю.СуммаОплаты КАК СуммаОплаты,
	CRM_СчетНаОплатуПокупателю.СуммаОстатокОплата КАК СуммаОстатокОплата,
	CRM_СчетНаОплатуПокупателю.СуммаОстатокОтгрузка КАК СуммаОстатокОтгрузка,
	CRM_СчетНаОплатуПокупателю.СуммаОтгрузки КАК СуммаОтгрузки,
	CRM_СчетНаОплатуПокупателю.Подразделение КАК Подразделение,
	CRM_СчетНаОплатуПокупателю.АдресХранилищаФайлов КАК АдресХранилищаФайлов,
	CRM_СчетНаОплатуПокупателю.Шаблон КАК Шаблон
ИЗ
	Документ.CRM_СчетНаОплатуПокупателю КАК CRM_СчетНаОплатуПокупателю
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
		ПО (CRM_ЖурналДокументов.Объект = CRM_СчетНаОплатуПокупателю.Ссылка)
			И (CRM_ЖурналДокументов.ГлавнаяЗапись)
			И (CRM_ЖурналДокументов.CRM_Интерес &lt;&gt; ЗНАЧЕНИЕ(Документ.CRM_Интерес.ПустаяСсылка))
ГДЕ
	CRM_СчетНаОплатуПокупателю.Ссылка = &amp;Ссылка</query>
	</dataSet>
	<parameter>
		<name>Ссылка</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Ссылка</v8:content>
			</v8:item>
			<v8:item>
				<v8:lang>en</v8:lang>
				<v8:content>Reference</v8:content>
			</v8:item>
		</title>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows"/>
	</settingsVariant>
</DataCompositionSchema>