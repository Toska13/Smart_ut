
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Номенклатура", 	Номенклатура);
	Параметры.Свойство("Серия", 		Серия);
	Заголовок				= СтрШаблон("Вывод из оборота %1%2", Номенклатура, ?(ЗначениеЗаполнено(Серия), ", " + Серия, ""));
	ТипНазначения   		= Перечисления.ТипыНазначений.смартТоварВыведенныйИзОборота;
	ПредставлениеНазначения = СформироватьПредставление();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПричинаВыводаТоваровИзОборотаПриИзменении(Элемент) 
	ПредставлениеНазначения = СформироватьПредставление();
	Элементы.УточнениеПричиныВыводаИзОборота.Видимость = ПричинаВыводаТоваровИзОборота = ПредопределенноеЗначение("Перечисление.смартПричиныВыводаТоваровИзОборота.Другое");
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеНазначенияПриИзменении(Элемент)
	ПредставлениеНазначения = СформироватьПредставление();
КонецПроцедуры

&НаКлиенте
Процедура УточнениеПричиныВыводаИзОборотаПриИзменении(Элемент)
	ПредставлениеНазначения = СформироватьПредставление();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	Если НЕ ЗначениеЗаполнено(ПричинаВыводаТоваровИзОборота) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите причину вывода товара из оборота", , "ПричинаВыводаТоваровИзОборота");
		Возврат;
	КонецЕсли;
	Если ПричинаВыводаТоваровИзОборота = ПредопределенноеЗначение("Перечисление.смартПричиныВыводаТоваровИзОборота.Другое")
		И НЕ ЗначениеЗаполнено(УточнениеПричиныВыводаИзОборота) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Уточните причину вывода товара из оборота", , "УточнениеПричиныВыводаИзОборота");
		Возврат;
	КонецЕсли;

	НовоеНазначениеСсылка = СоздатьНовоеНазначение(); 
	Если НЕ НовоеНазначениеСсылка = Неопределено Тогда
		Закрыть(НовоеНазначениеСсылка); 
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось записать новое назначение!");
	КонецЕсли;
КонецПроцедуры 

#КонецОбласти  

#Область СлужебныеПроцедурыИФункции 

&НаСервере
Функция СоздатьНовоеНазначение()  
	УстановитьПривилегированныйРежим(Истина);
	НазначениеОбъект = Справочники.Назначения.СоздатьЭлемент();

	НазначениеОбъект.ТипНазначения           				= ТипНазначения;
	НазначениеОбъект.Наименование            				= ПредставлениеНазначения;
	НазначениеОбъект.ДвиженияПоСкладскимРегистрам 			= Истина;
	НазначениеОбъект.КонтролироватьТолькоНаличие    		= Истина;
    НазначениеОбъект.смартПричинаВыводаИзОборота 			= ПричинаВыводаТоваровИзОборота; 
	Если ПричинаВыводаТоваровИзОборота = ПредопределенноеЗначение("Перечисление.смартПричиныВыводаТоваровИзОборота.Другое") Тогда
		НазначениеОбъект.смартУточнениеПричиныВыводаИзОборота = УточнениеПричиныВыводаИзОборота;
	КонецЕсли;
	
	НазначениеОбъект.смартВыведеннаяИзОборотаНоменклатура	= Номенклатура;
	НазначениеОбъект.смартВыведеннаяИзОборотаСерия          = Серия;
	
	Попытка
		НазначениеОбъект.Записать();
	Исключение 
		Возврат Неопределено;
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат НазначениеОбъект.Ссылка;	
КонецФункции  

&НаСервере
Функция СформироватьПредставление()
	
	Возврат СтрШаблон("Товар выведенный из оборота, %1, %2%3",
		?(ПричинаВыводаТоваровИзОборота = ПредопределенноеЗначение("Перечисление.смартПричиныВыводаТоваровИзОборота.Другое"), УточнениеПричиныВыводаИзОборота, ПричинаВыводаТоваровИзОборота),
		Номенклатура,
		?(ЗначениеЗаполнено(Серия), ", " + Серия, ""));
	
КонецФункции

#КонецОбласти
