
/////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.МестоПроведения = Справочники.смартПредопределенныеЗначения.Настройки.СкладДемозалМоскваСмарт;	
		Объект.Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.МестоПроведения, "Подразделение");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Объект.МестоПроведения = ПолучитьДемоЗалПоПодразделению(Объект.Подразделение);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

/////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьДемоЗалПоПодразделению(Подразделение)
	Результат = Справочники.смартПредопределенныеЗначения.Настройки.СкладДемозалМоскваСмарт;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Подразделение = &Подразделение
	|	И Склады.смартНазначениеСклада = ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ДемоЗал)";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
