#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.Ответственный = Пользователи.АвторизованныйПользователь();
		
		Если Параметры.Свойство("Номенклатура") Тогда
			
			УстановитьПривилегированныйРежим(Истина);
			
			Объект.Номенклатура = Параметры.Номенклатура;
			Объект.Наименование = Объект.Номенклатура.Наименование;
			Объект.Бренд = Объект.Номенклатура.Марка;
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("НаборСвойств", Объект.Номенклатура);
			Запрос.Текст =
			"ВЫБРАТЬ
			|	СмартЗначенияСвойствФильтров.Значение КАК Значение,
			|	СмартЗначенияСвойствФильтров.ЗначениеСтрока КАК ЗначениеСтрока,
			|	СмартЗначенияСвойствФильтров.ВидСвойств КАК ВидСвойств,
			|	СмартЗначенияСвойствФильтров.ВидСвойств.Множественное КАК Множественное
			|ИЗ
			|	РегистрСведений.СмартЗначенияСвойствФильтров КАК СмартЗначенияСвойствФильтров
			|ГДЕ
			|	СмартЗначенияСвойствФильтров.НаборСвойств = &НаборСвойств
			|	И СмартЗначенияСвойствФильтров.ВидСвойств.Код В (""000000002"", ""000000054"", ""000000006"", ""000000083"", ""000000024"")";
			
			ТЗ = Новый ТаблицаЗначений;
			ТЗ.Колонки.Добавить("ВидСвойств", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.СмартФильтрыНоменклатуры"));
			ТЗ.Колонки.Добавить("Значение", Новый ОписаниеТипов("СправочникСсылка.СмартДопФильтрыНоменклатуры"));
			ТЗ.Колонки.Добавить("ЗначениеСтрока", ОбщегоНазначения.ОписаниеТипаСтрока(100));
			ТЗ.Колонки.Добавить("Множественное", Новый ОписаниеТипов("Булево"));
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.Множественное Тогда
					
					МассивЗначений = СтрРазделить(Выборка.ЗначениеСтрока, ";");
					Для каждого стрЗначение Из МассивЗначений Цикл
						
						НоваяСтрока = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "ВидСвойств,Множественное");
						НоваяСтрока.ЗначениеСтрока = стрЗначение;
						
					КонецЦикла;
					
				Иначе
					
					НоваяСтрока = ТЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Запрос.УстановитьПараметр("ТЗ", ТЗ);
			Запрос.Текст = "ВЫБРАТЬ
			               |	Т.ВидСвойств КАК ВидСвойств,
			               |	Т.Значение КАК Значение,
			               |	Т.ЗначениеСтрока КАК ЗначениеСтрока,
			               |	Т.Множественное КАК Множественное
			               |ПОМЕСТИТЬ ВТТЗ
			               |ИЗ
			               |	&ТЗ КАК Т
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ РАЗЛИЧНЫЕ
			               |	ВТТЗ.ВидСвойств КАК ВидСвойств,
			               |	ВЫБОР
			               |		КОГДА ВТТЗ.Множественное
			               |			ТОГДА ЕСТЬNULL(СмартДопФильтрыНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.СмартДопФильтрыНоменклатуры.ПустаяСсылка))
			               |		ИНАЧЕ ВТТЗ.Значение
			               |	КОНЕЦ КАК Значение
			               |ПОМЕСТИТЬ ВТЗначенияФильтров
			               |ИЗ
			               |	ВТТЗ КАК ВТТЗ
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СмартДопФильтрыНоменклатуры КАК СмартДопФильтрыНоменклатуры
			               |		ПО ВТТЗ.ВидСвойств = СмартДопФильтрыНоменклатуры.Владелец
			               |			И ВТТЗ.ЗначениеСтрока = СмартДопФильтрыНоменклатуры.Наименование
			               |			И (ВТТЗ.Множественное)
			               |ГДЕ
			               |	ВЫБОР
			               |			КОГДА ВТТЗ.Множественное
			               |				ТОГДА ЕСТЬNULL(СмартДопФильтрыНоменклатуры.Ссылка, ЗНАЧЕНИЕ(Справочник.СмартДопФильтрыНоменклатуры.ПустаяСсылка))
			               |			ИНАЧЕ ВТТЗ.Значение
			               |		КОНЕЦ <> ЗНАЧЕНИЕ(Справочник.СмартДопФильтрыНоменклатуры.ПустаяСсылка)
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	смартЦветовыеКонфигурацииФильтрыНоменклатуры.Ссылка КАК ЦветоваяКонфигурация
			               |ИЗ
			               |	Справочник.смартЦветовыеКонфигурации.ФильтрыНоменклатуры КАК смартЦветовыеКонфигурацииФильтрыНоменклатуры
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗначенияФильтров КАК ВТЗначенияФильтров
			               |		ПО смартЦветовыеКонфигурацииФильтрыНоменклатуры.Значение = ВТЗначенияФильтров.Значение
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	смартТехнологииПечати.Ссылка КАК ТехнологияПечати
			               |ИЗ
			               |	Справочник.смартТехнологииПечати.ФильтрыНоменклатуры КАК смартТехнологииПечати
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗначенияФильтров КАК ВТЗначенияФильтров
			               |		ПО смартТехнологииПечати.Значение = ВТЗначенияФильтров.Значение
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	смартФорматыПринтеров.Ссылка КАК ФорматПринтера
			               |ИЗ
			               |	Справочник.смартФорматыПринтеров.ФильтрыНоменклатуры КАК смартФорматыПринтеров
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗначенияФильтров КАК ВТЗначенияФильтров
			               |		ПО смартФорматыПринтеров.Значение = ВТЗначенияФильтров.Значение
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	смартШиринаПечати.Ссылка КАК ШиринаПечати
			               |ИЗ
			               |	Справочник.смартШиринаПечати.ФильтрыНоменклатуры КАК смартШиринаПечати
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТЗначенияФильтров КАК ВТЗначенияФильтров
			               |		ПО смартШиринаПечати.Значение = ВТЗначенияФильтров.Значение";
			
			Пакет = Запрос.ВыполнитьПакет();
			
			Если НЕ Пакет[Пакет.Количество() - 4].Пустой() Тогда
				
				Выборка = Пакет[Пакет.Количество() - 4].Выбрать();
				Выборка.Следующий();
				НоваяСтрока = Объект.ЦветовыеСхемы.Добавить();
				НоваяСтрока.ЦветоваяСхема = Выборка.ЦветоваяКонфигурация;
				
			КонецЕсли;
			
			Если НЕ Пакет[Пакет.Количество() - 3].Пустой() Тогда
				
				Выборка = Пакет[Пакет.Количество() - 3].Выбрать();
				Выборка.Следующий();
				Объект.ТехнологияПечати = Выборка.ТехнологияПечати;
				
			КонецЕсли;
			
			Если НЕ Пакет[Пакет.Количество() - 2].Пустой() Тогда
				
				Выборка = Пакет[Пакет.Количество() - 2].Выбрать();
				Выборка.Следующий();
				Объект.ФорматПринтера = Выборка.ФорматПринтера;
				
			КонецЕсли;
			
			Если НЕ Пакет[Пакет.Количество() - 1].Пустой() Тогда
				
				Выборка = Пакет[Пакет.Количество() - 1].Выбрать();
				Выборка.Следующий();
				Объект.ШиринаПечати = Выборка.ШиринаПечати;
				
			КонецЕсли;
			
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ПолучитьПВХЧернила()));
	Элементы.РекомендуемыеЧернилаЧернила.ПараметрыВыбора = Новый ФиксированныйМассив(Массив);
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ОбновитьАдресКартинки();
	
	//++ #Б-3688 смарт: Фролов 02.07.2025 //Доработка НСИ Конструктора КП. 
	ЭтаФорма.ОсновныеФишкиПоле = ТекущийОбъект.ОсновныеФишки.Получить();
	//-- #Б-3688 смарт: Фролов 02.07.2025
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ДанныеФайлаКартинки) ИЛИ ЗначениеЗаполнено(ДанныеФайлаКартинкиПечатающейГоловки) Тогда
		
		Если ЗначениеЗаполнено(ДанныеФайлаКартинки) Тогда
			
			ПараметрыФайлаКартинки = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайлаКартинки.Автор				= Пользователи.АвторизованныйПользователь();
			ПараметрыФайлаКартинки.ВладелецФайлов		= ТекущийОбъект.Ссылка;
			ПараметрыФайлаКартинки.ИмяБезРасширения		= ДанныеФайлаКартинки.ИмяБезРасширения;
			ПараметрыФайлаКартинки.РасширениеБезТочки	= ДанныеФайлаКартинки.Расширение;
			
			ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайлаКартинки, АдресКартинки);
			
			ТекущийОбъект.ФайлКартинки = ПрисоединенныйФайл;
			
			ДанныеФайлаКартинки = Неопределено;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеФайлаКартинкиПечатающейГоловки) Тогда
			
			ПараметрыФайлаКартинки = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайлаКартинки.Автор				= Пользователи.АвторизованныйПользователь();
			ПараметрыФайлаКартинки.ВладелецФайлов		= ТекущийОбъект.Ссылка;
			ПараметрыФайлаКартинки.ИмяБезРасширения		= ДанныеФайлаКартинкиПечатающейГоловки.ИмяБезРасширения;
			ПараметрыФайлаКартинки.РасширениеБезТочки	= ДанныеФайлаКартинкиПечатающейГоловки.Расширение;
			
			ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайлаКартинки, АдресКартинкиПечатающейГоловки);
			
			ТекущийОбъект.ФайлКартинкиПечатающейГоловки = ПрисоединенныйФайл;
			
			ДанныеФайлаКартинкиПечатающейГоловки = Неопределено;
			
		КонецЕсли;
		
		ТекущийОбъект.Записать();
		
		Прочитать();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("смартЗаписанКонструкторОборудования", Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) И ЗначениеЗаполнено(ТекущийОбъект.Номенклатура) И НЕ ЗначениеЗаполнено(ТекущийОбъект.Родитель) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка,
		|	ЭтоГруппа КАК ЭтоГруппа,
		|	Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура
		|ГДЕ
		|	Ссылка = &Ссылка
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
		
		Запрос.УстановитьПараметр("Ссылка", ТекущийОбъект.Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		ТекущийРодитель = Справочники.смартКонструкторОборудования.ПустаяСсылка();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.смартКонструкторОборудования
		|ГДЕ
		|	Наименование = &Наименование
		|	И Родитель = &Родитель
		|	И ЭтоГруппа";
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ЭтоГруппа Тогда
				
				Запрос.УстановитьПараметр("Наименование", Выборка.Наименование);
				Запрос.УстановитьПараметр("Родитель", ТекущийРодитель);
				
				ВыборкаРодитель = Запрос.Выполнить().Выбрать();
				
				Если ВыборкаРодитель.Следующий() Тогда
					ТекущийРодитель = ВыборкаРодитель.Ссылка;
				Иначе
					
					НоваяГруппа = Справочники.смартКонструкторОборудования.СоздатьГруппу();
					НоваяГруппа.Наименование = Выборка.Наименование;
					НоваяГруппа.Родитель = ТекущийРодитель;
					НоваяГруппа.Записать();
					
					ТекущийРодитель = НоваяГруппа.Ссылка;
					
				КонецЕсли;
				
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ТекущийОбъект.Родитель = ТекущийРодитель;
		
	КонецЕсли;
	
	//++ #Б-3688 смарт: Фролов 02.07.2025 //Доработка НСИ Конструктора КП.
	ТекущийОбъект.ОсновныеФишки = Новый ХранилищеЗначения(ЭтаФорма.ОсновныеФишкиПоле);
	//-- #Б-3688 смарт: Фролов 02.07.2025
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") И ВыбранноеЗначение.Количество() > 0 Тогда
	
		Если ИсточникВыбора.ИмяФормы = "Справочник.смартВидыМатериалов.Форма.ФормаВыбора" Тогда
			
			Для каждого стрМатериал Из ВыбранноеЗначение Цикл
				
				Если Объект.Материалы.НайтиСтроки(Новый Структура("Материал", стрМатериал)).Количество() = 0 Тогда
					НоваяСтрока = Объект.Материалы.Добавить();
					НоваяСтрока.Материал = стрМатериал;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.смартПроизводимаяПродукция.Форма.ФормаВыбора" Тогда
			
			Для каждого стрПрименение Из ВыбранноеЗначение Цикл
				
				Если Объект.Применения.НайтиСтроки(Новый Структура("Применяется", стрПрименение)).Количество() = 0 Тогда
					НоваяСтрока = Объект.Применения.Добавить();
					НоваяСтрока.Применяется = стрПрименение;
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.СмартДопФильтрыНоменклатуры.ФормаВыбора" Тогда
			
			Для каждого стрЧернила Из ВыбранноеЗначение Цикл
				
				Если Объект.РекомендуемыеЧернила.НайтиСтроки(Новый Структура("Чернила", стрЧернила)).Количество() = 0 Тогда
					НоваяСтрока = Объект.РекомендуемыеЧернила.Добавить();
					НоваяСтрока.Чернила = стрЧернила;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПроверяемыйРеквизит = "АдресКартинки";
	Если Элемент.Имя = "ФайлКартинкиПечатающейГоловки" Тогда
		ПроверяемыйРеквизит = "АдресКартинкиПечатающейГоловки";
	КонецЕсли;
	
	Если ПустаяСтрока(ЭтаФорма[ПроверяемыйРеквизит]) Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
		ПриДобавленииИзображения(Элемент.Имя);
	Иначе
		ТекстСообщения = НСтр("ru='Отсутствует изображение для просмотра'");
		
		ПросмотретьПрисоединенныйФайл(Элемент.Имя, ПроверяемыйРеквизит, ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

