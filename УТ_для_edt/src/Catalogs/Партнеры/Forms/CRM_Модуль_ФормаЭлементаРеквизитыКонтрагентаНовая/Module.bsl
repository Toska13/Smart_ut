		ПараметрыДополнения.Вставить("УчетнаяЗапись", БыстрыйВвод_ЧатУчетнаяЗапись);
		ПараметрыДополнения.Вставить("ПартнерыКИ", ЭтотОбъект["КонтактнаяИнформацияОписаниеДополнительныхРеквизитов"]);
		
