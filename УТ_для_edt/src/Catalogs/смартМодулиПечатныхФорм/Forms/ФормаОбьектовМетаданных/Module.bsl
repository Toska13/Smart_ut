
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивГруппы = Новый Массив;
	МассивГруппы.Добавить(Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоНаименованию("Справочники"));
	МассивГруппы.Добавить(Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоНаименованию("Документы"));
	
	Список.Параметры.УстановитьЗначениеПараметра("Группы", МассивГруппы);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	НажалиВыбрать();

КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	НажалиВыбрать();
	
КонецПроцедуры

&НаКлиенте
Процедура НажалиВыбрать()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбран элемент";
		Сообщение.Сообщить(); 
		
		Возврат;
		
	ИначеЕсли Строка(ТекДанные.Ссылка) = "Документы" ИЛИ Строка(ТекДанные.Ссылка) = "Справочники" Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Выберите тип документа или справочника";
		Сообщение.Сообщить(); 
		
		Закрыть(Неопределено);
		
	Иначе	
		
		Закрыть(ТекДанные.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры


