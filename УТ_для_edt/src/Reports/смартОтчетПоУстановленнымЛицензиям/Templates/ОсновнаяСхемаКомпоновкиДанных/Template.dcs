			<field>ДатаУстановкиПостояннойЛицензии</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	смартЛицензииПО.Период КАК Период,
	смартЛицензииПО.Заявка КАК Заявка,
	смартЛицензииПО.Номенклатура КАК Номенклатура,
	смартЛицензииПО.Серия КАК Серия,
	смартЛицензииПО.ТипЛицензии КАК ТипЛицензии,
	смартЛицензииПО.СерийныйНомер КАК СерийныйНомер,
	смартЛицензииПО.ДатаОкончания КАК ДатаОкончания,
	смартЛицензииПО.ДатаУстановкиПостояннойЛицензии КАК ДатаУстановкиПостояннойЛицензии
{ВЫБРАТЬ
	Период,
	Заявка.*,
	Номенклатура.*,
	Серия.*,
	ТипЛицензии.*,
	СерийныйНомер,
	ДатаОкончания,
	ДатаУстановкиПостояннойЛицензии}
ИЗ
	РегистрСведений.смартЛицензииПО КАК смартЛицензииПО
ГДЕ
	ВЫБОР
		КОГДА &amp;ТипЛицензии = ЗНАЧЕНИЕ(Перечисление.смартТипыЛицензии.ПустаяСсылка) 
				ИЛИ &amp;ТипЛицензии = НЕОПРЕДЕЛЕНО
			ТОГДА 
				ИСТИНА
			ИНАЧЕ 
				смартЛицензииПО.ТипЛицензии = &amp;ТипЛицензии
		КОНЕЦ
	 И ВЫБОР 
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1) И &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ТОГДА
				ИСТИНА
			КОГДА &amp;ДатаНачала &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) И &amp;ДатаОкончания &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) ТОГДА
				ВЫБОР 
				  	КОГДА смартЛицензииПО.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ТОГДА
					 	смартЛицензииПО.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания  
				    КОГДА смартЛицензииПО.ДатаОкончания &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) ТОГДА 
						смартЛицензииПО.Период МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания 
							ИЛИ смартЛицензииПО.ДатаОкончания МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
				КОНЕЦ	 
			КОГДА &amp;ДатаНачала = ДАТАВРЕМЯ(1, 1, 1) И &amp;ДатаОкончания &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) ТОГДА				
				ВЫБОР 
				  	КОГДА смартЛицензииПО.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ТОГДА
						смартЛицензииПО.Период &lt;= &amp;ДатаОкончания 
				    КОГДА смартЛицензииПО.ДатаОкончания &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) ТОГДА 
						смартЛицензииПО.Период &lt;= &amp;ДатаОкончания 
						ИЛИ смартЛицензииПО.ДатаОкончания &lt;= &amp;ДатаОкончания 
				  КОНЕЦ
			КОГДА &amp;ДатаНачала &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) И &amp;ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ТОГДА				
				ВЫБОР 
				  	КОГДА смартЛицензииПО.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ТОГДА
						смартЛицензииПО.Период &gt;= &amp;ДатаНачала 
				    КОГДА смартЛицензииПО.ДатаОкончания &lt;&gt; ДАТАВРЕМЯ(1, 1, 1) ТОГДА 
						смартЛицензииПО.Период &gt;= &amp;ДатаНачала 
						ИЛИ смартЛицензииПО.ДатаОкончания &gt;= &amp;ДатаНачала 
				  КОНЕЦ
		КОНЕЦ
{ГДЕ
	смартЛицензииПО.Период,
	смартЛицензииПО.ДатаОкончания,
	смартЛицензииПО.ДатаУстановкиПостояннойЛицензии,
	смартЛицензииПО.Заявка.*,
	смартЛицензииПО.Номенклатура.*,
	смартЛицензииПО.Серия.*,
	смартЛицензииПО.СерийныйНомер}</query>
