				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>СуммаЗадолженности</dataPath>
				<field>СуммаЗадолженности</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаВыхода</dataPath>
				<field>ДатаВыхода</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата выхода</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Организация</dataPath>
				<field>Организация</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДниПросрочкиКалендарные</dataPath>
				<field>ДниПросрочкиКалендарные</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дни просрочки календарные</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ВидКредитногоДоверия</dataPath>
				<field>ВидКредитногоДоверия</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Вид кредитного доверия</v8:content>
					</v8:item>
				</title>
				<useRestriction>
					<condition>true</condition>
				</useRestriction>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаВозникновенияПросрочки</dataPath>
				<field>ДатаВозникновенияПросрочки</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата возникновения просрочки</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>АналитикаУчетаПоПартнерам</dataPath>
				<field>АналитикаУчетаПоПартнерам</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Валюта</dataPath>
				<field>Валюта</field>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ПартнерыСегмента.Партнер КАК Партнер
ПОМЕСТИТЬ ВТ_КлиентыИсключенияДляСтопЛиста
ИЗ
	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
ГДЕ
	ПартнерыСегмента.Сегмент = &amp;Сегмент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	смартСтопЛистТехническойОтсрочки.Партнер КАК Партнер,
	смартСтопЛистТехническойОтсрочки.Контрагент КАК Контрагент,
	смартСтопЛистТехническойОтсрочки.ЗаказКлиента КАК ЗаказКлиента,
	смартСтопЛистТехническойОтсрочки.Период КАК ДатаВозникновенияПросрочки,
	ЕСТЬNULL(смартСтопЛистТехническойОтсрочки1.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК ДатаВыхода,
	ВЫБОР
		КОГДА смартСтопЛистТехническойОтсрочки1.Период ЕСТЬ NULL
				И &amp;НаДату = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
			ТОГДА РАЗНОСТЬДАТ(смартСтопЛистТехническойОтсрочки.Период, &amp;ТекущаяДата, ДЕНЬ)
		КОГДА смартСтопЛистТехническойОтсрочки1.Период ЕСТЬ NULL 
				И смартСтопЛистТехническойОтсрочки.Период &lt; &amp;НаДату
			ТОГДА РАЗНОСТЬДАТ(смартСтопЛистТехническойОтсрочки.Период, &amp;НаДату, ДЕНЬ)
		КОГДА смартСтопЛистТехническойОтсрочки1.Период ЕСТЬ NULL 
				И смартСтопЛистТехническойОтсрочки.Период &gt;= &amp;НаДату
			ТОГДА 0
		ИНАЧЕ РАЗНОСТЬДАТ(смартСтопЛистТехническойОтсрочки.Период, смартСтопЛистТехническойОтсрочки1.Период, ДЕНЬ)
	КОНЕЦ КАК ДниПросрочкиКалендарные,
	смартСтопЛистТехническойОтсрочки.СуммаЗадолженности КАК СуммаЗадолженности,
	смартСтопЛистТехническойОтсрочки.РасчетныйДокумент КАК РасчетныйДокумент
ПОМЕСТИТЬ ВТ_СтопЛист
ИЗ
	РегистрСведений.смартСтопЛистТехническойОтсрочки КАК смартСтопЛистТехническойОтсрочки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСтопЛистТехническойОтсрочки КАК смартСтопЛистТехническойОтсрочки1
		ПО смартСтопЛистТехническойОтсрочки.Партнер = смартСтопЛистТехническойОтсрочки1.Партнер
			И смартСтопЛистТехническойОтсрочки.Контрагент = смартСтопЛистТехническойОтсрочки1.Контрагент
			И смартСтопЛистТехническойОтсрочки.ЗаказКлиента = смартСтопЛистТехническойОтсрочки1.ЗаказКлиента
			И (НЕ смартСтопЛистТехническойОтсрочки1.ПродажаОтгрузкаЗапрещена)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
		ПО смартСтопЛистТехническойОтсрочки.Партнер = Партнеры.Ссылка
ГДЕ
	смартСтопЛистТехническойОтсрочки.ПродажаОтгрузкаЗапрещена
	И НЕ смартСтопЛистТехническойОтсрочки.Партнер В
				(ВЫБРАТЬ
					ВТ_КлиентыИсключенияДляСтопЛиста.Партнер
				ИЗ
					ВТ_КлиентыИсключенияДляСтопЛиста)
{ГДЕ
	(смартСтопЛистТехническойОтсрочки.Период &lt;= &amp;НаДату
			//И (смартСтопЛистТехническойОтсрочки1.Период &gt;= &amp;НаДату
			//	ИЛИ смартСтопЛистТехническойОтсрочки1.Период ЕСТЬ NULL)
				),
	(Партнеры.смартОсновнойМенеджерСервисЦентра = &amp;Менеджер
			ИЛИ Партнеры.смартМенеджерПоРасходнымМатериалам = &amp;Менеджер)}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокЗаказКлиента.Организация КАК Организация,
	ВТ_СтопЛист.Партнер КАК Партнер,
	ВТ_СтопЛист.Контрагент КАК Контрагент,
	ВТ_СтопЛист.ЗаказКлиента КАК ЗаказКлиента,
	ВТ_СтопЛист.ДатаВозникновенияПросрочки КАК ДатаВозникновенияПросрочки,
	ВТ_СтопЛист.ДатаВыхода КАК ДатаВыхода,
	ВТ_СтопЛист.ДниПросрочкиКалендарные КАК ДниПросрочкиКалендарные,
	"Техническая отсрочка" КАК ВидКредитногоДоверия,
	РасчетыСКлиентамиОстатки.СуммаОстаток КАК СуммаЗадолженности
ИЗ
	ВТ_СтопЛист КАК ВТ_СтопЛист
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентами.Остатки(
				{(&amp;НаДату)},
				ЗаказКлиента В
					(ВЫБРАТЬ
						ВТ.ЗаказКлиента
					ИЗ
						ВТ_СтопЛист КАК ВТ)) КАК РасчетыСКлиентамиОстатки
		ПО ВТ_СтопЛист.ЗаказКлиента = РасчетыСКлиентамиОстатки.ЗаказКлиента
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ДокЗаказКлиента
		ПО ВТ_СтопЛист.ЗаказКлиента = ДокЗаказКлиента.Ссылка
{ГДЕ
	(&amp;ВидКредитногоДоверия = "СтопЛист")}</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>ОтсрочкаПоДоговору</name>
