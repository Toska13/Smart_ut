				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>АналитикаУчетаПоПартнерам</dataPath>
				<field>АналитикаУчетаПоПартнерам</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаПлановогоПогашения</dataPath>
				<field>ДатаПлановогоПогашения</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаВозникновения</dataPath>
				<field>ДатаВозникновения</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>СуммаЗадолженности</dataPath>
				<field>СуммаЗадолженности</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сумма задолженности</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Организация</dataPath>
				<field>Организация</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Контрагент</dataPath>
				<field>Контрагент</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Партнер</dataPath>
				<field>Партнер</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ЗаказКлиента</dataPath>
				<field>ЗаказКлиента</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Заказ клиента</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ВидКредитногоДоверия</dataPath>
				<field>ВидКредитногоДоверия</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Вид кредитного доверия</v8:content>
					</v8:item>
				</title>
				<useRestriction>
					<condition>true</condition>
				</useRestriction>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаВозникновенияПросрочки</dataPath>
				<field>ДатаВозникновенияПросрочки</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата возникновения просрочки</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДниПросрочкиКалендарные</dataPath>
				<field>ДниПросрочкиКалендарные</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дни просрочки календарные</v8:content>
					</v8:item>
				</title>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ДатаВыхода</dataPath>
				<field>ДатаВыхода</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Дата выхода</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ПартнерыСегмента.Партнер КАК Партнер
ПОМЕСТИТЬ ВТ_КлиентыИсключенияДляСтопЛиста
ИЗ
	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
ГДЕ
	ПартнерыСегмента.Сегмент = &amp;Сегмент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КлючиАналитикиУчетаПоПартнерам.Организация КАК Организация,
	КлючиАналитикиУчетаПоПартнерам.Партнер КАК Партнер,
	КлючиАналитикиУчетаПоПартнерам.Контрагент КАК Контрагент,
	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ОбъектРасчетов КАК ЗаказКлиента,
	КлючиАналитикиУчетаПоПартнерам.Договор КАК Договор,
	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаПлановогоПогашения КАК ДатаВозникновенияПросрочки,
	ВЫБОР 
		КОГДА РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаПлановогоПогашения &lt; &amp;НаДату ТОГДА
	    	РАЗНОСТЬДАТ(РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаПлановогоПогашения, &amp;НаДату, ДЕНЬ) 
		ИНАЧЕ
	    	0
	КОНЕЦ КАК ДниПросрочкиКалендарные,
	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаВозникновения КАК ДатаВозникновения,
	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДолгОстаток КАК СуммаЗадолженности,
	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК ДатаВыхода,
	"Отсрочка по индивидуальному договору" КАК ВидКредитногоДоверия
ИЗ
	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
			{(&amp;НаДату)},
			ОбъектРасчетов ССЫЛКА Документ.ЗаказКлиента
				И АналитикаУчетаПоПартнерам.Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
				И АналитикаУчетаПоПартнерам.Договор.ОграничиватьСуммуЗадолженности
				И АналитикаУчетаПоПартнерам.Договор.смартВидДоговора = ЗНАЧЕНИЕ(Перечисление.смартВидыДоговоров.РасходныеМатериалыОтсрочка)
				И НЕ АналитикаУчетаПоПартнерам.Партнер В
						(ВЫБРАТЬ
							ВТ_КлиентыИсключенияДляСтопЛиста.Партнер
						ИЗ
							ВТ_КлиентыИсключенияДляСтопЛиста)) КАК РасчетыСКлиентамиПоСрокамОстаткиИОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаПоПартнерам КАК КлючиАналитикиУчетаПоПартнерам
		ПО РасчетыСКлиентамиПоСрокамОстаткиИОбороты.АналитикаУчетаПоПартнерам = КлючиАналитикиУчетаПоПартнерам.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
		ПО (КлючиАналитикиУчетаПоПартнерам.Партнер = Партнеры.Ссылка)
{ГДЕ
	(&amp;ВидКредитногоДоверия = "ОтсрочкаПоДоговору"),
	(Партнеры.смартОсновнойМенеджерСервисЦентра = &amp;Менеджер
			ИЛИ Партнеры.смартМенеджерПоРасходнымМатериалам = &amp;Менеджер)}</query>
		</item>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>РеализацииТоваровУслуг</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаРеализации</dataPath>
			<field>ДатаРеализации</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата реализации</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ДФ=dd.MM.yyyy</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказКлиента</dataPath>
			<field>ЗаказКлиента</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	РеализацияТоваровУслуг.ЗаказКлиента КАК ЗаказКлиента,
	РеализацияТоваровУслуг.Дата КАК ДатаРеализации
ИЗ
	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
ГДЕ
	РеализацияТоваровУслуг.ЗаказКлиента В(&amp;ЗаказыКлиентов)
	И РеализацияТоваровУслуг.Проведен</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>СостоянияКонтрагентов</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СостояниеКонтрагента</dataPath>
			<field>СостояниеКонтрагента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Состояние контрагента</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">10</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СостоянияКонтрагентов.Контрагент КАК Контрагент,
	СостоянияКонтрагентов.Состояние КАК СостояниеКонтрагента
ИЗ
	РегистрСведений.СостоянияКонтрагентов КАК СостоянияКонтрагентов
ГДЕ
	СостоянияКонтрагентов.Контрагент В(&amp;Контрагенты)</query>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>НаборДанных1</sourceDataSet>
		<destinationDataSet>РеализацииТоваровУслуг</destinationDataSet>
		<sourceExpression>ЗаказКлиента</sourceExpression>
		<destinationExpression>ЗаказКлиента</destinationExpression>
		<parameter>ЗаказыКлиентов</parameter>
		<parameterListAllowed>true</parameterListAllowed>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>НаборДанных1</sourceDataSet>
		<destinationDataSet>СостоянияКонтрагентов</destinationDataSet>
		<sourceExpression>Контрагент</sourceExpression>
		<destinationExpression>Контрагент</destinationExpression>
		<parameter>Контрагенты</parameter>
		<parameterListAllowed>true</parameterListAllowed>
	</dataSetLink>
	<calculatedField>
		<dataPath>ДниПросрочкиРабочие</dataPath>
		<expression>ВЫБОР 
    КОГДА ДатаВозникновенияПросрочки &lt; &amp;НаДату И ДатаВыхода = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) ТОГДА
        смартКонтрольДебиторскойЗадолженности.ПолучитьКоличествоРабочихДней(ДатаВозникновенияПросрочки, &amp;НаДату)
    КОГДА ДатаВозникновенияПросрочки &lt; &amp;НаДату ТОГДА
        смартКонтрольДебиторскойЗадолженности.ПолучитьКоличествоРабочихДней(ДатаВозникновенияПросрочки, ДатаВыхода) 
    ИНАЧЕ
        0
КОНЕЦ  </expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дни просрочки рабочие</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>СуммаЗадолженности</dataPath>
		<expression>Сумма(СуммаЗадолженности)</expression>
	</totalField>
	<totalField>
		<dataPath>ДниПросрочкиКалендарные</dataPath>
		<expression>Максимум(ДниПросрочкиКалендарные)</expression>
		<group>ЗаказКлиента</group>
	</totalField>
	<totalField>
		<dataPath>ДниПросрочкиРабочие</dataPath>
		<expression>Максимум(ДниПросрочкиРабочие)</expression>
		<group>ЗаказКлиента</group>
	</totalField>
	<totalField>
		<dataPath>ДатаРеализации</dataPath>
		<expression>Массив(Формат(ДатаРеализации, "ДФ=dd.MM.yyyy"))</expression>
		<group>ЗаказКлиента</group>
	</totalField>
	<totalField>
		<dataPath>ДатаВозникновенияПросрочки</dataPath>
		<expression>Минимум(ДатаВозникновенияПросрочки)</expression>
		<group>ЗаказКлиента</group>
	</totalField>
	<totalField>
		<dataPath>ДатаВыхода</dataPath>
		<expression>Максимум(ДатаВыхода)</expression>
		<group>ЗаказКлиента</group>
	</totalField>
