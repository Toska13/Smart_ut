		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	Сегменты.Номенклатура КАК Номенклатура,
	Сегменты.Характеристика КАК Характеристика,
	ИСТИНА КАК ИспользуетсяОтборПоСегментуНоменклатуры
ПОМЕСТИТЬ ОтборПоСегментуНоменклатуры
ИЗ
	РегистрСведений.НоменклатураСегмента КАК Сегменты
{ГДЕ
	Сегменты.Сегмент.* КАК СегментНоменклатуры,
	Сегменты.Номенклатура.* КАК Номенклатура,
	Сегменты.Характеристика.* КАК Характеристика}

ИНДЕКСИРОВАТЬ ПО
	Номенклатура,
	Характеристика,
	ИспользуетсяОтборПоСегментуНоменклатуры
;

////////////////////////////////////////////////////////////////////////////////
// Временная таблица "ВтСвободныеОстатки"
//
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Набор.Номенклатура                         КАК Номенклатура,
	Набор.Характеристика                       КАК Характеристика,
	Набор.Склад                                КАК Склад,

	СУММА(Набор.ВНаличии)                      КАК ВНаличии,
	СУММА(Набор.ВРезервеСоСклада)              КАК ВРезервеСоСклада,
	СУММА(Набор.ВРезервеПодЗаказ)              КАК ВРезервеПодЗаказ,
	СУММА(Набор.КОтгрузке)                     КАК КОтгрузке,
	
	СУММА(Набор.ВНаличииГарантийные)                      КАК ВНаличииГарантийные,
	СУММА(Набор.ВРезервеСоСкладаГарантийные)              КАК ВРезервеСоСкладаГарантийные,
	СУММА(Набор.ВРезервеПодЗаказГарантийные)              КАК ВРезервеПодЗаказГарантийные,
	СУММА(Набор.КОтгрузкеГарантийные)                     КАК КОтгрузкеГарантийные

ПОМЕСТИТЬ ВтСвободныеОстатки
ИЗ(
	ВЫБРАТЬ

		Таблица.Номенклатура                         КАК Номенклатура,
		Таблица.Характеристика                       КАК Характеристика,
		Таблица.Склад                                КАК Склад,

		Таблица.ВНаличииОстаток                      КАК ВНаличии,
		Таблица.ВРезервеСоСкладаОстаток              КАК ВРезервеСоСклада,
		Таблица.ВРезервеПодЗаказОстаток              КАК ВРезервеПодЗаказ,
		0                                            КАК КОтгрузке,
		
		Таблица.смартВНаличииГарантийныеОстаток                      КАК ВНаличииГарантийные,
		Таблица.смартВРезервеСоСкладаГарантийныеОстаток              КАК ВРезервеСоСкладаГарантийные,
		Таблица.смартВРезервеПодЗаказГарантийныеОстаток              КАК ВРезервеПодЗаказГарантийные,
		0                                            КАК КОтгрузкеГарантийные

	ИЗ
		РегистрНакопления.СвободныеОстатки.Остатки( , {
			(Номенклатура, Характеристика) В(
				ВЫБРАТЬ
					ТаблицаОтбора.Номенклатура    КАК Номенклатура,
					ТаблицаОтбора.Характеристика  КАК Характеристика
				ИЗ
					ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				ГДЕ
					ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &amp;ИспользуетсяОтборПоСегментуНоменклатуры)
			} {Склад.*, Номенклатура.*, Характеристика.*}) КАК Таблица

	ОБЪЕДИНИТЬ ВСЕ

	ВЫБРАТЬ
		Таблица.Номенклатура     КАК Номенклатура,
		Таблица.Характеристика   КАК Характеристика,
		Таблица.Склад            КАК Склад,

		Таблица.КОтгрузкеОстаток КАК ВНаличии,
		0                        КАК ВРезервеСоСклада,
		0                        КАК ВРезервеПодЗаказ,
		Таблица.КОтгрузкеОстаток КАК КОтгрузке,
		
		Таблица.смартКОтгрузкеГарантийныеОстаток КАК ВНаличииГарантийные,
		0                        КАК ВРезервеСоСкладаГарантийные,
		0                        КАК ВРезервеПодЗаказГарантийные,
		Таблица.смартКОтгрузкеГарантийныеОстаток КАК КОтгрузкеГарантийные
	ИЗ
		РегистрНакопления.ТоварыКОтгрузке.Остатки(, {
			(Номенклатура, Характеристика) В(
				ВЫБРАТЬ
					ТаблицаОтбора.Номенклатура    КАК Номенклатура,
					ТаблицаОтбора.Характеристика  КАК Характеристика
				ИЗ
					ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				ГДЕ
					ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &amp;ИспользуетсяОтборПоСегментуНоменклатуры)
			} {Склад.*, Номенклатура.*, Характеристика.*}) КАК Таблица) КАК Набор

СГРУППИРОВАТЬ ПО
	Набор.Номенклатура, Набор.Характеристика, Набор.Склад

ИНДЕКСИРОВАТЬ ПО
	Номенклатура, Характеристика, Склад
;

//++ #1906 смарт: Шляпников 24.01.2025 / Проверить работу кнопок отбора в журнале заявки на гарантийный ремонт
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Заказ.Груз.ПланируемаяДатаПоступления КАК ПланируемаяДатаПоступления,
	График.Номенклатура КАК Номенклатура,
	График.Характеристика КАК Характеристика,
	График.Склад КАК Склад
ПОМЕСТИТЬ ВТПланируемыеПоступления
ИЗ
	РегистрНакопления.ГрафикПоступленияТоваров КАК График
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказ
		ПО График.Регистратор = Заказ.Ссылка
ГДЕ
	Заказ.Груз.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.ВПути)
	
;

////////////////////////////////////////////////////////////////////////////////

ВЫБРАТЬ РАЗЛИЧНЫЕ
	СостоянияЗаказовКлиентов.Заказ КАК Заказ
ПОМЕСТИТЬ ВТОплатаПоЗаказам
ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки({(КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ))}, ) КАК ТоварыКОтгрузкеОстатки
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО ВЫБОР КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказКлиента ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки = СостоянияЗаказовКлиентов.Заказ
			КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказНаПеремещение ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказНаСборку ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			ИНАЧЕ
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки = СостоянияЗаказовКлиентов.Заказ
			КОНЕЦ
ГДЕ
	( ТоварыКОтгрузкеОстатки.ВРезервеОстаток &lt;&gt; 0
		ИЛИ ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток &lt;&gt; 0 )
	И ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) &gt; 0

;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
	ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика,
	ТоварыКОтгрузкеОстатки.Склад КАК Склад,
	СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток + ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток) КАК КоличествоРезерв
ПОМЕСТИТЬ ВТРезервыПоОплаченнымЗаказам
ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки({(КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ))}, ) КАК ТоварыКОтгрузкеОстатки
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОплатаПоЗаказам КАК ВТОплатаПоЗаказам
		ПО ВЫБОР КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказКлиента ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки = ВТОплатаПоЗаказам.Заказ
			КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказНаПеремещение ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ДокументОснование = ВТОплатаПоЗаказам.Заказ
			КОГДА ТоварыКОтгрузкеОстатки.ДокументОтгрузки ССЫЛКА Документ.ЗаказНаСборку ТОГДА
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ДокументОснование = ВТОплатаПоЗаказам.Заказ
			ИНАЧЕ
				ТоварыКОтгрузкеОстатки.ДокументОтгрузки = ВТОплатаПоЗаказам.Заказ
			КОНЕЦ

СГРУППИРОВАТЬ ПО
	ТоварыКОтгрузкеОстатки.Номенклатура,
	ТоварыКОтгрузкеОстатки.Склад,
	ТоварыКОтгрузкеОстатки.Характеристика
;
//-- #1906 смарт: Шляпников 24.01.2025


////////////////////////////////////////////////////////////////////////////////
// Построение отчета
//
ВЫБРАТЬ РАЗРЕШЕННЫЕ

	Набор.Номенклатура                          КАК Номенклатура,
	Набор.Характеристика                        КАК Характеристика,
	Набор.Склад                                 КАК Склад,

    //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
	ЕСТЬNULL(Набор.ПрогнозГотовностиУПоставщика, ДАТАВРЕМЯ(1, 1, 1)) КАК ПрогнозГотовностиУПоставщика,
	//-- #Б-3262 смарт: Лопато 14.05.2025

	МАКСИМУМ(&amp;ТекстЗапросаВесНоменклатуры)      КАК Вес,
	МАКСИМУМ(&amp;ТекстЗапросаОбъемНоменклатуры)    КАК Объем,
	МАКСИМУМ(Набор.Номенклатура.ЕдиницаИзмерения)             КАК ЕдиницаХранения,
	МАКСИМУМ(Набор.Номенклатура.ЕдиницаДляОтчетов)            КАК ЕдиницаДляОтчетов,
	МАКСИМУМ(Набор.Номенклатура.КоэффициентЕдиницыДляОтчетов) КАК КоэффициентЕдиницыДляОтчетов,
	
	СУММА(Набор.ВНаличии)                       КАК ВНаличии,
	СУММА(Набор.ПриходОсновной)                 КАК ПриходОсновной,
	СУММА(Набор.РасходОсновной)                 КАК РасходОсновной,
	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ)      КАК ВРезервеСоСкладаИПодЗаказ,
	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ)
		+ СУММА(Набор.ВРезервеГрафика)          КАК ВРезерве,
	СУММА(Набор.Котгрузке)                      КАК Котгрузке,
	
	СУММА(Набор.ВНаличииГарантийные)                       КАК ВНаличииГарантийные,
	СУММА(Набор.ПриходОсновнойГарантийные)                 КАК ПриходОсновнойГарантийные,
	СУММА(Набор.РасходОсновнойГарантийные)                 КАК РасходОсновнойГарантийные,
	СУММА(Набор.ВРезервеСоСкладаИПодЗаказГарантийные)      КАК ВРезервеСоСкладаИПодЗаказГарантийные,
	СУММА(Набор.ВРезервеСоСкладаИПодЗаказГарантийные)
		+ СУММА(Набор.ВРезервеГрафикаГарантийные)          КАК ВРезервеГарантийные,
	СУММА(Набор.КотгрузкеГарантийные)                      КАК КотгрузкеГарантийные,
	//++ #1906 смарт: Шляпников 24.01.2025 / Проверить работу кнопок отбора в журнале заявки на гарантийный ремонт
	ВЫБОР КОГДА НЕ ЦеныЕвро.Цена ЕСТЬ NULL И НЕ ЦеныЕвро.Цена = 0 И НЕ ЦеныЕвро.Цена = 1000000 ТОГДА
			ЦеныЕвро.Цена
		КОГДА НЕ ЦеныДоллары.Цена ЕСТЬ NULL И НЕ ЦеныДоллары.Цена = 0 ТОГДА
			ЦеныДоллары.Цена
		КОГДА НЕ ЦеныРубли.Цена ЕСТЬ NULL И НЕ ЦеныРубли.Цена = 0 ТОГДА
			ЦеныРубли.Цена
		ИНАЧЕ
			0
	КОНЕЦ КАК ЦенаРозничная,
	ВЫБОР КОГДА НЕ ЦеныЕвро.Цена ЕСТЬ NULL И НЕ ЦеныЕвро.Цена = 0 И НЕ ЦеныЕвро.Цена = 1000000 ТОГДА
			ЦеныЕвро.ВидЦены.ВалютаЦены
		КОГДА НЕ ЦеныДоллары.Цена ЕСТЬ NULL И НЕ ЦеныДоллары.Цена = 0 ТОГДА
			ЦеныДоллары.ВидЦены.ВалютаЦены
		КОГДА НЕ ЦеныРубли.Цена ЕСТЬ NULL И НЕ ЦеныРубли.Цена = 0 ТОГДА
			ЦеныРубли.ВидЦены.ВалютаЦены
		ИНАЧЕ
			ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	КОНЕЦ КАК ВалютаЦены,
	МАКСИМУМ(ВТРезервыПоОплаченнымЗаказам.КоличествоРезерв) КАК КоличествоРезервОплачено,
	СУММА(Набор.ВРезервеКДате) КАК ВРезервеКДате,
	//-- #1906 смарт: Шляпников 24.01.2025
	//++ #Б2862 смарт: Шляпников 02.04.2025 / Доработать отчет "Остатки и доступность товаров". Добавить информацию по предзаказам
	СУММА(Набор.КоличествоПредзаказ)                       КАК КоличествоПредзаказ
	//-- #Б2862 смарт: Шляпников 02.04.2025

ИЗ(
	// 1) В наличии
	ВЫБРАТЬ

		Таблица.Номенклатура                          КАК Номенклатура,
		Таблица.Характеристика                        КАК Характеристика,
		Таблица.Склад                                 КАК Склад,

        //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
		ДАТАВРЕМЯ(1, 1, 1) КАК ПрогнозГотовностиУПоставщика,
		//-- #Б-3262 смарт: Лопато 14.05.2025

		Таблица.ВНаличии                              КАК ВНаличии,
		0                                             КАК ПриходОсновной,
		Таблица.ВРезервеПодЗаказ
			+ Таблица.ВРезервеСоСклада
			+ Таблица.КОтгрузке                       КАК РасходОсновной,

		Таблица.ВРезервеПодЗаказ
			+ Таблица.ВРезервеСоСклада                КАК ВРезервеСоСкладаИПодЗаказ,

		0                                             КАК ВРезервеГрафика,
		Таблица.КОтгрузке                             КАК КОтгрузке,
		
		Таблица.ВНаличииГарантийные                   КАК ВНаличииГарантийные,
		0                                             КАК ПриходОсновнойГарантийные,
		Таблица.ВРезервеПодЗаказГарантийные
			+ Таблица.ВРезервеСоСкладаГарантийные
			+ Таблица.КОтгрузкеГарантийные            КАК РасходОсновнойГарантийные,

		Таблица.ВРезервеПодЗаказГарантийные
			+ Таблица.ВРезервеСоСкладаГарантийные     КАК ВРезервеСоСкладаИПодЗаказГарантийные,

		0                                             КАК ВРезервеГрафикаГарантийные,
		Таблица.КОтгрузкеГарантийные                  КАК КОтгрузкеГарантийные,
		0											  КАК ВРезервеКДате,
		//++ #Б2862 смарт: Шляпников 02.04.2025 / Доработать отчет "Остатки и доступность товаров". Добавить информацию по предзаказам
		0											  КАК КоличествоПредзаказ
		//-- #Б2862 смарт: Шляпников 02.04.2025

	ИЗ
		ВтСвободныеОстатки КАК Таблица

	ОБЪЕДИНИТЬ ВСЕ

	// 2) Приход по заказам
	ВЫБРАТЬ
		Таблица.Номенклатура                          КАК Номенклатура,
		Таблица.Характеристика                        КАК Характеристика,
		Таблица.Склад                                 КАК Склад,

        //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
		ДАТАВРЕМЯ(1, 1, 1) КАК ПрогнозГотовностиУПоставщика,
		//-- #Б-3262 смарт: Лопато 14.05.2025

		0                                             КАК ВНаличии,
		Таблица.КоличествоИзЗаказов		              КАК ПриходОсновной,
		0                                             КАК РасходОсновной,
		0                                             КАК ВРезервеСоСкладаИПодЗаказ,

		0                                             КАК ВРезервеГрафика,
		0                                             КАК КОтгрузке,
		
		0                                             КАК ВНаличииГарантийные,
		Таблица.смартКоличествоИзЗаказовГарантийные   КАК ПриходОсновнойГарантийные,
		0                                             КАК РасходОсновнойГарантийные,
		0                                             КАК ВРезервеСоСкладаИПодЗаказГарантийные,

		0                                             КАК ВРезервеГрафикаГарантийные,
		0                                             КАК КОтгрузкеГарантийные,
		0											  КАК ВРезервеКДате,
		//++ #Б2862 смарт: Шляпников 02.04.2025 / Доработать отчет "Остатки и доступность товаров". Добавить информацию по предзаказам
		0											  КАК КоличествоПредзаказ
		//-- #Б2862 смарт: Шляпников 02.04.2025


	ИЗ
		РегистрНакопления.ГрафикПоступленияТоваров КАК Таблица
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказ
			ПО Таблица.Регистратор = Заказ.Ссылка
	ГДЕ
		Заказ.Груз.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.ВПути)
    
    ОБЪЕДИНИТЬ ВСЕ
    
	// 3) Расход по заказам
	ВЫБРАТЬ
		Таблица.Номенклатура                          КАК Номенклатура,
		Таблица.Характеристика                        КАК Характеристика,
		Таблица.Склад                                 КАК Склад,

        //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
		ДАТАВРЕМЯ(1, 1, 1) КАК ПрогнозГотовностиУПоставщика,
		//-- #Б-3262 смарт: Лопато 14.05.2025

		0                                             КАК ВНаличии,
		0								              КАК ПриходОсновной,
		0								 			  КАК РасходОсновной,
		0                                             КАК ВРезервеСоСкладаИПодЗаказ,

		0									          КАК ВРезервеГрафика,
		0                                             КАК КОтгрузке,
		
		0                                             КАК ВНаличииГарантийные,
		0								              КАК ПриходОсновнойГарантийные,
		0                                             КАК РасходОсновнойГарантийные,
		0                                             КАК ВРезервеСоСкладаИПодЗаказГарантийные,

		0                                             КАК ВРезервеГрафикаГарантийные,
		0                                             КАК КОтгрузкеГарантийные,
		Таблица.КоличествоИзЗаказов		              КАК ВРезервеКДате,
		//++ #Б2862 смарт: Шляпников 02.04.2025 / Доработать отчет "Остатки и доступность товаров". Добавить информацию по предзаказам
		0											  КАК КоличествоПредзаказ
		//-- #Б2862 смарт: Шляпников 02.04.2025


	ИЗ
		РегистрНакопления.ГрафикОтгрузкиТоваров КАК Таблица
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланируемыеПоступления КАК ВТПланируемыеПоступления
		ПО Таблица.Номенклатура = ВТПланируемыеПоступления.Номенклатура
			И Таблица.Характеристика = ВТПланируемыеПоступления.Характеристика
			И Таблица.Склад = ВТПланируемыеПоступления.Склад
			И Таблица.ДатаОтгрузки = ВТПланируемыеПоступления.ПланируемаяДатаПоступления
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО ВЫБОР КОГДА Таблица.Регистратор ССЫЛКА Документ.ЗаказКлиента ТОГДА
				Таблица.Регистратор = СостоянияЗаказовКлиентов.Заказ
			КОГДА Таблица.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение ТОГДА
				Таблица.Регистратор.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			КОГДА Таблица.Регистратор ССЫЛКА Документ.ЗаказНаСборку ТОГДА
				Таблица.Регистратор.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			ИНАЧЕ
				Таблица.Регистратор = СостоянияЗаказовКлиентов.Заказ
			КОНЕЦ
			И (СостоянияЗаказовКлиентов.СуммаОплаты &gt; 0)
	ГДЕ
		Таблица.КоличествоИзЗаказов &gt; 0
		
	{ГДЕ
		Таблица.Склад.* КАК Склад,
		Таблица.Номенклатура.* КАК Номенклатура,
		Таблица.Характеристика.* КАК Характеристика}
		
	ОБЪЕДИНИТЬ ВСЕ

	//++ #Б2862 смарт: Шляпников 02.04.2025 / Доработать отчет "Остатки и доступность товаров". Добавить информацию по предзаказам
	// 4) Предзаказы
	ВЫБРАТЬ
		Таблица.Номенклатура                          КАК Номенклатура,
		Таблица.Характеристика                        КАК Характеристика,
		Таблица.ПредзаказПоставщику.Склады            КАК Склад,
        
        //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
		ЕСТЬNULL(Таблица.ПредзаказПоставщику.ПрогнозГотовностиУПоставщика, ДАТАВРЕМЯ(1, 1, 1)) КАК ПрогнозГотовностиУПоставщика,
		//-- #Б-3262 смарт: Лопато 14.05.2025
		
		0                                             КАК ВНаличии,
		0								              КАК ПриходОсновной,
		0                                             КАК РасходОсновной,
		0                                             КАК ВРезервеСоСкладаИПодЗаказ,

		0                                             КАК ВРезервеГрафика,
		0                                             КАК КОтгрузке,
		
		0                                             КАК ВНаличииГарантийные,
		0											  КАК ПриходОсновнойГарантийные,
		0                                             КАК РасходОсновнойГарантийные,
		0                                             КАК ВРезервеСоСкладаИПодЗаказГарантийные,

		0                                             КАК ВРезервеГрафикаГарантийные,
		0                                             КАК КОтгрузкеГарантийные,
		0											  КАК ВРезервеКДате,
		Таблица.ЗаказаноОстаток						  КАК КоличествоПредзаказ
	ИЗ
		РегистрНакопления.смартПредзаказыПоставщикам.Остатки( , {
			(Номенклатура, Характеристика) В(
				ВЫБРАТЬ
					ТаблицаОтбора.Номенклатура    КАК Номенклатура,
					ТаблицаОтбора.Характеристика  КАК Характеристика
				ИЗ
					ОтборПоСегментуНоменклатуры КАК ТаблицаОтбора
				ГДЕ
					ТаблицаОтбора.ИспользуетсяОтборПоСегментуНоменклатуры = &amp;ИспользуетсяОтборПоСегментуНоменклатуры)
			} {ПредзаказПоставщику.Склады.*, Номенклатура.*, Характеристика.*}) КАК Таблица
	ГДЕ
		&amp;ФормироватьИнформациюОПредзаказах
	//-- #Б2862 смарт: Шляпников 02.04.2025
		
		) КАК Набор
	//++ #1906 смарт: Шляпников 24.01.2025 / Проверить работу кнопок отбора в журнале заявки на гарантийный ремонт
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних({КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)}, ВидЦены = &amp;ВидЦенЕвро) КАК ЦеныЕвро
		ПО Набор.Номенклатура = ЦеныЕвро.Номенклатура
		И Набор.Характеристика = ЦеныЕвро.Характеристика
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних({КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)}, ВидЦены = &amp;ВидЦенДоллары) КАК ЦеныДоллары
		ПО Набор.Номенклатура = ЦеныДоллары.Номенклатура
		И Набор.Характеристика = ЦеныДоллары.Характеристика
	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних({КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)}, ВидЦены = &amp;ВидЦенРубли) КАК ЦеныРубли
		ПО Набор.Номенклатура = ЦеныРубли.Номенклатура
		И Набор.Характеристика = ЦеныРубли.Характеристика
	ЛЕВОЕ СОЕДИНЕНИЕ ВТРезервыПоОплаченнымЗаказам КАК ВТРезервыПоОплаченнымЗаказам
		ПО Набор.Номенклатура = ВТРезервыПоОплаченнымЗаказам.Номенклатура
		И Набор.Характеристика = ВТРезервыПоОплаченнымЗаказам.Характеристика
		И Набор.Склад = ВТРезервыПоОплаченнымЗаказам.Склад
	//-- #1906 смарт: Шляпников 24.01.2025
		

СГРУППИРОВАТЬ ПО
	Набор.Номенклатура, Набор.Характеристика, Набор.Склад,

    //++ #Б-3262 смарт: Лопато 14.05.2025 //Доработать отчет "Остатки и доступность товаров". Добавить информацию о прогнозном сроке изготовления.
	Набор.ПрогнозГотовностиУПоставщика,
	//-- #Б-3262 смарт: Лопато 14.05.2025

	//++ #1906 смарт: Шляпников 24.01.2025 / Проверить работу кнопок отбора в журнале заявки на гарантийный ремонт
	ВЫБОР КОГДА НЕ ЦеныЕвро.Цена ЕСТЬ NULL И НЕ ЦеныЕвро.Цена = 0 И НЕ ЦеныЕвро.Цена = 1000000 ТОГДА
			ЦеныЕвро.Цена
		КОГДА НЕ ЦеныДоллары.Цена ЕСТЬ NULL И НЕ ЦеныДоллары.Цена = 0 ТОГДА
			ЦеныДоллары.Цена
		КОГДА НЕ ЦеныРубли.Цена ЕСТЬ NULL И НЕ ЦеныРубли.Цена = 0 ТОГДА
			ЦеныРубли.Цена
		ИНАЧЕ
			0
	КОНЕЦ,
	ВЫБОР КОГДА НЕ ЦеныЕвро.Цена ЕСТЬ NULL И НЕ ЦеныЕвро.Цена = 0 И НЕ ЦеныЕвро.Цена = 1000000 ТОГДА
			ЦеныЕвро.ВидЦены.ВалютаЦены
		КОГДА НЕ ЦеныДоллары.Цена ЕСТЬ NULL И НЕ ЦеныДоллары.Цена = 0 ТОГДА
			ЦеныДоллары.ВидЦены.ВалютаЦены
		КОГДА НЕ ЦеныРубли.Цена ЕСТЬ NULL И НЕ ЦеныРубли.Цена = 0 ТОГДА
			ЦеныРубли.ВидЦены.ВалютаЦены
		ИНАЧЕ
			ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	КОНЕЦ
	//-- #1906 смарт: Шляпников 24.01.2025</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>Доступность по датам</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДоступноОсновной</dataPath>
			<field>ДоступноОсновной</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Доступно</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧЦ=15; ЧДЦ=3</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаДоступностиОсновной</dataPath>
			<field>ДатаДоступностиОсновной</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата доступности</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">Л=ru_RU; ДФ='dd.MM.yyyy "г."'</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">13</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Склад</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДоступноОсновнойГарантийные</dataPath>
			<field>ДоступноОсновнойГарантийные</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Доступно основной гарантийные</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Груз</dataPath>
			<field>Груз</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Груз</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоРезервКДате</dataPath>
			<field>КоличествоРезервКДате</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Оплачено</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=3</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказПоставщику</dataPath>
			<field>ЗаказПоставщику</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заказ поставщику</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Заказ.Ссылка КАК ЗаказПоставщику,
	Заказ.Груз КАК Груз,
	Заказ.Груз.ПланируемаяДатаПоступления КАК ПланируемаяДатаПоступления,
	График.ДатаСобытия КАК ДатаДляРезерва,
	График.Номенклатура КАК Номенклатура,
	График.Характеристика КАК Характеристика,
	График.Склад КАК Склад,
	СУММА(График.КоличествоИзЗаказов) КАК Количество,
	СУММА(График.смартКоличествоИзЗаказовГарантийные) КАК КоличествоГарантийные
ПОМЕСТИТЬ ВТПланируемыеПоступления
ИЗ
	РегистрНакопления.ГрафикПоступленияТоваров КАК График
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК Заказ
		ПО График.Регистратор = Заказ.Ссылка
ГДЕ
	Заказ.Груз.СтатусГруза = ЗНАЧЕНИЕ(Перечисление.СтатусыГрузов.ВПути)

СГРУППИРОВАТЬ ПО
	График.ДатаСобытия,
	График.Характеристика,
	График.Склад,
	Заказ.Груз,
	График.Номенклатура,
	Заказ.Груз.ПланируемаяДатаПоступления,
	Заказ.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТПланируемыеПоступления.ПланируемаяДатаПоступления КАК ПланируемаяДатаПоступления,
	МАКСИМУМ(ВТПланируемыеПоступления.Груз) КАК Груз,
	ВТПланируемыеПоступления.ДатаДляРезерва КАК ДатаДляРезерва,
	ВТПланируемыеПоступления.Номенклатура КАК Номенклатура,
	ВТПланируемыеПоступления.Характеристика КАК Характеристика,
	ВТПланируемыеПоступления.Склад КАК Склад
ПОМЕСТИТЬ ВТПланируемыеПоступленияСвернуто
ИЗ
	ВТПланируемыеПоступления КАК ВТПланируемыеПоступления

СГРУППИРОВАТЬ ПО
	ВТПланируемыеПоступления.ПланируемаяДатаПоступления,
	ВТПланируемыеПоступления.Характеристика,
	ВТПланируемыеПоступления.Склад,
	ВТПланируемыеПоступления.ДатаДляРезерва,
	ВТПланируемыеПоступления.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ГрафикОтгрузкиТоваров.Номенклатура КАК Номенклатура,
	ГрафикОтгрузкиТоваров.Характеристика КАК Характеристика,
	ГрафикОтгрузкиТоваров.Склад КАК Склад,
	ВТПланируемыеПоступления.Груз КАК Груз,
	ГрафикОтгрузкиТоваров.ДатаОтгрузки КАК ДатаОтгрузки,
	СУММА(ГрафикОтгрузкиТоваров.КоличествоИзЗаказов) КАК КоличествоРезерв
ПОМЕСТИТЬ ВТРезервыПоДатам
ИЗ
	РегистрНакопления.ГрафикОтгрузкиТоваров КАК ГрафикОтгрузкиТоваров
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланируемыеПоступленияСвернуто КАК ВТПланируемыеПоступления
		ПО ГрафикОтгрузкиТоваров.Номенклатура = ВТПланируемыеПоступления.Номенклатура
			И ГрафикОтгрузкиТоваров.Характеристика = ВТПланируемыеПоступления.Характеристика
			И ГрафикОтгрузкиТоваров.Склад = ВТПланируемыеПоступления.Склад
			И ГрафикОтгрузкиТоваров.ДатаОтгрузки = ВТПланируемыеПоступления.ДатаДляРезерва
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО ВЫБОР КОГДА ГрафикОтгрузкиТоваров.Регистратор ССЫЛКА Документ.ЗаказКлиента ТОГДА
				ГрафикОтгрузкиТоваров.Регистратор = СостоянияЗаказовКлиентов.Заказ
			КОГДА ГрафикОтгрузкиТоваров.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение ТОГДА
				ГрафикОтгрузкиТоваров.Регистратор.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			КОГДА ГрафикОтгрузкиТоваров.Регистратор ССЫЛКА Документ.ЗаказНаСборку ТОГДА
				ГрафикОтгрузкиТоваров.Регистратор.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
			ИНАЧЕ
				ГрафикОтгрузкиТоваров.Регистратор = СостоянияЗаказовКлиентов.Заказ
			КОНЕЦ
			И (СостоянияЗаказовКлиентов.СуммаОплаты &gt; 0)
ГДЕ
	ГрафикОтгрузкиТоваров.КоличествоИзЗаказов &gt; 0

СГРУППИРОВАТЬ ПО
	ГрафикОтгрузкиТоваров.Номенклатура,
	ГрафикОтгрузкиТоваров.ДатаОтгрузки,
	ГрафикОтгрузкиТоваров.Характеристика,
	ГрафикОтгрузкиТоваров.Склад,
	ВТПланируемыеПоступления.Груз
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТПланируемыеПоступления.ЗаказПоставщику КАК ЗаказПоставщику,
	ВТПланируемыеПоступления.Груз КАК Груз,
	ВТПланируемыеПоступления.ПланируемаяДатаПоступления КАК ДатаДоступностиОсновной,
	ВТПланируемыеПоступления.Номенклатура КАК Номенклатура,
	ВТПланируемыеПоступления.Характеристика КАК Характеристика,
	ВТПланируемыеПоступления.Склад КАК Склад,
	ВТПланируемыеПоступления.Количество КАК ДоступноОсновной,
	ВТПланируемыеПоступления.КоличествоГарантийные КАК ДоступноОсновнойГарантийные,
	0 КАК КоличествоРезервКДате
ИЗ
	ВТПланируемыеПоступления КАК ВТПланируемыеПоступления

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	ВТРезервыПоДатам.Груз,
	ВТРезервыПоДатам.ДатаОтгрузки,
	ВТРезервыПоДатам.Номенклатура,
	ВТРезервыПоДатам.Характеристика,
	ВТРезервыПоДатам.Склад,
	0,
	0,
	ВТРезервыПоДатам.КоличествоРезерв
ИЗ
	ВТРезервыПоДатам КАК ВТРезервыПоДатам</query>
