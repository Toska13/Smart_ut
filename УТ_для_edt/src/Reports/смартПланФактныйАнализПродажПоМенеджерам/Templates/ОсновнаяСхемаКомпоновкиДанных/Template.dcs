			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	смартПланПродажПоМенеджерамОбороты.Менеджер КАК Менеджер
ПОМЕСТИТЬ МенеджерыСПланом
ИЗ
	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
			&amp;ДатаНачала,
			&amp;ДатаОкончания,
			,
			ТипУслуги = &amp;ТипУслуги
				И ВидПлана = &amp;ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВыручкаИСебестоимостьПродаж.Менеджер КАК Менеджер,
	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиОборот) КАК СуммаФакт,
	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиСНДСРеглОборот) КАК СуммаФактРегл,
	ВыручкаИСебестоимостьПродаж.смартДатаЗакрытияЗаказа КАК ДатаЗакрытия,
	ВыручкаИСебестоимостьПродаж.ЗаказКлиента КАК ЗаказКлиента,
	ВЫБОР
		КОГДА ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
			ТОГДА ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение
		ИНАЧЕ ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение.смартПодразделениеДляПланирования
	КОНЕЦ КАК Подразделение,
	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ВыручкаФакт
ИЗ
	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
			,
			,
			,
			смартДатаЗакрытияЗаказа МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
				И ВЫБОР
					КОГДА &amp;ДоступныВсеПользователи
						ТОГДА ИСТИНА
					ИНАЧЕ Менеджер = &amp;ТекущийПользователь
				КОНЕЦ
				И ВЫБОР
					КОГДА &amp;ПоказатьТолькоМенеджеровСПлланом
						ТОГДА Менеджер В
								(ВЫБРАТЬ РАЗЛИЧНЫЕ
									МенеджерыСПланом.Менеджер КАК Менеджер
								ИЗ
									МенеджерыСПланом КАК МенеджерыСПланом)
					ИНАЧЕ ИСТИНА
				КОНЕЦ) КАК ВыручкаИСебестоимостьПродаж

СГРУППИРОВАТЬ ПО
	ВыручкаИСебестоимостьПродаж.смартДатаЗакрытияЗаказа,
	ВыручкаИСебестоимостьПродаж.ЗаказКлиента,
	ВыручкаИСебестоимостьПродаж.Менеджер,
	ВЫБОР
		КОГДА ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
			ТОГДА ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение
		ИНАЧЕ ВыручкаИСебестоимостьПродаж.Менеджер.Подразделение.смартПодразделениеДляПланирования
	КОНЕЦ,
	ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИтоговыеДанные.Менеджер КАК Менеджер,
	ИтоговыеДанные.ПериодВыборки КАК ПериодВыборки,
	ИтоговыеДанные.СуммаПлан КАК СуммаПлан,
	ИтоговыеДанные.СуммаФакт КАК СуммаФакт,
	ИтоговыеДанные.СуммаПланРегл КАК СуммаПланРегл,
	ИтоговыеДанные.СуммаФактРегл КАК СуммаФактРегл,
	ИтоговыеДанные.Подразделение КАК ВыбПодразделение
ИЗ
	(ВЫБРАТЬ
		ВыручкаФакт.Менеджер КАК Менеджер,
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, МЕСЯЦ)
		КОНЕЦ КАК ПериодВыборки,
		СУММА(0) КАК СуммаПлан,
		СУММА(ЕСТЬNULL(ВыручкаФакт.СуммаФакт, 0)) КАК СуммаФакт,
		СУММА(0) КАК СуммаПланРегл,
		СУММА(ЕСТЬNULL(ВыручкаФакт.СуммаФактРегл, 0)) КАК СуммаФактРегл,
		ВыручкаФакт.Подразделение КАК Подразделение
	ИЗ
		ВыручкаФакт КАК ВыручкаФакт
	
	СГРУППИРОВАТЬ ПО
		ВыручкаФакт.Менеджер,
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, МЕСЯЦ)
		КОНЕЦ,
		ВыручкаФакт.Подразделение
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		смартПланПродажПоМенеджерамОбороты.Менеджер,
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, МЕСЯЦ)
		КОНЕЦ,
		СУММА(ЕСТЬNULL(смартПланПродажПоМенеджерамОбороты.СуммаОборот, 0)),
		СУММА(0),
		СУММА(ЕСТЬNULL(смартПланПродажПоМенеджерамОбороты.СуммаРеглОборот, 0)),
		СУММА(0),
		ВЫБОР
			КОГДА смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
				ТОГДА смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение
			ИНАЧЕ смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение.смартПодразделениеДляПланирования
		КОНЕЦ
	ИЗ
		РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
				{(&amp;ДатаНачала)},
				{(&amp;ДатаОкончания)},
				Регистратор,
				ВЫБОР
						КОГДА &amp;ДоступныВсеПользователи
							ТОГДА ИСТИНА
						ИНАЧЕ Менеджер = &amp;ТекущийПользователь
					КОНЕЦ
					И ТипУслуги = &amp;ТипУслуги
					И ВидПлана = &amp;ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
	
	СГРУППИРОВАТЬ ПО
		смартПланПродажПоМенеджерамОбороты.Менеджер,
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, МЕСЯЦ)
		КОНЕЦ,
		ВЫБОР
			КОГДА смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
				ТОГДА смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение
			ИНАЧЕ смартПланПродажПоМенеджерамОбороты.Менеджер.Подразделение.смартПодразделениеДляПланирования
		КОНЕЦ) КАК ИтоговыеДанные</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>НаборДанных2</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Склад</dataPath>
				<field>Склад</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Менеджер</dataPath>
				<field>Менеджер</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Менеджер</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Номенклатура</dataPath>
				<field>Номенклатура</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Сумма</dataPath>
				<field>Сумма</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сумма</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Серия</dataPath>
				<field>Серия</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ЗаказКлиента</dataPath>
				<field>ЗаказКлиента</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КодСтроки</dataPath>
				<field>КодСтроки</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Характеристика</dataPath>
				<field>Характеристика</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ВыбПодразделение</dataPath>
				<field>ВыбПодразделение</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Выб подразделение</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПериодВыборки</dataPath>
				<field>ПериодВыборки</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Период выборки</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыЕВРО
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;EUR
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыДоллар
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;USD
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыЮань
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;CNY
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер КАК Менеджер,
	СУММА(ВЫБОР
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;EUR
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;USD
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход * ЕСТЬNULL(КурсыДоллар.Курс, 1) / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;CNY
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход * ЕСТЬNULL(КурсыЮань.Курс, 1) / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;RUR
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			ИНАЧЕ ЗаказыКлиентовОбороты.СуммаПриход
		КОНЕЦ) КАК Сумма,
	ВЫБОР
		КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
			ТОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение
		ИНАЧЕ ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение.смартПодразделениеДляПланирования
	КОНЕЦ КАК ВыбПодразделение,
	ЗаказыКлиентовОбороты.ЗаказКлиента КАК ЗаказКлиента,
	ЗаказыКлиентовОбороты.Номенклатура КАК Номенклатура,
	&amp;ДатаНачала КАК ПериодВыборки
ИЗ
	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыКлиентов.Обороты(ДОБАВИТЬКДАТЕ(&amp;ТекущаяДата, МЕСЯЦ, -12), , , НЕ ЗаказКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)) КАК ЗаказыКлиентовОбороты
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыЕВРО КАК КурсыЕВРО
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыЕВРО.Период)
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыДоллар КАК КурсыДоллар
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыДоллар.Период)
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыЮань КАК КурсыЮань
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыЮань.Период)
		ПО (ЗаказыКлиентовОбороты.ЗаказКлиента = СостоянияЗаказовКлиентов.Заказ)
ГДЕ
	ЗаказыКлиентовОбороты.ЗаказаноПриход &gt; 0
	И СостоянияЗаказовКлиентов.ПроцентОплаты &gt; 0

СГРУППИРОВАТЬ ПО
	ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер,
	ВЫБОР
		КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
			ТОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение
		ИНАЧЕ ЗаказыКлиентовОбороты.ЗаказКлиента.Менеджер.Подразделение.смартПодразделениеДляПланирования
	КОНЕЦ,
	ЗаказыКлиентовОбороты.ЗаказКлиента,
	ЗаказыКлиентовОбороты.Номенклатура</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>СуммаСУчетомНеЗакрытых</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма с учетом не закрытых</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>СуммаПлан</dataPath>
		<expression>Сумма(СуммаПлан)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаПланРегл</dataPath>
		<expression>Сумма(СуммаПланРегл)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаФакт</dataPath>
		<expression>Сумма(СуммаФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаФактРегл</dataPath>
		<expression>Сумма(СуммаФактРегл)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>СуммаСУчетомНеЗакрытых</dataPath>
		<expression>Сумма(СуммаФакт)+Сумма(Сумма)</expression>
	</totalField>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
