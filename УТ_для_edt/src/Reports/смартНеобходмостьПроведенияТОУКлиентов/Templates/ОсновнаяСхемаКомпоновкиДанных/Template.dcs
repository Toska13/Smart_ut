		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Клиент КАК Клиент,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Контрагент КАК Контрагент,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Оборудование КАК Оборудование,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Серия КАК Серия,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.СрокЗамены КАК СрокЗамены,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Запчасть КАК Запчасть,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Количество КАК Количество,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.Представительство КАК Представительство,
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.ДатаТОУКлиента КАК ДатаТОУКлиента
ИЗ
	РегистрСведений.смартТехническоеОбслуживаниеОборудованияПоКлиентам КАК смартТехническоеОбслуживаниеОборудованияПоКлиентам
{ГДЕ
	смартТехническоеОбслуживаниеОборудованияПоКлиентам.ДатаТОУКлиента МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания}</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;Период.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>КонецПериода(&amp;Период.ДатаОкончания, "День")</expression>
	</parameter>
	<parameter>
		<name>Период</name>
