&НаСервере
Функция ПолучитьСкладГарантийныхЗапчастей()
	
	Настройка = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ;
	СсылкаНаСправочникДопОбработок = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);

	Возврат СсылкаНаСправочникДопОбработок;
	
КонецФункции

&НаСервере
Функция ПолучитьВнешнийОтчет()
	
	Настройка = Справочники.смартПредопределенныеЗначения.ОтчетДвиженияПоСкладуГарантийныхЗапчастей;
	СсылкаНаСправочникДопОбработок = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаСправочникДопОбработок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СсылкаНаСправочникДопОбработок;
	//ОбъектОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ОбъектВнешнейОбработки(СсылкаНаСправочникДопОбработок);
			
КонецФункции

&НаСервере
Функция ПолучитьРасшифровкуПолейСтрокиНаСервере(Расшифровка)
	
	МассивРасшифровываемых = Новый Массив();
	МассивРасшифровываемых.Добавить("Номенклатура");
	МассивРасшифровываемых.Добавить("ЗаявкаНаГарантийныйРемонт");

	РасшифровкаСтроки = Новый Структура;
	РасшифровкаСтроки.Вставить("НомерЗаявки", "");

	Для Каждого ИмяПоля Из МассивРасшифровываемых Цикл
		РасшифровкаСтроки.Вставить(ИмяПоля, "");
	КонецЦикла;

	ДанныеОтчета = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
	
	Поля = ДанныеОтчета.Элементы.Получить(Расшифровка).ПолучитьПоля(); //Тут получаем поля расшифровки, среди которых находим нужное.
	
	ПолеКоличество = Поля.Найти("ОстатокПоЗаявкеСмарт");
	
	Если ПолеКоличество = Неопределено Тогда		
		Возврат Неопределено;		
	КонецЕсли;				

	//ПоляРасшифровки = ДанныеОтчета.Элементы.Получить(Расшифровка).ПолучитьПоля();
	
	РасшифровкаЧисло = Число(Расшифровка);
	Сч = РасшифровкаЧисло - 7; // Поколодовать, выясняя первую колонку в строке
	
	Пока Сч <= РасшифровкаЧисло Цикл
		
		ЭлементРасшифровки = ДанныеОтчета.Элементы.Получить(Сч);
		
		Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			
			ПолеРасшифровки = ЭлементРасшифровки.ПолучитьПоля()[0];
			
			Если МассивРасшифровываемых.Найти(ПолеРасшифровки.Поле) <> Неопределено Тогда				
				РасшифровкаСтроки.Вставить(ПолеРасшифровки.Поле, ПолеРасшифровки.Значение);
			КонецЕсли;
		КонецЕсли;
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(РасшифровкаСтроки.ЗаявкаНаГарантийныйРемонт) Тогда
		РасшифровкаСтроки.НомерЗаявки = РасшифровкаСтроки.ЗаявкаНаГарантийныйРемонт.Номер;
	КонецЕсли;
	
	Возврат РасшифровкаСтроки;
			
КонецФункции