<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол-во</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РешениеПоставщика</dataPath>
			<field>РешениеПоставщика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АрендаЗапчастей</dataPath>
			<field>АрендаЗапчастей</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Аренда запчастей</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидЦены</dataPath>
			<field>ВидЦены</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкаНаГарантийныйРемонт</dataPath>
			<field>ЗаявкаНаГарантийныйРемонт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка на гарантийный ремонт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УстановленоКлиенту</dataPath>
			<field>УстановленоКлиенту</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Установлено клиенту</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПолученоОтПоставщика</dataPath>
			<field>ПолученоОтПоставщика</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Получено от поставщика</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПолученоОтКлиента</dataPath>
			<field>ПолученоОтКлиента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Получено от клиента</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОтправленоПоставщикуСписано</dataPath>
			<field>ОтправленоПоставщикуСписано</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Отправлено поставщику/списано</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СебестоимостьЗаЕд</dataPath>
			<field>СебестоимостьЗаЕд</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Себестоимость за ед.</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СебестоимостьВсего</dataPath>
			<field>СебестоимостьВсего</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Себестоимость всего</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	смартЗаявкаНаГарантийныйРемонт.Ссылка КАК Ссылка,
	ЗаполняетсяСпециалистом.Номенклатура КАК Номенклатура,
	ЗаполняетсяСпециалистом.Количество КАК Количество,
	ЗаполняетсяИнженеромТЧ.ДокументЗаказНаВнутреннееПотребление КАК ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту,
	ЗаполняетсяИнженеромТЧ.ДокументВводОстатков КАК ДокументВводОстатков,
	ЗаполняетсяСпециалистом.РешениеПоставщика КАК РешениеПоставщика,
	СтатусыСписать.ДокументДвижения КАК ЗаказНаВнутреннееПотреблениеДляСписано,
	СтатусыОжидаетсяОтправка.ДокументДвижения КАК ВозвратПоставщику,
	СтатусыОжидаетсяПоступление.ДокументДвижения КАК ЗаказПоставщику,
	ЗаполняетсяИнженеромТЧ.НоменклатураУстановленнаяКлиенту КАК НоменклатураУстановленнаяКлиенту,
	НоменклатураСпр.Артикул КАК Артикул,
	ВЫБОР
		КОГДА НоменклатураСпр.Артикул ПОДОБНО "%LOA%"
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК АрендаЗапчастей
ПОМЕСТИТЬ ВТ_Промежуточная
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК ЗаполняетсяСпециалистом
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.Статусы КАК СтатусыСписать
			ПО (СтатусыСписать.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуется))
				И (ЗаполняетсяСпециалистом.НомерПозиции = СтатусыСписать.НомерПозиции)
				И (ЗаполняетсяСпециалистом.Ссылка = СтатусыСписать.Ссылка)
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.Статусы КАК СтатусыОжидаетсяПоступление
			ПО (СтатусыОжидаетсяПоступление.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление))
				И (ЗаполняетсяСпециалистом.НомерПозиции = СтатусыОжидаетсяПоступление.НомерПозиции)
				И (ЗаполняетсяСпециалистом.Ссылка = СтатусыОжидаетсяПоступление.Ссылка)
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.Статусы КАК СтатусыОжидаетсяОтправка
			ПО (СтатусыОжидаетсяОтправка.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка))
				И (ЗаполняетсяСпециалистом.НомерПозиции = СтатусыОжидаетсяОтправка.НомерПозиции)
				И (ЗаполняетсяСпециалистом.Ссылка = СтатусыОжидаетсяОтправка.Ссылка)
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером КАК ЗаполняетсяИнженеромТЧ
				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
				ПО (ЗаполняетсяИнженеромТЧ.НоменклатураУстановленнаяКлиенту = НоменклатураСпр.Ссылка)
			ПО (ЗаполняетсяСпециалистом.Ссылка = ЗаполняетсяИнженеромТЧ.Ссылка)
				И (ЗаполняетсяСпециалистом.ИДСтрокиЗаполняетсяИнженером = ЗаполняетсяИнженеромТЧ.ИДСтрокиЗаполняетсяИнженером)
		ПО (смартЗаявкаНаГарантийныйРемонт.Ссылка = ЗаполняетсяСпециалистом.Ссылка)
ГДЕ
	смартЗаявкаНаГарантийныйРемонт.Дата &gt;= &amp;ДатаНачала
	И смартЗаявкаНаГарантийныйРемонт.Дата &lt;= &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту КАК ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту,
	ВТ_Промежуточная.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ВнутреннееПотреблениеТоваровТовары.Ссылка) КАК ВнутреннееПотреблениеДляУстановленоКлиенту
ПОМЕСТИТЬ ВТ_ВнутрПотреблениеДляУстановленоКлиенту
ИЗ
	ВТ_Промежуточная КАК ВТ_Промежуточная
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотреблениеТоваров.Товары КАК ВнутреннееПотреблениеТоваровТовары
		ПО ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту = ВнутреннееПотреблениеТоваровТовары.Ссылка.ЗаказНаВнутреннееПотребление
			И (НЕ ВнутреннееПотреблениеТоваровТовары.Ссылка.ПометкаУдаления)
			И (ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту &lt;&gt; ЗНАЧЕНИЕ(Документ.ЗаказНаВнутреннееПотребление.ПустаяСсылка))

СГРУППИРОВАТЬ ПО
	ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту,
	ВТ_Промежуточная.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляСписано КАК ЗаказНаВнутреннееПотреблениеДляСписано,
	ВТ_Промежуточная.Номенклатура КАК Номенклатура,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВнутреннееПотреблениеТоваровТовары.Ссылка) КАК ВнутреннееПотреблениеДляСписано
ПОМЕСТИТЬ ВТ_ВнутрПотреблениеДляСписано
ИЗ
	ВТ_Промежуточная КАК ВТ_Промежуточная
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотреблениеТоваров.Товары КАК ВнутреннееПотреблениеТоваровТовары
		ПО ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляСписано = ВнутреннееПотреблениеТоваровТовары.Ссылка.ЗаказНаВнутреннееПотребление
			И (НЕ ВнутреннееПотреблениеТоваровТовары.Ссылка.ПометкаУдаления)
			И (ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляСписано &lt;&gt; ЗНАЧЕНИЕ(Документ.ЗаказНаВнутреннееПотребление.ПустаяСсылка))

СГРУППИРОВАТЬ ПО
	ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляСписано,
	ВТ_Промежуточная.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Промежуточная.ЗаказПоставщику КАК ЗаказПоставщику,
	ВТ_Промежуточная.Номенклатура КАК Номенклатура,
	МАКСИМУМ(ПриобретениеТоваровУслугТовары.Ссылка) КАК ПриобретениеТоваров
ПОМЕСТИТЬ ВТ_ПриобретениеТоваров
ИЗ
	ВТ_Промежуточная КАК ВТ_Промежуточная
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		ПО ВТ_Промежуточная.Номенклатура = ПриобретениеТоваровУслугТовары.Номенклатура
			И ВТ_Промежуточная.ЗаказПоставщику = ПриобретениеТоваровУслугТовары.Ссылка.ЗаказПоставщику
			И (НЕ ПриобретениеТоваровУслугТовары.Ссылка.ПометкаУдаления)

СГРУППИРОВАТЬ ПО
	ВТ_Промежуточная.ЗаказПоставщику,
	ВТ_Промежуточная.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Промежуточная.Ссылка КАК ЗаявкаНаГарантийныйРемонт,
	ВТ_Промежуточная.Номенклатура КАК Номенклатура,
	ВТ_Промежуточная.Количество КАК Количество,
	ЕСТЬNULL(ВТ_ВнутрПотреблениеДляУстановленоКлиенту.ВнутреннееПотреблениеДляУстановленоКлиенту, ЗНАЧЕНИЕ(Документ.ВнутреннееПотреблениеТоваров.ПустаяСсылка)) КАК УстановленоКлиенту,
	ВТ_Промежуточная.ДокументВводОстатков КАК ПолученоОтКлиента,
	ЕСТЬNULL(ВТ_ВнутрПотреблениеДляСписано.ВнутреннееПотреблениеДляСписано, ВТ_Промежуточная.ВозвратПоставщику) КАК ОтправленоПоставщикуСписано,
	ВТ_ПриобретениеТоваров.ПриобретениеТоваров КАК ПолученоОтПоставщика,
	ВТ_Промежуточная.РешениеПоставщика КАК РешениеПоставщика,
	ВТ_Промежуточная.АрендаЗапчастей КАК АрендаЗапчастей,
	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК СебестоимостьЗаЕд,
	ВТ_Промежуточная.Количество * ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК СебестоимостьВсего
ИЗ
	ВТ_Промежуточная КАК ВТ_Промежуточная
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВнутрПотреблениеДляУстановленоКлиенту КАК ВТ_ВнутрПотреблениеДляУстановленоКлиенту
		ПО (ВТ_Промежуточная.Номенклатура = ВТ_ВнутрПотреблениеДляУстановленоКлиенту.Номенклатура)
			И (ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту = ВТ_ВнутрПотреблениеДляУстановленоКлиенту.ЗаказНаВнутреннееПотреблениеДляУстановленоКлиенту)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВнутрПотреблениеДляСписано КАК ВТ_ВнутрПотреблениеДляСписано
		ПО (ВТ_Промежуточная.Номенклатура = ВТ_ВнутрПотреблениеДляСписано.Номенклатура)
			И (ВТ_Промежуточная.ЗаказНаВнутреннееПотреблениеДляСписано = ВТ_ВнутрПотреблениеДляСписано.ЗаказНаВнутреннееПотреблениеДляСписано)
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПриобретениеТоваров КАК ВТ_ПриобретениеТоваров
		ПО (ВТ_Промежуточная.Номенклатура = ВТ_ПриобретениеТоваров.Номенклатура)
			И (ВТ_Промежуточная.ЗаказПоставщику = ВТ_ПриобретениеТоваров.ЗаказПоставщику)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
				&amp;ДатаОкончания,
				Номенклатура в (ВЫБРАТЬ ВТ.Номенклатура ИЗ ВТ_Промежуточная КАК ВТ )
				И ВидЦены = &amp;ВидЦеныСебестоимость) КАК ЦеныНоменклатурыСрезПоследних
		ПО (ВТ_Промежуточная.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура)</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<totalField>
		<dataPath>СебестоимостьВсего</dataPath>
		<expression>Сумма(СебестоимостьВсего)</expression>
	</totalField>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>КонецПериода(&amp;ПериодОтчета.ДатаОкончания, "день")</expression>
	</parameter>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>ВидЦеныСебестоимость</name>
