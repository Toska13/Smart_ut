<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Инженер</dataPath>
			<field>Инженер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Инженер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дата</dataPath>
			<field>Дата</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Командировка</dataPath>
			<field>Командировка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content> </v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДеньНедели</dataPath>
			<field>ДеньНедели</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>День недели</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заявка</dataPath>
			<field>Заявка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкаРасшифровка</dataPath>
			<field>ЗаявкаРасшифровка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка расшифровка</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫРАЗИТЬ(смартПредопределенныеЗначенияЗначения.Значение КАК Справочник.Пользователи) КАК Значение
ПОМЕСТИТЬ ВТ_ВсеСервисныеИнженеры
ИЗ
	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
ГДЕ
	смартПредопределенныеЗначенияЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.смартПредопределенныеЗначения.СписокИнженеров)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	смартЗаявкаНаРемонтныеРаботы.Ссылка КАК Ссылка,
	смартЗаявкаНаРемонтныеРаботы.Командировка КАК Командировка,
	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС КАК НазначеннаяДатаРемонтаС,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо
	КОНЕЦ КАК НазначеннаяДатаРемонтаПо,
	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер КАК НазначенныйНаРемонтИнженер
ПОМЕСТИТЬ ВТ_ВсеЗаявки
ИЗ
	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
ГДЕ
	ВЫБОР
			КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС &gt;= &amp;Период
				ТОГДА ИСТИНА
			КОГДА ВЫБОР
					КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС
					ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо
				КОНЕЦ &gt;= &amp;Период
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	И смартЗаявкаНаРемонтныеРаботы.Статус В(&amp;Статусы)

ОБЪЕДИНИТЬ

ВЫБРАТЬ
	смартЗаявкаНаРемонтныеРаботы.Ссылка,
	смартЗаявкаНаРемонтныеРаботы.Командировка2,
	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2
	КОНЕЦ,
	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2
ИЗ
	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
ГДЕ
	ВЫБОР
			КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 &gt;= &amp;Период
				ТОГДА ИСТИНА
			КОГДА ВЫБОР
					КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2
					ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2
				КОНЕЦ &gt;= &amp;Период
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	И НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	И смартЗаявкаНаРемонтныеРаботы.Статус В(&amp;Статусы)

// ++ 26.02.2021
ОБЪЕДИНИТЬ

ВЫБРАТЬ
	смартЗаявкаНаПускоНаладку.Ссылка КАК Ссылка,
	ЛОЖЬ КАК Командировка,
	// ++ 16.08.2021
	//смартЗаявкаНаПускоНаладку.ЖелаемаяДатаИнсталляции КАК НазначеннаяДатаРемонтаС,
	//смартЗаявкаНаПускоНаладку.ЖелаемаяДатаИнсталляции КАК НазначеннаяДатаРемонтаПо,
	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС
		ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо
	КОНЕЦ,

	// --
	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер КАК НазначенныйНаРемонтИнженер
ИЗ
	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
ГДЕ
	// ++ 16.08.2021
	//ВЫБОР
	//		КОГДА смартЗаявкаНаПускоНаладку.ЖелаемаяДатаИнсталляции &gt;= &amp;Период
	//			ТОГДА ИСТИНА
	//		ИНАЧЕ ЛОЖЬ
	//	КОНЕЦ
	ВЫБОР
			КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС &gt;= &amp;Период
				ТОГДА ИСТИНА
			КОГДА ВЫБОР
					КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС
					ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо
				КОНЕЦ &gt;= &amp;Период
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	// --
	И НЕ смартЗаявкаНаПускоНаладку.ПометкаУдаления
	И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	И смартЗаявкаНаПускоНаладку.Статус В(&amp;Статусы)

// ++ 16.08.2021
ОБЪЕДИНИТЬ

ВЫБРАТЬ
	смартЗаявкаНаПускоНаладку.Ссылка КАК Ссылка,
	ЛОЖЬ КАК Командировка,
	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2 = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2
		ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2
	КОНЕЦ,
	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2 КАК НазначенныйНаРемонтИнженер
ИЗ
	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
ГДЕ
	// ++ 16.08.2021
	//ВЫБОР
	//		КОГДА смартЗаявкаНаПускоНаладку.ЖелаемаяДатаИнсталляции &gt;= &amp;Период
	//			ТОГДА ИСТИНА
	//		ИНАЧЕ ЛОЖЬ
	//	КОНЕЦ
	ВЫБОР
			КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2 &gt;= &amp;Период
				ТОГДА ИСТИНА
			КОГДА ВЫБОР
					КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2 = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2
					ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2
				КОНЕЦ &gt;= &amp;Период
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
	// --
	И НЕ смартЗаявкаНаПускоНаладку.ПометкаУдаления
	И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	И смартЗаявкаНаПускоНаладку.Статус В(&amp;Статусы)
// --
//++ смарт:ММ 633 10.09.2021
ОБЪЕДИНИТЬ

ВЫБРАТЬ
	смартСтатусыИнженеров.ТекущийСтатус,
	ЛОЖЬ,
	смартСтатусыИнженеров.ДатаНачала,
	ВЫБОР
		КОГДА смартСтатусыИнженеров.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартСтатусыИнженеров.ДатаНачала
		ИНАЧЕ смартСтатусыИнженеров.ДатаОкончания
	КОНЕЦ,
	смартСтатусыИнженеров.Инженер
ИЗ
	РегистрСведений.смартСтатусыИнженеров КАК смартСтатусыИнженеров
ГДЕ
	ВЫБОР
			КОГДА смартСтатусыИнженеров.ДатаНачала &gt;= &amp;Период
				ТОГДА ИСТИНА
			КОГДА ВЫБОР
					КОГДА смартСтатусыИнженеров.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
						ТОГДА смартСтатусыИнженеров.ДатаНачала
					ИНАЧЕ смартСтатусыИнженеров.ДатаОкончания
				КОНЕЦ &gt;= &amp;Период
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
//-- смарт:ММ 10.09.2021
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(ВТ_ВсеЗаявки.НазначеннаяДатаРемонтаПо) КАК НазначеннаяДатаРемонтаПо
ПОМЕСТИТЬ ВТ_МаксимальнаяДатаОтчета
ИЗ
	ВТ_ВсеЗаявки КАК ВТ_ВсеЗаявки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	КалендарныеГрафики.ДатаГрафика КАК Дата
ПОМЕСТИТЬ ВТ_ВсеДатыОтчета
ИЗ
	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксимальнаяДатаОтчета КАК ВТ_МаксимальнаяДатаОтчета
		ПО КалендарныеГрафики.ДатаГрафика &lt;= ВТ_МаксимальнаяДатаОтчета.НазначеннаяДатаРемонтаПо
			И (КалендарныеГрафики.Календарь.Наименование = "Российская Федерация")
			И (КалендарныеГрафики.ДатаГрафика &gt;= НАЧАЛОПЕРИОДА(&amp;Период, ДЕНЬ))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВсеДатыОтчета.Дата КАК Дата,
	ВТ_ВсеСервисныеИнженеры.Значение КАК Инженер
ПОМЕСТИТЬ ВТ_ВсеДатыПоВсемИнженерам
ИЗ
	ВТ_ВсеСервисныеИнженеры КАК ВТ_ВсеСервисныеИнженеры
		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ВсеДатыОтчета КАК ВТ_ВсеДатыОтчета
		ПО (ИСТИНА)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВсеДатыПоВсемИнженерам.Дата КАК Дата,
	ВТ_ВсеДатыПоВсемИнженерам.Инженер КАК Инженер,
		
	ЕСТЬNULL(ВТ_ВсеЗаявки.Ссылка, "") КАК Заявка,
	ЕСТЬNULL(ВТ_ВсеЗаявки.Ссылка, "") КАК ЗаявкаРасшифровка,

	ЕСТЬNULL(ВТ_ВсеЗаявки.Ссылка.Номер, "") КАК Номер,
	ВТ_ВсеЗаявки.Командировка КАК Командировка,
	ВЫБОР ДЕНЬНЕДЕЛИ(ВТ_ВсеДатыПоВсемИнженерам.Дата) 
	КОГДА 1 ТОГДА "Понедельник"
	КОГДА 2 ТОГДА "Вторник"
	КОГДА 3 ТОГДА "Среда"
	КОГДА 4 ТОГДА "Четверг"
	КОГДА 5 ТОГДА "Пятница"
	КОГДА 6 ТОГДА "Суббота"
	КОГДА 7 ТОГДА "Воскресенье"
	КОНЕЦ КАК ДеньНедели
ИЗ
	ВТ_ВсеДатыПоВсемИнженерам КАК ВТ_ВсеДатыПоВсемИнженерам
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеЗаявки КАК ВТ_ВсеЗаявки
		ПО ВТ_ВсеДатыПоВсемИнженерам.Дата &gt;= ВТ_ВсеЗаявки.НазначеннаяДатаРемонтаС
			И ВТ_ВсеДатыПоВсемИнженерам.Дата &lt;= ВТ_ВсеЗаявки.НазначеннаяДатаРемонтаПо
			И ВТ_ВсеДатыПоВсемИнженерам.Инженер = ВТ_ВсеЗаявки.НазначенныйНаРемонтИнженер</query>
	</dataSet>
	<calculatedField>
		<dataPath>Текст</dataPath>
		<expression>ВЫБОР КОГДА ТипЗначения(Заявка) = тип( "Документ.смартЗаявкаНаПускоНаладку")  ТОГДА "Заявка на ПНР №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер)   КОГДА ТипЗначения(Заявка) = тип( "Документ.смартЗаявкаНаРемонтныеРаботы") ТОГДА "Заявка на ремонт №" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер) + выбор когда Командировка тогда " (Ком)" иначе " "  конец  КОГДА ТипЗначения(Заявка) = тип("Справочник.смартСписокСтатусовИнженеров")
ТОГДА Заявка ИНАЧЕ " " КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текст</v8:content>
			</v8:item>
		</title>
		<useRestriction>
			<field>true</field>
			<condition>true</condition>
			<group>true</group>
			<order>true</order>
		</useRestriction>
	</calculatedField>
	<totalField>
		<dataPath>Командировка</dataPath>
		<expression>Командировка</expression>
	</totalField>
	<totalField>
