		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ASP_ТаблицаЗнанийСрезПоследних.Инженер КАК Инженер,
	ASP_ТаблицаЗнанийСрезПоследних.Категория КАК Категория,
	ASP_ТаблицаЗнанийСрезПоследних.Категория.Коэффициент КАК Коэффициент,
	ASP_ТаблицаЗнанийСрезПоследних.Балл КАК Балл,
	ASP_ТаблицаЗнанийСрезПоследних.Категория.Коэффициент * ASP_ТаблицаЗнанийСрезПоследних.Балл КАК Итог
{ВЫБРАТЬ
	Инженер.*,
	Категория.*,
	Коэффициент,
	Балл,
	Итог}
ИЗ
	РегистрСведений.смартASP_ТаблицаЗнаний.СрезПоследних({(КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ДатаОтчета, МЕСЯЦ, -1), МЕСЯЦ))}, ) КАК ASP_ТаблицаЗнанийСрезПоследних
ГДЕ
	ASP_ТаблицаЗнанийСрезПоследних.Период МЕЖДУ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ДатаОтчета, МЕСЯЦ, -1), МЕСЯЦ) И КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ДатаОтчета, МЕСЯЦ, -1), МЕСЯЦ)
{ГДЕ
	ASP_ТаблицаЗнанийСрезПоследних.Инженер.*,
	ASP_ТаблицаЗнанийСрезПоследних.Категория.*,
	ASP_ТаблицаЗнанийСрезПоследних.Категория.Коэффициент,
	ASP_ТаблицаЗнанийСрезПоследних.Балл}</query>
	</dataSet>
