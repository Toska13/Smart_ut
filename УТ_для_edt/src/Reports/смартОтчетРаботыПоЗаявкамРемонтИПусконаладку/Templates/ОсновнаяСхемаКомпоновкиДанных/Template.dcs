<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Запрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дата</dataPath>
			<field>Дата</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Номер</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Представительство</dataPath>
			<field>Представительство</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаНачалаРабот</dataPath>
			<field>ДатаНачалаРабот</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>начало</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Инженер</dataPath>
			<field>Инженер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Инженер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВидРабот</dataPath>
			<field>ВидРабот</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вид работ</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers>
					<v8:Length>0</v8:Length>
					<v8:AllowedLength>Variable</v8:AllowedLength>
				</v8:StringQualifiers>
			</valueType>
			<availableValue>
				<value xsi:type="xs:string">Платный</value>
				<presentation xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Платный</v8:content>
					</v8:item>
				</presentation>
			</availableValue>
			<availableValue>
				<value xsi:type="xs:string">Гарантия</value>
				<presentation xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Гарантия</v8:content>
					</v8:item>
				</presentation>
			</availableValue>
			<availableValue>
				<value xsi:type="xs:string">Запуск</value>
				<presentation xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Запуск</v8:content>
					</v8:item>
				</presentation>
			</availableValue>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОкончанияРабот</dataPath>
			<field>ДатаОкончанияРабот</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>конец</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Модель</dataPath>
			<field>Модель</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Модель</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Командировка</dataPath>
			<field>Командировка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КомментарийМенеджера</dataPath>
			<field>КомментарийМенеджера</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Комментарии</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТипЧернил</dataPath>
			<field>ТипЧернил</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Тип чернил</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номер</dataPath>
			<field>Номер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер документа</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КонтактноеЛицо</dataPath>
			<field>КонтактноеЛицо</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ТелефонКонтактногоЛица</dataPath>
			<field>ТелефонКонтактногоЛица</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоИнженеров</dataPath>
			<field>КоличествоИнженеров</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество инженеров</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	смартЗаявкаНаРемонтныеРаботы.Ссылка КАК Ссылка,
	смартЗаявкаНаРемонтныеРаботы.Дата КАК Дата,
	смартЗаявкаНаРемонтныеРаботы.Номер КАК Номер,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Платная)
			ТОГДА "Платный"
		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Гарантия)
			ТОГДА "Гарантия"
	КОНЕЦ КАК ВидРабот,
	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер КАК Инженер,
	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС КАК ДатаНачалаРабот,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо
	КОНЕЦ КАК ДатаОкончанияРабот,
	смартЗаявкаНаРемонтныеРаботы.Представительство КАК Представительство,
	смартЗаявкаНаРемонтныеРаботы.Контрагент КАК Контрагент,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботыОборудование.ОборудованиеКлиентов = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
			ТОГДА смартЗаявкаНаРемонтныеРаботыОборудование.Оборудование
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботыОборудование.ОборудованиеКлиентов
	КОНЕЦ КАК Модель,
	смартЗаявкаНаРемонтныеРаботыОборудование.Серия КАК Серия,
	смартЗаявкаНаРемонтныеРаботы.Командировка КАК Командировка,
	смартЗаявкаНаРемонтныеРаботы.Статус КАК Статус,
	смартЗаявкаНаРемонтныеРаботыОборудование.ТипЧернилОборудование КАК ТипЧернил,
	ВЫРАЗИТЬ(смартЗаявкаНаРемонтныеРаботы.КомментарийМенеджера КАК СТРОКА(1000)) КАК КомментарийМенеджера,
	смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицо,
	смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
				И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ КАК КоличествоИнженеров
ИЗ
	Документ.смартЗаявкаНаРемонтныеРаботы.Оборудование КАК смартЗаявкаНаРемонтныеРаботыОборудование
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРемонтныеРаботы.КонтактныеЛица КАК смартЗаявкаНаРемонтныеРаботыКонтактныеЛица
			ПО (смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.Ссылка = смартЗаявкаНаРемонтныеРаботы.Ссылка)
		ПО смартЗаявкаНаРемонтныеРаботыОборудование.Ссылка = смартЗаявкаНаРемонтныеРаботы.Ссылка
ГДЕ
	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
{ГДЕ
	(смартЗаявкаНаРемонтныеРаботы.Дата &gt;= &amp;ДатаНачала),
	(смартЗаявкаНаРемонтныеРаботы.Дата &lt;= &amp;ДатаОкончания)}

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	смартЗаявкаНаРемонтныеРаботы.Ссылка,
	смартЗаявкаНаРемонтныеРаботы.Дата,
	смартЗаявкаНаРемонтныеРаботы.Номер,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Платная)
			ТОГДА "Платный"
		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Гарантия)
			ТОГДА "Гарантия"
	КОНЕЦ,
	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2,
	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2
	КОНЕЦ,
	смартЗаявкаНаРемонтныеРаботы.Представительство,
	смартЗаявкаНаРемонтныеРаботы.Контрагент,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботыОборудование.ОборудованиеКлиентов = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
			ТОГДА смартЗаявкаНаРемонтныеРаботыОборудование.Оборудование
		ИНАЧЕ смартЗаявкаНаРемонтныеРаботыОборудование.ОборудованиеКлиентов
	КОНЕЦ,
	смартЗаявкаНаРемонтныеРаботыОборудование.Серия,
	смартЗаявкаНаРемонтныеРаботы.Командировка,
	смартЗаявкаНаРемонтныеРаботы.Статус,
	смартЗаявкаНаРемонтныеРаботыОборудование.ТипЧернилОборудование,
	ВЫРАЗИТЬ(смартЗаявкаНаРемонтныеРаботы.КомментарийМенеджера КАК СТРОКА(1000)),
	смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.КонтактноеЛицо,
	смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.ТелефонКонтактногоЛица,
	ВЫБОР
		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
				И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ
ИЗ
	Документ.смартЗаявкаНаРемонтныеРаботы.Оборудование КАК смартЗаявкаНаРемонтныеРаботыОборудование
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРемонтныеРаботы.КонтактныеЛица КАК смартЗаявкаНаРемонтныеРаботыКонтактныеЛица
			ПО (смартЗаявкаНаРемонтныеРаботыКонтактныеЛица.Ссылка = смартЗаявкаНаРемонтныеРаботы.Ссылка)
		ПО смартЗаявкаНаРемонтныеРаботыОборудование.Ссылка = смартЗаявкаНаРемонтныеРаботы.Ссылка
ГДЕ
	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
{ГДЕ
	(смартЗаявкаНаРемонтныеРаботы.Дата &gt;= &amp;ДатаНачала),
	(смартЗаявкаНаРемонтныеРаботы.Дата &lt;= &amp;ДатаОкончания)}

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	смартЗаявкаНаПускоНаладку.Ссылка,
	смартЗаявкаНаПускоНаладку.Дата,
	смартЗаявкаНаПускоНаладку.Номер,
	"Запуск",
	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер,
	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС
		ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо
	КОНЕЦ,
	смартЗаявкаНаПускоНаладку.Представительство,
	смартЗаявкаНаПускоНаладку.Контрагент,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
			ТОГДА смартЗаявкаНаПускоНаладкуОборудование.Оборудование
		ИНАЧЕ смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов
	КОНЕЦ,
	смартЗаявкаНаПускоНаладкуОборудование.Серия,
	смартЗаявкаНаПускоНаладку.Командировка,
	смартЗаявкаНаПускоНаладку.Статус,
	смартЗаявкаНаПускоНаладкуОборудование.ТипЧернилОборудование,
	ВЫРАЗИТЬ(смартЗаявкаНаПускоНаладку.КомментарийМенеджера КАК СТРОКА(1000)),
	смартЗаявкаНаПускоНаладкуКонтактныеЛица.КонтактноеЛицо,
	смартЗаявкаНаПускоНаладкуКонтактныеЛица.ТелефонКонтактногоЛица,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
				И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ
ИЗ
	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаПускоНаладку.КонтактныеЛица КАК смартЗаявкаНаПускоНаладкуКонтактныеЛица
			ПО (смартЗаявкаНаПускоНаладкуКонтактныеЛица.Ссылка = смартЗаявкаНаПускоНаладку.Ссылка)
		ПО смартЗаявкаНаПускоНаладкуОборудование.Ссылка = смартЗаявкаНаПускоНаладку.Ссылка
ГДЕ
	НЕ смартЗаявкаНаПускоНаладку.ПометкаУдаления
	И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
{ГДЕ
	(смартЗаявкаНаПускоНаладку.Дата &gt;= &amp;ДатаНачала),
	(смартЗаявкаНаПускоНаладку.Дата &lt;= &amp;ДатаОкончания)}

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	смартЗаявкаНаПускоНаладку.Ссылка,
	смартЗаявкаНаПускоНаладку.Дата,
	смартЗаявкаНаПускоНаладку.Номер,
	"Запуск",
	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2,
	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2 = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2
		ИНАЧЕ смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2
	КОНЕЦ,
	смартЗаявкаНаПускоНаладку.Представительство,
	смартЗаявкаНаПускоНаладку.Контрагент,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
			ТОГДА смартЗаявкаНаПускоНаладкуОборудование.Оборудование
		ИНАЧЕ смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов
	КОНЕЦ,
	смартЗаявкаНаПускоНаладкуОборудование.Серия,
	смартЗаявкаНаПускоНаладку.Командировка,
	смартЗаявкаНаПускоНаладку.Статус,
	смартЗаявкаНаПускоНаладкуОборудование.ТипЧернилОборудование,
	ВЫРАЗИТЬ(смартЗаявкаНаПускоНаладку.КомментарийМенеджера КАК СТРОКА(1000)),
	смартЗаявкаНаПускоНаладкуКонтактныеЛица.КонтактноеЛицо,
	смартЗаявкаНаПускоНаладкуКонтактныеЛица.ТелефонКонтактногоЛица,
	ВЫБОР
		КОГДА смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
				И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
			ТОГДА 2
		ИНАЧЕ 1
	КОНЕЦ
ИЗ
	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаПускоНаладку.КонтактныеЛица КАК смартЗаявкаНаПускоНаладкуКонтактныеЛица
			ПО (смартЗаявкаНаПускоНаладкуКонтактныеЛица.Ссылка = смартЗаявкаНаПускоНаладку.Ссылка)
		ПО смартЗаявкаНаПускоНаладкуОборудование.Ссылка = смартЗаявкаНаПускоНаладку.Ссылка
ГДЕ
	НЕ смартЗаявкаНаПускоНаладку.ПометкаУдаления
	И смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2 &lt;&gt; ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
{ГДЕ
	(смартЗаявкаНаПускоНаладку.Дата &gt;= &amp;ДатаНачала),
	(смартЗаявкаНаПускоНаладку.Дата &lt;= &amp;ДатаОкончания)}</query>
	</dataSet>
