// Добавляет команду отчета в список команд.
// 
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - состав полей см. в функции МенюОтчеты.СоздатьКоллекциюКомандОтчетов.
//
Функция ДобавитьКомандуНоменклатура(КомандыОтчетов) Экспорт

	//Если ПравоДоступа("Просмотр", Метаданные.Отчеты.ВыручкаИСебестоимостьПродаж) Тогда
		
		КомандаОтчет = КомандыОтчетов.Добавить();
		
		КомандаОтчет.Менеджер = Метаданные.Отчеты.смартИсторияАвтоматизированногоРасчетаНеликвидов.ПолноеИмя();
		КомандаОтчет.Представление = НСтр("ru = 'История автоматизированного расчета неликвидов'");
		
		КомандаОтчет.МножественныйВыбор = Ложь;
		//КомандаОтчет.Важность = "Важное";
		КомандаОтчет.ДополнительныеПараметры.Вставить("ИмяКоманды", "смартИсторияАвтоматизированногоРасчетаНеликвидов");
		КомандаОтчет.КлючВарианта = "смартИсторияАвтоматизированногоРасчетаНеликвидовКонтекст";
		
		Возврат КомандаОтчет;
		
	//КонецЕсли;

	//Возврат Неопределено;

КонецФункции
