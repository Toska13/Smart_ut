	Если Настройки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранная настройка была удалена. Выберите другую.';en='The selected setting was deleted. Please choose a different one.'"));
		СвойстваНастроекФормы = СвойстваНастроекФормы();
		CRM_ОбщегоНазначенияСервер.ПользовательскиеНастройкиФормыПриСозданииНаСервере(ЭтотОбъект, СвойстваНастроекФормы);
		Возврат;
	КонецЕсли;
	Для каждого Настройка Из Настройки Цикл
		ЭтотОбъект[Настройка.Ключ] = Настройка.Значение;
	КонецЦикла;
	ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки);
