					СтруктураРасшифровки = Новый Структура("Серия, Точка, АктивныеУспешноНеудачно", "Активные", Точка.Значение, 2);
					Диаграмма.УстановитьЗначение(Точка, Серия, СтрокаСерияСравнение[Показатель+"Активных"], СтруктураРасшифровки);
