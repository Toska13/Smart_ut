			СтруктураРасшифровки = Новый Структура("Серия, Точка, АктивныеУспешноНеудачно", "Достроенные", Точка.Значение, 0);
			Диаграмма.УстановитьЗначение(Точка, Серия, ПоказательДостроенных, СтруктураРасшифровки);
