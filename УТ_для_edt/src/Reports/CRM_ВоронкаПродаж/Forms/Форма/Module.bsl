
#Область ОбработчикиСобытийФормы

&НаСервере
// Процедура - обработчик события формы "ПриСозданииНаСервере".
//
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ CRM_ЛицензированиеЭкспортныеМетоды.ПодсистемаCRMИспользуется() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Невозможно открыть воронку продаж. Подсистема 1С:CRM не используется! (см. Персональные настройки пользователя)';en='It is impossible to open the sales funnel. Subsystem 1C: CRM is not used! (see Personal settings of the user)'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	CRM_ЛицензированиеЭкспортныеМетоды.ПолучитьЗащищеннуюОбработку().ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	
	ЗаполнитьСписокВыбораТипДиаграммы();
	
	ВалютаУправленческогоУчета = Строка(Константы.ВалютаУправленческогоУчета.Получить());
	
	ИспользоватьБизнесПроцессы = ПолучитьФункциональнуюОпцию("CRM_ИспользоватьБизнесПроцессы");

	//++ #1759 смарт: Ермаков 24.04.2024 / Добавить в CRM обработку "Воронка продаж" отборы.
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ОтборТолькоНовые, ЭтаФорма.Элементы.ГруппаПоискИсточникПривлечения);
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ОтборТипыУслуг, ЭтаФорма.Элементы.ГруппаПоискИсточникПривлечения, ЭтаФорма.Элементы.ОтборТолькоНовые);
	
	//++ #1799 смарт: Ермаков 25.04.2024 / Доработка отчета Воронка продаж CRM
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ГруппаПоискСегментРегион, ЭтаФорма.Элементы.ЗначенияБыстрыеОтборы, ЭтаФорма.Элементы.ОтветственныйПодразделениеОфис);
	
	ГруппаОтветственныйПодразделение = ЭтаФорма.Элементы.Вставить("смартГруппаОтветственныйПодразделение", Тип("ГруппаФормы"), ЭтаФорма.Элементы.ЗначенияОсновныеОтборы, ЭтаФорма.Элементы.ГруппаПоискИсточникПривлечения);
	ГруппаОтветственныйПодразделение.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтветственныйПодразделение.ОтображатьЗаголовок = Ложь;
	ГруппаОтветственныйПодразделение.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ОтборОтветственные, ГруппаОтветственныйПодразделение);
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ОтборОтветственный, ГруппаОтветственныйПодразделение);
	//-- #1799 смарт: Ермаков 25.04.2024
	
	ЭтаФорма.Элементы.Переместить(ЭтаФорма.Элементы.ОтборПодразделение, ГруппаОтветственныйПодразделение);
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартКвалификация", Новый ОписаниеТипов("СписокЗначений"), "", "Квалификация"));	
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартВоронкаНовые", Новый ОписаниеТипов("Булево"), "", "Новые", Истина));
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартВоронкаСтарые", Новый ОписаниеТипов("Булево"), "", "Старые", Истина));
	
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов);
	
	ЭлементГруппаВоронки = ЭтаФорма.Элементы.Вставить("смартГруппаНовыеСтарые", Тип("ГруппаФормы"), ЭтаФорма.Элементы.Группа1, ЭтаФорма.Элементы.Группа2);
	ЭлементГруппаВоронки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппаВоронки.Заголовок = "Воронки";
	
	ЭлементГруппаКвалификации = ЭтаФорма.Элементы.Добавить("смартГруппаКвалификации", Тип("ГруппаФормы"), ЭтаФорма.Элементы.ЗначенияОсновныеОтборы);
	ЭлементГруппаКвалификации.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппаКвалификации.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ЭлементГруппаКвалификации.ОтображатьЗаголовок = Ложь;
	
	Для Каждого ЭлементМассива Из МассивРеквизитов Цикл
		
		Если ЭлементМассива.ТипЗначения = Новый ОписаниеТипов("Булево") Тогда
			
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить(ЭлементМассива.Имя, Тип("ПолеФормы"), ЭлементГруппаВоронки);
			НовыйЭлемент.ПутьКДанным = ЭлементМассива.Имя;
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
			
		Иначе
		
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить(ЭлементМассива.Имя, Тип("ПолеФормы"), ЭлементГруппаКвалификации);
			НовыйЭлемент.ПутьКДанным = ЭлементМассива.Имя;
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			НовыйЭлемент.КнопкаОчистки = Истина;
			
		КонецЕсли;
		
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОтборТолькоНовыеПриИзменении");
		
	КонецЦикла;
	//-- #1759 смарт: Ермаков 24.04.2024
	
	//++ #1799 смарт: Ермаков 26.04.2024 / Доработка отчета Воронка продаж CRM
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартПодразделения", Новый ОписаниеТипов("СписокЗначений"), "", "Подразделения"));
	
	//++ #Б-3616 смарт: Фролов 01.07.2025 //Доработка отчета Воронка продаж.
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартПричиныОтказа", Новый ОписаниеТипов("СписокЗначений")));
	//-- #Б-3616 смарт: Фролов 01.07.2025
	
	//++ #Б-6834 смарт: Фролов 12.05.2026 //Добавить в Воронку продаж отбор
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартИнтересКанал", Новый ОписаниеТипов("СписокЗначений")));
	//-- #Б-6834 смарт: Фролов 12.05.2026
	
	//++ #Б-7568 смарт: Фролов 27.07.2026 //задачи ком. отдела 21.07. Добавить отбор в отчет Воронка продаж
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартТолькоИнтересыНаОснованииЛида", Новый ОписаниеТипов("Булево"), "", "Только интересы на основании лида", Истина));
	//-- #Б-7568 смарт: Фролов 28.07.2026
		
	ЭтаФорма.ИзменитьРеквизиты(МассивРеквизитов);
	
	//++ #Б-6834 смарт: Фролов 12.05.2026 //Добавить в Воронку продаж отбор
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("смартИнтересКанал", Тип("ПолеФормы"), Элементы.ТипУслуг);
	НовыйЭлемент.ПутьКДанным = "смартИнтересКанал";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.Заголовок = "Канал (интерес)";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОтборТолькоНовыеПриИзменении");
	//-- #Б-6834 смарт: Фролов 12.05.2026
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("смартПодразделения", Тип("ПолеФормы"), ГруппаОтветственныйПодразделение);
	НовыйЭлемент.ПутьКДанным = "смартПодразделения";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОтборТолькоНовыеПриИзменении");
	
	ЭтаФорма.Элементы.ОтборОтветственные.Заголовок = "Ответственный";
	ЭтаФорма.Элементы.ОтборОтветственные.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	//-- #1799 смарт: Ермаков 26.04.2024 
	
	//++ #Б-7568 смарт: Фролов 27.07.2026 //задачи ком. отдела 21.07. Добавить отбор в отчет Воронка продаж
	ЭлементГруппаФлажки = ЭтаФорма.Элементы.Добавить("смартЭлементГруппаФлажки", Тип("ГруппаФормы"), Элементы.ГруппаПоискИсточникПривлечения);
	ЭлементГруппаФлажки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппаФлажки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ЭлементГруппаФлажки.ОтображатьЗаголовок = Ложь;
	
	Элементы.Переместить(Элементы.ОтборТолькоНовые, Элементы.смартЭлементГруппаФлажки);
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("смартТолькоИнтересыНаОснованииЛида", Тип("ПолеФормы"), Элементы.смартЭлементГруппаФлажки);
	НовыйЭлемент.ПутьКДанным = "смартТолькоИнтересыНаОснованииЛида";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка; 
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОтборТолькоНовыеПриИзменении");
	//-- #Б-7568 смарт: Фролов 28.07.2026

	//++ #Б-3616 смарт: Фролов 01.07.2025 //Доработка отчета Воронка продаж.
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("смартПричиныОтказа", Тип("ПолеФормы"), Элементы.ТипУслуг);
	НовыйЭлемент.ПутьКДанным = "смартПричиныОтказа";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.Заголовок = "Ислючая причины отказа";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ОтборТолькоНовыеПриИзменении");
	//-- #Б-3616 смарт: Фролов 01.07.2025
	
	ЗагрузитьНастройкиФормы();

	Если Параметры.Свойство("Воронка") Тогда
		Воронка = Параметры.Воронка;	
	КонецЕсли;	
	
	Если НЕ Пользователи.РолиДоступны("CRM_АнализПродажИВзаиморасчетовСКлиентами, ПолныеПрава") Тогда
		Элементы.ОтборОтветственные.Доступность = Ложь;
		ОтборОтветственные.Очистить();
		ОтборОтветственные.Добавить(Пользователи.ТекущийПользователь());
		ФиксированныйОтборПоПользователюПодразделению	= Истина;
	КонецЕсли;
	
	ЗаполнитьЦветовуюГамму();
	
	ОбновитьЗначенияОтбораПериодов();
	ВариантПериода = "ТекущийМесяц";
	ОтборПериод = ОтборСозданы[1].Значение;
	
	Если ЗначениеЗаполнено(Воронка) Тогда
		ЗаполнитьТаблицуЭтапыТекущейВоронкиИСоответствиеТочекМаршрута();
	КонецЕсли;
	
	НастроитьДоступностьИВидимостьФормы(ЭтотОбъект);
	
	Элементы.ТаблицаИнформацияСумма.Заголовок = НСтр("ru='Сумма (';en='Quantity ('") + ВалютаУправленческогоУчета +")";
	
	Если НЕ ПолучитьФункциональнуюОпцию("CRM_ИспользоватьТеги") Тогда
		Элементы.ЗначенияОтбораТеги.Видимость = Ложь;
		ОтбиратьПоТегам = Ложь;
	Иначе
		ОтбиратьОбъектыБезТегов = Ложь;
		ОтборПодразделениеДляТегов = Пользователи.АвторизованныйПользователь().Подразделение;
		ОтборПодразделениеДляТеговПриИзмененииНаСервере();
		ОбновитьЗначенияОтбораТегов();
	КонецЕсли;
	Элементы.ОтборОтветственные.ОграничениеТипа = Новый ОписаниеТипов("СписокЗначений");
	
	СвойстваНастроекФормы = СвойстваНастроекФормы();
	CRM_ОбщегоНазначенияСервер.ПользовательскиеНастройкиФормыПриСозданииНаСервере(ЭтотОбъект, СвойстваНастроекФормы);
	// +Рабочий стол
	CRM_СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	// -Рабочий стол
	
	Элементы.ОтборТипыУслуг.Видимость = ПолучитьФункциональнуюОпцию("CRM_ИспользоватьТипыУслуг");
	
	//++ #1453 смарт: Фролов 22.09.2023 //Доработка воронки продаж 
	смартУстановитьСпискиВыбораЭтапов();
	//-- #1453 смарт: Фролов 22.09.2023 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Перейдем сразу на вкладку отборов "Быстрые отборы" и оставим ее в свернутом режиме.
	Элементы.ПанельЗначенийОтбора.Видимость			= Истина;
	Элементы.ПанельЗначенийОтбора.ТекущаяСтраница	= Элементы.ЗначенияОсновныеОтборы;	
	ОсновныеОтборы(Элементы.ОсновныеОтборы);
	
	CRM_ТегиКлиент.ЗначенияОтборовИзменение(ЭтотОбъект, Элементы.БыстрыеОтборы, Элементы.ЗначенияБыстрыеОтборы);
	CRM_ТегиКлиент.ЗначенияОтборовИзменение(ЭтотОбъект, Элементы.ОсновныеОтборы, Элементы.ЗначенияОсновныеОтборы);

	//++ #1855 смарт: Ермаков 07.06.2024 / Доработка отчета Воронка продаж CRM - поле Период на форме
	ВариантПериода = ?(ВариантПериода = "", "ТекущийМесяц", ВариантПериода);
	//-- #1855 смарт: Ермаков 07.06.2024
	
	Если ЗначениеЗаполнено(ВариантПериода) Тогда
		CRM_ТегиКлиент.ОтборПоПеридуНажатие(ОтборСозданы, ВариантПериода, Элементы.ОтборПериод, Элементы.ЗначенияОтбораПериод);
		ОтборИнтересов.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);
		ОтборБизнесПроцессов.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);
		ОтборДокументы.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);
		CRM_ТегиКлиент.УстановитьОтборПоПериоду(ЭтотОбъект, "ОтборДокументы", ОтборСозданы, ВариантПериода);
	КонецЕсли;
	
	ОтборИнтересов.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);
	ОтборБизнесПроцессов.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);
	ОтборДокументы.Параметры.УстановитьЗначениеПараметра("ДатаНачала", ОтборПериод.ДатаНачала);

	Если ЗначениеЗаполнено(Воронка) Тогда
		ПриСменеВоронки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ПоискИсточникПривлечения = Настройки.Получить("ПоискИсточникПривлечения");
	Если ЗначениеЗаполнено(ПоискИсточникПривлечения) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборИнтересов, "ИсточникПривлечения", ПоискИсточникПривлечения, Истина);
	КонецЕсли;
	Если ЗначениеЗаполнено(ПоискИсточникПривлечения) И НЕ (ТипПВХ(ПоискИсточникПривлечения) = Тип("ПеречислениеСсылка.CRM_КаналыБезУказанияИсточника")) Тогда
		Элементы.ПоискЗначениеИсточникаПривлечения.Доступность		= Истина;
		Элементы.ПоискЗначениеИсточникаПривлечения.ТолькоПросмотр	= Ложь;
	Иначе
		Элементы.ПоискЗначениеИсточникаПривлечения.Доступность		= Ложь;
		Элементы.ПоискЗначениеИсточникаПривлечения.ТолькоПросмотр	= Истина;
	КонецЕсли;
	
	ПоискЗначениеИсточникаПривлечения = Настройки.Получить("ПоискЗначениеИсточникаПривлечения");
	Если ЗначениеЗаполнено(ПоискЗначениеИсточникаПривлечения) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборИнтересов, "ЗначениеИсточникаПривлечения", ПоискЗначениеИсточникаПривлечения, Истина);
	КонецЕсли;
	ОтборСегментКлиентов = Настройки.Получить("ОтборСегментКлиентов");
	Если ЗначениеЗаполнено(ОтборСегментКлиентов) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборИнтересов, "Сегмент", ОтборСегментКлиентов, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборБизнесПроцессов, "Сегмент", ОтборСегментКлиентов, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборДокументы, "Сегмент", ОтборСегментКлиентов, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
	КонецЕсли;
	ОтборРегион = Настройки.Получить("ОтборРегион");
	Если ЗначениеЗаполнено(ОтборРегион) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборИнтересов, "БизнесРегион", ОтборРегион, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборБизнесПроцессов, "БизнесРегион", ОтборРегион, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборДокументы, "БизнесРегион", ОтборРегион, Истина, ВидСравненияКомпоновкиДанных.ВИерархии);
	КонецЕсли;
	ОтборТолькоНовые = Настройки.Получить("ОтборТолькоНовые");
	CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборИнтересов, "НовыйКлиент", Истина, ОтборТолькоНовые);
	CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборБизнесПроцессов, "НовыйКлиент", Истина, ОтборТолькоНовые);
	CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(ОтборДокументы, "НовыйКлиент", Истина, ОтборТолькоНовые);
	
	ВариантПериода = Настройки.Получить("ВариантПериода");
	ПроизвольныйПериод =  Настройки.Получить("ПроизвольныйПериод");
	ОтборСозданы[0].Значение = ПроизвольныйПериод;
	Для каждого Период Из ОтборСозданы Цикл
		Если ВариантПериода = Период.Представление Тогда
			ОтборПериод = Период.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Воронка) И Воронка.ПолучитьОбъект() = Неопределено Тогда
		Воронка = Справочники.CRM_ВоронкиПродаж.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

