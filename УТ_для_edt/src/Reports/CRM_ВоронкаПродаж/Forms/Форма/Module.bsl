	Диаграмма.ОбластьПостроения.Верх	= 0;
	Диаграмма.ОбластьПостроения.Лево	= 0;
	Диаграмма.ОбластьПостроения.Низ		= 1;
	Диаграмма.ОбластьПостроения.Право	= 1;
	
