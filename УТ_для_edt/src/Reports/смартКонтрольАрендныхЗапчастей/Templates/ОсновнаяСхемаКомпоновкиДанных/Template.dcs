<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол-во</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РешениеПоставщика</dataPath>
			<field>РешениеПоставщика</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкаНаГарантийныйРемонт</dataPath>
			<field>ЗаявкаНаГарантийныйРемонт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Заявка на гарантийный ремонт</v8:content>
				</v8:item>
			</title>
			<presentationExpression>НомерЗаявки</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураУстановленнаяКлиентуАртикул</dataPath>
			<field>НоменклатураУстановленнаяКлиентуАртикул</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номенклатура, установленная клиенту артикул</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураПринятаяОтКлиента</dataPath>
			<field>НоменклатураПринятаяОтКлиента</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусПолучения</dataPath>
			<field>СтатусПолучения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураУстановленнаяКлиенту</dataPath>
			<field>НоменклатураУстановленнаяКлиенту</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураПринятаяОтКлиентаАртикул</dataPath>
			<field>НоменклатураПринятаяОтКлиентаАртикул</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номенклатура, принятая от клиента артикул</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Статус</dataPath>
			<field>Статус</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Примечание</dataPath>
			<field>Примечание</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Комментарий</dataPath>
			<field>Комментарий</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дата</dataPath>
			<field>Дата</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерЗаявки</dataPath>
			<field>НомерЗаявки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер заявки</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка КАК ЗаявкаНаГарантийныйРемонт,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка.Номер КАК НомерЗаявки,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка.Дата КАК Дата,
	НоменклатураУстановленная.Артикул КАК НоменклатураУстановленнаяКлиентуАртикул,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураУстановленнаяКлиенту КАК НоменклатураУстановленнаяКлиенту,
	НоменклатураПринятая.Артикул КАК НоменклатураПринятаяОтКлиентаАртикул,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураПринятаяОтКлиента КАК НоменклатураПринятаяОтКлиента,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Количество КАК Количество,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура КАК Номенклатура,
	ВЫБОР
		КОГДА НЕ НоменклатураУстановленная.Артикул ПОДОБНО "%LOA%"
				И смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.СтатусПолучения = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПустаяСсылка)
			ТОГДА "еще не отгружено"
		ИНАЧЕ ВЫБОР
				КОГДА НЕ НоменклатураУстановленная.Артикул ПОДОБНО "%LOA%"
						И смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.СтатусПолучения = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление)
					ТОГДА "в пути"
				ИНАЧЕ ВЫБОР
						КОГДА НоменклатураУстановленная.Артикул ПОДОБНО "%LOA%"
							ТОГДА "аренда"
						ИНАЧЕ ""
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК Статус,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.СтатусПолучения КАК СтатусПолучения,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.РешениеПоставщика КАК РешениеПоставщика,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Примечание КАК Примечание,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка.Комментарий КАК Комментарий
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка = смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка
			И смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураПринятаяОтКлиента = смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура
			И смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.ИДСтрокиЗаполняетсяИнженером = смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.ИДСтрокиЗаполняетсяИнженером
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураУстановленная
		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураУстановленнаяКлиенту = НоменклатураУстановленная.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураПринятая
		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураПринятаяОтКлиента = НоменклатураПринятая.Ссылка
{ГДЕ
	(смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка.Дата &gt;= &amp;ДатаНачала),
	(смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка.Дата &lt;= &amp;ДатаОкончания)}
{ГДЕ  ВЫБОР
			КОГДА &amp;ЛОА
				ТОГДА НоменклатураУстановленная.Артикул ПОДОБНО "%LOA%"
			ИНАЧЕ НЕ НоменклатураУстановленная.Артикул ПОДОБНО "%LOA%"
		КОНЕЦ}
{ГДЕ  смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка.Поставщик В (&amp;Поставщик)}

УПОРЯДОЧИТЬ ПО
	НомерЗаявки</query>
		<useQueryGroupIfPossible>false</useQueryGroupIfPossible>
	</dataSet>
	<parameter>
		<name>ПериодОтчета</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период отчета</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:type="v8:StandardPeriod">
			<v8:variant xsi:type="v8:StandardPeriodVariant">Custom</v8:variant>
			<v8:startDate>0001-01-01T00:00:00</v8:startDate>
			<v8:endDate>0001-01-01T00:00:00</v8:endDate>
		</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата начала</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>&amp;ПериодОтчета.ДатаНачала</expression>
	</parameter>
	<parameter>
		<name>ДатаОкончания</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата окончания</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>КонецПериода(&amp;ПериодОтчета.ДатаОкончания, "день")</expression>
	</parameter>
	<parameter>
		<name>ЛОА</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ЛОА</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:boolean</v8:Type>
		</valueType>
		<value xsi:type="xs:boolean">false</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>Поставщик</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Поставщик</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Партнеры</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
