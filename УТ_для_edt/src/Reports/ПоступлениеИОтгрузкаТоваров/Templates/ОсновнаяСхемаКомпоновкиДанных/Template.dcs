<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>Поступление и отгрузка заказа</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Приход</dataPath>
			<field>Приход</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Приход</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧЦ=15; ЧДЦ=3</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Характеристика</dataPath>
			<field>Характеристика</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Расход</dataPath>
			<field>Расход</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Расход</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧЦ=15; ЧДЦ=3</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаДокумента</dataPath>
			<field>ДатаДокумента</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата документа</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Additional</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Склад</dataPath>
			<field>Склад</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОснование</dataPath>
			<field>ДокументОснование</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Документ-основание</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
			<presentationExpression>ВЫБОР КОГДА Не ДокументОснование = НЕОПРЕДЕЛЕНО И НЕ ТИПЗНАЧЕНИЯ(ДокументОснование) = ТИП("СТРОКА") И НЕ ТИПЗНАЧЕНИЯ(ДокументОснование) = ТИП("Справочник.Назначения") И НЕ ТИПЗНАЧЕНИЯ(ДокументОснование) = ТИП("Документ.КорректировкаНазначенияТоваров") ТОГДА
ОбщегоНазначенияУТ.ПолучитьПредставлениеДокумента(ДокументОснование, ДокументОснование.Номер,ДокументОснование.Дата) ИНАЧЕ ДокументОснование КОНЕЦ</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НачальныйОстаток</dataPath>
			<field>НачальныйОстаток</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Начальный остаток</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ЧЦ=15; ЧДЦ=3</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>ВыделятьОтрицательные</dcscor:parameter>
					<dcscor:value xsi:type="xs:boolean">true</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
					<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Действие</dataPath>
			<field>Действие</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Действие</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>2</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
			<presentationExpression>ВЫБОР КОГДА Действие = 1 ТОГДА НСтр("ru = 'Отгружается'") КОГДА Действие = 2 ТОГДА НСтр("ru = 'Резерв (обособленный)'") КОГДА Действие = 3 ТОГДА НСтр("ru = 'Резерв'") КОГДА Действие = 5 ТОГДА НСтр("ru = 'Резерв к дате отгрузки'") ИНАЧЕ "" КОНЕЦ</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодРасшифровка</dataPath>
			<field>ПериодРасшифровка</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Период расшифровка</v8:content>
				</v8:item>
			</title>
			<useRestriction>
				<field>true</field>
				<condition>true</condition>
				<group>true</group>
				<order>true</order>
			</useRestriction>
			<role>
				<dcscom:periodNumber>3</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОтгрузки</dataPath>
			<field>ДокументОтгрузки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Назначение</dataPath>
			<field>Назначение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Получатель</dataPath>
			<field>Получатель</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НачальныйОстатокГарантийные</dataPath>
			<field>НачальныйОстатокГарантийные</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Начальный остаток гарантийные</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПриходГарантийные</dataPath>
			<field>ПриходГарантийные</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Приход гарантийные</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РасходГарантийные</dataPath>
			<field>РасходГарантийные</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Расход гарантийные</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>// 1) В наличии
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	0                                             КАК Действие,
	Таблица.Номенклатура                          КАК Номенклатура,
	Таблица.Характеристика                        КАК Характеристика,
	Таблица.Склад                                 КАК Склад,

	ДАТАВРЕМЯ(1, 1, 1)                            КАК ПериодРасшифровка,
	&amp;ВНаличии                                     КАК ДокументОснование,
	ДАТАВРЕМЯ(1, 1, 1)                            КАК ДатаДокумента,

	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	Таблица.ВНаличииОстаток                       КАК НачальныйОстаток,
	Таблица.смартВНаличииГарантийныеОстаток       КАК НачальныйОстатокГарантийные,
	0                                             КАК Приход,
	0                                             КАК ПриходГарантийные,
	0                                             КАК Расход,
	0                                             КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.СвободныеОстатки.Остатки КАК Таблица

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	0                        КАК Действие,
	Таблица.Номенклатура     КАК Номенклатура,
	Таблица.Характеристика   КАК Характеристика,
	Таблица.Склад            КАК Склад,

	ДАТАВРЕМЯ(1, 1, 1)       КАК ПериодРасшифровка,
	&amp;ВНаличии                КАК ДокументОснование,
	ДАТАВРЕМЯ(1, 1, 1)       КАК ДатаДокумента,
    
    //++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	Таблица.КОтгрузкеОстаток КАК НачальныйОстаток,
	Таблица.смартКОтгрузкеГарантийныеОстаток КАК НачальныйОстатокГарантийные,
	0                        КАК Приход,
	0                        КАК ПриходГарантийные,
	0                        КАК Расход,
	0                        КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024
ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки КАК Таблица

	ОБЪЕДИНИТЬ ВСЕ

// 2) Отгружается
ВЫБРАТЬ
	1                                             КАК Действие,
	Таблица.Номенклатура                          КАК Номенклатура,
	Таблица.Характеристика                        КАК Характеристика,
	Таблица.Склад                                 КАК Склад,

	ДАТАВРЕМЯ(1, 1, 1)                            КАК ПериодРасшифровка,
	Таблица.ДокументОтгрузки                      КАК ДокументОснование,
	ЕСТЬNULL(РеквизитыРаспоряжения.ДатаДокументаИБ, ДАТАВРЕМЯ(1,1,1)) КАК ДатаДокумента,
	
	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	0                                             КАК НачальныйОстаток,
	0                                             КАК НачальныйОстатокГарантийные,
	0                                             КАК Приход,
	0                                             КАК ПриходГарантийные,
	Таблица.КОтгрузкеОстаток                      КАК Расход,
	Таблица.смартКОтгрузкеГарантийныеОстаток      КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки КАК Таблица
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеквизитыРаспоряжения
			ПО Таблица.ДокументОтгрузки = РеквизитыРаспоряжения.Ссылка
				И НЕ РеквизитыРаспоряжения.ДополнительнаяЗапись

	ОБЪЕДИНИТЬ ВСЕ

// 3) Резервировать под заказ
ВЫБРАТЬ
	2                                             КАК Действие,
	Таблица.Номенклатура                          КАК Номенклатура,
	Таблица.Характеристика                        КАК Характеристика,
	Таблица.Склад                                 КАК Склад,

	ДАТАВРЕМЯ(1, 1, 1)                            КАК ПериодРасшифровка,

	ВЫБОР КОГДА Таблица.Назначение.Заказ = НЕОПРЕДЕЛЕНО ТОГДА
					Таблица.Назначение
				ИНАЧЕ
					Таблица.Назначение.Заказ
		КОНЕЦ                                     КАК ДокументОснование,
		
	ВЫБОР КОГДА Таблица.Назначение.Заказ = НЕОПРЕДЕЛЕНО ТОГДА
					ДАТАВРЕМЯ(1, 1, 1)
				ИНАЧЕ
					Таблица.Назначение.Заказ.Дата
		КОНЕЦ                                     КАК ДатаДокумента,

	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	0                                             КАК НачальныйОстаток,
	0                                             КАК НачальныйОстатокГарантийные,
	0                                             КАК Приход,
	0                                             КАК ПриходГарантийные,
	Таблица.НаличиеПодЗаказОстаток                КАК Расход,
	Таблица.смартНаличиеПодЗаказГарантийныеОстаток КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.ОбеспечениеЗаказов.Остатки КАК Таблица

ОБЪЕДИНИТЬ ВСЕ

// 4) Резервировать на складе
ВЫБРАТЬ
	3                                             КАК Действие,
	Таблица.Номенклатура                          КАК Номенклатура,
	Таблица.Характеристика                        КАК Характеристика,
	Таблица.Склад                                 КАК Склад,

	ДАТАВРЕМЯ(1, 1, 1)                            КАК ПериодРасшифровка,
	Таблица.ДокументОтгрузки                      КАК ДокументОснование,
	ЕСТЬNULL(РеквизитыРаспоряжения.ДатаДокументаИБ, ДАТАВРЕМЯ(1,1,1)) КАК ДатаДокумента,

	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	0                                             КАК НачальныйОстаток,
	0                                             КАК НачальныйОстатокГарантийные,
	0                                             КАК Приход,
	0                                             КАК ПриходГарантийные,
	Таблица.ВРезервеОстаток                       КАК Расход,
	Таблица.смартВРезервеГарантийныеОстаток       КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки КАК Таблица
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеквизитыРаспоряжения
			ПО Таблица.ДокументОтгрузки = РеквизитыРаспоряжения.Ссылка
				И НЕ РеквизитыРаспоряжения.ДополнительнаяЗапись

ОБЪЕДИНИТЬ ВСЕ

// 5) Ожидается к поступлению
ВЫБРАТЬ
	4                                                    КАК Действие,
	Таблица.Номенклатура                                 КАК Номенклатура,
	Таблица.Характеристика                               КАК Характеристика,
	Таблица.Склад                                        КАК Склад,

	ВЫБОР КОГДА Таблица.ДатаСобытия &lt; &amp;НачалоТекущегоДня ТОГДА
				&amp;НачалоТекущегоДня
			ИНАЧЕ
				Таблица.ДатаСобытия
		КОНЕЦ                                            КАК ПериодРасшифровка,

	Таблица.Регистратор                                  КАК ДокументОснование,
	МАКСИМУМ(Таблица.Регистратор.Дата)                   КАК ДатаДокумента,

	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	0                                                    КАК НачальныйОстаток,
	0                                                    КАК НачальныйОстатокГарантийные,
	СУММА(Таблица.КоличествоИзЗаказовСНеподтвержденными) КАК Приход,
	СУММА(Таблица.смартКоличествоИзЗаказовСНеподтвержденнымиГарантийные) КАК ПриходГарантийные,
	0                                                    КАК Расход,
	0                                                    КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.ГрафикПоступленияТоваров КАК Таблица

ГДЕ
	Таблица.КоличествоИзЗаказов &lt;&gt; 0
	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	ИЛИ Таблица.смартКоличествоИзЗаказовГарантийные &lt;&gt; 0
	//-- #Б1480 смарт: Шляпников 03.12.2024

СГРУППИРОВАТЬ ПО
	Таблица.Номенклатура, Таблица.Характеристика, Таблица.Склад,
	ВЫБОР КОГДА Таблица.ДатаСобытия &lt; &amp;НачалоТекущегоДня ТОГДА
				&amp;НачалоТекущегоДня
			ИНАЧЕ
				Таблица.ДатаСобытия
		КОНЕЦ,
	Таблица.Регистратор

ОБЪЕДИНИТЬ ВСЕ

// 6) Резервировать к дате
ВЫБРАТЬ
	5                                             КАК Действие,
	Таблица.Номенклатура                          КАК Номенклатура,
	Таблица.Характеристика                        КАК Характеристика,
	Таблица.Склад                                 КАК Склад,

	ВЫБОР КОГДА Таблица.ДатаОтгрузки &lt; &amp;НачалоТекущегоДня ТОГДА
				&amp;НачалоТекущегоДня
			ИНАЧЕ
				Таблица.ДатаОтгрузки
		КОНЕЦ                                     КАК ПериодРасшифровка,

	Таблица.Регистратор                           КАК ДокументОснование,
	МАКСИМУМ(Таблица.Регистратор.Дата)            КАК ДатаДокумента,

	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	0                                             КАК НачальныйОстаток,
	0                                             КАК НачальныйОстатокГарантийные,
	0                                             КАК Приход,
	0                                             КАК ПриходГарантийные,
	СУММА(Таблица.КоличествоИзЗаказов)            КАК Расход,
	СУММА(Таблица.смартКоличествоИзЗаказовГарантийные)            КАК РасходГарантийные
	//-- #Б1480 смарт: Шляпников 03.12.2024

ИЗ
	РегистрНакопления.ГрафикОтгрузкиТоваров КАК Таблица

ГДЕ
	Таблица.КоличествоИзЗаказов &lt;&gt; 0
	//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
	ИЛИ Таблица.смартКоличествоИзЗаказовГарантийные &lt;&gt; 0
	//-- #Б1480 смарт: Шляпников 03.12.2024

СГРУППИРОВАТЬ ПО
	Таблица.Номенклатура, Таблица.Характеристика, Таблица.Склад,
	ВЫБОР КОГДА Таблица.ДатаОтгрузки &lt; &amp;НачалоТекущегоДня ТОГДА
				&amp;НачалоТекущегоДня
			ИНАЧЕ
				Таблица.ДатаОтгрузки
		КОНЕЦ,
	Таблица.Регистратор

</query>
	</dataSet>
