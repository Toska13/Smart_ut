		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>КоличествоФакт</dataPath>
		<expression>Сумма(КоличествоФакт)</expression>
	</totalField>
	<totalField>
		<dataPath>КоличествоНеЗакрытые</dataPath>
		<expression>Сумма(КоличествоНеЗакрытые)</expression>
	</totalField>
