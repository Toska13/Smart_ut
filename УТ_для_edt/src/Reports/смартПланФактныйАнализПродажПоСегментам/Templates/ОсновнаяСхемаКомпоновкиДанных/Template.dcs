	Когда Сумма([Сумма план]) &gt; 0
		Тогда (Сумма([Сумма факт]) + Сумма(Сумма)) / Сумма([Сумма план]) * 100
	Иначе 0
Конец</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression>Выбор
	Когда Сумма(СуммаПлан) &gt; 0
		Тогда (Сумма(СуммаФакт) + Сумма(Сумма)) / Сумма(СуммаПлан) * 100
	Иначе 0
Конец</dcsset:totalExpression>
					<dcsset:totalExpressionPresentation>Выбор
	Когда Сумма([Сумма план]) &gt; 0
		Тогда (Сумма([Сумма факт]) + Сумма(Сумма)) / Сумма([Сумма план]) * 100
	Иначе 0
Конец</dcsset:totalExpressionPresentation>
				</dcsset:item>
			</dcsset:userFields>
