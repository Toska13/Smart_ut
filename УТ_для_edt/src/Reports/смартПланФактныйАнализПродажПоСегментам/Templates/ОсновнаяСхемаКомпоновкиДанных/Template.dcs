			<field xsi:type="DataSetFieldField">
				<dataPath>НаправлениеДеятельностиКонтрагента</dataPath>
				<field>НаправлениеДеятельностиКонтрагента</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Склад</dataPath>
