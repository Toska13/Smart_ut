				<dataPath>ХозяйственнаяОперация</dataPath>
				<field>ХозяйственнаяОперация</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>НаправлениеДеятельностиНоменклатуры</dataPath>
				<field>НаправлениеДеятельностиНоменклатуры</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>смартСтатусЗаказаКлиента</dataPath>
				<field>смартСтатусЗаказаКлиента</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>смартДатаЗакрытияЗаказа</dataPath>
				<field>смартДатаЗакрытияЗаказа</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>смартБизнесРегионКлиента</dataPath>
				<field>смартБизнесРегионКлиента</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ТипУслуги</dataPath>
				<field>ТипУслуги</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ВидПлана</dataPath>
				<field>ВидПлана</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>СегментНоменклатуры</dataPath>
				<field>СегментНоменклатуры</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Сегмент</dataPath>
				<field>Сегмент</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Номенклатура</dataPath>
				<field>Номенклатура</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КоличествоФакт</dataPath>
				<field>КоличествоФакт</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Количество факт</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КоличествоПлан</dataPath>
				<field>КоличествоПлан</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Количество план</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	НоменклатураСегмента.Сегмент КАК Сегмент,
	НоменклатураСегмента.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ НоменклатураСегментов
ИЗ
	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
ГДЕ
	НоменклатураСегмента.Сегмент.смартИспользуетсяВПланированииПродаж
	И НЕ НоменклатураСегмента.Сегмент.ЭтоГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	НоменклатураСегментов.Сегмент КАК Сегмент,
	НоменклатураСегментов.Номенклатура КАК Номенклатура,
	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиОборот) КАК СуммаФакт,
	СУММА(ВыручкаИСебестоимостьПродаж.СуммаВыручкиСНДСРеглОборот) КАК СуммаФактРегл,
	ВыручкаИСебестоимостьПродаж.смартДатаЗакрытияЗаказа КАК ДатаЗакрытия,
	ВыручкаИСебестоимостьПродаж.ЗаказКлиента КАК ЗаказКлиента,
	СУММА(ВыручкаИСебестоимостьПродаж.КоличествоОборот) КАК КоличествоФакт
ПОМЕСТИТЬ ВыручкаФакт
ИЗ
	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
			,
			,
			,
			смартДатаЗакрытияЗаказа МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
				И ВЫБОР
					КОГДА &amp;ДоступныВсеПользователи
						ТОГДА ИСТИНА
					ИНАЧЕ Менеджер = &amp;ТекущийПользователь
				КОНЕЦ
				И НЕ АналитикаУчетаПоПартнерам.Партнер В ИЕРАРХИИ (&amp;СмартГруппаКомпаний)) КАК ВыручкаИСебестоимостьПродаж
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураСегментов КАК НоменклатураСегментов
		ПО ВыручкаИСебестоимостьПродаж.АналитикаУчетаНоменклатуры.Номенклатура = НоменклатураСегментов.Номенклатура

СГРУППИРОВАТЬ ПО
	ВыручкаИСебестоимостьПродаж.смартДатаЗакрытияЗаказа,
	ВыручкаИСебестоимостьПродаж.ЗаказКлиента,
	НоменклатураСегментов.Сегмент,
	НоменклатураСегментов.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИтоговыеДанные.Сегмент КАК Сегмент,
	ИтоговыеДанные.Номенклатура КАК Номенклатура,
	ИтоговыеДанные.ПериодВыборки КАК ПериодВыборки,
	СУММА(ИтоговыеДанные.СуммаПлан) КАК СуммаПлан,
	СУММА(ИтоговыеДанные.СуммаФакт) КАК СуммаФакт,
	СУММА(ИтоговыеДанные.СуммаПланРегл) КАК СуммаПланРегл,
	СУММА(ИтоговыеДанные.СуммаФактРегл) КАК СуммаФактРегл,
	СУММА(ИтоговыеДанные.КоличествоФакт) КАК КоличествоФакт,
	СУММА(ИтоговыеДанные.КоличествоПлан) КАК КоличествоПлан
ИЗ
	(ВЫБРАТЬ
		ВыручкаФакт.Сегмент КАК Сегмент,
		ВыручкаФакт.Номенклатура КАК Номенклатура,
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, МЕСЯЦ)
		КОНЕЦ КАК ПериодВыборки,
		СУММА(0) КАК СуммаПлан,
		СУММА(ЕСТЬNULL(ВыручкаФакт.СуммаФакт, 0)) КАК СуммаФакт,
		СУММА(0) КАК СуммаПланРегл,
		СУММА(ЕСТЬNULL(ВыручкаФакт.СуммаФактРегл, 0)) КАК СуммаФактРегл,
		СУММА(ЕСТЬNULL(ВыручкаФакт.КоличествоФакт, 0)) КАК КоличествоФакт,
		0 КАК КоличествоПлан
	ИЗ
		ВыручкаФакт КАК ВыручкаФакт
	
	СГРУППИРОВАТЬ ПО
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыручкаФакт.ДатаЗакрытия, МЕСЯЦ)
		КОНЕЦ,
		ВыручкаФакт.Сегмент,
		ВыручкаФакт.Номенклатура
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		смартПланПродажПоМенеджерамОбороты.СегментНоменклатуры,
		ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, МЕСЯЦ)
		КОНЕЦ,
		СУММА(ЕСТЬNULL(смартПланПродажПоМенеджерамОбороты.СуммаОборот, 0)),
		СУММА(0),
		СУММА(ЕСТЬNULL(смартПланПродажПоМенеджерамОбороты.СуммаРеглОборот, 0)),
		СУММА(0),
		0,
		СУММА(смартПланПродажПоМенеджерамОбороты.КоличествоОборот)
	ИЗ
		РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
				{(&amp;ДатаНачала)},
				{(&amp;ДатаОкончания)},
				Регистратор,
				ВЫБОР
						КОГДА &amp;ДоступныВсеПользователи
							ТОГДА ИСТИНА
						ИНАЧЕ Менеджер = &amp;ТекущийПользователь
					КОНЕЦ
					И ВидПлана = &amp;ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
	
	СГРУППИРОВАТЬ ПО
		ВЫБОР
			КОГДА &amp;Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Квартал)
				ТОГДА НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, КВАРТАЛ)
			ИНАЧЕ НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамОбороты.Период, МЕСЯЦ)
		КОНЕЦ,
		смартПланПродажПоМенеджерамОбороты.СегментНоменклатуры) КАК ИтоговыеДанные

СГРУППИРОВАТЬ ПО
	ИтоговыеДанные.Сегмент,
	ИтоговыеДанные.ПериодВыборки,
	ИтоговыеДанные.Номенклатура</query>
		</item>
		<item xsi:type="DataSetQuery">
			<name>НаборДанных2</name>
			<field xsi:type="DataSetFieldField">
				<dataPath>Склад</dataPath>
				<field>Склад</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Номенклатура</dataPath>
				<field>Номенклатура</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Сумма</dataPath>
				<field>Сумма</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Сумма</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Серия</dataPath>
				<field>Серия</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ЗаказКлиента</dataPath>
				<field>ЗаказКлиента</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КодСтроки</dataPath>
				<field>КодСтроки</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Характеристика</dataPath>
				<field>Характеристика</field>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>Сегмент</dataPath>
				<field>Сегмент</field>
				<role>
					<dcscom:dimension>true</dcscom:dimension>
				</role>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>КоличествоНеЗакрытые</dataPath>
				<field>КоличествоНеЗакрытые</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Количество не закрытые</v8:content>
					</v8:item>
				</title>
			</field>
			<field xsi:type="DataSetFieldField">
				<dataPath>ПериодВыборки</dataPath>
				<field>ПериодВыборки</field>
				<title xsi:type="v8:LocalStringType">
					<v8:item>
						<v8:lang>ru</v8:lang>
						<v8:content>Период выборки</v8:content>
					</v8:item>
				</title>
			</field>
			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыЕВРО
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;EUR
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыДоллар
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;USD
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КурсыВалют.Период КАК Период,
	КурсыВалют.Курс КАК Курс
ПОМЕСТИТЬ КурсыЮань
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Валюта = &amp;CNY
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	НоменклатураСегмента.Сегмент КАК Сегмент,
	НоменклатураСегмента.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ НоменклатураСегментов
ИЗ
	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
ГДЕ
	НоменклатураСегмента.Сегмент.смартИспользуетсяВПланированииПродаж
	И НЕ НоменклатураСегмента.Сегмент.ЭтоГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	НоменклатураСегментов.Сегмент КАК Сегмент,
	НоменклатураСегментов.Номенклатура КАК Номенклатура,
	СУММА(ВЫБОР
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;EUR
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;USD
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход * ЕСТЬNULL(КурсыДоллар.Курс, 1) / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;CNY
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход * ЕСТЬNULL(КурсыЮань.Курс, 1) / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			КОГДА ЗаказыКлиентовОбороты.ЗаказКлиента.Валюта = &amp;RUR
				ТОГДА ЗаказыКлиентовОбороты.СуммаПриход / ЕСТЬNULL(КурсыЕВРО.Курс, 1)
			ИНАЧЕ ЗаказыКлиентовОбороты.СуммаПриход
		КОНЕЦ) КАК Сумма,
	СУММА(ЗаказыКлиентовОбороты.ЗаказаноПриход) КАК КоличествоНеЗакрытые,
	&amp;ДатаНачала КАК ПериодВыборки
ИЗ
	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыКлиентов.Обороты(, , , НЕ ЗаказКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)) КАК ЗаказыКлиентовОбороты
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыЕВРО КАК КурсыЕВРО
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыЕВРО.Период)
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыДоллар КАК КурсыДоллар
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыДоллар.Период)
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураСегментов КАК НоменклатураСегментов
			ПО ЗаказыКлиентовОбороты.Номенклатура = НоменклатураСегментов.Номенклатура
			ЛЕВОЕ СОЕДИНЕНИЕ КурсыЮань КАК КурсыЮань
			ПО (НАЧАЛОПЕРИОДА(ЗаказыКлиентовОбороты.ЗаказКлиента.Дата, ДЕНЬ) = КурсыЮань.Период)
		ПО (ЗаказыКлиентовОбороты.ЗаказКлиента = СостоянияЗаказовКлиентов.Заказ)
ГДЕ
	ЗаказыКлиентовОбороты.ЗаказаноПриход &gt; 0
	И СостоянияЗаказовКлиентов.ПроцентОплаты &gt; 0

СГРУППИРОВАТЬ ПО
	НоменклатураСегментов.Сегмент,
	НоменклатураСегментов.Номенклатура</query>
		</item>
	</dataSet>
	<calculatedField>
		<dataPath>СуммаСУчетомНеЗакрытых</dataPath>
		<expression/>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма с учетом не закрытых</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
		<dataPath>СуммаПлан</dataPath>
		<expression>Сумма(СуммаПлан)</expression>
		<group>Сегмент</group>
		<group>Сегмент Иерархия</group>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>СуммаПланРегл</dataPath>
		<expression>Сумма(СуммаПланРегл)</expression>
		<group>Сегмент</group>
