			<field>Тема</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПланируемаяДата</dataPath>
			<field>ПланируемаяДата</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСледующегоДействия</dataPath>
			<field>ДатаСледующегоДействия</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата следующего действия</v8:content>
				</v8:item>
				<v8:item>
					<v8:lang>en</v8:lang>
