Процедура ОжиданиеОплатыОтКлиентаОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	
	// Если установлен флаг КлиентОтказалсяОтЗаказаНаЭтапеОплаты, то проверки нет
	// Если не установлен флаг КлиентОтказалсяОтЗаказаНаЭтапеОплаты, то проверить наличие оплаты от клиента
	
	Результат = Истина;
	
	Если КлиентОтказалсяОтЗаказаНаЭтапеОплаты = Ложь Тогда
		
		ЕстьОплатаОтКлиента = ПроверитьНаличиеОплатыОтКлиента();
		Результат = ЕстьОплатаОтКлиента;
		
		Если НЕ Результат Тогда
			ОбщегоНазначения.СообщитьПользователю("По заказу клиента не поступало оплаты. Задача не выполнена.");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры




Процедура УстановитьИсполнителейИзсмартПредопределенногоЗначения(ФормируемыеЗадачи)
	
	СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.ПользовательОтветственныйЗаСозданиеНоменклатуры;
	смартОтветственныйЗаСозданиеНоменклатуры = Справочники.РолиИсполнителей.смартОтветственныйЗаСозданиеНоменклатуры;
	
	// Заполнить РС ИсполнителиЗадач актуальными значениями из предопределенных настроек смарт
	
	// 1. Сравнить пользователей из смарт предопределенных и регистра ИсполнителиЗадач
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
	|ПОМЕСТИТЬ ВТ_ИсполнителиВРегистре
	|ИЗ
	|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
	|ГДЕ
	|	ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_ИсполнителиПредопределенные
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	НЕ смартПредопределенныеЗначения.СписокЗначений
	|	И смартПредопределенныеЗначения.Ссылка = &СсылкаПредопределеннаяНастройка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
	|	И смартПредопределенныеЗначенияЗначения.Ссылка = &СсылкаПредопределеннаяНастройка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВТ_ИсполнителиВРегистре.Исполнитель, """") КАК ИзРегистра,
	|	ЕСТЬNULL(ВТ_ИсполнителиПредопределенные.Значение, """") КАК ИзСправочника
	|ИЗ
	|	ВТ_ИсполнителиВРегистре КАК ВТ_ИсполнителиВРегистре
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ИсполнителиПредопределенные КАК ВТ_ИсполнителиПредопределенные
	|		ПО ВТ_ИсполнителиВРегистре.Исполнитель = ВТ_ИсполнителиПредопределенные.Значение
	|ГДЕ
	|	(ВТ_ИсполнителиВРегистре.Исполнитель ЕСТЬ NULL
	|			ИЛИ ВТ_ИсполнителиПредопределенные.Значение ЕСТЬ NULL)";
	
	Запрос.УстановитьПараметр("РольИсполнителя", смартОтветственныйЗаСозданиеНоменклатуры);
	Запрос.УстановитьПараметр("СсылкаПредопределеннаяНастройка", СсылкаНаПредопределенноеЗначение);
	
	Результат = Запрос.Выполнить();
	
	ЕстьОтличия = НЕ Результат.Пустой();
	
	Если ЕстьОтличия Тогда
		
		МассивПользователей = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаНаПредопределенноеЗначение, Истина);

		//// 1. Удаление старых записей для роли смартОтветственныйЗаСозданиеНоменклатуры
		//	
		//Запрос = Новый Запрос;
		//Запрос.Текст = 
		//"ВЫБРАТЬ РАЗЛИЧНЫЕ
		//|	ИсполнителиЗадач.РольИсполнителя КАК РольИсполнителя,
		//|	ИсполнителиЗадач.Исполнитель КАК Исполнитель
		//|ИЗ
		//|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		//|ГДЕ
		//|	ИсполнителиЗадач.РольИсполнителя = &РольИсполнителя";
		//
		//Запрос.УстановитьПараметр("РольИсполнителя", смартОтветственныйЗаСозданиеНоменклатуры);
		//
		//Выборка = Запрос.Выполнить().Выбрать();
		//
		//Пока Выборка.Следующий() Цикл
		//	
		//	НаборЗаписей = РегистрыСведений.ИсполнителиЗадач.СоздатьНаборЗаписей();
		//	НаборЗаписей.Отбор.РольИсполнителя.Установить(Выборка.РольИсполнителя);
		//	НаборЗаписей.Отбор.Исполнитель.Установить(Выборка.Исполнитель);
		//	
		//	НаборЗаписей.Прочитать();		
		//	НаборЗаписей.Очистить();
		//	НаборЗаписей.Записать();
		//	
		//КонецЦикла;
		
		// 2. Добавление новых записей
		
		Если МассивПользователей.Количество() > 0 Тогда
			
			НаборЗаписей = РегистрыСведений.ИсполнителиЗадач.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.РольИсполнителя.Установить(смартОтветственныйЗаСозданиеНоменклатуры);

			Для Каждого ТекПользователь Из МассивПользователей Цикл
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.РольИсполнителя = смартОтветственныйЗаСозданиеНоменклатуры;
				НоваяЗапись.Исполнитель = ТекПользователь;
			КонецЦикла;
			НаборЗаписей.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
		
	//Если МассивПользователей.Количество() > 0 Тогда
