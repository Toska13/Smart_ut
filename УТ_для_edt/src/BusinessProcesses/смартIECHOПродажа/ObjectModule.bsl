Процедура ОтменитьЗаказПриСозданииЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, Отказ)
	
	Для Каждого ФормируемаяЗадача Из ФормируемыеЗадачи Цикл
		ФормируемаяЗадача.Исполнитель = Автор;
	КонецЦикла;
	
	ЗаполнитьСтандартныеРеквизитыНовойЗадачи(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи);
	
	// Проверка, возможно, задачу можно выполнить сразу
	
	Если ЗначениеЗаполнено(ЗаказКлиента) И ЗаказКлиента.ПометкаУдаления Тогда		
		
		Для Каждого ФормируемаяЗадача Из ФормируемыеЗадачи Цикл
			ФормируемаяЗадача.Выполнена = Истина;
			ФормируемаяЗадача.ДатаИсполнения = ТекущаяДатаСеанса();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтменитьЗаказОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	
	// Заказ клиента, созданные на основании спецификации, должен быть помечен на удаление
	Результат = Истина;
	
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Результат = ЗаказКлиента.ПометкаУдаления;
		Если НЕ Результат Тогда
			ОбщегоНазначения.СообщитьПользователю("Заказ клиента " + ЗаказКлиента + " не отменен. Задача не выполнена.");
		КонецЕсли;
	Иначе
		Результат = Ложь;
		ОбщегоНазначения.СообщитьПользователю("В задаче не указан заказ клиента");
	КонецЕсли;
		
КонецПроцедуры

