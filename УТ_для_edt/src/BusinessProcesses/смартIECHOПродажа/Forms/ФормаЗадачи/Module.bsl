&НаСервереБезКонтекста
Функция ПолучитьМассивТочекМаршрутаЗадачВыполняющихсяПрограммно()
	
	Результат = Новый Массив;
	Результат.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ПометитьСпецификациюНаУдаление);
	//Результат.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьНоменклатуруПоСпецификации);
	Результат.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьЗаказ);
	Результат.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОжиданиеОплатыОтКлиента);
	Результат.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОтменитьЗаказ);
	
	Возврат Результат;
	
КонецФункции

// ++ 23.01.2021
&НаКлиенте
Процедура ПроверкаИзмененийПоЗадаче()
	
	ЕстьМодификации = ПроверитьИзмененияПоЗадачеНаСервере();
	
	Если ЕстьМодификации И НЕ ЭтаФорма.Модифицированность Тогда
		ЭтаФорма.Прочитать();
		ПрочитатьРеквизитыИзБизнесПроцесса();
	КонецЕсли;
	
КонецПроцедуры

// ++ 23.01.2021
&НаСервере
Функция ПроверитьИзмененияПоЗадачеНаСервере()
	
	Результат = Ложь;
	
	ТочкаМаршрута = Объект.ТочкаМаршрута;
	
	Если ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ПометитьСпецификациюНаУдаление Тогда
		Если Объект.Предмет.ПометкаУдаления Тогда
			Результат = Истина;
		КонецЕсли;
	//ИначеЕсли ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьЗаказ Тогда
	//	Если ЗначениеЗаполнено(Объект.БизнесПроцесс.ЗаказКлиента) Тогда
	//		Результат = Истина;
	//	КонецЕсли;
	//ИначеЕсли ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОжиданиеОплатыОтКлиента Тогда
	//	Результат = Истина;
	ИначеЕсли ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОтменитьЗаказ Тогда
		Если ЗначениеЗаполнено(Объект.БизнесПроцесс.ЗаказКлиента) И Объект.БизнесПроцесс.ЗаказКлиента.ПометкаУдаления 
			ИЛИ ЗаказКлиента <> Объект.БизнесПроцесс.ЗаказКлиента Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе 
		БП = Объект.БизнесПроцесс;
		Если Номенклатура <> БП.Номенклатура
		ИЛИ КлиентСогласился <> БП.КлиентСогласился
		ИЛИ КлиентОтказалсяОтЗаказаНаЭтапеОплаты <> БП.КлиентОтказалсяОтЗаказаНаЭтапеОплаты
		ИЛИ ЗаказКлиента <> БП.ЗаказКлиента
		ИЛИ ЗаказПоставщику <> БП.ЗаказПоставщику
		ИЛИ Объект.ДатаИсполнения <> Объект.Ссылка.ДатаИсполнения Тогда
		Результат = Истина;
	КонецЕсли;

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

