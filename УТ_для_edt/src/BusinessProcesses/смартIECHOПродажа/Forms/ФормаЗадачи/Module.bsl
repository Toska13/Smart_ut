&НаСервере
Процедура ПрочитатьРеквизитыИзБизнесПроцесса()
	
	БП = Объект.БизнесПроцесс;
	КлиентСогласился = БП.КлиентСогласился;
	КлиентОтказалсяОтЗаказаНаЭтапеОплаты = БП.КлиентОтказалсяОтЗаказаНаЭтапеОплаты;
	Номенклатура 	= БП.Номенклатура;
	ЗаказКлиента 	= БП.ЗаказКлиента;
	ЗаказПоставщику = БП.ЗаказПоставщику;

КонецПроцедуры

// ++ 23.01.2021
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Форма = ЭтаФорма;
	
	Если ИмяСобытия = "смартЗапись_ЗадачаИсполнителяIECHO" 
		И НЕ Форма.Модифицированность 
		//И (Источник = Форма.Объект.Ссылка ИЛИ (ТипЗнч(Источник) = Тип("Массив") 
		//И Источник.Найти(Форма.Объект.Ссылка) <> Неопределено)) 
		Тогда
		
		Форма.Прочитать();
		ПрочитатьРеквизитыИзБизнесПроцесса();
			
	КонецЕсли;
	
КонецПроцедуры


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрытьВыполнить()

	ЗаписатьБизнесПроцессНаСервере();
	
	// Просто запись, без выполнения
	БизнесПроцессыИЗадачиКлиент.ЗаписатьИЗакрытьВыполнить(ЭтаФорма);

КонецПроцедуры

&НаСервере
Функция ЗадачуМожноЗакрыть()
	
	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ПроверитьВыполнение();
	
КонецФункции

&НаКлиенте
Процедура ВыполненоВыполнить()
	
	ЗаписатьБизнесПроцессНаСервере();
	
	Если Объект.Выполнена Тогда	
		Закрыть();
	КонецЕсли;
	
	ПроверкаПройдена = ЗадачуМожноЗакрыть();
	
	Если ПроверкаПройдена Тогда
		БизнесПроцессыИЗадачиКлиент.ЗаписатьИЗакрытьВыполнить(ЭтаФорма, Истина);
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не все условия задачи выполнены!");
	КонецЕсли;

	Оповестить("смартЗапись_ЗадачаИсполнителяIECHO");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьБизнесПроцессНаСервере()
	
	
	БПСсылка = Объект.БизнесПроцесс;
	
	Если БПСсылка.КлиентСогласился <> КлиентСогласился
		ИЛИ БПСсылка.КлиентОтказалсяОтЗаказаНаЭтапеОплаты <> КлиентОтказалсяОтЗаказаНаЭтапеОплаты
		ИЛИ БПСсылка.Номенклатура <> Номенклатура
		ИЛИ БПСсылка.ЗаказКлиента <> ЗаказКлиента
		ИЛИ БПСсылка.ЗаказПоставщику <> ЗаказПоставщику
		Тогда
		
		БП = БПСсылка.ПолучитьОбъект();
		БП.КлиентСогласился = КлиентСогласился;
		БП.КлиентОтказалсяОтЗаказаНаЭтапеОплаты = КлиентОтказалсяОтЗаказаНаЭтапеОплаты;
		БП.Номенклатура 	= Номенклатура;
		БП.ЗаказКлиента 	= ЗаказКлиента;
		БП.ЗаказПоставщику 	= ЗаказПоставщику;
		
		БП.Записать();
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	Элементы.ЗаданиеКлиентСогласился.Видимость = Ложь;
	Элементы.ЗаданиеКлиентСогласился.ТолькоПросмотр = Истина;
	
	Элементы.ЗаданиеНоменклатура.ТолькоПросмотр = Истина;
	Элементы.ЗаданиеНоменклатура.Видимость = Ложь;
	
	Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.Видимость = Ложь;
	Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.ТолькоПросмотр = Истина;
	
	Элементы.ЗаданиеЗаказКлиента.Видимость = Ложь;
	Элементы.ЗаданиеЗаказКлиента.ТолькоПросмотр = Истина;
	
	Элементы.ЗаданиеЗаказПоставщику.Видимость = Ложь;
	Элементы.ЗаданиеЗаказПоставщику.ТолькоПросмотр = Истина;
	
	Если Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СогласоватьСКлиентом Тогда  // 1
		Элементы.ЗаданиеКлиентСогласился.Видимость = Истина;
		Элементы.ЗаданиеКлиентСогласился.ТолькоПросмотр = Ложь;
	ИначеЕсли Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьНоменклатуруПоСпецификации Тогда  // 3
		Элементы.ЗаданиеНоменклатура.ТолькоПросмотр = Ложь;
		Элементы.ЗаданиеНоменклатура.Видимость = Истина;
	ИначеЕсли Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьЗаказ Тогда  // 4
		Элементы.ЗаданиеНоменклатура.Видимость = Истина;
		Элементы.ЗаданиеЗаказКлиента.Видимость = Истина;
		Элементы.ЗаданиеЗаказКлиента.ТолькоПросмотр = Ложь;
	ИначеЕсли Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОжиданиеОплатыОтКлиента Тогда // 5
		Элементы.ЗаданиеНоменклатура.Видимость = Истина;
		Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.Видимость = Истина;
		Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.ТолькоПросмотр = Ложь;
		Элементы.ЗаданиеЗаказКлиента.Видимость = Истина;
	ИначеЕсли Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОтменитьЗаказ Тогда // 6
		Элементы.ЗаданиеНоменклатура.Видимость = Истина;
		Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.Видимость = Истина;
		Элементы.ЗаданиеЗаказКлиента.Видимость = Истина;
		Элементы.ЗаданиеЗаказКлиента.ТолькоПросмотр = Ложь;
	ИначеЕсли Объект.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьЗаказПоставщику Тогда // 7
		Элементы.ЗаданиеНоменклатура.Видимость = Истина;
		Элементы.ЗаданиеКлиентОтказалсяОтЗаказаНаЭтапеОплаты.Видимость = Истина;
		Элементы.ЗаданиеЗаказКлиента.Видимость = Истина;
		Элементы.ЗаданиеЗаказПоставщику.Видимость = Истина;
		Элементы.ЗаданиеЗаказПоставщику.ТолькоПросмотр = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

