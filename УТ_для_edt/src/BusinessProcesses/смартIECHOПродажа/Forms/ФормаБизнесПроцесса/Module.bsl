// ++ 23.01.2021
&НаКлиенте
Процедура ПроверкаИзмененийПоБП()
	
	ЕстьМодификации = ПроверитьИзмененияНаСервере();
	
	Если ЕстьМодификации И НЕ ЭтаФорма.Модифицированность Тогда
		ЭтаФорма.Прочитать();
		ОбновитьКартуСервер();
	КонецЕсли;
	
КонецПроцедуры

// ++ 23.01.2021
&НаСервере
Функция ПроверитьИзмененияНаСервере()
	
	Результат = Ложь;
	
	Если Объект.Номенклатура <> Объект.Ссылка.Номенклатура
		ИЛИ Объект.КлиентСогласился <> Объект.Ссылка.КлиентСогласился
		ИЛИ Объект.КлиентОтказалсяОтЗаказаНаЭтапеОплаты <> Объект.Ссылка.КлиентОтказалсяОтЗаказаНаЭтапеОплаты
		ИЛИ Объект.ЗаказКлиента <> Объект.Ссылка.ЗаказКлиента
		ИЛИ Объект.ЗаказПоставщику <> Объект.Ссылка.ЗаказПоставщику
		ИЛИ Объект.Завершен <> Объект.Ссылка.Завершен Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
