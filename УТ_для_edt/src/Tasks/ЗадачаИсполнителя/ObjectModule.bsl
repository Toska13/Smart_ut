		|	ЗадачаИсполнителя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	НЕ ЗадачаИсполнителя.Выполнена
		|	И ЗадачаИсполнителя.смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.ОформлениеКомандировки)
		|	И ЗадачаИсполнителя.Предмет = &Предмет");
		Запрос.УстановитьПараметр("Предмет", Ссылка.Предмет);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОбъектЗадача = Выборка.Ссылка.ПолучитьОбъект();
			ОбъектЗадача.Выполнена = Истина;
			ОбъектЗадача.ДатаИсполнения = ТекущаяДата();
			ОбъектЗадача.Записать();
			
		КонецЦикла;	
		
	КонецЕсли;
	//-- #Б-3532 смарт: Фролов 16.06.2025
	
