Процедура ЗакрытьЗаказыНаПеремещение(ТаблицаЗаказов, АдресСервиснойЭлектроннойПочты, СоответствиеМенеджеровИЗаказовКУведомлениям)

	МассивОшибок = Новый Массив;
	
	ПараметрыЗакрытия = ЗаказыСервер.СтруктураКорректировкиСтрокЗаказа();
	ПараметрыЗакрытия.ОтменитьНеотработанныеСтроки = Истина;
	ПараметрыЗакрытия.ПроверятьОстатки = Истина;
	ПараметрыЗакрытия.ЗакрыватьЗаказы = Истина;

	Для Каждого стрЗаказ Из ТаблицаЗаказов Цикл
		
		ЗаказОбъект = стрЗаказ.ЗаказНаПеремещение.ПолучитьОбъект();
		
		Попытка
			ЗаказОбъект.Заблокировать();
		Исключение
			МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаПеремещение) + ". Не удалось заблокировать");
			Продолжить;
		КонецПопытки;
		
		ПараметрыЗакрытия.ДокументОбъект = ЗаказОбъект;
	
		Если ЗаказОбъект.УстановитьСтатус(1,ПараметрыЗакрытия) Тогда
			
			Попытка
				
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				НомерПоследнейВерсии = ВерсионированиеОбъектов.НомерПоследнейВерсии(стрЗаказ.ЗаказНаПеремещение);
				Если НомерПоследнейВерсии > 0 Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(стрЗаказ.ЗаказНаПеремещение, НомерПоследнейВерсии, "Автоматическое закрытие заказа по дате создания");	
				КонецЕсли;
				
			Исключение
				МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаПеремещение) + ". Не удалось закрыть. Причина: " + ОписаниеОшибки());
				ЗаказОбъект.Разблокировать();
				СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаПеремещениеОтветственный].Удалить(СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаПеремещениеОтветственный].Найти(стрЗаказ.ЗаказНаПеремещение));
			КонецПопытки;
			
		Иначе 
			
			МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаПеремещение) + ". Не удалось закрыть. Невозможно отменить все строки заказа. Дополнительно: " + ОписаниеОшибки());
			ЗаказОбъект.Разблокировать();
			СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаПеремещениеОтветственный].Удалить(СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаПеремещениеОтветственный].Найти(стрЗаказ.ЗаказНаПеремещение));
			
		КонецЕсли;
																
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		ДанныеДляОтправки = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность",
										 АдресСервиснойЭлектроннойПочты,
										 "Автоматическое закрытие заказов. Журнал ошибок",
										 "Журнал ошибок:" + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС),
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
	                              
	КонецЕсли; 
	
КонецПроцедуры 

