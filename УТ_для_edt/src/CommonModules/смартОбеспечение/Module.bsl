#Область РезервыКДате

Процедура РезервыКДатеУстановитьДатуПоступленияВЗаказахПоставщикам(ГрузСсылка, Отказ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ГрузСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГрузСсылка", ГрузСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	Документ.ЗаказПоставщику
	|ГДЕ
	|	Проведен
	|	И Груз = &ГрузСсылка
	|УПОРЯДОЧИТЬ ПО
	|	МоментВремени";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл 
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка
			ДокументОбъект.Заблокировать();
		Исключение			
			
			ОбщегоНазначения.СообщитьПользователю(
				"Документ " + ДокументОбъект + " заблокирован " + ОписаниеОшибки(), ДокументОбъект.Ссылка,,, Отказ);
			
			ОтменитьТранзакцию();
			Возврат;
			
		КонецПопытки;
		 
		ДокументОбъект.ЖелаемаяДатаПоступления = ГрузСсылка.ПланируемаяДатаПоступления;
		ДокументОбъект.ДатаПоступления = ГрузСсылка.ПланируемаяДатаПоступления;
		ДокументОбъект.ПоступлениеОднойДатой = Истина;
		
		Для Каждого СтрокаТовары Из ДокументОбъект.Товары Цикл 
			СтрокаТовары.ДатаПоступления = ГрузСсылка.ПланируемаяДатаПоступления;
		КонецЦикла;	
		
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение				
			
			ОбщегоНазначения.СообщитьПользователю(
				"Документ " + ДокументОбъект + " не записан " + ОписаниеОшибки(), ДокументОбъект.Ссылка,,, Отказ);
			
			Отказ=Истина;
			ОтменитьТранзакцию();
			Возврат;
			
		КонецПопытки;	
		
		ДокументОбъект.Разблокировать();
		
	КонецЦикла;  
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Процедура РезервыКДатеНастроитьПараметры(ЗаказПоставщику) Экспорт

	Если Не ЗаказПоставщику.ЭтоНовый() 
		 И ЗаказПоставщику.ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение
		 И ЗаказПоставщику.ПоступлениеОднойДатой
		 И Не ЗаказПоставщику.Ссылка.ДатаПоступления = ЗаказПоставщику.ДатаПоступления
		Тогда
		
		ТаблицаИзменений = ЗаказПоставщику.Товары.Выгрузить(, "Номенклатура, Характеристика, Склад, ДатаПоступления, Количество");
		ТаблицаИзменений.Колонки.Добавить("ДатаПоступленияНачальная", Новый ОписаниеТипов("Дата"));
		
		ТаблицаИзменений.ЗаполнитьЗначения(ЗаказПоставщику.ДатаПоступления, "ДатаПоступления");
		ТаблицаИзменений.ЗаполнитьЗначения(ЗаказПоставщику.Ссылка.ДатаПоступления, "ДатаПоступленияНачальная");
		
		ТаблицаИзменений.Свернуть("Номенклатура, Характеристика, Склад, ДатаПоступления, ДатаПоступленияНачальная", "Количество");	
		
		ЗаказПоставщику.ДополнительныеСвойства.Вставить("смартДатаПоступленияИзменена", Истина);
		ЗаказПоставщику.ДополнительныеСвойства.Вставить("смартТаблицаДатыПоступлленияИзменения", ТаблицаИзменений);

	КонецЕсли;
	
КонецПроцедуры

Процедура РезервыКДатеПерестроитьОтгрузки(ЗаказПоставщику, Отказ = Ложь) Экспорт
	
	Если Не ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаИзменений = Неопределено;
	
	ДатаПоступленияИзменена = 
		ЗаказПоставщику.ДополнительныеСвойства.Свойство("смартДатаПоступленияИзменена")
			И ЗаказПоставщику.ДополнительныеСвойства.смартДатаПоступленияИзменена = Истина;
			
	ЕстьТаблицаИзменений = 
		ЗаказПоставщику.ДополнительныеСвойства.Свойство(
			"смартТаблицаДатыПоступлленияИзменения", ТаблицаИзменений);
	
	Если Не (ДатаПоступленияИзменена И ЕстьТаблицаИзменений) Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = РезервыКДатеПодготовитьЗапрос();	
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
	 
	
	Для Каждого СтрокаТаблицыИзменений Из ТаблицаИзменений Цикл
		
		ЗаполнитьЗначенияСвойств(Запрос.Параметры, СтрокаТаблицыИзменений);			
		Запрос.УстановитьПараметр("МассивИзмененныхЗаказовНаПеремещение", Новый Массив);
		//++ #5378 смарт: Тимофеева 19.01.26 / Автоматическое резервирование запасов. Ошибка при изменении даты прихода в грузе
		Запрос.УстановитьПараметр("смартЗапчастиГарантийные", ЗаказПоставщику.смартЗапчастиГарантийные);
		//-- #5378 смарт: Тимофеева 19.01.26 
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
	    
	    ГрафикПоступления = МассивРезультатов[0].Выгрузить();
	    ГрафикОтгрузки = МассивРезультатов[6].Выгрузить();
		
		РезервыКДатеВыполнитьРаспределениеРезервов(ГрафикПоступления, ГрафикОтгрузки);

		РезервыКДатеОтменитьРезервыДокументов(ГрафикОтгрузки, Запрос.Параметры);
		РезервыКДатеУстановитьРезервыДокументов(ГрафикОтгрузки, Запрос.Параметры);
		
	КонецЦикла;
	
КонецПроцедуры	

