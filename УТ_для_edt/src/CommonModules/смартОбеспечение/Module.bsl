																									   стрНаборЗаписей.Собирается, 
																									   стрНаборЗаписей.Собрано,
																									   стрНаборЗаписей.смартВРезервеГарантийные, 
																									   стрНаборЗаписей.смартКОтгрузкеГарантийные, 
																									   стрНаборЗаписей.смартКОформлениюГарантийные, 
																									   стрНаборЗаписей.смартКСборкеГарантийные, 
																									   стрНаборЗаписей.смартСобираетсяГарантийные, 
																									   стрНаборЗаписей.смартСобраноГарантийные);
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(НаборЗаписей) = Тип("РегистрНакопленияНаборЗаписей.смартСвободныеОстаткиОрганизаций") Тогда
				
				ВНаличии = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.ВНаличии);
				ВРезервеСоСклада = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.ВРезервеСоСклада);
				ВРезервеПодЗаказ = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.ВРезервеПодЗаказ);
				смартВНаличииГарантийные = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.смартВНаличииГарантийные);
				смартВРезервеСоСкладаГарантийные = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.смартВРезервеСоСкладаГарантийные);
				смартВРезервеПодЗаказГарантийные = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.смартВРезервеПодЗаказГарантийные);
				
				Если ВНаличии < стрНаборЗаписей.ВНаличии 
					 ИЛИ ВРезервеСоСклада < стрНаборЗаписей.ВРезервеСоСклада 
					 ИЛИ ВРезервеПодЗаказ < стрНаборЗаписей.ВРезервеПодЗаказ
					 ИЛИ смартВНаличииГарантийные < стрНаборЗаписей.смартВНаличииГарантийные 
					 ИЛИ смартВРезервеСоСкладаГарантийные < стрНаборЗаписей.смартВРезервеСоСкладаГарантийные 
					 ИЛИ смартВРезервеПодЗаказГарантийные < стрНаборЗаписей.смартВРезервеПодЗаказГарантийные Тогда
					
					НоваяСтрока = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрНаборЗаписей);
					НоваяСтрока.Организация = стрНайденныеСтрокиТоваров.Организация;
					НоваяСтрока.ВНаличии = ВНаличии;
					НоваяСтрока.ВРезервеСоСклада = ВРезервеСоСклада;
					НоваяСтрока.ВРезервеПодЗаказ = ВРезервеПодЗаказ;
					НоваяСтрока.смартВНаличииГарантийные = смартВНаличииГарантийные;
					НоваяСтрока.смартВРезервеСоСкладаГарантийные = смартВРезервеСоСкладаГарантийные;
					НоваяСтрока.смартВРезервеПодЗаказГарантийные = смартВРезервеПодЗаказГарантийные;
					
					стрНаборЗаписей.ВНаличии = стрНаборЗаписей.ВНаличии - ВНаличии;
					стрНаборЗаписей.ВРезервеСоСклада = стрНаборЗаписей.ВРезервеСоСклада - ВРезервеСоСклада;
					стрНаборЗаписей.ВРезервеПодЗаказ = стрНаборЗаписей.ВРезервеПодЗаказ - ВРезервеПодЗаказ;
					стрНаборЗаписей.смартВНаличииГарантийные = стрНаборЗаписей.смартВНаличииГарантийные - смартВНаличииГарантийные;
					стрНаборЗаписей.смартВРезервеСоСкладаГарантийные = стрНаборЗаписей.смартВРезервеСоСкладаГарантийные - смартВРезервеСоСкладаГарантийные;
					стрНаборЗаписей.смартВРезервеПодЗаказГарантийные = стрНаборЗаписей.смартВРезервеПодЗаказГарантийные - смартВРезервеПодЗаказГарантийные;
					
					стрНайденныеСтрокиТоваров.Количество = стрНайденныеСтрокиТоваров.Количество - Макс(ВНаличии,
																									   ВРезервеСоСклада,
																									   ВРезервеПодЗаказ,
																									   смартВНаличииГарантийные,
																									   смартВРезервеСоСкладаГарантийные,
																									   смартВРезервеПодЗаказГарантийные);
					
				Иначе
					стрНаборЗаписей.Организация = стрНайденныеСтрокиТоваров.Организация;
					стрНайденныеСтрокиТоваров.Количество = стрНайденныеСтрокиТоваров.Количество - Макс(стрНаборЗаписей.ВНаличии, 
																									   стрНаборЗаписей.ВРезервеСоСклада, 
																									   стрНаборЗаписей.ВРезервеПодЗаказ,
																									   стрНаборЗаписей.смартВНаличииГарантийные, 
																									   стрНаборЗаписей.смартВРезервеСоСкладаГарантийные, 
																									   стрНаборЗаписей.смартВРезервеПодЗаказГарантийные);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

//++ #Б1154 смарт: Шляпников 17.10.2024 / Контроль оперативных остатков в разрезе организаций
Процедура смартПриЗаписиРегистровСкладскогоОперативногоУчетаПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Регистратор = Источник.Отбор.Регистратор.Значение;
	Исключение
		Регистратор = Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыНаСкладах") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартТоварыНаСкладахОрганизаций.СоздатьНаборЗаписей();
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ГрафикОтгрузкиТоваров") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартГрафикОтгрузкиТоваровОрганизаций.СоздатьНаборЗаписей();
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ГрафикПоступленияТоваров") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартГрафикПоступленияТоваровОрганизаций.СоздатьНаборЗаписей();
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыКОтбору") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартТоварыКОтборуОрганизаций.СоздатьНаборЗаписей();
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыКОтгрузке") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартТоварыКОтгрузкеОрганизаций.СоздатьНаборЗаписей();
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.СвободныеОстатки") Тогда
		НаборЗаписейСОрганизацией = РегистрыНакопления.смартСвободныеОстаткиОрганизаций.СоздатьНаборЗаписей();
	Иначе
		Возврат;
	КонецЕсли;
	
	Попытка
		Регистратор = Источник.Отбор.Регистратор.Значение;
		НаборЗаписейСОрганизацией.Отбор.Регистратор.Установить(Регистратор);
	Исключение
		ЗаписьЖурналаРегистрации("смартПриЗаписиРегистровСкладскогоОперативногоУчетаПриЗаписи", УровеньЖурналаРегистрации.Ошибка, 
								 Источник.Метаданные(), Источник, ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Организация = Неопределено;
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаИзлишковНедостачПоТоварнымМестам") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПересчетТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОрдерНаОтражениеПорчиТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОрдерНаОтражениеИзлишковТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОрдерНаОтражениеНедостачТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОрдерНаПеремещениеТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОрдерНаОтражениеПересортицыТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаПоОрдеруНаТовары") 
			И ТипЗнч(Регистратор.Ордер) = Тип("ДокументСсылка.ОрдерНаПеремещениеТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОтборРазмещениеТоваров") 
			И ТипЗнч(Регистратор.Распоряжение) = Тип("ДокументСсылка.ОрдерНаПеремещениеТоваров") Тогда
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	КонецЕсли;
	
	Для каждого стрИсточник Из Источник Цикл
			
		НоваяЗапись = НаборЗаписейСОрганизацией.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, стрИсточник);
		
		Если НЕ Организация = Неопределено Тогда
			НоваяЗапись.Организация = Организация;
		ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.РегистраторГрафикаДвиженияТоваров") Тогда
			НоваяЗапись.Организация = Регистратор.Распоряжение.Организация;
		ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
			Если ЗначениеЗаполнено(Регистратор.Распоряжение) И ОбщегоНазначения.СсылкаСуществует(Регистратор.Распоряжение) Тогда
				НоваяЗапись.Организация = Регистратор.Распоряжение.Организация;
			Иначе
				НоваяЗапись.Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
		ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаПоОрдеруНаТовары") Тогда
		ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОтборРазмещениеТоваров") Тогда
		Иначе
			НоваяЗапись.Организация = Регистратор.Организация;
		КонецЕсли;
		
		Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыКОтгрузке") Тогда
			Если ЗначениеЗаполнено(НоваяЗапись.ДокументОтгрузки) И ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", НоваяЗапись.ДокументОтгрузки.Метаданные()) Тогда
				НоваяЗапись.Организация = НоваяЗапись.ДокументОтгрузки.Организация;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.РасходныйОрдерНаТовары")
		ИЛИ ( ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаПоОрдеруНаТовары") И ТипЗнч(Регистратор.Ордер) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") )
		ИЛИ ( ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОтборРазмещениеТоваров") И ТипЗнч(Регистратор.Распоряжение) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") ) Тогда
		
		РаспределитьТоварыПоОрганизациямИзРасходногоОрдера(Регистратор, НаборЗаписейСОрганизацией);
	КонецЕсли;
	
	НаборЗаписейСОрганизацией.Записать(Замещение);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ГарантийныеЗапчасти

//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
Процедура смартПриЗаписиРегистровСкладскогоУчетаГарантийныеЗапчастиПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	Попытка
		Регистратор = Источник.Отбор.Регистратор.Значение;
		МетаданныеРегистратор = Регистратор.Метаданные();
	Исключение
		ЗаписьЖурналаРегистрации("смартПриЗаписиРегистровСкладскогоУчетаГарантийныеЗапчастиПриЗаписи", УровеньЖурналаРегистрации.Ошибка, 
								 Источник.Метаданные(), Источник, ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ПроводитьКакГарантийныеЗапчасти = Ложь;
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", МетаданныеРегистратор) И Регистратор.смартЗапчастиГарантийные Тогда
		ПроводитьКакГарантийныеЗапчасти = Истина;
	КонецЕсли;
	
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") И ЗначениеЗаполнено(Регистратор.Распоряжение) Тогда
		МетаданныеРаспоряжения = Регистратор.Распоряжение.Метаданные();
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", МетаданныеРаспоряжения) И Регистратор.Распоряжение.смартЗапчастиГарантийные Тогда
			ПроводитьКакГарантийныеЗапчасти = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроводитьКакГарантийныеЗапчасти Тогда
		
		Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ГрафикОтгрузкиТоваров") Тогда
			
			Для каждого стрИсточник Из Источник Цикл
				
				стрИсточник.смартКоличествоИзЗаказовГарантийные = стрИсточник.КоличествоИзЗаказов;
				стрИсточник.смартКоличествоПодЗаказГарантийные = стрИсточник.КоличествоПодЗаказ;
				стрИсточник.смартКоличествоНеобеспеченоГарантийные = стрИсточник.КоличествоНеобеспечено;
				
				стрИсточник.КоличествоИзЗаказов = 0;
				стрИсточник.КоличествоПодЗаказ = 0;
				стрИсточник.КоличествоНеобеспечено = 0;
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ГрафикПоступленияТоваров") Тогда
			
			Для каждого стрИсточник Из Источник Цикл
				
				стрИсточник.смартКоличествоИзЗаказовГарантийные = стрИсточник.КоличествоИзЗаказов;
				стрИсточник.смартКоличествоПодЗаказГарантийные = стрИсточник.КоличествоПодЗаказ;
				стрИсточник.смартКоличествоИзЗаказовСНеподтвержденнымиГарантийные = стрИсточник.КоличествоИзЗаказовСНеподтвержденными;
				стрИсточник.смартКоличествоПодЗаказСНеподтвержденнымиГарантийные = стрИсточник.КоличествоПодЗаказСНеподтвержденными;
				
				стрИсточник.КоличествоИзЗаказов = 0;
				стрИсточник.КоличествоПодЗаказ = 0;
				стрИсточник.КоличествоИзЗаказовСНеподтвержденными = 0;
				стрИсточник.КоличествоПодЗаказСНеподтвержденными = 0;
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.СвободныеОстатки") Тогда
			
			Для каждого стрИсточник Из Источник Цикл
				
				стрИсточник.смартВНаличииГарантийные = стрИсточник.ВНаличии;
				стрИсточник.смартВРезервеСоСкладаГарантийные = стрИсточник.ВРезервеСоСклада;
				стрИсточник.смартВРезервеПодЗаказГарантийные = стрИсточник.ВРезервеПодЗаказ;
				
				стрИсточник.ВНаличии = 0;
				стрИсточник.ВРезервеСоСклада = 0;
				стрИсточник.ВРезервеПодЗаказ = 0;
				
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ОбеспечениеЗаказов") Тогда
			
			Для каждого стрИсточник Из Источник Цикл
				
				стрИсточник.смартПотребностьГарантийные = стрИсточник.Потребность;
				стрИсточник.смартКЗаказуГарантийные = стрИсточник.КЗаказу;
				стрИсточник.смартНаличиеПодЗаказГарантийные = стрИсточник.НаличиеПодЗаказ;
				
				стрИсточник.Потребность = 0;
				стрИсточник.КЗаказу = 0;
				стрИсточник.НаличиеПодЗаказ = 0;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыКОтгрузке") Тогда
			
		Для каждого стрИсточник Из Источник Цикл
			
			Если ПроводитьКакГарантийныеЗапчасти ИЛИ ( ЗначениеЗаполнено(стрИсточник.ДокументОтгрузки) И 
													   ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", стрИсточник.ДокументОтгрузки.Метаданные()) И 
													   стрИсточник.ДокументОтгрузки.смартЗапчастиГарантийные ) Тогда
													   
				стрИсточник.смартВРезервеГарантийные = стрИсточник.ВРезерве;
				стрИсточник.смартКОтгрузкеГарантийные = стрИсточник.КОтгрузке;
				стрИсточник.смартКОформлениюГарантийные = стрИсточник.КОформлению;
				стрИсточник.смартКСборкеГарантийные = стрИсточник.КСборке;
				стрИсточник.смартСобираетсяГарантийные = стрИсточник.Собирается;
				стрИсточник.смартСобраноГарантийные = стрИсточник.Собрано;
				
				стрИсточник.ВРезерве = 0;
				стрИсточник.КОтгрузке = 0;
				стрИсточник.КОформлению = 0;
				стрИсточник.КСборке = 0;
				стрИсточник.Собирается = 0;
				стрИсточник.Собрано = 0;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#КонецОбласти

