					НоваяСтрока.смартКСборкеГарантийные = смартКСборкеГарантийные;
					НоваяСтрока.смартСобираетсяГарантийные = смартСобираетсяГарантийные;
					НоваяСтрока.смартСобраноГарантийные = смартСобраноГарантийные;
					
					стрНаборЗаписей.ВРезерве = стрНаборЗаписей.ВРезерве - ВРезерве;
