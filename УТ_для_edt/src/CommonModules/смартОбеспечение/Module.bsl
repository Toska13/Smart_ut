																									   смартКОтгрузкеГарантийные, 
																									   смартКОформлениюГарантийные, 
																									   смартКСборкеГарантийные, 
																									   смартСобираетсяГарантийные, 
																									   смартСобраноГарантийные);
					
				Иначе
					стрНаборЗаписей.Организация = стрНайденныеСтрокиТоваров.Организация;
					стрНайденныеСтрокиТоваров.Количество = стрНайденныеСтрокиТоваров.Количество - Макс(стрНаборЗаписей.ВРезерве, 
																									   стрНаборЗаписей.КОтгрузке, 
