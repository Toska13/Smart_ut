#Область РезервыКДате

Функция РезервыКДатеПодготовитьЗапрос()
	
	// Получаем минимальный процент оплаты заказа
    МинимальныйПроцентОплаты = Справочники.смартПредопределенныеЗначения.ПроцентОплатыЗаказаДляИерархииПоОплате.Значение;
	МинимальныйПроцентОплаты = ?(МинимальныйПроцентОплаты = Неопределено, 0, МинимальныйПроцентОплаты);	
	
	Запрос = Новый Запрос(РезервыКДатеПолучитьТекстЗапроса());
	Запрос.УстановитьПараметр("МинимальныйПроцентОплаты", МинимальныйПроцентОплаты);
	
	// Указывам значения по умолчанию для дальнейшего заполнения
	Запрос.УстановитьПараметр("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("Склад", Справочники.Склады.ПустаяСсылка());
	
	МассивТиповДокументов = Новый Массив;
	МассивТиповДокументов.Добавить(Тип("ДокументСсылка.ЗаказКлиента"));
	МассивТиповДокументов.Добавить(Тип("ДокументСсылка.ЗаказНаПеремещение"));
	МассивТиповДокументов.Добавить(Тип("ДокументСсылка.ЗаказНаСборку"));
	МассивТиповДокументов.Добавить(Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление"));

	Запрос.УстановитьПараметр("МассивТиповДокументов", МассивТиповДокументов);
	
	Запрос.УстановитьПараметр("СкладПолучательЗаказНаПеремещение", Справочники.Склады.ПустаяСсылка());
	Запрос.УстановитьПараметр("ЗаказКлиента", Документы.ЗаказКлиента.ПустаяСсылка());
	Запрос.УстановитьПараметр("ДатаСдвига", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("НоменклатураЗаказНаСборку", Справочники.Номенклатура.ПустаяСсылка());
	Запрос.УстановитьПараметр("ХарактеристикаЗаказНаСборку", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	
	Возврат Запрос;
	
КонецФункции

