					стрНаборЗаписей.КСборке = стрНаборЗаписей.КСборке - КСборке;
					стрНаборЗаписей.Собирается = стрНаборЗаписей.Собирается - Собирается;
					стрНаборЗаписей.Собрано = стрНаборЗаписей.Собрано - Собрано;
					стрНаборЗаписей.смартВРезервеГарантийные = стрНаборЗаписей.смартВРезервеГарантийные - смартВРезервеГарантийные;
					стрНаборЗаписей.смартКОтгрузкеГарантийные = стрНаборЗаписей.смартКОтгрузкеГарантийные - смартКОтгрузкеГарантийные;
					стрНаборЗаписей.смартКОформлениюГарантийные = стрНаборЗаписей.смартКОформлениюГарантийные - смартКОформлениюГарантийные;
					стрНаборЗаписей.смартКСборкеГарантийные = стрНаборЗаписей.смартКСборкеГарантийные - смартКСборкеГарантийные;
					стрНаборЗаписей.смартСобираетсяГарантийные = стрНаборЗаписей.смартСобираетсяГарантийные - смартСобираетсяГарантийные;
					стрНаборЗаписей.смартСобраноГарантийные = стрНаборЗаписей.смартСобраноГарантийные - смартСобраноГарантийные;
					
					стрНайденныеСтрокиТоваров.Количество = стрНайденныеСтрокиТоваров.Количество - Макс(ВРезерве, 
																									   КОтгрузке, 
																									   КОформлению, 
																									   КСборке, 
