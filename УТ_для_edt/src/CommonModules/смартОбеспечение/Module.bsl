КонецФункции

Функция ДобавитьКДатеРабочиеДни(ДатаСтарта, КоличествоДней)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
    "ВЫБРАТЬ
    |	ВЫБОР
    |		КОГДА Т.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий)
    |				ИЛИ Т.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный)
    |			ТОГДА 1
    |		ИНАЧЕ 0
    |	КОНЕЦ КАК ЧислоРабочихДней,
    |	Т.Дата КАК ДатаКалендаря
    |ПОМЕСТИТЬ ТЗ
    |ИЗ
    |	РегистрСведений.ДанныеПроизводственногоКалендаря КАК Т
    |ГДЕ
    |	Т.Дата МЕЖДУ &ДатаСтарта И &ДатаПредела
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	ТЗ.ДатаКалендаря КАК ДатаКалендаря,
    |	СУММА(ТЗ1.ЧислоРабочихДней) КАК ЧислоРабочихДней
    |ПОМЕСТИТЬ ТЗНакопл
    |ИЗ
    |	ТЗ КАК ТЗ
    |		ЛЕВОЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ1
    |		ПО (ТЗ1.ДатаКалендаря <= ТЗ.ДатаКалендаря)
    |
    |СГРУППИРОВАТЬ ПО
    |	ТЗ.ДатаКалендаря
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	МАКСИМУМ(ТЗ.ДатаКалендаря) КАК ДатаКалендаря
    |ИЗ
    |	ТЗНакопл КАК ТЗ
    |ГДЕ
    |	ТЗ.ЧислоРабочихДней = &ЧислоРабочихДней";
	
	Запрос.УстановитьПараметр("ДатаСтарта", НачалоДня(ДатаСтарта));
	Запрос.УстановитьПараметр("ДатаПредела", НачалоДня(ДатаСтарта) + 86400 * (КоличествоДней + 30));
	Запрос.УстановитьПараметр("ЧислоРабочихДней", КоличествоДней);
	
	Если КоличествоДней < 0 Тогда
		Запрос.УстановитьПараметр("ДатаПредела", НачалоДня(ДатаСтарта) + 86400 * (КоличествоДней - 30));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "<", ">");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаСтарта И &ДатаПредела", "&ДатаПредела И &ДатаСтарта");
		Запрос.УстановитьПараметр("ЧислоРабочихДней", - КоличествоДней);
	КонецЕсли;
	
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.ДатаКалендаря <> NULL Тогда
		Возврат Выборка.ДатаКалендаря;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

