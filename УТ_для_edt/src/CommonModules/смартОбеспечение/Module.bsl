										 ?(ЭтоТестоваяБаза, АдресСервиснойЭлектроннойПочты, ""),
										 "ПРЕДУПРЕЖДЕНИЕ о закрытии заказов на сборку",
										 СтрокаИнформацииОПлановомЗакрытиеЗаказов,
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
										 
		Попытка
											 
			РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
			
			Если ЭтоТестоваяБаза Тогда
				
				ТекстСообщения = "Отправлено письмо, предупреждение о закрытии заказов НА ТЕСТОВУЮ ПОЧТУ " 
									+ АдресСервиснойЭлектроннойПочты + " (в рабочей базе отправилось бы на почту " 
									+  Менеджер.смартРабочаяПочта + ")";
									
			Иначе
				ТекстСообщения = "Отправлено письмо, предупреждение о закрытии заказов на почту " +  Менеджер.смартРабочаяПочта;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, 
				"Не удалось отправить письмо, предупреждение о закрытии заказов "  + Символы.ПС + ОписаниеОшибки());

		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗакрытьЗаказыНаСборку(ТаблицаЗаказов, АдресСервиснойЭлектроннойПочты, СоответствиеМенеджеровИЗаказовКУведомлениям)

	МассивОшибок = Новый Массив;
	
	ПараметрыЗакрытия = ЗаказыСервер.СтруктураКорректировкиСтрокЗаказа();
	ПараметрыЗакрытия.ОтменитьНеотработанныеСтроки = Истина;
	ПараметрыЗакрытия.ПроверятьОстатки = Истина;
	ПараметрыЗакрытия.ЗакрыватьЗаказы = Истина;

	Для Каждого стрЗаказ Из ТаблицаЗаказов Цикл
		
		ЗаказОбъект = стрЗаказ.ЗаказНаСборку.ПолучитьОбъект();
		
		Попытка
			ЗаказОбъект.Заблокировать();
		Исключение
			МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаСборку) + ". Не удалось заблокировать");
			Продолжить;
		КонецПопытки;
		
		ПараметрыЗакрытия.ДокументОбъект = ЗаказОбъект;
	
		Если ЗаказОбъект.УстановитьСтатус(1,ПараметрыЗакрытия) Тогда
			
			Попытка
				
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				НомерПоследнейВерсии = ВерсионированиеОбъектов.НомерПоследнейВерсии(стрЗаказ.ЗаказНаСборку);
				Если НомерПоследнейВерсии > 0 Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(стрЗаказ.ЗаказНаСборку, НомерПоследнейВерсии, "Автоматическое закрытие заказа по дате создания");	
				КонецЕсли;
				
			Исключение
				МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаСборку) + ". Не удалось закрыть. Причина: " + ОписаниеОшибки());
				ЗаказОбъект.Разблокировать();
				СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаСборкуОтветственный].Удалить(СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаСборкуОтветственный].Найти(стрЗаказ.ЗаказНаСборку));
			КонецПопытки;
			
		Иначе 
			
			МассивОшибок.Добавить("Заказ " + Строка(стрЗаказ.ЗаказНаСборку) + ". Не удалось закрыть. Невозможно отменить все строки заказа. Дополнительно: " + ОписаниеОшибки());
			ЗаказОбъект.Разблокировать();
			СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаСборкуОтветственный].Удалить(СоответствиеМенеджеровИЗаказовКУведомлениям[стрЗаказ.ЗаказНаСборкуОтветственный].Найти(стрЗаказ.ЗаказНаСборку));
			
		КонецЕсли;
																
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		ДанныеДляОтправки = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность",
										 АдресСервиснойЭлектроннойПочты,
										 "Автоматическое закрытие заказов. Журнал ошибок",
										 "Журнал ошибок:" + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС),
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
	                              
	КонецЕсли; 
	
КонецПроцедуры 

#КонецОбласти

