Процедура РаспределитьТоварыПоОрганизациямИзРасходногоОрдера(Документ, НаборЗаписей)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура КАК Номенклатура,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика КАК Характеристика,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Серия КАК Серия,
	|	СУММА(РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Количество) КАК Количество,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение.Организация КАК Организация
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Серия,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение.Организация,
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Документ);
	ТаблицаТоваровПоОрганизациям = Запрос.Выполнить().Выгрузить();
	
	ЕстьСерия = Ложь;
	Если ТипЗнч(НаборЗаписей) = Тип("РегистрНакопленияНаборЗаписей.смартТоварыНаСкладахОрганизаций") Тогда
		ЕстьСерия = Истина;
	ИначеЕсли ТипЗнч(НаборЗаписей) = Тип("РегистрНакопленияНаборЗаписей.смартТоварыКОтборуОрганизаций") Тогда
		ЕстьСерия = Истина;
	ИначеЕсли ТипЗнч(НаборЗаписей) = Тип("РегистрНакопленияНаборЗаписей.смартТоварыКОтгрузкеОрганизаций") Тогда
		ЕстьСерия = Истина;
	КонецЕсли;
	
	КоличествоЗаписей = НаборЗаписей.Количество();
	Для н = 0 По КоличествоЗаписей-1 Цикл
		
		стрНаборЗаписей = НаборЗаписей[н];
		
		Если ЗначениеЗаполнено(стрНаборЗаписей.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураПоискаТоваров = Новый Структура("Номенклатура,Характеристика");
		ЗаполнитьЗначенияСвойств(СтруктураПоискаТоваров, стрНаборЗаписей);
		Если ЕстьСерия Тогда
			СтруктураПоискаТоваров.Вставить("Серия", стрНаборЗаписей.Серия);
		КонецЕсли;
		
		НайденныеСтрокиТоваров = ТаблицаТоваровПоОрганизациям.НайтиСтроки(СтруктураПоискаТоваров);
		
		Если НайденныеСтрокиТоваров.Количество() = 0 И ЕстьСерия Тогда
			
			СтруктураПоискаТоваров.Удалить("Серия");
			НайденныеСтрокиТоваров = ТаблицаТоваровПоОрганизациям.НайтиСтроки(СтруктураПоискаТоваров);
			
		КонецЕсли;
		
		Для каждого стрНайденныеСтрокиТоваров Из НайденныеСтрокиТоваров Цикл
			
			Если ТипЗнч(НаборЗаписей) = Тип("РегистрНакопленияНаборЗаписей.смартТоварыНаСкладахОрганизаций") Тогда
				
				ВНаличии = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.ВНаличии);
				КОтгрузке = Мин(стрНайденныеСтрокиТоваров.Количество, стрНаборЗаписей.КОтгрузке);
				
				Если ВНаличии < стрНаборЗаписей.ВНаличии ИЛИ КОтгрузке < стрНаборЗаписей.КОтгрузке Тогда
					
					НоваяСтрока = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, стрНаборЗаписей);
					НоваяСтрока.Организация = стрНайденныеСтрокиТоваров.Организация;
