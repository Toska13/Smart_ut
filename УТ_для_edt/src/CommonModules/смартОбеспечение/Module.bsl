//++ #5634 смарт: Тимофеева 13.02.26 / Автоматическое закрытие заказов. Дополнение. Заказ на внутреннее потребление
#Область ЗакрытиеЗаказовНаВнутреннееПотребление

Процедура ВыполнитьАвтоматическоеЗакрытиеЗаказовНаВнутреннееПотребление() Экспорт
	
	НастройкиАвтоматическогоЗакрытия = ПрочитатьНастройкиАвтоматическогоЗакрытияЗаказов();
	Если НЕ НастройкиАвтоматическогоЗакрытия.АвтоматическиЗакрыватьЗаказыНаВнутреннееПотребление Тогда
		Возврат;
	КонецЕсли;
	
	// Если текущая дата не является рабочим днем, выполнение не требуется.
	Если Не ТекущаяДатаЯвляетсяРабочей() Тогда
		Возврат;
	КонецЕсли;
	
	// Формируем макет компановки для получения таблицы значений
	СхемаКомпоновкиДанных = ПолучитьСКДОтбораДокументовЗаказовНаВнутреннееПотребление();
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	// Читаем настройки, которые сохранили ранее. 
	НастроитьКомпоновщикАвтоматическогоЗакрытияЗаказов(КомпоновщикНастроек, 4, Истина);
		
	// Получаем адрес электронной почты для отправки информации о проблемах исполнения обработки
	// Если адрес не заполнен, прерываем обработку
	АдресСервиснойЭлектроннойПочты = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("АдресEmailДляРассылки").Значение;
	
	Если Не ЗначениеЗаполнено(АдресСервиснойЭлектроннойПочты) Тогда
		
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Ошибка,,,
 			"Автоматическое закрытие заказов на внутреннее потребление! Не заполнен адрес рассылки.");

		Возврат;	
		
	КонецЕсли;
	
	//++++++++++ сначала закрываем заказы
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	// Получаем таблицу значений, которая хранит заказы согласно отборам СКД	
	ТаблицаЗаказов = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗаказов);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
													
	ЗакрытьЗаказыНаВнутреннееПотребление(ТаблицаЗаказов, АдресСервиснойЭлектроннойПочты);
		
КонецПроцедуры

Процедура ЗакрытьЗаказыНаВнутреннееПотребление(ТаблицаЗаказов, АдресСервиснойЭлектроннойПочты)

	МассивОшибок = Новый Массив;                                                                                         
	СтруктураПараметровЗакрытия = Новый Структура("ПричинаОтмены, ОтменитьНеотработанныеСтроки", 
											Справочники.ПричиныОтменыЗаказовКлиентов.ОтклонениеПриОтгрузкеМерныхТоваров,
											Истина);

	Для Каждого СтрокаТаблицыЗаказов Из ТаблицаЗаказов Цикл
		ЗаказНаВнутреннееПотреблениеСсылка = СтрокаТаблицыЗаказов.Ссылка;
		ЗаказНаВнутреннееПотреблениеОбъект = ЗаказНаВнутреннееПотреблениеСсылка.ПолучитьОбъект();
		
		Попытка
			ЗаказНаВнутреннееПотреблениеОбъект.Заблокировать();
		Исключение
			МассивОшибок.Добавить("Документ " + Строка(ЗаказНаВнутреннееПотреблениеСсылка) + ". Не удалось заблокировать");
			Продолжить;
		КонецПопытки;
		
		Если ЗаказНаВнутреннееПотреблениеОбъект.УстановитьСтатус("Закрыт", СтруктураПараметровЗакрытия) Тогда
			
			Попытка
				
				ЗаказНаВнутреннееПотреблениеОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				НомерПоследнейВерсии = ВерсионированиеОбъектов.НомерПоследнейВерсии(ЗаказНаВнутреннееПотреблениеСсылка);
				Если НомерПоследнейВерсии > 0 Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(ЗаказНаВнутреннееПотреблениеСсылка, НомерПоследнейВерсии, "Автоматическое закрытие заказа по сроку оплаты");	
				КонецЕсли;
				
			Исключение
				МассивОшибок.Добавить("Документ " + Строка(ЗаказНаВнутреннееПотреблениеСсылка) + ". Не удалось закрыть. Причина: " + ОписаниеОшибки());
				ЗаказНаВнутреннееПотреблениеОбъект.Разблокировать();
			КонецПопытки;
			
		Иначе 
			
			МассивОшибок.Добавить("Документ " + Строка(ЗаказНаВнутреннееПотреблениеСсылка) + ". Не удалось закрыть. Невозможно отменить все строки заказа. Дополнительно: " + ОписаниеОшибки());
			ЗаказНаВнутреннееПотреблениеОбъект.Разблокировать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		ДанныеДляОтправки = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность",
										 АдресСервиснойЭлектроннойПочты,
										 "Автоматическое закрытие заказов. Журнал ошибок",
										 "Журнал ошибок:" + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС),
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
	                              
	КонецЕсли; 
	
КонецПроцедуры 

Функция ПолучитьСКДОтбораДокументовЗаказовНаВнутреннееПотребление() Экспорт
	Возврат Справочники.смартПредопределенныеЗначения.ПолучитьМакет("СКДОтбораДокументовЗаказовНаВнутреннееПотребление");
КонецФункции

