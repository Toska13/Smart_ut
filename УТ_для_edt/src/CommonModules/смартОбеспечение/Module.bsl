Процедура СформироватьПараметрыНоменклатураВключениеИсключениеПриАвтоматическомЗакрытииЗаказовКлиентов(КомпоновщикНастроек);
	
	Массив = Новый Массив;
	
	СписокСегментовНоменклатурыВключение = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("СегментыНоменклатурыВключение");
	Для Каждого ЭлементСписка Из СписокСегментовНоменклатурыВключение.Значение Цикл
		
		// Получаем весь перечень номенклатуры по списку сегментов
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Массив, СегментыСервер.МассивЭлементов(ЭлементСписка.Значение)); 
		
	КонецЦикла;
	
	// Записываем полученную номенклатуру в значение параметра
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НоменклатураВключение");
	ПараметрКомпановкиДанных.Значение.ЗагрузитьЗначения(Массив);
	ПараметрКомпановкиДанных.Использование = Истина;	
	
	Массив.Очистить();
	
	// Аналогично первому
	СписокСегментовНоменклатурыИсключение = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("СегментыНоменклатурыИсключение");	
	Для Каждого ЭлементСписка Из СписокСегментовНоменклатурыИсключение.Значение Цикл
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Массив, СегментыСервер.МассивЭлементов(ЭлементСписка.Значение)); 
		
	КонецЦикла; 
	
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("НоменклатураИсключение");
	ПараметрКомпановкиДанных.Значение.ЗагрузитьЗначения(Массив);
	ПараметрКомпановкиДанных.Использование = Истина;	
	
КонецПроцедуры

Функция ТаблицаЗаказовКлиентовСодержитОшибки(ТаблицаЗаказов)
	
	// Проверяем, что в таблице нет пустых ключевых дат. В противном случае - завершение.	
	ЕстьПустаяДатаУведомления = Не ТаблицаЗаказов.Найти(Дата("00010101"), "ДатаУведомления") = Неопределено
									Или Не ТаблицаЗаказов.Найти(Неопределено, "ДатаУведомления") = Неопределено; 
									
	ЕстьПустаяДатаЗакрытия = Не ТаблицаЗаказов.Найти(Дата("00010101"), "ДатаЗакрытия") = Неопределено
									Или Не ТаблицаЗаказов.Найти(Неопределено, "ДатаЗакрытия") = Неопределено;
									
	Если ЕстьПустаяДатаУведомления Или ЕстьПустаяДатаЗакрытия Тогда								
		
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
										УровеньЖурналаРегистрации.Ошибка,,,
 										"Автоматическое закрытие заказа по сроку оплаты! Плановые даты рассчитаны неверно.");
										
	КонецЕсли;									
									
	Возврат ЕстьПустаяДатаУведомления Или ЕстьПустаяДатаЗакрытия;
	
КонецФункции

Процедура ДополнитьТаблицуЗаказовКлиентовКолонками(ТаблицаЗаказов)
	
	/////////////////////////////////////////////////////////////////////////////////////
	// Обработка дат
	// Краткое описание дополнений к таблице.
	// Все даты, кроме реальной даты заказа, рассчитываются по производственному календарю РФ.
	// Колонки:
	//  - ДатаЗаказаКалендарная - служит для определния календарной даты заказа. Это требуется, 
	//							  реальная дата заказа выпадает на нерабочий день.
	//							  Условно, если заказ создан в субботу, то его 
	//							  календарная дата - понедельник
	//  - ДатаНачалаПросрочки   - это первый рабочий день, следующий за календарной датой заказа
	//  - ДатаУведомления		- это дата, при наступлении которой следует отправить уведомление 
	//  - ДатаЗакрытия			- это дата, при наступлении которой заказ будет закрыт
	ОписаниеТипаДата = Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ТаблицаЗаказов.Колонки.Добавить("ДатаЗаказаКалендарная", ОписаниеТипаДата);
	ТаблицаЗаказов.Колонки.Добавить("ДатаНачалаПросрочки", ОписаниеТипаДата);
	ТаблицаЗаказов.Колонки.Добавить("ДатаУведомления", ОписаниеТипаДата);
	ТаблицаЗаказов.Колонки.Добавить("ДатаЗакрытия", ОписаниеТипаДата);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуЗаказовКлиентовДатамиПоКалендарю(ТаблицаЗаказов, СрокПросроченнойОплатыДней, СрокПросроченнойОплатыДнейРублевоеОборудование)

	// Получаем производственный календарь РФ
	Календарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
	ПараметрыПолученияБлижайшихРабочихДат = КалендарныеГрафики.ПараметрыПолученияБлижайшихРабочихДат(Календарь);
	ПараметрыПолученияБлижайшихРабочихДат.УчитыватьНерабочиеПериоды = Ложь;
	
	// Выгружаем массив реальных дат заказов для получения календарных дат
	// Условно - если заказ сформирован в субботу 10.09.2023, то считается, что он
	// сформирован в понедельник 12.09.2023. 
	МассивДатыЗаказа = ТаблицаЗаказов.ВыгрузитьКолонку("ДатаЗаказа");
	СоответствиеДатаЗаказаДатаЗаказаКалендарная = КалендарныеГрафики.БлижайшиеРабочиеДаты(Календарь, МассивДатыЗаказа, ПараметрыПолученияБлижайшихРабочихДат);
	Для Каждого СтрокаТаблицы Из ТаблицаЗаказов Цикл
		
		// Как было описано выше, календарная дата заказа может отличатся от реальной его даты.
		// Из примера выше: Реальная дата - суббота, 10.09.2023, календарная - понедельник, 12.09.2023
		СтрокаТаблицы.ДатаЗаказаКалендарная = СоответствиеДатаЗаказаДатаЗаказаКалендарная.Получить(СтрокаТаблицы.ДатаЗаказа);	
				
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаказов Цикл
		
		// Считаем, что первый день, с которого считаем просрочку оплаты, это первый рабочий день, следующий за календарной датой заказа
		// Из примера выше:
		//  - календарная дата заказа понедельник, 12.09.2023
		//  - если считать, что вторник, 13.09.2023 - это праздничный день (или нерабочий день), то дата начала просрочки сдвинется
		// 	  на самый ближайший рабочий день - например на среду, 14.09.2023.
		СтрокаТаблицы.ДатаНачалаПросрочки = КалендарныеГрафики.ДатаПоКалендарю(Календарь, СтрокаТаблицы.ДатаЗаказаКалендарная, 1); 
		
		// Как и выше, даты рассчитываются согласно производственному календарю (с отсеканием нерабочих дней)
		Если ЗначениеЗаполнено(СтрокаТаблицы.СрокЗакрытия) И ТипЗнч(СтрокаТаблицы.СрокЗакрытия) = Тип("Дата") Тогда
			
			СтрокаТаблицы.ДатаУведомления = ДобавитьКДатеРабочиеДни(СтрокаТаблицы.СрокЗакрытия,  - 3);
			СтрокаТаблицы.ДатаЗакрытия = СтрокаТаблицы.СрокЗакрытия;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.СрокЗакрытия) Тогда
			
			СтрокаТаблицы.ДатаУведомления = КалендарныеГрафики.ДатаПоКалендарю(Календарь, СтрокаТаблицы.ДатаНачалаПросрочки, СтрокаТаблицы.СрокЗакрытия - 2); 
			СтрокаТаблицы.ДатаЗакрытия = КалендарныеГрафики.ДатаПоКалендарю(Календарь, СтрокаТаблицы.ДатаНачалаПросрочки, СтрокаТаблицы.СрокЗакрытия); 
		
		Иначе
			
			СтрокаТаблицы.ДатаУведомления = КалендарныеГрафики.ДатаПоКалендарю(Календарь, СтрокаТаблицы.ДатаНачалаПросрочки, СрокПросроченнойОплатыДней - 1); 
			СтрокаТаблицы.ДатаЗакрытия = КалендарныеГрафики.ДатаПоКалендарю(Календарь, СтрокаТаблицы.ДатаНачалаПросрочки, СрокПросроченнойОплатыДней);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаЗаказов.Сортировать("ДатаЗакрытия ВОЗР");
	
КонецПроцедуры

Процедура СформироватьКоллекцииДанныхДляОбработкиЗаказовКлиентов(ТаблицаЗаказов, МассивЗаказовЗакрытия, СоответствиеМенеджеровИЗаказовКУведомлениям)
	
	ТекущаяДата = НачалоДня(ТекущаяДата());
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаказов Цикл
		
		Если СтрокаТаблицы.ДатаЗакрытия <= ТекущаяДата Тогда
			
			// Заказ подлежит закрытию, если его дата закрытия меньше текущей
			МассивЗаказовЗакрытия.Добавить(СтрокаТаблицы.ЗаказКлиента);
			
		ИначеЕсли СтрокаТаблицы.ДатаУведомления = ТекущаяДата Тогда
			
			// Отправляем уведомление, в случае, если дата уведомления равна текущей
			Если СоответствиеМенеджеровИЗаказовКУведомлениям.Получить(СтрокаТаблицы.ЗаказКлиента.Менеджер) = Неопределено Тогда
				СоответствиеМенеджеровИЗаказовКУведомлениям.Вставить(СтрокаТаблицы.ЗаказКлиента.Менеджер, Новый Массив);
			КонецЕсли;
			
			СоответствиеМенеджеровИЗаказовКУведомлениям[СтрокаТаблицы.ЗаказКлиента.Менеджер].Добавить(СтрокаТаблицы.ЗаказКлиента);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗакрытьЗаказыКлиентов(МассивЗаказовЗакрытия, АдресСервиснойЭлектроннойПочты)

	МассивОшибок = Новый Массив;                                                                                         
	СтруктураПараметровЗакрытия = Новый Структура("ПричинаОтмены, ОтменитьНеотработанныеСтроки", 
											Справочники.ПричиныОтменыЗаказовКлиентов.ОтклонениеПриОтгрузкеМерныхТоваров,
											Истина);

	Для Каждого ЗаказСсылка Из МассивЗаказовЗакрытия Цикл
		
		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
		ЗаказОбъект.ДополнительныеСвойства.Вставить("НеКонтроллироватьПлатнуюДоставку", Истина);
		
		Попытка
			ЗаказОбъект.Заблокировать();
		Исключение
			МассивОшибок.Добавить("Заказ " + Строка(ЗаказСсылка) + ". Не удалось заблокировать");
			Продолжить;
		КонецПопытки;
										
		Если ЗаказОбъект.УстановитьСтатус("Закрыт", СтруктураПараметровЗакрытия) Тогда
			
			Попытка
				
				//++ #Б4718 смарт: Шляпников 13.10.2025 / Исключить проверку заполнения поля Доставка, при автоматических обработках оп резервированию товаров
				ЗаказОбъект.ДополнительныеСвойства.Вставить("НеКонтроллироватьПлатнуюДоставку", Истина);
				//-- #Б4718 смарт: Шляпников 13.10.2025
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				
				НомерПоследнейВерсии = ВерсионированиеОбъектов.НомерПоследнейВерсии(ЗаказСсылка);
				Если НомерПоследнейВерсии > 0 Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(ЗаказСсылка, НомерПоследнейВерсии, "Автоматическое закрытие заказа по сроку оплаты");	
				КонецЕсли;
				
				//++ #1832 смарт: Шляпников 16.01.2025 / Автоматическое закрытие заказов. Отвязка интереса от закрытого заказа.
				ОтвязатьИнтересОтЗаказаКлиента(ЗаказСсылка);
				//-- #1832 смарт: Шляпников 16.01.2025
				
			Исключение
				МассивОшибок.Добавить("Заказ " + Строка(ЗаказСсылка) + ". Не удалось закрыть. Причина: " + ОписаниеОшибки());
				ЗаказОбъект.Разблокировать();
			КонецПопытки;
			
		Иначе 
			
			МассивОшибок.Добавить("Заказ " + Строка(ЗаказСсылка) + ". Не удалось закрыть. Невозможно отменить все строки заказа. Дополнительно: " + ОписаниеОшибки());
			ЗаказОбъект.Разблокировать();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		ДанныеДляОтправки = Новый Структура("Кому, Тема, Тело, ТипТекста, Важность",
										 АдресСервиснойЭлектроннойПочты,
										 "Автоматическое закрытие заказов. Журнал ошибок",
										 "Журнал ошибок:" + Символы.ПС + СтрСоединить(МассивОшибок, Символы.ПС),
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
	                              
	КонецЕсли; 
	
КонецПроцедуры 

Процедура ОтправитьУведомленияПриАвтоматическомЗакрытииЗаказовКлиентов(СоответствиеМенеджеровИЗаказовКУведомлениям, АдресСервиснойЭлектроннойПочты)
	
	// Перебираем соответствие: Ключ - Менеджер, Значение - Массив заказов этого менеджера
	Для Каждого КлючИЗначение Из СоответствиеМенеджеровИЗаказовКУведомлениям Цикл
			
		Менеджер = КлючИЗначение.Ключ;
		СтрокаИнформацииОПлановомЗакрытиеЗаказов = "Следующие заказы клиентов будут отменены сегодня ночью по причине просроченной оплаты:" + Символы.ПС;
		
		Для Каждого ЗаказСсылка Из КлючИЗначение.Значение Цикл
			
			//++ #1561 смарт: Ермаков 22.12.2023 / Добавить доп текст в оповещения
			СтрокаИнформацииОПлановомЗакрытиеЗаказов = 
				СтрокаИнформацииОПлановомЗакрытиеЗаказов + Символы.ПС + " - " + Строка(ЗаказСсылка.Контрагент) + ". " + Строка(ЗаказСсылка);				
			//-- #1561 смарт: Ермаков 22.12.2023 / Добавить доп текст в оповещения				
				
		КонецЦикла;
		
		СтрокаИнформацииОПлановомЗакрытиеЗаказов = 
			СтрокаИнформацииОПлановомЗакрытиеЗаказов + Символы.ПС + Символы.ПС + "Чтобы избежать отмены заказа, необходимо его оплатить (подвесить оплату).";
			
		ЭтоТестоваяБаза = Не смартОбщегоНазначения.смартРабочаяБаза();
		АдресЭлектроннойПочтыПолучателя = ?(смартОбщегоНазначения.смартРабочаяБаза(), Менеджер.смартРабочаяПочта, АдресСервиснойЭлектроннойПочты);
		
		//++ #Б2020 смарт: Шляпников 28.01.2025 / Автоматическое закрытие заказов. Доработка отправка почты
		Если НЕ ЗначениеЗаполнено(АдресЭлектроннойПочтыПолучателя) Тогда
			АдресЭлектроннойПочтыПолучателя = АдресСервиснойЭлектроннойПочты;
		КонецЕсли;
		//-- #Б2020 смарт: Шляпников 28.01.2025
		
		// смарт: почта
		ДанныеДляОтправки = Новый Структура("Кому, Копии, Тема, Тело, ТипТекста, Важность",
										 АдресЭлектроннойПочтыПолучателя, 
										 ?(ЭтоТестоваяБаза, АдресСервиснойЭлектроннойПочты, ""),
										 "ПРЕДУПРЕЖДЕНИЕ о скором закрытии заказов клиентов без оплаты",
										 СтрокаИнформацииОПлановомЗакрытиеЗаказов,
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая); 
										 
		Попытка
											 
			РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
			
			Если ЭтоТестоваяБаза Тогда
				
				ТекстСообщения = "Отправлено письмо, предупреждение о закрытии заказов НА ТЕСТОВУЮ ПОЧТУ " 
									+ АдресСервиснойЭлектроннойПочты + " (в рабочей базе отправилось бы на почту " 
									+  Менеджер.смартРабочаяПочта + ")";
									
			Иначе
				ТекстСообщения = "Отправлено письмо, предупреждение о закрытии заказов на почту " +  Менеджер.смартРабочаяПочта;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			
		Исключение
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, 
				"Не удалось отправить письмо, предупреждение о закрытии заказов "  + Символы.ПС + ОписаниеОшибки());

		КонецПопытки;
		
	КонецЦикла;	
	
КонецПроцедуры

//++ #1832 смарт: Шляпников 16.01.2025 / Автоматическое закрытие заказов. Отвязка интереса от закрытого заказа.
Процедура ОтвязатьИнтересОтЗаказаКлиента(ЗаказКлиента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_ЖурналДокументов.ГлавнаяЗапись КАК ГлавнаяЗапись,
	|	CRM_ЖурналДокументов.Клиент КАК Клиент,
	|	CRM_ЖурналДокументов.CRM_Интерес КАК CRM_Интерес,
	|	CRM_СостоянияИнтересов.Ссылка КАК НовоеСостояниеИнтереса
	|ИЗ
	|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
	|		ПО CRM_ЖурналДокументов.CRM_Интерес.СостояниеИнтереса.Родитель = CRM_СостоянияИнтересов.Родитель
	|			И (CRM_СостоянияИнтересов.РеквизитДопУпорядочивания = 8)
	|ГДЕ
	|	CRM_ЖурналДокументов.Объект = &ЗаказКлиента
	|	И НЕ CRM_ЖурналДокументов.CRM_Интерес = ЗНАЧЕНИЕ(Документ.CRM_Интерес.ПустаяСсылка)
	|	И CRM_ЖурналДокументов.ТипОбъекта.Наименование = ""Заказ клиента""
	//++ #Б2692 смарт: Шляпников 18.03.2025 / Автоматическое закрытие заказов. Отвязка интереса от закрытого заказа. Дополнение.
	|	И НЕ CRM_ЖурналДокументов.CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)";
	//-- #Б2692 смарт: Шляпников 18.03.2025
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		рег = РегистрыСведений.CRM_ЖурналДокументов.СоздатьНаборЗаписей();
		рег.Отбор.ГлавнаяЗапись.Установить(Выборка.ГлавнаяЗапись, Истина);
		рег.Отбор.Клиент.Установить(Выборка.Клиент, Истина);
		рег.Отбор.CRM_Интерес.Установить(Выборка.CRM_Интерес, Истина);
		рег.Отбор.Объект.Установить(ЗаказКлиента, Истина);
		
		рег.ОбменДанными.Загрузка = Истина;
		рег.Записать(Истина);
		
		ИнтересОбъект = Выборка.CRM_Интерес.ПолучитьОбъект();
		ИнтересОбъект.СостояниеИнтереса = Выборка.НовоеСостояниеИнтереса;
		ИнтересОбъект.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ЗаказКлиента.ДокументОснование) И ТипЗнч(ЗаказКлиента.ДокументОснование) = Тип("ДокументСсылка.CRM_Интерес") Тогда
		
		Если НЕ ЗаказКлиента.ДокументОснование.ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти Тогда
			
			ЗаказОбъект = ЗаказКлиента.ПолучитьОбъект();
			ЗаказОбъект.ДокументОснование = Неопределено;
			ЗаказОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗакрытиеЗаказовНаПеремещение

Функция ПолучитьСКДОтбораДокументовЗаказовНаПеремещение()
	Возврат Справочники.смартПредопределенныеЗначения.ПолучитьМакет("СКДОтбораДокументовЗаказовНаПеремещение");
КонецФункции

Процедура СформироватьКоллекцииДанныхДляОбработкиЗаказовНаПеремещение(ТаблицаЗаказов, СоответствиеМенеджеровИЗаказовКУведомлениям)
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаказов Цикл
		
		// Отправляем уведомление, в случае, если дата уведомления равна текущей
		Если СоответствиеМенеджеровИЗаказовКУведомлениям.Получить(СтрокаТаблицы.ЗаказНаПеремещениеОтветственный) = Неопределено Тогда
			СоответствиеМенеджеровИЗаказовКУведомлениям.Вставить(СтрокаТаблицы.ЗаказНаПеремещениеОтветственный, Новый Массив);
		КонецЕсли;
		
		СоответствиеМенеджеровИЗаказовКУведомлениям[СтрокаТаблицы.ЗаказНаПеремещениеОтветственный].Добавить(СтрокаТаблицы.ЗаказНаПеремещение);
			
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьУведомленияОСкоромАвтоматическомЗакрытииЗаказовНаПеремещение(СоответствиеМенеджеровИЗаказовКУведомлениям, АдресСервиснойЭлектроннойПочты, КоличествоДней)
	
	// Перебираем соответствие: Ключ - Менеджер, Значение - Массив заказов этого менеджера
	Для Каждого КлючИЗначение Из СоответствиеМенеджеровИЗаказовКУведомлениям Цикл
		
