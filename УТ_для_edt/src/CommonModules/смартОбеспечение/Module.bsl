КонецФункции

Процедура РезервыКДатеВыполнитьРаспределениеРезервов(ГрафикПоступления, ГрафикОтгрузки)
	
	ПустаяДата = Дата(1, 1, 1);
	
    // Для каждого документа из ГрафикОтгрузки найдем даты, на которые надо перенести документ.
    // Разбивка строк в документах графика отгрузки не предусмотрена (согласно условиям задачи).
	Для Каждого СтрокаТаблицыОтгрузка Из ГрафикОтгрузки Цикл
		
		ТребуетсяРаспределить = СтрокаТаблицыОтгрузка.Количество;
        ВсегоКоличествоПоВыбраннымПоступлениям = 0;
		
		// Определяем дату резерва
        Для Каждого СтрокаТаблицыПоступление Из ГрафикПоступления Цикл
			
			Если СтрокаТаблицыПоступление.Количество = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			// Накапливаем количество с каждой итерацией, пока количество не будет удовлетворять потребность 
			ВсегоКоличествоПоВыбраннымПоступлениям = ВсегоКоличествоПоВыбраннымПоступлениям + СтрокаТаблицыПоступление.Количество;
			
			// Потребность удовлетворить можно только целиком (условие задачи)
			Если ТребуетсяРаспределить <= ВсегоКоличествоПоВыбраннымПоступлениям Тогда
				
				Если (СтрокаТаблицыОтгрузка.ДатаОтгрузки >= СтрокаТаблицыПоступление.ДатаПоступления
						Или СтрокаТаблицыОтгрузка.ДатаОтгрузки >= СтрокаТаблицыПоступление.ДатаПоступления)						
					Тогда
					СтрокаТаблицыОтгрузка.ДатаСдвига = СтрокаТаблицыОтгрузка.ДатаОтгрузки;
				Иначе
					СтрокаТаблицыОтгрузка.ДатаСдвига = СтрокаТаблицыПоступление.ДатаПоступления;
				КонецЕсли;
				
				Прервать;

			КонецЕсли;
			
        КонецЦикла;                          
		
		// Распределяем количество поступающих по отгрузкам
		Для Каждого СтрокаТаблицыПоступление Из ГрафикПоступления Цикл
			
			Если ТребуетсяРаспределить = 0 Тогда
                Прервать;
            КонецЕсли;
			
			Если СтрокаТаблицыПоступление.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			            
            ДоступноКРаспредеению = Мин(СтрокаТаблицыПоступление.Количество, ТребуетсяРаспределить);
            
            СтрокаТаблицыПоступление.Количество = СтрокаТаблицыПоступление.Количество - ДоступноКРаспредеению;
            ТребуетсяРаспределить = ТребуетсяРаспределить - ДоступноКРаспредеению;
            
        КонецЦикла;
						
	КонецЦикла;
	
	// Удаляем строки из отгрузки, в котороых дата отгрузки и дата сдвига не заполнены
	// Резерва не было и резервировать нечего. Обработка не требуется.
	МассивСтрокТаблицыОтгрузкаДляУдаления = ГрафикОтгрузки.НайтиСтроки(Новый Структура("ДатаОтгрузки, ДатаСдвига", ПустаяДата, ПустаяДата));
	Для Каждого ЭлементМассива Из МассивСтрокТаблицыОтгрузкаДляУдаления Цикл
		ГрафикОтгрузки.Удалить(ЭлементМассива);	
	КонецЦикла;	
	
КонецПроцедуры

Процедура РезервыКДатеОтменитьРезервыДокументов(ГрафикОтгрузки, Параметры)

	НайденныеСтрокиОтгрузкиБезРаспрделения = ГрафикОтгрузки.НайтиСтроки(Новый Структура("ДатаСдвига", Дата(1, 1, 1)));
	
	Для Каждого НайденнаяСтрока Из НайденныеСтрокиОтгрузкиБезРаспрделения Цикл
				
		РезервКДатеОтменитьРезервДокумента(
			Параметры.ЗаказПоставщику,
			Параметры.МассивТиповДокументов, 
			НайденнаяСтрока.Документ, 
			НайденнаяСтрока.ДатаСдвига, 
			Параметры.Номенклатура, 
			Параметры.Характеристика, 
			Параметры.Склад, 
			Параметры.МассивИзмененныхЗаказовНаПеремещение);
				
		Если Не НайденнаяСтрока.ЗаказКлиента.Пустая() Тогда
			
			Если ТипЗнч(НайденнаяСтрока.Документ) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
						
				РезервКДатеОтменитьРезервДокумента(
					Параметры.ЗаказПоставщику,
					Параметры.МассивТиповДокументов, 
					НайденнаяСтрока.ЗаказКлиента, 
					НайденнаяСтрока.ДатаСдвига, 
					Параметры.Номенклатура, 
					Параметры.Характеристика, 
					НайденнаяСтрока.СкладПолучательЗаказНаПеремещение, 
					Параметры.МассивИзмененныхЗаказовНаПеремещение);
				
			ИначеЕсли ТипЗнч(НайденнаяСтрока.Документ) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
				
				РезервКДатеОтменитьРезервДокумента(
					Параметры.ЗаказПоставщику,
					Параметры.МассивТиповДокументов, 
					НайденнаяСтрока.ЗаказКлиента, 
					НайденнаяСтрока.ДатаСдвига, 
					НайденнаяСтрока.НоменклатураЗаказНаСборку, 
					НайденнаяСтрока.ХарактеристикаЗаказНаСборку, 
					Параметры.Склад, 
					Параметры.МассивИзмененныхЗаказовНаПеремещение);
				
			КонецЕсли;
				
		КонецЕсли;
		
		ГрафикОтгрузки.Удалить(НайденнаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура РезервКДатеОтменитьРезервДокумента(ЗаказПоставщику,
												МассивТиповДокументов, 
												Документ, 
												ДатаСдвига, 
												Номенклатура, 
												Характеристика, 
												Склад, 
												МассивИзмененныхЗаказовНаПеремещение = Неопределено)
												
	ЗначениеОпцииРезервыНаСкладе = Справочники.смартПредопределенныеЗначения.ЗаказПоставщикуРезервыНаСкладе.Значение;
	ЗначениеОпцииРезервыНаСкладе = ?(ЗначениеОпцииРезервыНаСкладе = Неопределено, Ложь, ЗначениеОпцииРезервыНаСкладе); 
	
    ТипТекущегоДокумента 			= ТипЗнч(Документ);
	ТипДокументаЗаказКлиента 		= Тип("ДокументСсылка.ЗаказКлиента");
	ТипДокументаЗаказНаПеремещение 	= Тип("ДокументСсылка.ЗаказНаПеремещение");
	ТипДокументаЗаказНаСборку 		= Тип("ДокументСсылка.ЗаказНаСборку");

	ТипДокументаАктуальный = 
		ТипТекущегоДокумента = ТипДокументаЗаказКлиента
		Или ТипТекущегоДокумента = ТипДокументаЗаказНаПеремещение
		Или ТипТекущегоДокумента = ТипДокументаЗаказНаСборку;
	
    Если Не МассивТиповДокументов.Найти(ТипТекущегоДокумента) = Неопределено тогда
		
		//меняем данные в документах и проводим
        ДокументОбъект = Документ.ПолучитьОбъект();
        НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДокументОбъект);
		
        Попытка
            ДокументОбъект.Заблокировать();
        Исключение			
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Строка(Документ) + " не возможно изменить, он заблокирован: " + ОписаниеОшибки()); 
            
			Если Не смартОбщегоНазначения.смартРабочаяБаза() Тогда
				Возврат;	
			КонецЕсли;
			
			//++ #1134 смарт: Фролов 12.05.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента  
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				Документ.Метаданные(),
				Документ,
				ОписаниеОшибки());
			//-- #1134 смарт: Фролов 12.05.2023
			
            УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
			
			ДанныеДляОтправки = Новый Структура;
            ДанныеДляОтправки.Вставить("Кому", 		"help1c@smart-t.ru"); 
            ДанныеДляОтправки.Вставить("Тема", 		"Не удалось изменить резерв, документ заблокирован, в: " + Документ);
            ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
            ДанныеДляОтправки.Вставить("Важность", 	ВажностьИнтернетПочтовогоСообщения.Высокая);              
            ДанныеДляОтправки.Вставить("Тело", 
				"Документ изменения: " 
				+ Строка(Документ) 
				+ Символы.ПС 
				+ Символы.ПС   
            	+ "Не изменено обеспечение по товару: "
				+ Номенклатура
				+ " Резервировать на складе: _ "
				+ Строка(Документ) 
				+ Символы.ПС
				+ " " + Символы.ПС
				+ Символы.ПС
				+ "Навигационная ссылка на документ: " + НавигационнаяСсылка);
			
            РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки);
           
            Возврат;
			
        КонецПопытки;
		
		Если ТипДокументаАктуальный Тогда
			
			Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента
				И ДокументОбъект.НеОтгружатьЧастями Тогда
				
				ДокументОбъект.НеОтгружатьЧастями = Ложь;

			КонецЕсли;
				            
            Отбор = Новый Структура("Номенклатура, Характеристика, ВариантОбеспечения", 
								Номенклатура, 
								Характеристика,
								ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); // Резервировать к дате
								
			Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента Тогда
                Отбор.Вставить("Склад", Склад);
            КонецЕсли;
            
			МассивСтрокИндексы = Новый Массив;

			НайденныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Отбор); 
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				МассивСтрокИндексы.Добавить(ДокументОбъект.Товары.Индекс(НайденнаяСтрока));
			КонецЦикла;
			
			Текст = "";                  
			
			Если ТипДокументаАктуальный
				И МассивСтрокИндексы.Количество() 
                И ЗначениеОпцииРезервыНаСкладе Тогда
				
				ВариантыОбеспечения = Новый Массив;
				ВариантыОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.Требуется);  //К обеспечению 
				
				Текст = РезервыКДатеУстановитьОбеспечениеДокумента(ВариантыОбеспечения, ДокументОбъект, МассивСтрокИндексы);
				
				Если ТипТекущегоДокумента = ТипДокументаЗаказНаСборку 
					И ДокументОбъект.Модифицированность() Тогда 

					ДокументОбъект.НачалоСборкиРазборки = 
						Макс(ДокументОбъект.НачалоСборкиРазборки, ДокументОбъект.Ссылка.НачалоСборкиРазборки);
						
					ДокументОбъект.ОкончаниеСборкиРазборки = 
						Макс(ДокументОбъект.ОкончаниеСборкиРазборки, ДокументОбъект.Ссылка.ОкончаниеСборкиРазборки);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
        //-- #1274 смарт: Фролов 27.12.2022
		
		Если ДокументОбъект.Модифицированность() Тогда
			
            //добавим доп. свойство для отмены проверки на отрицательные остатки по регистру ДоступныеОстаткиПланируемыхПоступлений
            ДокументОбъект.ДополнительныеСвойства.Вставить("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений", Истина);
			
			Попытка
				
                ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");  
				//++ #Б4718 смарт: Шляпников 13.10.2025 / Исключить проверку заполнения поля Доставка, при автоматических обработках оп резервированию товаров
				ДокументОбъект.ДополнительныеСвойства.Вставить("НеКонтроллироватьПлатнуюДоставку", Истина);
				//-- #Б4718 смарт: Шляпников 13.10.2025
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

				ОбщегоНазначения.СообщитьПользователю("Снят резерв в документе """ + Строка(Документ) + """", Документ);
                
                НомерПоследнейВерсии = ПолучитьНомерВерсииПоследний(Документ);
				Если Не НомерПоследнейВерсии = Неопределено Тогда
					
                    ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(
						Документ, НомерПоследнейВерсии, "Автоматическое снятие резерка при изменении даты поступления товара(Не обеспечивать)");
						
                КонецЕсли;
                //-- #1274 смарт: Фролов 28.12.2022
				
                ПоследняяВерсияИсторииИзменений = ВерсионированиеОбъектов.НомерПоследнейВерсии(ДокументОбъект.Ссылка); 
                НоваяВерсияИсторииИзменений = ВерсионированиеОбъектов.СведенияОВерсииОбъекта(Документ, ПоследняяВерсияИсторииИзменений);  
                                
                Менеджер = Справочники.Пользователи.ПустаяСсылка();
				
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "Менеджер") 
					И ЗначениеЗаполнено(Документ.Менеджер) Тогда
					
                    Менеджер = Документ.Менеджер; 
					
				ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "Ответственный") 
					И ЗначениеЗаполнено(Документ.Ответственный) Тогда
					
                    Менеджер = Документ.Ответственный;                
					
                КонецЕсли;
                
				Если ЗначениеЗаполнено(Менеджер)
					//++ #4926 смарт: Тимофеева 14.11.2025 / Ошибка ЖР. смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Менеджер, "Недействителен") 
					И НЕ Менеджер.Недействителен
					//-- #4926 смарт: Тимофеева 14.11.2025
					И Не ЗаказПоставщику.ДополнительныеСвойства.Свойство("смартНеРассылатьОповещения") 
					И смартОбщегоНазначения.смартРабочаяБаза() 
					Тогда
					
					//++ #5620 смарт: Тимофеева 18.06.2026 / смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					Если ЗначениеЗаполнено(Менеджер.смартРабочаяПочта) Тогда
					//-- #5620 смарт: Тимофеева 18.06.2026
					
                    УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
					
					ДанныеДляОтправки = Новый Структура;
                    ДанныеДляОтправки.Вставить("Кому", 		Менеджер.смартРабочаяПочта); 
                    ДанныеДляОтправки.Вставить("Тема", 		"Изменен резерв в: " + Документ);
					ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
                    ДанныеДляОтправки.Вставить("Важность", 	ВажностьИнтернетПочтовогоСообщения.Высокая);					
					
					Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента Тогда
						
						//++ #2006 смарт: Шляпников 19.09.2024 / Отключить оповещения "Изменение резервов" по СЦ у Ларькова А.С., ИТСМ 2006
						Если НЕ ЭтоЗапаснаяЧасть(Номенклатура) Тогда
							ДанныеДляОтправки.Вставить("Копии", "larkov@smart-t.ru");
						КонецЕсли;
						//-- #2006 смарт: Шляпников 19.09.2024
						
						ДанныеДляОтправки.Вставить("Тело", 
							"Документ изменения: "
							+ ЗаказПоставщику
							+ " Автор изменения: "
							+ НоваяВерсияИсторииИзменений.АвторВерсии
							+ Символы.ПС
							+ Символы.ПС
							+ "Изменено обеспечение по товару: "
							+ Номенклатура
							+ " снят резерв с оплаченного заказа : "
							+ Строка(Документ) 
							+ Символы.ПС + " " 
							+ Символы.ПС + Символы.ПС 
							+ "Навигационная ссылка на документ: " 
							+ НавигационнаяСсылка
							+ Символы.ПС
							+ СмартСервер.смартСформироватьТекстПисьмаМеньшеПределаПроцента(Документ));
						
					КонецЕсли;
                    
					РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки); 
                    
                    ЕстьЗаписьОсновной = смартОбработкаПодписокНаСобытия.ПолучитьТекЗаписьНапоминания(Менеджер, Документ);
					
					Если Не ЕстьЗаписьОсновной Тогда
						
                        ПараметрыНапоминания = Новый Структура;
	                    ПараметрыНапоминания.Вставить("Пользователь", Менеджер);
                        ПараметрыНапоминания.Вставить("Источник", Документ);
                        ПараметрыНапоминания.Вставить("Описание","Изменен резерв! " + Документ);
                        ПараметрыНапоминания.Вставить("ВремяСобытия", ТекущаяДатаСеанса());
                        ПараметрыНапоминания.Вставить("ИнтервалВремениНапоминания", 300);
                        ПараметрыНапоминания.Вставить("Идентификатор", "ЗаказКлиента");
						
                        НапоминанияПользователяСлужебный.ПодключитьНапоминание(ПараметрыНапоминания);
						
                    КонецЕсли; 
					
					//++ #5620 смарт: Тимофеева 18.06.2026 / смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					Иначе
						смартОбработкаПодписокНаСобытия.ОтправитьПисьмоОбОтсутствииРабочейПочтыУМенеджера(Менеджер);
					КонецЕсли;
					//-- #5620 смарт: Тимофеева 18.06.2026 				
                КонецЕсли;

			Исключение
				                
                ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ """ + Строка(Документ) + """ не записан: " + ОписаниеОшибки());  

				Если смартОбщегоНазначения.смартРабочаяБаза() Тогда

					//++ #1134 смарт: Фролов 12.05.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента  
					ЗаписьЖурналаРегистрации(
						ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
						УровеньЖурналаРегистрации.Ошибка,
						Документ.Метаданные(),
						Документ,
						ОписаниеОшибки());
					//-- #1134 смарт: Фролов 12.05.2023
					
					УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
					
					ДанныеДляОтправки=Новый Структура;
					ДанныеДляОтправки.Вставить("Кому", 		"help1c@smart-t.ru"); 
					ДанныеДляОтправки.Вставить("Тема", 		"Не удалось изменить резерв, в: " + Документ);
					ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
					ДанныеДляОтправки.Вставить("Важность", 	ВажностьИнтернетПочтовогоСообщения.Высокая);
					
					Если ЗначениеЗаполнено(Текст) Тогда
						
						//++ #1134 смарт: Фролов 13.02.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента
						ДанныеДляОтправки.Вставить("Тело",
							"Документ изменения: "
							+ ЗаказПоставщику
							+ Символы.ПС 
							+ Символы.ПС
							+ "Не Изменено обеспечение по товару: "
							+ Номенклатура
							+ " Резервировать на складе:"
							+ Текст + " _ " 
							+ Строка(Документ) 
							+ Символы.ПС
							+ " " + Символы.ПС + Символы.ПС 
							+ "Навигационная ссылка на документ: " + НавигационнаяСсылка 
							+ Символы.ПС
							+ "Ошибка: " + ОписаниеОшибки());

					Иначе
						ДанныеДляОтправки.Вставить("Тело", 
							"Документ изменения: "
							+ ЗаказПоставщику
							+ Символы.ПС
							+ Символы.ПС
							+ "Не Изменены даты резерва по товару: "
							+ Номенклатура
							+ " в документе " 
							+ Строка(Документ) 
							+ " на " + ДатаСдвига
							+ Символы.ПС 
							+ " " + Символы.ПС + Символы.ПС 
							+ "Навигационная ссылка на документ: " + НавигационнаяСсылка
							+ Символы.ПС 
							+ "Ошибка: " + ОписаниеОшибки());
						//-- #1134 смарт: Фролов 13.02.2023 добавлено описание ошибки
						
					КонецЕсли;

					РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки); 

				КонецЕсли;
                
                ВызватьИсключение
				
			КонецПопытки;
			
        КонецЕсли;
        
        ДокументОбъект.Разблокировать();
		
    КонецЕсли;       												
	
КонецПроцедуры

Процедура РезервыКДатеУстановитьРезервыДокументов(ГрафикОтгрузки, Параметры)

	ГрафикОтгрузки.Сортировать("ДатаСдвига Убыв");
	
	Для Каждого СтрокаТаблицыОтгрузка Из ГрафикОтгрузки Цикл

		РезервыКДатеУстановитьРезервДокумента(
			Параметры.ЗаказПоставщику,
			Параметры.МассивТиповДокументов, 
			СтрокаТаблицыОтгрузка.Документ, 
			СтрокаТаблицыОтгрузка.ДатаСдвига, 
			Параметры.Номенклатура, 
			Параметры.Характеристика, 
			Параметры.Склад, 
			Параметры.МассивИзмененныхЗаказовНаПеремещение,
			СтрокаТаблицыОтгрузка.ПроцентОплатыНижеМинимального);
			
		Если Не СтрокаТаблицыОтгрузка.ЗаказКлиента.Пустая() Тогда
				
			Если ТипЗнч(СтрокаТаблицыОтгрузка.Документ) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
					
			    РезервыКДатеУстановитьРезервДокумента(
					Параметры.ЗаказПоставщику,
					Параметры.МассивТиповДокументов, 
					СтрокаТаблицыОтгрузка.ЗаказКлиента, 
					СтрокаТаблицыОтгрузка.ДатаСдвига, 
					Параметры.Номенклатура, 
					Параметры.Характеристика, 
					Параметры.СкладПолучательЗаказНаПеремещение, 
					Параметры.МассивИзмененныхЗаказовНаПеремещение,
					СтрокаТаблицыОтгрузка.ПроцентОплатыНижеМинимального);
				
			ИначеЕсли ТипЗнч(СтрокаТаблицыОтгрузка.Документ) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
				
				РезервыКДатеУстановитьРезервДокумента(
					Параметры.ЗаказПоставщику,
					Параметры.МассивТиповДокументов, 
					СтрокаТаблицыОтгрузка.ЗаказКлиента, 
					СтрокаТаблицыОтгрузка.ДатаСдвига, 
					СтрокаТаблицыОтгрузка.НоменклатураЗаказНаСборку, 
					СтрокаТаблицыОтгрузка.ХарактеристикаЗаказНаСборку, 
					Параметры.Склад, 
					Параметры.МассивИзмененныхЗаказовНаПеремещение,
					СтрокаТаблицыОтгрузка.ПроцентОплатыНижеМинимального);
				
			КонецЕсли;
			
		КонецЕсли;
	   
	КонецЦикла;
	
КонецПроцедуры

Процедура РезервыКДатеУстановитьРезервДокумента(ЗаказПоставщику,
													МассивТиповДокументов, 
													Документ, 
													ДатаСдвига, 
													Номенклатура, 
													Характеристика, 
													Склад, 
													МассивИзмененныхЗаказовНаПеремещение, 
													ОплатаНижеПредела = Ложь) 
    
 	ЗначениеОпцииРезервыНаСкладе = Справочники.смартПредопределенныеЗначения.ЗаказПоставщикуРезервыНаСкладе.Значение;
	ЗначениеОпцииРезервыНаСкладе = ?(ЗначениеОпцииРезервыНаСкладе = Неопределено, Ложь, ЗначениеОпцииРезервыНаСкладе); 
	
    ТипТекущегоДокумента 			= ТипЗнч(Документ);
	ТипДокументаЗаказКлиента 		= Тип("ДокументСсылка.ЗаказКлиента");
	ТипДокументаЗаказНаПеремещение 	= Тип("ДокументСсылка.ЗаказНаПеремещение");
	ТипДокументаЗаказНаСборку 		= Тип("ДокументСсылка.ЗаказНаСборку");
	
	ТипДокументаАктуальный = 
		ТипТекущегоДокумента = ТипДокументаЗаказКлиента
		Или ТипТекущегоДокумента = ТипДокументаЗаказНаПеремещение
		Или ТипТекущегоДокумента = ТипДокументаЗаказНаСборку;
	
    Если Не МассивТиповДокументов.Найти(ТипТекущегоДокумента) = Неопределено Тогда
		
		//меняем данные в документах и проводим
        ДокументОбъект = Документ.ПолучитьОбъект();
        НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДокументОбъект);
		
        Попытка
            ДокументОбъект.Заблокировать();
		Исключение
			
            ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Строка(Документ) + " не возможно изменить, он заблокирован: " + ОписаниеОшибки()); 
            
			Если Не смартОбщегоНазначения.смартРабочаяБаза() Тогда
				Возврат;
			КонецЕсли;
			
			//++ #1134 смарт: Фролов 12.05.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента  
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка,
				Документ.Метаданные(),
				Документ,
				ОписаниеОшибки());
			//-- #1134 смарт: Фролов 12.05.2023
			
			УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
			
			ДанныеДляОтправки = Новый Структура;
            ДанныеДляОтправки.Вставить("Кому", "help1c@smart-t.ru"); 
            ДанныеДляОтправки.Вставить("Тема", "Не удалось изменить резерв, документ заблокирован, в: " + Документ);
            ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
            ДанныеДляОтправки.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);			
            ДанныеДляОтправки.Вставить("Тело",
				"Документ изменения: "
				+ Строка(Документ)
				+ Символы.ПС
				+ Символы.ПС
				+ "Не изменено обеспечение по товару: "
				+ Номенклатура
				+ " Резервировать на складе: _ "
				+ Строка(Документ) 
				+ Символы.ПС
				+ " " + Символы.ПС + Символы.ПС
				+ "Навигационная ссылка на документ: " + НавигационнаяСсылка);

            РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки);
            
            Возврат;
			
        КонецПопытки;
        
		Если ТипДокументаАктуальный Тогда
            
            //отгрузить одной датой
			Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента
				И ДокументОбъект.НеОтгружатьЧастями Тогда

                //если заказ отгружается одной датой, то снимаем этот признак, для того чтобы подвинуть дату по конкретному товару
                ДокументОбъект.НеОтгружатьЧастями = Ложь; 
				
            КонецЕсли;
			
			//ТекущийВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов");
			
            Отбор = Новый Структура("Номенклатура, Характеристика", Номенклатура, Характеристика);
								
            Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента Тогда
                Отбор.Вставить("Склад", Склад);
            КонецЕсли;
			
			МассивВариантовОбеспечения = Новый Массив;
			МассивВариантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов); 	// Резервировать к дате
			МассивВариантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.Требуется);    // К обеспечению
			МассивВариантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.НеТребуется);	// Не обеспечивать
			
            МассивСтрокИндексы = Новый Массив;
			
			Для Каждого ВариантОбеспечения Из МассивВариантовОбеспечения Цикл
				
				Отбор.Вставить("ВариантОбеспечения", ВариантОбеспечения);
				
				НайденныеСтроки = ДокументОбъект.Товары.НайтиСтроки(Отбор); 
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					МассивСтрокИндексы.Добавить(ДокументОбъект.Товары.Индекс(НайденнаяСтрока));
					
					Если ТипТекущегоДокумента = ТипДокументаЗаказНаПеремещение Тогда
						НайденнаяСтрока.НачалоОтгрузки = ДатаСдвига;
					ИначеЕсли ТипТекущегоДокумента = ТипДокументаЗаказНаСборку Тогда
						ДокументОбъект.НачалоСборкиРазборки = ДатаСдвига;
						ДокументОбъект.ОкончаниеСборкиРазборки = ДатаСдвига;
					Иначе	
						НайденнаяСтрока.ДатаОтгрузки = ДатаСдвига;
					КонецЕсли;
						
				КонецЦикла;
				
			КонецЦикла;

            Текст = "";             
			
			Если ТипДокументаАктуальный					
				И МассивСтрокИндексы.Количество() 
                И ЗначениеОпцииРезервыНаСкладе Тогда
                    
				ВариантыОбеспечения = Новый Массив;
				ВариантыОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);  // Резервировать к дате 
				
				Текст = РезервыКДатеУстановитьОбеспечениеДокумента(ВариантыОбеспечения, ДокументОбъект, МассивСтрокИндексы);
								
			КонецЕсли;
				
	   КонецЕсли;  
        
	   Если ДокументОбъект.Модифицированность() Тогда
		   
            ДокументОбъект.ДополнительныеСвойства.Вставить("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений", Истина);
			
			Попытка 
				
                ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");  
				//++ #Б4718 смарт: Шляпников 13.10.2025 / Исключить проверку заполнения поля Доставка, при автоматических обработках оп резервированию товаров
				ДокументОбъект.ДополнительныеСвойства.Вставить("НеКонтроллироватьПлатнуюДоставку", Истина);
				//-- #Б4718 смарт: Шляпников 13.10.2025
                ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);  
				
				ОбщегоНазначения.СообщитьПользователю(
					"Изменены даты резерва в документе """ + Строка(Документ) + """", Документ);
                
                ПоследняяВерсияИсторииИзменений = ПолучитьНомерВерсииПоследний(Документ);
				Если Не ПоследняяВерсияИсторииИзменений = Неопределено Тогда
					
                    ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(
						Документ, ПоследняяВерсияИсторииИзменений, 
							"Автоматический перенос резерва при изменении даты поступления товара");
						
                КонецЕсли;
                
                ПоследняяВерсияИсторииИзменений = ВерсионированиеОбъектов.НомерПоследнейВерсии(ДокументОбъект.Ссылка); 
				
				НоваяВерсияИсторииИзменений = 
					ВерсионированиеОбъектов.СведенияОВерсииОбъекта(ДокументОбъект.Ссылка, ПоследняяВерсияИсторииИзменений);  

                Менеджер = Справочники.Пользователи.ПустаяСсылка();
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "Менеджер") 
					И ЗначениеЗаполнено(Документ.Менеджер) Тогда  
					
                    Менеджер = Документ.Менеджер;
					
				ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "Ответственный") 
					И ЗначениеЗаполнено(Документ.Ответственный) Тогда
					
					Менеджер = Документ.Ответственный;                
					
                КонецЕсли;
                
				Если ЗначениеЗаполнено(Менеджер)
					//++ #4926 смарт: Тимофеева 14.11.2025 / Ошибка ЖР. смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Менеджер, "Недействителен") 
					И НЕ Менеджер.Недействителен
					//-- #4926 смарт: Тимофеева 14.11.2025
					И Не ЗаказПоставщику.ДополнительныеСвойства.Свойство("смартНеРассылатьОповещения") 
					И смартОбщегоНазначения.смартРабочаяБаза() 
					Тогда
					
					//++ #5620 смарт: Тимофеева 18.06.2026 / смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					Если ЗначениеЗаполнено(Менеджер.смартРабочаяПочта) Тогда
					//-- #5620 смарт: Тимофеева 18.06.2026

                    УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
					
                    ДанныеДляОтправки=Новый Структура;
                    ДанныеДляОтправки.Вставить("Кому", 		Менеджер.смартРабочаяПочта); 
                    ДанныеДляОтправки.Вставить("Тема", 		"Изменен резерв в: " + Документ);
                    ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
                    ДанныеДляОтправки.Вставить("Важность", 	ВажностьИнтернетПочтовогоСообщения.Высокая);
					
					Если ТипТекущегоДокумента = ТипДокументаЗаказКлиента Тогда
						
						Если ОплатаНижеПредела Тогда
							
							ДанныеДляОтправки.Вставить("Копии", "larkov@smart-t.ru");
							ДанныеДляОтправки.Вставить("Тело",
								"Документ изменения: "
								+ ЗаказПоставщику
								+ " Автор изменения: "
								+ НоваяВерсияИсторииИзменений.АвторВерсии
								+ Символы.ПС
								+ Символы.ПС
								+ "Установлен автоматический резерв по товару: "
								+ Номенклатура 
								//++ #Б-1080 смарт: Лопато 07.03.2025 //Добавить доп текст в оповещения (продолжение задачи 1600) (ИТСМ 1622)  
								+ " в документе " + Строка(Документ) + " " + СокрЛП(Документ.Контрагент) 
								//-- #Б-1080 смарт: Лопато 07.03.2025
								+ "  предоплата по которому менее 30%, необходимо дать письменное объяснение на электронный адрес larkov@smart-t.ru. " 
								+ Символы.ПС 
								+ " " + Символы.ПС + Символы.ПС
								+ "Навигационная ссылка на документ: " + НавигационнаяСсылка
								+ Символы.ПС
								+ СмартСервер.смартСформироватьТекстПисьмаМеньшеПределаПроцента(Документ));
							
						Иначе
								
							ДанныеДляОтправки.Вставить("Тело",
								"Документ изменения: "
								+ ЗаказПоставщику
								+ " Автор изменения: "
								+ НоваяВерсияИсторииИзменений.АвторВерсии
								+ Символы.ПС
								+ Символы.ПС
								+ "Изменены даты резерва по товару: "
								+ Номенклатура
								//++ #Б-1080 смарт: Лопато 07.03.2025 //Добавить доп текст в оповещения (продолжение задачи 1600) (ИТСМ 1622)  
								+ " в документе " + Строка(Документ) + " " + СокрЛП(Документ.Контрагент) 
								//-- #Б-1080 смарт: Лопато 07.03.2025
								+ " на "+ ДатаСдвига
								+ Символы.ПС
								+ " " + Символы.ПС + Символы.ПС
								+ "Навигационная ссылка на документ: " + НавигационнаяСсылка);

						КонецЕсли;

					Конецесли;

                    РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки); 
                    
                    ЕстьЗаписьОсновной = смартОбработкаПодписокНаСобытия.ПолучитьТекЗаписьНапоминания(Менеджер, Документ);
					
					Если Не ЕстьЗаписьОсновной Тогда
						
                        ПараметрыНапоминания = Новый Структура;
                        ПараметрыНапоминания.Вставить("Пользователь", Менеджер);
                        ПараметрыНапоминания.Вставить("Источник", Документ);
                        ПараметрыНапоминания.Вставить("Описание","Изменен резерв! " + Документ);
                        ПараметрыНапоминания.Вставить("ВремяСобытия", ТекущаяДатаСеанса());
                        ПараметрыНапоминания.Вставить("ИнтервалВремениНапоминания", 300);
                        ПараметрыНапоминания.Вставить("Идентификатор", "ЗаказКлиента");
						
						НапоминанияПользователяСлужебный.ПодключитьНапоминание(ПараметрыНапоминания);
						
                    КонецЕсли; 
					
					//++ #5620 смарт: Тимофеева 18.06.2026 / смартОтправитьОповещенияПоЗаказамКлиентаСбронью. Доработка.
					Иначе
						смартОбработкаПодписокНаСобытия.ОтправитьПисьмоОбОтсутствииРабочейПочтыУМенеджера(Менеджер);
					КонецЕсли;
					//-- #5620 смарт: Тимофеева 18.06.2026
                КонецЕсли;
                
                Если ТипТекущегоДокумента = ТипДокументаЗаказНаПеремещение Тогда
                    МассивИзмененныхЗаказовНаПеремещение.Добавить(Документ);
				КонецЕсли;
				
            Исключение
                
	            ОбщегоНазначения.СообщитьПользователю("Документ """ + Строка(Документ) + """ не записан: " + ОписаниеОшибки());  
				
				//++ #1134 смарт: Фролов 12.05.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента  
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Ошибка,
					Документ.Метаданные(),
					Документ,
					ОписаниеОшибки());
				//-- #1134 смарт: Фролов 12.05.2023
				
				Если смартОбщегоНазначения.смартРабочаяБаза() Тогда
					
					УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
					
					ДанныеДляОтправки = Новый Структура;
					ДанныеДляОтправки.Вставить("Кому", 		"help1c@smart-t.ru"); 
					ДанныеДляОтправки.Вставить("Тема", 		"Не удалось изменить резерв, в: " + Документ);
					ДанныеДляОтправки.Вставить("ТипТекста",	ТипТекстаПочтовогоСообщения.ПростойТекст);
					ДанныеДляОтправки.Вставить("Важность",	ВажностьИнтернетПочтовогоСообщения.Высокая);
					
					Если ЗначениеЗаполнено(Текст) Тогда
						//++ #1134 смарт: Фролов 13.02.2023 //Резервирование При изменении даты в Заказах постащику изменять Резерв в оплаченных Заказах клиента  
						ДанныеДляОтправки.Вставить("Тело",
							"Документ изменения: "
							+ ЗаказПоставщику
							+ Символы.ПС
							+ Символы.ПС
							+ "Не Изменено обеспечение по товару: "
							+ Номенклатура
							+ " Резервировать на складе:"
							+ Текст
							+ " _ " + Строка(Документ) 
							+ Символы.ПС 
							+ " " + Символы.ПС + Символы.ПС 
							+ "Навигационная ссылка на документ: " + НавигационнаяСсылка
							+ Символы.ПС
							+ "Ошибка: " + ОписаниеОшибки());
						
					Иначе
							
						ДанныеДляОтправки.Вставить("Тело",
							"Документ изменения: "
							+ ЗаказПоставщику
							+ Символы.ПС
							+ Символы.ПС
							+ "Не Изменены даты резерва по товару: "
							+ Номенклатура
							+ " в документе " 
							+ Строка(Документ) 
							+ " на " + ДатаСдвига
							+ Символы.ПС
							+ " " + Символы.ПС + Символы.ПС
							+ "Навигационная ссылка на документ: " + НавигационнаяСсылка
							+ Символы.ПС
							+ "Ошибка: " + ОписаниеОшибки());
						//-- #1134 смарт: Фролов 13.02.2023 добавлено описание ошибки					

					КонецЕсли;

					РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки); 
					
				КонецЕсли;
                
                ВызватьИсключение
				
			КонецПопытки;
			
        КонецЕсли;
        
        ДокументОбъект.Разблокировать();
		
    КонецЕсли;        
    
КонецПроцедуры

Функция РезервыКДатеУстановитьОбеспечениеДокумента(ВариантыОбеспечения, ДокументОбъект, МассивСтрокИндексы)
	
	ТипДокумента = ТипЗнч(ДокументОбъект);
	
    ВыбранноеЗначение = Новый Структура("ЗаполнятьЦелымиУпаковками, ПереченьВариантов", Ложь, ВариантыОбеспечения);
	
	ПараметрыЗаполнения = 
		Новый Структура("ПереченьВариантов, ИзменятьОбособление, ЗаполнятьЦелымиУпаковками", Неопределено, Истина, Ложь);
	
    ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыбранноеЗначение);

    ПутиКДанным = Новый Соответствие;
	ПараметрыДокумента = Новый Структура;
	
	Если ТипДокумента = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		
		ПутиКДанным.Вставить("ДатаОтгрузкиРабот", "ДатаОтгрузки"); 

		ПараметрыДокумента.Вставить("СтатусКВыполнению", Не ДокументОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован);
	    ПараметрыДокумента.Вставить("ГруппаСкладов", ДокументОбъект.Склад);
	    ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыКлиентов);
	    ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным);
	    ПараметрыДокумента.Вставить("ИмяТабличнойЧасти", "Товары");
		
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ЗаказНаПеремещение") Тогда
		
		ПутиКДанным.Вставить("ДатаОтгрузки", "НачалоОтгрузки");
		ПутиКДанным.Вставить("Склад", "СкладОтправитель");
		
		ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыНаПеремещение);
		ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным);  
		ПараметрыДокумента.Вставить("ИмяТабличнойЧасти", "Товары");		
		
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ЗаказНаСборку") Тогда
		
		ПутиКДанным.Вставить("ДатаОтгрузки", "НачалоСборкиРазборки");
		ПутиКДанным.Вставить("Назначение", "НазначениеШапки");		
		
		Если ДокументОбъект.ОбосабливатьПоНазначениюЗаказа 
			Или Не ДокументОбъект.ОбосабливатьПоНазначениюЗаказа 
			И Не ЗначениеЗаполнено(ДокументОбъект.Назначение) Тогда
			
			ПутиКДанным.Вставить("Назначение", "НазначениеТовары");
			
		КонецЕсли;		
		
		ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыНаСборку);
		ПараметрыДокумента.Вставить("ОтборПоИзмерениям", Новый Структура("ТипСборки", Перечисления.ТипыДвиженияЗапасов.Отгрузка));
		ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным); 
		ПараметрыДокумента.Вставить("ИмяТабличнойЧасти", "Товары");
		
	КонецЕсли;
		
    Таблица = ОбеспечениеСервер.ТаблицаЗаполнениеОбеспеченияДокумента(
					ДокументОбъект, ВариантыОбеспечения, ПараметрыДокумента, МассивСтрокИндексы);
					
	МенеджерДокумента = Документы[ДокументОбъект.Метаданные().Имя];
    Возврат МенеджерДокумента.ЗаполнитьВариантОбеспечения(ДокументОбъект, Неопределено, "ИндексыСтрок", Таблица);

КонецФункции

