Процедура смартУстановитьТолькоПросмотрЭлементаФормы(ЭлементыФормы, ИмяЭлемента, Значение, МассивИсключений = Неопределено) Экспорт
//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  
	
	Элемент = ЭлементыФормы.Найти(ИмяЭлемента);
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если МассивИсключений <> Неопределено Тогда
		ЭлементИсключение = МассивИсключений.Найти(ИмяЭлемента);
		Если ЭлементИсключение <> Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(Элемент) = Тип("ПолеФормы") ИЛИ ТипЗнч(Элемент) = Тип("ГруппаФормы") ИЛИ ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		ИмяСвойстваЭлемента = "ТолькоПросмотр";
		ЗначениеСвойства    = Значение;
	ИначеЕсли ТипЗнч(Элемент) = Тип("КнопкаФормы") И (Элемент.Вид <> ВидКнопкиФормы.КнопкаКоманднойПанели ИЛИ Элемент.Родитель.Имя = "ФормаКоманднаяПанель") Тогда
		ИмяСвойстваЭлемента = "Доступность";
		ЗначениеСвойства    = НЕ Значение;
	Иначе
		Возврат;
	КонецЕсли;

	Если Элемент[ИмяСвойстваЭлемента] <> ЗначениеСвойства Тогда
		Элемент[ИмяСвойстваЭлемента] = ЗначениеСвойства;
	КонецЕсли;
	
//--#1288 смарт: Лопато 26.12.2022
КонецПроцедуры

Процедура смартУстановитьТолькоПросмотрФормыРасчетЗавершен(Форма) Экспорт
//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  

	ЭлементыФормы = Форма.Элементы;
 	ОбъектФормы   = Форма.Объект;
	
	Если ОбъектФормы.смартСтатусРасчетаБонусов = ПредопределенноеЗначение("Перечисление.смартСтатусыДокументовРасчетаБонусов.РасчетЗавершен") Тогда
		
		Если ОбъектФормы.Проведен Тогда
			ТолькоПросмотр = Истина
		Иначе
			ТолькоПросмотр = НЕ ПравоДоступа("Изменение", ОбъектФормы.Ссылка.Метаданные());
		КонецЕсли;
		
		Для Каждого Элемент Из ЭлементыФормы Цикл
			смартУстановитьТолькоПросмотрЭлементаФормы(ЭлементыФормы, Элемент.Имя, ТолькоПросмотр);
		КонецЦикла;
		
	КонецЕсли;                                              
	
//--#1288 смарт: Лопато 26.12.2022
КонецПроцедуры	

