
// Возвращаемое значение:
//  Cтруктура:
//        * Выручка – Число
//        * ВыручкаПоПодразделениямТЗ - Таблица значений (если ТолькоСуммаВаловойПрибыли = Ложь)
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Функция ASP_ПолучитьДанныеОборотаПоРемонтнымРаботамСКД(Дата, ТолькоСуммаВыручки = Ложь, КурсВал = Неопределено) Экспорт
	СхемаКомпоновкиДанных = Отчеты.ВыручкаИСебестоимостьПродаж.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для Каждого Стр Из Настройки.Структура Цикл
		Если Строка(Стр.ПоляГруппировки) <> "Подразделение (Иерархия)" Тогда
			Стр.Использование = Ложь;
		КонецЕсли;
	КонецЦикла; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	смартASP_УстановкаПараметровОборота.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.смартASP_УстановкаПараметровОборота КАК смартASP_УстановкаПараметровОборота
		|ГДЕ
		|	смартASP_УстановкаПараметровОборота.Проведен = ИСТИНА
		|	И смартASP_УстановкаПараметровОборота.Дата <= &Дата
		|
		|СГРУППИРОВАТЬ ПО
		|	смартASP_УстановкаПараметровОборота.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартASP_УстановкаПараметровОборота.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();	
		ДокПарам=Выборка.Ссылка;
		
		НоменклатураВГруппеИзСписка = ДокПарам.СписокГрупп.ВыгрузитьКолонку("Группа");
		ASP_УстановитьОтборСКД("Номенклатура", ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, НоменклатураВГруппеИзСписка, Настройки);
		
		ГруппаДоступаНоменклатурыВГруппеИзСписка = ДокПарам.СписокГруппДоступа.ВыгрузитьКолонку("ГруппаДоступа");
		ASP_УстановитьОтборСКД("Номенклатура.ГруппаДоступа", ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, ГруппаДоступаНоменклатурыВГруппеИзСписка, Настройки);
		
		НоменклатураНеВСписке = ДокПарам.ИсключаемаяНоменклатура.ВыгрузитьКолонку("Номенклатура");
		ASP_УстановитьОтборСКД("Номенклатура", ВидСравненияКомпоновкиДанных.НеВСписке, НоменклатураНеВСписке, Настройки);
		
		НоменклатураНеВГруппе = ДокПарам.ИсключаемыеГруппыНоменклатуры.ВыгрузитьКолонку("ГруппаНоменклатуры");
		ASP_УстановитьОтборСКД("Номенклатура", ВидСравненияКомпоновкиДанных.НеВИерархии, НоменклатураНеВГруппе, Настройки);
		
		ЗаказКлиентаРеализацияКлиентНеВСписке = ДокПарам.ИсключаемыеКлиенты.ВыгрузитьКолонку("Контрагент");
		ASP_УстановитьОтборСКД("ЗаказКлиента.Партнер", ВидСравненияКомпоновкиДанных.НеВСписке, ЗаказКлиентаРеализацияКлиентНеВСписке, Настройки);	
		
		ASP_УстановитьОтборСКД("ЗаказКлиента.ДатаЗакрытия", ВидСравненияКомпоновкиДанных.БольшеИлиРавно, НачалоМесяца(Дата), Настройки);
		ASP_УстановитьОтборСКД("ЗаказКлиента.ДатаЗакрытия", ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Дата, Настройки);
		ASP_УстановитьОтборСКД("ЗаказКлиента.ДатаЗакрытия", ВидСравненияКомпоновкиДанных.Заполнено, '00010101', Настройки);
		ASP_УстановитьОтборСКД("ЗаказКлиента.Статус", ВидСравненияКомпоновкиДанных.Равно, Перечисления.СтатусыЗаказовКлиентов.Закрыт, Настройки);
		
		ASP_УстановитьПараметрСКД("СтрокаПродажиПоЗаказам","Продажи по заказам",Настройки);
		ASP_УстановитьПараметрСКД("СтрокаПродажиБезЗаказов","Продажи без заказов",Настройки);
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных,Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПараметрТекущаяДата = МакетКомпоновки.ЗначенияПараметров.Найти("ТекущаяДата");
		ПараметрТекущаяДата.Значение = Дата;
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
		
		ДокументРезультат = Новый ТабличныйДокумент;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ТЗ = Новый ТаблицаЗначений;
		ПроцессорВывода.УстановитьОбъект(ТЗ);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		СтрокаИтого = ТЗ.Найти(Неопределено, "Подразделение");
		
		Структура = Новый Структура;
		Структура.Вставить("Выручка", СтрокаИтого.Выручка);
		
		Если ТолькоСуммаВыручки Тогда
			Возврат Структура;
		КонецЕсли;
		
		ТЗ.Удалить(СтрокаИтого);
		Структура.Вставить("ВыручкаПоПодразделениямТЗ", ТЗ);
		
		Возврат Структура;  
		
	Иначе 
		
		Сообщить("Не найден документ установки параметров");
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Функция ASP_ПолучитьДанныеОборотаПоРемонтнымРаботам(Дата, ТолькоСуммаВыручки = Ложь, КурсВал = Неопределено, Платные = Ложь) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	смартASP_УстановкаПараметровОборота.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.смартASP_УстановкаПараметровОборота КАК смартASP_УстановкаПараметровОборота
		|ГДЕ
		|	смартASP_УстановкаПараметровОборота.Проведен
		|	И смартASP_УстановкаПараметровОборота.Дата <= &Дата
		|	И смартASP_УстановкаПараметровОборота.Платные = &Платные
		|
		|СГРУППИРОВАТЬ ПО
		|	смартASP_УстановкаПараметровОборота.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартASP_УстановкаПараметровОборота.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Платные", Платные);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();	
		ДокПарам=Выборка.Ссылка;
		
		НоменклатураВГруппеИзСписка = ДокПарам.СписокГрупп.ВыгрузитьКолонку("Группа");
		ГруппаДоступаНоменклатурыВГруппеИзСписка = ДокПарам.СписокГруппДоступа.ВыгрузитьКолонку("ГруппаДоступа");
		НоменклатураНеВСписке = ДокПарам.ИсключаемаяНоменклатура.ВыгрузитьКолонку("Номенклатура");
		НоменклатураНеВГруппе = ДокПарам.ИсключаемыеГруппыНоменклатуры.ВыгрузитьКолонку("ГруппаНоменклатуры");
		ЗаказКлиентаРеализацияКлиентНеВСписке = ДокПарам.ИсключаемыеКлиенты.ВыгрузитьКолонку("Контрагент");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Продажи.Подразделение КАК Подразделение,
			|	СУММА(Продажи.СуммаВыручкиОборот) КАК Выручка
			|ПОМЕСТИТЬ врВыручка
			|ИЗ
			|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
			|			,
			|			,
			|			,
			|			(&НоменклатураВГруппеИзСпискаБулево ИЛИ АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&НоменклатураВГруппеИзСписка))
			|				И (&ГруппаДоступаНоменклатурыВГруппеИзСпискаБулево ИЛИ АналитикаУчетаНоменклатуры.Номенклатура.ГруппаДоступа В ИЕРАРХИИ (&ГруппаДоступаНоменклатурыВГруппеИзСписка))
			|				
			|				И НЕ АналитикаУчетаНоменклатуры.Номенклатура В (&НоменклатураНеВСписке)
			|				И НЕ АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&НоменклатураНеВГруппе)
			|				
			|				И НЕ ЗаказКлиента.Партнер В (&ЗаказКлиентаРеализацияКлиентНеВСписке)
			|				
			|				И (ЗаказКлиента.ДатаЗакрытия МЕЖДУ &Дата1 И &Дата2)
			|				И ЗаказКлиента.ДатаЗакрытия <> &ПустаяДата
			|				И ЗаказКлиента.Статус = &Статус
			|				И АналитикаУчетаПоПартнерам.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)) КАК Продажи
			|
			|СГРУППИРОВАТЬ ПО
			|	Продажи.Подразделение
			|
			|ИМЕЮЩИЕ
			|	СУММА(Продажи.СуммаВыручкиОборот) <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, врВыручка.Подразделение) КАК Подразделение,
			|	врВыручка.Выручка КАК Выручка
			|ИЗ
			|	врВыручка КАК врВыручка
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартASP_ЗаменыПодразделений КАК смартASP_ЗаменыПодразделений
			|		ПО (врВыручка.Подразделение = смартASP_ЗаменыПодразделений.ПодразделениеДляЗамены)";
		
		Запрос.УстановитьПараметр("ГруппаДоступаНоменклатурыВГруппеИзСписка", ГруппаДоступаНоменклатурыВГруппеИзСписка);
		Запрос.УстановитьПараметр("ГруппаДоступаНоменклатурыВГруппеИзСпискаБулево", (ГруппаДоступаНоменклатурыВГруппеИзСписка.Количество() = 0));
		Запрос.УстановитьПараметр("НоменклатураВГруппеИзСписка", НоменклатураВГруппеИзСписка);
		Запрос.УстановитьПараметр("НоменклатураВГруппеИзСпискаБулево", (НоменклатураВГруппеИзСписка.Количество() = 0));
		
		Запрос.УстановитьПараметр("НоменклатураНеВГруппе", НоменклатураНеВГруппе);
		Запрос.УстановитьПараметр("НоменклатураНеВСписке", НоменклатураНеВСписке);
		
		Запрос.УстановитьПараметр("ЗаказКлиентаРеализацияКлиентНеВСписке", ЗаказКлиентаРеализацияКлиентНеВСписке);
		
		Запрос.УстановитьПараметр("Дата1", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("Дата2", Дата);
		Запрос.УстановитьПараметр("ПустаяДата", '00010101');
		Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказовКлиентов.Закрыт);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		КурсВал = смартASP_ОбщийМодуль.СреднийКурсЗаМесяц(Дата);
		Для Каждого стр Из ТЗ Цикл
			стр.Выручка = стр.Выручка * КурсВал
		КонецЦикла;
	
		Структура = Новый Структура;
		Структура.Вставить("Выручка", ТЗ.Итог("Выручка"));
		
		Если ТолькоСуммаВыручки Тогда
			Возврат Структура;
		КонецЕсли;
		
		Структура.Вставить("ВыручкаПоПодразделениямТЗ", ТЗ);
		
		Возврат Структура;  
		
	Иначе 
		
		Сообщить("Не найден документ установки параметров");
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Процедура ASP_УстановитьОтборСКД(ИмяПоля, ВидОтбора, Значение, Настройки) Экспорт
	ПолеОтбора = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого Стр Из Настройки.Отбор.Элементы Цикл
		Если Стр.ЛевоеЗначение = ПолеОтбора И Стр.ВидСравнения = ВидОтбора Тогда
			Отбор = Стр;
		КонецЕсли;
	КонецЦикла;
	Если Отбор = Неопределено Тогда
		Отбор = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Отбор.ЛевоеЗначение  = ПолеОтбора;
	КонецЕсли;
	
	Если Значение <> Неопределено Тогда
		Отбор.ВидСравнения   = ВидОтбора;
		Отбор.Использование  = Истина;
		Отбор.ПравоеЗначение  = Значение;
	Иначе
		Отбор.Использование  = Ложь;
	КонецЕсли;
	
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Процедура ASP_УстановитьПараметрСКД(ИмяПоля, Значение, Настройки)
	НовыйПараметр = Новый ПараметрКомпоновкиДанных(ИмяПоля);
	Для Каждого Стр Из Настройки.ПараметрыДанных.Элементы Цикл
		Если Стр.Параметр = НовыйПараметр Тогда
			Параметр = Стр;
		КонецЕсли;
	КонецЦикла;
	Если Параметр = Неопределено Тогда
		Параметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		Параметр.Параметр  = НовыйПараметр;
	КонецЕсли;
	
	Если Значение <> Неопределено Тогда
		Параметр.Использование  = Истина;
		Параметр.Значение  = Значение;
	Иначе
		Параметр.Использование  = Ложь;
	КонецЕсли;
	
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Функция СреднийКурсЗаМесяц(Дата, Валюта=Неопределено) Экспорт
	Если Валюта = Неопределено Тогда
		Валюта = Константы.ВалютаУправленческогоУчета.Получить()
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПроизводственныеКалендари.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ПроизводственныеКалендари КАК ПроизводственныеКалендари
	                      |ГДЕ
	                      |	НЕ ПроизводственныеКалендари.ПометкаУдаления");
	
	тзКалендари = Запрос.Выполнить().Выгрузить();
	
	Если тзКалендари.Количество() = 0 Тогда
		Сообщить("Данные по среднему курсу валюты могут быть некорректные, т.к. не найден ни один производственный календарь !!!");
		Возврат 1
	ИначеЕсли тзКалендари.Количество() > 1 Тогда
		Сообщить("Данные по среднему курсу валюты могут быть некорректные, т.к. не найдено несколько производственных календарей !!!");
	КонецЕсли;
	
	///////////////////
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
	///////////////////
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата КАК Дата
		|ПОМЕСТИТЬ врДаты
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &Календарь
		|	И ДанныеПроизводственногоКалендаря.ВидДня В(&ВидДня)
		|	И ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &Дата1 И &Дата2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	врДаты.Дата КАК Дата
		|ИЗ
		|	врДаты КАК врДаты";
	
	ВидДня = Новый Массив;
	ВидДня.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	ВидДня.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	Запрос.УстановитьПараметр("ВидДня", ВидДня);
	Запрос.УстановитьПараметр("Дата1", НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("Дата2", КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Календарь", тзКалендари[0].Ссылка);
	
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Сообщить("Данные по среднему курсу валюты могут быть некорректные, т.к. не заполнен производственный календарь !!!");
		Возврат 1
	КонецЕсли;
		
	///////////////////
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КурсыВалют.Период КАК Дата,
		|	КурсыВалют.Курс КАК Курс
		|ПОМЕСТИТЬ врВалюта
		|ИЗ
		|	РегистрСведений.КурсыВалют КАК КурсыВалют
		|ГДЕ
		|	КурсыВалют.Валюта = &Валюта
		|	И КурсыВалют.Период МЕЖДУ &Дата1 И &Дата2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	врВалюта.Дата КАК Дата,
		|	врВалюта.Курс КАК Курс
		|ИЗ
		|	врВалюта КАК врВалюта";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Сообщить("Данные по среднему курсу валюты могут быть некорректные, т.к. нет данных по курсу валюты за период !!!");
		Возврат 1
	КонецЕсли;
	
	///////////////////
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	врДаты.Дата КАК Дата,
		|	врВалюта.Курс КАК Курс
		|ИЗ
		|	врДаты КАК врДаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ врВалюта КАК врВалюта
		|		ПО врДаты.Дата = врВалюта.Дата";
	
	
	тз = Запрос.Выполнить().Выгрузить();
	
	Если тз.Количество() = 0 Тогда
		Сообщить("Данные по среднему курсу валюты могут быть некорректные, т.к. не согласованы данные производственного календаря и курсы валют !!!");
		Возврат 1
	КонецЕсли;
	
	Возврат тз.Итог("Курс") / тз.Количество()
КонецФункции

