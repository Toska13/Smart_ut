
#Область ПрограммныйИнтерфейс

// Получает данные расчета заполнености.
//
// Параметры:
//  КлючЗначение  - КлючИЗначение - ключ и значение.
//  ДанныеРасчета - Соответствие - данные расчета заполнености.
// 
// Возвращаемое значение:
//  Соответствие - данные расчета заполнености.
//
Процедура ДополнитьДанныеРасчетаЗаполнености(КлючЗначение, ДанныеРасчета) Экспорт

	Если КлючЗначение.Ключ <> "Справочник.Партнеры" И КлючЗначение.Ключ <> "Справочник.КонтактныеЛицаПартнеров" Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКонтроля = CRM_КонтрольЗаполненностиРеквизитовОбъектовПовтИсп.ПараметрыКонтроляЗаполненностиРеквизитов();
	ДопСоответствиеОбъектов = Новый Соответствие;
	Для каждого ОписаниеОбъектаРасчета Из ДанныеРасчета Цикл
		Если КлючЗначение.Ключ = "Справочник.Партнеры" Тогда
			
			Ключ = "Справочник.КонтактныеЛицаПартнеров";
			ПараметрыКонтроляОбъекта = ПараметрыКонтроля.ПараметрыКонтроляРеквизитов.Получить(Ключ);
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
			                      |ГДЕ
			                      |	КонтактныеЛицаПартнеров.Владелец = &Партнер
			                      |	И НЕ КонтактныеЛицаПартнеров.ПометкаУдаления");
			Запрос.УстановитьПараметр("Партнер", ОписаниеОбъектаРасчета.Ключ);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				ДанныеРасчетаКонтакт = CRM_КонтрольЗаполненностиРеквизитовОбъектов.ПолучитьДанныеРасчетаЗаполнености(Новый Структура("Ключ, Значение", Ключ, ПараметрыКонтроляОбъекта), Выборка.Ссылка);
				СтруктураРасчетаТемп = ДанныеРасчетаКонтакт.Получить(Выборка.Ссылка);
				Если СтруктураРасчетаТемп <> Неопределено Тогда
					ОписаниеОбъектаРасчета.Значение.ВсегоРеквизитов = ОписаниеОбъектаРасчета.Значение.ВсегоРеквизитов + СтруктураРасчетаТемп.ВсегоРеквизитов;
					ОписаниеОбъектаРасчета.Значение.ЗаполненоРеквизитов = ОписаниеОбъектаРасчета.Значение.ЗаполненоРеквизитов + СтруктураРасчетаТемп.ЗаполненоРеквизитов;
				КонецЕсли;
			КонецЦикла;
			Если ОписаниеОбъектаРасчета.Значение.ВсегоРеквизитов = 0 Тогда
				ОписаниеОбъектаРасчета.Значение.ПроцентЗаполненностиОбщий = 100;
			Иначе
				ОписаниеОбъектаРасчета.Значение.ПроцентЗаполненностиОбщий = ОписаниеОбъектаРасчета.Значение.ЗаполненоРеквизитов*100/ОписаниеОбъектаРасчета.Значение.ВсегоРеквизитов;
			КонецЕсли;
			
		ИначеЕсли КлючЗначение.Ключ = "Справочник.КонтактныеЛицаПартнеров" Тогда
			
			Если ОписаниеОбъектаРасчета.Ключ.Владелец.ЭтоГруппа Тогда
				Возврат;
			КонецЕсли;
			
			Ключ = "Справочник.Партнеры";
			ПараметрыКонтроляОбъекта = ПараметрыКонтроля.ПараметрыКонтроляРеквизитов.Получить(Ключ);
			ДанныеРасчетаПартнер = CRM_КонтрольЗаполненностиРеквизитовОбъектов.ПолучитьДанныеРасчетаЗаполнености(Новый Структура("Ключ, Значение", Ключ, ПараметрыКонтроляОбъекта), ОписаниеОбъектаРасчета.Ключ.Владелец);
			CRM_КонтрольЗаполненностиРеквизитовОбъектовПереопределяемый.ДополнитьДанныеРасчетаЗаполнености(Новый Структура("Ключ, Значение", Ключ, ПараметрыКонтроляОбъекта), ДанныеРасчетаПартнер);
			ДопСоответствиеОбъектов.Вставить(ОписаниеОбъектаРасчета.Ключ.Владелец, ДанныеРасчетаПартнер.Получить(ОписаниеОбъектаРасчета.Ключ.Владелец));
		КонецЕсли;
	КонецЦикла;
	Для каждого ОписаниеОбъектаРасчета из ДопСоответствиеОбъектов цикл
		ДанныеРасчета.Вставить(ОписаниеОбъектаРасчета.Ключ, ОписаниеОбъектаРасчета.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
