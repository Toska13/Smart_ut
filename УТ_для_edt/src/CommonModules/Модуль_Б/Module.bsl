Процедура ОтразитьДопРасходыНаРеализацииИнтеркампани(Месяц) Экспорт
	   
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПартииРасходовНаСебестоимостьТоваров.Период,
		|	ПартииРасходовНаСебестоимостьТоваров.Регистратор,
		|	ПартииРасходовНаСебестоимостьТоваров.ВидДвижения,
		|	ПартииРасходовНаСебестоимостьТоваров.Организация,
		|	ПартииРасходовНаСебестоимостьТоваров.АналитикаУчетаНоменклатуры,
		|	ПартииРасходовНаСебестоимостьТоваров.ДокументПоступления,
		|	ПартииРасходовНаСебестоимостьТоваров.ВидЗапасов,
		|	ПартииРасходовНаСебестоимостьТоваров.АналитикаУчетаПартий,
		|	ПартииРасходовНаСебестоимостьТоваров.ДокументПоступленияРасходов,
		|	ПартииРасходовНаСебестоимостьТоваров.СтатьяРасходов,
		|	ПартииРасходовНаСебестоимостьТоваров.Количество,
		|	ПартииРасходовНаСебестоимостьТоваров.Стоимость,
		|	ПартииРасходовНаСебестоимостьТоваров.СтоимостьБезНДС,
		|	ПартииРасходовНаСебестоимостьТоваров.СтоимостьРегл,
		|	ПартииРасходовНаСебестоимостьТоваров.НДСРегл,
		|	ПартииРасходовНаСебестоимостьТоваров.НалогообложениеНДС,
		|	ПартииРасходовНаСебестоимостьТоваров.МоментВремени,
		|	ПартииРасходовНаСебестоимостьТоваров.Активность
		|ПОМЕСТИТЬ ПередачиТоваровРасход
		|ИЗ
		|	РегистрНакопления.ПартииРасходовНаСебестоимостьТоваров КАК ПартииРасходовНаСебестоимостьТоваров
		|ГДЕ
		|	ПартииРасходовНаСебестоимостьТоваров.Регистратор ССЫЛКА Документ.ПередачаТоваровМеждуОрганизациями
		|	И ПартииРасходовНаСебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ПартииРасходовНаСебестоимостьТоваров.Период МЕЖДУ &НачалоМесяца И &КонецМесяца
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПартииТоваров.Период,
		|	ПартииТоваров.Регистратор,
		|	ПартииТоваров.ВидДвижения,
		|	ПартииТоваров.Организация,
		|	ПартииТоваров.АналитикаУчетаНоменклатуры,
		|	ПередачиТоваровРасход.ДокументПоступления,
		|	ПартииТоваров.ВидЗапасов,
		|	ПартииТоваров.АналитикаУчетаПартий,
		|	ПередачиТоваровРасход.ДокументПоступленияРасходов,
		|	ПередачиТоваровРасход.СтатьяРасходов КАК СтатьяРасходов,
		|	ПартииТоваров.Количество,
		|	ПередачиТоваровРасход.Стоимость,
		|	ПередачиТоваровРасход.СтоимостьБезНДС,
		|	ПередачиТоваровРасход.СтоимостьРегл,
		|	ПередачиТоваровРасход.НДСРегл,
		|	ПередачиТоваровРасход.НалогообложениеНДС КАК НалогообложениеНДС,
		|	ПередачиТоваровРасход.МоментВремени,
		|	ПартииТоваров.Активность
		|ИЗ
		|	ПередачиТоваровРасход КАК ПередачиТоваровРасход
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровОрганизаций КАК ПартииТоваров
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
		|			ПО (ТоварыОрганизаций.Регистратор = ПартииТоваров.Регистратор)
		|				И (ТоварыОрганизаций.АналитикаУчетаНоменклатуры = ПартииТоваров.АналитикаУчетаНоменклатуры)
		|				И (ТоварыОрганизаций.ВидЗапасов = ПартииТоваров.ВидЗапасов)
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотреблениеТоваров КАК Документ
		|			ПО (Документ.Ссылка = ПартииТоваров.Регистратор)
		|		ПО ПередачиТоваровРасход.Регистратор = ПартииТоваров.ДокументПоступления
		|			И ПередачиТоваровРасход.АналитикаУчетаНоменклатуры = ПартииТоваров.АналитикаУчетаНоменклатуры
		|ГДЕ
		|	ПартииТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ПартииТоваров.Период МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ПартииТоваров.ВидЗапасов.ТипЗапасов <> ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
		|	И ПартииТоваров.Регистратор ССЫЛКА Документ.ПередачаТоваровМеждуОрганизациями
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПартииТоваров.Период,
		|	ПартииТоваров.Регистратор,
		|	ПартииТоваров.ВидДвижения,
		|	ПартииТоваров.Организация,
		|	ПартииТоваров.АналитикаУчетаНоменклатуры,
		|	ПередачиТоваровРасход.ДокументПоступления,
		|	ПартииТоваров.ВидЗапасов,
		|	ПартииТоваров.АналитикаУчетаПартий,
		|	ПередачиТоваровРасход.ДокументПоступленияРасходов,
		|	ПередачиТоваровРасход.СтатьяРасходов,
		|	ПартииТоваров.Количество,
		|	ПередачиТоваровРасход.Стоимость,
		|	ПередачиТоваровРасход.СтоимостьБезНДС,
		|	ПередачиТоваровРасход.СтоимостьРегл,
		|	ПередачиТоваровРасход.НДСРегл,
		|	ПередачиТоваровРасход.НалогообложениеНДС,
		|	НЕОПРЕДЕЛЕНО,
		|	ПартииТоваров.Активность
		|ИЗ
		|	ПередачиТоваровРасход КАК ПередачиТоваровРасход
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровОрганизаций КАК ПартииТоваров
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизаций КАК ТоварыОрганизаций
		|			ПО (ТоварыОрганизаций.Регистратор = ПартииТоваров.Регистратор)
		|				И (ТоварыОрганизаций.АналитикаУчетаНоменклатуры = ПартииТоваров.АналитикаУчетаНоменклатуры)
		|				И (ТоварыОрганизаций.ВидЗапасов = ПартииТоваров.ВидЗапасов)
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВнутреннееПотреблениеТоваров КАК Документ
		|			ПО (Документ.Ссылка = ПартииТоваров.Регистратор)
		|		ПО ПередачиТоваровРасход.Регистратор = ПартииТоваров.ДокументПоступления
		|			И ПередачиТоваровРасход.АналитикаУчетаНоменклатуры = ПартииТоваров.АналитикаУчетаНоменклатуры
		|ГДЕ
		|	ПартииТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
		|	И ПартииТоваров.Период МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ПартииТоваров.ВидЗапасов.ТипЗапасов <> ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
		|	И ПартииТоваров.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг";

	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Месяц));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Месяц));
	//Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	ТаблицаДопРасходов = Результат.Выгрузить();
	
	НачатьТранзакцию();
	НаборЗаписей = РегистрыНакопления.ПартииРасходовНаСебестоимостьТоваров.СоздатьНаборЗаписей();
	
	Для каждого НоваяЗапись ИЗ ТаблицаДопРасходов Цикл
		
		НаборЗаписей.Отбор.Регистратор.Установить(НоваяЗапись.Регистратор);
		НаборЗаписей.Прочитать();
        
		ТаблицаНабораЗаписей = НаборЗаписей.Выгрузить();
		НаборЗаписейДляПроверки = НаборЗаписей.Выгрузить();
		НаборЗаписейДляПроверки.Колонки.Удалить("НомерСтроки");
		НаборЗаписейДляПроверки.Колонки.Удалить("МоментВремени");
		
		Отбор = НоваяЗапись;
		
		ЗаписыватьДвижение = Истина;
		Для каждого Запись Из НаборЗаписейДляПроверки Цикл
			Если Запись.Активность = Отбор.Активность И Запись.АналитикаУчетаНоменклатуры = Отбор.АналитикаУчетаНоменклатуры И
				Запись.АналитикаУчетаПартий = Отбор.АналитикаУчетаПартий И Запись.ВидДвижения = Отбор.ВидДвижения
				И Запись.ВидЗапасов = Отбор.ВидЗапасов И Запись.ДокументПоступления = Отбор.ДокументПоступления И
				Запись.ДокументПоступленияРасходов = Отбор.ДокументПоступленияРасходов И Запись.Количество = Отбор.Количество И
				Запись.НДСРегл = Отбор.НДСРегл И Запись.НалогообложениеНДС = Отбор.НалогообложениеНДС И
				Запись.Организация = Отбор.Организация И Запись.Период = Отбор.Период И
				Запись.Регистратор = Отбор.Регистратор И Запись.СтатьяРасходов = Отбор.СтатьяРасходов И
				Запись.Стоимость = Отбор.Стоимость И Запись.СтоимостьБезНДС = Отбор.СтоимостьБезНДС И
				Запись.СтоимостьРегл = Отбор.СтоимостьРегл	Тогда
				
				ЗаписыватьДвижение = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
		Если Не ЗаписыватьДвижение Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись.МоментВремени = Новый МоментВремени(НоваяЗапись.Период, НоваяЗапись.Регистратор);
		
		Движение = ТаблицаНабораЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Движение,НоваяЗапись);
		
		НаборЗаписей.Загрузить(ТаблицаНабораЗаписей);
		НаборЗаписей.Записывать = Истина;
		НаборЗаписей.Записать(Истина);
	    НаборЗаписей.Очистить();
		ТаблицаНабораЗаписей.Очистить();
		НаборЗаписейДляПроверки.Очистить();
		
	КонецЦикла;
	
    ЗафиксироватьТранзакцию();
     		   
КонецПроцедуры


