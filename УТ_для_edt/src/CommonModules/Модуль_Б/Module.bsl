Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено, Документ)

	Документ.Менеджер = Пользователи.ТекущийПользователь();
	Документ.Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Документ.Организация);
	Документ.Склад = ЗначениеНастроекПовтИсп.ПолучитьСкладПоУмолчанию(Документ.Склад);
	Документ.БанковскийСчетОрганизации = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Документ.Организация, , Документ.БанковскийСчетОрганизации);
	Документ.БанковскийСчетОрганизацииПолучателя = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(Документ.ОрганизацияПолучатель, , Документ.БанковскийСчетОрганизацииПолучателя);
	Документ.Подразделение = ЗначениеНастроекПовтИсп.ПодразделениеПользователя(Пользователи.ТекущийПользователь(), Документ.Подразделение);
	Документ.Дата = НачалоДня(ДанныеЗаполнения.КонецПериода);
	Документ.ДатаПлатежа = Документ.Дата;
	//Документ.КонецПериода = 
	//Если Не ЗначениеЗаполнено(Документ.ВидЦены) Тогда
	//	Документ.ВидЦены = Справочники.ВидыЦен.ВидЦеныПоУмолчанию(Истина, Документ.ВидЦены);
	//	Если ЗначениеЗаполнено(Документ.ВидЦены) Тогда
	//		Реквизиты = Справочники.ВидыЦен.ПолучитьРеквизитыВидаЦены(Документ.ВидЦены);
	//		Документ.Валюта = Реквизиты.ВалютаЦены;
	//		Документ.ЦенаВключаетНДС = Реквизиты.ЦенаВключаетНДС;
	//	Иначе
			
	Если (ТипЗнч(ДанныеЗаполнения) <> Тип("Структура") Или НЕ ДанныеЗаполнения.Свойство("Валюта")) 
		И НЕ ДанныеЗаполнения.Свойство("ОбработатьОткрытыйДокумент") Тогда
				Документ.Валюта    = ДоходыИРасходыСервер.ПолучитьВалютуРегламентированногоУчета(Документ.Валюта);
			Иначе
			    Документ.Валюта = Справочники.Валюты.НайтиПоНаименованию("EUR");
			КонецЕсли;
			
		//КонецЕсли;
		Документ.ВалютаВзаиморасчетов = Документ.Валюта;
	//КонецЕсли;
	
	ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Документ.Валюта, Документ.НалогообложениеНДС);
	Документ.ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.ПолучитьГруппуФинансовогоУчетаПоУмолчанию(ПорядокОплаты);
	
