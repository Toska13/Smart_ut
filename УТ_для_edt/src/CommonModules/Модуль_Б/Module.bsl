Процедура ЗаполнитьТЗТовары(ТЗТовары, ДанныеЗаполнения,Партии)
	
	ВыборкаОрганизацийПолучателей = Партии.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ОрганизацияПолучатель");
	//Если ВыборкаОрганизацийПолучателей.Количество() = 0 Тогда
		
		 Пока ВыборкаОрганизацийПолучателей.Следующий() Цикл

	     Если ДанныеЗаполнения.ОрганизацияПолучатель <> ВыборкаОрганизацийПолучателей.ОрганизацияПолучатель Тогда
					 Продолжить;
				 КонецЕсли;
	
		ВыборкаОрганизаций = ВыборкаОрганизацийПолучателей.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Организация");
		
			 Пока ВыборкаОрганизаций.Следующий() Цикл
				 
				 Если ДанныеЗаполнения.Организация <> ВыборкаОрганизаций.Организация Тогда
					 Продолжить;
				 КонецЕсли;
				 
				 ВыборкаТоваров = ВыборкаОрганизаций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Номенклатура");
				 
				 Пока ВыборкаТоваров.Следующий() Цикл
					 
					 ВыборкаТоваровПоХарактеристикам = ВыборкаТоваров.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Характеристика"); 
					 
					 Пока ВыборкаТоваровПоХарактеристикам.Следующий() Цикл
						 
						 Если ВыборкаТоваровПоХарактеристикам.КоличествоОстаток < ВыборкаТоваровПоХарактеристикам.КоличествоКПередаче Тогда
							 Сообщить("Не хватает товара " + ВыборкаТоваровПоХарактеристикам.Номенклатура + "! В Количестве " 
							 + (ВыборкаТоваровПоХарактеристикам.КоличествоКПередаче - ВыборкаТоваровПоХарактеристикам.КоличествоОстаток) + 
							 ".");
							 Продолжить;
						 КонецЕсли;
						 
						// НехваткаТовара = 0;
						 КоличествоКПередаче = ВыборкаТоваровПоХарактеристикам.КоличествоКПередаче;
						 КоличествоВПартии = КоличествоКПередаче;
						 СтрокаТовар = ВыборкаТоваровПоХарактеристикам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
						 
						 Пока СтрокаТовар.Следующий() Цикл
							 
							 Сч=0;
							 СуммаЦен = 0;
							 Если СтрокаТовар.КоличествоОстаток < КоличествоКПередаче Тогда   
								 КоличествоКПередаче  = КоличествоКПередаче - СтрокаТовар.КоличествоОстаток;
								 //КоличествоВПартии = СтрокаТовар.КоличествоОстаток;
								 СуммаЦен = СуммаЦен+СтрокаТовар.Цена;
								 Сч = Сч+1;
								 Продолжить;
							 Иначе
								 Сч = Сч+1;
								// КоличествоВПартии = КоличествоКПередаче;
								 СуммаЦен = СуммаЦен+СтрокаТовар.Цена;
								 //Цена = СтрокаТовар.Цена;
								 КоличествоКПередаче = 0;
							 КонецЕсли;
							 
							 НоваяСтрока = ТЗТовары.Добавить();
							 НоваяСтрока.Номенклатура =  СтрокаТовар.Номенклатура;
							 НоваяСтрока.Характеристика =  СтрокаТовар.Характеристика;
							 НоваяСтрока.Количество =  КоличествоВПартии;
							 //Если СтрокаТовар.Валюта = Справочники.Валюты.НайтиПоНаименованию("EUR") Тогда
							 Если СуммаЦен = 0 Тогда
								  НоваяСтрока.Цена = 0;
							 Иначе
								  НоваяСтрока.Цена =  СуммаЦен/Сч;//СтрокаТовар.Цена;
							 КонецЕсли;	  
						   //  Иначе
						   // 	 Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(Справочники.Валюты.НайтиПоНаименованию("EUR"), СтрокаТовар.Валюта, ТекущаяДата());
						   //	  НоваяСтрока.Цена = ?(Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов <> 0, СтрокаТовар.Цена / Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов, 0);
						   //КонецЕсли;
						     НоваяСтрока.ВидЗапасов = СтрокаТовар.ВидЗапасов;
							 НоваяСтрока.ВидЗапасовПолучателя = СтрокаТовар.ВидЗапасовПолучателя;
							 НоваяСтрока.НомерГТД = СтрокаТовар.НомерГТД;
							 
							
							 Если КоличествоКПередаче = 0 Тогда
								 Прервать;
							 КонецЕсли;
							 
				 	 	КонецЦикла;
				 	 КонецЦикла;
	             КонецЦикла;
			 КонецЦикла;
		КонецЦикла;	 
	КонецПроцедуры	
	
