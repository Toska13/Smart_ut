

//Процедуры автоматического формирования документов передачи товаров 
//между организациями. Товары передаются по закупочным ценам + доп. расходы.

Процедура ПередатьТоварыВДругуюОрганизацию(ДанныеЗаполнения = Неопределено, Документ = Неопределено) Экспорт
	
	//ПартионныйУчетСервер.ВыполнитьРегламентноеФормированиеДвиженийПоПартиямТоваров();

	//Распоряжения = ЖурналыДокументов.ПередачиВозвратыТоваровМеждуОрганизациями.ПолучитьФорму(;
	ДатаНачала = ?(ДанныеЗаполнения = Неопределено,Дата(1,1,1), ДанныеЗаполнения.НачалоПериода);
	ДатаОкончания = ?(ДанныеЗаполнения = Неопределено,НачалоЧаса(ТекущаяДата()), КонецДня(ДанныеЗаполнения.КонецПериода));
	Граница = Новый Граница(ДатаОкончания, ВидГраницы.Включая);
	
		
	Партии = СформироватьЗапросПоПартиям(Граница);
		
	ТЗТовары = Новый ТаблицаЗначений;
	ТЗТовары.Колонки.Добавить("Номенклатура");
	ТЗТовары.Колонки.Добавить("Характеристика");
	ТЗТовары.Колонки.Добавить("ВидЗапасов");
	ТЗТовары.Колонки.Добавить("ВидЗапасовПолучателя");
	ТЗТовары.Колонки.Добавить("НомерГТД");
	ТЗТовары.Колонки.Добавить("Количество");
	ТЗТовары.Колонки.Добавить("Цена");
    ТЗТовары.Колонки.Добавить("Валюта");
	
	Если ДанныеЗаполнения <> Неопределено И ДанныеЗаполнения.Свойство("ОбработатьОткрытыйДокумент") Тогда 
		ЗаполнитьТЗТовары(ТЗТовары, ДанныеЗаполнения,Партии);
		Документ.ЦенаВключаетНДС = Истина;
		//Документ.ДатаПлатежа = ДатаОкончания;
		//ТЗТовары.Свернуть("Номенклатура, Характеристика, ВидЗапасов, ВидЗапасовПолучателя, НомерГТД, Валюта", "Цена, Количество");   
		ДанныеЗаполнения.Вставить("Товары", ТЗТовары);
		ЗаполнитьДокументПоПартиямКПередаче(ДанныеЗаполнения, Документ);
		Возврат;
	КонецЕсли;
	
	Распоряжения = СформироватьЗапросПоРаспоряжениям(Граница);
	
	//Распоряжения = ЗапросПоРаспоряжениям.Выполнить();
	
	Если Распоряжения.Пустой() Тогда 
		Возврат;
	КонецЕсли;
			
	РаспоряженияНаПередачуТоваров = Распоряжения.Выбрать();

	
	Пока РаспоряженияНаПередачуТоваров.Следующий() Цикл
		
		 ТЗТовары.Очистить();
		 Если  РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация <> ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию")
			Тогда
			Продолжить;
		 КонецЕсли;
		 ДанныеЗаполнения.Вставить("Организация", РаспоряженияНаПередачуТоваров.Отправитель);
		 ДанныеЗаполнения.Вставить("ОрганизацияПолучатель", РаспоряженияНаПередачуТоваров.Получатель);
		 ЗаполнитьТЗТовары(ТЗТовары, ДанныеЗаполнения,Партии);
		
		 
	
	
	//Для Каждого Строка Из Распоряжения Цикл
	//Строка = Элементы.КОформлению.ТекущиеДанные;
		//Если Строка <> Неопределено Тогда
			СтруктураОснование = Новый Структура("
				|Организация,
				|ОрганизацияПолучатель,
				|Склад,
				|ПередачаПодДеятельность,
				|ТипЗапасов,
				|НачалоПериода,
				|КонецПериода,
				|ЗаполнятьПоСхеме,
				|ХозяйственнаяОперация,
				|Товары",
				РаспоряженияНаПередачуТоваров.Отправитель,
				РаспоряженияНаПередачуТоваров.Получатель,
				РаспоряженияНаПередачуТоваров.Склад,
				РаспоряженияНаПередачуТоваров.ПередачаПодДеятельность,
				РаспоряженияНаПередачуТоваров.ТипЗапасов,
				ДатаНачала,
				ДатаОкончания, 
				Истина,
				РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация,
				ТЗТовары
			);
			СтруктураПараметры = Новый Структура("Основание", СтруктураОснование);
			//
			//Если РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссиюВДругуюОрганизацию")
			//	Или РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию")
			//Тогда
			   СформироватьПередачуТоваров(СтруктураПараметры);
			//ИначеЕсли РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратТоваровМеждуОрганизациями")
			//	Или РаспоряженияНаПередачуТоваров.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ВозвратПоКомиссииМеждуОрганизациями")
			//Тогда
			//	СформироватьВозвратТоваров();
			//КонецЕсли;
		//КонецЕсли;
		//Прервать;
	КонецЦикла;
КонецПроцедуры

Процедура СформироватьПередачуТоваров(ДанныеЗаполнения)

	ДокументПередачи = Документы.ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();
	//Форма = ДокументПередачи.ПолучитьФорму("ФормаДокумента");
	//Форма.Открыть();

	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
	   И ДанныеЗаполнения.Основание.Свойство("ЗаполнятьПоСхеме") Тогда
	   
		ДокументПередачи.Организация = ДанныеЗаполнения.Основание.Организация;
		ДокументПередачи.ОрганизацияПолучатель = ДанныеЗаполнения.Основание.ОрганизацияПолучатель;
		ДокументПередачи.Склад = ДанныеЗаполнения.Основание.Склад;
		ДокументПередачи.ПоТоварамКОформлению = Истина;
		ДокументПередачи.Дата = НачалоДня(ДанныеЗаполнения.Основание.КонецПериода);
		ДокументПередачи.ЦенаВключаетНДС = Истина;
		//ДокументПередачи.ДатаПлатежа = ДокументПередачи.Дата;
		ДокументПередачи.Валюта = Справочники.Валюты.НайтиПоНаименованию("EUR");
		ДокументПередачи.КонецПериода =  ДокументПередачи.Дата;
		//Если ДанныеЗаполнения.ТипЗапасов = Перечисления.ТипыЗапасов.КомиссионныйТовар Тогда
		//	ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссиюВДругуюОрганизацию;
		//Иначе
			ДокументПередачи.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию;
		//КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Основание.ПередачаПодДеятельность) Тогда
			ДокументПередачи.ПередачаПодДеятельность = ДанныеЗаполнения.Основание.ПередачаПодДеятельность;
		КонецЕсли;
		
		ЗаполнитьДокументПоПартиямКПередаче(ДанныеЗаполнения.Основание, ДокументПередачи);
		
	//ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
	// И ДанныеЗаполнения.Свойство("ЗаполнятьПоОтрицательнымОстаткам") Тогда
	// 
	//	Организация = ДанныеЗаполнения.Организация;
	//	ОрганизацияПолучатель = ДанныеЗаполнения.ОрганизацияПолучатель;
	//	Склад = ДанныеЗаполнения.Склад;
	//	Дата = ДанныеЗаполнения.Дата;
	//	
	//	ЗаполнитьПоОтрицательнымОстаткамТоваровОрганизаций(ДанныеЗаполнения
	//	);
		
	//ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда	
	//	ЗаполнитьПоПеремещениюТоваров(
	//		ДанныеЗаполнения,
	//		ДанныеЗаполнения
	//	);
	КонецЕсли;
	
	//ИнициализироватьДокумент(ДанныеЗаполнения, ДокументПередачи);
	//ДокументПередачи.ДополнительныеСвойства.Вставить("НеобходимостьЗаполненияСчетаПриФОИспользоватьНесколькоСчетовЛожь", Ложь);
	ДокументПередачи.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Функция СформироватьЗапросПоРаспоряжениям(Граница)
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	ВЫБОР
	                              |		КОГДА ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
	                              |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПередачаНаКомиссиюВДругуюОрганизацию)
	                              |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию)
	                              |	КОНЕЦ КАК ХозяйственнаяОперация,
	                              |	НаДату.ВидЗапасовПродавца.НалогообложениеНДС КАК ПередачаПодДеятельность,
	                              |	НаДату.Склад,
	                              |	НаДату.ОрганизацияВладелец КАК Отправитель,
	                              |	ВидЗапасов.Организация КАК Получатель,
	                              |	ВидЗапасов.ТипЗапасов КАК ТипЗапасов
	                              |ИЗ
	                              |	РегистрНакопления.ТоварыОрганизацийКПередаче.Остатки(&Граница, ) КАК НаДату
	                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидЗапасов
	                              |		ПО НаДату.ВидЗапасовПродавца = ВидЗапасов.Ссылка
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизацийКПередаче.Остатки(, ) КАК НаСейчас
	                              |		ПО НаДату.Номенклатура = НаСейчас.Номенклатура
	                              |			И НаДату.Характеристика = НаСейчас.Характеристика
	                              |			И НаДату.НомерГТД = НаСейчас.НомерГТД
	                              |			И НаДату.ВидЗапасовПродавца = НаСейчас.ВидЗапасовПродавца
	                              |			И НаДату.ОрганизацияВладелец = НаСейчас.ОрганизацияВладелец
	                              |			И НаДату.Склад = НаСейчас.Склад
	                              |ГДЕ
	                              |	ЕСТЬNULL(НаСейчас.КоличествоОстаток, 0) > 0
	                              |
	                              |ОБЪЕДИНИТЬ ВСЕ
	                              |
	                              |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	ВЫБОР
	                              |		КОГДА ВидыЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.КомиссионныйТовар)
	                              |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратПоКомиссииМеждуОрганизациями)
	                              |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ВозвратТоваровМеждуОрганизациями)
	                              |	КОНЕЦ,
	                              |	НаДату.ВидЗапасовПродавца.НалогообложениеНДС,
	                              |	НаДату.Склад,
	                              |	ВидыЗапасов.Организация,
	                              |	НаДату.ОрганизацияВладелец,
	                              |	ВидыЗапасов.ТипЗапасов
	                              |ИЗ
	                              |	РегистрНакопления.ТоварыОрганизацийКПередаче.Остатки(&Граница, ) КАК НаДату
	                              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЗапасов КАК ВидыЗапасов
	                              |		ПО НаДату.ВидЗапасовПродавца = ВидыЗапасов.Ссылка
	                              |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизацийКПередаче.Остатки(, ) КАК НаСейчас
	                              |		ПО НаДату.Номенклатура = НаСейчас.Номенклатура
	                              |			И НаДату.Характеристика = НаСейчас.Характеристика
	                              |			И НаДату.НомерГТД = НаСейчас.НомерГТД
	                              |			И НаДату.ВидЗапасовПродавца = НаСейчас.ВидЗапасовПродавца
	                              |			И НаДату.ОрганизацияВладелец = НаСейчас.ОрганизацияВладелец
	                              |			И НаДату.Склад = НаСейчас.Склад
	                              |ГДЕ
	                              |	ЕСТЬNULL(НаСейчас.ВозвращеноОстаток, 0) > 0";
	
	Запрос.УстановитьПараметр("Граница", Граница);
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция СформироватьЗапросПоПартиям(Граница)
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыОрганизацийКПередачеОстатки.Номенклатура КАК Номенклатура,
	               |	ТоварыОрганизацийКПередачеОстатки.Характеристика,
	               |	ТоварыОрганизацийКПередачеОстатки.ВидЗапасовПродавца.ВидЗапасовВладельца КАК ВидЗапасов,
	               |	ТоварыОрганизацийКПередачеОстатки.ВидЗапасовПродавца КАК ВидЗапасовПолучателя,
	               |	ТоварыОрганизацийКПередачеОстатки.НомерГТД КАК НомерГТД,
	               |	ТоварыОрганизацийКПередачеОстатки.КоличествоОстаток,
	               |	ТоварыОрганизацийКПередачеОстатки.ОрганизацияВладелец,
	               |	ТоварыОрганизацийКПередачеОстатки.ВидЗапасовПродавца.Организация КАК ОрганизацияПолучатель
	               |ПОМЕСТИТЬ ТоварыКПередаче
	               |ИЗ
	               |	РегистрНакопления.ТоварыОрганизацийКПередаче.Остатки(&Граница, ) КАК ТоварыОрганизацийКПередачеОстатки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПоследовательностьПартииТоваровОрганизаций.Регистратор,
	               |	ПоследовательностьПартииТоваровОрганизаций.Период КАК Период,
	               |	ПоследовательностьПартииТоваровОрганизаций.Номенклатура КАК Номенклатура,
	               |	ПоследовательностьПартииТоваровОрганизаций.Характеристика,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.СтоимостьОстаток, 0) КАК СтоимостьОстаток,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.СтоимостьБезНДСОстаток, 0) КАК СтоимостьБезНДСОстаток,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.СтоимостьРеглОстаток, 0) КАК СтоимостьРеглОстаток,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.НДСРеглОстаток, 0) КАК НДСРеглОстаток,
	               |	ЕСТЬNULL(ТоварыКПередаче.КоличествоОстаток, 0) КАК КоличествоКПередаче,
	               |	ТоварыКПередаче.ОрганизацияВладелец,
	               |	ТоварыКПередаче.ОрганизацияПолучатель,
	               |	ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.СтоимостьОстаток, 0) / ЕСТЬNULL(ПартииТоваровОрганизацийОстатки.КоличествоОстаток, 0) КАК ЦенаПартии,
	               |	ТоварыКПередаче.ВидЗапасов,
	               |	ТоварыКПередаче.ВидЗапасовПолучателя,
	               |	ТоварыКПередаче.НомерГТД
	               |ПОМЕСТИТЬ ПартииКПередаче
	               |ИЗ
	               |	ТоварыКПередаче КАК ТоварыКПередаче
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваровОрганизаций.Остатки(
	               |				&Граница,
	               |				(АналитикаУчетаНоменклатуры.Номенклатура, АналитикаУчетаНоменклатуры.Характеристика) В
	               |					(ВЫБРАТЬ
	               |						ТоварыКПередаче.Номенклатура,
	               |						ТоварыКПередаче.Характеристика
	               |					ИЗ
	               |						ТоварыКПередаче)) КАК ПартииТоваровОрганизацийОстатки
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Последовательность.ПартииТоваровОрганизаций КАК ПоследовательностьПартииТоваровОрганизаций
	               |			ПО (ПоследовательностьПартииТоваровОрганизаций.Регистратор.Организация = ПартииТоваровОрганизацийОстатки.Организация)
	               |				И (ПоследовательностьПартииТоваровОрганизаций.Номенклатура = ПартииТоваровОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура)
	               |				И (ПоследовательностьПартииТоваровОрганизаций.Регистратор = ПартииТоваровОрганизацийОстатки.ДокументПоступления)
