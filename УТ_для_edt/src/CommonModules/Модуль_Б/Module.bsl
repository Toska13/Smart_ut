Процедура СкорректироватьСтоимостьРеглСебестоимовтиТоваров() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СебестоимостьТоваров.Период,
		|	СебестоимостьТоваров.Регистратор,
		|	СебестоимостьТоваров.НомерСтроки,
		|	СебестоимостьТоваров.Активность,
		|	СебестоимостьТоваров.ВидДвижения,
		|	СебестоимостьТоваров.АналитикаУчетаНоменклатуры,
		|	СебестоимостьТоваров.РазделУчета,
		|	СебестоимостьТоваров.ВидЗапасов,
		|	СебестоимостьТоваров.Организация,
		|	СебестоимостьТоваров.Количество,
		|	СебестоимостьТоваров.Стоимость,
		|	СебестоимостьТоваров.СтоимостьБезНДС,
		|	СебестоимостьТоваров.СуммаДопРасходов,
		|	СебестоимостьТоваров.СуммаДопРасходовБезНДС,
		|	СебестоимостьТоваров.ХозяйственнаяОперация,
		|	СебестоимостьТоваров.КорАналитикаУчетаНоменклатуры,
		|	СебестоимостьТоваров.КорРазделУчета,
		|	СебестоимостьТоваров.КорВидЗапасов,
		|	СебестоимостьТоваров.КорОрганизация,
		|	СебестоимостьТоваров.КорСтоимость,
		|	СебестоимостьТоваров.АналитикаУчетаПоПартнерам,
		|	СебестоимостьТоваров.ЗаказКлиента,
		|	СебестоимостьТоваров.Подразделение,
		|	СебестоимостьТоваров.АналитикаРасходов,
		|	СебестоимостьТоваров.СтатьяРасходовСписания,
		|	СебестоимостьТоваров.СтатьяДоходов,
		|	СебестоимостьТоваров.АналитикаДоходов,
		|	СебестоимостьТоваров.ПериодПродажи,
		|	//ВЫБОР
		|	//	КОГДА СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	//		ТОГДА 
		|   ПартииТоваровОрганизаций.СтоимостьРегл
		|		//ИНАЧЕ СебестоимостьТоваров.СтоимостьРегл
		|	//КОНЕЦ КАК СтоимостьРегл
		|ИЗ
		|	РегистрНакопления.ПартииТоваровОрганизаций КАК ПартииТоваровОрганизаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
		|		ПО ПартииТоваровОрганизаций.Регистратор = СебестоимостьТоваров.Регистратор
		|			И ПартииТоваровОрганизаций.ВидДвижения = СебестоимостьТоваров.ВидДвижения
		|			И ПартииТоваровОрганизаций.АналитикаУчетаНоменклатуры = СебестоимостьТоваров.АналитикаУчетаНоменклатуры
		|			И ПартииТоваровОрганизаций.Организация = СебестоимостьТоваров.Организация
		|			И ПартииТоваровОрганизаций.ХозяйственнаяОперация = СебестоимостьТоваров.ХозяйственнаяОперация
		|ГДЕ
		|	ПартииТоваровОрганизаций.Активность
		|	И ПартииТоваровОрганизаций.Регистратор ССЫЛКА Документ.ПередачаТоваровМеждуОрганизациями
		|	И ПартииТоваровОрганизаций.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|	И ПартииТоваровОрганизаций.СтоимостьРегл <> СебестоимостьТоваров.СтоимостьРегл";

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыККорректировке = Результат.Выгрузить();
    
	ТаблицаКорректировки = РегистрыНакопления.СебестоимостьТоваров.СоздатьНаборЗаписей();
	
			
	ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			ТаблицаКорректировки.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
			ТаблицаКорректировки.Прочитать();
			
	       Для Каждого Запись Из ТаблицаКорректировки Цикл
				Если Запись.ВидДвижения = ВидДвиженияНакопления.Расход ИЛИ 
					Запись.АналитикаУчетаНоменклатуры <> ВыборкаДетальныеЗаписи.АналитикаУчетаНоменклатуры ИЛИ
					(Запись.АналитикаУчетаНоменклатуры = ВыборкаДетальныеЗаписи.АналитикаУчетаНоменклатуры
					И Запись.НомерСтроки <> ВыборкаДетальныеЗаписи.НомерСтроки)Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(Запись, ВыборкаДетальныеЗаписи); 
				НачатьТранзакцию();
				ТаблицаКорректировки.Записывать = Истина;
				ТаблицаКорректировки.Записать(Истина);
				ЗафиксироватьТранзакцию();

		   КонецЦикла;

	    КонецЦикла;


		
		
КонецПроцедуры

