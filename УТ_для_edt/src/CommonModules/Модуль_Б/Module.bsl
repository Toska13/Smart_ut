Процедура ЗаполнитьДокументПоПартиямКПередаче(Параметры, Документ) Экспорт
	
		
	Документ.Товары.Очистить();
	ТаблицаТовары = Документ.Товары.Выгрузить();
	
	//Выборка = Запрос.Выполнить().Выбрать();
	Для Каждого Строка Из Параметры.Товары Цикл
		
		НоваяСтрока = Документ.ВидыЗапасов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрокаТоваров = ТаблицаТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, Строка);
		НоваяСтрокаТоваров.КоличествоУпаковок = НоваяСтрокаТоваров.Количество;
		НоваяСтрокаТоваров.Сумма = НоваяСтрокаТоваров.Количество*НоваяСтрокаТоваров.Цена;
		//НоваяСтрокаТоваров.СуммаНДС = Ценообразование.РассчитатьСуммуНДС(НоваяСтрокаТоваров.Сумма,НоваяСтрокаТоваров.СтавкаНДС, СтруктураПараметровДействия.ЦенаВключаетНДС);
	КонецЦикла;
	
