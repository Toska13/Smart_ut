	Таб.ОтображатьГруппировки = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
	Таб.ОтображатьСетку = Ложь;
	
	Макет = ПолучитьОбщийМакет("смартЗаявкаНаОтгрузкуАтлант");
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Номер = ДанныеШапки.Номер;
	Область.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
	Область.Параметры.Менеджер = СокрЛП(ДанныеШапки.Менеджер);
	Область.Параметры.Получатель = СтрШаблон("ООО ""Смарт-Т"" / %1", СокрЛП(ДанныеШапки.Менеджер));
	Область.Параметры.ДатаДоставки = ДанныеШапки.ДатаОтгрузки;
	Область.Параметры.Автомобиль = ДанныеШапки.Автомобиль;
	Область.Параметры.Водитель = ДанныеШапки.Водитель;
	Область.Параметры.КоличествоСтрок = Товары.Количество();
	Таб.Вывести(Область);
	
	Для каждого стрТовары Из Товары Цикл
		
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Код = стрТовары.Номенклатура.Код;
		Область.Параметры.НоменклатураНаименованиеПолное = стрТовары.Номенклатура.НаименованиеПолное;
		Область.Параметры.Количество = стрТовары.Количество;
		
		Если ЗначениеЗаполнено(стрТовары.Серия) Тогда
			Если ЗначениеЗаполнено(стрТовары.Серия.Номер) Тогда
				Область.Параметры.Серия = стрТовары.Серия.Номер;
			Иначе
				Область.Параметры.Серия = стрТовары.Серия;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(стрТовары.Характеристика) Тогда
			Область.Параметры.НоменклатураНаименованиеПолное = СтрШаблон("%1 (%2)", стрТовары.Номенклатура.НаименованиеПолное, стрТовары.Характеристика);
		КонецЕсли;
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
 	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xls");
	Таб.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLS);
	Данные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Адрес;
	
КонецФункции

Функция СформироватьУведомлениеОПриемкеАтлант(ДанныеШапки, Товары, УникальныйИдентификатор) Экспорт
	
	Таб = Новый ТабличныйДокумент;
	Таб.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Таб.АвтоМасштаб = Истина;
	Таб.ОтображатьГруппировки = Ложь;
	Таб.ОтображатьЗаголовки = Ложь;
