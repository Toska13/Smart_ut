	Область.Параметры.ДатаДоставки = ДанныеШапки.ДатаОтгрузки;
	Область.Параметры.Автомобиль = ДанныеШапки.Автомобиль;
	Область.Параметры.Водитель = ДанныеШапки.Водитель;
	Область.Параметры.КоличествоСтрок = Товары.Количество();
	Таб.Вывести(Область);
	
	Для каждого стрТовары Из Товары Цикл
		
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Заполнить(стрТовары);
		Область.Параметры.Код = стрТовары.Номенклатура.Код;
		Область.Параметры.НоменклатураНаименованиеПолное = стрТовары.Номенклатура.НаименованиеПолное;
		
		Если ЗначениеЗаполнено(стрТовары.Серия) И ЗначениеЗаполнено(стрТовары.Серия.Номер) Тогда
			Область.Параметры.Серия = СокрЛП(стрТовары.Серия.Номер);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(стрТовары.Характеристика) Тогда
			Область.Параметры.НоменклатураНаименованиеПолное = СтрШаблон("%1 (%2)", стрТовары.Номенклатура.НаименованиеПолное, стрТовары.Характеристика);
		КонецЕсли;
		
		Таб.Вывести(Область);
		
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xls");
	Таб.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLS);
	Данные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Адрес = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Адрес;
	
КонецФункции

Процедура ВыгрузитьМассивНоменклатурыНаFTP(МассивНоменклатуры, ЗНАЧ Узел = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивУзлов = ПолучитьМассивУзловАтлант();
	ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, МассивНоменклатуры);
	
	Если НЕ Узел = Неопределено Тогда
		смартИнтеграцияАтлант.ВыполнитьЗаданиеОбменСоСкладомАтлант(Новый Структура("УзелОбмена", Узел));
	Иначе
		
		Для каждого Узел Из МассивУзлов Цикл
			смартИнтеграцияАтлант.ВыполнитьЗаданиеОбменСоСкладомАтлант(Новый Структура("УзелОбмена", Узел));
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ЭтоСкладАтлант(Склад) Экспорт
	
	Возврат ЗначениеЗаполнено(Склад.смартНастройкаОбменомСАтлант);
	
КонецФункции

