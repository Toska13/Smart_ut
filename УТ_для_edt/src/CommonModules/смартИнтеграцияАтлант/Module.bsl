	Макет = ПолучитьОбщийМакет("смартЗаявкаНаПриемкуАтлант");
	
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.Номер = ДанныеШапки.Номер;
	Область.Параметры.Дата = Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
