#Область ПрограммныйИнтерфейс

// Процедура - Процедура выполняет обмен
//  
Процедура ВыполнитьЗаданиеОбменСоСкладомАтлант(Параметры) Экспорт
	
	ЭтоОбменПоРегламентномуЗаданию = Ложь;
	
	Если ТипЗнч(Параметры) = Тип("Строка") Тогда
		
		//Запуск по регламентному задани
		ЭтоОбменПоРегламентномуЗаданию = Истина;
		
		Параметры = Новый Структура("УзелОбмена", ПланыОбмена.смартОбменСоСкладомАтлант.НайтиПоКоду(Параметры));
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Параметры.УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОбмена = ПолучитьНастройкиОбменаУзлаАтлант(Параметры.УзелОбмена);
	
	Если ЭтоОбменПоРегламентномуЗаданию 
		И НЕ НастройкиОбмена.ИспользоватьРегламентныеЗадания Тогда
		
		Возврат;
		
	КонецЕсли;

	//Выгрузка номенклатуры
	ВыполнитьОбменСоСкладомАтлант(НастройкиОбмена, "Справочник.Номенклатура", "Номенклатура");
	
КонецПроцедуры

Функция ВыполнитьОбменСоСкладомАтлант(НастройкиОбмена, ОбъектВыгрузки, Сервис) Экспорт
	
	Результат = Ложь;
	
	Если ТипЗнч(ОбъектВыгрузки) = Тип("Строка") Тогда
		МассивОбъектов = ПолучитьИзмененияПоУзлу(НастройкиОбмена.Ссылка, ОбъектВыгрузки);
	ИначеЕсли ТипЗнч(ОбъектВыгрузки) = Тип("Массив") Тогда	
    	МассивОбъектов = ОбъектВыгрузки;
	КонецЕсли;	
		
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	FTPСоединениеАтлант = ПолучитьFTPСоединение(НастройкиОбмена);
	
	Если FTPСоединениеАтлант = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если Сервис = "Номенклатура" Тогда
		
		ВыгрузитьНаСкладАтлантНоменклатуру(FTPСоединениеАтлант, НастройкиОбмена, МассивОбъектов);
		
	КонецЕсли;	

КонецФункции

//++ #Б-2746 смарт: Лопато 31.03.2025 //Интеграция с WMS. Атлант. Выгрузка номенклатуры  
Процедура ВыгрузитьНаСкладАтлантНоменклатуру(FTPСоединениеАтлант, НастройкиОбмена, МассивОбъектов)
	
	МассивНоменклатуры = ПолучитьНоменклатуруДляВыгрузкиПоОтбору(МассивОбъектов, НастройкиОбмена);
	ДанныеВыгрузки = ПолучитьДанныеВыгрузкиНоменклатуры(МассивНоменклатуры);
	
	ТекущаяДата = ТекущаяДата();
	
	ИмяФайла = "items_" + Формат(ТекущаяДата, "ДФ=dd-MM-yyyy-hh-mm-ss") + ".xml"; 
   	ИмяФайлаЛокальныйПуть = КаталогВременныхФайлов() + ИмяФайла;
	
	ЗаписьXML = Новый ЗаписьXML; 
	ЗаписьXML.ОткрытьФайл(ИмяФайлаЛокальныйПуть, Новый ПараметрыЗаписиXML("UTF-8", "1.0", Ложь)); 
	ЗаписьXML.ЗаписатьОбъявлениеXML(); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("instock");
	
	ЗаписатьЭлементXML(ЗаписьXML, "id", "");
	ЗаписатьЭлементXML(ЗаписьXML, "date", Формат(ТекущаяДата, "ДФ='yyyy-MM-dd hh:mm:ss'"));
	ЗаписатьЭлементXML(ЗаписьXML, "source_system", "");
	ЗаписатьЭлементXML(ЗаписьXML, "owner", "");
	ЗаписатьЭлементXML(ЗаписьXML, "whse", "");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("catalogs");
	
	ОтразитьВеткуItems(ЗаписьXML, ДанныеВыгрузки);
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); //catalogs
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); //instock

	ЗаписьXML.Закрыть();
	
	Успешно = ЗаписатьФайлВКаталог(FTPСоединениеАтлант, "MD", ИмяФайлаЛокальныйПуть, ИмяФайла, НастройкиОбмена.ТестовыйКонтур);
	
	Если Успешно Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(НастройкиОбмена.Ссылка, МассивОбъектов);
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-2746 смарт: Лопато 31.03.2025	

#КонецОбласти

#Область ОперацииСФайламиFTP

// Процедура - Процедура выполняет чтение файлов из каталога FTP
//  
Функция ПрочитатьФайлыИзКаталога(FTPСоединениеАтлант, Каталог, Маска = "*", ТестовыйРежим = Ложь) Экспорт

	//in - запросы на приемку, мы размещаем
	//ex_in - ответы по приемкам, мы читаем
	//out - запросы на отгрузку, мы размещаем
	//ex_out - ответы по отгрузкам, мы читаем
	//md - справочник товаров, мы размещаем
	
	//Каталоги для тестирования имеют постфикс "1".
	
	ПутьКаталога = "/" + Каталог + ?(ТестовыйРежим, "1", "");

	Попытка
	
		FTPСоединениеАтлант.УстановитьТекущийКаталог(ПутьКаталога);

		МассивФайлов = FTPСоединениеАтлант.НайтиФайлы("/", Маска);
		
	Исключение

		ЗаписьЖурналаРегистрации("Обмен со складом Атлант", УровеньЖурналаРегистрации.Ошибка, , ,
								 "Не удалось прочитать файлы из каталога " + ПутьКаталога);
		
		МассивФайлов = Новый Массив;
		
	КонецПопытки;
	
	
	Возврат МассивФайлов;
	
КонецФункции

// Процедура - Процедура выполняет запись файла а каталог FTP
//  
Функция ЗаписатьФайлВКаталог(FTPСоединениеАтлант, Каталог, ИмяФайлаЛокальныйПуть, ИмяФайла, ТестовыйРежим = Ложь) Экспорт

	//in - запросы на приемку, мы размещаем
	//ex_in - ответы по приемкам, мы читаем
	//out - запросы на отгрузку, мы размещаем
	//ex_out - ответы по отгрузкам, мы читаем
	//md - справочник товаров, мы размещаем
	
	//Каталоги для тестирования имеют постфикс "1".

	ПутьКаталога = "/" + Каталог + ?(ТестовыйРежим, "1", "");

	Попытка
	
		FTPСоединениеАтлант.УстановитьТекущийКаталог(ПутьКаталога);

		FTPСоединениеАтлант.Записать(ИмяФайлаЛокальныйПуть, ИмяФайла);	

		Результат = Истина;
		
	Исключение

		ЗаписьЖурналаРегистрации("Обмен со складом Атлант", УровеньЖурналаРегистрации.Ошибка, , ,
								 "Не удалось записать файл " + ИмяФайла + " в каталог " + ПутьКаталога);
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьFTPСоединение(НастройкиОбмена) Экспорт

	АдресFTP  = НастройкиОбмена.АтлантFTPАдрес;
	ЛогинFTP  = НастройкиОбмена.АтлантFTPЛогин;
	ПарольFTP = НастройкиОбмена.АтлантFTPПароль;
	
	Если НЕ (ЗначениеЗаполнено(АдресFTP) И ЗначениеЗаполнено(ЛогинFTP) И ЗначениеЗаполнено(ПарольFTP)) Тогда
		Возврат	Неопределено;
	КонецЕсли;	
			 
    Попытка
		FTPСоединение = Новый FTPСоединение(АдресFTP, , ЛогинFTP, ПарольFTP, , Истина, 50);
	Исключение
		Возврат	Неопределено;
	КонецПопытки;
	
	Возврат FTPСоединение;
	
КонецФункции	

Функция ПолучитьНастройкиОбменаУзлаАтлант(УзелОбмена)
	
	НастройкиОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		УзелОбмена, "
		|Ссылка, 
	    |ТестовыйКонтур,
		|ИспользоватьРегламентныеЗадания,
		|АтлантFTPАдрес, 
		|АтлантFTPЛогин, 
		|АтлантFTPПароль, 
		|АтлантFTPНастройкиОтбораНоменклатуры");
	
	Возврат НастройкиОбмена;
	
КонецФункции

Функция ПолучитьИзмененияПоУзлу(Узел, НаименованиеОбъекта)

    Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка
	|ИЗ
	|" + НаименованиеОбъекта + ".Изменения
	|ГДЕ
	|   Узел = &Узел";

	Запрос.УстановитьПараметр("Узел", Узел);
			
	ВыборкаЗначений = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗначений.Следующий() Цикл

		Результат.Добавить(ВыборкаЗначений.Ссылка);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьНоменклатуруДляВыгрузкиПоОтбору(МассивОбъектов, НастройкиОбмена)

	Результат = Ложь;

	// Инициализация настроек
	АтлантFTPСхемаОтбораНоменклатуры = ПланыОбмена.смартОбменСоСкладомАтлант.ПолучитьМакет("АтлантFTPСхемаОтбораНоменклатуры");
	
	АтлантFTPНастройкиОтбораНоменклатуры = НастройкиОбмена.АтлантFTPНастройкиОтбораНоменклатуры.Получить();
	
	Если ТипЗнч(АтлантFTPНастройкиОтбораНоменклатуры) = Тип("НастройкиКомпоновкиДанных") Тогда
		НастройкиКомпоновкиОтбораНоменклатуры = АтлантFTPНастройкиОтбораНоменклатуры;
	Иначе
		НастройкиКомпоновкиОтбораНоменклатуры = АтлантFTPСхемаОтбораНоменклатуры.НастройкиПоУмолчанию;
	КонецЕсли;

	ИсточникНастроекОтбораНоменклатуры = Новый ИсточникДоступныхНастроекКомпоновкиДанных(
										       	   ПоместитьВоВременноеХранилище(АтлантFTPСхемаОтбораНоменклатуры, Новый УникальныйИдентификатор()));

	// Инициализация компоновщика
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроекОтбораНоменклатуры);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиОтбораНоменклатуры);

	// Установка параметров СКД
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("МассивСсылок");
	ПараметрКомпановкиДанных.Значение = МассивОбъектов;
	ПараметрКомпановкиДанных.Использование = Истина;	
	
	// Инициализация компоновки СКД
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(АтлантFTPСхемаОтбораНоменклатуры, КомпоновщикНастроек.Настройки, , , 
												  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	// Получаем таблицу значений результата запроса	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаНоменклатуры);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат ТаблицаНоменклатуры.ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

Функция ПолучитьДанныеВыгрузкиНоменклатуры(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	//++ #3892 смарт: Шляпников 23.07.2025 / Интеграция с WMS. Атлант. Выгрузка номенклатуры. Дополнение. Рефакторинг.
	|	Номенклатура.Код КАК Код,
	|	Номенклатура.ВидНоменклатуры.ИспользоватьСерии КАК ИспользоватьСерии,
	//-- #3892 смарт: Шляпников 23.07.2025
	|	Номенклатура.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	УпаковкиЕдиницыИзмерения.Владелец КАК Номенклатура,
	|	УпаковкиЕдиницыИзмерения.Ссылка КАК Упаковка,
	|	УпаковкиЕдиницыИзмерения.Наименование КАК Наименование,
	|	УпаковкиЕдиницыИзмерения.Вес КАК Вес,
	|	УпаковкиЕдиницыИзмерения.Высота КАК Высота,
	|	УпаковкиЕдиницыИзмерения.Глубина КАК Глубина,
	|	УпаковкиЕдиницыИзмерения.Ширина КАК Ширина,
	|	УпаковкиЕдиницыИзмерения.Объем КАК Объем,
	|	УпаковкиЕдиницыИзмерения.ОбъемЕдиницаИзмерения КАК ОбъемЕдиницаИзмерения,
	|	УпаковкиЕдиницыИзмерения.Числитель КАК Числитель,
	|	УпаковкиЕдиницыИзмерения.Знаменатель КАК Знаменатель,
	|	УпаковкиЕдиницыИзмерения.КоличествоУпаковок КАК КоличествоУпаковок
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|ГДЕ
	|	УпаковкиЕдиницыИзмерения.Владелец В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураРезультата = Новый Структура;
	
	СтруктураРезультата.Вставить("Номенклатура", РезультатЗапроса[0].Выгрузить());
	СтруктураРезультата.Вставить("Упаковки", 	 РезультатЗапроса[1].Выгрузить());
	СтруктураРезультата.Вставить("ШтрихКоды", 	 РезультатЗапроса[2].Выгрузить());

	Возврат СтруктураРезультата;
	
КонецФункции	

Процедура ЗаписатьЭлементXML(ЗаписьXML, Имя, Значение)
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
	ЗаписьXML.ЗаписатьТекст(Значение);
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	
КонецПроцедуры

Процедура ОтразитьВеткуBarcodes(ЗаписьXML, ДанныеВыгрузки, Номенклатура)

	СтрокиШтрихкодов = 
		ДанныеВыгрузки.Штрихкоды.НайтиСтроки(
			Новый Структура("Номенклатура", Номенклатура));

			
	ЗаписьXML.ЗаписатьНачалоЭлемента("barcodes");
			
	Для Каждого ЭлементШтрихкод Из СтрокиШтрихкодов Цикл

		ЗаписьXML.ЗаписатьНачалоЭлемента("barcode");
		
		ЗаписатьЭлементXML(ЗаписьXML, "name", "EAN13");
		ЗаписатьЭлементXML(ЗаписьXML, "value", ЭлементШтрихкод.Штрихкод);

		ЗаписьXML.ЗаписатьКонецЭлемента(); //barcode
		
	КонецЦикла;	
		
	ЗаписьXML.ЗаписатьКонецЭлемента(); //barcodes
	
КонецПроцедуры

Процедура ОтразитьВеткуUoms(ЗаписьXML, ДанныеВыгрузки, Номенклатура)
	
	СтрокиУпаковки = 
		ДанныеВыгрузки.Упаковки.НайтиСтроки(
			Новый Структура("Номенклатура", Номенклатура));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("uoms");
	
	//Если Не СтрокиУпаковки.Количество() Тогда
		
	ЗаписьXML.ЗаписатьНачалоЭлемента("uom");
	
	НаименованиеУпаковки = "шт";//Номенклатура.ЕдиницаИзмерения.Наименование;
	
	ЗаписатьЭлементXML(ЗаписьXML, "name", 				НаименованиеУпаковки);
	ЗаписатьЭлементXML(ЗаписьXML, "rf_name", 			НаименованиеУпаковки);
	ЗаписатьЭлементXML(ЗаписьXML, "gui_name", 			НаименованиеУпаковки);
	ЗаписатьЭлементXML(ЗаписьXML, "description", 		НаименованиеУпаковки);
	ЗаписатьЭлементXML(ЗаписьXML, "conversion_factor", 	"1");			
	ЗаписатьЭлементXML(ЗаписьXML, "pick_uom", 			"1");						
	ЗаписатьЭлементXML(ЗаписьXML, "default_uom", 		"1");									
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("physical_chars");
	
	ЗначениеВеса = 
