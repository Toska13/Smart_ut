Функция ПолучитьИмяФайлаПоДокументу(Документ, Направление, Расширение) Экспорт
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказНаСборку") И Направление = 1 Тогда
		ИмяФайла = СтрШаблон("SO_Отгрузка КОМ-%1 от %2.%3", НомерНаПечать(Документ.Номер, Истина, Истина), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"), Расширение);
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.ЗаказНаСборку") И Направление = 2 Тогда
		ИмяФайла = СтрШаблон("PO_Приемка КОМ-%1 от %2.%3", НомерНаПечать(Документ.Номер, Истина, Истина), Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"), Расширение);
	КонецЕсли;
	
	Возврат ИмяФайла;
	
