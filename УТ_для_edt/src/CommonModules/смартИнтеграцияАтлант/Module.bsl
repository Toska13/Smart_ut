#Область Обмен

// Процедура - Процедура регистрирует изменения при записи справочников и документов
//  
Процедура ЗарегистрироватьИзмененияПриЗаписиСправочникаДокументаДляОбменаАтлант(Источник, Отказ) Экспорт
	
	Если НЕ Отказ Тогда
		
		ЗарегистрироватьИзмененияАтлант(Источник);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗарегистрироватьИзмененияАтлант(Объект, Замещение = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);

	МассивУзловАтлант = ПолучитьМассивУзловАтлант();
	
	Если МассивУзловАтлант.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ДополнительныеСвойства.Свойство("НеРегистрироватьИзмененияДляСайта")
			 И Объект.ДополнительныеСвойства.НеРегистрироватьИзмененияДляСайта = Истина Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	ТипОбъекта = ТипЗнч(Объект);

	МассивОбъектовДляРегистрации = Новый Массив;
	
	Если ТипОбъекта = Тип("СправочникОбъект.Номенклатура") Тогда
		
		МассивОбъектовДляРегистрации.Добавить(Объект.Ссылка);

	КонецЕсли;
	
	//Регистрация объектов на узлах
	Если МассивОбъектовДляРегистрации.Количество() > 0 Тогда
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловАтлант, МассивОбъектовДляРегистрации);

	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивУзловАтлант()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.смартОбменСоСкладомАтлант
	|ГДЕ
	|	НЕ ЭтотУзел
	|	И НЕ ПометкаУдаления";
	
	ТаблицаУзлов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаУзлов.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

