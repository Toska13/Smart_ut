Функция СуммаПоЗаказамПоДоговору(Договор, ЗаказКлиента)	
	Результат = 0; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(РасчетыСКлиентамиОстатки.СуммаОстаток + РасчетыСКлиентамиОстатки.ОтгружаетсяОстаток) КАК СуммаПоДоговору
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Остатки(
	|			,
	|			АналитикаУчетаПоПартнерам.Договор = &Договор
	|				И НЕ ЗаказКлиента = &ЗаказКлиента) КАК РасчетыСКлиентамиОстатки";
	Запрос.УстановитьПараметр("Договор", Договор); 
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Результат = ВыборкаДетальныеЗаписи.СуммаПоДоговору;
	КонецЕсли;
	Возврат Результат;	
КонецФункции 

