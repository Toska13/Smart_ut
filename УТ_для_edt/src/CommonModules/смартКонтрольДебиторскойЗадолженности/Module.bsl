Функция ПолучитьФайлУведомлениеОПриближенииСрокаОплаты(ПараметрыВложения)	
	ТабДок 	= Новый ТабличныйДокумент;
	Макет 	= РегистрыСведений.смартСтопЛистТехническойОтсрочки.ПолучитьМакет("смартУведомлениеОбИстеченииСрокаОплатыПриОтсрочках");
	Область = Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.ДатаФормирования 				= Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
	Область.Параметры.НомерДоговора	 				= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыВложения.НомерДоговора, Истина, Истина);
	Область.Параметры.ДатаДоговора					= Формат(ПараметрыВложения.ДатаДоговора, "ДФ=dd.MM.yyyy");
	Область.Параметры.НаименованиеКонтрагента		= ПараметрыВложения.НаименованиеКонтрагента;
	Область.Параметры.СуммаЗадолженности    		= Формат(ПараметрыВложения.СуммаЗадолженности, "ЧДЦ=2");
	Область.Параметры.СуммаЗадолженностиПрописью    = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ПараметрыВложения.СуммаЗадолженности, ПараметрыВложения.Валюта);
    Область.Параметры.Валюта                        = ПараметрыВложения.Валюта;
	Область.Параметры.СтавкаНДС                     = Перечисления.СтавкиНДС.НДС22;
	
	ТабДок.Вывести(Область);
	
	ИмяВременногоФайла 		= ПолучитьИмяВременногоФайла("pdf");
	ТабДок.АвтоМасштаб 		= Истина;
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
	ДвоичныеДанные 			= Новый ДвоичныеДанные(ИмяВременногоФайла);
	АдресДвоичныхДанных		= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат АдресДвоичныхДанных;	
КонецФункции  

Процедура ОтправитьПочтовоеУведомлениеОПросрочкеПлатежей(ЗаказКлиента, СтруктураДанных)
		
	ВидСобытия = "ПросрочкаПлатежаПоЗаказу";
	
	Если смартУведомления.ПолучитьИнформациюОПоследнемУведомлении(ЗаказКлиента, ВидСобытия).Объект = Неопределено Тогда
		
		Событие              = СтрШаблон("Наступила просрочка по договору %1 от %2", СтруктураДанных.НомерДоговора, Формат(СтруктураДанных.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		СтруктураУведомления = ПолучитьСтруктуруУведомленияОКритическомСобытииПоДоговоруСОтсрочкойПлатежа(СтруктураДанных, Событие); 
	    смартУведомления.ОтправитьПочтовоеУведомление(ЗаказКлиента, ВидСобытия, СтруктураУведомления.Тема, СтруктураУведомления.Тело, СтруктураУведомления.Адреса, СтруктураУведомления.АдресаКопии, , СтруктураУведомления.Вложения);
		
	КонецЕсли;    
	
КонецПроцедуры 

Процедура ОтправитьПочтовоеУведомлениеОбИсчерпанииЛимита(ЗаказКлиента, СтруктураДанных)
		
	ВидСобытия = "ИсчерпанЛимитПоДоговору";
	
	Если смартУведомления.ПолучитьИнформациюОПоследнемУведомлении(ЗаказКлиента, ВидСобытия).Объект = Неопределено Тогда
		
		Событие              = СтрШаблон("Исчерпан лимит по договору %1 от %2", СтруктураДанных.НомерДоговора, Формат(СтруктураДанных.ДатаДоговора, "ДФ=dd.MM.yyyy"));
		СтруктураУведомления = ПолучитьСтруктуруУведомленияОКритическомСобытииПоДоговоруСОтсрочкойПлатежа(СтруктураДанных, Событие); 
	    смартУведомления.ОтправитьПочтовоеУведомление(ЗаказКлиента, ВидСобытия, СтруктураУведомления.Тема, СтруктураУведомления.Тело, СтруктураУведомления.Адреса, СтруктураУведомления.АдресаКопии, , СтруктураУведомления.Вложения);
		
	КонецЕсли;    
	
КонецПроцедуры

Функция ПолучитьСтруктуруУведомленияОКритическомСобытииПоДоговоруСОтсрочкойПлатежа(СтруктураДанных, Событие)	
	Результат 				= Новый Структура("Тема,Тело,Адреса,АдресаКопии,Вложения");
	
	Результат.Тема 			= СтрШаблон("По договору %1 с клиентом %2 действуют ограничения", СтруктураДанных.НомерДоговора, СтруктураДанных.НаименованиеКлиента);
	Тело 					= ПолучитьТекстаПисьмаУведомленияОКритическомСобытииПоДоговоруСОтсрочкойПлатежа();
	Тело 					= СтрЗаменить(Тело, "%Событие%",		Событие);

	Результат.Тело 			= Тело; 
	Получатели 				= Новый Массив;
	Получатели.Добавить(СтруктураДанных.Получатель1);
	Получатели.Добавить(СтруктураДанных.Получатель2);
	Результат.Адреса 		= смартУведомления.СформироватьАдресаПолучателейДляОтправки(Получатели);
	
	ПолучателиКопии			= ПолучитьАдресаРуководителейПодразделений(Получатели);
	Для Каждого Строка Из Справочники.смартПредопределенныеЗначения.ПолучателиУведомленийОКритическихСобытияхКонтроляОтсрочекПлатежей.Значения Цикл
		ПолучателиКопии.Добавить(Строка.Значение);
	КонецЦикла;
	Результат.АдресаКопии	= смартУведомления.СформироватьАдресаПолучателейДляОтправки(ПолучателиКопии);
	                          
	Возврат Результат;   						
КонецФункции

