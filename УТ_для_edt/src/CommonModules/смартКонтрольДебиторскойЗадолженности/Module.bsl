Процедура ОбработатьОтмененныеОтгрузки(МассивОшибок);

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартСтопЛистТехническойОтсрочкиСрезПоследних.ЗаказКлиента КАК ЗаказКлиента
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	РегистрСведений.смартСтопЛистТехническойОтсрочки.СрезПоследних КАК смартСтопЛистТехническойОтсрочкиСрезПоследних
	|ГДЕ
	|	смартСтопЛистТехническойОтсрочкиСрезПоследних.ПродажаОтгрузкаЗапрещена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказы.ЗаказКлиента = РеализацияТоваровУслуг.ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заказы.ЗаказКлиента
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(РеализацияТоваровУслуг.ПометкаУдаления) = ИСТИНА
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_Заказы.ЗаказКлиента
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_Заказы.ЗаказКлиента = РеализацияТоваровУслуг.ЗаказКлиента
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Попытка
			
			НаборЗаписей = РегистрыСведений.смартСтопЛистТехническойОтсрочки.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЗаказКлиента.Установить(ВыборкаДетальныеЗаписи.ЗаказКлиента);
			НаборЗаписей.Прочитать();
			Для Каждого Запись Из НаборЗаписей Цикл
				НаборЗаписей.Удалить(Запись);
			КонецЦикла;			
			НаборЗаписей.Записать();
			
			Комментарий = СтрШаблон("Внимание! Удалена запись в стоп-листе по заказу %1 по причине отмены отгрузки", 
											ВыборкаДетальныеЗаписи.ЗаказКлиента);

			ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         Комментарий);
							 
		Исключение  
			ТекстОшибки = СтрШаблон("Не удалось удалить запись в стоп-листе %1 (%2 - %3) по причине: %4", 
											ВыборкаДетальныеЗаписи.ЗаказКлиента,
											ВыборкаДетальныеЗаписи.Партнер,
											ВыборкаДетальныеЗаписи.Контрагент,
											ОписаниеОшибки());
			МассивОшибок.Добавить(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;	
		
КонецПроцедуры
