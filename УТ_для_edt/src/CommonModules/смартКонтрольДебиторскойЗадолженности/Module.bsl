//#4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
//#4822 смарт: Тимофеева 02.04.2026 / Контроль дебиторской задолженности. Реализация блокировки клиента. Отгрузка с отсрочкой платежа (по договору). Этап 2

#Область ПрограммныйИнтерфейс

Процедура КонтрольДебиторскойЗадолженности() Экспорт 
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.смартСозданиеПоступленийТоваровНаСклад);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Начат контроль дебиторской задолженности (смарт).'"));
							 
	Если НЕ ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаНачалаКонтроляДебиторскойЗадолженности.Значение)
		ИЛИ ТекущаяДатаСеанса() < Справочники.смартПредопределенныеЗначения.ДатаНачалаКонтроляДебиторскойЗадолженности.Значение Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Контроль дебиторской задолженности не включен.'"));
		Возврат;
	КонецЕсли;
						 
	МассивОшибок = Новый Массив;						 
	ОбработатьЗакрытиеЗадолженности(МассивОшибок);
	Если МассивОшибок.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Ошибка, , ,
	                         СтрСоединить(МассивОшибок, Символы.ПС));
	КонецЕсли;
						 
	//++ #7590 смарт: Тимофеева 30.07.2026 / Отмененные заказы попадают в стоп-лист по просроченной дебиторке
	МассивОшибок = Новый Массив;						 
	ОбработатьОтмененныеОтгрузки(МассивОшибок);
	Если МассивОшибок.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Ошибка, , ,
	                         СтрСоединить(МассивОшибок, Символы.ПС));
	КонецЕсли;
	//-- #7590 смарт: Тимофеева 30.07.2026
	
	МассивОшибок.Очистить();
	ОбработатьПросроченныеЗадолженности(МассивОшибок);
	Если МассивОшибок.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Ошибка, , ,
	                         СтрСоединить(МассивОшибок, Символы.ПС));
	КонецЕсли;
						 
	МассивОшибок.Очистить();
	ОбработатьОтгрузкиСОтсрочкойПлатежа(МассивОшибок);
	Если МассивОшибок.Количество() > 0 Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Ошибка, , ,
	                         СтрСоединить(МассивОшибок, Символы.ПС));
	КонецЕсли;

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Контроль дебиторской задолженности (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Закончен контроль дебиторской задолженности (смарт).'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ПроверитьЗапретОтгрузки(Партнер, ДатаДокумента, Отказ) Экспорт
	
	Если НЕ ВедетсяКонтрольДебиторскойЗадолженности(ДатаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru='Клиенту ""%Партнер%"" запрещены запись и проведение документа ""Реализация товаров и услуг"".'");
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%Партнер%", Партнер);
	
	Если Партнер.Клиент Тогда
		СостояниеПоТехническойОтсрочке = РегистрыСведений.смартСтопЛистТехническойОтсрочки.СостояниеПоТехническойОтсрочке(Партнер); 
		
		Если СостояниеПоТехническойОтсрочке.ПродажаОтгрузкаЗапрещена
			И СостояниеПоТехническойОтсрочке.ДатаЗапрета <= ДатаДокумента Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки,
				,
				"Объект.Партнер",
				,
				Отказ);
		КонецЕсли;				
	КонецЕсли;
	
КонецПроцедуры 

Процедура ПроверитьСуммуКредитаПоСроку(Договор, КоличествоДнейОтсрочки, ДатаАктуальности, Отказ) Экспорт
	ПограничныйСрокКредита 		= Справочники.смартПредопределенныеЗначения.ГраницаПоСрокуКредита.Значение;
	ПограничнаяСуммаДоговора 	= Справочники.смартПредопределенныеЗначения.ГраницаПоСуммеКредита.Значение;
	
	ПограничныйСрокКредита 		= ?(ЗначениеЗаполнено(ПограничныйСрокКредита), ПограничныйСрокКредита, 15);
	ПограничнаяСуммаДоговора 	= ?(ЗначениеЗаполнено(ПограничнаяСуммаДоговора), ПограничнаяСуммаДоговора, 300000);
	
	РеквизитыДоговора 			= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ДопустимаяСуммаЗадолженности, ВалютаВзаиморасчетов");
	ВалютаРеглУчета 			= Константы.ВалютаРегламентированногоУчета.Получить();
	Если РеквизитыДоговора.ВалютаВзаиморасчетов = ВалютаРеглУчета Тогда
		СуммаКредитаДоговора = РеквизитыДоговора.ДопустимаяСуммаЗадолженности;
	Иначе
		СуммаКредитаДоговора = РаботаСКурсамиВалют.ПересчитатьВВалюту(РеквизитыДоговора.ДопустимаяСуммаЗадолженности, 
																		РеквизитыДоговора.ВалютаВзаиморасчетов, 
																		ВалютаРеглУчета, 
																		ДатаАктуальности);  
	КонецЕсли;
	
	ТекстОшибки = НСтр("ru='Сумма кредита в договоре %СуммаКредитаДоговора% %ВалютаВзаиморасчетов% не соответствует сроку кредита.'");
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СуммаКредитаДоговора%", РеквизитыДоговора.ДопустимаяСуммаЗадолженности);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ВалютаВзаиморасчетов%", РеквизитыДоговора.ВалютаВзаиморасчетов);
    
	Если КоличествоДнейОтсрочки < ПограничныйСрокКредита 
		И СуммаКредитаДоговора > ПограничнаяСуммаДоговора
		Тогда
		
		ТекстОшибкиУточнение = НСтр("ru='Установлена отсрочка менее %ПограничныйСрокКредита% дней.'");
		ТекстОшибкиУточнение = СтрЗаменить(ТекстОшибкиУточнение, "%ПограничныйСрокКредита%", ПограничныйСрокКредита);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки + " " + ТекстОшибкиУточнение,
				,
				"Объект.ЭтапыГрафикаОплаты",
				,
				Отказ);        
				
	ИначеЕсли КоличествоДнейОтсрочки >= ПограничныйСрокКредита 
		И СуммаКредитаДоговора <= ПограничнаяСуммаДоговора
		Тогда
		
		ТекстОшибкиУточнение = НСтр("ru='Установлена отсрочка более %ПограничныйСрокКредита% дней.'");
		ТекстОшибкиУточнение = СтрЗаменить(ТекстОшибкиУточнение, "%ПограничныйСрокКредита%", ПограничныйСрокКредита - 1);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки + " " + ТекстОшибкиУточнение,
				,
				"Объект.ЭтапыГрафикаОплаты",
				,
				Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЛимитКредита(СтруктураЗаказа, Отказ) Экспорт
	
	РеквизитыДоговора 	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураЗаказа.Договор, "Номер, Дата, ДопустимаяСуммаЗадолженности");
	СуммаКредитаДоговора = РеквизитыДоговора.ДопустимаяСуммаЗадолженности;	

	ТекстОшибки = НСтр("ru='По договору %НомерДоговора% от %ДатаДоговора% превышена допустимая сумма кредита на %СуммаПревышения% руб. Запись не выполнена. Заказ клиента %НомерЗаказа% от %ДатаЗаказа%'");
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерДоговора%", РеквизитыДоговора.Номер);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаДоговора%", Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"));
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерЗаказа%", СтруктураЗаказа.Номер);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаЗаказа%", Формат(СтруктураЗаказа.Дата, "ДФ=dd.MM.yyyy"));
	
	//++ #7696 смарт: Тимофеева 31.07.2026 / Контроль дебиторской задолженности. Корректировка алгоритма учета кредитного лимита.
	//Если СтруктураЗаказа.СуммаДокумента + СуммаПоЗаказамПоДоговору(СтруктураЗаказа.Договор, СтруктураЗаказа.Ссылка) > СуммаКредитаДоговора Тогда
	//	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СуммаПревышения%", Формат(СтруктураЗаказа.СуммаДокумента + СуммаПоЗаказамПоДоговору(СтруктураЗаказа.Договор, СтруктураЗаказа.Ссылка) - СуммаКредитаДоговора, "ЧДЦ=2"));
	Если СтруктураЗаказа.СуммаДокумента + СуммаПоЗаказамПоДоговору(СтруктураЗаказа.Договор, СтруктураЗаказа.Ссылка) - СуммаОплатПоЗаказу(СтруктураЗаказа.Ссылка) > СуммаКредитаДоговора Тогда
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%СуммаПревышения%", Формат(СтруктураЗаказа.СуммаДокумента + СуммаПоЗаказамПоДоговору(СтруктураЗаказа.Договор, СтруктураЗаказа.Ссылка) - СуммаОплатПоЗаказу(СтруктураЗаказа.Ссылка) - СуммаКредитаДоговора, "ЧДЦ=2"));
	    //-- #7696 смарт: Тимофеева 31.07.2026
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки,
				,
				,
				,
				Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПросроченныеПлатежиПоДоговору(СтруктураЗаказа, Отказ) Экспорт
	
	РеквизитыДоговора 	 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураЗаказа.Договор, "Номер, Дата");
	ТекстОшибки = НСтр("ru='По договору %НомерДоговора% от %ДатаДоговора% есть реализация с просроченной датой планового платежа %РеализацияСсылка% (%КоличествоДнейПросрочки% дней просрочки)'");
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%НомерДоговора%", РеквизитыДоговора.Номер);
	ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаДоговора%", Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"));
	
	МассивПросрочек = ПолучитьМассивНакладныхСПросроченнойОплатой(СтруктураЗаказа.Договор, СтруктураЗаказа.Дата);
	Для Каждого СтруктураРеализации Из МассивПросрочек Цикл
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%РеализацияСсылка%", СтруктураРеализации.Ссылка);
		ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КоличествоДнейПросрочки%", СтруктураРеализации.КоличествоДнейПросрочки);
	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки,
				,
				,
				,
				Отказ);
	
	КонецЦикла;
	
КонецПроцедуры 

Функция ВедетсяКонтрольДебиторскойЗадолженности(Дата = Неопределено) Экспорт
	ДатаНачалаКонтроляДебиторскойЗадолженности = Справочники.смартПредопределенныеЗначения.ДатаНачалаКонтроляДебиторскойЗадолженности.Значение;
	Если НЕ ЗначениеЗаполнено(ДатаНачалаКонтроляДебиторскойЗадолженности) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Дата = Неопределено Тогда
		Возврат ТекущаяДатаСеанса() >= ДатаНачалаКонтроляДебиторскойЗадолженности;
	Иначе
		Возврат Дата >= ДатаНачалаКонтроляДебиторскойЗадолженности;
	КонецЕсли;
КонецФункции 

Функция ЕстьАктивныеБлокировкиПоДоговорамПартнера(Партнер) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ДоговорыКонтрагентов.ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Партнер = &Партнер
	|	И ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|	И ДоговорыКонтрагентов.ОграничиватьСуммуЗадолженности
	|	И ДоговорыКонтрагентов.смартВидДоговора = ЗНАЧЕНИЕ(Перечисление.смартВидыДоговоров.РасходныеМатериалыОтсрочка)";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СуммаПоЗаказамПоДоговору(Выборка.Договор, Неопределено) >= Выборка.ДопустимаяСуммаЗадолженности Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;		
		
		МассивНакладныхСПросроченнойОплатой = ПолучитьМассивНакладныхСПросроченнойОплатой(Выборка.Договор, ТекущаяДатаСеанса());
		Если МассивНакладныхСПросроченнойОплатой.Количество() > 0 Тогда
			Результат = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции  

#КонецОбласти

