Функция ПолучитьМассивНакладныхСПросроченнойОплатой(Договор, ДатаЗаказа)	
	Результат = Новый Массив; 
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаУчета.Партнер КАК Партнер,
	|	АналитикаУчета.Контрагент КАК Контрагент,
	|	РасчетыПоСрокам.ОбъектРасчетов КАК ЗаказКлиента,
	|	РасчетыПоСрокам.Валюта КАК Валюта,
	|	РасчетыПоСрокам.РасчетныйДокумент КАК РасчетныйДокумент,
	|	РасчетыПоСрокам.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
	|	РасчетыПоСрокам.ПредоплатаОстаток КАК Предоплата,
	|	РасчетыПоСрокам.ДолгОстаток КАК Долг
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(, АналитикаУчетаПоПартнерам.Договор = &Договор) КАК РасчетыПоСрокам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
	|		ПО РасчетыПоСрокам.АналитикаУчетаПоПартнерам = АналитикаУчета.КлючАналитики
	|ГДЕ
	|	АналитикаУчета.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|	И РасчетыПоСрокам.ДолгОстаток > 0";
	Запрос.УстановитьПараметр("Договор", Договор); 
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТекущаяДата > НачалоДня(ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения)  
			И НачалоДня(ДатаЗаказа) > НачалоДня(ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения) Тогда			
			ДанныеНакладной  = Новый Структура;
			ДанныеНакладной.Вставить("Ссылка", ВыборкаДетальныеЗаписи.РасчетныйДокумент);
			ДанныеНакладной.Вставить("КоличествоДнейПросрочки", ПолучитьКоличествоРабочихДней(ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения, ТекущаяДата));
			
			Результат.Добавить(ДанныеНакладной); 		
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;	
КонецФункции

