	//										ВыборкаДетальныеЗаписи.ЗаказКлиента,
	//										ВыборкаДетальныеЗаписи.Партнер,
	//										ВыборкаДетальныеЗаписи.Контрагент,
	//										ОписаниеОшибки());
	//		МассивОшибок.Добавить(ТекстОшибки);
	//	КонецПопытки;	
	//КонецЦикла;
	#КонецОбласти
	
	//Убираем учет предоплаты / вводим ДатаПлановогоПогашения 
	// + <>  	10000
	// - РТУ1 	 8000
	// - РТУ2 	12000
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартСтопЛистТехническойОтсрочкиСрезПоследних.ЗаказКлиента КАК ЗаказКлиента
	|ПОМЕСТИТЬ ВТ_ЗаказыВСтопЛисте
	|ИЗ
	|	РегистрСведений.смартСтопЛистТехническойОтсрочки.СрезПоследних КАК смартСтопЛистТехническойОтсрочкиСрезПоследних
	|ГДЕ
	|	смартСтопЛистТехническойОтсрочкиСрезПоследних.ПродажаОтгрузкаЗапрещена
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПартнерыСегмента.Партнер КАК Партнер
	|ПОМЕСТИТЬ ВТ_КлиентыИсключенияДляСтопЛиста
	|ИЗ
	|	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	|ГДЕ
	|	ПартнерыСегмента.Сегмент = &Сегмент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоглашенияСКлиентами.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ТиповыеСоглашения
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|	СоглашенияСКлиентами.Типовое
	|	И СоглашенияСКлиентами.ПорядокРасчетов = ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоЗаказамНакладным)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АналитикаУчета.Партнер КАК Партнер,
	|	АналитикаУчета.Контрагент КАК Контрагент,
	|	РасчетыПоСрокам.ОбъектРасчетов КАК ЗаказКлиента,
	|	РасчетыПоСрокам.Валюта КАК Валюта,
	|	РасчетыПоСрокам.РасчетныйДокумент КАК РасчетныйДокумент,
	|	РасчетыПоСрокам.ДатаВозникновения КАК ДатаВозникновения,
	|	РасчетыПоСрокам.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
	|	РасчетыПоСрокам.ДолгОстаток КАК СуммаЗадолженности
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			,
	|			ОбъектРасчетов ССЫЛКА Документ.ЗаказКлиента
	|				И ОбъектРасчетов.Соглашение В
	|					(ВЫБРАТЬ
	|						ВТ_ТиповыеСоглашения.Ссылка
	|					ИЗ
	|						ВТ_ТиповыеСоглашения)
	|				И НЕ ОбъектРасчетов В
	|						(ВЫБРАТЬ
	|							ВТ_ЗаказыВСтопЛисте.ЗаказКлиента
	|						ИЗ
	|							ВТ_ЗаказыВСтопЛисте)
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер В
	|						(ВЫБРАТЬ
	|							ВТ_КлиентыИсключенияДляСтопЛиста.Партнер
	|						ИЗ
	|							ВТ_КлиентыИсключенияДляСтопЛиста)
	|				И ОбъектРасчетов.Дата > &ДатаНачалаКонтроля) КАК РасчетыПоСрокам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
	|		ПО РасчетыПоСрокам.АналитикаУчетаПоПартнерам = АналитикаУчета.КлючАналитики
	|       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЗаказКлиентаЭтапыГрафикаОплаты
	|		ПО (РасчетыПоСрокам.ОбъектРасчетов = ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка
	|		И ЗаказКлиентаЭтапыГрафикаОплаты.ВариантОплаты В (ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитСдвиг)))
	|ГДЕ
	|	АналитикаУчета.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|	И РасчетыПоСрокам.ДолгОстаток > 0";

	Запрос.УстановитьПараметр("ДатаНачалаКонтроля", Справочники.смартПредопределенныеЗначения.ДатаНачалаКонтроляДебиторскойЗадолженности.Значение);
	Запрос.УстановитьПараметр("Сегмент", Справочники.смартПредопределенныеЗначения.СегментИсключенийДляТехническойОтсрочки.Значение);
	
	ТаблицаЗадолженности 				= Запрос.Выполнить().Выгрузить();
	ТаблицаПросроченныеЗадолженности 	= ТаблицаЗадолженности.СкопироватьКолонки(); 
	ТаблицаЗадолженностиСвернутая       = ТаблицаЗадолженности.Скопировать();
	ТаблицаЗадолженностиСвернутая.Свернуть("Партнер, Контрагент, ЗаказКлиента");
	
	Календарь 	= Константы.ОсновнойКалендарьПредприятия.Получить();
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗадолженностиСвернутая Цикл
		
		Отбор = Новый Структура("Партнер, Контрагент, ЗаказКлиента");
		ЗаполнитьЗначениясвойств(Отбор, СтрокаЗаказа); 
		
		НайденныеСтроки = ТаблицаЗадолженности.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 1 Тогда
			
			НайденнаяСтрока = НайденныеСтроки[0]; 
			
			Если НЕ ТипЗнч(НайденнаяСтрока.РасчетныйДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				Продолжить;
			КонецЕсли;
						
			ДатаОбязательногоПогашенияОтДатыВозникновения = CRM_КалендарныеГрафики.ПолучитьДатуПоКалендарю(Календарь, НайденнаяСтрока.ДатаВозникновения, КоличествоДнейДляОтсчета, Ложь, Истина);
			ДатаПлановогоПогашения = Макс(ДатаОбязательногоПогашенияОтДатыВозникновения, НайденнаяСтрока.ДатаПлановогоПогашения); 
			Если ТекущаяДата > ДатаПлановогоПогашения Тогда
				НоваяСтрока = ТаблицаПросроченныеЗадолженности.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока); 
			КонецЕсли;
			
		Иначе // больше одного расчетного документа
			
			СуммаЗадолженностиВИтог 		= 0;
			ДатаВозникновенияВИтог  		= НайденныеСтроки[0].ДатаВозникновения;
			ДатаПлановогоПогашенияВИтог		= НайденныеСтроки[0].ДатаПлановогоПогашения;
			РасчетныйДокументВИтог 			= НайденныеСтроки[0].РасчетныйДокумент;  
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				Если НЕ ТипЗнч(НайденнаяСтрока.РасчетныйДокумент) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
					Продолжить;
				КонецЕсли;
				
				ДатаОбязательногоПогашенияОтДатыВозникновения = CRM_КалендарныеГрафики.ПолучитьДатуПоКалендарю(Календарь, НайденнаяСтрока.ДатаВозникновения, КоличествоДнейДляОтсчета, Ложь, Истина);
				ДатаПлановогоПогашения = Макс(ДатаОбязательногоПогашенияОтДатыВозникновения, НайденнаяСтрока.ДатаПлановогоПогашения); 
				Если ТекущаяДата > ДатаПлановогоПогашения Тогда
					
					СуммаЗадолженностиВИтог = СуммаЗадолженностиВИтог + НайденнаяСтрока.СуммаЗадолженности;
					Если НайденнаяСтрока.ДатаВозникновения < ДатаВозникновенияВИтог Тогда
						
						ДатаВозникновенияВИтог  		= НайденнаяСтрока.ДатаВозникновения;
						ДатаПлановогоПогашенияВИтог		= НайденнаяСтрока.ДатаПлановогоПогашения;
						РасчетныйДокументВИтог 			= НайденнаяСтрока.РасчетныйДокумент;
						
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если СуммаЗадолженностиВИтог > 0 Тогда
				
				НоваяСтрока = ТаблицаПросроченныеЗадолженности.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока);
				НоваяСтрока.СуммаЗадолженности 		= СуммаЗадолженностиВИтог;
				НоваяСтрока.ДатаВозникновения		= ДатаВозникновенияВИтог;
				НоваяСтрока.ДатаПлановогоПогашения	= ДатаПлановогоПогашенияВИтог;
				НоваяСтрока.РасчетныйДокумент		= РасчетныйДокументВИтог;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработатьИтоговуюТаблицуПоПросроченнымЗадолженностям(ТаблицаПросроченныеЗадолженности, МассивОшибок);
	
КонецПроцедуры

Процедура ОбработатьИтоговуюТаблицуПоПросроченнымЗадолженностям(ТаблицаПросроченныеЗадолженности, МассивОшибок)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаПросроченныеЗадолженности.Партнер КАК Партнер,
	|	ТаблицаПросроченныеЗадолженности.Контрагент КАК Контрагент,
	|	ТаблицаПросроченныеЗадолженности.ЗаказКлиента КАК ЗаказКлиента,
	|	ТаблицаПросроченныеЗадолженности.Валюта КАК Валюта,
	|	ТаблицаПросроченныеЗадолженности.РасчетныйДокумент КАК РасчетныйДокумент,
	|	ТаблицаПросроченныеЗадолженности.ДатаВозникновения КАК ДатаВозникновения,
	|	ТаблицаПросроченныеЗадолженности.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
	|	ТаблицаПросроченныеЗадолженности.СуммаЗадолженности КАК СуммаЗадолженности
	|ПОМЕСТИТЬ ВТ_ПросроченнаяЗадолженностьИтог
	|ИЗ
	|	&ТаблицаПросроченныеЗадолженности КАК ТаблицаПросроченныеЗадолженности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПросроченнаяЗадолженностьИтог.Партнер КАК Партнер,
	|	ВТ_ПросроченнаяЗадолженностьИтог.Контрагент КАК Контрагент,
	|	ВТ_ПросроченнаяЗадолженностьИтог.ЗаказКлиента КАК ЗаказКлиента,
	|	ВТ_ПросроченнаяЗадолженностьИтог.Валюта КАК Валюта,
	|	ВТ_ПросроченнаяЗадолженностьИтог.СуммаЗадолженности КАК СуммаЗадолженности,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ПросроченнаяЗадолженностьИтог.Партнер) КАК НаименованиеКлиента,
	|	ЕСТЬNULL(Партнеры.смартОсновнойМенеджерСервисЦентра, НЕОПРЕДЕЛЕНО) КАК Получатель1,
	|	ЕСТЬNULL(Партнеры.смартМенеджерПоРасходнымМатериалам, НЕОПРЕДЕЛЕНО) КАК Получатель2,
	|	ЕСТЬNULL(Контрагенты.НаименованиеПолное, ПРЕДСТАВЛЕНИЕ(ВТ_ПросроченнаяЗадолженностьИтог.Контрагент)) КАК НаименованиеКонтрагента,
	|	ЕСТЬNULL(Контрагенты.ИНН, """""""") КАК ИННКонтрагента,
	|	ДокументЗаказКлиента.Номер КАК НомерЗаказа,
	|	ДокументЗаказКлиента.Дата КАК ДатаЗаказа,
	|	ВТ_ПросроченнаяЗадолженностьИтог.ДатаВозникновения КАК ДатаВозникновения,
	|	ВТ_ПросроченнаяЗадолженностьИтог.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
	|	&ТекущаяДата КАК ДатаПопаданияВСтопЛист,
	|	ВЫБОР
	|		КОГДА ВТ_ПросроченнаяЗадолженностьИтог.ДатаВозникновения >= ДАТАВРЕМЯ(2026, 1, 1, 0, 0, 0)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|	КОНЕЦ КАК СтавкаНДС,
	|	ВТ_ПросроченнаяЗадолженностьИтог.РасчетныйДокумент КАК РасчетныйДокумент
	|ИЗ
	|	ВТ_ПросроченнаяЗадолженностьИтог КАК ВТ_ПросроченнаяЗадолженностьИтог
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО ВТ_ПросроченнаяЗадолженностьИтог.Партнер = Партнеры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВТ_ПросроченнаяЗадолженностьИтог.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ДокументЗаказКлиента
	|		ПО ВТ_ПросроченнаяЗадолженностьИтог.ЗаказКлиента = ДокументЗаказКлиента.Ссылка";
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ТаблицаПросроченныеЗадолженности", ТаблицаПросроченныеЗадолженности);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл	
		
		НачатьТранзакцию();
		Попытка   
			
			СтруктураЗаписи = Новый Структура("Партнер, Контрагент, ЗаказКлиента, СуммаЗадолженности, Валюта, РасчетныйДокумент");
			ЗаполнитьЗначенияСвойств(СтруктураЗаписи, ВыборкаДетальныеЗаписи); 
			РегистрыСведений.смартСтопЛистТехническойОтсрочки.ЗапретитьТехническуюОтсрочку(ВыборкаДетальныеЗаписи);	
			
			СтруктураДанных = Новый Структура("НаименованиеКлиента, НаименованиеКонтрагента, ИННКонтрагента, НомерЗаказа, ДатаЗаказа, Валюта, СуммаЗадолженности, СтавкаНДС, ДатаПопаданияВСтопЛист");
			ЗаполнитьЗначенияСвойств(СтруктураДанных, ВыборкаДетальныеЗаписи);
			Получатели = Новый Массив;
			Получатели.Добавить(ВыборкаДетальныеЗаписи.Получатель1);
			Получатели.Добавить(ВыборкаДетальныеЗаписи.Получатель2);
			СтруктураДанных.Вставить("Получатели", Получатели);
			СтруктураДанных.Вставить("ПолучателиКопии", Справочники.смартПредопределенныеЗначения.ПолучателиУведомленийОКонтрагентахВСтопЛисте.Значения.Выгрузить().ВыгрузитьКолонку("Значение"));
						
			ОтправитьПочтовоеУведомлениеОбИстеченииСрокаОплаты(ВыборкаДетальныеЗаписи.ЗаказКлиента, СтруктураДанных);
			
			ЗафиксироватьТранзакцию();
		Исключение  
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон("Не удалось добавить в стоп-лист %1 (%2 - %3) по причине: %4", 
											ВыборкаДетальныеЗаписи.ЗаказКлиента,
											ВыборкаДетальныеЗаписи.Партнер,
											ВыборкаДетальныеЗаписи.Контрагент,
											ОписаниеОшибки());
			МассивОшибок.Добавить(ТекстОшибки);
		КонецПопытки;	
	КонецЦикла;	

КонецПроцедуры 

Процедура ОбработатьОтгрузкиСОтсрочкойПлатежа(МассивОшибок)
	
	КоличествоДнейДляКонтроля = Справочники.смартПредопределенныеЗначения.КоличествоДнейДляКонтроляПриближенияСрокаПлатежа.Значение;
	КоличествоДнейДляКонтроля = ?(ЗначениеЗаполнено(КоличествоДнейДляКонтроля), КоличествоДнейДляКонтроля, 3);
	
    ТекущаяДата = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ОбъектРасчетов КАК ЗаказКлиента,
	|	ЗаказКлиента.Номер КАК НомерЗаказа,
	|	ЗаказКлиента.Дата КАК ДатаЗаказа,
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.АналитикаУчетаПоПартнерам.Договор КАК Договор,
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаПлановогоПогашения КАК ДатаПлановогоПогашения,
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДатаВозникновения КАК ДатаВозникновения,
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ДолгОстаток КАК СуммаЗадолженности,
	|	РасчетыСКлиентамиПоСрокамОстаткиИОбороты.Валюта КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Партнеры.Ссылка) КАК НаименованиеКлиента,
	|	ЕСТЬNULL(Партнеры.смартОсновнойМенеджерСервисЦентра, НЕОПРЕДЕЛЕНО) КАК Получатель1,
	|	ЕСТЬNULL(Партнеры.смартМенеджерПоРасходнымМатериалам, НЕОПРЕДЕЛЕНО) КАК Получатель2,
	|	ДоговорыКонтрагентов.Номер КАК НомерДоговора,
	|	ДоговорыКонтрагентов.Дата КАК ДатаДоговора,
	|	ПРЕДСТАВЛЕНИЕ(АналитикаУчета.Контрагент) КАК НаименованиеКонтрагента,
	|	АналитикаУчета.Контрагент.ИНН КАК ИННКонтрагента
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(, ОбъектРасчетов ССЫЛКА Документ.ЗаказКлиента) КАК РасчетыСКлиентамиПоСрокамОстаткиИОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
	|		ПО РасчетыСКлиентамиПоСрокамОстаткиИОбороты.АналитикаУчетаПоПартнерам = АналитикаУчета.КлючАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ПО РасчетыСКлиентамиПоСрокамОстаткиИОбороты.ОбъектРасчетов = ЗаказКлиента.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО (АналитикаУчета.Партнер = Партнеры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО (АналитикаУчета.Договор = ДоговорыКонтрагентов.Ссылка)
	|ГДЕ
	|	АналитикаУчета.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|	И АналитикаУчета.Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|	И АналитикаУчета.Договор.ОграничиватьСуммуЗадолженности
	|	И АналитикаУчета.Договор.смартВидДоговора = ЗНАЧЕНИЕ(Перечисление.смартВидыДоговоров.РасходныеМатериалыОтсрочка)";
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл	
		
		Если ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения > ТекущаяДата 
			И ПолучитьКоличествоРабочихДней(ТекущаяДата, ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения) <= КоличествоДнейДляКонтроля Тогда
		
			ОтправитьПочтовоеУведомлениеОПриближенииСрокаПлатежей(ВыборкаДетальныеЗаписи.ЗаказКлиента, ВыборкаДетальныеЗаписи);
			
		ИначеЕсли ВыборкаДетальныеЗаписи.ДатаПлановогоПогашения <= ТекущаяДата  Тогда
			
			ОтправитьПочтовоеУведомлениеОПросрочкеПлатежей(ВыборкаДетальныеЗаписи.ЗаказКлиента, ВыборкаДетальныеЗаписи);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Договор КАК Договор,
	|	РасчетыСКлиентамиОстатки.Валюта КАК Валюта,
	|	ПРЕДСТАВЛЕНИЕ(Партнеры.Ссылка) КАК НаименованиеКлиента,
	|	ЕСТЬNULL(Партнеры.смартОсновнойМенеджерСервисЦентра, НЕОПРЕДЕЛЕНО) КАК Получатель1,
	|	ЕСТЬNULL(Партнеры.смартМенеджерПоРасходнымМатериалам, НЕОПРЕДЕЛЕНО) КАК Получатель2,
	|	ДоговорыКонтрагентов.Номер КАК НомерДоговора,
	|	ДоговорыКонтрагентов.Дата КАК ДатаДоговора,
	|	ПРЕДСТАВЛЕНИЕ(АналитикаУчета.Контрагент) КАК НаименованиеКонтрагента,
	|	АналитикаУчета.Контрагент.ИНН КАК ИННКонтрагента,
	|	ДоговорыКонтрагентов.ДопустимаяСуммаЗадолженности - (РасчетыСКлиентамиОстатки.СуммаОстаток + РасчетыСКлиентамиОстатки.ОтгружаетсяОстаток) КАК ТекущийЛимит
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Остатки(, ) КАК РасчетыСКлиентамиОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
	|		ПО РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам = АналитикаУчета.КлючАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО (АналитикаУчета.Партнер = Партнеры.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО (АналитикаУчета.Договор = ДоговорыКонтрагентов.Ссылка)
	|ГДЕ
	|	АналитикаУчета.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|	И АналитикаУчета.Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|	И АналитикаУчета.Договор.ОграничиватьСуммуЗадолженности
	|	И АналитикаУчета.Договор.смартВидДоговора = ЗНАЧЕНИЕ(Перечисление.смартВидыДоговоров.РасходныеМатериалыОтсрочка)
	|	И ДоговорыКонтрагентов.ДопустимаяСуммаЗадолженности - (РасчетыСКлиентамиОстатки.СуммаОстаток + РасчетыСКлиентамиОстатки.ОтгружаетсяОстаток) <= 0";
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл	
		
		ОтправитьПочтовоеУведомлениеОбИсчерпанииЛимита(ВыборкаДетальныеЗаписи.ЗаказКлиента, ВыборкаДетальныеЗаписи);
			
	КонецЦикла;	
		
КонецПроцедуры

Функция ПолучитьКоличествоРабочихДней(ДатаНачала, ДатаОкончания) Экспорт	
	Возврат CRM_КалендарныеГрафики.ПолучитьРабочиеДниПериода(ДатаНачала, ДатаОкончания).Количество() - 1;		
КонецФункции

#КонецОбласти 

#Область Уведомления

Процедура ОтправитьПочтовоеУведомлениеОбИстеченииСрокаОплаты(ЗаказКлиента, СтруктураДанных)
	
	ВидСобытия = "ПомещениеКонтрагентаВСтопЛист";
	
	Если смартУведомления.ПолучитьИнформациюОПоследнемУведомлении(ЗаказКлиента, ВидСобытия).Объект = Неопределено Тогда
		СтруктураУведомления = ПолучитьСтруктуруУведомленияОбИстеченииСрокаОплаты(СтруктураДанных); 
		смартУведомления.ОтправитьПочтовоеУведомление(ЗаказКлиента, ВидСобытия, СтруктураУведомления.Тема, СтруктураУведомления.Тело, СтруктураУведомления.Адреса, СтруктураУведомления.АдресаКопии, , СтруктураУведомления.Вложения);
	КонецЕсли;    
	
КонецПроцедуры  

Функция ПолучитьСтруктуруУведомленияОбИстеченииСрокаОплаты(СтруктураДанных)	
	Результат 				= Новый Структура("Тема,Тело,Адреса,АдресаКопии,Вложения");
	
	Результат.Тема 			= СтрШаблон("Клиент %1 помещен в Стоп-лист по технической отсрочке!", СтруктураДанных.НаименованиеКлиента);
	Тело 					= ПолучитьТекстаПисьмаУведомленияОбИстеченииСрокаОплаты();
	Тело 					= СтрЗаменить(Тело, "%НаименованиеКлиента%",		СтруктураДанных.НаименованиеКлиента);
	Тело 					= СтрЗаменить(Тело, "%НаименованиеКонтрагента%", 	СтруктураДанных.НаименованиеКонтрагента);
	Тело 					= СтрЗаменить(Тело, "%ИННКонтрагента%", 			СтруктураДанных.ИННКонтрагента);
	Тело 					= СтрЗаменить(Тело, "%НомерЗаказа%", 				СтруктураДанных.НомерЗаказа);
	Тело 					= СтрЗаменить(Тело, "%ДатаЗаказа%", 				Формат(СтруктураДанных.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
	Тело 					= СтрЗаменить(Тело, "%СуммаЗадолженности%", 		СтруктураДанных.СуммаЗадолженности);
	Тело 					= СтрЗаменить(Тело, "%Валюта%",	 					СтруктураДанных.Валюта);
	Тело 					= СтрЗаменить(Тело, "%ДатаПопадания%", 				СтруктураДанных.ДатаПопаданияВСтопЛист);
	
	Результат.Тело 			= Тело;
	Результат.Адреса 		= смартУведомления.СформироватьАдресаПолучателейДляОтправки(СтруктураДанных.Получатели);
	Результат.АдресаКопии 	= смартУведомления.СформироватьАдресаПолучателейДляОтправки(СтруктураДанных.ПолучателиКопии);
	
	Вложение 				= Новый Структура("ИмяФайла, РасширениеФайла, Адрес");
	Вложение.Адрес 			= ПолучитьФайлУведомлениеОбИстеченииСрокаОплаты(СтруктураДанных);
	Вложение.ИмяФайла 		= СтрШаблон("Уведомление о нарушении сроков оплаты по счету %1 от %2.pdf", СтруктураДанных.НомерЗаказа, Формат(СтруктураДанных.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("Вложения", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение));
	
	Возврат Результат;   						
КонецФункции

Функция ПолучитьТекстаПисьмаУведомленияОбИстеченииСрокаОплаты()	
	Возврат 
	"В связи с нарушением условий технической отсрочки, клиент был автоматически помещен в стоп-лист по технической отсрочке.
	|
	|У клиента %НаименованиеКлиента% (%НаименованиеКонтрагента% %ИННКонтрагента%) возникла задолженность по Заказу клиента %НомерЗаказа% %ДатаЗаказа% в размере %СуммаЗадолженности% %Валюта%.
	|Дата попадания в стоп лист %ДатаПопадания%
	|
	|С момента попадания в стоп-лист для клиента автоматически запрещено проведение любых документов ""Реализация товаров и услуг"".
	|
	|Для снятия ограничений необходимо обеспечить полное погашение задолженности по указанному документу. 
	|После поступления оплаты клиент будет автоматически выведен из стоп-листа, и ограничения снимутся.
	|
	|Необходимо принять меры для взаимодействия с клиентом.
	|
	|Это письмо сформировано автоматически системой 1С. Пожалуйста, не отвечайте на него.
	|-----";	
КонецФункции  

Функция ПолучитьФайлУведомлениеОбИстеченииСрокаОплаты(ПараметрыВложения)	
	ТабДок 	= Новый ТабличныйДокумент;
	Макет 	= РегистрыСведений.смартСтопЛистТехническойОтсрочки.ПолучитьМакет("смартУведомлениеОбИстеченииСрокаОплаты");
	Область = Макет.ПолучитьОбласть("Шапка");
	
	Область.Параметры.ДатаФормирования 				= Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");
	Область.Параметры.НомерЗаказа	 				= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыВложения.НомерЗаказа, Истина, Истина);
	Область.Параметры.ДатаЗаказа 					= Формат(ПараметрыВложения.ДатаЗаказа, "ДФ=dd.MM.yyyy");
	Область.Параметры.НаименованиеКонтрагента		= ПараметрыВложения.НаименованиеКонтрагента;
	Область.Параметры.СуммаЗадолженности    		= Формат(ПараметрыВложения.СуммаЗадолженности, "ЧДЦ=2");
	Область.Параметры.СуммаЗадолженностиПрописью    = РаботаСКурсамиВалют.СформироватьСуммуПрописью(ПараметрыВложения.СуммаЗадолженности, ПараметрыВложения.Валюта);
    Область.Параметры.Валюта                        = ПараметрыВложения.Валюта;
	Область.Параметры.СтавкаНДС                     = ПараметрыВложения.СтавкаНДС;
	
	ТабДок.Вывести(Область);
	
	ИмяВременногоФайла 		= ПолучитьИмяВременногоФайла("pdf");
	ТабДок.АвтоМасштаб 		= Истина;
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.PDF);
	ДвоичныеДанные 			= Новый ДвоичныеДанные(ИмяВременногоФайла);
	АдресДвоичныхДанных		= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат АдресДвоичныхДанных;	
КонецФункции  

Процедура ОтправитьПочтовоеУведомлениеОПриближенииСрокаПлатежей(ЗаказКлиента, СтруктураДанных)
		
	ВидСобытия = "ПриближениеСрокаПлатежаПоЗаказу";
	
	Если смартУведомления.ПолучитьИнформациюОПоследнемУведомлении(ЗаказКлиента, ВидСобытия).Объект = Неопределено Тогда
		
		СтруктураУведомления = ПолучитьСтруктуруУведомленияОПриближенииСрокаПлатежей(СтруктураДанных); 
	    смартУведомления.ОтправитьПочтовоеУведомление(ЗаказКлиента, ВидСобытия, СтруктураУведомления.Тема, СтруктураУведомления.Тело, СтруктураУведомления.Адреса, СтруктураУведомления.АдресаКопии, , СтруктураУведомления.Вложения);
		
	КонецЕсли;    
	
КонецПроцедуры

Функция ПолучитьСтруктуруУведомленияОПриближенииСрокаПлатежей(СтруктураДанных)	
	Результат 				= Новый Структура("Тема,Тело,Адреса,АдресаКопии,Вложения");
	
	Результат.Тема 			= СтрШаблон("По договору %1 с клиентом %2 приближается срок платежа", СтруктураДанных.НомерДоговора, СтруктураДанных.НаименованиеКлиента);
	Тело 					= ПолучитьТекстаПисьмаУведомленияОПриближенииСрокаПлатежей();
	Тело 					= СтрЗаменить(Тело, "%НаименованиеКлиента%",		СтруктураДанных.НаименованиеКлиента);
	Тело 					= СтрЗаменить(Тело, "%НаименованиеКонтрагента%", 	СтруктураДанных.НаименованиеКонтрагента);
	Тело 					= СтрЗаменить(Тело, "%ИННКонтрагента%", 			СтруктураДанных.ИННКонтрагента);
	Тело 					= СтрЗаменить(Тело, "%НомерДоговора%", 				СтруктураДанных.НомерДоговора);
	Тело 					= СтрЗаменить(Тело, "%ДатаДоговора%", 				Формат(СтруктураДанных.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	Тело 					= СтрЗаменить(Тело, "%НомерЗаказа%", 				СтруктураДанных.НомерЗаказа);
	Тело 					= СтрЗаменить(Тело, "%ДатаЗаказа%", 				Формат(СтруктураДанных.ДатаЗаказа, "ДФ=dd.MM.yyyy"));
	Тело 					= СтрЗаменить(Тело, "%СуммаЗадолженности%", 		СтруктураДанных.СуммаЗадолженности);
	Тело 					= СтрЗаменить(Тело, "%Валюта%",	 					СтруктураДанных.Валюта);
	
	Результат.Тело 			= Тело; 
	Получатели 				= Новый Массив;
	Получатели.Добавить(СтруктураДанных.Получатель1);
	Получатели.Добавить(СтруктураДанных.Получатель2);
	Результат.Адреса 		= смартУведомления.СформироватьАдресаПолучателейДляОтправки(Получатели);
	
	Вложение 				= Новый Структура("ИмяФайла, РасширениеФайла, Адрес");
	Вложение.Адрес 			= ПолучитьФайлУведомлениеОПриближенииСрокаОплаты(СтруктураДанных);
	Вложение.ИмяФайла 		= СтрШаблон("Уведомление о приближении срока оплаты по договору %1 от %2.pdf", СтруктураДанных.НомерДоговора, Формат(СтруктураДанных.ДатаДоговора, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("Вложения", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение));
	
	Возврат Результат;   						
КонецФункции

