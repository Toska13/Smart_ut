//++ #1544 смарт: Ермаков 17.01.2024 / Оптимизация отчетов  
// Возвращает период регистра "Выручка и себестоимость продаж" (ВиСП), 
// вычисленный от переданной даты закрытия заказа.
//
// Параметры:
//	ДатаЗакрытияЗаказа - Дата (без времени), начальная или конечная точка периода дат закрытия заказов;
//	Направление - Строка, определеяет какая именно часть стандартного периода была передана.
//				Варианты:
//					* НачалоПериода - вычисляется минимальный период для регистра;
//					* ОкончаниеПериода (или иное) - вычисляется максимальный период для регистра.
//
// Возвращаемое значение:
//	Дата - Период, который следует устанавливать в качестве стандартного периода для регистра ВиСП.
Функция КонвертироватьПериодЗакрытияЗаказовВПериодРегистраВиСП(Знач ДатаЗакрытияЗаказа, Знач Направление = "НачалоПериода") Экспорт

	Если Направление = "НачалоПериода" Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	НАЧАЛОПЕРИОДА(Заказы.Дата, ДЕНЬ) КАК Период
		|ИЗ
		|	Документ.ЗаказКлиента КАК Заказы	
		|ГДЕ
		|	Заказы.Проведен
		|	И НЕ Заказы.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|	И Заказы.ДатаЗакрытия >= &ДатаЗакрытияЗаказа		
		|УПОРЯДОЧИТЬ ПО
		|	Заказы.Дата ВОЗР
		|";	                     
		
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОНЕЦПЕРИОДА(МАКСИМУМ(Период), ДЕНЬ) КАК Период
		|ИЗ	
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж
		|ГДЕ
		|	НЕ смартДатаЗакрытияЗаказа = ДАТАВРЕМЯ(1, 1, 1)
		|	И смартДатаЗакрытияЗаказа <= &ДатаЗакрытияЗаказа
		|	И ТИПЗНАЧЕНИЯ(ЗаказКлиента) = ТИП(Документ.ЗаказКлиента)
		|";		
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаЗакрытияЗаказа", ДатаЗакрытияЗаказа);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Период, Дата(1, 1, 1));	
	
КонецФункции //-- #1544 смарт: Ермаков 17.01.2024 / Оптимизация отчетов

