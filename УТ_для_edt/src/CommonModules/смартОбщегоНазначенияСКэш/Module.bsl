Функция смартЗаполнитьКолонкуПотребность(СтруктураДокумента) Экспорт
	СписокНоменклатуры = ПолучитьИзВременногоХранилища(СтруктураДокумента.Адрес);
	СкладАнализа = СтруктураДокумента.Склад;
	ДатаЗаказа = СтруктураДокумента.ДатаЗаказа;
	ЗапросДат = Новый Запрос;
	ЗапросДат.УстановитьПараметр("Дата", ДатаЗаказа);
	ЗапросДат.Текст = "ВЫБРАТЬ ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -<КОЛМЕСЯЦЕВ>) КАК НачалоАнализа";
	Если СтруктураДокумента.МесяцевАнализ <> Неопределено Тогда
		ЗапросДат.Текст = СтрЗаменить(ЗапросДат.Текст,"<КОЛМЕСЯЦЕВ>",Строка(СтруктураДокумента.МесяцевАнализ));	
	Иначе
		ЗапросДат.Текст = СтрЗаменить(ЗапросДат.Текст,"<КОЛМЕСЯЦЕВ>","3");	
	КонецЕсли;	
	
	
	Выборка = ЗапросДат.Выполнить().Выбрать();
	Выборка.Следующий();
	АнализДатаНач = НачалоДня(Выборка.НачалоАнализа);
	АнализДатаКон = КонецДня(ДатаЗаказа);
	ЗаказДатаНач = НачалоДня(ДатаЗаказа);

	ЗапросДат = Новый Запрос;
	ЗапросДат.УстановитьПараметр("Дата", ДатаЗаказа);
	ЗапросДат.Текст = "  
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ <ДЗ>
		|	ПК.Дата КАК Дата,
		|	ПК.ВидДня КАК ДеньВключенВГрафик
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ПК
		|ГДЕ
		|    ПК.Дата >= &ДатаЗаказа
		|    И ПК.ВидДня = ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий)
		|";              
	Если СтруктураДокумента.ДнейЗаказа <> Неопределено Тогда
		ЗапросДат.Текст = СтрЗаменить(ЗапросДат.Текст,"<ДЗ>",Строка(СтруктураДокумента.ДнейЗаказа));	
	Иначе
		ЗапросДат.Текст = СтрЗаменить(ЗапросДат.Текст,"<ДЗ>","10");	
	КонецЕсли;	
	
	ЗапросДат.УстановитьПараметр("ДатаЗаказа",ДатаЗаказа);
	Выгрузка = ЗапросДат.Выполнить().Выгрузить();   
	ПоследняяЗапись = Выгрузка.Количество()-1;
	Выборка = Выгрузка.Получить(ПоследняяЗапись);
	ЗаказДатаКон = Выборка.Дата;
	
	Запрос = Новый Запрос;
	#Область ТекстЗапроса
	ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КалендарныеГрафики.ДатаГрафика КАК Дата,
		|	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньВключенВГрафик
		|ПОМЕСТИТЬ Вт_ПериодАнализаПоДням
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика МЕЖДУ &АнализДатаНач И &АнализДатаКон
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КалендарныеГрафики.ДатаГрафика КАК Дата,
		|	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньВключенВГрафик
		|ПОМЕСТИТЬ Вт_ПериодЗаказаПоДням
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		|ГДЕ
		|	КалендарныеГрафики.ДатаГрафика МЕЖДУ &ЗаказДатаНач И &ЗаказДатаКон
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПериодАнализ.РабочиеДни <> 0
		|			ТОГДА ПериодАнализ.РабочиеДни
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДнейАнализа,
		|	ВЫБОР
		|		КОГДА ПериодЗаказ.РабочиеДни <> 0
		|			ТОГДА ПериодЗаказ.РабочиеДни
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ДнейЗаказа
		|ПОМЕСТИТЬ Вт_РабочиеДниДвухПериодов
		|ИЗ
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Вт_ПериодАнализаПоДням.Дата) КАК РабочиеДни
		|	ИЗ
		|		Вт_ПериодАнализаПоДням КАК Вт_ПериодАнализаПоДням
		|	ГДЕ
		|		Вт_ПериодАнализаПоДням.ДеньВключенВГрафик) КАК ПериодАнализ,
		|	(ВЫБРАТЬ
		|		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Вт_ПериодЗаказаПоДням.Дата) КАК РабочиеДни
		|	ИЗ
		|		Вт_ПериодЗаказаПоДням КАК Вт_ПериодЗаказаПоДням
		|	ГДЕ
		|		Вт_ПериодЗаказаПоДням.ДеньВключенВГрафик) КАК ПериодЗаказ
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГрафикДвиженияТоваров.Регистратор КАК Регистратор,
		|	ВЫБОР
		|		КОГДА ГрафикДвиженияТоваров.Регистратор.ДокументОснование <> НЕОПРЕДЕЛЕНО
		|			ТОГДА ГрафикДвиженияТоваров.Регистратор.ДокументОснование
		|		ИНАЧЕ ГрафикДвиженияТоваров.Регистратор
		|	КОНЕЦ КАК Основание,
		|	ГрафикДвиженияТоваров.Номенклатура КАК Номенклатура,
		|	ГрафикДвиженияТоваров.Характеристика КАК Характеристика,
		|	ГрафикДвиженияТоваров.Склад КАК Склад,
		|	ГрафикДвиженияТоваров.КоличествоИзЗаказов КАК КоличествоСоСклада
		|ПОМЕСТИТЬ Вт_ВсеРезервы
		|ИЗ
		|	РегистрНакопления.ГрафикОтгрузкиТоваров КАК ГрафикДвиженияТоваров
		|ГДЕ
		|	ГрафикДвиженияТоваров.КоличествоИзЗаказов > 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ДокументОснование,
		|	ТоварыКОтгрузкеОстатки.Номенклатура,
		|	ТоварыКОтгрузкеОстатки.Характеристика,
		|	ТоварыКОтгрузкеОстатки.Склад,
		|	ВЫБОР
		|		КОГДА ТоварыКОтгрузкеОстатки.ВРезервеОстаток = 0
		|			ТОГДА ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
		|		ИНАЧЕ ТоварыКОтгрузкеОстатки.ВРезервеОстаток
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ТоварыКОтгрузкеОстатки.ВРезервеОстаток = 0
		|				ТОГДА ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток
		|			ИНАЧЕ ТоварыКОтгрузкеОстатки.ВРезервеОстаток
		|		КОНЕЦ > 0
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Набор.Расшифровка КАК Расшифровка,
		|	Набор.Номенклатура КАК Номенклатура,
		|	Набор.Характеристика КАК Характеристика,
		|	Набор.Склад КАК Склад,
		|	Набор.Документ КАК Документ,
		|	СУММА(Набор.ВНаличииНаСкладе) КАК ВНаличииНаСкладе,
		|	СУММА(Набор.ВозвратОтКлиента) КАК ВозвратОтКлиента,
		|	СУММА(Набор.РезервОбщий) КАК РезервОбщий,
		|	СУММА(Набор.РезервОплаченный) КАК РезервОплаченный,
		|	СУММА(Набор.Отгружается) КАК Отгружается,
		|	СУММА(Набор.ВТранзитеВнутр) КАК ВТранзитеВнутр,
		|	СУММА(Набор.ЗаказаноПоставщику) КАК ЗаказаноПоставщику,
		|	СУММА(Набор.ВТранзитеОтПоставщика) КАК ВТранзитеОтПоставщика,
		|	СУММА(Набор.ЗаказаноНаСкладе) КАК ЗаказаноНаСкладе,
		|	СУММА(Набор.ВТранзитеСоСклада) КАК ВТранзитеСоСклада,
		|	СУММА(Набор.Предзаказано) КАК Предзаказано
		|ПОМЕСТИТЬ Вт_ВсеОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		Т.Номенклатура КАК Номенклатура,
		|		Т.Характеристика КАК Характеристика,
		|		Т.Склад КАК Склад,
		|		NULL КАК Документ,
		|		Т.ВНаличииОстаток КАК ВНаличииНаСкладе,
		|		0 КАК ВозвратОтКлиента,
		|		0 КАК РезервОбщий,
		|		0 КАК РезервОплаченный,
		|		ВЫБОР
		|			КОГДА НЕ Т.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке
		|					ИЛИ &ТекущаяДата < Т.Склад.ДатаНачалаОрдернойСхемыПриОтгрузке
		|				ТОГДА Т.КОтгрузкеОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ КАК Отгружается,
		|		0 КАК ЗаказаноПоставщику,
		|		0 КАК ВТранзитеОтПоставщика,
		|		0 КАК ЗаказаноНаСкладе,
		|		0 КАК ВТранзитеСоСклада,
		|		0 КАК Предзаказано,
		|		0 КАК ВТранзитеВнутр,
		|		""Остаток на складе"" КАК Расшифровка
		|	ИЗ
		|		РегистрНакопления.ТоварыНаСкладах.Остатки(
		|				,
		|				Склад = &Склад
		|					И Номенклатура В (&СписокНоменклатуры)) КАК Т
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Вт_ВсеРезервы.Номенклатура,
		|		Вт_ВсеРезервы.Характеристика,
		|		Вт_ВсеРезервы.Склад,
		|		Вт_ВсеРезервы.Регистратор,
		|		0,
		|		0,
		|		Вт_ВсеРезервы.КоличествоСоСклада,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		""Резерв общий""
		|	ИЗ
		|		Вт_ВсеРезервы КАК Вт_ВсеРезервы
		|	ГДЕ
		|		Вт_ВсеРезервы.Склад = &Склад
		|		И Вт_ВсеРезервы.Номенклатура В(&СписокНоменклатуры)
		|		И Вт_ВсеРезервы.КоличествоСоСклада <> 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Вт_ВсеРезервы.Номенклатура,
		|		Вт_ВсеРезервы.Характеристика,
		|		Вт_ВсеРезервы.Склад,
		|		Вт_ВсеРезервы.Регистратор,
		|		0,
		|		0,
		|		0,
		|		Вт_ВсеРезервы.КоличествоСоСклада,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		""Резерв оплаченный""
		|	ИЗ
		|		Вт_ВсеРезервы КАК Вт_ВсеРезервы
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК Оплаты
		|			ПО Вт_ВсеРезервы.Регистратор = Оплаты.Заказ
		|				И (Вт_ВсеРезервы.КоличествоСоСклада > 0)
		|				И (Оплаты.ПроцентОплаты > 0)
		|	ГДЕ
		|		Вт_ВсеРезервы.Склад = &Склад
		|		И Вт_ВсеРезервы.Номенклатура В(&СписокНоменклатуры)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Т.Номенклатура,
		|		Т.Характеристика,
		|		Т.Склад,
		|		Т.ДокументОтгрузки,
		|		0,
		|		0,
		|		0,
		|		0,
		|		ВЫБОР
		|			КОГДА Т.ДокументОтгрузки ССЫЛКА Документ.РеализацияТоваровУслуг
		|				ТОГДА Т.КОтгрузкеОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		""Отгрузка""
		|	ИЗ
		|		РегистрНакопления.ТоварыКОтгрузке.Остатки(
		|				,
		|				Склад = &Склад
		|					И Номенклатура В (&СписокНоменклатуры)) КАК Т
		|	{ГДЕ
		|		Т.Характеристика.*}
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ТоварыКПоступлениюОстатки.Номенклатура,
		|		ТоварыКПоступлениюОстатки.Характеристика,
		|		ТоварыКПоступлениюОстатки.Склад,
		|		ТоварыКПоступлениюОстатки.ДокументПоступления,
		|		0,
		|		ТоварыКПоступлениюОстатки.КОформлениюОрдеровОстаток,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		""К поступлению""
		|	ИЗ
		|		РегистрНакопления.ТоварыКПоступлению.Остатки(
		|				,
