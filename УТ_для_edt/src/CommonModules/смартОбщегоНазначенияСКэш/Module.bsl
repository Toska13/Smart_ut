		|		ВложенныйЗапрос.Характеристика
		|	) КАК ВложенныйЗапрос
		|";
	#КонецОбласти
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("АнализДатаНач",АнализДатаНач);
