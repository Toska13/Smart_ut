Функция смартПредопределенныеЗначенияКэш(СсылкаПредопределенное) Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   смартПредопределенныеЗначения.Значение КАК Значение,
        |   NULL КАК К2,
        |   NULL КАК К3,
        |   NULL КАК К4
        |ИЗ
        |   Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
        |ГДЕ
        |   смартПредопределенныеЗначения.Ссылка = &Ссылка
        |   И НЕ смартПредопределенныеЗначения.СписокЗначений
        |   И НЕ смартПредопределенныеЗначения.ИспользоватьТЧСписокЗначений
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ РАЗЛИЧНЫЕ
        |   смартПредопределенныеЗначенияЗначения.Значение,
        |   NULL,
        |   NULL,
        |   NULL
        |ИЗ
        |   Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
        |ГДЕ
        |   смартПредопределенныеЗначенияЗначения.Ссылка = &Ссылка
        |   И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
        |
        |ОБЪЕДИНИТЬ ВСЕ
        |
        |ВЫБРАТЬ
        |   смартПредопределенныеЗначенияТЧСписокЗначений.к1,
        |   смартПредопределенныеЗначенияТЧСписокЗначений.к2,
        |   смартПредопределенныеЗначенияТЧСписокЗначений.к3,
        |   смартПредопределенныеЗначенияТЧСписокЗначений.к4
        |ИЗ
        |   Справочник.смартПредопределенныеЗначения.ТЧСписокЗначений КАК смартПредопределенныеЗначенияТЧСписокЗначений
        |ГДЕ
        |   смартПредопределенныеЗначенияТЧСписокЗначений.Ссылка = &Ссылка
        |   И смартПредопределенныеЗначенияТЧСписокЗначений.Ссылка.ИспользоватьТЧСписокЗначений";
    
    Запрос.УстановитьПараметр("Ссылка", СсылкаПредопределенное);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
    МассивРезультат=Новый Массив;
    Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
        ФиксСтруктура=Новый Структура("Значение,К2,К3,К4"); 
        ФиксСтруктура.Значение=ВыборкаДетальныеЗаписи.Значение;
        ФиксСтруктура.К2=ВыборкаДетальныеЗаписи.К2;
        ФиксСтруктура.К3=ВыборкаДетальныеЗаписи.К3;
        ФиксСтруктура.К4=ВыборкаДетальныеЗаписи.К4;
        МассивРезультат.Добавить(ФиксСтруктура);    
    КонецЦикла;
    
    Возврат МассивРезультат;
    
КонецФункции//-- смарт:Подкин # 06.06.2022 12:02:34 

