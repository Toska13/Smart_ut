// Проверяет, используется ли серийный учет для номенклатуры на указанном складе
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - номенклатура для проверки
//  Склад - СправочникСсылка.Склады - склад для проверки
//  Дата - Дата - дата на которую проверяется настройка
//
// Возвращаемое значение:
//  Булево - Истина, если используется серийный учет
//
Функция ИспользуетсяСерийныйУчетДляНоменклатурыИСклада(Номенклатура, Склад) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Или НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидНоменклатуры = Номенклатура.ВидНоменклатуры;
	
	Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.ПолитикаУчетаСерий КАК ПолитикаУчетаСерий,
	|	ВидыНоменклатуры.ИспользоватьСерии КАК ИспользоватьСерии
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|ГДЕ
	|	ВидыНоменклатуры.Ссылка = &ВидНоменклатуры";
	
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если НЕ Выборка.ИспользоватьСерии Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Выборка.ПолитикаУчетаСерий) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗапросПолитики = Новый Запрос;
	ЗапросПолитики.Текст =
	"ВЫБРАТЬ
	|	ПолитикиУчетаСерийНаСкладах.ПолитикаУчетаСерий КАК ПолитикаУчетаСерий
	|ИЗ
	|	Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ПолитикиУчетаСерийНаСкладах
	|ГДЕ
	|	ПолитикиУчетаСерийНаСкладах.Склад = &Склад
	|	И ПолитикиУчетаСерийНаСкладах.Ссылка = &ВидНоменклатуры";
	
	ЗапросПолитики.УстановитьПараметр("Склад", Склад);
	ЗапросПолитики.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	
	РезультатЗапросаПолитики = ЗапросПолитики.Выполнить();
	
	Если НЕ РезультатЗапросаПолитики.Пустой() Тогда
		ВыборкаПолитики = РезультатЗапросаПолитики.Выбрать();
		ВыборкаПолитики.Следующий();
		Возврат ЗначениеЗаполнено(ВыборкаПолитики.ПолитикаУчетаСерий);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Выборка.ПолитикаУчетаСерий);
	
КонецФункции