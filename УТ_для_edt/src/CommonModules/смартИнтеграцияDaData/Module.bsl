#Область Прочее

// Сериализует структуру, соответствие, массив в строку JSON
//
// Параметры:
//  Объект - структура, соответствие, массив
//
// Возвращаемое значение:
//  Строка - сериализованный объект в виде строки JSON.
//
Функция ЗаписатьОбъектВJSON(Объект)
	
	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "	", Истина);
    Запись.УстановитьСтроку(ПараметрыЗаписи);
    ЗаписатьJSON(Запись, Объект);
	
    Возврат Запись.Закрыть();
	
КонецФункции

// Десериализует строку JSON в соответствие
//
// Параметры:
//  Строка - Строка
//
// Возвращаемое значение:
//  Соответствие.
//
Функция ПрочитатьОбъектИзJSON(Строка)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Строка);
	Попытка
    	Объект = ПрочитатьJSON(Чтение);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Объект = Неопределено;
		ЗаписьЖурналаРегистрации("ЧтениеJSON", УровеньЖурналаРегистрации.Ошибка, , ОписаниеОшибки,ОписаниеОшибки);
	КонецПопытки;
	
    Возврат Объект;
	
КонецФункции

#КонецОбласти

#Область ВыводДанныхНаФорму

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Процедура ВывестиНаФормуИнформациюПоКонтрагенту(ИНН, Форма) Экспорт
	
	//Инициализация групп формы
	ИнициализироватьГруппыИнформацииПоКонтрагенту(Форма);	
	
	//Получение данных DaData
	ДанныеКонтрагента = смартИнтеграцияDaDataПовтИсп.ВыполнитьЗапросПолучитьДанныеОрганизацииПоИНН(ИНН);
	
	Если ТипЗнч(ДанныеКонтрагента) = Тип("Структура") 
		И ДанныеКонтрагента.Свойство("suggestions") 
		И ТипЗнч(ДанныеКонтрагента.suggestions) = Тип("Массив") Тогда
		
		КоличествоЭлементов = ДанныеКонтрагента.suggestions.Количество();
		
		Если КоличествоЭлементов > 0 Тогда
			
			ИндексДанных = Неопределено;
			
			Если КоличествоЭлементов = 1 Тогда
				
				ИндексДанных = 0;
				
			Иначе
				
				МаксимальнаяДата = Дата(1, 1, 1);
				
				Для Каждого ЭлементДанных Из ДанныеКонтрагента.suggestions Цикл
					
					Если ТипЗнч(ЭлементДанных) = Тип("Структура") 
						И ЭлементДанных.Свойство("data") Тогда
						
						ТекущийИндекс = ДанныеКонтрагента.suggestions.Найти(ЭлементДанных);
						
						//Проверка что это головная организация
						Если ЭлементДанных.data.Свойство("branch_type") 
							И ЭлементДанных.data.branch_type = "MAIN" Тогда
							
							ИндексДанных = ТекущийИндекс;
							
							Прервать;
							
						КонецЕсли;	

						//Вычисляем максимальную дату выдачи ОГРН
						Если ЭлементДанных.data.Свойство("ogrn_date") Тогда
							
							ДатаОГРН = ПреобразоватьЧислоКДатеDaData(ЭлементДанных.data.ogrn_date);
							
							Если ТипЗнч(ДатаОГРН) = Тип("Дата") 
								И ДатаОГРН > МаксимальнаяДата Тогда
								
								ИндексДанных 	 = ТекущийИндекс;
								МаксимальнаяДата = ДатаОГРН;
								
							КонецЕсли;	
							
						КонецЕсли;	
						
					КонецЕсли;
					
				КонецЦикла;	

				Если ИндексДанных = Неопределено Тогда
					
					ИндексДанных = 0;
					
				КонецЕсли;
				
			КонецЕсли;
				
			Если ИндексДанных <> Неопределено Тогда
				
				//Подготовка перечня выводимых реквизитов
				ДеревоВыводимыхПолей = ПолучитьДеревоВыводимыхПолейDaData(ДанныеКонтрагента.suggestions[ИндексДанных].data);	
				
				//Вывод информации на форму
				СформироватьНаФормеИнформациюПоКонтрагентуПоДеревуПолей(Форма, ДеревоВыводимыхПолей);

			КонецЕсли;

		КонецЕсли;
			
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-1018 смарт: Лопато 07.10.2024

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Процедура ИнициализироватьГруппыИнформацииПоКонтрагенту(Форма)
	
	Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.ПомощникНового" Тогда

		Форма.Элементы.Переместить(Форма.Элементы.СтраницыКомпанияЧастноеЛицо, Форма.Элементы.СтраницаПервичнаяИнформация);
		
		ГруппаИнформацияОКонтрагентеОбщая = Форма.Элементы.Найти("ГруппаИнформацияОКонтрагентеОбщая");
		
		Если ГруппаИнформацияОКонтрагентеОбщая <> Неопределено Тогда
			Форма.Элементы.Удалить(ГруппаИнформацияОКонтрагентеОбщая);
		КонецЕсли;	
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Контрагенты.Форма.ФормаЭлемента" Тогда

		Если Форма.ВидКонтрагента = "ЮрЛицоНеРезидент" Тогда
			
			ГруппаРодительИнформации = Форма.Элементы.ГруппаСтраницаИностраннойРегистрации;
			
			ГруппаРодительИнформации.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
			
			Форма.Элементы.Переместить(Форма.Элементы.ГруппаСтранаРегистрацииНалоговыйНомер, ГруппаРодительИнформации);
			Форма.Элементы.Переместить(Форма.Элементы.ГруппаРегистрационныйНомерИННКПП, ГруппаРодительИнформации);
			
		КонецЕсли;	
		
		ГруппаИнформацияОКонтрагентеОбщаяСтраница = Форма.Элементы.Найти("ГруппаИнформацияОКонтрагентеОбщаяСтраница");
		
		Если ГруппаИнформацияОКонтрагентеОбщаяСтраница <> Неопределено Тогда
			Форма.Элементы.Удалить(ГруппаИнформацияОКонтрагентеОбщаяСтраница);
		КонецЕсли;	

		ГруппаИнформацияОКонтрагентеОбщаяСтраницаОбъединение = Форма.Элементы.Найти("ГруппаИнформацияОКонтрагентеОбщаяСтраницаОбъединение");
		
		Если ГруппаИнформацияОКонтрагентеОбщаяСтраницаОбъединение <> Неопределено Тогда
			Форма.Элементы.Удалить(ГруппаИнформацияОКонтрагентеОбщаяСтраницаОбъединение);
		КонецЕсли;	
		
	КонецЕсли;	

КонецПроцедуры //-- #Б-1018 смарт: Лопато 07.10.2024	

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Функция ПолучитьДеревоВыводимыхПолейDaData(data)
	
	СписокБлоков = Новый СписокЗначений;
	
	//Состояние
	ГруппаСостояние = Новый СписокЗначений;
	
	СооответствиеСтатусовОрганизаций = Новый Соответствие;
	
	СооответствиеСтатусовОрганизаций.Вставить("ACTIVE", 	  "Действующая"); 
	СооответствиеСтатусовОрганизаций.Вставить("LIQUIDATING",  "Ликвидируется"); 
	СооответствиеСтатусовОрганизаций.Вставить("LIQUIDATED",   "Ликвидирована"); 
	СооответствиеСтатусовОрганизаций.Вставить("BANKRUPT", 	  "Банкротство"); 
	СооответствиеСтатусовОрганизаций.Вставить("REORGANIZING", "В процессе присоединения к другому юрлицу, с последующей ликвидацией"); 
	
	Если СооответствиеСтатусовОрганизаций.Получить(data.state.status) <> Неопределено Тогда
		СтатусОрганизации = СооответствиеСтатусовОрганизаций[data.state.status];
	Иначе
		СтатусОрганизации = data.state.status;	
	КонецЕсли;
	
	ГруппаСостояние.Добавить(СтатусОрганизации, 										  			  			   "Статус организации");
	ГруппаСостояние.Добавить(Формат(ПреобразоватьЧислоКДатеDaData(data.state.registration_date), "ДФ=dd.MM.yyyy"), "Дата регистрации");
	ГруппаСостояние.Добавить(Формат(ПреобразоватьЧислоКДатеDaData(data.state.actuality_date),    "ДФ=dd.MM.yyyy"), "Дата последних изменений");
	
	Если ЗначениеЗаполнено(data.state.liquidation_date) Тогда 
		ГруппаСостояние.Добавить(Формат(ПреобразоватьЧислоКДатеDaData(data.state.liquidation_date), "ДФ=dd.MM.yyyy"), "Дата ликвидации");
	КонецЕсли;	
	
	СписокБлоков.Добавить(ГруппаСостояние, "Состояние");
	
	//Информация об организации
	ГруппаИнформация = Новый СписокЗначений;
	
	ГруппаИнформация.Добавить(?(data.type = "LEGAL", 
								"Юридическое лицо", 
								"Индивидуальный предприниматель"), "Тип организации");

	ГруппаИнформация.Добавить(?(data.type = "LEGAL", 
								data.name.full_with_opf, 
								data.name.full), 				   "Полное наименование");
								
	//++ #Б-2628 смарт: Лопато 11.03.2025 //Получение и вывод информации о контрагенте из сервиса dadata.ru  
	Если data.Свойство("founders") И ТипЗнч(data.founders) = Тип("Массив") Тогда
		
		Для Каждого СтрУчредитель Из data.founders Цикл

			Если СтрУчредитель.Свойство("type") 
				И СтрУчредитель.type = "LEGAL"
				И СтрУчредитель.Свойство("name") Тогда
				
				ГруппаИнформация.Добавить(СтрУчредитель.name,   "Учредитель");
				
			ИначеЕсли СтрУчредитель.Свойство("type") 
				И СтрУчредитель.type = "PHYSICAL"
				И СтрУчредитель.Свойство("fio") 
				И ТипЗнч(СтрУчредитель.fio) = Тип("Структура")
				И СтрУчредитель.fio.Свойство("source") Тогда
				
				ГруппаИнформация.Добавить(СтрУчредитель.fio.source, "Учредитель");
				
			КонецЕсли;

			Если СтрУчредитель.Свойство("share")
				И ТипЗнч(СтрУчредитель.share) = Тип("Структура") Тогда
				
				Если СтрУчредитель.share.Свойство("type")
					И (СтрУчредитель.share.type = "PERCENT" ИЛИ СтрУчредитель.share.type = "DECIMAL")
					И СтрУчредитель.share.Свойство("value") Тогда
				
					ГруппаИнформация.Добавить(СокрЛП(СтрУчредитель.share.value)
											  + ?(СтрУчредитель.share.type = "PERCENT", "%", ""), "Доля учредителя");
					
				ИначеЕсли СтрУчредитель.share.Свойство("type")
					И СтрУчредитель.share.type = "FRACTION"
					И СтрУчредитель.share.Свойство("numerator")
					И СтрУчредитель.share.Свойство("denominator") Тогда
				
					ГруппаИнформация.Добавить(СокрЛП(СтрУчредитель.share.numerator) + "/" 
											  + СокрЛП(СтрУчредитель.share.denominator), "Доля учредителя");
				
				КонецЕсли;
										  
			КонецЕсли;
			
		КонецЦикла;	
			
	КонецЕсли;	

	Если data.Свойство("managers") И ТипЗнч(data.managers) = Тип("Массив") Тогда
		
		Для Каждого СтрРуководитель Из data.managers Цикл

			Если СтрРуководитель.Свойство("type") 
				И СтрРуководитель.type = "LEGAL"
				И СтрРуководитель.Свойство("name") Тогда
				
				ГруппаИнформация.Добавить(СтрРуководитель.name, "Руководитель");
				
			ИначеЕсли СтрРуководитель.Свойство("type") 
				И СтрРуководитель.type = "EMPLOYEE"
				И СтрРуководитель.Свойство("fio") 
				И ТипЗнч(СтрРуководитель.fio) = Тип("Структура")
				И СтрРуководитель.fio.Свойство("source")
				И СтрРуководитель.Свойство("post") Тогда
				
				ГруппаИнформация.Добавить(СтрРуководитель.fio.source, СтрРуководитель.post);
				
			КонецЕсли;
			
		КонецЦикла;	
			
	КонецЕсли;	
	//-- #Б-2628 смарт: Лопато 11.03.2025
								
	ГруппаИнформация.Добавить(data.employee_count,				   "Численность работников");
	
	Если ТипЗнч(data.address) = Тип("Структура") И data.address.Свойство("unrestricted_value") Тогда
		ГруппаИнформация.Добавить(data.address.unrestricted_value, "Адрес");
	КонецЕсли;	
	
	СписокБлоков.Добавить(ГруппаИнформация, "Информация об организации");

	//Финансовые показатели за год
	Если ТипЗнч(data.finance) = Тип("Структура") Тогда

		ГруппаФинансовыеПоказатели = Новый СписокЗначений;
		
		ГруппаФинансовыеПоказатели.Добавить(СтрЗаменить(Строка(data.finance.year), " ", ""), "Год бух. отчетности");
		
		ГруппаФинансовыеПоказатели.Добавить(Формат(data.finance.income,  "ЧДЦ=2"), "Доходы");
		ГруппаФинансовыеПоказатели.Добавить(Формат(data.finance.revenue, "ЧДЦ=2"), "Выручка");
		ГруппаФинансовыеПоказатели.Добавить(Формат(data.finance.expense, "ЧДЦ=2"), "Расходы");
		ГруппаФинансовыеПоказатели.Добавить(Формат(data.finance.debt, 	 "ЧДЦ=2"), "Недоимки по налогам");
		ГруппаФинансовыеПоказатели.Добавить(Формат(data.finance.penalty, "ЧДЦ=2"), "Налоговые штрафы");
	
		СписокБлоков.Добавить(ГруппаФинансовыеПоказатели, "Финансовые показатели за год");
		
	КонецЕсли;	
	
	Возврат СписокБлоков;
	
КонецФункции //-- #Б-1018 смарт: Лопато 07.10.2024	

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Процедура СформироватьНаФормеИнформациюПоКонтрагентуПоДеревуПолей(Форма, ДеревоВыводимыхПолей)
	
