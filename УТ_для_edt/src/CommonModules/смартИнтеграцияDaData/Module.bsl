	ГруппаИнформацияОКонтрагентеОбщаяВертикальная.ОтображатьЗаголовок = Ложь;
	
	Если НЕ ВыбранныйИНН = "" Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ассоциация.Наименование КАК АссоциацияНаименование
		|ИЗ
		|	РегистрСведений.смартСоставПрофильныхАссоциаций
		|ГДЕ
		|	ИНН = &ИНН");
		Запрос.УстановитьПараметр("ИНН", ВыбранныйИНН);
		
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			
			ТекстДекорации = "Клиент является участником следующих ассоциаций:";
			
			Выборка = Результат.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ТекстДекорации = ТекстДекорации + Символы.ПС + """" +  Выборка.АссоциацияНаименование + """";		
				
			КонецЦикла;	
			
			ГруппаИнформацияОбАссоциациях = Форма.Элементы.Добавить("ГруппаИнформацияОбАссоциациях", Тип("ГруппаФормы"), ГруппаИнформацияОКонтрагентеОбщаяВертикальная);
