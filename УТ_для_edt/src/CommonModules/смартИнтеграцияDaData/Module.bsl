#Область ПрограммныйИнтерфейс

// Выполняет запрос к сервису DaData для поиска организации по ИНН или ОГРН
//
// Параметры:
//  ИНН - строка - ИНН или ОГРН организации, данные по которой требуется найти
//
// Возвращаемое значение:
//  ???
//
Функция ВыполнитьЗапросПолучитьДанныеОрганизацииПоИНН(ИНН) Экспорт
	
	Данные = Неопределено;
	
	АдресВнутриСайта = ПолучитьАдресСервисаПолучитьДанныеОрганизацииПоИНН();
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("query", ИНН);
	
	Результат = ВыполнитьЗапросКСервисуDaData(АдресВнутриСайта, ЗаписатьОбъектВJSON(ПараметрыЗапроса));
	
	Если Результат <> Неопределено И Результат.КодСостояния = 200 Тогда
		
		Данные = ПрочитатьОбъектИзJSON(Результат.ПолучитьТелоКакСтроку());
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция ВыполнитьЗапросПолучитьИнформациюПоАдресу(Адрес) Экспорт
	
	Данные = Неопределено;
	
	АдресСервера = "cleaner.dadata.ru";
	АдресВнутриСайта = "api/v1/clean/address";
	
	Результат = ВыполнитьЗапросКСервисуDaData(АдресВнутриСайта, СтрШаблон("[ ""%1"" ]", Адрес),, Истина, АдресСервера);
	
	Если Результат <> Неопределено И Результат.КодСостояния = 200 Тогда
		Данные = ПрочитатьОбъектИзJSON(Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет запрос к сервису DaData и возвращает результат
//
// Параметры:
//  АдресВнутриСайта - строка - адрес вызываемого метода DaData
//  Тело - строка, ДвоичныеДанные - в случае POST запроса тело запроса передаваемое в сервис
//  ВидЗапроса - строка - вид вызываемого метода GET, POST
//  ТребуетсяПередаватьСекретныйКлюч - булево - признак того, что при вызове запроса требуется передавать не только API ключ, но и секретный
//
// Возвращаемое значение:
//  HTTPОтвет - ответ полученный от сервера или неопределено, в случае неизвестного вида запроса.
//
Функция ВыполнитьЗапросКСервисуDaData(АдресВнутриСайта, Тело = Неопределено, ВидЗапроса = "POST", ТребуетсяПередаватьСекретныйКлюч = Ложь, АдресСервера = Неопределено) Экспорт
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type",  "application/json");
	Заголовки.Вставить("Accept", 		"application/json");
	Заголовки.Вставить("Authorization", СтрШаблон("Token %1", ПолучитьТокенАвторизации()));
	Если ТребуетсяПередаватьСекретныйКлюч Тогда
		Заголовки.Вставить("X-Secret", ПолучитьСекретныйКлюч());
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресСервера) Тогда
		АдресСервера = ПолучитьБазовыйАдресСервиса();
	КонецЕсли;
	
	Если ВРЕГ(ВидЗапроса) = "GET" Тогда
		Возврат ВыполнитьGetЗапрос(АдресСервера, АдресВнутриСайта, , , , , , , Заголовки);
	ИначеЕсли ВРЕГ(ВидЗапроса) = "POST" Тогда
		Возврат ВыполнитьPOSTЗапрос(АдресСервера, АдресВнутриСайта, , , , , , , Заголовки, Тело);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Отправляет GET запрос на HTTP сервер
//
// Параметры:
//  АдресСервера - строка - адрес сервера(сайта)
//  АдресВнутриСайта - строка - путь к методу, внутри сайта
//  Порт - число - порт подключения, по умолчанию 80
//  Пользователь - строка - пользователь авторизации подключения
//  Пароль - строка - пароль авторизации подключения
//  Прокси - ИнтернетПрокси - если подключение идет через прокси
//  Таймаут - число - сколько ждать ответа
//  ЗащищенноеСоединение - ЗащищенноеСоединениеOpenSSL - если подключение идет по HTTPS
//  Заголовки - Соответствие - Массив заголовков запроса
//
// Возвращаемое значение:
//   HTTPОтвет - ответ полученный от сервера.
//
Функция ВыполнитьGetЗапрос(АдресСервера, АдресВнутриСайта, Порт = 80, Пользователь = "", Пароль = "", Прокси = Неопределено, Таймаут = 0, ЗащищенноеСоединение = Неопределено, Заголовки = Неопределено) Экспорт
 
    Соединение = Новый HTTPСоединение(
        АдресСервера, // сервер (хост)
        Порт, // порт, по умолчанию для http используется 80, для https 443
        Пользователь, // пользователь для доступа к серверу (если он есть)
        Пароль, // пароль для доступа к серверу (если он есть)
        Прокси, // здесь указывается прокси, если он есть
        Таймаут, // таймаут в секундах, 0 или пусто - не устанавливать
        ЗащищенноеСоединение  // защищенное соединение, если используется https
    );
 
    Запрос = Новый HTTPЗапрос(АдресВнутриСайта, Заголовки);
 
    Результат = Соединение.Получить(Запрос);
	
	Возврат Результат;
 
КонецФункции

// Отправляет POST запрос на HTTP сервер
//
// Параметры:
//  АдресСервера - строка - адрес сервера(сайта)
//  АдресВнутриСайта - строка - путь к методу, внутри сайта
//  Порт - число - порт подключения, по умолчанию 80
//  Пользователь - строка - пользователь авторизации подключения
//  Пароль - строка - пароль авторизации подключения
//  Прокси - ИнтернетПрокси - если подключение идет через прокси
//  Таймаут - число - сколько ждать ответа
//  ЗащищенноеСоединение - ЗащищенноеСоединениеOpenSSL - если подключение идет по HTTPS
//  Заголовки - Соответствие - Массив заголовков запроса
//  Тело - Строка, ДвоичныеДанные - данные передаваемые в теле запроса
//
// Возвращаемое значение:
//   HTTPОтвет - ответ полученный от сервера.
//
Функция ВыполнитьPOSTЗапрос(АдресСервера, АдресВнутриСайта, Порт = 80, Пользователь = "", Пароль = "", Прокси = Неопределено, Таймаут = 0, ЗащищенноеСоединение = Неопределено, Заголовки = Неопределено, Тело = Неопределено) Экспорт
 
    Соединение = Новый HTTPСоединение(
        АдресСервера, // сервер (хост)
        Порт, // порт, по умолчанию для http используется 80, для https 443
        Пользователь, // пользователь для доступа к серверу (если он есть)
        Пароль, // пароль для доступа к серверу (если он есть)
        Прокси, // здесь указывается прокси, если он есть
        Таймаут, // таймаут в секундах, 0 или пусто - не устанавливать
        ЗащищенноеСоединение  // защищенное соединение, если используется https
    );
 
    Запрос = Новый HTTPЗапрос(АдресВнутриСайта, Заголовки);
	
	Если НЕ Тело = Неопределено И ТипЗнч(Тело) = Тип("Строка") Тогда
		Запрос.УстановитьТелоИзСтроки(Тело);
	ИначеЕсли НЕ Тело = Неопределено И ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
	КонецЕсли;
 
    Результат = Соединение.ОтправитьДляОбработки(Запрос);
	
	Возврат Результат;
 
КонецФункции

