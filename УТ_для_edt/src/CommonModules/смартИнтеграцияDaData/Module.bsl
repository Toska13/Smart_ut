	ГруппаИнформацияОКонтрагентеБлоки.ЦветФона 			  = Новый Цвет(255, 255, 255); 
    ГруппаИнформацияОКонтрагентеБлоки.ОтображатьЗаголовок = Ложь;
	
	//Вывод блоков информации
	Для Каждого БлокИнформации Из ДеревоВыводимыхПолей Цикл
		
		ИмяГруппыБлока = "ГруппаИнформацияОКонтрагентеБлок" + СтрЗаменить(СтрЗаменить(БлокИнформации.Представление, " ", ""), ".", "");
		
		ГруппаБлокИнформации = Форма.Элементы.Добавить(ИмяГруппыБлока, Тип("ГруппаФормы"), ГруппаИнформацияОКонтрагентеБлоки);
		ГруппаБлокИнформации.Вид 				 = ВидГруппыФормы.ОбычнаяГруппа;
	    ГруппаБлокИнформации.Группировка 		 = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	    ГруппаБлокИнформации.ОтображатьЗаголовок = Ложь;
		
		ИмяГруппыЗаголовок = ИмяГруппыБлока + "Заголовок";
		
		НоваяСтрокаИнформацииГруппаЗаголовок = Форма.Элементы.Добавить(ИмяГруппыЗаголовок, Тип("ГруппаФормы"), ГруппаБлокИнформации);
		НоваяСтрокаИнформацииГруппаЗаголовок.Вид 				 = ВидГруппыФормы.ОбычнаяГруппа;
	    НоваяСтрокаИнформацииГруппаЗаголовок.Группировка 		 = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	    НоваяСтрокаИнформацииГруппаЗаголовок.ОтображатьЗаголовок = Истина;
		
		НоваяДекорация = Форма.Элементы.Добавить(ИмяГруппыЗаголовок + "Декорация1", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппаЗаголовок);
		НоваяДекорация.Ширина = 0;
		
		НоваяДекорацияЗаголовок = Форма.Элементы.Добавить(ИмяГруппыЗаголовок + "ДекорацияЗаголовок", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппаЗаголовок);
		НоваяДекорацияЗаголовок.Заголовок = БлокИнформации.Представление;
		НоваяДекорацияЗаголовок.Шрифт 	  = Новый Шрифт(, , Истина);
		
		//++ #Б-2628 смарт: Лопато 11.03.2025 //Получение и вывод информации о контрагенте из сервиса dadata.ru  
		Счетчик = 1;
		//-- #Б-2628 смарт: Лопато 11.03.2025
		
		//Вывод строк информации
		Для Каждого СтрокаБлока Из БлокИнформации.Значение Цикл
			
			//++ #Б-2628 смарт: Лопато 11.03.2025 //Получение и вывод информации о контрагенте из сервиса dadata.ru  
			ИмяСтроки = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрокаБлока.Представление, " ", ""), ".", "") + СтрЗаменить(СокрЛП(Счетчик), Символы.НПП, ""), "-", "");
			//-- #Б-2628 смарт: Лопато 11.03.2025
			ИмяГруппыСтрокиБлока = ИмяГруппыБлока + ИмяСтроки; 
			
			НоваяСтрокаИнформацииГруппа = Форма.Элементы.Добавить(ИмяГруппыСтрокиБлока, Тип("ГруппаФормы"), ГруппаБлокИнформации);
			НоваяСтрокаИнформацииГруппа.Вид 				= ВидГруппыФормы.ОбычнаяГруппа;
		    НоваяСтрокаИнформацииГруппа.Группировка 		= ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		    НоваяСтрокаИнформацииГруппа.ОтображатьЗаголовок = Ложь;
			
			НоваяДекорация = Форма.Элементы.Добавить(ИмяГруппыСтрокиБлока + "ДекорацияНачало", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппа);
			НоваяДекорация.АвтоМаксимальнаяШирина = Истина;
			НоваяДекорация.Ширина = 1;
			
			НоваяДекорацияЗаголовок = Форма.Элементы.Добавить(ИмяГруппыСтрокиБлока + "Имя", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппа);
			НоваяДекорацияЗаголовок.Заголовок = СтрокаБлока.Представление;
			НоваяДекорацияЗаголовок.Ширина = 17;
			
			НоваяДекорацияЗначение = Форма.Элементы.Добавить(ИмяГруппыСтрокиБлока + "Значение", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппа);
			НоваяДекорацияЗначение.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента .Право;
			НоваяДекорацияЗначение.Заголовок 			   = Строка(СтрокаБлока.Значение);
			НоваяДекорацияЗначение.Шрифт 				   = Новый Шрифт(, , Истина);
			НоваяДекорацияЗначение.Ширина 				   = 26;
			
			//++ #Б-2628 смарт: Лопато 11.03.2025 //Получение и вывод информации о контрагенте из сервиса dadata.ru  
			Если СтрНайти(ИмяСтроки, "Статусорганизации") <> 0 Тогда
			//-- #Б-2628 смарт: Лопато 11.03.2025
				Если НоваяДекорацияЗначение.Заголовок = "Действующая" Тогда
					НоваяДекорацияЗначение.ЦветТекста = Новый Цвет(0, 150, 70);
				Иначе
					НоваяДекорацияЗначение.ЦветТекста = Новый Цвет(255, 0, 0);
				КонецЕсли;	
			КонецЕсли;
			
			НоваяДекорация = Форма.Элементы.Добавить(ИмяГруппыСтрокиБлока + "ДекорацияКонец", Тип("ДекорацияФормы"), НоваяСтрокаИнформацииГруппа);
			НоваяДекорация.АвтоМаксимальнаяШирина = Истина;
			НоваяДекорация.Ширина = 1;
			
			//++ #Б-2628 смарт: Лопато 11.03.2025 //Получение и вывод информации о контрагенте из сервиса dadata.ru  
			Счетчик = Счетчик + 1;
			//-- #Б-2628 смарт: Лопато 11.03.2025
			
		КонецЦикла;	
		
	КонецЦикла;	

	//Вывод отступа
	ГруппаБлокИнформацииКонец = Форма.Элементы.Добавить("ГруппаИнформацияОКонтрагентеБлокКонец", Тип("ГруппаФормы"), ГруппаИнформацияОКонтрагентеБлоки);
	ГруппаБлокИнформацииКонец.Вид 				  = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаБлокИнформацииКонец.ОтображатьЗаголовок = Ложь;
    ГруппаБлокИнформацииКонец.Группировка 		  = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;

	НоваяДекорация = Форма.Элементы.Добавить("ГруппаИнформацияОКонтрагентеБлокКонецДекорация", Тип("ДекорацияФормы"), ГруппаБлокИнформацииКонец);
	НоваяДекорация.АвтоМаксимальнаяШирина = Истина;
	НоваяДекорация.Ширина = 1;
		
КонецПроцедуры //-- #Б-1018 смарт: Лопато 07.10.2024	

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Функция СформироватьЗаголовокИнформацииОКонтрагенте(ДеревоВыводимыхПолей)
	
	СтрокаЗаголовка = "";

	Если ДеревоВыводимыхПолей.Количество() > 0 Тогда
		
		БлокСостояние = ДеревоВыводимыхПолей[0].Значение;
		
		Если БлокСостояние.Количество() > 0 Тогда
		
			СтатусОрганизации = БлокСостояние[0].Значение;
			СтрокаЗаголовка = СтрокаЗаголовка + "Организация " + СтатусОрганизации;
			
		КонецЕсли;
		
		Если БлокСостояние.Количество() > 1 Тогда

			ДатаРегистрации = БлокСостояние[1].Значение;
			
			Если ЗначениеЗаполнено(ДатаРегистрации) Тогда
				СтрокаЗаголовка = СтрокаЗаголовка + ", дата регистрации: " + ДатаРегистрации;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;		

	Если ДеревоВыводимыхПолей.Количество() > 2 Тогда
		
		БлокФинансовыеПоказатели = ДеревоВыводимыхПолей[2].Значение;
		
		ДатаОтчетности = "";
		
		Если БлокФинансовыеПоказатели.Количество() > 0 Тогда
			ДатаОтчетности = БлокФинансовыеПоказатели[0].Значение;
		КонецЕсли;

		Доход = "";

		Если БлокФинансовыеПоказатели.Количество() > 1 Тогда
			Доход = БлокФинансовыеПоказатели[1].Значение;
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ДатаОтчетности) 
			И ЗначениеЗаполнено(Доход) Тогда

			СтрокаЗаголовка = СтрокаЗаголовка + ", " + "доход за " 
							  + СтрЗаменить(ДатаОтчетности, " ", "") + "г.: " 
							  + Доход + " руб.";
							  
		КонецЕсли;

	КонецЕсли;	
	
	Возврат СтрокаЗаголовка; 
	
КонецФункции //-- #Б-1018 смарт: Лопато 07.10.202

//++ #Б-1018 смарт: Лопато 07.10.2024 //Вывод информации о контрагенте полученной из DaData  
Функция ПреобразоватьЧислоКДатеDaData(ДатаЧислом)

	Возврат ?(ЗначениеЗаполнено(ДатаЧислом), Дата(1970, 1, 1) + ДатаЧислом / 1000, "");
	
КонецФункции //-- #Б-1018 смарт: Лопато 07.10.2024

