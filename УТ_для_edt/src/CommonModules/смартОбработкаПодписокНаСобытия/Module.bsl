				Прервать;
			КонецЕсли;
			
		КонецЦикла;  
		
		ЗарегистрироватьНоменклатуруСегментаВОбменДляОбновленияНоменклатурныхГруппБП(Сегмент, Источник);
		
	КонецЕсли;
	
КонецПроцедуры //-- #Б-1706 смарт: Лопато 25.12.2024

//++ #Б-1706 смарт: Лопато 25.12.2024 //Доработка синхронизации УТ СМАРТ-Т РФ - БП СМАРТ-Т РФ  
Процедура ЗарегистрироватьНоменклатуруСегментаВОбменДляОбновленияНоменклатурныхГруппБП(Сегмент, Источник)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаНастроекСопоставления = Справочники.смартПредопределенныеЗначения.Настройки.СопоставлениеСегментовИНоменклатурныхГруппБП.Выгрузить();
	
	СтрокаНастройкиСопоставления = ТаблицаНастроекСопоставления.Найти(Сегмент, "СегментНоменклатуры");
	
	Если СтрокаНастройкиСопоставления <> Неопределено Тогда 
		
		Если НЕ ЗначениеЗаполнено(СтрокаНастройкиСопоставления.Узел) Тогда
			Возврат;
		КонецЕсли;	
		
		МассивНоменклатурыСегмента = Источник.ВыгрузитьКолонку("Номенклатура");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	НоменклатураСегмента.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ВТ_НоменклатураСегмента
		               |ИЗ
		               |	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
		               |ГДЕ
		               |	НоменклатураСегмента.Сегмент = &Сегмент
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	Ссылка
		               |ИЗ
		               |	Справочник.Номенклатура
		               |ГДЕ
		               |	Ссылка В(&МассивНоменклатурыСегмента)
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	Номенклатура КАК Номенклатура
		               |ИЗ
		               |	ВТ_НоменклатураСегмента
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	Номенклатура
					   |
					   |ИМЕЮЩИЕ
					   |	КОЛИЧЕСТВО(Номенклатура) = 1";
		
		Запрос.УстановитьПараметр("Сегмент", Сегмент);
		Запрос.УстановитьПараметр("МассивНоменклатурыСегмента", МассивНоменклатурыСегмента);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		МассивНоменклатурыДляРегистрации = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура");
		
		Если МассивНоменклатурыДляРегистрации.Количество() > 0 Тогда

			Для Каждого ЭлементНоменклатуры Из МассивНоменклатурыДляРегистрации Цикл
				ОбменДаннымиXDTOСервер.ДобавитьОбъектВФильтрРазрешенныхОбъектов(ЭлементНоменклатуры, СтрокаНастройкиСопоставления.Узел);
			КонецЦикла;	
			
			ПланыОбмена.ЗарегистрироватьИзменения(СтрокаНастройкиСопоставления.Узел, МассивНоменклатурыДляРегистрации);
			
		КонецЕсли;	
		
	КонецЕсли;	
		
КонецПроцедуры //-- #Б-1706 смарт: Лопато 25.12.2024

//++ #Б-2858 смарт: Лопато 07.04.2025 //Автозадачи по заказам. Согласование даты отгрузки.  
Процедура ПослеПроведенияЗаказКлиента(Источник, Отказ, РежимПроведения) Экспорт

	УстановитьДатуРезерваЗаказаПоАвтозадачеСогласованиеДатыОгрузки(Источник, Отказ);
		
КонецПроцедуры	//-- #Б-2858 смарт: Лопато 07.04.2025

//++ #Б-2858 смарт: Лопато 07.04.2025 //Автозадачи по заказам. Согласование даты отгрузки.  
Процедура УстановитьДатуРезерваЗаказаПоАвтозадачеСогласованиеДатыОгрузки(Заказ, Отказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если НЕ ЗначениеЗаполнено(Заказ.Ссылка) Тогда
		Возврат;
	КонецЕсли;	
	
	АвтозадачиДатаНачала = Справочники.смартПредопределенныеЗначения.Настройки.АвтозадачиДатаНачала;

	Если НЕ ЗначениеЗаполнено(АвтозадачиДатаНачала) Тогда
		Возврат;
	КонецЕсли;	

	СвойствоДатаРезерваЗапчастей 
		= ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ДатаРезерваЗапчастей");

	Если НЕ ЗначениеЗаполнено(СвойствоДатаРезерваЗапчастей) Тогда
		Возврат;
	КонецЕсли;	
	
	Если Отказ 
		ИЛИ НЕ Заказ.Проведен
		ИЛИ Заказ.СуммаДокумента = 0
		ИЛИ Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
		
		Возврат;
		
	КонецЕсли;	
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	ЗаказКлиентаТовары.Номенклатура
	|ПОМЕСТИТЬ ВТ_НЕУстановленРезервВЗаказе
	|ИЗ 
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Ссылка
	|	И (НЕ ЗаказКлиентаТовары.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	|	   ИЛИ (НЕ ЗаказКлиентаТовары.Отменено
	|			И НЕ (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|				  ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	|				  ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно))))
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокЗаказ.Ссылка КАК Заказ
	|ИЗ
	|	Документ.ЗаказКлиента КАК ДокЗаказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения
	|		ПО ДопСведения.Объект = ДокЗаказ.Ссылка 
	|		   И ДопСведения.Свойство = &СвойствоДатаРезерваЗапчастей
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО РеализацияТоваровУслуг.ЗаказКлиента = ДокЗаказ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НЕУстановленРезервВЗаказе КАК ВТ_НЕУстановленРезервВЗаказе
	|		ПО ДокЗаказ.Ссылка = ВТ_НЕУстановленРезервВЗаказе.Заказ	
	|ГДЕ
	|	ДокЗаказ.Ссылка = &Ссылка
	|	И ДокЗаказ.Дата >= &ДатаНачала
	|	И ДокЗаказ.Проведен
	|	И ДокЗаказ.СуммаДокумента <> 0
	|	И ДокЗаказ.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И НЕ ДокЗаказ.Партнер В (&СписокПартнеровИсключения)
	|	И (ДокЗаказ.Менеджер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	   И ДокЗаказ.Менеджер = ДокЗаказ.Партнер.смартОсновнойМенеджерСервисЦентра)
	|	И ЕСТЬNULL(ДопСведения.Значение, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)  
	|	И ВЫБОР
	|		КОГДА ВТ_НЕУстановленРезервВЗаказе.Заказ ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	  КОНЕЦ
	|	И РеализацияТоваровУслуг.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Ссылка", 					  Заказ.Ссылка);
	Запрос.УстановитьПараметр("ДатаНачала", 				  АвтозадачиДатаНачала);
	Запрос.УстановитьПараметр("СвойствоДатаРезерваЗапчастей", СвойствоДатаРезерваЗапчастей);
	
	Запрос.УстановитьПараметр("СписокПартнеровИсключения", 
		Справочники.смартПредопределенныеЗначения.Настройки.АвтозадачиПартнерыИсключения.ВыгрузитьКолонку("Партнер"));
		
	Запрос.УстановитьПараметр("ВидНоменклатуры", 
		Справочники.смартПредопределенныеЗначения.Настройки.ВидНоменклатурыЗапчастиСервисногоЦентра);

	РезультатЗапроса = Запрос.Выполнить().Выбрать();

	Если РезультатЗапроса.Следующий() Тогда
		
		ЗначенияДополнительныхСвойств = Новый ТаблицаЗначений;
		
		ЗначенияДополнительныхСвойств.Колонки.Добавить("Свойство");
		ЗначенияДополнительныхСвойств.Колонки.Добавить("Значение");
		
		НоваяСтрока = ЗначенияДополнительныхСвойств.Добавить();
		
		НоваяСтрока.Свойство = СвойствоДатаРезерваЗапчастей;
		НоваяСтрока.Значение = CRM_ОбщегоНазначенияСервер.ПолучитьТекущуюДатуСеанса();
		
		УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Заказ.Ссылка, ЗначенияДополнительныхСвойств);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры	//-- #Б-2858 смарт: Лопато 07.04.2025

Процедура смартПриИзмененииКурсовВалютПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Валюты = Новый Массив;
	
	Если Источник.Отбор.Валюта.Использование Тогда
		
		// Пустой набор (часто удаление при Замещение) — валюта из отбора
		ВалютаОтбора = Источник.Отбор.Валюта.Значение;
		
		Если ТипЗнч(ВалютаОтбора) = Тип("СправочникСсылка.Валюты")
			И ЗначениеЗаполнено(ВалютаОтбора) Тогда
			
			Валюты.Добавить(ВалютаОтбора);
			
		ИначеЕсли ТипЗнч(ВалютаОтбора) = Тип("Массив") Тогда
			
			Для Каждого Валюта Из ВалютаОтбора Цикл
				Если Валюты.Найти(Валюта) = Неопределено Тогда
					Валюты.Добавить(Валюта);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	ИначеЕсли Источник.Количество() > 0 Тогда
		
		// Есть записи в наборе — берём валюты из них
		Для Каждого Запись Из Источник Цикл
			
			Если Валюты.Найти(Запись.Валюта) = Неопределено Тогда
				Валюты.Добавить(Запись.Валюта);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Акции = смартАкцииИСкидки.ПолучитьДействующиеАкции(ТекущаяДата(), Новый Структура("ВалютаАкция,ВозвращатьАкцииБудущего", Валюты, Истина));
	Акции.Свернуть("Ссылка");
	
	Если Акции.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(смартОбменССайтомБитриксСервер.ПолучитьМассивУзловОбменаБитрикс(), Акции.ВыгрузитьКолонку("Ссылка"));
	КонецЕсли;
	
КонецПроцедуры
