			Склад = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
			
			
			ТемаПисьма = "Заказ на перемещение запчастей на склад " + Склад + " №" + ЗаказНаПеремещение.Номер;
			ТекстПисьма = "По заказу на перемещение №" + ЗаказНаПеремещение.Номер + " следует переместить на склад " 
			+ Склад + " следующие запчасти:" + Символы.ПС 
			+ ЗапчастиДляПеремещенияТекст;
		// --
			ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			//-- смарт:ММ 03.03.2021
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
				
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				Если ПараметрыПисьма.ТестоваяБаза Тогда
					ТекстСообщения = "Отправлено уведомление о необходимости перемещения запчастей НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
				Иначе
				//-- смарт:ММ 03.03.2021
				
				ТекстСообщения = "Отправлено уведомление о необходимости перемещения запчастей (на почту " + АдресаДляОтправкиСтрокой + ")";
				
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				КонецЕсли;
				//-- смарт:ММ 03.03.2021
				
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Исключение 
				//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
				смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказНаПеремещение,ТекстПисьма);
				//-- #1416 смарт: Фролов 30.08.2023
				ТекстСообщения = "Не удалось отправить уведомление о необходимости перемещения запчастей" + Символы.ПС + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
			
		// ++ 20.12.2020
		КонецЦикла;
		// --
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 19.10.2020 

//++ смарт:ММ 19.10.2020 #044 224 Продолжение #001
Функция ПолучитьАдресаПолучателейУведомленийРаспроведениеРО(АдресаДляОтправкиСтрокой = "") Экспорт
	
	// Уведомление отправляется получаетелям, которые задаются в справочнике смартПредопределенныеЗначения
	
	СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.АдресаДляУведомленийОНеобходимостиРаспровестиРасходныйОрдерПриОтменеОтправки;
	
	// Раскомментировать, если в справочнике должны будут храниться пользователи, а не адреса эл. почты
	//Возврат смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаНаПредопределенноеЗначение, АдресаДляОтправкиСтрокой);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
	|	И НЕ смартПредопределенныеЗначения.СписокЗначений
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений";
	
	Запрос.УстановитьПараметр("ПредопределенноеЗначение", СсылкаНаПредопределенноеЗначение);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции //-- смарт:ММ 19.10.2020

