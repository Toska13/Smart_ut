//++ смарт:Подкин #1128 п1 13.09.2022 16:01:47
Процедура ЗаказыВСтатусРезервНаСкладе(Параметры, Адрес) Экспорт 
    
    ВнОбработка=смартОбщегоНазначения.ПолучитьВнешнююОбработку("ПриходныйОрдерНаТоварыРезервироватьЗаказыНаСкладе"); 
    ВнешнОбработка = ДополнительныеОтчетыИОбработки.ОбъектВнешнейОбработки(ВнОбработка);
    
    Если НЕ ВнешнОбработка=Неопределено Тогда
        Если ЗначениеЗаполнено(ВнОбработка.Комментарий) Тогда
            Чтение=Новый ЧтениеJSON;
            Чтение.УстановитьСтроку(ВнОбработка.Комментарий);
            ЗаполнитьЗначенияСвойств(ВнешнОбработка,ПрочитатьJSON(Чтение));
        КонецЕсли;
        ВнешнОбработка.ОбъектСсылка=Параметры.Источник;
        ВнешнОбработка.ИзменениеРезервированияЗаказов();  //ПараметрыВыполнения
    КонецЕсли;
    
КонецПроцедуры //-- смарт:Подкин #1128 п1 13.09.2022 16:01:47

//++ смарт:ММ #044 224 05.12.2020 - Заявка на гарантийный ремонт
// Функция вызывается из двух мест: при проведении Приходного ордера с детализацией по номенклатуре 
// или при проверке полноты цепочки документов поставки при проведении таможенной декларации, поступления товаров на склад или приобретения товаров без детализации по номенклатуре
Функция ОбработатьЗаказНаПеремещение(ЗаказНаПеремещение, ЗаказПоставщику, Номенклатура = Неопределено, ЗаявкаНаГарантийныйРемонт = Неопределено, НомераЗаявокНаГР = "", СоздаватьПеремещение = Истина, УстанавливатьДействиеОтгрузить = Истина, ЕстьДействиеОтгрузитьДляТекущейНоменклатуры = Ложь)
	
	Если ЗаказНаПеремещение.ПометкаУдаления ИЛИ ЗаказНаПеремещение.Товары.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПисьма = "";
	Отгрузить = Перечисления.ВариантыОбеспечения.Отгрузить;
	
	// 1. Попытка в Заказе на перемещение поменять действие на "отгрузить"
	ЗаказНаПеремещениеИзмененУспешно = Истина;
	ПеремещениеТоваровСозданоУспешно = Ложь;
	ИмпортПеремещениеТоваровСозданоУспешно = Ложь;
	
	// ++ 20.12.2020
	Если УстанавливатьДействиеОтгрузить Тогда
	// --
	Попытка
		ЕстьИзменения = Ложь;
		ЗаказНаПеремещениеОбъект = ЗаказНаПеремещение.ПолучитьОбъект();
		Для Каждого Строка Из ЗаказНаПеремещениеОбъект.Товары Цикл
			
			Если Номенклатура <> Неопределено Тогда
				Если Строка.Номенклатура <> Номенклатура 
					//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
					//ИЛИ СокрЛП(Строка.смартНомерЗаявкиНаГарантийныйРемонт) <> СокрЛП(ЗаявкаНаГарантийныйРемонт.Номер) 
					ИЛИ Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка <> ЗаявкаНаГарантийныйРемонт
					//-- #Б1132 смарт: Шляпников 01.11.2024
					// ++ 31.01.2021
					//ИЛИ Строка.ВариантОбеспечения = Отгрузить Тогда
					Тогда
					// --
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если Строка.ВариантОбеспечения = Отгрузить Тогда
				// ++ 31.01.2021
				ЕстьДействиеОтгрузитьДляТекущейНоменклатуры = Истина;
				// --
				Продолжить;
			КонецЕсли;
			
			Строка.ВариантОбеспечения = Отгрузить;
			ЕстьИзменения = Истина;
			// ++ 31.01.2021
			ЕстьДействиеОтгрузитьДляТекущейНоменклатуры = Истина;
			// --
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			ЗаказНаПеремещениеОбъект.Записать(РежимЗаписиДокумента.Проведение);//rnp:после изменения документа обязательно перепроводим его
		Иначе
			// или нет строк с нужной номенклатурой, или у них уже действие = отгрузить
			//ТекстПисьма = "В Заказе на перемещение №" + ЗаказНаПеремещение.Номер + " по Заявке на гарантийный ремонт №" + ДокОбъект.Номер + " не обнаружены строки с номенклатурой " + Номенклатура + " для изменения варианта обеспечения на ""Отгрузить""";
		КонецЕсли;
		
	Исключение
		ЗаказНаПеремещениеИзмененУспешно = Ложь;
		ТекстПисьма = "Не удалось установить действие ""Отгрузить"" в заказе на перемещение " + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
	
	// ++ 20.12.2020
	КонецЕсли;
	// --
	
	// ++ 20.12.2020
	Если НЕ СоздаватьПеремещение Тогда
		Возврат Истина;
	КонецЕсли;
	// --
	
	// 2. Попытка создать Перемещение товаров
	Если ЗаказНаПеремещениеИзмененУспешно Тогда
		ТекстОшибки = "";
		// ++ 20.12.2020
		//Если НЕ ЗначениеЗаполнено(НомераЗаявокНаГР) Тогда
		Если НомераЗаявокНаГР = "" Тогда
		// --
			НомераЗаявокНаГР = ЗаявкаНаГарантийныйРемонт.Номер;
		КонецЕсли;
		
		Попытка
			ДокументПеремещениеТоваров = СоздатьДокументПеремещениеТоваров(ЗаказНаПеремещение, НомераЗаявокНаГР, ТекстОшибки);
			Если ЗначениеЗаполнено(ДокументПеремещениеТоваров) Тогда
				ПеремещениеТоваровСозданоУспешно = Истина;
			Иначе
				ТекстПисьма = ТекстОшибки;
			КонецЕсли;	
		Исключение
			ТекстОшибки = "Не удалось создать Перемещение товаров на основании Заказа на перемещение №" 
			+ ЗаказНаПеремещение.Номер + " (по Заявке на гарантийный ремонт №" + НомераЗаявокНаГР + ")";
			ЗаписьЖурналаРегистрации("смартОбработкаЗаказаНаПеремещение", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Если ЗаказНаПеремещениеИзмененУспешно И ПеремещениеТоваровСозданоУспешно Тогда							
		ИмпортПеремещениеТоваровСозданоУспешно = Истина;
	КонецЕсли;
	
	Если НЕ ИмпортПеремещениеТоваровСозданоУспешно Тогда
		ОтправитьУведомлениеОбОшибкахСозданияПеремещенияТоваров(ЗаказПоставщику, ЗаказНаПеремещение, ТекстПисьма);
	КонецЕсли;

	Возврат ИмпортПеремещениеТоваровСозданоУспешно;
	
КонецФункции //-- смарт:ММ 05.12.2020

//++ смарт:ММ #044 224 27.11.2020 - Заявка на гарантийный ремонт 
Процедура ИзменитьДатуПоступленияВГрузе(ЗаказПоставщику, ДатаПоступления)
	
	Если ТипЗнч(ЗаказПоставщику) = Тип("ДокументСсылка.ЗаказПоставщику")
		И ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Груз = ЗаказПоставщику.Груз;
		Если ЗначениеЗаполнено(Груз) И Груз.ДатаПоступления <> ДатаПоступления Тогда
		    ГрузОбъект = Груз.ПолучитьОбъект();
			ГрузОбъект.ДатаПоступления = ДатаПоступления;
			Попытка
				ГрузОбъект.Записать();
			Исключение
			КонецПопытки;
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 27.11.2020

//++ смарт:ММ #044 224 18.11.2020 - Заявка на гарантийный ремонт 
