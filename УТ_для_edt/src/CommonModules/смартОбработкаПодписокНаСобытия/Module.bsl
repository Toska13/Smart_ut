//++ смарт:ММ #104 488 19.04.2021 
Функция ПодобратьОбщуюГруппу(ЭлементОдин, ЭлементДва)
	
	УровеньЭлементаОдин = ЭлементОдин.Уровень();
	УровеньЭлементаДва = ЭлементДва.Уровень();
	
	ЭлементВышеУровнем = ЭлементОдин;
	ЭлементНижеУровнем = ЭлементДва;
	
	Если УровеньЭлементаОдин > УровеньЭлементаДва Тогда
		ЭлементВышеУровнем = ЭлементДва;
		ЭлементНижеУровнем = ЭлементОдин;
	КонецЕсли;
	
	Возврат НайтиОбщегоРодителяРекурсивно(ЭлементВышеУровнем, ЭлементНижеУровнем);
	
КонецФункции //-- смарт:ММ 19.04.2021

//++ смарт:ММ #104 488 19.04.2021 
Функция НайтиОбщегоРодителяРекурсивно(знач ЭлементВышеУровнем, ЭлементНижеУровнем)
	
	Если ЭлементНижеУровнем.ПринадлежитЭлементу(ЭлементВышеУровнем) Тогда
		Возврат ЭлементВышеУровнем;
	ИначеЕсли НЕ ЗначениеЗаполнено(ЭлементВышеУровнем.Родитель) Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайтиОбщегоРодителяРекурсивно(ЭлементВышеУровнем.Родитель, ЭлементНижеУровнем);
	КонецЕсли;
	
КонецФункции //-- смарт:ММ 19.04.2021

//++ смарт:ММ #104 488 30.06.2021
Процедура ЗарезервироватьТоварПоЗаказуКлиента(ПоступлениеБезналичныхОбъект)
	
	Настройка = Справочники.смартПредопределенныеЗначения.КоличествоМесяцевАктуальностиЗаказаКлиентаДляРезерва;
	КоличествоМесяцевАктуальности = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);
	Если Не ЗначениеЗаполнено(КоличествоМесяцевАктуальности) Тогда
		КоличествоМесяцевАктуальности = 0;
	КонецЕсли;
	
	ДатаПроверки = ДобавитьМесяц(НачалоДня(ТекущаяДата()), -КоличествоМесяцевАктуальности);

	МассивЗаказовКлиента = Новый Массив;
	СтатусЗакрыт = Перечисления.СтатусыЗаказовКлиентов.Закрыт;
	
	Для Каждого СтрокаТЧ Из ПоступлениеБезналичныхОбъект.РасшифровкаПлатежа Цикл
		
		Заказ = СтрокаТЧ.Заказ;
		
		Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Заказ.Дата < ДатаПроверки Тогда
			Продолжить;
		КонецЕсли;
		
		Если Заказ.Статус = СтатусЗакрыт Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Заказ.Проведен Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивЗаказовКлиента.Найти(Заказ) = Неопределено Тогда
			МассивЗаказовКлиента.Добавить(Заказ);	
		КонецЕсли;
		
	КонецЦикла;
	
	РезервироватьСоСклада = Перечисления.ВариантыОбеспечения.СоСклада;
	КОбеспечению = Перечисления.ВариантыОбеспечения.Требуется;

	Для Каждого ЗаказКлиента Из МассивЗаказовКлиента Цикл
		
		ДокОбъект = ЗаказКлиента.ПолучитьОбъект();

		Для Каждого СтрокаТовар Из ДокОбъект.Товары Цикл
			Если СтрокаТовар.Отменено Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаТовар.ВариантОбеспечения <> КОбеспечению Тогда 
				Продолжить;
			КонецЕсли;
			
			СтрокаТовар.ВариантОбеспечения = РезервироватьСоСклада;
			
			Попытка				
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ДокОбъект = ЗаказКлиента.ПолучитьОбъект();
			КонецПопытки;
			
		КонецЦикла;		
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 30.06.2021

