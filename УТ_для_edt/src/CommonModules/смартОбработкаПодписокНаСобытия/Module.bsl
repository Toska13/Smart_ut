//++ смарт:ММ #044 224 19.11.2020 - Заявка на гарантийный ремонт 
Функция СоздатьДокументПеремещениеТоваров(ЗаказНаПеремещение, НомерЗаявкиНаГарантийныйРемонт, ТекстОшибки = "")
		
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументПеремещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(ЗаказНаПеремещение);

	ДанныеЗаполнения = Новый Структура;
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "ПеремещениеТоваров");
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	ДокументПеремещение.Заполнить(ДанныеЗаполнения);
	
	//++ #1346 смарт: Фролов 26.04.2023 //Исправить автоматичесое создание перемещений при оприходовании товара 
	//ДокументПеремещение.Дата = ЗаказНаПеремещение.Дата;
	ДокументПеремещение.Дата = ТекущаяДатаСеанса();
	//-- #1346 смарт: Фролов 26.04.2023
	ДокументПеремещение.Комментарий = Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьТекстКомментарияКДокументу(, НомерЗаявкиНаГарантийныйРемонт);
	
	// ++ 20.12.2020
	//Для Каждого Строка Из ДокументПеремещение.Товары Цикл
	//	Строка.смартНомерЗаявкиНаГарантийныйРемонт = НомерЗаявкиНаГарантийныйРемонт;
	//КонецЦикла;
	
	Для Каждого Строка Из ДокументПеремещение.Товары Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("КодСтроки", Строка.КодСтроки);
		НайденныеСтрокиЗаказ = Строка.ЗаказНаПеремещение.Товары.НайтиСтроки(Отбор);
		Если НайденныеСтрокиЗаказ.Количество() > 0 Тогда
			//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Строка.смартНомерЗаявкиНаГарантийныйРемонт = НайденныеСтрокиЗаказ[0].смартНомерЗаявкиНаГарантийныйРемонт;
			Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка = НайденныеСтрокиЗаказ[0].смартНомерЗаявкиНаГарантийныйРемонтСсылка;
			//-- #Б1132 смарт: Шляпников 14.10.2024
		КонецЕсли;
	КонецЦикла;
	// --
		
	Попытка
		ДокументПеремещение.Записать(РежимЗаписиДокумента.Проведение);
		УстановитьПривилегированныйРежим(Ложь);
		Возврат ДокументПеремещение.Ссылка;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ТекстОшибки = "Не удалось создать Перемещение товаров на основании Заказа на перемещение №" 
		+ ЗаказНаПеремещение.Номер + " (по Заявке на гарантийный ремонт №" + НомерЗаявкиНаГарантийныйРемонт + ")";
		ЗаписьЖурналаРегистрации("смартОбработкаЗаказаНаПеремещение", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
		
КонецФункции //-- смарт:ММ 19.11.2020

//++ смарт:ММ 16.10.2020 #044 224 Продолжение #001
//Процедура смартУдалитьСтрокиИзЗаказаНаПеремещениеПоЗаявкеНаГарантийныйРемонт(НомерЗаявки, Номенклатура, ЗаказНаПеремещение = Неопределено, ТолькоПолучитьНомераДокументов = Ложь, СоответствиеНоменклатуры = Неопределено, Успех = Ложь)
Процедура смартУдалитьСтрокиИлиПолучитьСписокНоменклатурыИзЗаказаНаПеремещениеПоЗаявкеНаГарантийныйРемонт(НомерЗаявки, Номенклатура, ЗаказНаПеремещение = Неопределено, ТолькоПолучитьНомераДокументов = Ложь, СоответствиеНоменклатуры = Неопределено, Успех = Ложь)	
	// ++ 01.11.2020
	Успех = Ложь;
	// --
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказНаПеремещениеТовары.Ссылка КАК Ссылка,
	|	ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказНаПеремещениеТовары.Ссылка.Номер КАК Номер,
	|	ЗаказНаПеремещениеТовары.ВариантОбеспечения КАК ВариантОбеспечения
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|ГДЕ
	// ++ 01.11.2020
	|	ВЫБОР 
	|		КОГДА &ОтборПоСсылке 
	|			ТОГДА ЗаказНаПеремещениеТовары.Ссылка = &Ссылка 
	|	ИНАЧЕ
	//
	|		ЗаказНаПеремещениеТовары.Ссылка.Проведен
	// ++ 31.01.2020
	//|		И ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонт = &смартНомерЗаявкиНаГарантийныйРемонт
	// --
	|	КОНЕЦ
	// ++ 31.01.2020
	//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
	|	И ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка = &смартНомерЗаявкиНаГарантийныйРемонт
	//-- #Б1132 смарт: Шляпников 01.11.2024
	// --
	|	И ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
	|	И ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель = &СкладПолучатель
	// ++ 23.10.2020
	|	И ВЫБОР 
	|		КОГДА &ОтборПоВариантуОбеспечения 
	|			ТОГДА ЗаказНаПеремещениеТовары.ВариантОбеспечения <> &Отгрузить
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	// --
	|ИТОГИ
	|	МАКСИМУМ(Номер)
	|ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("СкладПолучатель", Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	// ++ 31.01.2021
	//Запрос.УстановитьПараметр("смартНомерЗаявкиНаГарантийныйРемонт", НомерЗаявки);
	//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
	//Запрос.УстановитьПараметр("смартНомерЗаявкиНаГарантийныйРемонт", СокрЛП(НомерЗаявки));
	Запрос.УстановитьПараметр("смартНомерЗаявкиНаГарантийныйРемонт", НомерЗаявки);
	//-- #Б1132 смарт: Шляпников 01.11.2024
	// --
	// ++ 23.10.2020
	Запрос.УстановитьПараметр("Отгрузить", Перечисления.ВариантыОбеспечения.Отгрузить);
	Запрос.УстановитьПараметр("ОтборПоВариантуОбеспечения", НЕ ТолькоПолучитьНомераДокументов);
	// ++ 01.11.2020
	Запрос.УстановитьПараметр("Ссылка", ЗаказНаПеремещение);
	Запрос.УстановитьПараметр("ОтборПоСсылке", ?(ЗначениеЗаполнено(ЗаказНаПеремещение), Истина, Ложь));
	
	ВыборкаЗаказ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказ.Следующий() Цикл
		
		Если НЕ ТолькоПолучитьНомераДокументов Тогда
			ДокОбъект = ВыборкаЗаказ.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		// ++ 18.11.2020
		// Если в табличной части Заявки на гарантийный ремонт не был указан заказ на перемещение, но он нашелся в базе, то уведомления отправлять в дальнейшем по нему
		Если ЗаказНаПеремещение = Неопределено Тогда
			ЗаказНаПеремещение = ВыборкаЗаказ.Ссылка;
		КонецЕсли;
		//--
		
		Выборка = ВыборкаЗаказ.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ТолькоПолучитьНомераДокументов Тогда
				// ++ 20.12.2020
				//Соотв = Новый Соответствие();
				//Соотв.Вставить(ВыборкаЗаказ.Номер, Номенклатура);
				//СоответствиеНоменклатуры.Добавить(Соотв);
				НоваяСтрока = СоответствиеНоменклатуры.Добавить();
				НоваяСтрока.ЗаказНаПеремещение = ЗаказНаПеремещение;
				НоваяСтрока.Номенклатура = Номенклатура;
				НоваяСтрока.НомерЗаявкиНаГарантийныйРемонт = НомерЗаявки;
				// --
			Иначе
				Отбор = Новый Структура;
				//Отбор.Вставить("НомерСтроки", Выборка.НомерСтроки);
				// ++ 31.01.2021
				Отбор.Вставить("НомерСтроки", Выборка.НомерСтроки);
				// --
				Отбор.Вставить("Номенклатура", Номенклатура);
				
				СтрокиДляУдаления = ДокОбъект.Товары.НайтиСтроки(Отбор);
				Если СтрокиДляУдаления.Количество() > 0 Тогда
					ДокОбъект.Товары.Удалить(СтрокиДляУдаления[0]);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ТолькоПолучитьНомераДокументов Тогда
			Если ДокОбъект.Товары.Количество() = 0 Тогда
				// Удалить заказ на перемещение
				//ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				ДокОбъект = ВыборкаЗаказ.Ссылка.ПолучитьОбъект(); // Чтобы осталась удаляемая строка в документе
				ДокОбъект.УстановитьПометкуУдаления(Истина);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Помечен на удаление документ " + ДокОбъект.Ссылка, ДокОбъект.Ссылка);
				Успех = Истина;
			Иначе
				Попытка
					// ++ 31.01.2021
					//ДокОбъект.Записать();
					ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
					// --
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменен документ " + ДокОбъект.Ссылка, ДокОбъект.Ссылка);
					Успех = Истина;
				Исключение
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось изменить документ " + ДокОбъект.Ссылка + Символы.ПС + ОписаниеОшибки(), ДокОбъект.Ссылка);
				КонецПопытки;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 16.10.2020

//++ смарт:ММ 19.10.2020 #044 224 Продолжение #001
Процедура ОтправитьУведомлениеОНеобходимостиПеремещенияЗапчастей(ТаблицаНоменклатурыДляОповещения)
	
	// ++ 20.12.2020
	Если ТаблицаНоменклатурыДляОповещения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
