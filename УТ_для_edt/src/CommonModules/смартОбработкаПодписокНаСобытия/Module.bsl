				ТемаПисьма="Появился Заказ поставщику по ожидаемым запчастям по заявке №";
			КонецЕсли;
			ВыборкаНоменклатура=ВыборкаЗаявка.Выбрать();
			НомПП=1;
			Пока ВыборкаНоменклатура.Следующий() Цикл
				ТекстДляОтправкиПисьма=ТекстДляОтправкиПисьма+НомПП+". "+ВыборкаНоменклатура.Номенклатура+" в количестве "+ВыборкаНоменклатура.Количество+" на склад "+ВыборкаНоменклатура.Склад+Символы.ПС;	
				НомПП=НомПП+1;
			КонецЦикла;
			МассивСообщений = Новый Массив;
			Успех=Документы.смартЗаявкаНаРемонтныеРаботы.ОтправитьОповещениеПоОжидаемымЗапчастям(МассивСообщений,ТекстДляОтправкиПисьма,ВыборкаЗаявка.Регистратор,Выборка.Сотрудник,ТемаПисьма);
		КонецЦикла;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры	//-- #1366 смарт: Фролов 02.06.2023

