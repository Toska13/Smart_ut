Процедура смартЗаявкаНаРасходованиеДСНапоминанияПриЗаписи(Источник) Экспорт
	
	ЕстьЗаписьОсновной = ПолучитьТекЗаписьНапоминания(Источник.КтоЗаявил, Источник.Ссылка);
	
	Если НЕ ЕстьЗаписьОсновной Тогда
		
		ПараметрыНапоминания = Новый Структура;
		ПараметрыНапоминания.Вставить("Пользователь",				Источник.КтоЗаявил);
		ПараметрыНапоминания.Вставить("Источник",					Источник.Ссылка);
		ПараметрыНапоминания.Вставить("Описание",					"Ошибка заполнения документа. Пожалуйста проведите корректировку! " + СокрЛП(Источник.Ссылка));
		ПараметрыНапоминания.Вставить("ВремяСобытия", 				ТекущаяДатаСеанса());
		ПараметрыНапоминания.Вставить("ИнтервалВремениНапоминания", 300);
		ПараметрыНапоминания.Вставить("Идентификатор", 				"ЗаявкаНаРасходованиеДенежныхСредств");
		
		НапоминанияПользователяСлужебный.ПодключитьНапоминание(ПараметрыНапоминания);
		
	КонецЕсли; 
	
	//Доп напоминание фин департамент
	ДопПользователь = Справочники.смартПредопределенныеЗначения.ДопПользовательНапоминания.Значение;
	
	ЕстьЗаписьДоп = ПолучитьТекЗаписьНапоминания(ДопПользователь, Источник.Ссылка);
	
	Если НЕ ЕстьЗаписьДоп И ЗначениеЗаполнено(ДопПользователь) Тогда
		
		ПараметрыНапоминания=Новый Структура;
		ПараметрыНапоминания.Вставить("Пользователь",				ДопПользователь);
		ПараметрыНапоминания.Вставить("Источник",					Источник.Ссылка);
		ПараметрыНапоминания.Вставить("Описание",					"Ошибка заполнения документа. Отправлено на корректировку инициатору! " + СокрЛП(Источник.Ссылка));
		ПараметрыНапоминания.Вставить("ВремяСобытия", 				ТекущаяДатаСеанса());
		ПараметрыНапоминания.Вставить("ИнтервалВремениНапоминания", 900);
		ПараметрыНапоминания.Вставить("Идентификатор", 				"ЗаявкаНаРасходованиеДенежныхСредств");
		
		НапоминанияПользователяСлужебный.ПодключитьНапоминание(ПараметрыНапоминания);
		
	КонецЕсли;
	
КонецПроцедуры //--#1530 смарт: Лопато 27.10.2023

//++ смарт:ПА #815 13.12.2021 10:36:27
Функция ПолучитьТекЗаписьНапоминания(Пользователь,Предмет) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   НапоминанияПользователя.Пользователь КАК Пользователь,
    |   НапоминанияПользователя.Источник КАК Источник,
    |   НапоминанияПользователя.ВремяСобытия КАК ВремяСобытия
    |ИЗ
    |   РегистрСведений.НапоминанияПользователя КАК НапоминанияПользователя
    |ГДЕ
    |   НапоминанияПользователя.Пользователь = &Пользователь
    |   И НапоминанияПользователя.Источник = &Источник";
    
    Запрос.УстановитьПараметр("Источник", Предмет);
    Запрос.УстановитьПараметр("Пользователь", Пользователь);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
    
    Если ВыборкаДетальныеЗаписи.Следующий() Тогда
        Возврат Истина;
    КонецЕсли;
    
    Возврат Ложь;
    
КонецФункции //-- смарт:ПА #815 13.12.2021 10:36:27

