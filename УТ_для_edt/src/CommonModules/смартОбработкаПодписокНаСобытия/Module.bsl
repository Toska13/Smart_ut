	МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийРаспроведениеРО(АдресаДляОтправкиСтрокой);
	
	// 26.12.2020
	АдресаДляОтправкиУникальные = Новый Массив;
	Индекс = МассивАдресовДляОтправки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		ТекСтруктура = МассивАдресовДляОтправки[Индекс];
		ТекАдрес = ТекСтруктура.Адрес;
		Если АдресаДляОтправкиУникальные.Найти(ТекАдрес) = Неопределено Тогда
			АдресаДляОтправкиУникальные.Добавить(ТекАдрес);
		Иначе
			МассивАдресовДляОтправки.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
