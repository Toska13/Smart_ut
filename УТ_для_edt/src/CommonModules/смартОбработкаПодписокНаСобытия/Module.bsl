//++ смарт:ММ #044 224 19.11.2020 - Заявка на гарантийный ремонт 
Процедура ОтправитьУведомлениеОНеобходимостиКонтроляЗаказаПоставщику(ЗаказПоставщику, ИмпортЗаказыНаПеремещение, НаличиеДокументов)
	
	ТекстЗаказНаПеремещение = "";
	Для Каждого ЗаказНаПеремещение Из ИмпортЗаказыНаПеремещение Цикл
		ТекстЗаказНаПеремещение = ТекстЗаказНаПеремещение + ?(ЗначениеЗаполнено(ТекстЗаказНаПеремещение), ", ", "") + "Заказ на перемещение №" + ЗаказНаПеремещение.Номер;
	КонецЦикла;
	
	СписокОтсутствующихДокументов = "";
	Если НаличиеДокументов.Свойство("ЕстьПриобретениеТоваров") И НаличиеДокументов.ЕстьПриобретениеТоваров = Ложь Тогда
		СписокОтсутствующихДокументов = "приобретение товаров и услуг";
	КонецЕсли;
	
	Если НаличиеДокументов.Свойство("ЕстьТаможеннаяДекларация") И НаличиеДокументов.ЕстьТаможеннаяДекларация = Ложь Тогда
		СписокОтсутствующихДокументов = СписокОтсутствующихДокументов + ?(ЗначениеЗаполнено(СписокОтсутствующихДокументов), ", ", "") + "таможенная декларация на импорт";
	КонецЕсли;

	Если НаличиеДокументов.Свойство("ЕстьПоступлениеТоваров") И НаличиеДокументов.ЕстьПоступлениеТоваров = Ложь Тогда
		СписокОтсутствующихДокументов = СписокОтсутствующихДокументов + ?(ЗначениеЗаполнено(СписокОтсутствующихДокументов), ", ", "") + "поступление товаров на склад";
	КонецЕсли;
	
	ТекстПисьма = "Необходимо проконтролировать заказ поставщику №" + ЗаказПоставщику.Номер + ", т.к. отсутствуют документы по поставке (" + СписокОтсутствующихДокументов + ") и невозможно обработать " + ТекстЗаказНаПеремещение;
		
	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = ПолучитьАдресаПолучателейСообщенийОбОшибках(АдресаДляОтправкиСтрокой);
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);	
	//-- смарт:ММ 03.03.2021

	Если ЗначениеЗаполнено(УчетнаяЗапись) 
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда
		И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		//-- смарт:ММ 03.03.2021
		
		ТемаПисьма = "Контроль Заказа поставщику №" + ЗаказПоставщику.Номер; //НомерЗаявки;
								 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		//Если ЭтоТестоваяБаза Тогда
		//	ТестовыеАдреса = ПараметрыПисьма.ТестовыеАдреса;
		//КонецЕсли;
		
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
				
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ЭтоТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о необходимости контроля Заказа поставщику (на ТЕСТОВУЮ почту " + ПараметрыПисьма.ТестовыеАдреса + ". В рабочей отправилось бы на " + АдресаДляОтправкиСтрокой + ")";
			Иначе	
				ТекстСообщения = "Отправлено уведомление о необходимости контроля Заказа поставщику (на почту " +  АдресаДляОтправкиСтрокой + ")";
			КонецЕсли;
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Исключение
			Если ЭтоТестоваяБаза Тогда
				ТекстСообщения = "Не удалось отправить уведомление о необходимости контроля Заказа поставщику на ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + Символы.ПС + ОписаниеОшибки();
			Иначе
				ТекстСообщения = "Не удалось отправить уведомление о необходимости контроля Заказа поставщику" + Символы.ПС + ОписаниеОшибки();
			КонецЕсли;
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказПоставщику,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 19.11.2020

