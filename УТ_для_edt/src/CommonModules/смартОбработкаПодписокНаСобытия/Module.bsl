//++ смарт:ММ #022 193 19.02.2020 - доработка формирования Счетов на оплату на основании Заказов клиентов
Процедура смартЗаказКлиентаПриЗаписиПриЗаписи(Источник, Отказ) Экспорт
	
	 // Если по заказу не сформирован Счет, то сформировать новый; 
	 // если счет уже имеется,то переформировать его (если есть отличия в реквизитах, 
	 // например, изменился контрагент или сумма).
	 
	 Если Источник.Проведен 
		 //Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 04.03.2020 15:19:05
		И НЕ Источник.ОбменДанными.Загрузка 
		//Смарт }Подкин Алексей Иванович 04.03.2020 15:19:05
		//++ смарт:ММ #022 193 30.03.2020 
		И Год(ТекущаяДата()) = Год(Источник.Дата)
		//-- смарт:ММ 30.03.2020
		Тогда
		 
		 
		 //++ смарт:Балашов #1360 29.05.2023 убираем авто создание документа при записи 
		 СоздаватьСчет = Ложь;
		 ДокументСчет = Документы.СчетНаОплатуКлиенту.ПустаяСсылка();
		 //ДокументСчет = ПолучитьОбъектСчетНаОплату(Источник.Ссылка, СоздаватьСчет);
		 //-- смарт:Балашов #1360 29.05.2023 
		 
		 Если СоздаватьСчет Тогда
			 
			 ДокументСчет.Заполнить(Неопределено);
			 ЗаполнитьЗначенияСвойств(ДокументСчет, Источник);
			 
			 ДокументСчет.ДокументОснование = Источник.Ссылка;
			 
			 ДокументСчет.Дата = ТекущаяДатаСеанса();
			 ДокументСчет.Номер = Источник.Номер;
			 ДокументСчет.СуммаДокумента = Источник.СуммаДокумента;
			 ДокументСчет.ЧастичнаяОплата = Ложь;
			 
			 ДокументСчет.НазначениеПлатежа = Документы.СчетНаОплатуКлиенту.СформироватьНазначениеПлатежа(
					Источник.Номер,
					Источник.Ссылка);
			
			 ДокументСчет.Проведен = Ложь;
			 
			 Для Каждого ТекущийЭтап Из Источник.ЭтапыГрафикаОплаты Цикл
				 НовыйЭтап = ДокументСчет.ЭтапыГрафикаОплаты.Добавить();
				 НовыйЭтап.ДатаПлатежа    = ТекущийЭтап.ДатаПлатежа;
				 НовыйЭтап.СуммаПлатежа   = Источник.СуммаДокумента;
				 НовыйЭтап.ЭтоЗалогЗаТару = ТекущийЭтап.СуммаЗалогаЗаТару > 0;
				 НовыйЭтап.ПроцентПлатежа = 100;
			 КонецЦикла;
			 
			 Попытка
				 ДокументСчет.Записать(РежимЗаписиДокумента.Проведение);
				 //ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументСчет.Ссылка, ДокументСчет.Ссылка);
			 Исключение
				 ДокументСчет.Записать(РежимЗаписиДокумента.Запись);
				 //ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан, но не проведен документ " + ДокументСчет.Ссылка + Символы.ПС + ОписаниеОшибки(), ДокументСчет.Ссылка);
			 КонецПопытки;	
		 КонецЕсли;
		 
	 КонецЕсли;
	 
	 //++ смарт:ММ #090 436 29.12.2020 - Фоновое изменение заявки на пусконаладку при изменении заказа клиента
	 Если Источник.Проведен 
		И РольДоступна("смартДобавлениеИзменениеЗаявкиНаПускоНаладку")//смарт:rnp - добавлено ограничение на доступную роль, иначе запускаются и завершаются с ошибкой фоновые задания у пользователей без доступа к заявкам на ПНР 
		И НЕ Источник.ОбменДанными.Загрузка Тогда
		
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура();
		ПараметрыПроцедуры.Вставить("ДокументСсылка", Источник.Ссылка);
		
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ИзменитьЗаявкуНаПусконаладкуПоЗаказуКлиента", ПараметрыПроцедуры, ПараметрыВыполнения);

	КонецЕсли;
	 //-- смарт:ММ 29.12.2020
	 
	 //++ смарт:Демичев №1147 22.08.2022((  
	 Если Не Источник.Проведен и Источник.ПометкаУдаления Тогда
		 
		 мДокСчет = ПолучитьОбъектСчетНаОплату_Ссылку(Источник.Ссылка); 
		 
		 Если мДокСчет <> Неопределено Тогда
			 
			 ОбъектСчет = мДокСчет.ПолучитьОбъект();
			 
			 ОбъектСчет.УстановитьПометкуУдаления(Истина);
			 
			 Попытка
				 
				 ОбъектСчет.Записать();
				 
			 Исключение
				 
				 мОшибка = ОписаниеОшибки();
				 
				 ТекстСообщения = "При установке пометки удаления для Документа ""Счет на оплату"" №" + Строка(мДокСчет.Номер) + " от " + Строка(мДокСчет.Дата) + " произошла ошибка: " + мОшибка;
				 ЗаписьЖурналаРегистрации("смартОбработкаПодписокНаСобытия.смартЗаказКлиентаПриЗаписиПриЗаписи", УровеньЖурналаРегистрации.Ошибка,, Источник.Ссылка, ТекстСообщения);
				 				 
			 КонецПопытки;
			 
		 КонецЕсли;
		 
	 КонецЕсли;
	 //-- смарт:Демичев №1147 22.08.2022))  
	 
КонецПроцедуры //-- смарт:ММ 19.02.2020
//-- смарт:Демичев №1147 22.08.2022))  

//++ смарт:ММ #022 193 20.02.2020 - доработка формирования Счетов на оплату на основании Заказов клиентов
Функция ПолучитьОбъектСчетНаОплату(ЗаказКлиента, СоздаватьСчет = Ложь) Экспорт
	
	// Подразумевается, что на 1 Заказ 1 Счет на оплату
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СчетНаОплатуКлиенту.Ссылка         КАК Ссылка,
	|	СчетНаОплатуКлиенту.Организация    КАК Организация,
	|	СчетНаОплатуКлиенту.Контрагент     КАК Контрагент,
	|	СчетНаОплатуКлиенту.СуммаДокумента КАК СуммаДокумента,
	|	СчетНаОплатуКлиенту.БанковскийСчет КАК БанковскийСчет,
	|	ЗаказКлиента.Контрагент            КАК КонтрагентЗаказ,
	|	ЗаказКлиента.СуммаДокумента        КАК СуммаДокументаЗаказ,
	|	ЗаказКлиента.БанковскийСчет        КАК БанковскийСчетЗаказ
	|ИЗ
	|	Документ.СчетНаОплатуКлиенту КАК СчетНаОплатуКлиенту
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ПО СчетНаОплатуКлиенту.ДокументОснование = ЗаказКлиента.Ссылка
	//|			И (НЕ СчетНаОплатуКлиенту.ПометкаУдаления)
	|ГДЕ
	|	(ВЫРАЗИТЬ(СчетНаОплатуКлиенту.ДокументОснование КАК Документ.ЗаказКлиента)) = &ДокументОснование
	|	И ЗаказКлиента.Ссылка = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование", ЗаказКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоздаватьСчет = Ложь;
	ДокументСчет = Неопределено;
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Организация <> ЗаказКлиента.Организация Тогда
			
			//Смарт+ {заявка 347} Станчев Андрей
			УстановитьПривилегированныйРежим(Истина);
			ДокументСчет = Выборка.Ссылка.ПолучитьОбъект();
			ДокументСчет.Удалить();  // т.к. нам необходимо переделать документ по любому (удалим его непосредственно
			                         // и сразу создадим заново 
			
			ДокументСчет = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
			СоздаватьСчет = Истина;
			//Смарт- {заявка 347} Станчев Андрей

		ИначеЕсли Выборка.Контрагент <> Выборка.КонтрагентЗаказ 
			ИЛИ Выборка.СуммаДокумента <> Выборка.СуммаДокументаЗаказ 
			ИЛИ Выборка.БанковскийСчет <> Выборка.БанковскийСчетЗаказ Тогда
			
			ДокументСчет = Выборка.Ссылка.ПолучитьОбъект();
			ДокументСчет.ПометкаУдаления = Ложь;
			ДокументСчет.ЭтапыГрафикаОплаты.Очистить();
			ДокументСчет.ЧастичнаяОплата = Ложь;
			ДокументСчет.Аннулирован = Ложь;
			
			СоздаватьСчет = Истина;
		КонецЕсли;
	Иначе
		ДокументСчет = Документы.СчетНаОплатуКлиенту.СоздатьДокумент();
		СоздаватьСчет = Истина;
	КонецЕсли;
	
	Возврат ДокументСчет;
	
КонецФункции //-- смарт:ММ 20.02.2020

//++ смарт:ММ #010 137 02.01.2020
Процедура смартОбработкаПроведенияДокументовОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
		
	//++ смарт:ММ #044 224 15.02.2021 - Заявка на гарантийный ремонт 
	Если (ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары")
		ИЛИ ТипЗнч(Источник) = Тип("ДокументОбъект.РасходныйОрдерНаТовары"))
		И НЕ Источник.ОбменДанными.Загрузка 
		Тогда
		
		ДобавитьДвиженияПосмартОстаткиНаСкладеГарантийныхЗапчастей(Источник);
		
	КонецЕсли;
	//-- смарт:ММ 15.02.2021

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары")
		И Источник.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят
		// ++ 22.06.2020
		//И Источник.Склад = Справочники.смартПредопределенныеЗначения.ОсновнойСклад.Значение // Чтобы сюда не попадать, когда инженер сдает на склад ГАРАНТИЯ
		// -- 22.06.2020
		//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 04.03.2020 15:19:05
		И НЕ Источник.ОбменДанными.Загрузка 
		//Смарт }Подкин Алексей Иванович 04.03.2020 15:19:05
		
		//++ #6328 смарт: Тимофеева 15.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. ЗГР. Ошибка. 
		И НЕ (Источник.Отправитель = Справочники.смартПредопределенныеЗначения.СкладГарантийныхЗапчастейПоУмолчанию.Значение 
	 	И смартСервер.ЭтоСкладФизическогоЛица(Источник.Склад))
        //-- #6328 смарт: Тимофеева 15.04.2026 
		
		Тогда		
		
		//++ смарт:ММ #044 224 18.11.2020 - Заявка на гарантийный ремонт 
		// Перенесено в фоновое выполнение (сюда смартОбработкаПроведенияПриходныйОрдер)
		
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура();
		ПараметрыПроцедуры.Вставить("Источник", Источник.Ссылка);
				
		смартОтправлятьУведомления = Ложь;
		ДопСвойства = Источник.ДополнительныеСвойства;
		Если (ДопСвойства.Свойство("ЭтоНовый") И ДопСвойства.ЭтоНовый = Истина)
			ИЛИ (ДопСвойства.Свойство("смартОтправлятьУведомления") И ДопСвойства.смартОтправлятьУведомления = Истина) Тогда
			смартОтправлятьУведомления = Истина;
		КонецЕсли;	
		
		ПараметрыПроцедуры.Вставить("смартОтправлятьУведомления", смартОтправлятьУведомления);
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.смартОбработкаПроведенияПриходныйОрдер", ПараметрыПроцедуры, ПараметрыВыполнения);
		//-- смарт:ММ 18.11.2020

	//++ смарт:ММ #044 137 15.04.2020 
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РасходныйОрдерНаТовары")
		И Источник.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен
		И НЕ Источник.ОбменДанными.Загрузка 
		Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		//++ #Б1154 смарт: Шляпников 29.10.2024 / Контроль оперативных остатков в разрезе организаций
		//"ВЫБРАТЬ
		//|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.смартНомерЗаявкиНаГарантийныйРемонт КАК смартНомерЗаявкиНаГарантийныйРемонт,
		//|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура КАК Номенклатура,
		//|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение КАК Распоряжение
		//|ПОМЕСТИТЬ ВТ
