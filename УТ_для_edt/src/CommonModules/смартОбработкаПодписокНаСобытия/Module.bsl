			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 29.12.2020

//++ смарт:ММ #044 224 15.02.2021 - Заявка на гарантийный ремонт 
