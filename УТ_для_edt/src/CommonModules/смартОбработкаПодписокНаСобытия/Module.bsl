	                    |	ТабНоменклатура.Склад,
	                    |	смартОжидаемыеЗапчастиОбороты.Сотрудник
	                    |ИТОГИ ПО
	                    |	Сотрудник,
	                    |	Регистратор");  
	Запрос.УстановитьПараметр("Источник",Источник.Ссылка);
	Запрос.УстановитьПараметр("Имя","СкладыДляОжидаемыхЗапчастей");
