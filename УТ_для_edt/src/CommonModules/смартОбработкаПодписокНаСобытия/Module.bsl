		Движение.Номенклатура 	= СтрокаТовар.Номенклатура;
		// ++ 25.02.2021
		//Движение.НомерЗаявки 	= СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт;
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//Если ВРег(СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт) = "БЕЗ НОМЕРА" Тогда
		//	Движение.НомерЗаявки = "";
		//Иначе
		//	Движение.НомерЗаявки = СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт;
		//КонецЕсли;
		// --
		Движение.НомерЗаявки = СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка.Номер;
		Движение.Заявка = СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка;
		//-- #Б1132 смарт: Шляпников 14.10.2024

		Движение.Количество 	= СтрокаТовар.Количество;

		ЕстьДвижения = Истина;
		
