	                    |ГДЕ
	                    |	ПриходныйОрдерНаТоварыТовары.Ссылка = &Источник
	                    |	И ПриходныйОрдерНаТоварыТовары.Ссылка.Склад В
	                    |			(ВЫБРАТЬ
	                    |				ДополнительныеСведения.Объект КАК Объект
	                    |			ИЗ
	                    |				РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	                    |			ГДЕ
	                    |				ДополнительныеСведения.Свойство.Имя = &Имя
	                    |				И ДополнительныеСведения.Значение = ИСТИНА)
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	смартОжидаемыеЗапчастиОбороты.Организация,
	                    |	ПриходныйОрдерНаТоварыТовары.Ссылка.Склад,
	                    |	ПриходныйОрдерНаТоварыТовары.Номенклатура
	                    |
	                    |ОБЪЕДИНИТЬ ВСЕ
	                    |
	                    |ВЫБРАТЬ
	                    |	смартОжидаемыеЗапчастиОбороты.Организация,
	                    |	ЗаказПоставщикуТовары.Склад,
	                    |	ЗаказПоставщикуТовары.Номенклатура,
	                    |	ЗаказПоставщикуТовары.КоличествоУпаковок
	                    |ИЗ
	                    |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.смартОжидаемыеЗапчасти.Обороты КАК смартОжидаемыеЗапчастиОбороты
	                    |		ПО ЗаказПоставщикуТовары.Номенклатура = смартОжидаемыеЗапчастиОбороты.Номенклатура
	                    |			И ЗаказПоставщикуТовары.Ссылка.Организация = смартОжидаемыеЗапчастиОбороты.Организация
	                    |ГДЕ
	                    |	ЗаказПоставщикуТовары.Ссылка = &Источник
	                    |	И ЗаказПоставщикуТовары.Склад В
	                    |			(ВЫБРАТЬ
	                    |				ДополнительныеСведения.Объект КАК Объект
	                    |			ИЗ
	                    |				РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	                    |			ГДЕ
	                    |				ДополнительныеСведения.Свойство.Имя = &Имя
	                    |				И ДополнительныеСведения.Значение = ИСТИНА)
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
