	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021

			
		// ++ 20.12.2020
		//ТекстЗапчасть = "Запчасть ";
		//НомерЗаказаНаПеремещение = "";
		//
		//// ++ 16.11.2020
		//МассивНомеровЗаказовНаПеремещение = Новый Массив;
		//// --
		//Если СоответствиеНоменклатурыДляОповещения.Количество() > 1 Тогда
		//	ТекстЗапчасть = "Запчасти ";
		//КонецЕсли;
		//
		//Сч = 1;
		//Для Каждого ТекСоответствие Из СоответствиеНоменклатурыДляОповещения Цикл
		//	Для Каждого ЭлементСоответствия Из ТекСоответствие Цикл 
		//		Номенклатура = ЭлементСоответствия.Значение;
		//		НомерЗаказа = ЭлементСоответствия.Ключ;
		//		Если Сч > 1 Тогда
		//			ТекстЗапчасть = ТекстЗапчасть + ", " + Номенклатура;
		//			// ++ 16.11.2020
		//			Если МассивНомеровЗаказовНаПеремещение.Найти(НомерЗаказа) = Неопределено Тогда
		//			// --
		//			НомерЗаказаНаПеремещение = НомерЗаказаНаПеремещение + ", " + НомерЗаказа;
		//			// ++ 16.11.2020
		//			КонецЕсли;
		//			// --
		//		Иначе
		//			ТекстЗапчасть = ТекстЗапчасть + Номенклатура;
		//			// ++ 16.11.2020
		//			Если МассивНомеровЗаказовНаПеремещение.Найти(НомерЗаказа) = Неопределено Тогда
		//			// --
		//			НомерЗаказаНаПеремещение = НомерЗаказаНаПеремещение + НомерЗаказа;
		//			// ++ 16.11.2020
		//			КонецЕсли;
		//			// --
		//		КонецЕсли;
		//		
		//		Сч = Сч + 1;
		//	КонецЦикла;
		//КонецЦикла;

		//ТемаПисьма = НомерЗаявки;
							
		//ТекстПисьма = "" + ТекстЗапчасть + " по заявке на гарантийный ремонт " + НомерЗаявки 
		//+ " следует переместить на склад " + Склад + " по документу Заказ на перемещение №" + НомерЗаказаНаПеремещение;

		ТаблицаЗаказовНаПеремещение = ТаблицаНоменклатурыДляОповещения.Скопировать(,"ЗаказНаПеремещение");
		ТаблицаЗаказовНаПеремещение.Свернуть("ЗаказНаПеремещение");
		МассивЗаказовНаПеремещение = ТаблицаЗаказовНаПеремещение.ВыгрузитьКолонку("ЗаказНаПеремещение");
		
		Для Каждого ЗаказНаПеремещение Из МассивЗаказовНаПеремещение Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("ЗаказНаПеремещение", ЗаказНаПеремещение);
			
			НайденныеСтроки = ТаблицаНоменклатурыДляОповещения.НайтиСтроки(Отбор);
			ЗапчастиДляПеремещенияТекст = "";
			Для Каждого Строка Из НайденныеСтроки Цикл
				ЗапчастиДляПеремещенияТекст = ЗапчастиДляПеремещенияТекст 
				+ ?(ЗначениеЗаполнено(ЗапчастиДляПеремещенияТекст), Символы.ПС, "") 
				+ Строка.Номенклатура + " - " + Строка.НомерЗаявкиНаГарантийныйРемонт;
