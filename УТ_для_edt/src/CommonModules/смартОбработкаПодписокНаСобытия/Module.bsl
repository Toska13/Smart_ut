//++ смарт:ММ #090 436 29.12.2020 - Фоновое изменение заявки на пусконаладку при изменении заказа клиента
Процедура ИзменитьЗаявкуНаПусконаладкуПоЗаказуКлиента(Параметры, Адрес) Экспорт

	ИмяСобытияЖР = "смартФоновоеИзменениеЗаявкиНаПусконаладку";
	
	ОбщегоНазначенияБТС.Пауза(5);
	
	ДокументСсылка = Параметры.ДокументСсылка;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаПускоНаладку.Ссылка КАК ЗаявкаНаПусконаладку,
	|	смартЗаявкаНаПускоНаладку.Номер КАК Номер,
	|	смартЗаявкаНаПускоНаладку.Дата КАК Дата,
	|	смартЗаявкаНаПускоНаладку.ДокументОснование КАК ЗаказКлиента,
	|	смартЗаявкаНаПускоНаладку.Организация КАК Организация,
	|	смартЗаявкаНаПускоНаладку.Партнер КАК Партнер,
	|	смартЗаявкаНаПускоНаладку.Контрагент КАК Контрагент,
	|	ЗаказКлиента.Номер КАК ЗаказКлиентаНомер,
	|	ЗаказКлиента.Дата КАК ЗаказКлиентаДата,
	|	ЗаказКлиента.Контрагент КАК ЗаказКлиентаКонтрагент,
	|	ЗаказКлиента.Партнер КАК ЗаказКлиентаПартнер,
	|	ЗаказКлиента.Организация КАК ЗаказКлиентаОрганизация,
	|	ЗаказКлиента.КонтактноеЛицо КАК ЗаказКлиентаКонтактноеЛицо
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ПО смартЗаявкаНаПускоНаладку.ДокументОснование = ЗаказКлиента.Ссылка
	|ГДЕ
	|	смартЗаявкаНаПускоНаладку.ДокументОснование = &ДокументОснование
	|	И НЕ смартЗаявкаНаПускоНаладку.ПометкаУдаления
	|	И смартЗаявкаНаПускоНаладку.Статус <> &СтатусЗакрыта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаПускоНаладкуОборудование.Ссылка,
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Серия КАК Серия,
	|	смартЗаявкаНаПускоНаладкуОборудование.Оборудование КАК Оборудование
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ПО смартЗаявкаНаПускоНаладкуОборудование.Оборудование = ЗаказКлиентаТовары.Номенклатура
	|			И смартЗаявкаНаПускоНаладкуОборудование.Серия = ЗаказКлиентаТовары.Серия
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &ДокументОснование
	|	И НЕ смартЗаявкаНаПускоНаладкуОборудование.Ссылка.ПометкаУдаления
	|	И смартЗаявкаНаПускоНаладкуОборудование.Ссылка.Статус = &СтатусЗакрыта
	|	И ЗаказКлиентаТовары.Номенклатура ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартЗаявкаНаПускоНаладкуОборудование.НомерСтроки УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументСсылка);
	Запрос.УстановитьПараметр("СтатусЗакрыта", Перечисления.смартСтатусыЗаявокНаПускоНаладку.Размещена); //автоматически изменяем только еще не принятые в работу заявки
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаСтрокиКУдалению = Результат[Результат.Количество() - 1].Выбрать();
	Выборка = Результат[Результат.Количество() - 2].Выбрать();
	
	БылиИзменения = Ложь;
	ТекстСообщения = "";
	ТекстСообщенияДоп = "";
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.ЗаявкаНаПусконаладку.ПолучитьОбъект();
		ЗаказКлиентаСсылка = Выборка.ЗаказКлиента;
		
		НомерДокумента = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументСсылка.Номер);
		
		ТекстСообщения = "Изменена заявка на пусконаладку №" + НомерДокумента + " от " + Формат(Выборка.Дата, "ДФ='dd.MM.yyyy ""г.""'") 
		+ ", т.к. был изменен заказ клиента №" + Выборка.ЗаказКлиентаНомер + " от " + Формат(Выборка.ЗаказКлиентаДата, "ДФ='dd.MM.yyyy ""г.""'") 
		+ Символы.ПС + "Изменения:" + Символы.ПС;
		
		ИзмененныеРеквизиты = "";
		//организация
		Если Выборка.ЗаказКлиентаОрганизация <> Выборка.Организация Тогда
			ИзмененныеРеквизиты = "Организация";
			ДокОбъект.Организация = Выборка.ЗаказКлиентаОрганизация;
			БылиИзменения = Истина;
		КонецЕсли;
		
		//++ смарт:ММ #093 449 05.02.2021 - Доработка Заявки на ПНР
		Если НЕ ДокОбъект.ИзменитьКонтрагентаИКлиентаВРучномРежиме Тогда
			//-- смарт:ММ 05.02.2021
			
			//партнер
			ИзменилсяПартнер = Ложь;
			Если Выборка.ЗаказКлиентаПартнер <> Выборка.Партнер Тогда
				ИзменилсяПартнер = Истина;
				ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Партнер";
				ДокОбъект.Партнер = Выборка.ЗаказКлиентаПартнер;
				БылиИзменения = Истина;
			КонецЕсли;
			
			//контрагент
			ИзменилсяКонтрагент = Ложь;
			Если Выборка.ЗаказКлиентаКонтрагент <> Выборка.Контрагент Тогда
				
				ИзменилсяКонтрагент = Истина;
				
				ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Контрагент";
				ДокОбъект.Контрагент = Выборка.ЗаказКлиентаКонтрагент;
				
				ДокОбъект.ЗаполнитьРеквизитыПоКонтрагенту();
				
				Если ДокОбъект.АдресВыезда <> Выборка.ЗаявкаНаПусконаладку.АдресВыезда Тогда
					ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Адрес выезда";	
				КонецЕсли;
				
				Если ДокОбъект.НомерТелефонаКонтрагента <> Выборка.ЗаявкаНаПусконаладку.НомерТелефонаКонтрагента Тогда
					ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Номер телефона контрагента";	
				КонецЕсли;
				
				БылиИзменения = Истина;
			КонецЕсли;
		
			// Контактные лица
			КонтактноеЛицо = Выборка.ЗаказКлиентаКонтактноеЛицо;
			
			ИзменилосьКонтактноеЛицо = Ложь;
			//смарт rnp 497 13.04.2021  контактное лицо меняем только если изменился партнер 
			Если ЗначениеЗаполнено(КонтактноеЛицо) И ИзменилсяПартнер Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("КонтактноеЛицо", КонтактноеЛицо);
				НайденныеСтроки = ДокОбъект.КонтактныеЛица.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					Если ДокОбъект.КонтактныеЛица.Количество() = 1 Тогда
						// Если в документе одна строка с контактным лицом и оно не совпало, то подменяется на КЛ из Заказа клиента
						СтрокаКИ = ДокОбъект.КонтактныеЛица[0];
						СтрокаКИ.КонтактноеЛицо = КонтактноеЛицо;
						СтруктураДанныеКонтактногоЛица = ДокОбъект.ПолучитьДанныеКонтактногоЛица(КонтактноеЛицо);			
						СтрокаКИ.ТелефонКонтактногоЛица = СтруктураДанныеКонтактногоЛица.Телефон;
						СтрокаКИ.АдресЭПКонтактногоЛица = СтруктураДанныеКонтактногоЛица.ЭлПочта;
						
						ИзменилосьКонтактноеЛицо = Истина;
						
					Иначе
						// Контактного лица из заказа клиента нет в заявке на пусконаладку, но есть несколько других строк.
						Если ИзменилсяКонтрагент Тогда
							
							ДокОбъект.КонтактныеЛица.Очистить();
							СтрокаКИ = ДокОбъект.КонтактныеЛица.Добавить();
							СтрокаКИ.КонтактноеЛицо = КонтактноеЛицо;
							СтруктураДанныеКонтактногоЛица = ДокОбъект.ПолучитьДанныеКонтактногоЛица(КонтактноеЛицо);			
							СтрокаКИ.ТелефонКонтактногоЛица = СтруктураДанныеКонтактногоЛица.Телефон;
							СтрокаКИ.АдресЭПКонтактногоЛица = СтруктураДанныеКонтактногоЛица.ЭлПочта;
							ИзменилосьКонтактноеЛицо = Истина;
						КонецЕсли;
						
					КонецЕсли;			
				КонецЕсли;
			Иначе
				Если ИзменилсяПартнер Тогда
					ДокОбъект.КонтактныеЛица.Очистить();
					ИзменилосьКонтактноеЛицо = Истина;	
				КонецЕсли;
			КонецЕсли;
			
			Если ИзменилосьКонтактноеЛицо Тогда
				БылиИзменения = Истина;
				ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Контактное лицо";
			КонецЕсли;
			
		//++ смарт:ММ #093 449 05.02.2021 - Доработка Заявки на ПНР
		КонецЕсли;
		//-- смарт:ММ 05.02.2021
	
		// Оборудование
		
		ИзменялосьОборудование = Ложь;
		
		// 1. Удаление из заявки на пусконаладку номенклатуры, которой нет в заказе клиента
		
		ВыборкаСтрокиКУдалению.Сбросить();
		СтруктурПоиска = Новый Структура("Ссылка", Выборка.ЗаявкаНаПусконаладку); 
		Пока ВыборкаСтрокиКУдалению.НайтиСледующий(СтруктурПоиска) Цикл
			ДокОбъект.Оборудование.Удалить(ВыборкаСтрокиКУдалению.НомерСтроки - 1);
	        ИзменялосьОборудование = Истина;
		КонецЦикла;	
		
		// 2. Изменение существующих и добавление новых записей по оборудованию
		
		ТоварыПлоттерыСерии = Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение;
		ГарантийныйСрокНаОборудование = Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаОборудованиеПоУмолчанию.Значение;		
		ГарантийныйСрокНаПечатающиеГоловки = Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаПечатающиеГоловкиПоУмолчанию.Значение;
		РастровыйПроцессор = Справочники.смартПредопределенныеЗначения.РастровыйПроцессорПоУмолчанию.Значение;

		ЗапросОборудование = Новый Запрос;
		ЗапросОборудование.Текст = ДокОбъект.ПолучитьТекстЗапросаОборудованиеИзЗаказаКлиента();
		ЗапросОборудование.УстановитьПараметр("ТоварПлоттерыСерии", ТоварыПлоттерыСерии);
		ЗапросОборудование.УстановитьПараметр("ЗаказКлиента", ЗаказКлиентаСсылка);
		ЗапросОборудование.УстановитьПараметр("ОтборНоменклатура", Ложь);
		ЗапросОборудование.УстановитьПараметр("Номенклатура", Неопределено);
		
		ВыборкаТовары = ЗапросОборудование.Выполнить().Выбрать();
				
		Пока ВыборкаТовары.Следующий() Цикл
						
			Отбор = Новый Структура;
			Отбор.Вставить("Оборудование", ВыборкаТовары.Номенклатура);
			//Отбор.Вставить("Серия", ВыборкаТовары.Серия); //смарт rnp 497 13.04.2021, закомментировано, иначе добавляется строка в заявку, если по серии не нашлось оборудование (в момент, когда в заказе указали серию)
			НайденныеСтроки = ДокОбъект.Оборудование.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 1 Тогда
				
				СтрокаОборудование = НайденныеСтроки[0];
				Если ВыборкаТовары.Отменено Тогда
					// Удалить строку из заявки на пусконаладку
					ДокОбъект.Оборудование.Удалить(СтрокаОборудование);
					ИзменялосьОборудование = Истина;
				Иначе
					Если НачалоДня(СтрокаОборудование.ДатаОтгрузки) <> НачалоДня(ВыборкаТовары.ДатаОтгрузки) Тогда					
						СтрокаОборудование.ДатаОтгрузки = ВыборкаТовары.ДатаОтгрузки;
						ИзменялосьОборудование = Истина;
					КонецЕсли;
					Если СтрокаОборудование.Серия <> ВыборкаТовары.Серия Тогда
						СтрокаОборудование.Серия = ВыборкаТовары.Серия;
						ИзменялосьОборудование = Истина;
					КонецЕсли;					
				КонецЕсли;
			ИначеЕсли НайденныеСтроки.Количество() > 1 Тогда
				//смарт rnp 497 13.04.2021
				//!!! доделать если в заявке на ПНР несколько строк с одинаковым оборудованием, надо запомнить, какую строку уже автоматически изменили выше
				ТекстСообщенияДоп = ". В заявке на пусконаладку присутствуют строки с одинаковым оборудованием! Проверьте правильность заполнения даты отгрузки  серийных домеров!!!";
			ИначеЕсли НайденныеСтроки.Количество() = 0 Тогда
				
				НоваяСтрока = ДокОбъект.Оборудование.Добавить();
				НоваяСтрока.Оборудование 						= ВыборкаТовары.Номенклатура;
				
				//++ #Б-2768 смарт: Лопато 21.03.2025 //Заполнение корректного срока гарантии на оборудование и ПГ при формировании ПНР.  
				СтруктураГарантияНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Оборудование, "смартГарантияНаОборудование, смартГарантияНаПечатающиеГоловки");
				
				НоваяСтрока.ГарантийныйСрокНаОборудование 		= ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаОборудование), 
																	СтруктураГарантияНоменклатуры.смартГарантияНаОборудование, 
																	ГарантийныйСрокНаОборудование);

				НоваяСтрока.ГарантийныйСрокНаПечатающиеГоловки	= ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки), 
																	СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки, 
																	ГарантийныйСрокНаПечатающиеГоловки);
				//-- #Б-2768 смарт: Лопато 21.03.2025
				
				НоваяСтрока.РастровыйПроцессор 					= РастровыйПроцессор;
				НоваяСтрока.ДатаОтгрузки 						= ВыборкаТовары.ДатаОтгрузки;
				НоваяСтрока.Серия 								= ВыборкаТовары.Серия;
				
				ИзменялосьОборудование = Истина;
				
			КонецЕсли;
						
		КонецЦикла;

		Если ИзменялосьОборудование Тогда
			БылиИзменения = Истина;
			ИзмененныеРеквизиты = ИзмененныеРеквизиты + ?(ЗначениеЗаполнено(ИзмененныеРеквизиты), Символы.ПС, "") + "- Оборудование";
		КонецЕсли;
				
		Если БылиИзменения Тогда
			
			ТекстСообщения = ТекстСообщения + ИзмененныеРеквизиты + ТекстСообщенияДоп;
			
			Попытка 
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				ОтправитьУведомлениеМенеджеруЗаявкиНаПусконаладку(Выборка.ЗаявкаНаПусконаладку, ТекстСообщения);
			Исключение
				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,, Выборка.ЗаявкаНаПусконаладку, "Не удалось изменить заявку на пусконаладку при изменении заказа клиента №" + Выборка.ЗаказКлиентаНомер);
			КонецПопытки;			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 29.12.2020

//++ смарт:ММ #090 436 29.12.2020 - Фоновое изменение заявки на пусконаладку при изменении заказа клиента
Процедура ОтправитьУведомлениеМенеджеруЗаявкиНаПусконаладку(ДокументСсылка, ТекстСообщения)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Ответственный) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытияЖР = "смартОтправкаУведомленияМенеджеруЗаявкиНаПусконаладку";
		
	АдресаДляОтправкиСтрокой = "";
