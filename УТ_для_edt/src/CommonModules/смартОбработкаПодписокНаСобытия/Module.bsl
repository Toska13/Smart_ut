Процедура ОтправитьУведомлениеПриходНаСкладЗапчастейПодЗаказ(Заявка, СписокНоменклатуры,СкладГарантия=Неопределено)
//-- #1369 смарт: Фролов 06.06.2023	
	// ++ 26.11.2020 - вызывается еще из обработки смартОприходованиеГарантийныхЗапчастей при поступлении с флагом "Прямая поставка"
	Экспорт
	// --
	
	НомерЗаявки = Заявка.Номер;
	Серия = Заявка.Серия; // смарт Минаева 23.03.2022 #942  
	Контрагент = Заявка.Контрагент;	// смарт Минаева 23.03.2022 #942 
	
	АдресаДляОтправкиСтрокой = "";
	// ++ 27.11.2020
	//МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийПриходНаСкладЗапчастейПодЗаказ(АдресаДляОтправкиСтрокой, Заявка);
	//++ #1369 смарт: Фролов 06.06.2023 //Рассылка при поступлении запчастей Ковчег
	//СтруктураАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийПриходНаСкладЗапчастейПодЗаказ(АдресаДляОтправкиСтрокой, Заявка);
	СтруктураАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийПриходНаСкладЗапчастейПодЗаказ(АдресаДляОтправкиСтрокой, Заявка,СкладГарантия);
	//-- #1369 смарт: Фролов 06.06.2023
	МассивАдресовДляОтправки = СтруктураАдресовДляОтправки.АдресаОсновные;
	МассивАдресовДляОтправкиКопия = СтруктураАдресовДляОтправки.АдресаКопия;
	// --
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021

					 
		Склад = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
		ТемаПисьма = НомерЗаявки;
		
		//++ смарт:Минаева #942 24.03.2022 17:29:05 обновлен текс сообщения
		ТекстПисьма = "Запчасть " + СписокНоменклатуры + " по заявке на гарантийный ремонт " + НомерЗаявки 
		+ ", серии " + Серия + ", " + Контрагент + " поступила на склад " + Склад + ". Получите запчасть на складе. Для оформления документов пользуйтесь кнопкой ""Взять на складе"" в заявке на гарантийный ремонт в 1С.";
		//-- смарт:Минаева #942 24.03.2022 17:29:05
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		// ++ 21.11.2020
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, МассивАдресовДляОтправкиКопия);
		//++ #1404 смарт: Фролов 27.07.2023 //контроль отслеживания поступлений и зависших запчастей по гарантии  
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, МассивАдресовДляОтправкиКопия, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		Если Заявка.Статус=Перечисления.СтатусыКассовойСмены.Закрыта Тогда
			ЗаявкаЗакрыта=Истина;
		Иначе
			ЗаявкаЗакрыта=Ложь;
		КонецЕсли;	
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, МассивАдресовДляОтправкиКопия, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза,,,,ЗаявкаЗакрыта);
		//-- #1404 смарт: Фролов 27.07.2023
		//-- смарт:ММ 03.03.2021
		// --
		//++ #1404 смарт: Фролов 27.07.2023 //контроль отслеживания поступлений и зависших запчастей по гарантии 
		//ПараметрыПисьма		
		//-- #1404 смарт: Фролов 27.07.2023
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о поступлении гарантийных запчастей на склад для запчастей под заказ НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
			Иначе
			//-- смарт:ММ 03.03.2021
			
			ТекстСообщения = "Отправлено уведомление о поступлении гарантийных запчастей на склад для запчастей под заказ (на почту " +  АдресаДляОтправкиСтрокой + ")";
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			КонецЕсли;
			//-- смарт:ММ 03.03.2021
			
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Исключение 
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,Заявка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить уведомление о поступлении гарантийных запчастей на склад для запчастей под заказ" + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 19.10.2020

//++ смарт:ММ 19.10.2020 #044 224 Продолжение #001
//++ #1369 смарт: Фролов 06.06.2023 //Рассылка при поступлении запчастей Ковчег  
//Функция ПолучитьАдресаПолучателейУведомленийПриходНаСкладЗапчастейПодЗаказ(АдресаДляОтправкиСтрокой)
Функция ПолучитьАдресаПолучателейУведомленийПриходНаСкладЗапчастейПодЗаказ(АдресаДляОтправкиСтрокой, Заявка,СкладГарантия=Неопределено)
//-- #1369 смарт: Фролов 06.06.2023

	// Уведомление отправляется получаетелям, которые задаются в справочнике смартПредопределенныеЗначения "Адреса эл. почты для уведомлений об отмене отправки гарантийных запчастей"
	// + надо вытащить ответственного за "склад инженера": в заявке смотрим склад инженера -> в карточке склада находим реквизит Ответственный -> по этому физику находим пользователя -> у пользователя берем рабочую почту 
	// + ответственного за заявку
	
	// ++ 21.11.2020
	// + руководителя СЦ (или руководителя подразделения, если руководитель СЦ не заполнен)  
	// Адреса из предопределенного справочника перенести в копию адресатов, остальных оставить в основных получателях
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("АдресаКопия", Новый Массив);
	СтруктураВозврата.Вставить("АдресаОсновные", Новый Массив);
	//--
	
	
	СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.АдресаДляУведомленийОбОтменеОтправкиГарантийныхЗапчастей;
	
	// Раскомментировать, если в справочнике должны будут храниться пользователи, а не адреса эл. почты
	//Возврат смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаНаПредопределенноеЗначение, АдресаДляОтправкиСтрокой);
	
	Запрос = Новый Запрос;
	//++ #1369 смарт: Фролов 06.06.2023 //Рассылка при поступлении запчастей Ковчег  
	Если СкладГарантия=Неопределено Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Склады.ТекущийОтветственный КАК ТекущийОтветственный,
		|	Пользователи.Ссылка КАК ПользовательСклад
		|ПОМЕСТИТЬ ВТ_ПользовательОтветственныйЗаСклад
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО Склады.ТекущийОтветственный = Пользователи.ФизическоеЛицо
		|ГДЕ
		|	Склады.Ссылка = &СкладИнженера
		// ++ 21.11.2020
		|	И Склады.ТекущийОтветственный <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		// --
		|
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартПредопределенныеЗначения.Значение КАК Значение
		// ++ 21.11.2020
		|	, ""Копия"" КАК ВидПолучателя
		// --
		|ИЗ
		|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
		|ГДЕ
		|	смартПредопределенныеЗначения.Ссылка = &ПредопределенноеЗначение
		|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
		|	И НЕ смартПредопределенныеЗначения.СписокЗначений
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	смартПредопределенныеЗначенияЗначения.Значение
		// ++ 21.11.2020
		|	, ""Копия""
		// --
		|ИЗ
		|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
		|ГДЕ
		|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенноеЗначение
		|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
		|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПользователиСпр.смартРабочаяПочта = """"
		|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
		|		ИНАЧЕ ПользователиСпр.смартРабочаяПочта
		|	КОНЕЦ
		// ++ 21.11.2020
		|	, ""Основной""
		// --
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|		ПРАВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
		|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиСпр.Ссылка
		|			И ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя
		|ГДЕ
		|	ПользователиСпр.Ссылка = &Пользователь
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПользователиСпр.смартРабочаяПочта = """"
		|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
		|		ИНАЧЕ ПользователиСпр.смартРабочаяПочта
		|	КОНЕЦ
		// ++ 21.11.2020
		|	, ""Основной""
		// --
		|ИЗ
		|	Справочник.Пользователи КАК ПользователиСпр
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиСпр.Ссылка
		|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПользовательОтветственныйЗаСклад КАК ВТ_ПользовательОтветственныйЗаСклад
		|		ПО ПользователиСпр.Ссылка = ВТ_ПользовательОтветственныйЗаСклад.ПользовательСклад";
	
		Запрос.УстановитьПараметр("ПредопределенноеЗначение", СсылкаНаПредопределенноеЗначение); 
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Склады.ТекущийОтветственный КАК ТекущийОтветственный,
		|	Пользователи.Ссылка КАК ПользовательСклад
		|ПОМЕСТИТЬ ВТ_ПользовательОтветственныйЗаСклад
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО Склады.ТекущийОтветственный = Пользователи.ФизическоеЛицо
		|ГДЕ
		|	Склады.Ссылка = &СкладИнженера
		|	И Склады.ТекущийОтветственный <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СкладысмартАдресаДляОтправкиОповещенийОПриходеТовара.смартАдресДляОтправкиОповещенияОПриходеТовара КАК Значение,
		|	""Копия"" КАК ВидПолучателя
		|ИЗ
		|	Справочник.Склады.смартАдресаДляОтправкиОповещенийОПриходеТовара КАК СкладысмартАдресаДляОтправкиОповещенийОПриходеТовара
		|ГДЕ
		|	НЕ СкладысмартАдресаДляОтправкиОповещенийОПриходеТовара.Ссылка.ПометкаУдаления
		|	И СкладысмартАдресаДляОтправкиОповещенийОПриходеТовара.Ссылка = &СкладГарантия
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПользователиСпр.смартРабочаяПочта = """"
		|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
		|		ИНАЧЕ ПользователиСпр.смартРабочаяПочта
		|	КОНЕЦ,
		|	""Основной""
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|		ПРАВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
		|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиСпр.Ссылка
		|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
		|ГДЕ
		|	ПользователиСпр.Ссылка = &Пользователь
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ПользователиСпр.смартРабочаяПочта = """"
		|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
		|		ИНАЧЕ ПользователиСпр.смартРабочаяПочта
		|	КОНЕЦ,
		|	""Основной""
		|ИЗ
		|	Справочник.Пользователи КАК ПользователиСпр
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|		ПО (ПользователиКонтактнаяИнформация.Ссылка = ПользователиСпр.Ссылка)
		|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПользовательОтветственныйЗаСклад КАК ВТ_ПользовательОтветственныйЗаСклад
		|		ПО ПользователиСпр.Ссылка = ВТ_ПользовательОтветственныйЗаСклад.ПользовательСклад";	
	КонецЕсли;
	Запрос.УстановитьПараметр("СкладГарантия", СкладГарантия);
	
	//-- #1369 смарт: Фролов 06.06.2023	
	Запрос.УстановитьПараметр("Пользователь", Заявка.Ответственный);
	Запрос.УстановитьПараметр("СкладИнженера", Заявка.СкладИнженера);
	Запрос.УстановитьПараметр("ПочтаПользователя", Справочники.ВидыКонтактнойИнформации.EmailПользователя);

	
	МассивАдресов = Новый Массив;
	// ++ 21.11.2020
	МассивАдресовКопия = Новый Массив;
	// --
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			// ++ 21.11.2020
			Если Выборка.ВидПолучателя = "Копия" Тогда
				МассивАдресовКопия.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			Иначе
			// --
				МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			// ++ 21.11.2020
			КонецЕсли;
		    // --
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
	
	// ++ 21.11.2020
	//Возврат МассивАдресов;
	
	// ++ 23.11.2020
	Подразделение = Заявка.Ответственный.Подразделение;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		АдресаРуководителей = смартОбщегоНазначения.ПолучитьАдресРуководителяПредставительства(Подразделение, АдресаДляОтправкиСтрокой);
		Если ЗначениеЗаполнено(АдресаРуководителей) Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивАдресов, АдресаРуководителей, Истина);		
		КонецЕсли;
	КонецЕсли;
	
	СтруктураВозврата.Вставить("АдресаКопия", МассивАдресовКопия);
	СтруктураВозврата.Вставить("АдресаОсновные", МассивАдресов);
	
	Возврат СтруктураВозврата;
	// --
	
КонецФункции //-- смарт:ММ 19.10.2020

//++ смарт:ММ #037 15.03.2020
Процедура смартПометкаУдаленияФискальныеОперацииПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ФискальныеОперации.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
		|ГДЕ
		|	ФискальныеОперации.ДокументОснование = &ДокументОснование";
		
		Запрос.УстановитьПараметр("ДокументОснование", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ИмяРС = Метаданные.РегистрыСведений.ФискальныеОперации.Синоним;
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ нельзя пометить на удаление, т.к. по нему есть данные в регистре сведений " + ИмяРС);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 15.03.2020

//++ смарт:ММ #084 407 01.12.2020 - Доработка Заявки на пусконаладку
Процедура смартОбработкаПроведенияРеализацияТиУОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура();
		ПараметрыПроцедуры.Вставить("Источник", Источник.Ссылка);
						
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.смартОбработкаПроведенияРеализацияТиУ", ПараметрыПроцедуры, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 01.12.2020

//++ смарт:ММ #084 407 01.12.2020 - Доработка Заявки на пусконаладку
Процедура смартОбработкаПроведенияРеализацияТиУ(Параметры, Адрес) Экспорт
	
	// ++ 08.12.2020
	ОбщегоНазначенияБТС.Пауза(5);
	// --

	// Заполнение серий в связанной Заявке на пусконаладку
	
	РеализацияТоваровУслугСсылка = Параметры.Источник;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК ЗаказКлиента
	|ПОМЕСТИТЬ ВТ_ЗаказКлиента
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &Ссылка
	|	И РеализацияТоваровУслуг.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	|	И РеализацияТоваровУслуг.ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартЗаявкаНаПускоНаладку.Ссылка КАК ЗаявкаНаПускоНаладку
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЗаказКлиента КАК ВТ_ЗаказКлиента
	|		ПО смартЗаявкаНаПускоНаладку.ДокументОснование = ВТ_ЗаказКлиента.ЗаказКлиента";
	
	Запрос.УстановитьПараметр("Ссылка", РеализацияТоваровУслугСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаявкаНаПусконаладку = Выборка.ЗаявкаНаПускоНаладку;
		
		Если ЗначениеЗаполнено(ЗаявкаНаПусконаладку) Тогда
			
			ДокОбъект = ЗаявкаНаПусконаладку.ПолучитьОбъект();
			БылиИзменения = Ложь;
			
			Для Каждого ТекСтрока Из РеализацияТоваровУслугСсылка.Товары Цикл
				Отбор = Новый Структура;
				Отбор.Вставить("Оборудование", ТекСтрока.Номенклатура);
				НайденныеСтроки = ДокОбъект.Оборудование.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						Если НЕ ЗначениеЗаполнено(НайденнаяСтрока.Серия) 
							И ЗначениеЗаполнено(ТекСтрока.Серия) Тогда
							НайденнаяСтрока.Серия = ТекСтрока.Серия;
							БылиИзменения = Истина;
						КонецЕсли;						
					КонецЦикла;
				КонецЕсли;				
			КонецЦикла;
			
			Если БылиИзменения Тогда
				Попытка 
					ДокОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	//++ смарт:ММ #097 460 01.03.2021 Безвозмездная передача
	
	Если РеализацияТоваровУслугСсылка.смартБезвозмезднаяПередача 
		И ЗначениеЗаполнено(РеализацияТоваровУслугСсылка.ЗаказКлиента) Тогда
		
		// Создание Списания задолженности
		
		Заказ = РеализацияТоваровУслугСсылка.ЗаказКлиента;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписаниеЗадолженностиЗадолженность.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СписаниеЗадолженности.Задолженность КАК СписаниеЗадолженностиЗадолженность
		|ГДЕ
		|	СписаниеЗадолженностиЗадолженность.Заказ = &Заказ
		|	И НЕ СписаниеЗадолженностиЗадолженность.Ссылка.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыСКлиентамиПоСрокамОстатки.ДолгОстаток КАК ДолгОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
		|			,
		|			ОбъектРасчетов = &Заказ
		|				И РасчетныйДокумент = &Реализация
		|				И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент) КАК РасчетыСКлиентамиПоСрокамОстатки";
		
		Запрос.УстановитьПараметр("Заказ", 		Заказ);
		Запрос.УстановитьПараметр("Реализация", РеализацияТоваровУслугСсылка);
		Запрос.УстановитьПараметр("Контрагент", Заказ.Контрагент);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		ЗапросДокумент = РезультатЗапроса[РезультатЗапроса.Количество() - 2];
		
		Если ЗапросДокумент.Пустой() Тогда
			
			ВыборкаДолг = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
			
			Если ВыборкаДолг.Следующий() И ВыборкаДолг.ДолгОстаток > 0 Тогда
				
				НовыйДокумент = Документы.СписаниеЗадолженности.СоздатьДокумент();
				НовыйДокумент.Дата = ТекущаяДата();
				НовыйДокумент.Организация = Заказ.Организация;
				НовыйДокумент.Контрагент = Заказ.Контрагент;
				НовыйДокумент.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности;
				НовыйДокумент.СтатьяРасходов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьКлиентов;
				
				НоваяСтрока = НовыйДокумент.Задолженность.Добавить();
				НоваяСтрока.ТипРасчетов 			= Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
				НоваяСтрока.Партнер 				= Заказ.Партнер;
				НоваяСтрока.Заказ 					= Заказ;
				НоваяСтрока.ВалютаВзаиморасчетов 	= Заказ.Валюта;
				НоваяСтрока.ИдентификаторСтроки 	= Новый УникальныйИдентификатор;
				НоваяСтрока.Сумма 					= ВыборкаДолг.ДолгОстаток;
				
				Попытка
					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;

	//-- смарт:ММ 01.03.2021
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //-- смарт:ММ 01.12.2020

//++ смарт:ММ #044 224 03.12.2020 - Заявка на гарантийный ремонт 
Процедура смартРегистрацияВЦепочкеДокументовПоставкиОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	ВыполнятьФоновуюПроверкуЦепочки = Ложь;
	МассивЗаказовДляФоновойПроверки = Новый Массив;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеТоваровУслуг") Тогда
		
		ЗаказПоставщику = Источник.ЗаказПоставщику;
		
		Если ЗначениеЗаполнено(ЗаказПоставщику) И ЗаказПоИмпорту(ЗаказПоставщику) Тогда
			УстановитьПривилегированныйРежим(Истина);
			МенеджерЗаписи = РегистрыСведений.смартЦепочкиДокументовПоставки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ЗаказПоставщику = ЗаказПоставщику;
			МенеджерЗаписи.ХозОперация = ЗаказПоставщику.ХозяйственнаяОперация;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ПриобретениеТоваровУслуг <> Источник.Ссылка Тогда
				МенеджерЗаписи.ПриобретениеТоваровУслуг = Источник.Ссылка;
				МенеджерЗаписи.Записать();
				ВыполнятьФоновуюПроверкуЦепочки = Истина;
				МассивЗаказовДляФоновойПроверки.Добавить(ЗаказПоставщику);
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;		
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ТаможеннаяДекларацияИмпорт") Тогда
		
		Для Каждого СтрокаТовар Из Источник.Товары Цикл
			
			ДокументПриобретение = СтрокаТовар.ДокументПоступления;
			
			ЗаказПоставщику = ДокументПриобретение.ЗаказПоставщику;
			
			Если ЗначениеЗаполнено(ЗаказПоставщику) И ЗаказПоИмпорту(ЗаказПоставщику) Тогда
				УстановитьПривилегированныйРежим(Истина);
				МенеджерЗаписи = РегистрыСведений.смартЦепочкиДокументовПоставки.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.ЗаказПоставщику = ЗаказПоставщику;
				МенеджерЗаписи.ХозОперация = ЗаказПоставщику.ХозяйственнаяОперация;
				МенеджерЗаписи.Прочитать();
				Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ТаможеннаяДекларацияИмпорт <> Источник.Ссылка Тогда
					МенеджерЗаписи.ТаможеннаяДекларацияИмпорт = Источник.Ссылка;
					МенеджерЗаписи.Записать();
					ВыполнятьФоновуюПроверкуЦепочки = Истина;
					МассивЗаказовДляФоновойПроверки.Добавить(ЗаказПоставщику);
				КонецЕсли;
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровНаСклад") Тогда
		
		ЗаказПоставщику = Источник.Распоряжение;
		
		Если ЗначениеЗаполнено(ЗаказПоставщику) 
			И ТипЗнч(ЗаказПоставщику) = Тип("ДокументСсылка.ЗаказПоставщику")
			И ЗаказПоИмпорту(ЗаказПоставщику) Тогда
			УстановитьПривилегированныйРежим(Истина);
			МенеджерЗаписи = РегистрыСведений.смартЦепочкиДокументовПоставки.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ЗаказПоставщику = ЗаказПоставщику;
			МенеджерЗаписи.ХозОперация = ЗаказПоставщику.ХозяйственнаяОперация;
			МенеджерЗаписи.Прочитать();
			Если МенеджерЗаписи.Выбран() И МенеджерЗаписи.ПоступлениеТоваровНаСклад <> Источник.Ссылка Тогда
				МенеджерЗаписи.ПоступлениеТоваровНаСклад = Источник.Ссылка;
				МенеджерЗаписи.Записать();
				ВыполнятьФоновуюПроверкуЦепочки = Истина;
				МассивЗаказовДляФоновойПроверки.Добавить(ЗаказПоставщику);
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;	
	КонецЕсли;
	
	
	// Шаманство в фоновом режиме
	Если ВыполнятьФоновуюПроверкуЦепочки Тогда
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура();
		ПараметрыПроцедуры.Вставить("МассивЗаказовДляФоновойПроверки", МассивЗаказовДляФоновойПроверки);
		
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ПроверитьЦепочкуДокументов", ПараметрыПроцедуры, ПараметрыВыполнения);
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 03.12.2020

//++ смарт:ММ #044 224 03.12.2020 - Заявка на гарантийный ремонт 
Функция ЗаказПоИмпорту(ЗаказПоставщика) 
	
	Возврат ЗаказПоставщика.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту
			ИЛИ ЗаказПоставщика.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпортуТоварыВПути;
			
КонецФункции

//++ смарт:ММ #044 224 03.12.2020 - Заявка на гарантийный ремонт 
Процедура ПроверитьЦепочкуДокументов(Параметры, Адрес) Экспорт
	
	// ++ 08.12.2020
	ОбщегоНазначенияБТС.Пауза(5);
	// --

	// ++ 20.12.2020
	ТаблицаНоменклатурыДляОповещения = Новый ТаблицаЗначений;
	ТаблицаНоменклатурыДляОповещения.Колонки.Добавить("ЗаказНаПеремещение");
	ТаблицаНоменклатурыДляОповещения.Колонки.Добавить("Номенклатура");
	ТаблицаНоменклатурыДляОповещения.Колонки.Добавить("НомерЗаявкиНаГарантийныйРемонт");
	// --
	Импорт = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту;
	ИмпортТоварыВПути = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпортуТоварыВПути;
	
	МассивЗаказовДляФоновойПроверки = Параметры.МассивЗаказовДляФоновойПроверки;
	УстановитьПривилегированныйРежим(Истина);//rnp: для рег.св смартЦепочкиДокументовПоставки; где выключить?
	Для Каждого ЗаказПоставщику Из МассивЗаказовДляФоновойПроверки Цикл
		
		ОтправитьУведомлениеСклад = Ложь;
		ЦепочкаПолная = Ложь;
		
		МенеджерЗаписи = РегистрыСведений.смартЦепочкиДокументовПоставки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаказПоставщику = ЗаказПоставщику;
		МенеджерЗаписи.ХозОперация = ЗаказПоставщику.ХозяйственнаяОперация;
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			Если МенеджерЗаписи.ХозОперация = ИмпортТоварыВПути Тогда
				Если ЗначениеЗаполнено(МенеджерЗаписи.ТаможеннаяДекларацияИмпорт) 
					И ЗначениеЗаполнено(МенеджерЗаписи.ПриобретениеТоваровУслуг)
					И ЗначениеЗаполнено(МенеджерЗаписи.ПоступлениеТоваровНаСклад) Тогда
					ЦепочкаПолная = Истина;
				КонецЕсли;
			ИначеЕсли МенеджерЗаписи.ХозОперация = Импорт Тогда
				Если ЗначениеЗаполнено(МенеджерЗаписи.ТаможеннаяДекларацияИмпорт) 
					И ЗначениеЗаполнено(МенеджерЗаписи.ПриобретениеТоваровУслуг) Тогда
					ЦепочкаПолная = Истина;
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЦепочкаПолная Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаказНаПеремещение = МенеджерЗаписи.ЗаказНаПеремещение;
		// ++ 20.12.2020
		//СоответствиеНоменклатурыДляОповещения = Новый Массив;
		// --
		НомераЗаявокНаГарантийныйРемонт = "";
		МассивНомеровЗаявокНаГарантийныйРемонт = Новый Массив;
		
		ЗаказНаПеремещениеОбъект = ЗаказНаПеремещение.ПолучитьОбъект();
		МассивСтрокДляУдаления = Новый Массив;
		
		Для Каждого СтрокаТовар Из ЗаказНаПеремещение.Товары Цикл // Вроде как должна быть всего одна номенклатура, но на всякий случай цикл
			
			//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Если НЕ ЗначениеЗаполнено(СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт) Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаявкаНаГарантийныйРемонт = СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка;
			
			//ЗаявкаНаГарантийныйРемонт = НайтиЗаявкуНаГарантийныйРемонт(ЗаказНаПеремещение, СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт);
			//Если ЗаявкаНаГарантийныйРемонт = Неопределено Тогда
			//	Продолжить;
			//КонецЕсли;
			//-- #Б1132 смарт: Шляпников 01.11.2024
			
			
			ДокОбъект = ЗаявкаНаГарантийныйРемонт.ПолучитьОбъект();
			ДокументИзменен = Ложь;
			
			// 1. Проверка, надо ли удалить заказ на перемещение (детали по заявке на гарантийный ремонт добыли другим путем)
			// Аналогичная проверка есть при проведении приходного ордера. Нужна ли тут еще?
			
			Отбор = Новый Структура;
			Отбор.Вставить("ДокументДвиженияДоп", ЗаказНаПеремещение);
			СтрокиСтатус = ДокОбъект.Статусы.НайтиСтроки(Отбор);
			Если СтрокиСтатус.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаСтатус Из СтрокиСтатус Цикл
				
				Отбор = Новый Структура;
				Отбор.Вставить("НомерПозиции", СтрокаСтатус.НомерПозиции);
				СтрокиСпециалист = ДокОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
				Если СтрокиСпециалист.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаСпециалист = Неопределено;
				Для Каждого СтрокаСпец Из СтрокиСпециалист Цикл
					Номенклатура = СтрокаСпец.Номенклатура;
					Если ЗначениеЗаполнено(СтрокаСпец.АналогОтПоставщика) Тогда
						Номенклатура = СтрокаСпец.АналогОтПоставщика;
					КонецЕсли;
					
					Если Номенклатура = СтрокаТовар.Номенклатура Тогда
						СтрокаСпециалист = СтрокаСпец;
						Прервать;
					КонецЕсли;				
				КонецЦикла;
				
				Если СтрокаСпециалист = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ИДСтрокиЗаполняетсяИнженером = СтрокаСпециалист.ИДСтрокиЗаполняетсяИнженером;
				Отбор = Новый Структура;
				Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
				СтрокиИнженер = ДокОбъект.ЗаполняетсяИнженером.НайтиСтроки(Отбор);
				Если СтрокиИнженер.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				СтрокаИнженер = СтрокиИнженер[0];

				УспехУдаленияСтроки = Ложь;
								
				Если ЗначениеЗаполнено(СтрокаИнженер.НоменклатураУстановленнаяКлиенту) Тогда
					//смартУдалитьСтрокиИлиПолучитьСписокНоменклатурыИзЗаказаНаПеремещениеПоЗаявкеНаГарантийныйРемонт(ДокОбъект.Номер, Номенклатура, ЗаказНаПеремещение,,, УспехУдаленияСтроки);
					МассивСтрокДляУдаления.Добавить(СтрокаТовар);
					ДокументИзменен = Истина;
					СтрокаСтатус.ДокументДвиженияДоп = Неопределено; 					
					
				Иначе
					// Оповещения
					
					//смартУдалитьСтрокиИлиПолучитьСписокНоменклатурыИзЗаказаНаПеремещениеПоЗаявкеНаГарантийныйРемонт(ДокОбъект.Номер, Номенклатура, ЗаказНаПеремещение, Истина, СоответствиеНоменклатурыДляОповещения);
					// ++ 20.12.2020
					//Соотв = Новый Соответствие();
					//Соотв.Вставить(ЗаказНаПеремещение.Номер, СтрокаТовар.Номенклатура);
					//СоответствиеНоменклатурыДляОповещения.Добавить(Соотв);
					НоваяСтрокаОповещение = ТаблицаНоменклатурыДляОповещения.Добавить();
					НоваяСтрокаОповещение.ЗаказНаПеремещение = ЗаказНаПеремещение;
					НоваяСтрокаОповещение.Номенклатура = СтрокаТовар.Номенклатура;
					НоваяСтрокаОповещение.НомерЗаявкиНаГарантийныйРемонт = ДокОбъект.Номер;
					// --
					
					ОтправитьУведомлениеСклад = Истина;
					Если МассивНомеровЗаявокНаГарантийныйРемонт.Найти(ДокОбъект.Номер) = Неопределено Тогда
						НомераЗаявокНаГарантийныйРемонт = НомераЗаявокНаГарантийныйРемонт + ?(ЗначениеЗаполнено(НомераЗаявокНаГарантийныйРемонт), ", ", "") + ДокОбъект.Номер;
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЦикла;
						
			Если ДокументИзменен Тогда
				Попытка 
					ДокОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
				
		КонецЦикла; // По товарам заказа на перемещение
		
		Если МассивСтрокДляУдаления.Количество() > 0 Тогда
						
			Если ЗаказНаПеремещениеОбъект.Товары.Количество() = МассивСтрокДляУдаления.Количество() Тогда
				// Оставить все строки в заказе, но пометить его на удаление
				ЗаказНаПеремещениеОбъект.УстановитьПометкуУдаления(Истина);
			Иначе
				Для Каждого СтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
					ЗаказНаПеремещениеОбъект.Товары.Удалить(СтрокаДляУдаления);
				КонецЦикла;

				Попытка
					ЗаказНаПеремещениеОбъект.Записать();
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		
		Если ЗаказНаПеремещение.Товары.Количество() > 0 И НЕ ЗаказНаПеремещение.ПометкаУдаления Тогда
			// 2. Обработка заказа на перемещение (всем строкам установить Отгрузить, создать перемещение товаров)
			ОбработатьЗаказНаПеремещение(ЗаказНаПеремещение, ЗаказПоставщику,,, НомераЗаявокНаГарантийныйРемонт);
			
			// 3. Отправка уведомления
			Если ОтправитьУведомлениеСклад Тогда
				// ++ 20.12.2020
				//ОтправитьУведомлениеОНеобходимостиПеремещенияЗапчастей(СоответствиеНоменклатурыДляОповещения, НомераЗаявокНаГарантийныйРемонт);
				ОтправитьУведомлениеОНеобходимостиПеремещенияЗапчастей(ТаблицаНоменклатурыДляОповещения);
				// --
			КонецЕсли;

		КонецЕсли;
		
		// 4. Удалить запись из регистра (?)
		//МенеджерЗаписи.Удалить();
	КонецЦикла;	
		
КонецПроцедуры //-- смарт:ММ 03.12.2020

//++ смарт:ММ #044 224 05.12.2020 - Заявка на гарантийный ремонт 
Функция НайтиЗаявкуНаГарантийныйРемонт(ЗаказНаПеремещение, смартНомерЗаявкиНаГарантийныйРемонт)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартЗаявкаНаГарантийныйРемонт.Статусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
	|ГДЕ
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.ДокументДвиженияДоп = &ДокументДвиженияДоп
	|	И смартЗаявкаНаГарантийныйРемонтСтатусы.Ссылка.Номер = &Номер";
	
	Запрос.УстановитьПараметр("ДокументДвиженияДоп", ЗаказНаПеремещение);
	Запрос.УстановитьПараметр("Номер", смартНомерЗаявкиНаГарантийныйРемонт);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции //-- смарт:ММ 05.12.2020

