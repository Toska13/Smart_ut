//++ #1912 смарт: Лопато 28.08.2024 //Синхронизация связки Пользователь + Партнер  
Процедура ПартнерКонтрагентКЛПриЗаписиОтправкаНаСайт(Источник, Отказ) Экспорт

	Если НЕ Отказ
		И НЕ Б_ОбменССайтомСервер.смарт_ЭтоКопияБазы() Тогда

		//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
		Если Источник.ДополнительныеСвойства.Свойство("ПропуститьОтправкуНаСайтПриЗаписи") Тогда
			Возврат;
		КонецЕсли;	
		//-- #Б-1138 смарт: Лопато 15.10.2024
		
		Если ТипЗнч(Источник) = Тип("СправочникОбъект.Партнеры") Тогда

			Партнер = Источник.Ссылка;
			ЭтоКлиент = Источник.Клиент;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.Контрагенты") Тогда
			
			Партнер = Источник.Партнер;	
			ЭтоКлиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер, "Клиент");
			
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.КонтактныеЛицаПартнеров") Тогда
			
			Если НЕ ЗначениеЗаполнено(Источник.смартЛогинНаСайте) Тогда
				Возврат;
			КонецЕсли;	
			
			Партнер = Источник.Владелец;	
			ЭтоКлиент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер, "Клиент");

		КонецЕсли;	
		
	КонецЕсли;
	 
КонецПроцедуры //-- #1912 смарт: Лопато 28.08.2024

//++ #Б-1352 смарт: Лопато 25.11.2024 //Добавить ТЭГ выгрузки в imot.io  
Процедура ИсторияСостоянийОбращенийПриЗаписи(Источник, Отказ, Замещение) Экспорт

