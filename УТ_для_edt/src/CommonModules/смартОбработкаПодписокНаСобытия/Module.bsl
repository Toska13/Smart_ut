				СтруктураПараметров = Новый Структура("Период, Интерес, Состояние", 
				   				   					  ТекущаяЗаписьСостояния.Период, 
								   					  ТекущаяЗаписьСостояния.Обращение, 
								   					  ТекущаяЗаписьСостояния.Состояние);
				
				ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартФоновыеПроцессы.РассчитатьТэгиТелефонногоЗвонкаНецелевойКлиент",
													   СтруктураПараметров, 
													   ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор));
													   
			КонецЕсли;
			
		КонецЦикла;
											   
	КонецЕсли;										   
	 
КонецПроцедуры //-- #Б-1352 смарт: Лопато 25.11.2024

//++ #1538 смарт: Лопато 05.12.2024 //Интеграция с ROIStat. Добавить справочник Статусы ROIStat, доработать регистр состояний Интересов  
