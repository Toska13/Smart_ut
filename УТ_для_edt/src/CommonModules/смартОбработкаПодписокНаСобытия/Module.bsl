	////-- смарт:Подкин # 13.09.2022 11:01:46
	Если НЕ смартОбщегоНазначения.смартРабочаяБаза() Тогда
		Возврат;
	КонецЕсли;
	//--#1214 смарт: Лопато 10.10.2022
    
	ПроведениеВПервыйРаз = Ложь;
	Если Источник.ДополнительныеСвойства.Свойство("смартПроводитсяВпервые") = Истина Тогда
		ПроведениеВПервыйРаз = Источник.ДополнительныеСвойства.смартПроводитсяВпервые;
	КонецЕсли;
	
	Если НЕ ПроведениеВПервыйРаз Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьПодчиненныеПриобретенияТоваров = ЕстьПриобретениеТоваровПоЗаказуПоставщику(Источник.Ссылка, Неопределено);
	
	Если ЕстьПодчиненныеПриобретенияТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказПоЗаявкеНаГарантийныйРемонт = Ложь;
	Если СтрНайти(ВРег(Источник.Комментарий), "PRE") <> 0 Тогда
		ЗаказПоЗаявкеНаГарантийныйРемонт = Истина;
	КонецЕсли;
	Если СтрНайти(ВРег(Источник.Комментарий), "TITJ") <> 0 Тогда
		ЗаказПоЗаявкеНаГарантийныйРемонт = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.Груз)
		И Источник.Груз.СтатусГруза = Перечисления.СтатусыГрузов.ВПути 
		И НЕ ЗаказПоЗаявкеНаГарантийныйРемонт Тогда
		ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура();
		ПараметрыПроцедуры.Вставить("ЗаказПоставщику", Источник.Ссылка);
		
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ОтправитьУведомленияПоЗаказуПоставщику", ПараметрыПроцедуры, ПараметрыВыполнения);
		
		//++ #Б-3288 смарт: Фролов 14.05.2025 //Уведомления. По Заказу поставщику. Доработка.
		ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ОтправитьУведомленияПоЗаказуПоставщикуПоРасходке", ПараметрыПроцедуры, ПараметрыВыполнения);
		//-- #Б-3288 смарт: Фролов 14.05.2025
		
		// ++ 14.12.2020
		Если ЗначениеЗаполнено(Источник.ДокументОснование) И ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.смартПредзаказПоставщику") Тогда
			ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
			ФЗ2 = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ОтправитьУведомленияПоЗаказуПоставщикуМенеджеруПредзаказа", ПараметрыПроцедуры, ПараметрыВыполнения);
		КонецЕсли;	
		// --
		
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 06.12.2020

//++ смарт:ММ #086 362 06.12.2020 
Процедура ОтправитьУведомленияПоЗаказуПоставщику(Параметры, Адрес) Экспорт

	//++ смарт:ММ #104 488 19.04.2021 
	// Автоматически резервировать товар
	ТаблицаТоварыКРезерву = Новый ТаблицаЗначений;
	ТаблицаТоварыКРезерву.Колонки.Добавить("ЗаказПоставщику", Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	//-- смарт:ММ 19.04.2021
	
	// Получатели: менеджеры из заказов клиентов + пользователи из предопределенной настройки ПользователиДляРассылкиОПланируемыхПоставках
	
	ОбщегоНазначенияБТС.Пауза(5);

	ИмяСобытияЖР = "смартОтправкаУведомленияПоЗаказуПоставщику";
	
	ЗаказПоставщику = Параметры.ЗаказПоставщику;
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказПоставщикуНомер = ЗаказПоставщику.Номер;
		
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаУведомленияПоЗаказуПоставщику(); 
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказПоставщику);
	
	// ++ 21.12.2020
	ДатаОтбораЗаказовКлиентов = Справочники.смартПредопределенныеЗначения.ДатаОтбораЗаказовКлиентовДляОповещенияОПланируемыхПоставках.Значение;
	СсылкаНаСправочник = Справочники.смартПредопределенныеЗначения.ГруппаНоменклатурыДляОповещенияОПланируемыхПоставках;
	ГруппыНоменклатуры = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаНаСправочник, Истина);
	
	Запрос.УстановитьПараметр("ГруппыНоменклатуры", ГруппыНоменклатуры);
	Запрос.УстановитьПараметр("ДатаОтбораЗаказовКлиентов", ДатаОтбораЗаказовКлиентов);
	// --
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивМенеджеров = Новый Массив;
	ТекстНоменклатураМожетеИтог = "";
	ТекстНоменклатураИнформируемИтог = "";
	
	ТекстИтог = "";
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		ЕстьЗаказыДляРезерва = Ложь;
		ЕстьЗаказыДляИнформирования = Ложь;
		
		ТекстНоменклатураМожете = "По заказу поставщику №" + ЗаказПоставщикуНомер + " планируется поступление номенклатуры " 
		// ++ 21.12.2020
		//+ ВыборкаНоменклатура.Номенклатура + ". Можете зарезервировать товар для заказов клиента:" + Символы.ПС;
		+ ВыборкаНоменклатура.Номенклатура + " в количестве " + ВыборкаНоменклатура.Количество + ". Можете зарезервировать товар для заказов клиента:" + Символы.ПС;
		// --
		
		ТекстНоменклатураИнформируем = "Информируем, что ждут обеспечения также следующие заказы клиента:" + Символы.ПС;
		
		КоличествоОсталось = ВыборкаНоменклатура.Количество; // Количество из заказа поставщику
	
		Выборка = ВыборкаНоменклатура.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			ТекущееКоличество = Выборка.КоличествоЗаказКлиента;
			
			//++ смарт:ММ #104 488 19.04.2021 
			Оплачен = Ложь;
			//-- смарт:ММ 19.04.2021
			
			// ++ 21.12.2020
			//ШаблонСтроки = "№" + Выборка.Номер + " (" + Выборка.Состояние + ") менеджер " + Выборка.Менеджер + " количество ";
			
			ТекстДатаОплаты = "";
			Если Выборка.Состояние <> "не оплачен" Тогда
				//++ смарт:ММ #104 488 19.04.2021 
				Оплачен = Истина;
				//-- смарт:ММ 19.04.2021
				ТекстДатаОплаты = ", первая дата оплаты " + Формат(Выборка.ДатаОплаты, "ДФ='dd.MM.yyyy ""г.""'");
			КонецЕсли;
			
			//++ #Б-1080 смарт: Лопато 07.03.2025 //Добавить доп текст в оповещения (продолжение задачи 1600) (ИТСМ 1622)  
			ШаблонСтроки = СокрЛП(Выборка.Контрагент) 
						   + " №" + Выборка.Номер 
						   + " от " + Формат(Выборка.ДатаЗаказа, "ДФ='dd.MM.yyyy ""г.""'") 
						   + " (" + Выборка.Состояние +  ТекстДатаОплаты 
						   + ") менеджер " + Выборка.Менеджер + " количество ";
			//-- #Б-1080 смарт: Лопато 07.03.2025
			// --
			
			Если ТекущееКоличество <= КоличествоОсталось Тогда
				
				ТекстНоменклатураМожете = ТекстНоменклатураМожете + ШаблонСтроки + ТекущееКоличество + Символы.ПС;
				КоличествоОсталось = КоличествоОсталось - ТекущееКоличество;
				ЕстьЗаказыДляРезерва = Истина;
				
				//++ смарт:ММ #104 488 19.04.2021 
				Если Оплачен Тогда
					НоваяСтрока = ТаблицаТоварыКРезерву.Добавить();
					НоваяСтрока.ЗаказПоставщику = ЗаказПоставщику;
					НоваяСтрока.ЗаказКлиента = Выборка.ЗаказКлиента;
					НоваяСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
					НоваяСтрока.Количество = ТекущееКоличество;
				КонецЕсли;
				//-- смарт:ММ 19.04.2021
				
			ИначеЕсли КоличествоОсталось > 0 Тогда
				
				КоличествоХватило = КоличествоОсталось;
				КоличествоНеХватило = ТекущееКоличество - КоличествоОсталось;
				
				ТекстНоменклатураМожете = ТекстНоменклатураМожете + ШаблонСтроки + КоличествоХватило + " (всего в заказе " + ТекущееКоличество + ")" + Символы.ПС;
				ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + ШаблонСтроки + КоличествоНеХватило + Символы.ПС; 
				
				//++ смарт:ММ #104 488 19.04.2021 
				Если Оплачен Тогда
					НоваяСтрока = ТаблицаТоварыКРезерву.Добавить();
					НоваяСтрока.ЗаказПоставщику = ЗаказПоставщику;
					НоваяСтрока.ЗаказКлиента = Выборка.ЗаказКлиента;
					НоваяСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
					НоваяСтрока.Количество = ТекущееКоличество;
				КонецЕсли;
				//-- смарт:ММ 19.04.2021
				
				КоличествоОсталось = 0;
				ЕстьЗаказыДляРезерва = Истина;
				ЕстьЗаказыДляИнформирования = Истина;
				
			ИначеЕсли КоличествоОсталось = 0 Тогда
				ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + ШаблонСтроки + ТекущееКоличество + Символы.ПС; 
				ЕстьЗаказыДляИнформирования = Истина;
			КонецЕсли;
			
			Если МассивМенеджеров.Найти(Выборка.Менеджер) = Неопределено И ЗначениеЗаполнено(Выборка.Менеджер) Тогда
				МассивМенеджеров.Добавить(Выборка.Менеджер);
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьЗаказыДляРезерва Тогда
			ТекстНоменклатураМожете = "";
		Иначе
			ТекстНоменклатураМожете = ТекстНоменклатураМожете + Символы.ПС;
		КонецЕсли;
		Если НЕ ЕстьЗаказыДляИнформирования Тогда
			ТекстНоменклатураИнформируем = "";
		Иначе
			ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + Символы.ПС;
		КонецЕсли;
		
		ТекстИтог = ТекстИтог + ?(ЗначениеЗаполнено(ТекстИтог), Символы.ПС + Символы.ПС, "") + ТекстНоменклатураМожете + ТекстНоменклатураИнформируем;
		
	КонецЦикла;
	
	Если ТекстИтог = "" Тогда
		Возврат;
	КонецЕсли;
		
	АдресаДляОтправкиСтрокой = "";
	СсылкаПредопределнноеЗначение = Справочники.смартПредопределенныеЗначения.ПользователиДляРассылкиОПланируемыхПоставках;	
	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаПредопределнноеЗначение, АдресаДляОтправкиСтрокой, Истина);
	
	АдресаМенеджеров = смартОбщегоНазначения.ПолучитьАдресаПользователей(МассивМенеджеров, АдресаДляОтправкиСтрокой);
	
	// ++ 21.12.2020
	//ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивАдресовДляОтправки, АдресаМенеджеров, Истина);
	АдресаДляОтправкиУникальные = Новый Массив;
	Индекс = МассивАдресовДляОтправки.Количество() - 1;
	Пока Индекс >= 0 Цикл
		
		ТекСтруктура = МассивАдресовДляОтправки[Индекс];
		ТекАдрес = ТекСтруктура.Адрес;
		Если АдресаДляОтправкиУникальные.Найти(ТекАдрес) = Неопределено Тогда
			АдресаДляОтправкиУникальные.Добавить(ТекАдрес);
		Иначе
			МассивАдресовДляОтправки.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Для Каждого ТекСтруктура Из АдресаМенеджеров Цикл
		ТекАдрес = ТекСтруктура.Адрес;
		Если АдресаДляОтправкиУникальные.Найти(ТекАдрес) = Неопределено Тогда
			АдресаДляОтправкиУникальные.Добавить(ТекАдрес);
			МассивАдресовДляОтправки.Добавить(ТекСтруктура);
		КонецЕсли;
	КонецЦикла;
	
	АдресаДляОтправкиСтрокой = "";
	Для Каждого ТекАдрес Из АдресаДляОтправкиУникальные Цикл
		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ТекАдрес;
	КонецЦикла;
	
	// --
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
		
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
					 
		ТемаПисьма = "Резерв по заказу поставщику №" + ЗаказПоставщикуНомер + " от " + Формат(ЗаказПоставщику.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		ТекстПисьма = ТекстИтог;
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение 
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказПоставщику,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
	//++ смарт:ММ #104 488 19.04.2021 
	Если ТаблицаТоварыКРезерву.Количество() > 0 Тогда
		ЗарезервироватьТоварыВЗаказахКлиентов(ТаблицаТоварыКРезерву);
	КонецЕсли;
	//-- смарт:ММ 19.04.2021
	
КонецПроцедуры //-- смарт:ММ 06.12.2020

//++ #Б-3288 смарт: Фролов 14.05.2025 //Уведомления. По Заказу поставщику. Доработка.
Процедура ОтправитьУведомленияПоЗаказуПоставщикуПоРасходке(Параметры, Адрес) Экспорт

	// Автоматически резервировать товар
	ТаблицаТоварыКРезерву = Новый ТаблицаЗначений;
	ТаблицаТоварыКРезерву.Колонки.Добавить("ЗаказПоставщику", Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("ЗаказКлиента", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаТоварыКРезерву.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	// Получатели: менеджеры из заказов клиентов + пользователи из предопределенной настройки ПолучателиРассылокОПланируемыхПоставкахРасходыхМатериалов
	
	ОбщегоНазначенияБТС.Пауза(5);

	ИмяСобытияЖР = "смартОтправкаУведомленияПоЗаказуПоставщикуПоРасходке";
	
	ЗаказПоставщику = Параметры.ЗаказПоставщику;
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаказПоставщикуНомер = ЗаказПоставщику.Номер;
		
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапросаУведомленияПоЗаказуПоставщику(); 
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказПоставщику);
	
	ДатаОтбораЗаказовКлиентов = Справочники.смартПредопределенныеЗначения.ДатаОтбораЗаказовКлиентовДляОповещенияОПланируемыхПоставках.Значение;
	
	ГруппыНоменклатуры = Новый Массив;
	
	//++ #3980 смарт: Ермаков 05.08.2025 / Ошибка у Лавровой Евгении
	Для Каждого СтрРасходка Из Справочники.смартПредопределенныеЗначения.Настройки.ГруппыНоменклатурыРасходка Цикл
		
		ГруппыНоменклатуры.Добавить(СтрРасходка.ГруппаНоменклатуры);		
		
	КонецЦикла;
	//-- #3980 смарт: Ермаков 05.08.2025
	
	Запрос.УстановитьПараметр("ГруппыНоменклатуры", ГруппыНоменклатуры);
	Запрос.УстановитьПараметр("ДатаОтбораЗаказовКлиентов", ДатаОтбораЗаказовКлиентов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивМенеджеров = Новый Массив;
	ТекстНоменклатураМожетеИтог = "";
	ТекстНоменклатураИнформируемИтог = "";
	
	ТекстИтог = "";
	
	Пока ВыборкаНоменклатура.Следующий() Цикл
		
		ЕстьЗаказыДляРезерва = Ложь;
		ЕстьЗаказыДляИнформирования = Ложь;
		
		ТекстНоменклатураМожете = "По заказу поставщику №" + ЗаказПоставщикуНомер + " планируется поступление номенклатуры " 
			+ ВыборкаНоменклатура.Номенклатура + " в количестве " + ВыборкаНоменклатура.Количество + ". Можете зарезервировать товар для заказов клиента:" + Символы.ПС;
		
		ТекстНоменклатураИнформируем = "Информируем, что ждут обеспечения также следующие заказы клиента:" + Символы.ПС;
		
		КоличествоОсталось = ВыборкаНоменклатура.Количество; // Количество из заказа поставщику
	
		Выборка = ВыборкаНоменклатура.Выбрать();
	
		Пока Выборка.Следующий() Цикл
			
			ТекущееКоличество = Выборка.КоличествоЗаказКлиента;
			
			Оплачен = Ложь;
			
			ТекстДатаОплаты = "";
			Если Выборка.Состояние <> "не оплачен" Тогда
				
				Оплачен = Истина;
				ТекстДатаОплаты = ", первая дата оплаты " + Формат(Выборка.ДатаОплаты, "ДФ='dd.MM.yyyy ""г.""'");
				
			КонецЕсли;
			
			ШаблонСтроки = СокрЛП(Выборка.Контрагент) 
						   + " №" + Выборка.Номер 
						   + " от " + Формат(Выборка.ДатаЗаказа, "ДФ='dd.MM.yyyy ""г.""'") 
						   + " (" + Выборка.Состояние +  ТекстДатаОплаты 
						   + ") менеджер " + Выборка.Менеджер + " количество ";
			
			Если ТекущееКоличество <= КоличествоОсталось Тогда
				
				ТекстНоменклатураМожете = ТекстНоменклатураМожете + ШаблонСтроки + ТекущееКоличество + Символы.ПС;
				КоличествоОсталось = КоличествоОсталось - ТекущееКоличество;
				ЕстьЗаказыДляРезерва = Истина;
				
				Если Оплачен Тогда
					
					НоваяСтрока = ТаблицаТоварыКРезерву.Добавить();
					НоваяСтрока.ЗаказПоставщику = ЗаказПоставщику;
					НоваяСтрока.ЗаказКлиента = Выборка.ЗаказКлиента;
					НоваяСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
					НоваяСтрока.Количество = ТекущееКоличество;
					
				КонецЕсли;
				
			ИначеЕсли КоличествоОсталось > 0 Тогда
				
				КоличествоХватило = КоличествоОсталось;
				КоличествоНеХватило = ТекущееКоличество - КоличествоОсталось;
				
				ТекстНоменклатураМожете = ТекстНоменклатураМожете + ШаблонСтроки + КоличествоХватило + " (всего в заказе " + ТекущееКоличество + ")" + Символы.ПС;
				ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + ШаблонСтроки + КоличествоНеХватило + Символы.ПС; 
				
				Если Оплачен Тогда
					
					НоваяСтрока = ТаблицаТоварыКРезерву.Добавить();
					НоваяСтрока.ЗаказПоставщику = ЗаказПоставщику;
					НоваяСтрока.ЗаказКлиента = Выборка.ЗаказКлиента;
					НоваяСтрока.Номенклатура = ВыборкаНоменклатура.Номенклатура;
					НоваяСтрока.Количество = ТекущееКоличество;
					
				КонецЕсли;
				
				КоличествоОсталось = 0;
				ЕстьЗаказыДляРезерва = Истина;
				ЕстьЗаказыДляИнформирования = Истина;
				
			ИначеЕсли КоличествоОсталось = 0 Тогда
				
				ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + ШаблонСтроки + ТекущееКоличество + Символы.ПС; 
				ЕстьЗаказыДляИнформирования = Истина;
				
			КонецЕсли;
			
			Если МассивМенеджеров.Найти(Выборка.Менеджер) = Неопределено И ЗначениеЗаполнено(Выборка.Менеджер) Тогда
				
				МассивМенеджеров.Добавить(Выборка.Менеджер);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ЕстьЗаказыДляРезерва Тогда
			ТекстНоменклатураМожете = "";
		Иначе
			ТекстНоменклатураМожете = ТекстНоменклатураМожете + Символы.ПС;
		КонецЕсли;
		
		Если НЕ ЕстьЗаказыДляИнформирования Тогда
			ТекстНоменклатураИнформируем = "";
		Иначе
			ТекстНоменклатураИнформируем = ТекстНоменклатураИнформируем + Символы.ПС;
		КонецЕсли;
		
		ТекстИтог = ТекстИтог + ?(ЗначениеЗаполнено(ТекстИтог), Символы.ПС + Символы.ПС, "") + ТекстНоменклатураМожете + ТекстНоменклатураИнформируем;
		
	КонецЦикла;
	
	Если ТекстИтог = "" Тогда
		Возврат;
	КонецЕсли;
		
	МассивПользователей = Справочники.смартПредопределенныеЗначения.Настройки.ПолучателиРассылокОПланируемыхПоставкахРасходыхМатериалов.ВыгрузитьКолонку("Пользователь");
	
	МассивАдресовДляОтправки = Новый Массив;
	АдресаДляОтправкиСтрокой = "";
	
	Для Каждого Пользователь Из МассивПользователей Цикл

		МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
		
	КонецЦикла;
	
	АдресаМенеджеров = смартОбщегоНазначения.ПолучитьАдресаПользователей(МассивМенеджеров, АдресаДляОтправкиСтрокой);
	
	АдресаДляОтправкиУникальные = Новый Массив;
	Индекс = МассивАдресовДляОтправки.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		
		ТекСтруктура = МассивАдресовДляОтправки[Индекс];
		ТекАдрес = ТекСтруктура.Адрес;
		Если АдресаДляОтправкиУникальные.Найти(ТекАдрес) = Неопределено Тогда
			АдресаДляОтправкиУникальные.Добавить(ТекАдрес);
		Иначе
			МассивАдресовДляОтправки.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
		
	КонецЦикла;
	
	Для Каждого ТекСтруктура Из АдресаМенеджеров Цикл
		
		ТекАдрес = ТекСтруктура.Адрес;
		Если АдресаДляОтправкиУникальные.Найти(ТекАдрес) = Неопределено Тогда
			АдресаДляОтправкиУникальные.Добавить(ТекАдрес);
			МассивАдресовДляОтправки.Добавить(ТекСтруктура);
		КонецЕсли;
		
	КонецЦикла;
	
	АдресаДляОтправкиСтрокой = "";
	Для Каждого ТекАдрес Из АдресаДляОтправкиУникальные Цикл
		
		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ТекАдрес;
		
	КонецЦикла;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
					 
		ТемаПисьма = "Резерв по заказу поставщику №" + ЗаказПоставщикуНомер + " от " + Формат(ЗаказПоставщику.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		ТекстПисьма = ТекстИтог;
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		Попытка
			
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		Исключение 
			
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказПоставщику,ТекстПисьма);
			ТекстСообщения = "Не удалось отправить уведомление о возможности резерва по заказу поставщику №" + ЗаказПоставщикуНомер + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		КонецПопытки;
	КонецЕсли;
	
	Если ТаблицаТоварыКРезерву.Количество() > 0 Тогда
		ЗарезервироватьТоварыВЗаказахКлиентов(ТаблицаТоварыКРезерву);
	КонецЕсли;
	
КонецПроцедуры //-- #Б-3288 смарт: Фролов 14.05.2025


//++ смарт:ММ #086 362 09.12.2020 
Функция ПолучитьТекстЗапросаУведомленияПоЗаказуПоставщику()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказПоставщикуТовары.Количество) КАК Количество,
	|	ЗаказПоставщикуТовары.Ссылка.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_НоменклатураЗаказПоставщику
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	// ++ 21.12.2020
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|		ПО ЗаказПоставщикуТовары.Номенклатура = НоменклатураСправочник.Ссылка
	// --
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка = &Ссылка
	// ++ 21.12.2020
	|	И НоменклатураСправочник.Ссылка В ИЕРАРХИИ (&ГруппыНоменклатуры)
	// --
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказПоставщикуТовары.Номенклатура,
	|	ЗаказПоставщикуТовары.Ссылка.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГрафикОтгрузкиТоваров.Номенклатура КАК Номенклатура,
	|	ГрафикОтгрузкиТоваров.КоличествоНеобеспечено КАК КоличествоНеобеспеченоОстаток,
	|	ВЫРАЗИТЬ(ГрафикОтгрузкиТоваров.Регистратор КАК Документ.ЗаказКлиента) КАК Регистратор
	|ПОМЕСТИТЬ ВТ_НоменклатураПоЗаказамКлиентов
	|ИЗ
	|	РегистрНакопления.ГрафикОтгрузкиТоваров КАК ГрафикОтгрузкиТоваров
	|ГДЕ
	|	ГрафикОтгрузкиТоваров.Активность
	|	И (ГрафикОтгрузкиТоваров.Номенклатура, ВЫРАЗИТЬ(ГрафикОтгрузкиТоваров.Регистратор КАК Документ.ЗаказКлиента).Организация) В 
	|			(ВЫБРАТЬ
	|				ВТ.Номенклатура, 
	|				ВТ.Организация КАК Организация
	|			ИЗ
	|				ВТ_НоменклатураЗаказПоставщику КАК ВТ)
	|	И ГрафикОтгрузкиТоваров.Регистратор ССЫЛКА Документ.ЗаказКлиента
	|	И ГрафикОтгрузкиТоваров.КоличествоНеобеспечено <> 0
	// ++ 21.12.2020
	|	И ВЫРАЗИТЬ(ГрафикОтгрузкиТоваров.Регистратор КАК Документ.ЗаказКлиента).Дата >= &ДатаОтбораЗаказовКлиентов
	// --
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ЗаказыКлиентов.Регистратор КАК ЗаказКлиента,
	|	ВЫБОР
	|		КОГДА СостоянияЗаказовКлиентов.ПроцентОплаты = 100
	|			ТОГДА ""оплачен полностью""
	|		КОГДА ЕСТЬNULL(ЗаказКлиентаДок.смартДатаОплаты, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ""оплачен полностью""
	|		КОГДА СостоянияЗаказовКлиентов.ПроцентОплаты = 0
	|			ТОГДА ""не оплачен""
	|		ИНАЧЕ ""частично оплачен""
	|	КОНЕЦ КАК Состояние,
	|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты
	|ПОМЕСТИТЬ ВТ_ПроцентОплатыЗаказов
	|ИЗ
	|	ВТ_НоменклатураПоЗаказамКлиентов КАК ВТ_ЗаказыКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	|		ПО ВТ_ЗаказыКлиентов.Регистратор = ЗаказКлиентаДок.Ссылка
	|			И ЗаказКлиентаДок.смартДатаОплаты <> ДАТАВРЕМЯ(1, 1, 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ВТ_ЗаказыКлиентов.Регистратор = СостоянияЗаказовКлиентов.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ПроцентОплатыЗаказов.ЗаказКлиента КАК ЗаказКлиента,
	//|	МИНИМУМ(ЕСТЬNULL(РасчетыСКлиентамиПланОплат.Период, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаОплаты
	|	ВЫБОР 
	|		КОГДА МИНИМУМ(ЗаказКлиентаДок.смартДатаОплаты) < МИНИМУМ(ЕСТЬNULL(РасчетыСКлиентамиПланОплат.Период, ДАТАВРЕМЯ(1, 1, 1)))
	|			ТОГДА МИНИМУМ(ЗаказКлиентаДок.смартДатаОплаты)
	|		КОГДА МИНИМУМ(ЕСТЬNULL(РасчетыСКлиентамиПланОплат.Период, ДАТАВРЕМЯ(1, 1, 1))) = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА МИНИМУМ(ЗаказКлиентаДок.смартДатаОплаты)
	|		ИНАЧЕ МИНИМУМ(ЕСТЬNULL(РасчетыСКлиентамиПланОплат.Период, ДАТАВРЕМЯ(1, 1, 1)))
	|	КОНЕЦ КАК ДатаОплаты
	|ПОМЕСТИТЬ ВТ_ПервыеДатыОплатыЗаказов
	|ИЗ
	|	ВТ_ПроцентОплатыЗаказов КАК ВТ_ПроцентОплатыЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	|		    ПО ВТ_ПроцентОплатыЗаказов.ЗаказКлиента = ЗаказКлиентаДок.Ссылка
	|		    И ЗаказКлиентаДок.смартДатаОплаты <> ДАТАВРЕМЯ(1, 1, 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПланОплат КАК РасчетыСКлиентамиПланОплат
	|		ПО (ВТ_ПроцентОплатыЗаказов.ЗаказКлиента = (ВЫРАЗИТЬ(РасчетыСКлиентамиПланОплат.ОбъектРасчетов КАК Документ.ЗаказКлиента)))
	|			И (ВЫБОР
	|				КОГДА РасчетыСКлиентамиПланОплат.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|						И РасчетыСКлиентамиПланОплат.Оплачено <> 0
	|					ТОГДА ИСТИНА
	|				КОГДА РасчетыСКлиентамиПланОплат.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|						И РасчетыСКлиентамиПланОплат.КОплате <> 0
	|						И РасчетыСКлиентамиПланОплат.ВариантОплаты <> ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.ПустаяСсылка)
	|						И НЕ РасчетыСКлиентамиПланОплат.ДокументРегистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|ГДЕ
	//|	ВТ_ПроцентОплатыЗаказов.ПроцентОплаты <> 0
	|	ВТ_ПроцентОплатыЗаказов.Состояние <> ""не оплачен""
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПроцентОплатыЗаказов.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоменклатураПоЗаказамКлиентов.Номенклатура КАК Номенклатура,
	|	ВТ_НоменклатураЗаказПоставщику.Количество КАК Количество,
	|	ВТ_НоменклатураПоЗаказамКлиентов.Регистратор КАК ЗаказКлиента,
	|	ЗаказКлиентаДок.Дата КАК ДатаЗаказа,
	|	ЕСТЬNULL(ВТ_ПроцентОплатыЗаказов.Состояние, """") КАК Состояние,
	|	ЕСТЬNULL(ВТ_ПервыеДатыОплатыЗаказов.ДатаОплаты, ДАТАВРЕМЯ(3999, 1, 1)) КАК ДатаОплаты,
	|	ВТ_НоменклатураПоЗаказамКлиентов.КоличествоНеобеспеченоОстаток КАК КоличествоЗаказКлиента,
	//++ #Б-1080 смарт: Лопато 07.03.2025 //Добавить доп текст в оповещения (продолжение задачи 1600) (ИТСМ 1622)  
	|	ЗаказКлиентаДок.Контрагент КАК Контрагент,
	//-- #Б-1080 смарт: Лопато 07.03.2025
	|	ЗаказКлиентаДок.Менеджер КАК Менеджер,
	|	ЗаказКлиентаДок.Номер КАК Номер
	|ИЗ
	|	ВТ_НоменклатураПоЗаказамКлиентов КАК ВТ_НоменклатураПоЗаказамКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПроцентОплатыЗаказов КАК ВТ_ПроцентОплатыЗаказов
	|		ПО ВТ_НоменклатураПоЗаказамКлиентов.Регистратор = ВТ_ПроцентОплатыЗаказов.ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервыеДатыОплатыЗаказов КАК ВТ_ПервыеДатыОплатыЗаказов
	|		ПО ВТ_НоменклатураПоЗаказамКлиентов.Регистратор = ВТ_ПервыеДатыОплатыЗаказов.ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	|		ПО ВТ_НоменклатураПоЗаказамКлиентов.Регистратор = ЗаказКлиентаДок.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НоменклатураЗаказПоставщику КАК ВТ_НоменклатураЗаказПоставщику
	|		ПО (ВТ_НоменклатураЗаказПоставщику.Номенклатура = ВТ_НоменклатураПоЗаказамКлиентов.Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОплаты,
	|	ДатаЗаказа
	|ИТОГИ
	|	МАКСИМУМ(Количество)
	|ПО
	|	Номенклатура";
	
	Возврат ТекстЗапроса;
	
КонецФункции //-- смарт:ММ 09.12.2020

//++ смарт:ММ #086 362 14.12.2020 
Процедура ОтправитьУведомленияПоЗаказуПоставщикуМенеджеруПредзаказа(Параметры, Адрес) Экспорт

	// Получатели: менеджер из предзаказа поставщику
	
	ОбщегоНазначенияБТС.Пауза(5);

	ИмяСобытияЖР = "смартОтправкаУведомленияПоЗаказуПоставщикуМенеджеруПредзаказа";
	
	ЗаказПоставщику = Параметры.ЗаказПоставщику;
	
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат;
	КонецЕсли;
	
	Предзаказ = ЗаказПоставщику.ДокументОснование;
	МенеджерПредзаказа = Предзаказ.Менеджер;
	ЗаказПоставщикуНомер = ЗаказПоставщику.Номер;
	ПредзаказНомер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Предзаказ.Номер);
	
	Если НЕ ЗначениеЗаполнено(МенеджерПредзаказа) Тогда
		Возврат;
	КонецЕсли;
	
	АдресаДляОтправкиСтрокой = "";
	
	МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(МенеджерПредзаказа, АдресаДляОтправкиСтрокой);
		
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
					 
		ТемаПисьма = "Предзаказ поставщику №" + ПредзаказНомер + " от " + Формат(Предзаказ.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		ТекстПисьма = "По предзаказу №" + ПредзаказНомер + " создан заказ поставщику №" + ЗаказПоставщикуНомер + ", в состав которого входит:" + Символы.ПС;
		НоменклатураТекст = "";
		
		Для Каждого СтрокаТовар Из ЗаказПоставщику.Товары Цикл
			ТекСтрока = СтрокаТовар.Номенклатура.Артикул + " " + СтрокаТовар.Номенклатура.Наименование + ", кол-во: " + СтрокаТовар.Количество;
			НоменклатураТекст = НоменклатураТекст + ?(ЗначениеЗаполнено(НоменклатураТекст), Символы.ПС, "") + ТекСтрока;			
		КонецЦикла;
		
		ТекстПисьма = ТекстПисьма + НоменклатураТекст;		
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление менеджеру предзаказа поставщику №" + ПредзаказНомер + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено уведомление менеджеру предзаказа поставщику №" + ПредзаказНомер + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение  
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказПоставщику,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить уведомление менеджеру предзаказа поставщику №" + ПредзаказНомер + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 14.12.2020

//++ смарт:ММ #044 224 20.12.2020 - Заявка на гарантийный ремонт  
Процедура ОтправитьУведомлениеОНесоответствииПоступившегоКоличества(ТекстНесоответствиеКоличества)
	
	Если ТекстНесоответствиеКоличества <> "" Тогда
		Возврат;
	КонецЕсли;

	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = ПолучитьАдресаПолучателейСообщенийОбОшибках(АдресаДляОтправкиСтрокой);
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) 
	//	И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда

	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
	
		
		ТемаПисьма = "Несоответствие принятого количества по заявкам на гарантийный ремонт"; 
		ТекстПисьма = "При изменении статуса на получено от поставщика обнаружено несоответствие количества: " + Символы.ПС + ТекстНесоответствиеКоличества;
								 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Если ЭтоТестоваяБаза Тогда
			ТестовыеАдреса = ПараметрыПисьма.ТестовыеАдреса;
		КонецЕсли;
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ЭтоТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о несоответствии принятого количества заявке на гарантийный ремонт (на ТЕСТОВУЮ почту " + ТестовыеАдреса + ". В рабочей отправилось бы на " + АдресаДляОтправкиСтрокой + ")";
			Иначе	
				ТекстСообщения = "Отправлено уведомление о несоответствии принятого количества заявке на гарантийный ремонт (на почту " +  АдресаДляОтправкиСтрокой + ")";
			КонецЕсли;
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Исключение
			Если ЭтоТестоваяБаза Тогда
				ТекстСообщения = "Не удалось отправить уведомление о несоответствии принятого количества заявке на гарантийный ремонт на ТЕСТОВУЮ ПОЧТУ " + ТестовыеАдреса + Символы.ПС + ОписаниеОшибки();
			Иначе
				ТекстСообщения = "Не удалось отправить уведомление о несоответствии принятого количества заявке на гарантийный ремонт" + Символы.ПС + ОписаниеОшибки();
			КонецЕсли; 
			//++ #1416 смарт: Фролов 29.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,,ТекстПисьма);
			//-- #1416 смарт: Фролов 29.08.2023
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 20.12.2020

//++ смарт:ММ #088 428 23.12.2020 - Рассылка при проведении Приобретения дополнительных услуг и прочих активов
Процедура смартОповещениеОСозданииДокументаПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПриобретениеУслугПрочихАктивов") Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") = Истина
			И Источник.ДополнительныеСвойства.ЭтоНовый = Истина Тогда
			
			ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
			ПараметрыПроцедуры = Новый Структура();
			ПараметрыПроцедуры.Вставить("ДокументСсылка", Источник.Ссылка);
			
			ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ОтправитьУведомленияОСозданииПриобретенияУслугПрочихАктивов", ПараметрыПроцедуры, ПараметрыВыполнения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 23.12.2020

//++ смарт:ММ #088 428 23.12.2020 - Рассылка при проведении Приобретения дополнительных услуг и прочих активов
Процедура ОтправитьУведомленияОСозданииПриобретенияУслугПрочихАктивов(Параметры, Адрес) Экспорт

	ОбщегоНазначенияБТС.Пауза(5);

	ИмяСобытияЖР = "смартОтправкаУведомленияОСозданииПриобретенияУслугПрочихАктивов";
	
	ДокументСсылка = Параметры.ДокументСсылка;
	
	АдресаДляОтправкиСтрокой = "";
	СсылкаПредопределнноеЗначение = Справочники.смартПредопределенныеЗначения.ПользователиДляУведомленийОСозданииПриобретенияУслугПоИмпорту;	
	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаПредопределнноеЗначение, АдресаДляОтправкиСтрокой, Истина);

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) 
	//	И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021

		НомерДокумента = ДокументСсылка.Номер;
		
		ТемаПисьма = "Создан новый документ Приобретение услуг и прочих активов №" + НомерДокумента + " от " + Формат(ДокументСсылка.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		ТекстПисьма = "В УТ создан документ Приобретение услуг и прочих активов №" + НомерДокумента + " от " + Формат(ДокументСсылка.Дата, "ДФ='dd.MM.yyyy ""г.""'") + " Контрагент " + ДокументСсылка.Контрагент + ", " + ДокументСсылка.Контрагент.ИНН;
				 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о создании Приобретения услуг и прочих активов №" + НомерДокумента + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено уведомление о создании Приобретения услуг и прочих активов №" + НомерДокумента + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение 
			//++ #1416 смарт: Фролов 29.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ДокументСсылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 29.08.2023
			ТекстСообщения = "Не удалось отправить уведомление о создании Приобретения дополнительных услуг и прочих активов №" + НомерДокумента + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 23.12.2020

//++ смарт:ММ #089 415 23.12.2020 - Оповещения при создании номенклатуры
Процедура смартОповещенияОСозданииЭлементаСправочникаПриЗаписи(Источник, Отказ) Экспорт
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Номенклатура") Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") = Истина
			И Источник.ДополнительныеСвойства.ЭтоНовый = Истина Тогда
			
			// При создании новой номенклатуры надо отправлять уведомление ответственному за дополнение, если:
			// текущий пользователь (кто создал) - смарт предопределенный ПользовательОтветственныйЗаСозданиеНоменклатуры 
			
			ПользовательОтветственныйЗаСозданиеНоменклатуры = Справочники.смартПредопределенныеЗначения.ПользовательОтветственныйЗаСозданиеНоменклатуры.Значение;
			ПользовательОтветственныйЗаДополнениеНоменклатуры = Справочники.смартПредопределенныеЗначения.ПользовательОтветственныйЗаДополнениеНоменклатуры.Значение;
			
			Если ЗначениеЗаполнено(ПользовательОтветственныйЗаСозданиеНоменклатуры)
				И ЗначениеЗаполнено(ПользовательОтветственныйЗаДополнениеНоменклатуры) 
				И ТипЗнч(ПользовательОтветственныйЗаСозданиеНоменклатуры) = Тип("СправочникСсылка.Пользователи")
				И ТипЗнч(ПользовательОтветственныйЗаДополнениеНоменклатуры) = Тип("СправочникСсылка.Пользователи")
				Тогда
				
				Если ПараметрыСеанса.ТекущийПользователь = ПользовательОтветственныйЗаСозданиеНоменклатуры Тогда
					ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор);
					ПараметрыПроцедуры = Новый Структура();
					ПараметрыПроцедуры.Вставить("СправочникСсылка", Источник.Ссылка);
					ПараметрыПроцедуры.Вставить("Получатель", ПользовательОтветственныйЗаДополнениеНоменклатуры);
					ПараметрыПроцедуры.Вставить("Ответственный", ПользовательОтветственныйЗаСозданиеНоменклатуры);
					
					ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартОбработкаПодписокНаСобытия.ОтправитьУведомленияОСозданииНоменклатуры", ПараметрыПроцедуры, ПараметрыВыполнения);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 23.12.2020

//++ смарт:ММ #089 415 24.12.2020 - Оповещения при создании номенклатуры
Процедура ОтправитьУведомленияОСозданииНоменклатуры(Параметры, Адрес) Экспорт

	ОбщегоНазначенияБТС.Пауза(5);

	ИмяСобытияЖР = "смартОтправкаУведомленияОСозданииНоменклатуры";
	
	СправочникСсылка = Параметры.СправочникСсылка;
	Получатель = Параметры.Получатель;
	Ответственный = Параметры.Ответственный;
	
	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(Получатель, АдресаДляОтправкиСтрокой);

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) 
	//	И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
				
		ТемаПисьма = "Создана новая номенклатура " + СправочникСсылка;
		
		ТекстПисьма = "Создана новая номенклатура " + СправочникСсылка + ", артикул " + СправочникСсылка.Артикул + "." + Символы.ПС
		+ "По регламенту необходимо дозаполнить следующие сведения:" + Символы.ПС 
		+ "- сегмент для дилерских скидок" + Символы.ПС
		+ "- совместные продажи" + Символы.ПС
		+ "- цены";
				 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление о создании номенклатуры " + СправочникСсылка + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено уведомление о создании номенклатуры " + СправочникСсылка + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Исключение 
			//++ #1416 смарт: Фролов 29.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,,ТекстПисьма);
			//-- #1416 смарт: Фролов 29.08.2023
			ТекстСообщения = "Не удалось отправить уведомление о создании номенклатуры" + СправочникСсылка + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
		СоздаватьЗадачу = Справочники.смартПредопределенныеЗначения.СоздаватьЗадачу.Значение;
		
		Если ТипЗнч(СоздаватьЗадачу) = Тип("Булево") 
			И СоздаватьЗадачу = Истина Тогда
			
			ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
			ЗадачаОбъект.Дата = ТекущаяДатаСеанса();
			ЗадачаОбъект.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
			ЗадачаОбъект.Исполнитель = Получатель;
			ЗадачаОбъект.Предмет = СправочникСсылка;
			
			ЗадачаОбъект.Описание = "Дозаполнить номенклатуру";
			ЗадачаОбъект.Наименование = "Дозаполнить номенклатуру";
			ЗадачаОбъект.Автор = Ответственный;
			ЗадачаОбъект.СрокИсполнения = ЗадачаОбъект.Дата + 86400;
			ЗадачаОбъект.Записать();

			БизнесПроцессыИЗадачиВызовСервера.ВыполнитьЗадачу(ЗадачаОбъект.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 24.12.2020

