//++ смарт:ММ #104 488 19.04.2021 
Процедура ЗарезервироватьТоварыВЗаказахКлиентов(ТаблицаТоварыКРезерву)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ТЗ.ЗаказКлиента КАК ЗаказКлиента,
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЗ.ЗаказКлиента КАК ЗаказКлиента,
	|	ВТ_ТЗ.ЗаказПоставщику КАК ЗаказПоставщику,
	|	ВТ_ТЗ.Номенклатура КАК Номенклатура,
	|	ВТ_ТЗ.Количество КАК Количество,
	|	ЗаказКлиентаДок.Склад КАК СкладЗаказКлиента,
	|	ЗаказПоставщикуДок.Склад КАК СкладЗаказПоставщику
	|ИЗ
	|	ВТ_ТЗ КАК ВТ_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику КАК ЗаказПоставщикуДок
	|		ПО ВТ_ТЗ.ЗаказПоставщику = ЗаказПоставщикуДок.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	|		ПО ВТ_ТЗ.ЗаказКлиента = ЗаказКлиентаДок.Ссылка
	|ИТОГИ
	|	МАКСИМУМ(СкладЗаказКлиента),
	|	МАКСИМУМ(СкладЗаказПоставщику)
	|ПО
	|	ЗаказКлиента";
	Запрос.УстановитьПараметр("ТЗ", ТаблицаТоварыКРезерву);
	
	ВыборкаЗаказКлиента = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	РезервироватьКДате = Перечисления.ВариантыОбеспечения.ИзЗаказов;
	КОбеспечению = Перечисления.ВариантыОбеспечения.Требуется;
	УстановитьПривилегированныйРежим(Истина); //rnp 01.10.2021
	Пока ВыборкаЗаказКлиента.Следующий() Цикл
		
		ДокОбъект = ВыборкаЗаказКлиента.ЗаказКлиента.ПолучитьОбъект();
		
		// 1. Подбор склада в документа Заказ клиента
		СкладЗаказПоставщику = ВыборкаЗаказКлиента.СкладЗаказПоставщику;
		СкладЗаказКлиента = ВыборкаЗаказКлиента.СкладЗаказКлиента;
		
		// Поменять склад, если он не равен складу в Заказе поставщику
		СкладДляСтрокиЗаказаКлиента = Неопределено;
		Если СкладЗаказПоставщику <> СкладЗаказКлиента Тогда
			
			Если СкладЗаказКлиента.ЭтоГруппа 
				И СкладЗаказПоставщику.ПринадлежитЭлементу(СкладЗаказКлиента) Тогда
				// Склад в Заказе клиента менять не надо
			Иначе
				Склад = ПодобратьОбщуюГруппу(СкладЗаказКлиента, СкладЗаказПоставщику);
				ДокОбъект.Склад = Склад;
				СкладДляСтрокиЗаказаКлиента = СкладЗаказПоставщику;
			КонецЕсли;					
		КонецЕсли;
			
		Выборка = ВыборкаЗаказКлиента.Выбрать();
		
		Пока Выборка.Следующий() Цикл // По номенклатуре
			ДатаОтгрузкиРезерва = Выборка.ЗаказПоставщику.ЖелаемаяДатаПоступления;//++смарт:rnp 14.10.2021 всегда ли заполнена???
			КоличествоКРезерву = Выборка.Количество;
			
			Для Каждого СтрокаТовар Из ВыборкаЗаказКлиента.ЗаказКлиента.Товары Цикл  // Обходятся товары в ссылке, а не в объекте, т.к. в теле цикла в объект могут быть добавлены новые строки
				
				Если СтрокаТовар.Отменено Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаТовар.Номенклатура <> Выборка.Номенклатура Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаТовар.ВариантОбеспечения <> КОбеспечению Тогда // Проверять только строки, которые в РН График отгрузки товаров попали в колонку "Количество необеспечено"
					Продолжить;
				КонецЕсли;				
				
				Если КоличествоКРезерву = 0 Тогда
					Прервать;
				КонецЕсли;
								
				СтрокаТоварОбъект = ДокОбъект.Товары[СтрокаТовар.НомерСтроки - 1];
				
				Если СтрокаТовар.Количество > КоличествоКРезерву Тогда
					
					// Разбить строку
					НоваяСтрока = ДокОбъект.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовар);
					
					Хвостик = СтрокаТовар.Количество - КоличествоКРезерву; // В строке количество больше, чем надо зарезервировать
					
					НоваяСтрока.Количество = Хвостик;
					НоваяСтрока.КоличествоУпаковок = НоваяСтрока.Количество;
					
					ПересчитатьСтрокуЗаказаКлиента(НоваяСтрока, ДокОбъект);
					
					СтрокаТоварОбъект.Количество = КоличествоКРезерву;
					СтрокаТоварОбъект.КоличествоУпаковок = СтрокаТовар.Количество;
					
					ПересчитатьСтрокуЗаказаКлиента(СтрокаТоварОбъект, ДокОбъект);
					
				КонецЕсли;
				
				КоличествоКРезерву = КоличествоКРезерву - СтрокаТоварОбъект.Количество;
				СтрокаТоварОбъект.ВариантОбеспечения = РезервироватьКДате;
				СтрокаТоварОбъект.ДатаОтгрузки = ?(ЗначениеЗаполнено(ДатаОтгрузкиРезерва),ДатаОтгрузкиРезерва, ТекущаяДата());//++смарт:rnp 14.10.2021
				Если ЗначениеЗаполнено(СкладДляСтрокиЗаказаКлиента) Тогда
					СтрокаТоварОбъект.Склад = СкладДляСтрокиЗаказаКлиента;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Попытка
			ДокОбъект.Записать();
			ОбщегоНазначения.СообщитьПользователю("Изменен статус резерва в документе " + ДокОбъект.Ссылка, ДокОбъект.Ссылка);
		Исключение
			ЗаписьЖурналаРегистрации("смартРезервированиеТовараПоЗаказуПоставщику", УровеньЖурналаРегистрации.Ошибка, ,, ОписаниеОшибки());
		КонецПопытки;		
	КонецЦикла;	
	УстановитьПривилегированныйРежим(Ложь);//rnp 01.10.2021
КонецПроцедуры //-- смарт:ММ 19.04.2021

//++ смарт:ММ #104 488 19.04.2021 
Процедура ПересчитатьСтрокуЗаказаКлиента(НоваяСтрока, ДокОбъект)
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокОбъект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	
	НоваяСтрока.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
		НоваяСтрока.Сумма,
		УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС),
		ДокОбъект.ЦенаВключаетНДС,
		ДокОбъект.НалогообложениеНДС);
	
	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСНДСВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено); 			
	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСУчетомРучнойСкидкиВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
			
КонецПроцедуры //-- смарт:ММ 19.04.2021

