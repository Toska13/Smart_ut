#Область СлужебныеПроцедурыИФункции

// Подключается обработчиком ожидания в ПриНачалеРаботыСистемы
Процедура ОбработатьВходящееСобытиеВзаимодействия() Экспорт
	
	//++ #1747 смарт: Ермаков 05.04.2024 / Интеграция телефонии в 1C:СRM - Создание HTTP Сервиса для оповещения 1С
	Данные = Неопределено;
	
	//++ #Б-1114 смарт: Ермаков 09.10.2024 / Поиск и устранение перерасхода ресурсов сервера
	Если СтандартныеПодсистемыКлиент.ПараметрКлиента("ЭтоСекретарь") Тогда
    //-- #Б-1114 смарт: Ермаков 09.10.2024
	
		ВидСобытия = ПредопределенноеЗначение("Перечисление.смартВидыСобытийВзаимодействий.ВходящийТелефонныйЗвонок"); 
		
		Если смартСобытияВзаимодействий.ПолучитьДанныеСобытияВзаимодействий(ВидСобытия, Данные) Тогда
			
			Если Не Данные = Неопределено Тогда
				Оповестить("ВходящийТелефонныйЗвонок", Данные, "смартГлобальный.ОбработатьВходящееСобытиеВзаимодействия");
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;		
	//-- #1747 смарт: Ермаков 05.04.2024
	
	//++ #1760 смарт: Ермаков 05.04.2024 / Создание механизма оповещений менеджеров о назначенных Интересах.
	//++ #Б-1114 смарт: Ермаков 09.10.2024 / Поиск и устранение перерасхода ресурсов сервера  
	Если СтандартныеПодсистемыКлиент.ПараметрКлиента("ИспользуетПодсистемуCRM") Тогда
	//-- #Б-1114 смарт: Ермаков 09.10.2024
	
		//++ #1760 смарт: Ермаков 05.04.2024 / Создание механизма оповещений менеджеров о назначенных Интересах.
		ВидСобытия = ПредопределенноеЗначение("Перечисление.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес");
			
		Если смартСобытияВзаимодействий.ПолучитьДанныеСобытияВзаимодействий(ВидСобытия, Данные) Тогда
			
			Если Не Данные = Неопределено Тогда
				
				Если Данные.НаборДанных.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				ИдентификаторСобытия = Данные.НаборДанных[0].ИдентификаторСобытия; 
				
				ОткрытьФорму("РегистрСведений.смартВходящиеСобытияВзаимодействий.Форма.ФормаСобытияСозданиеДокументаИнтерес", 
					Данные,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
					
				смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(ИдентификаторСобытия);
				
			КонецЕсли;
			
		КонецЕсли;   
		//-- #1760 смарт: Ермаков 05.04.2024
		
		//++ #1789 смарт: Ермаков 22.04.2024 / Доработка механизма оповещений менеджеров.
		ВидСобытия = ПредопределенноеЗначение("Перечисление.смартВидыСобытийВзаимодействий.НайденСуществующийПартнер");
			
		Если смартСобытияВзаимодействий.ПолучитьДанныеСобытияВзаимодействий(ВидСобытия, Данные) Тогда
			
			Если Не Данные = Неопределено Тогда
				
				Если Данные.НаборДанных.Количество() = 0 Тогда
					Возврат;
				КонецЕсли;
				
				ИдентификаторСобытия = Данные.НаборДанных[0].ИдентификаторСобытия; 
				
				ОткрытьФорму("РегистрСведений.смартВходящиеСобытияВзаимодействий.Форма.ФормаСобытияСозданиеДокументаИнтерес", 
					Данные,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
					
				смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(ИдентификаторСобытия);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #1789 смарт: Ермаков 22.04.2024
	
КонецПроцедуры

#КонецОбласти