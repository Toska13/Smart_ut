//++ #1901 смарт: Ермаков 21.04.2024 / Создание документа Заявка на разборку оборудования
Процедура ОтразитьЗаявкиНаРазборкуОборудования(ДополнительныеСвойства, Движения, Отказ) Экспорт
	                                                                  
	ТаблицаЗаявкиНаРазборкуОборудования = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСмартЗаявкиНаРазборкуОборудования;
	
	Если Отказ ИЛИ ТаблицаЗаявкиНаРазборкуОборудования.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияЗаявкиНаРазборкуОборудования = Движения.смартЗаявкиНаРазборкуОборудования;
	ДвиженияЗаявкиНаРазборкуОборудования.Записывать = Истина;
	ДвиженияЗаявкиНаРазборкуОборудования.Загрузить(ТаблицаЗаявкиНаРазборкуОборудования);	
	
КонецПроцедуры 

//++ #1901 смарт: Ермаков 21.04.2024 / Создание документа Заявка на разборку оборудования
Процедура ОтразитьОборудованиеКРазборке(ДополнительныеСвойства, Движения, Отказ) Экспорт
	                                                                  
	ТаблицаОборудованиеКРазборке = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСмартОборудованиеКРазборке;
	
	Если Отказ ИЛИ ТаблицаОборудованиеКРазборке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДвиженияОборудованиеКРазборке = Движения.смартОборудованиеКРазборке;
	ДвиженияОборудованиеКРазборке.Записывать = Истина;
	ДвиженияОборудованиеКРазборке.Загрузить(ТаблицаОборудованиеКРазборке);	
	
КонецПроцедуры

//++ #1901 смарт: Ермаков 21.04.2024 / Создание документа Заявка на разборку оборудования
Процедура ДополнитьПараметрыИнициализацииПроведения(ДокументСсылка, Запрос) Экспорт

	ЗаявкаНаРазборкуОборудования 
		= Документы.смартЗаявкаНаРазборкуОборудования.ПолучитьСсылкуНаЗаявкуПоОснованию(ДокументСсылка);

	Запрос.УстановитьПараметр("ЭтоРазборкаОборудования", Не ЗаявкаНаРазборкуОборудования.Пустая());
	Запрос.УстановитьПараметр("ЗаявкаНаРазборкуОборудования", ЗаявкаНаРазборкуОборудования);
	Запрос.УстановитьПараметр("НазначениеЗаявкаНаРазборку", ЗаявкаНаРазборкуОборудования.Назначение);
	
	Если Не Запрос.Параметры.Свойство("Серия") Тогда
		Запрос.УстановитьПараметр("Серия", ЗаявкаНаРазборкуОборудования.Серия);
	КонецЕсли;
	
	Если Не Запрос.Параметры.Свойство("ПустойСклад") Тогда
		Запрос.УстановитьПараметр("ПустойСклад", Справочники.Склады.ПустаяСсылка());	
	КонецЕсли;
	
	//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
	ДанныеЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаявкаНаРазборкуОборудования, 
															 "СборкаНеТребуется,Узел");
	Запрос.УстановитьПараметр("СборкаНеТребуется", ?(ДанныеЗаявки.СборкаНеТребуется = Неопределено, Ложь, ДанныеЗаявки.СборкаНеТребуется));
	Запрос.УстановитьПараметр("Узел", ДанныеЗаявки.Узел);
	//-- #Б2138 смарт: Шляпников 19.02.2025
	
КонецПроцедуры

#КонецОбласти 
