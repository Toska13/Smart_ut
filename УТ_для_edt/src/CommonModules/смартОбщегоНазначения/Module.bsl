//++#1517 смарт: Лопато 25.01.2024 //Установка статуса указания серий по дате начала серийного учета номенклатуры
Функция смартПолучитьДатуОбъектаДляРасчетаСтатусовСерий(СтрокаТЧ, ПараметрыУказанияСерий = Неопределено, Объект = Неопределено) Экспорт
	
	ДатаОбъекта = Неопределено;
	
	//Расчет статуса указаний серий по всей ТЧ объекта
	Если Объект <> Неопределено Тогда
		
		Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") 
			ИЛИ ТипЗнч(Объект) = Тип("Структура") 
			ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура") 
			ИЛИ Метаданные.Документы.Содержит(Метаданные.НайтиПоТипу(ТипЗнч(Объект))) Тогда
			
			Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
				ДокументОбъект = Объект;
			Иначе
				ДокументОбъект = Объект.Ссылка;
			КонецЕсли;
			
			Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда

				Если ЗначениеЗаполнено(СтрокаТЧ.ДатаОтгрузки) И НЕ ДокументОбъект.НеОтгружатьЧастями Тогда
					ДатаОбъекта = СтрокаТЧ.ДатаОтгрузки;
				ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.ДатаОтгрузки) И ДокументОбъект.НеОтгружатьЧастями Тогда
					ДатаОбъекта = ДокументОбъект.ДатаОтгрузки;
				КонецЕсли;

			ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда

				Если ЗначениеЗаполнено(СтрокаТЧ.НачалоОтгрузки) Тогда
					ДатаОбъекта = СтрокаТЧ.НачалоОтгрузки;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда

				Если ЗначениеЗаполнено(ДокументОбъект.НачалоСборкиРазборки) Тогда
					ДатаОбъекта = ДокументОбъект.НачалоСборкиРазборки;
				КонецЕсли;

			ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда

				Если ЗначениеЗаполнено(СтрокаТЧ.ДатаОтгрузки) И НЕ ДокументОбъект.НеОтгружатьЧастями Тогда
					ДатаОбъекта = СтрокаТЧ.ДатаОтгрузки;
				ИначеЕсли ЗначениеЗаполнено(ДокументОбъект.ДатаОтгрузки) И ДокументОбъект.НеОтгружатьЧастями Тогда
					ДатаОбъекта = ДокументОбъект.ДатаОтгрузки;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
				
				Если ЗначениеЗаполнено(ДокументОбъект.ДатаОтгрузки) Тогда
					ДатаОбъекта = ДокументОбъект.ДатаОтгрузки;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ДатаОбъекта) И ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
				ДатаОбъекта = ДокументОбъект.Дата;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;
		
	//Расчет статуса указаний серий по одной строке
	Если НЕ ЗначениеЗаполнено(ДатаОбъекта)
		И (Объект = Неопределено ИЛИ (ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура"))) Тогда
			
		Если (ТипЗнч(ПараметрыУказанияСерий) = Тип("Структура") ИЛИ ТипЗнч(ПараметрыУказанияСерий) = Тип("ФиксированнаяСтруктура")) Тогда
				
			Если ПараметрыУказанияСерий.Свойство("ПолноеИмяОбъекта") Тогда
				
				Если (ПараметрыУказанияСерий.ПолноеИмяОбъекта = "Документ.ЗаказКлиента" ИЛИ ПараметрыУказанияСерий.ПолноеИмяОбъекта = "Документ.ЗаказНаВнутреннееПотребление")
					И ((ТипЗнч(СтрокаТЧ) = Тип("СтрокаТаблицыЗначений") И СтрокаТЧ.Владелец().Колонки.Найти("ДатаОтгрузки") <> Неопределено)
					   ИЛИ ((ТипЗнч(СтрокаТЧ) = Тип("Структура") ИЛИ ТипЗнч(СтрокаТЧ) = Тип("ФиксированнаяСтруктура")) И СтрокаТЧ.Свойство("ДатаОтгрузки"))) Тогда
				
					Если ЗначениеЗаполнено(СтрокаТЧ.ДатаОтгрузки) Тогда
			    		ДатаОбъекта = СтрокаТЧ.ДатаОтгрузки;
					КонецЕсли;

				КонецЕсли;	

				Если ПараметрыУказанияСерий.ПолноеИмяОбъекта = "Документ.ЗаказНаПеремещение"
					И ((ТипЗнч(СтрокаТЧ) = Тип("СтрокаТаблицыЗначений") И СтрокаТЧ.Владелец().Колонки.Найти("НачалоОтгрузки") <> Неопределено)
					   ИЛИ ((ТипЗнч(СтрокаТЧ) = Тип("Структура") ИЛИ ТипЗнч(СтрокаТЧ) = Тип("ФиксированнаяСтруктура")) И СтрокаТЧ.Свойство("НачалоОтгрузки"))) Тогда
				
					Если ЗначениеЗаполнено(СтрокаТЧ.НачалоОтгрузки) Тогда
			    		ДатаОбъекта = СтрокаТЧ.НачалоОтгрузки;
					КонецЕсли;

				КонецЕсли;	
				
			КонецЕсли;	

		КонецЕсли;	

	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ДатаОбъекта) 
		И (ТипЗнч(ПараметрыУказанияСерий) = Тип("Структура") ИЛИ ТипЗнч(ПараметрыУказанияСерий) = Тип("ФиксированнаяСтруктура")) 
		И ПараметрыУказанияСерий.Свойство("Дата") 
		И ЗначениеЗаполнено(ПараметрыУказанияСерий.Дата) Тогда
		
		ДатаОбъекта = ПараметрыУказанияСерий.Дата;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДатаОбъекта) 
		И (ТипЗнч(Объект) = Тип("Структура") ИЛИ ТипЗнч(Объект) = Тип("ФиксированнаяСтруктура")) Тогда
		
		Если Объект.Свойство("Дата") И ЗначениеЗаполнено(Объект.Дата) Тогда
			ДатаОбъекта = Объект.Дата;
		ИначеЕсли Объект.Свойство("Ссылка") И ЗначениеЗаполнено(Объект.Ссылка) Тогда
			ДатаОбъекта = Объект.Ссылка.Дата;
		КонецЕсли;
		
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(ДатаОбъекта) Тогда
		ДатаОбъекта = ТекущаяДатаСеанса();
	КонецЕсли;	
			
	Возврат ДатаОбъекта; 
			
КонецФункции //--#1517 смарт: Лопато 25.01.2024

