//++#1311 смарт: Лопато 17.02.2023 //Изменить форму Счета на оплату (Счет-оферта)  
Функция смартВЗаказахУстановленРезерв(МассивЗаказов) Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
        |	ЗаказКлиентаТовары.Ссылка КАК Заказ
        |ИЗ
        |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
        |ГДЕ
        |	ЗаказКлиентаТовары.Ссылка В(&Заказы)
        |	И НЕ ЗаказКлиентаТовары.Отменено
		|	И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
		|				ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется)
		|				ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно))";
    
    Запрос.УстановитьПараметр("Заказы", МассивЗаказов);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Пустой();
	
КонецФункции //--#1311 смарт: Лопато 17.02.2023

//++#1311 смарт: Лопато 17.02.2023 //Изменить форму Счета на оплату (Счет-оферта)  
Функция смартНужноВыводитьОферту(МассивЗаказов) Экспорт

	СегментПроверки = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментАппаратноеОбеспечение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка В(&Заказы)
	|	И ЗаказКлиентаТовары.Ссылка.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И ЗаказКлиентаТовары.Отменено = ЛОЖЬ
	|	И (ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|			ИЛИ ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Набор))
	|;
	|";
	
	Если ЗначениеЗаполнено(СегментПроверки) И СегментПроверки.СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьДинамически Тогда

		ТЗНоменклатураСегмента = СегментыСервер.СписокЭлементовСКД(СегментПроверки);
		
		Запрос.Текст = Запрос.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Номенклатура.Ссылка КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_НоменклатураСегмента
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В(&НоменклатураСегмента)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|";
		
		Запрос.УстановитьПараметр("НоменклатураСегмента", ТЗНоменклатураСегмента.ВыгрузитьКолонку("ЭлементСписка"));  
		
	Иначе

		Запрос.Текст = Запрос.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоменклатураСегмента.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ВТ_НоменклатураСегмента
		|ИЗ
		|	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
		|ГДЕ
		|	НоменклатураСегмента.Сегмент = &Сегмент
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура
		|;
		|";
		
	КонецЕсли;	
	
	Запрос.Текст = Запрос.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_НоменклатураСегмента КАК ВТ_НоменклатураСегмента
	|		ПО ВТ_Товары.Номенклатура = ВТ_НоменклатураСегмента.Номенклатура
	|";
	
    Запрос.УстановитьПараметр("Заказы",  МассивЗаказов);
	Запрос.УстановитьПараметр("Сегмент", СегментПроверки);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ЕстьТовар 			= НЕ РезультатЗапроса[2].Пустой();
	НетТовараИзСегмента = РезультатЗапроса[3].Пустой();
	
	Возврат ЕстьТовар И НетТовараИзСегмента;
	
КонецФункции //--#1311 смарт: Лопато 17.02.2023	

//++#1318 смарт: Лопато 09.03.2023 //Добавить текст оферты в файл Счет на оплату  
Функция смартСформироватьТекстОферты(ЗаказКлиента) Экспорт
	
	ТекстОферта = "";
	
	Если ЗначениеЗаполнено(ЗаказКлиента) 
		И ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") 
		И смартНужноВыводитьОферту(ЗаказКлиента) Тогда

		СтруктураДанныхОферта = Новый Структура;
		
		МакетОферта = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСчетовНаОплату.смартПФ_MXL_СчетНаОплатуВнимание");
		
		//++ #Б-1290 смарт: Мосолов 07.11.2024 //Дополнить печатную форму счета на оплату из 1С
		СписокАртикуловАналоговыхДеталей = ПолучитьСписокАртикуловАналоговыхДеталей(ЗаказКлиента);
		
		Если СписокАртикуловАналоговыхДеталей = "" Тогда
		//-- #Б-1290 смарт: Мосолов 07.11.2024
		
			Если ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента Тогда
				//Счет - доставка до склада Покупателя
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоКлиента").Область(3,2).Текст;
			ИначеЕсли ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика 
				  ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу
				  ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки Тогда
				//Счет - доставка до транспортной компании                                                    
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоТранспортнойКомпании").Область(3,2).Текст;
			ИначеЕсли ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз 
				  ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
				//Счет - самовывоз со склада Продавца
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаСамовывоз").Область(3,2).Текст;
			Иначе
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоКлиента").Область(3,2).Текст;
			КонецЕсли;				
		
		//++ #Б-1290 смарт: Мосолов 07.11.2024 //Дополнить печатную форму счета на оплату из 1С
		Иначе
		
			Если ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента Тогда  
				
				//Счет - доставка до склада Покупателя
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоКлиентаПоСегменту").Область(3,2).Текст;  
				
			ИначеЕсли ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчика 
				ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу
				ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки Тогда
				
				//Счет - доставка до транспортной компании                                                    
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоТранспортнойКомпанииПоСегменту").Область(3,2).Текст;  
				
			ИначеЕсли ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз 
				ИЛИ ЗаказКлиента.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда   
				
				//Счет - самовывоз со склада Продавца
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаСамовывозПоСегменту").Область(3,2).Текст;     
				
			Иначе     
				
				ТекстОферта = МакетОферта.ПолучитьОбласть("смартОфертаДоКлиентаПоСегменту").Область(3,2).Текст;  
				
			КонецЕсли;				
			
		КонецЕсли;
		
		СтруктураДанныхОферта.Вставить("АртикулыТоваровСегмента", СписокАртикуловАналоговыхДеталей);
		//-- #Б-1290 смарт: Мосолов 07.11.2024
		
		ТаблицаЭтапыОплаты = смартСформироватьТаблицуЭтапыОплатыЗаказа(ЗаказКлиента);
		
		ДатаСрокаДействия = смартПолучитьДатуСрокаДействия(ЗаказКлиента.Валюта, ЗаказКлиента.Дата, ТаблицаЭтапыОплаты);
		
		СтруктураДанныхОферта.Вставить("СрокОплаты", Формат(ДатаСрокаДействия, "ДФ=dd.MM.yyyy"));

		СтруктураДанныхОферта.Вставить("АдресДоставки", смартОпределитьСкладДоставки(ЗаказКлиента));
		СтруктураДанныхОферта.Вставить("СрокПоставки", смартПолучитьСрокПоставкиОферты(ЗаказКлиента));
		
		//++ #4778 смарт: Тимофеева 07.11.2025 / Заказ клиента. Печатная форма. Дополнить текст. 
		ЭлектронныйАдресКонтактногоЛица = "";
		ТелефонКонтактногоЛица 			= "";
		
		Бухгалтер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента.Контрагент, "смартБухгалтер", Истина);
		Если ЗначениеЗаполнено(Бухгалтер) Тогда
			КонтактнаяИнформация 			= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Бухгалтер, , ЗаказКлиента.Дата, Ложь);
			ТаблицаЭлектронныхАдресов		= КонтактнаяИнформация.Скопировать(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица), "Представление");
			ЭлектронныйАдресКонтактногоЛица = СтрСоединить(ТаблицаЭлектронныхАдресов.ВыгрузитьКолонку("Представление"), ", ");
		
			ТаблицаТелефонов		 		= КонтактнаяИнформация.Скопировать(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица), "Представление");
			ТаблицаМобильныхТелефонов		= КонтактнаяИнформация.Скопировать(Новый Структура("Вид", Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица), "Представление");
		
			ТелефонКонтактногоЛица			= СтрСоединить(ТаблицаТелефонов.ВыгрузитьКолонку("Представление"), ", ") 
											+ ?(ТаблицаТелефонов.Количество() > 0 И ТаблицаМобильныхТелефонов.Количество() > 0, ", ", "")
											+ СтрСоединить(ТаблицаМобильныхТелефонов.ВыгрузитьКолонку("Представление"), ", ");
		КонецЕсли;
										
		СтруктураДанныхОферта.Вставить("ЭлектронныйАдресКонтактногоЛица", 	ЭлектронныйАдресКонтактногоЛица);
		СтруктураДанныхОферта.Вставить("ТелефонКонтактногоЛица", 			ТелефонКонтактногоЛица);
		
		СведенияОбОрганизации   		= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ЗаказКлиента.Организация, ЗаказКлиента.Дата);
		СтруктураДанныхОферта.Вставить("ЭлектронныйАдресПродавца", СведенияОбОрганизации.ЭлектроннаяПочта);
		СтруктураДанныхОферта.Вставить("ТелефонПродавца", СведенияОбОрганизации.Телефоны);
	   	//-- #4778 смарт: Тимофеева 07.11.2025
		
		Для Каждого ПараметрОферта Из СтруктураДанныхОферта Цикл 
			ТекстОферта = СтрЗаменить(ТекстОферта, "["+ПараметрОферта.Ключ+"]", СокрЛП(ПараметрОферта.Значение));
		КонецЦикла;	

	КонецЕсли;				
	
	Возврат ТекстОферта;
	
КонецФункции //--#1318 смарт: Лопато 09.03.2023	

//++ #Б-1290 смарт: Мосолов 07.11.2024 //Дополнить печатную форму счета на оплату из 1С
Функция ПолучитьСписокАртикуловАналоговыхДеталей(ЗаказКлиента) 
	
	СписокАртикулов = "";
	
	СегментАналогов = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "АналоговыеДетали");
	
	Если СегментАналогов.Пустая() Тогда
		
		Возврат СписокАртикулов;
		
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("Сегмент", СегментАналогов);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТоварыЗаказа
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
	|	И НЕ ЗаказКлиентаТовары.Отменено
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НоменклатураСегмента.Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
	|ГДЕ
	|	НоменклатураСегмента.Сегмент = &Сегмент
	|	И НоменклатураСегмента.Номенклатура В
	|			(ВЫБРАТЬ
	|				ТоварыЗаказа.Номенклатура
	|			ИЗ
	|				ТоварыЗаказа КАК ТоварыЗаказа)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		СписокАртикулов = ?(СписокАртикулов = "", "", СписокАртикулов + ", ") + Выборка.Артикул;
		
	КонецЦикла;
	
	Возврат СписокАртикулов;
	
КонецФункции //-- #Б-1290 смарт: Мосолов 07.11.2024

//++#1318 смарт: Лопато 09.03.2023 //Добавить текст оферты в файл Счет на оплату  
Функция смартСформироватьТаблицуЭтапыОплатыЗаказа(ЗаказКлиента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	1														КАК Порядок,
	|	ЭтапыГрафикаОплаты.Ссылка								КАК Ссылка,
	|	ЭтапыГрафикаОплаты.НомерСтроки							КАК НомерСтроки,
	|	ЭтапыГрафикаОплаты.ДатаПлатежа							КАК ДатаПлатежа,
	|	ЭтапыГрафикаОплаты.ПроцентПлатежа						КАК ПроцентПлатежа,
	|	ЭтапыГрафикаОплаты.СуммаПлатежа							КАК СуммаПлатежа,
	|	ЛОЖЬ													КАК ЭтоЗалогЗаТару
	|ИЗ
	|	Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЭтапыГрафикаОплаты
	|ГДЕ
	|	ЭтапыГрафикаОплаты.Ссылка В(&МассивОбъектов)
	|	И ЭтапыГрафикаОплаты.СуммаПлатежа <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2														КАК Порядок,
	|	ЭтапыГрафикаОплаты.Ссылка								КАК Ссылка,
	|	ЭтапыГрафикаОплаты.НомерСтроки							КАК НомерСтроки,
	|	ЭтапыГрафикаОплаты.ДатаПлатежа							КАК ДатаПлатежа,
	|	ЭтапыГрафикаОплаты.ПроцентЗалогаЗаТару					КАК ПроцентПлатежа,
	|	ЭтапыГрафикаОплаты.СуммаЗалогаЗаТару					КАК СуммаПлатежа,
	|	ИСТИНА													КАК ЭтоЗалогЗаТару
	|ИЗ
	|	Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЭтапыГрафикаОплаты
	|ГДЕ
	|	ЭтапыГрафикаОплаты.Ссылка В(&МассивОбъектов)
	|	И ЭтапыГрафикаОплаты.Ссылка.ТребуетсяЗалогЗаТару
	|	И ЭтапыГрафикаОплаты.СуммаЗалогаЗаТару <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	Порядок";
	
	Запрос.УстановитьПараметр("МассивОбъектов", ЗаказКлиента);
	
	РезультатЭтапыОплаты = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЭтапыОплаты;

КонецФункции //--#1318 смарт: Лопато 09.03.2023	

//++#1311 смарт: Лопато 17.02.2023 //Изменить форму Счета на оплату (Счет-оферта)  
Функция смартОпределитьСкладДоставки(ЗаказСсылка)
	
	АдресДоставки = ЗаказСсылка.АдресДоставки;
	
	Если ЗаказСсылка.СпособДоставки=Перечисления.СпособыДоставки.Самовывоз 
		ИЛИ ЗаказСсылка.СпособДоставки=Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
		
		МассивСкладовДоставка = Новый Массив;
		
		Если НЕ ЗаказСсылка.Склад.ЭтоГруппа Тогда
			МассивСкладовДоставка.Добавить(ЗаказСсылка.Склад);
		Иначе
			Для Каждого СтрТовары Из ЗаказСсылка.Товары Цикл
				Если ЗначениеЗаполнено(СтрТовары.Склад) Тогда
					МассивСкладовДоставка.Добавить(СтрТовары.Склад);
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СкладыКонтактнаяИнформация.Представление КАК Адрес
		|ИЗ
		|	Справочник.Склады.КонтактнаяИнформация КАК СкладыКонтактнаяИнформация
		|ГДЕ
		|	СкладыКонтактнаяИнформация.Ссылка В(&Склады)
		|	И СкладыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресСклада)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Представление
		|";
		Запрос.УстановитьПараметр("Склады", МассивСкладовДоставка);
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			АдресДоставки = Результат.Адрес;
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат АдресДоставки;
	
КонецФункции //--#1311 смарт: Лопато 17.02.2023	

//++#1311 смарт: Лопато 17.02.2023 //Изменить форму Счета на оплату (Счет-оферта)  
Функция смартПолучитьСрокПоставкиОферты(ЗаказКлиента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &ЗаказСсылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	МАКСИМУМ(ЗаказКлиентаТовары.ДатаОтгрузки) КАК ДатаОтгрузки
	|ПОМЕСТИТЬ ВТ_МаксДатаОтгрузки
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказ КАК ВТ_Заказ
	|		ПО (ВТ_Заказ.Заказ = ЗаказКлиентаТовары.Ссылка)
	|ГДЕ
	|	НЕ ЗаказКлиентаТовары.Отменено
	|	И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
	|			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется)
	|			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ИзЗаказов)
	|			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	|	ЛОЖЬ КАК ТоварВРезерве
	|ПОМЕСТИТЬ ВТ_ТоварВРезерве
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказ КАК ВТ_Заказ
	|		ПО (ВТ_Заказ.Заказ = ЗаказКлиентаТовары.Ссылка)
	|ГДЕ
	|	НЕ ЗаказКлиентаТовары.Отменено
	|	И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
	|				ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется)
	|				ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ИзЗаказов)
	|				ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказ.Заказ КАК Заказ,
	|	ЕСТЬNULL(ВТ_МаксДатаОтгрузки.ДатаОтгрузки, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОтгрузки,
	|	ЕСТЬNULL(ВТ_ТоварВРезерве.ТоварВРезерве, ИСТИНА) КАК ТоварВРезерве
	|ИЗ
	|	ВТ_Заказ КАК ВТ_Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаксДатаОтгрузки КАК ВТ_МаксДатаОтгрузки
	|		ПО ВТ_Заказ.Заказ = ВТ_МаксДатаОтгрузки.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварВРезерве КАК ВТ_ТоварВРезерве
	|		ПО ВТ_Заказ.Заказ = ВТ_ТоварВРезерве.Заказ
	|";
	
	Запрос.Параметры.Вставить("ЗаказСсылка", ЗаказКлиента);	
	
	Результат = Запрос.Выполнить().Выбрать();
	
	//В п.2 срок проставляется из "резерв к дате + 5 раб. дней".
	//- если весь товар в резерве, ставим срок 5 дней
	//- если резерв к дате, берем самую дальнюю дату + 5 дней
	//- если товар не зарезервирован, перед печатью счета выдавать окно Да/Нет, если Да, берем дату "Отгружать одной датой/Дата отгрузки (самая дальняя)" + 5 раб. дней.		
	Если Результат.Следующий() Тогда
		Если Результат.ТоварВРезерве = Истина Тогда
			Возврат 5;
		ИначеЕсли ЗначениеЗаполнено(Результат.ДатаОтгрузки) Тогда
			РабочихДней = КалендарныеГрафики.РазностьДатПоКалендарю(КалендарныеГРафики.ОсновнойПроизводственныйКалендарь(), ЗаказКлиента.Дата, Результат.ДатаОтгрузки);
			Если РабочихДней <= 0 Тогда
				Возврат 5;
			Иначе	
				Возврат РабочихДней - 1 + 5;
			КонецЕсли;	
		Иначе	
			Возврат 5;
		КонецЕсли;	
	Иначе
		Возврат 5;
	КонецЕсли;	
	
КонецФункции //--#1311 смарт: Лопато 17.02.2023	

//++#1311 смарт: Лопато 10.02.2023 //Изменить форму Счета на оплату (Счет-оферта)  
