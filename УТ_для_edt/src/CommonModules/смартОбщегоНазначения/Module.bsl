//++ #1366 смарт: Фролов 28.06.2023 //Отслеживать появление на складах запчастей, требуемых для выполнения заявок со статусом  
Функция смартВычислитьРазличияВТаблицахЗначений(Таблица0, Таблица1, Измерения) Экспорт
	
	Отбор = Новый Структура(Измерения);
    
    Ресурсы = Новый Массив;
    Для ИндексКолонки = 0 По Таблица0.Колонки.Количество() - 1 Цикл
        Если НЕ Отбор.Свойство(Таблица0.Колонки[ИндексКолонки].Имя) Тогда
            Ресурсы.Добавить(ИндексКолонки)
        КонецЕсли
    КонецЦикла;
    
    Таблица1.Колонки.Добавить("Знак", Новый ОписаниеТипов("Число"));
    Таблица1.ЗаполнитьЗначения(1, "Знак");
    НовыйИндекс = Таблица1.Индексы.Добавить(Измерения);
    
    Разница = Таблица1.СкопироватьКолонки();
    
    Для Каждого Строка0 Из Таблица0 Цикл
        ЗаполнитьЗначенияСвойств(Отбор, Строка0); 
        Строки1 = Таблица1.НайтиСтроки(Отбор);
        Если Строки1.Количество() = 0 Тогда     
            ЗаполнитьЗначенияСвойств(Разница.Добавить(), Строка0)     
        Иначе
            Строка1 = Строки1[0];
            Для Каждого Ресурс Из Ресурсы Цикл 
                Если Строка0[Ресурс] <> Строка1[Ресурс] Тогда    
                    ЗаполнитьЗначенияСвойств(Разница.Добавить(), Строка0);
                    ЗаполнитьЗначенияСвойств(Разница.Добавить(), Строка1);
                    Прервать 
                КонецЕсли 
            КонецЦикла;
            Строка1.Знак = 0 
        КонецЕсли 
    КонецЦикла;
    
    Для Каждого Строка1 Из Таблица1.НайтиСтроки(Новый Структура("Знак", 1)) Цикл 
        ЗаполнитьЗначенияСвойств(Разница.Добавить(), Строка1); 
    КонецЦикла;
    
    Таблица1.Колонки.Удалить("Знак");
    Таблица1.Индексы.Удалить(НовыйИндекс);
        
    Возврат Разница
	
КонецФункции  //-- #1366 смарт: Фролов 28.06.2023

//++ #1416 смарт: Фролов 28.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ  
Процедура смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма, ДокСсылка = Неопределено, ТекстПисьма = "") Экспорт
	
	КлючУникальности = Новый УникальныйИдентификатор();
	
	НаборЗаписей = РегистрыСведений.смартКэшНеОтправленныхПочтовыхСообщений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УИДПисьма.Установить(КлючУникальности); 
	НаборЗаписей.Прочитать();
	
	СтрПолучателиТекст = "";
	СтруктураЗаписи = Новый Структура; 
	СтруктураЗаписиКопии = Новый Структура;
	МасПолучатели = Новый Массив;
	
	Для Каждого СтрПолучатели Из ПараметрыПисьма.Кому Цикл
		
		СтрПолучателиТекст = СтрПолучателиТекст+СтрПолучатели.Представление + "; ";
		МасПолучатели.Добавить(Строка(СтрПолучатели.Представление));
		
	КонецЦикла;	
	
	Если ПараметрыПисьма.Свойство("Копии") Тогда
		
		МасКопии = Новый Массив;
		
		Для Каждого СтрКопии Из ПараметрыПисьма.Копии Цикл
			
			СтрКопииТекст = СтрКопииТекст+СтрКопии.Представление+"; ";
			МасКопии.Добавить(Строка(СтрКопии.Представление));	
			
		КонецЦикла;
		
	КонецЕсли;	
	
	СтруктураЗаписи.Вставить("МасПолучатели", МасПолучатели);
	СтруктураЗаписиКопии.Вставить("МасПолучатели", МасКопии);
	
	Если ПараметрыПисьма.Свойство("Вложения") Тогда
		
		Для Каждого СтруктураВложение Из ПараметрыПисьма.Вложения Цикл
			
			СтрНаборЗаписей = НаборЗаписей.Добавить();
			
			Если НЕ ЭтоАдресВременногоХранилища(СтруктураВложение.АдресВоВременномХранилище) Тогда
				
				ЭлементХранилища = Новый ХранилищеЗначения(Новый ДвоичныеДанные(СтруктураВложение.АдресВоВременномХранилище));
				СтрНаборЗаписей.ПрисоединенныйФайл = ЭлементХранилища; 
				
			Иначе	
				
				ЗагруженныйФайл = ПолучитьИзВременногоХранилища(СтруктураВложение.АдресВоВременномХранилище);
				ЭлементХранилища = Новый ХранилищеЗначения(ЗагруженныйФайл);
				СтрНаборЗаписей.АдресХранилища = СтруктураВложение.АдресВоВременномХранилище;
				СтрНаборЗаписей.ПрисоединенныйФайл = ЭлементХранилища; 
				
			КонецЕсли;
			
			СтрНаборЗаписей.УИДПисьма = КлючУникальности;
			
			Если ПараметрыПисьма.Свойство("АдресОтвета") Тогда
				СтрНаборЗаписей.УчетнаяЗаписьОтправки = ПараметрыПисьма.АдресОтвета;
			КонецЕсли;
			
			СтрНаборЗаписей.ТемаПисьма = ПараметрыПисьма.Тема;
			СтрНаборЗаписей.СсылкаНаОбъект = ДокСсылка;  
			СтрНаборЗаписей.Получатели = СтрПолучателиТекст; 
			СтрНаборЗаписей.Копии = СтрКопииТекст;
			СтрНаборЗаписей.ТелоПисьма = ТекстПисьма;
			СтрНаборЗаписей.Пользователь = ПараметрыСеанса.ТекущийПользователь; 
			СтрНаборЗаписей.ИмяФайла = СтруктураВложение.Представление;
			
			Запись =Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, СтруктураЗаписи);
			СтрНаборЗаписей.ПолучателиМассив = Запись.Закрыть(); 
			
			Если НЕ СтруктураЗаписиКопии.МасПолучатели = Неопределено Тогда
				
				Запись = Новый ЗаписьJSON;
				Запись.УстановитьСтроку();
				ЗаписатьJSON(Запись, СтруктураЗаписиКопии);
				СтрНаборЗаписей.КопииМассив = Запись.Закрыть();
				
			КонецЕсли;
			
		КонецЦикла;                                    
	Иначе
		
		СтрНаборЗаписей = НаборЗаписей.Добавить();
		СтрНаборЗаписей.УИДПисьма = КлючУникальности;
		
		Если ПараметрыПисьма.Свойство("АдресОтвета") Тогда
			СтрНаборЗаписей.УчетнаяЗаписьОтправки = ПараметрыПисьма.АдресОтвета;
		КонецЕсли;
		
		СтрНаборЗаписей.ТемаПисьма = ПараметрыПисьма.Тема;
		СтрНаборЗаписей.СсылкаНаОбъект = ДокСсылка;  
		СтрНаборЗаписей.Получатели = СтрПолучателиТекст;
		СтрНаборЗаписей.Копии = СтрКопииТекст;
		СтрНаборЗаписей.ТелоПисьма = ТекстПисьма;
		СтрНаборЗаписей.Пользователь = ПараметрыСеанса.ТекущийПользователь; 
		
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		ЗаписатьJSON(Запись, СтруктураЗаписи);
		СтрНаборЗаписей.ПолучателиМассив = Запись.Закрыть(); 
		
		Если НЕ СтруктураЗаписиКопии.МасПолучатели = Неопределено Тогда
			
			Запись = Новый ЗаписьJSON;
			Запись.УстановитьСтроку();
			ЗаписатьJSON(Запись, СтруктураЗаписиКопии);
			СтрНаборЗаписей.КопииМассив = Запись.Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры
//-- #1416 смарт: Фролов 28.08.2023

//++#1459 смарт: Лопато 13.09.2023 //При копировании контрагента не очищается история наименования  
Процедура ОчиститьРеквизитыОбъекта(Объект, ИменаРеквизитов = Неопределено, ИменаТабличныхЧастей = Неопределено, ИменаИсключений = Неопределено) Экспорт
	
	Реквизиты = Объект.Метаданные().Реквизиты;
	СтандартныеРеквизиты = Объект.Метаданные().СтандартныеРеквизиты; 
	ТабличныеЧасти = Объект.Метаданные().ТабличныеЧасти;
	ИмяНаименование = "Наименование";
	
	МассивРеквизитов = Новый Массив;
	Если ИменаРеквизитов <> Неопределено И ТипЗнч(ИменаРеквизитов) = Тип("Строка") Тогда
		МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаРеквизитов, ", ");
	Иначе	
		Для Каждого ЭлементКоллекции Из Реквизиты Цикл
			МассивРеквизитов.Добавить(ЭлементКоллекции.Имя);
		КонецЦикла;	
		Для Каждого ЭлементКоллекции Из СтандартныеРеквизиты Цикл
			Если ЭлементКоллекции.Имя = ИмяНаименование Тогда 
				МассивРеквизитов.Добавить(ЭлементКоллекции.Имя);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	МассивТабличныхЧастей = Новый Массив;
	Если ИменаТабличныхЧастей <> Неопределено И ТипЗнч(ИменаТабличныхЧастей) = Тип("Строка") Тогда
		МассивТабличныхЧастей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаТабличныхЧастей, ", ");
	Иначе	
		Для Каждого ЭлементКоллекции Из ТабличныеЧасти Цикл
			МассивТабличныхЧастей.Добавить(ЭлементКоллекции.Имя);
		КонецЦикла;	
	КонецЕсли;	
	
	МассивИсключений = Новый Массив;
	Если ИменаИсключений <> Неопределено И ТипЗнч(ИменаИсключений) = Тип("Строка") Тогда
		МассивИсключений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаИсключений, ", ");
	КонецЕсли;	
	
	Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
		
		Если МассивИсключений.Найти(ИмяРеквизита) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Реквизиты.Найти(ИмяРеквизита) <> Неопределено ИЛИ ИмяРеквизита = ИмяНаименование)
			И ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда
			
			Объект[ИмяРеквизита] = Неопределено;

		КонецЕсли;
			
	КонецЦикла;
			
	Для Каждого ИмяТабличнойЧасти Из МассивТабличныхЧастей Цикл
		
		Если МассивИсключений.Найти(ИмяТабличнойЧасти) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТабличныеЧасти.Найти(ИмяТабличнойЧасти) <> Неопределено
			И Объект[ИмяТабличнойЧасти].Количество() > 0 Тогда
			
			Объект[ИмяТабличнойЧасти].Очистить();

		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры //--#1459 смарт: Лопато 13.09.2023

//++#1463 смарт: Лопато 20.09.2023 //Изменить выборку расчета бонусов по подразделению заказа.  
Функция смартПолучитьЗначениеСвойстваОффлайнЗаказ(Заказ) Экспорт
	
	ЗначСвойства = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|    ДополнительныеСведения.Значение КАК ЗначениеСв
	|ИЗ
	|    РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|    ДополнительныеСведения.Свойство.Наименование Подобно &ИмяСвойства
	|   И ДополнительныеСведения.Объект=&ОбъектЗаказ";
	
	Запрос.УстановитьПараметр("ОбъектЗаказ", Заказ.Ссылка);
	Запрос.УстановитьПараметр("ИмяСвойства", "%Оффлайн%заказ%");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаРезультата = РезультатЗапроса.Выбрать();
	
	Если ВыборкаРезультата.Следующий() Тогда
		ЗначСвойства = ВыборкаРезультата.ЗначениеСв;
	КонецЕсли;
	
	Возврат ЗначСвойства;
	
КонецФункции //--#1463 смарт: Лопато 20.09.2023

//++ #Б-5936 смарт: Фролов 06.03.2026 //Ошибка. Доработать механизм перераспределения лидов.
Функция ВернутьКонтрольныеДатуВремя(Менеджер, Квалификация) Экспорт
	
	ВремяРеакцииОбщее = Справочники.смартПредопределенныеЗначения.Настройки.КонтрольныйСрокОбработкиЛида;
	
	ВремяПоГринвичу = Менеджер.Подразделение.CRM_Офис.CRM_ВремяПоГринвичу_GMT;
	ПриведеннаяТекущаяДата = ТекущаяДата() + (ВремяПоГринвичу - 3) * 3600;
	
	Если ДатаЯвляетсяРабочей(ТекущаяДата()) ТОгда
		
		Если НачалоДня(ТекущаяДата()) + 3600 * 17 >= ПриведеннаяТекущаяДата Тогда //Определяем не закончился ли рабочий день
			//Успеваем сегодня
			Если НачалоДня(ТекущаяДата()) + 3600 * 9 >= ПриведеннаяТекущаяДата ТОгда
				Возврат НачалоДня(ТекущаяДата()) + 3600 * 9 + ?(Квалификация.ВремяРеакции = 0, ВремяРеакцииОбщее, Квалификация.ВремяРеакции * 3600);
			Иначе	
				Возврат ПриведеннаяТекущаяДата + ?(Квалификация.ВремяРеакции = 0, ВремяРеакцииОбщее, Квалификация.ВремяРеакции * 3600);
			КонецЕсли;
			
		Иначе
			//Переносим на следующий рабочий день
			СледующийРабочийДень = ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПриведеннаяТекущаяДата, 1);
			КонтрольнаяДата = СледующийРабочийДень + 3600 * 9 - (ВремяПоГринвичу - 3) * 3600 + ?(Квалификация.ВремяРеакции = 0, ВремяРеакцииОбщее, Квалификация.ВремяРеакции * 3600);
			Возврат КонтрольнаяДата;
			
		КонецЕсли;
		
	Иначе
		//Переносим на следующий рабочий день
		СледующийРабочийДень = ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПриведеннаяТекущаяДата, 1);
		КонтрольнаяДата = СледующийРабочийДень + 3600 * 9 - (ВремяПоГринвичу - 3) *3600 + ?(Квалификация.ВремяРеакции = 0, ВремяРеакцииОбщее, Квалификация.ВремяРеакции * 3600);
		Возврат КонтрольнаяДата;
		
	КонецЕсли;
	
КонецФункции

//++#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)
// Добавил область
#Область Мимаки

//++#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)
// Выполняет проверку объекта (документа) на соблюдения условий по производютелю Мимаки
// Параметры:
//  Объект  - ЛюбойОбъект - объект (документ), который следует анализировать.
//			- Форма - форма клиентского приложения, содержащая объект (документ)
//
// Возвращаемое значение:
//  Производитель Мимаки - СправочникСсылка.Производители.
//                 		   Если производитель Мимаки не найден, будет возвращена пустая ссылка.
Функция Мимаки_УсловияОбъектаВыполнены(Объект) Экспорт
	
	//++ #1838 смарт: Ермаков 03.06.2024 / Изменить условие обязательного заполнения отчета
	МассивПроизводителей = 
		ПолучитьСмартПредопределенноеЗначение(
			Справочники.смартПредопределенныеЗначения.ПроизводительМимаки, Истина);
			
	Если Не МассивПроизводителей.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;	
	//-- #1838 смарт: Ермаков 03.06.2024
	
	Если ТипЗнч(Объект) = Тип("ДокументОбъект.смартЗаявкаНаГарантийныйРемонт")
		 Или ТипЗнч(Объект) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт")
		 Или ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт")
		Тогда
		
		// Оборудование - это реквизит объекта
		Возврат ЗначениеЗаполнено(Объект.Оборудование)
				 И Не МассивПроизводителей.Найти(Объект.Оборудование.Производитель) = Неопределено;
				 
	ИначеЕсли ТипЗнч(Объект) = Тип("ДокументОбъект.смартЗаявкаНаПускоНаладку")
		 Или ТипЗнч(Объект) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку")
		 Или ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку")
		Тогда
		
		// Оборудование - это табличная часть объекта
		ОборудованиеВТаблицеНайдено = Ложь;
		Для Каждого СтрокаТаблицы Из Объект.Оборудование Цикл
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.Оборудование)
				 И Не МассивПроизводителей.Найти(СтрокаТаблицы.Оборудование.Производитель) = Неопределено
				Тогда
				
				ОборудованиеВТаблицеНайдено = Истина;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат ОборудованиеВТаблицеНайдено;
		
	КонецЕсли;
	
КонецФункции
//--#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)

#КонецОбласти
