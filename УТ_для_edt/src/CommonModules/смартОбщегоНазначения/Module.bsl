//++ #Б-6630 смарт: Фролов 13.05.2026 //Сделать механизм оповещений о новых Инцидентах.
Функция ПолучитьПользователейПоНастройкамОбОповещениях(ОбъектОповещения, Подразделение, ТипПродукта, ЭтапИнтереса = Неопределено) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи.смартОповещениеОбИнтересах
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ОбъектОповещения = ""Интересы""
	|				ТОГДА ВЫБОР
	|							КОГДА &Новые
	|								ТОГДА Новые
	|						КОНЕЦ
	|						ИЛИ ВЫБОР
	|							КОГДА &Квалификация
	|								ТОГДА Квалификация
	|						КОНЕЦ
	|						ИЛИ ВЫБОР
	|							КОГДА &Завершенные
	|								ТОГДА Завершенные
	|						КОНЕЦ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Оборудование
	|				ТОГДА Оборудование
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Запчасти
	|				ТОГДА Запчасти
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &РасходныеМатериалы
	|				ТОГДА РасходныеМатериалы
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &Прочее
	|				ТОГДА Прочее
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ОбъектОповещения = &ОбъектОповещения
	|	И (Подразделение = &Подразделение
	|			ИЛИ Подразделение = ""Все подразделения"")");
	Запрос.УстановитьПараметр("ОбъектОповещения", ОбъектОповещения);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Если ТипПродукта = Справочники.смартТипыПродуктов.Оборудование Тогда
		Запрос.УстановитьПараметр("Оборудование", Истина);
	Иначе
		Запрос.УстановитьПараметр("Оборудование", Ложь);
	КонецЕсли;
	
	Если ТипПродукта = Справочники.смартТипыПродуктов.Запчасти Тогда
		Запрос.УстановитьПараметр("Запчасти", Истина);
	Иначе
		Запрос.УстановитьПараметр("Запчасти", Ложь);
	КонецЕсли;	
	
	Если ТипПродукта = Справочники.смартТипыПродуктов.Расходка Тогда
		Запрос.УстановитьПараметр("РасходныеМатериалы", Истина);
	Иначе
		Запрос.УстановитьПараметр("РасходныеМатериалы", Ложь);
	КонецЕсли;	
	
	Если ТипПродукта = Справочники.смартТипыПродуктов.Прочее
		ИЛИ ТипПродукта = Справочники.смартТипыПродуктов.Неопределено Тогда
		Запрос.УстановитьПараметр("Прочее", Истина);
	Иначе
		Запрос.УстановитьПараметр("Прочее", Ложь);
	КонецЕсли;
	
	Если ЭтапИнтереса = "Новые" Тогда
		Запрос.УстановитьПараметр("Новые", Истина);
	Иначе
		Запрос.УстановитьПараметр("Новые", Ложь);
	КонецЕсли;

	Если ЭтапИнтереса = "Квалификация" Тогда
		Запрос.УстановитьПараметр("Квалификация", Истина);
	Иначе
		Запрос.УстановитьПараметр("Квалификация", Ложь);
	КонецЕсли;

	Если ЭтапИнтереса = "Завершенные" Тогда
		Запрос.УстановитьПараметр("Завершенные", Истина);
	Иначе
		Запрос.УстановитьПараметр("Завершенные", Ложь);
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;	
	
КонецФункции //-- #Б-6630 смарт: Фролов 13.05.2026	

