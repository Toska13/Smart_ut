		//ДатаСрокаДействия = смартСервер.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ДанныеПечати.Дата, 1);
		//++#1311 смарт: Лопато 13.02.2023 //Рефакторинг. Перенесено из расширения (отмена &Вместо)  
		ДатаСрокаДействия = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ЗаказДата, 0);
		//ДатаСрокаДействия = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ДанныеПечати.Дата, 1);
		//--#1311 смарт: Лопато 13.02.2023
		//-- смарт:ММ 05.04.2021
		// Фролов -
	КонецЕсли;
	
	Возврат ДатаСрокаДействия;
	
КонецФункции //--#1311 смарт: Лопато 10.02.2023	

