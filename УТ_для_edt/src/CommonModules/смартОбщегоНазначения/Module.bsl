//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
Процедура ОбновитьПредставлениеЗаявокНаГарантийныйРемонт(ОбъектТовары) Экспорт

	МассивЗаявок = ОбъектТовары.Выгрузить(, "смартНомерЗаявкиНаГарантийныйРемонтСсылка").ВыгрузитьКолонку("смартНомерЗаявкиНаГарантийныйРемонтСсылка");
	
	СоответствиеЗаявок = СоответствияПредставленийЗаявокНаГарантийныйРемонт(МассивЗаявок);
	
	Для Каждого СтрокаТовары Из ОбъектТовары Цикл
		
		СтрокаТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление = СоответствиеЗаявок[СтрокаТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка];
		
	КонецЦикла;	

КонецПроцедуры //-- #Б-1434 смарт: Лопато 22.11.2024

//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
Функция СоответствияПредставленийЗаявокНаГарантийныйРемонт(МассивЗаявок) Экспорт

	СоответствиеЗаявок = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Ссылка,
		|	Номер КАК Номер,
		|	Дата КАК Дата
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт
		|ГДЕ
		|	Ссылка В(&МассивЗаявок)";
	
	Запрос.УстановитьПараметр("МассивЗаявок", МассивЗаявок);

	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СоответствиеЗаявок.Вставить(Выборка.Ссылка,	СтрШаблон("%1 от %2", 
															  СокрЛП(Выборка.Номер), 
															  Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")));
		
	КонецЦикла;
	
	Возврат СоответствиеЗаявок;

КонецФункции //-- #Б-1434 смарт: Лопато 22.11.2024

