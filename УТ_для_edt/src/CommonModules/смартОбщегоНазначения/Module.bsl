//++#1605 смарт: Лопато 29.01.2024 //Доработки по интернет-магазину
Процедура смартЗаполнитьФИОКонтактногоЛицаПартнера(КонтактноеЛицоОбъект, Перезаполнять = Ложь) Экспорт

	КонтактноеЛицоНаименование = СокрЛП(КонтактноеЛицоОбъект.Наименование);
	
	Если ЗначениеЗаполнено(КонтактноеЛицоНаименование) Тогда
		
		Если Перезаполнять
			ИЛИ (НЕ ЗначениеЗаполнено(КонтактноеЛицоОбъект.CRM_Имя)
				 И НЕ ЗначениеЗаполнено(КонтактноеЛицоОбъект.CRM_Фамилия) 
				 И НЕ ЗначениеЗаполнено(КонтактноеЛицоОбъект.CRM_Отчество)) Тогда
			   
			//Определеление фамилии, имени, отчества
			СтруктураФИО = Новый Структура("Фамилия, Имя, Отчество");

			ЧастиИмени = СтрРазделить(КонтактноеЛицоНаименование, " ", Ложь);
			
			Если ЧастиИмени.Количество() = 1 Тогда

				СтруктураФИО.Имя = ЧастиИмени[0];

			Иначе

				Если ЧастиИмени.Количество() >= 2 Тогда
					
					СтруктураФИО.Фамилия = ЧастиИмени[0];
					СтруктураФИО.Имя = ЧастиИмени[1];
					
				КонецЕсли;
				
				Если ЧастиИмени.Количество() >= 3 Тогда
					
					СтруктураФИО.Отчество = ЧастиИмени[2];
					
				КонецЕсли;

				Если ЧастиИмени.Количество() > 3 Тогда
					
					ДополнительныеЧастиОтчества = Новый Массив;
					
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'оглы'"));
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'улы'"));
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'уулу'"));
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'кызы'"));
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'гызы'"));
					ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'угли'"));
					
					Если ДополнительныеЧастиОтчества.Найти(НРег(ЧастиИмени[3])) <> Неопределено Тогда
						
						СтруктураФИО.Отчество = СтруктураФИО.Отчество + " " + ЧастиИмени[3];
						
					КонецЕсли;
					
				КонецЕсли;

			КонецЕсли;
			
			КонтактноеЛицоОбъект.CRM_Фамилия  = СтруктураФИО.Фамилия;			
			КонтактноеЛицоОбъект.CRM_Имя 	  = СтруктураФИО.Имя;
			КонтактноеЛицоОбъект.CRM_Отчество = СтруктураФИО.Отчество;
			
			//Определение пола по имени
			Если НЕ ЗначениеЗаполнено(КонтактноеЛицоОбъект.Пол) 
				И ЗначениеЗаполнено(КонтактноеЛицоОбъект.CRM_Имя) Тогда
				
				КонтактноеЛицоОбъект.Пол = CRM_КлиентыСервер.ОпределитьПол(КонтактноеЛицоОбъект.CRM_Имя);
				
			КонецЕсли;

		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры //--#1605 смарт: Лопато 29.01.2024

//++#1936 смарт: Лопато 29.07.2024 //Управление запретом изменять основного менеджера клиента  
// Определяет, был ли исходящий звонок от менеджера партнеру за определенный период в прошлое от указанной даты
//
// Параметры:
//  Ответственный - менеджер для которого выполняется поиск звонков.
//  Партнер 	  - Партнер для которого выполняется поиск звонков.
//  Дата 		  - Дата, до которой производится поиск звонков за период.
//  Период - количество секунд, за которое в прошлом идет поиск звонков.
//  Длительность - ограничение минимальной длительности звока в секундах.
//
// Возвращаемое значение:
//  Булево - Если Истина, то звонок от менеджера партнеру был.
//
Функция смартБылЗвонокОтветственногоПартнеру(Ответственный, Партнер, Дата, Период, Длительность) Экспорт

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	Запрос.УстановитьПараметр("Партнер", 	   Партнер);
	Запрос.УстановитьПараметр("Дата", 		   Дата);
	Запрос.УстановитьПараметр("Период", 	   -Период);
	Запрос.УстановитьПараметр("Длительность",  Длительность);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ИЗ
	|	Документ.ТелефонныйЗвонок
	|ГДЕ
	|	НЕ ПометкаУдаления
	//|	И НЕ Входящий
	|	И Ответственный = &Ответственный
	|	И АбонентКонтакт = &Партнер 
	//|	И Дата >= ДОБАВИТЬКДАТЕ(&Дата, СЕКУНДА, &Период)
	|	И Дата >= &Дата
	|	И сфпДлительностьЗвонка >= &Длительность";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции //--#1936 смарт: Лопато 29.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
Функция ПолучитьСписокУсловийДопГарантииПоЗаказу(ТаблицаТоваров, ЗаказКлиента, Валюта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Валюта", Валюта.Наименование);
	Запрос.УстановитьПараметр("ДатаАнализа", ТекущаяДата());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ЗаказКлиента КАК ЗаказКлиента,
	|	ВЫРАЗИТЬ(ТаблицаТоваров.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.СуммаСНДС КАК СуммаСНДС,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТоварыЗаказа
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТоварыЗаказа.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика
	|ПОМЕСТИТЬ ХарактеристикиГарантии
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.СуммаСНДС КАК СуммаСНДС,
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) КАК СуммаОплаты
	|ПОМЕСТИТЬ ТоварыЗаказаСОплатой
	|ИЗ
	|	ТоварыЗаказа КАК ТоварыЗаказа
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ТоварыЗаказа.ЗаказКлиента = СостоянияЗаказовКлиентов.Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартОборудованиеЧернилаКлиентов.ОборудованиеКлиентов КАК ОборудованиеКлиентов,
	|	ТоварыЗаказа.НомерСтроки КАК НомерСтроки,
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.СуммаСНДС КАК Сумма
	|ПОМЕСТИТЬ ОборудованиеНоменклатура
	|ИЗ
	|	ТоварыЗаказаСОплатой КАК ТоварыЗаказа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартОборудованиеЧернилаКлиентов КАК смартОборудованиеЧернилаКлиентов
	|		ПО ТоварыЗаказа.Номенклатура = смартОборудованиеЧернилаКлиентов.Номенклатура
	|ГДЕ
	|	ТоварыЗаказа.СуммаОплаты = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборудованиеНоменклатура.Сумма * УсловияДополнительнойГарантии.СтоимостьДопГарантииНаПервомЭтапе / 100 КАК Стоимость,
	|	ОборудованиеНоменклатура.НомерСтроки КАК НомерСтроки,
	|	ОборудованиеНоменклатура.Номенклатура КАК Номенклатура,
	|	УсловияДополнительнойГарантии.СрокГарантииНаГоловку КАК СрокГарантииНаГоловку,
	|	УсловияДополнительнойГарантии.СрокГарантииНаОборудование КАК СрокГарантииНаОборудование,
	|	ЕСТЬNULL(ХарактеристикиГарантии.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	&Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ХарактеристикиГарантии.Характеристика ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ГарантияДобавлена
	|ИЗ
	|	ОборудованиеНоменклатура КАК ОборудованиеНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартУсловияДополнительнойГарантии.СрезПоследних КАК УсловияДополнительнойГарантии
	|		ПО ОборудованиеНоменклатура.ОборудованиеКлиентов = УсловияДополнительнойГарантии.Оборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ХарактеристикиГарантии КАК ХарактеристикиГарантии
	|		ПО ((ВЫРАЗИТЬ(ОборудованиеНоменклатура.Номенклатура.Наименование КАК СТРОКА(100))) = (ВЫРАЗИТЬ(ЛЕВ(ХарактеристикиГарантии.Характеристика.Наименование, ДЛИНАСТРОКИ(ОборудованиеНоменклатура.Номенклатура.Наименование)) КАК СТРОКА(100))))
	|ГДЕ
	|	УсловияДополнительнойГарантии.ДатаНачалаДействияУсловий <= &ДатаАнализа
	|	И УсловияДополнительнойГарантии.ДатаОкончанияДействияУсловий >= &ДатаАнализа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОборудованиеНоменклатура.НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024 

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
Функция ПолучитьСписокУсловийДопГарантииПоИнтересу(ТаблицаТоваров, Интерес, Валюта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Интерес", Интерес);
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	Запрос.УстановитьПараметр("Валюта", Валюта.Наименование);
	Запрос.УстановитьПараметр("ДатаАнализа", ТекущаяДата()); 
	Запрос.УстановитьПараметр("ЭтоРТО", 
		ЗначениеЗаполнено(Интерес.ДокументОснование) И ТипЗнч(Интерес.ДокументОснование) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов"));
		
	Запрос.Текст =
	"ВЫБРАТЬ
	|	CRM_ЖурналДокументов.CRM_Интерес КАК Интерес,
	|	CRM_ЖурналДокументов.Объект КАК ЗаказКлиента
	|ПОМЕСТИТЬ ЗаказыИнтереса
	|ИЗ
	|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
	|ГДЕ
	|	CRM_ЖурналДокументов.ГлавнаяЗапись
	|	И CRM_ЖурналДокументов.CRM_Интерес = &Интерес
	|	И ТИПЗНАЧЕНИЯ(CRM_ЖурналДокументов.Объект) = ТИП(Документ.ЗаказКлиента)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыИнтереса.Интерес КАК Интерес,
	|	СУММА(СостоянияЗаказовКлиентов.СуммаОплаты) КАК СуммаОплаты
	|ПОМЕСТИТЬ ОплатаПоЗаказамИнтереса
	|ИЗ
	|	ЗаказыИнтереса КАК ЗаказыИнтереса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ЗаказыИнтереса.ЗаказКлиента = СостоянияЗаказовКлиентов.Заказ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыИнтереса.Интерес
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Интерес КАК Интерес,
	|	ИнтересТовары.Номенклатура КАК Номенклатура,
	|	ИнтересТовары.Характеристика КАК Характеристика,
	|	ИнтересТовары.СуммаСНДС КАК СуммаСНДС,
	|	ИнтересТовары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТоварыИнтереса
	|ИЗ
	|	&ТаблицаТоваров КАК ИнтересТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТоварыИнтереса.Характеристика КАК Справочник.ХарактеристикиНоменклатуры) КАК Характеристика
	|ПОМЕСТИТЬ ХарактеристикиГарантии
	|ИЗ
	|	ТоварыИнтереса КАК ТоварыИнтереса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТоварыИнтереса.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ТоварыИнтереса.СуммаСНДС КАК СуммаСНДС,
	|	ТоварыИнтереса.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ОплатаПоЗаказамИнтереса.СуммаОплаты, 0) КАК СуммаОплаты
	|ПОМЕСТИТЬ ТоварыИнтересаСОплатой
	|ИЗ
	|	ТоварыИнтереса КАК ТоварыИнтереса
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОплатаПоЗаказамИнтереса КАК ОплатаПоЗаказамИнтереса
	|		ПО ТоварыИнтереса.Интерес = ОплатаПоЗаказамИнтереса.Интерес
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартОборудованиеЧернилаКлиентов.ОборудованиеКлиентов КАК ОборудованиеКлиентов,
	|	ТоварыИнтересаСОплатой.Номенклатура КАК Номенклатура,
	|	ТоварыИнтересаСОплатой.СуммаСНДС КАК Сумма,
	|	ТоварыИнтересаСОплатой.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ОборудованиеНоменклатура
	|ИЗ
	|	ТоварыИнтересаСОплатой КАК ТоварыИнтересаСОплатой
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартОборудованиеЧернилаКлиентов КАК смартОборудованиеЧернилаКлиентов
	|		ПО ТоварыИнтересаСОплатой.Номенклатура = смартОборудованиеЧернилаКлиентов.Номенклатура
	|ГДЕ
	|	ТоварыИнтересаСОплатой.СуммаОплаты = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОборудованиеНоменклатура.Сумма * ВЫБОР
	|		КОГДА &ЭтоРТО
	|			ТОГДА УсловияДополнительнойГарантии.СтоимостьДопГарантииНаВторомЭтапе / 100
	|		ИНАЧЕ УсловияДополнительнойГарантии.СтоимостьДопГарантииНаПервомЭтапе / 100
	|	КОНЕЦ КАК Стоимость,
	|	ОборудованиеНоменклатура.Номенклатура КАК Номенклатура,
	|	ОборудованиеНоменклатура.НомерСтроки КАК НомерСтроки,
	|	УсловияДополнительнойГарантии.СрокГарантииНаГоловку КАК СрокГарантииНаГоловку,
	|	УсловияДополнительнойГарантии.СрокГарантииНаОборудование КАК СрокГарантииНаОборудование,
	|	ЕСТЬNULL(ХарактеристикиГарантии.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)) КАК Характеристика,
	|	&Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА ХарактеристикиГарантии.Характеристика ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ГарантияДобавлена
	|ИЗ
	|	ОборудованиеНоменклатура КАК ОборудованиеНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартУсловияДополнительнойГарантии.СрезПоследних КАК УсловияДополнительнойГарантии
	|		ПО ОборудованиеНоменклатура.ОборудованиеКлиентов = УсловияДополнительнойГарантии.Оборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ ХарактеристикиГарантии КАК ХарактеристикиГарантии
	|		ПО ((ВЫРАЗИТЬ(ОборудованиеНоменклатура.Номенклатура.Наименование КАК СТРОКА(100))) = (ВЫРАЗИТЬ(ЛЕВ(ХарактеристикиГарантии.Характеристика.Наименование, ДЛИНАСТРОКИ(ОборудованиеНоменклатура.Номенклатура.Наименование)) КАК СТРОКА(100))))
	|ГДЕ
	|	УсловияДополнительнойГарантии.ДатаНачалаДействияУсловий <= &ДатаАнализа
	|	И УсловияДополнительнойГарантии.ДатаОкончанияДействияУсловий >= &ДатаАнализа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОборудованиеНоменклатура.НомерСтроки";
	
	УстановитьПривилегированныйРежим(Истина);
	Возврат Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024 

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
Процедура ИзменитьВидимостьЗаголовокДополнительнойГарантии(Форма, ТаблицаТоваров, СсылкаНаДокумент, Валюта) Экспорт 
	
	Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ТаблицаУсловийДопГарантии = ПолучитьСписокУсловийДопГарантииПоЗаказу(ТаблицаТоваров, СсылкаНаДокумент, Валюта); 
		
	ИначеЕсли ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.CRM_Интерес") Тогда
		
		ТаблицаУсловийДопГарантии = ПолучитьСписокУсловийДопГарантииПоИнтересу(ТаблицаТоваров, СсылкаНаДокумент, Валюта); 
		
	Иначе
		
		Возврат;

	КонецЕсли;  
	
	Если ТаблицаУсловийДопГарантии.Количество() Тогда 
		
		Форма.Элементы.смартГруппаУсловияДопГарантии.Видимость = Истина; 
		
		//++ #Б-1160 смарт: Мосолов 18.10.2024 // Изменить Интерес РТО    
		Если ТипЗнч(СсылкаНаДокумент) = Тип("ДокументСсылка.CRM_Интерес") 
			И СсылкаНаДокумент.ТипУслуги = ПредопределенноеЗначение("Справочник.CRM_ТипУслуги.ПоставкаРегламентноеОбслуживаниеКлиентов") Тогда
			
		Форма.Элементы.смартТекстДопУсловий.Заголовок = СформироватьЗаголовокДополнительнойГарантииРТО(ТаблицаУсловийДопГарантии); 
		
		Иначе
		//-- #Б-1160 смарт: Мосолов 18.10.2024 
		
		Форма.Элементы.смартТекстДопУсловий.Заголовок = СформироватьЗаголовокДополнительнойГарантии(ТаблицаУсловийДопГарантии);
		
		//++ #Б-1160 смарт: Мосолов 18.10.2024 // Изменить Интерес РТО    
		КонецЕсли;
		//-- #Б-1160 смарт: Мосолов 18.10.2024 
		
	Иначе
		
		Форма.Элементы.смартГруппаУсловияДопГарантии.Видимость = Ложь;
		
	КонецЕсли;
		
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
Функция СформироватьЗаголовокДополнительнойГарантии(ТаблицаУсловийДопГарантии)
	
	МассивСтрок = Новый Массив;  
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("Предложите клиенту дополнительную гарантию!", 
			Новый Шрифт("Arial", 9, Истина), 
			Новый Цвет(0, 150, 70))); 
			
	МассивСтрок.Добавить(Символы.ПС);
	МассивСтрок.Добавить(Символы.ПС);

	Для Каждого СтрокаТаблицы Из ТаблицаУсловийДопГарантии Цикл
		
		УжеЕсть = СтрокаТаблицы.ГарантияДобавлена;
		ЦветТекста = ?(УжеЕсть, Новый Цвет(0, 150, 70), Новый Цвет(0, 0 , 0));
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока("► ", Новый Шрифт("Arial", 8), Новый Цвет(0, 150, 70)));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(СтрокаТаблицы.Номенклатура.Наименование, 
				Новый Шрифт("Arial", 8, Истина, , Истина), ЦветТекста));  
				
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" доп. гарантия на " 
			+ ?(СтрокаТаблицы.СрокГарантииНаГоловку = 0, "на оборудование на ", "на оборудование и головку на ")
			+ Строка(СтрокаТаблицы.СрокГарантииНаОборудование) 
			+ ?(УжеЕсть, " мес. добавлена в документ!"," мес. составит: "), 
				Новый Шрифт("Arial", 8), ЦветТекста));
				
		Если НЕ УжеЕсть Тогда
					
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Формат(СтрокаТаблицы.Стоимость, "ЧДЦ=2"), 
					, 
					ЦветаСтиля.ЦветГиперссылки, 
					, 
					Строка(СтрокаТаблицы.НомерСтроки) 
						+ ";" 
						+ Строка(СтрокаТаблицы.СрокГарантииНаОборудование) 
						+ ";"
						+ Формат(СтрокаТаблицы.Стоимость, "ЧДЦ=2")));  
					
			//++ #2059 смарт: Мосолов 19.09.2024 // Подсказка для документов Интерес и Заказ клиента при первоначальной продажи Доп. гарантии 
			//МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + СтрокаТаблицы.Валюта + Символы.ПС, Новый Шрифт("Arial", 8))); 
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" " + СтрокаТаблицы.Валюта, Новый Шрифт("Arial", 8))); 
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" ?", , ЦветаСтиля.ЦветГиперссылки, , " ?"));  
			МассивСтрок.Добавить(Символы.ПС);  
			//-- #2059 смарт: Мосолов 19.09.2024  
			
		Иначе
			
			МассивСтрок.Добавить(Символы.ПС);  
		
		КонецЕсли;
		
		МассивСтрок.Добавить(Символы.ПС);  
		
	КонецЦикла;
	
	Возврат Новый ФорматированнаяСтрока(МассивСтрок); 

КонецФункции //-- #1944 смарт: Мосолов 26.07.2024

//++ #Б-1160 смарт: Мосолов 18.10.2024 // Изменить Интерес РТО    
Функция СформироватьЗаголовокДополнительнойГарантииРТО(ТаблицаУсловийДопГарантии)
	
	ТаблицаУсловийДопГарантии.Свернуть("СрокГарантииНаОборудование, Валюта", "Стоимость");
	СуммаГарантии = ТаблицаУсловийДопГарантии.Итог("Стоимость"); 
	
	МассивСтрок = Новый Массив;  
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("Предложите клиенту дополнительную гарантию", 
		Новый Шрифт("Arial", 9, Истина), 
		Новый Цвет(0, 150, 70))); 
			
	МассивСтрок.Добавить(Символы.ПС);
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("На данное оборудование распространяется услуга Дополнительная гарантия", 
			Новый Шрифт("Arial", 9, Ложь))); 
			
	Для Каждого СтрокаТаблицы Из ТаблицаУсловийДопГарантии Цикл
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(" на " 
			+ Строка(СтрокаТаблицы.СрокГарантииНаОборудование) 
			+ " месяцев, в размере "
			+ Формат(СтрокаТаблицы.Стоимость, "ЧДЦ=2")
			+ СтрокаТаблицы.Валюта,
				Новый Шрифт("Arial", 9, Ложь))); 
			
	КонецЦикла;
		
	МассивСтрок.Добавить(Символы.ПС);
	МассивСтрок.Добавить(Новый ФорматированнаяСтрока("При соответсвии оборудования техническим критериям, услуга будет доступна для предложения клиенту.
		|Для оценки необходим выезд инженера в рамках РТО.",
			Новый Шрифт("Arial", 9, Ложь))); 
	
	Возврат Новый ФорматированнаяСтрока(МассивСтрок); 

КонецФункции //-- #Б-1160 смарт: Мосолов 18.10.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
Процедура СоздатьУстановкуЦенДляДопГарантии(Номенклатура, Характеристика, Цена, Дата) Экспорт

	УстановитьПривилегированныйРежим(Истина); 
	
	УстановкаЦен = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	УстановкаЦен.Дата = НачалоДня(Дата);
	УстановкаЦен.Статус = Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	
	СтрокаЦен = УстановкаЦен.ВидыЦен.Добавить();
	СтрокаЦен.ВидЦены = Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяRUB");
	
	СтрокаТовара = УстановкаЦен.Товары.Добавить();
	СтрокаТовара.ВидЦены = Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяRUB");
	СтрокаТовара.Номенклатура = Номенклатура;
	СтрокаТовара.Характеристика = Характеристика;
	СтрокаТовара.Цена = 1;
	
	УстановкаЦен.Записать(РежимЗаписиДокумента.Проведение);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

