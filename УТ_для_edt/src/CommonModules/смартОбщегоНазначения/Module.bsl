Функция ПолучитьМассивСегментовПартнера(Партнер) Экспорт
	
	МассивСегментов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СегментыПартнеров.Ссылка КАК Сегмент,
	|	СегментыПартнеров.СпособФормирования КАК СпособФормирования
	|ИЗ
	|	Справочник.СегментыПартнеров КАК СегментыПартнеров
	|ГДЕ
	|	НЕ СегментыПартнеров.ЭтоГруппа
	|	И НЕ СегментыПартнеров.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если СегментыСервер.ВходитВСегмент(Партнер, Выборка.Сегмент,, Выборка.СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьДинамически) Тогда
			МассивСегментов.Добавить(Выборка.Сегмент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивСегментов;
	
КонецФункции

