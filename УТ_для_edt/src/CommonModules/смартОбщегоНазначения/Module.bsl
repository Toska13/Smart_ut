//++ #1984 смарт: Фролов 13.08.2024 //Запрет на привязку более одного заказа клиента к Интересу.
Функция ПроверитьНаличиеЗаказаПоИнтересу(ВыбранныйИнтерес) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	CRM_ЖурналДокументов.Объект КАК ЗаказКлиента
	|ИЗ
	|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
	|ГДЕ
	|	CRM_ЖурналДокументов.ГлавнаяЗапись
	|	И НЕ CRM_ЖурналДокументов.Объект.ПометкаУдаления
	|	И CRM_ЖурналДокументов.Объект ССЫЛКА Документ.ЗаказКлиента
	|	И CRM_ЖурналДокументов.CRM_Интерес = &Интерес");
	
	Запрос.УстановитьПараметр("Интерес", ВыбранныйИнтерес);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЗаказКлиента;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
