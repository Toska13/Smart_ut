//Функция ПолучитьФорматированныйТекст(ДанныеОтправки)
Функция ПолучитьФорматированныйТекст(ДанныеОтправки, ВыводитьПодписьНеТребуетОтвета = Истина,ПредупреждениеОЗакрытойЗавке=Ложь)
//-- смарт:ММ 28.07.2021	
	Док = Новый ФорматированныйДокумент;
	
	мЗаголовок = Док.Добавить("Уведомление.", ТипЭлементаФорматированногоДокумента.Текст);
	мЗаголовок.Шрифт = Новый Шрифт("Arial", 16, Истина);
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	
	КоличествоЭлементов = Док.Элементы[0].Элементы.Количество();
	
	Абзац = Док.Добавить(ДанныеОтправки.Заголовок, ТипЭлементаФорматированногоДокумента.Текст);
	
	Для Сч = КоличествоЭлементов + 1 По Док.Элементы[0].Элементы.Количество() Цикл 
		Если ТипЗнч(Док.Элементы[0].Элементы[Сч-1]) = Тип("ТекстФорматированногоДокумента") Тогда 
			Док.Элементы[0].Элементы[Сч-1].Шрифт = Новый Шрифт("Arial", 12);
		КонецЕсли;
	КонецЦикла;
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	
	//++ #1404 смарт: Фролов 27.07.2023 //контроль отслеживания поступлений и зависших запчастей по гарантии  
	Если ПредупреждениеОЗакрытойЗавке ТОгда
		мПодвал = Док.Добавить("Внимание! Заявка на гарантийный ремонт ЗАКРЫТА.", ТипЭлементаФорматированногоДокумента.Текст);
		мПодвал.Шрифт = Новый Шрифт("Arial", 14, Истина); 
		мПодвал.ЦветТекста=WEBЦвета.Красный;
		
		Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
		Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	КонецЕсли;	
	//-- #1404 смарт: Фролов 27.07.2023
	//++ смарт:ММ 572 28.07.2021
	Если ВыводитьПодписьНеТребуетОтвета Тогда
	//-- смарт:ММ 28.07.2021
	
	Подпись = Док.Добавить("Письмо создано роботом и не требует ответа.", ТипЭлементаФорматированногоДокумента.Текст);
	
	Подпись.Шрифт = Новый Шрифт("Arial", 8);
	
	//++ смарт:ММ 572 28.07.2021
	КонецЕсли;
	//-- смарт:ММ 28.07.2021
	
	Возврат Док;
	
КонецФункции //-- смарт:ММ 23.02.2020

// ++ 21.11.2020
Функция ПолучитьАдресРуководителяПредставительства(Представительство, АдресаДляОтправкиСтрокой = "") Экспорт 
		
	Если НЕ ЗначениеЗаполнено(Представительство) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ПользователиДляОтправки.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ПользователиДляОтправки.смартРабочаяПочта
	|	КОНЕЦ КАК Значение,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ ВТ_ВсеПриоритеты
	|ИЗ
	|	Справочник.Пользователи КАК ПользователиДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиДляОтправки.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
	|ГДЕ
	|	ПользователиДляОтправки.Ссылка = &смартРуководительСервисногоЦентра
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПользователиДляОтправки.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ПользователиДляОтправки.смартРабочаяПочта
	|	КОНЕЦ КАК Значение,
	|	2 КАК Приоритет
	|ИЗ
	|	Справочник.Пользователи КАК ПользователиДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиДляОтправки.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
	|ГДЕ
	|	ПользователиДляОтправки.ФизическоеЛицо = &ФизическоеЛицо
	|   И ПользователиДляОтправки.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|;
	|ВЫБРАТЬ
	|  МИНИМУМ(ВТ.Приоритет) КАК МинимальныйПриоритет
	|ПОМЕСТИТЬ ВТ_МинимальныйПриоритет
	|ИЗ
	|  ВТ_ВсеПриоритеты КАК ВТ
	|;
	|
	|ВЫБРАТЬ
	|  ВТ_ВсеПриоритеты.Значение
	|ИЗ 
	|	ВТ_ВсеПриоритеты КАК ВТ_ВсеПриоритеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МинимальныйПриоритет КАК ВТ_МинимальныйПриоритет
	|		ПО ВТ_ВсеПриоритеты.Приоритет = ВТ_МинимальныйПриоритет.МинимальныйПриоритет";
	
	Запрос.УстановитьПараметр("ПочтаПользователя", Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	Запрос.УстановитьПараметр("ФизическоеЛицо", Представительство.ТекущийРуководитель);
	Запрос.УстановитьПараметр("смартРуководительСервисногоЦентра", Представительство.смартРуководительСервисногоЦентра);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

//++ #1698 смарт: Фролов 28.03.2024 //Оповещение Маркетинга и Коммерции о результатах обработки интереса менеджером.
Функция смартПолучитьУчетнуюЗаписьЭППользователя(Пользователь) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CRM_УчетныеЗаписиЭлектроннойПочты.УчетнаяЗапись КАК УчетнаяЗапись
	|ИЗ
	|	РегистрСведений.CRM_УчетныеЗаписиЭлектроннойПочты КАК CRM_УчетныеЗаписиЭлектроннойПочты
	|ГДЕ
	|	CRM_УчетныеЗаписиЭлектроннойПочты.Пользователь = &Пользователь");
	Запрос.УстановитьПараметр("Пользователь",Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.УчетнаяЗапись;
	Иначе
		Возврат Справочники.УчетныеЗаписиЭлектроннойПочты.ПустаяСсылка();
	КонецЕсли;	
		
КонецФункции //-- #1698 смарт: Фролов 28.03.2024	

