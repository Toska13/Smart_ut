//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
Процедура СоздатьЭлементыПризнакаVIPКлиента(Форма, ЭтоВИП, ИмяПоляПартнер = "Партнер") Экспорт
	
	ЭлементПартнер = Форма.Элементы[ИмяПоляПартнер];
	ИмяКартинки = "ДобавитьВИзбранное";
	
	ГруппаВИП = смартФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(Форма, "смартПартнерВИП", ЭлементПартнер.Родитель, 3,,,, ЭлементПартнер);
	Форма.Элементы.Переместить(ЭлементПартнер, ГруппаВИП);
	
	ЭлементКартинка = смартФормированиеИнтерфейса.СздДекорацияКартинка(Форма, "смартПризнакВИП", ГруппаВИП, ИмяКартинки);
	ЭлементКартинка.Видимость = ЭтоВИП;
	ЭлементКартинка.Подсказка = "Это VIP клиент";
	ЭлементКартинка.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
	
КонецПроцедуры

//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
Процедура СоздатьЭлементыПризнакаVIPКлиентаНаФормеСписка(Форма, ИмяТаблицы, СтрокаЗаменыДляСоединения, СтрокаЗаменыДляПоля, ИмяСписка = "Список", ИмяПоляПартнер = "Партнер", ЭтоПоследнееПоле = Истина, ИмяКолонкиПеред = "СписокПартнер") Экспорт
	
	ТекстСоединения = СтрШаблон("		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПартнерыСегмента КАК ПартнерыСегментаВИП
							    |		ПО ПартнерыСегментаВИП.Сегмент = &СегментВИПКлиентов
							    |			И %1.%2 = ПартнерыСегментаВИП.Партнер", ИмяТаблицы, ИмяПоляПартнер);
	
	ТекстПоля = СтрШаблон("	%1НЕ(ПартнерыСегментаВИП.Сегмент ЕСТЬ NULL) КАК ЭтоВипКлиент%2",
							?(ЭтоПоследнееПоле, ",", ""),
							?(ЭтоПоследнееПоле, "", ","));
	
	ПутьКДанным = СтрШаблон("%1.ЭтоВипКлиент", ИмяСписка);
	
	Если НЕ Форма[ИмяСписка].ПроизвольныйЗапрос Тогда
		
		Форма[ИмяСписка].ПроизвольныйЗапрос = Истина;
		
		Форма[ИмяСписка].ТекстЗапроса = СтрШаблон("ВЫБРАТЬ * ИЗ %1 КАК %2", Форма[ИмяСписка].ОсновнаяТаблица, ИмяТаблицы);
		
	КонецЕсли;
	
	Форма[ИмяСписка].ТекстЗапроса = СтрЗаменить(Форма[ИмяСписка].ТекстЗапроса, СтрокаЗаменыДляСоединения, СтрШаблон("%1%2%3", СтрокаЗаменыДляСоединения, Символы.ПС, ТекстСоединения));
	Форма[ИмяСписка].ТекстЗапроса = СтрЗаменить(Форма[ИмяСписка].ТекстЗапроса, СтрокаЗаменыДляПоля, СтрШаблон("%1%2%3", СтрокаЗаменыДляПоля, Символы.ПС, ТекстПоля));
	
	Параметр = Форма[ИмяСписка].Параметры.Элементы.Найти("СегментВИПКлиентов");
	Параметр.Значение = Справочники.смартПредопределенныеЗначения.СегментВИППартнеров.Значение;
	Параметр.Использование = Истина;
	
	СвойстваЭлемента = Новый Структура("Вид,КартинкаЗначений", ВидПоляФормы.ПолеКартинки, БиблиотекаКартинок.ДобавитьВИзбранное);
	смартФормированиеИнтерфейса.СздПоле(Форма, "ЭтоВипКлиент", ИмяСписка, "VIP", 0, ПутьКДанным, СвойстваЭлемента,, ИмяКолонкиПеред);
	
КонецПроцедуры

//++ #Б4754 смарт: Шляпников 28.10.2025 / Справочник Договоры Контрагентов. Добавить новые реквизиты. 
Процедура СоздатьЭлементыНаличияФайловДляФормСпискаДоговоров(Форма) Экспорт
	
	ТекстЗамены = "Справочник.ДоговорыКонтрагентов КАК СправочникДоговорыКонтрагентов";
	ТекстВставки = "	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
				   |		ПО СправочникДоговорыКонтрагентов.Ссылка = НаличиеФайлов.ОбъектСФайлами";
	Форма.Список.ТекстЗапроса = СтрЗаменить(Форма.Список.ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
	
	ТекстЗамены = "СправочникДоговорыКонтрагентов.Ссылка,";
	ТекстВставки = "	ВЫБОР
				   |		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
				   |				ТОГДА 1
				   |			КОГДА НаличиеФайлов.ЕстьФайлы
				   |				ТОГДА 0
				   |			ИНАЧЕ 1
				   |		КОНЕЦ КАК ЕстьФайлы,";
	Форма.Список.ТекстЗапроса = СтрЗаменить(Форма.Список.ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
	
	Свойства = Новый Структура;
	Свойства.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	Свойства.Вставить("Вид", ВидПоляФормы.ПолеКартинки);
	Свойства.Вставить("КартинкаЗначений", БиблиотекаКартинок.Скрепка);
	Свойства.Вставить("КартинкаШапки", БиблиотекаКартинок.Скрепка);
	Свойства.Вставить("Подсказка", "Присоединенные файлы");
	смартФормированиеИнтерфейса.СздПоле(Форма, "ЕстьФайлы", "Список", "", 1, "Список.ЕстьФайлы", Свойства,, "СписокНомер");
	
КонецПроцедуры

//++ #Б-5002 смарт: Фролов 17.11.2025 //Ограничение количества планируемых взаимодействий на день.
Функция ПолучитьВзаимодействияПоОтветственному(ПлановаяДата, Ответственный) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	CRM_Интерес.Партнер КАК Партнер
	|ПОМЕСТИТЬ ПартнерыСИнтересами
	|ИЗ
	|	Документ.CRM_Интерес КАК CRM_Интерес
	|ГДЕ
	|	НЕ CRM_Интерес.ПометкаУдаления
	|	И НЕ CRM_Интерес.Завершен
	|	И НЕ CRM_Интерес.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|	И CRM_Интерес.Ответственный = &Ответственный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	CRM_Взаимодействие.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
	|ГДЕ
	|	НЕ CRM_Взаимодействие.ПометкаУдаления
	|	И НЕ CRM_Взаимодействие.Партнер В
	|				(ВЫБРАТЬ
	|					ПартнерыСИнтересами.Партнер
	|				ИЗ
	|					ПартнерыСИнтересами)
	|	И НЕ CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)
	|	И НЕ CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Отменено)
	|	И CRM_Взаимодействие.Ответственный = &Ответственный
	|	И CRM_Взаимодействие.ПлановаяДата МЕЖДУ &ДатаНачала И &ДатаОкончания");
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ПлановаяДата));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПлановаяДата));
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Количество();
	
КонецФункции //-- #Б-5002 смарт: Фролов 17.11.2025	

