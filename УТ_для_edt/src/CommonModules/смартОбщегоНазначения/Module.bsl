//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Функция смартТелефонияВыполнитьHTTPЗапрос(Знач ПараметрыЗвонка) Экспорт
	
	HTTPОтвет = Неопределено;

	HTTPЗапрос = смартТелефонияПодготовитьHTTPЗапрос(ПараметрыЗвонка);
	
	//++#1359 смарт: Лопато 28.08.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
	Если HTTPЗапрос = "" Тогда
		Возврат Неопределено;
	КонецЕсли;	
	//--#1359 смарт: Лопато 28.08.2023
	
	Попытка
		Соединение = Новый HTTPСоединение(ПараметрыЗвонка.Соединение, , , , , 60, ПараметрыЗвонка.ЗащищенноеСоединение);
		Если ПараметрыЗвонка.ИмяМетода = "ClickToCall" Тогда 
			//++#1359 смарт: Лопато 29.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			//--#1359 смарт: Лопато 29.09.2023
		ИначеЕсли ПараметрыЗвонка.ИмяМетода = "MakeCall" Тогда
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		//++#1359 смарт: Балашов 25.05.2023	
		ИначеЕсли ПараметрыЗвонка.ИмяМетода = "accounts" Тогда
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		ИначеЕсли ПараметрыЗвонка.ИмяМетода = "history" Тогда
			//++#1359 смарт: Лопато 06.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk) 
			Если ПараметрыЗвонка.ВерсияAPIМегафон = "V1" Тогда
				HTTPОтвет = Соединение.Получить(HTTPЗапрос);
			Иначе	
				HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
			КонецЕсли;	
			//--#1359 смарт: Лопато 06.09.2023		//--#1359 смарт: Балашов 25.05.2023	
		КонецЕсли;	
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Звонок через " + ПараметрыЗвонка.ИмяМетода + "'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если HTTPОтвет <> Неопределено Тогда
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Запрос ""%1"" не выполнен. Код состояния: %2.'"), ПараметрыЗвонка.ИмяМетода, HTTPОтвет.КодСостояния) + Символы.ПС
				+ HTTPОтвет.ПолучитьТелоКакСтроку();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Звонок через " + ПараметрыЗвонка.ИмяМетода + "'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			//++#1359 смарт: Лопато 30.08.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
			ОбщегоНазначения.СообщитьПользователю("Не удалось совершить звонок! " + ТекстОшибки);
			//--#1359 смарт: Лопато 30.08.2023
		КонецЕсли;
			
		Возврат HTTPОтвет.ПолучитьТелоКакСтроку();
		
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
