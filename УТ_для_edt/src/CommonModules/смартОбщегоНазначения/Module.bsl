//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартЗаполнитьОбеспечениеСериямиПоFEFO(Знач Объект, Форма, Операция, ДанныеЗаполнения, ПараметрыУказанияСерий) Экспорт
	
	//++#1547 смарт: Лопато 27.05.2024 //Ошибка при автоматической установке резерва
	Если Форма = Неопределено ИЛИ ПараметрыУказанияСерий = Неопределено Тогда
		Возврат ДанныеЗаполнения;
	КонецЕсли;	
	//--#1547 смарт: Лопато 27.05.2024
	
	ДанныеЗаполненияЭтоТаблицаЗначений = ТипЗнч(ДанныеЗаполнения) = Тип("ТаблицаЗначений");
	
	Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
		//++ #Б-1684 смарт: Лопато 20.01.2025 //Автоматическое заполнение серий чернил в Заказе клиента. Ошибка  
		ДанныеЗаполнения.Колонки.Добавить("Номенклатура");
		ДанныеЗаполнения.Колонки.Добавить("Характеристика");
		//-- #Б-1684 смарт: Лопато 20.01.2025
		ДанныеЗаполнения.Колонки.Добавить("Серия");
	КонецЕсли;	

	ДанныеЗаполненияИсходные = ОбщегоНазначения.СкопироватьРекурсивно(ДанныеЗаполнения);
	
	Для Каждого СтрокаДанныхЗаполнения Из ДанныеЗаполненияИсходные Цикл 
		
		СтрокаОбеспечения 		 = Неопределено;
		СтрокаОбеспеченияИндекс  = Неопределено;
	    КоличествоКРаспределению = 0;
	
		Если СтрокаДанныхЗаполнения.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить И СтрокаДанныхЗаполнения.Количество > 0 Тогда
			  
			СтрокаОбеспечения 		 = СтрокаДанныхЗаполнения;
			КоличествоКРаспределению = СтрокаДанныхЗаполнения.Количество;
			
		КонецЕсли;
			  
		Если СтрокаОбеспечения = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		Если Операция = "СтрокаТовары" Или Операция = "СтрокиТовары" Или Операция = "Заказ" Тогда
			СтрокаТовары = Объект.Товары.НайтиПоИдентификатору(СтрокаОбеспечения.Идентификатор);
		ИначеЕсли Операция = "ИндексыСтрок" Тогда
			СтрокаТовары = Объект.Товары[СтрокаОбеспечения.Идентификатор];
		КонецЕсли;

		Если НЕ смартДействуетОсобыйУчетСерий(СтрокаТовары.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовары.ВариантОбеспечения = СтрокаОбеспечения.ВариантОбеспечения;

		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);

		Если СтрокаТовары.СтатусУказанияСерий <> 0 Тогда
		
			Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				ПараметрыФормы = смартПараметрыВыбораОбеспеченияЗаказКлиента(Объект, Форма, СтрокаОбеспечения.Идентификатор);
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
				ПараметрыФормы = смартПараметрыВыбораОбеспеченияЗаказНаПеремещение(Объект, Форма, СтрокаОбеспечения.Идентификатор);
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
				ПараметрыФормы = смартПараметрыВыбораОбеспеченияЗаказНаСборку(Объект, Форма, СтрокаОбеспечения.Идентификатор);
			ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
				ПараметрыФормы = смартПараметрыВыбораОбеспеченияЗаказНаВнутреннееПотребление(Объект, Форма, СтрокаОбеспечения.Идентификатор);
			Иначе	
				Продолжить;
			КонецЕсли;	

			Операция = "СтрокаТовары";
			
			//++#Б-732 смарт: Лопато 14.10.2024 //Автоматическое заполнение серий чернил в заказах (ошибка)
			ОстаткиСерий = смартВыполнитьЗапросЗаполненияТаблицыОстатковСерий(Объект, ПараметрыУказанияСерий, СтрокаТовары, ПараметрыФормы, ДанныеЗаполнения);
			//--#Б-732 смарт: Лопато 14.10.2024
			
			Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
				МассивСтрокиОбеспечения = Новый Массив;
				МассивСтрокиОбеспечения.Добавить(СтрокаОбеспечения);
				ОбразецСтрокаОбеспечения = ДанныеЗаполненияИсходные.Скопировать(МассивСтрокиОбеспечения);	
			Иначе	
				ОбразецСтрокаОбеспечения = ОбщегоНазначения.СкопироватьРекурсивно(СтрокаОбеспечения);
			КонецЕсли;
			
			Для Каждого СтрокаНовыхДанныхЗаполнения Из ДанныеЗаполнения Цикл
				
				//++#Б-732 смарт: Лопато 14.10.2024 //Автоматическое заполнение серий чернил в заказах (ошибка)
				Если СтрокаНовыхДанныхЗаполнения.Идентификатор = СтрокаДанныхЗаполнения.Идентификатор
					И СтрокаНовыхДанныхЗаполнения.ВариантОбеспечения = СтрокаДанныхЗаполнения.ВариантОбеспечения Тогда
				//--#Б-732 смарт: Лопато 14.10.2024
					
					Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
						СтрокаОбеспеченияИндекс = ДанныеЗаполнения.Индекс(СтрокаНовыхДанныхЗаполнения);
					Иначе
						СтрокаОбеспеченияИндекс = ДанныеЗаполнения.Найти(СтрокаНовыхДанныхЗаполнения);
					КонецЕсли;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;	
			
			ТекущийИндекс = СтрокаОбеспеченияИндекс;
			
			Для Каждого СтрокаСерии Из ОстаткиСерий Цикл
				
				Если КоличествоКРаспределению <= 0 Тогда
					Прервать;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(СтрокаСерии.Серия) И СтрокаСерии.СвободныйОстаток > 0 Тогда
								
					КоличествоСерии = Мин(СтрокаСерии.СвободныйОстаток, КоличествоКРаспределению);
				
					Если ТекущийИндекс = СтрокаОбеспеченияИндекс Тогда
						
						ТекущаяСтрокаОбеспечения = ДанныеЗаполнения.Получить(ТекущийИндекс);
							
					Иначе

						Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
							ТекущаяСтрокаОбеспечения = ДанныеЗаполнения.Вставить(ТекущийИндекс);
							ЗаполнитьЗначенияСвойств(ТекущаяСтрокаОбеспечения, ОбразецСтрокаОбеспечения[0]);
						Иначе
							ТекущаяСтрокаОбеспечения = ОбщегоНазначения.СкопироватьРекурсивно(ОбразецСтрокаОбеспечения);
							ДанныеЗаполнения.Вставить(ТекущийИндекс, ТекущаяСтрокаОбеспечения);
						КонецЕсли;
						
					КонецЕсли;					
					
					//++ #Б-1684 смарт: Лопато 20.01.2025 //Автоматическое заполнение серий чернил в Заказе клиента. Ошибка  
					Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
						
						ТекущаяСтрокаОбеспечения.Номенклатура 	= СтрокаТовары.Номенклатура;
						ТекущаяСтрокаОбеспечения.Характеристика = СтрокаТовары.Характеристика;
						
					КонецЕсли;
					//-- #Б-1684 смарт: Лопато 20.01.2025
					
					ТекущаяСтрокаОбеспечения.Количество = КоличествоСерии;
					ТекущаяСтрокаОбеспечения.Серия 		= СтрокаСерии.Серия;
					
					КоличествоКРаспределению = КоличествоКРаспределению - КоличествоСерии;

					ТекущийИндекс = ТекущийИндекс + 1;
					
				КонецЕсли;

			КонецЦикла;	
			
			Если КоличествоКРаспределению > 0 И ДанныеЗаполнения.Количество() > 1 Тогда

				Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
					ТекущаяСтрокаОбеспечения = ДанныеЗаполнения.Вставить(ТекущийИндекс);
					ЗаполнитьЗначенияСвойств(ТекущаяСтрокаОбеспечения, ОбразецСтрокаОбеспечения[0]);
				Иначе
					ТекущаяСтрокаОбеспечения = ОбщегоНазначения.СкопироватьРекурсивно(ОбразецСтрокаОбеспечения);
					ДанныеЗаполнения.Вставить(ТекущийИндекс, ТекущаяСтрокаОбеспечения);
				КонецЕсли;

				ТекущаяСтрокаОбеспечения.Количество = КоличествоКРаспределению;
				
			КонецЕсли;	
			
		КонецЕсли;

	КонецЦикла;
	
	//++#1774 смарт: Лопато 29.05.2024 //Автоматическое заполнение серий чернил в заказах. Продолжение задачи 1547.
	Если (ТипЗнч(ДанныеЗаполнения) = Тип("ТаблицаЗначений") 
		  ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("Массив"))
		И ДанныеЗаполнения.Количество() > 1 Тогда
		  
		МассивСерий = Новый Массив;
		
		Для Каждого СтрДанныеЗаполнения Из ДанныеЗаполнения Цикл
			МассивСерий.Добавить(СтрДанныеЗаполнения.Серия);			
		КонецЦикла;	
		
		СвернутыйМассивСерий = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСерий);		
		
		Если МассивСерий.Количество() <> СвернутыйМассивСерий.Количество() Тогда
		
			Если ДанныеЗаполненияЭтоТаблицаЗначений Тогда
				
				ДанныеЗаполнения.Свернуть("Идентификатор, Склад, ВариантОбеспечения, ДатаОтгрузки, 
										  |Приоритет, ПриоритетТипаОбеспечения, СкладНаименование, Серия", 
										  "Количество, Отгружено");
				
			Иначе
				
				ТеблицаЗначенийДанныеЗаполнения = CRM_ОбменСMSOutlookСервер.МассивСтруктурВТаблицуЗначений(ДанныеЗаполнения);	

				ТеблицаЗначенийДанныеЗаполнения.Свернуть("Идентификатор, Склад, ВариантОбеспечения, ДатаОтгрузки, Серия",
														 "Количество, Отгружено");
				
				ДанныеЗаполнения = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТеблицаЗначенийДанныеЗаполнения);
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;	
	//--#1774 смарт: Лопато 29.05.2024
	
	Возврат ДанныеЗаполнения;
	
КонецФункции //--#1547 смарт: Лопато 20.11.2023	

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
//++#Б-732 смарт: Лопато 14.10.2024 //Автоматическое заполнение серий чернил в заказах (ошибка)
Функция смартВыполнитьЗапросЗаполненияТаблицыОстатковСерий(Объект, ПараметрыУказанияСерий, ТекСтрокаТовары, ПараметрыФормы, ДанныеЗаполнения)
//--#Б-732 смарт: Лопато 14.10.2024

	ТекущаяНоменклатура 	  = ТекСтрокаТовары.Номенклатура;
	ТекущаяХарактеристика 	  = ТекСтрокаТовары.Характеристика;
	ТекущийВидНоменклатуры 	  = ТекущаяНоменклатура.ВидНоменклатуры;
	ТекущийВариантОбеспечения = ТекСтрокаТовары.ВариантОбеспечения;
	
	Регистратор  = Объект.Ссылка;
	Распоряжение = Объект.Ссылка;
	Назначение 	 = Справочники.Назначения.ПустаяСсылка();

	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ТекущийСклад = ТекСтрокаТовары.Склад;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ТекущийСклад = Объект.СкладОтправитель;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
		ТекущийСклад = Объект.Склад;
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
		ТекущийСклад = Объект.Склад;
	КонецЕсли;
	
	ОстаткиСерий = Новый ТаблицаЗначений;
	ОстаткиСерий.Колонки.Добавить("Серия", 					Новый ОписаниеТипов("СправочникСсылка.СерииНоменклатуры"));
	ОстаткиСерий.Колонки.Добавить("СвободныйОстаток", 		Новый ОписаниеТипов("Число"));
	ОстаткиСерий.Колонки.Добавить("ГоденДо", 				Новый ОписаниеТипов("Дата"));
	ОстаткиСерий.Колонки.Добавить("Номер", 					Новый ОписаниеТипов("Строка"));
	ОстаткиСерий.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
	ОстаткиСерий.Колонки.Добавить("КоличествоУпаковок", 	Новый ОписаниеТипов("Число"));
	ОстаткиСерий.Колонки.Добавить("РежимОтображенияСерий", 	Новый ОписаниеТипов("Строка"));
	ОстаткиСерий.Колонки.Добавить("Номенклатура", 			Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ОстаткиСерий.Колонки.Добавить("Характеристика", 		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ОстаткиСерий.Колонки.Добавить("Склад", 					Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ОстаткиСерий.Колонки.Добавить("ВариантОбеспечения", 	Новый ОписаниеТипов("ПеречислениеСсылка.ВариантыОбеспечения"));
	ОстаткиСерий.Колонки.Добавить("СтрокаЗаказа", 			Новый ОписаниеТипов("Число"));
	ОстаткиСерий.Колонки.Добавить("Назначение", 			Новый ОписаниеТипов("СправочникСсылка.Назначения"));

	АдресТаблицыПодобраноРанее = ПараметрыФормы.АдресТаблицыПодобраноРанее;	
	
	ВариантПолучениеДанныхИзРегистров = "ЗаказНакладнаяСерииИзОстатка";
	
	ПараметрыЗапросаВрем = Новый Структура;
	ПараметрыЗапросаВрем.Вставить("Номенклатура", ТекущаяНоменклатура);
	ПараметрыЗапросаВрем.Вставить("Характеристика", ТекущаяХарактеристика);
	Если ЗначениеЗаполнено(Назначение) И ТекущийВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно Тогда
		ПараметрыЗапросаВрем.Вставить("ВсеСерии", Ложь);
	Иначе
		ПараметрыЗапросаВрем.Вставить("ВсеСерии", Истина);
	КонецЕсли;
	Если ТекущийВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно Тогда
		ПараметрыЗапросаВрем.Вставить("Назначение", Назначение);
	Иначе
		ПараметрыЗапросаВрем.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	КонецЕсли;
	ПараметрыЗапросаВрем.Вставить("Склад",        ТекущийСклад);
	ПараметрыЗапросаВрем.Вставить("Помещение",    Справочники.СкладскиеПомещения.ПустаяСсылка());
	ПараметрыЗапросаВрем.Вставить("Регистратор",  Регистратор);
	ПараметрыЗапросаВрем.Вставить("Распоряжение", Распоряжение);
	
	ПараметрыЗапросаОстаткаСерий = Новый ФиксированнаяСтруктура(ПараметрыЗапросаВрем);
	
	ТекстЗапроса = Обработки.ПодборСерийВДокументы.ТекстЗапросаФормированияТаблицыДанныеРегистров(ВариантПолучениеДанныхИзРегистров,
		ТекущийСклад);
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|";
	
	ТекстЗапроса = ТекстЗапроса + 
	"ВЫБРАТЬ
	|	ДанныеРегистров.Серия КАК Серия,
	//++#1774 смарт: Лопато 29.05.2024 //Автоматическое заполнение серий чернил в заказах. Продолжение задачи 1547.
	|	ВЫРАЗИТЬ(
	|		СТРЗАМЕНИТЬ(
	|			СТРЗАМЕНИТЬ(
	|				ВЫРАЗИТЬ(ДанныеРегистров.Серия КАК Справочник.СерииНоменклатуры).Номер, 
	|			""-"", """"),
	|		""."", """")
	|		КАК СТРОКА(1000))
	|	КАК Номер,
	//--#1774 смарт: Лопато 29.05.2024
	|	ВЫРАЗИТЬ(ДанныеРегистров.Серия КАК Справочник.СерииНоменклатуры).ГоденДо КАК ГоденДо,
	|	ДанныеРегистров.СвободныйОстаток КАК СвободныйОстаток
	|ПОМЕСТИТЬ ОстаткиСерий
	|ИЗ
	|	ДанныеРегистров КАК ДанныеРегистров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ТаблицаТоваров.Назначение КАК Назначение,
	|	ТаблицаТоваров.Склад КАК Склад,
	|	ТаблицаТоваров.Серия КАК Серия,
	|	ТаблицаТоваров.Количество
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Серия,
	|	СУММА(ТаблицаТоваров.Количество) КАК Количество
	|ПОМЕСТИТЬ ПодобранныеСерии
	|ИЗ
	|	ТаблицаТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.Номенклатура = &Номенклатура
	|	И ТаблицаТоваров.Характеристика = &Характеристика
	|	И (ТаблицаТоваров.Назначение = &Назначение
	|			ИЛИ Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
	|	И ТаблицаТоваров.Склад = &Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.Серия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиСерий.Серия,
	|	ОстаткиСерий.Номер,
	|	ОстаткиСерий.ГоденДо,
	|	ОстаткиСерий.СвободныйОстаток - ЕСТЬNULL(ПодобранныеСерии.Количество, 0) КАК СвободныйОстаток,
	|	ВЫБОР КОГДА ОстаткиСерий.Номер ЕСТЬ NULL ТОГДА 1 ИНАЧЕ 0 КОНЕЦ КАК ПриоритетИтог
	|ИЗ
	|	ОстаткиСерий КАК ОстаткиСерий
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПодобранныеСерии КАК ПодобранныеСерии
	|		ПО ОстаткиСерий.Серия = ПодобранныеСерии.Серия
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетИтог,
	|	ГоденДо,
	|	Номер";
		
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого Параметр Из ПараметрыЗапросаОстаткаСерий Цикл
		Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	ТаблицаТоваров = ОстаткиСерий.Скопировать().СкопироватьКолонки();
	Для Каждого Строка Из ПолучитьИзВременногоХранилища(АдресТаблицыПодобраноРанее) Цикл
		НоваяСтрока = ТаблицаТоваров.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	//++#Б-732 смарт: Лопато 14.10.2024 //Автоматическое заполнение серий чернил в заказах (ошибка)
	Для Каждого Строка Из ДанныеЗаполнения Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.Серия) Тогда
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ТаблицаТоваров.Добавить();

		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		//++ #Б-1684 смарт: Лопато 20.01.2025 //Автоматическое заполнение серий чернил в Заказе клиента. Ошибка  
		НоваяСтрока.Назначение = Назначение;
		//-- #Б-1684 смарт: Лопато 20.01.2025
		
	КонецЦикла;
	//--#Б-732 смарт: Лопато 14.10.2024
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
	
	СтруктураЗначенияПриоритетаПоСрокамГодностиСерий = смартПолучитьЗначенияПриоритетаПоСрокамГодностиСерий(Объект, ТекущийВидНоменклатуры);

	Если СтруктураЗначенияПриоритетаПоСрокамГодностиСерий.ПриоритетПоСрокам 
		И СтруктураЗначенияПриоритетаПоСрокамГодностиСерий.МинимальныйСрокГодностиВМесяцах <> 0 Тогда

		Запрос.УстановитьПараметр("ДатаПроверки", 					 ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("МинимальныйСрокГодностиВМесяцах", СтруктураЗначенияПриоритетаПоСрокамГодностиСерий.МинимальныйСрокГодностиВМесяцах);
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, 
		"ПО
		|	ПриоритетИтог,
		|	ГоденДо,",
		"ПО
		|	ПриоритетИтог,
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПроверки, ОстаткиСерий.ГоденДо, ДЕНЬ) / 30 >= &МинимальныйСрокГодностиВМесяцах
		|			ТОГДА ГоденДо
		|	КОНЕЦ ВОЗР,
		|	ВЫБОР
		|		КОГДА РАЗНОСТЬДАТ(&ДатаПроверки, ОстаткиСерий.ГоденДо, ДЕНЬ) / 30 < &МинимальныйСрокГодностиВМесяцах
		|			ТОГДА ГоденДо
		|	КОНЕЦ УБЫВ,");
		
	КонецЕсли;	
	
	ОстаткиСерий = Запрос.Выполнить().Выгрузить();
	
	//++#1774 смарт: Лопато 29.05.2024 //Автоматическое заполнение серий чернил в заказах. Продолжение задачи 1547.
	Если ОстаткиСерий.Количество() > 0 
		И ЗначениеЗаполнено(ТекущийВидНоменклатуры)
		И смартДействуетОсобыйУчетСерий(ТекущийВидНоменклатуры) Тогда
		
		//Запоминаем сортировку по FEFO
		Приоритет = 0;
		ТекущаяДатаГоденДо = ОстаткиСерий[0].ГоденДо;
		
		Для Каждого СтрокаОстаткиFEFO Из ОстаткиСерий Цикл
			
			Если ТекущаяДатаГоденДо <> СтрокаОстаткиFEFO.ГоденДо Тогда
				
				Приоритет = Приоритет + 1;
				ТекущаяДатаГоденДо = СтрокаОстаткиFEFO.ГоденДо;
				
			КонецЕсли;
			 
			СтрокаОстаткиFEFO.ПриоритетИтог = Приоритет; 
			
		КонецЦикла;	
		
		//Подготовка итоговой таблицы
		ОстаткиСерийFIFO = ОстаткиСерий.Скопировать();
		ОстаткиСерийFIFO.Колонки.Добавить("ДатаПрихода", Новый ОписаниеТипов("Дата"));
		ОстаткиСерийFIFO.Очистить();
		
		ОстаткиСерийFEFO = ОстаткиСерий.Скопировать();
		
		СерииFEFO = ОстаткиСерийFEFO.ВыгрузитьКолонку("Серия");

		ПустаяСерия = СерииFEFO.Найти(Справочники.СерииНоменклатуры.ПустаяСсылка());
		
		Если ПустаяСерия <> Неопределено Тогда
			СерииFEFO.Удалить(СерииFEFO.Найти(Справочники.СерииНоменклатуры.ПустаяСсылка()));
		КонецЕсли;	
		
		//Запрос по датам прихода и списаниям
		Запрос.Текст = ПолучитьЗапросПартийСерийДляFIFO();
	
		Запрос.УстановитьПараметр("Серия", СерииFEFO);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ТаблицаПриходаFIFO = РезультатЗапроса[0].Выгрузить();
		ТаблицаРасходаFIFO = РезультатЗапроса[1].Выгрузить();
		
		//Попытка развернуть каждую строку FEFO по FIFO
		Для Каждого СтрокаFEFO Из ОстаткиСерийFEFO Цикл
			
			Если ЗначениеЗаполнено(СтрокаFEFO.Номер) Тогда
				
				СерияFEFO = СтрокаFEFO.Серия;
				
				ОтборСерия = Новый Структура("Серия", СерияFEFO);
				
				СтрокиПриходаПоСерии = ТаблицаПриходаFIFO.НайтиСтроки(ОтборСерия); 
				СтрокиРасходаПоСерии = ТаблицаРасходаFIFO.НайтиСтроки(ОтборСерия); 
				
				ПриходВсего = 0;
				Для Каждого СтрокаПриходFIFO Из СтрокиПриходаПоСерии Цикл
					ПриходВсего = ПриходВсего + СтрокаПриходFIFO.Количество;	
				КонецЦикла;
				
				РасходВсего = 0;
				Если СтрокиРасходаПоСерии.Количество() > 0 Тогда
					РасходВсего = -СтрокиРасходаПоСерии[0].Количество;
				КонецЕсли;
				
				//Проверка остатков по FEFO и FIFO
				Если (ПриходВсего - РасходВсего) = СтрокаFEFO.СвободныйОстаток Тогда
					
					ВсегоТребуетсяРаспределить = ПриходВсего - РасходВсего;
					ОстатокРасхода 		  	   = РасходВсего;
					
					Для Каждого СтрокаПриходFIFO Из СтрокиПриходаПоСерии Цикл
						
						СписатьРасход = Мин(ОстатокРасхода, СтрокаПриходFIFO.Количество);
						
						ОстатокРасхода 				= ОстатокРасхода - СписатьРасход;
						СтрокаПриходFIFO.Количество = СтрокаПриходFIFO.Количество - СписатьРасход;
						
						Если СтрокаПриходFIFO.Количество = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						РаспределитьКоличество = Мин(ВсегоТребуетсяРаспределить, СтрокаПриходFIFO.Количество);
						
						НоваяСтрокаFIFO = ОстаткиСерийFIFO.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаFIFO, СтрокаFEFO);
						
						НоваяСтрокаFIFO.СвободныйОстаток = РаспределитьКоличество;
						НоваяСтрокаFIFO.ДатаПрихода 	 = СтрокаПриходFIFO.Период;
						
						ВсегоТребуетсяРаспределить = ВсегоТребуетсяРаспределить - РаспределитьКоличество;
					
					КонецЦикла;
					
				Иначе
					
					//Количество остатка не совпало, оставляем строку как есть
					НоваяСтрокаFIFO = ОстаткиСерийFIFO.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрокаFIFO, СтрокаFEFO);
					
				КонецЕсли;	

			Иначе
				
				//Строка итога переносится без изменения
				НоваяСтрокаFIFO = ОстаткиСерийFIFO.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрокаFIFO, СтрокаFEFO);
				
			КонецЕсли;	
				
		КонецЦикла;	
		
		ОстаткиСерийFIFO.Сортировать("ПриоритетИтог, ДатаПрихода, Номер");
		
		ОстаткиСерий = ОстаткиСерийFIFO.Скопировать();
		
	КонецЕсли;	
	//--#1774 смарт: Лопато 29.05.2024

	Возврат ОстаткиСерий;
	
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1774 смарт: Лопато 29.05.2024 //Автоматическое заполнение серий чернил в заказах. Продолжение задачи 1547.
Функция ПолучитьЗапросПартийСерийДляFIFO()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахПриход.Период КАК Период,
		|	ТоварыНаСкладахПриход.Регистратор КАК Регистратор,
		|	ТоварыНаСкладахПриход.Серия КАК Серия,
		|	ТоварыНаСкладахПриход.ВНаличииПриход КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , 
		|			Регистратор,
		|			Номенклатура = &Номенклатура
		|				И Характеристика = &Характеристика
		|				И (Назначение = &Назначение
		|					ИЛИ Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|						И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
		|				И Склад = &Склад
		|				И Серия В (&Серия)
		|				) КАК ТоварыНаСкладахПриход
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Серия КАК Серия,
		|	СУММА(ВложенныйЗапрос.СвободныйОстаток) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|	ТоварыНаСкладахПриход.Серия КАК Серия,
		|	-ТоварыНаСкладахПриход.ВНаличииРасход КАК СвободныйОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Обороты(, , ,
		|			Номенклатура = &Номенклатура
		|				И Характеристика = &Характеристика
		|				И (Назначение = &Назначение
		|					ИЛИ Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|						И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
		|				И Склад = &Склад
		|				И Серия В (&Серия)
		|				) КАК ТоварыНаСкладахПриход
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.Серия,
		|	-ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток - ТоварыКОтгрузкеОстатки.ВРезервеОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
		|			,
		|			Номенклатура = &Номенклатура
		|				И Склад = &Склад
		|				И Характеристика = &Характеристика
		|				И (Назначение = &Назначение
		|					ИЛИ Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|						И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
		|				И Серия В (&Серия)) КАК ТоварыКОтгрузкеОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТоварыНаСкладах.Серия,
		|	ВЫБОР
		|		КОГДА ТоварыНаСкладах.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА -ТоварыНаСкладах.ВНаличии + ТоварыНаСкладах.КОтгрузке
		|		ИНАЧЕ ТоварыНаСкладах.ВНаличии - ТоварыНаСкладах.КОтгрузке
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах КАК ТоварыНаСкладах
		|ГДЕ
		|	ТоварыНаСкладах.Номенклатура = &Номенклатура
		|	И ТоварыНаСкладах.Характеристика = &Характеристика
		|	И (ТоварыНаСкладах.Назначение = &Назначение
		|			ИЛИ ТоварыНаСкладах.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|				И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
		|	И ТоварыНаСкладах.Склад = &Склад
		|	И ТоварыНаСкладах.Регистратор = &Регистратор
		|	И Серия В (&Серия)
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РезервыСерий.Серия,
		|	ВЫБОР
		|		КОГДА РезервыСерий.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
		|			ТОГДА РезервыСерий.КОтгрузке + РезервыСерий.ВРезерве
		|		ИНАЧЕ -РезервыСерий.КОтгрузке - РезервыСерий.ВРезерве
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке КАК РезервыСерий
		|ГДЕ
		|	РезервыСерий.Номенклатура = &Номенклатура
		|	И РезервыСерий.Характеристика = &Характеристика
		|	И (РезервыСерий.Назначение = &Назначение
		|			ИЛИ РезервыСерий.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
		|				И НЕ ВЫРАЗИТЬ(&Назначение КАК Справочник.Назначения).ДвиженияПоСкладскимРегистрам)
		|	И РезервыСерий.Склад = &Склад
		|	И РезервыСерий.Регистратор = &Регистратор
		|	И РезервыСерий.Серия В (&Серия)) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Серия
		|
		|УПОРЯДОЧИТЬ ПО
		|	Серия
		|АВТОУПОРЯДОЧИВАНИЕ";

	Возврат ТекстЗапроса;
	
КонецФункции //--#1774 смарт: Лопато 29.05.2024

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПолучитьЗначенияПриоритетаПоСрокамГодностиСерий(Объект, ВидНоменклатуры) Экспорт
	
	ПриоритетПоСрокам = Ложь;
	МинимальныйСрокГодностиВМесяцах = 0;
	
	Если ЗначениеЗаполнено(ВидНоменклатуры)	И смартДействуетОсобыйУчетСерий(ВидНоменклатуры) Тогда
	
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			
			Если ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				ПартнерЗаказа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект, "Партнер", Истина);
			ИначеЕсли ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
				ПартнерЗаказа = Объект.Партнер;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПартнерЗаказа) Тогда

				ПартнерДилер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПартнерЗаказа, "Дилер", Истина);
				
				Если ПартнерДилер = Истина Тогда
					
					ПриоритетПоСрокам = Истина;
				    МинимальныйСрокГодностиВМесяцах = смартПолучитьМинимальныйСрокГодностиВМесяцах(ВидНоменклатуры, "ОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры", "К2");
					
				КонецЕсли;
				
			КонецЕсли;	
			
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
			
			Если ЗначениеЗаполнено(Объект.СкладОтправитель) И ЗначениеЗаполнено(Объект.СкладПолучатель) Тогда
				
				БизнесРегионОтправитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СкладОтправитель, "БизнесРегион", Истина);
				БизнесРегионПолучатель  = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СкладПолучатель, "БизнесРегион", Истина);
				
				БизнесРегионМосква = Справочники.смартПредопределенныеЗначения.БизнесРегионМосква.Значение;
				
				Если ЗначениеЗаполнено(БизнесРегионПолучатель)
					И ЗначениеЗаполнено(БизнесРегионМосква)
					И БизнесРегионПолучатель <> БизнесРегионМосква
					И БизнесРегионПолучатель <> БизнесРегионОтправитель Тогда
				
					ПриоритетПоСрокам = Истина;
				    МинимальныйСрокГодностиВМесяцах = смартПолучитьМинимальныйСрокГодностиВМесяцах(ВидНоменклатуры, "ОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры", "К3");

				КонецЕсли;	
					
			КонецЕсли;	
			
		КонецЕсли;

	КонецЕсли;
		
	Результат = Новый Структура();
	Результат.Вставить("ПриоритетПоСрокам", 			  ПриоритетПоСрокам);
	Результат.Вставить("МинимальныйСрокГодностиВМесяцах", МинимальныйСрокГодностиВМесяцах);
	
	Возврат Результат;
	
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПолучитьМинимальныйСрокГодностиВМесяцах(ВидНоменклатуры, НаименованиеПредопределеннойНастройки, Колонка)
	
	МинимальныйСрокГодностиВМесяцах = 0;
	
	МассивСтруктурМинимальныйСрокГодностиВМесяцах = смартПолучитьПредопределенноеЗначениеТЧСписокЗначений(НаименованиеПредопределеннойНастройки);
	
	Для Каждого СтруктураМинимальныйСрокГодностиВМесяцах Из МассивСтруктурМинимальныйСрокГодностиВМесяцах Цикл
		
		Если СтруктураМинимальныйСрокГодностиВМесяцах.К1 = ВидНоменклатуры 
			И ТипЗнч(СтруктураМинимальныйСрокГодностиВМесяцах[Колонка]) = Тип("Число") Тогда
	
			МинимальныйСрокГодностиВМесяцах = СтруктураМинимальныйСрокГодностиВМесяцах[Колонка];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат МинимальныйСрокГодностиВМесяцах;
	
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПараметрыВыбораОбеспеченияЗаказНаПеремещение(Объект, Форма, ИдентификаторСтроки)
	
	ПутиКДанным = Новый Соответствие();
	ПутиКДанным.Вставить("ДатаОтгрузки", "НачалоОтгрузки");
	ПутиКДанным.Вставить("Склад", "СкладОтправитель");
	Если Объект.ОбосабливатьПоНазначениюЗаказа Тогда
		Справочники.Назначения.ЗаполнитьНазначениеОбеспечения(Объект.Товары, Объект.Назначение);
		ПутиКДанным.Вставить("Назначение", "НазначениеОбеспечения");
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("МенеджерРегистра", РегистрыНакопления.ЗаказыНаПеремещение);
	
	Результат = ОбеспечениеСервер.ПараметрыВыбораОбеспечения(
		ИдентификаторСтроки,
		Объект,
		Объект.Товары,
		ПутиКДанным,
		ПараметрыЗаполнения);
	
	ОбеспечениеСервер.ДобавитьСвойствоАдресТаблицыПодобраноРанее(Результат, Форма.УникальныйИдентификатор);
	
	Возврат Результат;

КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПараметрыВыбораОбеспеченияЗаказКлиента(Объект, Форма, ИдентификаторСтроки)
	
	ПутиКДанным = Новый Соответствие();
	ПутиКДанным.Вставить("ДатаОтгрузкиРабот", "ДатаОтгрузки");

	ПараметрыЗаполнения = Новый Структура("СтатусКВыполнению, ГруппаСкладов, МенеджерРегистра",
		Объект.Статус <> Перечисления.СтатусыЗаказовКлиентов.НеСогласован, Объект.Склад, РегистрыНакопления.ЗаказыКлиентов);

	ПараметрыФормы = ОбеспечениеСервер.ПараметрыВыбораОбеспечения(
		ИдентификаторСтроки,
		Объект,
		Объект.Товары,
		ПутиКДанным,
		ПараметрыЗаполнения);

	// В строках ТЧ нет поля Назначения, поэтому оно копируется из шапки документа.
	// Необходимо очистить поле Назначение для тех строк, где выбран не обособленный вариант обеспечения.
	Для Каждого Строка Из ПараметрыФормы.ТаблицаНевыделенныеСтроки Цикл
		Если Не (Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно
			Или Строка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно) Тогда
			Строка.Назначение = Справочники.Назначения.ПустаяСсылка();
		КонецЕсли;
	КонецЦикла;
	
	ОбеспечениеСервер.ДобавитьСвойствоАдресТаблицыПодобраноРанее(ПараметрыФормы, Форма.УникальныйИдентификатор);
	
	Возврат ПараметрыФормы;
		
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
