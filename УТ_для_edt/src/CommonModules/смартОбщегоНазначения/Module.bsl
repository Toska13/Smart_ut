//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
Функция смартПолучитьДопустимуюСуммуСкидки(СтруктураПараметров) Экспорт
    
	МаксимальныйПроцентРучнойСкидкиОбщий = Константы.смартМаксимальныйПроцентРучнойСкидки.Получить();
	
	Если СтруктураПараметров.ПовышеннаяСкидкаРазрешена Тогда
		МаксимальныйПроцентРучнойСкидки = Макс(МаксимальныйПроцентРучнойСкидкиОбщий, СтруктураПараметров.ПроцентПовышеннойСкидки);
	Иначе
		МаксимальныйПроцентРучнойСкидки = МаксимальныйПроцентРучнойСкидкиОбщий;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураПараметров.Партнер)
		И ЗначениеЗаполнено(СтруктураПараметров.Номенклатура) Тогда
		
		ПроцентИндивидуальнойСкидки = смартПолучитьИндивидуальнуюСкидкуКлиентаПоНоменклатуре(СтруктураПараметров.Дата, 
																							 СтруктураПараметров.Партнер, 
																							 СтруктураПараметров.Номенклатура);
	
		Если ЗначениеЗаполнено(ПроцентИндивидуальнойСкидки) Тогда
			МаксимальныйПроцентРучнойСкидки = Макс(МаксимальныйПроцентРучнойСкидки, ПроцентИндивидуальнойСкидки);
		КонецЕсли;
		
	КонецЕсли;	
	
	СтруктураКонтроля = Новый Структура("МаксимальнаяСуммаСкидкиДляКонтроля, ПроцентРучнойСкидки", 
										Окр(СтруктураПараметров.Цена * СтруктураПараметров.Количество * МаксимальныйПроцентРучнойСкидки / 100, 2), 
										МаксимальныйПроцентРучнойСкидки);
	
	Возврат СтруктураКонтроля;
    
КонецФункции //--#1868 смарт: Лопато 19.06.2024

//++#1323 смарт: Лопато 15.06.2023 //Восстановить и переделать механизм индивидуальных скидок
&НаСервере
Процедура смартЗаписатьМаксимальныйПроцентРучнойСкидки(МаксимальныйПроцентИндивидуальнойРучнойСкидки) Экспорт

	НаборКонстантМаксимальныйПроцентРучнойСкидки = Константы.смартМаксимальныйПроцентРучнойСкидки.СоздатьМенеджерЗначения();
	НаборКонстантМаксимальныйПроцентРучнойСкидки.Значение = МаксимальныйПроцентИндивидуальнойРучнойСкидки;
	
	Попытка
		НаборКонстантМаксимальныйПроцентРучнойСкидки.Записать();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка записи значения максимальной ручной скидки!");
	КонецПопытки;	
	
КонецПроцедуры //--#1323 смарт: Лопато 15.06.2023

