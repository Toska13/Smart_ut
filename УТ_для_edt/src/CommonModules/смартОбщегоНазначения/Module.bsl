		Если Не ПустаяСтрока(СтрокаОтвет) Тогда

			СтрокаОтвет = СтрЗаменить(СтрокаОтвет,"{","");
			СтрокаОтвет = СтрЗаменить(СтрокаОтвет,"}","");
			
			МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаОтвет, ",");
			
			Если МассивСтрок.Количество() > 0 Тогда 
				
				Если МассивСтрок[0] = """result"":""valid""" Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь; 
	
КонецФункции 
