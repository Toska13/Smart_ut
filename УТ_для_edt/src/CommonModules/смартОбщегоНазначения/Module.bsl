//++ смарт:ММ #092 389 20.01.2021 - Конструктор оборудования
Процедура ЗавершитьБизнесПроцессИЗадачи(БП, Комментарий = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(БП) Тогда
		Возврат;
	КонецЕсли;
	
	//БизнесПроцессыИЗадачиВызовСервера.ОстановитьБизнесПроцесс(БП);
	
	Если НЕ БП.Завершен Тогда
		ОбъектБП = БП.ПолучитьОбъект();	
		ОбъектБП.Завершен = Истина;
		ОбъектБП.Комментарий = Комментарий;
		ОбъектБП.Записать();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадачаИсполнителя.БизнесПроцесс КАК БизнесПроцесс,
	|	ЗадачаИсполнителя.Ссылка КАК Задача
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	НЕ ЗадачаИсполнителя.Выполнена
	|	И ЗадачаИсполнителя.БизнесПроцесс = &БП
	|	И НЕ ЗадачаИсполнителя.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("БП", БП);
	
	ВыборкаЗадача = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗадача.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаЗадача.Задача) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущаяЗадача = ВыборкаЗадача.Задача.ПолучитьОбъект();
		ТекущаяЗадача.ВыполнитьЗадачу();
		ТекущаяЗадача.Записать();
	КонецЦикла;			
	
КонецПроцедуры //-- смарт:ММ 20.01.2021

//++ смарт:ММ #082 397 12.02.2021 Заявка на ремонтные работы
Функция ПолучитьДатуИзСтроки(ДатаСтрока) Экспорт
	
	Если ТипЗнч(ДатаСтрока) = Тип("Дата") Тогда
		Возврат ДатаСтрока;
	КонецЕсли;
		
	ДатаИтог 	= Дата('0001.01.01');
	СтрокаГод 	= "";
	СтрокаМесяц = "";
	СтрокаДень 	= "";
	
	ДатаСтрока = СокрЛП(ДатаСтрока);

	Разделитель = ".";
		
	Если СтрНайти(ДатаСтрока, "/") <> 0 Тогда
		Разделитель = "/";
	ИначеЕсли СтрНайти(ДатаСтрока, "-") <> 0 Тогда
		Разделитель = "-";
	КонецЕсли;
	
	Если СтрДлина(ДатаСтрока) = 10 Тогда  // 01012010 или 20100101

		НомерПервогоСимволаНеЧисло = СтрНайти(ДатаСтрока, Разделитель);
		
		Если НомерПервогоСимволаНеЧисло = 3 Тогда // 01.01.2010, 01-01-2021
			СтрокаГод 	= Прав(ДатаСтрока, 4);
			СтрокаМесяц = Сред(ДатаСтрока, 4, 2);
			СтрокаДень 	= Лев(ДатаСтрока, 2);			
		ИначеЕсли НомерПервогоСимволаНеЧисло = 5 Тогда // 2010.01.01, 2021-01-01
			СтрокаГод 	= Лев(ДатаСтрока, 4);
			СтрокаМесяц = Сред(ДатаСтрока, 6, 2);
			СтрокаДень 	= Прав(ДатаСтрока, 2);
		Иначе
			Возврат ДатаИтог;
		КонецЕсли;
		
	ИначеЕсли СтрДлина(ДатаСтрока) = 8 Тогда // 01.01.10, 01-01-20
		
		СтрокаГод 	= "20" + Прав(ДатаСтрока, 2);
		СтрокаМесяц = Сред(ДатаСтрока, 4, 2);
		СтрокаДень 	= Лев(ДатаСтрока, 2);
		
	ИначеЕсли СтрДлина(ДатаСтрока) = 18 ИЛИ СтрДлина(ДатаСтрока) = 19 Тогда // 01.01.2010 0:00:00 или 01.01.2010 14:00:00
		
		СтрокаГод 	= Сред(ДатаСтрока, 7, 4);
		СтрокаМесяц = Сред(ДатаСтрока, 4, 2);
		СтрокаДень 	= Лев(ДатаСтрока, 2);
		
	КонецЕсли;
		
	Если ЗначениеЗаполнено(СтрокаГод) Тогда
		Попытка
			ДатаСтрокаИтог = "" + СтрокаГод + СтрокаМесяц + СтрокаДень;
			ОписаниеТипа = Новый ОписаниеТипов("Дата");
			ДатаИтог = ОписаниеТипа.ПривестиЗначение(ДатаСтрокаИтог);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат ДатаИтог;
	
КонецФункции //-- смарт:ММ 12.02.2021

