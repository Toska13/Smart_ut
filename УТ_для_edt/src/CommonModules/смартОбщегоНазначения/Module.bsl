		|	ДоРасхождений.Контрагент_Ут КАК Контрагент_Ут,
		|	ДоРасхождений.КонтрагентИНН_Ут КАК КонтрагентИНН_Ут,
		|	ДоРасхождений.КонтрагентКПП_Ут КАК КонтрагентКПП_Ут,
		|	ДоРасхождений.ОбъектРасчетов_Ут КАК ОбъектРасчетов_Ут,
		|	ЕСТЬNULL(ДоРасхождений.ДолгКлиента, 0) КАК ДолгКлиента,
