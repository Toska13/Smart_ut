//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
Функция ПолучитьДублиПоКонтактнойИнформацииСправочников(ПараметрыКИ) Экспорт

	МассивРезультат = Новый Массив;
	
	ВидСправочника = "";

	Запрос = Новый Запрос;
	
	Если ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.КонтактныеЛицаПартнеров")
		ИЛИ ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Партнеры")
		ИЛИ ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда

		Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	Ссылка КАК Контрагент
			|ПОМЕСТИТЬ ВТ_Контрагенты
			|ИЗ
			|	Справочник.Контрагенты
			|ГДЕ
