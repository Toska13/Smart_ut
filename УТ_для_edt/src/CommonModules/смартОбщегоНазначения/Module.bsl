//++ #5734 смарт: Тимофеева 18.02.26 / Создать роль для создания перемещений со склада Гарантийные запчасти - не для продажи
Процедура СоздатьЭлементыДляНомераЗаявкиНаГарантийныйРемонт(Форма, ИмяТЧ)

	Если Форма.Элементы.Найти("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка") = Неопределено Тогда
		
		НовыйЭлемент = Форма.Элементы.Добавить("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка", Тип("ПолеФормы"), Форма.Элементы[ИмяТЧ]);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект." + ИмяТЧ + ".смартНомерЗаявкиНаГарантийныйРемонтСсылка";
		
		//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");
		//-- #Б-1434 смарт: Лопато 22.11.2024
		
		Если Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда
			Если НЕ РольДоступна("ПолныеПрава") Тогда
				НовыйЭлемент.ТолькоПросмотр = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
	//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
	Если Форма.Элементы.Найти("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление") = Неопределено Тогда
		
		МассивРеквизитов = Новый Массив;
		
		НовыйРеквизитФормы = Новый РеквизитФормы("смартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление", 
												Новый ОписаниеТипов("Строка",,, Новый КвалификаторыСтроки(50)), 
												"Объект." + ИмяТЧ, 
												"Представление заявки");
		
		МассивРеквизитов.Добавить(НовыйРеквизитФормы);
		
		Форма.ИзменитьРеквизиты(МассивРеквизитов); 
		
		НовыйЭлемент = Форма.Элементы.Добавить("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление", Тип("ПолеФормы"), Форма.Элементы[ИмяТЧ]);
		НовыйЭлемент.Вид 		 = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект." + ИмяТЧ + ".смартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление";
		НовыйЭлемент.Видимость 	 = Ложь;
		
		ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Форма.Элементы.ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка.Имя);
		
		ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".смартНомерЗаявкиНаГарантийныйРемонтСсылка");
		ЭлементУсловия.ВидСравнения  = ВидСравненияКомпоновкиДанных.Заполнено;
		ЭлементУсловия.Использование = Истина;
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра(
			"Текст", Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".смартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление"));
		
	КонецЕсли;
	
	ОбновитьПредставлениеЗаявокНаГарантийныйРемонт(Форма.Объект[ИмяТЧ]);
	//-- #Б-1434 смарт: Лопато 22.11.2024	
	
КонецПроцедуры
