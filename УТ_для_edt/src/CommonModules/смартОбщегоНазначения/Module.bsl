//++ #Б674 смарт: Шляпников 25.03.2025 / Отчет по кол-ву платных доставок, ИТСМ 1959
Функция ПолучитьВесЗаказа(ЗаказКлиента) Экспорт
	
	Результат = Новый Структура("ВесНетто,ВесБрутто", 0, 0);
	
	Запрос = Новый Запрос;
	МассивТекстов = Новый Массив;
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.Упаковка КАК Упаковка,
		|	ЗаказКлиентаТовары.Количество КАК Количество,
		|	ЗаказКлиентаТовары.КоличествоУпаковок КАК КоличествоУпаковок,
		|	ЗаказКлиентаТовары.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
		|	И НЕ ЗаказКлиентаТовары.Отменено";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Упаковка КАК Упаковка,
		|	Т.Количество КАК Количество,
		|	Т.КоличествоУпаковок КАК КоличествоУпаковок,
		|	Т.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТТовары
		|ИЗ
		|	&ТЗ КАК Т
		|ГДЕ
		|	НЕ Т.Отменено";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("ТЗ", ЗаказКлиента.Товары.Выгрузить());
		
	КонецЕсли;
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СУММА(Данные.ВесНетто) КАК ВесНетто,
	|	СУММА(Данные.ВесБрутто) КАК ВесБрутто
	|ИЗ
	|	(ВЫБРАТЬ
	|		МАКСИМУМ(ВЫБОР
	|				КОГДА ВТТовары.Номенклатура.ВесЗнаменатель = 0
	|					ТОГДА 0
	|				ИНАЧЕ ВТТовары.Номенклатура.ВесЧислитель / ВТТовары.Номенклатура.ВесЗнаменатель
	|			КОНЕЦ * ВТТовары.Количество) КАК ВесНетто,
	|		МАКСИМУМ(ВЫБОР
	|				КОГДА ВТТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|					ТОГДА ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0) * ВТТовары.КоличествоУпаковок
	|				ИНАЧЕ ВТТовары.Упаковка.Вес * ВТТовары.КоличествоУпаковок
	|			КОНЕЦ) КАК ВесБрутто,
	|		ВТТовары.НомерСтроки КАК НомерСтроки
	|	ИЗ
	|		ВТТовары КАК ВТТовары
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|			ПО ВТТовары.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец
	|				И ВТТовары.Номенклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТТовары.НомерСтроки) КАК Данные";
	
	МассивТекстов.Добавить(ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(МассивТекстов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Если Результат.ВесНетто = NULL Тогда
		Результат.ВесНетто = 0;
	КонецЕсли;
	
	Если Результат.ВесБрутто = NULL Тогда
		Результат.ВесБрутто = 0;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

