	//КонецЕсли;
	//-- #1193 смарт: Фролов 23.11.2022
	
		
	Возврат Успех;
	
КонецФункции //-- смарт:ММ 26.12.2020

//++ смарт:ММ 594 15.08.2021
//	Параметры:
//		АдресКаталога - адрес каталога на FTP (не включая имя сервера)	
Процедура СохранитьФайлыНаFTP(МассивВременныхФайлов, АдресКаталога)
    
    //++ смарт:Подкин #986 19.04.2022 16:18:02
	Настройка = Справочники.смартПредопределенныеЗначения.АдресФТПсервера;
	ИмяСервера = ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь); 
    //-- смарт:Подкин #986 19.04.2022 16:18:02

	//ИмяСервера = "u483805.ftp.masterhost.ru";
	
	Соединение = ПодключитьсяКFTPСерверу(ИмяСервера);
	
	Если ТипЗнч(Соединение) <> Тип("FTPСоединение") Тогда
		ТекстСообщения = "Не удалось загрузить файлы на ftp: " + ОписаниеОшибки();
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации("Сохранение файлов оборудования на ftp", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);

		Возврат;
	КонецЕсли;
	
	Соединение.УстановитьТекущийКаталог("/");
	
	АдресКаталога = СтрЗаменить(АдресКаталога, ИмяСервера, "");
	
	Если Лев(АдресКаталога, 1) <> "/" Тогда
		АдресКаталога = "/" + АдресКаталога;
	КонецЕсли;
	
	Если Прав(АдресКаталога, 1) <> "/" Тогда
		АдресКаталога = АдресКаталога + "/";
	КонецЕсли;
	
	Для Каждого СтруктураФайл Из МассивВременныхФайлов Цикл

		ИмяФайла = СтруктураФайл.ИмяФайла;
		АдресФайла = СтруктураФайл.АдресФайла;
		
		Попытка
			Соединение.Записать(
			        АдресФайла, // что записываем
			        АдресКаталога + ИмяФайла // куда записываем
    				);
			ТекстСообщения = "Файл " + ИмяФайла + " сохранен в каталог ftp: " + ИмяСервера + АдресКаталога;		
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЗаписьЖурналаРегистрации("Сохранение файлов оборудования на ftp", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
		Исключение
			ТекстСообщения = "Не удалось загрузить файлы на ftp: " + ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЗаписьЖурналаРегистрации("Сохранение файлов оборудования на ftp", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		КонецПопытки;
				
	КонецЦикла;

КонецПроцедуры //-- смарт:ММ 15.08.2021

//++ смарт:ММ 594 15.08.2021
Функция ПодключитьсяКFTPСерверу(ИмяСервера)
    
    //++ смарт:Подкин #986 19.04.2022 16:18:02
    НастройкаЛогин = Справочники.смартПредопределенныеЗначения.ЛогинФТПсервера;
    Логин = ПолучитьСмартПредопределенноеЗначение(НастройкаЛогин, Ложь);   
    
    НастройкаПароль = Справочники.смартПредопределенныеЗначения.ПарольФТПсервера;
    Пароль = ПолучитьСмартПредопределенноеЗначение(НастройкаПароль, Ложь); 
    
    Если Не ЗначениеЗаполнено(Логин) Или Не ЗначениеЗаполнено(Пароль) Тогда
        Возврат Неопределено;
    КонецЕсли;
    //-- смарт:Подкин #986 19.04.2022 16:18:02
    
    Соединение = Новый FTPСоединение(
        ИмяСервера, // адрес ftp сервера
        21, // порт сервера
        Логин, //"u483805"//"smartftpd", // имя пользователя
        Пароль, //"r5terietiessel", //"Wp4j63piI1WWzXh", // пароль пользователя
        Неопределено, // прокси не используется
        Истина, // пассивный режим работы
        0, // таймаут (0 - без ограничений)
        Неопределено // незащищенное соединение
    );
 
    // Для случаев, когда у ftp сервера нет возможности
    // обращаться к нам (мы находимся за межсетевым экраном)
    // следует использовать пассивный режим работы.
 
    Возврат Соединение;
 
КонецФункции //-- смарт:ММ 15.08.2021

