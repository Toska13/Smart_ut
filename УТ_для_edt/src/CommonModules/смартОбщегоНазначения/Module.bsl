		|							ТОГДА НЕ ЕСТЬNULL(ДоРасхождений.ВалСуммаОстатокКт, 0) = ЕСТЬNULL(ДоРасхождений.НашДолг, 0)
		|						КОГДА ЕСТЬNULL(ДоРасхождений.СуммаОстатокКт, 0) > 0
