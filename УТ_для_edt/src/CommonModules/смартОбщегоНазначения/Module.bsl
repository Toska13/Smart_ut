//++ #Б-1644 смарт: Фролов 12.12.2024 //Отображение состояния партнера в карточке партнера.
Функция ПолучитьДниВСклонении(КоличествоДней) Экспорт
	
	ДниВСклонении = "дней";
	
	Если КоличествоДней = 0 Тогда
		Возврат ДниВСклонении;
	КонецЕсли;	
	
	ДлинаЧисла = СтрДлина(КоличествоДней);
	ОдинСПрава = Прав(КоличествоДней, 1);
	ДваСПрава = Прав(КоличествоДней, 2);
	
	Если ДлинаЧисла = 1 И НЕ КоличествоДней = Неопределено Тогда     
		
		Если КоличествоДней = 1 Тогда 
			ДниВСклонении = "день";
		ИначеЕсли КоличествоДней = 2 ИЛИ КоличествоДней = 3 ИЛИ КоличествоДней = 4 Тогда  
			ДниВСклонении = "дня" 
		ИначеЕсли КоличествоДней = 5 ИЛИ КоличествоДней = 6 ИЛИ КоличествоДней = 7 ИЛИ КоличествоДней = 8
			ИЛИ КоличествоДней = 9 ИЛИ КоличествоДней = 0 Тогда  
			ДниВСклонении = "дней" 
		КонецЕсли;
		
	ИначеЕсли ДлинаЧисла > 1 Тогда
		
		Если ДваСПрава = "10" ИЛИ ДваСПрава = "11" ИЛИ ДваСПрава = "12" ИЛИ ДваСПрава = "13" ИЛИ ДваСПрава = "14" Тогда
			ДниВСклонении = "дней"   
		ИначеЕсли ОдинСПрава = "1" Тогда 
			ДниВСклонении = "день"     
		ИначеЕсли ОдинСПрава = "2" ИЛИ ОдинСПрава = "3" ИЛИ ОдинСПрава = "4" Тогда
			ДниВСклонении = "дня"  
		ИначеЕсли  ОдинСПрава = "5" ИЛИ ОдинСПрава = "6" ИЛИ ОдинСПрава = "7" ИЛИ ОдинСПрава = "8" 
			ИЛИ ОдинСПрава = "9" ИЛИ ОдинСПрава = "0" Тогда  
			ДниВСклонении = "дней";      
		КонецЕсли;
		
	КонеЦесли;
	
	Возврат ДниВСклонении;
	
КонецФункции //-- #Б-1644 смарт: Фролов 12.12.2024

//++ #Б-4120 смарт: Фролов 22.08.2025 //Указывать в Партнерах и Интересах, на против ответственных информацию о их отпусках
Функция смартОпределитьДатуОкончанияОтпуска(Ответственный) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Статус КАК Статус,
	|	До КАК До
	|ИЗ
	//++ #Б-7054 смарт: Фролов 01.06.2026 //Отпуска сотрудников на текущую дату
	//|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(, Пользователь = &Ответственный)");
	|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(&ТекущаяДата, Пользователь = &Ответственный)");
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	//-- #Б-7054 смарт: Фролов 01.06.2026
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Статус = Справочники.смартСтатусыСотрудников.ВОтпуске Тогда
			
			Возврат Выборка.До;
			
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;	
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции

//++ #Б4398 смарт: Шляпников 02.10.2025 / Задания на перевозку. Заполнение поля "Вес". Разработка. 
Функция Строка2Число(Строка) Экспорт
	
	Определение = Новый ОписаниеТипов("Число");
	Возврат Определение.ПривестиЗначение(Строка);
	
