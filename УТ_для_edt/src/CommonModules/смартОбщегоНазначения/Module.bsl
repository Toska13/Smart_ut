	Если НЕ ТекстСтрока="" тогда
		ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, "Сверка взаиморасчетов УТ/БП!!! "  + ТекущаяДатаСеанса() + Символы.ПС);
		
		// Отправка уведомления 
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки=смартПолучитьАдресаПолучателейУведомлений(Справочники.смартПредопределенныеЗначения.ПользователиДляОповещенияОбВзаимозачете,АдресаДляОтправкиСтрокой,);	//	МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес,Представление", "rashevskaya@smart-t.ru", "rashevskaya@smart-t.ru"));
		Если МассивАдресовДляОтправки.Количество()=0 Тогда
		   ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, "Не указаны адреса для рассылки в справочнике Предопределенные значения(смарт): ПользователиДляОповещенияОбВзаимозачете!");
		   Возврат;
		КонецЕсли; 
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
			
			ТемаПисьма = "Сверка взаиморасчетов УТ/БП для документа: "+ ИсточникДанных;
			ТекстПисьма = ТекстСтрока; 
			
			ДанныеОтправки = Новый Структура("Тема,Тело", ТемаПисьма, ТекстПисьма);
			
			ПараметрыПисьма = ПолучитьПараметрыОтправки2(МассивАдресовДляОтправки, ДанныеОтправки);
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, "Отправлено уведомление о взаиморасчете УТ/БП "+ИсточникДанных+" " + ТекущаяДата() + Символы.ПС + " на почту: " + АдресаДляОтправкиСтрокой);
			Исключение 
				//++ #1416 смарт: Фролов 29.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
				смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,,ТекстПисьма);
				//-- #1416 смарт: Фролов 29.08.2023
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось отправить уведомление о взаиморасчете УТ/БП "+ИсточникДанных+" "  + ТекущаяДата() + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	

	
КонецПроцедуры

Функция ПодключениеК_WS(Сервер,База,Логин,Пароль,СервисИмя)
	
	Адрес="http://"+Сервер+"/"+База+"/ws/"+СервисИмя+".1cws/?wsdl";
	
	// Создание WS-определений
	ОпределениеWS 		= Новый WSОпределения(Адрес, Логин, Пароль);
	Сервис 				= ОпределениеWS.Сервисы.Получить(0);
	ИмяСервиса 			= Сервис.Имя;
	ИмяТочкиПодключения = Сервис.ТочкиПодключения.Получить(0).Имя;
	
	// Создание WS-прокси
	ПроксиWS 				= Новый WSПрокси(ОпределениеWS, Сервис.URIПространстваИмен, ИмяСервиса, ИмяТочкиПодключения);
	ПроксиWS.Пользователь 	= Логин;
	ПроксиWS.Пароль 		= Пароль;
	
	Возврат ПроксиWS;
	
КонецФункции // ПодключениеК_УТ()

Функция СформироватьТЗ_УТ(ТЗ_УТ,ИсточникДанных, КонтрагентИНН)
	//Рашевская: в запрос добавлена аналитика по партнеру из регистра Расчеты по срокам
	//и в качестве объекта расчетов подставляется договор если заполнен в аналитике
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустойДоговор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Сегменты.Партнер КАК Партнер,
	|	ИСТИНА КАК ИспользуетсяОтборПоСегментуПартнеров
	|ИЗ
	|	РегистрСведений.ПартнерыСегмента КАК Сегменты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КурсВалюты.Валюта КАК Валюта,
	|	КурсВалюты.Курс * КурсВалютыОтчета.Кратность / (КурсВалюты.Кратность * КурсВалютыОтчета.Курс) КАК Коэффициент
	|ПОМЕСТИТЬ КурсыВалют
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&КонецПериода, ) КАК КурсВалюты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&КонецПериода, Валюта = &Валюта) КАК КурсВалютыОтчета
	|		ПО (ИСТИНА)
	|ГДЕ
	|	КурсВалюты.Кратность <> 0
	|	И КурсВалютыОтчета.Курс <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Расчеты.Контрагент КАК Контрагент,
	|	Расчеты.Контрагент.ИНН КАК КонтрагентИНН,
	|	Расчеты.Контрагент.КПП КАК КонтрагентКПП,
	|	СУММА(Расчеты.ДолгКлиентаКонечныйОстаток) КАК ДолгКлиентаКонечныйОстаток,
	|	СУММА(Расчеты.НашДолгКонечныйОстаток) КАК НашДолгКонечныйОстаток,
	|	Расчеты.ОбъектРасчетов КАК ОбъектРасчетов,
	|	ВЫБОР
	|		КОГДА Расчеты.АналитикаУчетаПоПартнерам.Договор = &ПустойДоговор
	|			ТОГДА Расчеты.ОбъектРасчетов.Номер
	|		ИНАЧЕ Расчеты.АналитикаУчетаПоПартнерам.Договор.Номер
	|	КОНЕЦ КАК Номер,
	|	ВЫБОР
	|		КОГДА Расчеты.АналитикаУчетаПоПартнерам.Договор = &ПустойДоговор
	|			ТОГДА НАЧАЛОПЕРИОДА(Расчеты.ОбъектРасчетов.Дата, ДЕНЬ)
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(Расчеты.АналитикаУчетаПоПартнерам.Договор.Дата, ДЕНЬ)
	|	КОНЕЦ КАК Дата,
	|	Расчеты.Валюта КАК Валюта,
	|	Расчеты.Партнер КАК Партнер,
	|	Расчеты.РасчетныйДокумент КАК ДокРасч,
	|	Расчеты.РасчетныйДокумент.Номер КАК Номер_ДокРасч,
	|	Расчеты.РасчетныйДокумент.Дата КАК Дата_ДокРасч,
	|	Расчеты.АналитикаУчетаПоПартнерам КАК КлючАналитикиПоПартнеру
	|ИЗ
	|	(ВЫБРАТЬ
	|		АналитикаУчета.Организация КАК Организация,
	|		АналитикаУчета.Партнер КАК Партнер,
