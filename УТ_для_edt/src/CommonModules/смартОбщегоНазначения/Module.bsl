	|		ПО (ВТ_ВсеКонтрагенты.Контрагент = (ВЫРАЗИТЬ(БанковскиеСчетаКонтрагентов.Владелец КАК Справочник.Контрагенты)))
	|			И (НЕ БанковскиеСчетаКонтрагентов.Закрыт)
	|
