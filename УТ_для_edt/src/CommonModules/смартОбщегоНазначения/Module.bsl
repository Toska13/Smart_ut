		|	ДоРасхождений.Номер_Ут КАК Номер_Ут,
		|	ДоРасхождений.Дата_Ут КАК Дата_Ут,
		|	ДоРасхождений.ДокРасч_Ут КАК ДокРасч_Ут,
		|	ДоРасхождений.Номер_ДокРасч_Ут КАК Номер_ДокРасч_Ут,
		|	ДоРасхождений.Дата_ДокРасч_Ут КАК Дата_ДокРасч_Ут,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ДоРасхождений.КонтрагентИНН_Бух, ЕСТЬNULL(ДоРасхождений.КонтрагентИНН_Ут, """")) <> """"
		|			ТОГДА ЕСТЬNULL(ДоРасхождений.КонтрагентИНН_Бух, ЕСТЬNULL(ДоРасхождений.КонтрагентИНН_Ут, """"))
		|		ИНАЧЕ ДоРасхождений.ПолеПорядка
		|	КОНЕЦ КАК ПолеДляПоиска,
		|	ДоРасхождений.КлючАналитикиПоПартнеру КАК КлючАналитикиПоПартнеру
		|ИЗ
		|	ДоРасхождений КАК ДоРасхождений
		|ГДЕ
