		КонецЕсли;
		
				
	Исключение
		ТекстСтрока="Не удалось выполнить сверу данных после проведения документа: "+ИсточникДанных+" "+Символы.пс+" "+ ОписаниеОшибки();
	КонецПопытки;
	
