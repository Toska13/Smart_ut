//++ смарт:ММ 615 15.09.2021 СМС инженеру
Функция ОтправитьСМСПользователю(Пользователь, ТекстСообщения) Экспорт
	
	РезультатОтправки = Новый Структура("ОтправленныеСообщения,ОписаниеОшибки", Новый Массив, "");
	
	УстановитьПривилегированныйРежим(Истина);
	НастройкиОтправкиSMS = ОтправкаSMS.НастройкиОтправкиSMS();
	УстановитьПривилегированныйРежим(Ложь);
	
	ЛогинДляОтправкиSMS 	= НастройкиОтправкиSMS.Логин;
	ИмяОтправителя 			= НастройкиОтправкиSMS.ИмяОтправителя;
	ПарольДляОтправкиSMS 	= НастройкиОтправкиSMS.Пароль; 
	
	//++ #1735 смарт: Ермаков 02.04.2024 / Не отправляются СМС пользователям
	ТелефонПользователя = 
		УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Пользователь,  
				Справочники.ВидыКонтактнойИнформации.CRM_МобильныйТелефонПользователя,
				,
				Истина);
	//-- #1735 смарт: Ермаков 02.04.2024				
				
	Если НЕ ЗначениеЗаполнено(ТелефонПользователя) Тогда
		РезультатОтправки.ОписаниеОшибки = "Не указан телефон пользователя " + Пользователь;
		Возврат РезультатОтправки;
	КонецЕсли;
			
	Если Не Взаимодействия.КорректноВведенНомерТелефона(ТелефонПользователя) Тогда
		
		ТекстОшибки = "SMS не отправлено: номер телефона пользователя " + Пользователь + " введен некорректно";
		ЗаписьЖурналаРегистрации("Отправка SMS пользователю (смарт)", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		РезультатОтправки.ОписаниеОшибки = ТекстОшибки;
		
		Возврат РезультатОтправки;
	КонецЕсли;
	
	НомерДляОтправки = ФорматироватьНомер(ТелефонПользователя);
	
	Если ЗначениеЗаполнено(НомерДляОтправки) Тогда
				
		Если НЕ смартРабочаяБаза() Тогда
			
			ОсталосьБесплатныхСМС = ОтправкаSMSЧерезSMSRU.смартПолучитьОстатокБесплатныхСМС(ЛогинДляОтправкиSMS, ПарольДляОтправкиSMS);
			
			Если ОсталосьБесплатныхСМС = 0 Тогда
				ТекстОшибки = "SMS инженеру не отправлено (ограничение тестовой базы)";
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				РезультатОтправки.ОписаниеОшибки = ТекстОшибки;
				Возврат РезультатОтправки;
			Иначе
				НомерДляРабочейБазы = НомерДляОтправки;
				НомерДляОтправки = ФорматироватьНомер(ЛогинДляОтправкиSMS);
				ОбщегоНазначения.СообщитьПользователю("SMS отправлено на номер " + НомерДляОтправки + " (в рабочей базе отправилось бы на номер " + НомерДляРабочейБазы + ")");
			КонецЕсли;			
		КонецЕсли;
	
		НомерДляОтправкиМассив = Новый Массив;
		НомерДляОтправкиМассив.Добавить(НомерДляОтправки);
		
		РезультатОтправки = ОтправкаSMSЧерезSMSRU.ОтправитьSMS(НомерДляОтправкиМассив, ТекстСообщения, ИмяОтправителя, ЛогинДляОтправкиSMS, ПарольДляОтправкиSMS);
		
		Если НЕ ЗначениеЗаполнено(РезультатОтправки.ОписаниеОшибки) Тогда  
			
			//++ #1803 смарт: Мосолов 27.04.2024 //Доработать отправку СМС из документа Заявка на ремонтные работы
			//ЗаписьЖурналаРегистрации("Отправка SMS пользователю (смарт)", УровеньЖурналаРегистрации.Информация,,, "SMS отправлено");
			
			ТекстЖурнала = "SMS отправлено" 
						+ Символы.ПС + "Пользователь: " + Пользователь
						+ Символы.ПС + "На номер " + Строка(ТелефонПользователя)
						+ Символы.ПС + "Текст: " + ТекстСообщения; 
						
			ЗаписьЖурналаРегистрации("Отправка SMS пользователю (смарт)", УровеньЖурналаРегистрации.Информация,,, ТекстЖурнала);
			//-- #1803 смарт: Мосолов 27.04.2024
			
		Иначе

			//++ #1803 смарт: Мосолов 27.04.2024 //Доработать отправку СМС из документа Заявка на ремонтные работы
			//ЗаписьЖурналаРегистрации("Отправка SMS пользователю (смарт)", УровеньЖурналаРегистрации.Ошибка,,, "SMS не отправлено: " + РезультатОтправки.ОписаниеОшибки);
			
			ТекстЖурнала = "SMS не отправлено: " + РезультатОтправки.ОписаниеОшибки 
						+ Символы.ПС + "Пользователь: " + Пользователь
						+ Символы.ПС + "На номер " + Строка(ТелефонПользователя)
						+ Символы.ПС + "Текст: " + ТекстСообщения; 
						
			ЗаписьЖурналаРегистрации("Отправка SMS пользователю (смарт)", УровеньЖурналаРегистрации.Ошибка,,, ТекстЖурнала);
			//-- #1803 смарт: Мосолов 27.04.2024
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатОтправки;
	
КонецФункции //-- смарт:ММ 15.09.2021

//++ смарт:ММ 615 17.09.2021 СМС инженеру 
Функция ФорматироватьНомер(Номер)
	
	Результат = "";
	ДопустимыеСимволы = "+1234567890";
	Для Позиция = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер,Позиция,1);
		Если СтрНайти(ДопустимыеСимволы, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрДлина(Результат) > 10 Тогда
		ПервыйСимвол = Лев(Результат, 1);
		Если ПервыйСимвол = "8" Тогда
			Результат = "+7" + Сред(Результат, 2);
		ИначеЕсли ПервыйСимвол <> "+" Тогда
			Результат = "+" + Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 17.09.2021

//++ смарт:ММ 667 06.10.2021 
Функция ОбработатьКодНоменклатуры(знач ИсходныйКод) Экспорт
	
	Результат = "";
	
	ИсходныйКод = СокрЛП(ИсходныйКод);
	
	Кириллица = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЫЪЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщыъьэюя"; 

	ВсеНеДопустимыеСимволы = Новый Соответствие;
	Для Позиция = 1 По СтрДлина(Кириллица) Цикл
		ВсеНеДопустимыеСимволы[Сред(Кириллица, Позиция, 1)] = Истина;
	КонецЦикла;
	
	Для Позиция = 1 По СтрДлина(ИсходныйКод) Цикл
		ТекСимвол = Сред(ИсходныйКод, Позиция, 1);
		Если ВсеНеДопустимыеСимволы[ТекСимвол] = Неопределено Тогда
			Результат = Результат + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Если Лев(Результат, 1) = "-" Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 06.10.2021

