Функция ПолучитьСписокАдресовРассылкиДляПакетаАдмирал(СкладАдмирал,Самовывоз=Ложь)
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	                    |	СкладысмартАдресаДляОтправкиПакетаНаСклад.смартАдресДляОтправкиПакетаНаСклад КАК смартАдресДляОтправкиПакетаНаСклад
	                    |ИЗ
	                    |	Справочник.Склады.смартАдресаДляОтправкиПакетаНаСклад КАК СкладысмартАдресаДляОтправкиПакетаНаСклад
	                    |ГДЕ
	                    |	СкладысмартАдресаДляОтправкиПакетаНаСклад.Ссылка = &Ссылка
	                    |	И  1 = 1 ";
	Если Самовывоз Тогда
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"1 = 1","СкладысмартАдресаДляОтправкиПакетаНаСклад.смартСамовывоз");
	Иначе
		Запрос.Текст=СтрЗаменить(Запрос.Текст,"1 = 1","СкладысмартАдресаДляОтправкиПакетаНаСклад.смартДоставка");
	КонецЕсли;	
	Запрос.УстановитьПараметр("Ссылка",СкладАдмирал);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("смартАдресДляОтправкиПакетаНаСклад");
КонецФункции	//-- #1353 смарт: Фролов 06.09.2023

