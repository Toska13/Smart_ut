//++ смарт:ММ #054 301 23.07.2020 - Контрагенты с ЭДО 
// В соответствии вернутся только те контрагенты, для которых есть доп. сведение "id_ЭДО"
&НаСервере
Функция ПолучитьОператоровЭДОКонтрагентов(МассивКонтрагентов = Неопределено, ВернутьТолькоКонтрагентов = Ложь) Экспорт
	
	СоответствиеВозврат = Новый Соответствие; // Контрагент - Массив операторов
	МассивКонтрагентовВозврат = Новый Массив; // Для контрагентов, у которых есть операторы ЭДО
	
	Если НЕ ЗначениеЗаполнено(МассивКонтрагентов) И НЕ ВернутьТолькоКонтрагентов Тогда
		Возврат СоответствиеВозврат;
	КонецЕсли;	
	
	// 1. Получить идентификаторы ЭДО для контрагентов из РС ДополнительныеСведения
	// 2. По первым 3 символам идентификатора найти операторов ЭДО в РС ОператорыЭДО
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) КАК КодОператора,
	|	ЕСТЬNULL(ДополнительныеСведения.Значение, """") КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_КодыОператоров
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО (Контрагенты.Ссылка = (ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Справочник.Контрагенты)))
	|ГДЕ
	|	ДополнительныеСведения.Объект В(&МассивКонтрагентов)
	|	И ДополнительныеСведения.Свойство.Имя = &ИмяСвойства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_КодыОператоров.Контрагент КАК Контрагент,
	|	ВТ_КодыОператоров.КодОператора КАК КодОператора,
	|	ВТ_КодыОператоров.Идентификатор КАК ИдентификаторКонтрагента,
	|	ЕСТЬNULL(ОператорыЭДО.Представление, """") КАК Оператор
	|ИЗ
	|	ВТ_КодыОператоров КАК ВТ_КодыОператоров
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
	|		ПО ВТ_КодыОператоров.КодОператора = ОператорыЭДО.ИдентификаторОператора
	|ИТОГИ ПО
	|	Контрагент";
	
	Запрос.УстановитьПараметр("ИмяСвойства", "id_ЭДО");
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
		
	ВыборкаКонтрагент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКонтрагент.Следующий() Цикл
		
		Контрагент = ВыборкаКонтрагент.Контрагент;
		
		МассивОператоров = Новый Массив;
		
		Выборка = ВыборкаКонтрагент.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ЗначениеЗаполнено(Выборка.Оператор) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивОператоров.Добавить(Выборка.Оператор);
		КонецЦикла;
		
		Если МассивКонтрагентовВозврат.Найти(Контрагент) = Неопределено Тогда
			МассивКонтрагентовВозврат.Добавить(Контрагент);
		КонецЕсли;
		
		СоответствиеВозврат.Вставить(ВыборкаКонтрагент.Контрагент, МассивОператоров);
		
	КонецЦикла;
	
	Если ВернутьТолькоКонтрагентов Тогда
		Возврат МассивКонтрагентовВозврат;
	КонецЕсли;
	
	Возврат СоответствиеВозврат;
	
КонецФункции //-- смарт:ММ 23.07.2020

//++ смарт:ММ #054 301 24.07.2020 - Контрагенты с ЭДО 
Функция СтруктураURI(Знач СтрокаURI) Экспорт
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// схема
	Схема = "";
	Позиция = Найти(СтрокаURI, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + 3);
	КонецЕсли;
	
	// строка соединения и путь на сервере
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = Найти(СтрокаСоединения, "/");
	Если Позиция > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
	КонецЕсли;
	
	// информация пользователя и имя сервера
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = Найти(СтрокаСоединения, "@");
	Если Позиция > 0 Тогда
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
	КонецЕсли;
	
	// логин и пароль
	Логин = СтрокаАвторизации;
	Пароль = "";
	
	Позиция = Найти(СтрокаАвторизации, ":");
	Если Позиция > 0 Тогда
		Логин = Лев(СтрокаАвторизации, Позиция - 1);
		Пароль = Сред(СтрокаАвторизации, Позиция + 1);
	КонецЕсли;
	
	// хост и порт
	Хост = ИмяСервера;
	Порт = "";
	Позиция = Найти(ИмяСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Сред(ИмяСервера, Позиция + 1);
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", ?(Порт <> "", Число(Порт), Неопределено));
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 24.07.2020

//++ смарт:ММ #072 311 14.09.2020 - Доработка подбора товаров
// Параметры: СсылкаНаПредопределенноеЗначение - ссылка или наименование предопределенного элемента
Функция ПолучитьСмартПредопределенноеЗначение(СсылкаНаПредопределенноеЗначение, ВернутьМассив = Истина) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначения.СписокЗначений = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений = ИСТИНА";
	
	// 05.06.2021
	УстановитьПривилегированныйРежим(Истина);

	Если ТипЗнч(СсылкаНаПредопределенноеЗначение) = Тип("Строка") Тогда
		Настройка = Справочники.смартПредопределенныеЗначения[СсылкаНаПредопределенноеЗначение];
		Запрос.УстановитьПараметр("Ссылка", Настройка);
	Иначе
	// --
		Запрос.УстановитьПараметр("Ссылка", СсылкаНаПредопределенноеЗначение);
	КонецЕсли;
	
	Если ВернутьМассив Тогда
		Результат = Новый Массив;
	Иначе 
		Результат = Неопределено;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();
	// ++ 02.03.2021
	УстановитьПривилегированныйРежим(Ложь);
	// --
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
