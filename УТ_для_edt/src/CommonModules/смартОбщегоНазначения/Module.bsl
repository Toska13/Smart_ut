Функция ВыгрузитьсмартКонфигурацииЧернилJSON(ОтправлятьНаЭлПочту = Истина, СохранятьНаFTP = Истина) Экспорт	
	Успех = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	смартКонфигурацииЧернил.Ссылка КАК Ссылка,
	|	смартКонфигурацииЧернил.Наименование КАК Наименование
	|ИЗ
	|	Справочник.смартКонфигурацииЧернил КАК смартКонфигурацииЧернил
	|ГДЕ
	|	НЕ смартКонфигурацииЧернил.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	рез = запрос.Выполнить().Выгрузить();
	
	ИмяВременногоФайлаКонфигурацииЧернил = "conf.json";		
	
	КаталогВременныхФайлов = КаталогВременныхФайлов();
	ИмяВременногоФайлаКонфигурацииЧернил = КаталогВременныхФайлов + ИмяВременногоФайлаКонфигурацииЧернил;
	ИмяФайла = ИмяВременногоФайлаКонфигурацииЧернил;
	
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
		
	ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON( , Символы.ПС);
		
	ЗаписьJSON.ОткрытьФайл(ИмяФайла,,, ПараметрыЗаписиJSON);
	ЗаписьJSON.ЗаписатьНачалоМассива();
		
	//++ смарт:Белоусова  494 13.05.2021 исправление
	//ЗаписьJSON.ЗаписатьНачалоОбъекта();
	//сч = 1;
	для каждого эл из рез цикл			
		//если сч<рез.Количество() тогда
		//ЗаписьJSON.ЗаписатьЗначение(эл.Наименование + ",");
		////ЗаписьJSON.ЗаписатьКонецОбъекта();
		//иначе
		ЗаписьJSON.ЗаписатьЗначение(эл.Наименование );

		//КонецЕсли;
		//сч = сч + 1;	
	КонецЦикла;

	//ЗаписьJSON.ЗаписатьКонецОбъекта();
	//-- смарт:Белоусова  494 13.05.2021 исправление
	

	ЗаписьJSON.ЗаписатьКонецМассива();			
	ЗаписьJSON.Закрыть();
		
	//++ смарт:rnp 594 16.08.2021
	Если СохранятьНаFTP Тогда
		
		АдресКаталога = ПолучитьСмартПредопределенноеЗначение("КаталогFTPДляОборудованияЧернил", Ложь);
		
		Если ЗначениеЗаполнено(АдресКаталога) Тогда
			
			ФайлОборудованиеСуществует = ФайлСуществует(ИмяВременногоФайлаКонфигурацииЧернил);
			
			
			МассивВременныхФайлов = Новый Массив;
			
			Если ФайлОборудованиеСуществует Тогда
				СтруктураФайла = Новый Структура;
				СтруктураФайла.Вставить("ИмяФайла", "conf.json");
				СтруктураФайла.Вставить("АдресФайла", ИмяВременногоФайлаКонфигурацииЧернил);
				МассивВременныхФайлов.Добавить(СтруктураФайла);				
			КонецЕсли;
			
						
			Если МассивВременныхФайлов.Количество() > 0 Тогда
				СохранитьФайлыНаFTP(МассивВременныхФайлов, АдресКаталога);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-- смарт:rnp 16.08.2021
	
	//++ #1193 смарт: Фролов 23.11.2022 //Исправить ошибки в журнале регистрации  
	//Если ОтправлятьНаЭлПочту Тогда
	//	Успех = ОтправитьФайлыКонфигурацииЧернил(ИмяВременногоФайлаКонфигурацииЧернил);
	//КонецЕсли;
	//-- #1193 смарт: Фролов 23.11.2022
	
	Возврат Успех;
	
КонецФункции 
