Функция НайтиПодчиненныйСчетФактуруВыданныйНаРеализацию(ДокСсылка) Экспорт
	
	//Возврат УчетНДСПереопределяемый.НайтиПодчиненныйСчетФактуруВыданныйНаРеализацию(ДокСсылка, , , Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка КАК Ссылка,
		|	1 КАК Приоритет,
		|	NULL КАК ДокументОснование
		|ПОМЕСТИТЬ ВТ_Объединение
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
		|	И НЕ СчетФактураВыданный.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетФактураВыданный.Ссылка,
		|	2,
		|	СчетФактураВыданный.ДокументОснование
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВТ_Объединение.Приоритет) КАК Приоритет
		|ПОМЕСТИТЬ ВТ_Приоритет
		|ИЗ
		|	ВТ_Объединение КАК ВТ_Объединение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВТ_Объединение.Ссылка КАК Ссылка
		|ИЗ
		|	ВТ_Объединение КАК ВТ_Объединение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Приоритет КАК ВТ_Приоритет
		|		ПО ВТ_Объединение.Приоритет = ВТ_Приоритет.Приоритет";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокСсылка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции //-- смарт:ММ 04.07.2021

