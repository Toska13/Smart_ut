Функция ПартнерПринадлежитСегменту(Партнер, Сегмент) Экспорт

	Принадлежит = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Партнер) ИЛИ НЕ ЗначениеЗаполнено(Сегмент) Тогда
		Возврат Принадлежит;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПартнерыСегмента.Партнер КАК Партнер
	|ИЗ
	|	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
	|ГДЕ
	|	ПартнерыСегмента.Сегмент = &Сегмент
	|	И ПартнерыСегмента.Партнер = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Сегмент", Сегмент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Принадлежит = НЕ РезультатЗапроса.Пустой();
	
	Возврат Принадлежит;
	
КонецФункции //-- смарт:ММ 10.09.2021

