//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПолучитьПредопределенноеЗначениеТЧСписокЗначений(СсылкаНаПредопределенноеЗначение) Экспорт

    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	смартПредопределенныеЗначенияТЧСписокЗначений.к1 КАК К1,
        |	смартПредопределенныеЗначенияТЧСписокЗначений.к2 КАК К2,
        |	смартПредопределенныеЗначенияТЧСписокЗначений.к3 КАК К3,
        |	смартПредопределенныеЗначенияТЧСписокЗначений.к4 КАК К4
        |ИЗ
        |	Справочник.смартПредопределенныеЗначения.ТЧСписокЗначений КАК смартПредопределенныеЗначенияТЧСписокЗначений
        |ГДЕ
        |	смартПредопределенныеЗначенияТЧСписокЗначений.Ссылка = &Ссылка
        |	И смартПредопределенныеЗначенияТЧСписокЗначений.Ссылка.ИспользоватьТЧСписокЗначений";
	
	Если ТипЗнч(СсылкаНаПредопределенноеЗначение) = Тип("СправочникСсылка.смартПредопределенныеЗначения") Тогда
		Настройка = СсылкаНаПредопределенноеЗначение;
	ИначеЕсли ТипЗнч(СсылкаНаПредопределенноеЗначение) = Тип("Строка") Тогда
		Попытка
			Настройка = Справочники.смартПредопределенныеЗначения[СсылкаНаПредопределенноеЗначение];
		Исключение
			Настройка = Справочники.смартПредопределенныеЗначения.ПустаяСсылка();
		КонецПопытки;	
	Иначе
		Настройка = Справочники.смартПредопределенныеЗначения.ПустаяСсылка();
	КонецЕсли;
	Запрос.УстановитьПараметр("Ссылка", Настройка);

    МассивРезультат = Новый Массив;
	
    ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
    
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Структура = Новый Структура("К1, К2, К3, К4"); 
		
		ЗаполнитьЗначенияСвойств(Структура, ВыборкаДетальныеЗаписи);
		
		МассивРезультат.Добавить(Структура);
		
	КонецЦикла;
    
    Возврат МассивРезультат;
    
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартДействуетОсобыйУчетСерий(ОбъектПроверкиСсылка) Экспорт

	ОсобыйУчетСерий = Ложь;
	ВидНоменклатуры = Неопределено;
	
	Если ЗначениеЗаполнено(ОбъектПроверкиСсылка) Тогда
		
		Если ТипЗнч(ОбъектПроверкиСсылка) = Тип("СправочникСсылка.Номенклатура") Тогда                                   
		    ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектПроверкиСсылка, "ВидНоменклатуры", Истина);
		ИначеЕсли ТипЗнч(ОбъектПроверкиСсылка) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
	        ВидНоменклатуры = ОбъектПроверкиСсылка;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		
			МассивСтруктурОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры = смартПолучитьПредопределенноеЗначениеТЧСписокЗначений("ОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры");
			
			Для Каждого СтруктураОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры Из МассивСтруктурОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры Цикл

				Если СтруктураОсобыеУсловияЗаполненияСерийПоВидамНоменклатуры.К1 = ВидНоменклатуры Тогда

					ОсобыйУчетСерий = Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;	

		КонецЕсли;
			
	КонецЕсли;
	
	Возврат ОсобыйУчетСерий;
	
КонецФункции //--#1547 смарт: Лопато 20.11.2023

//++#1547 смарт: Лопато 12.12.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПроверкаЗаказДоДатыНачалаСерийногоУчета(ВыбранноеЗначение, Знач Объект, ИмяФормы, Знач ВыделенныеСтроки) Экспорт

	СтрокаПредупреждение = "";
	
	Если ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ВыборВариантаОбеспечения" Тогда
		
		ДанныеОбеспечения = ВыбранноеЗначение;
		
	ИначеЕсли ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ИсполнениеЗаказа" Тогда
		
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			ДанныеОбеспечения = смартПолучитьТаблицуЗаполнениеОбеспеченияЗаказКлиента(ВыбранноеЗначение, Объект, ВыделенныеСтроки);
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
			ДанныеОбеспечения = смартПолучитьТаблицуЗаполнениеОбеспеченияЗаказНаПеремещение(ВыбранноеЗначение, Объект, ВыделенныеСтроки);
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
			ДанныеОбеспечения = смартПолучитьТаблицуЗаполнениеОбеспеченияЗаказНаСборку(ВыбранноеЗначение, Объект, ВыделенныеСтроки);
		ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
			ДанныеОбеспечения = смартПолучитьТаблицуЗаполнениеОбеспеченияЗаказНаВнутреннееПотребление(ВыбранноеЗначение, Объект, ВыделенныеСтроки);
		Иначе
			Возврат СтрокаПредупреждение;
		КонецЕсли;		
		
	КонецЕсли; 
	
	МассивНоменклатурыДляПроверки = Новый Массив;
	
	Для Каждого СтрокаОбеспечения Из ДанныеОбеспечения Цикл

		Если СтрокаОбеспечения.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить И СтрокаОбеспечения.Количество > 0 Тогда
		
			СтрокаТовары = Объект.Товары.НайтиПоИдентификатору(СтрокаОбеспечения.Идентификатор);

			Если СтрокаТовары <> Неопределено 
				И смартДействуетОсобыйУчетСерий(СтрокаТовары.Номенклатура) Тогда
		
				смартДатаНачалаСерийногоУчетаВременная = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТовары.Номенклатура, "смартДатаНачалаСерийногоУчетаВременная");

				Если ЗначениеЗаполнено(смартДатаНачалаСерийногоУчетаВременная) Тогда
					
					ДатаОбъекта = смартПолучитьДатуОбъектаДляРасчетаСтатусовСерий(СтрокаТовары, , Объект);

					//++#1517 смарт: Лопато 02.04.2024 //Установка статуса указания серий по дате начала серийного учета номенклатуры
					Если ЗначениеЗаполнено(ДатаОбъекта) 
						И НачалоДня(ДатаОбъекта) < НачалоДня(смартДатаНачалаСерийногоУчетаВременная)
						И НачалоДня(ТекущаяДатаСеанса()) > НачалоДня(смартДатаНачалаСерийногоУчетаВременная)
						Тогда
						
						МассивНоменклатурыДляПроверки.Добавить(СтрокаТовары.Номенклатура);
						
					КонецЕсли;
					//--#1517 смарт: Лопато 02.04.2024
					
				КонецЕсли;
				
			КонецЕсли;	
					
		КонецЕсли;	
		
	КонецЦикла;	
	
	МассивНоменклатурыПредупреждение = смартПолучитьНоменклатуруЗаказаБезДокументов(Объект.Ссылка, МассивНоменклатурыДляПроверки);
	
	СтрокаПредупреждениеТовары = "";
	
	Если МассивНоменклатурыПредупреждение.Количество() > 0 Тогда
	
		Для Каждого ЭлементНоменклатура ИЗ МассивНоменклатурыПредупреждение Цикл
			СтрокаПредупреждениеТовары = СтрокаПредупреждениеТовары + СокрЛП(ЭлементНоменклатура) + ", ";
		КонецЦикла;	
		
		Если Прав(СтрокаПредупреждениеТовары, 2) = ", " Тогда
			СтрокаПредупреждениеТовары = Лев(СтрокаПредупреждениеТовары, СтрДлина(СтрокаПредупреждениеТовары) - 2);
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтрокаПредупреждениеТовары) Тогда
		
		СтрокаПредупрежденияЗаказДоДатыНачалаСерийногоУчета = "
			|ВНИМАНИЕ! 
			|
			|Товар """ + СтрокаПредупреждениеТовары + """ 
			|теперь учитывается по партиям (срокам годности). 
			|
			|Для дальнейшей отгрузки товара
			|ОБЯЗАТЕЛЬНО обратитесь в ИТ отдел.
			|
			|Обратиться в поддержку можно любым удобным способом:
			|help1c@smart-t.ru
			|+7(495)993-91-11 (доб. 222)";

		СтрокаПредупреждение = СтрокаПредупреждение + СтрокаПредупрежденияЗаказДоДатыНачалаСерийногоУчета;
			
	КонецЕсли;	
	
	Возврат СтрокаПредупреждение;
	
КонецФункции //--#1547 смарт: Лопато 12.12.2023

//++#1547 смарт: Лопато 12.12.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПолучитьНоменклатуруЗаказаБезДокументов(ЗаказСсылка, МассивНоменклатурыДляПроверки)
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатурыДляПроверки);
	Запрос.УстановитьПараметр("ДокументЗаказ", ЗаказСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток) КАК КОтгрузкеОстаток,
	|	СУММА(ТоварыКОтгрузкеОстатки.КОформлениюОстаток) КАК КОформлениюОстаток,
	|	СУММА(ТоварыКОтгрузкеОстатки.КСборкеОстаток) КАК КСборкеОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
	|			,
	|			Номенклатура В (&Номенклатура)
	|				И ДокументОтгрузки = &ДокументЗаказ) КАК ТоварыКОтгрузкеОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОтгрузкеОстатки.Номенклатура
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток) > 0
	|		ИЛИ СУММА(ТоварыКОтгрузкеОстатки.КОформлениюОстаток) > 0
	|		ИЛИ СУММА(ТоварыКОтгрузкеОстатки.КСборкеОстаток) > 0)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

	Возврат Результат;	

КонецФункции //--#1547 смарт: Лопато 12.12.2023

//++#1517 смарт: Лопато 02.04.2024 //Установка статуса указания серий по дате начала серийного учета номенклатуры
Функция смартПолучитьНоменклатуруЗаказаОтгруженнуюИлиОформленную(ЗаказСсылка, МассивНоменклатурыДляПроверки) Экспорт
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатурыДляПроверки);
	Запрос.УстановитьПараметр("ДокументЗаказ", ЗаказСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыКОтгрузкеОбороты.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Обороты(
	|			,
	|			,
	|			,
	|			Номенклатура В (&Номенклатура)
	|				И ДокументОтгрузки = &ДокументЗаказ) КАК ТоварыКОтгрузкеОбороты
	|ГДЕ
	|	(ТоварыКОтгрузкеОбороты.КОтгрузкеРасход > 0
	|			ИЛИ ТоварыКОтгрузкеОбороты.КОформлениюРасход > 0)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");

	Возврат Результат;	

КонецФункции //--#1517 смарт: Лопато 02.04.2024

//++#1547 смарт: Лопато 14.12.2023 //Автоматическое заполнение серий чернил в заказах
Функция смартПолучитьТаблицуЗаполнениеОбеспеченияЗаказКлиента(ВыбранноеЗначение, Объект, ВыделенныеСтроки) Экспорт

	ПараметрыЗаполнения = Новый Структура("ПереченьВариантов, ИзменятьОбособление, ЗаполнятьЦелымиУпаковками", Неопределено, Истина, Ложь);
	ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыбранноеЗначение);
	
	ПутиКДанным = Новый Соответствие; //Описание особенностей формы
	ПутиКДанным.Вставить("ДатаОтгрузкиРабот", "ДатаОтгрузки"); // дату отгрузки работ необходимо брать из поля "Дата отгрузки".
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("СтатусКВыполнению", Объект.Статус <> Перечисления.СтатусыЗаказовКлиентов.НеСогласован);
	ПараметрыДокумента.Вставить("ГруппаСкладов", Объект.Склад);
	ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыКлиентов);
	ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным);
	
	ТаблицаЗаполнениеОбеспечения = ОбеспечениеСервер.ТаблицаЗаполнениеОбеспечения(ВыделенныеСтроки,
																		Объект,
																		Объект.Товары,
																		ПараметрыЗаполнения,
																		ПараметрыДокумента);
	Возврат ТаблицаЗаполнениеОбеспечения;
	
КонецФункции //--#1547 смарт: Лопато 14.12.2023

