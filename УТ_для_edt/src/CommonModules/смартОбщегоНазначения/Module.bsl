Функция База1сПодключение(Организация) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	смартБазы1С.ИмяИБ КАК ИмяИБ,
	|	смартБазы1С.ИмяСервера КАК ИмяСервера,
	|	смартБазы1С.Пользователь КАК Пользователь,
	|	смартБазы1С.Пароль КАК Пароль
	|ИЗ
	|	Справочник.смартБазы1С КАК смартБазы1С
	|ГДЕ
	|	смартБазы1С.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация",Организация);
	РезЗапроса=Запрос.Выполнить();
	Если РезЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	Выборка=РезЗапроса.Выбрать();
	СтрукутраБД1с=Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		СтрукутраБД1с.Вставить("Сервер",сокрЛП(Выборка.ИмяСервера));
		СтрукутраБД1с.Вставить("База",сокрЛП(Выборка.ИмяИБ));
		СтрукутраБД1с.Вставить("Логин",сокрЛП(Выборка.Пользователь));
		СтрукутраБД1с.Вставить("Пароль",сокрЛП(Выборка.Пароль));
	КонецЦикла; 
	
	Возврат СтрукутраБД1с;
	
КонецФункции // ()
 
//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке
Функция СостоянияСохраненияПечатныхФормРеализацийВБП(ПараметрыПолучения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураПодключенияКБД = База1сПодключение(ПараметрыПолучения.Организация);
	
	Если СтруктураПодключенияКБД = Неопределено Тогда
		Возврат "По организации " + ПараметрыПолучения.Организация + " не указаны настроки подключения к БД Бухгалтерии!";
	КонецЕсли; 
	
	Попытка
		
		Сервер = СтруктураПодключенияКБД.Сервер; 
		База = СтруктураПодключенияКБД.База;
		Логин = СтруктураПодключенияКБД.Логин;
		Пароль = СтруктураПодключенияКБД.Пароль;
		
		СервисИмя = "Reports_buh_smart";
		
		ПроксиWS = ПодключениеК_WS(Сервер, База, Логин, Пароль, СервисИмя);
		
		Если ПроксиWS = Неопределено Тогда
			Возврат "Не удалось подключиться к БД Бухгалтерии!";
		КонецЕсли;
		
		ПараметрыЗапросаБУ = Новый Структура;
		ПараметрыЗапросаБУ.Вставить("ВходящиеДанные", ПараметрыПолучения.ВходящиеДанные);
		
		Сериализатор = Новый СериализаторXDTO(ПроксиWS.ФабрикаXDTO);
		ПараметрыЗапросаXDTO = Сериализатор.ЗаписатьXDTO(ПараметрыЗапросаБУ); 
		
		Запрос =
		"ВЫБРАТЬ
		|	ВходящиеДанные.Номер КАК Номер,
		|	ВходящиеДанные.Дата КАК Дата
		|ПОМЕСТИТЬ ТаблицаПараметров
		|ИЗ
		|	&ВходящиеДанные КАК ВходящиеДанные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартСформированныеПакетыПФ.Документ.Номер КАК Номер,
		|	смартСформированныеПакетыПФ.Документ.Дата КАК Дата
		|ИЗ
		|	РегистрСведений.смартСформированныеПакетыПФ КАК смартСформированныеПакетыПФ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПараметров КАК ТаблицаПараметров
		|		ПО смартСформированныеПакетыПФ.Документ.Номер = ТаблицаПараметров.Номер
		|			И смартСформированныеПакетыПФ.Документ.Дата = ТаблицаПараметров.Дата
		|ГДЕ
		|	смартСформированныеПакетыПФ.Документ.Проведен 
		|	И смартСформированныеПакетыПФ.ПакетСформирован"; 
		
		
		ТаблицаХОПрокси = ПроксиWS.ПолучитьТаблицуРезультатаЗапроса(Запрос, ПараметрыЗапросаXDTO);
		//ТаблицаХОПрокси = ПроксиWS.ПолучитьДеревоРезультатаЗапроса(Запрос, ПараметрыЗапросаXDTO);
		
		Возврат Сериализатор.ПрочитатьXDTO(ТаблицаХОПрокси);  
		
	Исключение
		
		Возврат "По организации " + ПараметрыПолучения.Организация + " не удалось получить данные по формированию пакета документов в БД Бухгалтерии: " + Символы.ПС + ОписаниеОшибки(); 
		
	КонецПопытки;
		
	
КонецФункции //++ #1766 смарт: Мосолов 09.04.2024 

//++ смарт:ММ #099 409 26.03.2021 Регламентное обслуживание - уже не используется в блоке регл.обслуживания. 
Функция ДобавитьКДатеРабочиеДни(ДатаНач, ЧислоРабочихДней) экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ВЫБОР
	|        КОГДА ДанныеПроизводственногоКалендаря.ВидДня = &РабочийДень
	|                ИЛИ ДанныеПроизводственногоКалендаря.ВидДня = &ПредпраздничныйДень
	|            ТОГДА 1
	|        ИНАЧЕ 0
	|    КОНЕЦ КАК ЧислоРабочихДней,
	|    ДанныеПроизводственногоКалендаря.Дата КАК ДатаКалендаря
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|    РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
	|ГДЕ
	|    ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь.Код = ""РФ""
	|    И ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    ТЗ.ДатаКалендаря,
	|    СУММА(ТЗ1.ЧислоРабочихДней) КАК ЧислоРабочихДней
	|ПОМЕСТИТЬ ТЗНакопл
	|ИЗ
	|    ТЗ КАК ТЗ
	|        ЛЕВОЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ1
	|        ПО (ТЗ1.ДатаКалендаря <= ТЗ.ДатаКалендаря)
	|
	|СГРУППИРОВАТЬ ПО
	|    ТЗ.ДатаКалендаря
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|    МАКСИМУМ(ТЗ.ДатаКалендаря) КАК ДатаКалендаря
	|ИЗ
	|    ТЗНакопл КАК ТЗ
	|ГДЕ
	|    ТЗ.ЧислоРабочихДней = &ЧислоРабочихДней";
	
	Запрос.УстановитьПараметр("ДатаНач", ДатаНач);
	ЧислоНедель = Цел(ЧислоРабочихДней /5 + 0.5);
	ЧислоВыходныхДней = ЧислоНедель * 2;
	МаксимальноеКоличествоПраздничныхДнейПодряд = 8; //РождественскиеКаникулы
	ДатаКон = ДатаНач + (ЧислоВыходныхДней + ЧислоРабочихДней + МаксимальноеКоличествоПраздничныхДнейПодряд)*24*60*60;
	
	Запрос.УстановитьПараметр("ДатаКон", 				ДатаКон);
	Запрос.УстановитьПараметр("ЧислоРабочихДней", 		ЧислоРабочихДней);
	Запрос.УстановитьПараметр("РабочийДень",         	Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	Запрос.УстановитьПараметр("ПредпраздничныйДень", 	Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = 0;
	
	Если Выборка.Следующий() Тогда
		Если ТипЗнч(Выборка.ДатаКалендаря) = Тип("Дата") Тогда
			Результат = КонецДня(Выборка.ДатаКалендаря) + 1; 
		КонецЕсли;
	Конецесли;    
	
	Возврат Результат;
	
КонецФункции 

