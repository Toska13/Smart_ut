//++#1323 смарт: Лопато 15.03.2023 //Восстановить и переделать механизм индивидуальных скидок
Функция смартПолучитьИндивидуальныеСкидкиКлиентов(ДатаСкидок = Неопределено, Клиенты = Неопределено, Номенклатура = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаСкидок) Тогда
		ДатаСкидок = ТекущаяДата();
	КонецЕсли;	
	
	ЗапросСкидки = Новый Запрос;

	ТекстЗапросСкидки =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Период КАК НачалоДействия,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Клиент КАК Клиент,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Номенклатура КАК Номенклатура,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки КАК ПроцентСкидки,
		|	0 КАК СуммаСкидки,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Регистратор КАК Регистратор,
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
		|	ВЫРАЗИТЬ(смартИндивидуальныеСкидкиКлиентовСрезПоследних.Регистратор.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
		//-- #1870 смарт: Лопато 25.08.2024
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Ответственный КАК Ответственный,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.СрокДействия КАК СрокДействия
		|ИЗ
		|	РегистрСведений.смартИндивидуальныеСкидкиКлиентов.СрезПоследних(&Дата, &ОтборКлиент И &ОтборНоменклатура) КАК смартИндивидуальныеСкидкиКлиентовСрезПоследних
		|ГДЕ
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Клиент,
		|	Номенклатура
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	ЗапросСкидки.УстановитьПараметр("Дата",   ДатаСкидок);
	
	Если Клиенты <> Неопределено Тогда
		ЗапросСкидки.УстановитьПараметр("Клиенты", Клиенты);
		ТекстЗапросСкидки = СтрЗаменить(ТекстЗапросСкидки, "&ОтборКлиент", "Клиент В(&Клиенты)");
	Иначе
		ТекстЗапросСкидки = СтрЗаменить(ТекстЗапросСкидки, "&ОтборКлиент", "ИСТИНА");
	КонецЕсли;

	Если Номенклатура <> Неопределено Тогда
		ЗапросСкидки.УстановитьПараметр("Номенклатура", Номенклатура);
		ТекстЗапросСкидки = СтрЗаменить(ТекстЗапросСкидки, "&ОтборНоменклатура", " Номенклатура В(&Номенклатура)");
	Иначе
		ТекстЗапросСкидки = СтрЗаменить(ТекстЗапросСкидки, "&ОтборНоменклатура", " ИСТИНА");
	КонецЕсли;
	
	ЗапросСкидки.Текст = ТекстЗапросСкидки; 
	РезультатЗапроса = ЗапросСкидки.Выполнить();

	ТаблицаСкидокРезультат = РезультатЗапроса.Выгрузить();
				
	Возврат ТаблицаСкидокРезультат;	
	
КонецФункции //--#1323 смарт: Лопато 15.03.2023	

//++#1356 смарт: Лопато 14.06.2024 //Исправление автоматического расчета скидок в заказах клиентов
Функция смартПолучитьИндивидуальнуюСкидкуКлиентаПоНоменклатуре(Дата, Партнер, Номенклатура) Экспорт

