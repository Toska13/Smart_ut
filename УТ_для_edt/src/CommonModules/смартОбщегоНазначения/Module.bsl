Функция ПолучитьПрибавитьКДатеКоличествоРабочихДней(Знач ДатаОт,Знач КолДней)Экспорт
	Если КолДней=0 Тогда 
		Возврат ДатаОт;
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Дата",ДатаОт);
	Запрос.УстановитьПараметр("Календарь",Справочники.Календари.НайтиПоНаименованию("Российская Федерация",Истина));
	Запрос.УстановитьПараметр("Год",Год(ДатаОт));
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 5
	|	КалендарныеГрафики.ДатаГрафика КАК Дата
	|	ПОМЕСТИТЬ ВТ
	|ИЗ
	|РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	|ГДЕ
	|КалендарныеГрафики.Календарь=&Календарь
	|И КалендарныеГрафики.ДатаГрафика > &Дата
	|И КалендарныеГрафики.ДеньВключенВГрафик
	|И КалендарныеГрафики.Год >= &Год
	|;   
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ.Дата) КАК Дата
	|ИЗ
	|ВТ КАК ВТ";
	
	СхемаЗапроса=Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	СхемаЗапроса.ПакетЗапросов[0].Операторы[0].КоличествоПолучаемыхЗаписей=?(КолДней<0,-КолДней,КолДней);
	Если КолДней<0 Тогда 
		ПорядокСортировки=СхемаЗапроса.ПакетЗапросов[0].Порядок.Добавить("Дата");
		ПорядокСортировки.Направление=НаправлениеПорядкаСхемыЗапроса.ПоУбыванию;
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор[1]=Новый ВыражениеСхемыЗапроса("КалендарныеГрафики.ДатаГрафика < &Дата");
		
		СхемаЗапроса.ПакетЗапросов[1].Операторы[0].ВыбираемыеПоля[0]=Новый ВыражениеСхемыЗапроса("МИНИМУМ(ВТ.Дата)");
	КонецЕсли;
	Запрос.Текст=СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		//++ смарт:Каратеев #1297 09.01.2023//Заплатка для исправления ошибки сравнения типов, когда Рез.Дата = null
		//Лучше потом переделать всю эту функцию, сейчас запрос не учитывает год
		Возврат ?(ЗначениеЗаполнено(Рез.Дата),Рез.Дата,ДатаОт);
		//-- смарт:Каратеев #1297 09.01.2023
	КонецЕсли;
	Возврат ДатаОт;
КонецФункции

