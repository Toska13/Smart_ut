			|	И смартЛогинНаСайте <> """"
			|	И смартЛогинНаСайте = &ПредставлениеКИ
			//++ #Б-5452 смарт: Фролов 30.01.2026 //Заполнение адреса электронной почты в карточке контакта, если зафиксирована привязка к лк интернет-магазина
			|	И 2 = 2
			//-- #Б-5452 смарт: Фролов 30.01.2026
			|
			|ОБЪЕДИНИТЬ
			|
			//-- #Б-2314 смарт: Лопато 17.02.2025
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	""Клиента"",
			|	ОбъектВыборки.Вид,
			|	ОбъектВыборки.Ссылка,
			|	ОбъектВыборки.Ссылка.Представление,
			|	ОбъектВыборки.Ссылка.Представление
			|ИЗ
			|	Справочник.Партнеры.КонтактнаяИнформация КАК ОбъектВыборки
			|ГДЕ
			|	НЕ ОбъектВыборки.Ссылка.ПометкаУдаления
			|	И ОбъектВыборки.Ссылка <> &Партнер
			|	И ОбъектВыборки.Тип = &ТипКИ
			|	И ВЫБОР 
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) ТОГДА 
			|			ОбъектВыборки.АдресЭП = &ПредставлениеКИ
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) ТОГДА 
			|			ОбъектВыборки.НомерТелефона = &ПредставлениеКИ
			|        ИНАЧЕ 
			|			ЛОЖЬ 
			|	  КОНЕЦ
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	""Контрагента"",
			|	ОбъектВыборки.Вид,
			|	ОбъектВыборки.Ссылка,
			|	ОбъектВыборки.Ссылка.Представление,
			|	ОбъектВыборки.Ссылка.Партнер.Представление
			|ИЗ
			|	Справочник.Контрагенты.КонтактнаяИнформация КАК ОбъектВыборки
			|ГДЕ
			|	НЕ ОбъектВыборки.Ссылка.ПометкаУдаления
			|	И НЕ ОбъектВыборки.Ссылка В(ВЫБРАТЬ Контрагент ИЗ ВТ_Контрагенты)
			|	И ОбъектВыборки.Ссылка.Партнер <> &Партнер
			|	И ОбъектВыборки.Тип = &ТипКИ
			|	И ВЫБОР 
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) ТОГДА 
			|			ОбъектВыборки.АдресЭП = &ПредставлениеКИ
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) ТОГДА 
			|			ОбъектВыборки.НомерТелефона = &ПредставлениеКИ
			|        ИНАЧЕ 
			|			ЛОЖЬ 
			|	  КОНЕЦ";
		
		Если ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.КонтактныеЛицаПартнеров") Тогда
			
			Партнер = ПараметрыКИ.Владелец;

			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",     "Партнер = &Партнер");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтактноеЛицо", "Ссылка = &Ссылка");
			
			//++ #Б-5452 смарт: Фролов 30.01.2026 //Заполнение адреса электронной почты в карточке контакта, если зафиксирована привязка к лк интернет-магазина
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "НЕ КЛДанныеСайтаТелефон.КонтактноеЛицо = &Ссылка");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "НЕ КЛДанныеСайтаПочта.КонтактноеЛицо = &Ссылка");
			//-- #Б-5452 смарт: Фролов 30.01.2026
			
		ИначеЕсли ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Партнеры") Тогда
			
			Партнер = ПараметрыКИ.Ссылка;	

			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",     "Партнер = &Партнер");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтактноеЛицо", "Владелец = &Партнер");
			
		ИначеЕсли ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Партнер = ПараметрыКИ.Владелец;

			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",     "Ссылка = &Контрагент");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтактноеЛицо", "Владелец = &Партнер");
			
			Запрос.УстановитьПараметр("Контрагент", ПараметрыКИ.Ссылка);
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Партнер", Партнер);
		
	Иначе
		
		Если ПараметрыКИ.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			
			Возврат МассивРезультат;
			
		КонецЕсли;	
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	""Справочника"" КАК Представление,
			|	ОбъектВыборки.Вид КАК Вид,
			|	ОбъектВыборки.Ссылка КАК Ссылка,
			|	ОбъектВыборки.Ссылка.Представление КАК ПредставлениеСсылки
			|ИЗ
			|	Справочник.%СправочникДляПроверки%.КонтактнаяИнформация КАК ОбъектВыборки
			|ГДЕ
			|	НЕ ОбъектВыборки.Ссылка.ПометкаУдаления
			|	И ОбъектВыборки.Ссылка <> &Ссылка
			|	И ОбъектВыборки.Тип = &ТипКИ
			|	И ВЫБОР 
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты) ТОГДА 
			|			ОбъектВыборки.АдресЭП = &ПредставлениеКИ
			|	 	 КОГДА ОбъектВыборки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон) ТОГДА 
			|			ОбъектВыборки.НомерТелефона = &ПредставлениеКИ
			|        ИНАЧЕ 
			|			ЛОЖЬ 
			|	  КОНЕЦ";

		ВидСправочника = ПолучитьВидСправочника(ПараметрыКИ.Ссылка);
		
		Если НЕ ЗначениеЗаполнено(ВидСправочника) Тогда
			
			Возврат МассивРезультат;
			
		КонецЕсли;	
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%СправочникДляПроверки%", ВидСправочника);
		
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("ПредставлениеКИ", ПараметрыКИ.ПредставлениеКИ);
	Запрос.УстановитьПараметр("ТипКИ", 			 ПараметрыКИ.ТипКИ);
	Запрос.УстановитьПараметр("Ссылка", 		 ПараметрыКИ.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураРезультата = Новый Структура;
		
		ТекстСообщения = "Как """ + СокрЛП(ВыборкаДетальныеЗаписи.Вид) + """ "
						 + ?(ВыборкаДетальныеЗаписи.Представление = "Справочника", 
								 ВыборкаДетальныеЗаписи.Представление + " " + ВидСправочника,
								 ВыборкаДетальныеЗаписи.Представление)
						 + " """ + ВыборкаДетальныеЗаписи.ПредставлениеСсылки + """";
		
		Если (ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.КонтактныеЛицаПартнеров")
			ИЛИ ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Партнеры")
			ИЛИ ТипЗнч(ПараметрыКИ.Ссылка) = Тип("СправочникСсылка.Контрагенты"))
			И ВыборкаДетальныеЗаписи.Представление <> "Клиента" Тогда
			
			ТекстСообщения = ТекстСообщения + " у клиента """ + ВыборкаДетальныеЗаписи.ПредставлениеПартнер + """";
			
		КонецЕсли;	
		
		СтруктураРезультата.Вставить("ТекстСообщения", ТекстСообщения);													   
		СтруктураРезультата.Вставить("Ключ", 		   ВыборкаДетальныеЗаписи.Ссылка);
		
		МассивРезультат.Добавить(СтруктураРезультата);
						  
	КонецЦикла;

	Возврат МассивРезультат;
	
КонецФункции //-- #1152 смарт: Лопато 18.10.2024

Функция ПолучитьВидСправочника(Ссылка)

	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат "Контрагенты";	
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда 
	    Возврат "Организации";	
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Партнеры") Тогда 
	    Возврат "Партнеры";		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Пользователи") Тогда 
	    Возврат "Пользователи";			
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.ФизическиеЛица") Тогда 
	    Возврат "ФизическиеЛица";			
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.CRM_ПотенциальныеКлиенты") Тогда 
	    Возврат "CRM_ПотенциальныеКлиенты";			
	//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
	Иначе
		Возврат "";
	//-- #1152 смарт: Лопато 18.10.2024	
	КонецЕсли;

КонецФункции 

//++#1256 смарт: Лопато 03.06.2024 //Изменить проверку на дубли email при вводе в Контактном лице (продолжение задачи 1012)  
Функция АдресЭлПочтыПроверкаСВыводомСообщений(Знач Адрес, Ссылка, Владелец = Неопределено, РазрешитьЛокальныеАдреса = Ложь) Экспорт
//--#1256 смарт: Лопато 03.06.2024
	
	ВозврСтруктура = Новый Структура();
	ВозврСтруктура.Вставить("СообщениеОшибки", "");
	ВозврСтруктура.Вставить("КодОшибки", 0);
	
	// Коды Ошибок
	СообщениеПроверкаСобака					= НСтр("ru='В адресе электронной почты должен быть один символ @'");
	СообщениеПроверкаДвоеточие				= НСтр("ru='В адресе электронной почты может быть только один символ :'");
	СообщениеДвеТочки						= НСтр("ru='В адресе электронной почты нельзя ставить две точки подряд'");
	СообщениеНедопустимыеСимволы			= НСтр("ru='Допускается использование букв, цифр, английского и русского алфавита(если .рф)"
"Недопустимые символы в адресе электронной почты."
"Адреса электронной почты не должен содержать: !#$%^&*()+`~|\/=;,ПРОБЕЛ'");
	СообщениеНеверныйФорматПочтовогоАдреса	= НСтр("ru='Домен(после @) и локальное имя не могут быть пустыми. Также длина домена должна быть не более 255 символов, локального имени - 64'");
	СообщениеСимволыВокругДомена			= НСтр("ru='В начале и в конце домена (например .ru) не может быть символов .@_-:+'");
	СообщениеМинимумОднаТочка				= НСтр("ru='В домене (после @) должна быть минимум одна точка'");
	СообщениеПодчеркиваниеВДомене			= НСтр("ru='В домене (после @) не должно быть символа подчеркивания'");
	СообщениеДвоеточиеВДомене				= НСтр("ru='В домене (после @) не должно быть символа двоеточие'");
	СообщениеПлюсВДомене					= НСтр("ru='В домене (после @) не должно быть символа +'");
	СообщениеФорматЗоны						= НСтр("ru='Формат зона домена(например ru, com): минимум 2 символа, только буквы'");
	СообщениеНаличиеДублей					= НСтр("ru='Данный адрес уже закреплён за: '");
	СообщениеНеВалиден						= НСтр("ru='Данный адрес не существует'");
	
	// Допустимые символы для email.
	Буквы = "abcdefghijklmnopqrstuvwxyz";
	СимволыРусскогоАлфавита = "ёйцукенгшщзхъфывапролджэячсмитьбю"; 
	Цифры = "0123456789";
	СпецСимволы = ".@_-:+";
	
	// проверяем символ @
	Если СтрЧислоВхождений(Адрес, "@") <> 1 Тогда
		ВозврСтруктура.КодОшибки = 1;
		ВозврСтруктура.СообщениеОшибки = СообщениеПроверкаСобака; 
		Возврат ВозврСтруктура; 
	КонецЕсли;
	
	// Разрешаем двоеточие только один раз.
	Если СтрЧислоВхождений(Адрес, ":") > 1 Тогда
		ВозврСтруктура.КодОшибки = 2;
		ВозврСтруктура.СообщениеОшибки = СообщениеПроверкаДвоеточие; 
		Возврат ВозврСтруктура; 
	КонецЕсли;
	
	// проверяем две точки подряд
	Если СтрНайти(Адрес, "..") > 0 Тогда
		ВозврСтруктура.КодОшибки = 3;
		ВозврСтруктура.СообщениеОшибки = СообщениеДвеТочки; 
		Возврат ВозврСтруктура; 
	КонецЕсли;
	
	// Приводим строку адреса к нижнему регистру.
	Адрес = НРег(Адрес);
	
	// Разбираем адрес на local-part и domain.
	Позиция = СтрНайти(Адрес,"@");
	ЛокальноеИмя = Лев(Адрес, Позиция - 1);
	Домен = Сред(Адрес, Позиция + 1);
	
	// В домене должна быть минимум одна точка.
	Если Не РазрешитьЛокальныеАдреса И СтрНайти(Домен,".") = 0 Тогда
		ВозврСтруктура.КодОшибки = 7;
		ВозврСтруктура.СообщениеОшибки = СообщениеМинимумОднаТочка; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// Проверяем на заполненность и допустимость длины.
	Если ПустаяСтрока(ЛокальноеИмя)
	 	Или ПустаяСтрока(Домен)
		Или СтрДлина(ЛокальноеИмя) > 64
		Или СтрДлина(Домен) > 255 Тогда
		
		ВозврСтруктура.КодОшибки = 5;
		ВозврСтруктура.СообщениеОшибки = СообщениеНеверныйФорматПочтовогоАдреса; 
		Возврат ВозврСтруктура;
	КонецЕсли;

	// Выделяем зону (TLD) из имени домена.
	Зона = Домен;
	Позиция = СтрНайти(Зона,".");
	Пока Позиция > 0 Цикл
		Зона = Сред(Зона, Позиция + 1);
		Позиция = СтрНайти(Зона,".");
	КонецЦикла;
	
	// Проверяем зону домена (минимум 2 символа, только буквы).
	Если Прав(Адрес,3) = ".рф" Тогда
		Буквы = Буквы + СимволыРусскогоАлфавита;
	КонецЕсли;
	
	Если НЕ (РазрешитьЛокальныеАдреса Или СтрДлина(Зона) >= 2 И СтрокаСодержитТолькоДопустимыеСимволы(Зона,Буквы)) Тогда
	
		ВозврСтруктура.КодОшибки = 11;
		ВозврСтруктура.СообщениеОшибки = СообщениеФорматЗоны; 
		Возврат ВозврСтруктура;
	
	КонецЕсли;
	
	// Проверяем допустимые символы.
	Если СтрДлина(Зона) >= 2 И Прав(Адрес,3) = ".рф" Тогда
		ДопустимыеСимволы = Буквы + Цифры + СпецСимволы + СимволыРусскогоАлфавита;
	Иначе 
		ДопустимыеСимволы = Буквы + Цифры + СпецСимволы;		
	КонецЕсли;
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(Адрес, ДопустимыеСимволы) Тогда
		ВозврСтруктура.КодОшибки = 4;
		ВозврСтруктура.СообщениеОшибки = СообщениеНедопустимыеСимволы; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// Проверяем наличие спецсимволов в начале и в конце домена.
	Если ЕстьСимволыВНачалеВКонце(Домен, СпецСимволы) Тогда
		ВозврСтруктура.КодОшибки = 6;
		ВозврСтруктура.СообщениеОшибки = СообщениеСимволыВокругДомена; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// В домене не должно быть символа подчеркивания.
	Если СтрНайти(Домен,"_") > 0 Тогда
		ВозврСтруктура.КодОшибки = 8;
		ВозврСтруктура.СообщениеОшибки = СообщениеПодчеркиваниеВДомене; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// В домене не должно быть символа двоеточие.
	Если СтрНайти(Домен,":") > 0 Тогда
		ВозврСтруктура.КодОшибки = 9;
		ВозврСтруктура.СообщениеОшибки = СообщениеДвоеточиеВДомене; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// В домене не должно быть символа "плюс".
	Если СтрНайти(Домен,"+") > 0 Тогда
		ВозврСтруктура.КодОшибки = 10;
		ВозврСтруктура.СообщениеОшибки = СообщениеПлюсВДомене; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
	//Проверяем на наличие дублей
	СтруктураПараметровКИ = Новый Структура;

	СтруктураПараметровКИ.Вставить("Ссылка", 		  Ссылка);
	СтруктураПараметровКИ.Вставить("ПредставлениеКИ", Адрес);
	СтруктураПараметровКИ.Вставить("ТипКИ", 		  Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	СтруктураПараметровКИ.Вставить("Владелец", 		  Владелец);
	
	МассивСтруктурДублей = ПолучитьДублиПоКонтактнойИнформацииСправочников(СтруктураПараметровКИ);
		
	Если МассивСтруктурДублей.Количество() > 0  Тогда

		ВозврСтруктура.КодОшибки = 12;
		ВозврСтруктура.СообщениеОшибки = "Данный адрес электронной почты уже используется:" + Символы.ПС;

		ВозврСтруктура.Вставить("МассивДублей", МассивСтруктурДублей);
		
		Возврат ВозврСтруктура;
		
	КонецЕсли;
	//-- #1152 смарт: Лопато 18.10.2024
	
	//Проверка адреса на валидность
	//++#1012 смарт: Каратеев 14.09.2022 // ПроверитьАдресНаВалидность Отключена
	//Функция временно не используется, так как занимает слишком длительное время для проверки.
	//Перед началом использования необходимо решить вопрос скорости получения ответа.
	
	//АдресСуществует = ПроверитьАдресНаВалидность(Адрес);
	//Если НЕ АдресСуществует Тогда
	//
	//	ВозврСтруктура.КодОшибки = 13;
	//	ВозврСтруктура.СообщениеОшибки = СообщениеНеВалиден; 
	//	Возврат ВозврСтруктура;
	//	
	//КонецЕсли;
	
	//--#1012 смарт: Каратеев 14.09.2022 // ПроверитьАдресНаВалидность Отключена
	
	Возврат ВозврСтруктура;
	
КонецФункции

Функция СтрокаСодержитТолькоДопустимыеСимволы(Строка, ДопустимыеСимволы)
	МассивСимволов = Новый Массив;
	Для Позиция = 1 По СтрДлина(ДопустимыеСимволы) Цикл
		МассивСимволов.Добавить(Сред(ДопустимыеСимволы,Позиция,1));
	КонецЦикла;
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если МассивСимволов.Найти(Сред(Строка, Позиция, 1)) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции 

Функция ЕстьСимволыВНачалеВКонце(Строка, ПроверяемыеСимволы)
	
	Для Позиция = 1 По СтрДлина(ПроверяемыеСимволы) Цикл
		Символ = Сред(ПроверяемыеСимволы, Позиция, 1);
		СимволНайден = (Лев(Строка,1) = Символ) Или (Прав(Строка,1) = Символ);
		Если СимволНайден Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

