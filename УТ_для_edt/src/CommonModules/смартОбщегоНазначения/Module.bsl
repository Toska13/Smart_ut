КонецФункции //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Функция ПодготовитьПараметрыЗвонка(ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(ДополнительныеПараметры.СсылкаНаОбъект) Тогда
		НаименованиеКонтакта = сфпСофтФонПроСервер.сфпПолучитьНаименованиеКонтакта(ДополнительныеПараметры.СсылкаНаОбъект);
		Если НЕ (ТипЗнч(ДополнительныеПараметры.СсылкаНаОбъект) = Тип("Строка")) Тогда
			ВладелецКонтакта	= сфпСофтФонПроСервер.сфпПолучитьВладельцаКонтакта(ДополнительныеПараметры.СсылкаНаОбъект);
			ИзображениеКонтакта	= сфпСофтФонПроСервер.сфпПолучитьАватарКонтакта(ДополнительныеПараметры.СсылкаНаОбъект, Истина);	
	    КонецЕсли;
	КонецЕсли;

	ДополнительныеПараметры.Вставить("Дата", ТекущаяДата());

	ДополнительныеПараметры.Вставить("НаименованиеКонтакта", НаименованиеКонтакта);
	ДополнительныеПараметры.Вставить("ВладелецКонтакта", 	 ВладелецКонтакта);
	ДополнительныеПараметры.Вставить("ИзображениеКонтакта",  ИзображениеКонтакта);
	
	ДополнительныеПараметры.Вставить("Пользователь", ПользователиКлиентСервер.АвторизованныйПользователь());
    
	//++#1651 смарт: Лопато 17.04.2024 //Телефония. Хранение истории контактной информации пользователей  
	ДополнительныеПараметры.Вставить("ПользовательВнутреннийНомер", 
		УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДополнительныеПараметры.Пользователь,
																	Справочники.ВидыКонтактнойИнформации.смартРабочийТелефон));
	
	ДополнительныеПараметры.Вставить("ПользовательВнутреннийНомерВАТС", 
		УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДополнительныеПараметры.Пользователь, 
																	Справочники.ВидыКонтактнойИнформации.смартВнутреннийНомерВАТС));
	//--#1651 смарт: Лопато 17.04.2024
	
	//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
	ДополнительныеПараметры.Вставить("ПользовательВнутреннийНомерВАТСДополнительный", 
		УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ДополнительныеПараметры.Пользователь, 
																	Справочники.ВидыКонтактнойИнформации.смартВнутреннийНомерВАТСДополнительный));
	//-- #Б-6744 смарт: Фролов 28.05.2026																
	
	ДополнительныеПараметры.Телефон = СтрЗаменить(ДополнительныеПараметры.Телефон, "+7", "8");
	
	Возврат ДополнительныеПараметры;
	
КонецФункции //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Процедура смартОбработатьИсходящийЗвонок(ПараметрыЗвонка, Ответ) Экспорт
	
	//++#1359 смарт: балашов 23.05.2023 //записывать ID звонка
	Если Ответ <> Неопределено Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ);
		СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
		//++#1359 смарт: Лопато 29.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
		Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда
			Если ПараметрыЗвонка.ИмяМетода = "ClickToCall" И СтруктураИзJSON.Свойство("Uniqueid") Тогда
				ИдентификаторЗвонкаВАТС = СокрЛП(СтрЗаменить(СтруктураИзJSON.Uniqueid, "Event", ""));
			ИначеЕсли ПараметрыЗвонка.ИмяМетода = "MakeCall" И СтруктураИзJSON.Свойство("callid") Тогда
				ИдентификаторЗвонкаВАТС = СтруктураИзJSON["callid"];
			Иначе
				ИдентификаторЗвонкаВАТС = Неопределено;
			КонецЕсли;	
		Иначе
			ИдентификаторЗвонкаВАТС = Неопределено;
		КонецЕсли;	
		//--#1359 смарт: Лопато 29.09.2023
	Иначе
		ИдентификаторЗвонкаВАТС = Неопределено;	
	КонецЕсли;	
	//--#1359 смарт: балашов 23.05.2023
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументТелефонныйЗвонок = сфпСофтФонПроСервер.СоздатьТелефонныйЗвонок(ПараметрыЗвонка.СсылкаНаОбъект, ПараметрыЗвонка.Телефон, 
																		   ПараметрыЗвонка.Пользователь, ПараметрыЗвонка.Пользователь, 
																		   ПараметрыЗвонка.ИсходящийНомер, Ложь, ПараметрыЗвонка.Дата, 
															//++#1359 смарт: балашов 23.05.2023 //добавил ID звонка  
																		   ИдентификаторЗвонкаВАТС);
															//--#1359 смарт: балашов 23.05.2023 

	//++#1359 смарт: Балашов 18.07.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk) 
	Если ПараметрыЗвонка.Свойство("ДанныеЗаполнения") и ЗначениеЗаполнено(ПараметрыЗвонка.ДанныеЗаполнения) Тогда
		СтруктураЗаполнения = ПараметрыЗвонка.ДанныеЗаполнения;
		Если СтруктураЗаполнения.Свойство("Основание") и ЗначениеЗаполнено(СтруктураЗаполнения.Основание) Тогда
			ТекИнтерес = СтруктураЗаполнения.Основание;
			Если ТипЗнч(ТекИнтерес) = Тип("ДокументСсылка.CRM_Интерес") Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = "
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ 
					|	CRM_ЖурналДокументов.CRM_Интерес КАК Ссылка,
					|	CRM_ЖурналДокументов.ИнтересЯвляетсяОснованием КАК ВведенНаОсновании,
					|	CRM_ЖурналДокументов.ОсновнойИнтерес КАК ОсновнойИнтерес
					|ИЗ
					|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
					|ГДЕ
					|	CRM_ЖурналДокументов.Объект = &Объект
					|	И НЕ CRM_ЖурналДокументов.CRM_Интерес = ЗНАЧЕНИЕ(Документ.CRM_Интерес.ПустаяСсылка)
					|	И CRM_ЖурналДокументов.ГлавнаяЗапись
					|";
				Запрос.УстановитьПараметр("Объект",ДокументТелефонныйЗвонок);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Не Выборка.Следующий() Тогда
					Запрос_1 = Новый Запрос;
					Запрос_1.УстановитьПараметр("Объект"		, ДокументТелефонныйЗвонок);
					Запрос_1.УстановитьПараметр("Клиент"		, ПараметрыЗвонка.ВладелецКонтакта);
					Запрос_1.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
						|	CRM_ЖурналДокументов.ГлавнаяЗапись,
						|	CRM_ЖурналДокументов.Клиент,
						|	CRM_ЖурналДокументов.Объект,
						|	CRM_ЖурналДокументов.CRM_Интерес,
						|	CRM_ЖурналДокументов.ТипОбъекта,
						|	CRM_ЖурналДокументов.Номер,
						|	CRM_ЖурналДокументов.Дата,
						|	CRM_ЖурналДокументов.Организация,
						|	CRM_ЖурналДокументов.Сумма,
						|	CRM_ЖурналДокументов.Валюта,
						|	CRM_ЖурналДокументов.Ответственный,
						|	CRM_ЖурналДокументов.Автор,
						|	CRM_ЖурналДокументов.Описание,
						|	CRM_ЖурналДокументов.Важность,
						|	CRM_ЖурналДокументов.ВходящееИсходящее,
						|	CRM_ЖурналДокументов.ВидСобытия,
						|	CRM_ЖурналДокументов.ПометкаУдаления,
						|	CRM_ЖурналДокументов.Проведен,
						|	CRM_ЖурналДокументов.КонтактноеЛицо,
						|	CRM_ЖурналДокументов.СостояниеСобытия,
						|	CRM_ЖурналДокументов.СостояниеИнтереса,
						|	CRM_ЖурналДокументов.ЕстьПрисоединенныеФайлы
						|ИЗ
						|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
						|ГДЕ
						|	CRM_ЖурналДокументов.Объект = &Объект
						|	И CRM_ЖурналДокументов.Клиент = &Клиент
						|	И CRM_ЖурналДокументов.ГлавнаяЗапись
					    |";
					Выборка_1 = Запрос_1.Выполнить().Выбрать();
					НоваяЗапись = РегистрыСведений.CRM_ЖурналДокументов.СоздатьМенеджерЗаписи();
					Если Выборка_1.Следующий() Тогда
						ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка_1);
						НоваяЗапись.CRM_Интерес		= ТекИнтерес;
						НоваяЗапись.СостояниеИнтереса	= ТекИнтерес.СостояниеИнтереса;
					Иначе
						ТипИсточника	= ТипЗнч(Выборка.Ссылка);
						ТипОбъекта		= CRM_КлиентыСервер.ПолучитьСсылкуПВХОбъектыЖурналаПоТипу(ТипИсточника);
						
						НоваяЗапись.ГлавнаяЗапись		= Истина;
						НоваяЗапись.Клиент			= ПараметрыЗвонка.ВладелецКонтакта;
						НоваяЗапись.Объект			= ДокументТелефонныйЗвонок;
						НоваяЗапись.CRM_Интерес		= ТекИнтерес;
						НоваяЗапись.ТипОбъекта		= ТипОбъекта;
						НоваяЗапись.Номер				= ДокументТелефонныйЗвонок.Номер;
						НоваяЗапись.Дата				= ДокументТелефонныйЗвонок.Дата;
						НоваяЗапись.Автор				= ДокументТелефонныйЗвонок.Автор;
						НоваяЗапись.СостояниеИнтереса	= ТекИнтерес.СостояниеИнтереса;
						
					КонецЕсли;
					
					НоваяЗапись.ОсновнойИнтерес		= истина;
					
					НоваяЗапись.Записать();
					
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	//--#1359 смарт: Балашов 18.07.2023
																
	 
	//++#1359 смарт: балашов 26.05.2023 - лишний вызов. Внутри функции "СоздатьТелефонныйЗвонок" уже происходит запись,
	//так, что комментарю
	//сфпСофтФонПроСервер.ЗаписатьДанныеЗвонка(ДокументТелефонныйЗвонок, 
	//										 //++#1359 смарт: балашов 23.05.2023 //добавил ID звонка  
	//										 ИдентификаторЗвонкаВАТС, 
	//										 //--#1359 смарт: балашов 23.05.2023 //добавил ID звонка  
	//										 ПараметрыЗвонка.Дата, , Ложь, ПараметрыЗвонка.СсылкаНаОбъект, 
	//										 ПараметрыЗвонка.Телефон, ПараметрыЗвонка.ИсходящийНомер, ПараметрыЗвонка.Пользователь);
	//--#1359 смарт: балашов 26.05.2023
	
КонецПроцедуры //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Функция смартПроверитьДоступностьЗвонков() Экспорт

	ТекущийПользователь = ПользователиКлиентСервер.АвторизованныйПользователь();
	
	//++#1651 смарт: Лопато 17.04.2024 //Телефония. Хранение истории контактной информации пользователей  
	смартРабочийТелефон = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
							  ТекущийПользователь, Справочники.ВидыКонтактнойИнформации.смартРабочийТелефон);

	смартВнутреннийНомерВАТС = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
								   ТекущийПользователь, Справочники.ВидыКонтактнойИнформации.смартВнутреннийНомерВАТС);
								   
	//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
	смартВнутреннийНомерВАТСДополнительный = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
								   ТекущийПользователь, Справочники.ВидыКонтактнойИнформации.смартВнутреннийНомерВАТСДополнительный);
													  
	//Возврат ЗначениеЗаполнено(смартРабочийТелефон) ИЛИ ЗначениеЗаполнено(смартВнутреннийНомерВАТС);
	Возврат ЗначениеЗаполнено(смартРабочийТелефон) ИЛИ ЗначениеЗаполнено(смартВнутреннийНомерВАТС) ИЛИ ЗначениеЗаполнено(смартВнутреннийНомерВАТСДополнительный);
	//-- #Б-6744 смарт: Фролов 28.05.2026
	//--#1651 смарт: Лопато 17.04.2024
	
КонецФункции //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Функция ЗначениеВJSON(Значение) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции //--#1352 смарт: Лопато 04.05.2023

// Преобразует строку в формате JSON в значение при помощи метода глобального контекста ПрочитатьJSON.
// См. ограничения в синтакс-помощнике.
// Объекты JSON по умолчанию преобразует в значения типа Соответствие. 
// Имена свойств со значением типа Дата необходимо явно указывать, чтобы было выполнено преобразование.
// Ожидаемый формат дат - ISO (YYYY-MM-DDThh:mm:ssZ).
// 
// Параметры:
//   Строка - Строка - значение в формате JSON.
//   ИменаСвойствСоЗначениямиДата - Строка - имя свойства, содержащее значение типа Дата. Допустимо указывать несколько
//                                           свойств через запятую.
//                                - Массив из Строка 
//   ПрочитатьВСоответствие       - Булево - если Ложь, то объекты JSON будут преобразованы в значение типа Структура.
//   
// Возвращаемое значение:
//  Произвольный
//
Функция JSONВЗначение(Знач Строка, Знач ИменаСвойствСоЗначениямиДата = Неопределено, Знач ПрочитатьВСоответствие = Истина) Экспорт
	
	Если ТипЗнч(ИменаСвойствСоЗначениямиДата) = Тип("Строка") Тогда
		ИменаСвойствСоЗначениямиДата = СтрРазделить(ИменаСвойствСоЗначениямиДата, ", " + Символы.ПС, Ложь);
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Строка);
	
	Возврат ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие, ИменаСвойствСоЗначениямиДата);
	
КонецФункции

//++#1359 смарт: Балашов 13.06.2023 проверка получения значений для подключения    
Функция смартПолучитьПараметрыВАТС(ПараметрыЗвонка = "") Экспорт //#1431 смарт: Лопато 28.08.2023 //Доработать регистрацию звонков в 1С по Ковчегу (интеграция с ВАТС и Asterisk)

	ПредопределенныеДанныеМассив = Метаданные.Справочники.смартПредопределенныеЗначения.ПолучитьИменаПредопределенных();
	//++#1431 смарт: Лопато 28.08.2023 //Доработать регистрацию звонков в 1С по Ковчегу (интеграция с ВАТС и Asterisk)  
	Если (ТипЗнч(ПараметрыЗвонка) = Тип("Строка") И ПараметрыЗвонка = "Ковчег") 
		ИЛИ (ТипЗнч(ПараметрыЗвонка) = Тип("Структура") И ПараметрыЗвонка.Свойство("ИсходящийНомер") И Лев(ПараметрыЗвонка.ИсходящийНомер, 1) = "7") Тогда
		ПостфиксПредопределенныхДанных = "Ковчег";
	Иначе
		ПостфиксПредопределенныхДанных = "";
	КонецЕсли;	

	//++#1359 смарт: Лопато 06.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk) 
	ИмяПредопределенныхДанных = "ВерсияAPIМегафон";
	Индекс = ПредопределенныеДанныеМассив.Найти(ИмяПредопределенныхДанных);
	Если Индекс <> Неопределено И ПараметрыЗвонка.ИмяМетода <> "accounts" Тогда
		ВерсияAPIМегафон = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(ИмяПредопределенныхДанных, Ложь);
	Иначе
		ВерсияAPIМегафон = ""; 
	КонецЕсли;
	
	ИмяПредопределенныхДанных = "АдресРесурсаМегафон" + ВерсияAPIМегафон;
	//--#1359 смарт: Лопато 06.09.2023
	Индекс = ПредопределенныеДанныеМассив.Найти(ИмяПредопределенныхДанных);
	Если Индекс <> Неопределено Тогда
		АдресРесурсаМегафон = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(ИмяПредопределенныхДанных, Ложь);
		Если НЕ ЗначениеЗаполнено(АдресРесурсаМегафон) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не заполнены настройки подключения к АТС по организации " + ?(ПостфиксПредопределенныхДанных = "", "Смарт-Т", "Ковчег"));
			Возврат Неопределено; 
		КонецЕсли;			
	Иначе
		Возврат Неопределено; 
	КонецЕсли;
		
	ИмяПредопределенныхДанных = "СоединениеМегафонВАТС" + ПостфиксПредопределенныхДанных;
	Индекс = ПредопределенныеДанныеМассив.Найти(ИмяПредопределенныхДанных);
	Если Индекс <> Неопределено Тогда
		СоединениеМегафонВАТС = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(ИмяПредопределенныхДанных, Ложь);
		Если НЕ ЗначениеЗаполнено(СоединениеМегафонВАТС) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не заполнены настройки подключения к АТС по организации " + ?(ПостфиксПредопределенныхДанных = "", "Смарт-Т", "Ковчег"));
			Возврат Неопределено; 
		КонецЕсли;			
	Иначе
		Возврат Неопределено; 
	КонецЕсли;	
	
	ИмяПредопределенныхДанных = "ТокенМегафон" + ПостфиксПредопределенныхДанных;;
	Индекс = ПредопределенныеДанныеМассив.Найти(ИмяПредопределенныхДанных);
	Если Индекс <> Неопределено Тогда
		ТокенМегафон = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(ИмяПредопределенныхДанных, Ложь);
		Если НЕ ЗначениеЗаполнено(ТокенМегафон) Тогда
			ОбщегоНазначения.СообщитьПользователю("Не заполнены настройки подключения к АТС по организации " + ?(ПостфиксПредопределенныхДанных = "", "Смарт-Т", "Ковчег"));
			Возврат Неопределено; 
		КонецЕсли;			
	Иначе
		Возврат Неопределено; 
	КонецЕсли;	
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
	ПараметрыВАТС = Новый Структура;
	ПараметрыВАТС.Вставить("Соединение",   СоединениеМегафонВАТС);
	ПараметрыВАТС.Вставить("АдресРесурса", АдресРесурсаМегафон);
	ПараметрыВАТС.Вставить("Токен",        ТокенМегафон);
	//--#1431 смарт: Лопато 28.08.2023

	//++#1359 смарт: Лопато 06.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk) 
	ПараметрыВАТС.Вставить("ВерсияAPIМегафон", ВерсияAPIМегафон);
	//--#1359 смарт: Лопато 06.09.2023
	
	Возврат ПараметрыВАТС;

КонецФункции //--#1359 смарт: Балашов 13.06.2023	

//++#1359 смарт: Лопато 13.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
Функция ПривестиТелефонныйНомерКФормату(ОригТелНомер) Экспорт
	
	ТелНомер = СокрЛП(ОригТелНомер);
	
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, ";");
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, ",");
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, "/");
	
	ТелНомер = СтрЗаменить(ТелНомер, "+7", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, ":7", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, "+8", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, ":8", "7");     
	
	Если СтрДлина(ТелНомер) >= 6 Тогда
		ТелНомер = сфпСофтФонПроСерверПереопределяемый.ПреобразоватьНомерДляКонтактнойИнформации(ТелНомер);
	КонецЕсли;	

	ТелНомер = ТолькоЦифры(ТелНомер);
	
	Если СтрДлина(ТелНомер) = 10 Тогда
		ТелНомер = "7" + ТелНомер;
	КонецЕсли;

	Если Лев(ТелНомер, 1) = "8" И СтрДлина(ТелНомер) = 11 Тогда
		ТелНомер = "7" + Сред(ТелНомер, 2);
	КонецЕсли;

	Возврат ТелНомер;	

КонецФункции //--#1359 смарт: Лопато 13.09.2023

//++#1359 смарт: Лопато 13.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
Функция ПолучитьСтрокуДоСимвола(ТелНомер, Символ) Экспорт

	Если СтрНайти(ТелНомер, Символ) > 0 Тогда
		ТелНомер = Лев(ТелНомер, СтрНайти(ТелНомер, Символ) - 1);
	КонецЕсли;	           
	
	Возврат ТелНомер;
	
КонецФункции //--#1359 смарт: Лопато 13.09.2023

//++#1359 смарт: Лопато 13.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
Функция ТолькоЦифры(Строка) Экспорт

	Итог = "";
	
	ДлинаСтроки = СтрДлина(Строка);

	Для Сч = 1 По ДлинаСтроки Цикл
        Символ = Сред(Строка, Сч, 1);   
        КодСимвола = КодСимвола(Символ);
        Если КодСимвола > 47 И КодСимвола < 58 Тогда
            Итог = Итог + Символ;
        КонецЕсли;
    КонецЦикла;

	Возврат Итог;
	
КонецФункции //--#1359 смарт: Лопато 13.09.2023

