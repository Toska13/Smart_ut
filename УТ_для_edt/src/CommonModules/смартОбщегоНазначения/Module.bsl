//++#1316 смарт: Лопато 06.10.2023 //Запретить использование в документах подразделения другой организации  
Функция смартПолучитьСписокПодразделенийОрганизации(Организация) Экспорт

	МассивПодразделений = Новый Массив;

	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтруктураПредприятия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	НЕ СтруктураПредприятия.ПометкаУдаления
		|	И НЕ СтруктураПредприятия.смартПодразделениеНеИспользуется
		|	И СтруктураПредприятия.смартОрганизацияВладелец = &смартОрганизацияВладелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|АВТОУПОРЯДОЧИВАНИЕ";	
		
		Запрос.УстановитьПараметр("смартОрганизацияВладелец", Организация);
		
		Результат = Запрос.Выполнить();
		
		Если НЕ Результат.Пустой() Тогда
			МассивПодразделений = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
		Иначе
			МассивПодразделений = смартПолучитьСоздатьПодразделениеОрганизацииПоУмолчанию(Организация);
		КонецЕсли;

	КонецЕсли;
		
	Возврат МассивПодразделений;
		
КонецФункции //--#1316 смарт: Лопато 06.10.2023

//++#1316 смарт: Лопато 06.10.2023 //Запретить использование в документах подразделения другой организации  
Функция смартПолучитьСоздатьПодразделениеОрганизацииПоУмолчанию(Организация) Экспорт

	МассивПодразделений = Новый Массив;
	
	НеобходимоСоздатьЭлемент = Ложь;
			
	НаименованиеЭлементаПоУмолчанию = НСтр("ru = '<Подразделение по умолчанию>'");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СтруктураПредприятия.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА СтруктураПредприятия.Наименование = &НаименованиеЭлементаПоУмолчанию
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоЭлементПоУмолчаниюДляОбмена
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.смартОрганизацияВладелец = &смартОрганизацияВладелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоЭлементПоУмолчаниюДляОбмена УБЫВ");
	Запрос.УстановитьПараметр("НаименованиеЭлементаПоУмолчанию", НаименованиеЭлементаПоУмолчанию);
	Запрос.УстановитьПараметр("смартОрганизацияВладелец", 		 Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ЭтоЭлементПоУмолчаниюДляОбмена Тогда
			МассивПодразделений.Добавить(Выборка.Ссылка);
		КонецЕсли;
	Иначе
		НеобходимоСоздатьЭлемент = Истина;
	КонецЕсли;
	
	Если НеобходимоСоздатьЭлемент Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ПодразделениеОбъект = Справочники.СтруктураПредприятия.СоздатьЭлемент();

		ПодразделениеОбъект.Наименование 					 = НаименованиеЭлементаПоУмолчанию;
		ПодразделениеОбъект.смартОрганизацияВладелец 		 = Организация;
		ПодразделениеОбъект.ВариантОбособленногоУчетаТоваров = Перечисления.ВариантыОбособленногоУчетаТоваров.НеВедется;
		
		ПодразделениеОбъект.ОбменДанными.Загрузка = Истина;
		
		Попытка
			ПодразделениеОбъект.Записать();
			МассивПодразделений.Добавить(ПодразделениеОбъект.Ссылка);
			ОбщегоНазначения.СообщитьПользователю("Создано подразделение по умолчанию для организации """ + СокрЛП(Организация) + """");
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось создать подразделение по умолчанию! Обратитесь к администратору 1С!");
			ЗаписьЖурналаРегистрации("Автоматическое создание подразделения по умолчанию", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось создать подразделение по умолчанию!");
		КонецПопытки;

		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
	Возврат МассивПодразделений;
	
КонецФункции //--#1316 смарт: Лопато 06.10.2023

//++#1316 смарт: Лопато 06.10.2023 //Запретить использование в документах подразделения другой организации  
Процедура смартПроверитьОрганизациюПодразделения(Отказ, Подразделение, Организация, ПодразделениеОбязательно = Ложь) Экспорт
	
	СообщениеОшибка = "";
	
	Если ЗначениеЗаполнено(Подразделение) Тогда

		ПодразделениеВладелец = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Подразделение, "смартОрганизацияВладелец");

		Если ПодразделениеВладелец <> Организация Тогда
			СообщениеОшибка = НСтр("ru='Организация в документе """ + СокрЛП(Организация) + """ не совпадает с организацией-владельцем подразделения """ + СокрЛП(Подразделение) + """!'");
		КонецЕсли;
		
	ИначеЕсли ПодразделениеОбязательно Тогда
		
		МассивПодразделений = смартПолучитьСписокПодразделенийОрганизации(Организация);
		
		Если МассивПодразделений.Количество() > 0 Тогда

			НаименованиеПодразделенияПоУмолчанию = "<Подразделение по умолчанию>";

			Если НЕ (МассивПодразделений.Количество() = 1 И МассивПодразделений[0].Наименование = НаименованиеПодразделенияПоУмолчанию) Тогда
				СообщениеОшибка = НСтр("ru='В документе не заполнено поле подразделения! У организации """ + СокрЛП(Организация) + """ имеются действующие подразделения!'");
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеОшибка) Тогда
		
		Если НЕ Пользователи.ЭтоПолноправныйПользователь() Тогда
			ОбщегоНазначения.СообщитьПользователю(СообщениеОшибка, Подразделение, "Подразделение", "Объект.Подразделение", Отказ);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СообщениеОшибка, Подразделение, "Подразделение", "Объект.Подразделение");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //--#1316 смарт: Лопато 06.10.2023

//++ #Б-2282 смарт: Фролов 11.03.2025 //Оповещение руководителей при назначении новому партнеру менеджера по расходке
Функция НайтиРегионВерхнегоУровня(Регион) Экспорт
	
	РегионПоиска = Регион;
	
	Пока ЗначениеЗаполнено(РегионПоиска.Родитель) И НЕ ЗначениеЗаполнено(РегионПоиска.смартОтветственоеПодразделение) Цикл
		РегионПоиска = НайтиРегионВерхнегоУровня(РегионПоиска.Родитель);
	КонецЦикла;
	
	Возврат РегионПоиска;
	
КонецФункции //-- #Б-2282 смарт: Фролов 11.03.2025

