Функция ПолучитьПрефиксКонтрагентаПартнера(КонтрагентПартнер) Экспорт
	
	Префикс = "";
	
	Если НЕ ЗначениеЗаполнено(КонтрагентПартнер) Тогда
		Возврат Префикс;
	КонецЕсли;
	
	Если ТипЗнч(КонтрагентПартнер) <> Тип("СправочникСсылка.Контрагенты") 
		И ТипЗнч(КонтрагентПартнер) <> Тип("СправочникСсылка.Партнеры") Тогда
		Возврат Префикс;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтрагентыДополнительныеРеквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК КонтрагентыДополнительныеРеквизиты
	|ГДЕ
	|	КонтрагентыДополнительныеРеквизиты.Свойство.Имя = ""ПрефиксКонтрагента""
	|	И КонтрагентыДополнительныеРеквизиты.Ссылка = &КонтрагентПартнер";
		
	Если ТипЗнч(КонтрагентПартнер) = Тип("СправочникСсылка.Партнеры") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.Контрагенты", "Справочник.Партнеры");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПрефиксКонтрагента", "ПрефиксПартнера");	
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонтрагентПартнер", КонтрагентПартнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Префикс;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Значение;
	
КонецФункции //-- смарт:ММ 01.12.2019

