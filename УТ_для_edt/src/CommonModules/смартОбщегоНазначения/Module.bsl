Функция ПроверитьТелефон(ДанныеСтроки) Экспорт

	Возврат ТелефонПроверкаСВыводомСообщений(ДанныеСтроки);	

КонецФункции 

Функция ПроверитьТелефонПриЗаписи(СтрДанных,Ссылка) Экспорт 
	
	Если Лев(СтрДанных.Представление,2) = "+7" Тогда
		Результат = ТелефонПроверкаСВыводомСообщений(СтрДанных);	 	
	Иначе
		Результат = ТелефонПроверкаСообщенияПриЗаписи(СтрДанных,Ссылка);
	КонецЕсли;
	
	Возврат Результат;
 
 КонецФункции 

Функция ТелефонПроверкаСообщенияПриЗаписи(ДанныеСтроки,Ссылка)

	ВозврСтруктура = Новый Структура();
	ВозврСтруктура.Вставить("СообщениеОшибки", "");
	ВозврСтруктура.Вставить("КодОшибки", 0); 

	СообщениеНетКодов		 = НСтр("ru='Не заполнен код страны и код города'");
	СообщениеСкобкаВНачале	 = НСтр("ru='Номер не может начинаться со скобки'");
	СообщениеНекорректныеСимволы  = НСтр("ru='Можно использовать только 0123456789+()-–‒'");
	СообщениеКодСтраныПлюс	 = НСтр("ru='Код страны должне начинаться с знака + и состоять из цифр'");
	
	ТелПредставление = ДанныеСтроки.Представление;

	// Проверяем допустимые символы.
    КорректныеСимволыВТелефоне = "0123456789+()-–‒ ";
	
	Добавочный = СтрНайти(ТелПредставление,", доб.");
	
	Если Добавочный > 0 Тогда
		КорректныеСимволыВТелефоне	= КорректныеСимволыВТелефоне + ",доб.";
	КонецЕсли; 
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(ТелПредставление, КорректныеСимволыВТелефоне) Тогда
		ВозврСтруктура.КодОшибки = 1;
		ВозврСтруктура.СообщениеОшибки = СообщениеНекорректныеСимволы; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// Проверяем на скобку в начале номера
	Если Лев(ТелПредставление, 1) = "(" Тогда
		ВозврСтруктура.КодОшибки = 7 ;
		ВозврСтруктура.СообщениеОшибки = СообщениеСкобкаВНачале; 
		Возврат ВозврСтруктура;
	КонецЕсли;

	//Проверяем на код города и номер телефона
	Значение = ДанныеСтроки.Значение;
	
	Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(Значение) Тогда
		КонтактнаяИнформацияСтруктурой = УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(Значение, Перечисления.ТипыКонтактнойИнформации.Телефон);
		
		Если КонтактнаяИнформацияСтруктурой.Свойство("countryCode") И 
			КонтактнаяИнформацияСтруктурой.Свойство("number") И
			КонтактнаяИнформацияСтруктурой.Свойство("areaCode") Тогда
			
			Если КонтактнаяИнформацияСтруктурой.countryCode = "" И КонтактнаяИнформацияСтруктурой.areaCode = "" Тогда
				ВозврСтруктура.КодОшибки = 6;
				ВозврСтруктура.СообщениеОшибки = СообщениеНетКодов; 
				Возврат ВозврСтруктура;
			ИначеЕсли КонтактнаяИнформацияСтруктурой.countryCode = "+" Тогда
				ВозврСтруктура.КодОшибки = 8;
				ВозврСтруктура.СообщениеОшибки = СообщениеКодСтраныПлюс; 
				Возврат ВозврСтруктура;
			//ИначеЕсли СтрДлина(КонтактнаяИнформацияСтруктурой.areaCode) <> 3 Тогда
			//	ВозврСтруктура.КодОшибки = 4;
			//	ВозврСтруктура.СообщениеОшибки = СообщениеКодГорода; 
			//	Возврат ВозврСтруктура;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	
	Возврат ВозврСтруктура;

 КонецФункции 
 
Функция ТелефонПроверкаСВыводомСообщений(ДанныеСтроки)
	
	ВозврСтруктура = Новый Структура();
	ВозврСтруктура.Вставить("СообщениеОшибки", "");
	ВозврСтруктура.Вставить("КодОшибки", 0);
	
	// Коды Ошибок
	СообщениеНекорректныеСимволы			= НСтр("ru='Можно использовать только 0123456789+()-–‒'");
	СообщениеНеверныйКодСтраны				= НСтр("ru='Российский номер должен начинаться с +7 или 8'");
	СообщениеКороткийномер					= НСтр("ru='Номер должен состоять из семи цифр'");
	СообщениеКодГорода						= НСтр("ru='Код города должен состоять из трёх цифр'");
	СообщениеНеформат						= НСтр("ru='Номер должен состоять из 11 цифр'");	
	СообщениеСкобкаВНачале					= НСтр("ru='Перед перед скобками должен быть код страны'");
	СообщениНеПлюсСемь						= НСтр("ru='Если номер начинается с + , то должен быть +7'");
	
	Представление = ДанныеСтроки.Представление;
	
	// Проверяем допустимые символы.
    КорректныеСимволыВТелефоне = "0123456789+()-–‒ ";
	
	Добавочный = СтрНайти(Представление,", доб.");
	
	Если Добавочный > 0 Тогда
		КорректныеСимволыВТелефоне	= КорректныеСимволыВТелефоне + ",доб.";
	КонецЕсли; 
	
	Если Не СтрокаСодержитТолькоДопустимыеСимволы(Представление, КорректныеСимволыВТелефоне) Тогда
		ВозврСтруктура.КодОшибки = 1;
		ВозврСтруктура.СообщениеОшибки = СообщениеНекорректныеСимволы; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	// Проверяем на длину в 11 символов
	СтрокаЧисел = "";
	
	Для Индекс = 1 По ?(Добавочный > 0,Добавочный-1 ,СтрДлина(Представление)) Цикл
		
		Символ = Сред(Представление, Индекс, 1); // Перебираем все символы из нашей строки
		
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
			СтрокаЧисел = СтрокаЧисел + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтрДлина(СтрокаЧисел) <> 11 Тогда
		ВозврСтруктура.КодОшибки = 5;
		ВозврСтруктура.СообщениеОшибки = СообщениеНеформат; 
		Возврат ВозврСтруктура;
	КонецЕсли;
	
	//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
	//Проверяем на наличие дублей
	СтруктураПараметровКИ = Новый Структура;
	
	СтруктураПараметровКИ.Вставить("Ссылка", ДанныеСтроки.Ссылка);

	Если ДанныеСтроки.Свойство("Владелец") Тогда
		СтруктураПараметровКИ.Вставить("Владелец", ДанныеСтроки.Владелец);
	Иначе
		СтруктураПараметровКИ.Вставить("Владелец", Неопределено);
	КонецЕсли;
	
	СтруктураПараметровКИ.Вставить("ПредставлениеКИ", СтрокаЧисел);
	СтруктураПараметровКИ.Вставить("ТипКИ", 		  Перечисления.ТипыКонтактнойИнформации.Телефон);
	
	МассивСтруктурДублей = ПолучитьДублиПоКонтактнойИнформацииСправочников(СтруктураПараметровКИ);
		
	Если МассивСтруктурДублей.Количество() > 0  Тогда

		ВозврСтруктура.КодОшибки = 12;
		ВозврСтруктура.СообщениеОшибки = "Данный телефон уже используется:" + Символы.ПС;

		ВозврСтруктура.Вставить("МассивДублей", МассивСтруктурДублей);
		
		Возврат ВозврСтруктура;
		
	КонецЕсли;
	//-- #1152 смарт: Лопато 18.10.2024
	
	//Проверяем на код города и номер телефона
	Значение = ДанныеСтроки.Значение;
	
	Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(Значение) Тогда
		КонтактнаяИнформацияСтруктурой = УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(Значение, Перечисления.ТипыКонтактнойИнформации.Телефон);
		
		Если КонтактнаяИнформацияСтруктурой.Свойство("countryCode") И 
			КонтактнаяИнформацияСтруктурой.Свойство("number") И
			КонтактнаяИнформацияСтруктурой.Свойство("areaCode") Тогда
			
			Если КонтактнаяИнформацияСтруктурой.countryCode <> "+7" Тогда
				ВозврСтруктура.КодОшибки = 2;
				ВозврСтруктура.СообщениеОшибки = СообщениеНеверныйКодСтраны; 
				Возврат ВозврСтруктура;
			//ИначеЕсли СтрДлина(КонтактнаяИнформацияСтруктурой.number) <> 7 Тогда
			//	ВозврСтруктура.КодОшибки = 3;
			//	ВозврСтруктура.СообщениеОшибки = СообщениеКороткийномер; 
			//	Возврат ВозврСтруктура;
			//ИначеЕсли СтрДлина(КонтактнаяИнформацияСтруктурой.areaCode) <> 3 Тогда
			//	ВозврСтруктура.КодОшибки = 4;
			//	ВозврСтруктура.СообщениеОшибки = СообщениеКодГорода; 
			//	Возврат ВозврСтруктура;
				
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ВозврСтруктура;
	
КонецФункции 

&НаСервере
Процедура ДобавитьПодсказкиКонтактнаяИнформация(Форма) Экспорт
	
	Если ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат;		
	КонецЕсли;      
	
	Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.ПомощникНового" Тогда
		
		МассивИзменяемыхЭлементов = новый Массив();
		
		МассивИзменяемыхЭлементов.Добавить("ТелефонПартнера"); 
		МассивИзменяемыхЭлементов.Добавить("ТелефонКЛ");
		МассивИзменяемыхЭлементов.Добавить("МобильныйТелефонКЛ");
		МассивИзменяемыхЭлементов.Добавить("ТелефонПартнераФизЛицо");
		
		Для каждого ЭлМассива Из МассивИзменяемыхЭлементов Цикл
			
			УстановитьПодсказкуДляЭлементов(Форма.Элементы[ЭлМассива]);
			
		КонецЦикла;
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая"
				ИЛИ Форма.ИмяФормы = "Справочник.КонтактныеЛицаПартнеров.Форма.CRM_ФормаЭлементаНовая"  Тогда	
		
		Если НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
			Для каждого Стр Из Форма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
				
				Если Стр.Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") Тогда
					
					ЭлемНомерТелефона = Форма.Элементы.Найти(Стр.ИмяРеквизита);
					
					Если ЭлемНомерТелефона <> Неопределено Тогда
						
						УстановитьПодсказкуДляЭлементов(ЭлемНомерТелефона);
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая" Тогда
				
				МассивИзменяемыхЭлементов = новый Массив();
				
				МассивИзменяемыхЭлементов.Добавить("Контакт_Телефон"); 
				МассивИзменяемыхЭлементов.Добавить("Контакт_МобТелефон");
				
				Для каждого ЭлМассива Из МассивИзменяемыхЭлементов Цикл
					
					УстановитьПодсказкуДляЭлементов(Форма.Элементы[ЭлМассива]);
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.CRM_ПотенциальныеКлиенты.Форма.ФормаЭлемента" 
				ИЛИ Форма.ИмяФормы = "Справочник.ФизическиеЛица.Форма.CRM_МодульУТ_ФормаЭлемента"
				ИЛИ Форма.ИмяФормы = "Справочник.Склады.Форма.ФормаЭлемента" 
				ИЛИ Форма.ИмяФормы = "Справочник.Пользователи.Форма.CRM_ФормаЭлемента" 
				ИЛИ Форма.ИмяФормы = "Справочник.Организации.Форма.ФормаЭлемента"
		        ИЛИ Форма.ИмяФормы = "Справочник.Контрагенты.Форма.ФормаЭлемента" Тогда 
				
		Для каждого Стр Из Форма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
				
				Если Стр.Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") Тогда
					
					ЭлемНомерТелефона = Форма.Элементы.Найти(Стр.ИмяРеквизита);
					
					Если ЭлемНомерТелефона <> Неопределено Тогда
						
						УстановитьПодсказкуДляЭлементов(ЭлемНомерТелефона);
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьПодсказкуДляЭлементов(Элемент)
	
	Элемент.ПодсказкаВвода = "+7 ХХХ ХХХ ХХ ХХ или 8 ХХХ ХХХ ХХ ХХ БЕЗ ПРОБЕЛОВ";
	Элемент.Подсказка = "Если номер имеет заграничный формат, нажмите на кнопку выбора(если имеется) или F4 и введите номер";
	Элемент.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
	
КонецПроцедуры 

