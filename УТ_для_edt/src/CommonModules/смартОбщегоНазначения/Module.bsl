//++ смарт:ММ #044 224 25.02.2021 - Заявка на гарантийный ремонт 
Процедура ПроверитьОстаткиНаСкладеГарантийныхЗапчастей(ДатаОстатков, МассивСтруктур, ОткрытьФормуПодбор, Регистратор = Неопределено) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ 
	|	ВТ.Номенклатура,
	|	ВТ.Количество
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ВТ
	|;
	|/////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.Номенклатура КАК Номенклатура,
	|	смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.НомерЗаявки КАК НомерЗаявки,
	//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
	|	смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.Заявка КАК Заявка,
	//-- #Б1132 смарт: Шляпников 14.10.2024
	|	смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.смартОстаткиНаСкладеГарантийныхЗапчастей.Остатки(&ДатаДокумента, Номенклатура В (ВЫБРАТЬ ВТ.Номенклатура ИЗ ВТ КАК ВТ)) КАК смартОстаткиНаСкладеГарантийныхЗапчастейОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО ВТ.Номенклатура = смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.Номенклатура
	|			И  ВТ.Количество <= смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.КоличествоОстаток
	|ГДЕ
	|	смартОстаткиНаСкладеГарантийныхЗапчастейОстатки.КоличествоОстаток > 0";
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекущаяСтрока Из МассивСтруктур Цикл
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Номенклатура = ТекущаяСтрока.Номенклатура;
		НоваяСтрока.Количество = ТекущаяСтрока.Количество;
	КонецЦикла;	
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаОстатков);
	
	// ++ 18.03.2021
	Если ЗначениеЗаполнено(Регистратор) Тогда
		Запрос.УстановитьПараметр("ДатаДокумента", Новый Граница(Новый МоментВремени(Регистратор.Дата, Регистратор), ВидГраницы.Исключая));
	КонецЕсли;
	// --
	
	Запрос.УстановитьПараметр("ТЗ", ТЗ);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Для Каждого ТекущаяСтрока Из МассивСтруктур Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
		
		Выборка.Сбросить();
		
		Список = Новый СписокЗначений;
		Сч = 0;
		
		//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
		Заявка = Неопределено;
		//-- #Б1132 смарт: Шляпников 01.11.2024
		
		Пока Выборка.НайтиСледующий(Отбор) Цикл
			
			Сч = Сч + 1;
			
			Если ЗначениеЗаполнено(Выборка.НомерЗаявки) Тогда
				НомерЗаявки = Выборка.НомерЗаявки;
			Иначе
				НомерЗаявки = "Без номера";
			КонецЕсли;
			
			//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			Если ЗначениеЗаполнено(Выборка.Заявка) Тогда
				Заявка = Выборка.Заявка;
			КонецЕсли;
			
			Список.Добавить(Выборка.Заявка, НомерЗаявки);
			//-- #Б1132 смарт: Шляпников 01.11.2024
			
		КонецЦикла;
		
		ТекущаяСтрока.СписокНомеров = Список;
		
		Если Сч = 1 Тогда
			ТекущаяСтрока.НомерЗаявки = НомерЗаявки;
			//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			ТекущаяСтрока.Заявка = Заявка;
			//-- #Б1132 смарт: Шляпников 01.11.2024
		КонецЕсли;
		
		Если Сч <> 1 Тогда
			ОткрытьФормуПодбор = Истина;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры //-- смарт:ММ 23.02.2021

Функция НайтиДоговор(Организация,Партнер,Контрагент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ДоговорыКонтрагентов.ДопустимаяСуммаЗадолженности КАК ДопустимаяСуммаЗадолженности,
	|	ДоговорыКонтрагентов.ВалютаВзаиморасчетов КАК Валюта
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.ДопустимаяСуммаЗадолженности > 0
	|   И ДоговорыКонтрагентов.ДатаНачалаДействия <= &ДатаТек
	|	И ДоговорыКонтрагентов.ДатаОкончанияДействия >= &ДатаТек
	|	И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.Партнер = &Партнер
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("ДатаТек", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если  ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьИндСоглашение(Организация,Партнер,Контрагент,Валюта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоглашенияСКлиентами.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|ГДЕ
	|	СоглашенияСКлиентами.Организация = &Организация
	|	И СоглашенияСКлиентами.Партнер = &Партнер
	|	И СоглашенияСКлиентами.Контрагент = &Контрагент
	|	И (СоглашенияСКлиентами.ДатаНачалаДействия <= &ДатаТек
	|			ИЛИ СоглашенияСКлиентами.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1))
	|	И (СоглашенияСКлиентами.ДатаОкончанияДействия >= &ДатаТек
	|			ИЛИ СоглашенияСКлиентами.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1))
	|	И СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)
	|	И СоглашенияСКлиентами.Валюта = &Валюта
	|	И СоглашенияСКлиентами.ИспользуютсяДоговорыКонтрагентов";
	
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("ДатаТек", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	//Запрос.УстановитьПараметр("ПустоеЗначение", пустаяда);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если  ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
