	|ИТОГИ ПО
	|	Контрагент";
	
	Запрос.УстановитьПараметр("КонецПериода", 		ТекущаяДата());
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ИтоговоеСоответствиие;
	КонецЕсли;
	
	ВыборкаКонтрагент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКонтрагент.Следующий() Цикл
			
		Выборка = ВыборкаКонтрагент.Выбрать();
		
		МассивРеквизитов = Новый Массив;
		
		Пока Выборка.Следующий() Цикл
			МассивРеквизитов.Добавить(Выборка.Реквизит);
		КонецЦикла;
		
		ИтоговоеСоответствиие.Вставить(ВыборкаКонтрагент.Контрагент, МассивРеквизитов);

	КонецЦикла;
		
	Возврат ИтоговоеСоответствиие;
		
КонецФункции //-- смарт:ММ 08.12.2019

//++ смарт:ММ #010 137 05.01.2020
Функция РазбитьСтрокуНаПрефиксИНомер(Стр) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Префикс", "");
	СтруктураВозврата.Вставить("Номер", "");
	
	НомерПервогоЧисловогоСимвола = ПолучитьНомерПервогоЧисловогоСимвола(Стр);
	
	Если НомерПервогоЧисловогоСимвола > 0 Тогда
		
		Префикс = Лев(Стр, НомерПервогоЧисловогоСимвола - 1);
		СтруктураВозврата.Вставить("Префикс", Префикс);
		
		ВнешнийНомер = Прав(Стр, (СтрДлина(Стр) - НомерПервогоЧисловогоСимвола + 1));
		СтруктураВозврата.Вставить("Номер", ВнешнийНомер);
	Иначе //смарт:rnp 551 21.10.2021
		Префикс = Стр;
		СтруктураВозврата.Вставить("Префикс", Префикс);
	КонецЕсли;

	Возврат СтруктураВозврата;
	
КонецФункции //-- смарт:ММ 05.01.2020

//++ #Б-1176 смарт: Мосолов 25.10.2024 //Заявки на гарантийный ремонт. Запчасти. Отчет по возвратам  
Функция ПолучитьПрефиксИзНомера(Номер) Экспорт
	
	НомерПервогоЧисловогоСимвола = ПолучитьНомерПервогоЧисловогоСимвола(Номер);
	
	Если НомерПервогоЧисловогоСимвола > 0 Тогда
		
		Префикс = Лев(Номер, НомерПервогоЧисловогоСимвола - 1); 
		
	Иначе 
		
		Префикс = Номер;  
		
	КонецЕсли;

	Возврат Префикс;
	
КонецФункции //-- #Б-1176 смарт: Мосолов 25.10.2024

//++ смарт:ММ #010 137 05.01.2020
Функция ПолучитьНомерПервогоЧисловогоСимвола(Стр) Экспорт
	
	МассивЧисел = Новый Массив;
	МассивЧисел.Добавить("0");
	МассивЧисел.Добавить("1");
	МассивЧисел.Добавить("2");
	МассивЧисел.Добавить("3");
	МассивЧисел.Добавить("4");
	МассивЧисел.Добавить("5");
	МассивЧисел.Добавить("6");
	МассивЧисел.Добавить("7");
	МассивЧисел.Добавить("8");
	МассивЧисел.Добавить("9");
	
	Для Сч = 1 По СтрДлина(Стр) Цикл
		
		ТекСимвол = Сред(Стр, Сч, 1);
		
		Если МассивЧисел.Найти(ТекСимвол) <> Неопределено Тогда
			Возврат Сч;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции //-- смарт:ММ 05.01.2020

//++ смарт:ММ #010 137 07.01.2020
Функция ПолучитьСтрокуСоСтатусом(ДокОбъект, НомерПозиции, Статус) Экспорт
	
	СтрокаДокумента = Неопределено;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерПозиции", НомерПозиции);
	Отбор.Вставить("Статус", Статус);
	
	НайденныеСтроки = ДокОбъект.Статусы.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаДокумента = ДокОбъект.Статусы.Добавить();		
	Иначе
		СтрокаДокумента = НайденныеСтроки[0];
	КонецЕсли;
	
	Возврат СтрокаДокумента;
	
КонецФункции //-- смарт:ММ 07.01.2020

//++ смарт:ММ #044 137 08.04.2020
Функция СформироватьПутьККаталогуГарантийныхЗапчастей(НомерОтправления, ДатаЗаявки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НомерОтправления)
		ИЛИ НЕ ЗначениеЗаполнено(ДатаЗаявки) Тогда
		Возврат "";
	КонецЕсли;
	
	Начало = Справочники.смартПредопределенныеЗначения.КаталогФайловПоЗаявкамНаГарантийныйРемонт.Значение;
	
	Если НЕ ЗначениеЗаполнено(Начало) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Прав(Начало, 1) <> "\" Тогда
		Начало = Начало + "\";
	КонецЕсли;
	
	Окончание = "" + Формат(Год(ДатаЗаявки), "ЧГ=") + "\" + НомерОтправления;
	
	Возврат (Начало + Окончание);

КонецФункции //-- смарт:ММ 08.04.2020

