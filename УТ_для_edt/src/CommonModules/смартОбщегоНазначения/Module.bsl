	КонецЕсли;
	
	Запрос = Новый Запрос(
	//++#1578 смарт: Лопато 15.12.2023 //Ошибка в заказе клиента при изменении адреса доставки  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТЧСклады.Склад КАК Склад
	|ПОМЕСТИТЬ ТЧСклады
	|ИЗ
	|	&ТЧСклады КАК ТЧСклады
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СкладыКонтактнаяИнформация.Вид.Представление КАК Вид,
	|	СкладыКонтактнаяИнформация.Представление 	 КАК АдресДоставки,
	|	СкладыКонтактнаяИнформация.Значение 		 КАК АдресДоставкиЗначение,
	|	СкладыКонтактнаяИнформация.ЗначенияПолей 	 КАК АдресДоставкиЗначенияПолей
	|ИЗ
	|	Справочник.Склады.КонтактнаяИнформация КАК СкладыКонтактнаяИнформация
	|ГДЕ
	|	СкладыКонтактнаяИнформация.Ссылка В
	|			(ВЫБРАТЬ
	|				ТЧСклады.Склад
	|			ИЗ
	|				ТЧСклады)
	|	И СкладыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И СкладыКонтактнаяИнформация.Вид = &Вид");
	//--#1578 смарт: Лопато 15.12.2023

	Запрос.УстановитьПараметр("Вид", 	  Справочники.ВидыКонтактнойИнформации.АдресСклада);
	Запрос.УстановитьПараметр("ТЧСклады", ТЧСклады);

	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции //--#1382 смарт: Лопато 21.06.2023

