Функция ДатаЯвляетсяРабочей(ДатаПроверки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроизводственныйКалендарь", КалендарныеГрафики.ОсновнойПроизводственныйКалендарь());
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ДатаПроверки));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Дата
	|ИЗ
	|	РегистрСведений.ДанныеПроизводственногоКалендаря
	|ГДЕ
	|	ПроизводственныйКалендарь = &ПроизводственныйКалендарь
	|	И Дата = &ТекущаяДата
	|	И ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий), 
	|				ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный))";
	
	Возврат Запрос.Выполнить().Выбрать().Следующий();
	
КонецФункции //-- #Б-4290 смарт: Фролов 11.09.2025

