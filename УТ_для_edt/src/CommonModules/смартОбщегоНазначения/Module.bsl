// 		Соответствие, где ключ - контрагент, значение - массив из строк с названиями незаполненных реквизитов
Функция ПолучитьНезаполненныеРеквизитыКонтрагента(Контрагенты) Экспорт
	
	ИтоговоеСоответствиие = Новый Соответствие;
	//Смарт {[*](фрагмент ИЗМЕНЕН), Подкин Алексей Иванович 01.09.2021 10:10:25 задача 552 исключение из проверки предопределенного контрагента, для Розничного покупателя
	Если НЕ ЗначениеЗаполнено(Контрагенты) или Контрагенты.Предопределенный Тогда
	//Смарт }Подкин Алексей Иванович 01.09.2021 10:10:25
		Возврат ИтоговоеСоответствиие;
	КонецЕсли;
	
	МассивКонтрагентов = Новый Массив;
	
	Если ТипЗнч(Контрагенты) = Тип("СправочникСсылка.Контрагенты") Тогда
		МассивКонтрагентов.Добавить(Контрагенты);
	ИначеЕсли ТипЗнч(Контрагенты) = Тип("Массив") Тогда
		МассивКонтрагентов = Контрагенты;
	Иначе
		Возврат ИтоговоеСоответствиие;
	КонецЕсли;
	
	Для Каждого Контрагент Из МассивКонтрагентов Цикл
		ИтоговоеСоответствиие.Вставить(Контрагент, Новый Массив);
