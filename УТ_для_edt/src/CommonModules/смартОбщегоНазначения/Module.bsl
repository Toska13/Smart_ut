	|	ВЫБОР
	|		КОГДА смартОборудованиеКлиентов.Родитель.Родитель = &ГруппаОборудование
	|			ТОГДА смартОборудованиеКлиентов.Родитель
	|		КОГДА смартОборудованиеКлиентов.Родитель.Родитель = &ГруппаЧернила
	|			ТОГДА смартОборудованиеКлиентов.Родитель
	|		ИНАЧЕ смартОборудованиеКлиентов.Родитель.Родитель
	|	КОНЕЦ КАК Родитель,
	|	ВЫБОР
	|		КОГДА РодительСпр.Родитель = &ГруппаОборудование
	|			ТОГДА ЕСТЬNULL(РодительСпр.Наименование, """")
	|		КОГДА РодительСпр.Родитель = &ГруппаЧернила
	|			ТОГДА ЕСТЬNULL(РодительСпр.Наименование, """")
	|		ИНАЧЕ ЕСТЬNULL(РодительСпр.Родитель.Наименование, """")
	|	КОНЕЦ КАК РодительНаименование,
	|	смартОборудованиеКлиентов.Ссылка КАК Ссылка,
	|	смартОборудованиеКлиентов.Наименование КАК Наименование
	|ИЗ
	|	Справочник.смартОборудованиеКлиентов КАК смартОборудованиеКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартОборудованиеКлиентов КАК РодительСпр
	|		ПО смартОборудованиеКлиентов.Родитель = РодительСпр.Ссылка
	|ГДЕ
	|	НЕ смартОборудованиеКлиентов.ПометкаУдаления
	|	И НЕ смартОборудованиеКлиентов.ЭтоГруппа
	|	И РодительСпр.ВыгружатьВЗаявкуНаРемонтныеРаботы
	|
	|УПОРЯДОЧИТЬ ПО
	//++ #Б-4874 смарт: Фролов 05.11.2025 //Доработка выгрузки справочника Оборудование клиентов на сайт Smart.help 
	//|	РодительСпр.ПорядокСортировкиДляВыгрузки,
	|	ВЫБОР
	|		КОГДА смартОборудованиеКлиентов.Родитель.ПорядокСортировкиДляВыгрузки = 0
	|			ТОГДА смартОборудованиеКлиентов.Родитель.Родитель.ПорядокСортировкиДляВыгрузки
	|		ИНАЧЕ смартОборудованиеКлиентов.Родитель.ПорядокСортировкиДляВыгрузки
	|	КОНЕЦ,
	//-- #Б-4874 смарт: Фролов 05.11.2025
	|	Наименование
	|ИТОГИ
	|	МАКСИМУМ(РодительНаименование)
	|ПО
	|	КорневойКаталог,
	|	Родитель";
	
	//++ смарт:ММ #094 411 07.02.2021
	//ГруппаОборудование = Справочники.смартОборудованиеКлиентов.НайтиПоНаименованию("ОБОРУДОВАНИЕ", Истина);
	//ГруппаЧернила = Справочники.смартОборудованиеКлиентов.НайтиПоНаименованию("ЧЕРНИЛА", Истина);
	ГруппаОборудование = Справочники.смартПредопределенныеЗначения.ОборудованиеГруппаОборудование.Значение;
	Если НЕ ЗначениеЗаполнено(ГруппаОборудование) Тогда
		ГруппаОборудование = Справочники.смартОборудованиеКлиентов.НайтиПоНаименованию("ОБОРУДОВАНИЕ", Истина);	
	КонецЕсли;
	
	ГруппаЧернила = Справочники.смартПредопределенныеЗначения.ОборудованиеГруппаЧернила.Значение;
	Если НЕ ЗначениеЗаполнено(ГруппаЧернила) Тогда
		ГруппаЧернила = Справочники.смартОборудованиеКлиентов.НайтиПоНаименованию("ЧЕРНИЛА", Истина);	
	КонецЕсли;
	//-- смарт:ММ 07.02.2021
	
	Запрос.УстановитьПараметр("ГруппаОборудование", ГруппаОборудование);
	Запрос.УстановитьПараметр("ГруппаЧернила", ГруппаЧернила);
	
	ВыборкаТип = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ИмяВременногоФайлаОБОРУДОВАНИЕ = "hardware.json";
	ИмяВременногоФайлаЧЕРНИЛА = "inks.json";		
	
	Пока ВыборкаТип.Следующий() Цикл
		
		КаталогВременныхФайлов = КаталогВременныхФайлов();
		Если ВыборкаТип.КорневойКаталог = ГруппаОборудование Тогда
			ИмяВременногоФайлаОБОРУДОВАНИЕ = КаталогВременныхФайлов + ИмяВременногоФайлаОБОРУДОВАНИЕ;
			ИмяФайла = ИмяВременногоФайлаОБОРУДОВАНИЕ;
		ИначеЕсли ВыборкаТип.КорневойКаталог = ГруппаЧернила Тогда
			ИмяВременногоФайлаЧЕРНИЛА = КаталогВременныхФайлов + ИмяВременногоФайлаЧЕРНИЛА;
			ИмяФайла = ИмяВременногоФайлаЧЕРНИЛА;
		Иначе
			Продолжить;
		КонецЕсли;			
		
		ВыборкаРодитель = ВыборкаТип.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.ПроверятьСтруктуру = Ложь;
		
		ПараметрыЗаписиJSON = Новый ПараметрыЗаписиJSON( , Символы.Таб);
		
		// ОТЛАДКА
		//ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписиJSON);
		ЗаписьJSON.ОткрытьФайл(ИмяФайла,,, ПараметрыЗаписиJSON);
		
		
		ЗаписьJSON.ЗаписатьНачалоМассива();
				
		Пока ВыборкаРодитель.Следующий() Цикл
			
			ЗаписьJSON.ЗаписатьНачалоОбъекта(); 

			ЗаписьJSON.ЗаписатьИмяСвойства("title");
			ЗаписьJSON.ЗаписатьЗначение(ВыборкаРодитель.РодительНаименование);
			//++ смарт: Белоусова 494 22.04.2021
			если ВыборкаРодитель.родитель.СмартНеИспользуетЧернила тогда
				ЗаписьJSON.ЗаписатьИмяСвойства("no_inks");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаРодитель.родитель.СмартНеИспользуетЧернила);
			КонецЕсли;
			//-- смарт: Белоусова 494 22.04.2021
			ЗаписьJSON.ЗаписатьИмяСвойства("items");
			
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			
			Выборка = ВыборкаРодитель.Выбрать(); 
			Сч = 1;
			Пока Выборка.Следующий() Цикл
				
				ЗаписьJSON.ЗаписатьИмяСвойства("id-" + Сч);
				ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Выборка.Наименование));              
				Сч = Сч + 1;
			КонецЦикла;
			
			ЗаписьJSON.ЗаписатьКонецОбъекта();
			ЗаписьJSON.ЗаписатьКонецОбъекта(); 
			
		КонецЦикла;
				
		ЗаписьJSON.ЗаписатьКонецМассива();
		
		// ОТЛАДКА
		//СтрокаJSON = ЗаписьJSON.Закрыть();
		//сообщить(СтрокаJSON);	
		ЗаписьJSON.Закрыть();
		
	КонецЦикла;
	
	//++ смарт:ММ 594 15.08.2021
	Если СохранятьНаFTP Тогда
		
		АдресКаталога = ПолучитьСмартПредопределенноеЗначение("КаталогFTPДляОборудованияЧернил", Ложь);
		
		Если ЗначениеЗаполнено(АдресКаталога) Тогда
			
			ФайлОборудованиеСуществует = ФайлСуществует(ИмяВременногоФайлаОБОРУДОВАНИЕ);
			ФайлЧернилаСуществует = ФайлСуществует(ИмяВременногоФайлаЧЕРНИЛА);
			
			МассивВременныхФайлов = Новый Массив;
			
			Если ФайлОборудованиеСуществует Тогда
				СтруктураФайла = Новый Структура;
				СтруктураФайла.Вставить("ИмяФайла", "hardware.json");
				СтруктураФайла.Вставить("АдресФайла", ИмяВременногоФайлаОБОРУДОВАНИЕ);
				МассивВременныхФайлов.Добавить(СтруктураФайла);				
			КонецЕсли;
			
			Если ФайлЧернилаСуществует Тогда				
				СтруктураФайла = Новый Структура;
				СтруктураФайла.Вставить("ИмяФайла", "inks.json");
				СтруктураФайла.Вставить("АдресФайла", ИмяВременногоФайлаЧЕРНИЛА);
				МассивВременныхФайлов.Добавить(СтруктураФайла);
			КонецЕсли;
			
			Если МассивВременныхФайлов.Количество() > 0 Тогда
				СохранитьФайлыНаFTP(МассивВременныхФайлов, АдресКаталога);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	//-- смарт:ММ 15.08.2021

	//++ #1193 смарт: Фролов 23.11.2022 //Исправить ошибки в журнале регистрации 
