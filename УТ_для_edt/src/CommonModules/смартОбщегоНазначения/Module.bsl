//++ #Б-4290 смарт: Фролов 11.09.2025 //Доработки Автозадач
Функция ПолучитьРабочуюДатуОтносительноИсходной(ДатаИсходная, КоличествоДней, Направление) Экспорт
	
	НомерДня = 1;
	НужнаяДата = ДатаИсходная + ?(Направление = "Вперед", 1, (-1)) * 86400;
	Пока НомерДня < КоличествоДней Цикл
		
		Если ДатаЯвляетсяРабочей(НужнаяДата) Тогда
			
			НужнаяДата = НужнаяДата + ?(Направление = "Вперед", 1, (-1)) * 86400;
			НомерДня = НомерДня + 1;
			
		Иначе	
			
			НужнаяДата = НужнаяДата + ?(Направление = "Вперед", 1, (-1)) * 86400;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Пока НЕ ДатаЯвляетсяРабочей(НужнаяДата) Цикл
		
		НужнаяДата = НужнаяДата + ?(Направление = "Вперед", 1, (-1)) * 86400;	
		
	КонецЦикла;
		
	Возврат НужнаяДата;
	
КонецФункции //-- #Б-4290 смарт: Фролов 11.09.2025

