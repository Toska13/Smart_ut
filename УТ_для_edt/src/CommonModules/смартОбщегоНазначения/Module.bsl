//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Функция смартЗаписатьВыбраныеКонтейнерыВJSON(СписокКонтейнеров) Экспорт
	НастройкиСериализации = Новый НастройкиСериализацииJSON;
	НастройкиСериализации.СериализовыватьМассивыКакОбъекты = Истина;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ", Истина);
	Запись = Новый ЗаписьJSON;
	Запись.ПроверятьСтруктуру = Истина;
	Запись.УстановитьСтроку(ПараметрыJSON);
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("Контейнеры");
		Запись.ЗаписатьНачалоМассива();
		Для каждого Контейнер Из СписокКонтейнеров Цикл 
		Запись.ЗаписатьНачалоОбъекта();
		Если ТипЗнч(СписокКонтейнеров) = Тип("СписокЗначений") Тогда
			Запись.ЗаписатьИмяСвойства("Ссылка");
			Запись.ЗаписатьЗначение(Строка(Контейнер.Значение.УникальныйИдентификатор()));
			Запись.ЗаписатьИмяСвойства("Наименование");
			Запись.ЗаписатьЗначение(Строка(Контейнер));
			Запись.ЗаписатьИмяСвойства("Пометка");
			Запись.ЗаписатьЗначение(Контейнер.Пометка);
		ИначеЕсли ТипЗнч(СписокКонтейнеров) = Тип("Массив") Тогда
			Запись.ЗаписатьИмяСвойства("Ссылка");
			Запись.ЗаписатьЗначение(Контейнер.Ссылка);
			Запись.ЗаписатьИмяСвойства("Наименование");
			Запись.ЗаписатьЗначение(Контейнер.Наименование);
			Запись.ЗаписатьИмяСвойства("Пометка");
			Запись.ЗаписатьЗначение(Контейнер.Пометка);
		КонецЕсли;	
		Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
