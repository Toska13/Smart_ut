//++ #Б-1910 смарт: Лопато 20.01.2025 //Ошибка оформления документов УПД и РО по Заказу клиента  
Процедура ПроверитьКоличествоУпаковокВТЧТовары(Ссылка, Товары, Отказ) Экспорт

	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
    Для Каждого СтрокаТовара Из Товары Цикл
		
		ПараметрыПересчета = ОбработкаТабличнойЧастиКлиентСервер.НормализоватьПараметрыПересчетаЕдиниц(СтрокаТовара, Неопределено);
		
		ДанныеУпаковки = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьКоэффициентУпаковки(
							 ПараметрыПересчета.Упаковка, КэшированныеЗначения, ПараметрыПересчета.Номенклатура);
		
		Количество = СтрокаТовара.КоличествоУпаковок * ДанныеУпаковки.Коэффициент;
		
		Если ДанныеУпаковки.НужноОкруглятьКоличество
			И ПараметрыПересчета.НужноОкруглять Тогда
			
			Количество = Окр(Количество, 0, РежимОкругления.Окр15как20);
			
		КонецЕсли;
		
		Если СтрокаТовара.Количество <> Количество Тогда
			
			СообщениеТекст = СокрЛП(Ссылка) + Символы.ПС 
							 + "В строке " + СокрЛП(СтрокаТовара.НомерСтроки) 
							 + " по номенклатуре """ + СокрЛП(СтрокаТовара.Номенклатура) + """" 
							 + " количество товара """ + СокрЛП(СтрокаТовара.Количество) + """" 
							 + " не соответствует количеству упаковок """ + СокрЛП(СтрокаТовара.КоличествоУпаковок) + """!"
							 + Символы.ПС + "Срочно обратитесь в ИТ-Департамент!";

			ОбщегоНазначения.СообщитьПользователю(СообщениеТекст, , , , Отказ);

			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка несоответствия количества и количества упаковок'", 
									 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , СообщениеТекст);
			
		КонецЕсли;	
		
	КонецЦикла;	
		
КонецПроцедуры //-- #Б-1910 смарт: Лопато 20.01.2025	

