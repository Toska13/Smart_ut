//++#1336 смарт: Лопато 04.04.2023 //Ограничение создания заявки на ПНР (только после полной отгрузки)  
Функция смартЗаказКлиентаОтгруженОформлен(Заказ) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   СостоянияЗаказовКлиентов.Заказ КАК Заказ
    |ИЗ
    |   РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
    |ГДЕ
	|   СостоянияЗаказовКлиентов.Заказ = &Заказ
	|   И СостоянияЗаказовКлиентов.ПроцентОтгрузки = 100";
    
    Запрос.УстановитьПараметр("Заказ", Заказ);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    Возврат НЕ РезультатЗапроса.Пустой();
    
КонецФункции //--#1336 смарт: Лопато 04.04.2023

