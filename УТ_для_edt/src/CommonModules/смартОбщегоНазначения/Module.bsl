//++ смарт:ММ #054 301 19.06.2020 - Контрагенты с ЭДО
// В соответствии вернутся ТОЛЬКО ТЕ контрагенты, для которых есть записи в регистре сведений смартКонтрагентыСЭДО
&НаСервере
Функция ПолучитьЭДОКонтрагентов(МассивКонтрагентов = Неопределено, ВернутьТолькоКонтрагентов = Ложь) Экспорт
	
	СоответствиеВозврат = Новый Соответствие; // Контрагент - массив видов ЭДО
	МассивКонтрагентовВозврат = Новый Массив; 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартКонтрагентыСЭДО.Контрагент КАК Контрагент,
	|	""1С ЭДО"" КАК ВидЭДО
	|ПОМЕСТИТЬ ВТ_Объединение
	|ИЗ
	|	РегистрСведений.смартКонтрагентыСЭДО КАК смартКонтрагентыСЭДО
	|ГДЕ
	|	смартКонтрагентыСЭДО.ЭДО1С
	|	И ВЫБОР
	|			КОГДА &ОтборКонтрагенты
	|				ТОГДА смартКонтрагентыСЭДО.Контрагент В (&МассивКонтрагентов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	смартКонтрагентыСЭДО.Контрагент,
	|	""Диадок""
	|ИЗ
	|	РегистрСведений.смартКонтрагентыСЭДО КАК смартКонтрагентыСЭДО
	|ГДЕ
	|	смартКонтрагентыСЭДО.Диадок
	|	И ВЫБОР
	|			КОГДА &ОтборКонтрагенты
	|				ТОГДА смартКонтрагентыСЭДО.Контрагент В (&МассивКонтрагентов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	смартКонтрагентыСЭДО.Контрагент,
	|	""СБИС""
	|ИЗ
	|	РегистрСведений.смартКонтрагентыСЭДО КАК смартКонтрагентыСЭДО
	|ГДЕ
	|	смартКонтрагентыСЭДО.СБИС
	|	И ВЫБОР
	|			КОГДА &ОтборКонтрагенты
	|				ТОГДА смартКонтрагентыСЭДО.Контрагент В (&МассивКонтрагентов)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Объединение.Контрагент КАК Контрагент,
	|	ВТ_Объединение.ВидЭДО КАК ВидЭДО
	|ИЗ
	|	ВТ_Объединение КАК ВТ_Объединение
	|ИТОГИ ПО
	|	Контрагент";
	
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);
	Запрос.УстановитьПараметр("ОтборКонтрагенты", ?(ЗначениеЗаполнено(МассивКонтрагентов), Истина, Ложь));
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СоответствиеВозврат;
	КонецЕсли;
	
	ВыборкаКонтрагент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКонтрагент.Следующий() Цикл
		
		Контрагент = ВыборкаКонтрагент.Контрагент;
		
		Если МассивКонтрагентовВозврат.Найти(Контрагент) = Неопределено Тогда
			МассивКонтрагентовВозврат.Добавить(Контрагент);
		КонецЕсли;
		
		МассивВидовЭДОКонтрагента = Новый Массив;
		
		Выборка = ВыборкаКонтрагент.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивВидовЭДОКонтрагента.Добавить(Выборка.ВидЭДО);
		КонецЦикла;
		
		СоответствиеВозврат.Вставить(Контрагент, МассивВидовЭДОКонтрагента);
		
	КонецЦикла;
	
	Если ВернутьТолькоКонтрагентов Тогда
		Возврат МассивКонтрагентовВозврат;
	КонецЕсли;
	
	Возврат СоответствиеВозврат;
	
КонецФункции //-- смарт:ММ 19.06.2020

//++ смарт: #1438 Корбутов 04.09.2023 добавление выбора основного ЭДО контрагента 
// возвращает оператора ЭДО по умолчанию для контрагента
&НаСервере
Функция ПолучитьОсновнойЭДОКонтрагентов(МассивКонтрагентов = Неопределено) Экспорт
	
	СоответствиеВозврат = Новый Соответствие;
	Если Не ЗначениеЗаполнено(МассивКонтрагентов)
	Тогда 
		Возврат СоответствиеВозврат;
	Иначе 
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	|	смартКонтрагентыСЭДО.Контрагент КАК Контрагент,
	|	смартКонтрагентыСЭДО.ОператорЭДО КАК ОператорЭДО
	|ИЗ
	|	РегистрСведений.смартКонтрагентыСЭДО КАК смартКонтрагентыСЭДО
	|ГДЕ
	|	смартКонтрагентыСЭДО.Контрагент В(&МассивКонтрагентов)";
	
	Запрос.УстановитьПараметр("МассивКонтрагентов", МассивКонтрагентов);	
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СоответствиеВозврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() 
	Цикл
		СоответствиеВозврат.Вставить(Выборка.Контрагент, Выборка.ОператорЭДО);			
	КонецЦикла; 	
	Возврат СоответствиеВозврат;	
КонецФункции //-- смарт: #1438 Корбутов 04.09.2023

//++ смарт: #1438 Корбутов 04.09.2023 добавление выбора основного ЭДО контрагента
//пер. ЗначениеВыбора - Строка(4,0)
Процедура ЗаписатьВыборОсновногоЭДО(Контрагент,ЗначениеВыбора) Экспорт 
	УстановитьПривилегированныйРежим(Истина);
	НаборЗаписей = РегистрыСведений.смартКонтрагентыСЭДО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Контрагент.Установить(Контрагент);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0
	Тогда
		НовЗапись = НаборЗаписей.Добавить();
		НовЗапись.Контрагент = Контрагент;
		НовЗапись.ОператорЭДО = ЗначениеВыбора;
	Иначе
		НовЗапись = НаборЗаписей[0];
		НовЗапись.ОператорЭДО = ЗначениеВыбора;
	КонецЕсли;	
	НаборЗаписей.Записать();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры //-- смарт: #1438 Корбутов 04.09.2023

