//++#1323 смарт: Лопато 15.03.2023 //Восстановить и переделать механизм индивидуальных скидок
Функция смартПолучитьТекРуководительПовышенныеСкидки(Пользователь = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	СтруктураРезультат = Новый Структура("Значение, К2, К3, К4");
	
	МассивРуководителейРегионов = смартОбщегоНазначенияСКэш.смартПредопределенныеЗначенияКэш(
									  Справочники.смартПредопределенныеЗначения.смартПользователиПредоставленияПовышеннойСкидки); 
	
	Для каждого Стр Из МассивРуководителейРегионов Цикл
		
		Если Стр.Значение = Пользователь Тогда
			ЗаполнитьЗначенияСвойств(СтруктураРезультат, Стр); 
			Возврат СтруктураРезультат;
		КонецЕсли;
	   
    КонецЦикла;      
    
    Возврат СтруктураРезультат;
       
