//++ смарт:ММ #082 397 26.12.2020 - Выгрузка при создании оборудования
Функция ОтправитьФайлыОборудование(ИмяВременногоФайлаОБОРУДОВАНИЕ, ИмяВременногоФайлаЧЕРНИЛА)
	
	Успех = Ложь;
	
	ИмяСобытияЖР = "ОтправкаФайловОборудованиеJSON_смарт";
	ФайлОборудованиеСуществует = ФайлСуществует(ИмяВременногоФайлаОБОРУДОВАНИЕ);
	ФайлЧернилаСуществует = ФайлСуществует(ИмяВременногоФайлаЧЕРНИЛА);
	Если НЕ ФайлОборудованиеСуществует И НЕ ФайлЧернилаСуществует Тогда
		ТекстСообщения = "Не найдены файлы для отправки";
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Успех;
	КонецЕсли;
	
	АдресаДляОтправкиСтрокой = "";
	СсылкаПредопределнноеЗначение = Справочники.смартПредопределенныеЗначения.АдресДляОтправкиВыгрузкиОборудования;	
	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаПредопределнноеЗначение, АдресаДляОтправкиСтрокой, Ложь);

	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если МассивАдресовДляОтправки.Количество() = 0 И НЕ ЭтоТестоваяБаза Тогда
		ТекстСообщения = "Не найдены получатели в справочнике ""Предопределенные значения (смарт)""";
		ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Успех;
	КонецЕсли;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);	
	//-- смарт:ММ 03.03.2021
	
	Если ЗначениеЗаполнено(УчетнаяЗапись) 
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда
		И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		//-- смарт:ММ 03.03.2021
		
		ТемаПисьма = "Выгрузка оборудования из УТ";
		
		ТекстПисьма = "";
		
		Вложения = Новый Массив;
		
		Если ФайлОборудованиеСуществует Тогда
			Вложение = Новый Структура;		
			Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайлаОБОРУДОВАНИЕ);
			Вложение.Вставить("Представление", "ОборудованиеУТ.json");
		КонецЕсли;
		
		Вложения.Добавить(Вложение);
		
		Если ФайлЧернилаСуществует Тогда
			Вложение = Новый Структура;		
			Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайлаЧЕРНИЛА);
			Вложение.Вставить("Представление", "ЧернилаУТ.json");
		КонецЕсли;
		
		Вложения.Добавить(Вложение);
		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		ПараметрыПисьма.Вставить("Вложения", Вложения);
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо с файлами оборудования НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + "(в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено письмо с файлами оборудования на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			//ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Успех = Истина;
		Исключение 
			//++ #1416 смарт: Фролов 29.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,,ТекстПисьма);
			//-- #1416 смарт: Фролов 29.08.2023
			ТекстСообщения = "Не удалось отправить письмо с файлами оборудования" + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
		Попытка
			УдалитьФайлы(ИмяВременногоФайлаОБОРУДОВАНИЕ);
			УдалитьФайлы(ИмяВременногоФайлаЧЕРНИЛА);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции //-- смарт:ММ 26.12.2020

