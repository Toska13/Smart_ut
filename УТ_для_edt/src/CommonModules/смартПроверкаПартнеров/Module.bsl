		|	NULL,
		|	Т.ВидДубля
		|ИЗ
		|	ВТДублиПартнеровКонтрагентов КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Партнер,
		|	Т.ПартнерДубль,
		|	Т.КонтактноеЛицо,
		|	Т.КонтактноеЛицо.Владелец,
		|	Т.КонтактнаяИнформация,
		|	Т.ТипКонтактнойИнформации,
		|	NULL,
		|	Т.Контрагент,
		|	NULL,
		|	Т.ВидДубля
		|ИЗ
		|	ВТДублиКонтрагентовКонтактныхЛиц КАК Т";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка,"Партнер,ПартнерДубль,ТипКонтактнойИнформации,КонтактнаяИнформация,ВидДубля");
		
		Если Выборка.ВидДубля = "ДубльПартнеров" Тогда
		ИначеЕсли Выборка.ВидДубля = "ДубльКонтактныхЛиц" Тогда
			НоваяСтрока.КонтактноеЛицо = Выборка.КонтактноеЛицо;
			НоваяСтрока.КонтактноеЛицоДубль = Выборка.КонтактноеЛицоДубль;
		ИначеЕсли Выборка.ВидДубля = "ДубльКонтрагентов" Тогда
			НоваяСтрока.Контрагент = Выборка.Контрагент;
			НоваяСтрока.КонтрагентДубль = Выборка.КонтрагентДубль;
		ИначеЕсли Выборка.ВидДубля = "ДубльПартнерКонтактноеЛицо" Тогда
			Если Выборка.КонтактноеЛицоВладелец = Партнер Тогда
				НоваяСтрока.КонтактноеЛицо = Выборка.КонтактноеЛицо;
			Иначе
				НоваяСтрока.КонтактноеЛицоДубль = Выборка.КонтактноеЛицо;
			КонецЕсли;
		ИначеЕсли Выборка.ВидДубля = "ДубльКонтрагентКонтактноеЛицо" Тогда
			Если Выборка.КонтактноеЛицоВладелец = Партнер Тогда
				НоваяСтрока.КонтактноеЛицо = Выборка.КонтактноеЛицо;
				НоваяСтрока.КонтрагентДубль = Выборка.Контрагент;
			Иначе
				НоваяСтрока.Контрагент = Выборка.Контрагент;
				НоваяСтрока.КонтактноеЛицоДубль = Выборка.КонтактноеЛицо;
			КонецЕсли;
		ИначеЕсли Выборка.ВидДубля = "ДубльПартнерКонтрагент" Тогда
			Если Выборка.КонтактноеЛицоВладелец = Партнер Тогда
				НоваяСтрока.Контрагент = Выборка.Контрагент;
			Иначе
				НоваяСтрока.КонтрагентДубль = Выборка.Контрагент;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ АдресВременногоХранилища = Неопределено Тогда
		ПоместитьВоВременноеХранилище(Результат, АдресВременногоХранилища);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

