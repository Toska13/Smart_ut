	Результат.Колонки.Добавить("Партнер");
	Результат.Колонки.Добавить("ПартнерДубль");
	Результат.Колонки.Добавить("КонтактноеЛицо");
	Результат.Колонки.Добавить("КонтактноеЛицоДубль");
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("КонтрагентДубль");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	Если ЗначениеЗаполнено(Телефон) ИЛИ ЗначениеЗаполнено(ЭлектроннаяПочта) Тогда
		
		Запрос.УстановитьПараметр("Телефон", Телефон);
		Запрос.УстановитьПараметр("ЭлектроннаяПочта", ЭлектроннаяПочта);
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Партнер КАК Партнер,
		|	Т.Ссылка КАК ПартнерДубль,
		|	NULL КАК КонтактноеЛицо,
		|	NULL КАК КонтактноеЛицоВладелец,
		|	Т.НомерТелефона КАК КонтактнаяИнформация,
		|	Т.Тип КАК ТипКонтактнойИнформации,
		|	NULL КАК КонтактноеЛицоДубль,
		|	NULL КАК Контрагент,
		|	NULL КАК КонтрагентДубль,
		|	""ДубльПартнеров"" КАК ВидДубля
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК Т
		|ГДЕ
		|	Т.Ссылка <> &Партнер
		|	И Т.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|	И Т.НомерТелефона = &Телефон
		|	И Т.НомерТелефона <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Партнер,
		|	Т.Ссылка,
		|	NULL,
		|	NULL,
		|	Т.АдресЭП,
		|	Т.Тип,
		|	NULL,
		|	NULL,
		|	NULL,
		|	""ДубльПартнеров""
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК Т
		|ГДЕ
		|	Т.Ссылка <> &Партнер
		|	И Т.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И Т.АдресЭП = &ЭлектроннаяПочта
		|	И Т.АдресЭП <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&Партнер,
		|	Т.Ссылка.Владелец,
		|	Т.Ссылка,
