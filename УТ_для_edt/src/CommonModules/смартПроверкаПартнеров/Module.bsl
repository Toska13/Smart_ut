//++ смарт:ММ #036 176 15.03.2020 - создание партнеров от дилеров
Функция НаименованиеПартнера(ДанныеДляЗаполнения) Экспорт
	
	ЭтоКомпания = ДанныеДляЗаполнения.ЭтоКомпания;
	ИспользуютсяТолькоПартнеры = Ложь;
	ПолноеЮридическоеНаименование 	= ДанныеДляЗаполнения.ПолноеЮридическоеНаименование;
	ПолноеНаименование 				= ДанныеДляЗаполнения.ПолноеНаименование;
	ФамилияПартнера 				= ДанныеДляЗаполнения.ФамилияПартнера;
	ИмяПартнера		 				= ДанныеДляЗаполнения.ИмяПартнера;
	ОтчествоПартнера 				= ДанныеДляЗаполнения.ОтчествоПартнера;
	
	Если ЭтоКомпания = 0 Тогда
		Возврат ?(ИспользуютсяТолькоПартнеры, ПолноеЮридическоеНаименование, ПолноеНаименование)
	Иначе
		Возврат ФИО_ОднойСтрокой(ФамилияПартнера, ИмяПартнера, ОтчествоПартнера);
	КонецЕсли;
	
КонецФункции //-- смарт:ММ 15.03.2020

//++ смарт:ММ #036 176 15.03.2020 - создание партнеров от дилеров
Функция ФИО_ОднойСтрокой(Фамилия,Имя,Отчество) Экспорт
	
	Возврат СокрЛП(СокрЛП(Фамилия) + " " + СокрЛП(Имя) + " " + СокрЛП(Отчество));
	
КонецФункции //-- смарт:ММ 15.03.2020

