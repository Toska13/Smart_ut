//++#1012 смарт: Холопов 04.05.2022 // Проверка полей с контактной информацией
&НаКлиенте
Процедура ПроверитьПочтуПриИзменении(Элемент,Ссылка,Форма) Экспорт
	
	Текст = Элемент.ТекстРедактирования;
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ИтогПроверки = смартОбщегоНазначения.ПроверитьАдресЭлектроннойПочты(Текст,Ссылка); 
	
	Если ИтогПроверки.КодОшибки <> 0 Тогда
		
		//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
		Если ИтогПроверки.КодОшибки = 12 И ИтогПроверки.Свойство("МассивДублей") Тогда
			
			ОчиститьСообщения();

			ОбщегоНазначенияКлиент.СообщитьПользователю(ИтогПроверки.СообщениеОшибки, , Элемент.Имя);
			
			Для Каждого ЭлементДубль Из ИтогПроверки.МассивДублей Цикл
				ОбщегоНазначенияКлиент.СообщитьПользователю(ЭлементДубль.ТекстСообщения, ЭлементДубль.Ключ);
			КонецЦикла;
				
		Иначе
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ИтогПроверки.СообщениеОшибки, , Элемент.Имя);
			
		КонецЕсли;
		
		смартУдалитьВведенныйТекст(Форма);
		//-- #1152 смарт: Лопато 18.10.2024
	
	КонецЕсли;

КонецПроцедуры //--#1012 смарт: Холопов 04.05.2022

//++#1012 смарт: Холопов 04.05.2022 // Проверка полей с контактной информацией
&НаКлиенте
Процедура смартУдалитьВведенныйТекст(Форма) Экспорт
	
	Если ТипЗнч(Форма) <> Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат;		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.ПомощникНового" Тогда
		
		Форма.АдресЭППартнера = "";
		Форма.АдресЭПКЛ = "";
		
	ИначеЕсли Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая" Тогда	
		
		Форма.Контакт_Email = "";
				
	ИначеЕсли Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаБыстрогоВвода" Тогда 
				
		Форма.Email = "";
		Форма.EmailКонтактногоЛица = "";

	//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
	ИначеЕсли Форма.ИмяФормы = "Справочник.КонтактныеЛицаПартнеров.Форма.CRM_ФормаБыстрогоВвода" Тогда	
		
		Форма.EmailКонтактногоЛица = "";
	//-- #1152 смарт: Лопато 18.10.2024
		
	КонецЕсли;
	
КонецПроцедуры //--#1012 смарт: Холопов 04.05.2022

