#Область ПроверкиПриСозданииПартнера

//++ смарт:ММ #036 176 15.03.2020 - создание партнеров от дилеров
// ДанныеДляЗаполнения - структура с именами реквизитов
Функция ПроверкаПервичнойИнформацииПартнер(ДанныеДляЗаполнения, СтруктураНезаполненныеРеквизиты, ВсеПоляЗаполнены, ОбязательныеПоляКонтактнойИнформации) Экспорт
	
	ЭтоКомпания 		= ДанныеДляЗаполнения.ЭтоКомпания;
	ВидКомпании 		= ДанныеДляЗаполнения.ВидКомпании;
	ФамилияПартнера 	= ДанныеДляЗаполнения.ФамилияПартнера;
	ИмяПартнера 		= ДанныеДляЗаполнения.ИмяПартнера;
	ПолноеНаименование 	= ДанныеДляЗаполнения.ПолноеНаименование;
	АдресЭППартнера 	= ДанныеДляЗаполнения.АдресЭППартнера;
	ТелефонПартнера 	= ДанныеДляЗаполнения.ТелефонПартнера;
	АдресЭПКЛ 			= ДанныеДляЗаполнения.АдресЭПКЛ;
	ТелефонКЛ 			= ДанныеДляЗаполнения.ТелефонКЛ;
	МобильныйТелефонКЛ 	= ДанныеДляЗаполнения.МобильныйТелефонКЛ;
	АдресЭППартнераФизЛицо = ДанныеДляЗаполнения.АдресЭППартнераФизЛицо;
	ТелефонПартнераФизЛицо = ДанныеДляЗаполнения.ТелефонПартнераФизЛицо;
	ПолноеЮридическоеНаименование = ДанныеДляЗаполнения.ПолноеЮридическоеНаименование;
	ИНН 				= ДанныеДляЗаполнения.ИНН;
	КПП 				= ДанныеДляЗаполнения.КПП;
	ФамилияКЛ 			= ДанныеДляЗаполнения.ФамилияКЛ;
	ИмяКЛ 				= ДанныеДляЗаполнения.ИмяКЛ;
	УказыватьЮридическиеРеквизиты = ДанныеДляЗаполнения.УказыватьЮридическиеРеквизиты;
	
	АдресЭППартнераОбязателен = ОбязательныеПоляКонтактнойИнформации.АдресЭППартнераОбязателен;
	ТелефонПартнераОбязателен = ОбязательныеПоляКонтактнойИнформации.ТелефонПартнераОбязателен;
	АдресЭПКонтактногоЛицаОбязателен = ОбязательныеПоляКонтактнойИнформации.АдресЭПКонтактногоЛицаОбязателен;
	ТелефонКонтактногоЛицаОбязателен = ОбязательныеПоляКонтактнойИнформации.ТелефонКонтактногоЛицаОбязателен;
	МобильныйТелефонКонтактногоЛицаОбязателен = ОбязательныеПоляКонтактнойИнформации.МобильныйТелефонКонтактногоЛицаОбязателен;
	
	
	ИспользуютсяТолькоПартнеры = Ложь;
	УказатьДанныеКонтактногоЛица = Истина;
	УказатьДокументУдостоверяющийЛичность = Ложь;
	УпрощенныйВводДоступен = Ложь; //ПартнерыИКонтрагенты.УпрощенныйВводДоступен();
	
	Отказ = Ложь;
	
	Если ЭтоКомпания = 0 Тогда
		Если ПустаяСтрока(ПолноеНаименование) Тогда
			СтруктураНезаполненныеРеквизиты.Вставить("ПолноеНаименование", "Не указано публичное наименование партнера");
			Отказ = Истина;
		КонецЕсли;
	ИначеЕсли ЭтоКомпания = 1 Тогда
		Если ПустаяСтрока(ФамилияПартнера) Тогда
			СтруктураНезаполненныеРеквизиты.Вставить("ФамилияПартнера", "Не указана фамилия партнера");
			Отказ = Истина;
		КонецЕсли;
		Если ПустаяСтрока(ИмяПартнера) Тогда
			СтруктураНезаполненныеРеквизиты.Вставить("ИмяПартнера", "Не указано имя партнера");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОбязательностьКонтактнойИнформацииОтработана = Ложь;
	
	Если ЭтоКомпания = 0 Тогда
		
		Если АдресЭППартнераОбязателен
			И Не ЗначениеЗаполнено(АдресЭППартнера) Тогда
			
			СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнера", "Не указан адрес электронной почты партнера");
			Отказ = Истина;
			ОбязательностьКонтактнойИнформацииОтработана = Истина;
			
		КонецЕсли;
		
		Если ТелефонПартнераОбязателен
			И Не ЗначениеЗаполнено(ТелефонПартнера) Тогда
			
			СтруктураНезаполненныеРеквизиты.Вставить("ТелефонПартнера", "Не указан телефон партнера");
			Отказ = Истина;
			ОбязательностьКонтактнойИнформацииОтработана = Истина;
			
		КонецЕсли;
		
		Если УказатьДанныеКонтактногоЛица Тогда
			
			Если АдресЭПКонтактногоЛицаОбязателен
				И Не ЗначениеЗаполнено(АдресЭПКЛ) Тогда
				
				СтруктураНезаполненныеРеквизиты.Вставить("АдресЭПКЛ", "Не указан адрес электронной почты контактного лица");
				Отказ = Истина;
				ОбязательностьКонтактнойИнформацииОтработана = Истина;
				
			КонецЕсли;
			
			Если ТелефонКонтактногоЛицаОбязателен 
				И Не ЗначениеЗаполнено(ТелефонКЛ) Тогда
				
				СтруктураНезаполненныеРеквизиты.Вставить("ТелефонКЛ", "Не указан телефон контактного лица");
				Отказ = Истина;
				ОбязательностьКонтактнойИнформацииОтработана = Истина;
				
			КонецЕсли;
			
			Если МобильныйТелефонКонтактногоЛицаОбязателен 
				И Не ЗначениеЗаполнено(МобильныйТелефонКЛ) Тогда
				
				СтруктураНезаполненныеРеквизиты.Вставить("МобильныйТелефонКЛ", "Не указан мобильный телефон контактного лица");
				Отказ = Истина;
				ОбязательностьКонтактнойИнформацииОтработана = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ОбязательностьКонтактнойИнформацииОтработана 
			И ПустаяСтрока(АдресЭППартнера)
			И ПустаяСтрока(ТелефонПартнера) Тогда
			
			Если (УказатьДанныеКонтактногоЛица) Тогда
				
				Если ПустаяСтрока(ТелефонКЛ) И ПустаяСтрока(МобильныйТелефонКЛ) И ПустаяСтрока(АдресЭПКЛ) Тогда
					
					СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнера", "Необходимо указать хотя бы одно значение контактной информации");
					Отказ = Истина;
					
				КонецЕсли;
				
			Иначе
				СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнера", "Необходимо указать хотя бы одно значение контактной информации");
				Отказ = Истина;				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если АдресЭППартнераОбязателен
			И Не ЗначениеЗаполнено(АдресЭППартнераФизЛицо) Тогда
			
			СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнераФизЛицо", "Не указан адрес электронной почты партнера");
			Отказ = Истина;
			ОбязательностьКонтактнойИнформацииОтработана = Истина;
			
		КонецЕсли;
		
		Если ТелефонПартнераОбязателен
			И Не ЗначениеЗаполнено(ТелефонПартнераФизЛицо) Тогда
			
			СтруктураНезаполненныеРеквизиты.Вставить("ТелефонПартнераФизЛицо", "Не указан телефон партнера");
			Отказ = Истина;
			ОбязательностьКонтактнойИнформацииОтработана = Истина;
			
		КонецЕсли;
		
		Если Не ОбязательностьКонтактнойИнформацииОтработана
			И ПустаяСтрока(АдресЭППартнераФизЛицо) И ПустаяСтрока(ТелефонПартнераФизЛицо) Тогда
			
			СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнераФизЛицо", "Необходимо указать хотя бы одно значение контактной информации");
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если УказыватьЮридическиеРеквизиты Тогда
		
		Если Не ИспользуютсяТолькоПартнеры И ЭтоКомпания = 0 Тогда
			Если ПустаяСтрока(ПолноеЮридическоеНаименование) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("НаименованиеКонтрагента", "Не указано сокращенное юр. наименование");
				Отказ = Истина; 
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоКомпания = 0 И (ВидКомпании = 0 Или ВидКомпании = 3) Тогда
			Если ПустаяСтрока(ИНН) И Не ПустаяСтрока(КПП) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("ИНН", "Указан КПП, но не указан ИНН");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоКомпания = 0 И НЕ ВидКомпании = 1 И НЕ УпрощенныйВводДоступен Тогда
			Если ПустаяСтрока(ИНН) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("ИНН", "Не указан ИНН");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		//Если ЭтоКомпания = 1 И УказыватьЮридическиеРеквизиты И УказатьДокументУдостоверяющийЛичность Тогда
		//	Если Не ЗначениеЗаполнено(ВидДокумента) Тогда
		//		СтруктураНезаполненныеРеквизиты.Вставить("ВидДокумента", "Не указан вид документа, удостоверяющего личность");
		//		Отказ = Истина
		//	КонецЕсли;
		//КонецЕсли;
		
	КонецЕсли;
	
	Если УказатьДанныеКонтактногоЛица И ЭтоКомпания = 0 Тогда
		
		//Если ПустаяСтрока(ФамилияКЛ) Тогда
		//	СтруктураНезаполненныеРеквизиты.Вставить("ФамилияКЛ", "Не указана фамилия контактного лица");
		//	Отказ = Истина;
		//КонецЕсли;
		
		Если ПустаяСтрока(ИмяКл) Тогда
			СтруктураНезаполненныеРеквизиты.Вставить("ИмяКЛ", "Не указано имя контактного лица");
			Отказ = Истина;
		КонецЕсли;
		
		Если ПустаяСтрока(ТелефонКЛ) И ПустаяСтрока(АдресЭПКЛ) И ПустаяСтрока(МобильныйТелефонКЛ) Тогда
			СтруктураНезаполненныеРеквизиты.Вставить("АдресЭПКЛ", "Необходимо указать хотя бы одно значение контактной информации контактного лица");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		// проверка корректности адресов электронной почты
		Если  НЕ ПустаяСтрока(АдресЭППартнера) И ЭтоКомпания = 0 Тогда
			Если ОбщегоНазначенияУТКлиентСервер.ПроверитьЗаполнениеПочтовогоАдреса(АдресЭППартнера) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнера", "Неверный формат адреса электронной почты партнера");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если  НЕ ПустаяСтрока(АдресЭППартнераФизЛицо) И ЭтоКомпания = 1 Тогда
			Если ОбщегоНазначенияУТКлиентСервер.ПроверитьЗаполнениеПочтовогоАдреса(АдресЭППартнераФизЛицо) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("АдресЭППартнераФизЛицо", "Неверный формат адреса электронной почты партнера");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если  УказатьДанныеКонтактногоЛица И НЕ ПустаяСтрока(АдресЭПКЛ) И ЭтоКомпания = 0 Тогда
			Если ОбщегоНазначенияУТКлиентСервер.ПроверитьЗаполнениеПочтовогоАдреса(АдресЭПКЛ) Тогда
				СтруктураНезаполненныеРеквизиты.Вставить("АдресЭПКЛ", "Неверный формат адреса электронной почты контактного лица");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		//// Проверка данных физического лица
		//Если  ЭтоКомпания = 1 И УказыватьЮридическиеРеквизиты И УказатьДокументУдостоверяющийЛичность Тогда
		//	
		//	Если Не ПустаяСтрока(СерияДокумента) Тогда
		//		ТекстОшибки = "";
		//		Отказ = Не ФизическиеЛицаКлиентСерверУТ.СерияДокументаУказанаПравильно(ВидДокумента, СерияДокумента, ТекстОшибки) Или Отказ;
		//		Если Не ПустаяСтрока(ТекстОшибки) Тогда
		//			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "СерияДокумента");
		//		КонецЕсли;
		//	КонецЕсли;
		//	
		//	Если Не ПустаяСтрока(НомерДокумента) Тогда
		//		ТекстОшибки = "";
		//		Отказ = Не ФизическиеЛицаКлиентСерверУТ.НомерДокументаУказанПравильно(ВидДокумента, НомерДокумента, ТекстОшибки) Или Отказ;
		//		Если Не ПустаяСтрока(ТекстОшибки) Тогда
		//			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "НомерДокумента");
		//		КонецЕсли;
		//	КонецЕсли;
		//	
		//КонецЕсли;
		
	КонецЕсли;

	Если Отказ Тогда
		ВсеПоляЗаполнены = Ложь;
	КонецЕсли;
			
КонецФункции

//++ смарт:ММ #036 176 15.03.2020 - создание партнеров от дилеров
Функция ОткрытьФормуПомощникаСозданияПартнера(ДанныеДляЗаполнения, Форма, ИмяСтраницы, СтруктураАдреса = Неопределено) Экспорт
	
	СписокОтборПоТипуПартнера = Новый СписокЗначений;
	СписокОтборПоТипуПартнера.Добавить("Клиент");
	СписокОтборПоТипуПартнера.Добавить("УказатьДанныеКонтактногоЛица");
	
	Основание = Новый Структура;
	Основание.Вставить("Описание", ДанныеДляЗаполнения.ПолноеНаименование);
	Основание.Вставить("АдресЭППартнера", "");
	Основание.Вставить("ИНН", ДанныеДляЗаполнения.ИНН);
	Основание.Вставить("КПП", ДанныеДляЗаполнения.КПП);			
	
	ПараметрыФормы = Новый Структура;			
	ПараметрыФормы.Вставить("СписокОтборПоТипуПартнера", СписокОтборПоТипуПартнера);
	ПараметрыФормы.Вставить("Основание", Основание);
	
	Если ИмяСтраницы = "СтраницаНайдено" И ТипЗнч(СтруктураАдреса) = Тип("Структура") Тогда
		ПараметрыФормы.Вставить("АдресТаблицаНайдено", СтруктураАдреса.АдресТаблицаНайдено);
		ПараметрыФормы.Вставить("АдресДеревоДанных", СтруктураАдреса.АдресДеревоДанных);
		
	КонецЕсли;

	ФормаПомощникНового = ПолучитьФорму("Справочник.Партнеры.Форма.ПомощникНового", ПараметрыФормы, Форма);
	
	ФормаПомощникНового.ПолноеЮридическоеНаименование = ДанныеДляЗаполнения.ПолноеЮридическоеНаименование;
		
	ФормаПомощникНового.ФамилияКЛ 	= ДанныеДляЗаполнения.ФамилияКЛ;
	ФормаПомощникНового.ИмяКЛ 		= ДанныеДляЗаполнения.ИмяКЛ;
	ФормаПомощникНового.ОтчествоКЛ 	= ДанныеДляЗаполнения.ОтчествоКЛ;
	ФормаПомощникНового.АдресЭПКЛ 	= ДанныеДляЗаполнения.АдресЭПКЛ;
	
	ФормаПомощникНового.Элементы.СтраницыПомощника.ТекущаяСтраница = ФормаПомощникНового.Элементы[ИмяСтраницы];
	//Если ЗначениеЗаполнено(ИмяДопСтраницы) Тогда
		//ФормаПомощникНового.Элементы.ГруппаДействиеСКонтрагентом.ТекущаяСтраница = ФормаПомощникНового.Элементы[ИмяСтраницы];
	//КонецЕсли;
	Если ИмяСтраницы = "СтраницаНайдено" И ТипЗнч(СтруктураАдреса) = Тип("Структура") Тогда
		
		ФормаПомощникНового.СтекПредыдущихСтраниц.Добавить(ФормаПомощникНового.Элементы.СтраницаПервичнаяИнформация.Имя);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ФормаПомощникНового, ДанныеДляЗаполнения);
	
	ФормаПомощникНового.Открыть();
	
КонецФункции

#КонецОбласти

#Область ПроеркаКоличестваВТоварах

//++ смарт:ММ #040 217 21.03.2020 - проверка рулонов
Функция ПроверитьПравильностьЗаполненияКоличестваВСтроке(Строка) Экспорт
	
	Намотка = Число(Строка(Строка.Характеристика));
	
	Если Не Намотка = 1 Тогда
		КоличествоКОтгрузке = Строка.КоличествоУпаковок;
	Иначе
		КоличествоКОтгрузке = Истина;
	КонецЕсли;
		
