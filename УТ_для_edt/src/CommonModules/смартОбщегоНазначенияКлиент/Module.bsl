//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Процедура смартВыполнитьЗвонок(ДополнительныеПараметры, Ошибка, СтрокаПояснения) Экспорт

	Если ПустаяСтрока(ДополнительныеПараметры.Телефон) Тогда
		Ошибка = "Не задан номер телефона!";
		Возврат;
	КонецЕсли;
	
	ПараметрыЗвонка = смартОбщегоНазначения.ПодготовитьПараметрыЗвонка(ДополнительныеПараметры);

	СтрокаПояснения = "Контакт: " + ПараметрыЗвонка.НаименованиеКонтакта + ", тел: " + ПараметрыЗвонка.Телефон;
	
	ДополнительныеПараметрыОповещения = Новый Структура;
	ДополнительныеПараметрыОповещения.Вставить("ПараметрыЗвонка", ПараметрыЗвонка);
	
	ОповещениеВыборИсходящегоНомераЗавершение = Новый ОписаниеОповещения("смартВыборИсходящегоНомераЗавершение", ЭтотОбъект, ДополнительныеПараметрыОповещения);
	
	Если ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомер) И ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомерВАТС) Тогда

		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПользовательВнутреннийНомер", 	   ПараметрыЗвонка.ПользовательВнутреннийНомер);
		ПараметрыФормы.Вставить("ПользовательВнутреннийНомерВАТС", ПараметрыЗвонка.ПользовательВнутреннийНомерВАТС);
		
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		Если ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомерВАТСДополнительный) Тогда
			
			ПараметрыФормы.Вставить("ПользовательВнутреннийНомерВАТСДополнительный", ПараметрыЗвонка.ПользовательВнутреннийНомерВАТСДополнительный);		
			
		КонецЕсли;
		//-- #Б-6744 смарт: Фролов 28.05.2026
		
		ОткрытьФорму("ОбщаяФорма.смартФормаВыбораИсходящегоНомера", ПараметрыФормы,,,,,ОповещениеВыборИсходящегоНомераЗавершение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	Иначе
		
		Если ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомер) Тогда	
			
			ПараметрыВыбораНомера = Новый Структура;
			ПараметрыВыбораНомера.Вставить("ВыбранныйТипНомера", "ПользовательВнутреннийНомер");
			
			ВыполнитьОбработкуОповещения(ОповещениеВыборИсходящегоНомераЗавершение, ПараметрыВыбораНомера);
			
		ИначеЕсли ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомерВАТС) Тогда	
			
			ПараметрыВыбораНомера = Новый Структура;
			ПараметрыВыбораНомера.Вставить("ВыбранныйТипНомера", "ПользовательВнутреннийНомерВАТС");
			
			ВыполнитьОбработкуОповещения(ОповещениеВыборИсходящегоНомераЗавершение, ПараметрыВыбораНомера);
			
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		ИначеЕсли ЗначениеЗаполнено(ПараметрыЗвонка.ПользовательВнутреннийНомерВАТСДополнительный) Тогда	
			
			ПараметрыВыбораНомера = Новый Структура;
			ПараметрыВыбораНомера.Вставить("ВыбранныйТипНомера", "ПользовательВнутреннийНомерВАТСДополнительный");
			
			ВыполнитьОбработкуОповещения(ОповещениеВыборИсходящегоНомераЗавершение, ПараметрыВыбораНомера);
		//-- #Б-6744 смарт: Фролов 28.05.2026
			
		Иначе

			Ошибка = "Не задан исходящий номер телефона!";
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры //--#1352 смарт: Лопато 04.05.2023

//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
Процедура смартВыборИсходящегоНомераЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда
		
		ПараметрыЗвонка = ДополнительныеПараметры.ПараметрыЗвонка;
		
		Если РезультатЗакрытия.ВыбранныйТипНомера = "ПользовательВнутреннийНомер" Тогда
			
			ПараметрыЗвонка.Вставить("ИмяМетода", 	   "ClickToCall");
			ПараметрыЗвонка.Вставить("ИсходящийНомер", ПараметрыЗвонка.ПользовательВнутреннийНомер);

		ИначеЕсли РезультатЗакрытия.ВыбранныйТипНомера = "ПользовательВнутреннийНомерВАТС" Тогда	

			ПараметрыЗвонка.Вставить("ИмяМетода", 	   "MakeCall");
			ПараметрыЗвонка.Вставить("ИсходящийНомер", ПараметрыЗвонка.ПользовательВнутреннийНомерВАТС);
			
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		ИначеЕсли РезультатЗакрытия.ВыбранныйТипНомера = "ПользовательВнутреннийНомерВАТСДополнительный" Тогда	

			ПараметрыЗвонка.Вставить("ИмяМетода", 	   "MakeCall");
			ПараметрыЗвонка.Вставить("ИсходящийНомер", ПараметрыЗвонка.ПользовательВнутреннийНомерВАТСДополнительный);
		//-- #Б-6744 смарт: Фролов 28.05.2026

		Иначе

			Ошибка = "Не задан исходящий номер телефона!";
			Возврат;
			
		КонецЕсли;

		Ответ = смартОбщегоНазначения.смартТелефонияВыполнитьHTTPЗапрос(ПараметрыЗвонка);
		
		//++#1359 смарт: Лопато 12.09.2023 //Доработать регистрацию звонков в 1С (интеграция с ВАТС и Asterisk)  
		Если Ответ <> Неопределено Тогда
			
			//++ #2023 смарт: Лопато 29.08.2024 //Ошибки в форме заказа клиента  
			СтруктураИзJSON = сфпСофтФонПроСервер.СтруктураJSON(Ответ);
			//-- #2023 смарт: Лопато 29.08.2024
			
			Если СтруктураИзJSON.Свойство("message") Тогда
				СообщениеОтвет = СтруктураИзJSON["message"];
				Если СообщениеОтвет = "Domain disabled" Тогда
					ОбщегоНазначенияКлиент.СообщитьПользователю("Обязательно обратитесь к администратору, сервис Мегафон заблокирован, скорее всего, за неуплату!");
					Возврат;	
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;	
		//--#1359 смарт: Лопато 12.09.2023
		
		смартОбщегоНазначения.смартОбработатьИсходящийЗвонок(ПараметрыЗвонка, Ответ);
		
	КонецЕсли;	

КонецПроцедуры //--#1352 смарт: Лопато 04.05.2023

#КонецОбласти

//++ #1409 смарт: Лопато 27.07.2023 //Выбора компании - контрагента из Списка поставщиков  
Процедура смартДанныеВыбораПоЧастиСтроки(Текст, СписокВыбора, ДанныеВыбора, МаксНайденных = 0) Экспорт
	
	ТекстПоиска = ВРег(Текст);
	
	Пока СтрНайти(ТекстПоиска, "  ") > 0 Цикл
		ТекстПоиска = СтрЗаменить(ТекстПоиска, "  ", " ");
	КонецЦикла;
	
	ТекстПоиска = СокрЛП(ТекстПоиска);
	
	ДлинаТекста = СтрДлина(ТекстПоиска);
	Если ДлинаТекста = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Шрифт = Новый Шрифт(,,Истина);
	Цвет = WebЦвета.Зеленый;
	
	ДанныеВыбора = Новый СписокЗначений;
	
	МассивПодстрок = СтрРазделить(ТекстПоиска, " ");
	
	Для Каждого Стр Из СписокВыбора Цикл
		
		Строка = Стр.Значение;
		СтрокаВРег = ВРег(Строка);
		
		ВхожденияНайдены = Истина;
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			Если Найти(СтрокаВРег, Подстрока) = 0 Тогда
				ВхожденияНайдены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не ВхожденияНайдены Тогда
			Продолжить
		КонецЕсли;
		
		ДлинаСтроки = СтрДлина(Строка);
		Массив = Новый Массив(ДлинаСтроки);
		
		Для Каждого Подстрока Из МассивПодстрок Цикл
			
			ДлинаПодстроки = СтрДлина(Подстрока);
			НачалоПоиска = 1;			
			
			Пока Истина Цикл
				
				ПозицияПодстроки = СтрНайти(СтрокаВРег, Подстрока, , НачалоПоиска);
				Если ПозицияПодстроки = 0 Тогда
					Прервать;
				КонецЕсли;
				
				НачалоПоиска = ПозицияПодстроки + ДлинаПодстроки;
				
				Для Сч = ПозицияПодстроки По НачалоПоиска - 1 Цикл
					Массив[Сч - 1] = Истина;
				КонецЦикла;				
				
				Если НачалоПоиска > ДлинаСтроки Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		МассивСтрок = Новый Массив;		
		Для Сч = 0 По Массив.ВГраница() Цикл
			Символ = Сред(Строка, Сч + 1, 1);
			Если Массив[Сч] = Неопределено Тогда
				МассивСтрок.Добавить(Символ);
			Иначе
				МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Символ, Шрифт, Цвет));
			КонецЕсли;
		КонецЦикла;
		
		ДанныеВыбора.Добавить(Строка, Новый ФорматированнаяСтрока(МассивСтрок));
		
		Если МаксНайденных > 0 Тогда
			Если ДанныеВыбора.Количество() = МаксНайденных Тогда
				Прервать
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры //-- #1409 смарт: Лопато 27.07.2023	

#Область УчетПоСериям

//++#1547 смарт: Лопато 23.11.2023 //Автоматическое заполнение серий чернил в заказах
Процедура смартПроверитьУстановитьДоступностьТоварыСерия(ЭлементТовары, ЭлементТоварыСерия, ТекущаяСтрокаТовары) Экспорт

	Если ЭлементТовары.ТекущийЭлемент = ЭлементТоварыСерия Тогда
		
		Если ТекущаяСтрокаТовары.СтатусУказанияСерий <> 0 
			И смартОбщегоНазначения.смартДействуетОсобыйУчетСерий(ТекущаяСтрокаТовары.Номенклатура) Тогда

			Если ТекущаяСтрокаТовары.Свойство("ВариантОбеспечения") Тогда
				 
				Если ТекущаяСтрокаТовары.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада") Тогда
					УстановитьТолькоПросмотр = Истина;
				Иначе
					УстановитьТолькоПросмотр = НЕ смартОбщегоНазначения.смартПравоУказыватьСерииВручную();
				КонецЕсли;	

				Если УстановитьТолькоПросмотр Тогда
				    ОбщегоНазначенияКлиент.СообщитьПользователю("Серии номенклатуры заполняются только при установке статуса ""Отгрузить"". Ручное изменение серии не допускается!");
				КонецЕсли;
				
			Иначе
				
				УстановитьТолькоПросмотр = НЕ смартОбщегоНазначения.смартПравоУказыватьСерииВручную();

				Если УстановитьТолькоПросмотр Тогда
				    ОбщегоНазначенияКлиент.СообщитьПользователю("Серии не редактируются в накладных, только в Заказах!");
				КонецЕсли;	
				
			КонецЕсли;	
			
			ЭлементТовары.ТекущийЭлемент.ТолькоПросмотр = УстановитьТолькоПросмотр; 

		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры //--#1547 смарт: Лопато 23.11.2023

//++#1547 смарт: Лопато 12.12.2023 //Автоматическое заполнение серий чернил в заказах
Процедура смартПроверитьПоказатьПредупреждениеПоСериям(ВыбранноеЗначение, ИсточникВыбора) Экспорт

	СтрокаПредупреждения = "";

	Если ТипЗнч(ИсточникВыбора) = Тип("ФормаКлиентскогоПриложения") 
		И (ИсточникВыбора.ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ВыборВариантаОбеспечения"
			ИЛИ ИсточникВыбора.ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ИсполнениеЗаказа") Тогда
			
		Если ТипЗнч(ИсточникВыбора.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения")
			И (ИсточникВыбора.ВладелецФормы.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" 
			ИЛИ ИсточникВыбора.ВладелецФормы.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента"
			ИЛИ ИсточникВыбора.ВладелецФормы.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.ФормаДокумента"
			ИЛИ ИсточникВыбора.ВладелецФормы.ИмяФормы = "Документ.ЗаказНаСборку.Форма.ФормаДокумента") Тогда

			СтрокаПредупрежденияЗаказДоДатыНачалаСерийногоУчета = 
				смартОбщегоНазначения.смартПроверкаЗаказДоДатыНачалаСерийногоУчета(ВыбранноеЗначение, 
				 																   ИсточникВыбора.ВладелецФормы.Объект, 
																				   ИсточникВыбора.ИмяФормы, 
																				   ИсточникВыбора.ВладелецФормы.Элементы.Товары.ВыделенныеСтроки);
			
			Если ЗначениеЗаполнено(СтрокаПредупрежденияЗаказДоДатыНачалаСерийногоУчета) Тогда
				СтрокаПредупреждения = СтрокаПредупреждения + СтрокаПредупрежденияЗаказДоДатыНачалаСерийногоУчета;
			КонецЕсли;	
				
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтрокаПредупреждения) Тогда

		ПоказатьПредупреждение(, Новый ФорматированнаяСтрока(СтрокаПредупреждения, 
							   Новый Шрифт(, 10, Истина), 
							   Новый Цвет(255, 0, 0)));
		
	КонецЕсли;	
	
КонецПроцедуры //--#1547 смарт: Лопато 12.12.2023

#КонецОбласти
