//++ смарт:ММ #044 224 25.02.2021 - Заявка на гарантийный ремонт 
Процедура ОбработатьПодборНомеровЗаявок(Форма, Отказ) Экспорт
	
	СкладПодЗаказ = смартОбщегоНазначения.ПолучитьСкладПодЗаказ();
	
	Объект = Форма.Объект;
	
	Если Объект.Склад = СкладПодЗаказ Тогда
		
		МассивСтруктур = Новый Массив;
		
		ОткрытьФормуПодбора = Ложь;
		
		ИмяТЧ = "Товары";
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			ИмяТЧ = "ТоварыПоРаспоряжениям";
		КонецЕсли;
		
		Для Каждого СтрокаТовар Из Объект[ИмяТЧ] Цикл
			//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Если НЕ ЗначениеЗаполнено(СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт) Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка) Тогда
			//-- #Б1132 смарт: Шляпников 01.11.2024
				ТекущаяСтрока = Новый Структура;
				ТекущаяСтрока.Вставить("НомерСтроки", 	СтрокаТовар.НомерСтроки);
				ТекущаяСтрока.Вставить("Номенклатура", 	СтрокаТовар.Номенклатура);
				ТекущаяСтрока.Вставить("Количество", 	СтрокаТовар.Количество);
				ТекущаяСтрока.Вставить("НомерЗаявки", 	"");
				ТекущаяСтрока.Вставить("СписокНомеров", Новый СписокЗначений);
				//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
				ТекущаяСтрока.Вставить("Заявка", 	Неопределено);
				//-- #Б1132 смарт: Шляпников 01.11.2024

				// ++ 11.04.2021
				ТаблицаНомеров = Новый Соответствие;
				ТекущаяСтрока.Вставить("ТаблицаНомеров", ТаблицаНомеров);
				// --
				МассивСтруктур.Добавить(ТекущаяСтрока);
				
			КонецЕсли;
		КонецЦикла;	
		
		// ++ 12.04.2021
		Если МассивСтруктур.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		// --
		
		// ++ 18.03.2021
		//смартОбщегоНазначения.ПроверитьОстаткиНаСкладеГарантийныхЗапчастей(ТекущаяДата(), МассивСтруктур, ОткрытьФормуПодбора);
		смартОбщегоНазначения.ПроверитьОстаткиНаСкладеГарантийныхЗапчастей(ТекущаяДата(), МассивСтруктур, ОткрытьФормуПодбора, Объект.Ссылка);
		// --
		
		Если ОткрытьФормуПодбора Тогда
			
			Отказ = Истина;
			
			Оповещение = Новый ОписаниеОповещения("смартПослеЗакрытияФормыПодбораНомеровЗаявок", Форма);
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("МассивСтруктур", МассивСтруктур);
			ОткрытьФорму("ОбщаяФорма.смартПодборНомеровЗаявокНаГарантийныйРемонт", ПараметрыОткрытия, Форма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		Иначе
			смартЗаполнитьНомераЗаявокПоСтрокам(Форма, МассивСтруктур);
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 25.02.2021

//++ смарт:ММ #044 224 24.02.2021 - Заявка на гарантийный ремонт
Процедура смартЗаполнитьНомераЗаявокПоСтрокам(Форма, МассивСтруктур, БылоРаздвоениеСтроки = Ложь) Экспорт
	
	Объект = Форма.Объект;
	
	// ++ 11.04.2021
	НомераРаздвоившихсяСтрок = Новый Массив;
	НомераВсехСтрок = Новый Массив;
	Для Каждого ЭлементНомерСтроки Из МассивСтруктур Цикл 
		
		НомерСтроки = ЭлементНомерСтроки.НомерСтроки;
		Если НомераВсехСтрок.Найти(НомерСтроки) = Неопределено Тогда
			НомераВсехСтрок.Добавить(НомерСтроки);
		Иначе
			НомераРаздвоившихсяСтрок.Добавить(НомерСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработанныеНомераСтрок = Новый Массив;
	// --
	
	Для Каждого ЭлементНомерСтроки Из МассивСтруктур Цикл 
					
		НомерСтроки = ЭлементНомерСтроки.НомерСтроки;
		
		// ++ 11.04.2021
		Если ОбработанныеНомераСтрок.Найти(НомерСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// --

		смартНомерЗаявкиНаГарантийныйРемонт = ЭлементНомерСтроки.НомерЗаявки;

		ИмяТЧ = "Товары";
		Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			ИмяТЧ = "ТоварыПоРаспоряжениям";
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерСтроки", НомерСтроки);
		НайденныеСтроки = Объект[ИмяТЧ].НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//НайденнаяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = смартНомерЗаявкиНаГарантийныйРемонт;
			НайденнаяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = ЭлементНомерСтроки.Заявка;
			//-- #Б1132 смарт: Шляпников 14.10.2024
			// ++ 18.03.2021
			Форма.Модифицированность = Истина;
			// --
			// ++ 11.04.2021
			Если НомераРаздвоившихсяСтрок.Найти(НомерСтроки) <> Неопределено Тогда
				НайденнаяСтрока.Количество = ЭлементНомерСтроки.КоличествоВДокументе;
				
				// Добавить новую строку
				Сч = 0;
				Для Каждого ДобавленныеСтроки Из МассивСтруктур Цикл
					
					Если ДобавленныеСтроки.НомерСтроки <> НомерСтроки Тогда
						Продолжить;
					КонецЕсли;
					
					Если Сч > 0 Тогда
						// Первая строка с таким номером уже обработана в цикле "Для Каждого ЭлементНомерСтроки Из МассивСтруктур Цикл"
						// Сейчас обходятся повторные строки с таким же номером (те, что были добавлены автоматически в форме подбора остатков)
						НоваяСтрокаТовары = Объект[ИмяТЧ].Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, НайденнаяСтрока);
						
						НоваяСтрокаТовары.Количество = ДобавленныеСтроки.КоличествоВДокументе;
						//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
						//НоваяСтрокаТовары.смартНомерЗаявкиНаГарантийныйРемонт = ДобавленныеСтроки.НомерЗаявки;
						НайденнаяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = ДобавленныеСтроки.Заявка;
						//-- #Б1132 смарт: Шляпников 14.10.2024
						
						БылоРаздвоениеСтроки = Истина;
					КонецЕсли;
					Сч = Сч + 1;
				КонецЦикла;
			КонецЕсли;
			
			ОбработанныеНомераСтрок.Добавить(НомерСтроки); // Чтобы при обходе вернувшейся из формы таблицы строки с одинаковыми номерами обходились один раз
			// --

		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 24.02.2021

