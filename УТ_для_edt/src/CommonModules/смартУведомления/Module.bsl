#Область ПрограммныйИнтерфейс

// Добавляет к отправке уведомление по объекту
//
// Параметры:
//  - Объект - документ, справочник или другой ссылочный объект, по котрому отправляется уведомление
//	- ВидСобытия - строка, идентификатор события по которому идет отправка
//	- Тема - строка, тема письма
//	- Тело - строка, тело письма
//	- Получатели - массив структур ("Адрес, Представление")
//
Процедура ОтправитьПочтовоеУведомление(Объект, ВидСобытия, Тема, Тело, Получатели, ПолучателиКопии = Неопределено, ПолучателиСкрытые = Неопределено, Вложения = Неопределено, ТипТекста = Неопределено, УчетнаяЗапись = Неопределено, ДатаУведомления = Неопределено, Уведомление = Неопределено, Единственное = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	ДатаФормирования = ТекущаяДатаСеанса();
	
	НаборЗаписей = РегистрыСведений.смартСформированныеУведомления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Объект, Истина);
	НаборЗаписей.Отбор.ВидСобытия.Установить(ВидСобытия, Истина);
	НаборЗаписей.Отбор.ДатаФормирования.Установить(ДатаФормирования, Истина);
	
	Запись = НаборЗаписей.Добавить();
	Запись.СпособУведомления = Перечисления.смартСпособыУведомлений.Почта;
	Запись.Объект = Объект;
	Запись.ВидСобытия = ВидСобытия;
	Запись.ДатаФормирования = ДатаФормирования;
	Запись.Тема = Тема;
	Запись.Тело = Тело;
	Запись.ТипТекста = ТипТекста;
	Запись.Получатели = ЗначениеВСтрокуВнутр(Получатели);
	Запись.ПолучателиКопии = ЗначениеВСтрокуВнутр(ПолучателиКопии);
	Запись.ПолучателиСкрытые = ЗначениеВСтрокуВнутр(ПолучателиСкрытые);
	Запись.Уведомление = Уведомление;
	Запись.ДатаУведомления = ДатаУведомления;
	Запись.ДополнительныеПараметры = ДополнительныеПараметры;
	Запись.УчетнаяЗапись = УчетнаяЗапись;
	
	Если НЕ Единственное Тогда
		
		ИдентификаторУведомления = СокрЛП(Новый УникальныйИдентификатор);
		НаборЗаписей.Отбор.Идентификатор.Установить(ИдентификаторУведомления, Истина);
		Запись.Идентификатор = ИдентификаторУведомления;
		
	КонецЕсли;
	
	МассивПредставлений = Новый Массив;
	Для каждого стрПолучатель Из Получатели Цикл
		МассивПредставлений.Добавить(СтрШаблон("%1 <%2>", стрПолучатель.Представление, стрПолучатель.Адрес));
	КонецЦикла;
	Запись.ПолучателиСтрокой = СтрСоединить(МассивПредставлений, ";");
	
	Если ЗначениеЗаполнено(ПолучателиКопии) Тогда
		
		МассивПредставлений = Новый Массив;
		Для каждого стрПолучатель Из ПолучателиКопии Цикл
			МассивПредставлений.Добавить(СтрШаблон("%1 <%2>", стрПолучатель.Представление, стрПолучатель.Адрес));
		КонецЦикла;
		Запись.ПолучателиКопииСтрокой = СтрСоединить(МассивПредставлений, ";");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПолучателиСкрытые) Тогда
		
		МассивПредставлений = Новый Массив;
		Для каждого стрПолучатель Из ПолучателиСкрытые Цикл
			МассивПредставлений.Добавить(СтрШаблон("%1 <%2>", стрПолучатель.Представление, стрПолучатель.Адрес));
		КонецЦикла;
		Запись.ПолучателиСкрытыеСтрокой = СтрСоединить(МассивПредставлений, ";");
		
	КонецЕсли;
	
	Если НЕ Вложения = Неопределено Тогда
		
		МассивФайлов = Новый Массив;
		
		Для каждого стрВложение Из Вложения Цикл
			
			ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.ВладелецФайлов = ПолучитьПапкуДляФайлов();
			ПараметрыФайла.ИмяБезРасширения = стрВложение.ИмяФайла;
			ПараметрыФайла.РасширениеБезТочки = стрВложение.РасширениеФайла;
			
			Файл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, стрВложение.Адрес);
			
			МассивФайлов.Добавить(Файл);
			
		КонецЦикла;
		
		Запись.Вложения = ЗначениеВСтрокуВнутр(МассивФайлов);
		
	КонецЕсли;
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Процедура ОтправитьУведомлениеНапоминанием(Объект, ВидСобытия, Тема, Тело, Получатели, ДатаУведомления = Неопределено, Уведомление = Неопределено, Единственное = Истина, ДополнительныеПараметры = Неопределено) Экспорт
	
	ДатаФормирования = ТекущаяДатаСеанса();
	
	НаборЗаписей = РегистрыСведений.смартСформированныеУведомления.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Объект, Истина);
