#Область Служебные

Функция ПолучитьУведомленияПоСобытию(ИдентификаторМетаданных, ВидСобытия)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартУведомленияСобытияОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартУведомления.СобытияОбъектов КАК смартУведомленияСобытияОбъектов
	|ГДЕ
	|	смартУведомленияСобытияОбъектов.Объект = &Объект
	|	И смартУведомленияСобытияОбъектов.ВидСобытия = &ВидСобытия
	|	И смартУведомленияСобытияОбъектов.Ссылка.Использование";
	
	Запрос.УстановитьПараметр("Объект", ИдентификаторМетаданных);
	Запрос.УстановитьПараметр("ВидСобытия", ВидСобытия);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьПапкуДляФайлов()
	
	Возврат смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ПапкаФайловВложенийУведомлений");
	
КонецФункции

Функция СформироватьАдресаПолучателейДляОтправки(Массив) Экспорт
	
	МассивПользователей = Новый Массив;
	Результат = Новый Массив;
	
	Для каждого стрАдрес Из Массив Цикл
		
		Если ТипЗнч(стрАдрес) = Тип("Строка") Тогда
			Результат.Добавить(Новый Структура("Адрес,Представление", стрАдрес, стрАдрес));
		ИначеЕсли ТипЗнч(стрАдрес) = Тип("СправочникСсылка.Пользователи") Тогда
			МассивПользователей.Добавить(стрАдрес);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивПользователей.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, смартОбщегоНазначения.ПолучитьАдресаПользователей(МассивПользователей));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти