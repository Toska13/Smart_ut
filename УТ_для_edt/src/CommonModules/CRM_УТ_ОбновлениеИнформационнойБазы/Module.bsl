	// 3.0.18.33
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.0.18.33";
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("16fe5f7e-82b9-411f-8116-5329fe69dccc");
	Обработчик.Комментарий = НСтр("ru='Заполнение пустых текстов вопросов в решениях'");
