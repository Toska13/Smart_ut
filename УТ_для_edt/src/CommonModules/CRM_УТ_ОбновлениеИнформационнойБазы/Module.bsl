	Обработчик.Комментарий = НСтр("ru='Обновление условий срабатывания триггеров'");
	Обработчик.Процедура = "CRM_Модуль_ОбновлениеИнформационнойБазы.ОбработатьУсловияСрабатыванияТриггеровПриПереходеНаНовуюВерсию";
