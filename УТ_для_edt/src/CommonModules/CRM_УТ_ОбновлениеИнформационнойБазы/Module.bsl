	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.ОчередьОтложеннойОбработки = 1;
	Обработчик.ПроцедураЗаполненияДанныхОбновления = "CRM_УТ_ОбновлениеИнформационнойБазы.ЗарегистрироватьРешенияСПустымиТекстамиВопросов";
	Обработчик.ЧитаемыеОбъекты      = "Справочник.CRM_Решения";
	Обработчик.ИзменяемыеОбъекты    = "Справочник.CRM_Решения";
	Обработчик.БлокируемыеОбъекты   = "Справочник.CRM_Решения";
	Обработчик.ПроцедураПроверки    = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	
	 // 3.0.18.34
	Обработчик = Обработчики.Добавить();
	Обработчик.Версия = "3.0.18.34";
	Обработчик.РежимВыполнения = "Монопольно";
