
//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Процедура смартРассчитатьПараметрыСтатусовЗаказовБитрикс(МассивЗаказов, СтруктураДействийРасчета) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	НачатьТранзакцию();
	
	//Получим текущие значения параметров
	ТекущиеЗначенияПараметровРасчета = смартПолучитьТекущиеЗначенияПараметровРасчетаСтатусовЗаказовБитрикс(МассивЗаказов); 

	//Блокировка регистра по заказам для исключения параллельного чтения/записи
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ТекущиеЗначенияПараметровРасчета;  
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Заказ", "Заказ");
	БлокировкаДанных.Заблокировать();
	
	//Копируем текущие параметры для изменения
	НовыеЗначенияПараметровРасчета = ТекущиеЗначенияПараметровРасчета.Скопировать();
	
	//Расчеты параметров
	смартРассчитатьПараметрыЗаказа(МассивЗаказов, СтруктураДействийРасчета, НовыеЗначенияПараметровРасчета);
	//смартРассчитатьПараметрДоставки(МассивЗаказов, СтруктураДействийРасчета, НовыеЗначенияПараметровРасчета);
	
	//В запись попадают только строки с измененными параметрами
	ТаблицаОтличийПараметровРасчета = смартВычислитьРазличияВТаблицах(НовыеЗначенияПараметровРасчета, ТекущиеЗначенияПараметровРасчета);
	
	//Запись регистра
	Если НЕ смартЗаписатьРегистрСмартПараметрыРасчетаСтатусовЗаказовБитрикс(ТаблицаОтличийПараметровРасчета) Тогда
		ЗаписьЖурналаРегистрации("Проблема с проведением документа, не удалось записать параметры расчета статуса в регистр смартПараметрыРасчетаСтатусовЗаказовБитрикс",
								 УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
	КонецЕсли;
	
	ЗафиксироватьТранзакцию();
	
	//Вычисление статусов заказов по параметрам
	смартОтразитьСостоянияЗаказовБитрикс(МассивЗаказов);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //--#1241 смарт: Лопато 25.01.2023

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Процедура смартОтразитьСостоянияЗаказовБитрикс(МассивЗаказов)

	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	//Получим текущие значения параметров
	ЗначенияПараметровРасчетаИСтатусы = смартПолучитьЗначенияПараметровРасчетаИСтатусыЗаказовБитрикс(МассивЗаказов); 

	//Блокировка регистра по заказам для исключения параллельного чтения/записи
	БлокировкаДанных = Новый БлокировкаДанных;

	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ЗначенияПараметровРасчетаИСтатусы;  
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Заказ", "Заказ");

	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.СмартСтатусыЗаказовБитрикс");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = ЗначенияПараметровРасчетаИСтатусы;  
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("СсылкаМет", "Заказ");
	
	БлокировкаДанных.Заблокировать();
	
	Для Каждого ПараметрыЗаказа Из ЗначенияПараметровРасчетаИСтатусы Цикл
		
		Заказ = ПараметрыЗаказа.Заказ;
	 	ТекСтатус = ПараметрыЗаказа.СтатусЗаказа;
		
		//Проверка что заказ уже закрыт и дальнейшие действия не нужны. 
		Если ТекСтатус = Перечисления.смартСтатусыЗаказовБитриксЗначения.Выполнен Тогда
			//Чистим регистры процессов и параметров
			смартОчиститьРегистрПроцессов(Заказ);
			смартОчиститьРегистрПараметров(Заказ);
			Продолжить;
		КонецЕсли;
		
		//++ #2020 смарт: Ермаков 03.09.2024 / Исправить логику формирования статуса "Готов к выдаче"
		//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
		//++ #Б6102 смарт: Шляпников 23.03.2026 / Проект smart-t.ru. Не выгружается финальный статус для завершенных заказов.
		//МенятьСтатус = Не (ПараметрыЗаказа.Проведен И ПараметрыЗаказа.Отгружен И ПараметрыЗаказа.Оплачен И Не ПараметрыЗаказа.Доставка) 
		//				ИЛИ (ТекСтатус = Перечисления.смартСтатусыЗаказовБитриксЗначения.ОжидаютсяДокументы И ПараметрыЗаказа.ВЗаказеТолькоУслуги);
		МенятьСтатус = Истина;
		//-- #Б6102 смарт: Шляпников 23.03.2026
		//-- #Б3854 смарт: Шляпников 01.10.2025
		
		Если МенятьСтатус Тогда
		//-- #2020 смарт: Ермаков 03.09.2024
			
			НаименованиеНовогоСтатуса = смартВычислитьСтатусЗаказаБитриксПоПараметрам(ПараметрыЗаказа);
			
			//СоответствиеСтатусовЗаказа
			СоответствиеСтатусовЗаказа = смартПолучитьСоответствиеСтатусовЗаказа();
		
			//Подготовка структуры новой записи СмартПроцессИзмененияСтатусовЗаказовБитрикс
			СтруктураЗаписиПроцесса = Новый Структура;
			СтруктураЗаписиПроцесса.Вставить("Заказ",  Заказ);
			СтруктураЗаписиПроцесса.Вставить("Период", ТекущаяДата());
			
			//Подготовка структуры новой записи СмартСтатусыЗаказовБитрикс
			СтруктураЗаписиСтатусыЗаказовБитрикс = Новый Структура;
			СтруктураЗаписиСтатусыЗаказовБитрикс.Вставить("СсылкаМет", Заказ);
			СтруктураЗаписиСтатусыЗаказовБитрикс.Вставить("ГУИД", Заказ.УникальныйИдентификатор());
			СтруктураЗаписиСтатусыЗаказовБитрикс.Вставить("СтатусЗаказа");
			СтруктураЗаписиСтатусыЗаказовБитрикс.Вставить("Идентификатор");
			
			СтруктураЗаписиПроцесса.Вставить(НаименованиеНовогоСтатуса, Истина); 
			ЗаполнитьЗначенияСвойств(СтруктураЗаписиСтатусыЗаказовБитрикс, СоответствиеСтатусовЗаказа[НаименованиеНовогоСтатуса]);
			
			//Статус изменен
			Если ТекСтатус = Неопределено ИЛИ ТекСтатус <> СтруктураЗаписиСтатусыЗаказовБитрикс.СтатусЗаказа Тогда
				
				//Запись регистра СмартСтатусыЗаказовБитрикс
				Отказ = смартЗаписатьРегистрСмартСтатусыЗаказовБитрикс(СтруктураЗаписиСтатусыЗаказовБитрикс);
				
				Если НЕ Отказ Тогда
					Если СтруктураЗаписиСтатусыЗаказовБитрикс.СтатусЗаказа = Перечисления.смартСтатусыЗаказовБитриксЗначения.Выполнен Тогда
				        //Чистим регистр процессов
						смартОчиститьРегистрПроцессов(Заказ);
						смартОчиститьРегистрПараметров(Заказ);
					Иначе
						//Запись регистра СмартПроцессИзмененияСтатусовЗаказовБитрикс
						Отказ = смартЗаписатьРегистрСмартПроцессИзмененияСтатусовЗаказовБитрикс(СтруктураЗаписиПроцесса);	
					КонецЕсли;
			    КонецЕсли; 
					
			КонецЕсли;
			
		//++ #2020 смарт: Ермаков 03.09.2024 / Исправить логику формирования статуса "Готов к выдаче"
		КонецЕсли;
		//-- #2020 смарт: Ермаков 03.09.2024
		
	КонецЦикла;	
	
	ЗафиксироватьТранзакцию();
	
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры //--#1241 смарт: Лопато 25.01.2023

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартВычислитьСтатусЗаказаБитриксПоПараметрам(ПараметрыЗаказа)
	
	НаименованиеНовогоСтатуса = "ВОбработке";
	
	//Вычисление статуса
	//Параметры: Проведен, ПометкаУдаления, Закрыт, ОтмененыСтроки, УстановленРезерв, Отгружен, Оплачен, Самовывоз, БезналичнаяОплата, Доставка, ГлавныйСкладСамовывоз
	Если ПараметрыЗаказа.ПометкаУдаления ИЛИ ПараметрыЗаказа.ОтмененыСтроки Тогда 
		//Заказ отменен (когда заказ в 1с помечен на удаление или закрыт с отменой всех строк)
		НаименованиеНовогоСтатуса = "Отменен";
	ИначеЕсли ПараметрыЗаказа.Закрыт Тогда 
		//Заказ завершен (когда заказ закрыт)
		НаименованиеНовогоСтатуса = "Завершен";	
	ИначеЕсли ПараметрыЗаказа.Отгружен И НЕ ПараметрыЗаказа.Оплачен Тогда 					
        //Ожидается оплата (когда заказ после отгрузки не оплачен полностью или частично)
		НаименованиеНовогоСтатуса = "ОжидаетсяОплата";
		//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
	//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
	ИначеЕсли ПараметрыЗаказа.Самовывоз И ПараметрыЗаказа.Проведен И ПараметрыЗаказа.УстановленРезервНаСкладе И Не ПараметрыЗаказа.Отгружен И ПараметрыЗаказа.ВЗаказеТолькоУслуги Тогда
		НаименованиеНовогоСтатуса = "ОжидаютсяДокументы";
	ИначеЕсли ПараметрыЗаказа.Самовывоз И ПараметрыЗаказа.Проведен И ПараметрыЗаказа.УстановленРезервНаСкладе И ПараметрыЗаказа.Отгружен И ПараметрыЗаказа.ВЗаказеТолькоУслуги Тогда
		НаименованиеНовогоСтатуса = "Получен";
	//-- #Б3854 смарт: Шляпников 01.10.2025
	//++ #2020 смарт: Ермаков 03.09.2024 / Исправить логику формирования статуса "Готов к выдаче"
	ИначеЕсли ПараметрыЗаказа.Самовывоз И ПараметрыЗаказа.Проведен И ПараметрыЗаказа.УстановленРезервНаСкладе И Не ПараметрыЗаказа.Отгружен Тогда	
	//-- #2020 смарт: Ермаков 03.09.2024
		//- если способ доставки "самовывоз" и все товары зарезервированы и способ оплаты "наличными при получении" - статус "Готов к выдаче"
		//- если способ доставки "самовывоз" и все товары зарезервированы и способ оплаты "по счету" и заказ не оплачен - статус "Принят, ожидается оплата"
		//- если способ доставки "самовывоз" и все товары зарезервированы и способ оплаты "по счету" и заказ оплачен - статус "Готов к выдаче"
		Если ПараметрыЗаказа.БезналичнаяОплата Тогда
			Если ПараметрыЗаказа.Оплачен Тогда
				НаименованиеНовогоСтатуса = "ГотовКВыдаче";
			Иначе	
				НаименованиеНовогоСтатуса = "НовыйОбъект";
			КонецЕсли;	
		Иначе
			НаименованиеНовогоСтатуса = "ГотовКВыдаче";
		КонецЕсли;	
		//-- #2020 смарт: Лопато 29.08.2024
	ИначеЕсли НЕ ПараметрыЗаказа.Самовывоз И ПараметрыЗаказа.Проведен И ПараметрыЗаказа.Доставка Тогда	
		//Доставляется (когда доставка нашими силами по городу и товар передан водителю (заказ попал в задание на перевозку))
		НаименованиеНовогоСтатуса = "Доставляется";
	ИначеЕсли ПараметрыЗаказа.Оплачен И ПараметрыЗаказа.УстановленРезерв Тогда	
		//Принят, ожидается отгрузка – когда заказ оплачен и установлен резерв
		НаименованиеНовогоСтатуса = "Оплачен";
	ИначеЕсли ПараметрыЗаказа.Проведен И ПараметрыЗаказа.УстановленРезерв Тогда	
		//Принят, ожидается оплата – когда заказ в 1с проведен и установлен резерв
		НаименованиеНовогоСтатуса = "НовыйОбъект";
	ИначеЕсли НЕ ПараметрыЗаказа.Проведен ИЛИ НЕ ПараметрыЗаказа.УстановленРезерв Тогда	
		//Заказ в обработке (когда заказ в 1с не проведен или не установлен резерв)                                                                    
		НаименованиеНовогоСтатуса = "ВОбработке";
	Иначе
		НаименованиеНовогоСтатуса = "ВОбработке";
	КонецЕсли;	

	Возврат НаименованиеНовогоСтатуса;

КонецФункции //--#1241 смарт: Лопато 25.01.2023	

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартВычислитьРазличияВТаблицах(Таблица1, Таблица2)
	
	ТаблицаРазница = Таблица1.СкопироватьКолонки();
	
	Для ИндексСтрок = 0 По Таблица1.Количество() - 1 Цикл
		
		Если Таблица1[ИндексСтрок][0] = Таблица2[ИндексСтрок][0] Тогда

			ЕстьРазличия = Ложь;
			
			Для ИндексКолонок = 1 По Таблица1.Колонки.Количество() - 1 Цикл
			
				Если Таблица2.Количество() >= (ИндексСтрок + 1) 
					И Таблица2.Колонки.Количество() >= ИндексКолонок + 1 Тогда
				
					Если Таблица1[ИндексСтрок][ИндексКолонок] <> Таблица2[ИндексСтрок][ИндексКолонок] Тогда
                        ЕстьРазличия = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЦикла;	
			
			Если ЕстьРазличия Тогда
				НоваяСтрока = ТаблицаРазница.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Таблица1[ИндексСтрок]);
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ТаблицаРазница;
	
КонецФункции //--#1241 смарт: Лопато 25.01.2023

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартПолучитьТекущиеЗначенияПараметровРасчетаСтатусовЗаказовБитрикс(МассивЗаказов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказКлиента.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка В(&МассивЗаказов)
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Заказ КАК Заказ,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Проведен КАК Проведен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ПометкаУдаления КАК ПометкаУдаления,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Закрыт КАК Закрыт,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ОтмененыСтроки КАК ОтмененыСтроки,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.УстановленРезерв КАК УстановленРезерв,
	//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.УстановленРезервНаСкладе КАК УстановленРезервНаСкладе,
	//-- #2020 смарт: Лопато 29.08.2024
	//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ВЗаказеТолькоУслуги КАК ВЗаказеТолькоУслуги,
	//-- #Б3854 смарт: Шляпников 01.10.2025
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Отгружен КАК Отгружен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Оплачен КАК Оплачен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Самовывоз КАК Самовывоз,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.БезналичнаяОплата КАК БезналичнаяОплата,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Доставка КАК Доставка,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ГлавныйСкладСамовывоз КАК ГлавныйСкладСамовывоз
	|ПОМЕСТИТЬ ВТ_ПараметрыРасчета
	|ИЗ
	|	РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс.СрезПоследних КАК смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
	|		ПО смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Заказ = ВТ_Заказы.Заказ
