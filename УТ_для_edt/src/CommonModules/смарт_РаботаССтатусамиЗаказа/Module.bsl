//++#1241 смарт: Лопато 14.11.2022 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартПолучитьСоответствиеСтатусовЗаказа()

	//Принят, ожидается оплата - P
	//Принят, ожидается отгрузка - ND
	////////////////Собирается - C
	////////////////Заказ собран - R
	//Заказ отменён - D
	//Доставляется - T
	/////////////////Отправлен курьером - DC
	/////////////////Передан в транспортную компанию - DT
	//Готов к выдаче - DP 
	//Заказ получен - OR;
	//Ожидается оплата - EP;
	////////////////Ожидается подтверждение документов - B
	//Выполнен - F
	//В обработке - N
	
	СоответствиеСтатусовЗаказа = Новый Соответствие;
	
	СоответствиеСтатусовЗаказа.Вставить("ВОбработке", 
										Новый Структура("СтатусЗаказа, Идентификатор", Перечисления.смартСтатусыЗаказовБитриксЗначения.ВОбработке,              "N"));	
	СоответствиеСтатусовЗаказа.Вставить("НовыйОбъект", 
