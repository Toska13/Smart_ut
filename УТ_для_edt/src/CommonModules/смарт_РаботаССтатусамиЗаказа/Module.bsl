Функция ЗаказОтменен(Заказ)
	
	Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	КОЛИЧЕСТВО(*) = СУММА(ВЫБОР
	|			КОГДА ЗаказКлиентаТовары.Отменено
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Отменен
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.Ссылка.Статус = &Статус");
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусыЗаказовКлиентов.Закрыт);
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Если ТипЗнч(Рез.Отменен)=Тип("Null") Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Рез.Отменен;
	КонецЕсли;
	Возврат Ложь;
	
