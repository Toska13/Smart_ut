//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартПолучитьЗначенияПараметровРасчетаИСтатусыЗаказовБитрикс(МассивЗаказов)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказКлиента.Ссылка КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказы
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка В(&МассивЗаказов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Заказ КАК Заказ,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Проведен КАК Проведен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ПометкаУдаления КАК ПометкаУдаления,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Закрыт КАК Закрыт,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ОтмененыСтроки КАК ОтмененыСтроки,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.УстановленРезерв КАК УстановленРезерв,
	//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.УстановленРезервНаСкладе КАК УстановленРезервНаСкладе,
	//-- #2020 смарт: Лопато 29.08.2024
	//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ВЗаказеТолькоУслуги КАК ВЗаказеТолькоУслуги,
	//-- #Б3854 смарт: Шляпников 01.10.2025
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Отгружен КАК Отгружен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Оплачен КАК Оплачен,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Самовывоз КАК Самовывоз,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.БезналичнаяОплата КАК БезналичнаяОплата,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Доставка КАК Доставка,
	|	смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.ГлавныйСкладСамовывоз КАК ГлавныйСкладСамовывоз
	|ПОМЕСТИТЬ ВТ_ПараметрыРасчета
	|ИЗ
	|	РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс.СрезПоследних КАК смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
	|		ПО смартПараметрыРасчетаСтатусовЗаказовБитриксСрезПоследних.Заказ = ВТ_Заказы.Заказ
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс.СрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(СмартСтатусыЗаказовБитрикс.СсылкаМет КАК Документ.ЗаказКлиента) КАК ЗаказСсылка,
	|	СмартСтатусыЗаказовБитрикс.СтатусЗаказа КАК СтатусЗаказа
	|ПОМЕСТИТЬ ВТ_СтатусыЗаказов
	|ИЗ
	|	РегистрСведений.СмартСтатусыЗаказовБитрикс КАК СмартСтатусыЗаказовБитрикс
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
	|		ПО ((ВЫРАЗИТЬ(СмартСтатусыЗаказовБитрикс.СсылкаМет КАК Документ.ЗаказКлиента)) = ВТ_Заказы.Заказ)
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.СмартСтатусыЗаказовБитрикс
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗаказСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Проведен, 				ЛОЖЬ) КАК Проведен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ПометкаУдаления, 		ЛОЖЬ) КАК ПометкаУдаления,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Закрыт, 				ЛОЖЬ) КАК Закрыт,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ОтмененыСтроки, 		ЛОЖЬ) КАК ОтмененыСтроки,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.УстановленРезерв,  	ЛОЖЬ) КАК УстановленРезерв,
	//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.УстановленРезервНаСкладе, ЛОЖЬ) КАК УстановленРезервНаСкладе,
	//-- #2020 смарт: Лопато 29.08.2024
	//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ВЗаказеТолькоУслуги, ЛОЖЬ) КАК ВЗаказеТолькоУслуги,
	//-- #Б3854 смарт: Шляпников 01.10.2025
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Отгружен, 				ЛОЖЬ) КАК Отгружен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Оплачен, 				ЛОЖЬ) КАК Оплачен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Самовывоз, 			ЛОЖЬ) КАК Самовывоз,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.БезналичнаяОплата, 	ЛОЖЬ) КАК БезналичнаяОплата,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Доставка, 				ЛОЖЬ) КАК Доставка,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ГлавныйСкладСамовывоз,	ЛОЖЬ) КАК ГлавныйСкладСамовывоз,
	|	ЕСТЬNULL(ВТ_СтатусыЗаказов.СтатусЗаказа, ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаказовБитриксЗначения.ПустаяСсылка)) КАК СтатусЗаказа
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыРасчета КАК ВТ_ПараметрыРасчета
	|		ПО ВТ_Заказы.Заказ = ВТ_ПараметрыРасчета.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыЗаказов КАК ВТ_СтатусыЗаказов
	|		ПО ВТ_Заказы.Заказ = ВТ_СтатусыЗаказов.ЗаказСсылка
	|";
	
	Запрос.Параметры.Вставить("МассивЗаказов", МассивЗаказов);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции //--#1241 смарт: Лопато 25.01.2023	

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Процедура смартРассчитатьПараметрыЗаказа(МассивЗаказов, СтруктураДействийРасчета, НовыеЗначенияПараметровРасчета)

	СтруктураПараметровРасчета = Неопределено;
	
	Если СтруктураДействийРасчета.Свойство("Заказ") Тогда

	    Запрос = Новый Запрос;
	    Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаказКлиента.Ссылка КАК Заказ,
		|	ЗаказКлиента.Склад КАК Склад,
		|	ВЫБОР
		|		КОГДА &УдалениеПроведения = ИСТИНА
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ЗаказКлиента.Проведен = ИСТИНА
		|	КОНЕЦ КАК Проведен,
		|	ЗаказКлиента.ПометкаУдаления = ИСТИНА КАК ПометкаУдаления,
		//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
		|	ЗаказКлиента.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.Безналичная) 
		|		ИЛИ ЗаказКлиента.ФормаОплаты = ЗНАЧЕНИЕ(Перечисление.ФормыОплаты.ПустаяСсылка) КАК БезналичнаяОплата,
		//-- #2020 смарт: Лопато 29.08.2024
		|	ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз)
		|		ИЛИ ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал) КАК Самовывоз,
		|	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента
		|ПОМЕСТИТЬ ВТ_Заказы
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Ссылка В(&МассивЗаказов)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостоянияЗаказовКлиентов.Заказ КАК Заказ,
		|	СостоянияЗаказовКлиентов.Состояние КАК Состояние,
		|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты,
		|	СостоянияЗаказовКлиентов.ПроцентОтгрузки КАК ПроцентОтгрузки
		|ПОМЕСТИТЬ ВТ_СостоянияЗаказовКлиентов
		|ИЗ
		|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
		|		ПО СостоянияЗаказовКлиентов.Заказ = ВТ_Заказы.Заказ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		//++ #2014 смарт: Лопато 23.08.2024 //Информирование клиентов о статусе заказа  
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаказКлиентаТовары.Ссылка КАК ЗаказРезерв
		|ПОМЕСТИТЬ ВТ_НЕУстановленРезервВЗаказе
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
		|		ПО ЗаказКлиентаТовары.Ссылка = ВТ_Заказы.Заказ
		|ГДЕ
		|	НЕ ЗаказКлиентаТовары.Ссылка.Проведен
		|		ИЛИ (НЕ ЗаказКлиентаТовары.Отменено
		|			 И НЕ (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
		|				   ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
		|				   ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно)))
		//-- #2014 смарт: Лопато 23.08.2024
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗаказРезерв
		|;
		|
		//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаказКлиентаТовары.Ссылка КАК ЗаказОбработаныСтроки
		|ПОМЕСТИТЬ ВТ_НЕОбработаныСрокиВЗаказе
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказы КАК ВТ_Заказы
		|		ПО ЗаказКлиентаТовары.Ссылка = ВТ_Заказы.Заказ
		|ГДЕ
		|	(НЕ ЗаказКлиентаТовары.Ссылка.Проведен
		|			ИЛИ НЕ ЗаказКлиентаТовары.Отменено
		|				И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.НеТребуется)
		|					ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется)))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗаказОбработаныСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		//-- #2020 смарт: Лопато 29.08.2024
		|	ЗаказКлиентаТовары.Ссылка КАК ЗаказОтмена
		|ПОМЕСТИТЬ ВТ_ЕстьНеОтмененныеСтрокиВЗаказе
		|ИЗ
