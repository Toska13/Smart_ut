	|ДЛЯ ИЗМЕНЕНИЯ
	|	РегистрСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс.СрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заказы.Заказ КАК Заказ,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Проведен, 		    	ЛОЖЬ) КАК Проведен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ПометкаУдаления,   	ЛОЖЬ) КАК ПометкаУдаления,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Закрыт, 		    	ЛОЖЬ) КАК Закрыт,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ОтмененыСтроки,    	ЛОЖЬ) КАК ОтмененыСтроки,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.УстановленРезерв,  	ЛОЖЬ) КАК УстановленРезерв,
	//++ #2020 смарт: Лопато 29.08.2024 //Исправить логику формирования статуса "Готов к выдаче"  
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.УстановленРезервНаСкладе, ЛОЖЬ) КАК УстановленРезервНаСкладе,
	//-- #2020 смарт: Лопато 29.08.2024
	//++ #Б3854 смарт: Шляпников 01.10.2025 / Проект smart-t.ru. Исправить логику статусов Заказа клиента на сайте
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ВЗаказеТолькоУслуги, ЛОЖЬ) КАК ВЗаказеТолькоУслуги,
	//-- #Б3854 смарт: Шляпников 01.10.2025
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Отгружен, 		    	ЛОЖЬ) КАК Отгружен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Оплачен,		    	ЛОЖЬ) КАК Оплачен,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Самовывоз, 	    	ЛОЖЬ) КАК Самовывоз,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.БезналичнаяОплата, 	ЛОЖЬ) КАК БезналичнаяОплата,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.Доставка, 				ЛОЖЬ) КАК Доставка,
	|	ЕСТЬNULL(ВТ_ПараметрыРасчета.ГлавныйСкладСамовывоз, ЛОЖЬ) КАК ГлавныйСкладСамовывоз
	|ИЗ
	|	ВТ_Заказы КАК ВТ_Заказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПараметрыРасчета КАК ВТ_ПараметрыРасчета
	|		ПО ВТ_Заказы.Заказ = ВТ_ПараметрыРасчета.Заказ
	|";

