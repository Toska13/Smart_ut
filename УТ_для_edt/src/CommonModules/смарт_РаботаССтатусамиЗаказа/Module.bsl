//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Процедура смартУстановитьРассчитанныйПараметр(ЗначенияПараметровРасчета, СтрокаРезультата, ПараметрРасчета)

	СтруктураПоиска = Новый Структура("Заказ", СтрокаРезультата.Заказ);
	НайденныеЗначения = ЗначенияПараметровРасчета.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрЗначения Из НайденныеЗначения Цикл
		СтрЗначения[ПараметрРасчета] = СтрокаРезультата[ПараметрРасчета];
	КонецЦикла;	
	
КонецПроцедуры //--#1241 смарт: Лопато 25.01.2023

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартЗаписатьРегистрСмартПараметрыРасчетаСтатусовЗаказовБитрикс(ТаблицаПараметровРасчета)
	
	Успех = Истина;
	
	ПериодЗаписи = ТекущаяДата();

	Для Каждого СтрокаНовыхПараметровРасчета Из ТаблицаПараметровРасчета Цикл
		
		МенеджерЗаписиПараметра = РегистрыСведений.смартПараметрыРасчетаСтатусовЗаказовБитрикс.СоздатьМенеджерЗаписи();
		
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиПараметра, СтрокаНовыхПараметровРасчета);
		МенеджерЗаписиПараметра.Период = ПериодЗаписи;
		
		Попытка
        	МенеджерЗаписиПараметра.Записать();
		Исключение
			Успех = Ложь;
		КонецПопытки;
		
	КонецЦикла;	
		
	Возврат Успех;

КонецФункции //--#1241 смарт: Лопато 25.01.2023

//++#1241 смарт: Лопато 14.11.2022 //Доработать алгоритм вычисления статуса заказа для сайта.  
Функция смартОчиститьРегистрПроцессов(Заказ)

    НаборЗаписей = РегистрыСведений.смартПроцессИзмененияСтатусовЗаказовБитрикс.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Заказ.Установить(Заказ);
	НаборЗаписей.Прочитать();

	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Очистить();
	    НаборЗаписей.Записать();
	КонецЕсли;	
		
КонецФункции //--#1241 смарт: Лопато 14.11.2022

//++#1241 смарт: Лопато 14.11.2022 //Доработать алгоритм вычисления статуса заказа для сайта.  
