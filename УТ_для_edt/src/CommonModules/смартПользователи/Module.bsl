#Область НастройкиПользователей

// Определяет, включена ли настройка "Использовать подсистему 1С:CRM" у пользователя 
//
// Параметры:
// 		Пользователь - СправочникСсылка.Пользователи
// Возвращаемое значение:
// 		Булево - Истина, если опция включена
//
Функция ИспользуетПодсистемуCRM(Пользователь = Неопределено) Экспорт
	
	//++ #1760 смарт: Ермаков 12.04.2024 / Создание механизма оповещений менеджеров о назначенных Интересах.
	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.CRM_НастройкиПользователей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Настройка = ПланыВидовХарактеристик.CRM_НастройкиПользователей.ИспользоватьCRM;
	МенеджерЗаписи.Прочитать();
	
 	Возврат ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.Значение, Ложь);
	//-- #1760 смарт: Ермаков 12.04.2024
	
КонецФункции

// Определяет, включена ли пользователь в состав группы "Секретариат"
//
// Параметры:
// 		Пользователь - СправочникСсылка.Пользователи
// Возвращаемое значение:
// 		Булево - Истина, если пользователь включен в группу
//
Функция ЭтоСекретарь(Пользователь = Неопределено) Экспорт
	
	//++ #1760 смарт: Ермаков 12.04.2024 / Создание механизма оповещений менеджеров о назначенных Интересах.
	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	Группа = Справочники.ГруппыПользователей.НайтиПоНаименованию("Секретариат", Истина);
	
	Если Группа.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Не Группа.Состав.Найти(Пользователь, "Пользователь") = Неопределено;
	//-- #1760 смарт: Ермаков 12.04.2024
	
КонецФункции

