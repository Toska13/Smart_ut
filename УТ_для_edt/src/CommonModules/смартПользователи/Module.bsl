//++ #1929 смарт: Фролов 05.09.2024 //Создание рабочего места сотрудника с Задачами/Взаимодействиями/Поручениями
Функция ОткрыватьРабочийСтолСотрудника(Пользователь = Неопределено) Экспорт
	
	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.CRM_НастройкиПользователей.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Пользователь = Пользователь;
	МенеджерЗаписи.Настройка = ПланыВидовХарактеристик.CRM_НастройкиПользователей.смартИспользоватьРабочийСтолСотрудника;
	МенеджерЗаписи.Прочитать();
	
 	Возврат ?(МенеджерЗаписи.Выбран(), МенеджерЗаписи.Значение, Ложь);

КонецФункции //-- #1929 смарт: Фролов 05.09.2024	

//++ #Б-1954 смарт: Лопато 22.01.2025 //Заказ клиента. Колонка "Кто консультировал". Настроить выбор.  
Функция ПолучитьМассивПользователейКтоКонсультировал() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Объект КАК Справочник.Пользователи) КАК Пользователь
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения
		|ГДЕ
		|	Свойство = &Свойство
		|	И Значение = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР 
		|		КОГДА ВЫРАЗИТЬ(Объект КАК Справочник.Пользователи).Наименование = ""Никто"" 
		|		ТОГДА 0 
		|		ИНАЧЕ 1 
		|	КОНЕЦ,
		|	Пользователь
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Свойство", 
		ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту(
			"ИдентификаторДляФормул", "УчаствуетВВыбореКтоКонсультировалВЗаказеКлиента"));
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	
КонецФункции //-- #Б-1954 смарт: Лопато 22.01.2025

