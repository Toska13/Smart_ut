	СтруктураМассивовПисем.Вставить("ВсеПолученныеПисьма", Новый Массив);
	СтруктураМассивовПисем.Вставить("ПисьмаДляОпределенияПапок", Новый Массив);
	
	Возврат СтруктураМассивовПисем;
	
