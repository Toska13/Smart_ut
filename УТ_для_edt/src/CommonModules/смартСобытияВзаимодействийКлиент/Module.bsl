#Область ПрограммныйИнтерфейс

Процедура ПодключитьОбработчикОжиданияПользователя() Экспорт
	
	//++ #1747 смарт: Ермаков 05.04.2024 / Интеграция телефонии в 1C:СRM - Создание HTTP Сервиса для оповещения 1С
	Если СтандартныеПодсистемыКлиент.ПараметрКлиента("ПодключитьОбработчикОжиданияСобытияВзаимодействий") Тогда
		
		//++ #Б-1114 смарт: Ермаков 09.10.2024 / Поиск и устранение перерасхода ресурсов сервера  
		Если СтандартныеПодсистемыКлиент.ПараметрКлиента("ЭтоСекретарь") Тогда
			ИнтервалОбработчикаОжидания = 3;
		Иначе
			ИнтервалОбработчикаОжидания = 10;
		КонецЕсли;
		
		ПодключитьОбработчикОжидания("ОбработатьВходящееСобытиеВзаимодействия", ИнтервалОбработчикаОжидания);
		//-- #Б-1114 смарт: Ермаков 09.10.2024
		
	КонецЕсли; 	
	//-- #1747 смарт: Ермаков 05.04.2024
	
КонецПроцедуры

#КонецОбласти
