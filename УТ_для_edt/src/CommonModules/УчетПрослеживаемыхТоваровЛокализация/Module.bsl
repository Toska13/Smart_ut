Функция ШаблонСообщенияРазличныеПрослеживаемыеКомплектующие(ТипНоменклатуры, СборкаКомплекта, РедактированиеНабора)
	
	ПереносТекста = "
					|";
	
	Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор Тогда
		ТекстШаблона = НСтр("ru='Прослеживаемый по РНПТ набор ""%1"" не должен содержать различные прослеживаемые комплектующие:
							|%2.'");
		
		Если Не РедактированиеНабора Тогда
			ТекстШаблона = ТекстШаблона + ПереносТекста + НСтр("ru='Оставьте в составе набора одну прослеживаемую по РНПТ комплектующую и укажите ее в качестве основной.'");
		КонецЕсли;
	Иначе
		ТекстШаблона = НСтр("ru='Прослеживаемый по РНПТ комплект ""%1"" не должен содержать различные прослеживаемые комплектующие:
							|%2.'");
		
		Если СборкаКомплекта Тогда
			ТекстШаблона = ТекстШаблона + ПереносТекста + НСтр("ru='Оставьте в составе набора одну прослеживаемую по РНПТ комплектующую и укажите ее в качестве основной.'");
		Иначе
			ТекстШаблона = ТекстШаблона + ПереносТекста + НСтр("ru='Оставьте в составе комплекта одну прослеживаемую по РНПТ комплектующую.'");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекстШаблона;
	
