#Область ПрограммныйИнтерфейс

// Функция - получает остатки Адмирал на дату
//  
Функция ПолучитьОстаткиАдмирал(Дата, Артикул = "", ДляКовчега = Ложь) Экспорт
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", 	 Дата);
	Параметры.Вставить("Артикул", Артикул);
	
	Результат = ВыполнитьЗапросАдмирал(Параметры, "stock", ДляКовчега);
	
	Возврат Результат;

КонецФункции

// Функция - получает приходные ордера Адмирал по дате операций
//  
Функция ПолучитьПриходныеОрдераАдмирал(Дата) Экспорт
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", Дата);
	
	Результат = ВыполнитьЗапросАдмирал(Параметры, "status",, "1");
	
	Возврат Результат;

КонецФункции

// Функция - получает расходные ордера Адмирал по дате операций
//  
Функция ПолучитьРасходныеОрдераАдмирал(Дата) Экспорт
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
