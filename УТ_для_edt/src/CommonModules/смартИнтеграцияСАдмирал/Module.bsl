КонецФункции

// Функция - выполняет запрос Адмирал
//
// Входящие параметры:
// - Параметры - структура
// - Метод - строка
//  
Функция ВыполнитьЗапросАдмирал(Параметры, МетодПрефикс, ДляКовчега = Ложь, МетодПостфикс = "") Экспорт
	
	Результат = Неопределено;
	
	//Настройки соединенеия
	АдмиралAPIАдрес  = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("АдмиралAPIАдрес");
	АдмиралAPIРесурс = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("АдмиралAPIРесурс");
	АдмиралAPIЛогин  = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("АдмиралAPIЛогин");
	АдмиралAPIПароль = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("АдмиралAPIПароль");

	//Адрес ресурса
	МассивРесурс = Новый Массив;
	МассивРесурс.Добавить(АдмиралAPIРесурс);
	МассивРесурс.Добавить(МетодПрефикс);
	
	//++ #Б6592 смарт: Шляпников 27.04.2026 / Интеграция WMS. Проверить получение информации из Адмирал (АРМ Приемка и Отгрузка).
	//Если ВРЕГ(Метод) = "STOCK" Тогда
	Если ДляКовчега Тогда
		МассивРесурс.Добавить("ark");
	Иначе
		МассивРесурс.Добавить("smart");
	КонецЕсли;
	//КонецЕсли;
	//-- #Б6592 смарт: Шляпников 27.04.2026
	
	Если ЗначениеЗаполнено(МетодПостфикс) Тогда
		МассивРесурс.Добавить(МетодПостфикс);
	КонецЕсли;
	
	Если Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
		МассивРесурс.Добавить(Формат(Параметры.Дата, "ДФ=yyyy-MM-dd"));
	КонецЕсли;
	
	Если Параметры.Свойство("Артикул") Тогда
		Если ЗначениеЗаполнено(Параметры.Артикул) Тогда
			МассивРесурс.Добавить(Параметры.Артикул);
		Иначе
			МассивРесурс.Добавить("*");
		КонецЕсли;
	КонецЕсли;

	АдресРесурса = СтрСоединить(МассивРесурс, "/");
	
	//Выполнение запроса
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept",     "*/*");
	Заголовки.Вставить("Connection", "keep-alive");
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);

	Соединение = Новый HTTPСоединение(АдмиралAPIАдрес, , АдмиралAPIЛогин, АдмиралAPIПароль, , , ЗащищенноеСоединение);
					 
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	
	HTTPОтвет = Соединение.Получить(HTTPЗапрос);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда

		Результат = ПрочитатьОбъектИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
		
	Иначе

		ЗаписьЖурналаРегистрации("Запрос в Адмирал", УровеньЖурналаРегистрации.Ошибка, ,
								 "Код состояния: " + HTTPОтвет.КодСостояния, 
								 "Не удалось выполнить загрузку из Адмирал" + АдресРесурса);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Прочее

// Десериализует строку JSON в структуру или соответствие
//
// Параметры:
//  Строка - Строка
//
// Возвращаемое значение:
//  Структура или соответствие.
//
Функция ПрочитатьОбъектИзJSON(Стр, Соответствие = Ложь)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Попытка
    	Объект = ПрочитатьJSON(Чтение, Соответствие);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Объект = Неопределено;
		ЗаписьЖурналаРегистрации("Запрос в Адмирал", УровеньЖурналаРегистрации.Ошибка, , Стр, ОписаниеОшибки);
	КонецПопытки;
	
    Возврат Объект;
	
КонецФункции

#КонецОбласти