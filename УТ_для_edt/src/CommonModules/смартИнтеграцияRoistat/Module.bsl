// Смарт внесены изменения
// Общая процедура регистрации объектов 1С
//
Процедура ЗарегистрироватьИзмененияRoistat(Объект, Замещение = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);

	RoistatAPIKey = ПолучитьRoistatAPIKey();
	
	Если НЕ ЗначениеЗаполнено(RoistatAPIKey)
		ИЛИ (Объект.ДополнительныеСвойства.Свойство("НеРегистрироватьИзмененияДляСайта")
			 И Объект.ДополнительныеСвойства.НеРегистрироватьИзмененияДляСайта = Истина) Тогда
		
		Возврат;
		
	КонецЕсли;	

	МассивУзловRoistat = смартПолучитьМассивУзловRoistat();
		
	Если МассивУзловRoistat.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ТипОбъекта = ТипЗнч(Объект);

	МассивОбъектовДляРегистрации = Новый Массив;
	
	Если ТипОбъекта = Тип("ДокументОбъект.CRM_Интерес") Тогда
		
		Если НужноРегистрироватьИнтерес(Объект.Ссылка) Тогда
			
			МассивОбъектовДляРегистрации.Добавить(Объект.Ссылка);
			
		КонецЕсли;	

	ИначеЕсли ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.CRM_ИсторияСостоянийОбращений") тогда 

		Для Каждого ТекущаяЗаписьСостояния Из Объект Цикл
			
			Если ЗначениеЗаполнено(ТекущаяЗаписьСостояния.смартСтатусRoistat)
				И НужноРегистрироватьИнтерес(ТекущаяЗаписьСостояния.Обращение) Тогда
				
				МассивОбъектовДляРегистрации.Добавить(ТекущаяЗаписьСостояния.Обращение);
				
			КонецЕсли;	

		КонецЦикла;										   

	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.смартСтатусыRoistat") тогда 
		
		МассивОбъектовДляРегистрации.Добавить(Объект.Ссылка);

	//++ #Б-2560 смарт: Лопато 11.03.2025 //Интеграция с ROIStat. Добавление в выгрузку документа Заказ покупателя.  
	ИначеЕсли ТипОбъекта = Тип("ДокументОбъект.ЗаказКлиента") тогда 
		
		Если НужноРегистрироватьЗаказКлиента(Объект) Тогда
			МассивОбъектовДляРегистрации.Добавить(Объект.Ссылка);
		КонецЕсли;	

	ИначеЕсли ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.СостоянияЗаказовКлиентов") тогда 
		
		Для Каждого ТекущаяЗаписьСостояния Из Объект Цикл

			Если НужноРегистрироватьЗаказКлиента(ТекущаяЗаписьСостояния.Заказ) Тогда
				МассивОбъектовДляРегистрации.Добавить(ТекущаяЗаписьСостояния.Заказ);
			КонецЕсли;	
			
		КонецЦикла;										   
	//-- #Б-2560 смарт: Лопато 11.03.2025
		
	КонецЕсли;
	
	//Регистрация объектов на узлах
	Если МассивОбъектовДляРегистрации.Количество() > 0 Тогда
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловRoistat, МассивОбъектовДляРегистрации);

	КонецЕсли;
	
КонецПроцедуры

Функция смартПолучитьМассивУзловRoistat()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.смартОбменRoistat
	|ГДЕ
	|	НЕ ЭтотУзел
	|	И НЕ ПометкаУдаления
	|	И RoistatProject <> """"
	|	И URL <> """"";
	
	ТаблицаУзлов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаУзлов.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция НужноРегистрироватьИнтерес(Интерес)

	Результат = Ложь;

	// Инициализация настроек
	RoistatСхемаОтбораИнтересов = Справочники.смартПредопределенныеЗначения.ПолучитьМакет("RoistatСхемаОтбораИнтересов");

	RoistatНастройкиОтбораИнтересов = Справочники.смартПредопределенныеЗначения.Настройки.RoistatНастройкиОтбораИнтересов.Получить();
	
	Если ТипЗнч(RoistatНастройкиОтбораИнтересов) = Тип("НастройкиКомпоновкиДанных") Тогда
		НастройкиКомпоновкиОтбораИнтересов = RoistatНастройкиОтбораИнтересов;
	Иначе
		НастройкиКомпоновкиОтбораИнтересов = RoistatСхемаОтбораИнтересов.НастройкиПоУмолчанию;
	КонецЕсли;

	ИсточникНастроекОтбораИнтересов = Новый ИсточникДоступныхНастроекКомпоновкиДанных(
										        ПоместитьВоВременноеХранилище(RoistatСхемаОтбораИнтересов, Новый УникальныйИдентификатор()));

	// Инициализация компоновщика
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроекОтбораИнтересов);
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиОтбораИнтересов);

	// Установка параметров СКД
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ИнтересСсылка");
	ПараметрКомпановкиДанных.Значение = Интерес;
	ПараметрКомпановкиДанных.Использование = Истина;	
	
	// Инициализация компоновки СКД
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(RoistatСхемаОтбораИнтересов, КомпоновщикНастроек.Настройки, , , 
												  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	// Получаем таблицу значений результата запроса	
	ТаблицаИнтересов = Новый ТаблицаЗначений;
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаИнтересов);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ТаблицаИнтересов.Количество() > 0 Тогда;
		Результат = Истина;
	КонецЕсли;	
		
	Возврат Результат
	
КонецФункции	

//++ #Б-2560 смарт: Лопато 11.03.2025 //Интеграция с ROIStat. Добавление в выгрузку документа Заказ покупателя.  
Функция НужноРегистрироватьЗаказКлиента(ЗаказОбъект)

	Результат = Ложь;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) КАК Заказ
	|ПОМЕСТИТЬ ОнлайнЗаказы
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения
	|ГДЕ
	|   ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) = &Заказ
	|	И Свойство = &Свойство
	|	И Значение = &Значение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента) КАК Заказ
	|ПОМЕСТИТЬ Обработанные
	|ИЗ
	|	Документ.смартЛид
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказы 
	|		ПО ((ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента)) = ОнлайнЗаказы.Заказ)
	|			И (НЕ ПометкаУдаления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОнлайнЗаказы.Заказ КАК Заказ
	|ИЗ
	|	ОнлайнЗаказы КАК ОнлайнЗаказы	
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обработанные КАК Обработанные
	|		ПО (ОнлайнЗаказы.Заказ = Обработанные.Заказ)
	|ГДЕ		
	|	Обработанные.Заказ ЕСТЬ NULL";
	
	СвойствоОффлайнЗаказ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ОффлайнЗаказ");
    ЗначениеОффлайнЗаказ = "N";
	
	Запрос.УстановитьПараметр("Свойство", СвойствоОффлайнЗаказ);
	Запрос.УстановитьПараметр("Значение", ЗначениеОффлайнЗаказ);
	Запрос.УстановитьПараметр("Заказ", 	  ЗаказОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ЦФО 	 = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаБизнесРегионЦФО;
		СуммаЦФО = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаСуммаЦФО;

		ЗаказБизнесРегион = ЗаказОбъект.Партнер.БизнесРегион;
		
		Если (ЗаказОбъект.СуммаДокумента <= СуммаЦФО
			  И (ЗаказБизнесРегион = ЦФО ИЛИ ЗаказБизнесРегион.ПринадлежитЭлементу(ЦФО))) Тогда
				 
			Результат = Истина;
			
		КонецЕсли;	
				 
	КонецЕсли;	

	Возврат Результат;
	
КонецФункции //-- #Б-2560 смарт: Лопато 11.03.2025

#КонецОбласти
