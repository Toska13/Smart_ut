Функция ПолучитьПараметрыОбменаRoistat(Url, RoistatProject = "", Сервис = "", Ресурс = "", Метод = "", НачалоПериода = Неопределено, ОкончаниеПериода = Неопределено) Экспорт
	
	ПараметрыОбмена = Новый Соответствие;

	ПараметрыОбмена.Вставить("url",		   Url);
	ПараметрыОбмена.Вставить("api",		   "v1");
	ПараметрыОбмена.Вставить("context",	   "project");
	ПараметрыОбмена.Вставить("service",	   Сервис);
	ПараметрыОбмена.Вставить("resource",   Ресурс);
	ПараметрыОбмена.Вставить("method",	   Метод);
	ПараметрыОбмена.Вставить("accept",	   "application/json");
	ПараметрыОбмена.Вставить("api-key",	   ПолучитьRoistatAPIKey());
	
	СтруктураПараметров = Новый Структура;
	
	Если ЗначениеЗаполнено(RoistatProject) Тогда
		СтруктураПараметров.Вставить("project", RoistatProject);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(ОкончаниеПериода) Тогда

		СтруктураПараметров.Вставить("period", НачалоПериода + "-" + ОкончаниеПериода);
									   
	КонецЕсли;	

	ПараметрыОбмена.Вставить("Параметры", СтруктураПараметров);
	
	Возврат ПараметрыОбмена;
	
КонецФункции

//Функция получения адреса запроса
//Структура адреса: https://[url]/api/v1/[Контекст]/[Сервис]/[Ресурс]/[Метод]?project=[Проект]
Функция ПолучитьАдресРесурсаRoistat(ПараметрыОбмена)
	
	api = "/api/" + ПараметрыОбмена.Получить("api");
	
	context =  ?(ПараметрыОбмена.Получить("context") <> Неопределено, 
				 ?(ЗначениеЗаполнено(ПараметрыОбмена.Получить("context")), 
				   "/" + ПараметрыОбмена.Получить("context"), ""), "");
				
	service =  ?(ПараметрыОбмена.Получить("service") <> Неопределено, 
			 	 ?(ЗначениеЗаполнено(ПараметрыОбмена.Получить("service")), 
				   "/" + ПараметрыОбмена.Получить("service"), ""), "");
				
	resource = ?(ПараметрыОбмена.Получить("resource") <> Неопределено, 
				 ?(ЗначениеЗаполнено(ПараметрыОбмена.Получить("resource")), 
				   "/" + ПараметрыОбмена.Получить("resource"), ""), "");
				 
	method =   ?(ПараметрыОбмена.Получить("method") <> Неопределено, 
			     ?(ЗначениеЗаполнено(ПараметрыОбмена.Получить("method")), 
				   "/" + ПараметрыОбмена.Получить("method"), ""), "");

	АдресРесурса = api + context + service + resource + method;
						
	СтруктураПараметров = ПараметрыОбмена.Получить("Параметры");				
					
	Если СтруктураПараметров.Количество() > 0 Тогда
		
		СтрокаПараметров = "?";
		
		Для Каждого ЭлементПараметр Из СтруктураПараметров Цикл
			СтрокаПараметров = СтрокаПараметров + ЭлементПараметр.Ключ + "=" + ЭлементПараметр.Значение + "&";
		КонецЦикла;
		
		АдресРесурса = АдресРесурса + Лев(СтрокаПараметров, СтрДлина(СтрокаПараметров) - 1);
		
	КонецЕсли;
	
	Возврат АдресРесурса;
	
КонецФункции

Функция ВыполнитьЗапросRoistat(ВидЗапроса, ПараметрыОбмена, ТелоЗапроса = Неопределено) Экспорт
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("accept",	   ПараметрыОбмена.Получить("accept"));
	Заголовки.Вставить("Content-Type", ПараметрыОбмена.Получить("accept"));
	Заголовки.Вставить("Api-key", 	   ПараметрыОбмена.Получить("api-key"));
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);

	Соединение = Новый HTTPСоединение(ПараметрыОбмена.Получить("url"), , , , , , ЗащищенноеСоединение);
					 
	HTTPЗапрос = Новый HTTPЗапрос(ПолучитьАдресРесурсаRoistat(ПараметрыОбмена), Заголовки);
	
	Если ВРег(ВидЗапроса) = "GET" Тогда
		
		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		
	ИначеЕсли ВРег(ВидЗапроса) = "POST" Тогда
		
		Если ТелоЗапроса <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		ИначеЕсли ТелоЗапроса <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
		КонецЕсли;
	 
	    HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
	КонецЕсли;
	
	Возврат HTTPОтвет;
	
КонецФункции

Функция ПолучитьRoistatAPIKey()

	Возврат СокрЛП(Справочники.смартПредопределенныеЗначения.Настройки.RoistatAPIKey);
	
КонецФункции	

//++ #Б-1680 смарт: Лопато 13.12.2024 //Интеграция с ROIStat. Загрузка ProxyLeads. Загрузить данные.  
Процедура ЗагрузитьProxyLeads(МассивProxyLeads)
	
	Если НЕ ТипЗнч(МассивProxyLeads) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	
	
	СоответствиеПолейProxyLeads = Новый Соответствие;

	СоответствиеПолейProxyLeads.Вставить("ИдентификаторROIStat", "id");
	СоответствиеПолейProxyLeads.Вставить("Наименование",		 "title");
	СоответствиеПолейProxyLeads.Вставить("Описание", 			 "text");
	СоответствиеПолейProxyLeads.Вставить("ФИО", 				 "name");
	СоответствиеПолейProxyLeads.Вставить("Телефон", 			 "phone");
	СоответствиеПолейProxyLeads.Вставить("Email", 				 "email");
	СоответствиеПолейProxyLeads.Вставить("НомерВизита", 		 "roistat");
	СоответствиеПолейProxyLeads.Вставить("ДатаСоздания", 		 "creation_date");
	СоответствиеПолейProxyLeads.Вставить("ИдентификаторСделки",  "order_id");
	СоответствиеПолейProxyLeads.Вставить("ДополнительныеПоля",   "order_fields");
	СоответствиеПолейProxyLeads.Вставить("ЭтоСпам",   			 "is_spam");
	СоответствиеПолейProxyLeads.Вставить("Тип",				     "engine_type");
	
	МассивID = Новый Массив;

	Для Каждого ProxyLeads Из МассивProxyLeads Цикл
		
		ЗначениеID = ProxyLeads.Получить("id");
		
		Если ЗначениеЗаполнено(ЗначениеID) Тогда
			МассивID.Добавить(ЗначениеID);
		КонецЕсли;	
			
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ИдентификаторROIStat КАК ID
		|ИЗ
		|	РегистрСведений.смартПроксиЛидыROIStat
		|ГДЕ
		|	ИдентификаторROIStat В (&МассивID)";
	
	Запрос.УстановитьПараметр("МассивID", МассивID);
	РезультатID = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ID");
	
	Для Каждого ProxyLeads Из МассивProxyLeads Цикл

		ЗначениеID = ProxyLeads.Получить("id");
		
		Если ЗначениеЗаполнено(ЗначениеID) 
			И РезультатID.Найти(ЗначениеID) = Неопределено Тогда

			НоваяЗапись = РегистрыСведений.смартПроксиЛидыROIStat.СоздатьМенеджерЗаписи();
			
			Для Каждого Поле Из СоответствиеПолейProxyLeads Цикл
				
				ЗначениеПоля = ProxyLeads.Получить(Поле.Значение);
				
				Если Поле.Ключ = "ДополнительныеПоля" Тогда
					НоваяЗапись[Поле.Ключ] = ЗаписатьОбъектВJSON(ЗначениеПоля);
				ИначеЕсли Поле.Ключ = "ДатаСоздания" Тогда
					НоваяЗапись[Поле.Ключ] = МестноеВремя(
											     СтрЗаменить(
												     СтрЗаменить(
													     СтрЗаменить(
													  	     ЗначениеПоля,
														 "-", ""),
													 ":", ""), 
												 " ", ""));
				Иначе	
					НоваяЗапись[Поле.Ключ] = ЗначениеПоля;
				КонецЕсли;
				
			КонецЦикла;
			
			НоваяЗапись.Записать();
			
		КонецЕсли;	
		
	КонецЦикла;

КонецПроцедуры //-- #Б-1680 смарт: Лопато 13.12.2024

