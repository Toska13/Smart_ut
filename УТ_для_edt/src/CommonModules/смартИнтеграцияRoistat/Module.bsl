//				  По умолчанию все даты в Roistat интерпретируются 
//				  в часовом поясе UTC+0 как 2024-01-01 12:00:00+00:00 
//
// Возвращаемое значение:
//  Дата в формате строки.
//
Функция ПолучитьДатуRoistat(Дата, ЧасовойПояс = "+0300")

