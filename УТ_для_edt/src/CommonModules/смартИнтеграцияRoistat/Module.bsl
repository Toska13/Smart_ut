#Область ПрограммныйИнтерфейс

// Процедура - Процедура выполняет обмен
//  
Процедура ВыполнитьЗаданиеОбменRoistat(Параметры) Экспорт
	
	ЭтоОбменПоРегламентномуЗаданию = Ложь;
	
	Если ТипЗнч(Параметры) = Тип("Строка") Тогда
		
		//Запуск по регламентному задани
		ЭтоОбменПоРегламентномуЗаданию = Истина;
		
		Параметры = Новый Структура("УзелОбмена", ПланыОбмена.смартОбменRoistat.НайтиПоКоду(Параметры));
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Параметры.УзелОбмена) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиОбмена = ПолучитьНастройкиОбменаУзлаRoistat(Параметры.УзелОбмена);
	
	Если НЕ ЗначениеЗаполнено(НастройкиОбмена.URL)
		ИЛИ НЕ ЗначениеЗаполнено(НастройкиОбмена.RoistatProject)
		ИЛИ НЕ ЗначениеЗаполнено(ПолучитьRoistatAPIKey()) Тогда

		ЗаписьЖурналаРегистрации("Обмен с Roistat", УровеньЖурналаРегистрации.Ошибка, ,
								 "Roistat APIKey, Roistat URL и Roistat Project должны быть заполнены", 
								 "Не удалось выгрузить в Roistat");
		
		Возврат;
		
	КонецЕсли;	

	Если ЭтоОбменПоРегламентномуЗаданию 
		И НЕ НастройкиОбмена.ИспользоватьРегламентныеЗадания Тогда
		
		Возврат;
		
	КонецЕсли;
	
	//Выгрузка статусов
	ВыполнитьОбменRoistat(НастройкиОбмена, "Справочник.смартСтатусыRoistat", "set-statuses");
	
	//Выгрузка интересов
	ВыполнитьОбменRoistat(НастройкиОбмена, "Документ.CRM_Интерес", "add-orders");

	//++ #Б-2560 смарт: Лопато 11.03.2025 //Интеграция с ROIStat. Добавление в выгрузку документа Заказ покупателя.  
	//Выгрузка заказов
	ВыполнитьОбменRoistat(НастройкиОбмена, "Документ.ЗаказКлиента", "add-orders");
	//-- #Б-2560 смарт: Лопато 11.03.2025
	
	//++ #Б-1680 смарт: Лопато 13.12.2024 //Интеграция с ROIStat. Загрузка ProxyLeads. Загрузить данные.  
	НачалоПериода 	 = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");
	ОкончаниеПериода = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd");

	//Загрузка ProxyLeads
	ВыполнитьЗагрузкуRoistat(НастройкиОбмена, "proxy-leads", , , НачалоПериода, ОкончаниеПериода);
	//-- #Б-1680 смарт: Лопато 13.12.2024
	
КонецПроцедуры

Функция ВыполнитьОбменRoistat(НастройкиОбмена, ОбъектВыгрузки, Сервис) Экспорт
	
	Результат = Ложь;
	
	Если ТипЗнч(ОбъектВыгрузки) = Тип("Строка") Тогда
		МассивОбъектов = ПолучитьИзмененияПоУзлу(НастройкиОбмена.Ссылка, ОбъектВыгрузки);
	ИначеЕсли ТипЗнч(ОбъектВыгрузки) = Тип("Массив") Тогда	
    	МассивОбъектов = ОбъектВыгрузки;
	КонецЕсли;	
		
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ПараметрыОбмена = ПолучитьПараметрыОбменаRoistat(НастройкиОбмена.Url, НастройкиОбмена.RoistatProject, Сервис);
	
	//Выгрузка статусов
	Если Сервис = "set-statuses" Тогда
		
		СтруктураДанных = ПолучитьДанныеСтатусовRoistat();
		
	//Выгрузка интересов
	ИначеЕсли Сервис = "add-orders" Тогда
		
		//++ #Б-2560 смарт: Лопато 11.03.2025 //Интеграция с ROIStat. Добавление в выгрузку документа Заказ покупателя.  
		НаименованиеОбъекта = ПолучитьНаименованиеОбъекта(ОбъектВыгрузки);
		
		МассивКлиентов = ПолучитьМассивКлиентов(МассивОбъектов, НаименованиеОбъекта);
		
		Если ВыполнитьОбменRoistat(НастройкиОбмена, МассивКлиентов, "clients") Тогда
			
			Если НаименованиеОбъекта = "Документ.CRM_Интерес" Тогда
			
				СтруктураДанных = ПолучитьДанныеИнтересовRoistat(МассивОбъектов);
				
			ИначеЕсли НаименованиеОбъекта = "Документ.ЗаказКлиента" Тогда

				СтруктураДанных = ПолучитьДанныеЗаказовRoistat(МассивОбъектов);
				
			КонецЕсли;	
		//-- #Б-2560 смарт: Лопато 11.03.2025
			
		Иначе
			
			ЗаписьЖурналаРегистрации("Обмен с Roistat", УровеньЖурналаРегистрации.Ошибка, , ,
									 "Не удалось выгрузить клиентов");
			Возврат Ложь;
			
		КонецЕсли;	
			
	//Выгрузка клиентов
	ИначеЕсли Сервис = "clients" Тогда
		
		ПараметрыОбмена.Вставить("resource", "import");

		СтруктураДанных = ПолучитьДанныеКлиентовRoistat(МассивОбъектов);
		
	КонецЕсли;
	
	ТелоЗапроса = ЗаписатьОбъектВJSON(СтруктураДанных.СтруктураТелаЗапроса);
	
	HTTPОтвет = ВыполнитьЗапросRoistat("POST", ПараметрыОбмена, ТелоЗапроса);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда

		ContentType = HTTPОтвет.Заголовки.Получить("Content-Type");

		Если Найти(ContentType, ПараметрыОбмена.Получить("accept")) > 0 Тогда
			
			ДанныеJSON = ПрочитатьОбъектИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
			
			Если ТипЗнч(ДанныеJSON) = Тип("Соответствие") 
				И ДанныеJSON.Получить("status") = "success" Тогда 
				
				Если СтруктураДанных.Свойство("МассивВыгруженныхСсылок")
					И СтруктураДанных.МассивВыгруженныхСсылок.Количество() > 0 Тогда
				
					ПланыОбмена.УдалитьРегистрациюИзменений(НастройкиОбмена.Ссылка, 
														    СтруктураДанных.МассивВыгруженныхСсылок);
					
				КонецЕсли;
														
				Результат = Истина;										
														
			Иначе
				
				ЗаписьЖурналаРегистрации("Обмен с Roistat", УровеньЖурналаРегистрации.Ошибка, ,
										 HTTPОтвет.ПолучитьТелоКакСтроку(), "Не удалось выгрузить данные");
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

//++ #Б-1680 смарт: Лопато 13.12.2024 //Интеграция с ROIStat. Загрузка ProxyLeads. Загрузить данные.  
Функция ВыполнитьЗагрузкуRoistat(НастройкиОбмена, Сервис, Ресурс = "", Метод = "", НачалоПериода = "", ОкончаниеПериода = "") Экспорт
	
	Результат = Неопределено;
	
	ПараметрыОбмена = ПолучитьПараметрыОбменаRoistat(НастройкиОбмена.Url, 
													 НастройкиОбмена.RoistatProject, 
													 Сервис, 
													 Ресурс, 
													 Метод, 
													 НачалоПериода, 
													 ОкончаниеПериода);
	
	HTTPОтвет = ВыполнитьЗапросRoistat("GET", ПараметрыОбмена);
	
	Если HTTPОтвет.КодСостояния = 200 Тогда

		ContentType = HTTPОтвет.Заголовки.Получить("Content-Type");

		Если Найти(ContentType, ПараметрыОбмена.Получить("accept")) > 0 Тогда
			
			ДанныеJSON = ПрочитатьОбъектИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
			
			Если ТипЗнч(ДанныеJSON) = Тип("Соответствие") 
				И ДанныеJSON.Получить("status") = "success" Тогда 

				Если Сервис = "proxy-leads" Тогда
					ЗагрузитьProxyLeads(ДанныеJSON.Получить("ProxyLeads"));
				КонецЕсли;
				
			Иначе
				
				ЗаписьЖурналаРегистрации("Обмен с Roistat", УровеньЖурналаРегистрации.Ошибка, ,
										 HTTPОтвет.ПолучитьТелоКакСтроку(), "Не удалось выполнить загрузку " + Сервис);
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

//++ #Б-1634 смарт: Лопато 10.12.2024 //Интеграция с ROIStat. Доработать регистр состояний Интересов. Оплата заказа  
Функция ПолучитьСостоянияИнтересовЗаказовRoistat(МассивЗаказов) Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Журнал.Объект КАК Документ.ЗаказКлиента) КАК Заказ,
		|	ИсторияСостояний.Период КАК Период,
		|	ИсторияСостояний.Обращение КАК Обращение,
		|	ИсторияСостояний.Состояние КАК Состояние,
		|	ИсторияСостояний.ДатаЗавершения КАК ДатаЗавершения,
		|	ИсторияСостояний.смартСтатусRoistat КАК смартСтатусRoistat
		|ИЗ
		|	РегистрСведений.CRM_ЖурналДокументов КАК Журнал
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ИсторияСостоянийОбращений.СрезПоследних(, ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)) КАК ИсторияСостояний
		|		ПО Журнал.CRM_Интерес = ИсторияСостояний.Обращение
		|ГДЕ
		|	Журнал.ГлавнаяЗапись
		|	И ВЫРАЗИТЬ(Журнал.Объект КАК Документ.ЗаказКлиента) В(&МассивЗаказов)";

	Запрос.УстановитьПараметр("МассивЗаказов", МассивЗаказов);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции //-- #Б-1634 смарт: Лопато 10.12.2024

//++ #Б-1634 смарт: Лопато 10.12.2024 //Интеграция с ROIStat. Доработать регистр состояний Интересов. Оплата заказа  
Процедура ОбновитьЗаписьСостояниеИнтереса(ДанныеСостояния) Экспорт

	СтруктураЗаписиСостояний = Новый Структура;
	
	СтруктураЗаписиСостояний.Вставить("Период");
	СтруктураЗаписиСостояний.Вставить("Обращение");
	СтруктураЗаписиСостояний.Вставить("Состояние");
	СтруктураЗаписиСостояний.Вставить("ДатаЗавершения");
	СтруктураЗаписиСостояний.Вставить("смартСтатусRoistat");
	
	ЗаполнитьЗначенияСвойств(СтруктураЗаписиСостояний, ДанныеСостояния);
					
	ОбменДаннымиСлужебный.ОбновитьЗаписьВРегистрСведений(СтруктураЗаписиСостояний, "CRM_ИсторияСостоянийОбращений");
	
КонецПроцедуры //-- #Б-1634 смарт: Лопато 10.12.2024

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьНастройкиОбменаУзлаRoistat(УзелОбмена)
	
	НастройкиОбмена = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		УзелОбмена, "
		|Ссылка, 
	    |URL, 
	    |RoistatProject,
		|ИспользоватьРегламентныеЗадания");
	
	Возврат НастройкиОбмена;
	
КонецФункции	

Функция ПолучитьДанныеСтатусовRoistat()

	Результат = Новый Структура;
	Результат.Вставить("СтруктураТелаЗапроса", Новый Массив);
	Результат.Вставить("МассивВыгруженныхСсылок", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка КАК Ссылка,
	|	Наименование КАК name,
	|	ВЫБОР КОГДА Тип = ЗНАЧЕНИЕ(Перечисление.смартТипыСтатусовRoistat.progress) ТОГДА ""progress""
	|		  КОГДА Тип = ЗНАЧЕНИЕ(Перечисление.смартТипыСтатусовRoistat.paid)     ТОГДА ""paid""
	|		  КОГДА Тип = ЗНАЧЕНИЕ(Перечисление.смартТипыСтатусовRoistat.canceled) ТОГДА ""canceled""
	|	КОНЕЦ КАК type 
	|ИЗ
	|	Справочник.смартСтатусыRoistat";

	ВыборкаЗначений = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаЗначений.Следующий() Цикл

		//Массив выгружаемых объектов
		Результат.МассивВыгруженныхСсылок.Добавить(ВыборкаЗначений.Ссылка);
		
		//Структура тела запроса
		СтруктураРезультата = Новый Структура("id, name, type");
		
		ЗаполнитьЗначенияСвойств(СтруктураРезультата, ВыборкаЗначений);

		СтруктураРезультата.id = XMLСтрока(ВыборкаЗначений.Ссылка);;
		
		Результат.СтруктураТелаЗапроса.Добавить(СтруктураРезультата);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции	

//++ #Б-1670 смарт: Лопато 16.12.2024 //Интеграция с ROIStat. Выгрузка интересов. Выгрузка произвольных полей, товаров и клиента.  
Функция ПолучитьДанныеИнтересовRoistat(МассивОбъектов)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
    Результат = Новый Структура;
	Результат.Вставить("СтруктураТелаЗапроса", Новый Массив);
	Результат.Вставить("МассивВыгруженныхСсылок", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CRM_Интерес КАК Интерес,
		|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) КАК Заказ,
		|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента).Дата КАК ЗаказДата,
		|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента).Валюта КАК ЗаказВалюта
		|ПОМЕСТИТЬ ЗапросЗаказ
		|ИЗ
		|	РегистрСведений.CRM_ЖурналДокументов
		|ГДЕ
		|	CRM_Интерес В(&МассивИнтересов)
		|	И ГлавнаяЗапись
		|	И Объект ССЫЛКА Документ.ЗаказКлиента
		|
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Интерес,
		|	Дата КАК Дата,
		|	Номер КАК Номер,
		|	Ссылка.Партнер КАК Клиент,
		|	Тема КАК name,
		|	ЕСТЬNULL(ИсторияСостояний.смартСтатусRoistat, """") КАК СтатусRoistat,
		|	ЕСТЬNULL(ЗапросЗаказ.Заказ, ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)) КАК Заказ,
		|	ЕСТЬNULL(ЗапросЗаказ.ЗаказДата, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗаказДата,
		|	ЕСТЬNULL(ЗапросЗаказ.ЗаказВалюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ЗаказВалюта,
		|	ЕСТЬNULL(ВЫРАЗИТЬ(Ссылка.ДокументОснование КАК Документ.смартЛид).Roistat_visit, """") КАК roistat,
		|	Ссылка.ТипУслуги.Наименование КАК ТипУслуги, 
		|	Ссылка.Ответственный.Наименование КАК Менеджер, 
		|	ВЫБОР 
		|		КОГДА Ссылка.смартИтоговаяКвалификация <> ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.ПустаяСсылка) ТОГДА
		|			Ссылка.смартИтоговаяКвалификация.Наименование
		|		КОГДА Ссылка.смартПредварительнаяКвалификация <> ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.ПустаяСсылка) ТОГДА
		|			Ссылка.смартПредварительнаяКвалификация.Наименование
		|		ИНАЧЕ
		|		""""
		|	КОНЕЦ КАК Квалификация,
		|	ВЫБОР КОГДА ИсторияСостояний.Состояние.РеквизитДопУпорядочивания = 99 
		|		ТОГДА
		|			ПричинаОтказа
		|		ИНАЧЕ
		|			""""
		|	КОНЕЦ КАК ПричинаОтказа,
		|	ВЫБОР КОГДА ИсторияСостояний.Состояние.РеквизитДопУпорядочивания = 99 
		|		ТОГДА
		|			ПричинаОтказаКомментарий
		|		ИНАЧЕ
		|			""""
		|	КОНЕЦ КАК ПричинаОтказаКомментарий
		|ИЗ
		|	Документ.CRM_Интерес
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ИсторияСостоянийОбращений.СрезПоследних(, Обращение В(&МассивИнтересов)) КАК ИсторияСостояний
		|		ПО Ссылка = ИсторияСостояний.Обращение
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЗапросЗаказ КАК ЗапросЗаказ
		|		ПО Ссылка = ЗапросЗаказ.Интерес
		|ГДЕ
		|	Ссылка В(&МассивИнтересов)
		|
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗапросЗаказ.Интерес КАК Интерес,
		|	ЗапросЗаказ.Заказ КАК Заказ,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Номенклатура.Наименование КАК name,
		|	ЕСТЬNULL(Товары.Номенклатура.Марка.Наименование, """") КАК brand,
		|	СУММА(Товары.СуммаСНДС) КАК СуммаСНДС,
		|	СУММА(Товары.Количество) КАК Количество
		|ИЗ
		|	ЗапросЗаказ КАК ЗапросЗаказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК Товары
		|		ПО ЗапросЗаказ.Заказ = Товары.Ссылка
		|ГДЕ
		|	НЕ Товары.Отменено
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура,
		|	ЗапросЗаказ.Заказ,
		|	ЗапросЗаказ.Интерес,
		|	Товары.Номенклатура.Наименование,
		|	Товары.Номенклатура.Марка
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CRM_Интерес.Ссылка КАК Интерес,
		|	CRM_Взаимодействие.Дата КАК Дата,
		|	CRM_Взаимодействие.Результат КАК Результат
		|ИЗ
		|	Документ.CRM_Интерес КАК CRM_Интерес
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
		|		ПО (CRM_Интерес.Партнер = CRM_Взаимодействие.Партнер)
		|           И (CRM_Интерес.Ответственный = CRM_Взаимодействие.Ответственный)
		|           И (CRM_Интерес.Дата <= CRM_Взаимодействие.Дата)
		|			И НЕ CRM_Взаимодействие.ПометкаУдаления
		|			И CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)
		|			И НЕ ПОДСТРОКА(Результат, 1, 30) ПОДОБНО ""%Завершено автоматически%""
		|ГДЕ
		|	CRM_Интерес.Ссылка В(&МассивИнтересов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Интерес,
		|	Дата";
	
	Запрос.УстановитьПараметр("МассивИнтересов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаЗначений 	  = РезультатЗапроса[1].Выбрать();
	ТаблицаТоваров  	  = РезультатЗапроса[2].Выгрузить();
	ТаблицаВзаимодействий = РезультатЗапроса[3].Выгрузить();
	
	Пока ВыборкаЗначений.Следующий() Цикл

		//Массив выгружаемых объектов
		Результат.МассивВыгруженныхСсылок.Добавить(ВыборкаЗначений.Интерес);
		
		Если НЕ ЗначениеЗаполнено(ВыборкаЗначений.СтатусRoistat) Тогда
			Продолжить;
		КонецЕсли;	

		КоэффициентПересчетаВВалютуВзаиморасчетов = Неопределено;
		
		Если ЗначениеЗаполнено(ВыборкаЗначений.Заказ)
			И ЗначениеЗаполнено(ВыборкаЗначений.ЗаказВалюта)
			И ВыборкаЗначений.ЗаказВалюта <> ВалютаРегламентированногоУчета Тогда
			
			Коэффициенты = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентыПересчетаВалюты(ВыборкаЗначений.ЗаказВалюта, 
																					 ВалютаРегламентированногоУчета, 
																					 ВыборкаЗначений.ЗаказДата);
																					 
			КоэффициентПересчетаВВалютуВзаиморасчетов = Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов;

		КонецЕсли;
		
		//Структура тела запроса
		СтруктураРезультата = Новый Структура("id, name, client_id, date_create, status, roistat");

		ЗаполнитьЗначенияСвойств(СтруктураРезультата, ВыборкаЗначений);
		
		СтруктураРезультата.id 			= XMLСтрока(ВыборкаЗначений.Интерес);
		СтруктураРезультата.client_id	= XMLСтрока(ВыборкаЗначений.Клиент);
		СтруктураРезультата.status		= XMLСтрока(ВыборкаЗначений.СтатусRoistat);
		СтруктураРезультата.date_create = ПолучитьДатуRoistat(ВыборкаЗначений.Дата);
		
		//Дополнительные поля
		СтруктураДопПолей = Новый Структура("Номер, ТипУслуги, Квалификация, Менеджер");

		ЗаполнитьЗначенияСвойств(СтруктураДопПолей, ВыборкаЗначений);
		
		Если ЗначениеЗаполнено(ВыборкаЗначений.ПричинаОтказа) Тогда
			СтруктураДопПолей.Вставить("Причина_отказа", СокрЛП(ВыборкаЗначений.ПричинаОтказа));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаЗначений.ПричинаОтказаКомментарий) Тогда
			СтруктураДопПолей.Вставить("Причина_отказа_комментарий", СокрЛП(ВыборкаЗначений.ПричинаОтказаКомментарий));
		КонецЕсли;
		
		//Результаты взаимодействий
		СтрокиВзаимодействий = ТаблицаВзаимодействий.НайтиСтроки(Новый Структура("Интерес", ВыборкаЗначений.Интерес));
		
		Сч = 1;
		
		Для Каждого СтрокаВзаимодействия Из СтрокиВзаимодействий Цикл
			
			ТекстВзаимодействий = Формат(СтрокаВзаимодействия.Дата, "ДФ=dd.MM.yyyy")
								  + " - " + СокрЛП(СтрокаВзаимодействия.Результат);

			СтруктураДопПолей.Вставить("Результат_взаимодействия_" + Строка(Сч), Лев(ТекстВзаимодействий, 1000));
			
			Сч = Сч + 1;
			
		КонецЦикла;	
		
		СтруктураРезультата.Вставить("fields", СтруктураДопПолей);
		
		//Товары
		СтрокиТоваровИнтереса = ТаблицаТоваров.НайтиСтроки(Новый Структура("Интерес", ВыборкаЗначений.Интерес));

		СуммаТоваров  = 0;
		МассивТоваров = Новый Массив;	
		
		Для Каждого СтрокаТовара Из СтрокиТоваровИнтереса Цикл
			
			СтруктураТовара = Новый Структура("id, name, brand");
			
			ЗаполнитьЗначенияСвойств(СтруктураТовара, СтрокаТовара);
			
			СтруктураТовара.id = XMLСтрока(СтрокаТовара.Номенклатура);
			
			СуммаПоСтроке = СтрокаТовара.СуммаСНДС;
			
			Если ТипЗнч(КоэффициентПересчетаВВалютуВзаиморасчетов) = Тип("Число") Тогда
				
				СуммаПоСтроке = СуммаПоСтроке * КоэффициентПересчетаВВалютуВзаиморасчетов;
				
			КонецЕсли;

			СуммаТоваров = СуммаТоваров + СуммаПоСтроке;
			
			СтруктураТовара.Вставить("quantity", СтрокаТовара.Количество);
			СтруктураТовара.Вставить("price",    ?(СтрокаТовара.Количество <> 0, 
													   СуммаПоСтроке / СтрокаТовара.Количество, 0));
			
			//category
			ПолноеНаименованиеНоменклатуры = СтрокаТовара.Номенклатура.ПолноеНаименование();
			ПутьКНоменклатуре = СтрЗаменить(ПолноеНаименованиеНоменклатуры, "/" + СтрокаТовара.name, ""); 
			
			ПутьМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ПутьКНоменклатуре, "/");
			
			СтруктураКатегории = Новый Структура; 
			
			НомерУровня = 1;
			
			Пока НомерУровня <= ПутьМассив.Количество() И НомерУровня <= 5 Цикл
				
				Уровень = ПутьМассив[НомерУровня - 1];
				
				СтруктураКатегории.Вставить("level" + Строка(НомерУровня), Уровень);
				
				НомерУровня = НомерУровня + 1;
			   
			КонецЦикла;   
			
			СтруктураТовара.Вставить("category", СтруктураКатегории);
			
			МассивТоваров.Добавить(СтруктураТовара);
			
		КонецЦикла;	
		
		СтруктураРезультата.Вставить("price", СуммаТоваров);
		
		Если МассивТоваров.Количество() > 0 Тогда
			СтруктураРезультата.Вставить("products", МассивТоваров);
		КонецЕсли;	

		Результат.СтруктураТелаЗапроса.Добавить(СтруктураРезультата);
			
	КонецЦикла;

	Возврат Результат;
	
КонецФункции //-- #Б-1670 смарт: Лопато 16.12.2024

//++ #Б-2560 смарт: Лопато 11.03.2025 //Интеграция с ROIStat. Добавление в выгрузку документа Заказ покупателя.  
Функция ПолучитьДанныеЗаказовRoistat(МассивОбъектов)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
    Результат = Новый Структура;
	Результат.Вставить("СтруктураТелаЗапроса", Новый Массив);
	Результат.Вставить("МассивВыгруженныхСсылок", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Заказ,
		|	Дата КАК Дата,
		|	Номер КАК Номер,
		|	Валюта КАК Валюта,
		|	Партнер КАК Партнер,
		|	Менеджер КАК Менеджер,
		|	ПометкаУдаления КАК ПометкаУдаления
		|ПОМЕСТИТЬ ЗапросЗаказ
		|ИЗ
		|	Документ.ЗаказКлиента
		|ГДЕ
		|	Ссылка В(&МассивОбъектов)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗапросЗаказ.Заказ КАК Заказ,
		|	Дата КАК ЗаказДата,
		|	Номер КАК ЗаказНомер,
		|	Валюта КАК ЗаказВалюта,
		|	Партнер КАК Партнер,
		|	Менеджер.Наименование КАК Менеджер,
		|	ВЫБОР
		|		КОГДА ПометкаУдаления 
		|			  	  ИЛИ (СостоянияЗаказовКлиентов.ПроцентОплаты = 0
		|				   	   И СостоянияЗаказовКлиентов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт))
		|			ТОГДА &СтатусRoistatЗавершенНеудачно
		|		КОГДА СостоянияЗаказовКлиентов.ПроцентОплаты = 100
		|			ТОГДА &СтатусRoistatСчетОплаченПолностью
		|		КОГДА СостоянияЗаказовКлиентов.ПроцентОплаты > 0
		|			ТОГДА &СтатусRoistatСчетОплаченЧастично
		|		ИНАЧЕ &СтатусRoistatСчетВыставлен
		|	КОНЕЦ КАК СтатусRoistat,
		|	ЕСТЬNULL(ДополнительныеСведенияRoistat_Visit.Значение, """") КАК roistat
		|ИЗ
		|	ЗапросЗаказ КАК ЗапросЗаказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведенияRoistat_Visit
		|   	ПО Объект = Заказ И Свойство = &СвойствоRoistat_Visit
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|		ПО СостоянияЗаказовКлиентов.Заказ = ЗапросЗаказ.Заказ
		|;
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗапросЗаказ.Заказ КАК Заказ,
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Номенклатура.Наименование КАК name,
		|	ЕСТЬNULL(Товары.Номенклатура.Марка.Наименование, """") КАК brand,
		|	СУММА(Товары.СуммаСНДС) КАК СуммаСНДС,
		|	СУММА(Товары.Количество) КАК Количество
		|ИЗ
		|	ЗапросЗаказ КАК ЗапросЗаказ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК Товары
		|		ПО ЗапросЗаказ.Заказ = Товары.Ссылка
		|ГДЕ
		|	НЕ Товары.Отменено
		|
		|СГРУППИРОВАТЬ ПО
		|	Товары.Номенклатура,
		|	ЗапросЗаказ.Заказ,
		|	Товары.Номенклатура.Наименование,
		|	Товары.Номенклатура.Марка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);

	СвойствоRoistat_Visit = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "Roistat_Visit");
	Запрос.УстановитьПараметр("СвойствоRoistat_Visit", СвойствоRoistat_Visit);

	Запрос.УстановитьПараметр("СтатусRoistatСчетВыставлен", 	   Справочники.смартСтатусыRoistat.НайтиПоКоду("03"));
	Запрос.УстановитьПараметр("СтатусRoistatСчетОплаченЧастично",  Справочники.смартСтатусыRoistat.НайтиПоКоду("04"));
	Запрос.УстановитьПараметр("СтатусRoistatСчетОплаченПолностью", Справочники.смартСтатусыRoistat.НайтиПоКоду("05"));
	Запрос.УстановитьПараметр("СтатусRoistatЗавершенНеудачно",	   Справочники.смартСтатусыRoistat.НайтиПоКоду("06"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаЗначений 	  = РезультатЗапроса[1].Выбрать();
	ТаблицаТоваров  	  = РезультатЗапроса[2].Выгрузить();
	
	Пока ВыборкаЗначений.Следующий() Цикл

		//Массив выгружаемых объектов
		Результат.МассивВыгруженныхСсылок.Добавить(ВыборкаЗначений.Заказ);
		
		Если НЕ ЗначениеЗаполнено(ВыборкаЗначений.СтатусRoistat) Тогда
			Продолжить;
		КонецЕсли;	

		КоэффициентПересчетаВВалютуВзаиморасчетов = Неопределено;
		
		Если ЗначениеЗаполнено(ВыборкаЗначений.Заказ)
			И ЗначениеЗаполнено(ВыборкаЗначений.ЗаказВалюта)
			И ВыборкаЗначений.ЗаказВалюта <> ВалютаРегламентированногоУчета Тогда
			
			Коэффициенты = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентыПересчетаВалюты(ВыборкаЗначений.ЗаказВалюта, 
																					 ВалютаРегламентированногоУчета, 
																					 ВыборкаЗначений.ЗаказДата);
																					 
			КоэффициентПересчетаВВалютуВзаиморасчетов = Коэффициенты.КоэффициентПересчетаВВалютуВзаиморасчетов;

		КонецЕсли;
		
		//Структура тела запроса
		СтруктураРезультата = Новый Структура("id, name, client_id, date_create, status, price, roistat");

		СтруктураРезультата.id 			= XMLСтрока(ВыборкаЗначений.Заказ);
		СтруктураРезультата.name 		= "Заказ с сайта Smart.shop " + СокрЛП(ВыборкаЗначений.ЗаказНомер);
		СтруктураРезультата.client_id	= XMLСтрока(ВыборкаЗначений.Партнер);
		СтруктураРезультата.date_create = ПолучитьДатуRoistat(ВыборкаЗначений.ЗаказДата);
		СтруктураРезультата.status		= XMLСтрока(ВыборкаЗначений.СтатусRoistat);
		СтруктураРезультата.roistat		= СокрЛП(ВыборкаЗначений.roistat);
		
		//Дополнительные поля
		СтруктураДопПолей = Новый Структура("Менеджер");

		ЗаполнитьЗначенияСвойств(СтруктураДопПолей, ВыборкаЗначений);
		
		СтруктураРезультата.Вставить("fields", СтруктураДопПолей);
		
		//Товары
		СтрокиТоваровИнтереса = ТаблицаТоваров.НайтиСтроки(Новый Структура("Заказ", ВыборкаЗначений.Заказ));

		СуммаТоваров  = 0;
		МассивТоваров = Новый Массив;	
		
		Для Каждого СтрокаТовара Из СтрокиТоваровИнтереса Цикл
			
			СтруктураТовара = Новый Структура("id, name, brand");
			
			ЗаполнитьЗначенияСвойств(СтруктураТовара, СтрокаТовара);
			
			СтруктураТовара.id = XMLСтрока(СтрокаТовара.Номенклатура);
			
			СуммаПоСтроке = СтрокаТовара.СуммаСНДС;
			
			Если ТипЗнч(КоэффициентПересчетаВВалютуВзаиморасчетов) = Тип("Число") Тогда
				
				СуммаПоСтроке = СуммаПоСтроке * КоэффициентПересчетаВВалютуВзаиморасчетов;
				
			КонецЕсли;

			СуммаТоваров = СуммаТоваров + СуммаПоСтроке;
			
			СтруктураТовара.Вставить("quantity", СтрокаТовара.Количество);
			СтруктураТовара.Вставить("price",    ?(СтрокаТовара.Количество <> 0, 
													   СуммаПоСтроке / СтрокаТовара.Количество, 0));
			
			//category
			ПолноеНаименованиеНоменклатуры = СтрокаТовара.Номенклатура.ПолноеНаименование();
			ПутьКНоменклатуре = СтрЗаменить(ПолноеНаименованиеНоменклатуры, "/" + СтрокаТовара.name, ""); 
			
			ПутьМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ПутьКНоменклатуре, "/");
			
			СтруктураКатегории = Новый Структура; 
			
			НомерУровня = 1;
			
			Пока НомерУровня <= ПутьМассив.Количество() И НомерУровня <= 5 Цикл
				
				Уровень = ПутьМассив[НомерУровня - 1];
				
				СтруктураКатегории.Вставить("level" + Строка(НомерУровня), Уровень);
				
				НомерУровня = НомерУровня + 1;
			   
			КонецЦикла;   
			
			СтруктураТовара.Вставить("category", СтруктураКатегории);
			
			МассивТоваров.Добавить(СтруктураТовара);
			
