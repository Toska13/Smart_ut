Функция ПрочитатьСессиюИзРегистра()
	
	Результат = Новый Структура("ИдентификаторСессии, ДействуетДо", "", '00010101');
	
	ЗаписьСессии = РегистрыСведений.смартДЛ_Сессии.СоздатьМенеджерЗаписи();
	ЗаписьСессии.Ключ = КлючХраненияСессииДЛ();
	ЗаписьСессии.Прочитать();
	
	Если ЗаписьСессии.Выбран() Тогда
		
		Результат.ИдентификаторСессии = ЗаписьСессии.ИдентификаторСессии;
		Результат.ДействуетДо = ЗаписьСессии.ДействуетДо;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

