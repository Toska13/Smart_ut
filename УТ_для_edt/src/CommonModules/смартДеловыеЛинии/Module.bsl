Процедура ПроверитьНеобходимостьОбновленияСправочников()
	
	СправочникиСТипомЗагрузки = ПолучитьСтруктуруЗагружаемыхСправочниктов();
	
	Для Каждого Справочник Из СправочникиСТипомЗагрузки Цикл		
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("appkey", AppKey()); 
		
		Если Справочник.Ключ = "ДЛ_Контрагенты" Тогда
			
			СтруктураПараметров.Вставить("sessionID", ПараметрыСеанса.смартДЛ_ИДСессии); 
			
		КонецЕсли;			
		
		РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("Справочник." + Справочник.Ключ), СтруктураПараметров);
		
		Если РезультатЗапроса.КодСтатуса = 200 Тогда
			
			СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);		
			
			Хеш = ?(Справочник.Значение = "json", Строка(НачалоДня(ТекущаяДата())), СтруктураОтвета["hash"]);
			ТекущийХеш = РегистрыСведений.смартДЛ_ХешиСправочников.ПолучитьХеш(Справочник.Ключ);
			
			Если Хеш <> ТекущийХеш Тогда 
				
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(Справочник);
				МассивПараметров.Добавить(СтруктураОтвета);
				
				ИмяФункции = ?(Справочник.Значение = "json", "ОбновитьЗначенияСправочникаИзJSON", "ОбновитьСправочник");
			
				ФоновыеЗадания.Выполнить("смартДеловыеЛинии." + ИмяФункции, МассивПараметров);	
				//Выполнить(ИмяФункции + "(Справочник, СтруктураОтвета);");
				
			КонецЕсли; 	
			
		Иначе
			
			//Обработка ошибок
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтруктуруЗагружаемыхСправочниктов()
	
	Результат = Новый Структура;	                
	Результат.Вставить("смартДЛ_Города", "csv");
	Результат.Вставить("ДЛ_Контрагенты", "json");		
	Результат.Вставить("смартДЛ_ХарактерГруза", "csv");
	Результат.Вставить("смартДЛ_ДополнительныеУслуги", "csv");
	Результат.Вставить("смартДЛ_ДокументыДляПолучения", "csv");    
	Результат.Вставить("смартДЛ_ПараметрыДляОтчета", "csv");   
	Результат.Вставить("смартДЛ_ВидыЗагрузки", "json");
	Результат.Вставить("смартДЛ_СпециальныеТребования", "json"); 
	Результат.Вставить("смартДЛ_ВидыУпаковок", "json");
	Результат.Вставить("смартДЛ_СтатусыЗаказа", "json");	  
	Результат.Вставить("СтраныМира", "json"); 
	Результат.Вставить("смартДЛ_ОПФ", "json");
	Результат.Вставить("смартДЛ_ПараметрыНГГ", "json"); 
	Результат.Вставить("ДЛ_Терминалы_Города", "json_file");
	
	Возврат Результат; 	
	
КонецФункции 

Процедура ОбновитьЗначенияСправочникаИзJSON(СправочникСТипомЗагрузки, СтруктураПараметров, СвязьСВышестоящим = Неопределено) Экспорт	 
	
	ИмяСправочника = ?(СправочникСТипомЗагрузки.Ключ = "ДЛ_Терминалы_Города", "смартДЛ_Города", СправочникСТипомЗагрузки.Ключ);
	ИмяСправочника = ?(СправочникСТипомЗагрузки.Ключ = "ДЛ_Контрагенты", "Контрагенты", СправочникСТипомЗагрузки.Ключ);
	
	МассивПоляПоиска = Справочники[ИмяСправочника].ПолучитьМассивПоляПоиска(); 
	ТаблицаПолейЗначений = Справочники[ИмяСправочника].ПолучитьТаблицуПолейЗначений();  
	
	Если ИмяСправочника = "Контрагенты" Тогда
		
		КоллекцияПараметров = СтруктураПараметров["data"]["counteragents"]; 
		
	Иначе
		
	    КоллекцияПараметров = СтруктураПараметров["data"];    
		
	КонецЕсли;
	
	Для Каждого СтруктураДанных Из КоллекцияПараметров Цикл		 
		
		ЭлементВБазе = Справочники[ИмяСправочника].НайтиПоРеквизиту(МассивПоляПоиска[1], СтруктураДанных[МассивПоляПоиска[0]]);		
		
		Если ЗначениеЗаполнено(ЭлементВБазе) Тогда 
			
			ТребуетсяОбновитьЭлемент = Ложь;
			
			Для Каждого ПолеЗначения Из ТаблицаПолейЗначений Цикл
				
				Если ПолеЗначения.ТипСопоставления = "Реквизит" Тогда	
					
					Если ЭлементВБазе[ПолеЗначения.ИмяРеквизита] = СтруктураДанных[ПолеЗначения.Поле] Тогда 
						
						ТребуетсяОбновитьЭлемент = Истина;						
						Прервать;
						
					КонецЕсли;  
					
				ИначеЕсли ПолеЗначения.ТипСопоставления = "ТабличнаяЧасть" Или ПолеЗначения.ТипСопоставления = "Справочник" Тогда  
					
					//Подумать о доработке сравнения наборов данных в табличных частях. Пока на всякий пожарный перегружаем каждый раз.	
					ТребуетсяОбновитьЭлемент = Истина;						
					Прервать; 					
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ТребуетсяОбновитьЭлемент Тогда
				
				ОбъектВБазе = ЭлементВБазе.ПолучитьОбъект(); 
				
				Если СвязьСВышестоящим <> Неопределено Тогда
					
					ОбъектВБазе[СвязьСВышестоящим[0]] = СвязьСВышестоящим[1];
					
				КонецЕсли;
				
				ДозаполнитьОбъектРеквизитамиJSON(ОбъектВБазе, СтруктураДанных, ТаблицаПолейЗначений); 				
				
			КонецЕсли;
			
		Иначе
			
			НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
			НовыйЭлемент[МассивПоляПоиска[1]] = СтруктураДанных[МассивПоляПоиска[0]];	
			
			Если СвязьСВышестоящим <> Неопределено Тогда
					
				НовыйЭлемент[СвязьСВышестоящим[0]] = СвязьСВышестоящим[1];
					
			КонецЕсли;
			
			ДозаполнитьОбъектРеквизитамиJSON(НовыйЭлемент, СтруктураДанных, ТаблицаПолейЗначений); 			
			
		КонецЕсли;
		
	КонецЦикла;  
	
	ЗаписьХеша = РегистрыСведений.смартДЛ_ХешиСправочников.СоздатьМенеджерЗаписи();
	ЗаписьХеша.ИмяСправочника = СправочникСТипомЗагрузки.Ключ;
	ЗаписьХеша.Хеш = Строка(НачалоДня(ТекущаяДата()));
	ЗаписьХеша.Записать(Истина);
	
КонецПроцедуры

Процедура ДозаполнитьОбъектРеквизитамиJSON(ОбъектСправочника, СтруктураДанных, ТаблицаПолейЗначений)
	
	Для Каждого ПолеЗначения Из ТаблицаПолейЗначений Цикл 
		
		Если ПолеЗначения.ТипСопоставления = "Реквизит" Тогда
			
			ОбъектСправочника[ПолеЗначения.ИмяРеквизита] = СтруктураДанных[ПолеЗначения.Поле];	
			
		ИначеЕсли ПолеЗначения.ТипСопоставления = "ТабличнаяЧасть" Тогда
			
			ОбъектСправочника[ПолеЗначения.ИмяРеквизита].Очистить();	
			
			Для Каждого СтрокаДанных Из СтруктураДанных[ПолеЗначения.Поле] Цикл
				
				СтрокаТабличнойЧасти = ОбъектСправочника[ПолеЗначения.ИмяРеквизита].Добавить();
				
				Для Каждого ПолеСтруктурыСтроки Из ПолеЗначения.Дополнительно Цикл
					
					Если ПолеСтруктурыСтроки.Значение = Неопределено Тогда
						
						СтрокаТабличнойЧасти[ПолеСтруктурыСтроки.Ключ] = СтрокаДанных;
						
					Иначе
						
						СтрокаТабличнойЧасти[ПолеСтруктурыСтроки.Ключ] = СтрокаДанных[ПолеСтруктурыСтроки.Значение];	
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		ИначеЕсли ПолеЗначения.ТипСопоставления = "Справочник" Тогда
			
			Если ЗначениеЗаполнено(ПолеЗначения.ИмяРеквизита) Тогда 
				
				СтруктураДанныхНовогоСправочника = СтруктураДанных[ПолеЗначения.Поле][ПолеЗначения.ИмяРеквизита];
				
			Иначе    
				
				СтруктураДанныхНовогоСправочника = СтруктураДанных[ПолеЗначения.Поле];
				
			КонецЕсли;  
			
			СправочникиСТипомЗагрузки = Новый Структура(ПолеЗначения.Дополнительно);
			
			Если ЗначениеЗаполнено(ОбъектСправочника.Ссылка) Тогда
				
				СсылкаНаОбъект = ОбъектСправочника.Ссылка;
				
			Иначе 
				
				СсылкаНаОбъект = Справочники[ОбъектСправочника.Метаданные().Имя].ПолучитьСсылку();				
				ОбъектСправочника.УстановитьСсылкуНового(СсылкаНаОбъект);	
				
			КонецЕсли;  
			
			Для Каждого СправочникСТипомЗагрузки Из СправочникиСТипомЗагрузки Цикл
			
				ОбновитьЗначенияСправочникаИзJSON(СправочникСТипомЗагрузки, Новый Структура("data", СтруктураДанныхНовогоСправочника), МассивДвухЭлементов("Город", СсылкаНаОбъект));
				
			КонецЦикла;	
			
		ИначеЕсли ПолеЗначения.ТипСопоставления = "ВложенныеРеквизиты" Тогда
			
			Для Каждого ВложенныйРеквизит Из ПолеЗначения.Дополнительно Цикл
				
				Если ТипЗнч(ВложенныйРеквизит.Значение) = Тип("Массив") Тогда
					
					Если ВложенныйРеквизит.Значение[0] = "ТабличнаяЧасть" Тогда
						
						ОбъектСправочника[ВложенныйРеквизит.Значение[1]].Очистить();
						
						Для Каждого СтрокаДанных Из СтруктураДанных[ПолеЗначения.Поле][ВложенныйРеквизит.Ключ] Цикл
							
							СтрокаТабличнойЧасти = ОбъектСправочника[ВложенныйРеквизит.Значение[1]].Добавить();
							
							Для Каждого ПолеСтруктурыСтроки Из ВложенныйРеквизит.Значение[2] Цикл
								
								Если ПолеСтруктурыСтроки.Значение = Неопределено Тогда
									
									СтрокаТабличнойЧасти[ПолеСтруктурыСтроки.Ключ] = СтрокаДанных;
									
								Иначе
									
									СтрокаТабличнойЧасти[ПолеСтруктурыСтроки.Ключ] = СтрокаДанных[ПолеСтруктурыСтроки.Значение];	
									
								КонецЕсли;
								
							КонецЦикла;
							
						КонецЦикла;
						
					КонецЕсли;					
					
				Иначе
					
					Если ТипЗнч(СтруктураДанных[ПолеЗначения.Поле]) = Тип("Соответствие") Тогда
					
						ОбъектСправочника[ВложенныйРеквизит.Значение] = СтруктураДанных[ПолеЗначения.Поле][ВложенныйРеквизит.Ключ];						
						
					КонецЕсли;	
					
				КонецЕсли;	
				
			КонецЦикла;			
			
		КонецЕсли;
		
	КонецЦикла;			
	
	ОбъектСправочника.Записать();	
	
КонецПроцедуры

Процедура ОбновитьСправочник(СправочникСТипомЗагрузки, СтруктураПараметров) Экспорт  
	
	РезультатЗапроса = ДЛ_ПолучитьФайл(СтруктураПараметров["url"]);
	
	Если РезультатЗапроса.КодСтатуса = 200 Тогда							
		
		Если СправочникСТипомЗагрузки.Значение = "csv" Тогда
			
			ОбновитьЗначенияСправочникаИзCSV(СправочникСТипомЗагрузки.Ключ, РезультатЗапроса.Файл);			 
			
		ИначеЕсли СправочникСТипомЗагрузки.Значение = "json_file" Тогда
			
			ОбновитьЗначенияСправочникаИзФайлаJSON(СправочникСТипомЗагрузки, РезультатЗапроса.Файл);
			
		КонецЕсли;
		
		ЗаписьХеша = РегистрыСведений.смартДЛ_ХешиСправочников.СоздатьМенеджерЗаписи();
		ЗаписьХеша.ИмяСправочника = СправочникСТипомЗагрузки.Ключ;
		ЗаписьХеша.Хеш = СтруктураПараметров["hash"];
		ЗаписьХеша.Записать(Истина);
		
	КонецЕсли;		
	
КонецПроцедуры 

Процедура ОбновитьЗначенияСправочникаИзФайлаJSON(СправочникСТипомЗагрузки, ДвоичныеДанные)	 
	
	СтруктураДанных = ДесериализоватьСтруктуруПараметров(ДвоичныеДанные, Истина); 
	
	Для Каждого МассивДанных Из СтруктураДанных Цикл
	
		ОбновитьЗначенияСправочникаИзJSON(СправочникСТипомЗагрузки, Новый Структура("data", МассивДанных.Значение));
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьЗначенияСправочникаИзCSV(ИмяСправочника, ДвоичныеДанные) Экспорт 
	
	ОчищатьОтсутсвующиеВЗагрузке = Ложь;
	
	Если ИмяСправочника = "смартДЛ_Города" Тогда
		
		ГородаУдалитьДублиИПустыеКЛАДР();
		
	ИначеЕсли ИмяСправочника = "смартДЛ_ХарактерГруза" Тогда	 
		
		ОчищатьОтсутсвующиеВЗагрузке = Истина; 
		
		МассивЗагруженыхИД = Новый Массив;
		
	КонецЕсли;
	
	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные, "UTF-8");
	
	СтрокаЗаголовков = СтрЗаменить(ЧтениеДанных.ПрочитатьСтроку(), """", "");
	СтрокаДанных = ЧтениеДанных.ПрочитатьСтроку();    
	
	МассивПоляПоиска = Справочники[ИмяСправочника].ПолучитьМассивПоляПоиска(); 
	СтруктураПолейЗначений = Справочники[ИмяСправочника].ПолучитьСтруктуруПолейЗначений();  	
	
	Пока Не ЧтениеДанных.ЧтениеЗавершено Цикл		
		
		СтруктураДанных = Вычислить("Новый Структура(СтрокаЗаголовков, " + СтрокаДанных + ")");  
		
		Если ОчищатьОтсутсвующиеВЗагрузке Тогда
			
			МассивЗагруженыхИД.Добавить(СтруктураДанных[МассивПоляПоиска[0]]);				
			
		КонецЕсли;
		
		ЭлементВБазе = Справочники[ИмяСправочника].НайтиПоРеквизиту(МассивПоляПоиска[1], СтруктураДанных[МассивПоляПоиска[0]]);
		
		Если ЗначениеЗаполнено(ЭлементВБазе) Тогда 
			
			ТребуетсяОбновитьЭлемент = Ложь;
			
			Для Каждого ПолеЗначения Из СтруктураПолейЗначений Цикл
				
				Если ЭлементВБазе[ПолеЗначения.Значение] <> СтруктураДанных[ПолеЗначения.Ключ] Тогда 
					
					ТребуетсяОбновитьЭлемент = Истина;
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ТребуетсяОбновитьЭлемент Тогда
				
				ОбъектВБазе = ЭлементВБазе.ПолучитьОбъект(); 			
				ДозаполнитьОбъектРеквизитамиCSV(ОбъектВБазе, СтруктураДанных, СтруктураПолейЗначений);					
				
			КонецЕсли;
			
		Иначе
			
			НовыйЭлемент = Справочники[ИмяСправочника].СоздатьЭлемент();
			НовыйЭлемент[МассивПоляПоиска[1]] = СтруктураДанных[МассивПоляПоиска[0]];			
			ДозаполнитьОбъектРеквизитамиCSV(НовыйЭлемент, СтруктураДанных, СтруктураПолейЗначений);
			
		КонецЕсли;
		
		СтрокаДанных = ЧтениеДанных.ПрочитатьСтроку();
		
	КонецЦикла;	 
	
	Если ОчищатьОтсутсвующиеВЗагрузке Тогда
		
		ОчиститьОтсутсвующиеВЗагрузкеЭлементы(ИмяСправочника, МассивПоляПоиска[1], МассивЗагруженыхИД);
		
	КонецЕсли; 
	
КонецПроцедуры  

Процедура ДозаполнитьОбъектРеквизитамиCSV(ОбъектСправочника, СтруктураДанных, СтруктураПолейЗначений)
	
	Для Каждого ПолеЗначения Из СтруктураПолейЗначений Цикл
		
		ОбъектСправочника[ПолеЗначения.Значение] = СтруктураДанных[ПолеЗначения.Ключ];	
		
	КонецЦикла; 
	
	ОбъектСправочника.Записать();	
	
КонецПроцедуры
	
