КонецПроцедуры

Функция ОтветАвторизацииДЛУспешен(РезультатЗапроса, СтруктураОтвета = Неопределено)
	
	Если РезультатЗапроса.КодСтатуса <> 200 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СтруктураОтвета = Неопределено И ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);
		
	КонецЕсли;
	
	Если СтруктураОтвета = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Метаданные = СтруктураОтвета.Получить("metadata");
	
	Если Метаданные = Неопределено Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	СтатусAPI = Метаданные.Получить("status");
	
	Если СтатусAPI <> Неопределено И СтатусAPI <> 200 Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ЗаписатьОшибкуАвторизацииДЛ(РезультатЗапроса, ТекстОшибки = "")
	
	КодHTTP = РезультатЗапроса.КодСтатуса;
	СтатусAPI = "?";
	СообщениеAPI = ТекстОшибки;
	
	Если ПустаяСтрока(СообщениеAPI) И ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		
		Попытка
			
			СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);
			Метаданные = СтруктураОтвета.Получить("metadata");
			
			Если Метаданные <> Неопределено Тогда
				
				СтатусОтвета = Метаданные.Получить("status");
				
				Если СтатусОтвета <> Неопределено Тогда
					
					СтатусAPI = Формат(СтатусОтвета, "ЧГ=0");
					
				КонецЕсли;
				
				СообщениеAPI = Метаданные.Получить("detail");
				
				Если СообщениеAPI = Неопределено Тогда
					
					СообщениеAPI = Метаданные.Получить("message");
					
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			СообщениеAPI = "";
			
		КонецПопытки;
		
	КонецЕсли;
	
	Если СообщениеAPI = Неопределено Тогда
		
		СообщениеAPI = "";
		
	КонецЕсли;
	
	Комментарий = СтрШаблон(
		НСтр("ru = 'HTTP %1, статус API %2. %3'"),
		КодHTTP,
		СтатусAPI,
		СообщениеAPI);
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'Деловые линии.Авторизация'"),
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		Комментарий);
	
КонецПроцедуры

Функция ТекстИсключенияАвторизацииДЛ(РезультатЗапроса)
	
	ТекстОшибки = "";
	
	Если ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		
		Попытка
			
			СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);
			Метаданные = СтруктураОтвета.Получить("metadata");
			
			Если Метаданные <> Неопределено Тогда
				
				ТекстОшибки = Метаданные.Получить("detail");
				
				Если ТекстОшибки = Неопределено Тогда
					
					ТекстОшибки = Метаданные.Получить("message");
					
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = "";
			
		КонецПопытки;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось авторизоваться в API Деловых Линий.'");
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция SessionID() Экспорт 
	
	Сейчас = ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(ПараметрыСеанса.смартДЛ_ИДСессии)
		И Сейчас < ПараметрыСеанса.смартДЛ_СрокДействияСессии Тогда
		
		Возврат ПараметрыСеанса.смартДЛ_ИДСессии;
		
	КонецЕсли;
	
	ДанныеСессии = ПрочитатьСессиюИзРегистра();
	
	Если ЗначениеЗаполнено(ДанныеСессии.ИдентификаторСессии)
		И Сейчас < ДанныеСессии.ДействуетДо Тогда
		
		УстановитьСессиюВПараметрыСеанса(ДанныеСессии.ИдентификаторСессии, ДанныеСессии.ДействуетДо);
		Возврат ДанныеСессии.ИдентификаторСессии;
		
	КонецЕсли;
	
	Результат = ПолучитьИДСессии();
	
	ПроверитьНеобходимостьОбновленияСправочников();
	ФоновыеЗадания.Выполнить("смартДеловыеЛинии.ПодрезатьРегистрЛогов");
	ФоновыеЗадания.Выполнить("смартДеловыеЛинии.ПодрезатьРегистрАдреснойКниги");
	
	Возврат Результат;
	
КонецФункции    

Функция СериализоватьСтруктуруПараметров(СтруктураПараметров) Экспорт 
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(ЗаписьJSON, СтруктураПараметров);
	
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции    

Функция ДесериализоватьСтруктуруПараметров(Тело, ЭтоДвоичныеДанные = Ложь) Экспорт 
	
	ЧтениеJSON = Новый ЧтениеJSON;
	
	Если ЭтоДвоичныеДанные Тогда
		
		ЧтениеJSON.ОткрытьПоток(Тело.ОткрытьПотокДляЧтения());
		
	Иначе
		
		ЧтениеJSON.УстановитьСтроку(Тело);
		
	КонецЕсли;	
	
	Возврат ПрочитатьJSON(ЧтениеJSON, Истина);
	
КонецФункции

Функция СтруктураИнтернетАдреса(Знач ИнтернетАдрес)
	
	ИнтернетАдрес        = СокрЛП(ИнтернетАдрес);
	ПараметрыАвторизации = "";
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Протокол",     "");
	СтруктураДанных.Вставить("ИмяСервера",   "");
	СтруктураДанных.Вставить("Хост",         "");
	СтруктураДанных.Вставить("Порт", 	     "");
	СтруктураДанных.Вставить("Логин",        "");
	СтруктураДанных.Вставить("Пароль",       "");
	СтруктураДанных.Вставить("АдресРесурса", "");
	
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "://", "Второе", СтруктураДанных.Протокол, ИнтернетАдрес);                // выделяем протокол из адреса
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "/",   "Первое", ИнтернетАдрес, СтруктураДанных.АдресРесурса);            // выделяем адрес ресурса на сервере
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "@",   "Второе", ПараметрыАвторизации, СтруктураДанных.ИмяСервера);       // выделяем имя сервера и параметры авторизации
	РазложитьСтрокуПоРазделителю(ПараметрыАвторизации, ":", "Первое",  СтруктураДанных.Логин, СтруктураДанных.Пароль);    // раскладываем параметры авторизации на поля
	РазложитьСтрокуПоРазделителю(СтруктураДанных.ИмяСервера, ":", "Первое", СтруктураДанных.Хост, СтруктураДанных.Порт);  // раскладываем имя сервера на поля
	
	Если ЗначениеЗаполнено(СтруктураДанных.Порт) Тогда
		
		СтруктураДанных.Порт = Число(СтруктураДанных.Порт);
		
	Иначе
		
		СтруктураДанных.Порт = Неопределено;
		
	КонецЕсли; 
	
	Возврат СтруктураДанных;
	
КонецФункции  

Процедура РазложитьСтрокуПоРазделителю(Знач ИсходнаяСтрока, Разделитель, ЗаполнятьБезРазделителя = "", ПервоеПоле, ВтороеПоле)
	
	СмещениеВПраво     = СтрДлина(Разделитель);
	ПозицияРазделителя = СтрНайти(ИсходнаяСтрока, Разделитель);
	
	Если ПозицияРазделителя > 0 Тогда
		
		ПервоеПоле = Лев(ИсходнаяСтрока,  ПозицияРазделителя - 1);
		ВтороеПоле = Сред(ИсходнаяСтрока, ПозицияРазделителя + СмещениеВПраво);
		
	ИначеЕсли ЗаполнятьБезРазделителя = "Первое" Тогда
		
		ПервоеПоле = ИсходнаяСтрока;
		
	ИначеЕсли ЗаполнятьБезРазделителя = "Второе" Тогда
		
		ВтороеПоле = ИсходнаяСтрока;
		
	КонецЕсли; 
	
КонецПроцедуры

Функция ПолучитьИДСессии() Экспорт
	
	СтруктураПараметров = СтруктураЗапросаПоКлючуПриложения();
	СтруктураПараметров.Вставить("login", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_Логин"));
	СтруктураПараметров.Вставить("password", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_Пароль"));
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("Авторизация"), СтруктураПараметров);
	СтруктураОтвета = Неопределено;
	
	Если ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);
		
	КонецЕсли;
	
	Если Не ОтветАвторизацииДЛУспешен(РезультатЗапроса, СтруктураОтвета) Тогда
		
		ЗаписатьОшибкуАвторизацииДЛ(РезультатЗапроса);
		ВызватьИсключение ТекстИсключенияАвторизацииДЛ(РезультатЗапроса);
		
	КонецЕсли;
	
	ИдентификаторСессии = "";
	ДанныеОтвета = СтруктураОтвета.Получить("data");
	
	Если ДанныеОтвета <> Неопределено Тогда
		
		ИдентификаторСессии = ДанныеОтвета.Получить("sessionID");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторСессии) Тогда
		
		ЗаписатьОшибкуАвторизацииДЛ(РезультатЗапроса, НСтр("ru = 'В ответе авторизации отсутствует sessionID.'"));
		ВызватьИсключение НСтр("ru = 'В ответе авторизации API Деловых Линий отсутствует идентификатор сессии.'");
		
	КонецЕсли;
	
	СтруктураПараметров = СтруктураЗапросаПоКлючуПриложения();
	СтруктураПараметров.Вставить("sessionID", ИдентификаторСессии);
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("ИнформацияОСессии"), СтруктураПараметров);
	СтруктураОтветаИнфо = Неопределено;
	
	Если ЗначениеЗаполнено(РезультатЗапроса.Тело) Тогда
		
		СтруктураОтветаИнфо = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело);
		
	КонецЕсли;
	
	Если ОтветАвторизацииДЛУспешен(РезультатЗапроса, СтруктураОтветаИнфо) Тогда
		
		ДанныеСессии = СтруктураОтветаИнфо.Получить("data");
		
		Если ДанныеСессии <> Неопределено Тогда
			
			Сессия = ДанныеСессии.Получить("session");
			
			Если Сессия <> Неопределено Тогда
				
				СрокДействияСтрокой = Сессия.Получить("expireTime");
				
				Если ЗначениеЗаполнено(СрокДействияСтрокой) Тогда
					
					СрокДействия = ПреобразоватьВДату(СрокДействияСтрокой);
					
				Иначе
					
					СрокДействия = ТекущаяДатаСеанса() + 24 * 60 * 60;
					
				КонецЕсли;
				
			Иначе
				
				СрокДействия = ТекущаяДатаСеанса() + 24 * 60 * 60;
				
			КонецЕсли;
			
		Иначе
			
			СрокДействия = ТекущаяДатаСеанса() + 24 * 60 * 60;
			
		КонецЕсли;
		
	Иначе
		
		СрокДействия = ТекущаяДатаСеанса() + 24 * 60 * 60;
		
	КонецЕсли;
	
	УстановитьСессиюВПараметрыСеанса(ИдентификаторСессии, СрокДействия);
	ЗаписатьСессиюВРегистр(ИдентификаторСессии, СрокДействия);
	
	Возврат ИдентификаторСессии;
	
КонецФункции

Функция ПреобразоватьВДату(Знач ДатаСтрокой) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаСтрокой) Тогда
		
		Возврат Дата("00010101");
		
	КонецЕсли;
	
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, "-", "");			
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, ":", "");
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, " ", "");
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, "T", "");
	
	Возврат Дата(ДатаСтрокой);
	
КонецФункции

Функция AppKey() Экспорт
	
	Возврат смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_appkey");
	
КонецФункции 

Процедура ВывестиСообщениеПользователю(Текст, Поле = Неопределено, Интерактивно = Истина, ПараметрОтказ = Неопределено) Экспорт
	
	Если Интерактивно Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СокрЛП(Текст);
		
		Если ЗначениеЗаполнено(Поле) Тогда
			
			Сообщение.Поле = Поле;
			
		КонецЕсли;
		
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	ПараметрОтказ = Истина;
	
КонецПроцедуры

