Функция ВыполнитьPOSTЗапрос(АдресМетода, СтруктураПараметров) Экспорт
	
	ЛогированиеВключено = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_ДнейХраненияЛогов") > 0; 
	СериализованныеПараметры = СериализоватьСтруктуруПараметров(СтруктураПараметров); 
	 
	ПараметрыПодключения = ПолучитьПараметрыПодключения(); 
	
	Соединение = Новый HTTPСоединение(ПараметрыПодключения.Сервер,,,, НовыйИнтернетПрокси(ПараметрыПодключения.Прокси), ПараметрыПодключения.Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("Content-type", "application/json; charset=utf-8");	
	
	Запрос = Новый HTTPЗапрос(АдресМетода, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СериализованныеПараметры, "UTF-8"); 
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Ответ  = Соединение.ОтправитьДляОбработки(Запрос); 
	
	ВремяОкончания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КодСтатуса", Ответ.КодСостояния);
	СтруктураДанных.Вставить("Тело",       Ответ.ПолучитьТелоКакСтроку()); 
	
	Если ЛогированиеВключено Тогда   
		
		ЛогироватьЗапрос(АдресМетода, СтруктураПараметров, СтруктураДанных.Тело, ВремяОкончания - ВремяНачала);
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции 

Процедура ЛогироватьЗапрос(Метод, Знач Отправлено, Получено, ВремяВыполнения)
	
	ЗаписьПолучено = ?(Метод = "v2/mutual_calculations.json", "***", Получено);
	
	Если Отправлено.Свойство("password") Тогда
		
		Отправлено["password"] = "***";	
		
	КонецЕсли;
	
	Если Метод = "v3/auth/login.json" Тогда
		
		Если Отправлено.Свойство("appKey") Тогда
			
			Отправлено["appKey"] = "***";
			
		КонецЕсли;
		
		Если Отправлено.Свойство("login") Тогда
			
			Отправлено["login"] = "***";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отправлено.Свойство("sessionID") Тогда
		
		Отправлено["sessionID"] = "***";	
		
	КонецЕсли; 
	
	Если Метод = "v3/auth/login.json" Тогда
		
		Если СтрНайти(Получено, "sessionID") > 0  Тогда
			
			ЗаписьПолучено = "Успешно";	
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЛогЗапросов = РегистрыСведений.смартДЛ_ЛогЗапросов.СоздатьМенеджерЗаписи();
	ЛогЗапросов.Метод = Метод;
	ЛогЗапросов.Дата = ТекущаяДатаСеанса();
	ЛогЗапросов.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	ЛогЗапросов.Отправлено = СериализоватьСтруктуруПараметров(Отправлено);
	ЛогЗапросов.Получено = ЗаписьПолучено;
	ЛогЗапросов.ВремяВыполнения = ВремяВыполнения; 
	ЛогЗапросов.НазваниеМетода = ПолучитьНазваниеМетода(Метод);
	ЛогЗапросов.Записать(Истина);
	
КонецПроцедуры

