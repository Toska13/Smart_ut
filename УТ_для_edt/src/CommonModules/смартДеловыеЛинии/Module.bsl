Процедура ГородаУдалитьДублиИПустыеКЛАДР()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_Города.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартДЛ_Города КАК ДЛ_Города
	|ГДЕ
	|	ДЛ_Города.КодКЛАДР = """"";   
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Город = Выборка.Ссылка.ПолучитьОбъект();
		Город.Удалить();
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_Города.КодКЛАДР КАК КодКЛАДР,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_КЛАДР_Количество
	|ИЗ
	|	Справочник.смартДЛ_Города КАК ДЛ_Города
	|ГДЕ
	|	ДЛ_Города.КодКЛАДР = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ДЛ_Города.КодКЛАДР
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КЛАДР_Количество.КодКЛАДР КАК КодКЛАДР
	|ПОМЕСТИТЬ ВТ_КЛАДР_Дубли
	|ИЗ
	|	ВТ_КЛАДР_Количество КАК ВТ_КЛАДР_Количество
	|ГДЕ
	|	ВТ_КЛАДР_Количество.Количество > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДЛ_Города.Ссылка КАК Ссылка,
	|	ДЛ_Города.КодКЛАДР КАК КодКЛАДР
	|ИЗ
	|	Справочник.смартДЛ_Города КАК ДЛ_Города
	|ГДЕ
	|	ДЛ_Города.КодКЛАДР В
	|			(ВЫБРАТЬ
	|				ВТ_КЛАДР_Дубли.КодКЛАДР
	|			ИЗ
	|				ВТ_КЛАДР_Дубли КАК ВТ_КЛАДР_Дубли)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛ_Города.КодКЛАДР,
	|	ДЛ_Города.ИДгорода УБЫВ"; 
	
	ТекущийКЛАДР = "";
	ЭтоПервый = Ложь;
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл 
		
		Если ТекущийКЛАДР <> Выборка.КодКЛАДР Тогда
			
			ТекущийКЛАДР = Выборка.КодКЛАДР;
			ЭтоПервый = Истина;	
			
		КонецЕсли; 
		
		Если ЭтоПервый Тогда 
			
			ЭтоПервый = Ложь;	
			
		Иначе	
		
			Город = Выборка.Ссылка.ПолучитьОбъект();
			Город.Удалить(); 		
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

