Процедура ПодрезатьРегистрЛогов() Экспорт  
	
	ДатаПодрезки = НачалоДня(ТекущаяДатаСеанса()) - 24 * 60 * 60 * смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_ДнейХраненияЛогов");
	
	ЛогЗапросов = РегистрыСведений.смартДЛ_ЛогЗапросов.СоздатьНаборЗаписей();
	ЛогЗапросов.Прочитать(); 
	
	ТЗ = ЛогЗапросов.Выгрузить();
	
	Счетчик  = 0;
	
	Пока Счетчик < ТЗ.Количество() Цикл 
		
		СтрокаТЗ = ТЗ[Счетчик];	
		
		Если СтрокаТЗ.Дата < ДатаПодрезки  Тогда  
			
			ТЗ.Удалить(СтрокаТЗ);
			
		Иначе     
			
			Счетчик = Счетчик + 1;	
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ЛогЗапросов.Количество() <> ТЗ.Количество() Тогда
		
		ЛогЗапросов.Загрузить(ТЗ);
		ЛогЗапросов.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПрочитатьДанныеГрафикаПеревозки(ДанныеГрафика, ДнейДоставкаДоПолучателя = -1, ДанныеГрафикаАвиа = Неопределено) Экспорт
	
	СписокДанных  = Новый СписокЗначений;	 	 
	
	Если ДанныеГрафика <> Неопределено Тогда
		
		ОписаниеДанных = ПолучитьОписаниеДанныхГрафикаПеревозки();
		
		ЗаполнитьСписокДанныхГрафикаПеревозки(СписокДанных, ДанныеГрафика, ОписаниеДанных);  		
		
	КонецЕсли; 
	
	Если ДанныеГрафикаАвиа <> Неопределено Тогда
		
		ОписаниеДанных = ПолучитьОписаниеДанныхГрафикаПеревозкиАвиа();
		
		ЗаполнитьСписокДанныхГрафикаПеревозки(СписокДанных, ДанныеГрафикаАвиа, ОписаниеДанных);  		
		
	КонецЕсли;	
	
	КоличествоЗаписей = СписокДанных.Количество();
	
	Если КоличествоЗаписей > 0 И ДнейДоставкаДоПолучателя >= 0 Тогда   
		
		ПоследняяЗапись = СписокДанных.Получить(КоличествоЗаписей - 1);  
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Значение",      ПоследняяЗапись.Значение.Значение + ДнейДоставкаДоПолучателя * 24 * 60 * 60);
		СтруктураДанных.Вставить("Представление", "Доставка до адреса получателя");
		
		СписокДанных.Добавить(СтруктураДанных, 8);
		
	КонецЕсли; 
	
	СписокДанных.СортироватьПоПредставлению();
	
	Возврат СписокДанных.ВыгрузитьЗначения();
	
КонецФункции  

