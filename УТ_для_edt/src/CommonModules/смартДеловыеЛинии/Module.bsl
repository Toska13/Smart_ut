Функция ДоступнаНоваяВерсия() Экспорт  
	
	Результат = Новый Структура;
	Результат.Вставить("НеОповещатьОВерсии", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_НеОповещатьОВерсии"));
	
	ПараметрыТекущейВерсии = ПолучитьПараметрыТекцущейВерсии();  
	
	Если ПараметрыТекущейВерсии.Свойство("Версия") Тогда
		
		ДДФайлаВерсий = ПолучитьДанныеОВерсияхИзФайла();
		
		Если ДДФайлаВерсий.КодСтатуса = 200 Тогда  
			
			Попытка
			
				СтруктураДанных = ДесериализоватьСтруктуруПараметров(ДДФайлаВерсий.Файл, Истина);	 
				
			Исключение 
				
				Возврат Результат;
				
			КонецПопытки;
			
			СтруктураДанныхКонфигурации = СтруктураДанных[ПараметрыТекущейВерсии.Идентификатор];
			ВерсияИзФайла = СтруктураДанныхКонфигурации["Version"];
			
			Если ВерсияИзФайла <> ПараметрыТекущейВерсии.Версия Тогда 									 
				
				Результат.Вставить("НоваяВерсия", ВерсияИзФайла);
				
				Если ЗначениеЗаполнено(СтруктураДанныхКонфигурации["Caption"]) Тогда
					
					Результат.Вставить("Описание", СтруктураДанныхКонфигурации["Caption"]);
					
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтруктураДанныхКонфигурации["Tasks"]) Тогда
					
					Результат.Вставить("МассивЗадач", СтруктураДанныхКонфигурации["Tasks"]);	
					
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтруктураДанныхКонфигурации["Url"]) Тогда
					
					Результат.Вставить("СсылкаНаФайл", СтруктураДанныхКонфигурации["Url"]);	
					
				КонецЕсли;											
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПереносШаблоновВРегистр()
	
	УстановитьПривилегированныйРежим(Истина); 	 
	
	КлючНастроек = "ШаблоныЗаказов";
	
	СписокШаблонов = ХранилищеОбщихНастроек.Загрузить(КлючОбъектаНастроек(), КлючНастроек);   	
	
	Если ТипЗнч(СписокШаблонов) = Тип("СписокЗначений") Тогда
		
		ТекущаяДата = ТекущаяДатаСеанса(); 
		ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
		Сч = 0;
		
		Для Каждого ШаблонНастроек Из СписокШаблонов Цикл			
			
			НовыйШаблон = РегистрыСведений.смартДЛ_Шаблоны.СоздатьМенеджерЗаписи();			
			НовыйШаблон.Автор = ТекущийПользователь;
			НовыйШаблон.ДатаСоздания = ТекущаяДата + Сч;
			НовыйШаблон.Наименование = ШаблонНастроек.Представление;
			НовыйШаблон.Данные        = Новый ХранилищеЗначения(ШаблонНастроек.Значение);  
			НовыйШаблон.ДатаИспользования = НовыйШаблон.ДатаСоздания;
			НовыйШаблон.Записать(Истина);
			
			Сч = Сч + 1;
			
		КонецЦикла;   
		
		ХранилищеОбщихНастроек.Удалить(КлючОбъектаНастроек(), КлючНастроек, ПользователиИнформационнойБазы.ТекущийПользователь().Имя);	
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеОВерсияхИзФайла()
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();
	
	Соединение = Новый HTTPСоединение("assets-rgw.dellin.ru",,,, НовыйИнтернетПрокси(ПараметрыПодключения.Прокси), ПараметрыПодключения.Таймаут, Новый ЗащищенноеСоединениеOpenSSL()); 	
	Запрос     = Новый HTTPЗапрос("integra-assets/uploads/1c_version_list.txt");
	//Запрос     = Новый HTTPЗапрос("integra-assets/uploads/1c_version_list_demo.txt");
	
	Ответ      = Соединение.Получить(Запрос);	
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КодСтатуса", Ответ.КодСостояния);
	СтруктураДанных.Вставить("Файл", Ответ.ПолучитьТелоКакДвоичныеДанные()); 	
	
	Возврат СтруктураДанных;
	
КонецФункции

