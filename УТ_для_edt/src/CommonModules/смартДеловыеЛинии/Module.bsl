Процедура ОчиститьОтсутсвующиеВЗагрузкеЭлементы(ИмяСправочника, ПолеПоиска, МассивЗагруженныхИД)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ИмяСправочника.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИмяСправочника КАК ИмяСправочника
	|ГДЕ
	|	НЕ ИмяСправочника.ПолеПоиска В (&МассивЗагруженныхИД)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИмяСправочника", ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ПолеПоиска", ПолеПоиска);
	Запрос.УстановитьПараметр("МассивЗагруженныхИД", МассивЗагруженныхИД);  
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементОбъект.Удалить();
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьОписаниеДанныхГрафикаПеревозкиАвиа() 
	
	ОписаниеДанныхГрафикаПеревозки = Новый Массив;		
	ОписаниеДанныхГрафикаПеревозки.Добавить(СтруктураОписанияГрафикаПеревозки("arrivalDate",      	"Фактическая дата прибытия груза при доставке авиатранспортом", 5.1));
	ОписаниеДанныхГрафикаПеревозки.Добавить(СтруктураОписанияГрафикаПеревозки("giveoutDate",      	"Дата выдачи груза при доставке авиатранспортом", 5.2));
	ОписаниеДанныхГрафикаПеревозки.Добавить(СтруктураОписанияГрафикаПеревозки("warehousingDate",	"Дата начала платного хранения при доставке авиатранспортом", 5.3));
	ОписаниеДанныхГрафикаПеревозки.Добавить(СтруктураОписанияГрафикаПеревозки("deliveryDate",     	"Ориентировочная дата прибытия груза при доставке авиатранспортом", 5.4));
		
	Возврат ОписаниеДанныхГрафикаПеревозки;	
	
КонецФункции

Процедура ЗаполнитьСписокДанныхГрафикаПеревозки(СписокДанных, ДанныеГрафика, ОписаниеДанных)
	
	Для Каждого ТекущееОписание Из ОписаниеДанных Цикл			
		
		ЗначениеДаты = ПреобразоватьВДату(ДанныеГрафика[ТекущееОписание.Поле]);
		
		Если ЗначениеЗаполнено(ЗначениеДаты) Тогда 				
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Значение",      ЗначениеДаты);
			СтруктураДанных.Вставить("Представление", ТекущееОписание.Представление);
			
			ПорядокСортировки = Формат(ЗначениеДаты, "ДФ=ггггММдд") + Формат(ТекущееОписание.Порядок, "ЧЦ=4; ЧДЦ=1; ЧВН=");
			СписокДанных.Добавить(СтруктураДанных, ПорядокСортировки);				 				
			
		КонецЕсли;			
		
	КонецЦикла; 
	
КонецПроцедуры		

Процедура ПодрезатьРегистрАдреснойКниги() Экспорт  
	
	ДатаПодрезки = ДобавитьМесяц(НачалоДня(ТекущаяДатаСеанса()), -2);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_АдреснаяКнига.УчастникГрузоперевозки КАК УчастникГрузоперевозки,	
	|	ДЛ_АдреснаяКнига.Адрес КАК Адрес
	|ИЗ
	|	РегистрСведений.смартДЛ_АдреснаяКнига КАК ДЛ_АдреснаяКнига
	|ГДЕ
	|	ДЛ_АдреснаяКнига.ДатаИспользования < &ДатаИспользования";
	Запрос.УстановитьПараметр("ДатаИспользования", ДатаПодрезки);

	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл 
		
		НаборЗаписей = РегистрыСведений.смартДЛ_АдреснаяКнига.СоздатьНаборЗаписей();		
		НаборЗаписей.Отбор.УчастникГрузоперевозки.Установить(Выборка.УчастникГрузоперевозки);		
		НаборЗаписей.Отбор.Адрес.Установить(Выборка.Адрес);
		НаборЗаписей.Записать();  
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокКонтрагентов(ДанныеПоиска) Экспорт 
	
	Результат = Новый СписокЗначений;
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("country", "0x8f51001438c4d49511dbd774581edb7a");
	СтруктураЗапроса.Вставить("query", ДанныеПоиска); 
	СтруктураЗапроса.Вставить("juridical", Истина);
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("ПоискКонтрагента"), СтруктураЗапроса);
	
	СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело); 
	
	Если СтруктураОтвета["data"] <> Неопределено И СтруктураОтвета["data"].Количество() > 0 Тогда
		
		Для Каждого ПолученныйКонтрагент Из СтруктураОтвета["data"] Цикл
			
			СтруктураКонтрагента = Новый Структура;
			СтруктураКонтрагента.Вставить("Наименование", ПолученныйКонтрагент["name"]);
			СтруктураКонтрагента.Вставить("КПП", ПолученныйКонтрагент["kpp"]); 
			СтруктураКонтрагента.Вставить("ИНН", ПолученныйКонтрагент["inn"]);			 
				
			Представление = СтруктураКонтрагента.Наименование + " ИНН " + СтруктураКонтрагента.ИНН + " КПП" + СтруктураКонтрагента.КПП; 	
			
			Результат.Добавить(СтруктураКонтрагента, Представление);	
			
		КонецЦикла;		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

