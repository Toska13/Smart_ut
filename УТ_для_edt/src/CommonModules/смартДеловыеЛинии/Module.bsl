Функция ДЛ_ПолучитьФайл(АдресФайла)
	
	ПараметрыПодключения = ПолучитьПараметрыПодключения();   
	
	Адрес = СтрЗаменить(АдресФайла, ПараметрыПодключения.Сервер + "/", Символы.ПС);
	Адрес = СтрПолучитьСтроку(Адрес, СтрЧислоСтрок(Адрес));
	
	Соединение = Новый HTTPСоединение(ПараметрыПодключения.Сервер,,,, НовыйИнтернетПрокси(ПараметрыПодключения.Прокси), ПараметрыПодключения.Таймаут, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос     = Новый HTTPЗапрос(Адрес);
	
	Ответ      = Соединение.Получить(Запрос);	
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КодСтатуса", Ответ.КодСостояния);
	СтруктураДанных.Вставить("Файл", Ответ.ПолучитьТелоКакДвоичныеДанные()); 	
	
	Возврат СтруктураДанных;
	
КонецФункции

Функция ПолучитьПараметрыПодключения() Экспорт 	
	
	Результат = Новый Структура;
	
	Таймаут = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_Таймаут");
	
	Результат.Вставить("Прокси", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_ПроксиСервер"));
	Результат.Вставить("Таймаут", ?(Таймаут = 0, 45, Таймаут)); 
	Результат.Вставить("Сервер", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДЛ_Сервер"));
	
	Возврат Результат;                         
	
КонецФункции 

Функция НовыйИнтернетПрокси(ПараметрыПроксиСервера) Экспорт
	
	Прокси = Новый ИнтернетПрокси;
	
	Если ЗначениеЗаполнено(ПараметрыПроксиСервера) Тогда
		
		СтруктураПараметров = СтруктураИнтернетАдреса(ПараметрыПроксиСервера);
		
		Прокси.Установить("https", СтруктураПараметров.Хост, СтруктураПараметров.Порт, СтруктураПараметров.Логин, СтруктураПараметров.Пароль);
		Прокси.Установить("http", СтруктураПараметров.Хост, СтруктураПараметров.Порт, СтруктураПараметров.Логин, СтруктураПараметров.Пароль);		
		
	КонецЕсли;
	
	Возврат Прокси;
	
КонецФункции  

