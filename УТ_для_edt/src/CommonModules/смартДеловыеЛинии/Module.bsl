	Если СтруктураОтвета["data"] <> Неопределено 
		И СтруктураОтвета["data"]["counteragents"] <> Неопределено 
		И СтруктураОтвета["data"]["counteragents"].Количество() > 0 Тогда
		
		Результат = СтруктураОтвета["data"]["counteragents"][1]["uid"]; //исправить на 0
		
