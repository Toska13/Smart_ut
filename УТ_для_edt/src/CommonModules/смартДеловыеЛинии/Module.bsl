Функция ПолучитьОПФпоИНН(ИНН) Экспорт 
	
	Результат = Неопределено;
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("country", "0x8f51001438c4d49511dbd774581edb7a");
	СтруктураЗапроса.Вставить("query", ИНН); 
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("ПоискКонтрагента"), СтруктураЗапроса);
	
	СтруктураОтвета = ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело); 
	
	Если СтруктураОтвета["data"] <> Неопределено И СтруктураОтвета["data"].Количество() > 0 Тогда
		
		Результат = СтруктураОтвета["data"][0]["opfUid"];	
		
	КонецЕсли;
	
	Возврат Результат;
	
