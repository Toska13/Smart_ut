Функция ПолучитьЖурналОтправок(Параметры, ОтветСтрокой = Ложь) Экспорт 	
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();	 
	
	Если Параметры.Свойство("ИдентификаторДокумента") Тогда 
		
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Параметры.ИдентификаторДокумента);
		
		СтруктураЗапроса.Вставить("docIds", МассивДокументов);
		
	КонецЕсли;
	
	Если Параметры.Свойство("НачалоПериода") Тогда
		
		СтруктураЗапроса.Вставить("dateStart", Формат(Параметры.НачалоПериода, "ДФ='гггг-ММ-дд ЧЧ:мм:сс'"));
		
	КонецЕсли;
	
	Если Параметры.Свойство("ОкончаниеПериода") Тогда
		
		СтруктураЗапроса.Вставить("dateEnd", Формат(Параметры.ОкончаниеПериода, "ДФ='гггг-ММ-дд ЧЧ:мм:сс'"));			
		
	КонецЕсли; 
	
	Если Параметры.Свойство("ПоследниеИзменения") Тогда
		
		СтруктураЗапроса.Вставить("lastupdate", Формат(Параметры.ПоследниеИзменения, "ДФ='гггг-ММ-дд ЧЧ:мм:сс'"));			
		
	КонецЕсли; 
	
	Если Параметры.Свойство("Статус") Тогда
		
		СтруктураЗапроса.Вставить("states", Параметры.Статус);
		
	КонецЕсли; 
	
	Если Параметры.Свойство("ВнутреннийНомер") Тогда
		
		СтруктураЗапроса.Вставить("orderNumber", Параметры.ВнутреннийНомер);
		
	КонецЕсли;  
	
	Если Параметры.Свойство("Откуда") Тогда
		
		СтруктураЗапроса.Вставить("derivalCity", Параметры.Откуда);
		
	КонецЕсли;
	
	Если Параметры.Свойство("Куда") Тогда
		
		СтруктураЗапроса.Вставить("arrivalCity", Параметры.Куда);
		
	КонецЕсли;
	
	Если Параметры.Свойство("Получатель") Тогда
		
		СтруктураЗапроса.Вставить("receiver", Параметры.Получатель);
		
	КонецЕсли;
	
	Если Параметры.Свойство("Отправитель") Тогда
		
		СтруктураЗапроса.Вставить("sender", Параметры.Отправитель);
		
	КонецЕсли;
	
	Если Параметры.Свойство("Страница") Тогда
		
		СтруктураЗапроса.Вставить("page", Параметры.Страница);
		ПолучитьВсеСтраницы = Ложь;
		
	КонецЕсли; 
	
	РезультатЗапроса = ВыполнитьPOSTЗапрос(АдресМетода("СписокЗаказов"), СтруктураЗапроса);		
	
	Возврат ?(ОтветСтрокой, РезультатЗапроса.Тело, ДесериализоватьСтруктуруПараметров(РезультатЗапроса.Тело));
	
КонецФункции 

