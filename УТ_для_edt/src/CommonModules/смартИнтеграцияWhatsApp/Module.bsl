// Модуль смартИнтеграцияWhatsApp предназначен для 
// хранения процедур и функций, связанных с обменом  
// данными с мессенджером WhatsApp
/////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Процедура ВыполнитьЗаданиеПроверкаСтатусовИнстансовWhatsApp(Параметры = Неопределено) Экспорт
	
	ПроверкаОтправкаНаПочтуСтатусовИнстансовWhatsApp();

КонецПроцедуры

Процедура ПроверкаОтправкаНаПочтуСтатусовИнстансовWhatsApp() Экспорт
	
	GreenAPIАдрес = Справочники.смартПредопределенныеЗначения.Настройки.GreenAPIАдрес;
	АдресПочтыДляОшибокWhatsApp = Справочники.смартПредопределенныеЗначения.Настройки.АдресПочтыДляОшибокWhatsApp;
	
	Если НЕ ЗначениеЗаполнено(АдресПочтыДляОшибокWhatsApp)
		ИЛИ НЕ ЗначениеЗаполнено(GreenAPIАдрес) Тогда
		Возврат;
	КонецЕсли;	
	
	МассивОшибок = Новый Массив;

	УспешныйСтатус = "authorized";
	
	УчетныеЗаписиДляПроверки = ПолучитьДействующиеУчетныеЗаписиМессенджеров("WhatsApp");
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписиДляПроверки Цикл
		
		Статус = ПолучитьСтатусИнстансаWhatsApp(УчетнаяЗапись, GreenAPIАдрес);
		
		Если ЗначениеЗаполнено(Статус) 
			И Статус <> УспешныйСтатус Тогда
			
			СтруктураОшибки = Новый Структура;
			
			СтруктураОшибки.Вставить("УчетнаяЗапись", УчетнаяЗапись.Ссылка);
			СтруктураОшибки.Вставить("Ответственный", УчетнаяЗапись.Ответственный);
			СтруктураОшибки.Вставить("Статус", 		  Статус);
			
			МассивОшибок.Добавить(СтруктураОшибки);
			
		КонецЕсли;
		
	КонецЦикла;	

	Если МассивОшибок.Количество() > 0 Тогда
		
		ТексОшибокWhatsApp = "";
		
		Для Каждого СтруктураОшибки Из МассивОшибок Цикл
			
			ТексОшибокWhatsApp = ТексОшибокWhatsApp 
				+ СокрЛП(СтруктураОшибки.УчетнаяЗапись) + " - "
				+ СокрЛП(СтруктураОшибки.Ответственный) + " - "
				+ СокрЛП(СтруктураОшибки.Статус) + Символы.ПС;
				
		КонецЦикла;
			
		//Отправка письма с ошибками
		ДанныеДляОтправки = Новый Структура;
		ДанныеДляОтправки.Вставить("Кому", 		АдресПочтыДляОшибокWhatsApp); 
	    ДанныеДляОтправки.Вставить("Тема", 		"Неавторизованные пользователи WhatsApp!");
		ДанныеДляОтправки.Вставить("Тело", 		ТексОшибокWhatsApp); 
	    ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
	    ДанныеДляОтправки.Вставить("Важность", 	ВажностьИнтернетПочтовогоСообщения.Высокая);

		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки); 
		
	КонецЕсли;	

КонецПроцедуры

Функция ПолучитьСтатусИнстансаWhatsApp(УчетнаяЗапись, GreenAPIАдрес) Экспорт
	
	Результат = Неопределено;
	
	ПараметрыУчетнойЗаписи = УчетнаяЗапись.ХранилищеПараметровДоступа.Получить();
	
	ПараметрыЗапроса = Новый Соответствие;
	
	ПараметрыЗапроса.Вставить("API", 	   		  GreenAPIАдрес);
	ПараметрыЗапроса.Вставить("idInstance", 	  ПараметрыУчетнойЗаписи.ApiURL);
	ПараметрыЗапроса.Вставить("apiTokenInstance", ПараметрыУчетнойЗаписи.Токен);
	
	HTTPОтвет = ВыполнитьЗапросGreenApi("GET", ПараметрыЗапроса, "GetStateInstance");

	Если HTTPОтвет.КодСостояния = 200 Тогда

		ДанныеJSON = ПрочитатьОбъектИзJSON(HTTPОтвет.ПолучитьТелоКакСтроку());
		
		Если ТипЗнч(ДанныеJSON) = Тип("Структура") 
			И ДанныеJSON.Свойство("stateInstance") Тогда 
			
			Результат = ДанныеJSON.stateInstance;										
														
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьДействующиеУчетныеЗаписиМессенджеров(Мессенджер)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ссылка,
	|	Включена,
	|	Ответственный,
	|	ТипМессенджера,
	|	УникальныйИдентификаторЗадания,
	|	ХранилищеПараметровДоступа
	|ИЗ
	|	Справочник.CRM_УчетныеЗаписиМессенджеров
	|ГДЕ
	|	Включена
	|	И ТипМессенджера В (&Мессенджер)
	|	
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Мессенджер", Мессенджер);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВыполнитьЗапросGreenApi(ВидЗапроса, ПараметрыЗапроса, Метод, ТелоЗапроса = "")
	
	URL = ПараметрыЗапроса.Получить("API");
	АдресРесурса = ПолучитьАдресЗапросаGreenApi(ПараметрыЗапроса, Метод);
	
	Заголовки = Новый Соответствие;
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);

	Соединение = Новый HTTPСоединение(URL, , , , , , ЗащищенноеСоединение);
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, Заголовки);
	
	Если ВРег(ВидЗапроса) = "GET" Тогда
		
		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		
	ИначеЕсли ВРег(ВидЗапроса) = "POST" Тогда
		
		Если ТелоЗапроса <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
			HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
		ИначеЕсли ТелоЗапроса <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
		КонецЕсли;
	 
	    HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
	КонецЕсли;
	
	Возврат HTTPОтвет;
	
КонецФункции

//Функция получения адреса запроса Green-Api
Функция ПолучитьАдресЗапросаGreenApi(ПараметрыЗапроса, Метод)

	Instance 	  = "/" + "waInstance" + ПараметрыЗапроса.Получить("idInstance");
	Service		  = "/" + Метод;
	TokenInstance = "/" + ПараметрыЗапроса.Получить("apiTokenInstance");
				
	АдресРесурса = Instance + Service + TokenInstance;
	
	Возврат АдресРесурса;
	
КонецФункции

#КонецОбласти

#Область Прочее

// Десериализует строку JSON в структуру или соответствие
//
// Параметры:
//  Строка - Строка
//
// Возвращаемое значение:
//  Структура или соответствие.
//
Функция ПрочитатьОбъектИзJSON(Стр, Соответствие = Ложь)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Попытка
    	Объект = ПрочитатьJSON(Чтение, Соответствие);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Объект = Неопределено;
	КонецПопытки;
	
    Возврат Объект;
	
КонецФункции

#КонецОбласти