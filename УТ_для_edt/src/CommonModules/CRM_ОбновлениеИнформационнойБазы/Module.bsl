Процедура ЗарегистрироватьДанныеКОбработкеПрисоединенныеФайлы_3_0_21_30(Параметры)
	
	ИнфоТаблица = ИнфотаблицаПрисоединенныеФайлы_3_0_21_30();
	
	Для Каждого СтрИнфоТаблица Из ИнфоТаблица Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1000
			|	&ИмяСправочника.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.&ИмяСправочника КАК &ИмяСправочника
			|ГДЕ
			|	&ИмяСправочника.Ссылка > &Ссылка";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИмяСправочника", СтрИнфоТаблица.Справочник);
		
		ОтработаныВсеЭлементы = Ложь;
		Ссылка = "";
		
		Пока Не ОтработаныВсеЭлементы Цикл
			
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			РезультатЗапроса = Запрос.Выполнить();
			МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"); 
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, МассивСсылок);
			
			КоличествоСсылок = МассивСсылок.Количество();
			Если КоличествоСсылок < 1000 Тогда
				ОтработаныВсеЭлементы = Истина;
			КонецЕсли;
			
			Если КоличествоСсылок > 0 Тогда
				Ссылка = МассивСсылок[КоличествоСсылок - 1];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

