Процедура ЗаполнитьКонстантыДляВзаимодействий(Параметры = Неопределено) Экспорт
	// Цвет в календаре по умолчанию.
	Константы.CRM_ЦветСобытияВКалендареПоУмолчанию.Установить(7);
	// Использование категорий.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Категории.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.CRM_Взаимодействие.Категории КАК Категории
	               |ГДЕ
	               |	Категории.Категория <> ЗНАЧЕНИЕ(Справочник.CRM_Категории.ПустаяСсылка)";
	Константы.CRM_ИспользоватьКатегорииВзаимодействий.Установить(НЕ Запрос.Выполнить().Пустой());
	// Использование тегов.
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Теги.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.CRM_Взаимодействие.CRM_Теги КАК Теги
	               |ГДЕ
	               |	Теги.Тег <> ЗНАЧЕНИЕ(Справочник.CRM_Теги.ПустаяСсылка)";
	Константы.CRM_ИспользоватьТегиДляВзаимодействий.Установить(НЕ Запрос.Выполнить().Пустой());
	Если Параметры <> Неопределено Тогда
