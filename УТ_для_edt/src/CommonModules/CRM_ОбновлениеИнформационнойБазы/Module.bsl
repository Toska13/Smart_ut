		        ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
		    Иначе
		
				МассивУдаляемыхСтрокТЧ = Новый Массив;
				
				Для Каждого СтрТЧ ИЗ СпрОбъект.Состав Цикл
					
					Если СтрТЧ[ИмяРеквизита].ТипЗначения = Неопределено Тогда Продолжить; КонецЕсли;
					
					Если СтрТЧ[ИмяРеквизита].ТипЗначения.СодержитТип(Тип("ДокументСсылка.удалитьCRM_Мероприятие"))
							ИЛИ СтрТЧ[ИмяРеквизита].ТипЗначения.СодержитТип(Тип("ДокументСсылка.удалитьCRM_Планирование"))
							ИЛИ СтрТЧ[ИмяРеквизита].ТипЗначения.СодержитТип(Тип("ДокументСсылка.УдалитьCRM_Сделка"))
							ИЛИ СтрТЧ[ИмяРеквизита].ТипЗначения.СодержитТип(Тип("ДокументСсылка.УдалитьCRM_Событие")) Тогда
							
