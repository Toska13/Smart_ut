Функция ПерваяБукваЗаглавная(Слово)
	
	Возврат Врег(Лев(Слово, 1)) + Нрег(Сред(Слово, 2));
	
КонецФункции

Функция ПолучитьСтруктуруНадписьПрописью(Сумма)
	
	стВозврата = Новый Структура("НадписьСумма, НадписьКопейки", "", "");
	
	МассивСуммы = СтрРазделить(ЧислоПрописью(Сумма, "Л=ru_RU;ДП=Ложь;"), " ", Ложь);
	
	стВозврата.НадписьСумма = "";
	стВозврата.НадписьКопейки = "";
	
	Для Сч = 0 По МассивСуммы.ВГраница() Цикл
		
		Если Сч = МассивСуммы.ВГраница() Тогда
			
			стВозврата.НадписьКопейки = МассивСуммы[Сч];
			
			Прервать;
			
		КонецЕсли;	
		
		стВозврата.НадписьСумма = стВозврата.НадписьСумма + МассивСуммы[Сч] + " ";
		
	КонецЦикла;	
	
	стВозврата.НадписьСумма = СокрЛП(стВозврата.НадписьСумма);
	стВозврата.НадписьКопейки = СокрЛП(стВозврата.НадписьКопейки);
	
	Возврат стВозврата;
	
КонецФункции

Функция ПолучитьКонтактнуюИнформацию(КонтактноеЛицо)
	
	СтруктураВозврат = Новый Структура;
	СтруктураВозврат.Вставить("Почта", "");
	СтруктураВозврат.Вставить("Телефон", "");
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК Значение,
	|	""Почта"" КАК Тип
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтактногоЛица)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление,
	|	""Телефон""
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Вид В (ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица), ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица))";
	
	Запрос.УстановитьПараметр("Ссылка", КонтактноеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Телефон = "";
	Почта = "";
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Тип = "Почта" Тогда
			Почта = Почта + ?(ЗначениеЗаполнено(Почта), ", ", "") + Выборка.Значение;
		Иначе
			Телефон = Телефон + ?(ЗначениеЗаполнено(Телефон), ", ", "") + Выборка.Значение;
		КонецЕсли;
		
	КонецЦикла;	
	
	СтруктураВозврат.Вставить("Телефон", Телефон);
	СтруктураВозврат.Вставить("Почта", Почта);
	
	Возврат СтруктураВозврат;
	
КонецФункции

Процедура ВычислитьМаксНомерКлюча(МаксНомерКлюча, ТаблицаСвязей)

	Для Каждого СтрКлюча Из ТаблицаСвязей Цикл
	
		СтруктураКлюча = ПолучитьИмяБезЦифр(СтрКлюча.ИдРесурса);
		
		Если СтруктураКлюча.Номер > МаксНомерКлюча Тогда
			МаксНомерКлюча = СтруктураКлюча.Номер;	
		КонецЕсли;	
		
	КонецЦикла;	

КонецПроцедуры

Функция ПолучитьИмяБезЦифр(Знач Имя)

	МассивКлюча = СтрРазделить(Имя, "0123456789", Ложь);

	Если МассивКлюча.Количество() > 1 Тогда
		ВызватьИсключение НСтр("ru = 'Неожиданный ключ'");
	КонецЕсли;
	
	Результат = Новый Структура ("ШаблонИмени, Номер");
	
	Результат.ШаблонИмени 	= МассивКлюча[0] + "%1";
	
	НеНужныеСимволы = СтрСоединить(МассивКлюча, "");
	
	МассивНомеров = СтрРазделить(Имя, НеНужныеСимволы, Ложь);
	
	Если МассивНомеров.Количество() > 1 Тогда
		ВызватьИсключение НСтр("ru = 'Неожиданный ключ, несколько номеров'");
	КонецЕсли;
	
	Результат.Номер	= Число(МассивНомеров[0]);

	Возврат Результат;
	
КонецФункции

#КонецОбласти