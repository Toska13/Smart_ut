
// Дополняет список команд шаблонами печати.
Процедура ПриПолученииКомандПечати(КомандыПечати, ОбъектМетаданных) Экспорт

	ИдентификаторОбъектаМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ОбъектМетаданных);
	
	ОбъектМетаданных = Справочники.ИдентификаторыОбъектовМетаданных.ОбъектМетаданныхПоИдентификатору(ИдентификаторОбъектаМетаданных, Ложь);
	
	ДанныеШаблонов = ПолучитьШаблоныПоИдентификаторуОбъектаМетаданных(ИдентификаторОбъектаМетаданных);
	
	Для Каждого СтрШаблон Из ДанныеШаблонов Цикл;
		
		Если НЕ Пользователи.РолиДоступны("ПолныеПрава", , Ложь) 
			И СтрШаблон.ТестовыйРежим Тогда
			
			Продолжить;
			
		КонецЕсли;	
		
		КомандаПечати = КомандыПечати.Добавить();

		КомандаПечати.Идентификатор 				 	= СтрЗаменить(СтрШаблон.Ссылка.УникальныйИдентификатор(), "-", "_");
		КомандаПечати.Представление 				 	= СтрШаблон.Наименование;
		КомандаПечати.Обработчик 					 	= "смартШаблоныПечатныхФормКлиент.ПечатьПоШаблону";
		КомандаПечати.Порядок 							= 100;
		КомандаПечати.Картинка 					 		= БиблиотекаКартинок.ФорматWord2007;
		
	КонецЦикла;	
	
КонецПроцедуры

//Формирует печатную форму по шаблону
Функция СформироватьПечатнуюФормуПоШаблону(ОбъектПечати, Шаблон) Экспорт

	РезультатПечатнаяФорма = Неопределено;
	ПечатнаяФорма = Неопределено;
	ТипМакета = Неопределено;
	ЭтоПервыйМодуль = Истина;
	ПечатнаяФормаИнициализирована = Ложь;
	
	ОписаниеОшибки = "";
	
	НомерРаздела = 0;
	НомерПриложения = 0;

	СтруктураПараметров = Новый Структура;
	
	Для Каждого СтрокаМодуля Из Шаблон.Модули Цикл

		Если НЕ СтрокаМодуля.Используется Тогда
			Продолжить;
		КонецЕсли;	

		//Проверка условия печати
		Если смартШаблоныПечатныхФормСервер.ПроверитьУсловиеПечатиМодуля(ОбъектПечати, СтрокаМодуля.УсловиеВидимости) Тогда
			
			//Инициализация печатной формы	
			Если НЕ ПечатнаяФормаИнициализирована Тогда
				
				ПечатнаяФормаИнициализирована = ИнициализироватьПечатнуюФорму(ПечатнаяФорма, СтрокаМодуля.Модуль, ТипМакета, ОбъектПечати, Шаблон);
					
				Если НЕ ПечатнаяФормаИнициализирована Тогда
					Продолжить;				
				КонецЕсли;	

			КонецЕсли;	

			СтруктураПечати = Новый Структура;
			СтруктураПечати.Вставить("Модуль",	   СтрокаМодуля.Модуль);
			СтруктураПечати.Вставить("ИмяОбласти", СтрокаМодуля.Модуль.ИмяОбласти);
			
			//Печать модуля
			ВывестиМодульВПечатнуюФорму(ПечатнаяФорма, ТипМакета, ОбъектПечати, СтруктураПечати, СтруктураПараметров, 
										ЭтоПервыйМодуль, НомерРаздела, НомерПриложения, ОписаниеОшибки);
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ТипМакета = "MXL" Тогда
		
		РезультатПечатнаяФорма = ПечатнаяФорма;
		
	ИначеЕсли ТипМакета = "DOCX" Тогда 
		
		Если ТипЗнч(ПечатнаяФорма) = Тип("Структура") Тогда	
		
			РезультатПечатнаяФорма = смартУправлениеПечатью.СформироватьДокумент(ПечатнаяФорма);
		
			смартУправлениеПечатью.ОчиститьСсылки(ПечатнаяФорма);
			
		Иначе
			
			РезультатПечатнаяФорма = ПечатнаяФорма;
			
		КонецЕсли;	
			
	КонецЕсли;
	
	Возврат РезультатПечатнаяФорма;
	
КонецФункции	

//Выводит модуль в печатную форму
Процедура ВывестиМодульВПечатнуюФорму(ПечатнаяФорма, ТипМакета, ОбъектПечати, СтруктураПечати, СтруктураПараметров, ЭтоПервыйМодуль, НомерРаздела, НомерПриложения, ОписаниеОшибки) Экспорт
	
	ТекущийМодуль = СтруктураПечати.Модуль;
	
	//Вывод модулей по коллекции
	Если СтруктураПечати.Свойство("КоллекцияЗначений")
		И (ТипЗнч(СтруктураПечати.КоллекцияЗначений) = Тип("Массив")
		   ИЛИ ТипЗнч(СтруктураПечати.КоллекцияЗначений) = Тип("Соответствие")
		   ИЛИ ТипЗнч(СтруктураПечати.КоллекцияЗначений) = Тип("Структура")
		   ИЛИ ТипЗнч(СтруктураПечати.КоллекцияЗначений) = Тип("ФиксированноеСоответствие")
		   ИЛИ ТипЗнч(СтруктураПечати.КоллекцияЗначений) = Тип("ФиксированнаяСтруктура")) Тогда
		
		Для Каждого СтрокаКоллекции Из СтруктураПечати.КоллекцияЗначений Цикл

			СтруктураПечатиКоллекцияЗначений = Новый Структура;
			СтруктураПечатиКоллекцияЗначений.Вставить("Модуль",	   		 ТекущийМодуль);
			СтруктураПечатиКоллекцияЗначений.Вставить("ИмяОбласти", 	 ТекущийМодуль.ИмяОбласти);
			СтруктураПечатиКоллекцияЗначений.Вставить("СтрокаКоллекции", СтрокаКоллекции);
			
			СтруктураПараметров.Вставить("СтрокаКоллекции", СтрокаКоллекции);
			
			ВывестиМодульВПечатнуюФорму(ПечатнаяФорма, ТипМакета, ОбъектПечати, 
										СтруктураПечатиКоллекцияЗначений, СтруктураПараметров, 
										ЭтоПервыйМодуль, НомерРаздела, НомерПриложения, ОписаниеОшибки);

		КонецЦикла;

		СтруктураПараметров.Вставить("СтрокаКоллекции", Неопределено);
		
		Возврат;
		
	КонецЕсли;	
	
	ТипМакета = ТекущийМодуль.ТипМакета;
	
	//Получение макета модуля
	МакетМодуля = смартСерверПривилегированный.ПолучитьДополнительныеДанныеОбъекта(ТекущийМодуль);

	Если МакетМодуля = Неопределено
		 И (ТекущийМодуль.ВложенныеМодули.Количество() = 0
			ИЛИ ТекущийМодуль.ПечататьОсновнойМакет) Тогда
		Возврат;
	КонецЕсли;

	//Параметры модуля
	ПолучитьПараметрыМодуля(СтруктураПараметров, ТекущийМодуль, ОбъектПечати, ПечатнаяФорма, ОписаниеОшибки);
	
	//Нумерация разделов
	ВидМодуля = ТекущийМодуль.ВидМодуля;
	
	Если ВидМодуля = "Новый раздел" Тогда
		НомерРаздела = НомерРаздела + 1;
	ИначеЕсли ВидМодуля = "Новое приложение" Тогда
		НомерПриложения = НомерПриложения + 1;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("НомерРаздела", 	НомерРаздела);
	СтруктураПараметров.Вставить("НомерПриложения", НомерПриложения);
	
	//Вывод макета с новой страницы
	Если ТекущийМодуль.НоваяСтраница Тогда
		
		Если ТипМакета = "MXL" Тогда
			ПечатнаяФорма.ВывестиГоризонтальныйРазделительСтраниц();
		ИначеЕсли ТипМакета = "DOCX" Тогда	
			ВставитьРазрывСтраницыWord(ПечатнаяФорма);
		КонецЕсли;
		
	КонецЕсли;

	//Вывод основного макета модуля
	Если ТекущийМодуль.ПечататьОсновнойМакет
		 ИЛИ ТекущийМодуль.ВложенныеМодули.Количество() = 0 Тогда
	
		Если ТипМакета = "MXL" Тогда
			
			Если МакетМодуля.Области.Количество() > 0 Тогда

				Для Каждого ОбластьМакета Из МакетМодуля.Области Цикл 
					
					//Заполнение параметров
					ОбластьТабДок = МакетМодуля.ПолучитьОбласть(ОбластьМакета.Имя);
					ОбластьТабДок.Параметры.Заполнить(СтруктураПараметров);

					ЗаполнитьПараметрыСтрокиКоллекцииMXL(ОбластьТабДок, СтруктураПараметров);
					ЗаполнитьПараметрыСтрокиКоллекцииMXL(ОбластьТабДок, СтруктураПечати);
					
					//Вывод макета
					ПечатнаяФорма.Вывести(ОбластьТабДок);
					
				КонецЦикла;
				
			Иначе
				
				//Заполнение параметров
				МакетМодуля.Параметры.Заполнить(СтруктураПараметров);

				ЗаполнитьПараметрыСтрокиКоллекцииMXL(МакетМодуля, СтруктураПараметров);
				ЗаполнитьПараметрыСтрокиКоллекцииMXL(МакетМодуля, СтруктураПечати);
				
				//Вывод макета
				ПечатнаяФорма.Вывести(МакетМодуля);
				
			КонецЕсли;	
			
		ИначеЕсли ТипМакета = "DOCX" Тогда	
		
			МакетWord = смартУправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетМодуля, "");

			//Перед выводом проверим перенесем картинки из иакета
			Если НЕ ЭтоПервыйМодуль Тогда

				ПеренестиКартинкиИзМакетаВПечатнуюФорму(ПечатнаяФорма, МакетWord);
				
			КонецЕсли;	
			
			//Получение имени области
			ИмяОбластиПечати = ?(ЗначениеЗаполнено(СтруктураПечати.ИмяОбласти), СтруктураПечати.ИмяОбласти, "Тело");

			Если ЗначениеЗаполнено(ТекущийМодуль.ПараметрОбласти) Тогда
				
				ПолучитьИмяОбластиИзПараметров(ИмяОбластиПечати, ТекущийМодуль.ПараметрОбласти, СтруктураПараметров);
				
			КонецЕсли;
			
			Если СтруктураПечати.Свойство("ПараметрОбласти")
				И ЗначениеЗаполнено(СтруктураПечати.ПараметрОбласти) Тогда

				ПолучитьИмяОбластиИзПараметров(ИмяОбластиПечати, СтруктураПечати.ПараметрОбласти, СтруктураПараметров);
				ПолучитьИмяОбластиИзПараметров(ИмяОбластиПечати, СтруктураПечати.ПараметрОбласти, СтруктураПечати);
				
			КонецЕсли;
			
			//Вывод дополнительных областей
			Для Каждого СтрОбласти Из ТекущийМодуль.ОбластиШаблона Цикл
				
				Если ПроверитьУсловиеВыводаОбласти(СтрОбласти, ОбъектПечати, СтруктураПараметров) Тогда

				    ОписаниеОбласти = Новый Структура("ТипОбласти, ИмяОбласти", "Общая", СтрОбласти.ОбластьШаблона);
				    ОбластьМакета = смартУправлениеПечатью.ОбластьМакета(МакетWord, ОписаниеОбласти);

				    смартУправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьМакета, Ложь);

					//Заполнение параметров
					смартУправлениеПечатью.ЗаполнитьПараметры(ПечатнаяФорма, СтруктураПараметров);
					
					ЗаполнитьПараметрыСтрокиКоллекцииWord(ПечатнаяФорма, СтруктураПараметров);
					ЗаполнитьПараметрыСтрокиКоллекцииWord(ПечатнаяФорма, СтруктураПечати);
					
				КонецЕсли;
				
			КонецЦикла;	
			
			//Вывод основного макета
		    ОписаниеОбласти = Новый Структура("ТипОбласти, ИмяОбласти", "Общая", ИмяОбластиПечати);
		    ОбластьМакета = смартУправлениеПечатью.ОбластьМакета(МакетWord, ОписаниеОбласти);

		    смартУправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьМакета, Ложь);

			//Заполнение параметров
			смартУправлениеПечатью.ЗаполнитьПараметры(ПечатнаяФорма, СтруктураПараметров);

			ЗаполнитьПараметрыСтрокиКоллекцииWord(ПечатнаяФорма, СтруктураПараметров);
			ЗаполнитьПараметрыСтрокиКоллекцииWord(ПечатнаяФорма, СтруктураПечати);
			
			смартУправлениеПечатью.ОчиститьСсылки(МакетWord);
			
		КонецЕсли;	

	КонецЕсли;	
	
	ЭтоПервыйМодуль = Ложь;
	
	//Вложенные модули
	Если ТекущийМодуль.ВложенныеМодули.Количество() > 0 Тогда
		
		МассивСтрокВложенныхМодулей = Новый Массив;
		
		//Получение одного вложенного модуля по параметру
		Если ЗначениеЗаполнено(ТекущийМодуль.ПараметрВложенногоМодуля) Тогда
			
			СтрокаВложенногоМодуля = ПолучитьВложенныйМодуль(ОбъектПечати, 
															 ТекущийМодуль.ВложенныеМодули, 
															 ТекущийМодуль.ПараметрВложенногоМодуля,
															 СтруктураПараметров);
			
			Если СтрокаВложенногоМодуля <> Неопределено Тогда
				МассивСтрокВложенныхМодулей.Добавить(СтрокаВложенногоМодуля);
			КонецЕсли;

		Иначе
			
			//Вывод вложенных модулей по условию
			Для Каждого СтрокаВложенногоМодуля Из ТекущийМодуль.ВложенныеМодули Цикл
				
				Если ЗначениеЗаполнено(СтрокаВложенногоМодуля.Модуль)
					И (НЕ ЗначениеЗаполнено(СтрокаВложенногоМодуля.УсловиеПечати) 
					   ИЛИ смартШаблоныПечатныхФормСервер.ПроверитьУсловиеПечатиМодуля(ОбъектПечати, СтрокаВложенногоМодуля.УсловиеПечати)) Тогда
					
					МассивСтрокВложенныхМодулей.Добавить(СтрокаВложенногоМодуля);
						

				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
			
		//Печать вложенных модулей
		Для Каждого СтрокаВложенногоМодуля Из МассивСтрокВложенныхМодулей Цикл
		
			//Получение имени области
			ИмяОбластиДляПечати = ?(ЗначениеЗаполнено(СтрокаВложенногоМодуля.ИмяОбласти), СтрокаВложенногоМодуля.ИмяОбласти, "Тело");

			Если ЗначениеЗаполнено(СтрокаВложенногоМодуля.ПараметрОбласти) Тогда

				ПолучитьИмяОбластиИзПараметров(ИмяОбластиДляПечати, СтрокаВложенногоМодуля.ПараметрОбласти, СтруктураПараметров);
				ПолучитьИмяОбластиИзПараметров(ИмяОбластиДляПечати, СтрокаВложенногоМодуля.ПараметрОбласти, СтруктураПечати);
				
			КонецЕсли;
				
			СтруктураПечатиВложенногоМодуля = Новый Структура;
			СтруктураПечатиВложенногоМодуля.Вставить("Модуль", 	   СтрокаВложенногоМодуля.Модуль);
			СтруктураПечатиВложенногоМодуля.Вставить("ИмяОбласти", ИмяОбластиДляПечати);

			Если ЗначениеЗаполнено(СтрокаВложенногоМодуля.РеквизитКоллекцииЗначений)
				И СтруктураПараметров.Свойство(СтрокаВложенногоМодуля.РеквизитКоллекцииЗначений) Тогда
				
				СтруктураПечатиВложенногоМодуля.Вставить("КоллекцияЗначений", 
					СтруктураПараметров[СтрокаВложенногоМодуля.РеквизитКоллекцииЗначений]);
				
			КонецЕсли;	
			
			//Вывод вложенного модуля
			ВывестиМодульВПечатнуюФорму(ПечатнаяФорма, ТипМакета, ОбъектПечати, СтруктураПечатиВложенногоМодуля, 
										СтруктураПараметров, ЭтоПервыйМодуль, НомерРаздела, НомерПриложения, ОписаниеОшибки)
															 
		КонецЦикла;													 

	КонецЕсли;
	
КонецПроцедуры

//Перенос картинок в печатную форму
Процедура ПеренестиКартинкиИзМакетаВПечатнуюФорму(ПечатнаяФорма, МакетWord);
	
	Если СтрНайти(МакетWord.СтруктураДокумента.СвязиКонтента, "relationships/image") <> 0 Тогда
		
		ТаблицаСвязейПечатнойФормы = ПечатнаяФорма.СтруктураДокумента.ТаблицаСвязейКонтента;
		ТаблицаСвязейМакета = МакетWord.СтруктураДокумента.ТаблицаСвязейКонтента;
		
		МаксНомерКлюча = 0;
		
		ВычислитьМаксНомерКлюча(МаксНомерКлюча, ТаблицаСвязейПечатнойФормы);
		ВычислитьМаксНомерКлюча(МаксНомерКлюча, ТаблицаСвязейМакета);

		ИмяКаталогаФайловПечатнойФормы = ПечатнаяФорма.ИмяКаталога + "word/media/";
		
		//++ #4254 смарт: Ермаков 02.09.2025 / Ошибка ЖР. Печать договора
		// Если в печатной форме нет картинок, то катлог media не создается автоматически
		ИмяКаталогаФайловПечатнойФормыФайл = Новый Файл(ИмяКаталогаФайловПечатнойФормы);
		Если Не ИмяКаталогаФайловПечатнойФормыФайл.Существует() Тогда
			
			СоздатьКаталог(ИмяКаталогаФайловПечатнойФормы);
			
		КонецЕсли;
		//-- #4254 смарт: Ермаков 02.09.2025
		
		ИмяКаталогаФайловМакета = МакетWord.ИмяКаталога + "word/media/";
		
		Для Каждого СтрСвязи Из ТаблицаСвязейМакета Цикл
			
			Если СтрНайти(СтрСвязи.ИмяРесурса, "media/image") <> 0 Тогда
				
				МаксНомерКлюча = МаксНомерКлюча + 1;
				
				ИмяФайлаКартинки = СтрЗаменить(СтрСвязи.ИмяРесурса, "media/", "");
				ИмяФайлаИсточник = ИмяКаталогаФайловМакета + ИмяФайлаКартинки;
				
				ФайлКартинкиИсточник = Новый Файл(ИмяФайлаИсточник);
				
				Если ФайлКартинкиИсточник.Существует() Тогда
					
					УникальныйКлюч = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
					
					НовоеИмяФайлаКартинки = "image" + Строка(УникальныйКлюч) + ФайлКартинкиИсточник.Расширение;
					ИмяФайлаПриемник 	  = ИмяКаталогаФайловПечатнойФормы + НовоеИмяФайлаКартинки; 
					
					//Перенос картинки
					КопироватьФайл(ИмяФайлаИсточник, ИмяФайлаПриемник);
					
					//Новая строка связи
					НоваяСтрСвязи = ТаблицаСвязейПечатнойФормы.Добавить();
					
					НоваяСтрСвязи.ИдРесурса    = "rld" + Строка(МаксНомерКлюча);
					НоваяСтрСвязи.НомерРесурса = МаксНомерКлюча;
					НоваяСтрСвязи.ИмяРесурса   = "media/" + НовоеИмяФайлаКартинки;
					
					//Найти ИдРесурса в документе и заменить на новый ИдРесурса
					ОбластиМакетаЗамена = МакетWord.СтруктураДокумента.ОбластиДокумента;

					Для Каждого ОбластьМакетаЗамена Из ОбластиМакетаЗамена Цикл
						
						ОбластьМакетаЗамена.Значение.Текст 
							= СтрЗаменить(ОбластьМакетаЗамена.Значение.Текст, 
										  "blip r:embed=""" + СтрСвязи.ИдРесурса + """", 
										  "blip r:embed=""" + НоваяСтрСвязи.ИдРесурса + """");
						
					КонецЦикла;	
					
					//Запись Relationship в связи контента
					НоваяСтрокаСвязи = ПолучитьСтрокуСвязи(НоваяСтрСвязи.ИдРесурса, НовоеИмяФайлаКартинки);
									
					ПечатнаяФорма.СтруктураДокумента.СвязиКонтента 
						= СтрЗаменить(ПечатнаяФорма.СтруктураДокумента.СвязиКонтента, "</Relationships>", НоваяСтрокаСвязи);
									  
				КонецЕсли;	

			КонецЕсли;	
			
		КонецЦикла;	
			
	КонецЕсли;	

КонецПроцедуры	

//Получение параметров модуля
Процедура ПолучитьПараметрыМодуля(СтруктураПараметров, Модуль, ОбъектСсылка, ПечатнаяФорма, ОписаниеОшибки) Экспорт

	Для Каждого СтрокаПараметра Из Модуль.ПараметрыШаблона Цикл
			
		// Получить ЗначениеПараметра из произвольного кода
		ЗначениеПроизвольногоКода = Ложь;
		ЗначениеПараметраПолучено = Ложь;
		
		Если НЕ ЗначениеПараметраПолучено
			И ЗначениеЗаполнено(СокрЛП(СтрокаПараметра.ПроизвольныйКод)) Тогда
			
			ЗначениеПараметра = ВыполнитьПроизвольныйКод(СокрЛП(СтрокаПараметра.ПроизвольныйКод), 
														 СтрокаПараметра, ОбъектСсылка, СтруктураПараметров, Модуль, ОписаниеОшибки);
														 
			Если ЗначениеПараметра <> Неопределено Тогда											 
				ЗначениеПараметраПолучено = Истина;
				ЗначениеПроизвольногоКода = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеПараметраПолучено
			И ЗначениеЗаполнено(СтрокаПараметра.ЗначениеПараметра) Тогда
			
			ЗначениеПараметра = СтрокаПараметра.ЗначениеПараметра;
			
			ЗначениеПараметраПолучено = Истина;
			
		КонецЕсли;	
			
		Если НЕ ЗначениеПараметраПолучено Тогда
			
			ОбрабатываемыйПараметр = "";
			
			Попытка
				
				Если СтрокаПараметра.РеквизитИмя = "Ссылка" Тогда
					
					ОбрабатываемыйПараметр = "Ссылка";
					ЗначениеПараметра	   = ОбъектСсылка;
					
				Иначе
					
					Если СтрНайти(СтрокаПараметра.РеквизитИмя, ".") = 0 Тогда
						
						Если СтруктураПараметров.Свойство(СтрЗаменить(СтрокаПараметра.РеквизитИмя, " ", "")) Тогда

							ОбрабатываемыйПараметр = СтрЗаменить(СтрокаПараметра.РеквизитИмя, " ", "");
							ЗначениеПараметра	   = СтруктураПараметров[ОбрабатываемыйПараметр];

						Иначе
							
							ОбрабатываемыйПараметр = СтрокаПараметра.РеквизитИмя;
							ЗначениеПараметра	   = ПолучитьЧерезТочки(ОбъектСсылка, ОбрабатываемыйПараметр);
							
						КонецЕсли;	
					
					Иначе

						ОбрабатываемыйПараметр = СтрокаПараметра.РеквизитИмя;

						МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(ОбрабатываемыйПараметр), ".");
						
						Если МассивРеквизитов.Количество() > 0 
							И СтруктураПараметров.Свойство(МассивРеквизитов[0]) Тогда
							
							ЗначениеПараметра = ПолучитьЧерезТочки(СтруктураПараметров, ОбрабатываемыйПараметр);
							
						Иначе
							
							ЗначениеПараметра = ПолучитьЧерезТочки(ОбъектСсылка, ОбрабатываемыйПараметр);
							
						КонецЕсли;	
					
					КонецЕсли;

				КонецЕсли;
					
			Исключение

				ОписаниеОшибки = ОписаниеОшибки + "|Ошибка обработки параметра: " + ОбрабатываемыйПараметр;
				
				Продолжить;
				
			КонецПопытки;		
		
		КонецЕсли;

		// Применить Формат
		Если ЗначениеЗаполнено(СтрокаПараметра.Формат) Тогда
			ЗначениеПараметра = Формат(ЗначениеПараметра, СокрЛП(СтрокаПараметра.Формат));
		КонецЕсли;	

		СтруктураПараметров.Вставить(СтрокаПараметра.ПараметрШаблона, ЗначениеПараметра);
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПараметрыСтрокиКоллекцииWord(ПечатнаяФорма, Знач СтруктураПараметры)

	Если СтруктураПараметры.Свойство("СтрокаКоллекции")
		И (ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Соответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Структура")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированноеСоответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированнаяСтруктура")) Тогда
		
		смартУправлениеПечатью.ЗаполнитьПараметры(ПечатнаяФорма, СтруктураПараметры.СтрокаКоллекции);
		
	КонецЕсли;	

КонецПроцедуры	

Процедура ЗаполнитьПараметрыСтрокиКоллекцииMXL(Макет, Знач СтруктураПараметры)

	Если СтруктураПараметры.Свойство("СтрокаКоллекции")
		И (ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Соответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Структура")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированноеСоответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированнаяСтруктура")) Тогда
		
		Макет.Параметры.Заполнить(СтруктураПараметры.СтрокаКоллекции);
		
