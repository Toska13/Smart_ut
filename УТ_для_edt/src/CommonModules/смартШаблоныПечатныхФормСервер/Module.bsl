Функция ПолучитьЧерезТочки(СсылкаОбъекта, СтрокаСсылок) Экспорт

    Перем ПромежуточноеЗначение;
    
    МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(СтрокаСсылок), ".");
    
    Для Индекс = 0 По МассивРеквизитов.Количество() - 1 Цикл
		
		Если Индекс = 0 Тогда
			ПромежуточноеЗначение = СсылкаОбъекта[МассивРеквизитов[Индекс]];
		Иначе
        	ПромежуточноеЗначение = ПромежуточноеЗначение[МассивРеквизитов[Индекс]];
		КонецЕсли;
		
    КонецЦикла;

    Возврат ПромежуточноеЗначение;
        
КонецФункции

Функция ОчиститьКвадратныеСкобки(Строка)
	
	Если СтрНачинаетсяС(Строка, "[") И СтрЗаканчиваетсяНа(Строка, "]") Тогда
		Возврат Сред(Строка, 2, СтрДлина(Строка) - 2);
	КонецЕсли;
	
	Возврат Строка;
	
КонецФункции

