Функция ИменаПараметровТабличногоДокумента(ТабДок) Экспорт 
    
	КоллекцияИменПараметров = Новый Соответствие;

	Для НомерРяда = 1 По ТабДок.ВысотаТаблицы Цикл
		
		Для НомерКолонки = 1 По ТабДок.ШиринаТаблицы Цикл
			
			ОбластьЯчейка = ТабДок.Область(НомерРяда, НомерКолонки, НомерРяда, НомерКолонки);
			
			Если НомерКолонки = 1 Тогда
				ОбластьЯчейка.Текст = Символы.Таб + Символы.Таб + ОбластьЯчейка.Текст;	
			КонецЕсли;
				
			ПараметрыТекста = смартУправлениеПечатью.НайтиПараметрыВТексте(ОбластьЯчейка.Текст);

			Для Каждого Параметр Из ПараметрыТекста Цикл
				
				ИмяПараметра = ОчиститьКвадратныеСкобки(Параметр);
				
		        КоллекцияИменПараметров.Вставить(ИмяПараметра, ИмяПараметра);
	
			КонецЦикла; 
				
		КонецЦикла;

		НомерКолонки = Неопределено;

	КонецЦикла;

	НомерРяда = Неопределено; 

	Возврат КоллекцияИменПараметров

КонецФункции

Функция ИменаПараметровДокументаWord(МакетМодуля) Экспорт 
    
	МассивПараметров = Новый Массив;
	
	МакетWord = смартУправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетМодуля, "");
	
	Для Каждого Область Из МакетWord.СтруктураДокумента.ОбластиДокумента Цикл
		
		НайтиПараметрыWord(МассивПараметров, Область.Значение.Текст);
		
	КонецЦикла;	

	КоллекцияИменПараметров = Новый Соответствие;
	
	Для Каждого ЭлементПараметр Из МассивПараметров Цикл
		КоллекцияИменПараметров.Вставить(ЭлементПараметр, ЭлементПараметр);	
	КонецЦикла;	
	
	смартУправлениеПечатью.ОчиститьСсылки(МакетWord);
	
	Возврат КоллекцияИменПараметров;

КонецФункции

Процедура НайтиПараметрыWord(МассивПараметров, Знач Текст)

	НачалоПараметра = СтрНайти(Текст, "{v8 ");
	
	Если НачалоПараметра > 0 Тогда
		
		Текст = Прав(Текст, СтрДлина(Текст) - (НачалоПараметра+3));
		КонецПараметра = СтрНайти(Текст, "}");
		Если КонецПараметра > 0 Тогда
			ТекстПараметра = СокрЛП(Лев(Текст, КонецПараметра-1));
			МассивПараметров.Добавить(ТекстПараметра);
			Текст = Прав(Текст, СтрДлина(Текст) - (СтрДлина(ТекстПараметра) + 1));
		КонецЕсли;
		
		НачалоПараметра = СтрНайти(Текст, "{v8 ");
		Если НачалоПараметра > 0 Тогда
			НайтиПараметрыWord(МассивПараметров, Текст);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

