Функция ИнициализироватьПечатнуюФорму(ПечатнаяФорма, Модуль, ТипМакета, ОбъектПечати, Шаблон)
	
	//Получение макета модуля
	МакетМодуля = смартСерверПривилегированный.ПолучитьДополнительныеДанныеОбъекта(Модуль);

	Если МакетМодуля = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ТипМакета = Модуль.ТипМакета;
	
	Если ТипМакета = "MXL" Тогда

		ПечатнаяФорма = Новый ТабличныйДокумент;
		
		СкопироватьПараметрыТабличногоДокумента(ПечатнаяФорма, МакетМодуля);

	ИначеЕсли ТипМакета = "DOCX" Тогда	
		
		//Инициалицазия печатной формы
		МакетWord = смартУправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетМодуля, "");
		
	    ПечатнаяФорма = смартУправлениеПечатью.ИнициализироватьПечатнуюФорму(,, МакетWord);
		
		//Вывод колонтитулов из первого макета
	    ОписаниеОбластиКолонтитул = Новый Структура("ТипОбласти, ИмяОбласти", "ВерхнийКолонтитул", "ВерхнийКолонтитул");
	    ОбластьМакетаКолонтитул	= смартУправлениеПечатью.ОбластьМакета(МакетWord, ОписаниеОбластиКолонтитул);
	    смартУправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьМакетаКолонтитул);

		ОписаниеОбластиНижнийКолонтитул = Новый Структура("ТипОбласти, ИмяОбласти", "НижнийКолонтитул", "НижнийКолонтитул");
		ОбластьМакетаНижнийКолонтитул = смартУправлениеПечатью.ОбластьМакета(МакетWord, ОписаниеОбластиНижнийКолонтитул);
		смартУправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьМакетаНижнийКолонтитул);
		
		смартУправлениеПечатью.ОчиститьСсылки(МакетWord);
		
	Иначе	
		
		Возврат Ложь;
		
	КонецЕсли;	

	Возврат Истина;
	
КонецФункции

Функция ПолучитьСхемуСКДПоОбъекту(Объект) Экспорт

	СхемаОбъекта = Неопределено;
	
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат СхемаОбъекта;
	КонецЕсли;	
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных") Тогда
		ОбъектМетаданных = Справочники.ИдентификаторыОбъектовМетаданных.ОбъектМетаданныхПоИдентификатору(Объект, Ложь);
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		ОбъектМетаданных = Объект.Метаданные();	
	Иначе	
		Возврат СхемаОбъекта;
	КонецЕсли;
	
	ИмяОбъектаМетаданных = ОбъектМетаданных.ПолноеИмя();
	
	СхемыОбъекта = смартУправлениеПечатью.СхемыКомпоновкиДанныхИсточникаПолей(ИмяОбъектаМетаданных, Истина);
	
	Для Каждого Схема Из СхемыОБъекта Цикл
		
		Если Схема.Представление = ИмяОбъектаМетаданных Тогда
			СхемаОбъекта = Схема.Значение;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СхемаОбъекта <> Неопределено Тогда
		
		ПолеВыбора = СхемаОбъекта.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ПолеВыбора.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
		ПолеВыбора.Использование = Истина;
		
		ГруппировкаКомпоновкиДанных = СхемаОбъекта.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ГруппировкаКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));							   
		ГруппировкаКомпоновкиДанных.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		ГруппировкаКомпоновкиДанных.Использование = Истина;
		
		ПараметрПредмет = СхемаОбъекта.Параметры.Добавить(); 
		ПараметрПредмет.Имя = "Предмет";
		ПараметрПредмет.Значение = "";
		ПараметрПредмет.Использование = ИспользованиеПараметраКомпоновкиданных.Всегда;
		
	КонецЕсли;	
	
	Возврат СхемаОбъекта;
	
КонецФункции	

Функция ПолучитьШаблоныПоИдентификаторуОбъектаМетаданных(ИдентификаторОбъектаМетаданных) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка КАК Ссылка,
	|	Наименование КАК Наименование,
	|	ОбъектНазначения КАК ОбъектНазначения,
	|	Используется КАК Используется,
	|	ИмяКомандыПечати КАК ИмяКомандыПечати,
	|	УсловиеПечати КАК УсловиеПечати,
	|	ТестовыйРежим КАК ТестовыйРежим
	|ИЗ
	|	Справочник.смартШаблоныПечатныхФорм
	|ГДЕ
	|	Используется
	|	И НЕ ЭтоГруппа
	|	И ОбъектНазначения = &ИдентификаторОбъектаМетаданных
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	Запрос.УстановитьПараметр("ИдентификаторОбъектаМетаданных", ИдентификаторОбъектаМетаданных);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Возврат РезультатЗапроса;
	
КонецФункции

Функция ПолучитьШаблонПечатиПоИдентификаторуПечатнойФормы(Идентификатор) Экспорт
	
	УИДСтрока = СтрЗаменить(Идентификатор, "_", "-"); 
	
	Попытка
		СсылкаНаШаблон = Справочники.смартШаблоныПечатныхФорм.ПолучитьСсылку(Новый УникальныйИдентификатор(УИДСтрока));
	Исключение
		СсылкаНаШаблон = Неопределено;
	КонецПопытки;	
	
	Возврат СсылкаНаШаблон;

КонецФункции

Функция ПроверитьУсловиеПечатиШаблона(ОбъектПечати, Шаблон) Экспорт
	
	Результат = Истина;
	
	СтруктураДанныхШаблона = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Шаблон, "УсловиеПечати");
	
	Если ЗначениеЗаполнено(СтруктураДанныхШаблона.УсловиеПечати)
		И НЕ смартРаботаСАлгоритмамиПроверки.АлгоритмПоПредметуВыполняется(ОбъектПечати, СтруктураДанныхШаблона.УсловиеПечати) Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не выполнены условия печати """ 
											  + СокрЛП(СтруктураДанныхШаблона.УсловиеПечати) 
											  + """ по шаблону """ + СокрЛП(Шаблон) + """");
											  
		Результат = Ложь;

	КонецЕсли;
	
	Возврат Результат;
												
КонецФункции

Функция ПроверитьУсловиеПечатиМодуля(ОбъектПечати, УсловиеВидимости) Экспорт
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(УсловиеВидимости)
		И НЕ смартРаботаСАлгоритмамиПроверки.АлгоритмПоПредметуВыполняется(ОбъектПечати, УсловиеВидимости) Тогда
		
		Результат = Ложь;

	КонецЕсли;
	
	Возврат Результат;
												
КонецФункции

Процедура ВставитьРазрывСтраницыWord(ПечатнаяФорма)
	
	МодульРазрывСтраницыWord = Справочники.смартМодулиПечатныхФорм.РазрывСтраницыWord;
	МакетМодуляРазрывСтраницы = смартСерверПривилегированный.ПолучитьДополнительныеДанныеОбъекта(МодульРазрывСтраницыWord);
	МакетРазрывСтраницыWord = смартУправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетМодуляРазрывСтраницы, "");
	
	ОписаниеОбластиРазрывСтраницыWord = Новый Структура("ТипОбласти, ИмяОбласти", "Общая", "РазрывСтраницы");
	ОбластьМакетаРазрывСтраницыWord = смартУправлениеПечатью.ОбластьМакета(МакетРазрывСтраницыWord, ОписаниеОбластиРазрывСтраницыWord);
	смартУправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьМакетаРазрывСтраницыWord, Истина);
	
	смартУправлениеПечатью.ОчиститьСсылки(МакетРазрывСтраницыWord);
	
КонецПроцедуры	

Функция ПолучитьВложенныйМодуль(ОбъектПечати, ВложенныеМодули, ПараметрВложенногоМодуля, СтруктураПараметров)

	Результат = Неопределено;
	
	//Поиск по параметру
	Если ЗначениеЗаполнено(ПараметрВложенногоМодуля) Тогда
		
		ЗначениеПараметраВложенногоМодуля = Неопределено;
		
		Если ПараметрВложенногоМодуля = "Ссылка" Тогда
			ЗначениеПараметраВложенногоМодуля = ОбъектПечати;
		ИначеЕсли СтрНайти(ПараметрВложенногоМодуля, ".") <> 0 Тогда

			Если ЗначениеПараметраВложенногоМодуля = Неопределено Тогда
				Попытка
					ЗначениеПараметраВложенногоМодуля = ПолучитьЧерезТочки(СтруктураПараметров, ПараметрВложенногоМодуля);
				Исключение
					ОписаниеОшибки = ОписаниеОшибки + "|Ошибка обработки параметра: " + ПараметрВложенногоМодуля;
				КонецПопытки;		
			КонецЕсли;
			
			Попытка
				ЗначениеПараметраВложенногоМодуля = ПолучитьЧерезТочки(ОбъектПечати, ПараметрВложенногоМодуля);
			Исключение
				ОписаниеОшибки = ОписаниеОшибки + "|Ошибка обработки параметра: " + ПараметрВложенногоМодуля;
			КонецПопытки;		

		ИначеЕсли СтруктураПараметров.Свойство(СтрЗаменить(ПараметрВложенногоМодуля, " ", "")) Тогда
			ЗначениеПараметраВложенногоМодуля = СтруктураПараметров[СтрЗаменить(ПараметрВложенногоМодуля, " ", "")];
		КонецЕсли;
			
		Если ЗначениеПараметраВложенногоМодуля <> Неопределено Тогда
			Результат = ВложенныеМодули.Найти(ЗначениеПараметраВложенногоМодуля, "ЗначениеПараметра");
		КонецЕсли;
		
	КонецЕсли;	

	Возврат Результат;	
	
КонецФункции		

Функция ТипПоМетаданнымОбъекта(ОбъектМетаданных) Экспорт
	
	ИмяЗначенияПеречисления = ОбъектМетаданных.Имя;
	
	Если Метаданные.Справочники.Найти(ИмяЗначенияПеречисления) <> Неопределено Тогда
		Возврат ТипЗнч(Справочники[ИмяЗначенияПеречисления].ПустаяСсылка());
	ИначеЕсли Метаданные.БизнесПроцессы.Найти(ИмяЗначенияПеречисления) <> Неопределено Тогда
		Возврат ТипЗнч(БизнесПроцессы[ИмяЗначенияПеречисления].ПустаяСсылка());
	ИначеЕсли Метаданные.Документы.Найти(ИмяЗначенияПеречисления) <> Неопределено Тогда
		Возврат ТипЗнч(Документы[ИмяЗначенияПеречисления].ПустаяСсылка());
	КонецЕсли;
	
	ВызватьИсключение НСтр("ru = 'Непредвиденное значение типа объекта, обратитесь к администратору.'");
	
КонецФункции

Процедура ПодобратьОбразецПоОбъектуМетаданных(ОбъектМетаданных) Экспорт
	
	Результат = Неопределено;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПсевдонимЗаданнойТаблицы.Ссылка КАК Ссылка
	|ИЗ
	|	&Таблица КАК ПсевдонимЗаданнойТаблицы
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка УБЫВ";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Таблица", ОбъектМетаданных.ПолноеИмя());
	Запрос = Новый Запрос(ТекстЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Образец = Выборка.Ссылка;
	КонецЕсли;
	
