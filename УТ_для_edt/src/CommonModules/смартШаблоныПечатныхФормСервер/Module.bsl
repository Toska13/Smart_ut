КонецПроцедуры

Функция ПолучитьИмяОбластиИзПараметров(ИмяОбластиПечати, Знач ПараметрОбласти, Знач СтруктураПараметры)
	
	Если СтруктураПараметры.Свойство(ПараметрОбласти) Тогда
		ИмяОбластиПечати = СтруктураПараметры[ПараметрОбласти];
	КонецЕсли;

	Если СтруктураПараметры.Свойство("СтрокаКоллекции")
		И (ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Соответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("Структура")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированноеСоответствие")
		   ИЛИ ТипЗнч(СтруктураПараметры.СтрокаКоллекции) = Тип("ФиксированнаяСтруктура")) Тогда
		
		Если СтруктураПараметры.СтрокаКоллекции.Свойство(ПараметрОбласти) Тогда
			ИмяОбластиПечати = СтруктураПараметры.СтрокаКоллекции[ПараметрОбласти];
		КонецЕсли;
		
	КонецЕсли;	
	
