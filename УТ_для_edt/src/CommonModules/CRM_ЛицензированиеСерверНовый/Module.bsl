
#Область ПрограммныйИнтерфейс

Функция ПолучитьЗащищеннуюОбработку(ВыводитьОшибки = Истина) Экспорт
	
	ОписаниеОшибки = "";
	
	ОбработкаЗащиты = слкМенеджерЗащиты.СоздатьОбъект(
		"52BA",
		"CRM_ФайлДанныхОРСР_КОРП_Новый.CRM_ЗащищеннаяОбработка_КОРП",
		ОписаниеОшибки);
		
	Если ОписаниеОшибки <> "" Тогда
		// BSLLS:UnusedLocalVariable-off
		КлассИсключения = CRM_ЛицензированиеСервер.ПолучитьКлассИсключения(ОписаниеОшибки);
		// BSLLS:UnusedLocalVariable-on
		Если ВыводитьОшибки Тогда
			ВызватьИсключение ОписаниеОшибки;
		Иначе
			Возврат Неопределено;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ОбработкаЗащиты;
	
КонецФункции

Функция ПодсистемаCRMИспользуется() Экспорт
	Возврат ПараметрыСеанса.CRM_ИспользоватьCRM;
КонецФункции

#КонецОбласти
