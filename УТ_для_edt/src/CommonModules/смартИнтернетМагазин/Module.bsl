Функция СоздатьИзменитьПодписки(Данные,Ресурс)
	
	Если Не ТипЗнч(Данные.result)=Тип("Структура") ИЛИ НЕ Данные.result.свойство("Data") ИЛИ Данные.result.Data.Количество()=0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	МассивПараметров=Новый Массив;
	
	СсылкаПредопределенноеЗначение = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.СерверВыгрузки");
	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначение, Ложь);
	ТЗизМассива=ПреобразоватьМассивВТаблицуЗначений(Данные.result.Data);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.ID КАК ID,
	|	ТЗ.NAME КАК NAME,
	|	ТЗ.USER_ID КАК USER_ID,
	|	ТЗ.EXTERNAL_USER_ID КАК EXTERNAL_USER_ID,
	|	ТЗ.IBLOCK_ELEMENT_CODE КАК IBLOCK_ELEMENT_CODE,
	|	ТЗ.DATE_CHANGE КАК DATE_CHANGE,
	|	ТЗ.IMPORT_DATE КАК IMPORT_DATE,
	|	ТЗ.IMPORTED КАК IMPORTED,
	|	ТЗ.STATUS КАК STATUS
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ID КАК ID,
	|	ВТ.NAME КАК NAME,
	|	ВЫРАЗИТЬ(ВТ.USER_ID КАК СТРОКА(200)) КАК USER_ID,
	|	ВТ.EXTERNAL_USER_ID КАК EXTERNAL_USER_ID,
	|	ВЫРАЗИТЬ(ВТ.IBLOCK_ELEMENT_CODE КАК СТРОКА(25)) КАК IBLOCK_ELEMENT_CODE,
	|	ВТ.DATE_CHANGE КАК DATE_CHANGE,
	|	ВТ.IMPORT_DATE КАК IMPORT_DATE,
	|	ВТ.IMPORTED КАК IMPORTED,
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(ВТ.STATUS КАК СТРОКА(200))) = ""0""
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК STATUS,
	|	СмартИдентификаторыСоответствияБитрикс.СсылкаМет КАК USER,
	|	ЕСТЬNULL(смартРассылкиБитрикс.Ссылка, ЗНАЧЕНИЕ(Справочник.смартРассылкиБитрикс.ПустаяСсылка)) КАК SUBSCRIBE
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартИдентификаторыСоответствияБитрикс КАК СмартИдентификаторыСоответствияБитрикс
	|		ПО ((ВЫРАЗИТЬ(ВТ.USER_ID КАК СТРОКА(200))) = СмартИдентификаторыСоответствияБитрикс.ИДсайта
	|				ИЛИ (ВЫРАЗИТЬ(ВТ.EXTERNAL_USER_ID КАК СТРОКА(200))) = СмартИдентификаторыСоответствияБитрикс.ГУИД)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартРассылкиБитрикс КАК смартРассылкиБитрикс
	|		ПО ((ВЫРАЗИТЬ(ВТ.IBLOCK_ELEMENT_CODE КАК СТРОКА(25))) = смартРассылкиБитрикс.Код)";
	
	Запрос.УстановитьПараметр("ТЗ",ТЗизМассива);
	ТЗСПользователями = Запрос.Выполнить().Выгрузить();
	
	Если ТЗСПользователями.Количество()>0 Тогда
		НаборЗаписей=РегистрыСведений.смартИсторияПодписокНаРассылки.СоздатьНаборЗаписей();
		Соединение=Новый HTTPСоединение(Сервер,,,,,,Новый ЗащищенноеСоединениеOpenSSL());// "smart-t.testfact2.ru/"
		
		Для Каждого Эл Из ТЗСПользователями Цикл
			
			//НаборЗаписей.Отбор.Период.Установить(ТекущаяДатаСеанса());
			//НаборЗаписей.Отбор.ID.Установить(Эл.ID);
			НовЭлемент=Справочники.смартРассылкиБитрикс.ПустаяСсылка();
			Если НЕ ЗначениеЗаполнено(Эл.SUBSCRIBE) Тогда
				НовЭлемент=Справочники.смартРассылкиБитрикс.СоздатьЭлемент();
				НовЭлемент.Код=Эл.IBLOCK_ELEMENT_CODE;
				НовЭлемент.Наименование=Эл.NAME;
				НовЭлемент.Записать();
			иначе
				Если Эл.SUBSCRIBE.Наименование<>Эл.NAME Тогда
					НовЭлемент=Эл.SUBSCRIBE.ПолучитьОбъект();
					НовЭлемент.Наименование=Эл.NAME;
					НовЭлемент.Записать();
				КонецЕсли; 
			КонецЕсли;
			
			ЗаписьНабора=НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаписьНабора,Эл);
			Если НовЭлемент<>Справочники.смартРассылкиБитрикс.ПустаяСсылка() Тогда
				ЗаписьНабора.SUBSCRIBE=НовЭлемент;
			КонецЕсли; 
			ЗаписьНабора.Период=ТекущаяДатаСеанса();
			
			//https://smart-t.testfact2.ru/rest/1/<token>/api.subscriptions.import.success/?ID=523
			Запрос=Новый HTTPЗапрос("rest/1/c3jq3eiu1fbmi0il/api.subscriptions.import.success/");
			Запрос.УстановитьТелоИзСтроки("ID="+Эл.ID);
			ДанныеОтвета=Соединение.ОтправитьДляОбработки(Запрос);
		КонецЦикла;	
		
		НаборЗаписей.Записать();
		
		Данные=ПолучитьДанныеССайта(Ресурс);
		Возврат СоздатьИзменитьПодписки(Данные,Ресурс);
		
	КонецЕсли; 

	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции 

