	Если Параметры.Ресурс="order" Тогда 
		ВыполнитьОбменЗаказамиССайтом();
		//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 15.03.2021 11:27:29  чтоб не приходила ошибка на почту
		Возврат;
		//Смарт }Подкин Алексей Иванович 15.03.2021 11:27:29
	КонецЕсли;	
	Данные=ПолучитьДанныеССайта(Параметры.Ресурс);
	
	ПараметрыДляОтвета=Неопределено;
    Если Параметры.Ресурс="contragent" Тогда
        ТестПолученияЗапросаНаПолучениеНовыхДанных(Новый Структура("ВходныеДанныеДоОбработки",Данные),Параметры.Ресурс);
        ПараметрыДляОтвета=СоздатьИзменитьКонтрагентов(Данные,Параметры.Ресурс);
	ИначеЕсли Параметры.Ресурс="user" Тогда
		ТестПолученияЗапросаНаПолучениеНовыхДанных(Новый Структура("ВходныеДанныеДоОбработки",Данные),Параметры.Ресурс);
		//++ #Б-1148 смарт: Лопато 16.10.2024 //ИМ. Регистрация пользователей на сайте. Переключатель режимов  
		Если НЕ Справочники.смартПредопределенныеЗначения.Настройки.НовыйРежимРегистрацииПользователейИМ Тогда
			ПараметрыДляОтвета = СоздатьИзменитьПользователяИнтернетМагазина(Данные, Параметры.Ресурс);
		КонецЕсли;	
		//-- 1148 смарт: Лопато 16.10.2024	
	ИначеЕсли Параметры.Ресурс="subscriptions" Тогда
		ПараметрыДляОтвета=СоздатьИзменитьПодписки(Данные,Параметры.Ресурс);
	КонецЕсли;	
	
	// это для теста
	//	ТестПолученияЗапросаНаПолучениеНовыхДанных(Новый Структура("ВходныеДанные",Данные),Параметры.Ресурс);  //Новый Структура("ВходныеДанные,Результат",Данные,ПараметрыДляОтвета)
КонецПроцедуры                                                                                               

#КонецОбласти

#Область Контрагенты

Функция СоздатьИзменитьКонтрагентов(Данные,Ресурс)
	Если Не ТипЗнч(Данные.result)=Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	МассивПараметров=Новый Массив;
	Для Каждого Эл Из Данные.result Цикл
		ЮрФизЛицо=ПредопределенноеЗначение("Перечисление.ЮрФизЛицо."+Эл.UF_YURFIZLITSO);
        Контрагент=ПолучитьОбъектИзБазы(Эл,"Контрагент",ЮрФизЛицо=Перечисления.ЮрФизЛицо.ФизЛицо);
		Если Контрагент=Неопределено Тогда
			Контрагент=Справочники.Контрагенты.СоздатьЭлемент();
		Иначе
			Контрагент=Контрагент.ПолучитьОбъект();
		КонецЕсли;
		
		Контрагент.ИНН=Эл.UF_INN;
		Контрагент.КПП=Эл.UF_KPP;
		Контрагент.Наименование=Эл.UF_NAME;
		Контрагент.НаименованиеПолное=Эл.UF_NAME;
		Контрагент.ЮрФизЛицо=ЮрФизЛицо;
		Контрагент.ОбособленноеПодразделение=?(Эл.UF_OBOSOBLENNOEPODRA="1",Истина,Ложь);
		Контрагент.ГоловнойКонтрагент=?(Контрагент.ОбособленноеПодразделение,
		Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(Эл.UF_GOLOVNOYKONTRAGEN)),
		Неопределено);
		
		Если Эл.UF_PARTNER="" Тогда
			Продолжить;
		КонецЕсли;
		 
		Контрагент.Партнер=Справочники.Партнеры.ПолучитьСсылку(Новый УникальныйИдентификатор(Эл.UF_PARTNER));
		Контрагент.РегистрационныйНомер=Эл.UF_REGISTRATSIONNYYN;
		Контрагент.СтранаРегистрации=ПолучитьСтрануРегистрации(Эл.UF_STRANAREGISTRATSI);
		ЗаполнитьКонтактнуюИнформациюОбъекта(Контрагент,Эл);
		Если Не Контрагент.Партнер.Пустая() Тогда 
			ЗаполнитьМенеджераПартнера(Контрагент.Партнер,Эл.UF_GUIDMENEDZHERA);
		КонецЕсли;	
		//Контрагент.ОбменДанными.Загрузка=Истина;
		Попытка
			Контрагент.Записать();
			
			ОтветСайту=Новый Структура("ID,XML_ID",Эл.ID,XMLСтрока(Контрагент.Ссылка));
			ЗаполнитьДопСвойствоОбъекта(Контрагент.Ссылка,Эл.ID);
			//ОтправитьДанныеОЗаписиОбъекта(Ресурс+".import.success",ОтветСайту);
			// Пробуем отправить данные методом POST
			СсылкаПредопределенноеЗначение = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.СерверВыгрузки");
			Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначение, Ложь);
			Соединение=Новый HTTPСоединение(Сервер,,,,,,Новый ЗащищенноеСоединениеOpenSSL());//"smart-t.testfact2.ru/"
			Запрос=Новый HTTPЗапрос("rest/1/c3jq3eiu1fbmi0il/api.contragent.import.success/");
			Запрос.УстановитьТелоИзСтроки("ID="+ОтветСайту.ID+"&XML_ID="+ОтветСайту.XML_ID);
			ДанныеОтвета=Соединение.ОтправитьДляОбработки(Запрос);
			ОтветСайту.Вставить("ДанныеОтвета",ДанныеОтвета);
			ДобавитьЗаписьВИдентификаторыСообветствияБитрикс(Контрагент.Ссылка,ОтветСайту);
		Исключение
			ЗаписьЖурналаРегистрации("Ошибка записи контрагента или ошибка отравки ответа на сайт",,,Контрагент.Ссылка);
		КонецПопытки;
		Если ЗначениеЗаполнено(Эл.UF_PASPDANNYEFL) Тогда
			ЗаполнитьПаспортныеДанныеОбъекта(Контрагент.Ссылка,Эл.UF_PASPDANNYEFL);
		КонецЕсли;	
		
		МассивПараметров.Добавить(ОтветСайту); // Это для теста
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат МассивПараметров;  // Это для теста
КонецФункции

#КонецОбласти

#Область Пользователи
//Создание изменение пользователей в 1с.
//++#1209 смарт: Лопато 20.01.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Функция СоздатьИзменитьПользователяИнтернетМагазина(Данные,Ресурс)
	
	Если Не ТипЗнч(Данные.result) = Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МассивПараметров = Новый Массив;
	
	СсылкаПредопределенноеЗначение = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.СерверВыгрузки");
	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначение, Ложь);
	Соединение = Новый HTTPСоединение(Сервер,,,,,,Новый ЗащищенноеСоединениеOpenSSL());// "smart-t.testfact2.ru/"

	Для Каждого Эл Из Данные.result Цикл
		
		ЗаписьЖурналаРегистрации("Обработка контактного лица!",,,Эл.LOGIN,Эл.NAME);

		//КонтактноеЛицо = Неопределено;
		Контрагент = Неопределено;
		Партнер = Неопределено;
		
		//Поиск по регистру сопоставления   
		КонтактноеЛицо = ПолучитьОбъектИзБазы(Эл, "Пользователь", Истина);
        
		//Поиск по логину**************************************************************************
		Если КонтактноеЛицо = Неопределено и (ЗначениеЗаполнено(Эл.LOGIN) ИЛИ ЗначениеЗаполнено(Эл.EMAIL)) Тогда
			КонтактноеЛицо = КонтактноеЛицоПоЛогинуЭлПочте(СокрЛП(Эл.LOGIN), СокрЛП(Эл.EMAIL))
		КонецЕсли; 
		
		//********************************************************************************************
		//Если ЭЛ.FULL_IMPORT="1" И ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		//	ОтветСайту=Новый Структура("ID,XML_ID,IMPORT_PROCESSED",Эл.ID,XMLСтрока(КонтактноеЛицо.Ссылка),1);
		//Иначе	
		
		//Поиск контрагента
		Контрагент = Неопределено;
		
		Если ЗначениеЗаполнено(Эл.B2B_USER) И Эл.B2B_USER = "N" Тогда
			//Розничный покупатель
			//++ #5264 смарт: Тимофеева 16.12.2025 / Обмен с Битрикс. Удалить код
			//Узел = Справочники.смартПредопределенныеЗначения.УзелОбменаЗаказамиБитрикс.Значение;
		    Узел = Неопределено;
			//-- #5264 смарт: Тимофеева 16.12.2025 

			Если Не ЗначениеЗаполнено(Узел) Тогда 
				
				ЗаписьЖурналаРегистрации("ОшибкаПоискаУЗла",,,,"Не найден узел при добавлении пользователя в 1с,смартИнтернетМагазин-СоздатьИзменитьПользователяИнтернетМагазина.");
				
			Иначе	

				ОсновныеПараметры = Новый Структура;
				НастройкиУспешноДобавлены = Б_ОбменССайтомСервер.ДобавитьОсновныеНастройкиВПараметры(Узел, ОсновныеПараметры);
				НастройкиУспешноДобавлены = Б_ОбменССайтомСервер.ДобавитьНастройкиОбменаВПараметры(Узел, ОсновныеПараметры);
				
				Если ЗначениеЗаполнено(ОсновныеПараметры.КонтрагентФизлицо) Тогда	
					Контрагент = ОсновныеПараметры.КонтрагентФизлицо; 	
				КонецЕсли;
				
			КонецЕсли;	
		Иначе
			Контрагент = СмартНайтиКонтрагента(Эл);
		КонецЕсли; 

		Если ЗначениеЗаполнено(КонтактноеЛицо) 
			И КонтактноеЛицо.Владелец = Справочники.Партнеры.НеизвестныйПартнер Тогда
			
			КонтактноеЛицо = Неопределено;
			
		КонецЕсли;	

		//********************************************************************************************
		НачатьТранзакцию();
		
		//блокировка регистра сведений                                                      l
		Блокировка = Новый БлокировкаДанных; 

		Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СмартИдентификаторыСоответствияБитрикс"); 
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; 
			ЭлементБлокировки.УстановитьЗначение("СсылкаМет", КонтактноеЛицо); 
			
			ВторойЭлементБлокировки = Блокировка.Добавить("Справочник.КонтактныеЛицаПартнеров"); 
			ВторойЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; 
			ВторойЭлементБлокировки.УстановитьЗначение("Ссылка", КонтактноеЛицо); 

		КонецЕсли;

		Если ЗначениеЗаполнено(Контрагент) Тогда
		
			ТретийЭлементБлокировки = Блокировка.Добавить("Справочник.Контрагенты"); 
			ТретийЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; 
			ТретийЭлементБлокировки.УстановитьЗначение("Ссылка", Контрагент); 
			
			КонтрагентОбъект = Контрагент.ПолучитьОбъект();
			
		Иначе
			
			КонтрагентОбъект = Неопределено;
			Контрагент = Неопределено;
			
		КонецЕсли;
			
		Блокировка.Заблокировать(); 	
		
		//Проверка создание партнера контрагента контактного лица
		Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда

			КонтактноеЛицоОбъект = КонтактноеЛицо.ПолучитьОбъект();
			
			Если КонтактноеЛицо.Владелец = Справочники.Партнеры.НеизвестныйПартнер Тогда
				//1 колонка
				КонтактноеЛицо = Неопределено;
				
				ЗаписьЖурналаРегистрации("Ошибка контактного лица - неизвестный партнер",,,Эл.LOGIN,Эл.NAME);
				
				смартОтправитьОшибкуНаПочту("Ошибка регистрации контактного лица - владелец неопределенный партнер: " + Эл.LOGIN + ", " + Эл.NAME);
				
				Продолжить;

			ИначеЕсли ЗначениеЗаполнено(КонтактноеЛицо.Владелец) Тогда
				//2 колонка
 				Если ЗначениеЗаполнено(Контрагент) Тогда
					Если Контрагент.Партнер = Справочники.Партнеры.НеизвестныйПартнер Тогда
						//1-2
						КонтрагентОбъект.Партнер = КонтактноеЛицо.Владелец;
						
					ИначеЕсли ЗначениеЗаполнено(Контрагент.Партнер) Тогда
						//2-2
					КонецЕсли;	
				Иначе
	                    //3-2
						КонтрагентОбъект = смартСоздатьКонтрагента(Эл);
						
						КонтрагентОбъект.Партнер = КонтактноеЛицо.Владелец;
						
				КонецЕсли;	
			КонецЕсли;
		Иначе
				//3 колонка
				КонтактноеЛицоОбъект = Справочники.КонтактныеЛицаПартнеров.СоздатьЭлемент();
				КонтактноеЛицоОбъект.Комментарий = "#Загружено с сайта";
				
	 			Если ЗначениеЗаполнено(Контрагент) Тогда
					Если Контрагент.Партнер = Справочники.Партнеры.НеизвестныйПартнер Тогда
						//1-3
						Партнер = смартСоздатьПартнера(Эл, Контрагент);
						
						КонтрагентОбъект.Партнер = Партнер;

						КонтактноеЛицоОбъект.Владелец = Партнер;
						
					ИначеЕсли ЗначениеЗаполнено(Контрагент.Партнер) Тогда
						//2-3
						КонтактноеЛицоОбъект.Владелец = Контрагент.Партнер;
					КонецЕсли;	
				Иначе
	                    //3-3
						КонтрагентОбъект = смартСоздатьКонтрагента(Эл);
						
						Партнер = смартСоздатьПартнера(Эл, Контрагент);

						КонтрагентОбъект.Партнер = Партнер;
						
						КонтактноеЛицоОбъект.Владелец = Партнер;
						
				КонецЕсли;
					
		КонецЕсли;

		//********************************************************************************************
		
		КонтактноеЛицоОбъект.ОбменДанными.Загрузка = Истина;
		
		смартЗаполнитьКонтактноеЛицоДаннымиСайта(КонтактноеЛицоОбъект, Эл);
        смартЗаписатьКонтактнуюИнформациюКонтактногоЛица(КонтактноеЛицоОбъект, Эл);
		
		//++ #1912 смарт: Лопато 26.08.2024 //Синхронизация связки Пользователь + Партнер  
		КонтактноеЛицоОбъект.ДополнительныеСвойства.Вставить("смартЗаписьВерсииОбъектаПриЗагрузке");
		//-- #1912 смарт: Лопато 26.08.2024

		//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
		КонтактноеЛицоОбъект.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
		//-- #Б-1138 смарт: Лопато 15.10.2024
		
		Попытка
			КонтактноеЛицоОбъект.Записать();
			КонтактноеЛицо = КонтактноеЛицоОбъект.Ссылка;
		Исключение
			КонтактноеЛицо = Неопределено;
		КонецПопытки;	
		
		//********************************************************************************************
		
		Если КонтрагентОбъект <> Неопределено Тогда
			смартЗаписатьКонтактнуюИнформациюКонтрагента(КонтрагентОбъект, Эл);
			Попытка
				КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
				//++ #1912 смарт: Лопато 26.08.2024 //Синхронизация связки Пользователь + Партнер  
				КонтрагентОбъект.ДополнительныеСвойства.Вставить("смартЗаписьВерсииОбъектаПриЗагрузке");
				//-- #1912 смарт: Лопато 26.08.2024
				//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
				КонтрагентОбъект.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
				//-- #Б-1138 смарт: Лопато 15.10.2024
				КонтрагентОбъект.Записать();
				Контрагент = КонтрагентОбъект.Ссылка;
			Исключение
				Контрагент = Неопределено;
			КонецПопытки;
		Иначе	
			Контрагент = Неопределено;
		КонецЕсли;
		
		//********************************************************************************************
		
		//отправка ошибок
		Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
			ЗаписьЖурналаРегистрации("Ошибка создания контактного лица",,,Эл.LOGIN,Эл.NAME);
			смартОтправитьОшибкуНаПочту("Ошибка создания контактного лица: " + Эл.LOGIN + ", " + Эл.NAME);
			Продолжить;
		КонецЕсли; 
			
		Если НЕ ЗначениеЗаполнено(КонтактноеЛицо.Владелец) Тогда
			МассивПараметров.Добавить(Новый Структура("Ошибка", "Партнер не был создан"));
			смартОтправитьОшибкуНаПочту("Ошибка создания партнера: " + Эл.COMPANY_NAME + ", " + Эл.COMPANY_EMAIL);
			Продолжить;
		КонецЕсли;		

		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
			МассивПараметров.Добавить(Новый Структура("Ошибка", "Контрагент не был создан"));
			смартОтправитьОшибкуНаПочту("Ошибка создания еонтрагента: " + Эл.COMPANY_NAME + ", " + Эл.COMPANY_EMAIL);
			Продолжить;
		КонецЕсли;		
		
		//Проверить дубль
