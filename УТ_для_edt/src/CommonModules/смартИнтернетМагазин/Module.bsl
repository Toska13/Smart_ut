//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
// Формирует массив интернет-заказов для распределения или оповещает по почте по условиям.
//
// Параметры:
//	ОправлятьОповещения - Булево - признак надо ли отправлять оповещения
//	Источник - Объект заказа клиета или массив ссылок заказов клиента
//
// Возвращаемое значение:
//	Массив - ссылки на заказы клиента.
//
Функция ПолучитьМассивИнтернетЗаказовДляРаспределенияИлиОповестить(ОтправлятьОповещения = Ложь, Источник = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ЗаказыДляОповещения = Новый Массив;
	ЗаказыДляРаспределения = Новый Массив;
	
	//Проверка активности функционала распределения и оповещения
	ФункционалВключен = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаВключено;
	
	Если НЕ ФункционалВключен Тогда
		Возврат ЗаказыДляРаспределения;
	КонецЕсли;	
	
	//Получение необработанных онлайн-заказов
	МассивОбеспечений = Новый Массив;
	МассивОбеспечений.Добавить(Перечисления.ВариантыОбеспечения.Требуется);
	МассивОбеспечений.Добавить(Перечисления.ВариантыОбеспечения.НеТребуется);
	
	СвойствоОффлайнЗаказ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ОффлайнЗаказ");
    ЗначениеОффлайнЗаказ = "N";
	
	ЦФО 	 = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаБизнесРегионЦФО;
	СуммаЦФО = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаСуммаЦФО;
	
	СтруктураПараметровЗапроса = Новый Структура;
    СтруктураПараметровЗапроса.Вставить("Источник", 			Источник);
    СтруктураПараметровЗапроса.Вставить("МассивОбеспечений", 	МассивОбеспечений);
    СтруктураПараметровЗапроса.Вставить("СвойствоОффлайнЗаказ", СвойствоОффлайнЗаказ);
    СтруктураПараметровЗапроса.Вставить("ЗначениеОффлайнЗаказ", ЗначениеОффлайнЗаказ);
	
	Если Источник = Неопределено 
		ИЛИ ТипЗнч(Источник) = Тип("Массив") Тогда
	
		РезультатНеобработанныеЗаказы = ПолучитьНеобработанныеИнтернетЗаказыИзБазы(СтруктураПараметровЗапроса);
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		
		РезультатНеобработанныеЗаказы = ПолучитьНеобработанныеИнтернетЗаказыПоОбъекту(СтруктураПараметровЗапроса);
		
		//++ #Б-3034 смарт: Лопато 25.07.2025 //Изменение алгоритма заполнения менеджера в Онлайн Заказе клиента  
		ПользовательИнтернетМагазина = Справочники.смартПредопределенныеЗначения.ПользовательИнтернетМагазина.Значение;
		
		ЗаказБизнесРегион = Источник.Партнер.БизнесРегион;
		ЗаказСуммаТовары =  Источник.Товары.Итог("Сумма");
		
		Если Источник.Менеджер = ПользовательИнтернетМагазина
		    И НЕ (Источник.ПометкаУдаления 
  				  ИЛИ (Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт
				 	   И Источник.СуммаДокумента = 0)) Тогда
									
			Если (ЗаказБизнесРегион = ЦФО
				      ИЛИ ЗаказБизнесРегион.ПринадлежитЭлементу(ЦФО))
			      И ЗаказСуммаТовары <= СуммаЦФО Тогда
				  
				Если ЗначениеЗаполнено(Источник.Партнер) Тогда  
				  
					//когда в заказе только расходные материалы, подставляется действующий менеджер клиента по расходным материалам.*
					//когда в заказе только запчасти, подставляется действующий менеджер по запчастям.*
					//когда в заказе запчасти + расходные материалы, будет назначен действующий менеджер СЦ* или Расходных материалов*, в зависимости, сумма какого направления будет больше.
					//Важно! Если, например, сумма запчастей будет выше, а у клиента нет действующего менеджера СЦ, но есть действующий менеджер по расходным материалам, будет назначен он. И наоборот.

					//*действующим считается менеджер, статус которого "Закреплен" или "Ведется работа", если статус менеджера "Свободен", остается менеджер "shop".
					  
					Запрос = Новый Запрос;
					
					Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
					|	Партнер КАК Партнер,
					|	ВЫБОР
					|		КОГДА Состояние = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|				ИЛИ Состояние = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК Действует,
					|	ВЫБОР
					|		КОГДА СостояниеСЦ = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|				ИЛИ СостояниеСЦ = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК ДействуетСЦ,
					|	ВЫБОР
					|		КОГДА СостояниеРМ = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|				ИЛИ СостояниеРМ = ЗНАЧЕНИЕ(Перечисление.смартСостоянияПартнеров.Закреплен)
					|			ТОГДА ИСТИНА
					|		ИНАЧЕ ЛОЖЬ
					|	КОНЕЦ КАК ДействуетРМ,
					|	Партнеры.смартОсновнойМенеджерСервисЦентра КАК смартОсновнойМенеджерСервисЦентра,
					|	Партнеры.смартМенеджерПоРасходнымМатериалам КАК смартМенеджерПоРасходнымМатериалам
					|ИЗ
					|	РегистрСведений.смартСостояниеПартнеров
					|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
					|		ПО Партнер = Партнеры.Ссылка
					|ГДЕ
					|	Партнер = &Партнер";
 					
					Запрос.УстановитьПараметр("Партнер", Источник.Партнер);
					
					ВыборкаПартнер = Запрос.Выполнить().Выбрать();
					
					Если ВыборкаПартнер.Следующий() Тогда
							
						ДействуетМенеджерСЦ = ВыборкаПартнер.ДействуетСЦ 
											  И ЗначениеЗаполнено(ВыборкаПартнер.смартОсновнойМенеджерСервисЦентра);
											  
						ДействуетМенеджерРМ = ВыборкаПартнер.ДействуетРМ 
											  И ЗначениеЗаполнено(ВыборкаПартнер.смартМенеджерПоРасходнымМатериалам);

						МассивЗапчасти 			 = Новый Массив;
						МассивРасходныеМатериалы = Новый Массив;	
						
						СуммаЗапчасти			= 0;
						СуммаРасходныеМатериалы = 0;
						
						СегментЗапчасти = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментЗапчасти");
						СегментРасходныеМатериалы = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментРасходныеМатериалы");

						Для Каждого СтрТовары Из Источник.Товары Цикл
							
							Если ЗначениеЗаполнено(СегментЗапчасти) Тогда
								Если СегментыСервер.ВходитВСегмент(СтрТовары.Номенклатура, СегментЗапчасти,, СегментЗапчасти.СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьДинамически) Тогда
									СуммаЗапчасти = СуммаЗапчасти + СтрТовары.Сумма;
								КонецЕсли;
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СегментРасходныеМатериалы) Тогда
								Если СегментыСервер.ВходитВСегмент(СтрТовары.Номенклатура, СегментРасходныеМатериалы,, СегментРасходныеМатериалы.СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьДинамически) Тогда
									СуммаРасходныеМатериалы = СуммаРасходныеМатериалы + СтрТовары.Сумма;
								КонецЕсли;
							КонецЕсли;
						
						КонецЦикла;	
						
						Если ДействуетМенеджерСЦ 
							И СуммаЗапчасти = Источник.Товары.Итог("Сумма") Тогда
							
							Источник.Менеджер = ВыборкаПартнер.смартОсновнойМенеджерСервисЦентра;
							
						ИначеЕсли ДействуетМенеджерРМ 
							И СуммаРасходныеМатериалы = Источник.Товары.Итог("Сумма") Тогда

							Источник.Менеджер = ВыборкаПартнер.смартМенеджерПоРасходнымМатериалам;
							
						Иначе
							
							Если СуммаЗапчасти > СуммаРасходныеМатериалы Тогда

								Если ДействуетМенеджерСЦ Тогда
									Источник.Менеджер = ВыборкаПартнер.смартОсновнойМенеджерСервисЦентра;
								ИначеЕсли ДействуетМенеджерРМ Тогда
									Источник.Менеджер = ВыборкаПартнер.смартМенеджерПоРасходнымМатериалам;
								КонецЕсли;
								
							ИначеЕсли СуммаРасходныеМатериалы > СуммаЗапчасти Тогда	

								Если ДействуетМенеджерРМ Тогда
									Источник.Менеджер = ВыборкаПартнер.смартМенеджерПоРасходнымМатериалам;
								ИначеЕсли ДействуетМенеджерСЦ Тогда
									Источник.Менеджер = ВыборкаПартнер.смартОсновнойМенеджерСервисЦентра;
								КонецЕсли;

							КонецЕсли;	
								
						КонецЕсли;	
						
					КонецЕсли;	
						
				КонецЕсли;
				
			Иначе

				ТекущийПользователь = Пользователи.АвторизованныйПользователь();
				
				Если Источник.Товары.Количество() > 0
					И ТекущийПользователь <> ПользовательИнтернетМагазина Тогда
				
					//- На все товары проставлен статус обеспечения Резервировать; Резервировать к дате; Отгрузить
					//- Текущий статус заказа на сайте "В обработке"										

					Запрос = Новый Запрос;
					
					Запрос.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	СтатусЗаказа КАК СтатусЗаказа
					|ИЗ
					|	РегистрСведений.смартСтатусыЗаказовБитрикс
					|ГДЕ
					|	СсылкаМет = &Заказ";
					
					Запрос.УстановитьПараметр("Заказ", Источник.Ссылка);
					
					ВыборкаСтатус = Запрос.Выполнить().Выбрать();
					
					Если ВыборкаСтатус.Следующий()
						И ВыборкаСтатус.СтатусЗаказа = Перечисления.смартСтатусыЗаказовБитриксЗначения.ВОбработке Тогда
						
						СтатусТоваровПодходит = Истина;
						
						Для Каждого СтрТовары Из Источник.Товары Цикл
							
							Если НЕ (СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить
									 ИЛИ СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно
									 ИЛИ СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада
									 ИЛИ СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ИзЗаказов) Тогда
									
								СтатусТоваровПодходит = Ложь;
								
							КонецЕсли;	
							
						КонецЦикла;	
						
						Если СтатусТоваровПодходит Тогда
							
							Источник.Менеджер = ТекущийПользователь;
							
						КонецЕсли;	
						
					КонецЕсли;	

				КонецЕсли;	
					
			КонецЕсли;	

		КонецЕсли;	
		//-- #Б-3034 смарт: Лопато 25.07.2025
		
	Иначе
		
		Возврат ЗаказыДляРаспределения;
		
	КонецЕсли;	
	
	Если РезультатНеобработанныеЗаказы.Количество() = 0 Тогда
		Возврат ЗаказыДляРаспределения;
	КонецЕсли;	
	
	//++ #Б-5924 смарт: Фролов 19.03.2026 //Доработать схему распределения онлайн заказов
	СегментЗапчасти = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментЗапчасти");
	//-- #Б-5942 смарт: Фролов 19.03.2026
	
	//Обработка условий распределения или оповещения
	Для Каждого СтрокаЗаказ Из РезультатНеобработанныеЗаказы Цикл
		
		//++ #Б-5924 смарт: Фролов 19.03.2026 //Доработать схему распределения онлайн заказов
		ЕстьЗапчасти = Ложь;
		
		Если ЗначениеЗаполнено(СегментЗапчасти) Тогда
			Для Каждого СтрТовары Из СтрокаЗаказ.Заказ.Товары Цикл
				
				Если СегментыСервер.ВходитВСегмент(СтрТовары.Номенклатура, СегментЗапчасти,, СегментЗапчасти.СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьДинамически) Тогда
					
					ЕстьЗапчасти = Истина;
					Прервать;
					
				КонецЕсли;
								
			КонецЦикла;
		КонецЕсли;
		//-- #Б-5942 смарт: Фролов 19.03.2026
		
		Если (СтрокаЗаказ.БизнесРегион = ЦФО
			      ИЛИ СтрокаЗаказ.БизнесРегион.ПринадлежитЭлементу(ЦФО))
			  //++ #Б-5924 смарт: Фролов 19.03.2026 //Доработать схему распределения онлайн заказов	  
			  //И СтрокаЗаказ.СуммаТовары <= СуммаЦФО Тогда
			  И СтрокаЗаказ.СуммаТовары <= СуммаЦФО И НЕ ЕстьЗапчасти Тогда
			  //-- #Б-5942 смарт: Фролов 19.03.2026
			  
			Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") Тогда			  
				ЗаказыДляОповещения = Источник;
			Иначе	
				ЗаказыДляОповещения.Добавить(СтрокаЗаказ.Заказ);
			КонецЕсли;

		Иначе
			
			//Проверка, что заказ не помечен на удаление и не отменен
			Если НЕ (СтрокаЗаказ.ПометкаУдаления
					 	ИЛИ (СтрокаЗаказ.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт
							 	И СтрокаЗаказ.СуммаДокумента = 0)) Тогда
				
				ЗаказыДляРаспределения.Добавить(СтрокаЗаказ.Заказ);
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	//Отправка оповещения
	Если ОтправлятьОповещения Тогда
		
		ОтправитьОповещениеПоОнлайнЗаказам(ЗаказыДляОповещения);
		
	КонецЕсли;	
	
	//Возврат массива заказов для распределения
	Возврат ЗаказыДляРаспределения;
	
КонецФункции //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Функция ПолучитьНеобработанныеИнтернетЗаказыИзБазы(СтруктураПараметровЗапроса)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) КАК Заказ
		|ПОМЕСТИТЬ ОнлайнЗаказы
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения
		|ГДЕ
		|	НЕ ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента).ПометкаУдаления
		|	И Свойство = &Свойство
		|	И Значение = &Значение
		|   И &ОтборПоЗаказам
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЗаказТовары.Ссылка КАК Заказ
		|ПОМЕСТИТЬ ОнлайнЗаказыНеОбеспеченные
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказы
		|		ПО ОнлайнЗаказы.Заказ = ЗаказТовары.Ссылка
		|ГДЕ
		|	(ЗаказТовары.ВариантОбеспечения В (&СписокОбеспечений)
		|		И НЕ ЗаказТовары.Отменено)
		|	И НЕ (ЗаказТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
		|	 		И ЗаказТовары.Ссылка.СуммаДокумента = 0)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента) КАК Заказ
		|ПОМЕСТИТЬ Обработанные
		|ИЗ
		|	Документ.смартЛид
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказы 
		|		ПО ((ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента)) = ОнлайнЗаказы.Заказ)
		|			И (НЕ ПометкаУдаления)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказКлиентаТовары.Ссылка КАК Заказ,
		|	СУММА(ЗаказКлиентаТовары.Сумма) КАК СуммаТовары
		|ПОМЕСТИТЬ ЗаказыСуммы
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка В
		|			(ВЫБРАТЬ
		|				ОнлайнЗаказыНеОбеспеченные.Заказ
		|			ИЗ
		|				ОнлайнЗаказыНеОбеспеченные)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОнлайнЗаказы.Заказ КАК Заказ,
		|	ОнлайнЗаказы.Заказ.ПометкаУдаления КАК ПометкаУдаления,
		|	ОнлайнЗаказы.Заказ.Статус КАК Статус,
		|	ОнлайнЗаказы.Заказ.СуммаДокумента КАК СуммаДокумента,
		|	ЗаказыСуммы.СуммаТовары КАК СуммаТовары,
		|	ОнлайнЗаказы.Заказ.Партнер КАК Партнер,
		|	ОнлайнЗаказы.Заказ.Партнер.БизнесРегион КАК БизнесРегион
		|ИЗ
		|	ОнлайнЗаказы КАК ОнлайнЗаказы	
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказыНеОбеспеченные КАК ОнлайнЗаказыНеОбеспеченные
		|		ПО (ОнлайнЗаказы.Заказ = ОнлайнЗаказыНеОбеспеченные.Заказ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Обработанные КАК Обработанные
		|		ПО (ОнлайнЗаказы.Заказ = Обработанные.Заказ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказыСуммы КАК ЗаказыСуммы
		|		ПО ОнлайнЗаказы.Заказ = ЗаказыСуммы.Заказ
		|ГДЕ		
		|	Обработанные.Заказ ЕСТЬ NULL		
		|		
		|УПОРЯДОЧИТЬ ПО
		|	Заказ
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("СписокОбеспечений", СтруктураПараметровЗапроса.МассивОбеспечений);
	Запрос.УстановитьПараметр("Свойство", 		   СтруктураПараметровЗапроса.СвойствоОффлайнЗаказ);
	Запрос.УстановитьПараметр("Значение", 		   СтруктураПараметровЗапроса.ЗначениеОффлайнЗаказ);
	
	Если СтруктураПараметровЗапроса.Источник <> Неопределено Тогда

		ОтборПоЗаказам = "ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) В(&СписокЗаказов)";
		
		Запрос.УстановитьПараметр("СписокЗаказов", СтруктураПараметровЗапроса.Источник);

	Иначе	
		
		ОтборПоЗаказам = "ИСТИНА";
		
	КонецЕсли;	

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоЗаказам", ОтборПоЗаказам);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Функция ПолучитьНеобработанныеИнтернетЗаказыПоОбъекту(СтруктураПараметровЗапроса)
	
	ЗаказОбъект = СтруктураПараметровЗапроса.Источник;
	
	ТаблицаЗаказ = Новый ТаблицаЗначений;
	
	ТаблицаЗаказ.Колонки.Добавить("Заказ", 			 Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента")); 
	ТаблицаЗаказ.Колонки.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево")); 
	ТаблицаЗаказ.Колонки.Добавить("Статус", 		 Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыЗаказовКлиентов")); 
	ТаблицаЗаказ.Колонки.Добавить("СуммаДокумента",  Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2))); 
	ТаблицаЗаказ.Колонки.Добавить("СуммаТовары",  	 Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2))); 
	ТаблицаЗаказ.Колонки.Добавить("Партнер", 		 Новый ОписаниеТипов("СправочникСсылка.Партнеры")); 
	ТаблицаЗаказ.Колонки.Добавить("БизнесРегион", 	 Новый ОписаниеТипов("СправочникСсылка.БизнесРегионы")); 
	
	Если ЗаказОбъект.ПометкаУдаления
		 ИЛИ (ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт
			 	И ЗаказОбъект.СуммаДокумента = 0) Тогда
				
		//Заказ удален или закрыт		
		НоваяСтрокаЗаказ = ТаблицаЗаказ.Добавить();
		
		НоваяСтрокаЗаказ.Заказ 			 = ЗаказОбъект.Ссылка;
		НоваяСтрокаЗаказ.ПометкаУдаления = ЗаказОбъект.ПометкаУдаления;
		НоваяСтрокаЗаказ.Статус			 = ЗаказОбъект.Статус;
		НоваяСтрокаЗаказ.СуммаДокумента  = ЗаказОбъект.СуммаДокумента;
		НоваяСтрокаЗаказ.СуммаТовары	 = ЗаказОбъект.Товары.Итог("Сумма");
		НоваяСтрокаЗаказ.Партнер 	 	 = ЗаказОбъект.Партнер;
		НоваяСтрокаЗаказ.БизнесРегион	 = ЗаказОбъект.Партнер.БизнесРегион;
		
	Иначе
		
		Для Каждого СтрокаТовары Из ЗаказОбъект.Товары Цикл
			
			Если НЕ СтрокаТовары.Отменено 
				     И СтруктураПараметровЗапроса.МассивОбеспечений.Найти(СтрокаТовары.ВариантОбеспечения) <> Неопределено Тогда
			
				//Ест необработанные строки		
				НоваяСтрокаЗаказ = ТаблицаЗаказ.Добавить();
				
				НоваяСтрокаЗаказ.Заказ 			 = ЗаказОбъект.Ссылка;
				НоваяСтрокаЗаказ.ПометкаУдаления = ЗаказОбъект.ПометкаУдаления;
				НоваяСтрокаЗаказ.Статус			 = ЗаказОбъект.Статус;
				НоваяСтрокаЗаказ.СуммаДокумента  = ЗаказОбъект.СуммаДокумента;
				НоваяСтрокаЗаказ.СуммаТовары	 = ЗаказОбъект.Товары.Итог("Сумма");
				НоваяСтрокаЗаказ.Партнер 	 	 = ЗаказОбъект.Партнер;
				НоваяСтрокаЗаказ.БизнесРегион	 = ЗаказОбъект.Партнер.БизнесРегион;
				
				Прервать;
				
			КонецЕсли;	
				
		КонецЦикла;

	КонецЕсли;
	
	Если ТаблицаЗаказ.Количество() = 0 Тогда
		Возврат ТаблицаЗаказ;
	КонецЕсли;	
	
	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ТаблицаЗаказ.Заказ,
        |	ТаблицаЗаказ.ПометкаУдаления,
        |	ТаблицаЗаказ.Статус,
        |	ТаблицаЗаказ.СуммаДокумента,
        |	ТаблицаЗаказ.СуммаТовары,
        |	ТаблицаЗаказ.Партнер,
        |	ТаблицаЗаказ.БизнесРегион
		|ПОМЕСТИТЬ ИсходныйЗаказ
		|ИЗ
		|	&ТаблицаЗаказ КАК ТаблицаЗаказ
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	ИсходныйЗаказ.Заказ,
        |	ИсходныйЗаказ.ПометкаУдаления,
        |	ИсходныйЗаказ.Статус,
        |	ИсходныйЗаказ.СуммаДокумента,
        |	ИсходныйЗаказ.СуммаТовары,
        |	ИсходныйЗаказ.Партнер,
        |	ИсходныйЗаказ.БизнесРегион
		|ПОМЕСТИТЬ ОнлайнЗаказыНеОбеспеченные
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИсходныйЗаказ
		|		ПО ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) = ИсходныйЗаказ.Заказ
		|ГДЕ
		|	Свойство = &Свойство
		|	И Значение = &Значение
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Заказ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента) КАК ЗаказКлиента
		|ПОМЕСТИТЬ Обработанные
		|ИЗ
		|	Документ.смартЛид КАК смартЛид
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказыНеОбеспеченные 
		|		ПО ((ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента)) = ОнлайнЗаказыНеОбеспеченные.Заказ)
		|			И (НЕ смартЛид.ПометкаУдаления)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЗаказКлиента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОнлайнЗаказыНеОбеспеченные.Заказ КАК Заказ,
		|	ОнлайнЗаказыНеОбеспеченные.ПометкаУдаления КАК ПометкаУдаления,
		|	ОнлайнЗаказыНеОбеспеченные.Статус КАК Статус,
		|	ОнлайнЗаказыНеОбеспеченные.СуммаДокумента КАК СуммаДокумента,
		|	ОнлайнЗаказыНеОбеспеченные.СуммаТовары КАК СуммаТовары,
		|	ОнлайнЗаказыНеОбеспеченные.Партнер КАК Партнер,
		|	ОнлайнЗаказыНеОбеспеченные.БизнесРегион КАК БизнесРегион
		|ИЗ
		|	ОнлайнЗаказыНеОбеспеченные КАК ОнлайнЗаказыНеОбеспеченные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Обработанные КАК Обработанные
		|		ПО (ОнлайнЗаказыНеОбеспеченные.Заказ = Обработанные.ЗаказКлиента)
		|ГДЕ		
		|	Обработанные.ЗаказКлиента ЕСТЬ NULL		
		|		
		|УПОРЯДОЧИТЬ ПО
		|	Заказ
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ТаблицаЗаказ", ТаблицаЗаказ);
	Запрос.УстановитьПараметр("Свойство", 	  СтруктураПараметровЗапроса.СвойствоОффлайнЗаказ);
	Запрос.УстановитьПараметр("Значение", 	  СтруктураПараметровЗапроса.ЗначениеОффлайнЗаказ);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Процедура ОтправитьОповещениеПоОнлайнЗаказам(Источник) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ (ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") 
			 	ИЛИ (ТипЗнч(Источник) = Тип("Массив") 
					И Источник.Количество() > 0)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ЗаказКлиента") Тогда
		
		ОбъектСтруктура = Новый Структура();
		
		ОбъектСтруктура.Вставить("Ссылка",							   Источник.Ссылка); 
		ОбъектСтруктура.Вставить("ПометкаУдаления", 				   Источник.ПометкаУдаления); 
		ОбъектСтруктура.Вставить("Дата", 							   Источник.Дата); 
		ОбъектСтруктура.Вставить("Номер", 							   Источник.Номер); 
		ОбъектСтруктура.Вставить("Статус", 							   Источник.Статус); 
		ОбъектСтруктура.Вставить("СуммаДокумента", 					   Источник.СуммаДокумента); 
		ОбъектСтруктура.Вставить("Партнер", 						   Источник.Партнер); 
		ОбъектСтруктура.Вставить("смартТелефонКонтактногоЛица", 	   Источник.смартТелефонКонтактногоЛица); 
		ОбъектСтруктура.Вставить("СпособДоставки", 					   Источник.СпособДоставки); 
		ОбъектСтруктура.Вставить("Подразделение", 					   Источник.Подразделение); 
		ОбъектСтруктура.Вставить("АдресДоставки", 					   Источник.АдресДоставки); 
		ОбъектСтруктура.Вставить("ДополнительнаяИнформацияПоДоставке", Источник.ДополнительнаяИнформацияПоДоставке); 
		ОбъектСтруктура.Вставить("ОсобыеУсловияПеревозкиОписание", 	   Источник.ОсобыеУсловияПеревозкиОписание); 
		ОбъектСтруктура.Вставить("Товары", 							   ОбщегоНазначения.ТаблицаЗначенийВМассив(Источник.Товары.Выгрузить())); 
		
		Источник = ОбъектСтруктура;
		
	КонецЕсли;	
	
	ФЗ = ДлительныеОперации.ВыполнитьВФоне("смартИнтернетМагазин.ОтправитьОповещениеПоОнлайнЗаказамФоновоеЗадание", 
										   Новый Структура("Источник", Источник),
										   ДлительныеОперации.ПараметрыВыполненияВФоне(Новый УникальныйИдентификатор));
										   	
КонецПроцедуры //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Процедура ОтправитьОповещениеПоОнлайнЗаказамФоновоеЗадание(Параметры, Адрес) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);

	ОбщегоНазначенияБТС.Пауза(5);
	
	Источник = Параметры.Источник;
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	ТестовыйРежим = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаТестовыйРежим;
	
	Если ЭтоТестоваяБаза И НЕ ТестовыйРежим Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытияЖР = "смартОтправкаОповещенияБэкОфисуОбИнтернетЗаказе";

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//Адреса для отправки
	МассивАдресов = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаПочтаБэкОфис.ВыгрузитьКолонку("АдресПочты");	
	
	МассивАдресовДляОтправки = Новый Массив;
	АдресаДляОтправкиСтрокой = "";
	
	Для Каждого ЭлементАдрес Из МассивАдресов Цикл

		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(ЭлементАдрес);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			
			Если НЕ ЗначениеЗаполнено(ЭлементСтруктуры.ОписаниеОшибки) Тогда
				МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
				АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
		 	И МассивАдресовДляОтправки.Количество() > 0 Тогда
			   
		РезультатЗапроса = ПолучитьРезультатЗапросаПоИнтернетЗаказамДляОповещения(Источник);
		
		СтрокаЗаказа = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		//Отправка оповещения по каждому заказу
		Пока СтрокаЗаказа.Следующий() Цикл
		
			ПредставлениеЗаказа = "№ " + СтрокаЗаказа.Номер;
			
			Если НЕ СтрокаЗаказа.ЗаказОтменен Тогда
				ТемаПисьма = "Смарт-Т: Требуется обработка заказа Интернет-магазина " + ПредставлениеЗаказа;
			Иначе
				ТемаПисьма = "Смарт-Т: Заказ Интернет-магазина " + ПредставлениеЗаказа + " отменен";
			КонецЕсли;
			
			ТекстПисьма = СформироватьТекстПисьмаОповещенияИнтернетЗаказ(СтрокаЗаказа);
					 		
			ПараметрыПисьма = Новый Структура;
			ПараметрыПисьма.Вставить("Кому",	  МассивАдресовДляОтправки);
			ПараметрыПисьма.Вставить("Тема", 	  ТемаПисьма);
 			ПараметрыПисьма.Вставить("Тело", 	  ТекстПисьма);	
			ПараметрыПисьма.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.HTML);
			ПараметрыПисьма.Вставить("Важность",  ВажностьИнтернетПочтовогоСообщения.Обычная);

			Попытка
				
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);

				ТекстСообщения = "Отправлено оповещение об интернет-заказе " + ПредставлениеЗаказа + " на почту " + АдресаДляОтправкиСтрокой;

				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				
			Исключение 

				ТекстСообщения = "Не удалось отправить оповещение об интернет-заказе " + ПредставлениеЗаказа + Символы.ПС + ОписаниеОшибки();

				ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
				
			КонецПопытки;
			
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Функция ПолучитьРезультатЗапросаПоИнтернетЗаказамДляОповещения(Источник)

	Если ТипЗнч(Источник) = Тип("Структура") Тогда	
		
		ТаблицаЗаказ = Новый ТаблицаЗначений;
		
		ТаблицаЗаказ.Колонки.Добавить("Ссылка", 							Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента")); 
		ТаблицаЗаказ.Колонки.Добавить("ПометкаУдаления", 					Новый ОписаниеТипов("Булево")); 
		ТаблицаЗаказ.Колонки.Добавить("Дата", 								Новый ОписаниеТипов("Дата")); 
		ТаблицаЗаказ.Колонки.Добавить("Номер", 								Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(20))); 
		ТаблицаЗаказ.Колонки.Добавить("Статус", 							Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыЗаказовКлиентов")); 
		ТаблицаЗаказ.Колонки.Добавить("СуммаДокумента", 					Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2))); 
		ТаблицаЗаказ.Колонки.Добавить("Партнер", 							Новый ОписаниеТипов("СправочникСсылка.Партнеры")); 
		ТаблицаЗаказ.Колонки.Добавить("смартТелефонКонтактногоЛица", 		Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(100))); 
		ТаблицаЗаказ.Колонки.Добавить("СпособДоставки", 					Новый ОписаниеТипов("ПеречислениеСсылка.СпособыДоставки")); 
		ТаблицаЗаказ.Колонки.Добавить("Подразделение", 						Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия")); 
		ТаблицаЗаказ.Колонки.Добавить("АдресДоставки", 						Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(500))); 
		ТаблицаЗаказ.Колонки.Добавить("ДополнительнаяИнформацияПоДоставке", Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(1000))); 
		ТаблицаЗаказ.Колонки.Добавить("ОсобыеУсловияПеревозкиОписание", 	Новый ОписаниеТипов("Строка",,,Новый КвалификаторыСтроки(1000))); 
		ТаблицаЗаказ.Колонки.Добавить("НомерСтроки", 						Новый ОписаниеТипов("Число")); 
		ТаблицаЗаказ.Колонки.Добавить("Номенклатура", 						Новый ОписаниеТипов("СправочникСсылка.Номенклатура")); 
		ТаблицаЗаказ.Колонки.Добавить("Характеристика", 					Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры")); 
		ТаблицаЗаказ.Колонки.Добавить("Упаковка", 							Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения")); 
		ТаблицаЗаказ.Колонки.Добавить("КоличествоУпаковок", 				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3))); 
		ТаблицаЗаказ.Колонки.Добавить("Сумма", 								Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2))); 
		ТаблицаЗаказ.Колонки.Добавить("Отменено", 							Новый ОписаниеТипов("Булево")); 

		Для Каждого СтрокаТовары Из Источник.Товары Цикл
			
			НоваяСтрокаЗаказ = ТаблицаЗаказ.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЗаказ, Источник);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЗаказ, СтрокаТовары, 
				"НомерСтроки, Номенклатура, Характеристика, Упаковка, КоличествоУпаковок, Сумма, Отменено");
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказТовары.Ссылка КАК Ссылка,
			|	ЗаказТовары.ПометкаУдаления КАК ПометкаУдаления,
			|	ЗаказТовары.Дата КАК Дата,
			|	ЗаказТовары.Номер КАК Номер,
			|	ЗаказТовары.Статус КАК Статус,
			|	ЗаказТовары.СуммаДокумента КАК СуммаДокумента,
			|	ЗаказТовары.Партнер КАК Партнер,
			|	ЗаказТовары.смартТелефонКонтактногоЛица КАК смартТелефонКонтактногоЛица,
			|	ЗаказТовары.СпособДоставки КАК СпособДоставки,
			|	ЗаказТовары.Подразделение КАК Подразделение,
			|	ЗаказТовары.АдресДоставки КАК АдресДоставки,
			|	ЗаказТовары.ДополнительнаяИнформацияПоДоставке КАК ДополнительнаяИнформацияПоДоставке,
			|	ЗаказТовары.ОсобыеУсловияПеревозкиОписание КАК ОсобыеУсловияПеревозкиОписание,
			|	ЗаказТовары.НомерСтроки КАК НомерСтроки,
			|	ЗаказТовары.Номенклатура КАК Номенклатура,
			|	ЗаказТовары.Характеристика КАК Характеристика,
			|	ЗаказТовары.Упаковка КАК Упаковка,
			|	ЗаказТовары.КоличествоУпаковок КАК КоличествоУпаковок,
			|	ЗаказТовары.Сумма КАК Сумма,
			|	ЗаказТовары.Отменено КАК Отменено
			|ПОМЕСТИТЬ ЗаказТовары
			|ИЗ
			|	&ТаблицаЗаказ КАК ЗаказТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказТовары.Ссылка КАК Ссылка,
			|	ЗаказТовары.Дата КАК Дата,
			|	ЗаказТовары.Номер КАК Номер,
			|	ВЫБОР КОГДА 
			|		ЗаказТовары.ПометкаУдаления 
			|			ИЛИ (ЗаказТовары.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт) И ЗаказТовары.СуммаДокумента = 0) 
			|		ТОГДА ИСТИНА 
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ЗаказОтменен,
			|	ЗаказТовары.СуммаДокумента КАК СуммаДокумента,
			|	ЗаказТовары.Партнер КАК Партнер,
			|	ЗаказТовары.смартТелефонКонтактногоЛица КАК смартТелефонКонтактногоЛица,
			|	ЗаказТовары.СпособДоставки КАК СпособДоставки,
			|	ЗаказТовары.Подразделение КАК Подразделение,
			|	ВЫБОР
			|		КОГДА ЗаказТовары.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз)
			|				ИЛИ ЗаказТовары.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал)
			|			ТОГДА ЗаказТовары.Подразделение
			|		ИНАЧЕ ЗаказТовары.АдресДоставки
			|	КОНЕЦ КАК АдресДоставки,
			|	ЗаказТовары.ДополнительнаяИнформацияПоДоставке КАК ДополнительнаяИнформацияПоДоставке,
			|	ЗаказТовары.ОсобыеУсловияПеревозкиОписание КАК ОсобыеУсловияПеревозкиОписание,
			|	ЗаказТовары.НомерСтроки КАК НомерСтроки,
			|	ЗаказТовары.Номенклатура КАК Номенклатура,
			|	ЗаказТовары.Характеристика КАК Характеристика,
			|	ВЫБОР
			|		КОГДА ЗаказТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения
			|		ИНАЧЕ ЗаказТовары.Упаковка
			|	КОНЕЦ КАК Упаковка,
			|	ЗаказТовары.КоличествоУпаковок КАК КоличествоУпаковок,
			|	ЗаказТовары.Сумма КАК Сумма,
			|	ЗаказТовары.Отменено КАК Отменено
			|ИЗ
			|	ЗаказТовары КАК ЗаказТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
			|		ПО ЗаказТовары.Номенклатура = СпрНоменклатура.Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	Ссылка,
			|	НомерСтроки
			|ИТОГИ
			|	МАКСИМУМ(Дата),
			|	МАКСИМУМ(Номер),
			|	МАКСИМУМ(ЗаказОтменен),
			|	МАКСИМУМ(СуммаДокумента),
			|	МАКСИМУМ(Партнер),
			|	МАКСИМУМ(смартТелефонКонтактногоЛица),
			|	МАКСИМУМ(СпособДоставки),
			|	МАКСИМУМ(Подразделение),
			|	МАКСИМУМ(АдресДоставки),
			|	МАКСИМУМ(ДополнительнаяИнформацияПоДоставке),
			|	МАКСИМУМ(ОсобыеУсловияПеревозкиОписание)
			|ПО
			|	Ссылка
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("ТаблицаЗаказ", ТаблицаЗаказ);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказТовары.Ссылка КАК Ссылка,
			|	ЗаказТовары.Ссылка.Дата КАК Дата,
			|	ЗаказТовары.Ссылка.Номер КАК Номер,
			|	ВЫБОР КОГДА 
			|		ЗаказТовары.Ссылка.ПометкаУдаления 
			|			ИЛИ (ЗаказТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт) И ЗаказТовары.Ссылка.СуммаДокумента = 0) 
			|		ТОГДА ИСТИНА 
			|		ИНАЧЕ ЛОЖЬ
			|	КОНЕЦ КАК ЗаказОтменен,
			|	ЗаказТовары.Ссылка.СуммаДокумента КАК СуммаДокумента,
			|	ЗаказТовары.Ссылка.Партнер КАК Партнер,
			|	ЗаказТовары.Ссылка.смартТелефонКонтактногоЛица КАК смартТелефонКонтактногоЛица,
			|	ЗаказТовары.Ссылка.СпособДоставки КАК СпособДоставки,
			|	ЗаказТовары.Ссылка.Подразделение КАК Подразделение,
			|	ВЫБОР
			|		КОГДА ЗаказТовары.Ссылка.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.Самовывоз)
			|				ИЛИ ЗаказТовары.Ссылка.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал)
			|			ТОГДА ЗаказТовары.Ссылка.Подразделение
			|		ИНАЧЕ ЗаказТовары.Ссылка.АдресДоставки
			|	КОНЕЦ КАК АдресДоставки,
			|	ЗаказТовары.Ссылка.ДополнительнаяИнформацияПоДоставке КАК ДополнительнаяИнформацияПоДоставке,
			|	ЗаказТовары.Ссылка.ОсобыеУсловияПеревозкиОписание КАК ОсобыеУсловияПеревозкиОписание,
			|	ЗаказТовары.НомерСтроки КАК НомерСтроки,
			|	ЗаказТовары.Номенклатура КАК Номенклатура,
			|	ЗаказТовары.Характеристика КАК Характеристика,
			|	ВЫБОР
			|		КОГДА ЗаказТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
			|			ТОГДА ЗаказТовары.Номенклатура.ЕдиницаИзмерения
			|		ИНАЧЕ ЗаказТовары.Упаковка
			|	КОНЕЦ КАК Упаковка,
			|	ЗаказТовары.КоличествоУпаковок КАК КоличествоУпаковок,
			|	ЗаказТовары.Сумма КАК Сумма,
			|	ЗаказТовары.Отменено КАК Отменено
			|ИЗ
			|	Документ.ЗаказКлиента.Товары КАК ЗаказТовары
			|ГДЕ
			|	ЗаказТовары.Ссылка В(&МассивЗаказов)
			|
			|УПОРЯДОЧИТЬ ПО
			|	Ссылка,
			|	НомерСтроки
			|ИТОГИ ПО
			|	Ссылка
			|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос.УстановитьПараметр("МассивЗаказов", Источник);
		
	КонецЕсли;	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции //-- #1993 смарт: Лопато 19.08.2024	

//++ #1993 смарт: Лопато 19.08.2024 //Обработка онлайн заказов (переделка)  
Функция СформироватьТекстПисьмаОповещенияИнтернетЗаказ(ВыборкаСтрокиЗаказа)
	
	ШаблонПисьма = Справочники.смартПредопределенныеЗначения.ПолучитьМакет("ШаблонЗаказСайтаПринят").ПолучитьТекст();	
	
	Если НЕ ВыборкаСтрокиЗаказа.ЗаказОтменен Тогда
		
		ТекстШапкиЗаказа = "Чтобы клиенту был доступен Счет на оплату, проверьте пожалуйста Заказ клиента в 1С" 
						   + " и установите резерв на товары. Так же может потребоваться скорректировать Доставку," 
						   + " Склады отгрузки и Скидки клиента.";
	Иначе
		
		ТекстШапкиЗаказа = "заказ отменен.";
		
	КонецЕсли;
	
	//Заполнение шаблона
	СоответствиеПараметровШапка = Новый Соответствие;
	СоответствиеПараметровШапка.Вставить("#IPOLMO_NUMBER_1C#", СокрЛП(ВыборкаСтрокиЗаказа.Номер));
	СоответствиеПараметровШапка.Вставить("#ORDER_DATE#", 	   Формат(ВыборкаСтрокиЗаказа.Дата, "ДЛФ=DT"));
	СоответствиеПараметровШапка.Вставить("#ORDER_STATUS#", 	   ?(ВыборкаСтрокиЗаказа.ЗаказОтменен, "Заказ отменен", "Заказ принят"));
	СоответствиеПараметровШапка.Вставить("#MANAGER_NAME#",	   "менеджер");
	СоответствиеПараметровШапка.Вставить("#COMPANY_NAME#", 	   СокрЛП(ВыборкаСтрокиЗаказа.Партнер));
	СоответствиеПараметровШапка.Вставить("#NUMBER#", 		   СокрЛП(ВыборкаСтрокиЗаказа.смартТелефонКонтактногоЛица));
	СоответствиеПараметровШапка.Вставить("#DOSTAVKA#", 		   СокрЛП(ВыборкаСтрокиЗаказа.СпособДоставки));
	СоответствиеПараметровШапка.Вставить("#DOSTAVKA_ADRES#",   СокрЛП(ВыборкаСтрокиЗаказа.АдресДоставки));
	СоответствиеПараметровШапка.Вставить("#ORDER_TEXT#",	   ТекстШапкиЗаказа);
	
	ДопПараметрыДоставки = СокрЛП(ВыборкаСтрокиЗаказа.ДополнительнаяИнформацияПоДоставке)
						   	      + ?(ЗначениеЗаполнено(ВыборкаСтрокиЗаказа.ОсобыеУсловияПеревозкиОписание),
							 	  	  Символы.ПС + СокрЛП(ВыборкаСтрокиЗаказа.ОсобыеУсловияПеревозкиОписание), "");
									  
	СоответствиеПараметровШапка.Вставить("#DOSTAVKA_DOP#", ?(ЗначениеЗаполнено(ДопПараметрыДоставки), ДопПараметрыДоставки, "Нет"));
	
	Для Каждого Параметр Из СоответствиеПараметровШапка Цикл
		ШаблонПисьма = СтрЗаменить(ШаблонПисьма, Параметр.Ключ, Параметр.Значение);
	КонецЦикла;	
	
	//Заполнение таблицы товаров
	НачалоШаблокаСтрокиТоваров = СтрНайти(ШаблонПисьма, "<tr valign=""top"" class=""table-line"">");
	КонецШаблокаСтрокиТоваров = СтрНайти(ШаблонПисьма, "</tr>", , НачалоШаблокаСтрокиТоваров);                                                
	ШаблонСтрокиТоваров = Сред(ШаблонПисьма, НачалоШаблокаСтрокиТоваров, КонецШаблокаСтрокиТоваров - НачалоШаблокаСтрокиТоваров + 5); 

	ШаблонПисьма = СтрЗаменить(ШаблонПисьма, ШаблонСтрокиТоваров, "#Товары#");
	
	БлокТаблицыТоваров = "";
	
	ВыборкаСтрокиТовара = ВыборкаСтрокиЗаказа.Выбрать();
	
	СуммаДокументаТовары = 0;
	
	Пока ВыборкаСтрокиТовара.Следующий() Цикл
		
		БлокСтрокаТовары = ШаблонСтрокиТоваров;
		
		СоответствиеПараметровТовары = Новый Соответствие;
		СоответствиеПараметровТовары.Вставить("#PRODUCT_NAME#", СокрЛП(ВыборкаСтрокиТовара.Номенклатура)
																+ ?(ЗначениеЗаполнено(ВыборкаСтрокиТовара.Характеристика),
															   	    СокрЛП(ВыборкаСтрокиТовара.Характеристика), ""));
		СоответствиеПараметровТовары.Вставить("#PRODUCT_KOL#",  СокрЛП(ВыборкаСтрокиТовара.КоличествоУпаковок) 
																+ " " + СокрЛП(ВыборкаСтрокиТовара.Упаковка));
		СоответствиеПараметровТовары.Вставить("#PRODUCT_SUM#", 	Формат(ВыборкаСтрокиТовара.Сумма, "ЧДЦ=2"));

		Для Каждого Параметр Из СоответствиеПараметровТовары Цикл
			БлокСтрокаТовары = СтрЗаменить(БлокСтрокаТовары, Параметр.Ключ, Параметр.Значение);
		КонецЦикла;	

		//Стоимость заказа
		Если НЕ ВыборкаСтрокиЗаказа.ЗаказОтменен Тогда
			
			Если НЕ ВыборкаСтрокиТовара.Отменено Тогда
				
				СуммаДокументаТовары = СуммаДокументаТовары + ВыборкаСтрокиТовара.Сумма;
				
			Иначе
				
				//Зачеркиваем отмененную строку
				БлокСтрокаТовары = СтрЗаменить(БлокСтрокаТовары, 
					"<tr valign=""top"" class=""table-line"">", 
					"<tr valign=""top"" class=""table-line"" style=""text-decoration: line-through;"">");
				
			КонецЕсли;
			
		Иначе
			
			СуммаДокументаТовары = СуммаДокументаТовары + ВыборкаСтрокиТовара.Сумма; 
			
		КонецЕсли;	
		
		//Вывод строки
		БлокТаблицыТоваров = БлокТаблицыТоваров + БлокСтрокаТовары + Символы.ПС;
		
	КонецЦикла;	

	ШаблонПисьма = СтрЗаменить(ШаблонПисьма, "#Товары#", БлокТаблицыТоваров);
	
	//Стоимость заказа
	ШаблонПисьма = СтрЗаменить(ШаблонПисьма, "#PRICE#", Формат(СуммаДокументаТовары, "ЧДЦ=2; ЧН=0.00"));
	
	Возврат ШаблонПисьма;

КонецФункции //-- #1993 смарт: Лопато 19.08.2024

