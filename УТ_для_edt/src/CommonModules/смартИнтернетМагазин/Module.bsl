//++ #Б-990 смарт: Лопато 23.09.2024 //ИМ. Подготовить метод подтверждения (отклонения) регистрации пользователя на сайте  
Функция ОтправкаСообщенияОПользователеНаСайтUpdate(СайтПараметры) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("СерверВыгрузки", Ложь);
	
	Соединение = Новый HTTPСоединение(Сервер,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос 	   = Новый HTTPЗапрос("rest/1/c3jq3eiu1fbmi0il/api.user.update/");
	
	МассивСтрокПараметров = Новый Массив;
	Для Каждого ЭлементПараметр Из СайтПараметры Цикл
		МассивСтрокПараметров.Добавить(ЭлементПараметр.Ключ + "=" + ЭлементПараметр.Значение);
	КонецЦикла;	
	
	ТелоЗапроса = СтрСоединить(МассивСтрокПараметров, "&");
	
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	
	ДанныеОтвета = Соединение.ОтправитьДляОбработки(Запрос);
	
	Возврат ДанныеОтвета;
	
КонецФункции //--#Б-990 смарт: Лопато 23.09.2024

