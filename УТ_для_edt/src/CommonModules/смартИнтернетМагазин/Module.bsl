	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("СерверВыгрузки", Ложь);
	
	Соединение = Новый HTTPСоединение(Сервер,,,,,, Новый ЗащищенноеСоединениеOpenSSL());
	Запрос 	   = Новый HTTPЗапрос("rest/1/c3jq3eiu1fbmi0il/api.user.add/");
	
	МассивСтрокПараметров = Новый Массив;
	Для Каждого ЭлементПараметр Из СайтПараметры Цикл
		МассивСтрокПараметров.Добавить(ЭлементПараметр.Ключ + "=" + ЭлементПараметр.Значение);
	КонецЦикла;	
	
	ТелоЗапроса = СтрСоединить(МассивСтрокПараметров, "&");
	
