//++ #Б-1998 смарт: Лопато 27.01.2025 //Создание пользователя ИМ на основании договора поставки. Доработать метод отправки регистрации на сайт  
Функция ЗарегистрироватьПользователяНаСайте(КонтактноеЛицо, КонтактноеЛицоТелефон, КонтактноеЛицоEmail) Экспорт
	
	Результат = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//++ #Б-2604 смарт: Лопато 06.03.2025 //Ошибка в проведении договора с отметкой "Подписан"  
	СтрокаОшибки = "";
    //-- #Б-2604 смарт: Лопато 06.03.2025
	
	Если Б_ОбменССайтомСервер.смарт_ЭтоКопияБазы() Тогда
		
		//СтрокаОшибки = "Регистрация пользователя на сайте возможно только в рабочей базе!";

		//ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки);
		//
		//Возврат СтрокаОшибки;
		
	КонецЕсли;	
	
	//Проверка ИД сайта уже присвоен контактному лицу
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИДсайта
	|ИЗ
	|	РегистрСведений.СмартИдентификаторыСоответствияБитрикс
	|ГДЕ
	|	ВЫРАЗИТЬ(СсылкаМет КАК Справочник.КонтактныеЛицаПартнеров) = &КонтактноеЛицо";

	Запрос.УстановитьПараметр("КонтактноеЛицо", КонтактноеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	//Проверка
	Успешно = Истина;	
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не заполнено контактное лицо";
		Успешно = Ложь;
	КонецЕсли; 

	Если КонтактноеЛицо.Владелец = Справочники.Партнеры.НеизвестныйПартнер Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "Контактное лицо принадлежит неопределенному партнеру";
		Успешно = Ложь;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо.Владелец) Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не заполнен партнер";
		Успешно = Ложь;
	КонецЕсли;		

	Если НЕ КонтактноеЛицо.Владелец.Клиент Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "Партнер не является клиентом";
		Успешно = Ложь;
	КонецЕсли;		
	
	//Проверка что у партнера есть контрагент
	Контрагент = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты
		|ГДЕ
		|	Партнер = &Партнер";
	
	Запрос.УстановитьПараметр("Партнер", КонтактноеЛицо.Владелец);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Контрагент = Выборка.Контрагент;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда 
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не найден контрагент";
		Успешно = Ложь;
	КонецЕсли;
	
	//Получение Email
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицоEmail) Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "У контактного лица не заполнена почта";
		Успешно = Ложь;
	КонецЕсли;				  
				  
	//Получение мобильного телефона
	КЛМобильныйТелефон = ПолучитьНомерТелефонаПоПредставлению(КонтактноеЛицоТелефон);						  
										 
	Если НЕ ЗначениеЗаполнено(КЛМобильныйТелефон) Тогда
		СтрокаОшибки = СтрокаОшибки 
			+ ?(СтрокаОшибки <> "", Символы.ПС, "") + "У контактного лица не заполнен телефон";
		Успешно = Ложь;
	КонецЕсли;				  
	
	Если НЕ Успешно Тогда
		
		СтрокаДанныхПользователя = "Пользователь: " + СокрЛП(КонтактноеЛицо) + ", " 
								   + "Клиент: " 	+ СокрЛП(КонтактноеЛицо.Владелец) + ", " 
								   + "Контрагент: " + СокрЛП(Контрагент) + ", " 
								   + "Email: " 		+ СокрЛП(КонтактноеЛицоEmail) + ", "
								   + "Телефон: " 	+ СокрЛП(КЛМобильныйТелефон);

		СтрокаОшибки = СтрокаОшибки + Символы.ПС 
								 + "при регистрации нового пользователя сайта: " 
								 + СтрокаДанныхПользователя;
								   
		ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки);
		
		смартОтправитьОшибкуНаПочту(СтрокаОшибки);
		
		Возврат СтрокаОшибки;
		
	КонецЕсли;	
	
	//Вызываем регистрацию пользователя на сайте
	СайтПараметры = Новый Структура;

	СайтПараметры.Вставить("XML_ID", 		 XMLСтрока(КонтактноеЛицо));
	СайтПараметры.Вставить("PARTNER_XML_ID", XMLСтрока(КонтактноеЛицо.Владелец));
	СайтПараметры.Вставить("NAME", 		 	 СокрЛП(КонтактноеЛицо));
	СайтПараметры.Вставить("EMAIL", 		 СокрЛП(КонтактноеЛицоEmail));
	СайтПараметры.Вставить("PHONE", 		 СокрЛП(КЛМобильныйТелефон));
	
	//Вызываем регистрацию пользователя на сайте
	ДанныеОтвета = ОтправкаСообщенияОПользователеНаСайтAdd(СайтПараметры);
	
	//Обработка ответа
	Если ТипЗнч(ДанныеОтвета) = Тип("HTTPОтвет") Тогда

		ТелоОтвета = ДанныеОтвета.ПолучитьТелоКакСтроку();
		
		Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			
			Попытка
				
				СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
				
			Исключение
				
				СтрокаОшибки = "Ошибка регистрации на сайте пользователя: " + СокрЛП(КонтактноеЛицо) + " (ошибка разбора JSON)";

				ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки, ТелоОтвета);

				смартОтправитьОшибкуНаПочту(СтрокаОшибки + Символы.ПС + ТелоОтвета);
				
				Возврат СтрокаОшибки;
				
			КонецПопытки;
		
			Если СтруктураИзJSON.Свойство("result") Тогда 
				
				Если ТипЗнч(СтруктураИзJSON.Result) = Тип("Структура")
					И СтруктураИзJSON.Result.Свойство("error") 
					И СтруктураИзJSON.Result.Error = Истина Тогда
				
					СтрокаОшибки = "Пользователь " + СокрЛП(КонтактноеЛицо) + " с данным ID уже существует";
					
					Если СтруктураИзJSON.Result.Свойство("userId") Тогда
						СтрокаОшибки = СтрокаОшибки + ": " + СокрЛП(СтруктураИзJSON.Result.userId);
					КонецЕсли;
					
					ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки, СтруктураИзJSON.Result.Text);

					смартОтправитьОшибкуНаПочту(СтрокаОшибки + Символы.ПС + СтруктураИзJSON.Result.Text);

					Возврат СтрокаОшибки;
					
				ИначеЕсли ТипЗнч(СтруктураИзJSON.Result) = Тип("Число") Тогда

					//Запись соответствия в смартИдентификаторыСоответствияБитрикс
					ЗаполнитьДопСвойствоОбъекта(КонтактноеЛицо, СтрЗаменить(СтруктураИзJSON.Result, Символы.НПП, ""));						

					УстановитьОсновноеКонтактноеЛицоПартнера(КонтактноеЛицо, КонтактноеЛицо.Владелец);		
					
					//Подготовка контактного лица
					КонтактноеЛицоОбъект = КонтактноеЛицо.ПолучитьОбъект();

					КонтактноеЛицоОбъект.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
					
					КонтактноеЛицоОбъект.смартЛогинНаСайте 			  = СокрЛП(КонтактноеЛицоEmail);
					КонтактноеЛицоОбъект.смартЭлектроннаяПочтаНаСайте = СокрЛП(КонтактноеЛицоEmail);
					КонтактноеЛицоОбъект.смартТелефонНаСайте 		  = СокрЛП(КЛМобильныйТелефон);

					Попытка
						
						КонтактноеЛицоОбъект.Записать();

						Результат = Истина;
						
					Исключение

						СтрокаОшибки = "Ошибка записи контактного лица при регистрации на сайте пользователя: " + СокрЛП(КонтактноеЛицо);

						ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки);
						
						смартОтправитьОшибкуНаПочту(СтрокаОшибки);
						
						Возврат СтрокаОшибки;
						
					КонецПопытки;	

				КонецЕсли;
				
			КонецЕсли;
				
		КонецЕсли;
		
	Иначе

		СтрокаОшибки = "Ошибка регистрации на сайте пользователя: " + СокрЛП(КонтактноеЛицо);

		ЗаписьЖурналаРегистрации("Ошибка регистрации пользователя на сайте",,, СтрокаОшибки);

		смартОтправитьОшибкуНаПочту(СтрокаОшибки);

		Возврат СтрокаОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //--#Б-1998 смарт: Лопато 27.01.2025	

