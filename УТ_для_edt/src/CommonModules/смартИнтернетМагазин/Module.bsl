		|	Контрагенты.Партнер КАК КонтрагентПартнер,
		|	Контрагенты.Партнер.ОсновнойМенеджер КАК КонтрагентПартнерОсновнойМенеджер,
		|	Контрагенты.Партнер.ОсновнойМенеджер.смартРабочаяПочта КАК КонтрагентПартнерОсновнойМенеджерсмартРабочаяПочта,
		|	Контрагенты.Партнер.смартОсновнойМенеджерСервисЦентра КАК КонтрагентПартнерсмартОсновнойМенеджерСервисЦентра,
		|	Контрагенты.Партнер.смартОсновнойМенеджерСервисЦентра.смартРабочаяПочта КАК КонтрагентПартнерсмартОсновнойМенеджерСервисЦентрасмартРабочаяПочта
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактныеЛицаПартнеров.Ссылка КАК КонтактноеЛицо,
		|	КонтактныеЛицаПартнеров.Владелец КАК КонтактноеЛицоПартнер,
		|	КонтактныеЛицаПартнеров.Владелец.ОсновнойМенеджер КАК КонтактноеЛицоПартнерОсновнойМенеджер,
		|	КонтактныеЛицаПартнеров.Владелец.ОсновнойМенеджер.смартРабочаяПочта КАК КонтактноеЛицоПартнерОсновнойМенеджерсмартРабочаяПочта,
		|	КонтактныеЛицаПартнеров.Владелец.смартОсновнойМенеджерСервисЦентра КАК КонтактноеЛицоПартнерсмартОсновнойМенеджерСервисЦентра,
		|	КонтактныеЛицаПартнеров.Владелец.смартОсновнойМенеджерСервисЦентра.смартРабочаяПочта КАК КонтактноеЛицоПартнерсмартОсновнойМенеджерСервисЦентрасмартРабочаяПочта,
		|	Контрагенты.Ссылка КАК КонтактноеЛицоПартнерКонтрагент,
		|	Контрагенты.ИНН КАК КонтактноеЛицоПартнерКонтрагентИНН,
		|	Контрагенты.КПП КАК КонтактноеЛицоПартнерКонтрагентКПП,
		|	Контрагенты.Наименование КАК КонтактноеЛицоПартнерКонтрагентНаименование,
		|	Контрагенты.НаименованиеПолное КАК КонтактноеЛицоПартнерКонтрагентНаименованиеПолное
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|		ПО КонтактныеЛицаПартнеров.Владелец = Контрагенты.Партнер
		|			И ВЫБОР КОГДА &Контрагент <> НЕОПРЕДЕЛЕНО ТОГДА Контрагенты.Ссылка = &Контрагент КОНЕЦ
		|ГДЕ
		|	КонтактныеЛицаПартнеров.Ссылка = &КонтактноеЛицо";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("КонтактноеЛицо", КонтактноеЛицо);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТЗКонтрагент 	 = РезультатЗапроса[0].Выгрузить();
	ТЗКонтактноеЛицо = РезультатЗапроса[1].Выгрузить();
		
	ВыборкаКонтактноеЛицо = ТЗКонтактноеЛицо[0]; 

	Если ТЗКонтрагент.Количество() > 0 Тогда
    	ВыборкаКонтрагент = ТЗКонтрагент[0];
	Иначе
		ВыборкаКонтрагент = Новый Структура("Контрагент", Контрагент);
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер)
		ИЛИ ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер = ПредопределенноеЗначение("Справочник.Партнеры.НеизвестныйПартнер")
		ИЛИ ТЗКонтрагент.Количество() = 0
		ИЛИ ((ТЗКонтрагент.Количество() > 0 И ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагент))
			 И (ВыборкаКонтрагент.Контрагент <> ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагент)) Тогда	 	
			 
		Если ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерОсновнойМенеджер) 
		   И ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерОсновнойМенеджерсмартРабочаяПочта) Тогда
		   
			АдресПочты = ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерОсновнойМенеджерсмартРабочаяПочта;
			
		ИначеЕсли ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерсмартОсновнойМенеджерСервисЦентра) 
		  		И ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерсмартОсновнойМенеджерСервисЦентрасмартРабочаяПочта) Тогда	 
			
			АдресПочты = ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерсмартОсновнойМенеджерСервисЦентрасмартРабочаяПочта;
			
		Иначе
			
			АдресПочты = АдресПочтыАдресаДляОтправкиОшибок;

		КонецЕсли;			
			
		Если НЕ ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер) Тогда
			
			ТекстПисьма = ТекстПисьма + "У контактного лица """ + СокрЛП(КонтактноеЛицо) + """ не заполнен партнер!" + Символы.ПС + Символы.ПС;
			
			Если ТЗКонтрагент.Количество() > 0 И ЗначениеЗаполнено(ВыборкаКонтрагент.Контрагент) Тогда
				ТекстПисьма = ТекстПисьма + "Необходимо создать партнера к контрагенту """ + СокрЛП(ВыборкаКонтрагент.Контрагент) + "!" + Символы.ПС + Символы.ПС;
			КонецЕсли;
									  
		КонецЕсли;	
			
		Если ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер = ПредопределенноеЗначение("Справочник.Партнеры.НеизвестныйПартнер") Тогда
			ТекстПисьма = ТекстПисьма + "Партнером контактного лица """ + СокрЛП(КонтактноеЛицо) + """ является ""Неопределенный партнер""!" + Символы.ПС + Символы.ПС;
		КонецЕсли;
			
		Если ТЗКонтрагент.Количество() = 0 Тогда
			
			ТекстПисьма = ТекстПисьма + "По данным регистрации контактного лица:
										|ИНН: "			 + СокрЛП(Данные.INN) + "
										|КПП: " 		 + СокрЛП(Данные.KPP) + "
										|Наименование: " + СокрЛП(Данные.COMPANY_NAME) + "
										|Емайл: " 		 + СокрЛП(Данные.COMPANY_EMAIL) + "
 										|не найден контрагент!" + Символы.ПС + Символы.ПС;
		КонецЕсли;

		//Если ТЗКонтактноеЛицо.Количество() > 0 Тогда
		//	ТекстПисьма = ТекстПисьма + "У партнера контактного лица """ + СокрЛП(КонтактноеЛицо) + """ несколько прикрепленных контрагентов!" + Символы.ПС + Символы.ПС;
		//КонецЕсли;
		
		Если ТЗКонтрагент.Количество() > 0 И ЗначениеЗаполнено(ВыборкаКонтрагент.Контрагент) Тогда
			ТекстПисьма = ТекстПисьма + "Необходимо прикрепить партнера """ + СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер) + """ контактного лица """ + СокрЛП(КонтактноеЛицо) 
									  + """ к контрагенту """ + СокрЛП(ВыборкаКонтрагент.Контрагент) + "!" + Символы.ПС + Символы.ПС;
		КонецЕсли;
				
		Если ((ТЗКонтрагент.Количество() > 0 И ЗначениеЗаполнено(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагент))
			И (ВыборкаКонтрагент.Контрагент <> ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагент)) Тогда
			
			ТекстПисьма = ТекстПисьма + "Контрагент """ + СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагентНаименование) + """" + "
										|Наименование полное: " + СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагентНаименованиеПолное) + "
										|ИНН: "			 		+ СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагентИНН) + "
										|КПП: " 		 		+ СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнерКонтрагентКПП) + Символы.ПС 
									  + "контактного лица """ + СокрЛП(КонтактноеЛицо) + """" + Символы.ПС 
									  + "не совпадает с найденным по данным регистрации контрагентом: 
										|Наименование: " 		+ СокрЛП(ВыборкаКонтрагент.КонтрагентНаименование) + "
										|Наименование полное: " + СокрЛП(ВыборкаКонтрагент.КонтрагентНаименованиеПолное) + "
										|ИНН: "			 		+ СокрЛП(ВыборкаКонтрагент.КонтрагентИНН) + "
										|КПП: " 		 		+ СокрЛП(ВыборкаКонтрагент.КонтрагентКПП) + Символы.ПС 
									  + "Необходимо прикрепить партнера """ + СокрЛП(ВыборкаКонтактноеЛицо.КонтактноеЛицоПартнер) + """ контактного лица """ + СокрЛП(КонтактноеЛицо) 
									  + """ к контрагенту """ + СокрЛП(ВыборкаКонтрагент.Контрагент) + """!" + Символы.ПС + Символы.ПС;
			
		КонецЕсли;
			
	КонецЕсли;	

	Если ЗначениеЗаполнено(АдресПочты) И ЗначениеЗаполнено(ТекстПисьма) Тогда 
		
		ТекстШапки = "Здравствуйте!
				   	  |
					  |Требуется проверка регистрации на сайте контактного лица " + СокрЛП(КонтактноеЛицо) + ".
					  |
					  |";
		
	    УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		ДанныеДляОтправки = Новый Структура;
		ДанныеДляОтправки.Вставить("Кому", АдресПочты); 
	    ДанныеДляОтправки.Вставить("Тема", "Требуется проверка регистрации на сайте контактного лица " + СокрЛП(КонтактноеЛицо));
		ДанныеДляОтправки.Вставить("Тело", ТекстШапки + ТекстПисьма); 
	    ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
	    ДанныеДляОтправки.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);

		Если НЕ смартОбщегоНазначения.смартРабочаяБаза() Тогда
			ДанныеДляОтправки.Кому = АдресПочтыАдресаДляОтправкиОшибок;
			ДанныеДляОтправки.Тема = ДанныеДляОтправки.Тема + " " + СтрокаСоединенияИнформационнойБазы();
		КонецЕсли;	
		
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки); 

	КонецЕсли;	
			
КонецПроцедуры //--#1209 смарт: Лопато 12.10.2022

//++#1209 смарт: Лопато 12.10.2022 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Функция СмартНайтиКонтрагента(Данные)
	
	Контрагент = Неопределено;
	
	ЭтоИП = ЗначениеЗаполнено(Данные.INN) И СтрДлина(СокрЛП(Данные.INN)) = 12;
	ЭтоФизик = НЕ ЗначениеЗаполнено(Данные.INN) ИЛИ НЕ СтрДлина(СокрЛП(Данные.INN)) = 10;
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ИНН", 		  СокрЛП(Данные.INN));
	Запрос.УстановитьПараметр("КПП", 		  СокрЛП(Данные.KPP));
    Запрос.УстановитьПараметр("ИП", 		  ЭтоИП); 
    Запрос.УстановитьПараметр("Физик", 		  ЭтоФизик);
    Запрос.УстановитьПараметр("Наименование", СокрЛП(Данные.COMPANY_NAME));   
    Запрос.УстановитьПараметр("Емайл", 		  СокрЛП(Данные.COMPANY_EMAIL));

	Запрос.Текст="
	//|ВЫБРАТЬ ПЕРВЫЕ 1
	//|	1 КАК Порядок,
	//|	смартИдентификаторыСоответствияБитрикс.СсылкаМет КАК Ссылка
	//|ИЗ
	//|	РегистрСведений.СмартИдентификаторыСоответствияБитрикс КАК смартИдентификаторыСоответствияБитрикс
	//|ГДЕ
	//|	смартИдентификаторыСоответствияБитрикс.ИДсайта = &ИД
	//|
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	2,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И НЕ &Физик
	|	И Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	3,
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ 
	|	НЕ Контрагенты.ПометкаУдаления
	|	И &Физик
    |   И &ИП
    |	И Контрагенты.ИНН = &ИНН
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |	4,
    |	КонтрагентыКонтактнаяИнформация.Ссылка
    |ИЗ
    |	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
    |ГДЕ
	|	НЕ КонтрагентыКонтактнаяИнформация.Ссылка.ПометкаУдаления
	|	И &Физик
    |	И НЕ &ИП
  //  |	И КонтрагентыКонтактнаяИнформация.Ссылка.Партнер = &Партнер
    |	И (КонтрагентыКонтактнаяИнформация.Ссылка.Наименование = &Наименование
    |	ИЛИ КонтрагентыКонтактнаяИнформация.АдресЭП = &Емайл)             
    |
    |ОБЪЕДИНИТЬ ВСЕ
    |
    |ВЫБРАТЬ ПЕРВЫЕ 1
    |	5,
    |	Контрагенты.Ссылка
    |ИЗ
    |	Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И &Физик
    |	И НЕ &ИП
//    |	И Контрагенты.Партнер = &Партнер
    |	И Контрагенты.НаименованиеПолное = &Наименование";
	
	Рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 		
		Контрагент = Рез.Ссылка;
	КонецЕсли;	

	Возврат Контрагент;
	
КонецФункции //--#1209 смарт: Лопато 12.10.2022

Процедура ЗаполнитьДанныеКонтрагентаПоКлиенту(Контрагент,Данные)
	Контрагент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ФизЛицо;
	Контрагент.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	Контрагент.Наименование=Данные.NAME;
	Контрагент.НаименованиеПолное=Данные.NAME;
	Если ЗначениеЗаполнено(Данные.PHONE) Тогда 
	//++#1209 смарт: Лопато 28.02.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, Данные.PHONE, 
															 		 Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, , Ложь);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.EMAIL) Тогда 
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, Данные.EMAIL, 
															 		 Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, , Ложь);
	//--#1209 смарт: Лопато 28.02.2023
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗаполнитьДанныеКонтрагентаПоФНС(Контрагент,ДанныеКонтрагента)
	ЗаполнитьЗначенияСвойств(Контрагент, ДанныеКонтрагента);
	Если СтрДлина(Контрагент.ИНН)=10 Тогда 
		Контрагент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ЮрЛицо;
		Контрагент.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо;
	ИначеЕсли СтрДлина(Контрагент.ИНН)=12 Тогда 
		Контрагент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель;
		Контрагент.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	Иначе 
		Контрагент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ФизЛицо;
		Контрагент.ЮридическоеФизическоеЛицо=Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;
	КонецЕсли;
	Если Контрагент.НаименованиеПолное <> ДанныеКонтрагента.НаименованиеСокращенное Тогда
		Контрагент.НаименованиеПолное = ДанныеКонтрагента.НаименованиеСокращенное;
	КонецЕсли;
	
	Если ДанныеКонтрагента.Свойство("Телефон") И ЗначениеЗаполнено(ДанныеКонтрагента.Телефон) Тогда
	//++#1209 смарт: Лопато 28.02.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, ДанныеКонтрагента.Телефон, 
																	 Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, , Истина);
	//--#1209 смарт: Лопато 28.02.2023
	КонецЕсли;
	
	//++#1209 смарт: Лопато 28.02.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
	Если ДанныеКонтрагента.Свойство("ЮридическийАдрес") Тогда

		Если ТипЗнч(ДанныеКонтрагента.ЮридическийАдрес) = Тип("Структура") Тогда
			
			Если ДанныеКонтрагента.ЮридическийАдрес.Свойство("КонтактнаяИнформация") 
				 И УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(ДанныеКонтрагента.ЮридическийАдрес.КонтактнаяИнформация) Тогда
				
				УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, ДанныеКонтрагента.ЮридическийАдрес.КонтактнаяИнформация, 
																			 Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, , Истина);
				
			ИначеЕсли ДанныеКонтрагента.ЮридическийАдрес.Свойство("Представление") 
					  И ЗначениеЗаполнено(ДанныеКонтрагента.ЮридическийАдрес.Представление) Тогда
			
				УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, ДанныеКонтрагента.ЮридическийАдрес.Представление, 
																			 Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, , Истина);
			КонецЕсли;
																			 
			Успешно = Контрагент.смартЗаполнитьФактическийАдресПоЮридическому();
																		 
		КонецЕсли;
		
	КонецЕсли;
	//--#1209 смарт: Лопато 28.02.2023
КонецПроцедуры	

Функция ПолучитьНовогоПартнера(ДанныеКонтрагента,ДанныеКлиента)
	Партнер=Справочники.Партнеры.СоздатьЭлемент();
	//Партнер.ОбменДанными.Загрузка=Истина;
	Партнер.ДатаРегистрации=ТекущаяДата();
	Партнер.УстановитьНовыйКод();
	Если ДанныеКонтрагента=Неопределено Тогда
		СоздатьПартнераКакЧастноеЛицо(Партнер,ДанныеКлиента);
	Иначе
		СоздатьПартнераКакКомпанию(Партнер,ДанныеКонтрагента);
	КонецЕсли;	
	
	Попытка 
		Партнер.Записать();
		// здесь наверное нужно отправить данные по Партнеру на сайт
		Возврат Партнер.Ссылка;
	Исключение
	КонецПопытки;	
	
	Возврат Неопределено;
КонецФункции

Процедура СоздатьПартнераКакКомпанию(Партнер,ДанныеКонтрагента)
	Партнер.Наименование=ДанныеКонтрагента.Наименование;
	Партнер.НаименованиеПолное=ДанныеКонтрагента.Наименование;
	Партнер.Клиент=Истина;
	Партнер.Комментарий="#Загружено с сайта";
	Партнер.ЮрФизЛицо=Перечисления.КомпанияЧастноеЛицо.Компания;
	Если ДанныеКонтрагента.Свойство("ЮридическийАдрес") И ЗначениеЗаполнено(ДанныеКонтрагента.ЮридическийАдрес) Тогда 
		Стр=Партнер.КонтактнаяИнформация.Добавить();
		Стр.Тип=Перечисления.ТипыКонтактнойИнформации.Адрес;
		Стр.Вид=Справочники.ВидыКонтактнойИнформации.АдресПартнера;
		Стр.Значение=ДанныеКонтрагента.ЮридическийАдрес.КонтактнаяИнформация;
		Стр.Представление=ДанныеКонтрагента.ЮридическийАдрес.Представление;
	КонецЕсли;
	Если ДанныеКонтрагента.Свойство("Телефон") И  ЗначениеЗаполнено(ДанныеКонтрагента.Телефон) Тогда
		Стр=Партнер.КонтактнаяИнформация.Добавить();
		Стр.Тип=Перечисления.ТипыКонтактнойИнформации.Телефон;
		Стр.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		Стр.Значение=ДанныеКонтрагента.Телефон.КонтактнаяИнформация;
		Стр.Представление=ДанныеКонтрагента.Телефон.Представление;
		//++ #1938 смарт: Лопато 14.08.2024 //Ошибки создания нового клиента при регистрации пользователя ИМ  
		Стр.НомерТелефона = ПолучитьНомерТелефонаПоПредставлению(ДанныеКонтрагента.Телефон.Представление);
		//-- #1938 смарт: Лопато 14.08.2024
	КонецЕсли;
КонецПроцедуры	

Процедура СоздатьПартнераКакЧастноеЛицо(Партнер,ДанныеКлиента)
	Партнер.Наименование=ДанныеКлиента.NAME;
	Партнер.НаименованиеПолное=ДанныеКлиента.NAME;
	Партнер.Клиент=Истина;
	Партнер.Комментарий="#Загружено с сайта";
	//++ #1938 смарт: Лопато 14.08.2024 //Ошибки создания нового клиента при регистрации пользователя ИМ  
	Партнер.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	//-- #1938 смарт: Лопато 14.08.2024
	Партнер.Пол=?(ДанныеКлиента.GENDER="Ж",Перечисления.ПолФизическогоЛица.Женский,Перечисления.ПолФизическогоЛица.Мужской);
	Партнер.ДатаРождения=ПолучитьДатуИзСтроки(ДанныеКлиента.DATE_BIRTHDAY,Ложь);
	Если ЗначениеЗаполнено(ДанныеКлиента.EMAIL) Тогда
		Стр=Партнер.КонтактнаяИнформация.Добавить();
		Стр.Тип=Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		Стр.Вид=Справочники.ВидыКонтактнойИнформации.EmailПартнера;
		Стр.Представление=ДанныеКлиента.EMAIL;
		Стр.АдресЭП=ДанныеКлиента.EMAIL;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеКлиента.PHONE) Тогда 
		Стр=Партнер.КонтактнаяИнформация.Добавить();
		Стр.Тип=Перечисления.ТипыКонтактнойИнформации.Телефон;
		Стр.Вид=Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		Стр.Представление=ДанныеКлиента.PHONE;
		//++ #1938 смарт: Лопато 14.08.2024 //Ошибки создания нового клиента при регистрации пользователя ИМ  
		Стр.НомерТелефона = ПолучитьНомерТелефонаПоПредставлению(ДанныеКлиента.PHONE);
		//-- #1938 смарт: Лопато 14.08.2024
	КонецЕсли;	
КонецПроцедуры	

Функция ПолучитьКонтрагентаПартнераПоИНН(ИНН)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ИНН",ИНН);
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.Партнер КАК Партнер
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|	И Контрагенты.ЮрФизЛицо В (ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо), ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель), ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо))";
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.Партнер;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции	

