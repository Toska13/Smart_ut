Функция ПолучитьДанныеССайта(Ресурс)
    
    СсылкаПредопределенноеЗначение = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.СерверВыгрузки");
	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначение, Ложь);
    
	Соединение=Новый HTTPСоединение(Сервер,443,,,,,Новый ЗащищенноеСоединениеOpenSSL()); //"smart-t.testfact2.ru/" 
	Запрос=Новый HTTPЗапрос("rest/1/c3jq3eiu1fbmi0il/api."+Ресурс+".import/");
	Ответ=Соединение.Получить(Запрос);
	
	Возврат СтрокуJSONВДанные(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));  
    
КонецФункции

Процедура ОтправитьДанныеОЗаписиОбъекта(Ресурс,Параметры)
	СсылкаПредопределенноеЗначение = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.СерверВыгрузки");
	Сервер = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначение, Ложь);
	
	Соединение=Новый HTTPСоединение(Сервер,,,,,,Новый ЗащищенноеСоединениеOpenSSL()); //"smart-t.testfact2.ru/"
	Адрес="rest/1/c3jq3eiu1fbmi0il/api."+Ресурс+"/?";
	Для Каждого Эл Из Параметры Цикл 
		Адрес=Адрес+Эл.Ключ+"="+Эл.Значение+"&";
	КонецЦикла;	
	Адрес=Лев(Адрес,СтрДлина(Адрес)-1);
	Запрос=Новый HTTPЗапрос(Адрес);
	
	ДанныеОтвета=СтрокуJSONВДанные(Соединение.Получить(Запрос));
	
	Если Не ДанныеОтвета.result Тогда 
		ЗаписьЖурналаРегистрации("ОшибкаЗаписиНаСайте",,,Параметры.XML_ID,"После записи "+Ресурс+" в 1С сайт вернул ошибку по ID: "+Параметры.ID);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыФункции

Процедура ТестПолученияЗапросаНаПолучениеНовыхДанных(Данные,Тема)
	УчетнаяЗапись=РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ДанныеДляОтправки=Новый Структура;
	ДанныеДляОтправки.Вставить("Кому","debugging1c@smart-t.ru"); //+-#1207 смарт: Каратеев 06.10.2022 //Замена получателя рассылки.
	//ДанныеДляОтправки.Вставить("Копии","karateev@smart-t.ru");
	ДанныеДляОтправки.Вставить("Тема",Тема+" "+СтрокаСоединенияИнформационнойБазы()); //+-#1207 смарт: Каратеев 18.10.2022 //Добавление инфо из базы рассылки.
	ДанныеДляОтправки.Вставить("Тело",ДанныеВСтрокуJSON(Данные)); 
	ДанныеДляОтправки.Вставить("ТипТекста",ТипТекстаПочтовогоСообщения.ПростойТекст);
	ДанныеДляОтправки.Вставить("Важность",ВажностьИнтернетПочтовогоСообщения.Высокая);
	
	РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки);
КонецПроцедуры	

Процедура ЗаполнитьДопСвойствоОбъекта(Ссылка,ИДСайта)
	Поиск=Новый Структура("ГУИД,СсылкаМет",Ссылка.УникальныйИдентификатор(),Ссылка);
	МЗ=РегистрыСведений.смартИдентификаторыСоответствияБитрикс.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ,Поиск);
	МЗ.Прочитать();
	Если МЗ.Выбран() Тогда
		МЗ.ИДСайта=ИДСайта;
	Иначе
		Поиск.Вставить("ИДСайта",ИДСайта);
		ЗаполнитьЗначенияСвойств(МЗ,Поиск);
	КонецЕсли;	
	МЗ.Записать();
КонецПроцедуры	

