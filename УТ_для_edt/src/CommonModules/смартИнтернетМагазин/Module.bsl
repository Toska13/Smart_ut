Функция ПолучитьСтрануРегистрации(Данные)
	Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.СтраныМира
	|ГДЕ Наименование=&Данные
	|ИЛИ Код=&Данные
	|ИЛИ КодАльфа2=&Данные
	|ИЛИ КодАльфа3=&Данные");
	Запрос.УстановитьПараметр("Данные",Данные);
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
