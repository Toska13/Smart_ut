//Процедура УстановитьОсновноеКонтактноеЛицоПартнера(КонтактноеЛицо, Партнер) 
// Добавил (Экспорт)
Процедура УстановитьОсновноеКонтактноеЛицоПартнера(КонтактноеЛицо, Партнер) Экспорт
//-- #1999 смарт: Ермаков 05.09.2024
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
	    |	Ссылка КАК ДопРеквизитСсылка
	    |ПОМЕСТИТЬ ДопРеквизиты
	    |ИЗ
	    |	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения
	    |ГДЕ
        |	Имя = &ИмяДопРеквизита
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |	Свойство,
        |	Значение
        |ИЗ
        |	РегистрСведений.ДополнительныеСведения
        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДопРеквизиты КАК ДопРеквизиты
        |		ПО Объект = &Партнер И Свойство = ДопРеквизиты.ДопРеквизитСсылка";
	
	Запрос.УстановитьПараметр("Партнер", 		 Партнер);
	Запрос.УстановитьПараметр("ИмяДопРеквизита", "ОсновноеКонтактноеЛицоБитрикс");
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными(); 
	
	Если РезультатЗапроса[1].Пустой() Тогда 
		
		Выборка = РезультатЗапроса[0].Выбрать(); 
		
		Если Выборка.Следующий() Тогда
		
			МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи(); 
			
			МенеджерЗаписи.Объект   = Партнер; 
			МенеджерЗаписи.Свойство = Выборка.ДопРеквизитСсылка; 
			МенеджерЗаписи.Значение = КонтактноеЛицо; 
			
			МенеджерЗаписи.Записать();
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры //-- #1999 смарт: Лопато 27.08.2024

//++ #Б-990 смарт: Лопато 23.09.2024 //ИМ. Подготовить метод подтверждения (отклонения) регистрации пользователя на сайте  
Функция ПодтвердитьРегистрациюПользователяНаСайте(ПараметрыРегистрации) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	СтрокаОшибки = "";

	//++ #Б-1148 смарт: Лопато 16.10.2024 //ИМ. Регистрация пользователей на сайте. Переключатель режимов  
	Если НЕ Справочники.смартПредопределенныеЗначения.Настройки.НовыйРежимРегистрацииПользователейИМ Тогда

		Возврат "Новый режим регистрации пользователей сайта через почту выключен! Обратитесь в Департамент ИТ!";
		
	КонецЕсли;	
	//-- 1148 смарт: Лопато 16.10.2024	
	
	Если Б_ОбменССайтомСервер.смарт_ЭтоКопияБазы() Тогда
		
		//Возврат "Подтверждение/отклонение регистрации пользователя сайта возможно только в рабочей базе!";
		
	КонецЕсли;	
	
	//Чтение JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СокрЛП(ПараметрыРегистрации.JSON));
	
	Попытка 
		
		ДанныеСайта = ПрочитатьJSON(ЧтениеJSON);
		
	Исключение
		
		СтрокаОшибки = "Ошибка чтения JSON при подтверждении/отклонении регистрации пользователя сайта";
		
		ЗаписьЖурналаРегистрации("Ошибка подтверждения/отклонения регистрации пользователя сайта",,, СтрокаОшибки, ПараметрыРегистрации.JSON);

		смартОтправитьОшибкуНаПочту(СтрокаОшибки + ": " + ПараметрыРегистрации.JSON);
		
		Возврат СтрокаОшибки;
		
	КонецПопытки;

	Если НЕ ДанныеСайта.Свойство("ID")
		ИЛИ НЕ ЗначениеЗаполнено(ДанныеСайта.ID) Тогда
		
		СтрокаОшибки = "Пустое значение ID пользователя сайта";
		
		ЗаписьЖурналаРегистрации("Ошибка подтверждения/отклонения регистрации пользователя сайта",,, СтрокаОшибки, ПараметрыРегистрации.JSON);

		смартОтправитьОшибкуНаПочту(СтрокаОшибки + ": " + ПараметрыРегистрации.JSON);
		
		Возврат СтрокаОшибки;
		
	КонецЕсли;

	СайтПараметры = Новый Структура;
	
	СайтПараметры.Вставить("ID", 	  	   СтрЗаменить(СокрЛП(ДанныеСайта.ID), Символ(160), "")); 
	СайтПараметры.Вставить("REGISTRATION", XMLСтрока(ПараметрыРегистрации.РегистрацияПодтверждена)); 
	
	Если ПараметрыРегистрации.РегистрацияПодтверждена Тогда

		Результат = Истина;	
		
		//Проверка
		Если НЕ ЗначениеЗаполнено(ПараметрыРегистрации.КонтактноеЛицо) Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не заполнено контактное лицо";
			Результат = Ложь;
		КонецЕсли; 

		Если НЕ ЗначениеЗаполнено(ПараметрыРегистрации.Партнер) Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не заполнен партнер";
			Результат = Ложь;
		КонецЕсли;		

		Если НЕ ПараметрыРегистрации.Партнер.Клиент Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Партнер не является клиентом";
			Результат = Ложь;
		КонецЕсли;		
		
		Если НЕ ЗначениеЗаполнено(ПараметрыРегистрации.Контрагент) Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Не заполнен контрагент";
			Результат = Ложь;
		КонецЕсли;

		Если ПараметрыРегистрации.Партнер <> ПараметрыРегистрации.Контрагент.Партнер Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Партнер не принадлежит контрагенту";
			Результат = Ложь;
		КонецЕсли;

		Если ПараметрыРегистрации.КонтактноеЛицо.Владелец <> ПараметрыРегистрации.Партнер Тогда
			СтрокаОшибки = СтрокаОшибки + ?(СтрокаОшибки <> "", Символы.ПС, "") + "Контактное лицо не принадлежит партнеру";
			Результат = Ложь;
		КонецЕсли;
		
		Если НЕ Результат Тогда
			
			СтрокаОшибки = СтрокаОшибки + " при подтверждении регистрации нового пользователя сайта: ";
			
			СтрокаДанныхПользователя = "ID: " + ДанныеСайта.ID + ", " 
									   + "EMAIL: " + ДанныеСайта.EMAIL + ", " 
									   + "ФИО: " + ДанныеСайта.ФИО + ", "
									   + "Название компании: " + ДанныеСайта.НазваниеКомпании + ", " 
									   + "ИНН: " + ДанныеСайта.ИНН + ", "
									   + "КПП: " + ДанныеСайта.КПП;
			
			ЗаписьЖурналаРегистрации("Ошибка подтверждения/отклонения регистрации пользователя сайта",,, СтрокаОшибки + СтрокаДанныхПользователя);
			
			смартОтправитьОшибкуНаПочту(СтрокаОшибки + Символы.ПС + СтрокаДанныхПользователя);
			
			Возврат СтрокаОшибки;
			
		КонецЕсли;	
		
		//Подготовка контактного лица
		КонтактноеЛицоОбъект = ПараметрыРегистрации.КонтактноеЛицо.ПолучитьОбъект();

		//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
		КонтактноеЛицоОбъект.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
		//-- #Б-1138 смарт: Лопато 15.10.2024
		
		КонтактноеЛицоОбъект.смартЛогинНаСайте 			  = СокрЛП(ДанныеСайта.EMAIL);
		КонтактноеЛицоОбъект.смартЭлектроннаяПочтаНаСайте = СокрЛП(ДанныеСайта.EMAIL);
		КонтактноеЛицоОбъект.смартТелефонНаСайте 		  = СокрЛП(ДанныеСайта.Телефон);

		//++ #Б-1220  смарт: Лопато 25.10.2024 //Регистрация в ИМ. Подтверждение регистрации. Контактная информация КЛ  
		Если ЗначениеЗаполнено(ДанныеСайта.Телефон) И КонтактноеЛицоОбъект.КонтактнаяИнформация.Найти(ДанныеСайта.Телефон) = Неопределено Тогда
			
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(КонтактноеЛицоОбъект, ДанныеСайта.Телефон, 
																		 Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица, , Ложь);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСайта.EMAIL) И КонтактноеЛицоОбъект.КонтактнаяИнформация.Найти(ДанныеСайта.EMAIL) = Неопределено Тогда
			
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(КонтактноеЛицоОбъект, ДанныеСайта.EMAIL, 
																		 Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица, , Ложь);
																		 
		КонецЕсли;
		//-- #Б-1220 смарт: Лопато 25.10.2024
		
		//++ #Б3686 смарт: Шляпников 03.07.2025 / Проект smart-t.ru. API. Выгрузка "Личный кабинет" 
		Если ТипЗнч(ДанныеСайта.ID) = Тип("Число") Тогда
			КонтактноеЛицоОбъект.смартИдентификаторБитрикс = Формат(ДанныеСайта.ID, "ЧГ=");
		Иначе
			КонтактноеЛицоОбъект.смартИдентификаторБитрикс = ДанныеСайта.ID;
		КонецЕсли;
		
		КонтактноеЛицоОбъект.смартАктивностьНаСайте = Истина;
		//-- #Б3686 смарт: Шляпников 03.07.2025

		Попытка
			
