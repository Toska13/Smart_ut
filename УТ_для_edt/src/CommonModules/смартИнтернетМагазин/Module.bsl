Функция ОставитьТолькоЦиФрыВСтроке(СтрокаОбработки) Экспорт
	
	Результат = "";
	
	ПравильныеСимволы = "0123456789";
	
	Для Сч = 1 по СтрДлина(СтрокаОбработки) Цикл
		
		ТекСимв = Сред(СтрокаОбработки, Сч, 1);
		
		Если Найти(ПравильныеСимволы, ТекСимв) > 0 Тогда
			Результат = Результат + ТекСимв;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
