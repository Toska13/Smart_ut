Функция ПолучитьДатуИзСтроки(Стр,СоВременем)Экспорт 
	ДатаВремя=СтрРазделить(Стр," ",Ложь);
	ЧастьДата=СтрРазделить(ДатаВремя[0],".",Ложь);	
	Если СоВременем Тогда 
		ЧастьВремя=СтрРазделить(ДатаВремя[1],":",Ложь);
	КонецЕсли;
	Попытка
		Возврат Дата(ЧастьДата[2]+ЧастьДата[1]+ЧастьДата[0]+?(СоВременем,ЧастьВремя[0]+ЧастьВремя[1]+ЧастьВремя[2],""));
	Исключение
		Возврат '00010101';	
	КонецПопытки;
КонецФункции	

