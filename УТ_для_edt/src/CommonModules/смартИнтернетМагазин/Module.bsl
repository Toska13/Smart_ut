	Контрагент = СмартНайтиКонтрагента(Данные);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Контрагент,
		|	Контрагенты.ИНН КАК КонтрагентИНН,
		|	Контрагенты.КПП КАК КонтрагентКПП,
