//++#1209 смарт: Лопато 20.01.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Процедура смартЗаписатьКонтактнуюИнформациюКонтрагента(Контрагент, Эл)
	
	Если ЗначениеЗаполнено(Эл.COMPANY_PHONE) И Контрагент.КонтактнаяИнформация.Найти(Эл.COMPANY_PHONE) = Неопределено Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, Эл.COMPANY_PHONE, 
		Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента, , Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Эл.COMPANY_EMAIL) И Контрагент.КонтактнаяИнформация.Найти(Эл.COMPANY_EMAIL) = Неопределено Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Контрагент, Эл.COMPANY_EMAIL, 
		Справочники.ВидыКонтактнойИнформации.EmailКонтрагента, , Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Эл.INTERNATIONAL_NAME) И НЕ ЗначениеЗаполнено(Контрагент.НаименованиеМеждународное) Тогда
		Контрагент.НаименованиеМеждународное = Эл.INTERNATIONAL_NAME;
	КонецЕсли;	

	Если ЗначениеЗаполнено(Эл.OKPO) И НЕ ЗначениеЗаполнено(Контрагент.КодПоОКПО) Тогда
		Контрагент.КодПоОКПО = Эл.OKPO;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Эл.COMMENT) Тогда
		Если НЕ ЗначениеЗаполнено(Контрагент.ДополнительнаяИнформация) Тогда
			Контрагент.ДополнительнаяИнформация = Эл.COMMENT;
		ИначеЕсли СтрНайти(Контрагент.ДополнительнаяИнформация, Эл.COMMENT) = 0 Тогда
			Контрагент.ДополнительнаяИнформация = Контрагент.ДополнительнаяИнформация + Символы.ПС + Эл.COMMENT;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры //--#1209 смарт: Лопато 20.01.2023	

//++#1209 смарт: Лопато 20.01.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Функция смартСоздатьКонтрагента(Данные)

	Контрагент = Неопределено;
	
	ИНН = СокрЛП(Данные.INN);
	КПП = СокрЛП(Данные.KPP);
	
	Если СтрДлина(ИНН) = 10 Тогда
		ДанныеКонтрагента = РаботаСКонтрагентами.РеквизитыЮридическогоЛицаПоИНН(ИНН);
	ИначеЕсли СтрДлина(ИНН) = 12 Тогда
		ДанныеКонтрагента = РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(ИНН);
	Иначе
		ДанныеКонтрагента = Неопределено;
	КонецЕсли;
	
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	
	Если ДанныеКонтрагента = Неопределено Тогда
		ЗаполнитьДанныеКонтрагентаПоКлиенту(Контрагент, Данные);
	Иначе	
		ЗаполнитьДанныеКонтрагентаПоФНС(Контрагент, ДанныеКонтрагента);
	КонецЕсли;

	Если ЗначениеЗаполнено(ИНН) Тогда
		Контрагент.ИНН = ИНН;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(КПП) Тогда
		Контрагент.КПП = КПП;
	КонецЕсли;	
		
	Контрагент.ОбменДанными.Загрузка = Истина;
	
	//++ #1912 смарт: Лопато 26.08.2024 //Синхронизация связки Пользователь + Партнер  
	Контрагент.ДополнительныеСвойства.Вставить("смартЗаписьВерсииОбъектаПриЗагрузке");
	//-- #1912 смарт: Лопато 26.08.2024

	//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
	Контрагент.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
	//-- #Б-1138 смарт: Лопато 15.10.2024
	
	Попытка
		Контрагент.Записать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
	
	Возврат Контрагент;
	
КонецФункции //--#1209 смарт: Лопато 20.01.2023

//++#1209 смарт: Лопато 20.01.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Функция смартСоздатьПартнера(Данные, Контрагент)

	Партнер = Справочники.Партнеры.СоздатьЭлемент();
	Партнер.ОбменДанными.Загрузка = Истина;
	Партнер.ДатаРегистрации = ТекущаяДата();
	Партнер.УстановитьНовыйКод();
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ИНН = Контрагент.ИНН;
	Иначе
		ИНН = СокрЛП(Данные.INN);
	КонецЕсли;	
	
	Если СтрДлина(ИНН) = 10 Тогда
		ДанныеКонтрагента = РаботаСКонтрагентами.РеквизитыЮридическогоЛицаПоИНН(ИНН);
	ИначеЕсли СтрДлина(ИНН) = 12 Тогда
		ДанныеКонтрагента = РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(ИНН);
	Иначе
		ДанныеКонтрагента = Неопределено;
	КонецЕсли;
	
	Если ДанныеКонтрагента = Неопределено Тогда
		СоздатьПартнераКакЧастноеЛицо(Партнер, Данные);
	Иначе
		СоздатьПартнераКакКомпанию(Партнер, ДанныеКонтрагента);
	КонецЕсли;	

	//++ #1938 смарт: Лопато 14.08.2024 //Ошибки создания нового клиента при регистрации пользователя ИМ  
	Партнер.ОсновнойМенеджер = Справочники.смартПредопределенныеЗначения.ПользовательИнтернетМагазина.Значение;
	
	СтрокаРегион = ОпределитьБизнесРегионОбъектаПоТелефону(Партнер);

	Если ЗначениеЗаполнено(СтрокаРегион) Тогда
		Партнер.БизнесРегион = НайтиРегион(СтрокаРегион);
	КонецЕсли;
	//-- #1938 смарт: Лопато 14.08.2024
	
	//++ #1912 смарт: Лопато 26.08.2024 //Синхронизация связки Пользователь + Партнер  
	Партнер.ДополнительныеСвойства.Вставить("смартЗаписьВерсииОбъектаПриЗагрузке");
	//-- #1912 смарт: Лопато 26.08.2024

	//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
	Партнер.смартДатаНачалаОбменаДокументамиИМ = ТекущаяДата();
	
	Партнер.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
	//-- #Б-1138 смарт: Лопато 15.10.2024
	
	Попытка 
		Партнер.Записать();
	Исключение
		Возврат Неопределено;
	КонецПопытки;	

	Возврат Партнер.Ссылка;
	
КонецФункции //--#1209 смарт: Лопато 20.01.2023

//++#1605 смарт: Лопато 16.01.2024 //Доработки по интернет-магазину
Процедура смартЗаполнитьКонтактноеЛицоДаннымиСайта(КонтактноеЛицо, Эл)

	ФИОСтрокой = СокрЛП(Эл.NAME);

	КонтактноеЛицо.Наименование = ФИОСтрокой;
	
	смартОбщегоНазначения.смартЗаполнитьФИОКонтактногоЛицаПартнера(КонтактноеЛицо, Истина);
	
	//Определение пола
    Если Эл.GENDER = "Ж" Тогда
        Пол = Перечисления.ПолФизическогоЛица.Женский;
    ИначеЕсли Эл.GENDER = "М" Тогда        
        Пол = Перечисления.ПолФизическогоЛица.Мужской;
    Иначе
        Пол = Неопределено;
    КонецЕсли;    

	Если НЕ ЗначениеЗаполнено(Пол) Тогда
		Пол = CRM_КлиентыСервер.ОпределитьПол(КонтактноеЛицо.CRM_Имя);
	КонецЕсли;

	КонтактноеЛицо.Пол = Пол;
	
	//Другие поля
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо.ДатаРегистрацииСвязи) Тогда
		КонтактноеЛицо.ДатаРегистрацииСвязи = ПолучитьДатуИзСтроки(Эл.DATE_REGISTER, Ложь);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо.Автор) Тогда
		КонтактноеЛицо.Автор = Пользователи.ТекущийПользователь();
	КонецЕсли; 
	
	КонтактноеЛицо.ДатаРождения 				= ПолучитьДатуИзСтроки(Эл.DATE_BIRTHDAY, Ложь);
	КонтактноеЛицо.ДолжностьПоВизитке 			= Эл.POSITION;                      
	КонтактноеЛицо.смартЭлектроннаяПочтаНаСайте = Эл.EMAIL;
	КонтактноеЛицо.смартЛогинНаСайте 			= Эл.LOGIN;
	
	Если ЗначениеЗаполнено(Эл.PHONE) И НЕ ЗначениеЗаполнено(КонтактноеЛицо.смартТелефонНаСайте) Тогда
		КонтактноеЛицо.смартТелефонНаСайте = Эл.PHONE;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Эл.UF_ROLE_COMPANY) Тогда
		КонтактноеЛицо.CRM_РольКонтактногоЛица = Справочники.РолиКонтактныхЛицПартнеров.ПолучитьСсылку(Новый УникальныйИдентификатор(Эл.UF_ROLE_COMPANY));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо.CRM_Состояние) Тогда
		КонтактноеЛицо.CRM_Состояние = Перечисления.CRM_Состояние.Работает;
	КонецЕсли;	
	
КонецПроцедуры //--#1605 смарт: Лопато 16.01.2024

//++#1209 смарт: Лопато 20.01.2023 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Процедура смартОтправитьОшибкуНаПочту(ТекстОшибки)
	
	СсылкаПредопределенноеЗначениеАдресаДляОтправкиОшибок = ПредопределенноеЗначение("Справочник.смартПредопределенныеЗначения.АдресаДляОтправкиОшибок");
	АдресПочтыАдресаДляОтправкиОшибок = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаПредопределенноеЗначениеАдресаДляОтправкиОшибок, Ложь);
	Если НЕ ЗначениеЗаполнено(АдресПочтыАдресаДляОтправкиОшибок) Тогда
		Возврат;
	КонецЕсли;	

	ДанныеДляОтправки = Новый Структура;
	ДанныеДляОтправки.Вставить("Кому", АдресПочтыАдресаДляОтправкиОшибок); 
    ДанныеДляОтправки.Вставить("Тема", "Ошибка регистрации на сайте контактного лица" + " " + СтрокаСоединенияИнформационнойБазы());
	ДанныеДляОтправки.Вставить("Тело", ТекстОшибки); 
    ДанныеДляОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
    ДанныеДляОтправки.Вставить("Важность", ВажностьИнтернетПочтовогоСообщения.Высокая);

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ДанныеДляОтправки); 
	
КонецПроцедуры //--#1209 смарт: Лопато 12.10.2022
	
//++#1209 смарт: Лопато 12.10.2022 //Исправить поиск и заполнение контрагента при регистрации пользователя  
Процедура смартПроверитьПартнераКонтрагентаКонтактногоЛица(КонтактноеЛицо, Данные)
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
