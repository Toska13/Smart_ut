	|	КурсВалюты.Валюта КАК Валюта,
	|	ВЫБОР 
	|		КОГДА КурсВалюты.Кратность * КурсВалютыОтчета.Курс <> 0 
	|			ТОГДА КурсВалюты.Курс * КурсВалютыОтчета.Кратность / (КурсВалюты.Кратность * КурсВалютыОтчета.Курс)
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ КАК Коэффициент
	|ПОМЕСТИТЬ Курс
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаТек, ) КАК КурсВалюты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаТек, Валюта = &Валюта) КАК КурсВалютыОтчета
	|		ПО (ИСТИНА)
	|ГДЕ
	|	КурсВалюты.Кратность <> 0
	|	И КурсВалютыОтчета.Курс <> 0
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Данные по договорам с расчетом допустимого лимита по курсу на дату запроса
	|ВЫБРАТЬ
	|	Ссылка КАК Договор,
	|	Партнер КАК Партнер,
	|	Контрагент КАК Контрагент,
	|	Номер КАК Номер,
	|	Дата КАК ДатаНачалаДействия,
	|	ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ВЫБОР
	|		КОГДА ДопустимаяСуммаЗадолженности > 0 И ОграничиватьСуммуЗадолженности 
	|			ТОГДА ДопустимаяСуммаЗадолженности * ЕСТЬNULL(Курс.Коэффициент, 1)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ДопустимаяСуммаЗадолженности
	|ПОМЕСТИТЬ Договоры
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Курс КАК Курс
	|		ПО ВалютаВзаиморасчетов = Курс.Валюта
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Договор ИЗ АнализируемыеДоговоры)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	Партнер,
	|	Ссылка,
	|	"""",
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0),
	|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0),
	|	0
	|ИЗ
	|	Справочник.Контрагенты
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Контрагент ИЗ Контрагенты)	
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|//Все не закрытые заказы с отбором по ключам аналитики
	|ВЫБРАТЬ
	|	Ссылка,
	|	Дата,
	|	Валюта,
	|	ВЫБОР 
	|		КОГДА Договор = НЕОПРЕДЕЛЕНО 
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|		ИНАЧЕ Договор
	|	КОНЕЦ КАК Договор
	|ПОМЕСТИТЬ Заказы
	|ИЗ
	|	Документ.ЗаказКлиента
	|ГДЕ
	|	Проведен
	|	И НЕ Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И (Партнер, Контрагент, Договор) 
	|	      В (ВЫБРАТЬ Партнер, Контрагент, Договор ИЗ КлючиАналитикиУчетаПоПартнерам)
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Остатки по неотгруженным заказам с пересчетом сумм по курсу на дату запроса
	|ВЫБРАТЬ 
	|	ЗаказКлиента КАК ЗаказКлиента,
	|	ВЫБОР 
	|		КОГДА ЗаказКлиента.Договор = НЕОПРЕДЕЛЕНО 
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|		ИНАЧЕ ЗаказКлиента.Договор
	|	КОНЕЦ КАК Договор,
	|	ЗаказКлиента.Валюта КАК Валюта,
	|	СуммаОстаток * ЕСТЬNULL(Курс.Коэффициент, 1) КАК СуммаОстаток
	|ПОМЕСТИТЬ ЗаказыБезРеализацииПред
	|ИЗ
	|	РегистрНакопления.ЗаказыКлиентов.Остатки(, ЗаказКлиента В (ВЫБРАТЬ Ссылка ИЗ Заказы))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Курс КАК Курс
	|		ПО ЗаказКлиента.Валюта = Курс.Валюта
	|;	
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Неотгруженные заказы, в которых установлен резерв или отгрузить
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка.Договор КАК Договор,
	|	СУММА(ЗаказыБезРеализацииПред.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ЗаказыБезРеализацииУстановленРезервИлиОтгрузить
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаказыБезРеализацииПред КАК ЗаказыБезРеализацииПред
	|		ПО ЗаказКлиентаТовары.Ссылка = ЗаказыБезРеализацииПред.ЗаказКлиента
	|ГДЕ
	|	НЕ ЗаказКлиентаТовары.Отменено
	|		И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	|			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно))
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка.Договор
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Остатки расчетов в суммах регл учета на дату запроса
	|ВЫБРАТЬ
	|	Расчеты.Контрагент                                      КАК Контрагент,
	|	Расчеты.Договор                                         КАК Договор,
	|	Расчеты.ОбъектРасчетов                                  КАК ОбъектРасчетов,
	|	СУММА(Расчеты.ДолгКлиентаКонечныйОстаток)               КАК ДолгКлиентаКонечныйОстаток,
	|	СУММА(Расчеты.НашДолгКонечныйОстаток)                   КАК НашДолгКонечныйОстаток
	|ПОМЕСТИТЬ РасчетыПред	
	|ИЗ (ВЫБРАТЬ
	|		АналитикаУчета.Контрагент                                      КАК Контрагент,
	|		АналитикаУчета.Договор                                         КАК Договор,
	|		РасчетыПоСрокам.ОбъектРасчетов                                 КАК ОбъектРасчетов,
	|		РасчетыПоСрокам.ДолгРеглОстаток                                КАК ДолгКлиентаКонечныйОстаток,
	|		РасчетыПоСрокам.ПредоплатаРеглОстаток                          КАК НашДолгКонечныйОстаток
	|	ИЗ
	|		РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			&ДатаТек, 
	|			АналитикаУчетаПоПартнерам В (ВЫБРАТЬ Ссылка ИЗ КлючиАналитикиУчетаПоПартнерам)
	|		) КАК РасчетыПоСрокам
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаУчета
	|				ПО РасчетыПоСрокам.АналитикаУчетаПоПартнерам = АналитикаУчета.КлючАналитики
	|	) КАК Расчеты
	|
	|СГРУППИРОВАТЬ ПО
	|	Расчеты.Контрагент,
	|	Расчеты.Договор,
	|	Расчеты.ОбъектРасчетов
	|
	|ИМЕЮЩИЕ
	|	СУММА(Расчеты.ДолгКлиентаКонечныйОстаток) <> 0
	|	ИЛИ СУММА(Расчеты.НашДолгКонечныйОстаток) <> 0
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Остатки расчетов, где объект расчета это заказ клиента
	|ВЫБРАТЬ
	|	Договор,
	|	СУММА(РасчетыПред.ДолгКлиентаКонечныйОстаток) - СУММА(РасчетыПред.НашДолгКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ Расчеты
	|ИЗ
	|	РасчетыПред КАК РасчетыПред
	|ГДЕ
	|	РасчетыПред.ОбъектРасчетов ССЫЛКА Документ.ЗаказКлиента	
	|
	|СГРУППИРОВАТЬ ПО
	|	Договор
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|//Остатки расчетов, у которых объект расчетов сам документ поступления ДС
	|ВЫБРАТЬ
	|	Договор,
	|	СУММА(РасчетыПред.НашДолгКонечныйОстаток) КАК Аванс
	|ПОМЕСТИТЬ Авансы
	|ИЗ
	|	РасчетыПред КАК РасчетыПред
	|ГДЕ
	|	НЕ РасчетыПред.ОбъектРасчетов ССЫЛКА Документ.ЗаказКлиента	
	|
	|СГРУППИРОВАТЬ ПО
	|	Договор
	|;
	|////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	1 																			  КАК Пакет,
	|	""ДоговорыКонтрагентов"" 													  КАК ПользовательскийСправочник,
	|	ПРЕДСТАВЛЕНИЕ(&Валюта)														  КАК CURRENCY,
	|
	|	Договоры.Партнер 															  КАК Партнер,
	|	Договоры.Контрагент 														  КАК Контрагент,
	|	Договоры.Контрагент 														  КАК Объект,
	|
	|	ПРЕДСТАВЛЕНИЕ(Договоры.Договор)												  КАК Договор,
	|	Договоры.Номер 																  КАК NUMBER,
	|	Договоры.ДатаНачалаДействия 												  КАК TERM,
	|	Договоры.ДатаОкончанияДействия 												  КАК TERMEND,
	|	ИСТИНА                                                        				  КАК VALID,
	|
	|	ВЫРАЗИТЬ(Договоры.ДопустимаяСуммаЗадолженности КАК ЧИСЛО(15, 2)) 			  КАК DOPUSTIMAYASUMMA,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(Авансы.Аванс, 0) КАК ЧИСЛО(15, 2)) 						  КАК AVANS,
	|	ВЫРАЗИТЬ((ЕСТЬNULL(Расчеты.СуммаКонечныйОстаток, 0) * (-1)) КАК ЧИСЛО(15, 2)) КАК DEBIT,
	|	ВЫБОР
	|		КОГДА Договоры.Договор ЕСТЬ NULL 
	|				ИЛИ Договоры.ДопустимаяСуммаЗадолженности = 0
	|			ТОГДА 0
	|		ИНАЧЕ
	|				ВЫРАЗИТЬ(ЕСТЬNULL(ЗаказыРезервИлиОтгрузить.Сумма, 0)
	|						 КАК ЧИСЛО(15, 2))
	|	КОНЕЦ 					   													  КАК RESERV,
	|	ВЫБОР
	|		КОГДА Договоры.Договор ЕСТЬ NULL 
	|				ИЛИ Договоры.ДопустимаяСуммаЗадолженности = 0
	|			ТОГДА 0
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(Договоры.ДопустимаяСуммаЗадолженности
	|					- ЕСТЬNULL(ЗаказыРезервИлиОтгрузить.Сумма, 0) 
	|					- ЕСТЬNULL(Расчеты.СуммаКонечныйОстаток, 0)
	|					КАК ЧИСЛО(15, 2))
	|	КОНЕЦ 				 														  КАК OSTATOK
	|ИЗ
	|	Договоры КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Расчеты КАК Расчеты
	|		ПО Договоры.Договор = Расчеты.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗаказыБезРеализацииУстановленРезервИлиОтгрузить КАК ЗаказыРезервИлиОтгрузить
	|		ПО Договоры.Договор = ЗаказыРезервИлиОтгрузить.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ Авансы КАК Авансы
	|		ПО Договоры.Договор = Авансы.Договор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент,
	|	Партнер,
	|	Договоры.Договор УБЫВ
	|АВТОУПОРЯДОЧИВАНИЕ";
	//-- #Б-1742 смарт: Лопато 04.02.2025
	
	Запрос.УстановитьПараметр("CONTRAGENTS",		 CONTRAGENTS);
	Запрос.УстановитьПараметр("ДатаТек",			 ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Организация",		 Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение);
	//++#1282 смарт: Лопато 10.01.2023 //Ошибки в работе механизма Состояние взаиморасчетов
	Запрос.Параметры.Вставить("Валюта", 			 Константы.ВалютаРегламентированногоУчета.Получить()); //руб.
	//--#1282 смарт: Лопато 10.01.2023
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции //--#1846 смарт: Лопато 04.06.2024

//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 11.10.2021 13:16:28
Функция MD5ХешСтрока(тСтрока) Экспорт
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	
	Хеш.Добавить(тСтрока);
	
	Возврат Хеш.ХешСумма; 
КонецФункции

