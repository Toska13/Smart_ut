Функция СформироватьХэшПоДокументу(Документ, ИзмененияТабЧасти = Ложь)
	
	Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ТЗНоменклатура = Документ.Товары.Выгрузить(Новый Структура("Отменено", Ложь));
	ИначеЕсли ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
		ТЗНоменклатура = Документ.ОтгружаемыеТовары.Выгрузить();
	Иначе
		ТЗНоменклатура = Документ.Товары.Выгрузить();
	КонецЕсли;
	
	ТЗНоменклатура.Колонки.Добавить("Наименование");
	ТЗНоменклатура.Колонки.Добавить("Учитывать");
	
	МассивСтрок = Новый Массив;
	
	Для каждого стрНоменклатура Из ТЗНоменклатура Цикл
		
		стрНоменклатура.Наименование = стрНоменклатура.Номенклатура.Наименование;
		
		Если НЕ ИзмененияТабЧасти Тогда
			стрНоменклатура.Учитывать = НоменклатураПодлежитОбязательнойМаркировке(стрНоменклатура.Номенклатура);
		Иначе
			стрНоменклатура.Учитывать = НоменклатураПодлежитЭксперементальнойМаркировке(стрНоменклатура.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	ТЗНоменклатура.Сортировать("Наименование");
	
	Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		МассивСтрок.Добавить(СтрШаблон("ОтгруженоФИН:%1", Документ.СогласованоБух));
	КонецЕсли;
	
	Для каждого стрНоменклатура Из ТЗНоменклатура Цикл
		
		Если НЕ стрНоменклатура.Учитывать Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(стрНоменклатура.Наименование);
		
		Если ИзмененияТабЧасти Тогда
			
			МассивСтрок.Добавить(стрНоменклатура.Количество);
			
		КонецЕсли;
		
		Если ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			МассивСтрок.Добавить(СокрЛП(?(стрНоменклатура.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить ИЛИ стрНоменклатура.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно, "Отгрузить", "")));
		КонецЕсли;
		
	КонецЦикла;
	
	CRC32 = Новый ХешированиеДанных(ХешФункция.CRC32);
	CRC32.Добавить(СтрСоединить(МассивСтрок, ";"));
	
	Хэш = СтрЗаменить(Строка(CRC32.ХешСумма), Символы.НПП, "");
	
	Возврат Хэш;
	
КонецФункции

Функция НайтиКИЗПоШК(ЗНАЧ Штрихкод) Экспорт
	
	Штрихкод = ОтформатироватьКИЗИВыкинутьКриптохвост(Штрихкод);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|ГДЕ
	|	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеШтрихкода";
	
	Запрос.УстановитьПараметр("ЗначениеШтрихкода", Штрихкод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Ссылка <> NULL Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти