Функция ПолучитьСообщениеОБудущейМаркировкеНоменклатуры(МассивНоменклатуры, МассивХарактеристик, Дата) Экспорт
	
	МассивНоменклатурыВРаботе = Новый Массив;
	МассивХарактеристикВРаботе = Новый Массив;
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
			МассивНоменклатуры, 
			"смартОбязательнаяМаркировка,смартДатаНачалаОбязательнойМаркировки,Наименование");
	
	Для н = 0 По МассивНоменклатуры.Количество() - 1 Цикл
	
		Если РеквизитыНоменклатуры[МассивНоменклатуры[н]].смартОбязательнаяМаркировка
			И ЗначениеЗаполнено(РеквизитыНоменклатуры[МассивНоменклатуры[н]].смартДатаНачалаОбязательнойМаркировки)
			И РеквизитыНоменклатуры[МассивНоменклатуры[н]].смартДатаНачалаОбязательнойМаркировки > Дата Тогда
			
			МассивНоменклатурыВРаботе.Добавить(МассивНоменклатуры[н]);
			МассивХарактеристикВРаботе.Добавить(МассивХарактеристик[н]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Склад КАК Склад,
		|	Остатки.ВНаличииОстаток - Остатки.ВРезервеСоСкладаОстаток КАК КоличествоВНаличии,
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Характеристика КАК Характеристика
		|ИЗ
		|	РегистрНакопления.СвободныеОстатки.Остатки(
		|			&ДатаОстатков,
		|			Номенклатура В (&Номенклатура)
		|				И Характеристика В (&Характеристика)) КАК Остатки
		|ГДЕ
		|	Остатки.ВНаличииОстаток - Остатки.ВРезервеСоСкладаОстаток > 0";
	
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатурыВРаботе);
	Запрос.УстановитьПараметр("Характеристика", МассивХарактеристикВРаботе);
	Запрос.УстановитьПараметр("ДатаОстатков", Дата);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	МассивСообщений = Новый Массив;
	
	Для н = 0 По МассивНоменклатурыВРаботе.Количество() - 1 Цикл
	
		ДатаНачала = Формат(
					РеквизитыНоменклатуры[МассивНоменклатурыВРаботе[н]].смартДатаНачалаОбязательнойМаркировки, 
					"ДФ=dd.MM.yyyy");
			
		ТекстСообщения = СтрШаблон(
			"В документе содержится маркируемый товар: %1. С %2 начинает действовать обязательная маркировка. Скорректируйте дату на реальную.",
			РеквизитыНоменклатуры[МассивНоменклатурыВРаботе[н]].Наименование,
			ДатаНачала);
			
		МассивСообщений.Добавить(ТекстСообщения);
		
		МассивСообщений.Добавить(ПолучитьСообщениеОБудущейМаркировкеНоменклатурыПоОстаткам(ТаблицаОстатков.НайтиСтроки(Новый Структура("Номенклатура,Характеристика", МассивНоменклатурыВРаботе[н], МассивХарактеристикВРаботе[н]))));
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСообщений, Символы.ПС);
	
КонецФункции

Функция ПолучитьСообщениеОБудущейМаркировкеНоменклатурыПоОстаткам(ТаблицаОстатков)
	
	ТекстСообщения = "";
	
	Если ТаблицаОстатков.Количество() > 0 Тогда
		
		ТекстСообщения = ТекстСообщения	+ "Для доступного остатка необходимо заказать коды маркировки.";
		ТекстСообщения = ТекстСообщения + Символы.ПС + "Текущий доступный остаток:";
		
		Для каждого Выборка Из ТаблицаОстатков Цикл
			
			СтрокаСклад = СтрШаблон(
				"%1 %2 - %3",
				Выборка.Склад.Наименование,
				Выборка.Номенклатура.Наименование,
				Выборка.КоличествоВНаличии);
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтрокаСклад;
			
		КонецЦикла;
			
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции

Процедура ПроверитьЗаполненностьСерииМаркированныхТоваров(Документ, Отказ) Экспорт
	
	Для каждого стрТовар Из Документ.Товары Цикл
		
		Если смартМаркировка.НоменклатураПодлежитОбязательнойМаркировке(стрТовар.Номенклатура, Документ.Дата) Тогда
			
			Если Не ЗначениеЗаполнено(стрТовар.Серия) Тогда
				ТекстСообщения = СтрШаблон(
					"Для маркированного товара '%1' (строка %2) не заполнена серия.",
					стрТовар.Номенклатура,
					стрТовар.НомерСтроки);
				
				ИмяПоля = "Товары[" + (стрТовар.НомерСтроки - 1) + "].Серия";
				
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					Документ,
					ИмяПоля,
					"",
					Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОтформатироватьКИЗИВыкинутьКриптохвост(Знач ПолныйКод) Экспорт
	
	ПолныйКод = СтрЗаменить(ПолныйКод, "○", Символ(29));
	
	ШК = ШтрихкодированиеИС.КодGS1ДляКомпонентыПечати(ПолныйКод, 2);
	
	// Сначала ищем скобочный вариант "(91)"/"(92)" — результат работы парсера
	Позиция = Мин(СтрНайти(ШК, "(91)"), СтрНайти(ШК, "(92)"));
	
	// Если не нашли — ищем "91"/"92" после позиции 38 (конец блока GTIN+Serial)
	Если Позиция = 0 И СтрДлина(ШК) >= 39 Тогда
		Остаток = Сред(ШК, 39);
		ПозицияВХвосте = Мин(СтрНайти(Остаток, "91"), СтрНайти(Остаток, "92"));
		Если ПозицияВХвосте > 0 Тогда
			Позиция = 38 + ПозицияВХвосте;
		КонецЕсли;
	КонецЕсли;
	
	Если Позиция > 0 Тогда
		ШК = Лев(ШК, Позиция - 2);
	КонецЕсли;
	
	Возврат ШК;
	
КонецФункции

