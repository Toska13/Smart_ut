Функция ПолучитьМаркируемыйТоварИзКоллекции(ТаблицаТовары, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.*
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	&ТаблицаТовары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.*
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура";
	
	Запрос.УстановитьПараметр("ТаблицаТовары", ТаблицаТовары);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Количество = ТЗ.Количество();
	
	Для н = 1 По Количество Цикл
		
		ТекСтрока = ТЗ[Количество - н];
		Если НЕ НоменклатураПодлежитОбязательнойМаркировке(ТекСтрока.Номенклатура, Дата) Тогда
			ТЗ.Удалить(ТекСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции 

Функция ПолучитьРеализацииСНеподобраннымиШтрихкодамиУпаковок(ТаблицаТоварыПоРаспоряжениям) Экспорт	
	
	ТаблицаТоваровРеализацииСНеподобраннымиШтрихкодамиУпаковок = ПолучитьТаблицуТоваровРеализацииСНеподобраннымиШтрихкодамиУпаковок(ТаблицаТоварыПоРаспоряжениям);
	ТаблицаРеализаций = ТаблицаТоваровРеализацииСНеподобраннымиШтрихкодамиУпаковок.Скопировать(, "РеализацияТоваровУслуг");
	ТаблицаРеализаций.Свернуть("РеализацияТоваровУслуг");
	
	Возврат ТаблицаРеализаций.ВыгрузитьКолонку("РеализацияТоваровУслуг");
	
КонецФункции 

Функция ПолучитьТаблицуТоваровРеализацииСНеподобраннымиШтрихкодамиУпаковок(ТаблицаТоварыПоРаспоряжениям) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТоварыПоРаспоряжениям.Распоряжение КАК Распоряжение,
	|	ТоварыПоРаспоряжениям.Номенклатура КАК Номенклатура,
	|	ТоварыПоРаспоряжениям.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ТоварыПоРаспоряжениям
	|ИЗ
	|	&ТоварыПоРаспоряжениям КАК ТоварыПоРаспоряжениям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка КАК РеализацияТоваровУслуг,
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	РеализацияТоваровУслугТовары.Характеристика КАК Характеристика,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_ТоварыПоРеализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ПО (РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение = РеализацияТоваровУслугТовары.ЗаказКлиента)
	|			И (РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Номенклатура = РеализацияТоваровУслугТовары.Номенклатура)
	|			И (РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Характеристика = РеализацияТоваровУслугТовары.Характеристика)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка,
	|	РеализацияТоваровУслугТовары.Номенклатура,
	|	РеализацияТоваровУслугТовары.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка КАК РеализацияТоваровУслуг,
	|	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика КАК Характеристика,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки) КАК Количество
	|ПОМЕСТИТЬ ВТ_ШтрихкодыПоРеализации
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК РеализацияТоваровУслугШтрихкодыУпаковок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	|		ПО РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ПО (РеализацияТоваровУслугШтрихкодыУпаковок.ШтрихкодУпаковки = ШтрихкодыУпаковокТоваров.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугШтрихкодыУпаковок.Ссылка,
	|	ШтрихкодыУпаковокТоваров.Номенклатура,
	|	ШтрихкодыУпаковокТоваров.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыПоРеализации.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг,
	|	ВТ_ТоварыПоРеализации.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыПоРеализации.Характеристика КАК Характеристика,
	|	ВТ_ТоварыПоРеализации.Количество КАК КоличествоВДокументе,
	|	ЕСТЬNULL(ВТ_ШтрихкодыПоРеализации.Количество, 0) КАК КоличествоПодобрано
	|ИЗ
	|	ВТ_ТоварыПоРеализации КАК ВТ_ТоварыПоРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ШтрихкодыПоРеализации КАК ВТ_ШтрихкодыПоРеализации
	|		ПО ВТ_ТоварыПоРеализации.РеализацияТоваровУслуг = ВТ_ШтрихкодыПоРеализации.РеализацияТоваровУслуг
	|			И ВТ_ТоварыПоРеализации.Номенклатура = ВТ_ШтрихкодыПоРеализации.Номенклатура
	|			И ВТ_ТоварыПоРеализации.Характеристика = ВТ_ШтрихкодыПоРеализации.Характеристика
	|ГДЕ
	|	НЕ ВТ_ТоварыПоРеализации.Количество = ЕСТЬNULL(ВТ_ШтрихкодыПоРеализации.Количество, 0)";
	
	Запрос.УстановитьПараметр("ТоварыПоРаспоряжениям", ТаблицаТоварыПоРаспоряжениям);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
