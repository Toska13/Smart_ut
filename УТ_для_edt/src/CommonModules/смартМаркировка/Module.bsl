Функция ПредупреждениеПоДокументуБылоОтправленоРанее(Документ, ИзмененияТабЧасти = Ложь) Экспорт
	
	Если Документ.Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Хэш = СформироватьХэшПоДокументу(Документ, ИзмененияТабЧасти);
	
	Если НЕ ИзмененияТабЧасти Тогда
		ИмяСвойства = "УведомлениеОМаркировкеОтправлено";
		ИмяХэш = "МаркировкаХэшСумма";
	Иначе
		ИмяСвойства = "УведомлениеОМаркировкеОтправленоИзменения";
		ИмяХэш = "МаркировкаХэшСуммаИзменения";
	КонецЕсли;
	
	Данные = смартСерверПривилегированный.ПолучитьДополнительныеДанныеОбъекта(Документ.Ссылка);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство(ИмяСвойства) И Данные.Свойство(ИмяХэш) И Данные[ИмяХэш] = Хэш Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ЗаписатьИнформациюОбОтправленномПредупрежденииПоДокументу(Документ, ИзмененияТабЧасти = Ложь) Экспорт
	
	Если Документ.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Хэш = СформироватьХэшПоДокументу(Документ, ИзмененияТабЧасти);
	
	Данные = смартСерверПривилегированный.ПолучитьДополнительныеДанныеОбъекта(Документ.Ссылка);
	Если НЕ ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные = Новый Структура;
	КонецЕсли;
	
	Если НЕ ИзмененияТабЧасти Тогда
		ИмяСвойства = "УведомлениеОМаркировкеОтправлено";
		ИмяХэш = "МаркировкаХэшСумма";
	Иначе
		ИмяСвойства = "УведомлениеОМаркировкеОтправленоИзменения";
		ИмяХэш = "МаркировкаХэшСуммаИзменения";
	КонецЕсли;
	
	Данные.Вставить(ИмяСвойства, Истина);
	Данные.Вставить(ИмяХэш, Хэш);

	смартСерверПривилегированный.ЗаписатьДополнительныеДанныеОбъекта(Документ.Ссылка, Данные);
	
КонецПроцедуры

Функция КонтроллироватьОтгрузкуМаркированнойПродукции(Дата) Экспорт
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("КонтроллироватьОтгрузкуМаркированнойПродукции", Ложь) <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДатаНачалаКонтроляОтгрузкиМаркированнойПродукции", Дата(1, 1, 1)) > Дата Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура МодифицироватьФормуСпискаНоменклатуры(Форма) Экспорт
	
	Если НЕ КонтроллироватьОтгрузкуМаркированнойПродукции(ТекущаяДата()) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтрНайти(Форма.СписокНоменклатура.ТекстЗапроса, "смартИндексКартинкиМаркировки") > 0 Тогда
		
		ТекстЗамены = "СпрНоменклатура.Родитель,";
		ТекстВставки = "	ВЫБОР КОГДА (СпрНоменклатура.КодТНВЭД.смартОбязательнаяМаркировка ИЛИ СпрНоменклатура.смартОбязательнаяМаркировка) И НЕ СпрНоменклатура.смартПроверкаПроведенаМаркировкаНеТребуется ТОГДА 1 КОГДА СпрНоменклатура.КодТНВЭД.смартЭкспериментальныйРежимМаркировки И НЕ СпрНоменклатура.смартПроверкаПроведенаМаркировкаНеТребуется ТОГДА 0 ИНАЧЕ -1 КОНЕЦ КАК смартИндексКартинкиМаркировки,";
		Форма.СписокНоменклатура.ТекстЗапроса = СтрЗаменить(Форма.СписокНоменклатура.ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
		
		ТекстЗамены = "СправочникНоменклатура.Родитель КАК Родитель,";
		ТекстВставки = "	ВЫБОР КОГДА (СправочникНоменклатура.КодТНВЭД.смартОбязательнаяМаркировка ИЛИ СправочникНоменклатура.смартОбязательнаяМаркировка) И НЕ СправочникНоменклатура.смартПроверкаПроведенаМаркировкаНеТребуется ТОГДА 1 КОГДА СправочникНоменклатура.КодТНВЭД.смартЭкспериментальныйРежимМаркировки И НЕ СправочникНоменклатура.смартПроверкаПроведенаМаркировкаНеТребуется ТОГДА 0 ИНАЧЕ -1 КОНЕЦ КАК смартИндексКартинкиМаркировки,";
		Форма.СписокНоменклатура.ТекстЗапроса = СтрЗаменить(Форма.СписокНоменклатура.ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
		
	КонецЕсли;
	
	СвойстваКолонки = Новый Структура;
	СвойстваКолонки.Вставить("Вид", ВидПоляФормы.ПолеКартинки);
	СвойстваКолонки.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
    СвойстваКолонки.Вставить("КартинкаЗначений", БиблиотекаКартинок.смартЧестныйЗнакКоллекция);
	СвойстваКолонки.Вставить("КартинкаШапки", БиблиотекаКартинок.смартЧестныйЗнак16);
	СвойстваКолонки.Вставить("РастягиватьПоГоризонтали", Ложь);
	СвойстваКолонки.Вставить("Ширина", 2);
	СвойстваКолонки.Вставить("МаксимальнаяШирина", 2);
	СвойстваКолонки.Вставить("АвтоМаксимальнаяШирина", Ложь);
	Если Форма.Элементы.Найти("смартМаркировкаКартинка") = Неопределено Тогда
		смартФормированиеИнтерфейса.СздПоле(Форма, "смартМаркировкаКартинка", "СписокРасширенныйПоискНоменклатура",, 1, "СписокНоменклатура.смартИндексКартинкиМаркировки", СвойстваКолонки,, "СписокРасширенныйПоискНоменклатураАртикул");
	КонецЕсли;
	Если Форма.Элементы.Найти("смартМаркировкаКартинкаСтд") = Неопределено Тогда
		смартФормированиеИнтерфейса.СздПоле(Форма, "смартМаркировкаКартинкаСтд", "СписокСтандартныйПоискНоменклатура",, 1, "СписокНоменклатура.смартИндексКартинкиМаркировки", СвойстваКолонки,, "СписокСтандартныйПоискНоменклатураАртикул");
	КонецЕсли;
	
КонецПроцедуры

Функция ЗапрещатьПеремещениеМаркированнойПродукции(Дата) Экспорт
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ЗапрещатьПеремещениеМаркированныхТоваров", Ложь) <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДатаНачалаЗапретаПеремещенияМаркированныхТоваров", Дата(1, 1, 1)) > Дата Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьВозможностьПеремещенияТоваров(Документ, ТекстСообщения) Экспорт
	
	Если НЕ ЗапрещатьПеремещениеМаркированнойПродукции(Документ.Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	БлокироватьПроведение = Истина;
	СкладыИсключения = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("СкладыСРазрешениемПеремещенияМаркировки").Выгрузить();
	
	//++ #6674  смарт: Тимофеева 24.04.2026 / Маркировка радиоэлектронной продукции. Запрет на перемещение между складами. Дополнение.
	//Если СкладыИсключения.Найти(Документ.СкладОтправитель) <> Неопределено И СкладыИсключения.Найти(Документ.СкладПолучатель) <> Неопределено Тогда
	//	БлокироватьПроведение = Ложь;
	//КонецЕсли;  
	
	НазначенияСкладовИсключения = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("НазначенияСкладовСРазрешениемПеремещенияМаркировки").Выгрузить();
	НазначениеСкладаОтправителя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.СкладОтправитель, "смартНазначениеСклада");
	НазначениеСкладаПолучателя = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ.СкладПолучатель, "смартНазначениеСклада");
	Если (СкладыИсключения.Найти(Документ.СкладОтправитель) <> Неопределено И СкладыИсключения.Найти(Документ.СкладПолучатель) <> Неопределено) 
		ИЛИ (НазначенияСкладовИсключения.Найти(НазначениеСкладаОтправителя) <> Неопределено И НазначенияСкладовИсключения.Найти(НазначениеСкладаПолучателя) <> Неопределено)
		ИЛИ (СкладыИсключения.Найти(Документ.СкладОтправитель) <> Неопределено И НазначенияСкладовИсключения.Найти(НазначениеСкладаПолучателя) <> Неопределено) 
		ИЛИ (НазначенияСкладовИсключения.Найти(НазначениеСкладаОтправителя) <> Неопределено И СкладыИсключения.Найти(Документ.СкладПолучатель) <> Неопределено)
		Тогда
		БлокироватьПроведение = Ложь;
	КонецЕсли; 
	//-- #6674  смарт: Тимофеева 24.04.2026
	
	ЕстьМаркировка = Ложь;
	
	МассивСтрок = Новый Массив;
	
	Для каждого стрТовары Из Документ.Товары Цикл
		Если НоменклатураПодлежитОбязательнойМаркировке(стрТовары.Номенклатура, Документ.Дата) Тогда
			ЕстьМаркировка = Истина;
			МассивСтрок.Добавить(СтрШаблон("Маркированная номенклатура : %1, строка № %2", стрТовары.Номенклатура, стрТовары.НомерСтроки));
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьМаркировка И БлокироватьПроведение Тогда
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	ИначеЕсли НЕ БлокироватьПроведение И ЕстьМаркировка Тогда
		ТекстСообщения = СтрШаблон("Перемещение между складами %1 - %2 разрешено для маркированной продукции: 
								   |%3", Документ.СкладОтправитель, Документ.СкладПолучатель, СтрСоединить(МассивСтрок, Символы.ПС));
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьВТабличнуюЧастьКолонкиМаркировки(Форма, ИмяТаблицыФормы = "Товары", ИмяКолонкиНоменклатуры = "ТоварыНоменклатура", ПутьКДаннымНоменклатуры = "Объект.Товары.Номенклатура", ИмяПоляОбязательнойМаркировки = "смартЧестныйЗнакОМ", ИмяПоляЭкспериментальнойМаркировки = "смартЧестныйЗнакЭР") Экспорт
	
	Попытка
		Если НЕ ЗначениеЗаполнено(Форма.Объект.Дата) И НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
			ДатаПроверки = ТекущаяДата();
		Иначе
			ДатаПроверки = Форма.Объект.Дата;
		КонецЕсли;
	Исключение
		ДатаПроверки = ТекущаяДата();
	КонецПопытки;
	
	//++ #Б6770 смарт: Шляпников 04.05.2026 / Маркировка. Документ Предзаказ поставщику. Добавит пиктограммы ЧЗ.
	//Если НЕ КонтроллироватьОтгрузкуМаркированнойПродукции(ДатаПроверки) Тогда
	//	Возврат;
	//КонецЕсли;
	//-- #Б6770 смарт: Шляпников 04.05.2026
	
	Попытка
		
		ПутьКТаблице = "";
		Массив = СтрРазделить(ПутьКДаннымНоменклатуры, ".", Ложь);
		ИмяПоляНоменклатуры = "";
		Если Массив.Количество() > 1 Тогда
			ИмяПоляНоменклатуры = Массив[Массив.Количество() - 1];
			Массив.Удалить(Массив.Количество() - 1);
			ПутьКТаблице = СтрСоединить(Массив, ".");
		КонецЕсли;
		
		Если ПутьКТаблице = "" Тогда
			Возврат;
		КонецЕсли;
			
		СтруктураРеквизитов = Новый Структура;
		СтруктураРеквизитов.Вставить(ИмяПоляОбязательнойМаркировки, смартФормированиеИнтерфейса.ОписаниеТипаБулево());
		СтруктураРеквизитов.Вставить(ИмяПоляЭкспериментальнойМаркировки, смартФормированиеИнтерфейса.ОписаниеТипаБулево());
		
		смартФормированиеИнтерфейса.СоздатьРеквизитыТаблицы(Форма, ПутьКТаблице, СтруктураРеквизитов);
			
		ЭлементПеред = ИмяКолонкиНоменклатуры;
		РодительНоменклатуры = Форма.Элементы[ИмяКолонкиНоменклатуры].Родитель;
		Пока ТипЗнч(РодительНоменклатуры) = Тип("ГруппаФормы") 
			И (РодительНоменклатуры.Группировка = ГруппировкаКолонок.ВЯчейке ИЛИ РодительНоменклатуры.Группировка = ГруппировкаКолонок.Вертикальная) Цикл
			ЭлементПеред = РодительНоменклатуры;
			РодительНоменклатуры = РодительНоменклатуры.Родитель;
		КонецЦикла;
		
		Группа = смартФормированиеИнтерфейса.СздГруппаКолонокТаблицыФормы(Форма, СтрШаблон("%1Группа", ИмяПоляОбязательнойМаркировки), РодительНоменклатуры, 1,, Ложь, "Честный знак",, ЭлементПеред);
		
		Свойства = Новый Структура;
		Свойства.Вставить("Вид", ВидПоляФормы.ПолеКартинки);
		Свойства.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
		Свойства.Вставить("КартинкаЗначений", БиблиотекаКартинок.смартЧестныйЗнак32);
		Свойства.Вставить("КартинкаШапки", БиблиотекаКартинок.смартЧестныйЗнак16);
		Свойства.Вставить("Ширина", 2);
		Свойства.Вставить("МаксимальнаяШирина", 2);
		Свойства.Вставить("АвтоМаксимальнаяШирина", Ложь);
		Свойства.Вставить("Подсказка", "Товар подлежит обязательной маркировке");
		Свойства.Вставить("РастягиватьПоГоризонтали", Ложь);
		
		смартФормированиеИнтерфейса.СздПоле(Форма, ИмяПоляОбязательнойМаркировки, Группа,, 0, СтрШаблон("%1.%2", ПутьКТаблице, ИмяПоляОбязательнойМаркировки), Свойства);
		
		Свойства.Вставить("КартинкаЗначений", БиблиотекаКартинок.смартЧестныйЗнакЭР32);
		Свойства.Вставить("КартинкаШапки", БиблиотекаКартинок.смартЧестныйЗнакЭР16);
		Свойства.Вставить("Подсказка", "Товар участвует в эксперименте по маркировке");
		
		смартФормированиеИнтерфейса.СздПоле(Форма, ИмяПоляЭкспериментальнойМаркировки, Группа,, 0, СтрШаблон("%1.%2", ПутьКТаблице, ИмяПоляЭкспериментальнойМаркировки), Свойства);
		
		Если Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
			
			СтруктураКолонок = Новый Структура;
			СтруктураКолонок.Вставить("смартШтрихкодыУпаковокПодобраны", смартФормированиеИнтерфейса.ОписаниеТипаЧисло(2, 0));
			
			смартФормированиеИнтерфейса.СоздатьРеквизитыТаблицы(Форма, "Объект.Товары", СтруктураКолонок);
			
			Свойства.Вставить("КартинкаЗначений", БиблиотекаКартинок.МаркируемаяПродукцияТЧ);
			Свойства.Вставить("КартинкаШапки", БиблиотекаКартинок.МаркируемаяПродукцияШапка);
			Свойства.Вставить("Подсказка", "Штрихкоды подобраны");
			
			смартФормированиеИнтерфейса.СздПоле(Форма, "смартШтрихкодыУпаковокПодобраны", Группа,, 0, "Объект.Товары.смартШтрихкодыУпаковокПодобраны", Свойства);
			
		КонецЕсли;
		
		Выполнить(СтрШаблон("ЗаполнитьИнформациюОМаркировкеВТаблицуНоменклатуры(Форма.%1, ИмяПоляНоменклатуры, ИмяПоляОбязательнойМаркировки, ИмяПоляЭкспериментальнойМаркировки);", ПутьКТаблице));
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьИнформациюОМаркировкеВТаблицуНоменклатуры(Таблица, ИмяПоляНоменклатура = "Номенклатура", ИмяПоляОбязательнойМаркировки = "смартЧестныйЗнакОМ", ИмяПоляЭкспериментальнойМаркировки = "смартЧестныйЗнакЭР") Экспорт
	
	Попытка
		
		Для каждого стрТовары Из Таблица Цикл
			
			стрТовары[ИмяПоляОбязательнойМаркировки] = НоменклатураПодлежитОбязательнойМаркировке(стрТовары[ИмяПоляНоменклатура]);
			стрТовары[ИмяПоляЭкспериментальнойМаркировки] = НоменклатураПодлежитЭксперементальнойМаркировке(стрТовары[ИмяПоляНоменклатура]);
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура смартЗагрузкаДанныхОМаркировкеВКлассификаторТНВЭД() Экспорт
	
	Соединение = Новый HTTPСоединение("www.gs1ru.org",,,,,, Новый ЗащищенноеСоединениеOpenSSL());
    Запрос = Новый HTTPЗапрос("/marking/TNVED/");
	Запрос.Заголовки.Вставить("User-Agent", "1C-Enterprise/8.3");

    Попытка
        Ответ = Соединение.Получить(Запрос);
    Исключение
        Сообщить("Ошибка загрузки страницы: " + ОписаниеОшибки());
        Возврат;
    КонецПопытки;

    Если Не Ответ.КодСостояния = 200 Тогда
        Сообщить("HTTP-ошибка: " + Ответ.КодСостояния);
        Возврат;
    КонецЕсли;

    ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	
	ПервыйСимвол = СтрНайти(ТелоОтвета, "через какой Excel шаблон.<br>");
	НужныйТекст = Сред(ТелоОтвета, ПервыйСимвол + СтрДлина("через какой Excel шаблон.<br>") + 1);
	ПоследнийСимвол = СтрНайти(НужныйТекст, "</div>") - 1;
	НужныйТекст = Лев(НужныйТекст, ПоследнийСимвол); 
	
	НужныйТекст = СтрЗаменить(НужныйТекст, "<br>", "");
	НужныйТекст = СтрЗаменить(НужныйТекст, "<u>", "");
	НужныйТекст = СтрЗаменить(НужныйТекст, "</u>", "");

	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(НужныйТекст);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	Таблица.Колонки.Добавить("Эксперимент", Новый ОписаниеТипов("Булево")); 
	Таблица.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(10)));
	
	Для Нум = 1 По ТекстовыйДокумент.КоличествоСтрок() Цикл
		
		СтрокаДанных = СокрЛП(ТекстовыйДокумент.ПолучитьСтроку(Нум));
		Если СтрокаДанных = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(СтрокаДанных, "<a href") Тогда
			
			ПервыйСимволНаименования = СтрНайти(СтрокаДанных, ">") + 1;
			НаименованиеРаздела = Сред(СтрокаДанных, ПервыйСимволНаименования);
			НаименованиеРаздела = СтрЗаменить(НаименованиеРаздела, "</a>", "");
			
			Если СтрНайти(НРег(НаименованиеРаздела), "эксперимент") Тогда                
				Эксперимент = Истина;
			Иначе 
				Эксперимент = Ложь;
			КонецЕсли;
			
		Иначе
			
			МассивКодов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДанных, ";", Истина, Истина);			
			
			Для Каждого ЭлементМассива Из МассивКодов Цикл
				
				НоваяСтрокаТаблицы = Таблица.Добавить();
				НоваяСтрокаТаблицы.Наименование = ТРег(НаименованиеРаздела);
				НоваяСтрокаТаблицы.Эксперимент = Эксперимент;
				НоваяСтрокаТаблицы.Код = ЭлементМассива; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗ.Код КАК Код,
	|	ТЗ.Наименование КАК Наименование,
	|	ТЗ.Эксперимент КАК Эксперимент
	|ПОМЕСТИТЬ ВТТаблица
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КлассификаторТНВЭД.Ссылка КАК Ссылка,
	|	КлассификаторТНВЭД.смартОбязательнаяМаркировка КАК смартОбязательнаяМаркировка,
	|	КлассификаторТНВЭД.смартЭкспериментальныйРежимМаркировки КАК смартЭкспериментальныйРежимМаркировки,
	|	КлассификаторТНВЭД.смартВидМаркировки КАК смартВидМаркировки,
	|	ВТТаблица.Код КАК Код,
	|	ВТТаблица.Наименование КАК Наименование,
	|	ВТТаблица.Эксперимент КАК Эксперимент
	|ИЗ
	|	ВТТаблица КАК ВТТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|		ПО ВТТаблица.Код = КлассификаторТНВЭД.Код";
	
	Запрос.УстановитьПараметр("ТЗ", Таблица);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Выборка.Эксперимент И НЕ Выборка.смартЭкспериментальныйРежимМаркировки)
			ИЛИ (НЕ Выборка.Эксперимент И НЕ Выборка.смартОбязательнаяМаркировка) Тогда
			
			ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ТекОбъект.смартЭкспериментальныйРежимМаркировки = Выборка.Эксперимент;
			ТекОбъект.смартОбязательнаяМаркировка = НЕ Выборка.Эксперимент;
			ТекОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьОтметкуОПодобранныхШтрихкодахВДокументе(Форма) Экспорт
	
	Попытка
		Если НЕ ЗначениеЗаполнено(Форма.Объект.Дата) И НЕ ЗначениеЗаполнено(Форма.Объект.Ссылка) Тогда
			ДатаПроверки = ТекущаяДата();
		Иначе
			ДатаПроверки = Форма.Объект.Дата;
		КонецЕсли;
	Исключение
		ДатаПроверки = ТекущаяДата();
	КонецПопытки;
	
	Если НЕ КонтроллироватьОтгрузкуМаркированнойПродукции(ДатаПроверки) Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		
		ТЗШтрихкоды = Форма.Объект.ШтрихкодыУпаковок.Выгрузить();
		
		Для каждого стрТовары Из Форма.Объект.Товары Цикл
			
			Если НоменклатураПодлежитОбязательнойМаркировке(стрТовары.Номенклатура, ДатаПроверки) Тогда
				
				стрТовары.смартШтрихкодыУпаковокПодобраны = 2;
				Счетчик = стрТовары.Количество;
				
				Количество = ТЗШтрихкоды.Количество();
				Для н = 1 По Количество Цикл
					
					ТекСтрока = ТЗШтрихкоды[Количество - н];
					Если ТекСтрока.ШтрихкодУпаковки.Номенклатура = стрТовары.Номенклатура Тогда
						Счетчик = Счетчик - 1;
						ТЗШтрихкоды.Удалить(ТекСтрока);
					КонецЕсли;
					
					Если Счетчик = 0 Тогда
						стрТовары.смартШтрихкодыУпаковокПодобраны = 1;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			Иначе
				стрТовары.смартШтрихкодыУпаковокПодобраны = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ЗапрещатьСборкуРазборкуМаркированнойПродукции(Дата) Экспорт
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ЗапрещатьСборкуРазборкуМаркированныхТоваров", Ложь) <> Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ДатаНачалаЗапретаСборкиРазборкиМаркированныхТоваров", Дата(1, 1, 1)) > Дата Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПроверитьВозможностьСборкиРазборки(Документ, ТекстСообщения) Экспорт
	
	Если НЕ ЗапрещатьСборкуРазборкуМаркированнойПродукции(Документ.Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕстьМаркировка = Ложь;
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Проведение документа запрещено! В документе содержится маркируемый товар (обязательная или экспериментальная маркировка) - записать / провести документ невозможно.");
	
	Если НоменклатураПодлежитОбязательнойМаркировке(Документ.Номенклатура, Документ.Дата) Тогда
		ЕстьМаркировка = Истина;
		МассивСтрок.Добавить(СтрШаблон("Маркированная номенклатура : %1 в шапке документа", Документ.Номенклатура));
	КонецЕсли;
		
	Для каждого стрТовары Из Документ.Товары Цикл
		Если НоменклатураПодлежитОбязательнойМаркировке(стрТовары.Номенклатура, Документ.Дата) Тогда
			ЕстьМаркировка = Истина;
			МассивСтрок.Добавить(СтрШаблон("Маркированная номенклатура : %1, строка № %2", стрТовары.Номенклатура, стрТовары.НомерСтроки));
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьМаркировка Тогда
		Возврат СтрСоединить(МассивСтрок, Символы.ПС);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции 

