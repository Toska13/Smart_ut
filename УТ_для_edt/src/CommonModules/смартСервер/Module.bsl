					ЗаполнитьЗначенияСвойств(НоваяСтрокаОрдера, СтрокаОрдера);
					
					//Для совместимости
					СписокКонтейнеров = Новый СписокЗначений;
					СписокКонтейнеров.ЗагрузитьЗначения(Контейнеры.ВыгрузитьКолонку("Контейнер"));
					ЭлементСписка = СписокКонтейнеров.НайтиПоЗначению(НайденнаяСтрока.Контейнер);
					Если НЕ ЭлементСписка = Неопределено Тогда
						ЭлементСписка.Пометка = Истина;
					КонецЕсли;
					
					НоваяСтрокаОрдера.смартКонтейнер	= смартОбщегоНазначения.смартЗаписатьВыбраныеКонтейнерыВJSON(СписокКонтейнеров);
					ЗначениеДляКонтейнера 				= смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрокаОрдера.смартКонтейнер);
					НоваяСтрокаОрдера.Контейнеры 		= смартОбщегоНазначения.смартКонтейнерыВСтроку(ЗначениеДляКонтейнера); 
					
					НоваяСтрокаОрдера.Серия             = НайденнаяСтрока.Серия;
					НоваяСтрокаОрдера.Количество 		= НайденнаяСтрока.Количество; 
					
					//++ #4600 смарт: Тимофеева 07.10.2025 / Задвоение товара при приемке
					Количество = Количество - НайденнаяСтрока.Количество;
					НайденнаяСтрока.Количество = 0;
					//-- #4600 смарт: Тимофеева 07.10.2025
					
					СтруктураДействий = Новый Структура;
					СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
					СтруктураДействий.Вставить("ЗаполнитьВесУпаковки",				Новый Структура("Номенклатура, Упаковка", "ВесУпаковки"));
					СтруктураДействий.Вставить("ЗаполнитьОбъемУпаковки",			Новый Структура("Номенклатура, Упаковка", "ОбъемУпаковки"));
					СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияВеса",		Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияВеса"));
					СтруктураДействий.Вставить("ЗаполнитьЕдиницуИзмеренияОбъема",	Новый Структура("Номенклатура, Упаковка", "ЕдиницаИзмеренияОбъема"));
					СтруктураДействий.Вставить("ПересчитатьКоличествоУпаковок");
					СтруктураДействий.Вставить("ПересчитатьВесОбъем");
					СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус",
								Новый Структура("Склад, ПараметрыУказанияСерий", Форма.Объект.Склад, Форма.ПараметрыУказанияСерий));
					
					ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрокаОрдера, СтруктураДействий, КэшированныеЗначения);

				КонецЦикла;  
				
			КонецЦикла;
			
			//-- #2492 смарт: Тимофеева 15.08.2025  
			//-- #360  смарт: Тимофеева 15.08.2025  
 			//-- #320  смарт: Тимофеева 15.08.2025  
			
			Форма.МаксимальныйНомерСтроки = Форма.Объект.Товары.Количество();
			//-- #1577 смарт: Мосолов 25.12.2023  
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры
