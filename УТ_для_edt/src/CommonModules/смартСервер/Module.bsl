//++ #1566 смарт: Фролов 06.02.2024 //Коэффициенты менеджеров для автоматического распределения лидов
Функция СформироватьВыдачуЛидовПоКвалификации(Квалификация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗапросЗаблокированные = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Коэффициенты.Менеджер КАК Менеджер
	|ИЗ
	|	РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних КАК Коэффициенты
	|ГДЕ
	|	Коэффициенты.ВыдачаЗаблокирована");
	МасЗаблокированные = ЗапросЗаблокированные.Выполнить().Выгрузить().ВыгрузитьКолонку("Менеджер");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Коэффициенты.Менеджер КАК Менеджер,
	|	Коэффициенты.Коэффициент КАК Коэффициент
	|ИЗ
	|	РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(, ) КАК Коэффициенты
	|ГДЕ
	|	Коэффициенты.Менеджер = &Менеджер
	|	И Коэффициенты.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент)
	|	И Коэффициенты.Коэффициент > 0
	|	И НЕ Коэффициенты.ВыдачаЗаблокирована");
	
	ТаблицаДляКоэффициентов=Новый ТаблицаЗначений;
	ТаблицаДляКоэффициентов.Колонки.Добавить("Менеджер");
	ТаблицаДляКоэффициентов.Колонки.Добавить("ИтоговыйКоэффициент");
	ТаблицаДляКоэффициентов.Колонки.Добавить("КоэффициентОтВыручки");
	ТаблицаДляКоэффициентов.Колонки.Добавить("КоэффициентОтКонверсии");
	ТаблицаДляКоэффициентов.Колонки.Добавить("КоэффициентОтПотериЛидов");
	ТаблицаДляКоэффициентов.Колонки.Добавить("КоэффициентОтКоммерческогоОтдела");
	ТаблицаДляКоэффициентов.Колонки.Добавить("КоэффициентОтМаркетинговогоОтдела");
	
	Для Каждого СтрМенеджеры Из Квалификация.Пользователи Цикл
		
		Запрос.УстановитьПараметр("Менеджер", СтрМенеджеры.Пользователь);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			
			Коэффициент = Выборка.Коэффициент;	
			
		Иначе
			
			Если ТаблицаДляКоэффициентов.Найти(СтрМенеджеры.Пользователь, "Менеджер") = Неопределено 
				И МасЗаблокированные.Найти(СтрМенеджеры.Пользователь) = Неопределено Тогда
				
				СтрТаблицаДляКоэффициентов = ТаблицаДляКоэффициентов.Добавить();
				СтрТаблицаДляКоэффициентов.Менеджер = СтрМенеджеры.Пользователь;
				СтрТаблицаДляКоэффициентов.ИтоговыйКоэффициент = 2;
				СтрТаблицаДляКоэффициентов.КоэффициентОтВыручки = 1;
				СтрТаблицаДляКоэффициентов.КоэффициентОтКонверсии = 1;
				СтрТаблицаДляКоэффициентов.КоэффициентОтПотериЛидов = 1;
				СтрТаблицаДляКоэффициентов.КоэффициентОтКоммерческогоОтдела = 1;
				СтрТаблицаДляКоэффициентов.КоэффициентОтМаркетинговогоОтдела = 1;
				
			КонецЕсли;
			
			Коэффициент = 2;	
			
		КонецЕсли;	
		
		Если МасЗаблокированные.Найти(СтрМенеджеры.Пользователь) = Неопределено Тогда
			
			НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Менеджер.Установить(СтрМенеджеры.Пользователь);
			НаборЗаписей.Отбор.Квалификация.Установить(Квалификация);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей[0].ВыдатьЛидов = Коэффициент;
				НаборЗаписей[0].ВыданоЛидов = НаборЗаписей[0].ВыданоЛидов;
			Иначе
				ЗаписьНЗ = НаборЗаписей.Добавить();
				ЗаписьНЗ.Менеджер = СтрМенеджеры.Пользователь;
				ЗаписьНЗ.Квалификация = Квалификация;
				ЗаписьНЗ.ВыдатьЛидов = Коэффициент;
				ЗаписьНЗ.ВыданоЛидов = 0;
			КонецЕсли;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ТаблицаДляКоэффициентов;
	
