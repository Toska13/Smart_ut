//++ смарт:ММ #096 221 19.02.2021 Доработка Приобретения ТиУ
Функция СоздатьПоступлениеТоваровНаСклад(ДокументОснование)
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		
		Если НЕ ЗначениеЗаполнено(ДокументОснование.ЗаказПоставщику) Тогда
			Возврат Неопределено;
		КонецЕсли;

		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("ДокументОснование", ДокументОснование.ЗаказПоставщику);
		//ДанныеЗаполнения.Вставить("РеквизитыШапки", РеквизитыШапки);
		Если ДокументОснование.Склад.ЭтоГруппа Тогда
			СкладПоступления = Неопределено;
		Иначе
			СкладПоступления = ДокументОснование.Склад;
		КонецЕсли;
		
		ДанныеЗаполнения.Вставить("СкладПоступления",		СкладПоступления);
		ДанныеЗаполнения.Вставить("ЗаполнятьПоНакладной", 	Истина);
		ДанныеЗаполнения.Вставить("ЗаполнятьПоОрдеру",		Ложь);
		ДанныеЗаполнения.Вставить("ХозяйственнаяОперацияПриемки", ДокументОснование.ЗаказПоставщику.ХозяйственнаяОперация);
				
		НовыйДокумент = Документы.ПоступлениеТоваровНаСклад.СоздатьДокумент();
		НовыйДокумент.Дата = ТекущаяДатаСеанса();
		НовыйДокумент.Заполнить(ДанныеЗаполнения);
		НовыйДокумент.Автор = ПараметрыСеанса.ТекущийПользователь;
		НовыйДокумент.Распоряжение = ДокументОснование.ЗаказПоставщику; 
		
		Если НовыйДокумент.Товары.Количество() = 0 Тогда
			Для Каждого СтрокаТовар Из ДокументОснование.Товары Цикл
				НоваяСтрока = НовыйДокумент.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовар);	
			КонецЦикла;
			
			СтруктураДействий = Новый Структура("ПересчитатьКоличествоУпаковок", ОбработкаТабличнойЧастиКлиентСервер.СтруктураПересчетаКоличестваУпаковок());
	
			ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(НовыйДокумент.Товары, СтруктураДействий, Неопределено);
	
			ЗаполнитьЦеныПоСоглашению(НовыйДокумент);
	
		КонецЕсли;
		
		Попытка
			НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначения.СообщитьПользователю("Создан и проведен документ " + НовыйДокумент.Ссылка, НовыйДокумент.Ссылка);
		Исключение
			НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначения.СообщитьПользователю("Создан документ " + НовыйДокумент.Ссылка, НовыйДокумент.Ссылка);
		КонецПопытки;
				
	КонецЕсли;
	
КонецФункции //-- смарт:ММ 19.02.2021

//++ смарт:ММ #096 221 19.02.2021 Доработка Приобретения ТиУ
Процедура ЗаполнитьЦеныПоСоглашению(НовыйДокумент)
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(НовыйДокумент);
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПоляЗаполнения",     "Цена, СтавкаНДС");
	ПараметрыЗаполнения.Вставить("Дата",               НовыйДокумент.Дата);
	ПараметрыЗаполнения.Вставить("Валюта",             НовыйДокумент.Валюта);
	ПараметрыЗаполнения.Вставить("Соглашение",         НовыйДокумент.Соглашение);
	ПараметрыЗаполнения.Вставить("ВидЦеныПоставщика",  НовыйДокумент.ВидЦеныПоставщика);
	ПараметрыЗаполнения.Вставить("НалогообложениеНДС", НовыйДокумент.НалогообложениеНДС);
	
	ДействияСоСтроками = Новый Структура;
	ДействияСоСтроками.Вставить("ПересчитатьСумму",     "КоличествоУпаковок");
	ДействияСоСтроками.Вставить("ПересчитатьСуммуНДС",  СтруктураПересчетаСуммы);
	ДействияСоСтроками.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	
	ЗакупкиСервер.ЗаполнитьЦены(НовыйДокумент.Товары, Неопределено, ПараметрыЗаполнения, ДействияСоСтроками);
	
КонецПроцедуры //-- смарт:ММ 19.02.2021

