//++ #1566 смарт: Фролов 07.02.2024 ////Коэффициенты менеджеров для автоматического распределения лидов
Процедура ОтразитьИзмененийЛидаВРегистрах(СтруктураИзменений) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если СтруктураИзменений.Свойство("УстановленаПометкаУдаления") Тогда
		
		НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(СтруктураИзменений.СтарыйМенеджер);
		НаборЗаписей.Отбор.Квалификация.Установить(СтруктураИзменений.Квалификация);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			
			ИзменениеВыдачи = НаборЗаписей[0].ВыданоЛидов - 1;
			Если ИзменениеВыдачи < 0 Тогда
				ИзменениеВыдачи = 0;
			ИначеЕсли ИзменениеВыдачи > НаборЗаписей[0].ВыдатьЛидов Тогда
				ИзменениеВыдачи = НаборЗаписей[0].ВыдатьЛидов;
			КонецЕсли;	
			НаборЗаписей[0].ВыданоЛидов = ИзменениеВыдачи;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(СтруктураИзменений.СтарыйМенеджер);
		НаборЗаписей.Отбор.Лид.Установить(СтруктураИзменений.Лид);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НаборЗаписей.Записать(Истина);
		
	Иначе

		НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(СтруктураИзменений.СтарыйМенеджер);
		НаборЗаписей.Отбор.Квалификация.Установить(СтруктураИзменений.Квалификация);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			
			ИзменениеВыдачи = НаборЗаписей[0].ВыданоЛидов - 1;
			Если ИзменениеВыдачи < 0 Тогда
				ИзменениеВыдачи = 0;
			ИначеЕсли ИзменениеВыдачи > НаборЗаписей[0].ВыдатьЛидов Тогда
				ИзменениеВыдачи = НаборЗаписей[0].ВыдатьЛидов;
			КонецЕсли;	
			НаборЗаписей[0].ВыданоЛидов = ИзменениеВыдачи;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(СтруктураИзменений.НовыйМенеджер);
		НаборЗаписей.Отбор.Квалификация.Установить(СтруктураИзменений.Квалификация);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			
			ИзменениеВыдачи = НаборЗаписей[0].ВыданоЛидов + 1;
			Если ИзменениеВыдачи < 0 Тогда
				ИзменениеВыдачи = 0;
			ИначеЕсли ИзменениеВыдачи > НаборЗаписей[0].ВыдатьЛидов Тогда
				ИзменениеВыдачи = НаборЗаписей[0].ВыдатьЛидов;
			КонецЕсли;	
			НаборЗаписей[0].ВыданоЛидов = ИзменениеВыдачи;
			
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;
		
		НаборЗаписейС = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
		НаборЗаписейС.Отбор.Менеджер.Установить(СтруктураИзменений.СтарыйМенеджер);
		НаборЗаписейС.Отбор.Лид.Установить(СтруктураИзменений.Лид);
		НаборЗаписейС.Прочитать();
		
		//++ #Б-5936 смарт: Фролов 06.03.2026 //Ошибка. Доработать механизм перераспределения лидов.
		//НаборЗаписейС.Очистить();
		Если НаборЗаписейС.Количество() > 0 Тогда
			СтрНаборЗаписейС = НаборЗаписейС[0];
			СтрНаборЗаписейС.ДатаЗавершения = ТекущаяДата();
			СтрНаборЗаписейС.ПервыйКонтакт = "Лид передан другому";
			СтрНаборЗаписейС.ЗавершенНеУдачно = Истина;
			НаборЗаписейС.Записать(Истина);
		КонецЕсли; 
		//-- #Б-5936 смарт: Фролов 06.03.2026
		
		НаборЗаписей = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
