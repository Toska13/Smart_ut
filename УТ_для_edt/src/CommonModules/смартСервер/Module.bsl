//++ #1566 смарт: Фролов 06.02.2024 //Описание
Процедура ЗаполнитьКоэффициентыМенеджеров(ТаблицаДляКоэффициентов) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТаблицаДляКоэффициентов.Количество() > 0 Тогда
		
		ДатаВнесения = ТекущаяДата();
		Для Каждого СтрТаблицаДляКоэффициентов Из ТаблицаДляКоэффициентов Цикл
			
			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.КоэффициентОтКоммерческогоОтдела;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();
			
			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.КоэффициентОтМаркетинговогоОтдела;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();

			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтВыручки;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.КоэффициентОтВыручки;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();
			
			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКонверсии;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.КоэффициентОтКонверсии;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();
			
			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтПотериЛидов;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.КоэффициентОтПотериЛидов;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();
			
			МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Период = ДатаВнесения;
			МенеджерЗаписи.Менеджер = СтрТаблицаДляКоэффициентов.Менеджер;
			МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент;
			МенеджерЗаписи.Коэффициент = СтрТаблицаДляКоэффициентов.ИтоговыйКоэффициент;
			МенеджерЗаписи.ИзменениеКоэффициента = 0;
			МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //-- #1566 смарт: Фролов 06.02.2024

//++ #1566 смарт: Фролов 06.02.2024 //Коэффициенты менеджеров для автоматического распределения лидов
Процедура ОчиститьКоэффициентыИВыдачуЛидов() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Очищаем квалификации, которых теперь нет у менеджеров
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартВыдачаЛидов.Квалификация КАК Квалификация,
	|	смартВыдачаЛидов.Менеджер КАК Менеджер,
	|	Пользователи.Ссылка КАК КвалификацияВыдача
	|ИЗ
	|	РегистрСведений.смартВыдачаЛидов КАК смартВыдачаЛидов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартКвалификацииМенеджеров.Пользователи КАК Пользователи
	|		ПО смартВыдачаЛидов.Квалификация = Пользователи.Ссылка
	|			И смартВыдачаЛидов.Менеджер = Пользователи.Пользователь
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Заблокированные.Ссылка,
	|	Заблокированные.Пользователь,
	|	ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.Пустаяссылка)
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи КАК Заблокированные
	|ГДЕ
	|	Заблокированные.Пользователь В
	|			(ВЫБРАТЬ
	|				Менеджер КАК Менеджер
	|			ИЗ
	|				РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(, 
	|				ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент))
	|			ГДЕ
	|				ВыдачаЗаблокирована)");
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.КвалификацияВыдача) Тогда
			
			НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Менеджер.Установить(Выборка.Менеджер);
			НаборЗаписей.Отбор.Квалификация.Установить(Выборка.Квалификация);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	//Очищаем менеджеров, которых нет в кваификциях из регистра коэффициентов
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Менеджер КАК Менеджер
	|ИЗ
	|	РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(, НЕ Менеджер В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Пользователь КАК Пользователь
	|				ИЗ
	|					Справочник.смартКвалификацииМенеджеров.Пользователи))
	|ГДЕ
	|	ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент)
	|	И Коэффициент > 0");
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДатаВнесения = ТекущаяДата();
	Пока Выборка.Следующий() Цикл
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтВыручки;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКонверсии;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтПотериЛидов;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
		МенеджерЗаписи = РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ДатаВнесения;
		МенеджерЗаписи.Менеджер = Выборка.Менеджер;
		МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент;
		МенеджерЗаписи.Коэффициент = 0;
		МенеджерЗаписи.ИзменениеКоэффициента = 0;
		МенеджерЗаписи.ВыдачаЗаблокирована = Истина;
		МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
