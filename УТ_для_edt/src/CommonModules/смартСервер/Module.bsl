Функция ПолучитьТаблицуСублимационногоОборудования(Товары, Склад) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Склад КАК Склад
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТаблицаТовары КАК ТаблицаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Сегменты.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ОтборПоСегментуНоменклатуры
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента КАК Сегменты
	|ГДЕ
	|	Сегменты.Сегмент = &Сегмент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА &СкладЭтоГруппа
	|			ТОГДА ВТ_Товары.Склад
	|		ИНАЧЕ &Склад
	|	КОНЕЦ КАК Склад
	|ПОМЕСТИТЬ ВТ_ТоварыИСклады
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|ГДЕ
	|	ВТ_Товары.Номенклатура В
	|			(ВЫБРАТЬ
	|				ОтборПоСегментуНоменклатуры.Номенклатура
	|			ИЗ
	|				ОтборПоСегментуНоменклатуры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыИСклады.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыИСклады.Склад КАК Склад,
	|	ВЫБОР
	|		КОГДА Склады.Ссылка.смартНазначениеСклада В (ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ДемоЗал), ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ТорговыйСклад))
	|				И НЕ ВТ_ТоварыИСклады.Склад В (&СкладыОтветственногоХранения)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоВнутреннийСклад,
	|	ВЫБОР
	|		КОГДА ВТ_ТоварыИСклады.Склад В (&СкладыОтветственногоХранения)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоСкладОтветственногоХранения
	|ИЗ
	|	ВТ_ТоварыИСклады КАК ВТ_ТоварыИСклады
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО ВТ_ТоварыИСклады.Склад = Склады.Ссылка";	
	Запрос.УстановитьПараметр("ТаблицаТовары", 					Товары);
	Запрос.УстановитьПараметр("Сегмент", 						Справочники.смартПредопределенныеЗначения.СегментОборудованияДляКомплектации.Значение);
	Запрос.УстановитьПараметр("Склад", 							Склад); 
	Запрос.УстановитьПараметр("СкладЭтоГруппа",					Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовПродажи(Склад));
	Запрос.УстановитьПараметр("СкладыОтветственногоХранения",	Справочники.смартПредопределенныеЗначения.СкладыОтветственногоХранения.Значения.ВыгрузитьКолонку("Значение"));

	РезультатЗапроса = Запрос.Выполнить();             
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции  

Функция ПолучитьОстаткиНоменклатурыНаСкладах(Номенклатура, МассивСкладов, ДатаОстатков) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Склад КАК Склад,
	|	Т.ВНаличииОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&Дата,
	|			Номенклатура = &Номенклатура
	|				И Склад В (&МассивСкладов)) КАК Т
	|ГДЕ
	|	Т.ВНаличииОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад,
	|	Номенклатура,
	|	Характеристика";
	
	Запрос.УстановитьПараметр("Номенклатура",    	Номенклатура);
	Запрос.УстановитьПараметр("МассивСкладов", 		МассивСкладов);
	Запрос.УстановитьПараметр("Дата",		 		ДатаОстатков);
    
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции                      	

Функция ПолучитьЗаказНаВнутренееПотребление(ЗаказКлиента, Номенклатура, ТолькоЭтаНоменклатура = Ложь) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ЗаказНаВнутреннееПотреблениеТовары
	|ГДЕ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка.ДокументОснование = &ДокументОснование
	|	И ЗаказНаВнутреннееПотреблениеТовары.Номенклатура = &Номенклатура
	|	И ЗаказНаВнутреннееПотреблениеТовары.Ссылка.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаВнутреннееПотреблениеТовары.Номенклатура) КАК Номенклатура,
	|	МАКСИМУМ(ЗаказНаВнутреннееПотреблениеТовары.Номенклатура) КАК Номенклатура1,
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ЗаказНаВнутреннееПотреблениеТовары
	|ГДЕ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Заказ.Ссылка
	|			ИЗ
	|				ВТ_Заказ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка
	|
	|ИМЕЮЩИЕ
	|	(НЕ &ТолькоЭтаНоменклатура
	|		ИЛИ &ТолькоЭтаНоменклатура
	|			И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказНаВнутреннееПотреблениеТовары.Номенклатура) = 1
	|			И МАКСИМУМ(ЗаказНаВнутреннееПотреблениеТовары.Номенклатура) = &Номенклатура)"; 
	Запрос.УстановитьПараметр("Номенклатура",    		Номенклатура);
	Запрос.УстановитьПараметр("ДокументОснование",  	ЗаказКлиента);
	Запрос.УстановитьПараметр("ТолькоЭтаНоменклатура",  ТолькоЭтаНоменклатура); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	Возврат Документы.ЗаказНаВнутреннееПотребление.ПустаяСсылка();	
КонецФункции   

Функция СоздатьЗаказНаВнутренееПотребление(ДанныеЗаполнения, Партнер, Номенклатура, Склад, ВариантОбеспеченияОтгрузить = Ложь) Экспорт 
	ЗаказОбъект 						= Документы.ЗаказНаВнутреннееПотребление.СоздатьДокумент();
	ЗаказОбъект.Дата 					= ТекущаяДатаСеанса();
	ЗаказОбъект.ДатаОтгрузки			= ТекущаяДатаСеанса();
	ЗаказОбъект.Организация 			= ДанныеЗаполнения.Организация;
	ЗаказОбъект.ДокументОснование 		= ДанныеЗаполнения; 
	ЗаказОбъект.Склад				 	= Склад;
	ЗаказОбъект.Статус 					= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ЗаказОбъект.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	ЗаказОбъект.Ответственный 			= Пользователи.ТекущийПользователь();
	ЗаказОбъект.Подразделение 			= ЗначениеНастроекПовтИсп.ПодразделениеПользователя(ЗаказОбъект.Ответственный);
	ЗаказОбъект.Комментарий				= "#Документ создан автоматически";
										
	НоваяСтрока 						= ЗаказОбъект.Товары.Добавить();
	НоваяСтрока.Номенклатура 			= Номенклатура;
	НоваяСтрока.Количество 				= 1;
	НоваяСтрока.КоличествоУпаковок 		= 1;
	НоваяСтрока.ДатаОтгрузки 			= ТекущаяДатаСеанса();

	НоваяСтрока.ВариантОбеспечения 		= ?(ВариантОбеспеченияОтгрузить, Перечисления.ВариантыОбеспечения.Отгрузить, 
																			Перечисления.ВариантыОбеспечения.СоСклада);
	НоваяСтрока.СтатьяРасходов 			=
		ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоНаименованию(".Изготовление каталогов для раздачи в рекламных целях (клиент)", Истина);
	НоваяСтрока.АналитикаРасходов 		= Партнер; 

	Если ЗаказОбъект.ПроверитьЗаполнение() Тогда
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный); 
		Возврат ЗаказОбъект.Ссылка;
	Иначе
		ЗаписьЖурналаРегистрации(
			"Создание документа ""Заказ на внутреннее потребление""",
			УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон("Не удалось создать документ ""Заказ на внутреннее потребление"" на основании %1 для комплектования каталогом сублимационнго оборудования", ДанныеЗаполнения));
		Возврат Неопределено;
	КонецЕсли; 
КонецФункции 

Функция НайтиВнутренееПотреблениеПоЗаказу(ЗаказНаВнутреннееПотребление) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВнутреннееПотреблениеТоваров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВнутреннееПотреблениеТоваров КАК ВнутреннееПотреблениеТоваров
	|ГДЕ
	|	ВнутреннееПотреблениеТоваров.ЗаказНаВнутреннееПотребление = &ЗаказНаВнутреннееПотребление
	|	И ВнутреннееПотреблениеТоваров.Проведен";	
	Запрос.УстановитьПараметр("ЗаказНаВнутреннееПотребление", ЗаказНаВнутреннееПотребление); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ВнутреннееПотреблениеТоваров.ПустаяСсылка();
КонецФункции

Процедура СоздатьВнутренееПотребление(ЗаказНаВнутреннееПотребление) Экспорт

	Если ЗаказНаВнутреннееПотребление.Товары.Количество() > 0
		И НЕ ЗаказНаВнутреннееПотребление.Товары[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда
		
		ЗаказОбъект	= ЗаказНаВнутреннееПотребление.ПолучитьОбъект();
	    ЗаказОбъект.Товары[0].ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		
		Если ЗаказОбъект.ПроверитьЗаполнение() Тогда
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Оперативный);
		Иначе
			ЗаписьЖурналаРегистрации(
						"Проведение документа ""Заказ на внутреннее потребление""",
						УровеньЖурналаРегистрации.Ошибка,,,
						СтрШаблон("Не удалось провести документ ""Заказ на внутреннее потребление"" на основании %1", 
								ЗаказНаВнутреннееПотребление.Документоснование));
			Возврат;
		КонецЕсли;
   КонецЕсли;

   ВнутренееПотреблениеОбъект = Документы.ВнутреннееПотреблениеТоваров.СоздатьДокумент(); 
   
   МассивЗаказов = Новый массив;
   МассивЗаказов.Добавить(ЗаказНаВнутреннееПотребление);
   ПараметрыПоЗаказу = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов,	"ВнутреннееПотреблениеТоваров").ПараметрыФормы;
   
   ВнутренееПотреблениеОбъект.Заполнить(ПараметрыПоЗаказу.Основание);
   ВнутренееПотреблениеОбъект.Комментарий	= "#Документ создан автоматически";
   Если ВнутренееПотреблениеОбъект.ПроверитьЗаполнение() Тогда
	   ВнутренееПотреблениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
   Иначе
	   ЗаписьЖурналаРегистрации(
					   "Создание документа ""Внутреннее потребление""",
					   УровеньЖурналаРегистрации.Ошибка,,,
					   СтрШаблон("Не удалось создать документ ""Внутреннее потребление"" на основании %1", ЗаказНаВнутреннееПотребление));
	   Возврат;
   КонецЕсли;  
   
КонецПроцедуры  

