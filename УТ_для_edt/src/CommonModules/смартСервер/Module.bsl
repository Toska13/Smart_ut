#Область АвтоматическоеФормированиеСкладскихОрдеров  
//++ #5806 смарт: Тимофеева 26.02.26 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц.

Процедура СоздатьСкладскиеОрдераОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Отказ Тогда 	
		Возврат;  	
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПеремещениеТоваров") Тогда
		
		ИспользоватьОрдернуюСхемуПриОтгрузке = СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(Источник.СкладОтправитель, Источник.Дата);
		ИспользоватьОрдернуюСхемуПриПоступлении = СкладыСервер.ИспользоватьОрдернуюСхемуПриПоступлении(Источник.СкладПолучатель, Источник.Дата);
		
		//++ #6868 смарт: Тимофеева 25.05.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Изменение алгоритма формирования ордеров (физ - физ)
		//Если ЭтоСкладФизическогоЛица(Источник.СкладОтправитель) И ИспользоватьОрдернуюСхемуПриОтгрузке
		//	И ЭтоСкладФизическогоЛица(Источник.СкладПолучатель) И ИспользоватьОрдернуюСхемуПриПоступлении 
		//    И НЕ ЕстьТоварыИспользующиеСерии(Источник.Товары.Выгрузить(,"Номенклатура"))
		//	Тогда  
		//	
		//	Если НЕ ЗначениеЗаполнено(НайтиРасходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказНаПеремещение, Истина)) Тогда
		//		РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказНаПеремещение, Источник.Ссылка, ДействиеСоздатьРасходныйОрдер());
		//	КонецЕсли;
		//	Если НЕ ЗначениеЗаполнено(НайтиПриходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказНаПеремещение)) Тогда
		//		РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказНаПеремещение, Источник.Ссылка, ДействиеСоздатьПриходныйОрдер());
		//	КонецЕсли;
		//КонецЕсли;
		//-- #6868 смарт: Тимофеева 25.05.2026
		
		Если ЭтоСкладФизическогоЛица(Источник.СкладОтправитель) И ИспользоватьОрдернуюСхемуПриОтгрузке
			И НЕ ИспользоватьОрдернуюСхемуПриПоступлении 
            И НЕ ЕстьТоварыИспользующиеСерии(Источник.Товары.Выгрузить(,"Номенклатура"))
			Тогда  
			
			Если НЕ ЗначениеЗаполнено(НайтиРасходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказНаПеремещение, Истина)) Тогда
				РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказНаПеремещение, Источник.Ссылка, ДействиеСоздатьРасходныйОрдер());
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ИспользоватьОрдернуюСхемуПриОтгрузке
			И ЭтоСкладФизическогоЛица(Источник.СкладПолучатель) И ИспользоватьОрдернуюСхемуПриПоступлении 
            И НЕ ЕстьТоварыИспользующиеСерии(Источник.Товары.Выгрузить(,"Номенклатура"))
			Тогда  
			
			Если НЕ ЗначениеЗаполнено(НайтиПриходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказНаПеремещение)) Тогда
				РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказНаПеремещение, Источник.Ссылка, ДействиеСоздатьПриходныйОрдер());
			КонецЕсли;
		КонецЕсли; 
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ПриходныйОрдерНаТовары") 
		И Источник.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят Тогда
		
		Заказ = Источник.Распоряжение;
		Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
			РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Дата, СкладОтправитель"); 
			
			Если ЭтоСкладФизическогоЛица(РеквизитыЗаказа.СкладОтправитель) 
				И СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(РеквизитыЗаказа.СкладОтправитель, РеквизитыЗаказа.Дата)
				И НЕ ЗначениеЗаполнено(НайтиРасходныйОрдерНаТоварыПоЗаказу(Заказ, Истина))
				Тогда
				РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Заказ, Источник.Ссылка, ДействиеСоздатьРасходныйОрдер());
			КонецЕсли;
			
		КонецЕсли;
	
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РасходныйОрдерНаТовары") 
		И Источник.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен Тогда
				        	
		ТаблицаРаспоряжения = Источник.ТоварыПоРаспоряжениям.Выгрузить(,"Распоряжение");
		ТаблицаРаспоряжения.Свернуть("Распоряжение");
		Для Каждого СтрокаРаспоряжения Из ТаблицаРаспоряжения Цикл  
			
			Заказ = СтрокаРаспоряжения.Распоряжение;
			Если ТипЗнч(Заказ) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
				РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказ, "Дата, СкладОтправитель, СкладПолучатель, ДокументОснование");				
				Если НЕ ТипЗнч(РеквизитыЗаказа.ДокументОснование) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования")
					И ЭтоСкладФизическогоЛица(РеквизитыЗаказа.СкладПолучатель) 
					И СкладыСервер.ИспользоватьОрдернуюСхемуПриПоступлении(РеквизитыЗаказа.СкладПолучатель, Источник.Дата)
					И НЕ ЗначениеЗаполнено(НайтиПриходныйОрдерНаТоварыПоЗаказу(Заказ))
					//++ #6868 смарт: Тимофеева 25.05.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Изменение алгоритма формирования ордеров (физ - физ)
					//И (НЕ ЭтоСкладФизическогоЛица(РеквизитыЗаказа.СкладОтправитель)
					//ИЛИ (ЭтоСкладФизическогоЛица(РеквизитыЗаказа.СкладОтправитель) И ЕстьТоварыИспользующиеСерии(Источник.ТоварыПоРаспоряжениям.Выгрузить(,"Номенклатура"))))
					//-- #6868 смарт: Тимофеева 25.05.2026
					Тогда
					РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Заказ, Источник.Ссылка, ДействиеСоздатьПриходныйОрдер());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.ВнутреннееПотреблениеТоваров") Тогда
		
		Если ЭтоСкладФизическогоЛица(Источник.Склад) И СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(Источник.Склад, Источник.Дата)
			И НЕ ЕстьТоварыИспользующиеСерии(Источник.Товары.Выгрузить(,"Номенклатура"))
			И НЕ ЗначениеЗаполнено(НайтиРасходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказНаВнутреннееПотребление, Истина)) Тогда  
			РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказНаВнутреннееПотребление, Источник.Ссылка, ДействиеСоздатьРасходныйОрдер());
        КонецЕсли;
		
	//++ #6326 смарт: Тимофеева 03.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Дополнение. Уведомления.
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Если ЭтоСкладФизическогоЛица(Источник.Склад) И СкладыСервер.ИспользоватьОрдернуюСхемуПриОтгрузке(Источник.Склад, Источник.Дата)
			И НЕ ЕстьТоварыИспользующиеСерии(Источник.Товары.Выгрузить(,"Номенклатура"))
			И НЕ ЗначениеЗаполнено(НайтиРасходныйОрдерНаТоварыПоЗаказу(Источник.ЗаказКлиента, Истина)) Тогда  
			РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(Источник.ЗаказКлиента, Источник.Ссылка, ДействиеСоздатьРасходныйОрдер());
        КонецЕсли; 	
    //-- #6326 смарт: Тимофеева 03.04.2026
	КонецЕсли;
	
	Если ЕстьДействияПоСобытию(Источник.Ссылка) Тогда
		ЗапуститьРегламентноеЗаданиеСозданиеСкладскихОрдеров();
	КонецЕсли;
	
КонецПроцедуры

Функция ДействиеСоздатьРасходныйОрдер()
	Возврат "Создать расходный ордер";	
КонецФункции

Функция ДействиеСоздатьПриходныйОрдер()
	Возврат "Создать приходный ордер";	
КонецФункции

Функция ЭтоСкладФизическогоЛица(Склад) Экспорт
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НазначениеСклада = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "смартНазначениеСклада", Истина);
	
	Возврат НазначениеСклада = Перечисления.смартНазначенияСкладов.ФизическоеЛицо;
	
КонецФункции 

Функция ЕстьТоварыИспользующиеСерии(Товары) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	&Товары КАК ЗаказНаПеремещениеТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО ВТ_Номенклатура.Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
	|			И (ВидыНоменклатуры.ИспользоватьСерии)";
	Запрос.УстановитьПараметр("Товары", Товары);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();	
КонецФункции 

Функция ЕстьТоварыИспользующиеСерииПоДокументу(ИсточникСтрока, Ссылка) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	%ИсточникСтрока% КАК Товары 
	|ГДЕ
	|   Товары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|		ПО ВТ_Номенклатура.Номенклатура.ВидНоменклатуры = ВидыНоменклатуры.Ссылка
	|			И (ВидыНоменклатуры.ИспользоватьСерии)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка); 
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ИсточникСтрока%", ИсточникСтрока);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат НЕ РезультатЗапроса.Пустой();	
КонецФункции

Функция НайтиПриходныйОрдерНаТоварыПоЗаказу(Заказ) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходныйОрдерНаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары КАК ПриходныйОрдерНаТовары
	|ГДЕ
	|	ПриходныйОрдерНаТовары.Распоряжение = &Распоряжение
	|	И ПриходныйОрдерНаТовары.Проведен";	
	Запрос.УстановитьПараметр("Распоряжение", Заказ); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ПриходныйОрдерНаТовары.ПустаяСсылка();
КонецФункции 

Функция ЕстьДействияПоСобытию(ДокументСобытие)  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОчередьФормированияСкладскихОрдеров.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	РегистрСведений.смартОчередьФормированияСкладскихОрдеров КАК смартОчередьФормированияСкладскихОрдеров
	|ГДЕ
	|	смартОчередьФормированияСкладскихОрдеров.ДокументСобытие = &ДокументСобытие";	
	Запрос.УстановитьПараметр("ДокументСобытие", ДокументСобытие);	
	Возврат НЕ Запрос.Выполнить().Пустой();	
КонецФункции 

Процедура ЗапуститьРегламентноеЗаданиеСозданиеСкладскихОрдеров()
   ИмяМетода = Метаданные.РегламентныеЗадания.смартСозданиеСкладскихОрдеров.ИмяМетода;

   Отбор = Новый Структура;
   Отбор.Вставить("ИмяМетода", ИмяМетода);
   Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
   ФоновыеЗаданияСозданияСкладскихОрдеров = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
   Если ФоновыеЗаданияСозданияСкладскихОрдеров.Количество() = 0 Тогда
	   НаименованиеФоновогоЗадания = НСтр("ru = 'Запуск вручную: Автоматическое создание складских ордеров (смарт)'");
	   ФоновыеЗадания.Выполнить(ИмяМетода,,, НаименованиеФоновогоЗадания);
   КонецЕсли;
КонецПроцедуры

//Регламентное задание
Процедура СоздатьСкладскиеОрдера() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.смартСозданиеПоступленийТоваровНаСклад);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Автоматическое создание складских ордеров (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Начато регламентное создание складских ордеров.'"));
							 
	ДействиеСоздатьРасходныйОрдер = ДействиеСоздатьРасходныйОрдер();
	ДействиеСоздатьПриходныйОрдер = ДействиеСоздатьПриходныйОрдер();
	Для Каждого СтрокаДляОбработки Из ПолучитьОчередьДляСозданияДокументов() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			Если СтрокаДляОбработки.Действие = ДействиеСоздатьПриходныйОрдер Тогда 
				
				Сдвиг = 10;
				Если НЕ ТипЗнч(СтрокаДляОбработки.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
					ВызватьИсключение "Недопустимый тип основания";
				КонецЕсли; 
				
				РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДляОбработки.ДокументОснование, "Дата, Номер, СкладОтправитель, СкладПолучатель"); 
				
				Если НЕ ЭтоСкладФизическогоЛица(РеквизитыЗаказа.СкладПолучатель) Тогда
					ВызватьИсключение "Недопустимое назначение склада";
				КонецЕсли; 
				
				СоздатьПриходныйОрдерНаТоварыПоЗаказу(СтрокаДляОбработки.ДатаСобытия + Сдвиг, СтрокаДляОбработки.ДокументОснование, РеквизитыЗаказа);
				
			ИначеЕсли СтрокаДляОбработки.Действие = ДействиеСоздатьРасходныйОрдер Тогда 
				
				Сдвиг = 10;
				Если ТипЗнч(СтрокаДляОбработки.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда  
					
					Если ТипЗнч(СтрокаДляОбработки.ДокументСобытие) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
						Сдвиг = -10	
					КонецЕсли;	
					
					Если ТипЗнч(СтрокаДляОбработки.ДокументСобытие) = Тип("ДокументСсылка.ПриходныйОрдерНаТовары")
						И ЕстьТоварыИспользующиеСерииПоДокументу("Документ.ПриходныйОрдерНаТовары.Товары", СтрокаДляОбработки.ДокументСобытие) Тогда
						
						СоздатьРасходныйОрдерНаТоварыПоПриходномуОрдеру(СтрокаДляОбработки.ДатаСобытия + Сдвиг, СтрокаДляОбработки.ДокументСобытие);
					
					Иначе
						
						РеквизитыОснования 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДляОбработки.ДокументОснование, "СкладОтправитель, СкладПолучатель");
						Склад 			 	= РеквизитыОснования.СкладОтправитель;
						Получатель 			= РеквизитыОснования.СкладПолучатель; 
						
						Если НЕ ЭтоСкладФизическогоЛица(Склад) Тогда
							ВызватьИсключение "Недопустимое назначение склада";
						КонецЕсли;
					
						СоздатьРасходныйОрдерНаТоварыПоЗаказу(СтрокаДляОбработки.ДатаСобытия + Сдвиг, СтрокаДляОбработки.ДокументОснование, Склад, Получатель);	

					КонецЕсли;					
					
				ИначеЕсли ТипЗнч(СтрокаДляОбработки.ДокументОснование) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
					РеквизитыОснования 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДляОбработки.ДокументОснование, "Подразделение, Склад");
					Склад 				= РеквизитыОснования.Склад;
					Получатель 			= РеквизитыОснования.Подразделение;  
					
					Если НЕ ЭтоСкладФизическогоЛица(Склад) Тогда
						ВызватьИсключение "Недопустимое назначение склада";
					КонецЕсли;
					
					СоздатьРасходныйОрдерНаТоварыПоЗаказу(СтрокаДляОбработки.ДатаСобытия + Сдвиг, СтрокаДляОбработки.ДокументОснование, Склад, Получатель);	
					
				//++ #6326 смарт: Тимофеева 03.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Дополнение. Уведомления.
				ИначеЕсли ТипЗнч(СтрокаДляОбработки.ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				
				    Если  ТипЗнч(СтрокаДляОбработки.ДокументСобытие) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
						
						Если ЕстьСчетаФактурыВыданные(СтрокаДляОбработки.ДокументСобытие) Тогда
							РеквизитыОснования 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДляОбработки.ДокументОснование, "Партнер, Склад");
							Склад 				= РеквизитыОснования.Склад;
							Получатель 			= РеквизитыОснования.Партнер;  
					
							Если НЕ ЭтоСкладФизическогоЛица(Склад) Тогда
								ВызватьИсключение "Недопустимое назначение склада";
							КонецЕсли;
					
							СоздатьРасходныйОрдерНаТоварыПоЗаказу(СтрокаДляОбработки.ДатаСобытия + Сдвиг, СтрокаДляОбработки.ДокументОснование, Склад, Получатель);	
						Иначе
							ВызватьИсключение "Не введена счет-фактура";
						КонецЕсли;
					КонецЕсли;				
				//-- #6326 смарт: Тимофеева 03.04.2026
				Иначе
					ВызватьИсключение "Недопустимый тип основания";
				КонецЕсли; 
				
			КонецЕсли;				
			РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.УдалитьЗапись(СтрокаДляОбработки);
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ОписаниеОшибки = ОписаниеОшибки(); 
			МассивСообщенийПользователю = ПолучитьСообщенияПользователю();
			Для Каждого ЭлементСообщение Из МассивСообщенийПользователю Цикл
				ОписаниеОшибки = ОписаниеОшибки + "#" + ЭлементСообщение.Текст;		
			КонецЦикла;				
			РегистрыСведений.смартОчередьФормированияСкладскихОрдеров.ДобавитьЗапись(СтрокаДляОбработки.ДокументОснование, СтрокаДляОбработки.ДокументСобытие, 
																					СтрокаДляОбработки.Действие, ОписаниеОшибки);
		КонецПопытки; 		
								 
	КонецЦикла;						 
							 
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Автоматическое создание складских ордеров (смарт)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Закончено регламентное создание складских ордеров.'"));
	
КонецПроцедуры 

Функция ПолучитьОчередьДляСозданияДокументов()  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОчередьФормированияСкладскихОрдеров.ДокументОснование КАК ДокументОснование,
	|	смартОчередьФормированияСкладскихОрдеров.ДокументСобытие.Дата КАК ДатаСобытия,
	|	смартОчередьФормированияСкладскихОрдеров.ДокументСобытие КАК ДокументСобытие,
	|	смартОчередьФормированияСкладскихОрдеров.Действие КАК Действие
	|ИЗ
	|	РегистрСведений.смартОчередьФормированияСкладскихОрдеров КАК смартОчередьФормированияСкладскихОрдеров
	|ГДЕ
	|	смартОчередьФормированияСкладскихОрдеров.КоличествоПопыток < &КоличествоПопыток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументСобытие УБЫВ";	
	Запрос.УстановитьПараметр("КоличествоПопыток", 10);	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить();	
КонецФункции

Функция СоздатьПриходныйОрдерНаТоварыПоЗаказу(ДатаОрдера, ДокументЗаказ, РеквизитыЗаказа) Экспорт  
	
	Основание = Новый Структура;
	Основание.Вставить("Распоряжение",               ДокументЗаказ);
	Основание.Вставить("Отправитель",                РеквизитыЗаказа.СкладОтправитель);
	Основание.Вставить("ЗакрыватьГрафикПоступления", Истина);
	Основание.Вставить("Склад",                      РеквизитыЗаказа.СкладПолучатель);
	Основание.Вставить("ДатаВходящегоДокумента",     РеквизитыЗаказа.Дата);
	Основание.Вставить("ДатаПоступления",     		 ДатаОрдера);
	Основание.Вставить("НомерВходящегоДокумента",    ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыЗаказа.Номер, Истина, Истина));
	Основание.Вставить("ХозяйственнаяОперация",      Перечисления.ХозяйственныеОперации.ПеремещениеТоваров);
	
	ПриходныйОрдерНаТоварыОбъект = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	ПриходныйОрдерНаТоварыОбъект.Заполнить(Основание); 
	
	Если ПриходныйОрдерНаТоварыОбъект.Товары.Количество() = 0 Тогда
		ВызватьИсключение "Табличная часть приходного ордера пустая";
	КонецЕсли;
	
	ПриходныйОрдерНаТоварыОбъект.Статус 			= Перечисления.СтатусыПриходныхОрдеров.Принят;	
	ПриходныйОрдерНаТоварыОбъект.Дата 				= ДатаОрдера;
	ПриходныйОрдерНаТоварыОбъект.Комментарий 		= "#Документ создан автоматически#5806";
	ПриходныйОрдерНаТоварыОбъект.Ответственный 		= Справочники.Пользователи.ПустаяСсылка();
	ПриходныйОрдерНаТоварыОбъект.ДополнительныеСвойства.Вставить("НеОтражатьСостояниеЗаявкиНаРазборОборудования", Истина);

	ПриходныйОрдерНаТоварыОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);

КонецФункции 

Функция СоздатьРасходныйОрдерНаТоварыПоЗаказу(ДатаОрдера, ДокументЗаказ, Склад, Получатель) Экспорт  
	
	СтруктураПараметровСозданияРасходныхОрдеров 			= СкладыСервер.ПараметрыПереоформленияРасходныхОрдеров();
	СтруктураПараметровСозданияРасходныхОрдеров.Склад 		= Склад;
	СтруктураПараметровСозданияРасходныхОрдеров.Получатель 	= Получатель;
	СтруктураПараметровСозданияРасходныхОрдеров.РаспоряженияНаОтгрузку.Добавить(ДокументЗаказ);
	
	ТаблицаСозданныеРасходныеОрдера = ПолучитьТаблицуСозданныеРасходныеОрдера(СтруктураПараметровСозданияРасходныхОрдеров.РаспоряженияНаОтгрузку);
	Если ТаблицаСозданныеРасходныеОрдера.Количество() Тогда  // Запрещаем использовать уже созданные Расходные ордера
		СтруктураПараметровСозданияРасходныхОрдеров.Вставить("СозданныеРасходныеОрдера", ТаблицаСозданныеРасходныеОрдера);
	КонецЕсли;
	Ордера = СкладыСервер.ПереоформитьРасходныеОрдера(СтруктураПараметровСозданияРасходныхОрдеров);
	
	Для Каждого СтрокаДок Из Ордера.ОформленныеОрдера Цикл
		РасходныйОрдерНаТоварыОбъект 					= СтрокаДок.РасходныйОрдер.ПолучитьОбъект();
		РасходныйОрдерНаТоварыОбъект.Дата 				= ДатаОрдера;
		РасходныйОрдерНаТоварыОбъект.ДатаОтгрузки 		= ДатаОрдера;
		РасходныйОрдерНаТоварыОбъект.Статус 			= Перечисления.СтатусыРасходныхОрдеров.Отгружен;
		РасходныйОрдерНаТоварыОбъект.Ответственный 		= Справочники.Пользователи.ПустаяСсылка();
		РасходныйОрдерНаТоварыОбъект.Комментарий		= "#Документ создан автоматически#5806";
		
		Для Каждого СтрокаОтгружаемыеТовары Из РасходныйОрдерНаТоварыОбъект.ОтгружаемыеТовары Цикл
			СтрокаОтгружаемыеТовары.Действие 			= Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить; 
		КонецЦикла;
		
		РасходныйОрдерНаТоварыОбъект.ДополнительныеСвойства.Вставить("НеОтражатьСостояниеЗаявкиНаРазборОборудования", Истина);
	 	РасходныйОрдерНаТоварыОбъект.ДополнительныеСвойства.Вставить("смартПроверятьНаличиеРолиВзятиеРасходногоОрдераВРаботу", Ложь);

		РасходныйОрдерНаТоварыОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	КонецЦикла;
	
	Возврат Ордера;
КонецФункции 

Функция ПолучитьТаблицуСозданныеРасходныеОрдера(Распоряжения)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОтгрузки", Распоряжения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыКОтгрузкеОбороты.Регистратор КАК ДокументОбъект,
	|	ИСТИНА КАК Использован
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Обороты(, , Регистратор, ДокументОтгрузки В (&ДокументОтгрузки)) КАК ТоварыКОтгрузкеОбороты
	|ГДЕ
	|	ТоварыКОтгрузкеОбороты.Регистратор ССЫЛКА Документ.РасходныйОрдерНаТовары";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции 

Функция СоздатьРасходныйОрдерНаТоварыПоПриходномуОрдеру(ДатаОрдера, ПриходныйОрдерСсылка) Экспорт  
	РасходныйОрдерНаТоварыОбъект					= Документы.РасходныйОрдерНаТовары.СоздатьДокумент();	
	РасходныйОрдерНаТоварыОбъект.Дата 				= ДатаОрдера;
	РасходныйОрдерНаТоварыОбъект.ДатаОтгрузки 		= ДатаОрдера;
	РасходныйОрдерНаТоварыОбъект.Статус 			= Перечисления.СтатусыРасходныхОрдеров.Отгружен;
	РасходныйОрдерНаТоварыОбъект.Ответственный 		= Справочники.Пользователи.ПустаяСсылка();
	РасходныйОрдерНаТоварыОбъект.Приоритет 			= Справочники.Приоритеты.НайтиПоНаименованию("Средний");
	РасходныйОрдерНаТоварыОбъект.СкладскаяОперация 	= Перечисления.СкладскиеОперации.ОтгрузкаПоПеремещению;
	
	РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПриходныйОрдерСсылка, "Распоряжение, Отправитель, Склад, Товары");
	РасходныйОрдерНаТоварыОбъект.Склад 				= РеквизитыОснования.Отправитель;
	РасходныйОрдерНаТоварыОбъект.Получатель 		= РеквизитыОснования.Склад;
		
	Выборка = РеквизитыОснования.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = РасходныйОрдерНаТоварыОбъект.ТоварыПоРаспоряжениям.Добавить();
		НоваяСтрока.Распоряжение    = РеквизитыОснования.Распоряжение;
		НоваяСтрока.Номенклатура    = Выборка.Номенклатура;
		НоваяСтрока.Характеристика  = Выборка.Характеристика;
		НоваяСтрока.Серия 			= Выборка.Серия;
		НоваяСтрока.Назначение      = Выборка.Назначение;
		НоваяСтрока.Количество     	= Выборка.Количество;
		//++ #6384  смарт: Тимофеева 29.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Расходные ордера (склад ГАРАНТИЯ и чернила)
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка	= Выборка.смартНомерЗаявкиНаГарантийныйРемонтСсылка;
		//-- #6384  смарт: Тимофеева 29.04.2026
		
		НоваяСтрока = РасходныйОрдерНаТоварыОбъект.ОтгружаемыеТовары.Добавить();
		НоваяСтрока.Номенклатура 		= Выборка.Номенклатура;
		НоваяСтрока.Характеристика  	= Выборка.Характеристика;
		НоваяСтрока.Серия 				= Выборка.Серия;
		НоваяСтрока.Назначение 			= Выборка.Назначение;
		НоваяСтрока.Количество 			= Выборка.Количество;
		НоваяСтрока.КоличествоУпаковок 	= Выборка.КоличествоУпаковок;
		НоваяСтрока.Упаковка 			= Выборка.Упаковка;
		//НоваяСтрока.Действие 			= Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить; 
	КонецЦикла;
	
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(РасходныйОрдерНаТоварыОбъект, Документы.РасходныйОрдерНаТовары));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(РасходныйОрдерНаТоварыОбъект, ПараметрыУказанияСерий.ОтгружаемыеТовары);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(РасходныйОрдерНаТоварыОбъект, ПараметрыУказанияСерий.ТоварыПоРаспоряжениям);
	
	//++ #6384  смарт: Тимофеева 29.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Расходные ордера (склад ГАРАНТИЯ и чернила)
	Если НЕ РасходныйОрдерНаТоварыОбъект.ТоварыПоРаспоряжениям.Найти(13, "СтатусУказанияСерий") = Неопределено Тогда 
		ТоварыПоРаспоряжениямБезСерий = РасходныйОрдерНаТоварыОбъект.ТоварыПоРаспоряжениям.Выгрузить(Новый Структура("СтатусУказанияСерий", 13), "Номенклатура, Характеристика, смартНомерЗаявкиНаГарантийныйРемонтСсылка");
		ЗаполнитьСерииТоваровПоРаспоряжениям(РасходныйОрдерНаТоварыОбъект, РеквизитыОснования.Распоряжение, ТоварыПоРаспоряжениямБезСерий, ПараметрыУказанияСерий);
	КонецЕсли; 
	
	Если РасходныйОрдерНаТоварыОбъект.Получатель = Справочники.смартПредопределенныеЗначения.СкладГарантийныхЗапчастейПоУмолчанию.Значение тогда
		
		СерииПоУмолчаниюСоответствие = смартСервер.ПолучитьСерииПоУмолчаниюСоответствие();
		Для Каждого ТекСтрока Из РасходныйОрдерНаТоварыОбъект.ОтгружаемыеТовары Цикл
			Если ТекСтрока.СтатусУказанияСерий = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекСтрока.Серия) Тогда
				Продолжить;
			КонецЕсли;
			
			ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Номенклатура, "ВидНоменклатуры");
			СерияПоУмолчанию = СерииПоУмолчаниюСоответствие.Получить(ВидНоменклатуры);    
			
			Если НоменклатураКлиентСервер.ВЭтомСтатусеСерииУказываютсяВТЧТовары(ТекСтрока.СтатусУказанияСерий, ПараметрыУказанияСерий.ОтгружаемыеТовары) Тогда
				ТекСтрока.Серия = СерияПоУмолчанию;	
			КонецЕсли;
		КонецЦикла;
		
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(РасходныйОрдерНаТоварыОбъект, ПараметрыУказанияСерий.ОтгружаемыеТовары);
	КонецЕсли;	

	Для Каждого Строка Из РасходныйОрдерНаТоварыОбъект.ОтгружаемыеТовары Цикл
		Строка.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить; 
	КонецЦикла;

	РасходныйОрдерНаТоварыОбъект.ВсегоМест = УпаковочныеЛистыСервер.КоличествоМестВТЧ(РасходныйОрдерНаТоварыОбъект.ОтгружаемыеТовары);
	//-- #6384  смарт: Тимофеева 29.04.2026 
	
	РасходныйОрдерНаТоварыОбъект.Комментарий	= "#Документ создан автоматически#5806";
	РасходныйОрдерНаТоварыОбъект.ДополнительныеСвойства.Вставить("НеОтражатьСостояниеЗаявкиНаРазборОборудования", Истина);
	РасходныйОрдерНаТоварыОбъект.ДополнительныеСвойства.Вставить("смартПроверятьНаличиеРолиВзятиеРасходногоОрдераВРаботу", Ложь);
	
	РасходныйОрдерНаТоварыОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);		
	Возврат РасходныйОрдерНаТоварыОбъект.Ссылка;
КонецФункции 

//-- #5806 смарт: Тимофеева 26.02.26 

//++ #6326 смарт: Тимофеева 03.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Дополнение. Уведомления.				
Функция ЕстьСчетаФактурыВыданные(ДокументОснование) 
	Результат 	= Ложь;	
	Основания 	= ОбщегоНазначенияУТКлиентСервер.Массив(ДокументОснование);
	СФ 			= УчетНДСУП.СчетаФактурыВыданныеПоДокументамОснованиям(Основания, Истина);	
	Результат 	= СФ.Количество() > 0; 
	Возврат Результат;
КонецФункции 
//-- #6326 смарт: Тимофеева 03.04.2026

//++ #6294 смарт: Тимофеева 30.03.2026 /  Перевод запчастей на серийный учет. ЗГР. Не отображается серия в документе Ввод начальных остатков.
Функция ПолучитьСерииПоУмолчаниюСоответствие() Экспорт	
	СерииПоУмолчаниюСоответствие = Новый Соответствие;	
	СерииПоУмолчанию	= смартОбщегоНазначения.смартПолучитьПредопределенноеЗначениеТЧСписокЗначений("СерииПоУмолчанию"); 
	Для Каждого СтруктураСерияПоУмолчанию Из СерииПоУмолчанию Цикл		
		Если ЗначениеЗаполнено(СтруктураСерияПоУмолчанию.К1) 
			И ТипЗнч(СтруктураСерияПоУмолчанию.К1) = Тип("СправочникСсылка.ВидыНоменклатуры")
			И ЗначениеЗаполнено(СтруктураСерияПоУмолчанию.К2) 
			И ТипЗнч(СтруктураСерияПоУмолчанию.К2) = Тип("СправочникСсылка.СерииНоменклатуры") Тогда 		
			СерииПоУмолчаниюСоответствие.Вставить(СтруктураСерияПоУмолчанию.К1, СтруктураСерияПоУмолчанию.К2);
		КонецЕсли; 	
	КонецЦикла;
	Возврат СерииПоУмолчаниюСоответствие;
КонецФункции
//-- #6294 смарт: Тимофеева 30.03.2026 

//++ #6384  смарт: Тимофеева 29.04.2026 / Перевод запчастей на серийный учет. Автоматизация создания ордеров для складов физлиц. Расходные ордера (склад ГАРАНТИЯ и чернила)
Процедура ЗаполнитьСерииТоваровПоРаспоряжениям(Объект, Распоряжение, ТоварыПоРаспоряжениямБезСерий, ПараметрыУказанияСерий)
	Серии = ТаблицаСерийПоОтгрузкеПриПеремещении(Распоряжение, ТоварыПоРаспоряжениямБезСерий);
	НоменклатураСервер.ДополнитьТаблицуКолонкамиПоПолямПараметровУказанияСерий(ПараметрыУказанияСерий.ТоварыПоРаспоряжениям, Серии,, Истина);
	
	Действия = Новый Структура;
	Действия.Вставить("ОбновлятьКоличествоТоваровПриРегистрацииСерий", Истина); 
	ЗаполнитьСерииВТЧПоТаблицеСерий(Объект, ПараметрыУказанияСерий.ТоварыПоРаспоряжениям, Серии, Действия, ",Распоряжение,смартНомерЗаявкиНаГарантийныйРемонтСсылка");
	
	Действия.Вставить("ПересчитатьКоличествоУпаковок", Истина);
	Серии.Свернуть("Номенклатура,Характеристика,Серия", "Количество");
	ЗаполнитьСерииВТЧПоТаблицеСерий(Объект, ПараметрыУказанияСерий.ОтгружаемыеТовары, Серии, Действия);			
КонецПроцедуры

Функция ТаблицаСерийПоОтгрузкеПриПеремещении(Распоряжение, ТоварыПоРаспоряжениямБезСерий)
	
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ТекстЗапросаПоРаспоряжениям =
		" ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПеремещениеТоваров.Ссылка КАК Распоряжение 
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	ПеремещениеТоваров.Проведен
		|	И ПеремещениеТоваров.Товары.ЗаказНаПеремещение = &Распоряжение";
	Иначе
		ТекстЗапросаПоРаспоряжениям =
		" &Распоряжение ";
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТоварыПоРаспоряжениямБезСерий.Номенклатура КАК Номенклатура,
	|	ТоварыПоРаспоряжениямБезСерий.Характеристика КАК Характеристика,
	|	ТоварыПоРаспоряжениямБезСерий.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК смартНомерЗаявкиНаГарантийныйРемонтСсылка
	|ПОМЕСТИТЬ ВТ_ТоварыБезСерий
	|ИЗ
	|	&ТоварыПоРаспоряжениямБезСерий КАК ТоварыПоРаспоряжениямБезСерий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Серия КАК Серия,
	|	СУММА(ВложенныйЗапрос.Количество) КАК Количество,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	ВложенныйЗапрос.Характеристика КАК Характеристика,
	|	ВложенныйЗапрос.Назначение КАК Назначение,
	|	ВложенныйЗапрос.Распоряжение КАК Распоряжение,
	|	ВложенныйЗапрос.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК смартНомерЗаявкиНаГарантийныйРемонтСсылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПеремещениеТоваровТовары.Серия КАК Серия,
	|		ПеремещениеТоваровТовары.Количество КАК Количество,
	|		ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	|		ПеремещениеТоваровТовары.Характеристика КАК Характеристика,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(ПеремещениеТоваровТовары.Назначение.ДвиженияПоСкладскимРегистрам, ЛОЖЬ)
	|				ТОГДА ПеремещениеТоваровТовары.Назначение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		КОНЕЦ КАК Назначение,
	|		ПеремещениеТоваровТовары.Ссылка.ЗаказНаПеремещение КАК Распоряжение,
	|		ПеремещениеТоваровТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК смартНомерЗаявкиНаГарантийныйРемонтСсылка
	|	ИЗ
	|		Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	|	ГДЕ
	|		ПеремещениеТоваровТовары.Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|		И ПеремещениеТоваровТовары.Ссылка В(&ТекстЗапросаПоРаспоряжениям)
	|		И (ПеремещениеТоваровТовары.Номенклатура, ПеремещениеТоваровТовары.Характеристика) В
	|				(ВЫБРАТЬ
	|					ВТ_ТоварыБезСерий.Номенклатура,
	|					ВТ_ТоварыБезСерий.Характеристика
	|				ИЗ
	|					ВТ_ТоварыБезСерий)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Серия,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Характеристика,
	|	ВложенныйЗапрос.Назначение,
	|	ВложенныйЗапрос.Распоряжение,
	|	ВложенныйЗапрос.смартНомерЗаявкиНаГарантийныйРемонтСсылка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.Количество) > 0";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЗапросаПоРаспоряжениям", ТекстЗапросаПоРаспоряжениям);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Распоряжение", Распоряжение);
	Запрос.УстановитьПараметр("ТоварыПоРаспоряжениямБезСерий", ТоварыПоРаспоряжениямБезСерий);
	
	Серии = Запрос.Выполнить().Выгрузить();
	
	Возврат Серии;
	
КонецФункции

Процедура ЗаполнитьСерииВТЧПоТаблицеСерий(Объект, ПараметрыУказанияСерий, Серии, Действия, ТекстПоляСвязи = "")
	//ТекстПоляСвязи = "";
	
	//Для Каждого СтрМас Из ПараметрыУказанияСерий.ПоляСвязи Цикл
	//	ТекстПоляСвязи = ТекстПоляСвязи + "," + СтрМас  ;
	//КонецЦикла;
	СтруктураПоиска = Новый Структура("Номенклатура,Характеристика"+ТекстПоляСвязи);
	
	СвернутаяТаблицаТоваров = Объект[ПараметрыУказанияСерий.ИмяТЧТовары].Выгрузить(,"Номенклатура,Характеристика"+ТекстПоляСвязи);
	СвернутаяТаблицаТоваров.Свернуть("Номенклатура,Характеристика"+ТекстПоляСвязи);
	
	Для Каждого СтрТабл Из СвернутаяТаблицаТоваров Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрТабл);
		
		НайденныеСтрокиСерий = Серии.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтрокиСерий.Количество() > 0 Тогда
			
			НайденныеСтрокиТоваров = Объект[ПараметрыУказанияСерий.ИмяТЧТовары].НайтиСтроки(СтруктураПоиска);
			НомерПервойУдаляемойСтроки = 0;
			Для Каждого СтрМас Из НайденныеСтрокиТоваров Цикл
				
				Если НомерПервойУдаляемойСтроки = 0 Тогда
					НомерПервойУдаляемойСтроки = СтрМас.НомерСтроки;
				КонецЕсли;
				
				Объект[ПараметрыУказанияСерий.ИмяТЧТовары].Удалить(СтрМас);	
				
			КонецЦикла;
			
			Индекс = 0;
			
			Для Каждого СтрМас Из НайденныеСтрокиСерий Цикл
				
				Если НомерПервойУдаляемойСтроки = 0 Тогда
					НоваяСтрока = Объект[ПараметрыУказанияСерий.ИмяТЧТовары].Добавить();
				Иначе
					НоваяСтрока = Объект[ПараметрыУказанияСерий.ИмяТЧТовары].Вставить(НомерПервойУдаляемойСтроки - 1 + Индекс);
					Индекс = Индекс + 1;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрМас);
				ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, Действия, Неопределено);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий);
	
КонецПроцедуры

