//++ #Б-5028 смарт: Фролов 24.11.2025 //Доработка документа Заявка на ремонтные работы, по новому регламенту
//Процедура ЗафиксироватьИзменениеСтатусаЗаявокНаРемонтныеРаботыИПНР(Заявка, ПредыдущийСтатус, ТекущийСтатус) Экспорт
Процедура ЗафиксироватьИзменениеСтатусаЗаявокНаРемонтныеРаботыИПНР(Заявка, ПредыдущийСтатус, ТекущийСтатус, 
	Этап = Неопределено, Комментарий = Неопределено) Экспорт 
//-- #Б-5028 смарт: Фролов 24.11.2025	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Период КАК Период,
	|	Заявка КАК Заявка,
	|	Статус КАК Статус,
	|	Ответственный КАК Ответственный
	|ИЗ
	|	РегистрСведений.смартИсторияСостоянийЗаявокНаРемонтИПНР.СрезПоследних(, Заявка = &Заявка)
	|ГДЕ
	|	Статус = &Статус
	|	И ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)");
	Запрос.УстановитьПараметр("Заявка", Заявка);
	Запрос.УстановитьПараметр("Статус", ПредыдущийСтатус);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		НаборЗаписей = РегистрыСведений.смартИсторияСостоянийЗаявокНаРемонтИПНР.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Отбор.Заявка.Установить(Выборка.Заявка);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			
			НаборЗаписей[0].ДатаЗавершения = ТекущаяДата();
			НаборЗаписей.Записать(Истина);
			
		КонецЕсли;	
		
	КонецЕсли;	
	
	МенеджерЗаписи = РегистрыСведений.смартИсторияСостоянийЗаявокНаРемонтИПНР.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДата();
	МенеджерЗаписи.Заявка = Заявка;
	МенеджерЗаписи.Ответственный = Пользователи.ТекущийПользователь();
	МенеджерЗаписи.Статус = ТекущийСтатус;
	
	//++ #Б-5028 смарт: Фролов 24.11.2025 //Доработка документа Заявка на ремонтные работы, по новому регламенту
	Если НЕ Этап = Неопределено Тогда
		
		МенеджерЗаписи.Этап = Этап;
		МенеджерЗаписи.Комментарий = Комментарий;
		
	КонецЕсли;
	//-- #Б-5028 смарт: Фролов 24.11.2025
		
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры //-- #Б-4738 смарт: Фролов 16.10.2025	

