
#Область ЗвонокЧерезАТС

Функция Позвонить(Телефон, ВнутреннийНомер)Экспорт
	
	СообщениеОшибки="";
	ВнутреннийТелефонПользователя=ПолучитьВнутреннийТелефонТекущегоПользователя();
	
	Если ЗначениеЗаполнено(ВнутреннийТелефонПользователя) Тогда	
		Если Не ВнутреннийНомер И Не СтрДлина(Телефон)=10 Тогда
			СообщениеОшибки="Номер телефона заполнен не верно";
		КонецЕсли;	
		
		Если Не ВнутреннийНомер 
			И СообщениеОшибки="" 
			И (Лев(Телефон,1)="8" Или Лев(Телефон,1)="7") Тогда  // Это звонок по России
			Телефон="8"+Сред(Телефон,2);	
		Иначе 
			СообщениеОшибки="Звонки возможны только по России";
		КонецЕсли;
		
		Если СообщениеОшибки="" Тогда 
			Соединение=Новый HTTPСоединение("call.smart-t.me");
			ПараметрыЗапроса="?exten=SIP/"+ВнутреннийТелефонПользователя+"&cont="+?(ВнутреннийНомер,"internalcall","dial-trunk2")+"&number="+Телефон;
			Запрос=Новый HTTPЗапрос("clicktocall.php"+ПараметрыЗапроса);
			Ответ=Соединение.Получить(Запрос);
		КонецЕсли;
	Иначе
		СообщениеОшибки="Телефон пользователя не заполнен";
	КонецЕсли;
	
	Возврат СообщениеОшибки;
	
КонецФункции

Функция ПолучитьВнутреннийТелефонТекущегоПользователя()Экспорт 
	
	//++#1651 смарт: Лопато 17.04.2024 //Телефония. Хранение истории контактной информации пользователей  
	Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПользователиКлиентСервер.АвторизованныйПользователь(), 
																		Справочники.ВидыКонтактнойИнформации.смартРабочийТелефон);
	//--#1651 смарт: Лопато 17.04.2024
	
КонецФункции

