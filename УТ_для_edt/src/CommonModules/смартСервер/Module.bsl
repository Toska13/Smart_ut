Функция НайтиРасходныйОрдерНаТоварыПоЗаказу(ЗаказРаспоряжение, ТолькоПроведенные = Ложь) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение = &ЗаказРаспоряжение";	
	
	Запрос.Текст = Запрос.Текст + ?(ТолькоПроведенные, " И РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка.Проведен", "");
	
	Запрос.УстановитьПараметр("ЗаказРаспоряжение", ЗаказРаспоряжение); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда  		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.РасходныйОрдерНаТовары.ПустаяСсылка();
