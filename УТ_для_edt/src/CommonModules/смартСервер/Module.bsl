&НаСервере
Функция смартЗаполнитьКонтейнерПоДокументуНаСервере(СтруктураПараметров)
	
	Запрос = Новый Запрос; 
	
	//++ #1627 смарт: Мосолов 07.02.2024 //Документ Приходный ордер на товары. Ошибка при заполнении из обработки УправлениеПоступлением
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриобретениеТоваровУслугТовары.смартКонтейнер КАК смартКонтейнер,
	|	ПриобретениеТоваровУслугТовары.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ПриобретениеБезКоличества
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
	|	И ПриобретениеТоваровУслугТовары.Номенклатура = &Номенклатура
	|	И ПриобретениеТоваровУслугТовары.Характеристика = &Характеристика
	|	И ПриобретениеТоваровУслугТовары.Серия = &Серия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриобретениеТоваровУслугТовары.смартКонтейнер КАК смартКонтейнер,
	|	ПриобретениеТоваровУслугТовары.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ПриобретениеСКоличеством
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
	|	И ПриобретениеТоваровУслугТовары.Номенклатура = &Номенклатура
	|	И ПриобретениеТоваровУслугТовары.Характеристика = &Характеристика
	|	И ПриобретениеТоваровУслугТовары.Серия = &Серия
	|	И ПриобретениеТоваровУслугТовары.Количество = &Количество
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ПриобретениеСКоличеством.смартКонтейнер, ПриобретениеБезКоличества.смартКонтейнер) КАК смартКонтейнер
	|ИЗ
	|	ПриобретениеСКоличеством КАК ПриобретениеСКоличеством
	|		ПОЛНОЕ СОЕДИНЕНИЕ ПриобретениеБезКоличества КАК ПриобретениеБезКоличества
	|		ПО (ПриобретениеБезКоличества.Ссылка = ПриобретениеСКоличеством.Ссылка)";

	//-- #1627 смарт: Мосолов 07.02.2024 
	
	//++ #1577 смарт: Мосолов 25.12.2023 Исправить заполнение Приходного ордера по контейнерам (изначальная задача 1374) 
	Запрос.УстановитьПараметр("Ссылка", СтруктураПараметров.Регистратор);
	Запрос.УстановитьПараметр("Номенклатура", СтруктураПараметров.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", СтруктураПараметров.Характеристика);
	Запрос.УстановитьПараметр("Серия", СтруктураПараметров.Серия);
	Запрос.УстановитьПараметр("Количество", СтруктураПараметров.Количество);
	//-- #1577 смарт: Мосолов 25.12.2023  
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.смартКонтейнер;
	Иначе	
		Результат = ""
	КонецЕсли;	
	Возврат Результат;
КонецФункции//--#1374 смарт: Балашов 07.07.2023
