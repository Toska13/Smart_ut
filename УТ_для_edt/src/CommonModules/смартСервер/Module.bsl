//++ #Б-1116 смарт: Фролов 15.10.2024 //Создание общей очереди в механизме распределения Интересов
Процедура ДобавитьВОбщуюОчередьМенеджеровПоКвалификации(Квалификация) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Пользователь КАК Менеджер
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи
	|ГДЕ
	|	Ссылка = &Квалификация");
	Запрос.УстановитьПараметр("Квалификация", Квалификация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.смартОбщаяОчередьВыдачиЛидов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(Выборка.Менеджер);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		СтрокаНаборЗаписей = НаборЗаписей.Добавить();
		СтрокаНаборЗаписей.Менеджер = Выборка.Менеджер;
		СтрокаНаборЗаписей.ДатаНачала = ТекущаяДата();
		
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;	
	
КонецПроцедуры //-- #Б-1116 смарт: Фролов 15.10.2024

