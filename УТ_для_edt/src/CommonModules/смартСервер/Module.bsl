Функция ЕстьУслугиСЦ(Ссылка,ДатаВнедренияФункционала)Экспорт
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ДатаВнедрения",ДатаВнедренияФункционала);
	Запрос.УстановитьПараметр("ВидНоменклатуры",Справочники.ВидыНоменклатуры.ПолучитьВидыНоменклатурыСЦ());
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	ИСТИНА КАК ЕстьУслугаСЦ
	             |ИЗ
	             |	Документ.ЗаказКлиента.Товары КАК Таблица
	             |ГДЕ
	             |	Таблица.Ссылка = &Ссылка
	             |	И Таблица.Номенклатура.ВидНоменклатуры В(&ВидНоменклатуры)
	             |	И Таблица.Ссылка.Дата >= &ДатаВнедрения
	             |	И НЕ Таблица.Отменено";
	
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.ЕстьУслугаСЦ;
	КонецЕсли;	
	Возврат Ложь;
КонецФункции	

Процедура ДописатьДвиженияПоУчетуУслугСЦ(Заказ)Экспорт
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	смартРаботыСервисногоЦентра.Регистратор КАК Регистратор
	             |ИЗ
	             |	РегистрНакопления.смартРаботыСервисногоЦентра КАК смартРаботыСервисногоЦентра
				 |ГДЕ Заказ = &Заказ И НЕ Регистратор = &Заказ";
	МассивРегистраторв=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	НЗ=РегистрыНакопления.смартРаботыСервисногоЦентра.СоздатьНаборЗаписей();
	Для Каждого Регистратор Из МассивРегистраторв Цикл 
		НЗ.Отбор.Регистратор.Установить(Регистратор);
		НЗ.Прочитать();
		Таб=НЗ.Выгрузить();
		Таб.ЗаполнитьЗначения(Заказ.ДатаЗакрытия,"ДатаЗакрытия");
		Таб.ЗаполнитьЗначения(Заказ.смартИсполнительРаботПоЗаказу,"Инженер");
		Таб.ЗаполнитьЗначения(Заказ.Статус=Перечисления.СтатусыЗаказовКлиентов.Закрыт,"ЗаказЗакрыт");
		
		НЗ.Загрузить(Таб);
		НЗ.Записать();
	КонецЦикла;
КонецПроцедуры	
#КонецОбласти

#Область ЗаказыКлиентов

Функция ПолучитьПравильнуюОрганизациюИСоглашениеПоЗаказу(ЗНАЧ ЗаказКлиента) Экспорт
	
	//1. Проверка чернила Марабу
	ПроверятьЧернилаМарабу = Истина;
	Результат = Новый Структура("Организация,Соглашение", ЗаказКлиента.Организация, ЗаказКлиента.Соглашение);
	
	Если НЕ Справочники.смартПредопределенныеЗначения.Настройки.ПроверятьЗаполнениеОрганизацииДляПродажиЧернилКовчег Тогда
		ПроверятьЧернилаМарабу = Ложь;
	КонецЕсли;
	
	Если ПроверятьЧернилаМарабу И Пользователи.РолиДоступны("смартМенеджерБэкОфис") Тогда
		ПроверятьЧернилаМарабу = Ложь;
	КонецЕсли;
	
	Если ПроверятьЧернилаМарабу И ЗаказКлиента.Товары.Количество() = 0 Тогда
		ПроверятьЧернилаМарабу = Ложь;
	КонецЕсли;
	
	СегментЧернила = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("СегментНоменклатурыЧернилаКовчег");
	Если ПроверятьЧернилаМарабу И ЗначениеЗаполнено(СегментЧернила) Тогда
		
		ЕстьЧернила = Ложь;
		Для каждого стрТовары Из ЗаказКлиента.Товары Цикл
					
			Если СегментыСервер.ВходитВСегмент(стрТовары.Номенклатура, СегментЧернила) Тогда
				ЕстьЧернила = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ПроверятьЧернилаМарабу = ЕстьЧернила;
		
	Иначе
		ПроверятьЧернилаМарабу = Ложь;
	КонецЕсли;
	
	Если ПроверятьЧернилаМарабу Тогда
		
		ПрименятьАлгоритм = Ложь;
		ПодразделениеПользователя = Пользователи.АвторизованныйПользователь().Подразделение;
		Если ЗначениеЗаполнено(ПодразделениеПользователя) Тогда
			Для каждого стрПодразделение Из Справочники.смартПредопределенныеЗначения.Настройки.ПодразделенияПользователейДляПравилПродажЧернил Цикл
				Если стрПодразделение.Подразделение = ПодразделениеПользователя ИЛИ ПодразделениеПользователя.ПринадлежитЭлементу(стрПодразделение.Подразделение) Тогда
					ПрименятьАлгоритм = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ ПрименятьАлгоритм Тогда
			ПроверятьЧернилаМарабу = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПроверятьЧернилаМарабу Тогда
		
		ОрганизацияСмарт = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
		СоглашениеСмарт = Справочники.смартПредопределенныеЗначения.СоглашениеДляСайта.Значение;
		
		ОрганизацияКовчег = Справочники.смартПредопределенныеЗначения.Настройки.ОрганизацияКовчег;
		СоглашениеКовчег = Справочники.смартПредопределенныеЗначения.Настройки.СоглашениеКовчегПоЗаказамРубли;
		
		//0. Проверяем на оплату
		Если ЗначениеЗаполнено(ЗаказКлиента.Ссылка) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты
			|ИЗ
			|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
			|ГДЕ
			|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
			
			Запрос.УстановитьПараметр("Заказ", ЗаказКлиента.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И Выборка.СуммаОплаты > 0 Тогда
				ПроверятьЧернилаМарабу = Ложь;
			Конецесли;
			
		КонецЕсли;
		
		//1. Проверяем партнеров
		Если ПроверятьЧернилаМарабу И Справочники.смартПредопределенныеЗначения.Настройки.ПартнерыИсключенияИзПроверкиПродажКовчега.Найти(ЗаказКлиента.Партнер) <> Неопределено Тогда
			ПроверятьЧернилаМарабу = Ложь;
			Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
		КонецЕсли;
		
		Если ПроверятьЧернилаМарабу И ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.Настройки.СегментПартнеровДилеры) Тогда
			Если СегментыСервер.ВходитВСегмент(ЗаказКлиента.Партнер, Справочники.смартПредопределенныеЗначения.Настройки.СегментПартнеровДилеры) Тогда
				ПроверятьЧернилаМарабу = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверятьЧернилаМарабу Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	МАКСИМУМ(смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки) КАК ПроцентСкидки
			|ИЗ
			|	РегистрСведений.смартИндивидуальныеСкидкиКлиентов.СрезПоследних КАК смартИндивидуальныеСкидкиКлиентовСрезПоследних
			|ГДЕ
			|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Клиент = &Клиент
			|	И смартИндивидуальныеСкидкиКлиентовСрезПоследних.Номенклатура В(&Номенклатура)
			|
			|ИМЕЮЩИЕ
			|	МАКСИМУМ(смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки) >= 11";
			
			Запрос.УстановитьПараметр("Клиент", ЗаказКлиента.Партнер);
			Запрос.УстановитьПараметр("Номенклатура", ЗаказКлиента.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
			
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				ПроверятьЧернилаМарабу = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
			
		КонецЕсли;
		
		//2. проверяем на онлайн заказ
		Если ПроверятьЧернилаМарабу И ЗначениеЗаполнено(ЗаказКлиента.Ссылка) Тогда
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДополнительныеСведения.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|ГДЕ
			|	ДополнительныеСведения.Объект = &Объект
			|	И ДополнительныеСведения.Свойство.Имя = ""ОффлайнЗаказ""";
			
			Запрос.УстановитьПараметр("Объект", ЗаказКлиента.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И Выборка.Значение <> NULL И СокрЛП(Выборка.Значение) = "N" Тогда
				ПроверятьЧернилаМарабу = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
			
		КонецЕсли;
		
		//3. Проверяем номенклатуру
		Если ПроверятьЧернилаМарабу И ЗначениеЗаполнено(СегментЧернила) Тогда
			
			Для каждого стрТовары Из ЗаказКлиента.Товары Цикл
				
				Если НЕ СегментыСервер.ВходитВСегмент(стрТовары.Номенклатура, СегментЧернила) Тогда
					ПроверятьЧернилаМарабу = Ложь;
					Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			ПроверятьЧернилаМарабу = Ложь;
		КонецЕсли;
		
		Если ПроверятьЧернилаМарабу Тогда
			Результат = Новый Структура("Организация,Соглашение", ОрганизацияКовчег, СоглашениеКовчег);
			Возврат Результат;
		КонецЕсли;
		
	КонецЕсли;
	
	//2. Проверка оборудования Ковчег
	ПроверятьОборудованиеКовчег = Истина;
	
	Если НЕ Справочники.смартПредопределенныеЗначения.Настройки.ПроверятьЗаполнениеОрганизацииДляПродажиОборудованияКовчег Тогда
		ПроверятьОборудованиеКовчег = Ложь;
	КонецЕсли;
	
	Если ПроверятьОборудованиеКовчег И Пользователи.РолиДоступны("смартМенеджерБэкОфис") Тогда
		ПроверятьОборудованиеКовчег = Ложь;
	КонецЕсли;
	
	Если ПроверятьОборудованиеКовчег И ЗаказКлиента.Товары.Количество() = 0 Тогда
		ПроверятьОборудованиеКовчег = Ложь;
	КонецЕсли;
	
	СегментОборудование = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("СегментНоменклатурыОборудованиеПродажаКовчег");
	Если ПроверятьОборудованиеКовчег И ЗначениеЗаполнено(СегментОборудование) Тогда
		
		ЕстьОборудование = Ложь;
		Для каждого стрТовары Из ЗаказКлиента.Товары Цикл
					
			Если СегментыСервер.ВходитВСегмент(стрТовары.Номенклатура, СегментОборудование) Тогда
				ЕстьОборудование = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ПроверятьОборудованиеКовчег = ЕстьОборудование;
		
	Иначе
		ПроверятьОборудованиеКовчег = Ложь;
	КонецЕсли;
	
	Если ПроверятьОборудованиеКовчег Тогда
		
		ОрганизацияСмарт = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
		СоглашениеСмарт = Справочники.смартПредопределенныеЗначения.Настройки.СоглашениеСмартТиповоеРублиСДоговором;
		
		ОрганизацияКовчег = Справочники.смартПредопределенныеЗначения.Настройки.ОрганизацияКовчег;
		СоглашениеКовчег = Справочники.смартПредопределенныеЗначения.Настройки.СоглашениеКовчегТиповоеРублиСДоговором;
		
		//0. Проверяем на оплату
		Если ЗначениеЗаполнено(ЗаказКлиента.Ссылка) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты
			|ИЗ
			|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
			|ГДЕ
			|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
			
			Запрос.УстановитьПараметр("Заказ", ЗаказКлиента.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И Выборка.СуммаОплаты > 0 Тогда
				ПроверятьОборудованиеКовчег = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ЗаказКлиента.Организация, ЗаказКлиента.Соглашение);
			Конецесли;
			
		КонецЕсли;
		
		//1. Проверяем партнеров
		Если ПроверятьОборудованиеКовчег И Справочники.смартПредопределенныеЗначения.Настройки.ПартнерыИсключенияИзПроверкиПродажКовчега.Найти(ЗаказКлиента.Партнер) <> Неопределено Тогда
			ПроверятьОборудованиеКовчег = Ложь;
			Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
		КонецЕсли;
		
		Если ПроверятьОборудованиеКовчег И 
			 Справочники.смартПредопределенныеЗначения.Настройки.ПроверятьПартнераНаПринадлежностьКДилерамПриПродажеОборудованияКовчег И 
			 ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.Настройки.СегментПартнеровДилеры) Тогда
			 
			Если СегментыСервер.ВходитВСегмент(ЗаказКлиента.Партнер, Справочники.смартПредопределенныеЗначения.Настройки.СегментПартнеровДилеры) Тогда
				ПроверятьОборудованиеКовчег = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПроверятьОборудованиеКовчег И 
			 Справочники.смартПредопределенныеЗначения.Настройки.ПроверятьНаПринадлежностьКЛизинговойКомпании Тогда
			 
			Если ЗаказКлиента.Контрагент.смартЛизинговаяКомпания Тогда
				ПроверятьОборудованиеКовчег = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
			
		КонецЕсли;
		
		//2. проверяем на онлайн заказ
		Если ПроверятьОборудованиеКовчег И ЗначениеЗаполнено(ЗаказКлиента.Ссылка) Тогда
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ДополнительныеСведения.Значение КАК Значение
			|ИЗ
			|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
			|ГДЕ
			|	ДополнительныеСведения.Объект = &Объект
			|	И ДополнительныеСведения.Свойство.Имя = ""ОффлайнЗаказ""";
			
			Запрос.УстановитьПараметр("Объект", ЗаказКлиента.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() И Выборка.Значение <> NULL И СокрЛП(Выборка.Значение) = "N" Тогда
				ПроверятьОборудованиеКовчег = Ложь;
				Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
			КонецЕсли;
			
		КонецЕсли;
		
		//3. Проверяем номенклатуру
		Если ПроверятьОборудованиеКовчег И ЗначениеЗаполнено(СегментОборудование) Тогда
			
			НоменклатураСегмента = Новый Массив;
			Для каждого стрТовары Из ЗаказКлиента.Товары Цикл
				
				Если СегментыСервер.ВходитВСегмент(стрТовары.Номенклатура, СегментОборудование) Тогда
					ПроверятьОборудованиеКовчег = Ложь;
					Результат = Новый Структура("Организация,Соглашение", ОрганизацияКовчег, СоглашениеКовчег);
					НоменклатураСегмента.Добавить(стрТовары.Номенклатура);
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ ПроверятьОборудованиеКовчег Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ
				|	СУММА(ВЫБОР
				|			КОГДА ТоварыНаСкладахОстатки.Склад = &СкладАтлант
				|				ТОГДА ТоварыНаСкладахОстатки.ВНаличииОстаток
				|			ИНАЧЕ 0
				|		КОНЕЦ) КАК ОстатокНаАтланте,
				|	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК ОстатокВсего,
				|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура
				|ИЗ
				|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура В (&Номенклатура)) КАК ТоварыНаСкладахОстатки
				|
				|СГРУППИРОВАТЬ ПО
				|	ТоварыНаСкладахОстатки.Номенклатура";
				
				Запрос.УстановитьПараметр("Номенклатура", НоменклатураСегмента);
				Запрос.УстановитьПараметр("СкладАтлант", смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("СкладАтлант"));
				
				ВыборкаНоменклатура = Запрос.Выполнить().Выбрать();
				Пока ВыборкаНоменклатура.Следующий() Цикл
					
					Если ВыборкаНоменклатура.ОстатокнаАтланте = ВыборкаНоменклатура.ОстатокВсего Тогда
						//остаток только на Атланте
						Результат = Новый Структура("Организация,Соглашение", ОрганизацияСмарт, СоглашениеСмарт);
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПодписьДокументов
// Смарт Фролов+
//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
//Функция ЕстьВозможностьПодписатьДокумент(Ссылка,Заказ,СчетФактура)Экспорт
//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
//Функция ЕстьВозможностьПодписатьДокумент(Ссылка, Заказ, СчетФактура, Подписавший = Неопределено) Экспорт
Функция ЕстьВозможностьПодписатьДокумент(Ссылка, Заказ, СчетФактура, Подписавший = Неопределено, ПодписанаТН = Ложь) Экспорт
//-- #Б-4672 смарт: Фролов 22.10.2025
//-- смарт:ММ 02.09.2020
	ДанныеВозврата=Новый Структура("Результат,Ошибки",Истина,Новый Массив);
	Если Не Ссылка.Проведен Тогда
		ДанныеВозврата.Результат=Ложь;
		ДанныеВозврата.Ошибки.Добавить("Документ "+Ссылка+" не проведен.");
	КонецЕсли;	
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	//Если Заказ.Пустая() Тогда 
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
	//-- смарт:ММ 02.09.2020
		ДанныеВозврата.Результат=Ложь;
		ДанныеВозврата.Ошибки.Добавить("Нет заказа клиента.");
	КонецЕсли;
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	Если ЗначениеЗаполнено(Заказ) Тогда
	//-- смарт:ММ 02.09.2020
	Если Не Заказ.Проведен Тогда 
		ДанныеВозврата.Результат=Ложь;
		ДанныеВозврата.Ошибки.Добавить("Заказ клиента "+Заказ+" не проведен.");
	КонецЕсли;
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	КонецЕсли;
	//-- смарт:ММ 02.09.2020 
	
	//++ #Б-1208 смарт: Мосолов 25.10.2024 //Не проверять наличие выписанной СЧФ в документе реализация, если продажа от СМАРТ-ТЕКСТИЛЬ  
	Если НЕ (ЗначениеЗаполнено(Ссылка.Организация) И Ссылка.Организация.ИНН = "9701053617") Тогда 
	//++ #Б-1208 смарт: Мосолов 25.10.2024        
			
		Если СчетФактура=Неопределено Или СчетФактура.Пустая() Тогда 
			ДанныеВозврата.Результат=Ложь;
			ДанныеВозврата.Ошибки.Добавить("Не выставлен счет фактура.");
		КонецЕсли;
		Если СчетФактура=Неопределено Или Не СчетФактура.Проведен Тогда 
			ДанныеВозврата.Результат=Ложь;
			ДанныеВозврата.Ошибки.Добавить("Счет фактура выданный "+СчетФактура+" не проведен.");
		КонецЕсли;
		
	//++ #Б-1208 смарт: Мосолов 25.10.2024 //Не проверять наличие выписанной СЧФ в документе реализация, если продажа от СМАРТ-ТЕКСТИЛЬ  
	КонецЕсли;
	//++ #Б-1208 смарт: Мосолов 25.10.2024        
	
	//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
	Если НЕ ПодписанаТН Тогда
	
		Если ДанныеВозврата.Результат Тогда 
			УстановитьДокументПодписан(Ссылка,Заказ,Истина);
			//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
			//УстановитьПодписавшегоДокумент(Ссылка,Истина);
			УстановитьПодписавшегоДокумент(Ссылка, Истина, Подписавший);
			//-- смарт:ММ 02.09.2020
			ДанныеВозврата.Вставить("ОтветственныйЗаПодпись",Пользователи.ТекущийПользователь());
		КонецЕсли;
		
	Иначе
		
		ДанныеВозврата.Вставить("ОтветственныйЗаПодпись",Пользователи.ТекущийПользователь());
	
	КонецЕсли;
	//-- #Б-4672 смарт: Фролов 22.10.2025
	
	Возврат ДанныеВозврата; 
КонецФункции

//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
//Процедура УстановитьПодписавшегоДокумент(Ссылка,Подписан)Экспорт
Процедура УстановитьПодписавшегоДокумент(Ссылка, Подписан, Подписавший)Экспорт
//-- смарт:ММ 02.09.2020
	МЗ=РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МЗ.Объект=Ссылка;
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	//МЗ.Значение=?(Подписан,Пользователи.ТекущийПользователь(),Неопределено);
	Если НЕ ЗначениеЗаполнено(Подписавший) Тогда
		Подписавший = Пользователи.ТекущийПользователь();
	КонецЕсли;
	
	МЗ.Значение = ?(Подписан, Подписавший, Неопределено);
	//-- смарт:ММ 02.09.2020
	
	МЗ.Свойство=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ПодписавшийДокумент");
	
	УстановитьПривилегированныйРежим(Истина);
	МЗ.Записать();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ПолучитьДанныеПодписаногоДокумента(Ссылка,Свойство)Экспорт 
	Запрос=Новый Запрос("Выбрать Первые 1 Значение ИЗ РегистрСведений.ДополнительныеСведения ГДЕ Объект=&Ссылка И Свойство.Имя=&Свойство");
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("Свойство",Свойство);
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.Значение;
	КонецЕсли;	
	Возврат Неопределено;
КонецФункции

Процедура УстановитьДокументПодписан(Реализация,Заказ,Подписан)Экспорт 
	МЗ=РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МЗ.Объект=Реализация;
	МЗ.Свойство=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","Подписан");
	МЗ.Значение=Подписан;
	
	//++ #1650 смарт: Шляпников 17.09.2024 / Отметка "Оригиналы документов получены" (Заказ клиента) при частичной отгрузке (1650)
	УстановитьПривилегированныйРежим(Истина); 
	МЗ.Записать();
	//-- #1650 смарт: Шляпников 17.09.2024
		
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	Если ЗначениеЗаполнено(Заказ) Тогда
		//-- смарт:ММ 02.09.2020
		
		//++ #1650 смарт: Шляпников 17.09.2024 / Отметка "Оригиналы документов получены" (Заказ клиента) при частичной отгрузке (1650)
		РегистрыСведений.СостоянияЗаказовКлиентов.ОтразитьСостояниеЗаказа(Заказ, Ложь);
		//-- #1650 смарт: Шляпников 17.09.2024
		
	КонецЕсли;
	//-- смарт:ММ 02.09.2020

	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ПолучитьИмяФайлаДляБуфераОбмена(Заказ,СчетФактура)Экспорт 
	Если ЗначениеЗаполнено(СчетФактура) Тогда 
		ИмяКонтрагента=Лев(СокрЛП(СтрЗаменить(СчетФактура.Контрагент.Наименование,"ООО","")),100);
		Возврат "СФ "+СчетФактура.Номер+" "+Формат(СчетФактура.Дата,"ДЛФ=D")+" (Счет "+Заказ.Номер+" "+Формат(Заказ.Дата,"ДЛФ=D")+") "+ИмяКонтрагента;
	КонецЕсли;
	Возврат "";
КонецФункции

//++ #Б-4672 смарт: Фролов 15.10.2025 //Контроль возврата УПД с подписью клиента
Функция ПолучитьИмяФайлаТНДляБуфераОбмена(Заказ, СчетФактура) Экспорт 
	
	Если ЗначениеЗаполнено(СчетФактура) Тогда 
		
		ИмяКонтрагента = Лев(СокрЛП(СтрЗаменить(СчетФактура. Контрагент.Наименование, "ООО", "")), 100);
		Возврат "ТН " + СчетФактура.Номер + " " + Формат(СчетФактура.Дата,"ДЛФ=D") + " (Счет " + Заказ.Номер + " " + Формат(Заказ.Дата,"ДЛФ=D") + ") " + ИмяКонтрагента;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции //-- #Б-4672 смарт: Фролов 15.10.2025

Процедура ИзменитьДополнительноеСвойство(Ссылка,ИмяСвойства,Значение)Экспорт  
	
	//++ смарт:ММ #096 221 19.02.2021 Доработка Приобретения ТиУ
	Если ((ИмяСвойства = "смартДопРасходыВнесены" И Значение = Истина) 
		ИЛИ ИмяСвойства = "смартОтветственныйЗаДопРасходы")
		И НЕ Ссылка.Проведен Тогда
		Если ИмяСвойства = "смартДопРасходыВнесены" Тогда
			ИмяСвойстваТекст = "Доп. расходы внесены";
		Иначе
			ИмяСвойстваТекст = "Ответственный за доп. расходы";
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю("Изменение свойства """ + ИмяСвойстваТекст + """ невозможно: документ " + Ссылка + " не проведен.");
		Возврат;
	КонецЕсли;	
	//-- смарт:ММ 19.02.2021
	
	МЗ=РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МЗ.Объект=Ссылка;
	МЗ.Свойство=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя",ИмяСвойства);
	МЗ.Значение=Значение;
	
	УстановитьПривилегированныйРежим(Истина);
	МЗ.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Регистрируем документ Поступление товаров на склад к обмену
	Если Значение=Истина И ИмяСвойства="смартДопРасходыВнесены"
		И ТипЗнч(Ссылка)=Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда 
		
		ЗарегестрироватьПоступлениеТоваровНаСкладКОбмену(Ссылка);
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗарегестрироватьПоступлениеТоваровНаСкладКОбмену(Распоряжение)Экспорт 
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжение",Распоряжение);
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ПТУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПТУ.Распоряжение КАК Распоряжение,
	|	ПоступлениеТоваровНаСклад.Ссылка КАК Перемещение,
	|	ДополнительныеСведения.Значение КАК Значение
	|ИЗ
	|	ПТУ КАК ПТУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО (ПТУ.Распоряжение = ДополнительныеСведения.Объект)
	|			И (ДополнительныеСведения.Свойство.Имя = ""смартДопРасходыВнесены"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровНаСклад КАК ПоступлениеТоваровНаСклад   
	|		ПО #СравнениеПоРаспоряжениюЗаказу
	|";
	
	//смарт++ Станчев (30.09.2020)
	//смарт+ В запросе при соединениях проверяются, из всего списка документов, два документа Приобретение товаров услуг и ПоступлениеТоваровНаСклад , они
	//       между собой не связаны напрямую вообще, а они связаны только косвенно через докумнета Закза Поставщику. 
	//       Поэтому сделал проверку на тип метаданных реквизита "Распоряжение" и в условии
	//       если это ДокументСсылка.ПриобретениеТоваровУслуг заменяю строку в запросе "#СравнениеПоРаспоряжениюЗаказу" на "(ПТУ.Распоряжение.ЗаказПоставщику = ПоступлениеТоваровНаСклад.Распоряжение)"
	//       в противном случаю вставляется строка "(ПТУ.Распоряжение = ПоступлениеТоваровНаСклад.Распоряжение)"
	Если ТипЗнч(Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
