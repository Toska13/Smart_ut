//++ #Б4004 смарт: Шляпников 20.08.2025 / Отчет Движения товаров на складах (Акимов) не выводится в приоритете
Функция ПолучитьПереопределениеОтчетаПоУмолчаниюДляПользователя(Отчет, КлючВарианта) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей.ВариантОтчетаПереопределеяемый КАК ВариантОтчета,
	|	смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей.ВариантОтчетаПереопределеяемый.КлючВарианта КАК КлючВарианта
	|ИЗ
	|	РегистрСведений.смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей КАК смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей
	|ГДЕ
	|	смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей.Отчет = &Отчет
	|	И смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей.Пользователь = &Пользователь
	|	И смартПереопределениеВариантовОтчетовПоУмолчаниюДляПользователей.ВариантОтчета.КлючВарианта = &КлючВарианта";
	
	Запрос.УстановитьПараметр("Отчет", Отчет);
	Запрос.УстановитьПараметр("КлючВарианта", КлючВарианта);
	Запрос.УстановитьПараметр("Пользователь", Пользователи.АвторизованныйПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() И Выборка.КлючВарианта <> NULL Тогда
		
		Результат = Новый Структура("КлючВарианта", Выборка.КлючВарианта);
		
		Возврат Результат;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

