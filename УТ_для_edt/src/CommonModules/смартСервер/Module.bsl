//++ #1836 смарт: Фролов 30.05.2024 //Доработка механизма Неудачного Завершения интереса.
Функция ПроверитьБылЛиИнтересКвалифицирован(Интерес) Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	CRM_СостоянияИнтересов.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания
	|ПОМЕСТИТЬ НомерКвалификации
	|ИЗ
	|	Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
	|ГДЕ
	|	CRM_СостоянияИнтересов.Родитель = &Родитель
	|	И CRM_СостоянияИнтересов.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.смартКвалификация)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CRM_СостоянияИнтересов.Ссылка КАК Квалификация
	|ПОМЕСТИТЬ КвалификацияИДалее
	|ИЗ
	|	Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НомерКвалификации КАК НомерКвалификации
	|		ПО (CRM_СостоянияИнтересов.РеквизитДопУпорядочивания >= НомерКвалификации.РеквизитДопУпорядочивания)
	|ГДЕ
	|	CRM_СостоянияИнтересов.Родитель = &Родитель
	|	И НЕ CRM_СостоянияИнтересов.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CRM_ИсторияСостоянийОбращений.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.CRM_ИсторияСостоянийОбращений КАК CRM_ИсторияСостоянийОбращений
	|ГДЕ
	|	CRM_ИсторияСостоянийОбращений.Обращение = &Интерес
	|	И CRM_ИсторияСостоянийОбращений.Состояние В
	|			(ВЫБРАТЬ
	|				КвалификацияИДалее.Квалификация
	|			ИЗ
	|				КвалификацияИДалее)");
	Запрос.УстановитьПараметр("Родитель", Интерес.СостояниеИнтереса.Родитель);
	Запрос.УстановитьПараметр("Интерес", Интерес);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //-- #1836 смарт: Фролов 30.05.2024

