//++ #1349 смарт: Фролов 03.05.2023 //Добавить оповещение при оплате 30% при поступлении оплаты. Продолжение задачи 1134  
Процедура ОтправитьПисьмоПоОплатеЗаказа(ЗаказКлиента) Экспорт 
	
	//++ #1812 смарт: Ермаков 30.05.2024 / Авторезервирование. Рефакторинг и доработка.
	// Переделал процедуру
	Если Не ( 
		ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") 
        И ЗаказКлиента.Проведен 
        И Не ЗаказКлиента.Статус = Перечисления.СостоянияЗаказовКлиентов.Закрыт) Тогда	
		
		Возврат;
		
	КонецЕсли;
	
	//++ #Б-7538 смарт: Фролов 20.07.2026 //Создать оповещение о поступлении ДС по определенному товару
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура
	|ПОМЕСТИТЬ НужнаяНоменклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&МассивГрупп)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
	|	И ЗаказКлиентаТовары.Номенклатура В
	|			(ВЫБРАТЬ
	|				НужнаяНоменклатура.Номенклатура
	|			ИЗ
	|				НужнаяНоменклатура)");
	Запрос.УстановитьПараметр("МассивГрупп", 
		Справочники.смартПредопределенныеЗначения.Настройки.ГруппыНоменклатурыIECHOДляОповещения.ВыгрузитьКолонку("ГруппаНоменклатуры"));
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
	
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
		
		МассивАдресовДляОтправки = Новый Массив;
		АдресаДляОтправкиСтрокой = "";
		
		МассивПользователей = Справочники.смартПредопределенныеЗначения.Настройки.ПользователиДляОповещенияОбОплатахIECHO.ВыгрузитьКолонку("Пользователь");
		
		Для Каждого Пользователь Из МассивПользователей Цикл
			
			МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
			
		КонецЦикла;
			
		ТекстПисьма = "";
		
		НавСсылка = ПолучитьНавигационнуюСсылку(ЗаказКлиента);
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			
			ТекстПисьма = ТекстПисьма + "Поступила оплата за однослойные раскройные комплексы iECHO, режущие плоттеры PK и PK4" + Символы.ПС;
			ТекстПисьма = ТекстПисьма + "по заказу клиента: " + ЗаказКлиента.Номер + " от " + ЗаказКлиента.Дата + Символы.ПС;
			ТекстПисьма = ТекстПисьма + "Навигационная ссылка на документ: " + НавСсылка + Символы.ПС + Символы.ПС + Символы.ПС;
			
			
			ДанныеОтправки = Новый Структура("Тема, Заголовок", "Поступила оплата за однослойные раскройные комплексы iECHO, режущие плоттеры PK и PK4", ТекстПисьма);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, , ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Исключение
				ТекстСообщения = "Не удалось отправить письмо о поступлению оплаты по iECHO"  + Символы.ПС + ОписаниеОшибки(); 
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;	
	//-- #Б-7538 смарт: Фролов 20.07.2026
	
	ПределПроцента = Справочники.смартПредопределенныеЗначения.ПроцентОплатыЗаказаДляИерархииПоОплате.Значение;
	ПределПроцента = ?(ПределПроцента = Неопределено, 0, ПределПроцента);
	
	СегментОборудование = 
		Справочники.СегментыНоменклатуры.НайтиПоРеквизиту(
			"смартИдентификаторДляФормул", "СегментАппаратноеОбеспечение");
	
	Если СегментОборудование.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Заказ", ЗаказКлиента); 	
	Запрос.УстановитьПараметр("ПределПроцента", ПределПроцента);
	Запрос.УстановитьПараметр("МассивСегмента", СегментыСервер.МассивЭлементов(СегментОборудование));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Заказ
	|ПОМЕСТИТЬ ЗаказыСОборудованием
	|ИЗ
	|	Документ.ЗаказКлиента.Товары
	|ГДЕ
	|	Ссылка = &Заказ
	|	И Номенклатура В (&МассивСегмента)
	|;
	|ВЫБРАТЬ
	|	Заказ,
	|	ПроцентОплаты
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов 
	|ГДЕ
	|	&Заказ В (ВЫБРАТЬ Заказ ИЗ ЗаказыСОборудованием)
	|	И Заказ = &Заказ 
	|	И ПроцентОплаты > 0 
	|	И ПроцентОплаты < &ПределПроцента";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
							
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ЭтоТестоваяБаза = Не смартОбщегоНазначения.смартРабочаяБаза();
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
	
	ТемаПисьма = "Предоплата по Заказу клиента менее " + ПределПроцента + "%.";
	
	АдресПолучателя = "larkov@smart-t.ru"; 
	
	МассивПолучателей = Новый Массив;
	МассивПолучателей.Добавить(Новый Структура("Адрес, Представление", АдресПолучателя, АдресПолучателя));

	ТекстПисьма = 
		"Проведена оплата по документу " 
		+ Строка(ЗаказКлиента) 
		+ ", предоплата составляет менее " 
		+ ПределПроцента 
		+ "%."
		+ Символы.ПС
		+ "Навигационная ссылка на документ: "
		+ ПолучитьНавигационнуюСсылку(ЗаказКлиента)
		+ ""
		+ Символы.ПС 
		+ смартСформироватьТекстПисьмаМеньшеПределаПроцента(ЗаказКлиента);		

	Если ТестовыеАдресаМассив.Количество() > 0
		Или (МассивПолучателей.Количество() > 0 И Не ЭтоТестоваяБаза) Тогда
				
		ДанныеОтправки = Новый Структура("Тема, Заголовок", ТемаПисьма, ТекстПисьма);
		
		ПараметрыПисьма = 
			смартОбщегоНазначения.ПолучитьПараметрыОтправки(
				МассивПолучателей, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		Попытка
			
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма); 
			
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				
				ТекстСообщения = 
					"Отправлено письмо, предупреждение о предоплате менее "
					+ ПределПроцента
					+ "% НА ТЕСТОВУЮ ПОЧТУ " 
					+ ПараметрыПисьма.ТестовыеАдреса 
					+ " (в рабочей базе отправилось бы на почту " 
					+ АдресПолучателя 
					+ ")";	
				
			Иначе
					
				ТекстСообщения = 
					"Отправлено письмо, предупреждение о предоплате менее "
					+ ПределПроцента
					+ "%" 
					+ АдресПолучателя;
				
			КонецЕсли;
				
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			
		Исключение
			
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма, ЗаказКлиента, ТекстПисьма);
			
			ТекстСообщения = 
				"Не удалось отправить письмо, предупреждение о предоплате менее "
				+ ПределПроцента 
				+ "%"
				+ Символы.ПС 
				+ ОписаниеОшибки(); 
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			
		КонецПопытки;
	КонецЕсли;	
	//-- #1812 смарт: Ермаков 30.05.2024	
	
КонецПроцедуры //-- #1349 смарт: Фролов 03.05.2023	

//++ #1355 смарт: Фролов 19.05.2023 //Добавить доп текст в оповещение при оплате и авторезерве в заказах, где оплата менее 30%. Продолжение задачи 1134
Функция смартСформироватьТекстПисьмаМеньшеПределаПроцента(Заказ) Экспорт
	ДополнениеПисьма=Символы.ПС+"Перечень товаров заказа:"+Символы.ПС+Символы.ПС; 
	НомПП=1;
	Для Каждого Стр Из Заказ.Товары Цикл
		ДополнениеПисьма=ДополнениеПисьма+НомПП+". "+Стр.Номенклатура+Символы.ПС;
		НомПП=НомПП+1;
	КонецЦикла;
	ДополнениеПисьма=ДополнениеПисьма+Символы.ПС+"Клиент: "+Заказ.Партнер+Символы.ПС;
	ДополнениеПисьма=ДополнениеПисьма+Символы.ПС+"Менеджер: "+Заказ.Менеджер+Символы.ПС; 
	Возврат ДополнениеПисьма;
КонецФункции	

