	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКонтрагенты КАК ВТКонтрагенты
	|		ПО ДоговорыКонтрагентов.Контрагент = ВТКонтрагенты.Контрагент
	|			И ДоговорыКонтрагентов.Партнер = ВТКонтрагенты.Партнер
	|ГДЕ
	|	ДоговорыКонтрагентов.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
	|	И НЕ ДоговорыКонтрагентов.Дата = ДАТАВРЕМЯ(1, 1, 1)
	|	И НЕ ДоговорыКонтрагентов.Номер = """"
	|	И ДоговорыКонтрагентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И ДоговорыКонтрагентов.смартДоговорПодписан
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПартнеры.Ссылка.ОсновнойМенеджер КАК Менеджер
	|ИЗ
	|	ВТПартнеры КАК ВТПартнеры
	|ГДЕ
	|	НЕ ВТПартнеры.Ссылка.ОсновнойМенеджер.Недействителен
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПартнеры.Ссылка.смартОсновнойМенеджерСервисЦентра
	|ИЗ
	|	ВТПартнеры КАК ВТПартнеры
	|ГДЕ
	|	НЕ ВТПартнеры.Ссылка.смартОсновнойМенеджерСервисЦентра.Недействителен
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПартнеры.Ссылка.смартМенеджерПоРасходнымМатериалам
	|ИЗ
	|	ВТПартнеры КАК ВТПартнеры
	|ГДЕ
	|	НЕ ВТПартнеры.Ссылка.смартМенеджерПоРасходнымМатериалам.Недействителен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТКонтрагенты.Контрагент КАК Контрагент,
	|	ВТКонтрагенты.Партнер КАК Партнер
	|ИЗ
	|	ВТКонтрагенты КАК ВТКонтрагенты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактныеЛицаПартнеров.Ссылка КАК КонтактноеЛицо,
	|	ВТПартнеры.Ссылка КАК Партнер
	|ИЗ
	|	ВТПартнеры КАК ВТПартнеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
	|		ПО ВТПартнеры.Ссылка = КонтактныеЛицаПартнеров.Владелец
	|ГДЕ
	|	НЕ КонтактныеЛицаПартнеров.смартИдентификаторБитрикс = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Заявки.Партнер КАК Партнер,
	|	Заявки.Номер КАК Номер,
	|	Заявки.Дата КАК Дата,
	|	ПРЕДСТАВЛЕНИЕ(Заявки.Статус) КАК СтатусПредставление,
	|	ТабОборудования.ОборудованиеКлиентов КАК ОборудованиеКлиентов,
	|	ТабОборудования.Оборудование КАК Номенклатура,
	|	ТабОборудования.Серия КАК Серия,
	|	ЕСТЬNULL(Заявки.НазначенныйНаРемонтИнженер.Наименование, """") КАК ИнженерНаименование,
	|	ЕСТЬNULL(Заявки.НазначенныйНаРемонтИнженер.смартРабочийТелефон, """") КАК ТелефонИнженера
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы КАК Заявки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПартнеры КАК ВТПартнеры
	|		ПО Заявки.Партнер = ВТПартнеры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРемонтныеРаботы.Оборудование КАК ТабОборудования
	|		ПО Заявки.Ссылка = ТабОборудования.Ссылка
	|			И (ТабОборудования.НомерСтроки = 1)
	|ГДЕ
	|	НЕ Заявки.ПометкаУдаления
	|	И НЕ Заявки.Статус В (&ТерминальныеСтатусы)
	|	И НЕ Заявки.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)";
	
	ТерминальныеСтатусы = Новый Массив;
	ТерминальныеСтатусы.Добавить(Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтЗавершен);
	ТерминальныеСтатусы.Добавить(Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтОсуществленПоТелефону);
	ТерминальныеСтатусы.Добавить(Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ЗаявкаАннулирована);
	ТерминальныеСтатусы.Добавить(Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ОшибочнаяЗаявка);
	
	Запрос.УстановитьПараметр("МассивПартнеров", МассивПартнеров);
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("ВидНоменклатуры", Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение);
	Запрос.УстановитьПараметр("ОрганизацияСмарт", Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение);
	Запрос.УстановитьПараметр("ТерминальныеСтатусы", ТерминальныеСтатусы);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ТаблицаЗаявок = Пакет[Пакет.Количество() - 1].Выгрузить();
	ТаблицаЗаявок.Колонки.Добавить("ПартнерВыгрузки");
	Для каждого стрЗаявка Из ТаблицаЗаявок Цикл
		Если ЗначениеЗаполнено(стрЗаявка.Партнер) Тогда
			стрЗаявка.ПартнерВыгрузки = ПолучитьПартнераВерхнегоУровня(стрЗаявка.Партнер);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Партнеры = МассивПартнеров;
	Результат.ЗаявкиНаРемонт = ТаблицаЗаявок;
	Результат.КонтактныеЛица = Пакет[Пакет.Количество() - 2].Выгрузить();
	Результат.Контрагенты = Пакет[Пакет.Количество() - 3].Выгрузить();
	Результат.Пользователи = Пакет[Пакет.Количество() - 4].Выгрузить().ВыгрузитьКолонку("Менеджер");
	Результат.Договоры = Пакет[Пакет.Количество() - 5].Выгрузить();
	Результат.Оборудование = Пакет[Пакет.Количество() - 6].Выгрузить();
	Результат.Взаиморасчеты = Пакет[Пакет.Количество() - 7].Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Процедура ВыгрузитьДанныеВБитрикс() Экспорт
	
	МассивУзлов = смартОбщегоНазначенияСКэш.ПолучитьМассивУзловОбменаБитрикс();
	МассивПартнеров = Новый Массив;
	МассивАкций = Новый Массив;
	
	Для каждого Узел Из МассивУзлов Цикл
		
		КоличествоВВыгрузке = Узел.КоличествоПартнеровВПакете;
		Если КоличествоВВыгрузке = 0 Тогда
			КоличествоВВыгрузке = 10;
		КонецЕсли;
		
		Выборка = ПланыОбмена.ВыбратьИзменения(Узел, Узел.НомерОтправленного + 1);
		Пока Выборка.Следующий() Цикл
			
			ТекущийОбъект = Выборка.Получить();
			Если ТипЗнч(ТекущийОбъект) = Тип("СправочникОбъект.Партнеры") Тогда
				МассивПартнеров.Добавить(ТекущийОбъект.Ссылка);
			ИначеЕсли ТипЗнч(ТекущийОбъект) = Тип("ДокументОбъект.смартУправлениеАкциями") Тогда
				МассивАкций.Добавить(ТекущийОбъект.Ссылка);
			КонецЕсли;
			
			Если МассивПартнеров.Количество() = КоличествоВВыгрузке Тогда
				СформироватьПакетПоМассивуПартнеровИВыгрузитьВбитрикс(Узел, МассивПартнеров);
				МассивПартнеров.Очистить();
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивПартнеров.Количество() > 0 Тогда
			СформироватьПакетПоМассивуПартнеровИВыгрузитьВбитрикс(Узел, МассивПартнеров);
			МассивПартнеров.Очистить();
		КонецЕсли;
		
		Если МассивАкций.Количество() > 0 Тогда
			СформироватьПакетПоМассивуАкцийИВыгрузитьВбитрикс(Узел, МассивАкций);
			МассивАкций.Очистить();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ПолучитьПартнераВерхнегоУровня(Партнер)
	
	Если Партнер.Родитель.Пустая() Тогда
		Возврат Партнер;
	КонецЕсли;
	
	Возврат ПолучитьПартнераВерхнегоУровня(Партнер.Родитель);
	
КонецФункции

Функция ПолучитьДанныеСкладаДляВыгрузкиВБитрикс(Склад) Экспорт
	
	Результат = Новый Структура("Склад,ВыгружатьНаСайт,НаименованиеНаСайте,АдресНаСайте,Наименование");
	
	Если ЗначениеЗаполнено(Склад) И ТипЗнч(Склад) = Тип("СправочникСсылка.Склады") И Склад.ЭтоГруппа Тогда
		
		Результат.Склад = Склад;
		Результат.ВыгружатьНаСайт = Склад.смартВыгружатьНаСайт;
		Результат.НаименованиеНаСайте = Склад.смартНаименованиеНаСайте;
		Результат.АдресНаСайте = Склад.смартАдресНаСайте;
		Результат.Наименование = Склад.Наименование;
		
	Иначе
	
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СкладысмартСкладыОстатковДляСайта.Ссылка КАК Склад,
		|	СкладысмартСкладыОстатковДляСайта.Ссылка.смартВыгружатьНаСайт КАК ВыгружатьНаСайт,
		|	СкладысмартСкладыОстатковДляСайта.Ссылка.смартНаименованиеНаСайте КАК НаименованиеНаСайте,
		|	СкладысмартСкладыОстатковДляСайта.Ссылка.смартАдресНаСайте КАК АдресНаСайте,
		|	СкладысмартСкладыОстатковДляСайта.Ссылка.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Склады.смартСкладыОстатковДляСайта КАК СкладысмартСкладыОстатковДляСайта
		|ГДЕ
		|	СкладысмартСкладыОстатковДляСайта.Склад = &Склад";
		
		Запрос.УстановитьПараметр("Склад", Склад);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаполнитьЗначенияСвойств(Результат, Выборка);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьПакетПоМассивуПартнеровИВыгрузитьВбитрикс(Узел, МассивПартнеров)
	
	ДанныеДляВыгрузки = СформироватьДанныеДляВыгрузкиВБитрикс(МассивПартнеров, Узел);
		
	Результат = ПередатьПакетВБитрикс(Узел, ДанныеДляВыгрузки.Пользователи, "Пользователи", ДанныеДляВыгрузки);
	Если НЕ Результат = Истина Тогда
		ЗаписьЖурналаРегистрации("смартОбменССайтомБитриксСервер.ВыгрузкаПользователей", УровеньЖурналаРегистрации.Ошибка,,, Результат);
		Сообщить(Результат);
		Возврат;
	КонецЕсли;
	
	Результат = ПередатьПакетВБитрикс(Узел, ДанныеДляВыгрузки.Партнеры, "Партнеры", ДанныеДляВыгрузки);
	Если НЕ Результат = Истина Тогда
		ЗаписьЖурналаРегистрации("смартОбменССайтомБитриксСервер.ВыгрузкаПартнеров", УровеньЖурналаРегистрации.Ошибка,,, Результат);
		Сообщить(Результат);
		Возврат;
	КонецЕсли;
	
	Если МассивПартнеров.Количество() > 0 Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, МассивПартнеров);
	КонецЕсли;
		
КонецПроцедуры

Процедура СформироватьПакетПоМассивуАкцийИВыгрузитьВбитрикс(Узел, МассивАкций)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение);
	Отбор.Вставить("ВозвращатьАкцииБудущего", Истина);
	
	ДанныеДляВыгрузки = смартАкцииИСкидки.ПолучитьДействующиеАкции(ТекущаяДата(), Отбор);
		
	Результат = ПередатьПакетВБитрикс(Узел, ДанныеДляВыгрузки, "Акции", ДанныеДляВыгрузки);
	Если НЕ Результат = Истина Тогда
		ЗаписьЖурналаРегистрации("смартОбменССайтомБитриксСервер.ВыгрузкаАкций", УровеньЖурналаРегистрации.Ошибка,,, Результат);
		Сообщить(Результат);
		Возврат;
	КонецЕсли;
	
	Если МассивАкций.Количество() > 0 Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, МассивАкций);
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьТекущийСтатусЗаказаКлиентаНаСайте(ЗаказКлиента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СмартСтатусыЗаказовБитрикс.СтатусЗаказа КАК СтатусЗаказа
	|ИЗ
	|	РегистрСведений.СмартСтатусыЗаказовБитрикс КАК СмартСтатусыЗаказовБитрикс
	|ГДЕ
	|	СмартСтатусыЗаказовБитрикс.ГУИД = &ГУИД
	|	И СмартСтатусыЗаказовБитрикс.СсылкаМет = &СсылкаМет";
	
	Запрос.УстановитьПараметр("ГУИД", СокрЛП(ЗаказКлиента.УникальныйИдентификатор()));
	Запрос.УстановитьПараметр("СсылкаМет", ЗаказКлиента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.СтатусЗаказа <> NULL Тогда
		Возврат Выборка.СтатусЗаказа;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПередатьНаСайтОтклонениеРегистрацииПользователя(ИДПользователя) Экспорт
	
	МассивОшибок = Новый Массив;
	
	МассивУзлов = ПолучитьМассивУзловОбменаБитрикс();
	
	Для каждого Узел Из МассивУзлов Цикл
		
		ДанныеПодключения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел, "АдресСайта,Логин,Пароль");
		
		АдресВнутри = "rest-api/v1/contacts/reject/";
		
		ДанныеJSON = смартОбщегоНазначения.ЗначениеВJSON(Новый Структура("userId", ИДПользователя));
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type",  "application/json");
		
		Результат = смартИнтеграцияDaData.ВыполнитьPOSTЗапрос(ДанныеПодключения.АдресСайта, АдресВнутри, 443, ДанныеПодключения.Логин, ДанныеПодключения.Пароль,,, Новый ЗащищенноеСоединениеOpenSSL(), Заголовки, ДанныеJSON);
		
		Если Результат <> Неопределено И НЕ Результат.КодСостояния = 200 Тогда
			МассивОшибок.Добавить(Результат.ПолучитьТелоКакСтроку());
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивОшибок, Символы.ПС);
	
КонецФункции

#КонецОбласти
