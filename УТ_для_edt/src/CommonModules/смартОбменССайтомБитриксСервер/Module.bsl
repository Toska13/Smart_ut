#Область Регистрация

Процедура смартПередЗаписьюОбъектаОбменССайтомБитриксПередЗаписью(Источник, Отказ) Экспорт
	
	Если Источник.Ссылка.Пустая() Тогда
		Источник.ДополнительныеСвойства.Вставить("ЗаписьНовогоОбъекта", Истина);
	Иначе
		
		Если ТипЗнч(Источник) = Тип("СправочникОбъект.Контрагенты") Тогда
			
			Если Источник.Ссылка.Партнер <> Источник.Партнер Тогда
				Источник.ДополнительныеСвойства.Вставить("СменаПартнера", Источник.Ссылка.Партнер);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.КонтактныеЛицаПартнеров") Тогда
			
			Если Источник.Ссылка.Владелец <> Источник.Владелец Тогда
				Источник.ДополнительныеСвойства.Вставить("СменаПартнера", Источник.Ссылка.Владелец);
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.Партнеры") Тогда
			
			Если Источник.Ссылка.Родитель <> Источник.Родитель Тогда
				Источник.ДополнительныеСвойства.Вставить("СменаПартнера", Источник.Ссылка.Родитель);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура смартПриЗаписиОбъектаОбменССайтомБитриксПриЗаписи(Источник, Отказ) Экспорт
	
	МассивУзлов = смартОбщегоНазначенияСКэш.ПолучитьМассивУзловОбменаБитрикс();
	
	Если МассивУзлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("СправочникОбъект.Контрагенты") Тогда
			
		Если Источник.ДополнительныеСвойства.Свойство("СменаПартнера") Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.ДополнительныеСвойства.СменаПартнера));
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.Партнер));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.КонтактныеЛицаПартнеров") Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("СменаПартнера") Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.ДополнительныеСвойства.СменаПартнера));
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.Владелец));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.Партнеры") Тогда
		
		Если Источник.ДополнительныеСвойства.Свойство("СменаПартнера") Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.ДополнительныеСвойства.СменаПартнера));
		КонецЕсли;
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.Ссылка));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.Партнер));
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.смартУправлениеАкциями") Тогда
		
		Если Источник.Статус = Перечисления.смартСтатусыАкций.Действует И (Источник.ДатаОкончанияАкции = Дата(1, 1, 1) ИЛИ КонецДня(Источник.ДатаОкончанияАкции) >= ТекущаяДата()) Тогда
			
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, Источник.Ссылка);
			
			МассивУсзловБ = Б_ОбменССайтомСервер.ПолучениеОбщегоМассиваУзлов();
			МассивТоваров = Источник.Товары.ВыгрузитьКолонку("Номенклатура");
			
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУсзловБ, МассивТоваров);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		Если ЗначениеЗаполнено(Источник.Партнер) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(Источник.Партнер));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура смартПриЗаписиРегистраОбменССайтомБитриксПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	МассивУзлов = смартОбщегоНазначенияСКэш.ПолучитьМассивУзловОбменаБитрикс();
	
	Если МассивУзлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.смартИндивидуальныеСкидкиКлиентов") Тогда
		
		ТаблицаПартнеров = Источник.Выгрузить(, "Клиент");
		ТаблицаПартнеров.Свернуть("Клиент");
		
		Для каждого стрПартнер Из ТаблицаПартнеров Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(стрПартнер.Клиент));
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.РасчетыСКлиентами") Тогда
		
		ТаблицаПартнеров = Новый ТаблицаЗначений;
		ТаблицаПартнеров.Колонки.Добавить("Клиент");
		
		Для каждого стрИсточник Из Источник Цикл
			
			НоваяСтрока = ТаблицаПартнеров.Добавить();
			НоваяСтрока.Клиент = стрИсточник.АналитикаУчетаПоПартнерам.Партнер;
			
		КонецЦикла;
		
		ТаблицаПартнеров.Свернуть("Клиент");
		
		Для каждого стрПартнер Из ТаблицаПартнеров Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, ПолучитьПартнераВерхнегоУровня(стрПартнер.Клиент));
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ВыручкаИСебестоимостьПродаж") Тогда
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьМассивУзловОбменаБитрикс() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартНастройкиОбменаССайтомБитрикс.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.смартНастройкиОбменаССайтомБитрикс КАК смартНастройкиОбменаССайтомБитрикс
	|ГДЕ
	|	НЕ смартНастройкиОбменаССайтомБитрикс.ПометкаУдаления
	|	И НЕ смартНастройкиОбменаССайтомБитрикс.ЭтотУзел";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

