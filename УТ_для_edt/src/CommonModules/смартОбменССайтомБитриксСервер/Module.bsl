Функция ЗаполнитьСущностьКонтактПоКонтактномуЛицу(Сущность, КонтактноеЛицо) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактныеЛицаПартнеров.смартИдентификаторБитрикс КАК смартИдентификаторБитрикс,
	|	КонтактныеЛицаПартнеров.смартАктивностьНаСайте КАК смартАктивностьНаСайте,
	|	КонтактныеЛицаПартнеров.Владелец КАК Партнер,
	|	КонтактныеЛицаПартнеров.Владелец.Родитель КАК ПартнерРодитель,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(КонтактныеЛицаПартнеров.Ссылка) КАК Идентификатор,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(КонтактныеЛицаПартнеров.Владелец) КАК ИдентификаторПартнера
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
	|ГДЕ
	|	КонтактныеЛицаПартнеров.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", КонтактноеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Сущность.id = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Выборка.смартИдентификаторБитрикс);
		Сущность.xmlId = СокрЛП(Выборка.Идентификатор);
		Если НЕ ЗначениеЗаполнено(Выборка.ПартнерРодитель) Тогда
			Сущность.partnerXmlId = СокрЛП(Выборка.Партнер.УникальныйИдентификатор());
		Иначе
			Сущность.partnerXmlId = СокрЛП(ПолучитьПартнераВерхнегоУровня(Выборка.ПартнерРодитель).УникальныйИдентификатор());
		КонецЕсли;
		Сущность.active = ?(Выборка.смартАктивностьНаСайте, "Y", "N");
		
	КонецЕсли;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьКонтрагентПоКонтрагенту(Сущность, Контрагент, ДанныеДляВыгрузки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Контрагенты.Ссылка) КАК xmlId,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Контрагенты.Партнер) КАК partnerXmlId,
	|	Контрагенты.Партнер.Родитель КАК ПартнерРодитель,
	|	Контрагенты.ЮридическоеФизическоеЛицо КАК ЮридическоеФизическоеЛицо,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП,
	|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
	|	Контрагенты.КонтактнаяИнформация.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Тип КАК Тип,
	|		Вид КАК Вид,
	|		Представление КАК Представление,
	|		ЗначенияПолей КАК ЗначенияПолей,
	|		Страна КАК Страна,
	|		Регион КАК Регион,
	|		Город КАК Город,
	|		АдресЭП КАК АдресЭП,
	|		ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|		НомерТелефона КАК НомерТелефона,
	|		НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|		ВидДляСписка КАК ВидДляСписка,
	|		ДействуетС КАК ДействуетС,
	|		Значение КАК Значение
	|	) КАК КонтактнаяИнформация,
	|	Контрагенты.ЮрФизЛицо КАК ЮрФизЛицо
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Сущность.xmlId = СокрЛП(Выборка.xmlId);
		Если НЕ ЗначениеЗаполнено(Выборка.ПартнерРодитель) Тогда
			Сущность.partnerXmlId = СокрЛП(Выборка.partnerXmlId);
		Иначе
			Сущность.partnerXmlId = СокрЛП(ПолучитьПартнераВерхнегоУровня(Выборка.ПартнерРодитель).УникальныйИдентификатор());
		КонецЕсли;
		
		Если Выборка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда
			Сущность.clientType = "ИП";
		ИначеЕсли Выборка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			Сущность.clientType = "Физическое лицо";
		ИначеЕсли Выборка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Сущность.clientType = "Юридическое лицо";
		Иначе
			Сущность.clientType = СокрЛП(Выборка.ЮридическоеФизическоеЛицо);
		КонецЕсли;
		
		Сущность.ogrn = "";
		Сущность.inn = СокрЛП(Выборка.ИНН);
		Сущность.kpp = СокрЛП(Выборка.КПП);
		Сущность.name = СокрЛП(Выборка.НаименованиеПолное);
		Сущность.active = "Y";
		
		ВыборкаКонтакт = Выборка.КонтактнаяИнформация.Выбрать();
		Пока ВыборкаКонтакт.Следующий() Цикл
			
			Если ВыборкаКонтакт.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И ЗначениеЗаполнено(ВыборкаКонтакт.АдресЭП) Тогда
				Сущность.email = ВыборкаКонтакт.АдресЭП;
			ИначеЕсли ВыборкаКонтакт.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон И ЗначениеЗаполнено(ВыборкаКонтакт.НомерТелефона) Тогда
				Сущность.phone = ВыборкаКонтакт.НомерТелефона;
			ИначеЕсли ВыборкаКонтакт.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента И ЗначениеЗаполнено(ВыборкаКонтакт.Представление) Тогда
				Сущность.legalAddress = ВыборкаКонтакт.Представление;
			КонецЕсли;
			
		КонецЦикла;
		
		//договоры
		НайденныеСтроки = ДанныеДляВыгрузки.Договоры.НайтиСтроки(Новый Структура("Партнер,Контрагент", Контрагент.Партнер, Контрагент));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			СущностьДоговор = СоздатьСущностьДоговор();
			ЗаполнитьСущностьДоговорПоДоговору(СущностьДоговор, стрНайденныеСтроки.Договор);
			Сущность.contracts.Добавить(СущностьДоговор);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьПартнерПоПартнеру(СущностьПартнер, Партнер, ДанныеДляВыгрузки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Партнеры.Ссылка) КАК Ссылка,
	|	Партнеры.Наименование КАК Наименование,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Партнеры.смартМенеджерПоРасходнымМатериалам) КАК consumablesManagerXmlId,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Партнеры.смартОсновнойМенеджерСервисЦентра) КАК serviceCenterManagerXmlId,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Партнеры.ОсновнойМенеджер) КАК mainManagerXmlId
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(смартИндивидуальныеСкидкиКлиентовСрезПоследних.Номенклатура) КАК productXmlId,
	|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки КАК discount
	|ИЗ
	|	РегистрСведений.смартИндивидуальныеСкидкиКлиентов.СрезПоследних(, Клиент = &Ссылка) КАК смартИндивидуальныеСкидкиКлиентовСрезПоследних";
	
	Запрос.УстановитьПараметр("Ссылка", Партнер);
	
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СущностьПартнер.xmlId = СокрЛП(Выборка.Ссылка);
		СущностьПартнер.description = СокрЛП(Выборка.Наименование);
		СущностьПартнер.active = "Y";
		СущностьПартнер.mainManagerXmlId = СокрЛП(Выборка.mainManagerXmlId);
		СущностьПартнер.serviceCenterManagerXmlId = СокрЛП(Выборка.serviceCenterManagerXmlId);
		СущностьПартнер.consumablesManagerXmlId = СокрЛП(Выборка.consumablesManagerXmlId);
		
		ВыборкаСкидок = Пакет[1].Выбрать();
		Пока ВыборкаСкидок.Следующий() Цикл
			
			СущностьСкидка = СоздатьСущностьИндивидуальнаяСкидка();
			СущностьСкидка.productXmlId = СокрЛП(ВыборкаСкидок.productXmlId);
			СущностьСкидка.discount = ВыборкаСкидок.discount;
			СущностьПартнер.discounts.Добавить(СущностьСкидка);
			
		КонецЦикла;
		
		//контактные лица
		НайденныеСтроки = ДанныеДляВыгрузки.КонтактныеЛица.НайтиСтроки(Новый Структура("Партнер", Партнер));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			Сущность = СоздатьСущностьКонтакт();
			ЗаполнитьСущностьКонтактПоКонтактномуЛицу(Сущность, стрНайденныеСтроки.КонтактноеЛицо);
			СущностьПартнер.contacts.Добавить(Сущность);
			
		КонецЦикла;
		
		//контрагенты
		НайденныеСтроки = ДанныеДляВыгрузки.Контрагенты.НайтиСтроки(Новый Структура("Партнер", Партнер));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			Сущность = СоздатьСущностьКонтрагент();
			ЗаполнитьСущностьКонтрагентПоКонтрагенту(Сущность, стрНайденныеСтроки.Контрагент, ДанныеДляВыгрузки);
			СущностьПартнер.contragents.Добавить(Сущность);
			
		КонецЦикла;
		
		//оборудование
		НайденныеСтроки = ДанныеДляВыгрузки.Оборудование.НайтиСтроки(Новый Структура("Партнер", Партнер));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			Сущность = СоздатьСущностьОборудование();
			ЗаполнитьСущностьОборудованиеПоОборудованию(Сущность, стрНайденныеСтроки);
			СущностьПартнер.equipments.Добавить(Сущность);
			
		КонецЦикла;
		
		//заявки на ремонт
		НайденныеСтроки = ДанныеДляВыгрузки.ЗаявкиНаРемонт.НайтиСтроки(Новый Структура("ПартнерВыгрузки", Партнер));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			Сущность = СоздатьСущностьРемонт();
			ЗаполнитьСущностьРемонтПоСтрокеВыгрузки(Сущность, стрНайденныеСтроки);
			СущностьПартнер.repairs.Добавить(Сущность);
			
		КонецЦикла;
		
		//взаиморасчеты
		НайденныеСтроки = ДанныеДляВыгрузки.Взаиморасчеты.НайтиСтроки(Новый Структура("Партнер", Партнер));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			
			Сущность = СоздатьСущностьВзаиморасчеты();
			ЗаполнитьСущностьВзаиморасчеты(Сущность, стрНайденныеСтроки);
			СущностьПартнер.mutualSettlements.Добавить(Сущность);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат СущностьПартнер;
	
КонецФункции

Функция ЗаполнитьСущностьМенеджерПоПользователю(Сущность, Пользователь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Пользователи.Ссылка) КАК xmlId,
	|	Пользователи.Наименование КАК Наименование,
	|	Пользователи.КонтактнаяИнформация.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Тип КАК Тип,
	|		Вид КАК Вид,
	|		Представление КАК Представление,
	|		ЗначенияПолей КАК ЗначенияПолей,
	|		Страна КАК Страна,
	|		Регион КАК Регион,
	|		Город КАК Город,
	|		АдресЭП КАК АдресЭП,
	|		ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|		НомерТелефона КАК НомерТелефона,
	|		НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|		ВидДляСписка КАК ВидДляСписка,
	|		Значение КАК Значение
	|	) КАК КонтактнаяИнформация,
	|	Пользователи.смартРабочаяПочта КАК смартРабочаяПочта,
	|	Пользователи.смартРабочийТелефон КАК смартРабочийТелефон,
	|	Пользователи.Недействителен КАК Недействителен
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Пользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Сущность.xmlId = СокрЛП(Выборка.xmlId);
		Сущность.name = СокрЛП(Выборка.Наименование);
		Сущность.active = ?(Выборка.Недействителен, "N", "Y");
		Сущность.email = СокрЛП(Выборка.смартРабочаяПочта);
		
		ВыборкаКонтакт = Выборка.КонтактнаяИнформация.Выбрать();
		Пока ВыборкаКонтакт.Следующий() Цикл
			
			Если ВыборкаКонтакт.Вид = Справочники.ВидыКонтактнойИнформации.CRM_МобильныйТелефонПользователя Тогда
				Сущность.mobile = ВыборкаКонтакт.НомерТелефона;
			ИначеЕсли ВыборкаКонтакт.Вид = Справочники.ВидыКонтактнойИнформации.смартРабочийТелефон Тогда
				Сущность.phone = СтрШаблон("+7 (495) 663-91-11 (доб. %1)", ВыборкаКонтакт.НомерТелефона);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьДоговорПоДоговору(Сущность, Договор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ДоговорыКонтрагентов.Ссылка) КАК ИДДоговора,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ДоговорыКонтрагентов.Контрагент) КАК ИДКонтрагента,
	|	ДоговорыКонтрагентов.Номер КАК Номер,
	|	ДоговорыКонтрагентов.Дата КАК Дата,
	|	ДоговорыКонтрагентов.Наименование КАК Наименование,
	|	ДоговорыКонтрагентов.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДоговорыКонтрагентов.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДоговорыКонтрагентов.Статус КАК Статус,
	|	ПРЕДСТАВЛЕНИЕ(ДоговорыКонтрагентов.ВалютаВзаиморасчетов) КАК Валюта,
	|	ДоговорыКонтрагентов.Сумма КАК Сумма,
	|	ЕСТЬNULL(РасчетыСКлиентамиОстатки.СуммаОстаток, 0) КАК Баланс,
	|	ДоговорыКонтрагентов.ТипДоговора КАК ТипДоговора
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентами.Остатки(, АналитикаУчетаПоПартнерам.Договор = &Ссылка) КАК РасчетыСКлиентамиОстатки
	|		ПО ДоговорыКонтрагентов.Ссылка = РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Договор
	|ГДЕ
	|	ДоговорыКонтрагентов.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентовсмартОборудование.ОборудованиеКлиента КАК ОборудованиеКлиента,
	|	ДоговорыКонтрагентовсмартОборудование.Серия КАК Серия,
	|	ДоговорыКонтрагентовсмартОборудование.Бренд КАК Бренд,
	|	смартОборудованиеЧернилаКлиентов.Номенклатура КАК Номенклатура,
	|	смартОборудованиеЧернилаКлиентов.Количество КАК Количество,
	|	ДоговорыКонтрагентовсмартОборудование.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов.смартОборудование КАК ДоговорыКонтрагентовсмартОборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартОборудованиеЧернилаКлиентов КАК смартОборудованиеЧернилаКлиентов
	|		ПО ДоговорыКонтрагентовсмартОборудование.ОборудованиеКлиента = смартОборудованиеЧернилаКлиентов.ОборудованиеКлиентов
	|			И (смартОборудованиеЧернилаКлиентов.СопоставлениеСТоваром)
	|ГДЕ
	|	ДоговорыКонтрагентовсмартОборудование.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", Договор);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Выборка = Пакет[0].Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если НЕ Выборка.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.Номер)
			ИЛИ НЕ ЗначениеЗаполнено(Выборка.Дата) Тогда
			
			Возврат Сущность;
			
		КонецЕсли;
		
		Сущность.xmlId = СокрЛП(Выборка.ИДДоговора);
		Сущность.contragentXmlId = СокрЛП(Выборка.ИДКонтрагента);
		Сущность.contractNumber = Выборка.Номер;
		Сущность.contractDate = Формат(Выборка.Дата, "ДФ=dd.MM.yyyy");
		Сущность.contractName = Выборка.Наименование;
		Сущность.startDate = Формат(Выборка.ДатаНачалаДействия, "ДФ=dd.MM.yyyy");
		Сущность.endDate = Формат(Выборка.ДатаОкончанияДействия, "ДФ=dd.MM.yyyy");
		Сущность.active = ?(Выборка.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует, "Y", "N");
		Сущность.currency = Выборка.Валюта;
		Сущность.amount = Выборка.Сумма;
		Сущность.balance = Выборка.Баланс;
		Сущность.overdraftLimit = 0;
		Сущность.reservedAmount = 0;
		
		ВыборкаНоменклатура = Пакет[1].Выбрать();
		Пока ВыборкаНоменклатура.Следующий() Цикл
			
			СущностьСтрокаНоменклатуры = СоздатьСущностьСтрокаНоменклатуры();
			Сущность.products.Добавить(ЗаполнитьСущностьСтрокаНоменклатурыПоОборудованию(СущностьСтрокаНоменклатуры, ВыборкаНоменклатура));
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьСтрокаНоменклатурыПоОборудованию(Сущность, СтрокаОборудования) Экспорт

	Сущность.productXmlId = СокрЛП(СтрокаОборудования.Номенклатура.УникальныйИдентификатор());
	Сущность.quantity = 1;
	Сущность.unitPrice = 0;
	Сущность.totalPrice = 0;
	Сущность.sort = СтрокаОборудования.НомерСтроки;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьОборудованиеПоОборудованию(Сущность, Оборудование) Экспорт
	
	ДатаГарантии1 = Неопределено;
	ДатаГарантии2 = Неопределено;
	ФорматДаты = "ДФ=dd.MM.yyyy";
	
	Если НЕ Оборудование.Оборудование = NULL И ЗначениеЗаполнено(Оборудование.Оборудование) Тогда
		Сущность.xmlId = СокрЛП(Оборудование.Оборудование.УникальныйИдентификатор());
		Сущность.name = СокрЛП(Оборудование.Оборудование);
	КонецЕсли;
	
	Если НЕ Оборудование.Партнер = NULL И ЗначениеЗаполнено(Оборудование.Партнер) Тогда
		Сущность.partnerXmlId = СокрЛП(ПолучитьПартнераВерхнегоУровня(Оборудование.Партнер).УникальныйИдентификатор());
	КонецЕсли;
	
	Если НЕ Оборудование.Номенклатура = NULL И ЗначениеЗаполнено(Оборудование.Номенклатура) Тогда
		Сущность.productXmlId = СокрЛП(Оборудование.Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	
	Если НЕ Оборудование.Серия = NULL И ЗначениеЗаполнено(Оборудование.Серия) Тогда
		Сущность.Вставить("serialNumber", СокрЛП(Оборудование.Серия.Номер));
	КонецЕсли;
	
	Если НЕ Оборудование.ДатаНачалаДополнительнойГарантии = NULL И ЗначениеЗаполнено(Оборудование.ДатаНачалаДополнительнойГарантии) Тогда
		Сущность.Вставить("extendedWarrantyStartDate", Формат(Оборудование.ДатаНачалаДополнительнойГарантии, ФорматДаты));
	КонецЕсли;
	
	Если НЕ Оборудование.ДатаОтгрузки = NULL И ЗначениеЗаполнено(Оборудование.ДатаОтгрузки) Тогда
		
		Сущность.Вставить("purchaseDate", Формат(Оборудование.ДатаОтгрузки, ФорматДаты));
		ДатаГарантии1 = ДобавитьМесяц(Оборудование.ДатаОтгрузки, 13);
		
	КонецЕсли;
	
	Если НЕ Оборудование.АдресВыезда = NULL И ЗначениеЗаполнено(Оборудование.АдресВыезда) Тогда
		Сущность.Вставить("address", СокрЛП(Оборудование.АдресВыезда));
	КонецЕсли;
	
	Если НЕ Оборудование.ПНР = NULL И ЗначениеЗаполнено(Оборудование.ПНР) Тогда
		Сущность.Вставить("setupRequestNumber", СокрЛП(Оборудование.ПНР.Номер));
	КонецЕсли;
	
	Если НЕ Оборудование.Комментарий = NULL И ЗначениеЗаполнено(Оборудование.Комментарий) Тогда
		Сущность.Вставить("notes", СокрЛП(Оборудование.Комментарий));
	КонецЕсли;
	
	Если НЕ Оборудование.ДатаПодписанияАктаПНР = NULL И ЗначениеЗаполнено(Оборудование.ДатаПодписанияАктаПНР) Тогда
		ДатаГарантии2 = ДобавитьМесяц(Оборудование.ДатаПодписанияАктаПНР, 12);
		Сущность.Вставить("shipmentDate", Формат(Оборудование.ДатаПодписанияАктаПНР, ФорматДаты));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаГарантии1) И ЗначениеЗаполнено(ДатаГарантии2) Тогда
		ДатаГарантии = Мин(ДатаГарантии1, ДатаГарантии2);
	ИначеЕсли ЗначениеЗаполнено(ДатаГарантии1) Тогда
		ДатаГарантии = ДатаГарантии1;
	ИначеЕсли ЗначениеЗаполнено(ДатаГарантии2) Тогда
		ДатаГарантии = ДатаГарантии2;
	Иначе
		ДатаГарантии = Дата(1, 1, 1);
	КонецЕсли;
	
	Сущность.Вставить("warrantyEndDate", ?(ЗначениеЗаполнено(ДатаГарантии), Формат(ДатаГарантии, ФорматДаты), ""));
	
	Сущность.Вставить("supplierName", СокрЛП(Оборудование.ПНР.Организация.НаименованиеСокращенное));
	Сущность.Вставить("purchaserName", СокрЛП(Оборудование.ПНР.Контрагент));
	Если Оборудование.ПНР.КонтактныеЛица.Количество() > 0 Тогда
		Сущность.Вставить("contactPerson", СокрЛП(Оборудование.ПНР.КонтактныеЛица[0].КонтактноеЛицо));
	КонецЕсли;
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьРемонтПоСтрокеВыгрузки(Сущность, СтрокаДанных) Экспорт
	
	Если ЗначениеЗаполнено(СтрокаДанных.ОборудованиеКлиентов) Тогда
		Сущность.xmlId = СокрЛП(СтрокаДанных.ОборудованиеКлиентов.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДанных.Партнер) Тогда
		Сущность.partnerXmlId = СокрЛП(ПолучитьПартнераВерхнегоУровня(СтрокаДанных.Партнер).УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДанных.Номенклатура) Тогда
		Сущность.productXmlId = СокрЛП(СтрокаДанных.Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДанных.Серия) Тогда
		Сущность.serial = СокрЛП(СтрокаДанных.Серия.Номер);
	КонецЕсли;
	
	Сущность.number = СокрЛП(СтрокаДанных.Номер);
	Сущность.date = Формат(СтрокаДанных.Дата, "ДФ=yyyy-MM-dd HH:mm:ss");
	Сущность.engeneer = СокрЛП(СтрокаДанных.ИнженерНаименование);
	Сущность.phone = СокрЛП(СтрокаДанных.ТелефонИнженера);
	Сущность.status = СокрЛП(СтрокаДанных.СтатусПредставление);
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьВзаиморасчеты(Сущность, Данные) Экспорт
	
	Сущность.contragentXmlId = СокрЛП(Данные.Контрагент.УникальныйИдентификатор());
	Если ЗначениеЗаполнено(Данные.Договор) Тогда
		Сущность.contractXmlId = СокрЛП(Данные.Договор.УникальныйИдентификатор());
	КонецЕсли;
	Сущность.balanceDebit = Данные.Аванс;
	Сущность.balanceCredit = Данные.Долг;
	Сущность.currency = СокрЛП(Данные.Валюта);
	
	Возврат Сущность;
	
КонецФункции

Функция ЗаполнитьСущностьАкция(Сущность, Данные) Экспорт
	
	ИДНоменклатура = "";
	ИДСерия = "";
	ИДСклад = "";
	
	Если ЗначениеЗаполнено(Данные.Номенклатура) Тогда
		ИДНоменклатура = СокрЛП(Данные.Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Серия) Тогда
		ИДСерия = СокрЛП(Данные.Серия.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Данные.Склад) Тогда
		ИДСклад = СокрЛП(Данные.Склад.УникальныйИдентификатор());
	КонецЕсли;
	
	Если Данные.ВидАкции = Перечисления.смартВидыАкций.ДемоЗал Тогда
		ИДПродукта = СтрШаблон("%1^%2^%3", ИДНоменклатура, ИДСклад, ИДСерия);
	Иначе
		ИДПродукта = ИДНоменклатура;
	КонецЕсли;
	
	Сущность.xmlId = СокрЛП(Данные.Ссылка.УникальныйИдентификатор());
	Сущность.type = "sale";
	Сущность.productXmlId = ИДПродукта;
	Сущность.price = Окр(РаботаСКурсамиВалют.ПересчитатьВВалюту(Данные.ЦенаАкция, Данные.ВалютаАкция, смартОбщегоНазначенияСКэш.ВалютаРегламентированногоУчета(), ТекущаяДата()));
	Сущность.dateStart = Формат(Данные.ДатаНачалаАкции, "ДФ='yyyy-MM-dd ЧЧ:мм:сс'");
	Сущность.dateEnd = Формат(?(ЗначениеЗаполнено(Данные.ДатаОкончанияАкции), Данные.ДатаОкончанияАкции, Дата(3999, 12, 31)), "ДФ='yyyy-MM-dd ЧЧ:мм:сс'");
	Сущность.active = "Y";
	Сущность.demoHall = СокрЛП(Данные.Склад);
	Сущность.serialNumber = СокрЛП(Данные.Серия);
	Сущность.yearOfManufacture = Формат(Данные.ОборудованиеДемозала.ГодВыпуска, "ДФ=yyyy");;
	Сущность.demoStartDate = Формат(Данные.ОборудованиеДемозала.ДатаЗапуска, "ДФ='yyyy-MM-dd ЧЧ:мм:сс'");
	Сущность.mileage = Данные.ОборудованиеДемозала.ПробегОборудования;
	Сущность.note = СокрЛП(Данные.Примечание);
	
	Возврат Сущность;
	
КонецФункции

#КонецОбласти

#Область ВыгрузкаДанных

Функция ПередатьПакетВБитрикс(Узел, Данные, ТипПакета, ДанныеВыгрузки)
	
	ДанныеПодключения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Узел, "АдресСайта,Логин,Пароль");
	
	Если ТипПакета = "Пользователи" Тогда
		АдресВнутри = "rest-api/v1/partners/managers/";
	ИначеЕсли ТипПакета = "Партнеры" Тогда
		АдресВнутри = "rest-api/v1/sync/full/";
	ИначеЕсли ТипПакета = "Акции" Тогда
		АдресВнутри = "rest-api/v1/promotions/sync/";
	Иначе
		Возврат "Неизвестный вид пакета данных";
	КонецЕсли;
	
	МассивСущностей = Новый Массив;
	Для каждого стрДанные Из Данные Цикл
		
		Если НЕ ЗначениеЗаполнено(стрДанные) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипПакета = "Пользователи" Тогда
			
			Сущность = СоздатьСущностьМенеджер();
			ЗаполнитьСущностьМенеджерПоПользователю(Сущность, стрДанные);
			
		ИначеЕсли ТипПакета = "Партнеры" Тогда
			
			Сущность = СоздатьСущностьПартнер();
			ЗаполнитьСущностьПартнерПоПартнеру(Сущность, стрДанные, ДанныеВыгрузки);
			
		ИначеЕсли ТипПакета = "Акции" Тогда
			
			Сущность = СоздатьСущностьАкция();
			ЗаполнитьСущностьАкция(Сущность, стрДанные);
			
		КонецЕсли;
		
		МассивСущностей.Добавить(Сущность);
		
	КонецЦикла;
	
	Если ТипПакета = "Партнеры" Тогда
		ДанныеJSON = смартОбщегоНазначения.ЗначениеВJSON(Новый Структура("partners", МассивСущностей));
	ИначеЕсли ТипПакета = "Акции" Тогда
		ДанныеJSON = смартОбщегоНазначения.ЗначениеВJSON(МассивСущностей);
	Иначе
		ДанныеJSON = смартОбщегоНазначения.ЗначениеВJSON(Новый Структура("data", МассивСущностей));
	КонецЕсли;
	
	Сообщить(АдресВнутри);
	Сообщить(ДанныеJSON);
		
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type",  "application/json");
	
	Результат = смартИнтеграцияDaData.ВыполнитьPOSTЗапрос(ДанныеПодключения.АдресСайта, АдресВнутри, 443, ДанныеПодключения.Логин, ДанныеПодключения.Пароль,,, Новый ЗащищенноеСоединениеOpenSSL(), Заголовки, ДанныеJSON);
	
	Если Результат <> Неопределено И НЕ Результат.КодСостояния = 200 Тогда
		Возврат Результат.ПолучитьТелоКакСтроку();
	Иначе
		ДанныеОтвета = смартОбщегоНазначения.JSONВЗначение(Результат.ПолучитьТелоКакСтроку(),, Ложь);
		Если ВРЕГ(ДанныеОтвета.status) = "ERROR" Тогда
			Возврат смартОбщегоНазначения.ЗначениеВJSON(ДанныеОтвета.errors);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СформироватьДанныеДляВыгрузкиВБитрикс(МассивПартнеров, Узел)
	
	Результат = Новый Структура("Партнеры,КонтактныеЛица,Пользователи,Контрагенты,Договоры,Оборудование,Взаиморасчеты,ЗаявкиНаРемонт");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Партнеры.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТПартнеры
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	Партнеры.Ссылка В ИЕРАРХИИ(&МассивПартнеров)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ВТПартнеры.Ссылка КАК Партнер
	|ПОМЕСТИТЬ ВТКонтрагенты
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПартнеры КАК ВТПартнеры
	|		ПО Контрагенты.Партнер = ВТПартнеры.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Договор, ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
	|	СУММА(-ЕСТЬNULL(РасчетыСКлиентамиОстатки.ДолгОстаток, 0)) КАК Долг,
	|	СУММА(ЕСТЬNULL(РасчетыСКлиентамиОстатки.ПредоплатаОстаток, 0)) КАК Аванс,
	|	РасчетыСКлиентамиОстатки.Валюта КАК Валюта
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			,
	|			АналитикаУчетаПоПартнерам.Партнер В
	|					(ВЫБРАТЬ
	|						Т.Ссылка
	|					ИЗ
	|						ВТПартнеры КАК Т)
	|				И АналитикаУчетаПоПартнерам.Контрагент В
	|					(ВЫБРАТЬ
	|						Т.Контрагент
	|					ИЗ
	|						ВТКонтрагенты КАК Т)
	|				И АналитикаУчетаПоПартнерам.Организация = &ОрганизацияСмарт
	|				И (АналитикаУчетаПоПартнерам.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|					ИЛИ АналитикаУчетаПоПартнерам.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыМеждуОрганизациями.ПустаяСсылка)
	|					ИЛИ АналитикаУчетаПоПартнерам.Договор = НЕОПРЕДЕЛЕНО
	|					ИЛИ АналитикаУчетаПоПартнерам.Договор.смартДоговорПодписан)) КАК РасчетыСКлиентамиОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Контрагент,
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Договор,
	|	РасчетыСКлиентамиОстатки.АналитикаУчетаПоПартнерам.Партнер,
	|	РасчетыСКлиентамиОстатки.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОборудования.ОборудованиеКлиентов КАК Оборудование,
	|	ВТПартнеры.Ссылка КАК Партнер,
	|	ТабОборудования.Оборудование КАК Номенклатура,
	|	ТабОборудования.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ТабОборудования.Серия КАК Серия,
	|	ТабОборудования.ДатаНачалаДополнительнойГарантии КАК ДатаНачалаДополнительнойГарантии,
	|	ТабОборудования.Ссылка.АдресВыезда КАК АдресВыезда,
	|	ТабОборудования.ГарантийныйСрокНаОборудование КАК ГарантийныйСрокНаОборудование,
	|	ТабОборудования.Ссылка.Комментарий КАК Комментарий,
	|	ТабОборудования.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаПНР,
	|	ТабОборудования.Ссылка КАК ПНР
	|ИЗ
	|	ВТПартнеры КАК ВТПартнеры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК ТабОборудования
	|		ПО ВТПартнеры.Ссылка = ТабОборудования.Ссылка.Партнер
	|			И (ТабОборудования.Ссылка.Проведен)
	|ГДЕ
	|	НЕ ТабОборудования.ОборудованиеКлиентов = ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор,
	|	ДоговорыКонтрагентов.Партнер КАК Партнер,
	|	ВТКонтрагенты.Контрагент КАК Контрагент
	|ИЗ
