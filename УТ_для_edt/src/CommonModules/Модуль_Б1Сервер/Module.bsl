// Функция проверяет соответствие Организация и Контрагентов во всех подчиненных документах
&НаСервере
Функция ПроверитьЮрЛицНаСоответствиеСервер(Отказ, Объект) Экспорт

	СтруктураПодчиненности = Новый ТаблицаЗначений;
	СтруктураПодчиненности.Колонки.Добавить("Ссылка",,"Документ");
	СтруктураПодчиненности.Колонки.Добавить("Уровень",,"Уровень подчиенности");
	
	Стр = СтруктураПодчиненности.Добавить();
	Стр.Ссылка = Объект.Ссылка;
	Стр.Уровень = 0;
	
	// Получаем все подчиненные документы
	Для Каждого Строка Из СтруктураПодчиненности Цикл
		
		ЗначениеКритерияОтбора = Строка.Получить(0);
		
		Если Строка.Уровень <= 3 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеДокументы.Ссылка КАК Ссылка
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&ЗначениеКритерияОтбора) КАК СвязанныеДокументы
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ЗаказПоставщику)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ЗаказНаПеремещение)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ПриобретениеТоваровУслуг)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ПриобретениеУслугПрочихАктивов)
			//++ #Б-990 смарт: Лопато 23.09.2024 //ИМ. Подготовить метод подтверждения (отклонения) регистрации пользователя на сайте  
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Задача.ЗадачаИсполнителя)
			//--#Б-990 смарт: Лопато 23.09.2024
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.смартЗаявкаНаПускоНаладку)";
			
			Запрос.УстановитьПараметр("ЗначениеКритерияОтбора", ЗначениеКритерияОтбора);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Стр = СтруктураПодчиненности.Добавить(); 
				Стр.Ссылка = ВыборкаДетальныеЗаписи.Ссылка;
				Стр.Уровень = Строка.Уровень + 1;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Стр Из СтруктураПодчиненности Цикл
		
		Если Не Стр.Уровень = 0 Тогда
			
			Документ = Стр.Получить(0);
			
			//++ #Б4348 смарт: Шляпников 15.09.2025 / Ошибка ЖР. Закрытие заказа клиента
			Если НЕ ЗначениеЗаполнено(Документ) Тогда
				Продолжить;
			ИначеЕсли НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Документ)) Тогда
				Продолжить;
			ИначеЕсли НЕ ОбщегоНазначения.ЭтоДокумент(Документ.Метаданные()) Тогда
				Продолжить;
			КонецЕсли;
			//-- #Б4348 смарт: Шляпников 15.09.2025
			
			Если Документ.Проведен Тогда
				
				ДокументОбъект = Документ.ПолучитьОбъект();
				
				Попытка // Проверка Организации и Контрагента
					
					Если Не ДокументОбъект.Организация = Объект.Организация Тогда
						Отказ = Истина;
						Сообщить("В документе: "+ДокументОбъект.Ссылка+" необходимо изменить Организацию");
					КонецЕсли;
					
					Если Не ДокументОбъект.Контрагент = Объект.Контрагент Тогда
						Отказ = Истина;
						Сообщить("В документе: "+ДокументОбъект.Ссылка+" необходимо изменить Контрагента");
					КонецЕсли;
					
				Исключение
					Продолжить;
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Отказ;
	
КонецФункции // ПроверитьЮрЛицНаСоответствиеСервер()

