Функция ПроверитьВозможностьЗакрытияДокументов(Документы) Экспорт
	      
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки,
		|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток,
		|	ТоварыКОтгрузкеОстатки.СобираетсяОстаток,
		|	ТоварыКОтгрузкеОстатки.СобраноОстаток,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ЗаказКлиента КАК ЗаказКлиента
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки(&Период, ДокументОтгрузки.ЗаказКлиента В (&Документы)) КАК ТоварыКОтгрузкеОстатки
		|ГДЕ
		|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток > 0
		|	И ТоварыКОтгрузкеОстатки.ДокументОтгрузки.ЗаказКлиента.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке = ИСТИНА";
		
	//Запрос.Текст = Запрос.Текст +  ТекстЗапросаПроверитьДолгКлиента();
	
	Запрос.УстановитьПараметр("Документы", Документы);
	//Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата());
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДата()));

	Результат = Запрос.Выполнить();

	//Если Список Тогда
		//Результат = Запрос.ВыполнитьПакет();
		МассивДокументов = Новый Массив;
		//МассивДокументов = Результат[0];
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			МассивДокументов.Добавить(Выборка.ЗаказКлиента);
		КонецЦикла;
		//МассивДокументов = Результат.Выгрузить();
		
		Возврат МассивДокументов;
	//КонецЕсли;
	
	
	
	//Если Результат.Пустой()  Тогда
	//	Возврат Истина;
	//ИначеЕсли ПроверитьПолныеПраваТекПользователя() Тогда
	//	Возврат Истина;
	//Иначе	
	//	Возврат Ложь;
	//КонецЕсли;	
	//ВыборкаДетальныеЗаписи = Результат.Выбрать();

	
    	
КонецФункции

Процедура ЗапретитьВозможностьПроведенияДокументовПоЗакрытымЗаказам(Заказы, Отказ) Экспорт
	
	Если ПроверитьПолныеПраваТекПользователя() Тогда
		Возврат; //Ложь;
	КонецЕсли;
	//Проверим, закрыты ли заказы. Если закрыты проводить нельзя - вернем занчение Истина.
	
	 	
	Для каждого Заказ ИЗ Заказы Цикл
		Если Заказ.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
		  ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заказ " + Заказ + " Закрыт.",,,,Отказ);
		  Если Отказ Тогда
			  Прервать;
		  КонецЕсли;  
		КонецЕсли;  
	КонецЦикла;	
	
КонецПроцедуры

