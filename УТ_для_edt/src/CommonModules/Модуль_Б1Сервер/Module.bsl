

Функция ПолучитьМассивСостояний() Экспорт
	
	МассивСостояний = Новый Массив();
	МассивСостояний.Добавить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяАвансДоОбеспечения);
	МассивСостояний.Добавить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяПредоплатаДоОтгрузки);
	МассивСостояний.Добавить(Перечисления.СостоянияЗаказовКлиентов.ОжидаетсяОплатаПослеОтгрузки);	
	Возврат МассивСостояний;
	
КонецФункции

Функция ПолучитьЧерныйсписокПартнеров() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НеплатящиеПартнеры.Партнер
		|ИЗ
		|	РегистрСведений.НеплатящиеПартнеры КАК НеплатящиеПартнеры";

	Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
	МассивПартнеры = Новый Массив;
	Пока Выборка.Следующий()Цикл
		МассивПартнеры.Добавить(Выборка.Партнер);
	КонецЦикла;	
	Возврат МассивПартнеры;
	
КонецФункции

