//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
Процедура ЗаполнитьРеквизитыКонтрагентаПоПолученнымДанным(РеквизитыКонтрагента, Контрагент)
	
	Объект = Контрагент.ПолучитьОбъект();
	
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыКонтрагента, "ИНН, Наименование");
	Если РеквизитыКонтрагента.Свойство("КПП") Тогда
		Если РеквизитыКонтрагента.КПП <> Объект.КПП Тогда
			Объект.КПП = РеквизитыКонтрагента.КПП;
			ЗаполнитьИсториюКПП(Объект, РеквизитыКонтрагента);
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.НаименованиеПолное <> РеквизитыКонтрагента.НаименованиеСокращенное Тогда
		Объект.НаименованиеПолное = РеквизитыКонтрагента.НаименованиеСокращенное;
		ЗаполнитьИсториюНаименований(Объект, РеквизитыКонтрагента);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("Телефон") Тогда
		ЗаполнитьЭлементКонтактнойИнформации(Объект,
		ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента"),
		РеквизитыКонтрагента.Телефон);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("ЮридическийАдрес") Тогда
		
		//ЗаполнитьЭлементКонтактнойИнформации(Объект,
		//                                     ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"),
		//                                    РеквизитыКонтрагента.ЮридическийАдрес);
		
		ЗаполнитьИсториюАдресов(Объект, РеквизитыКонтрагента);
		
		//ЗаполнитьЭлементКонтактнойИнформации(Объект,
		//                                     ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"),
		//                                      РеквизитыКонтрагента.ЮридическийАдрес);
		
	КонецЕсли;
	
	Объект.смартЗаполнитьФактическийАдресПоЮридическому();
	
	ТелефонИEmailЗаполнены = Объект.смартПроверитьЗаполнениеEmailИТелефона(Истина, Истина, Истина);
	Если НЕ ТелефонИEmailЗаполнены Тогда	
		Успех = Объект.смартЗаполнитьЕmailТелефонИзПартнера(Истина, Истина);
	КонецЕсли;
	
	Объект.смартДатаОбновленияПоДаннымФНС = ТекущаяДата();
	
	Объект.Записать();
	
КонецПроцедуры //-- смарт:ММ 08.10.2020

//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
Процедура ЗаполнитьИсториюКПП(Объект, РеквизитыКомпании)
	
	Объект.ИсторияКПП.Очистить();
	
	ИсторияКПП = ПолучитьИсториюРеквизита(РеквизитыКомпании, "КПП");
	Если ИсторияКПП = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИсторияКПП.Количество() > 1 Тогда
		Для Каждого СтрокаКПП Из ИсторияКПП Цикл
			СтрокаИсторииКПП = Объект.ИсторияКПП.Добавить();
			СтрокаИсторииКПП.Период = СтрокаКПП.Дата;
			СтрокаИсторииКПП.КПП    = СтрокаКПП.Значение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 08.10.2020

//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
