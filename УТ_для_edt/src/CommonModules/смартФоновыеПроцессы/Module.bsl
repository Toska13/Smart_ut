                    стр.НачалоОтгрузки = ДатаСдвига;
                    ОбъектИзменен = Истина; 
                Иначе 
                    МассивСтрокИндексы.Добавить(Об.Товары.Индекс(стр));
                    
                    ВариантыОбеспечения=Новый Массив;
