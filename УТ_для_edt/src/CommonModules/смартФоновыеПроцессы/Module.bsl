//++ #5384 смарт: Тимофеева 29.01.26 / Доработка документов под схему "товары в пути"
&НаСервере
Процедура СоздатьДокументыПоступленияТоваровНаСклад() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.смартСозданиеПоступленийТоваровНаСклад);
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Автоматическое создание документов Поступление товаров на склад'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Начато регламентное создание документов Поступление товаров на склад.'"));
	
	НачатьТранзакцию();
	Попытка
		
		Выборка = ВыбратьЗаказыПоставщиковДляСозданияПоступленийНаСклад();
		Пока Выборка.Следующий() Цикл
			
			ОписаниеОшибки = "";
			
			ПоступлениеТоваровНаСкладОбъект = Документы.ПоступлениеТоваровНаСклад.СоздатьДокумент(); 
			
			Основание = Новый Структура;
			Основание.Вставить("ДокументОснование", 			Выборка.ДокументПоступления);
			Основание.Вставить("СкладПоступления", 				Выборка.Склад);
			Основание.Вставить("ХозяйственнаяОперацияПриемки", 	Выборка.ХозяйственнаяОперацияПриемки);	
			Основание.Вставить("ЗаполнятьПоНакладной", 			Истина);
			
			ПоступлениеТоваровНаСкладОбъект.Заполнить(Основание);
			ПоступлениеТоваровНаСкладОбъект.Дата 		= ТекущаяДатаСеанса();
			ПоступлениеТоваровНаСкладОбъект.Комментарий = СтрШаблон("#Автоматическое создание документов / %1", ТекущаяДатаСеанса());
			
			ПоступлениеТоваровНаСкладОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Автоматическое создание документов Поступление товаров на склад'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
		                         УровеньЖурналаРегистрации.Ошибка, , ,
		                         НСтр("ru = 'Во время регламентного создания документов Поступление товаров на склад произошла ошибка.'")
		                         + Символы.ПС + ОписаниеОшибки);
		Возврат;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Автоматическое создание документов Поступление товаров на склад'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
	                         УровеньЖурналаРегистрации.Информация, , ,
	                         НСтр("ru = 'Закончено регламентное создание документов Поступление товаров на склад.'"));
	
КонецПроцедуры  

Функция ВыбратьЗаказыПоставщиковДляСозданияПоступленийНаСклад()	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументПоступления КАК ДокументПоступления,
	|	Таблица.Склад КАК Склад,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Серия КАК Серия,
	|	Таблица.Назначение КАК Назначение,
	|	Таблица.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	Таблица.КОформлениюНакладныхПоРаспоряжениюОстаток КАК КОформлениюНакладныхПоРаспоряжениюОстаток,
	|	Таблица.КОформлениюПоступленийПоРаспоряжениюОстаток КАК КОформлениюПоступленийПоРаспоряжениюОстаток,
	|	Таблица.КОформлениюПоступленийПоНакладнымОстаток КАК КОформлениюПоступленийПоНакладнымОстаток,
	|	Таблица.КОформлениюПоступленийПоОрдерамОстаток КАК КОформлениюПоступленийПоОрдерамОстаток,
	|	Таблица.КОформлениюОрдеровОстаток КАК КОформлениюОрдеровОстаток,
	|	Таблица.ПринимаетсяОстаток КАК ПринимаетсяОстаток
	|ПОМЕСТИТЬ ВтОстаткиКОформлениюПоступленийПоРаспоряжению
	|ИЗ
	|	РегистрНакопления.ТоварыКПоступлению.Остатки(
	|			,
	|			ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаПоИмпортуТоварыВПути)
	|				И ДокументПоступления ССЫЛКА Документ.ЗаказПоставщику) КАК Таблица
	|ГДЕ
	|	Таблица.КОформлениюПоступленийПоРаспоряжениюОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументПоступления КАК ДокументПоступления,
	|	Таблица.Склад КАК Склад,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Назначение КАК Назначение,
	|	Таблица.КОформлениюОрдеровОстаток КАК КОформлениюОрдеровОстаток
	|ПОМЕСТИТЬ ВтОстаткиКОформлениюОрдеров
	|ИЗ
	|	РегистрНакопления.ТоварыКПоступлению.Остатки(
	|			,
	|			(ДокументПоступления, Склад, Номенклатура, Характеристика, Назначение) В
	|				(ВЫБРАТЬ
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению.ДокументПоступления КАК ДокументПоступления,
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Склад КАК Склад,
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Номенклатура КАК Номенклатура,
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Характеристика КАК Характеристика,
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Назначение КАК Назначение
	|				ИЗ
	|					ВтОстаткиКОформлениюПоступленийПоРаспоряжению)) КАК Таблица
	|ГДЕ
	|	Таблица.КОформлениюОрдеровОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументПоступления КАК ДокументПоступления,
	|	Таблица.ХозяйственнаяОперация КАК ХозяйственнаяОперацияПриемки,
	|	Таблица.Склад КАК Склад,
	|	Таблица.Номенклатура КАК Номенклатура,
	|	Таблица.Характеристика КАК Характеристика,
	|	Таблица.Назначение КАК Назначение,
	|	ВЫБОР
	|		КОГДА ТаблицаОстаткиКОформлениюОрдеров.ДокументПоступления ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОформленОрдер
	|ПОМЕСТИТЬ ВтСостояниеОрдеров
	|ИЗ
	|	ВтОстаткиКОформлениюПоступленийПоРаспоряжению КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтОстаткиКОформлениюОрдеров КАК ТаблицаОстаткиКОформлениюОрдеров
	|		ПО (ТаблицаОстаткиКОформлениюОрдеров.ДокументПоступления = Таблица.ДокументПоступления)
	|			И (ТаблицаОстаткиКОформлениюОрдеров.Склад = Таблица.Склад)
	|			И (ТаблицаОстаткиКОформлениюОрдеров.Номенклатура = Таблица.Номенклатура)
	|			И (ТаблицаОстаткиКОформлениюОрдеров.Характеристика = Таблица.Характеристика)
	|			И (ТаблицаОстаткиКОформлениюОрдеров.Назначение = Таблица.Назначение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.ДокументПоступления КАК ДокументПоступления,
	|	Таблица.ХозяйственнаяОперацияПриемки КАК ХозяйственнаяОперацияПриемки,
	|	Таблица.Склад КАК Склад,
	|	МИНИМУМ(Таблица.ОформленОрдер) КАК ОформленОрдер
	|ПОМЕСТИТЬ ВтДокументыКОформлениюПоступлений
	|ИЗ
	|	ВтСостояниеОрдеров КАК Таблица
	|
	|СГРУППИРОВАТЬ ПО
	|	Таблица.ДокументПоступления,
	|	Таблица.ХозяйственнаяОперацияПриемки,
	|	Таблица.Склад
	|
	|ИМЕЮЩИЕ
	|	МИНИМУМ(Таблица.ОформленОрдер) = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтОстаткиКОформлениюПоступленийПоРаспоряжению.ДокументПоступления КАК ДокументПоступления,
	|	ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Склад КАК Склад,
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(ВидыНоменклатурыПолитикиУчетаСерий.ПолитикаУчетаСерий.УчитыватьСебестоимостьПоСериям, ЛОЖЬ) КАК УчитыватьСерии
	|ПОМЕСТИТЬ ВТ_ТаблицаУчетНоменклатурыПоСериям
	|ИЗ
	|	ВтОстаткиКОформлениюПоступленийПоРаспоряжению КАК ВтОстаткиКОформлениюПоступленийПоРаспоряжению
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ПО ВтОстаткиКОформлениюПоступленийПоРаспоряжению.ДокументПоступления = ЗаказПоставщикуТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНоменклатуры.ПолитикиУчетаСерий КАК ВидыНоменклатурыПолитикиУчетаСерий
	|		ПО (ЗаказПоставщикуТовары.Номенклатура.ВидНоменклатуры = ВидыНоменклатурыПолитикиУчетаСерий.Ссылка)
	|			И ВтОстаткиКОформлениюПоступленийПоРаспоряжению.Склад = ВидыНоменклатурыПолитикиУчетаСерий.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаУчетНоменклатурыПоСериям.ДокументПоступления КАК ДокументПоступления,
	|	МАКСИМУМ(ВТ_ТаблицаУчетНоменклатурыПоСериям.УчитыватьСерии) КАК УчитыватьСерии
	|ПОМЕСТИТЬ ВТ_ДокументыПоступленияБезСерий
	|ИЗ
	|	ВТ_ТаблицаУчетНоменклатурыПоСериям КАК ВТ_ТаблицаУчетНоменклатурыПоСериям
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаУчетНоменклатурыПоСериям.ДокументПоступления
	|
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВТ_ТаблицаУчетНоменклатурыПоСериям.УчитыватьСерии) = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.ДокументПоступления КАК ДокументПоступления,
	|	Таблица.ХозяйственнаяОперацияПриемки КАК ХозяйственнаяОперацияПриемки,
	|	Таблица.Склад КАК Склад
	|ИЗ
	|	ВтДокументыКОформлениюПоступлений КАК Таблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДокументыПоступленияБезСерий КАК ВТ_ДокументыПоступленияБезСерий
	|		ПО Таблица.ДокументПоступления = ВТ_ДокументыПоступленияБезСерий.ДокументПоступления");  
		
	Результат = Запрос.Выполнить();
	Возврат Результат.Выбрать();	
КонецФункции
