 				//++#1214 смарт: Лопато 10.10.2022 //Рефакторинг в связи с ошибками  
				//Копия=Ложь;
				//ИнформацияОБазе=Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Получить().Получить();
