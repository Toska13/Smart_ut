	Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
	Для Каждого Строка Из Строки Цикл
		Объект.КонтактнаяИнформация.Удалить(Строка);
	КонецЦикла;
	ДанныеСтроки = Объект.КонтактнаяИнформация.Добавить();
