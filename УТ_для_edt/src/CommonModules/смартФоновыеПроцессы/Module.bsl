                    Таблица = ОбеспечениеСервер.ТаблицаЗаполнениеОбеспеченияДокумента(Об,ВариантыОбеспечения,ПараметрыДокумента,МассивСтрокИндексы);
                    Текст=Документы.ЗаказКлиента.ЗаполнитьВариантОбеспечения(Об,Неопределено,"ИндексыСтрок",Таблица);  
                    ОбъектИзменен = Истина;
                КонецЕсли;
            КонецЕсли;
            
            Если НЕ ОбъектИзменен Тогда
                Для каждого стр из МассивСтрок цикл 
                    Если ЗначениеЗаполнено(ДатаСдвига) Тогда
                        стр.ДатаОтгрузки = ДатаСдвига;
                        ОбъектИзменен = Истина;
                    Иначе
                        ВариантыОбеспечения=Новый Массив;
