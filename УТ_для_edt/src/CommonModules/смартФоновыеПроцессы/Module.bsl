//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 17.08.2020 15:24:38 добавление фильтров номенклатуры, вызов при записи номенклатуры
Процедура ДобавлениеФильтровНоменклатуры(Параметры,Адрес) Экспорт 
	
	Если ЗначениеЗаполнено(Параметры.СсылкаНоменклатура) Тогда
		Ссылка = Параметры.СсылкаНоменклатура;
	иначе
		Возврат
	КонецЕсли;
	
	Сегменты=Справочники.СегментыНоменклатуры;
	Выборка = Сегменты.Выбрать();
	МассивФильтров=Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		Сегмент=Выборка.Ссылка;
		Если СегментыСервер.ВходитВСегмент(Ссылка,Сегмент) И Сегмент.ФильтрыБитрикс.Количество()>0 Тогда
			Если МассивФильтров.Количество()>0 Тогда
				Для Каждого СтрТЧсегм из Сегмент.ФильтрыБитрикс цикл
					МассивФильтров.Добавить(СтрТЧсегм.Фильтр);
				КонецЦикла;
			Иначе
				МассивФильтров=Сегмент.ФильтрыБитрикс.ВыгрузитьКолонку("Фильтр");	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если МассивФильтров.Количество()>0 Тогда
		Для Каждого СтрМасс из МассивФильтров Цикл 
			НаборЗаписей=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НаборСвойств.Установить(Ссылка);
			НаборЗаписей.Отбор.ВидСвойств.Установить(СтрМасс);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество()=0 Тогда
				//Для Каждого СтрФильтр Из МассивФильтров цикл
				НоваяЗапись=НаборЗаписей.Добавить();
				НоваяЗапись.НаборСвойств=Ссылка;
				НоваяЗапись.ВидСвойств=СтрМасс;
				//КонецЦикла;
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавлениеФильтровПоСегментам(Параметры,Адрес) Экспорт 
	
	Если НЕ Параметры.СсылкаСегмент=Неопределено Тогда
		Ссылка = Параметры.СсылкаСегмент;
	иначе
		Возврат;
	КонецЕсли;
	
	МассивЭлементов=Новый Массив;
	Если Параметры.ВклУд=Неопределено И Параметры.СсылкаНоменклатура=Неопределено Тогда  
		МассивЭлементов=СегментыСервер.МассивЭлементов(Ссылка);	
	Иначе
		СсылкаНоменклатура = Параметры.СсылкаНоменклатура;
		Если Параметры.ВклУд Тогда
			МассивЭлементов.Добавить(СсылкаНоменклатура);
		ИначеЕсли Не Параметры.ВклУд Тогда 	
			НаборЗаписейДляЧистики=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
			НаборЗаписейДляЧистики.Отбор.НаборСвойств.Установить(СсылкаНоменклатура);
			НаборЗаписейДляЧистики.Отбор.Сегмент.Установить(Ссылка);
			НаборЗаписейДляЧистики.Прочитать();
			НаборЗаписейДляЧистики.Очистить();
			НаборЗаписейДляЧистики.Записать();
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	
	Для Каждого СтрМасс из МассивЭлементов Цикл 
		Если Ссылка.ФильтрыБитрикс.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		
		//Очистка свойств без сегментов
		НаборЗаписейДляЧистики=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
		НаборЗаписейДляЧистики.Отбор.НаборСвойств.Установить(СтрМасс);
		НаборЗаписейДляЧистики.Отбор.Сегмент.Установить(Справочники.СегментыНоменклатуры.ПустаяСсылка());
		НаборЗаписейДляЧистики.Прочитать();
		НаборЗаписейДляЧистики.Очистить();
		НаборЗаписейДляЧистики.Записать();
		
		//Отбор существующих фильтров
		НаборЗаписей=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.НаборСвойств.Установить(СтрМасс);
		НаборЗаписей.Отбор.Сегмент.Установить(Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество()=0 Тогда
			Для Каждого СтрФильтр Из Ссылка.ФильтрыБитрикс цикл
				НоваяЗапись=НаборЗаписей.Добавить();
				НоваяЗапись.НаборСвойств=СтрМасс;
				НоваяЗапись.Сегмент=Ссылка;
				НоваяЗапись.ВидСвойств=СтрФильтр.Фильтр;
			КонецЦикла;
			НаборЗаписей.Записать();
		Иначе
			// удалим лишний фильтр в регистре
			Для Каждого стрНабор Из НаборЗаписей Цикл 
				НайденнаяСтрока = Ссылка.ФильтрыБитрикс.Найти(стрНабор.ВидСвойств,"Фильтр"); 
				Если НайденнаяСтрока=Неопределено Тогда
					НаборЗаписей.Удалить(стрНабор);
					НаборЗаписей.Записать();
				КонецЕсли;
			КонецЦикла;
			
			// добавим фильтр в регистр
			Для Каждого СтрФильтр Из Ссылка.ФильтрыБитрикс цикл
				НаборЗаписей.Отбор.ВидСвойств.Установить(СтрФильтр.Фильтр);
				НаборЗаписей.Прочитать();
				Если НаборЗаписей.Количество()=0 Тогда
					НоваяЗапись=НаборЗаписей.Добавить();
					НоваяЗапись.НаборСвойств=СтрМасс;
					НоваяЗапись.Сегмент=Ссылка;
					НоваяЗапись.ВидСвойств=СтрФильтр.Фильтр;  
					НаборЗаписей.Записать();
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
//Смарт }Подкин Алексей Иванович 17.08.2020 15:24:38

//++ смарт:Подкин #1134 10.08.2022 17:49:58
Процедура смартПроведениеЗаказовКлиента(Параметры, Адрес) Экспорт 
    
    // ОбщегоНазначенияБТС.Пауза(5);
    МассивТиповДокументов                = Параметры.МассивТиповДокументов;
    Док                                  = Параметры.Док;
    ДатаСдвига                           = Параметры.ДатаСдвига;
    Номенклатура                         = Параметры.Номенклатура;
    Характеристика                       = Параметры.Характеристика;
    Склад                                = Параметры.Склад;
    МассивИзмененныхЗаказовНаПеремещение = Параметры.МассивИзмененныхЗаказовНаПеремещение;
    
    ТипДок = ТипЗнч(Док);
    
    Если МассивТиповДокументов.Найти(ТипДок) <> Неопределено тогда
        //меняем данные в документах и проводим
        Об = Док.ПолучитьОбъект();
        
        Попытка
            Об.Заблокировать();
        Исключение			
            ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Строка(Док) + " не возможно изменить, он заблокирован: " + ОписаниеОшибки());
            Возврат;
        КонецПопытки;
        
        ОбъектИзменен = Ложь;
        
        Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") ИЛИ
            ТипДок = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") тогда 
            
            //отгрузить одной датой
            Если Об.НеОтгружатьЧастями = Истина тогда
                //если заказ отгружается одной датой, то снимаем этот признак, для того чтобы подвинуть дату по конкретному товару
                Об.НеОтгружатьЧастями = Ложь;
            КонецЕсли;
            
            Отбор = Новый Структура;
            Отбор.Вставить("Номенклатура", Номенклатура);
            Отбор.Вставить("Характеристика", Характеристика);
            Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") тогда
                Отбор.Вставить("Склад", Склад);
            КонецЕсли;
            Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
            
            МассивСтрок = Об.Товары.НайтиСтроки(Отбор);           
            
            ТЗТовары=Об.Товары.Выгрузить(,"Номенклатура,Характеристика,Количество"); 
            ТЗТовары.Свернуть("Номенклатура,Характеристика","Количество"); 
            ТЗСдостОстатками=ПолучитьДоступныеОстатки(ТЗТовары, Склад);
            МассивСтрокИндексы=Новый Массив;
            Для каждого стр из МассивСтрок Цикл
                МассивНСтрок=ТЗСдостОстатками.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",стр.Номенклатура,стр.Характеристика));
                Если МассивНСтрок.Количество()=1 Тогда
                    Если МассивНСтрок[0].Доступно>=МассивНСтрок[0].Количество Тогда
                        МассивСтрокИндексы.Добавить(Об.Товары.Индекс(стр));
                    КонецЕсли;
                    
                КонецЕсли; 
            КонецЦикла;
            
            ИзменитьОбеспечение=Ложь;
            Текст="";
            Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") И МассивСтрокИндексы.Количество() Тогда
                ВыборкаСостояния = РегистрыСведений.СостоянияЗаказовКлиентов.Выбрать(Новый Структура("Заказ",Док),);
                Если ВыборкаСостояния.Следующий() И ВыборкаСостояния.ПроцентОплаты>0 Тогда 
                    
                    ВариантыОбеспечения=Новый Массив;
                    ВариантыОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.СоСклада);  //Резервировать на складе
                    ВыбранноеЗначение=Новый Структура("ЗаполнятьЦелымиУпаковками,ПереченьВариантов",Ложь,ВариантыОбеспечения);
                    
                    ПараметрыЗаполнения = Новый Структура("ПереченьВариантов, ИзменятьОбособление, ЗаполнятьЦелымиУпаковками", Неопределено, Истина, Ложь);
                    ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыбранноеЗначение);
                    ПутиКДанным = Новый Соответствие; //Описание особенностей формы
                    ПутиКДанным.Вставить("ДатаОтгрузкиРабот", "ДатаОтгрузки"); // дату отгрузки работ необходимо брать из поля "Дата отгрузки".
                    ПараметрыДокумента = Новый Структура;
                    ПараметрыДокумента.Вставить("СтатусКВыполнению", Об.Статус <> Перечисления.СтатусыЗаказовКлиентов.НеСогласован);
                    ПараметрыДокумента.Вставить("ГруппаСкладов", Об.Склад);
                    ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыКлиентов);
                    ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным);
                    ПараметрыДокумента.Вставить("ИмяТабличнойЧасти","Товары");
                    
                    Таблица = ОбеспечениеСервер.ТаблицаЗаполнениеОбеспеченияДокумента(Об,ВариантыОбеспечения,ПараметрыДокумента,МассивСтрокИндексы);
                    
                    Текст=Документы.ЗаказКлиента.ЗаполнитьВариантОбеспечения(Об,Неопределено,"ИндексыСтрок",Таблица);  
                    
                    ОбъектИзменен = Истина;
                КонецЕсли;
            КонецЕсли;
            
            Если НЕ ОбъектИзменен Тогда
                Для каждого стр из МассивСтрок цикл  
                    стр.ДатаОтгрузки = ДатаСдвига;
                    ОбъектИзменен = Истина;
                КонецЦикла; 
            КонецЕсли;
            
        ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаСборку") тогда
            Об.НачалоСборкиРазборки = ДатаСдвига;
            Об.ОкончаниеСборкиРазборки = ДатаСдвига;
            
            ОбъектИзменен = Истина;
        ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаПеремещение") тогда
            Отбор = Новый Структура;
            Отбор.Вставить("Номенклатура", Номенклатура);
            Отбор.Вставить("Характеристика", Характеристика);
            Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
            
            МассивСтрок = Об.Товары.НайтиСтроки(Отбор);
            Для каждого стр из МассивСтрок цикл
                стр.НачалоОтгрузки = ДатаСдвига;
                ОбъектИзменен = Истина;
            КонецЦикла;
        КонецЕсли;  
        
        Если ОбъектИзменен Тогда
            //добавим доп. свойство для отмены проверки на отрицательные остатки по регистру ДоступныеОстаткиПланируемыхПоступлений
            Об.ДополнительныеСвойства.Вставить("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений", Истина);
            Попытка
                Об.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");  
                НачатьТранзакцию();
                Об.Записать(РежимЗаписиДокумента.Проведение);  
                ЗафиксироватьТранзакцию();
                ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменены даты резерва в документе """ + Строка(Док) + """", Док);
                
                НомерПоследнейВерсии = ПолучитьНомерВерсииПоследний(Док);
                Если НомерПоследнейВерсии <> Неопределено Тогда
                    ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(Док, НомерПоследнейВерсии, "Автоматический перенос резерва при изменении даты поступления товара");
                КонецЕсли;
                
				//++#1214 смарт: Лопато 10.10.2022 //Рефакторинг в связи с ошибками  
				//Копия=Ложь;
				//ИнформацияОБазе=Константы.ПараметрыБлокировкиРаботыСВнешнимиРесурсами.Получить().Получить();
				//Если Не ИнформацияОБазе=Неопределено Тогда 
				//    Копия=ИнформацияОБазе.РаботаСВнешнимиРесурсамиЗаблокирована;
				//КонецЕсли;	
				//Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Док,"Менеджер") И ЗначениеЗаполнено(Док.Менеджер) Тогда
				
                Менеджер=Справочники.Пользователи.ПустаяСсылка();
                Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Док,"Менеджер") И ЗначениеЗаполнено(Док.Менеджер) Тогда  
                    Менеджер = Док.Менеджер; 
                ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Док,"Ответственный") И ЗначениеЗаполнено(Док.Ответственный) Тогда
                    Менеджер = Док.Ответственный;                
                КонецЕсли;
				
                Если смартОбщегоНазначения.смартРабочаяБаза() И ЗначениеЗаполнено(Менеджер) Тогда  
				//--#1214 смарт: Лопато 10.10.2022
                    НавСсылка=ПолучитьНавигационнуюСсылку(Об);
                    УчетнаяЗапись=РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
                    ДанныеДляОтправки=Новый Структура;
 					//++#1214 смарт: Лопато 10.10.2022 //Рефакторинг в связи с ошибками  
					//ДанныеДляОтправки.Вставить("Кому",Об.Менеджер.смартРабочаяПочта); 
					ДанныеДляОтправки.Вставить("Кому",Менеджер.смартРабочаяПочта); 
 					//--#1214 смарт: Лопато 10.10.2022
                    ДанныеДляОтправки.Вставить("Тема","Изменен резерв в: "+Док);
                    Если ЗначениеЗаполнено(Текст) Тогда
                        ДанныеДляОтправки.Вставить("Тело","Изменено обеспечение Резервировать на складе:"+Текст+ " _ "+ Строка(Док) +Символы.ПС+" "+Символы.ПС+"Навигационная ссылка на документ: "+НавСсылка);
                    Иначе
                        ДанныеДляОтправки.Вставить("Тело","Изменены даты резерва в документе " + Строка(Док) + " на "+ДатаСдвига+Символы.ПС+" "+Символы.ПС+"Навигационная ссылка на документ: "+НавСсылка);
                    КонецЕсли;
                    ДанныеДляОтправки.Вставить("ТипТекста",ТипТекстаПочтовогоСообщения.ПростойТекст);
                    ДанныеДляОтправки.Вставить("Важность",ВажностьИнтернетПочтовогоСообщения.Высокая);
                    РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки); 
                    
 					//++#1214 смарт: Лопато 10.10.2022 //Рефакторинг в связи с ошибками  
					//ЕстьЗаписьОсновной=смартОбработкаПодписокНаСобытия.ПолучитьТекЗаписьНапоминания(Док.Менеджер,Док);
                    ЕстьЗаписьОсновной=смартОбработкаПодписокНаСобытия.ПолучитьТекЗаписьНапоминания(Менеджер,Док);
 					//--#1214 смарт: Лопато 10.10.2022
                    Если НЕ ЕстьЗаписьОсновной Тогда
                        ПараметрыНапоминания=Новый Структура;
 						//++#1214 смарт: Лопато 10.10.2022 //Рефакторинг в связи с ошибками  
						//ПараметрыНапоминания.Вставить("Пользователь",Док.Менеджер);
                        ПараметрыНапоминания.Вставить("Пользователь",Менеджер);
 						//--#1214 смарт: Лопато 10.10.2022
                        ПараметрыНапоминания.Вставить("Источник",Док);
