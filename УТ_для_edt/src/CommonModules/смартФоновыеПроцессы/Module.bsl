    |	ВременнаяТаблица КАК ВременнаяТаблица
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СвободныеОстатки.Остатки(, Склад = &Склад) КАК СвободныеОстатки
    |		ПО (ВременнаяТаблица.Номенклатура = СвободныеОстатки.Номенклатура)
    |			И (ВременнаяТаблица.Характеристика = СвободныеОстатки.Характеристика)";
    
    Запрос.УстановитьПараметр("ТЗТовары",ТЗТовары);  
    Запрос.УстановитьПараметр("Склад",Склад);  
    Результат = Запрос.Выполнить(); 
    
    Если Не Результат.Пустой() Тогда
        Возврат Результат.Выгрузить();	
    КонецЕсли;  
    
    Возврат Неопределено;
    
