//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
Процедура ЗаполнениеРеквизитовКонтрагентаПоИНН(Параметры, Адрес) Экспорт
	
	Если ЗначениеЗаполнено(Параметры.СсылкаКонтарегнт) Тогда
		Ссылка = Параметры.СсылкаКонтарегнт;
	Иначе
		Возврат
	КонецЕсли;
	
	//++ 04.11.2020
	Если Ссылка.смартНеОбновлятьКППВноситБухгалтерия Тогда
		Возврат;
	КонецЕсли;
	//-- 
	
	ИмяСобытияДляЖР = "ОбновлениеИнформацииОКонтрагентахПоДаннымФНС_смартФоновоеЗадание";
	МассивСообщений = Новый Массив;
	ТекстСообщения = "";
	
	Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(Ссылка.ИНН, ОбщегоНазначенияУТКлиентСервер.ЭтоЮрЛицо(Ссылка.ЮрФизЛицо), ТекстСообщения) Тогда
		
		ТекстОшибки = "Контрагент " + Ссылка + ": " + ТекстСообщения; 
		МассивСообщений.Добавить(ТекстОшибки);
		ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР, УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	НастройкиПодключенияКСервисуИППЗаданы = ПартнерыИКонтрагенты.НастройкиПодключенияКСервисуИППЗаданы();
	
	ЗаполнениеРеквизитовПоДаннымИННВозможно = СамообслуживаниеКлиентСервер.ЗаполнениеРеквизитовПоДаннымИННВозможно(
	Истина,
	НастройкиПодключенияКСервисуИППЗаданы,
	Истина,
	Ложь,
	Ссылка.ОбособленноеПодразделение);
	
	Если НЕ ЗаполнениеРеквизитовПоДаннымИННВозможно Тогда
		Возврат;
	КонецЕсли;
	
	ФоновоеЗаданиеИдентификатор = "";
	
	РеквизитыКонтрагента = ПартнерыИКонтрагентыВызовСервера.ДанныеКонтрагентаПоИНН(
	ОбщегоНазначенияУТКлиентСервер.ЭтоЮрЛицо(Ссылка.ЮрФизЛицо), //13.10.2020
	Ссылка.ИНН,
	ФоновоеЗаданиеИдентификатор);
	
	ВыполнитьЗаполнениеРеквизитовПоИНН(РеквизитыКонтрагента,, Ссылка, МассивСообщений);
	
КонецПроцедуры //-- смарт:ММ 08.10.2020

