&НаСервере
Процедура смартЗаполнитьОплатыВЗаказах(ТЗГрафикОтгрузки)
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   ТЗ.ДатаОтгрузки КАК ДатаОтгрузки,
    |   ТЗ.КоличествоОтгрузка КАК КоличествоОтгрузка,
    |   ТЗ.Документ КАК Документ
    |ПОМЕСТИТЬ ВТ
    |ИЗ
    |   &ТЗ КАК ТЗ
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
    |   ВТ.КоличествоОтгрузка КАК КоличествоОтгрузка,
    |   ВТ.Документ КАК Документ,
    |   РасчетыСКлиентамиПланОплатОстаткиИОбороты.Период КАК ДатаОплаты
    |ПОМЕСТИТЬ Оплаты
    |ИЗ
    |   ВТ КАК ВТ
    |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПланОплат.ОстаткиИОбороты(, , Регистратор, , ) КАК РасчетыСКлиентамиПланОплатОстаткиИОбороты
    |       ПО ВТ.Документ = РасчетыСКлиентамиПланОплатОстаткиИОбороты.ОбъектРасчетов
    |ГДЕ
    |   РасчетыСКлиентамиПланОплатОстаткиИОбороты.КОплатеРасход > 0
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   ВТ.ДатаОтгрузки КАК ДатаОтгрузки,
    |   ВТ.КоличествоОтгрузка КАК КоличествоОтгрузка,
    |   ВТ.Документ КАК Документ,
    |   Оплаты.ДатаОплаты КАК ДатаОплаты
    |ИЗ
    |   ВТ КАК ВТ
    |       ЛЕВОЕ СОЕДИНЕНИЕ Оплаты КАК Оплаты
    |       ПО ВТ.Документ = Оплаты.Документ
    |
    |УПОРЯДОЧИТЬ ПО
    |   ДатаОплаты";
    
    Запрос.УстановитьПараметр("ТЗ", ТЗГрафикОтгрузки);
    
    РезультатЗапроса = Запрос.Выполнить();
    
    ТЗГрафикОтгрузки = РезультатЗапроса.Выгрузить();
    
КонецПроцедуры//-- смарт:Подкин #1134 10.08.2022 12:37:24

//++ смарт:ММ #059 327 05.10.2020 - Перенос даты резерва, спр. Грузы 
Функция ПолучитьНомерВерсииПоследний(СсылкаНаОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Максимум(ВерсииОбъектов.НомерВерсии) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВерсииОбъектов.Объект";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);

	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НомерВерсии;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 05.10.2020

