	|	CRM_Интерес.Ссылка КАК ИнтересДокумент,
	|	CRM_Интерес.Номер КАК ИнтересНомер,
	|	CRM_Интерес.Партнер КАК ИнтересПартнер,
	|	ДокументЛид.Ссылка КАК ИнтересЛид,
	|	ВЫБОР
	|		КОГДА ДЛИНАСТРОКИ(ЕСТЬNULL(ДокументЛид.Телефон, """")) = 11
	|				И ПОДСТРОКА(ЕСТЬNULL(ДокументЛид.Телефон, """"), 1, 1) = ""8""
	|			ТОГДА ""7"" + ПОДСТРОКА(ДокументЛид.Телефон, 2, 10)
	|		КОГДА ДЛИНАСТРОКИ(ЕСТЬNULL(ДокументЛид.Телефон, """")) = 10
	|			ТОГДА ""7"" + ДокументЛид.Телефон
	|		ИНАЧЕ ЕСТЬNULL(ДокументЛид.Телефон, """")
	|	КОНЕЦ КАК ИнтересЛидТелефон
	|ПОМЕСТИТЬ ВТ_Интерес
	|ИЗ
	|	Документ.CRM_Интерес КАК CRM_Интерес
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЛид КАК ДокументЛид
	|		ПО ВЫРАЗИТЬ(CRM_Интерес.Ссылка.ДокументОснование КАК Документ.смартЛид) = ДокументЛид.Ссылка
	|ГДЕ
	|	CRM_Интерес.Ссылка = &ИнтересСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Интерес.ИнтересДокумент КАК ИнтересДокумент,
	|	ВТ_Интерес.ИнтересНомер КАК ИнтересНомер,
	|	ВТ_Интерес.ИнтересПартнер КАК ИнтересПартнер,
	|	ВТ_Интерес.ИнтересЛид КАК ИнтересЛид,
	|	ВТ_Интерес.ИнтересЛидТелефон КАК ИнтересЛидТелефон,
	|	ТелефонныйЗвонок.Ссылка КАК ТелефонныйЗвонок,
	|	ТелефонныйЗвонок.Дата КАК ТелефонныйЗвонокДата,
	|	ЕСТЬNULL(ДопСведения_ЭтапИнтереса.Значение, """") КАК ЭтапИнтересаЗначениеТекущее,
	|	ЕСТЬNULL(ДопСведения_НомерИнтереса.Значение, """") КАК НомерИнтересаЗначениеТекущее,
	|	ЕСТЬNULL(ДопСведения_ПричинаОтказа.Значение, """") КАК ПричинаОтказаЗначениеТекущее
	|ИЗ
	|	ВТ_Интерес КАК ВТ_Интерес
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	|		ПО (ВЫБОР
	|				КОГДА ВЫРАЗИТЬ(ВТ_Интерес.ИнтересЛид.ДокументОснование КАК Документ.ТелефонныйЗвонок) <> ЗНАЧЕНИЕ(Документ.ТелефонныйЗвонок.ПустаяСсылка) ТОГДА
	|						  ВЫРАЗИТЬ(ВТ_Интерес.ИнтересЛид.ДокументОснование КАК Документ.ТелефонныйЗвонок) = ТелефонныйЗвонок.Ссылка
	|				КОГДА ТИПЗНАЧЕНИЯ(ТелефонныйЗвонок.АбонентКонтакт) = ТИП(Справочник.Партнеры)
	|						И (ВЫРАЗИТЬ(ТелефонныйЗвонок.АбонентКонтакт КАК Справочник.Партнеры)) <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|						И ВТ_Интерес.ИнтересПартнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|					ТОГДА (ВЫРАЗИТЬ(ТелефонныйЗвонок.АбонентКонтакт КАК Справочник.Партнеры)) = ВТ_Интерес.ИнтересПартнер
	|				ИНАЧЕ ТелефонныйЗвонок.АбонентКакСвязаться = ВТ_Интерес.ИнтересЛидТелефон
	|			КОНЕЦ)
	|			И (ТелефонныйЗвонок.Дата <= &ДатаСостоянияОбращения)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения_ЭтапИнтереса
	|			ПО ВЫРАЗИТЬ(ДопСведения_ЭтапИнтереса.Объект КАК Документ.ТелефонныйЗвонок) = ТелефонныйЗвонок.Ссылка
	|			И ДопСведения_ЭтапИнтереса.Свойство = &ТегРечевойАналитики_ЭтапИнтереса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения_НомерИнтереса
	|			ПО ВЫРАЗИТЬ(ДопСведения_НомерИнтереса.Объект КАК Документ.ТелефонныйЗвонок) = ТелефонныйЗвонок.Ссылка
	|			И ДопСведения_НомерИнтереса.Свойство = &ТегРечевойАналитики_НомерИнтереса
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения_ПричинаОтказа
	|			ПО ВЫРАЗИТЬ(ДопСведения_ПричинаОтказа.Объект КАК Документ.ТелефонныйЗвонок) = ТелефонныйЗвонок.Ссылка
	|			И ДопСведения_ПричинаОтказа.Свойство = &ТегРечевойАналитики_ПричинаОтказа
	|УПОРЯДОЧИТЬ ПО
	|	ТелефонныйЗвонокДата УБЫВ";

	Запрос.УстановитьПараметр("ИнтересСсылка", 					   Параметры.Интерес);
	Запрос.УстановитьПараметр("ДатаСостоянияОбращения", 		   Параметры.Период);
	Запрос.УстановитьПараметр("ТегРечевойАналитики_ПричинаОтказа", ТегРечевойАналитики_ПричинаОтказа);
	Запрос.УстановитьПараметр("ТегРечевойАналитики_НомерИнтереса", ТегРечевойАналитики_НомерИнтереса);
	Запрос.УстановитьПараметр("ТегРечевойАналитики_ЭтапИнтереса",  ТегРечевойАналитики_ЭтапИнтереса);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();

	Если РезультатЗапроса.Следующий() Тогда
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ТелефонныйЗвонок)
			 И НЕ (РезультатЗапроса.ПричинаОтказаЗначениеТекущее = "Нецелевой клиент"
		    	   И РезультатЗапроса.ЭтапИнтересаЗначениеТекущее = "Завершен неудачно"
				   И СокрЛП(РезультатЗапроса.НомерИнтересаЗначениеТекущее) = СокрЛП(РезультатЗапроса.ИнтересНомер)) Тогда
			
			ТаблицаДопСвойств = Новый ТаблицаЗначений;
			ТаблицаДопСвойств.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
			ТаблицаДопСвойств.Колонки.Добавить("Значение");
			
			//Причина отказа
			НовоеСвойство = ТаблицаДопСвойств.Добавить();
			НовоеСвойство.Свойство = ТегРечевойАналитики_ПричинаОтказа;
			НовоеСвойство.Значение = "Нецелевой клиент";

			//Этап интереса
			НовоеСвойство = ТаблицаДопСвойств.Добавить();
			НовоеСвойство.Свойство = ТегРечевойАналитики_ЭтапИнтереса;
			НовоеСвойство.Значение = "Завершен неудачно";
			
			//Номер интереса
			НовоеСвойство = ТаблицаДопСвойств.Добавить();
			НовоеСвойство.Свойство = ТегРечевойАналитики_НомерИнтереса;
			НовоеСвойство.Значение = РезультатЗапроса.ИнтересНомер;

			//Дата изменения
			СвойствоДатаИзмененияТэговIMOT = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ДатаИзмененияТэговIMOT");
			ДатаИзменения = ТекущаяДата();
			
			НовоеСвойство = ТаблицаДопСвойств.Добавить();
			НовоеСвойство.Свойство = СвойствоДатаИзмененияТэговIMOT;
			НовоеСвойство.Значение = ДатаИзменения;
					
			Попытка
				УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(РезультатЗапроса.ТелефонныйЗвонок, ТаблицаДопСвойств);
			Исключение
				ЗаписьЖурналаРегистрации("Ошибка записи тэгов звонка", УровеньЖурналаРегистрации.Ошибка, , , 
										 "Ошибка записи тэгов звонка " + СокрЛП(РезультатЗапроса.ТелефонныйЗвонок));
			КонецПопытки;
					
		КонецЕсли;	
			
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-1352 смарт: Лопато 25.11.2024

