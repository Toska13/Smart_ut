                    КонецЕсли;
                    МассивСтрокИндексы.Добавить(Об.Товары.Индекс(стр));
                КонецЕсли; 
            КонецЦикла;
            
            ИзменитьОбеспечение=Ложь;
            Текст="";
            Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") И МассивСтрокИндексы.Количество() И ЕстьДоступно 
