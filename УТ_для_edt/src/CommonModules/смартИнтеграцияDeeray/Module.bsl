#Область РасчетТегов

Процедура РассчитатьТеги(Пересчитать) Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОбменССервисомРечевойАналитикиDeeray.Ссылка КАК Узел,
	|	смартОбменССервисомРечевойАналитикиDeeray.ХранилищеСхемыКомпоновкиДанных КАК ХранилищеСхемыКомпоновкиДанных,
	|	смартОбменССервисомРечевойАналитикиDeeray.ХранилищеНастроекКомпоновкиДанных КАК ХранилищеНастроекКомпоновкиДанных,
	|	смартОбменССервисомРечевойАналитикиDeeray.ДатаНачала КАК ДатаНачала
	|ИЗ
	|	ПланОбмена.смартОбменССервисомРечевойАналитикиDeeray КАК смартОбменССервисомРечевойАналитикиDeeray
	|ГДЕ
	|	НЕ смартОбменССервисомРечевойАналитикиDeeray.ЭтотУзел
	|	И смартОбменССервисомРечевойАналитикиDeeray.Активно
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Ссылка КАК Узел,
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Тег КАК Тег,
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Тег.ИдентификаторДляФормул КАК ИдентификаторДляФормул
	|ИЗ
	|	ПланОбмена.смартОбменССервисомРечевойАналитикиDeeray.ВыгружаемыеТеги КАК смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги";
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаУзлов = РезультатЗапроса[0].Выгрузить(); 
	ТаблицаТегов = РезультатЗапроса[1].Выгрузить();
	
	Для Каждого СтрокаУзла Из ТаблицаУзлов Цикл 
		
		ПараметрыРасчета = Новый Структура("Узел, ХранилищеСхемыКомпоновкиДанных, ХранилищеНастроекКомпоновкиДанных, ДатаНачала");
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, СтрокаУзла);
		НайденныеСтроки = ТаблицаТегов.НайтиСтроки(Новый Структура("Узел", СтрокаУзла.Узел));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ПараметрыРасчета.Вставить("ИдентификаторДляФормул", НайденнаяСтрока.ИдентификаторДляФормул);
			ТаблицаТелефонныхЗвонков = ВыбратьДанныеДляРасчетаТегов(ПараметрыРасчета, Пересчитать);
		    ТаблицаРезультат = РассчитатьЗначениеТега(ТаблицаТелефонныхЗвонков.ВыгрузитьКолонку("ТелефонныйЗвонок"), НайденнаяСтрока.Тег);
			ЗаписатьСвойства(ТаблицаРезультат);
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры  

Процедура РассчитатьТегУзла(Пересчитать, Узел, Тег) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОбменССервисомРечевойАналитикиDeeray.Ссылка КАК Узел,
	|	смартОбменССервисомРечевойАналитикиDeeray.ХранилищеСхемыКомпоновкиДанных КАК ХранилищеСхемыКомпоновкиДанных,
	|	смартОбменССервисомРечевойАналитикиDeeray.ХранилищеНастроекКомпоновкиДанных КАК ХранилищеНастроекКомпоновкиДанных,
	|	смартОбменССервисомРечевойАналитикиDeeray.ДатаНачала КАК ДатаНачала
	|ИЗ
	|	ПланОбмена.смартОбменССервисомРечевойАналитикиDeeray КАК смартОбменССервисомРечевойАналитикиDeeray
	|ГДЕ
	|	НЕ смартОбменССервисомРечевойАналитикиDeeray.ЭтотУзел
	|	И смартОбменССервисомРечевойАналитикиDeeray.Активно
	|	И смартОбменССервисомРечевойАналитикиDeeray.Ссылка = &Узел
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Ссылка КАК Узел,
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Тег КАК Тег,
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Тег.ИдентификаторДляФормул КАК ИдентификаторДляФормул
	|ИЗ
	|	ПланОбмена.смартОбменССервисомРечевойАналитикиDeeray.ВыгружаемыеТеги КАК смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги
	|ГДЕ
	|	смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Ссылка = &Узел
	|	И смартОбменССервисомРечевойАналитикиDeerayВыгружаемыеТеги.Тег = &Тег";
	Запрос.УстановитьПараметр("Узел", Узел);
	Запрос.УстановитьПараметр("Тег", Тег);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТаблицаУзлов = РезультатЗапроса[0].Выгрузить(); 
	ТаблицаТегов = РезультатЗапроса[1].Выгрузить();
	
	Для Каждого СтрокаУзла Из ТаблицаУзлов Цикл 
		
		ПараметрыРасчета = Новый Структура("Узел, ХранилищеСхемыКомпоновкиДанных, ХранилищеНастроекКомпоновкиДанных, ДатаНачала");
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета, СтрокаУзла);
		НайденныеСтроки = ТаблицаТегов.НайтиСтроки(Новый Структура("Узел", СтрокаУзла.Узел));
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ПараметрыРасчета.Вставить("ИдентификаторДляФормул", НайденнаяСтрока.ИдентификаторДляФормул);
			ТаблицаТелефонныхЗвонков = ВыбратьДанныеДляРасчетаТегов(ПараметрыРасчета, Пересчитать);
		    ТаблицаРезультат = РассчитатьЗначениеТега(ТаблицаТелефонныхЗвонков.ВыгрузитьКолонку("ТелефонныйЗвонок"), НайденнаяСтрока.Тег);
			ЗаписатьСвойства(ТаблицаРезультат);
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры  

Процедура РассчитатьТегУзлаТелефонногоЗвонка(Тег, ТелефонныйЗвонок) Экспорт	
	
	ТаблицаРезультат = РассчитатьЗначениеТега(ТелефонныйЗвонок, Тег);
	ЗаписатьСвойства(ТаблицаРезультат);

КонецПроцедуры  

Функция ВыбратьДанныеДляРасчетаТегов(Реквизиты, Пересчитать)
	
	// Схема компоновки данных
	СхемаКомпоновкиДанных 	= Реквизиты.ХранилищеСхемыКомпоновкиДанных.Получить();
	
	Если НЕ Пересчитать Тогда  //берем только без свойства
		СоединенияТаблицПолейТегов = СтрШаблон("
										|ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЗначенияЗвонков КАК ВложенныйЗапрос%1
										|	ПО (ВложенныйЗапрос%1.Объект = ВТ_Звонки.ТелефонныйЗвонок)
										|	И (ВложенныйЗапрос%1.ИдентификаторДляФормул = ""%1"")", 
										Реквизиты.ИдентификаторДляФормул); 
		Условие	= СтрШаблон(" ГДЕ ВложенныйЗапрос%1.Объект ЕСТЬ NULL", Реквизиты.ИдентификаторДляФормул);
	
		ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%СоединенияТаблицПолейТегов%", СоединенияТаблицПолейТегов);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//%Условие%", Условие);
		СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Запрос = ТекстЗапроса;
	КонецЕсли;
	
	// Загрузка настроек
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	
	НастройкиКомпоновкиДанных = Реквизиты.ХранилищеНастроекКомпоновкиДанных.Получить();
	Если НастройкиКомпоновкиДанных <> Неопределено Тогда
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновкиДанных);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КонецЕсли;
	КомпоновщикНастроек.Восстановить();
	
	// Установка параметров данных
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("Узел");
	ПараметрКомпановкиДанных.Значение = Реквизиты.Узел;
	ПараметрКомпановкиДанных.Использование = Истина;
	
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ОтбиратьТолькоИзменения");
	ПараметрКомпановкиДанных.Значение = Ложь;
	ПараметрКомпановкиДанных.Использование = Истина;
	
	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("ДатаНачала");
	ПараметрКомпановкиДанных.Значение = Реквизиты.ДатаНачала;
	ПараметрКомпановкиДанных.Использование = Истина;	

	ПараметрКомпановкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы.Найти("РодительСостояниеИнтереса");
	ПараметрКомпановкиДанных.Значение = Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Продажа Оборудования, Материалов, ЗЧ");
	ПараметрКомпановкиДанных.Использование = Истина;	
    
	// Компоновка макета
	КомпоновщикМакетаКомпоновкиДанных = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакетаКомпоновкиДанных.Выполнить(СхемаКомпоновкиДанных, КомпоновщикНастроек.Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	// Инициализация процессора компоновки
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных);
	
	// Таблица значений, в которую будет получен результат
	Результат = Новый ТаблицаЗначений;
	
	// Получение результата
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений.УстановитьОбъект(Результат);
	ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Результат;
	
КонецФункции  

Функция РассчитатьЗначениеТега(ТелефонныйЗвонок, Тег) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Тег) Тогда  
		Возврат Неопределено;
	КонецЕсли;  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тег", Тег);
	Если ТипЗнч(ТелефонныйЗвонок) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("ТелефонныеЗвонки", ТелефонныйЗвонок);				
	Иначе  
		ТелефонныеЗвонки = Новый Массив; 
		ТелефонныеЗвонки.Добавить(ТелефонныйЗвонок);
		Запрос.УстановитьПараметр("ТелефонныеЗвонки", ТелефонныеЗвонки);
	КонецЕсли;
	ТекстыЗапросов = Новый Массив();
	
	ИдентификаторДляФормул = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Тег, "ИдентификаторДляФормул");
	Если ИдентификаторДляФормул = "ТегРечевойАналитики_ЭтапИнтереса" Тогда
						
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСТегамиТекущими());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСостоянияИнтересовИтог());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		ТекстЗапросаИтоги = "ВЫБРАТЬ
		|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
		|	ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересСостояниеНаименование КАК ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗвонкиСостоянияИнтересовИтог КАК ВТ_ЗвонкиСостоянияИнтересовИтог
		|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ЗвонкиСостоянияИнтересовИтог.ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики"; 
		ТекстыЗапросов.Добавить(ТекстЗапросаИтоги);
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		Запрос.УстановитьПараметр("ПустоеЗначение", "");
		Запрос.УстановитьПараметр("РодительСостояниеИнтереса", Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Продажа Оборудования, Материалов, ЗЧ"));
		
	ИначеЕсли ИдентификаторДляФормул = "ТегРечевойАналитики_НомерИнтереса" Тогда 
		
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСТегамиТекущими());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСостоянияИнтересовИтог());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		ТекстЗапросаИтоги = "ВЫБРАТЬ
		|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
		|	ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересНомер КАК ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗвонкиСостоянияИнтересовИтог КАК ВТ_ЗвонкиСостоянияИнтересовИтог
		|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ЗвонкиСостоянияИнтересовИтог.ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики"; 
		ТекстыЗапросов.Добавить(ТекстЗапросаИтоги);
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		Запрос.УстановитьПараметр("ПустоеЗначение", "");
		Запрос.УстановитьПараметр("РодительСостояниеИнтереса", Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Продажа Оборудования, Материалов, ЗЧ"));
		
	ИначеЕсли ИдентификаторДляФормул = "ТегРечевойАналитики_Квалификация" Тогда 		
			
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСТегамиТекущими());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСостоянияИнтересовИтог());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		ТекстЗапросаИтоги = "ВЫБРАТЬ
		|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
		|	ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересКвалификация КАК ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗвонкиСостоянияИнтересовИтог КАК ВТ_ЗвонкиСостоянияИнтересовИтог
		|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ЗвонкиСостоянияИнтересовИтог.ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики"; 
		ТекстыЗапросов.Добавить(ТекстЗапросаИтоги);
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		Запрос.УстановитьПараметр("ПустоеЗначение", "");
		Запрос.УстановитьПараметр("РодительСостояниеИнтереса", Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Продажа Оборудования, Материалов, ЗЧ"));
		
	ИначеЕсли ИдентификаторДляФормул = "ТегРечевойАналитики_БизнесРегион" Тогда
		
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСТегамиТекущими());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСостоянияИнтересовИтог());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		ТекстЗапросаИтоги = "ВЫБРАТЬ
		|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
		|	ВЫБОР 
		|		КОГДА ЕСТЬNULL(ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересПартнерБизнесРегион, """") <> """"
		|			ТОГДА ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересПартнерБизнесРегион
		|		КОГДА ТИПЗНАЧЕНИЯ(ЕСТЬNULL(ВТ_ЗвонкиСостоянияИнтересовИтог.АбонентКонтакт, """")) = ТИП(Справочник.Партнеры) 
		|			ТОГДА ВТ_ЗвонкиСостоянияИнтересовИтог.АбонентКонтакт.БизнесРегион.Наименование
		|		КОГДА ТИПЗНАЧЕНИЯ(ВТ_Звонки.АбонентКонтакт) = ТИП(Справочник.Партнеры)
		|			ТОГДА ВТ_Звонки.АбонентКонтакт.БизнесРегион.Наименование
		|		ИНАЧЕ """"		
		|	КОНЕЦ КАК ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
