
#Область ПрограммныйИнтерфейс

Процедура ВыполнитьОбменССервисомРечевойАналитикиDeeray() Экспорт
	
	МассивУзлов = ПолучитьМассивУзлов();	
	Для Каждого УзелОбмена Из МассивУзлов Цикл 	
		ЗагрузитьДанные(УзелОбмена);
		ВыгрузитьДанные(УзелОбмена);  	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#Область Обмен

// Процедура - Процедура регистрирует изменения при записи справочников и документов//  
Процедура ЗарегистрироватьИзмененияПриЗаписиСправочникаДокументаДляОбмена(Источник, Отказ) Экспорт
	
	Если НЕ Отказ Тогда
		
		ЗарегистрироватьИзменения(Источник);
		
	КонецЕсли;	
	
КонецПроцедуры  

// Процедура - Процедура регистрирует изменения перед записью регистров//  
Процедура ЗарегистрироватьИзмененияПриЗаписиРегистраСведенийДляОбмена(Источник, Отказ, Замещение) Экспорт
	
	Если НЕ Отказ Тогда
		
		ЗарегистрироватьИзменения(Источник, Замещение);
		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗарегистрироватьИзменения(Объект, Замещение = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);

	МассивУзлов = ПолучитьМассивУзлов(); 	
	Если МассивУзлов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ТипОбъекта = ТипЗнч(Объект);

	МассивОбъектовДляРегистрации = Новый Массив;
	
	Если ТипОбъекта = Тип("РегистрСведенийНаборЗаписей.ДополнительныеСведения") тогда 
		
		Для Каждого Запись Из Объект Цикл
			
			Если ТипЗнч(Запись.Объект) = Тип("ДокументСсылка.ТелефонныйЗвонок") Тогда
				МассивОбъектовДляРегистрации.Добавить(Запись.Объект);
			КонецЕсли;
			
		КонецЦикла;										   
		
	КонецЕсли;
	
	//Регистрация объектов на узлах
	Если МассивОбъектовДляРегистрации.Количество() > 0 Тогда
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзлов, МассивОбъектовДляРегистрации);

	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьМассивУзлов() 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартОбменССервисомРечевойАналитикиDeeray.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.смартОбменССервисомРечевойАналитикиDeeray КАК смартОбменССервисомРечевойАналитикиDeeray
	|ГДЕ
	|	НЕ смартОбменССервисомРечевойАналитикиDeeray.ЭтотУзел
	|	И НЕ смартОбменССервисомРечевойАналитикиDeeray.ПометкаУдаления
	|	И смартОбменССервисомРечевойАналитикиDeeray.Активно";  
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
КонецФункции

#КонецОбласти  

Функция ПолучитьДанныеФайлаJSONТелефонногоЗвонка(ТелефонныйЗвонок) Экспорт  
	РасположениеПапкиФайловDEERAY 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.смартПредопределенныеЗначения.Настройки, "РасположениеПапкиФайловDEERAY"); 
	смартИдентификаторDeeray 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТелефонныйЗвонок, "смартидентификаторDeeray");
	
	ИмяФайла = СтрШаблон("%1%2.json", РасположениеПапкиФайловDEERAY, смартИдентификаторDeeray);

	Возврат смартИнтеграцияDeeray.ПолучитьДанныеJSON(ИмяФайла);
КонецФункции

Функция ПолучитьДанныеJSON(ИмяФайла) Экспорт
	
	Файл = Новый Файл(ИмяФайла);
	
	Если НЕ Файл.Существует() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.ОткрытьФайл(ИмяФайла);
	Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();
	
	Возврат Данные; 
	
КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗагрузкаДанных      

Процедура ЗагрузитьДанные(УзелОбмена) Экспорт
	НастройкиЗагрузки = ПолучитьНастройкиЗагрузки(УзелОбмена);
	РезультатЗагрузки = "";
	Если НастройкиЗагрузки.ЭтоТестоваяБаза Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиЗагрузки.Каталог) Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Начало загрузки файлов из сервиса речевой аналитики Deeray'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация);
	Для Итерация = 1 По 10 Цикл
		ДанныеФайлов	  = ПрочитатьДанныеФайлов(НастройкиЗагрузки);
		Если ДанныеФайлов.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ИдентифицироватьТелефонныеЗвонки(ДанныеФайлов);
		ЗаписатьДанныеВРегистры(ДанныеФайлов);
	
		РезультатЗагрузки = РезультатЗагрузки + ОбработатьРезультатыЗагрузки(ДанныеФайлов, Итерация); 
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Окончание загрузки файлов из сервиса речевой аналитики Deeray'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация,,, РезультатЗагрузки);
КонецПроцедуры 

Функция ПолучитьНастройкиЗагрузки(УзелОбмена) 
	Настройки = Новый Структура; 	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УзелОбмена, 
		"ПутьКФайламЗагрузки"); 
	Настройки.Вставить("Каталог",			Реквизиты.ПутьКФайламЗагрузки);
	Настройки.Вставить("ЭтоТестоваяБаза",	НЕ смартОбщегоНазначения.смартРабочаяБаза());
	Настройки.Вставить("Порция",			10000);
	Возврат Настройки;
КонецФункции 

Функция ОбработатьРезультатыЗагрузки(ДанныеФайлов, Итерация) 
	Результат = "";
	КоличествоФайловВсего = ДанныеФайлов.Количество();
	КоличествоУспешноЗагруженных = 0;
	КоличествоБезТелефонныхЗвонков = 0;
	КоличествоНетДанных = 0;
	КоличествоНетСценариев = 0;
	КоличествоОшибкиСценариев = 0;
	КоличествоОшибкиЗаписиДанных = 0;
	
	Для Каждого СтрокаФайла Из ДанныеФайлов Цикл 
		УдалитьФайл = Ложь;
		Если СтрокаФайла.РезультатЗагрузкиСценариев = "Загружены"
			И СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Загружены" Тогда
			КоличествоУспешноЗагруженных = КоличествоУспешноЗагруженных + 1;
			УдалитьФайл = Истина;
		КонецЕсли;
		
		Если НЕ СтрокаФайла.ТелефонныйЗвонокНайден Тогда
			КоличествоБезТелефонныхЗвонков = КоличествоБезТелефонныхЗвонков + 1;
			УдалитьФайл = Истина;
		КонецЕсли;
		
		Если НЕ СтрокаФайла.РезультатЧтенияФайла Тогда
			КоличествоНетДанных = КоличествоНетДанных + 1;
			УдалитьФайл = Истина;
		КонецЕсли;
		
		Если СтрокаФайла.РезультатЗагрузкиСценариев = "Нет сценариев"
			И СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Загружены" Тогда
			КоличествоНетСценариев = КоличествоНетСценариев + 1;
			УдалитьФайл = Истина;
		КонецЕсли; 
		
		Если УдалитьФайл Тогда
			УдалитьФайлы(СтрокаФайла.ИмяФайла);
		КонецЕсли;
		
        Если СтрокаФайла.РезультатЗагрузкиСценариев = "Ошибка записи" Тогда
			КоличествоОшибкиСценариев = КоличествоОшибкиСценариев + 1;
		КонецЕсли; 

		Если СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Ошибка записи" Тогда
			КоличествоОшибкиЗаписиДанных = КоличествоОшибкиЗаписиДанных + 1;
		КонецЕсли; 

	КонецЦикла;   
	
	Возврат СтрШаблон("В итерации %1 всего обработано %2 файлов,
						|из них успешно загружены %3,
						|не найдено телефонных звонков на %4 файлов,
						|не найдено data в %5 файлах,
						|не найдено сценариев в %6 файлах,
						|ошибок записи сценариев %7,
						|ошибок записи суммарных данных %8
						|",
						Итерация,
						КоличествоФайловВсего,
						КоличествоУспешноЗагруженных,
						КоличествоБезТелефонныхЗвонков,
						КоличествоНетДанных,
						КоличествоНетСценариев,
						КоличествоОшибкиСценариев,
						КоличествоОшибкиЗаписиДанных);
КонецФункции 

Функция ПрочитатьДанныеФайлов(НастройкиЗагрузки) 
	Результат 	 = ИнициализироватьТаблицуРезультатаЗагрузки();
    НомерФайла	 = 0;
	МассивФайлов = НайтиФайлы(НастройкиЗагрузки.Каталог, "*.json", Ложь);
    Для Каждого ЭлементФайл Из МассивФайлов Цикл             
		НоваяСтрока 					 = Результат.Добавить();	
		НоваяСтрока.Идентификатор 		 = ЭлементФайл.ИмяБезРасширения;
		НоваяСтрока.ИмяФайла	 		 = ЭлементФайл.ПолноеИмя;
		НоваяСтрока.ДанныеФайла 		 = ПолучитьЗначениеИзФайлаJSON(ЭлементФайл.ПолноеИмя);
		НоваяСтрока.РезультатЧтенияФайла = НЕ НоваяСтрока.ДанныеФайла = Неопределено; 
		
		НомерФайла = НомерФайла + 1;
		Если НомерФайла = НастройкиЗагрузки.Порция Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла; 

	Возврат Результат;
КонецФункции  

Функция ИнициализироватьТаблицуРезультатаЗагрузки() 
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100)));
	ТаблицаРезультата.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(100))); 
	
	ТаблицаРезультата.Колонки.Добавить("ДанныеФайла");
	ТаблицаРезультата.Колонки.Добавить("ТелефонныйЗвонок");
	ТаблицаРезультата.Колонки.Добавить("Интерес");
	ТаблицаРезультата.Колонки.Добавить("ПервыйКонтакт");
	ТаблицаРезультата.Колонки.Добавить("ЭтапИнтереса");
	ТаблицаРезультата.Колонки.Добавить("ЦелевойЗвонок");
	
	ТаблицаРезультата.Колонки.Добавить("ТелефонныйЗвонокНайден", Новый ОписаниеТипов("Булево"));
	ТаблицаРезультата.Колонки.Добавить("РезультатЧтенияФайла", Новый ОписаниеТипов("Булево"));
	ТаблицаРезультата.Колонки.Добавить("РезультатЗагрузкиСценариев", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("РезультатЗагрузкиСуммарныхДанных", Новый ОписаниеТипов("Строка"));
	ТаблицаРезультата.Колонки.Добавить("МассивОшибок");
	Возврат ТаблицаРезультата;
КонецФункции   

Функция ПолучитьЗначениеИзФайлаJSON(ФайлJSON)
	
	Результат = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ФайлJSON);
	
	Попытка
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
	Исключение
	КонецПопытки;
	
	Возврат	Результат;
	
КонецФункции // ПолучитьПараметрыИзСтроки

Процедура ИдентифицироватьТелефонныеЗвонки(ДанныеФайлов) 
	ИдентификаторыDeeray = ДанныеФайлов.ВыгрузитьКолонку("Идентификатор");
	Если ИдентификаторыDeeray.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТелефонныйЗвонок.Ссылка КАК ТелефонныйЗвонок,
	|	ТелефонныйЗвонок.смартИдентификаторDeeray КАК Идентификатор
	|ПОМЕСТИТЬ ВТ_Звонки
	|ИЗ
	|	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	|ГДЕ
	|	ТелефонныйЗвонок.смартИдентификаторDeeray В(&ИдентификаторыDeeray)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Регистр.Объект КАК Документ.ТелефонныйЗвонок) КАК Объект,
	|	Регистр.Значение КАК Значение,
	|	Свойства.ИдентификаторДляФормул КАК ИдентификаторДляФормул
	|ПОМЕСТИТЬ СвойстваЗначенияЗвонков
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК Свойства
	|		ПО (Свойства.Ссылка = Регистр.Свойство)
	|			И (Свойства.ИдентификаторДляФормул В (""ИнтересGUID"", ""ТегРечевойАналитики_ПервыйКонтакт"", ""ТегРечевойАналитики_ЭтапИнтереса"", ""ТегРечевойАналитики_СозданПоОбращению""))
	|ГДЕ
	|	ВЫРАЗИТЬ(Регистр.Объект КАК Документ.ТелефонныйЗвонок) В
	|			(ВЫБРАТЬ
	|				ВТ_Звонки.ТелефонныйЗвонок
	|			ИЗ
	|				ВТ_Звонки)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект,
	|	ИдентификаторДляФормул
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	ВТ_Звонки.Идентификатор КАК Идентификатор,
	|	ЕСТЬNULL(ВложенныйЗапросИнтересGUID.Значение, """") КАК ИнтересGUID,
	|	ЕСТЬNULL(ВложенныйЗапросТегРечевойАналитики_ПервыйКонтакт.Значение, """") КАК ПервыйКонтакт,
	|	ЕСТЬNULL(ВложенныйЗапросТегРечевойАналитики_ЭтапИнтереса.Значение, """") КАК ЭтапИнтереса
	|ИЗ
	|	ВТ_Звонки КАК ВТ_Звонки
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЗначенияЗвонков КАК ВложенныйЗапросИнтересGUID
	|		ПО (ВложенныйЗапросИнтересGUID.Объект = ВТ_Звонки.ТелефонныйЗвонок)
	|			И (ВложенныйЗапросИнтересGUID.ИдентификаторДляФормул = ""ИнтересGUID"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЗначенияЗвонков КАК ВложенныйЗапросТегРечевойАналитики_ПервыйКонтакт
	|		ПО (ВложенныйЗапросТегРечевойАналитики_ПервыйКонтакт.Объект = ВТ_Звонки.ТелефонныйЗвонок)
	|			И (ВложенныйЗапросТегРечевойАналитики_ПервыйКонтакт.ИдентификаторДляФормул = ""ТегРечевойАналитики_ПервыйКонтакт"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЗначенияЗвонков КАК ВложенныйЗапросТегРечевойАналитики_ЭтапИнтереса
	|		ПО (ВложенныйЗапросТегРечевойАналитики_ЭтапИнтереса.Объект = ВТ_Звонки.ТелефонныйЗвонок)
	|			И (ВложенныйЗапросТегРечевойАналитики_ЭтапИнтереса.ИдентификаторДляФормул = ""ТегРечевойАналитики_ЭтапИнтереса"")";
	
	Запрос.УстановитьПараметр("ИдентификаторыDeeray", ИдентификаторыDeeray);
	ТаблицаТелефонныхЗвонков = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаФайла Из ДанныеФайлов Цикл  	
		НайденныеСтроки = ТаблицаТелефонныхЗвонков.НайтиСтроки(Новый Структура("Идентификатор", СтрокаФайла.Идентификатор));
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаФайла.ТелефонныйЗвонок 		= НайденныеСтроки[0].ТелефонныйЗвонок;
			Если ЗначениеЗаполнено(НайденныеСтроки[0].ИнтересGUID) Тогда
				СтрокаФайла.Интерес 				= Документы.CRM_Интерес.ПолучитьСсылку(Новый УникальныйИдентификатор(НайденныеСтроки[0].ИнтересGUID));
			Иначе 
				СтрокаФайла.Интерес = Неопределено;
			КонецЕсли;
			СтрокаФайла.ПервыйКонтакт 			= ?(НайденныеСтроки[0].ПервыйКонтакт = "Да", Истина, Ложь);
			СтрокаФайла.ЭтапИнтереса 			= НайденныеСтроки[0].ЭтапИнтереса;
			
			СтрокаФайла.ТелефонныйЗвонокНайден 	= Истина;
		Иначе
			СтрокаФайла.ТелефонныйЗвонокНайден 	= Ложь;
		КонецЕсли;    	
	КонецЦикла;
	
КонецПроцедуры 

Функция ПолучитьСценарииDeeray() 
	Результат = Новый Соответствие();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартСценарииDeeray.Ссылка КАК Ссылка,
	|	смартСценарииDeeray.Наименование КАК Наименование
	|ИЗ
	|	Справочник.смартСценарииDeeray КАК смартСценарииDeeray";	
	РезультатЗапроса = Запрос.Выполнить();    
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Вставить(Строка(ВыборкаДетальныеЗаписи.Ссылка.УникальныйИдентификатор()), 
				Новый Структура("Ссылка, Наименование", ВыборкаДетальныеЗаписи.Ссылка, ВыборкаДетальныеЗаписи.Наименование));
	КонецЦикла;
	Возврат Результат;
КонецФункции   

Процедура ЗаписатьДанныеВРегистры(ДанныеФайлов) 

	СценарииDeeray = ПолучитьСценарииDeeray();
	Для Каждого СтрокаФайла Из ДанныеФайлов Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаФайла.ТелефонныйЗвонок) Тогда
