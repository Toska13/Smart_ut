		|			ТОГДА ""Нет"" 
		|		КОГДА ВТ_ЗвонкиСостоянияИнтересовИтог.ИнтересСостояние В (&СостоянияИнтересаДляПервогоКонтакта)
		|			ТОГДА ""Да"" 
		|		ИНАЧЕ
		|			""Нет""
		|	КОНЕЦ КАК  ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗвонкиСостоянияИнтересовИтог КАК ВТ_ЗвонкиСостоянияИнтересовИтог
		|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ЗвонкиСостоянияИнтересовИтог.ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики"; 
		ТекстыЗапросов.Добавить(ТекстЗапросаИтоги);
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		РодительСостояниеИнтереса = Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Продажа Оборудования, Материалов, ЗЧ");
		Запрос.УстановитьПараметр("ПустоеЗначение", "");
		Запрос.УстановитьПараметр("РодительСостояниеИнтереса", РодительСостояниеИнтереса);
		
		СостоянияИнтересаДляПервогоКонтакта = Новый Массив;
		СостояниеИнтереса = Справочники.CRM_СостоянияИнтересов.НайтиПоНаименованию("Неразобранное", Истина, РодительСостояниеИнтереса);
		Если ЗначениеЗаполнено(СостояниеИнтереса) Тогда
			СостоянияИнтересаДляПервогоКонтакта.Добавить(СостояниеИнтереса);
