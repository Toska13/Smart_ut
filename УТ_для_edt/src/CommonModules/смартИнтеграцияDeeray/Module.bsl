Процедура ЗаписатьСвойства(ТаблицаСсылокИЗначений) 
	
	Если НЕ ТипЗнч(ТаблицаСсылокИЗначений) = Тип("ТаблицаЗначений")
		ИЛИ ТаблицаСсылокИЗначений.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	ТэгИнтересGUID = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ИнтересGUID");
	
	НачатьТранзакцию();
	Попытка  
		
		Для Каждого Строка Из ТаблицаСсылокИЗначений Цикл 
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
			ЭлементБлокировки.УстановитьЗначение("Объект", Строка.ТелефонныйЗвонок);
			ЭлементБлокировки.УстановитьЗначение("Свойство", Строка.Тег);
			Блокировка.Заблокировать();
			
			МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Объект = Строка.ТелефонныйЗвонок;
			МенеджерЗаписи.Свойство = Строка.Тег; 
			
			Если ЗначениеЗаполнено(ТэгИнтересGUID) И Строка.Тег = ТэгИнтересGUID И ЗначениеЗаполнено(Строка.ЗначениеТега) Тогда
				МенеджерЗаписи.Значение = СокрЛП(Строка.ЗначениеТега.УникальныйИдентификатор());
			Иначе
				МенеджерЗаписи.Значение = Строка.ЗначениеТега;
			КонецЕсли; 
			
			МенеджерЗаписи.Записать(Истина);  			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон("ru = 'Ошибка записи дополнительных сведений %1 телефонных звонков: %2'", ТаблицаСсылокИЗначений[0].Тег, ОписаниеОшибки());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка записи дополнительных сведений телефонных звонков'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

