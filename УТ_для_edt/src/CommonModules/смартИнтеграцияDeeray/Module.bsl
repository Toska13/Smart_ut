				Для Каждого ДанныеСценария Из ДанныеСценариев Цикл 				
					ИдентификаторСценария = ДанныеСценария.Получить("id");
					НаименованиеСценария  = ДанныеСценария.Получить("name"); 
					ЗначениеСценария 	= ДанныеСценария.Получить("values");
					ПроцентПоСценарию 	= ЗначениеСценария.Получить("percent");
															
					ЗаписатьДанныеСценариевDeeray(ТелефонныйЗвонок, СценарииDeeray, ИдентификаторСценария, НаименованиеСценария, ПроцентПоСценарию);
				КонецЦикла;
				
				СтрокаФайла.РезультатЗагрузкиСценариев = "Загружены";			
			Исключение
				СтрокаФайла.РезультатЗагрузкиСценариев = "Ошибка записи";
			КонецПопытки; 		
		КонецЕсли;
		
		//++ #7224 смарт: Тимофеева 24.06.2026 / Загрузка суммарных данных Deeray. Загружать все данные, независимо от Интереса.
		//Интерес          = СтрокаФайла.Интерес;
		//Если НЕ ЗначениеЗаполнено(Интерес) Тогда
		//	СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Загружены"; //Считаем, что загружены
		//Иначе    		
		//	СсылкаНаПлатформу 	= ДанныеФайла.Получить("url");		
		//	Резюме            	= ДанныеФайла.Получить("summary");
		//	Если ТипЗнч(Резюме) = Тип("Строка") Тогда
		//		РезюмеСтрокой	= Резюме;
		//	ИначеЕсли ТипЗнч(Резюме) = Тип("Массив") Тогда
		//		РезюмеСтрокой	= СтрСоединить(Резюме, "; ")
		//	Иначе
		//		РезюмеСтрокой 	= "";
		//	КонецЕсли;
		//		
		//	Попытка
		//		ЗаписатьДанныеDeeray(СтрокаФайла, СсылкаНаПлатформу, РезюмеСтрокой);
		//		СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Загружены";			
		//	Исключение
		//		СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Ошибка записи";	
		//	КонецПопытки;  
		//КонецЕсли;
		
		СсылкаНаПлатформу 	= ДанныеФайла.Получить("url");		
		Резюме            	= ДанныеФайла.Получить("summary");
		Если ТипЗнч(Резюме) = Тип("Строка") Тогда
			РезюмеСтрокой	= Резюме;
		ИначеЕсли ТипЗнч(Резюме) = Тип("Массив") Тогда
			РезюмеСтрокой	= СтрСоединить(Резюме, "; ")
		Иначе
			РезюмеСтрокой 	= "";
		КонецЕсли;
		
		Попытка
			ЗаписатьДанныеDeeray(СтрокаФайла, СсылкаНаПлатформу, РезюмеСтрокой);
			СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Загружены";			
		Исключение
			СтрокаФайла.РезультатЗагрузкиСуммарныхДанных = "Ошибка записи";	
		КонецПопытки; 
		//-- #7224 смарт: Тимофеева 24.06.2026
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьДанныеСценариевDeeray(ТелефонныйЗвонок, СценарииDeeray, ИдентификаторСценария, НаименованиеСценария, ПроцентПоСценарию) 	
	
	СтруктураСценария = СценарииDeeray.Получить(ИдентификаторСценария);
	Если СценарииDeeray.Получить(ИдентификаторСценария) = Неопределено Тогда
		УникальныйИдентификатор     = Новый УникальныйИдентификатор(ИдентификаторСценария);
		СценарийСсылка 		        = Справочники.смартСценарииDeeray.ПолучитьСсылку(УникальныйИдентификатор);
		
		СценарийОбъект              = Справочники.смартСценарииDeeray.СоздатьЭлемент();
		СценарийОбъект.УстановитьСсылкуНового(СценарийСсылка);
		СценарийОбъект.Наименование = НаименованиеСценария;
		СценарийОбъект.Активно      = Истина;
		СценарийОбъект.Записать();
		
		СценарииDeeray.Вставить(ИдентификаторСценария, Новый Структура("Ссылка, Наименование", СценарийСсылка, НаименованиеСценария)); 
	Иначе
		СценарийСсылка 				= СтруктураСценария.Ссылка;
		Если НЕ СтруктураСценария.Наименование = НаименованиеСценария Тогда
			СценарийОбъект 				= СценарийСсылка.ПолучитьОбъект();
			СценарийОбъект.Наименование = НаименованиеСценария;
			СценарийОбъект.Записать();		
		КонецЕсли; 			
	КонецЕсли;  		
	
	Запись 					= РегистрыСведений.смартДанныеСценариевDeeray.СоздатьМенеджерЗаписи();
	Запись.Сценарий 		= СценарийСсылка;
	Запись.ТелефонныйЗвонок = ТелефонныйЗвонок;
	Запись.Процент          = ПроцентПоСценарию;
	Запись.Записать(Истина);
	
КонецПроцедуры

Процедура ЗаписатьДанныеDeeray(Данные, СсылкаНаПлатформу, Резюме)
	Запись 						= РегистрыСведений.смартДанныеDeeray.СоздатьМенеджерЗаписи();
	Запись.Интерес 				= Данные.Интерес;
	Запись.ТелефонныйЗвонок 	= Данные.ТелефонныйЗвонок;  
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат;
	КонецЕсли;
	Запись.Интерес 				= Данные.Интерес;
	Запись.ТелефонныйЗвонок 	= Данные.ТелефонныйЗвонок;		
	Запись.СсылкаНаПлатформу    = СсылкаНаПлатформу;
	Запись.Резюме			    = Резюме;
	Запись.ПервыйКонтакт	    = Данные.ПервыйКонтакт;
	Запись.ЭтапИнтереса			= Данные.ЭтапИнтереса;
	Запись.Записать(Истина);	
КонецПроцедуры

#КонецОбласти 

#Область ВыгрузкаДанных      

Процедура ВыгрузитьДанные(УзелОбмена) Экспорт
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	Если ЭтоТестоваяБаза Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Начало выгрузки данных в сервис речевой аналитики Deeray'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация);
								 
	ДанныеДляВыгрузки 	= ПланыОбмена.смартОбменССервисомРечевойАналитикиDeeray.ВыбратьДанные(УзелОбмена);
	УдалитьРегистрациюСНевалидныхОбъектов(УзелОбмена, ДанныеДляВыгрузки);
	НастройкиУзла		= ПолучитьНастройкиУзла(УзелОбмена);
	ПараметрыСоединения = ПолучитьНастройкиСоединения(УзелОбмена);
	
	РезультатыВыгрузки  = Новый Соответствие;
	Для Каждого СтрокаЗвонка Из ДанныеДляВыгрузки Цикл
		
		РезультатВыгрузки = ИнициализироватьРезультатВыгрузки(РезультатыВыгрузки, СтрокаЗвонка.ТелефонныйЗвонок);
		ПараметрыВыгрузки = ИнициализироватьПараметрыВыгрузки();
		ЗаполнитьПараметрыВыгрузки(ПараметрыВыгрузки, СтрокаЗвонка);
		ДополнитьПараметрыВыгрузкиЗначениямиТегов(ПараметрыВыгрузки, НастройкиУзла, СтрокаЗвонка);
		
		Если ЭтоНомерСотрудника(ПараметрыВыгрузки.ТелефонКлиента) Тогда
			ТекстОшибки = СтрШаблон("Номер абонента - это номер сотрудника, выгрузка звонка %1 отменена", СокрЛП(СтрокаЗвонка.ТелефонныйЗвонок)); 
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, СтрокаЗвонка.ТелефонныйЗвонок);	
			Продолжить;
		КонецЕсли;
		 	
		Если ЗначениеЗаполнено(ПараметрыВыгрузки.ИдентификаторDeeray) Тогда
			
			ВыгрузитьТэгиЗвонковВРечевуюАналитикуDeeray(ПараметрыСоединения, ПараметрыВыгрузки, НастройкиУзла, РезультатВыгрузки);
			
		Иначе
			
			Если НЕ ПараметрыВыгрузки.ТегиРассчитаны Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыВыгрузки.СсылкаНаФайл = ПолучитьФайлВыгрузки(СтрокаЗвонка, РезультатВыгрузки);		
			Если НЕ ЗначениеЗаполнено(ПараметрыВыгрузки.СсылкаНаФайл) Тогда
				Продолжить; 		
			КонецЕсли; 
			
			ВыгрузитьЗвонокВРечевуюАналитикуDeeray(ПараметрыСоединения, ПараметрыВыгрузки, НастройкиУзла, РезультатВыгрузки); 		
		КонецЕсли;
		
		ЗафиксироватьРезультатВыгрузки(СтрокаЗвонка.ТелефонныйЗвонок, РезультатВыгрузки, НастройкиУзла);
		
		Если РезультатВыгрузки.МассивОшибок.Количество() = 0 Тогда
			ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, СтрокаЗвонка.ТелефонныйЗвонок);	
		КонецЕсли;
	КонецЦикла;
	
	ОбработатьРезультатыВыгрузки(РезультатыВыгрузки, НастройкиУзла);
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Окончание выгрузки данных в сервис речевой аналитики Deeray'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Информация,,,);
КонецПроцедуры 

Процедура УдалитьРегистрациюСНевалидныхОбъектов(УзелОбмена, ДанныеДляВыгрузки) 
    Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТелефонныйЗвонокИзменения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ВсеИзменения
	|ИЗ
	|	Документ.ТелефонныйЗвонок.Изменения КАК ТелефонныйЗвонокИзменения
	|ГДЕ
	|	ТелефонныйЗвонокИзменения.Узел = &Узел
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДляВыгрузки.ТелефонныйЗвонок КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ВыгружаемыеИзменения
	|ИЗ
	|	&ДанныеДляВыгрузки КАК ДанныеДляВыгрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеИзменения.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_ВсеИзменения КАК ВТ_ВсеИзменения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВыгружаемыеИзменения КАК ВТ_ВыгружаемыеИзменения
	|		ПО ВТ_ВсеИзменения.Ссылка = ВТ_ВыгружаемыеИзменения.Ссылка
	|ГДЕ
	|	ВТ_ВыгружаемыеИзменения.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Узел", УзелОбмена);
	Запрос.УстановитьПараметр("ДанныеДляВыгрузки", ДанныеДляВыгрузки); 
	МассивЗвонков = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если МассивЗвонков.Количество() > 0 Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(УзелОбмена, МассивЗвонков);
	КонецЕсли;
Конецпроцедуры

Процедура ЗафиксироватьРезультатВыгрузки(ТелефонныйЗвонокСсылка, РезультатВыгрузки, НастройкиУзла) 
		
	Если РезультатВыгрузки.ЗаписатьВЗвонокПризнакНетФайла Тогда
		ТелефонныйЗвонокОбъект = ТелефонныйЗвонокСсылка.ПолучитьОбъект();
		ТелефонныйЗвонокОбъект.ОбменДанными.Загрузка = Истина;			
		ТелефонныйЗвонокОбъект.сфпИдентификаторЗаписи = "НЕТ ФАЙЛА";
		
		Попытка
			ТелефонныйЗвонокОбъект.Записать();
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка записи реквизита сфпИдентификаторЗаписи: %1", ОписаниеОшибки());
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
		КонецПопытки;  		
	КонецЕсли;    
	
	Если РезультатВыгрузки.ЗаписатьИдентификаторDeeray Тогда
		ТелефонныйЗвонокОбъект = ТелефонныйЗвонокСсылка.ПолучитьОбъект();
		ТелефонныйЗвонокОбъект.ОбменДанными.Загрузка = Истина;			
		ТелефонныйЗвонокОбъект.смартИдентификаторDeeray = РезультатВыгрузки.ИдентификаторDeeray;
		
		Попытка
			ТелефонныйЗвонокОбъект.Записать();
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка записи реквизита смартИдентификаторDeeray: %1", ОписаниеОшибки());
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
		КонецПопытки;  		
	КонецЕсли;

	ТаблицаДопСвойств = Новый ТаблицаЗначений;
	ТаблицаДопСвойств.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	ТаблицаДопСвойств.Колонки.Добавить("Значение");
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ПроектDeeray"); 
	Если ЗначениеЗаполнено(Свойство) Тогда 		
		НоваяСтрока = ТаблицаДопСвойств.Добавить();
		НоваяСтрока.Свойство = Свойство;
		НоваяСтрока.Значение = НастройкиУзла.Проект;
	КонецЕсли;
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ДатаПервойВыгрузкиВDeeray"); 
	Если ЗначениеЗаполнено(РезультатВыгрузки.ДатаПервойВыгрузкиВDeeray) И ЗначениеЗаполнено(Свойство) Тогда 		
		НоваяСтрока = ТаблицаДопСвойств.Добавить();
		НоваяСтрока.Свойство = Свойство;
		НоваяСтрока.Значение = РезультатВыгрузки.ДатаПервойВыгрузкиВDeeray;
	КонецЕсли;
	
	Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ДатаПоследнейВыгрузкиВDeeray"); 
	Если ЗначениеЗаполнено(РезультатВыгрузки.ДатаПоследнейВыгрузкиВDeeray) И ЗначениеЗаполнено(Свойство) Тогда 		
		НоваяСтрока = ТаблицаДопСвойств.Добавить();
		НоваяСтрока.Свойство = Свойство;
		НоваяСтрока.Значение = РезультатВыгрузки.ДатаПоследнейВыгрузкиВDeeray;
	КонецЕсли;
	
	Попытка
		УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(ТелефонныйЗвонокСсылка, ТаблицаДопСвойств);
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка записи свойств: %1", ОписаниеОшибки());
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьРезультатыВыгрузки(РезультатыВыгрузки, НастройкиУзла) 
	
	ТекстОшибок = "";
	
	Для Каждого КлючИЗначение Из РезультатыВыгрузки Цикл 
		
		ТелефонныйЗвонокСсылка  = КлючИЗначение.Ключ;
		РезультатВыгрузки		= КлючИЗначение.Значение;
		
		Если РезультатВыгрузки.МассивОшибок.Количество() > 0 Тогда
			ТекстОшибок = ТекстОшибок + СтрШаблон("%1: %2", ТелефонныйЗвонокСсылка, СтрСоединить(РезультатВыгрузки.МассивОшибок, ";")) + Символы.ПС;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстОшибок) Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибки выгрузки звонков в сервис речевой аналитики Deeray'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибок);
	КонецЕсли;
							 
КонецПроцедуры

#КонецОбласти 

#Область Подготовка

Функция ПолучитьНастройкиСоединения(УзелОбмена) 
	НастройкиСоединения = Новый Структура;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УзелОбмена, 
		"АдресAPIDeeray, ТокенAPIDeeray, SecretKeyAPIDeeray");
	
	НастройкиСоединения.Вставить("АдресAPIDeeray",		Реквизиты.АдресAPIDeeray);
	НастройкиСоединения.Вставить("ТокенAPIDeeray",      Реквизиты.ТокенAPIDeeray); 
	НастройкиСоединения.Вставить("SecretKeyAPIDeeray",  Реквизиты.SecretKeyAPIDeeray);
	НастройкиСоединения.Вставить("ЭтоТестоваяБаза",  	НЕ смартОбщегоНазначения.смартРабочаяБаза());
	
	Возврат НастройкиСоединения;
КонецФункции  

Функция ПолучитьНастройкиУзла(УзелОбмена) 
	Результат = Новый Структура;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УзелОбмена, 
		"Проект, ВыгружаемыеТеги");
	
	Результат.Вставить("Проект",			Реквизиты.Проект);
	Результат.Вставить("ВыгружаемыеТеги",   Реквизиты.ВыгружаемыеТеги.Выгрузить()); 
	
	Возврат Результат;
КонецФункции

Функция ИнициализироватьРезультатВыгрузки(РезультатыВыгрузки, ТелефонныйЗвонок)
	Результат = Новый Структура;
	Результат.Вставить("МассивОшибок", Новый Массив); 
	Результат.Вставить("ИдентификаторDeeray", "");
	Результат.Вставить("ЗаписатьВЗвонокПризнакНетФайла", Ложь);
	Результат.Вставить("ЗаписатьИдентификаторDeeray", Ложь); 
	Результат.Вставить("ДатаПервойВыгрузкиВDeeray", Неопределено);
	Результат.Вставить("ДатаПоследнейВыгрузкиВDeeray", Неопределено);
	
	РезультатыВыгрузки.Вставить(ТелефонныйЗвонок, Результат);		
	Возврат РезультатыВыгрузки[ТелефонныйЗвонок];	
КонецФункции

Функция ИнициализироватьПараметрыВыгрузки()
	
	ПараметрыВыгрузки = Новый Структура;

	ПараметрыВыгрузки.Вставить("ТелефонныйЗвонок");
	ПараметрыВыгрузки.Вставить("ВидАТС");
	ПараметрыВыгрузки.Вставить("АТС");
	ПараметрыВыгрузки.Вставить("ТипЗвонка");
	ПараметрыВыгрузки.Вставить("СсылкаНаФайл");
	ПараметрыВыгрузки.Вставить("ТелефонКлиента");
	ПараметрыВыгрузки.Вставить("ТелефонОператора");
	ПараметрыВыгрузки.Вставить("ИдентификаторЗвонка");
	ПараметрыВыгрузки.Вставить("ИдентификаторDeeray");
	ПараметрыВыгрузки.Вставить("ДатаЗвонка");
	ПараметрыВыгрузки.Вставить("ДатаДокумента");

	ПараметрыВыгрузки.Вставить("Клиент");
	ПараметрыВыгрузки.Вставить("Контакт");
	ПараметрыВыгрузки.Вставить("Сотрудник");

	Возврат ПараметрыВыгрузки;
	
КонецФункции  

Процедура ЗаполнитьПараметрыВыгрузки(ПараметрыВыгрузки, ДанныеЗвонка)
	
	ЗаполнитьЗначенияСвойств(ПараметрыВыгрузки, ДанныеЗвонка, "ТелефонныйЗвонок, ИдентификаторЗвонка, ИдентификаторDeeray");
	
	ПараметрыВыгрузки.ВидАТС 			= СокрЛП(ДанныеЗвонка.ВидАТС);
	ПараметрыВыгрузки.АТС 				= ДанныеЗвонка.ВидАТС;
	ПараметрыВыгрузки.ТипЗвонка 		= ?(ДанныеЗвонка.Входящий, "Входящий", "Исходящий");
	ПараметрыВыгрузки.ТелефонКлиента 	= ДанныеЗвонка.АбонентКакСвязаться;
	ПараметрыВыгрузки.ТелефонОператора 	= ДанныеЗвонка.ВнутреннийНомер;
	ПараметрыВыгрузки.ДатаЗвонка 		= УниверсальноеВремя(ДанныеЗвонка.ДатаЗвонка) - Дата(1970, 1, 1);
	ПараметрыВыгрузки.ДатаДокумента 	= ДанныеЗвонка.ДатаЗвонка;
	ПараметрыВыгрузки.Клиент			= СокрЛП(ДанныеЗвонка.АбонентПредставление);
	ПараметрыВыгрузки.Контакт 			= СокрЛП(ДанныеЗвонка.КонтактноеЛицо);
	ПараметрыВыгрузки.Сотрудник			= СокрЛП(ДанныеЗвонка.Ответственный); 
		
КонецПроцедуры

Процедура ДополнитьПараметрыВыгрузкиЗначениямиТегов(ПараметрыВыгрузки, НастройкиУзла, ДанныеЗвонка)
	
	МассивТегов 	= Новый Массив; 
	ТегиРассчитаны 	= Ложь;
	Для Каждого СтрокаНастройкиУзла Из НастройкиУзла.ВыгружаемыеТеги Цикл  
		
		ПолеДанных = СтрокаНастройкиУзла.Тег.ИдентификаторДляФормул; 
		
		Если ПолеДанных = "ИнтересGUID" Тогда
			Если ЗначениеЗаполнено(ДанныеЗвонка.ИнтересGUID) Тогда 			
				ИнтересСсылка = Документы.CRM_Интерес.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеЗвонка.ИнтересGUID));				
				Если ЗначениеЗаполнено(ИнтересСсылка) Тогда 				
					
					СоответствиеТега = Новый Соответствие;
					СоответствиеТега.Вставить(СтрокаНастройкиУзла.ИмяПоля, ПолучитьНавигационнуюСсылку(ИнтересСсылка));
					МассивТегов.Добавить(СоответствиеТега);
					
				КонецЕсли;				
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеЗвонка[ПолеДанных]) Тогда
			ТегиРассчитаны 	= Истина;	
		КонецЕсли;
		
		СоответствиеТега = Новый Соответствие;
		СоответствиеТега.Вставить(СтрокаНастройкиУзла.ИмяПоля, ДанныеЗвонка[ПолеДанных]);
		МассивТегов.Добавить(СоответствиеТега);
	
	КонецЦикла;

	ПараметрыВыгрузки.Вставить("Теги",  			МассивТегов);
	ПараметрыВыгрузки.Вставить("ТегиРассчитаны",  	ТегиРассчитаны)
КонецПроцедуры

Функция ПолучитьФайлВыгрузки(ДанныеЗвонка, РезультатВыгрузки)
	
	СсылкаНаФайл = Неопределено;
		
	Если ДанныеЗвонка.ВидАТС = Справочники.смартВидыАТС.Asterisk Тогда
		
		СсылкаНаФайл = ПолучитьСсылкуНаАудиоФайлЗвонкаAsterisk(ДанныеЗвонка.ИдентификаторЗвонка, ДанныеЗвонка.ДатаЗвонка, РезультатВыгрузки);

	ИначеЕсли ДанныеЗвонка.ВидАТС = Справочники.смартВидыАТС.Мегафон
		ИЛИ ДанныеЗвонка.ВидАТС = Справочники.смартВидыАТС.МегафонКовчег Тогда
			
		СсылкаНаФайл = СокрЛП(ДанныеЗвонка.ИдентификаторЗаписи);
		
	КонецЕсли;
	
	Возврат СсылкаНаФайл;
	
КонецФункции 

Функция ПолучитьСсылкуНаАудиоФайлЗвонкаAsterisk(ИдентификаторЗвонка, ДатаЗвонка, РезультатВыгрузки) 
	
	Результат 	 = "";	
	UIDЗаписи 	 = СтрЗаменить(ИдентификаторЗвонка, ".", "-");	
	АдресСервера = "sip.smart-t.me";
	
	Если ДатаЗвонка >= НачалоДня(ТекущаяДата()) Тогда
		АдресРесурса = "/calls/" + СокрЛП(UIDЗаписи) + ".wav";
		ТипТелаОтвета = "ДвоичныеДанные";
	Иначе	
		АдресРесурса = "/player_uid.php?UID=" + СокрЛП(UIDЗаписи) + "&JSON=Y";
		ТипТелаОтвета = "Строка";
	КонецЕсли;	
	
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json, charset=UTF-8");
	
	РезультатЗапроса  = ОтправитьДляОбработкиGET(АдресСервера, 443, АдресРесурса, ЗаголовокЗапросаHTTP, Новый ЗащищенноеСоединениеOpenSSL(), ТипТелаОтвета);  
	
	Если ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки) Тогда 	
		ТекстОшибки = СтрШаблон("Ошибка соединения %1 при получении ссылки на файл звонка: %2", АдресСервера, РезультатЗапроса.ТекстОшибки);
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);			  
		Возврат Результат;
	КонецЕсли;

	Если РезультатЗапроса.КодСостояния = 200 Тогда

		Если ТипТелаОтвета = "Строка" Тогда
			
			Если НЕ ЗначениеЗаполнено(РезультатЗапроса.ТелоОтвета) Тогда
				
				ТекстОшибки = СтрШаблон("При получения ссылки на файл записи Asterisk сервер вернул пустой ответ (нет файла) ID: %1", ИдентификаторЗвонка);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);							  
				РезультатВыгрузки.ЗаписатьВЗвонокПризнакНетФайла = Истина; 						  
				Возврат Результат;			  
							  
			КонецЕсли;	
			
			СтруктураИзJSON = ПолучитьЗначениеИзСтрокиJSON(РезультатЗапроса.ТелоОтвета);						
			Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда				
				Результат = СтруктураИзJSON.LINK; 			
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(РезультатЗапроса.ТелоОтвета) = Тип("ДвоичныеДанные") И РезультатЗапроса.ТелоОтвета.Размер() > 0 Тогда

				Результат = "https://sip.smart-t.me/calls/" + СокрЛП(UIDЗаписи) + ".wav";

			Иначе

				ТекстОшибки = СтрШаблон("При получения ссылки на файл записи Asterisk сервер вернул пустой ответ (нет файла) ID: %1", ИдентификаторЗвонка);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);							  
				РезультатВыгрузки.ЗаписатьВЗвонокПризнакНетФайла = Истина; 						  
				Возврат Результат;							  
			КонецЕсли;	
			
		КонецЕсли;

	Иначе
		
		ТекстОшибки = СтрШаблон("Ошибка получения ссылки на файл записи Asterisk: ID: %1 - код соотояния: %2; Тело ответа: %3", ИдентификаторЗвонка, РезультатЗапроса.КодСостояния, РезультатЗапроса.ТелоОтвета);
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);	
				
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

Процедура ВыгрузитьЗвонокВРечевуюАналитикуDeeray(ПараметрыСоединения, ПараметрыВыгрузки, НастройкиУзла, РезультатВыгрузки)
	
	Если ПараметрыСоединения.ЭтоТестоваяБаза Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураФайлаЗвонка = ПолучитьСтруктуруФайлаАудиоЗвонка(ПараметрыВыгрузки, РезультатВыгрузки);
	Если СтруктураФайлаЗвонка = Неопределено Тогда
   		Возврат;		
	КонецЕсли; 
	
	СтруктураТелаЗвонка = Новый Соответствие;
	СтруктураТелаЗвонка.Вставить("api-key",	   ПараметрыСоединения.ТокенAPIDeeray);
	СтруктураТелаЗвонка.Вставить("secret-key", ПараметрыСоединения.SecretKeyAPIDeeray);
	
	СтруктураMeta = Новый Структура;	
	СтруктураMeta.Вставить("operator", 	Новый Структура("name, nick", ПараметрыВыгрузки.Сотрудник, 	ПараметрыВыгрузки.Сотрудник));
	СтруктураMeta.Вставить("customer", 	Новый Структура("name, nick", ПараметрыВыгрузки.Клиент,	  	ПараметрыВыгрузки.Клиент));
	СтруктураMeta.Вставить("source",   	ПараметрыВыгрузки.ВидАТС);		
	СтруктураMeta.Вставить("tags", 		ПолучитьМассивТеговСтрок(ПараметрыВыгрузки));
	Если ЗначениеЗаполнено(ПараметрыВыгрузки.ИдентификаторDeeray) Тогда
		СтруктураMeta.Вставить("uuid", ПараметрыВыгрузки.ИдентификаторDeeray);
	КонецЕсли;
	
	СтруктураТелаЗвонка.Вставить("meta",  	   СтруктураMeta);	
	СтруктураТелаЗвонка.Вставить("audio", 	   СтруктураФайлаЗвонка);

	ТелоЗапроса = ЗначениеВСтрокуJSON(СтруктураТелаЗвонка);

	АдресРесурса = "/api/v1/carrot/audio/create";
	
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
	
	РезультатЗапроса  = ОтправитьДляОбработкиPOST(ТелоЗапроса, ПараметрыСоединения.АдресAPIDeeray, 443, АдресРесурса, ЗаголовокЗапросаHTTP, Новый ЗащищенноеСоединениеOpenSSL());  
	
	Если ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки) Тогда 	
		ТекстОшибки = СтрШаблон("Ошибка соединения %1 при выгрузке звонка в сервис речевой аналитики Deeray: %2", ПараметрыСоединения.АдресAPIDeeray, РезультатЗапроса.ТекстОшибки);
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);			  
		Возврат;
	КонецЕсли;

	Если РезультатЗапроса.КодСостояния = 200 ИЛИ РезультатЗапроса.КодСостояния = 422 Тогда
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ТелоОтвета) Тогда
			
			СтруктураИзJSON = ПолучитьЗначениеИзСтрокиJSON(РезультатЗапроса.ТелоОтвета);						
			
			Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда				
				
				Если СтруктураИзJSON.Свойство("code") И СтруктураИзJSON.code = 0 Тогда //Успешно
					
					Если СтруктураИзJSON.Свойство("data")
						И ТипЗнч(СтруктураИзJSON.data) = Тип("Структура")
						И СтруктураИзJSON.data.Свойство("id") Тогда
						
						РезультатВыгрузки.ЗаписатьИдентификаторDeeray 	= Истина;
						РезультатВыгрузки.ИдентификаторDeeray 			= СтруктураИзJSON.data.id;
						
					КонецЕсли;	
					
					РезультатВыгрузки.ДатаПервойВыгрузкиВDeeray 		= ТекущаяДатаСеанса();
					РезультатВыгрузки.ДатаПоследнейВыгрузкиВDeeray 		= ТекущаяДатаСеанса(); 
					
				Иначе	
					ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка %1 в сервис речевой аналитики Deeray (Code = %2): %3", ПараметрыВыгрузки.ИдентификаторЗвонка, СтруктураИзJSON.code, РезультатЗапроса.ТелоОтвета);
					РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);							  
				КонецЕсли;			
			Иначе
				ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка %1 в сервис речевой аналитики Deeray: Не удалось прочитать параметр Code: %2", ПараметрыВыгрузки.ИдентификаторЗвонка, РезультатЗапроса.ТелоОтвета);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);	
			КонецЕсли;        
			
		Иначе
			
			ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray (пустое тело ответа) ID: %1", ПараметрыВыгрузки.ИдентификаторЗвонка);
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);			  
			
		КонецЕсли; 
		
	Иначе
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ТелоОтвета) Тогда
			
			СтруктураИзJSON = ПолучитьЗначениеИзСтрокиJSON(РезультатЗапроса.ТелоОтвета);						
			
			Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда
				
				ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray (error) ID: %1 error:%2", ПараметрыВыгрузки.ИдентификаторЗвонка, СтруктураИзJSON.error);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
				
			КонецЕсли;	
			
		Иначе
			
			ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray ID: %1, код состояния - %2", ПараметрыВыгрузки.ИдентификаторЗвонка, РезультатЗапроса.КодСостояния);
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);

		КонецЕсли;  
		
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьМассивТеговСтрок(ПараметрыВыгрузки)
	
	МассивТегов = Новый Массив;
	
	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("ID", 			ПараметрыВыгрузки.ИдентификаторЗвонка);
	МассивТегов.Добавить(СоответствиеТега);

	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Тип звонка", 	ПараметрыВыгрузки.ТипЗвонка);
	МассивТегов.Добавить(СоответствиеТега);

	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Клиент", 		ПараметрыВыгрузки.Клиент);
	МассивТегов.Добавить(СоответствиеТега);

	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Телефон клиента", ПараметрыВыгрузки.ТелефонКлиента);
	МассивТегов.Добавить(СоответствиеТега);

	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Телефон оператора", ПараметрыВыгрузки.ТелефонОператора);
	МассивТегов.Добавить(СоответствиеТега);
	
	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Контакт", 		ПараметрыВыгрузки.Контакт);
	МассивТегов.Добавить(СоответствиеТега);
	
	Для Каждого ЭлементТег Из ПараметрыВыгрузки.Теги Цикл  
		МассивТегов.Добавить(ЭлементТег);	
	КонецЦикла;  
	
	СоответствиеТега = Новый Соответствие;
	СоответствиеТега.Вставить("Ссылка на звонок", ПолучитьНавигационнуюСсылку(ПараметрыВыгрузки.ТелефонныйЗвонок));
	МассивТегов.Добавить(СоответствиеТега); 	
	
	МассивТеговСтрок = Новый Массив;
	
	Для Каждого Эл Из МассивТегов Цикл

		Для Каждого ЭлТег Из Эл Цикл
		
			Если ЗначениеЗаполнено(ЭлТег.Значение) Тогда
				МассивТеговСтрок.Добавить(ЭлТег.Ключ + ": " + ЭлТег.Значение);
			КонецЕсли;

		КонецЦикла;	
			
	КонецЦикла;	

	Возврат МассивТеговСтрок;	
КонецФункции

Функция ПолучитьСтруктуруФайлаАудиоЗвонка(ПараметрыВыгрузки, РезультатВыгрузки)
	
	СсылкаНаФайл = ПараметрыВыгрузки.СсылкаНаФайл;
	Если НЕ ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Каталог = "/home/1c/exchange/deeray/";
	//Каталог = "/home/exchange/timofeeva/deeray/";
	
	ИмяУИД = СокрЛП(Новый УникальныйИдентификатор()); 
	
	ИмяФайла 	   = ИмяУИД + ".mp3";
	ПолноеИмяФайла = Каталог + ИмяФайла;
	
	//Скачиваем файл записи
	Попытка
		КопироватьФайл(СсылкаНаФайл, ПолноеИмяФайла);		
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка скачивания файла звонка %1 при выгрузке звонка в сервис речевой аналитики Deeray", СсылкаНаФайл);					  
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
		Возврат Неопределено;	
	КонецПопытки;	
	
	Если ПараметрыВыгрузки.АТС = Справочники.смартВидыАТС.Asterisk 
		И (ПараметрыВыгрузки.ТипЗвонка = "Входящий"
		   ИЛИ НачалоДня(ПараметрыВыгрузки.ДатаДокумента) = НачалоДня(ТекущаяДата())) Тогда
		
		ПолноеИмяФайлаOutput = Каталог + ИмяУИД + "Output" + ".mp3";
		
		//Если входящий Asterisk, то меняем каналы
		Если ПараметрыВыгрузки.ТипЗвонка = "Входящий" Тогда
			
			Командаffmpeg = "ffmpeg -i " + ПолноеИмяФайла + " -filter_complex ""channelmap=map=FL-FR|FR-FL:channel_layout=stereo"" " + ПолноеИмяФайлаOutput;
			
		Иначе
			
			Командаffmpeg = "ffmpeg -i " + ПолноеИмяФайла + " -acodec libmp3lame " + ПолноеИмяФайлаOutput;
			
		КонецЕсли;	
			
		КодВозврата = Неопределено;
		
		ЗапуститьПриложение(Командаffmpeg, Каталог, Истина, КодВозврата);
		
		Если КодВозврата = Неопределено Тогда
			
			ТекстОшибки = СтрШаблон("Ошибка смены каналов файла звонка %1 при выгрузке звонка в сервис речевой аналитики Deeray", СсылкаНаФайл);
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
			Возврат Неопределено;
			
		КонецЕсли;

		УдалитьФайлы(ПолноеИмяФайла);
		
		ПолноеИмяФайла = ПолноеИмяФайлаOutput;

	КонецЕсли;
	
	//Кодирование файла в Base64
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолноеИмяФайла);
    ДанныеФайлаBase64 = Base64Строка(ДвоичныеДанныеФайла);
	
	УдалитьФайлы(ПолноеИмяФайла);
	
	//Результат
	СтруктураРезультата = Новый Структура;
	
	СтруктураРезультата.Вставить("language",   "ru");
	СтруктураРезультата.Вставить("file", 	   ДанныеФайлаBase64);
	СтруктураРезультата.Вставить("name", 	   ИмяФайла);
	СтруктураРезультата.Вставить("created_at", ПараметрыВыгрузки.ДатаЗвонка);
	
	Возврат СтруктураРезультата;
	
КонецФункции

Функция ЭтоНомерСотрудника(НомерТелефона)
	
	Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат Ложь;
	КонецЕсли;	

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПользователиКонтактнаяИнформация.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|ГДЕ
	|	ПользователиКонтактнаяИнформация.НомерТелефона = &НомерТелефона";
	РезультатЗапроса = Запрос.Выполнить();

	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции 

Процедура ВыгрузитьТэгиЗвонковВРечевуюАналитикуDeeray(ПараметрыСоединения, ПараметрыВыгрузки, НастройкиУзла, РезультатВыгрузки)
	
	Если ПараметрыСоединения.ЭтоТестоваяБаза Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураТелаЗвонка = Новый Соответствие;

	СтруктураТелаЗвонка.Вставить("api-key",	   ПараметрыСоединения.ТокенAPIDeeray);
	СтруктураТелаЗвонка.Вставить("secret-key", ПараметрыСоединения.SecretKeyAPIDeeray);
	СтруктураТелаЗвонка.Вставить("id", 		   ПараметрыВыгрузки.ИдентификаторDeeray);

	СтруктураFields = Новый Структура;
	СтруктураFields.Вставить("type",   "tags");
	СтруктураFields.Вставить("action", "set");
	СтруктураFields.Вставить("values", ПолучитьМассивТеговСтрок(ПараметрыВыгрузки));
	
	МассивFields = Новый Массив;
	МассивFields.Добавить(СтруктураFields);
	
	СтруктураТелаЗвонка.Вставить("fields", 	   МассивFields);
	
	ТелоЗапроса = ЗначениеВСтрокуJSON(СтруктураТелаЗвонка);

	АдресРесурса = "/api/v1/carrot/conversation/edit";
	
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json");
	
	РезультатЗапроса  = ОтправитьДляОбработкиPOST(ТелоЗапроса, ПараметрыСоединения.АдресAPIDeeray, 443, АдресРесурса, ЗаголовокЗапросаHTTP, Новый ЗащищенноеСоединениеOpenSSL());  
	
	Если ЗначениеЗаполнено(РезультатЗапроса.ТекстОшибки) Тогда 	
		ТекстОшибки = СтрШаблон("Ошибка соединения %1 при выгрузке звонка в сервис речевой аналитики Deeray: %2", ПараметрыСоединения.АдресAPIDeeray, РезультатЗапроса.ТекстОшибки);
		РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);			  
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапроса.КодСостояния = 200 ИЛИ РезультатЗапроса.КодСостояния = 422 Тогда
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ТелоОтвета) Тогда
			
			СтруктураИзJSON = ПолучитьЗначениеИзСтрокиJSON(РезультатЗапроса.ТелоОтвета);						
			
			Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда				
				
				Если СтруктураИзJSON.Свойство("code") И СтруктураИзJSON.code = 0 Тогда //Успешно
					
					РезультатВыгрузки.ДатаПоследнейВыгрузкиВDeeray	= ТекущаяДатаСеанса(); 
					
				Иначе	
					ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка %1 в сервис речевой аналитики Deeray (Code = %2): %3", ПараметрыВыгрузки.ИдентификаторЗвонка, СтруктураИзJSON.code, РезультатЗапроса.ТелоОтвета);
					РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);							  
				КонецЕсли;			
			Иначе
				ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка %1 в сервис речевой аналитики Deeray: Не удалось прочитать параметр Code: %2", ПараметрыВыгрузки.ИдентификаторЗвонка, РезультатЗапроса.ТелоОтвета);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);	
			КонецЕсли;        
			
		Иначе
			
			ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray (пустое тело ответа) ID: %1", ПараметрыВыгрузки.ИдентификаторЗвонка);
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);			  
			
		КонецЕсли; 
		
	Иначе
		
		Если ЗначениеЗаполнено(РезультатЗапроса.ТелоОтвета) Тогда
			
			СтруктураИзJSON = ПолучитьЗначениеИзСтрокиJSON(РезультатЗапроса.ТелоОтвета);						
			
			Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда
				
				ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray (error) ID: %1 error:%2", ПараметрыВыгрузки.ИдентификаторЗвонка, СтруктураИзJSON.error);
				РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);
				
			КонецЕсли;	
			
		Иначе
			
			ТекстОшибки = СтрШаблон("Ошибка выгрузки звонка в сервис речевой аналитики Deeray ID: %1, код состояния - %2", ПараметрыВыгрузки.ИдентификаторЗвонка, РезультатЗапроса.КодСостояния);
			РезультатВыгрузки.МассивОшибок.Добавить(ТекстОшибки);

		КонецЕсли;  
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтправкаЗапросов

Функция ОтправитьДляОбработкиPOST(ТелоЗапроса, АдресСервера, Порт, АдресРесурса, ЗаголовокHTTP, ЗащищенноеСоединение = Неопределено)
	
	ВозвращаемоеЗначение = СтруктураВозвращаемогоЗначения();
	
	ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTP");

	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, ЗаголовокHTTP);

	Если ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные") Тогда
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
	Иначе
		HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
	КонецЕсли;
	
	ТекстОшибки = "";
	Попытка
		
		Соединение = Новый HTTPСоединение(АдресСервера, Порт,,, ИнтернетПрокси, 60, ЗащищенноеСоединение);
		HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		
	Исключение
		HTTPОтвет = Неопределено;
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				
	КонецПопытки;
	
	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибки;
	Если НЕ HTTPОтвет = Неопределено Тогда
		ВозвращаемоеЗначение.КодСостояния = HTTPОтвет.КодСостояния;
		ВозвращаемоеЗначение.Заголовки    = HTTPОтвет.Заголовки;
		ВозвращаемоеЗначение.ТелоОтвета   = HTTPОтвет.ПолучитьТелоКакСтроку();
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции 

Функция ОтправитьДляОбработкиGET(АдресСервера, Порт, АдресРесурса, ЗаголовокHTTP, ЗащищенноеСоединение = Неопределено, ТипТелаОтвета = "Строка")
	
	ВозвращаемоеЗначение = СтруктураВозвращаемогоЗначения();
	
	ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTP");
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса, ЗаголовокHTTP);

	ТекстОшибки = "";
	Попытка
		
		Соединение = Новый HTTPСоединение(АдресСервера, Порт,,, ИнтернетПрокси, 60, ЗащищенноеСоединение);
		HTTPОтвет = Соединение.ВызватьHTTPМетод("GET", HTTPЗапрос);
		
	Исключение
		HTTPОтвет = Неопределено;
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	

	ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибки;
	Если НЕ HTTPОтвет = Неопределено Тогда  
		ВозвращаемоеЗначение.КодСостояния = HTTPОтвет.КодСостояния;
		ВозвращаемоеЗначение.Заголовки    = HTTPОтвет.Заголовки;
		ВозвращаемоеЗначение.ТелоОтвета   = ?(ТипТелаОтвета = "Строка", HTTPОтвет.ПолучитьТелоКакСтроку(), HTTPОтвет.ПолучитьТелоКакДвоичныеДанные());        							
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции 

