		Запрос.УстановитьПараметр("СостоянияИнтересаДляПервогоКонтакта", СостоянияИнтересаДляПервогоКонтакта); 
		
	ИначеЕсли ИдентификаторДляФормул = "ТегРечевойАналитики_ПодразделениеПартнера" Тогда
		
		ТекстыЗапросов.Добавить(ТаблицаВТ_ЗвонкиСТегамиТекущими());
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());		
		
		ТекстЗапросаИтоги = "ВЫБРАТЬ
		|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
		|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
		|	ЕСТЬNULL((ВЫБОР
		|			КОГДА БизнесРегионы.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
		|				ТОГДА БизнесРегионы.Ссылка
		|			КОГДА БизнесРегионы.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
		|				ТОГДА БизнесРегионы.Родитель
		|			КОГДА БизнесРегионы.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
		|				ТОГДА БизнесРегионы.Родитель.Родитель
		|			КОГДА БизнесРегионы.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
		|				ТОГДА БизнесРегионы.Родитель.Родитель.Родитель
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
		|		КОНЕЦ).смартОтветственоеПодразделение, """") КАК ЗначениеТега
		|ПОМЕСТИТЬ ВТ_РезультатРасчета
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БизнесРегионы КАК БизнесРегионы
		|		ПО (ТИПЗНАЧЕНИЯ(ВТ_Звонки.АбонентКонтакт) = ТИП(Справочник.Партнеры))
		|			И ВТ_Звонки.АбонентКонтакт.БизнесРегион = БизнесРегионы.Ссылка,
		|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики"; 
		ТекстыЗапросов.Добавить(ТекстЗапросаИтоги);
		ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
		
		Запрос.УстановитьПараметр("ПустоеЗначение", "");
				
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ВТ_ЗначенияТеговИтог = "
	|ВЫБРАТЬ
	|	ВТ_ЗвонкиСТегамиТекущими.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	ВТ_ЗвонкиСТегамиТекущими.Тег КАК Тег,
	|	ВТ_ЗвонкиСТегамиТекущими.ЗначениеТегаТекущее КАК ЗначениеТегаТекущее,
	|	NULL КАК ЗначениеТега
	|ПОМЕСТИТЬ ВТ_ЗначенияТеговИтог
	|ИЗ
	|	ВТ_ЗвонкиСТегамиТекущими КАК ВТ_ЗвонкиСТегамиТекущими
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_РезультатРасчета.ТелефонныйЗвонок,
	|	ВТ_РезультатРасчета.Тег,
	|	NULL,
	|	ВТ_РезультатРасчета.ЗначениеТега
	|ИЗ
	|	ВТ_РезультатРасчета КАК ВТ_РезультатРасчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗначенияТеговИтог.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	ВТ_ЗначенияТеговИтог.Тег КАК Тег,
	|	МАКСИМУМ(ВТ_ЗначенияТеговИтог.ЗначениеТегаТекущее) КАК ЗначениеТегаТекущее,
	|	МАКСИМУМ(ВТ_ЗначенияТеговИтог.ЗначениеТега) КАК ЗначениеТега
	|ИЗ
	|	ВТ_ЗначенияТеговИтог КАК ВТ_ЗначенияТеговИтог
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЗначенияТеговИтог.ТелефонныйЗвонок,
	|	ВТ_ЗначенияТеговИтог.Тег
	|
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТелефонныйЗвонок
	|АВТОУПОРЯДОЧИВАНИЕ";
    ТекстыЗапросов.Добавить(ВТ_ЗначенияТеговИтог);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов);
	
	УстановитьПривилегированныйРежим(Истина);	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;

КонецФункции

Функция ТаблицаВТ_ЗвонкиСТегамиТекущими()

	Возврат 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыИСведения.Ссылка КАК Тег,
	|	ДополнительныеРеквизитыИСведения.Имя КАК ИмяТега
	|ПОМЕСТИТЬ ВТ_ТегиРечевойАналитики
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
	|ГДЕ
	|	ДополнительныеРеквизитыИСведения.Ссылка = &Тег
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТелефонныйЗвонок.Ссылка КАК ТелефонныйЗвонок,
	|	ТелефонныйЗвонок.Автор КАК Автор,
	|	ТелефонныйЗвонок.Ответственный КАК Ответственный,
	|	ТелефонныйЗвонок.АбонентКакСвязаться КАК АбонентКакСвязаться,
	|	ТелефонныйЗвонок.Дата КАК ДатаЗвонка,
	|	ТелефонныйЗвонок.АбонентКонтакт КАК АбонентКонтакт
	|ПОМЕСТИТЬ ВТ_Звонки
	|ИЗ
	|	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	|ГДЕ
	|	ТелефонныйЗвонок.Ссылка В(&ТелефонныеЗвонки)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТелефонныйЗвонок,
	|	АбонентКакСвязаться
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Документ.ТелефонныйЗвонок) КАК ТелефонныйЗвонок,
	|	ДополнительныеСведения.Свойство КАК Тег,
	|	ДополнительныеСведения.Значение КАК ЗначениеТегаТекущее
	|ПОМЕСТИТЬ ВТ_ТекущиеЗначенияТегов
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Звонки КАК ВТ_Звонки
	|		ПО ((ВЫРАЗИТЬ(ДополнительныеСведения.Объект КАК Документ.ТелефонныйЗвонок)) = ВТ_Звонки.ТелефонныйЗвонок)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики
	|		ПО ДополнительныеСведения.Свойство = ВТ_ТегиРечевойАналитики.Тег
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТелефонныйЗвонок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
	|	ЕСТЬNULL(ВТ_ТекущиеЗначенияТегов.ЗначениеТегаТекущее, &ПустоеЗначение) КАК ЗначениеТегаТекущее
	|ПОМЕСТИТЬ ВТ_ЗвонкиСТегамиТекущими
	|ИЗ
	|	ВТ_Звонки КАК ВТ_Звонки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеЗначенияТегов КАК ВТ_ТекущиеЗначенияТегов
	|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ТекущиеЗначенияТегов.ТелефонныйЗвонок
	|			И (ВТ_ТегиРечевойАналитики.Тег = ВТ_ТекущиеЗначенияТегов.Тег)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТелефонныйЗвонок";
	
КонецФункции 

Функция ТаблицаВТ_РезультатРасчета_ПервыйКонтакт()

	Возврат 
	"ВЫБРАТЬ
	|	сфпИсторияЗвонков.Звонок КАК Звонок,
	|	сфпИсторияЗвонков.ДатаНачала КАК ДатаНачала,
	|	ВЫБОР
	|		КОГДА ДЛИНАСТРОКИ(сфпИсторияЗвонков.НомерТелефона) = 10
	|			ТОГДА ""7"" + сфпИсторияЗвонков.НомерТелефона
	|		ИНАЧЕ сфпИсторияЗвонков.НомерТелефона
	|	КОНЕЦ КАК НомерТелефона,
	|	ВЫБОР
	|		КОГДА ДЛИНАСТРОКИ(сфпИсторияЗвонков.ВнутреннийНомер) = 10
	|			ТОГДА ""7"" + сфпИсторияЗвонков.ВнутреннийНомер
	|		ИНАЧЕ сфпИсторияЗвонков.ВнутреннийНомер
	|	КОНЕЦ КАК ВнутреннийНомер
	|ПОМЕСТИТЬ ВТ_ИсторияЗвонков
	|ИЗ
	|	РегистрСведений.сфпИсторияЗвонков КАК сфпИсторияЗвонков
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Звонок,
	|	НомерТелефона,
	|	ВнутреннийНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	МИНИМУМ(ВТ_ИсторияЗвонков.ДатаНачала) КАК ДатаПервогоКонтакта
	|ПОМЕСТИТЬ ВТ_ИсторияЗвонков_БылКонтакт
	|ИЗ
	|	ВТ_ИсторияЗвонков КАК ВТ_ИсторияЗвонков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Звонки КАК ВТ_Звонки
	|		ПО (ВТ_Звонки.ТелефонныйЗвонок <> ВТ_ИсторияЗвонков.Звонок)
	|			И (ВТ_Звонки.ДатаЗвонка > ВТ_ИсторияЗвонков.ДатаНачала)
	|			И (ВТ_Звонки.АбонентКакСвязаться = ВТ_ИсторияЗвонков.НомерТелефона
	|				ИЛИ ВТ_Звонки.АбонентКакСвязаться = ВТ_ИсторияЗвонков.ВнутреннийНомер)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Звонки.ТелефонныйЗвонок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТелефонныйЗвонок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_ИсторияЗвонков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Звонки.ТелефонныйЗвонок КАК ТелефонныйЗвонок,
	|	ВТ_ТегиРечевойАналитики.Тег КАК Тег,
	|	ВТ_ИсторияЗвонков_БылКонтакт.ДатаПервогоКонтакта КАК ДатаПервогоКонтакта,
	|	ВЫБОР
	|		КОГДА ВТ_ИсторияЗвонков_БылКонтакт.ДатаПервогоКонтакта ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЗначениеТега
	|ПОМЕСТИТЬ ВТ_РезультатРасчета
	|ИЗ
	|	ВТ_Звонки КАК ВТ_Звонки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсторияЗвонков_БылКонтакт КАК ВТ_ИсторияЗвонков_БылКонтакт
	|		ПО ВТ_Звонки.ТелефонныйЗвонок = ВТ_ИсторияЗвонков_БылКонтакт.ТелефонныйЗвонок,
	|	ВТ_ТегиРечевойАналитики КАК ВТ_ТегиРечевойАналитики
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТелефонныйЗвонок";
	
