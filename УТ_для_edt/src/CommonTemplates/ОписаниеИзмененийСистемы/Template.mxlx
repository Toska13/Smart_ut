			<c>
				<i>1</i>
				<c>
					<f>14</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Оплата через единый лицевой счет при импорте товаров</v8:content>
						</v8:item>
