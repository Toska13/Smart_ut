					<f>14</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Устранение разрыва между регистрами взаиморасчетов с партнерами</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
