					<f>14</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Обмен с ИС МП (обувь, одежда, табак…)</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
