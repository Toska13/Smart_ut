				<c>
					<f>15</f>
					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Возможность звонка на любой номер контакта или клиента</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
