

&НаКлиенте
Процедура ОК(Команда)
	СтруктураВозврата = Новый Структура("Комментарий, НомерКомментария");
	СтруктураВозврата.Комментарий = Комментарий;
	СтруктураВозврата.НомерКомментария = НомерПримечания;
	Закрыть(СтруктураВозврата);
КонецПроцедуры


&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Номер = Параметры.НомерПримечания;
	Если Номер <> Неопределено Тогда
		НомерПримечания = Номер + 1;
	КонецЕсли;
КонецПроцедуры

