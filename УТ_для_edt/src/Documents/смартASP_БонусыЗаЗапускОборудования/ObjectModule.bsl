Процедура ОбработкаПроведения(Отказ, Режим)
	
	//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  
	Если смартСтатусРасчетаБонусов <> Перечисления.смартСтатусыДокументовРасчетаБонусов.РасчетЗавершен Тогда

		Движения.смартASP_НакоплениеБонусов.Очистить();
		Движения.смартASP_НакоплениеБонусов.Записывать = Истина;

		Движения.смартASP_РасшифровкаЗапуска.Очистить();
		Движения.смартASP_РасшифровкаЗапуска.Записывать = Истина;

		Возврат;
		
	КонецЕсли;	
	//--#1288 смарт: Лопато 26.12.2022
	
	// регистр ASP_НакоплениеБонусов 
	Движения.смартASP_НакоплениеБонусов.Очистить();
	Движения.смартASP_НакоплениеБонусов.Записывать = Истина;
	Для Каждого ТекСтрокаРасчетБонусов Из РасчетБонусов Цикл
		Если ТекСтрокаРасчетБонусов.Бонус <> 0 Тогда
			Движение = Движения.смартASP_НакоплениеБонусов.Добавить();
			Движение.Период = Дата;
			Движение.ТипБонуса = Перечисления.смартASP_ТипыБонусов.ЗапускиОборудования;
			Движение.Инженер = ТекСтрокаРасчетБонусов.Инженер;
			Движение.Сумма = ТекСтрокаРасчетБонусов.Бонус;
		КонецЕсли;
	КонецЦикла;

	// регистр ASP_РасшифровкаЗапуска 
	Движения.смартASP_РасшифровкаЗапуска.Очистить();
	Движения.смартASP_РасшифровкаЗапуска.Записывать = Истина;
	Для Каждого ТекСтрокаРасчетБонусов Из РасчетБонусов Цикл
		Если ТекСтрокаРасчетБонусов.Бонус <> 0 ИЛИ ТекСтрокаРасчетБонусов.Тариф <> 0 Тогда
			Движение = Движения.смартASP_РасшифровкаЗапуска.Добавить();
			Движение.Период = Дата;
			Движение.Инженер = ТекСтрокаРасчетБонусов.Инженер;
			Движение.ЗаявкаНаЗапуск = ТекСтрокаРасчетБонусов.ЗаявкаНаЗапуск;
			Движение.Оборудование = ТекСтрокаРасчетБонусов.Оборудование;
			Движение.Тариф = ТекСтрокаРасчетБонусов.Тариф;
			Движение.Стоимость = ТекСтрокаРасчетБонусов.Бонус;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

