#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоискОборудованияПоСкладам(Команда)
	
	ОткрытьФорму("Документ.смартЗаявкаНаРазборкуОборудования.Форма.ФормаПодбораОборудования",
					Новый Структура("Оборудование,Организация", Объект.Номенклатура, Объект.Организация),
					ЭтаФорма,,,,
					Новый ОписаниеОповещения("ПоискОборудованияПоСкладамЗавершение", ЭтаФорма),
					РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКомандуСПодтверждением(Команда) 
	
	ИмяКоманды = Команда.Имя;
	
	ДополнительныеПараметрыОповещения = Новый Структура("ИмяКоманды", ИмяКоманды);
	МодульХраненияМетодаОповещения = ЭтотОбъект;
	
	МетодОповещения = "ОбработатьРезультатОтветаНаВопрос";

	ЗаголовокВопроса = "Согласование заявки";
	
	Если ИмяКоманды = "КСогласованию"
			Или ИмяКоманды = "Согласована"
			Или ИмяКоманды = "НеСогласована" Тогда
	
		Если ИмяКоманды = "КСогласованию" Тогда
			
			ТекстВопроса = 
				"Заявка будет передана на согласование.
				|Продолжить?";
		
		ИначеЕсли ИмяКоманды = "Согласована" Тогда
			
			ТекстВопроса = 
				"Заявка будет согласован.
			   	|Продолжить?"; 
			
		ИначеЕсли ИмяКоманды = "НеСогласована" Тогда 
			
			ТекстВопроса = 
				"Заявка не будет согласована, работа с документом будет остановлена.
				|Продолжить?";		
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяКоманды = "ПередатьВРаботу" Тогда
		
		Если Не ПроверитьЗаполнение() Тогда
			Возврат;
		КонецЕсли;
		
		ЗаголовокВопроса = "Передать заявку в работу";
		
		ТекстВопроса = 
			"Заявка будет передана в работу.
			|Изменение заявки в процессе ее выполнения будет невозможно!
			|200 тысяч раз подумай, перед тем как согласиться!
			|Сходи к магу, к колдунье, спроси - что тебе делать в такой ситуации!
			|
			|Уверен? Продолжить?";

	КонецЕсли;
	
	
	ПоказатьВопрос(
		Новый ОписаниеОповещения(МетодОповещения, МодульХраненияМетодаОповещения, ДополнительныеПараметрыОповещения),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		60,,
		ЗаголовокВопроса);
	
КонецПроцедуры

