&НаСервере
Процедура УстановитьВидимость()
	
	//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
	Элементы.ГруппаСогласованиеКнопки.Видимость = Ложь;
	Элементы.КСогласованию.Видимость = Ложь;
	Элементы.КомплектующиеСоздатьКомплектующую.Видимость = Ложь;
	//-- #Б2022 смарт: Шляпников 10.02.2025

	ЭтаФорма.УзелДоляСтоимости = 100 - Объект.Комплектующие.Итог("ДоляСтоимости");
	
	ТекущееСостояние = РегистрыСведений.смартСостоянияЗаявокНаРазборкуОборудования.ПолучитьСостояниеЗаявки(Объект.Ссылка);	
	//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
	Если ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.Выполнена
		И НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.КомплектующиеПодборКомплектующих.Доступность = Ложь;
		Элементы.ПоискОборудованияПоСкладам.Доступность = Ложь;
		
		Возврат;
		
	КонецЕсли;
	//-- #Б2022 смарт: Шляпников 10.02.2025
	
	//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
	Если (ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.ВводНоменклатуры
		ИЛИ ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.НаСогласовании
		ИЛИ ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.НеСогласована
		ИЛИ ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.Выполнена
		ИЛИ ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.ВРаботе)
		И НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		Элементы.СтраницаРазбираемоеОборудование.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
	Если ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.НаСогласовании Тогда
		Элементы.ПоискОборудованияПоСкладам.Доступность = Ложь;
	КонецЕсли;
	
	Если ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.ВРаботе
		И НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		Элементы.СтраницаПолучаемыйУзелИЗапасныеЧасти.ТолькоПросмотр = Истина;
		Элементы.КомплектующиеПодборКомплектующих.Доступность = Ложь;
		Элементы.ПоискОборудованияПоСкладам.Доступность = Ложь;
		
	КонецЕсли;
	//-- #Б2022 смарт: Шляпников 10.02.2025
	
	//++ #6068 смарт: Тимофеева 01.04.2026 /  Заявка на разборку оборудования. Изменение доступа к корректировке реквизитов.
	ЭтоВводНоменклатуры = ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.ВводНоменклатуры;
	Элементы.СтраницаПолучаемыйУзелИЗапасныеЧасти.ТолькоПросмотр = НЕ ЭтоВводНоменклатуры И НЕ Пользователи.РолиДоступны("ПолныеПрава");
	Элементы.КомплектующиеПодборКомплектующих.Доступность = ЭтоВводНоменклатуры ИЛИ Пользователи.РолиДоступны("ПолныеПрава");
	//-- #6068 смарт: Тимофеева 01.04.2026
	
	МенеджерСтатусов = Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования;
	
	//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
	Если Объект.Отменена И НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.КомплектующиеПодборКомплектующих.Доступность = Ложь;
		Элементы.ПоискОборудованияПоСкладам.Доступность = Ложь;
		Элементы.ПричинаНесогласования.Видимость = 
			Объект.СтатусСогласования = МенеджерСтатусов.НеСогласована;
			
		Возврат;
			
	КонецЕсли;
	//-- #Б2022 смарт: Шляпников 10.02.2025
	
	Если Объект.СтатусСогласования = МенеджерСтатусов.КСогласованию Тогда
		//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
		ЭтаФорма.ТолькоПросмотр = Не Пользователи.РолиДоступны("смартСогласованиеЗаявокНаРазборкуОборудования,ПолныеПрава");
		//-- #Б2022 смарт: Шляпников 10.02.2025
	КонецЕсли;
				
	Если Объект.СтатусСогласования = МенеджерСтатусов.НеУстановлен
		Или Объект.СтатусСогласования = МенеджерСтатусов.КСогласованию Тогда
		
		Элементы.СтраницаПолучаемыйУзелИЗапасныеЧасти.Доступность = Ложь;
		Элементы.ГруппаСогласованиеКнопки.Видимость = Истина;
	
		Если Объект.СтатусСогласования = МенеджерСтатусов.НеУстановлен Тогда
			
			Элементы.КСогласованию.Видимость = Истина;
			
		ИначеЕсли Объект.СтатусСогласования = МенеджерСтатусов.КСогласованию Тогда
					
			ЕстьПравоНаСогласование = Пользователи.РолиДоступны("смартСогласованиеЗаявокНаРазборкуОборудования");
 
			Элементы.Согласовать.Видимость = ЕстьПравоНаСогласование;
			Элементы.НеСогласовано.Видимость = ЕстьПравоНаСогласование; 
			ЭтаФорма.ТолькоПросмотр = Не ЕстьПравоНаСогласование;
			
		КонецЕсли;
				
	Иначе
		
		//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
		Элементы.СтраницаПолучаемыйУзелИЗапасныеЧасти.Доступность = Истина;
		//-- #Б2022 смарт: Шляпников 10.02.2025
		Элементы.ПередатьВРаботу.Видимость = Не Объект.КВыполнению;
		
	КонецЕсли;
	
	Если Объект.СтатусСогласования = МенеджерСтатусов.Согласована Тогда
		
		//Элементы.Инженер.АвтоОтметкаНезаполненного = Истина;	
		//Элементы.НачалоРабот.АвтоОтметкаНезаполненного = Истина;	
		//Элементы.ОкончаниеРабот.АвтоОтметкаНезаполненного = Истина;	
		//Элементы.Узел.АвтоОтметкаНезаполненного = Истина;
		//Элементы.КомплектующиеДоляСтоимости.АвтоОтметкаНезаполненного = Истина;
		
		Элементы.ПоискОборудованияПоСкладам.Доступность = Пользователи.РолиДоступны("ПолныеПрава");
		
		Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
			Элементы.СтраницаРазбираемоеОборудование.ТолькоПросмотр = Истина;	
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ИзменитьСостояние.Видимость = Пользователи.РолиДоступны("ПолныеПрава");
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Элементы.ПоискОборудованияПоСкладам.Доступность = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте                 
Процедура ОбработатьРезультатОтветаНаВопрос(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
		
	ИмяКоманды = ДополнительныеПараметры.ИмяКоманды;
	
	РежимПроведенияДокументаОпределение = 
		?(ЗначениеЗаполнено(Объект.Ссылка), 
			РежимПроведенияДокумента.Неоперативный, 
			РежимПроведенияДокумента.Оперативный); 
	
	Если ИмяКоманды = "КСогласованию"
			Или ИмяКоманды = "Согласована"
			Или ИмяКоманды = "НеСогласована" Тогда 
			
		//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
		Если НЕ ПроверитьЗаполнение() Тогда
			Возврат;
		КонецЕсли;
		//-- #Б2022 смарт: Шляпников 10.02.2025

		Если ИмяКоманды = "НеСогласована" Тогда
			
			ПоказатьВводСтроки(
				Новый ОписаниеОповещения("ОбработатьПолучениеПричиныНесогласования", ЭтаФорма, РежимПроведенияДокументаОпределение),
				"",
				"Уточните причину, по которой в согласовании заявки отказано.",
				1024,
				Истина);
				
		Иначе 
			
			//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
			ИзменитьСтатусСогласования(ДополнительныеПараметры.ИмяКоманды);
			ЗаписатьДокумент(РежимПроведенияДокументаОпределение);
			Закрыть();
			//-- #Б2022 смарт: Шляпников 10.02.2025
				
		КонецЕсли;
				
	ИначеЕсли ИмяКоманды = "ПередатьВРаботу" Тогда
		
		УстановитьПризнакКВыполнению(Истина);
		Если ПроверитьЗаполнение() Тогда
			
			Если Не СформироватьУзел() Тогда
				Возврат;	
			КонецЕсли;
			
	 		ЭтаФорма.Записать(
				Новый Структура("РежимЗаписи, РежимПроведения, ТребуетсяЗакрытьФорму", 
					РежимЗаписиДокумента.Проведение, РежимПроведенияДокументаОпределение));
					
		Иначе	
			УстановитьПризнакКВыполнению(Ложь);		
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

//++ #Б2022 смарт: Шляпников 10.02.2025 / Заявка на разборку оборудования. Исправление ошибок.
&НаСервере
Процедура УстановитьПричинуНесогласования(Причина, РежимПроведенияДокументаОпределение)
	
	УстановитьПривилегированныйРежим(Истина);
	Объект.ПричинаНесогласования = Причина;
	УстановитьПривилегированныйРежим(Ложь);
	
	ЗаписатьДокумент(РежимПроведенияДокументаОпределение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДокумент(РежимПроведенияДокументаОпределение)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записать(Новый Структура("РежимЗаписи, РежимПроведения, ТребуетсяЗакрытьФорму", 
							  РежимЗаписиДокумента.Проведение, РежимПроведенияДокументаОпределение));
							  
	УстановитьВидимость();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

