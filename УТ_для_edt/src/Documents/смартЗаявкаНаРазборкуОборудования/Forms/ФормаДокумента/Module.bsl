&НаСервере
Процедура РассчитатьЗатраченноеВремяНаСервере()
	
	Для Нум = 1 По 2 Цикл
		
		ЕстьНезаполненныеПоля = Ложь;
		Постфикс = ?(Нум = 2, "2", ""); 
		Таблица = Объект["ЗатраченноеВремяИнженера" + Постфикс];
		
		Для Каждого СтрокаТаблицы Из Таблица Цикл
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяНачалаРабот) 
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяОкончанияРабот) Тогда 
				
				СтрокаТаблицы.Часы = (СтрокаТаблицы.ДатаИВремяОкончанияРабот - СтрокаТаблицы.ДатаИВремяНачалаРабот) / 60 / 60;
				
			Иначе
				
				ЕстьНезаполненныеПоля = Истина;
				СтрокаТаблицы.Часы = 0;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Объект["ЗатраченоЧасов" + Постфикс] = ?(ЕстьНезаполненныеПоля, 0, Таблица.Итог("Часы"));	
		
	КонецЦикла;
			
КонецПроцедуры

&НаСервере
Процедура СформироватьНаименованиеНовогоУзла()

	НайденныеСтроки = 
		ЭтаФорма.Объект.Комплектующие.НайтиСтроки(
			Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка()));
			
	Если НайденныеСтроки.Количество() Тогда
		Возврат;
	КонецЕсли;

	Таблица = ЭтаФорма.Объект.Комплектующие.Выгрузить(, "Номенклатура, Количество");
	ДополнитьМассивКомплектующихРекурсивно(ЭтаФорма.Объект.Номенклатура, Таблица);
	
	Таблица.Свернуть("Номенклатура", "Количество");
	
	Таблица.Колонки.Добавить("УникальныйИдентификаторСтрокой", 
		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
		
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		СтрокаТаблицы.УникальныйИдентификаторСтрокой = 
			Строка(СтрокаТаблицы.Номенклатура.УникальныйИдентификатор());
		
	КонецЦикла;
	
	Таблица.Сортировать("УникальныйИдентификаторСтрокой Возр");
	
	ЭтаФорма.КорневоеОборудование = ПолучитьКорневойУзелРазобранногоОборудования(Объект.Номенклатура);
	
	РазобранноеОборудованиеИдентификаторУзла = "";
	
	//++ #Б2028 смарт: Шляпников 11.02.2025 / Заявка на разборку оборудования. Формирование нового узла номенклатуры (результат разборки).
	МассивИдентификаторов = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		МассивИдентификаторов.Добавить(СтрШаблон("%1#%2", СтрокаТаблицы.УникальныйИдентификаторСтрокой, СтрокаТаблицы.Количество));
	КонецЦикла;
	
	РазобранноеОборудованиеИдентификаторУзла = СтрСоединить(МассивИдентификаторов, ";");
	
	CRC32 = Новый ХешированиеДанных(ХешФункция.CRC32);
	CRC32.Добавить(РазобранноеОборудованиеИдентификаторУзла);
	
	РазобранноеОборудованиеИдентификаторУзла = СтрЗаменить(Строка(CRC32.ХешСумма), Символы.НПП, "");
	
	НаименованиеУзла = СтрШаблон("%1 (Не комплект:%2)", ЭтаФорма.КорневоеОборудование.Наименование, РазобранноеОборудованиеИдентификаторУзла);
	КоличествоСимволовОбрезания = СтрДлина(НаименованиеУзла) - Метаданные.Справочники.Номенклатура.ДлинаНаименования;
	Если КоличествоСимволовОбрезания > 0 Тогда
		ОбрезанноеНаименованиеРазбираемогоОборудования = Лев(ЭтаФорма.КорневоеОборудование.Наименование, СтрДлина(ЭтаФорма.КорневоеОборудование.Наименование) - КоличествоСимволовОбрезания);
		НаименованиеУзла = СтрШаблон("%1 (Не комплект:%2)", ОбрезанноеНаименованиеРазбираемогоОборудования, РазобранноеОборудованиеИдентификаторУзла);
	КонецЕсли;
	//-- #Б2028 смарт: Шляпников 11.02.2025
	
	ЭтаФорма.Объект.Узел = НайтиСуществующийУзел(РазобранноеОборудованиеИдентификаторУзла);
			
	ЭтаФорма.Элементы.Узел.ПодсказкаВвода = НаименованиеУзла;
	ЭтаФорма.ИдентификаторНовогоУзла = РазобранноеОборудованиеИдентификаторУзла; 
	
КонецПроцедуры

&НаСервере
Функция НайтиСуществующийУзел(РазобранноеОборудованиеИдентификаторУзла)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.смартРазобранноеОборудование = &смартРазобранноеОборудование
	|	И Номенклатура.смартРазобранноеОборудованиеИдентификаторУзла = &смартРазобранноеОборудованиеИдентификаторУзла";
	
	Запрос.УстановитьПараметр("смартРазобранноеОборудование", Объект.Номенклатура);
	Запрос.УстановитьПараметр("смартРазобранноеОборудованиеИдентификаторУзла", РазобранноеОборудованиеИдентификаторУзла);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

&НаСервере
Процедура ДополнитьМассивКомплектующихРекурсивно(РазобранноеОборудование, Таблица)

	Если Не ЗначениеЗаполнено(РазобранноеОборудование.смартРазобранноеОборудование) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(РазобранноеОборудование.смартСнятыеКомплектующие, Таблица);
	ДополнитьМассивКомплектующихРекурсивно(РазобранноеОборудование.смартРазобранноеОборудование, Таблица);
 	
КонецПроцедуры

&НаСервере
Функция ПолучитьКорневойУзелРазобранногоОборудования(Оборудование) 

	Возврат ?(ЗначениеЗаполнено(Оборудование.смартРазобранноеОборудование),
				ПолучитьКорневойУзелРазобранногоОборудования(Оборудование.смартРазобранноеОборудование),
				Оборудование);
	
КонецФункции

&НаСервере
Функция СформироватьУзел()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ЭтаФорма.Объект.Узел) Тогда
		Возврат Истина;
	КонецЕсли;
	
	НоваяНоменклатура = ЭтаФорма.Объект.Номенклатура.Скопировать();

	НоваяНоменклатура.Наименование = ЭтаФорма.Элементы.Узел.ПодсказкаВвода;
	НоваяНоменклатура.НаименованиеПолное = НоваяНоменклатура.Наименование; 
	
	//++ #Б2028 смарт: Шляпников 11.02.2025 / Заявка на разборку оборудования. Формирование нового узла номенклатуры (результат разборки).
	НоваяНоменклатура.Артикул = СтрШаблон("%1_%2", КорневоеОборудование.Артикул, ИдентификаторНовогоУзла);
	//-- #Б2028 смарт: Шляпников 11.02.2025
			
	НоваяНоменклатура.смартРазобранноеОборудование = ЭтаФорма.Объект.Номенклатура;
	
	Таблица = ЭтаФорма.Объект.Комплектующие.Выгрузить(, "Номенклатура, Количество");
	ДополнитьМассивКомплектующихРекурсивно(ЭтаФорма.Объект.Номенклатура, Таблица);

	Таблица.Колонки.Добавить("УникальныйИдентификаторСтрокой", 
		Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(36)));
		
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		СтрокаТаблицы.УникальныйИдентификаторСтрокой = 
			Строка(СтрокаТаблицы.Номенклатура.УникальныйИдентификатор());
		
	КонецЦикла;
	
	Таблица.Сортировать("УникальныйИдентификаторСтрокой Возр");
	Таблица.Свернуть("Номенклатура", "Количество");	
	
	НоваяНоменклатура.смартСнятыеКомплектующие.Загрузить(Таблица);
	
	НоваяНоменклатура.смартРазобранноеОборудованиеИдентификаторУзла = 
		ЭтаФорма.ИдентификаторНовогоУзла;
		
	НачатьТранзакцию();
	
	Попытка
		
		НоваяНоменклатура.Записать();
		ЭтаФорма.Объект.Узел = НоваяНоменклатура.Ссылка;
		
		ВыборкаУпаковок = Справочники.УпаковкиЕдиницыИзмерения.Выбрать(, ЭтаФорма.Объект.Номенклатура);
		Пока ВыборкаУпаковок.Следующий() Цикл
			
			НоваяУпаковка = Справочники.УпаковкиЕдиницыИзмерения.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НоваяУпаковка, ВыборкаУпаковок,, "Код, Владелец");
			
			НоваяУпаковка.Владелец = НоваяНоменклатура.Ссылка;	
			
			НоваяУпаковка.Записать();
			
		КонецЦикла; 
		
		ЗафиксироватьТранзакцию();
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Истина;
		
	Исключение
		
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = СтрШаблон("Не удалось сформировать узел, по причине: %1%2", Символы.ПС, ТекстОшибки);
		Сообщить(ТекстСообщения);
		
		ОтменитьТранзакцию(); 
		УстановитьПривилегированныйРежим(Ложь);
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура РассчитатьДолюСтоимостиВТекущейСтроке()
	
	Если Элементы.Комплектующие.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Комплектующие.НайтиПоИдентификатору(Элементы.Комплектующие.ТекущаяСтрока);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КоличествоОстаток КАК Количество,
	|	СтоимостьОстаток + ДопРасходыОстаток КАК Стоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(
	|			,
	|			АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|				И АналитикаУчетаНоменклатуры.Серия = &Серия
	|				И АналитикаУчетаНоменклатуры.МестоХранения = &Склад)";
	
	Запрос.УстановитьПараметр("Номенклатура", Объект.Номенклатура);
	Запрос.УстановитьПараметр("Серия", Объект.Серия);
	Запрос.УстановитьПараметр("Склад", ?(ЗначениеЗаполнено(Объект.ПереместитьСоСклада), Объект.ПереместитьСоСклада, Объект.Склад));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> 0 И Выборка.Стоимость <> 0 Тогда
		ТекущаяСтрока.ДоляСтоимости = ТекущаяСтрока.Стоимость * ТекущаяСтрока.Количество * 100 / Выборка.Стоимость / Выборка.Количество;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не удалось рассчитать долю стоимости. Необходимо рассчитать себестоимость разбираемого оборудования.");
		ТекущаяСтрока.ДоляСтоимости = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискОборудованияПоСкладамЗавершение(Значение, ДопПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, Значение, "Номенклатура, Серия, Назначение");
		
	Если Не Значение.Склад = Объект.Склад Тогда
		Объект.ПереместитьСоСклада = Значение.Склад;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСостояниеЗавершение(Значение, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		Если Значение = ПредопределенноеЗначение("Перечисление.смартСостоянияЗаявокНаРазборкуОборудования.Отменена") Тогда
			ОтменитьЗаявкуЗавершение(КодВозвратаДиалога.Да, Неопределено);
		Иначе
			ИзменитьСостояниеЗаявкиСервер(Значение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьСостояниеЗаявкиСервер(НовоеСостояние)
	
	Если НовоеСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.Отменена Тогда
		
		Объект.Отменена = Истина;
		Объект.КВыполнению = Ложь;
		Объект.КВыполнению = Ложь;
		Объект.СтатусСогласования = Неопределено;
		
	Иначе
		Объект.Отменена = Ложь;
	КонецЕсли;
	
	Записать();
	
	МенеджерЗаписи = РегистрыСведений.смартСостоянияЗаявокНаРазборкуОборудования.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = ТекущаяДатаСеанса();
	МенеджерЗаписи.Заявка = Объект.Ссылка;
	МенеджерЗаписи.Состояние = НовоеСостояние;
	МенеджерЗаписи.Записать(Истина);
	
	ТекущееСостояние = НовоеСостояние;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьЗаявкуЗавершение(Значение, ДопПараметры) Экспорт
	
	Если НЕ Значение = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьОтменыЗаявки() Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ИзменитьСостояниеЗаявкиСервер(ПредопределенноеЗначение("Перечисление.смартСостоянияЗаявокНаРазборкуОборудования.Отменена"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьОтменыЗаявки()
	
	ТекущееСостояние = РегистрыСведений.смартСостоянияЗаявокНаРазборкуОборудования.ПолучитьСостояниеЗаявки(Объект.Ссылка);
	Если НЕ ТекущееСостояние = Перечисления.смартСостоянияЗаявокНаРазборкуОборудования.Подготовка Тогда
		ОбщегоНазначения.СообщитьПользователю("Отменять можно только заявки в статусе ""Подготовка""", Объект.Ссылка);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Объект.Проведен Тогда
		ОбщегоНазначения.СообщитьПользователю("Отменять можно только проведенные заявки", Объект.Ссылка);
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	смартОборудованиеКРазборкеОбороты.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.смартОборудованиеКРазборке.Обороты(, , Регистратор, Заявка = &Заявка) КАК смартОборудованиеКРазборкеОбороты
	|ГДЕ
	|	НЕ смартОборудованиеКРазборкеОбороты.Регистратор ССЫЛКА Документ.смартЗаявкаНаРазборкуОборудования";
	
	Запрос.УстановитьПараметр("Заявка", Объект.Ссылка);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		ОбщегоНазначения.СообщитьПользователю("По заявке уже созданы документы. Отмена невозможна.", Объект.Ссылка);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти







