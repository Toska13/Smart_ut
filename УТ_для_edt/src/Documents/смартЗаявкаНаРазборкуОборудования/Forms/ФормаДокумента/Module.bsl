&НаСервере
Процедура ДобавитьОбновитьКомплектующие(Данные)

	НайденныеСтроки = Объект.Комплектующие.НайтиСтроки(Новый Структура("Номенклатура", Данные.Номенклатура));
	Если Не НайденныеСтроки.Количество() Тогда
		
		НоваяСтрока = Объект.Комплектующие.Добавить();
		НоваяСтрока.Номенклатура = Данные.Номенклатура;
		НоваяСтрока.Количество = 1;
		НоваяСтрока.НеЗаказывать = Объект.СборкаНеТребуется;
		
	КонецЕсли;
	
	КомплектующиеНоменклатураПриИзмененииНаСервере();
