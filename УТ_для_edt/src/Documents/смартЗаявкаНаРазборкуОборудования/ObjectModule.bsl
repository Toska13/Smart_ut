#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
		
		Организация = ДанныеЗаполнения.Организация;
		Подразделение = ДанныеЗаполнения.Представительство;
		
		Если ДокументОснование.Оборудование.Количество() Тогда
			Номенклатура = ДокументОснование.Оборудование[0].Оборудование; 
		КонецЕсли;
		
	КонецЕсли;
	
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		ДокументОснование = ДанныеЗаполнения;
	КонецЕсли;	
	//-- #1989 смарт: Лопато 15.08.2024
	
	ИнициализироватьДокумент(ДанныеЗаполнения);
		
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Ссылка.СтатусСогласования = Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.Согласована
			И ЭтотОбъект.КВыполнению 
		Тогда
		
		ПроверяемыеРеквизиты.Добавить("Инженер");
		ПроверяемыеРеквизиты.Добавить("НачалоРабот");
		ПроверяемыеРеквизиты.Добавить("ОкончаниеРабот");
		
		ПроверяемыеРеквизиты.Добавить("Комплектующие");
		
		ПроверяемыеРеквизиты.Добавить("Комплектующие.Номенклатура");
		ПроверяемыеРеквизиты.Добавить("Комплектующие.ДоляСтоимости");
		ПроверяемыеРеквизиты.Добавить("Комплектующие.Количество");
		ПроверяемыеРеквизиты.Добавить("Комплектующие.ПереместитьНаСклад");
				
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Ответственный = Пользователи.ТекущийПользователь();
	
	Если Склад.Пустая() Тогда
		Склад = Справочники.Склады.НайтиПоНаименованию("Ремонтная зона", Истина);  // Временно		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи); 
	
	Если СтатусСогласования = 
			Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.НеСогласована Тогда
		
		Отменена = Истина;
		
	КонецЕсли;
	
	//++ #Б2340 смарт: Шляпников 17.02.2025 / Заявка на разборку оборудования. Подготовка справочника Назначения.
	Если Ссылка.СтатусСогласования = Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.Согласована
			И ЭтотОбъект.КВыполнению 
		Тогда
		
		РеквизитыПроверки = "Номенклатура,Серия,Узел";
		
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.СнятаяЗапаснаяЧасть);
		Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(НазначениеСнятаяЗапаснаяЧасть, ШаблонНазначения, ЭтотОбъект, РеквизитыПроверки, Отказ);
		
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.ПолученныйУзел);
		Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(НазначениеПолученныйУзел, ШаблонНазначения, ЭтотОбъект, РеквизитыПроверки, Отказ);
		
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.НаЗаменуСнятойЗапаснойЧасти);
		Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(НазначениеНаЗаменуСнятойЗапаснойЧасти, ШаблонНазначения, ЭтотОбъект, РеквизитыПроверки, Отказ);
												
	КонецЕсли;
	//-- #Б2340 смарт: Шляпников 17.02.2025
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);

	Документы.смартЗаявкаНаРазборкуОборудования.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	смартСборкаРазборкаОборудованияСервер.ОтразитьЗаявкиНаРазборкуОборудования(ДополнительныеСвойства, Движения, Отказ);
	смартСборкаРазборкаОборудованияСервер.ОтразитьОборудованиеКРазборке(ДополнительныеСвойства, Движения, Отказ);
	
	СформироватьСписокРегистровДляКонтроля();
	
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	смартПроведениеСервер.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	РегистрыСведений.смартСостоянияЗаявокНаРазборкуОборудования.ОтразитьСостояниеЗаявки(Ссылка, Отказ,, Ссылка);
	
КонецПроцедуры  

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	СформироватьСписокРегистровДляКонтроля();

	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	смартПроведениеСервер.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	
	РегистрыСведений.смартСостоянияЗаявокНаРазборкуОборудования.ОтразитьСостояниеЗаявки(Ссылка, Отказ, Истина, Ссылка);
	
КонецПроцедуры  

Процедура ПриКопировании(ОбъектКопирования)
	
	КВыполнению = Ложь;
	Отменена = Ложь;
	Узел = Справочники.Номенклатура.ПустаяСсылка();
	УзелПереместитьНаСклад = Справочники.Склады.ПустаяСсылка();
	ДокументОснование = Неопределено; 
	Серия = Справочники.СерииНоменклатуры.ПустаяСсылка();
	ПереместитьСоСклада = Справочники.Склады.ПустаяСсылка();
	ПричинаРазборки = "";
	ЖелаемаяДатаРазбора = Дата(1, 1, 1);
	СтатусСогласования = Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.НеУстановлен;
	ПричинаНесогласования = "";
	
	СтатусСогласования = 
		Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.НеУстановлен;
		
	//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
	НазначениеСнятаяЗапаснаяЧасть = Неопределено;
	НазначениеПолученныйУзел = Неопределено;
	НазначениеНаЗаменуСнятойЗапаснойЧасти = Неопределено;
	СборкаНеТребуется = Ложь;
	//-- #Б2138 смарт: Шляпников 19.02.2025

	ИнициализироватьДокумент();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	//++ #Б2340 смарт: Шляпников 17.02.2025 / Заявка на разборку оборудования. Подготовка справочника Назначения.
	Если Ссылка.СтатусСогласования = Перечисления.смартСтатусыСогласованияЗаявокНаРазборкуОборудования.Согласована
			И ЭтотОбъект.КВыполнению 
		Тогда
		
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.СнятаяЗапаснаяЧасть);
		Справочники.Назначения.ПриЗаписиДокумента(НазначениеСнятаяЗапаснаяЧасть,
												  ШаблонНазначения,
												  ЭтотОбъект,
												  Неопределено,
												  Неопределено);
												  
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.ПолученныйУзел);
		Справочники.Назначения.ПриЗаписиДокумента(НазначениеПолученныйУзел,
												  ШаблонНазначения,
												  ЭтотОбъект,
												  Неопределено,
												  Неопределено);
												  
		ШаблонНазначения = Документы.смартЗаявкаНаРазборкуОборудования.ШаблонНазначения(ЭтотОбъект, Перечисления.смартТипыНазначенийРазобранногоОборудования.НаЗаменуСнятойЗапаснойЧасти);
		Справочники.Назначения.ПриЗаписиДокумента(НазначениеНаЗаменуСнятойЗапаснойЧасти,
												  ШаблонНазначения,
												  ЭтотОбъект,
												  Неопределено,
												  Неопределено);
												  
	КонецЕсли;
	//-- #Б2340 смарт: Шляпников 17.02.2025
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

Процедура СформироватьСписокРегистровДляКонтроля()
	
	Массив = Новый Массив;
	Массив.Добавить(Движения.смартЗаявкиНаРазборкуОборудования);
	Массив.Добавить(Движения.смартОборудованиеКРазборке);
		
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);

КонецПроцедуры

#КонецОбласти

#КонецЕсли

