#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	////////////////////////////////////////////////////////////////////////////
	// Создадим запрос инициализации движений
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка); 
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаЗаявкиНаРазборкуОборудования(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаОборудованиеКРазборке(Запрос, ТекстыЗапроса, Регистры);

	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = "ВЫБРАТЬ";
	
	Для Каждого Реквизит Из Метаданные.Документы.смартЗаявкаНаРазборкуОборудования.СтандартныеРеквизиты Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	" + Реквизит.Имя + " КАК " + Реквизит.Имя + ",";
		
	КонецЦикла;
	
	Для Каждого Реквизит Из Метаданные.Документы.смартЗаявкаНаРазборкуОборудования.Реквизиты Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	" + Реквизит.Имя + " КАК " + Реквизит.Имя + ",";
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "ИЗ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, ",ИЗ", Символы.ПС + "ИЗ" + Символы.ПС);
	
	Запрос.Текст = Запрос.Текст + "
	|	Документ.смартЗаявкаНаРазборкуОборудования
	|ГДЕ
	|	Ссылка = &Ссылка
	|";
	Реквизиты = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Колонка Из Реквизиты.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[0][Колонка.Имя]); 
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Период", Реквизиты[0].Дата);
	Запрос.УстановитьПараметр("ПустойСклад", Справочники.Склады.ПустаяСсылка());
	
КонецПроцедуры  

Функция ТекстЗапросаТаблицаЗаявкиНаРазборкуОборудования(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "смартЗаявкиНаРазборкуОборудования";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	&Ссылка КАК Заявка,
	|	&Номенклатура КАК Номенклатура,
	|	&Серия КАК Серия,
	|	1 КАК КРазборке,
	|	0 КАК КПолучению
	|
	|ГДЕ
	|	&КВыполнению И НЕ &Отменена
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	&Ссылка КАК Заявка,
	|	Номенклатура КАК Номенклатура,
	|	&Серия КАК Серия, 
	|	0 КАК КРазборке,
	|	Количество КАК КПолучению
	|ИЗ
	|	Документ.смартЗаявкаНаРазборкуОборудования.Комплектующие
	|ГДЕ
	|	Ссылка = &Ссылка
	|	И &КВыполнению И НЕ &Отменена	
	|	
	|ОБЪЕДИНИТЬ 
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	&Ссылка КАК Заявка,
	|	&Узел КАК Номенклатура,
	|	&Серия КАК Серия,
	|	0 КАК КРазборке,
	|	1 КАК КПолучению
	|
	|ГДЕ
	|	&КВыполнению И НЕ &Отменена	
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

