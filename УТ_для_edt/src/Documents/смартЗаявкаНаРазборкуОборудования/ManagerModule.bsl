#Область Назначения

//++ #Б2340 смарт: Шляпников 17.02.2025 / Заявка на разборку оборудования. Подготовка справочника Назначения.
// Возврашает шаблон для генерации назначения товаров в документе.
//
// Параметры:
// 		Объект - ДокументОбъект.ЗаказКлиента, ДанныеФормыСтруктура - заказ клиента, по которому необходимо получить шаблон назначения.
//
// Возвращаемое значение:
// 		Структура - (см. функцию Справочники.Назначения.ШаблонНового).
//
Функция ШаблонНазначения(Объект, ЧтоПроизошло) Экспорт
	
	ШаблонНазначения = Справочники.Назначения.ШаблонНового();
	ШаблонНазначения.Заказ = Объект.Ссылка;
	ШаблонНазначения.смартРазобранноеОборудованиеТипНазначения = ЧтоПроизошло;
	ШаблонНазначения.смартРазобранноеОборудование = Объект.Номенклатура;
	ШаблонНазначения.смартРазобранноеОборудованиеСерия = Объект.Серия;
	ШаблонНазначения.смартРазобранноеОборудованиеУзел = Объект.Узел;
	
	Возврат ШаблонНазначения;
	
КонецФункции

#КонецОбласти

#КонецЕсли
