Функция ПолучитьСсылкуНаЗаявкуПоОснованию(ДокументСсылка, ВсеЗаявки = Неопределено) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказНаПеремещение")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
			
		//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
		Заявка = ?(ТипЗнч(ДокументСсылка.ДокументОснование) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования"),
					ДокументСсылка.ДокументОснование,
					Документы.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка());
		
		Если ВсеЗаявки = Неопределено Тогда
			Возврат Заявка;
		Иначе
			Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Заявка);
		КонецЕсли;
		//-- #Б2138 смарт: Шляпников 19.02.2025
			
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкиНаРазборку.Ссылка КАК Заявка
	|ИЗ
	|	Документ.ПеремещениеТоваров КАК Перемещение
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ЗаказыНаПеремещение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРазборкуОборудования КАК ЗаявкиНаРазборку
	|		ПО
	|			ЗаявкиНаРазборку.Ссылка = ЗаказыНаПеремещение.ДокументОснование
	|			И ЗаявкиНаРазборку.Проведен
	|	ПО
	|		ЗаказыНаПеремещение.Ссылка = Перемещение.ЗаказНаПеремещение
	|		И ЗаказыНаПеремещение.Проведен
	|ГДЕ
	|	Перемещение.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ
	|       
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаявкиНаРазборку.Ссылка КАК Заявка
	|ИЗ
	|	Документ.СборкаТоваров КАК СборкаТоваров
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаСборку КАК ЗаказыНаСборку
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРазборкуОборудования КАК ЗаявкиНаРазборку
	|		ПО
	|			ЗаявкиНаРазборку.Ссылка = ЗаказыНаСборку.ДокументОснование
	|			И ЗаявкиНаРазборку.Проведен
	|	ПО
	|		ЗаказыНаСборку.Ссылка = СборкаТоваров.ЗаказНаСборку
	|		И ЗаказыНаСборку.Проведен
	|ГДЕ
	|	СборкаТоваров.Ссылка = &ДокументСсылка
	//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
	//|	И СборкаТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РазборкаТоваров)
	|
	|ОБЪЕДИНИТЬ
	|       
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Назначения.Заказ КАК Заявка
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК Товары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|	ПО Товары.Назначение = Назначения.Ссылка
	|		И Назначения.Заказ ССЫЛКА Документ.смартЗаявкаНаРазборкуОборудования
	|		И НЕ Назначения.Заказ = ЗНАЧЕНИЕ(Документ.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка)
	|ГДЕ
	|	Товары.Ссылка = &ДокументСсылка
	|
	|ОБЪЕДИНИТЬ
	|       
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Назначения.Заказ КАК Заявка
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК Товары
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Назначения КАК Назначения
	|	ПО Товары.Назначение = Назначения.Ссылка
	|		И Назначения.Заказ ССЫЛКА Документ.смартЗаявкаНаРазборкуОборудования
	|		И НЕ Назначения.Заказ = ЗНАЧЕНИЕ(Документ.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка)
	|ГДЕ
	|	Товары.Ссылка = &ДокументСсылка";
	
	МассивЗаявок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заявка");
	
	Возврат ?(ВсеЗаявки = Неопределено, 
			  ?(МассивЗаявок.Количество() > 0, МассивЗаявок[0], Документы.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка()),
			  МассивЗаявок);
	//-- #Б2138 смарт: Шляпников 19.02.2025
	
КонецФункции

