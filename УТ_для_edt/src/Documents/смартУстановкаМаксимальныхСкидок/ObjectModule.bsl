#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.смартМаксимальныеСкидки.Записывать = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Дата КАК Период,
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Организация КАК Организация,
	|	смартУстановкаМаксимальныхСкидокТовары.Номенклатура КАК Номенклатура,
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Партнер КАК Партнер,
	|	смартУстановкаМаксимальныхСкидокТовары.МаксимальнаяСкидка КАК МаксимальнаяСкидка,
	|	смартУстановкаМаксимальныхСкидокТовары.Отменена КАК Отменена,
	|	смартУстановкаМаксимальныхСкидокТовары.СкидкаЗапрещена КАК СкидкаЗапрещена,
	|	ЛОЖЬ КАК ДляДилеров
	|ИЗ
	|	Документ.смартУстановкаМаксимальныхСкидок.Товары КАК смартУстановкаМаксимальныхСкидокТовары
	|ГДЕ
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка = &Ссылка
	|	И (смартУстановкаМаксимальныхСкидокТовары.МаксимальнаяСкидка > 0
	|			ИЛИ смартУстановкаМаксимальныхСкидокТовары.СкидкаЗапрещена
	|			ИЛИ смартУстановкаМаксимальныхСкидокТовары.Отменена)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Дата,
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Организация,
	|	смартУстановкаМаксимальныхСкидокТовары.Номенклатура,
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка.Партнер,
	|	смартУстановкаМаксимальныхСкидокТовары.МаксимальнаяСкидкаДляДилеров,
	|	смартУстановкаМаксимальныхСкидокТовары.Отменена,
	|	смартУстановкаМаксимальныхСкидокТовары.СкидкаЗапрещена,
	|	ИСТИНА
	|ИЗ
	|	Документ.смартУстановкаМаксимальныхСкидок.Товары КАК смартУстановкаМаксимальныхСкидокТовары
	|ГДЕ
	|	смартУстановкаМаксимальныхСкидокТовары.Ссылка = &Ссылка
	|	И (смартУстановкаМаксимальныхСкидокТовары.МаксимальнаяСкидкаДляДилеров > 0
	|			ИЛИ смартУстановкаМаксимальныхСкидокТовары.СкидкаЗапрещена
	|			ИЛИ смартУстановкаМаксимальныхСкидокТовары.Отменена)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Движения.смартМаксимальныеСкидки.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры
	
