&НаСервере
Процедура ЗаполнитьДействующимиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартМаксимальныеСкидкиСрезПоследних.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА смартМаксимальныеСкидкиСрезПоследних.ДляДилеров
	|				ТОГДА смартМаксимальныеСкидкиСрезПоследних.МаксимальнаяСкидка
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК МаксимальнаяСкидкаДляДилеров,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА смартМаксимальныеСкидкиСрезПоследних.ДляДилеров
	|				ТОГДА 0
	|			ИНАЧЕ смартМаксимальныеСкидкиСрезПоследних.МаксимальнаяСкидка
	|		КОНЕЦ) КАК МаксимальнаяСкидка,
	|	МАКСИМУМ(смартМаксимальныеСкидкиСрезПоследних.СкидкаЗапрещена) КАК СкидкаЗапрещена
	|ИЗ
	|	РегистрСведений.смартМаксимальныеСкидки.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И Партнер = &Партнер) КАК смартМаксимальныеСкидкиСрезПоследних
	|ГДЕ
	|	НЕ смартМаксимальныеСкидкиСрезПоследних.Отменена
	|
	|СГРУППИРОВАТЬ ПО
	|	смартМаксимальныеСкидкиСрезПоследних.Номенклатура";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Партнер", Объект.Партнер);
	
	Объект.Товары.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

