#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область Проведение

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);
	
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицасмартASP_НакоплениеБонусов(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицасмартБонусыЗаМаркетинговыеМероприятия(Запрос, ТекстыЗапроса, Регистры);
	
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
КонецПроцедуры 

Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДокумента.Дата 						КАК Период
	|ИЗ
	|	Документ.смартБонусыЗаМаркетинговыеМероприятия КАК ДанныеДокумента
	|ГДЕ
	|	ДанныеДокумента.Ссылка = &Ссылка
	|";	
	Реквизиты = Запрос.Выполнить().Выгрузить();
		
	Для Каждого Колонка Из Реквизиты.Колонки Цикл
		Запрос.УстановитьПараметр(Колонка.Имя, Реквизиты[0][Колонка.Имя]);
	КонецЦикла;
	
КонецПроцедуры 

Функция ТекстЗапросаТаблицасмартASP_НакоплениеБонусов(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартASP_НакоплениеБонусов";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(Перечисление.смартASP_ТипыБонусов.ПроведениеМаркетинговыхМероприятий) КАК ТипБонуса,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.Инженер КАК Инженер,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.СуммаБонуса КАК Сумма
	|ИЗ
	|	Документ.смартБонусыЗаМаркетинговыеМероприятия.Бонусы КАК смартБонусыЗаМаркетинговыеМероприятияБонусы
	|ГДЕ
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.Ссылка = &Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции 

Функция ТекстЗапросаТаблицасмартБонусыЗаМаркетинговыеМероприятия(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартБонусыЗаМаркетинговыеМероприятия";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	&Ссылка КАК Регистратор,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.Инженер КАК Инженер,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.МаркетинговоеМероприятие КАК МаркетинговоеМероприятие,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.ЗаказКлиента КАК ЗаказКлиента,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.Номенклатура КАК Номенклатура,
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.СуммаБонуса КАК Сумма
	|ИЗ
	|	Документ.смартБонусыЗаМаркетинговыеМероприятия.Бонусы КАК смартБонусыЗаМаркетинговыеМероприятияБонусы
	|ГДЕ
	|	смартБонусыЗаМаркетинговыеМероприятияБонусы.Ссылка = &Ссылка";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции    

