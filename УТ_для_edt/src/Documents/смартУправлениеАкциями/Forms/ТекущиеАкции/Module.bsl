#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Организация", Организация);
	
	Если Параметры.Свойство("АдресТаблицыАкций") Тогда
		
		ТЗ = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыАкций);
		ТаблицаАкцийВДокументе.Загрузить(ТЗ);
		
	КонецЕсли;
	
	ОбновитьСписокДоступныхАкций();
	
КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытияЭлементов

&НаКлиенте
Процедура ДоступныеАкцииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока <> Неопределено Тогда
		
		ДоступныеАкцииВыборСервер(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДоступныеАкцииВыборСервер(ВыбраннаяСтрока)
	
	СтрокаАкция = ТаблицаДоступныхАкций.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ТЗ = ТаблицаДоступныхАкций.Выгрузить(Новый Структура("ВидАкции", Неопределено));
	СтруктураПоиска = Новый Структура;
	Для каждого стрКолонка Из ТЗ.Колонки Цикл
		СтруктураПоиска.Вставить(стрКолонка.Имя, СтрокаАкция[стрКолонка.Имя]);
	КонецЦикла;
	
	СтруктураПоиска.Удалить("Количество");
	СтруктураПоиска.Удалить("ПроцентСкидки");
	СтруктураПоиска.Удалить("ЦенаРозница");
	СтруктураПоиска.Удалить("КодСтроки");
	
	НайденныеСтроки = ТаблицаАкцийВДокументе.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() > 0 И ЗначениеЗаполнено(СтрокаАкция.Серия) Тогда
		
		Возврат;
		
	ИначеЕсли НайденныеСтроки.Количество() > 0 Тогда
		
		Если НайденныеСтроки[0].КоличествоДобавлено < СтрокаАкция.Количество Тогда
			НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество + 1;
			НайденныеСтроки[0].КоличествоДобавлено = НайденныеСтроки[0].КоличествоДобавлено + 1;
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = ТаблицаАкцийВДокументе.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАкция);
		НоваяСтрока.Количество = 1;
		НоваяСтрока.КоличествоДобавлено = 1;
		
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Функция ПоместитьАцииДляПередачиВДокумент()
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаАкцийВДокументе.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	Закрыть(ПоместитьАцииДляПередачиВДокумент());
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ОбновитьСписокДоступныхАкций()
	
	ТаблицаДоступныхАкций.Очистить();
	
	ПараметрыАкций = Новый Структура;
	ПараметрыАкций.Вставить("Организация", Организация);
	
	ТЗАкций = смартАкцииИСкидки.ПолучитьДействующиеАкции(ТекущаяДата(), ПараметрыАкций);
	
	Для каждого стрАкция ИЗ ТЗАкций Цикл
		
		НоваяСтрока = ТаблицаДоступныхАкций.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрАкция);
		НоваяСтрока.ПроцентСкидки = ?(НоваяСтрока.ЦенаРозница = 0, 0, (НоваяСтрока.ЦенаРозница - НоваяСтрока.ЦенаАкция) * 100 / НоваяСтрока.ЦенаРозница);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти