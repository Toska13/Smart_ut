  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	ТоварыНаСкладахОстатки.Серия КАК Серия,
	СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток - ТоварыНаСкладахОстатки.КОтгрузкеОстаток) КАК Количество
ПОМЕСТИТЬ ОстаткиДомозала
ИЗ
	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад.смартНазначениеСклада = ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ДемоЗал)) КАК ТоварыНаСкладахОстатки

СГРУППИРОВАТЬ ПО
	ТоварыНаСкладахОстатки.Номенклатура,
	ТоварыНаСкладахОстатки.Серия,
	ТоварыНаСкладахОстатки.Склад

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТоварыКОтгрузкеОстатки.Номенклатура,
	ТоварыКОтгрузкеОстатки.Склад,
	ТоварыКОтгрузкеОстатки.Серия,
	СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток * -1)
ИЗ
	РегистрНакопления.ТоварыКОтгрузке.Остатки(, Склад.смартНазначениеСклада = ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ДемоЗал)) КАК ТоварыКОтгрузкеОстатки

СГРУППИРОВАТЬ ПО
	ТоварыКОтгрузкеОстатки.Номенклатура,
	ТоварыКОтгрузкеОстатки.Склад,
	ТоварыКОтгрузкеОстатки.Серия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиДомозала.Номенклатура КАК Номенклатура,
	ОстаткиДомозала.Склад КАК Склад,
	ОстаткиДомозала.Серия КАК Серия,
	СУММА(ОстаткиДомозала.Количество) КАК Количество
ПОМЕСТИТЬ ОстаткиДомозеловИтог
ИЗ
	ОстаткиДомозала КАК ОстаткиДомозала

СГРУППИРОВАТЬ ПО
	ОстаткиДомозала.Номенклатура,
	ОстаткиДомозала.Склад,
	ОстаткиДомозала.Серия
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	демоОборудованиеДляДемонстрации.ДемоЗал КАК ДемоЗал,
	ВЫБОР
		КОГДА демоОборудованиеДляДемонстрации.Ссылка В (&amp;ВыбранноеОборудование)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВДокументе,
	демоОборудованиеДляДемонстрации.Номенклатура.Родитель КАК Родитель,
	демоОборудованиеДляДемонстрации.Ссылка КАК ОборудованиеДемозала,
	демоОборудованиеДляДемонстрации.Номенклатура КАК Номенклатура,
	демоОборудованиеДляДемонстрации.СерийныйНомер КАК Серия,
	демоОборудованиеДляДемонстрации.ДатаЗапуска КАК ДатаЗапуска,
	демоОборудованиеДляДемонстрации.КонфигурацияЧернил КАК КонфигурацияЧернил,
	РАЗНОСТЬДАТ(демоОборудованиеДляДемонстрации.ДатаЗапуска, &amp;ТекДата, МЕСЯЦ) КАК Месяцев,
	демоОборудованиеДляДемонстрации.СНПЧ КАК СНПЧ,
	демоОборудованиеДляДемонстрации.ТипЧернил КАК ТипЧернил,
	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК РозничнаяЦена,
	демоОборудованиеДляДемонстрации.Номенклатура.Марка КАК Бренд,
	демоОборудованиеДляДемонстрации.Ссылка КАК Ссылка,
	демоОборудованиеДляДемонстрации.ГотовностьКДемонстрации КАК Готовность,
	ЦеныНоменклатурыСрезПоследних.ВидЦены.ВалютаЦены КАК Валюта,
	ЕСТЬNULL(ОстаткиДомозеловИтог.Количество, 0) КАК Количество
ИЗ
	Справочник.демоОборудованиеДляДемонстрации КАК демоОборудованиеДляДемонстрации
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, ВидЦены = &amp;ВидЦены) КАК ЦеныНоменклатурыСрезПоследних
		ПО демоОборудованиеДляДемонстрации.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
			И (ЦеныНоменклатурыСрезПоследних.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиДомозеловИтог КАК ОстаткиДомозеловИтог
		ПО демоОборудованиеДляДемонстрации.Номенклатура = ОстаткиДомозеловИтог.Номенклатура
			И (демоОборудованиеДляДемонстрации.Серия = ОстаткиДомозеловИтог.Серия
				ИЛИ демоОборудованиеДляДемонстрации.СерийныйНомер = ОстаткиДомозеловИтог.Серия.Номер)
			И демоОборудованиеДляДемонстрации.ДемоЗал = ОстаткиДомозеловИтог.Склад
ГДЕ
	(демоОборудованиеДляДемонстрации.ГотовностьКДемонстрации = &amp;Готовность
			ИЛИ &amp;Готовность = ЗНАЧЕНИЕ(Перечисление.демоСтатусГотовностиОборудования.ПустаяСсылка))</queryText>
      <mainTable>Catalog.демоОборудованиеДляДемонстрации</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
