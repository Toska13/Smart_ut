#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Готовность = Перечисления.демоСтатусГотовностиОборудования.Готов;
	
	Параметры.Свойство("ВидЦены", ВидЦены);
	
	Если Параметры.Свойство("ОборудованиеВДокументе") Тогда
		ОборудованиеВДокументе.ЗагрузитьЗначения(Параметры.ОборудованиеВДокументе);
	КонецЕсли;
	
	УстановитьПараметрыОтборов();
	
	//++ #Б-7542 смарт: Фролов 23.07.2026 //Управление акциями. Ошибка отображения акции Распродажа демозала
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Элементы.Список.Имя);
	
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Количество");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементУсловия.ПравоеЗначение = 0;
	ЭлементУсловия.Использование = Истина;
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(250, 128, 114));
	//-- #Б-7542 смарт: Фролов 23.07.2026
	
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДобавитьОборудованиеДляПереносаВДокумент(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	Закрыть(ПоместитьДанныеДляПереносаВоВременноеХранилище());
	
КонецПроцедуры

&НаКлиенте
Процедура ГотовностьПриИзменении(Элемент)
	
	УстановитьПараметрыОтборов();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокиДляПереноса(Команда)
	
	Для каждого ВыбраннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл
		ДобавитьОборудованиеДляПереносаВДокумент(ВыбраннаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроки(Команда)
	
	МассивСтрок = Новый Массив;
	
	Для каждого ВыбраннаяСтрока Из Элементы.Корзина.ВыделенныеСтроки Цикл
		МассивСтрок.Добавить(Корзина.НайтиПоИдентификатору(ВыбраннаяСтрока));
	КонецЦикла;
	
	Для каждого стр Из МассивСтрок Цикл
		Корзина.Удалить(стр);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура КорзинаПриИзменении(Элемент)
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция ПоместитьДанныеДляПереносаВоВременноеХранилище()
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номенклатура");
	ТЗ.Колонки.Добавить("Серия");
	ТЗ.Колонки.Добавить("Склад");
	ТЗ.Колонки.Добавить("ОборудованиеДемозала");
	
	Для каждого стрКорзина Из Корзина Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		НоваяСтрока.Номенклатура = стрКорзина.Оборудование.Номенклатура;
		НоваяСтрока.Серия = стрКорзина.Оборудование.Серия;
		НоваяСтрока.Склад = стрКорзина.Оборудование.ДемоЗал;
		НоваяСтрока.ОборудованиеДемозала = стрКорзина.Оборудование;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТЗ);
	
КонецФункции

&НаСервере
Процедура УстановитьПараметрыОтборов()
	
	Параметр = Список.Параметры.Элементы.Найти("ТекДата");
	Параметр.Значение = ТекущаяДата();
	Параметр.Использование = Истина;
	
	Параметр = Список.Параметры.Элементы.Найти("Готовность");
	Параметр.Использование = Истина;
	Параметр.Значение = Готовность;
	
	Параметр = Список.Параметры.Элементы.Найти("ВыбранноеОборудование");
	Параметр.Использование = Истина;
	Параметр.Значение = ОборудованиеВДокументе.ВыгрузитьЗначения();
	
	Параметр = Список.Параметры.Элементы.Найти("ВидЦены");
	Параметр.Использование = Истина;
	Параметр.Значение = ВидЦены;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОборудованиеДляПереносаВДокумент(Оборудование)
	
	Если НЕ ЗначениеЗаполнено(Оборудование) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Оборудование) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Оборудование) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Возврат;
	КонецЕсли;
	
	Если Корзина.НайтиСтроки(Новый Структура("Оборудование", Оборудование)).Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОборудованиеВДокументе.НайтиПоЗначению(Оборудование) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Корзина.Добавить();
	НоваяСтрока.Оборудование = Оборудование;
	
КонецПроцедуры

#КонецОбласти