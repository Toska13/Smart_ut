&НаСервере
Процедура ВыполнитьДействияДляТоваровСервер()
	
	Для каждого стрТовары Из Элементы.Товары.ВыделенныеСтроки Цикл
		
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(стрТовары);
		
		Если УстановитьПроцентДляВыделенныхСтрок <> 0 Тогда
			
			ЦенаРозница = РаботаСКурсамиВалют.ПересчитатьВВалюту(ТекущаяСтрока.ЦенаРозница, ТекущаяСтрока.ВалютаРозница, ТекущаяСтрока.ВалютаАкция, Объект.Дата);
			ТекущаяСтрока.ЦенаАкция = ЦенаРозница * (1 - УстановитьПроцентДляВыделенныхСтрок / 100);
			
		КонецЕсли;
		
		Если РежимОкругления > 2 Тогда
			
			ТекЦена = ТекущаяСтрока.ЦенаАкция / pow(10, РежимОкругления - 2);
			ТекЦена = Окр(ТекЦена);
			ТекущаяСтрока.ЦенаАкция = ТекЦена * pow(10, РежимОкругления - 2);
			
		Иначе
			ТекущаяСтрока.ЦенаАкция = Окр(ТекущаяСтрока.ЦенаАкция, РежимОкругления);
		КонецЕсли;
		
		РассчитатьДанныеПоСтроке(ТекущаяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьЦеныВВыделенныхСтрокахНаСервере()
	
	МассивСтрок = Новый Массив;
	
	Для каждого стрИД Из Элементы.Товары.ВыделенныеСтроки Цикл
		МассивСтрок.Добавить(Объект.Товары.НайтиПоИдентификатору(стрИД));
	КонецЦикла;
	
	Если МассивСтрок.Количество() > 0 Тогда
		ЗаполнитьДанныеПоСтрокам(МассивСтрок);
	КонецЕсли;
	
КонецПроцедуры

