&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	//

	НоменклатураСервер.УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтаФорма);

	//

	НоменклатураСервер.УстановитьУсловноеОформлениеСерийНоменклатуры(ЭтаФорма, "СерииПриПланированииОтгрузкиУказываютсяВТЧТовары");

	//

	НоменклатураСервер.УстановитьУсловноеОформлениеСтатусовУказанияСерий(ЭтаФорма, Ложь);

	// Создаем элемент условного оформления

	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();

	// Настраиваем отбор
	Отбор = ЭлементУсловногоОформления.Отбор;

	НовыйЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.Серия");
	НовыйЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	НовыйЭлементОтбора.Использование = Истина;

	// Настраиваем оформление
	Оформление = ЭлементУсловногоОформления.Оформление;
	Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Оформление.УстановитьЗначениеПараметра("Текст", "1");

	// Устанавливаем применяемые поля (к каким полям таблицы применить оформление)
	ПолеОформления = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ТоварыКоличествоТоваров");
	ПолеОформления.Использование = Истина;
	
КонецПроцедуры

