&НаСервере
Процедура РассчитатьДанныеПоДокументу()

	Для каждого стрТовары Из Объект.Товары Цикл
		РассчитатьДанныеПоСтроке(стрТовары);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьДанныеПоСтроке(стрТовары)
	
	ЦенаРозница = РаботаСКурсамиВалют.ПересчитатьВВалюту(стрТовары.ЦенаРозница, стрТовары.ВалютаРозница, стрТовары.ВалютаАкция, Объект.Дата);
	стрТовары.ПроцентСкидки = ?(ЦенаРозница = 0, 0, (ЦенаРозница - стрТовары.ЦенаАкция) * 100 / ЦенаРозница);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПоСтрокам(ЗНАЧ МассивСтрок = Неопределено)
	
	ЗаполнитьВспомогательныеДанныеПоСтрокам(МассивСтрок);
	
	Если НЕ МассивСтрок = Неопределено Тогда
		
		МассивНоменклатуры = Новый Массив;
		МассивХарактеристик = Новый Массив;
		МассивХарактеристик.Добавить(Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
		
		Для каждого стрТовары Из МассивСтрок Цикл
			
			МассивНоменклатуры.Добавить(стрТовары.Номенклатура);
			
			Если ЗначениеЗаполнено(стрТовары.Характеристика) Тогда
				МассивХарактеристик.Добавить(стрТовары.Характеристика);
			КонецЕсли;
			
		КонецЦикла;
		
		Цены = ПолучитьЦеныНоменклатуры(МассивНоменклатуры, МассивХарактеристик);
		
	Иначе
		
		Цены = ПолучитьЦеныНоменклатуры();
		МассивСтрок = Объект.Товары;
		
	КонецЕсли;
	
	ВалютаРозница = Объект.ВидЦеныРозница.ВалютаЦены;
	ВалютаАкция = Объект.ВидЦеныРозница.ВалютаЦены;
	
	Для каждого стрТовары Из МассивСтрок Цикл
		
		стрТовары.ВалютаРозница = ВалютаРозница;
		стрТовары.ВалютаАкция = ВалютаАкция;
		
		строкиЦен = Цены.НайтиСтроки(Новый Структура("Номенклатура,Характеристика", стрТовары.Номенклатура, стрТовары.Характеристика));
		Если строкиЦен.Количество() > 0 Тогда
			стрТовары.ЦенаРозница = строкиЦен[0].Цена;
		Иначе
			стрТовары.ЦенаРозница = 0;
		КонецЕсли;
		
		РассчитатьДанныеПоСтроке(стрТовары);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВспомогательныеДанныеПоСтрокам(ЗНАЧ МассивСтрок = Неопределено)
	
	Если НЕ МассивСтрок = Неопределено Тогда
		
		МассивНоменклатуры = Новый Массив;
		МассивСкладов = Новый Массив;
		МассивСерий = Новый Массив;
		МассивСерий.Добавить(Справочники.СерииНоменклатуры.ПустаяСсылка());
		
		Для каждого стрТовары Из МассивСтрок Цикл
			
			МассивНоменклатуры.Добавить(стрТовары.Номенклатура);
			
			Если ЗначениеЗаполнено(стрТовары.Серия) Тогда
				МассивСерий.Добавить(стрТовары.Серия);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(стрТовары.Склад) Тогда
				МассивСкладов.Добавить(стрТовары.Склад);
			КонецЕсли;
			
		КонецЦикла;
		
		ДИЦ = ПолучитьДанныеДИЦ(МассивНоменклатуры, МассивСерий, МассивСкладов);
		
	Иначе
		
		ДИЦ = ПолучитьДанныеДИЦ();
		МассивСтрок = Объект.Товары;
		
	КонецЕсли;
	
	Для каждого стрТовары Из МассивСтрок Цикл
		
		Если ЗначениеЗаполнено(стрТовары.ОборудованиеДемозала) Тогда
			стрТовары.ЗапускВДИЦ = стрТовары.ОборудованиеДемозала.ДатаЗапуска;
			стрТовары.Пробег = стрТовары.ОборудованиеДемозала.ПробегОборудования;
			стрТовары.Заметки = стрТовары.ОборудованиеДемозала.ПромывкаИОстатки;
			стрТовары.ГодВыпуска = Формат(стрТовары.ОборудованиеДемозала.ГодВыпуска, "ДФ=гггг");
		Иначе
		
			строкиДИЦ = ДИЦ.НайтиСтроки(Новый Структура("Номенклатура,Серия,Склад", стрТовары.Номенклатура, стрТовары.Серия, стрТовары.Склад));
			Если строкиДИЦ.Количество() > 0 Тогда
				стрТовары.ЗапускВДИЦ = строкиДИЦ[0].ДатаЗапуска;
			Иначе
				стрТовары.ЗапускВДИЦ = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦеныНоменклатуры(ЗНАЧ МассивНоменклатуры = Неопределено, ЗНАЧ МассивХарактеристик = Неопределено)
	
	Если МассивНоменклатуры = Неопределено Тогда
		МассивНоменклатуры = Объект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	
	Если МассивХарактеристик = Неопределено Тогда
		МассивХарактеристик = Объект.Товары.Выгрузить(, "Характеристика").ВыгрузитьКолонку("Характеристика");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дата,
	|			Номенклатура В (&МассивНоменклатуры)
	|				И ВидЦены = &ВидЦены
	|				И Характеристика В (&МассивХарактеристик)) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.ДатаНачалаАкции);
	Запрос.УстановитьПараметр("ВидЦены", Объект.ВидЦеныРозница);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивХарактеристик", МассивХарактеристик);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДИЦ(ЗНАЧ МассивНоменклатуры = Неопределено, ЗНАЧ МассивСерий = Неопределено, ЗНАЧ МассивСкладов = Неопределено)
	
	Если МассивНоменклатуры = Неопределено Тогда
		МассивНоменклатуры = Объект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;
	
	Если МассивСерий = Неопределено Тогда
		МассивСерий = Объект.Товары.Выгрузить(, "Серия").ВыгрузитьКолонку("Серия");
	КонецЕсли;
	
	Если МассивСкладов = Неопределено Тогда
		МассивСкладов = Объект.Товары.Выгрузить(, "Склад").ВыгрузитьКолонку("Склад");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	демоОборудованиеДляДемонстрации.ДатаЗапуска КАК ДатаЗапуска,
	|	демоОборудованиеДляДемонстрации.Ссылка КАК Ссылка,
	|	демоОборудованиеДляДемонстрации.Номенклатура КАК Номенклатура,
	|	демоОборудованиеДляДемонстрации.Серия КАК Серия,
	|	демоОборудованиеДляДемонстрации.ДемоЗал КАК Склад
	|ИЗ
	|	Справочник.демоОборудованиеДляДемонстрации КАК демоОборудованиеДляДемонстрации
	|ГДЕ
	|	демоОборудованиеДляДемонстрации.Номенклатура В(&МассивНоменклатуры)
	|	И демоОборудованиеДляДемонстрации.Серия В(&МассивСерий)
	|	И демоОборудованиеДляДемонстрации.ДемоЗал В(&МассивСкладов)
	|	И демоОборудованиеДляДемонстрации.ГотовностьКДемонстрации = ЗНАЧЕНИЕ(Перечисление.демоСтатусГотовностиОборудования.Готов)";
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивСерий", МассивСерий);
	Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ПолучитьМассивОборудованияВДокументе()
	
	Возврат Объект.Товары.Выгрузить(, "ОборудованиеДемозала").ВыгрузитьКолонку("ОборудованиеДемозала");
	
КонецФункции

