#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.смартОстаткиАкционныхТоваров.Записывать = Истина;
	
	Если Статус = Перечисления.смартСтатусыАкций.Действует Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	смартУправлениеАкциямиТовары.Номенклатура КАК Номенклатура,
		|	смартУправлениеАкциямиТовары.Серия КАК Серия,
		|	ВЫБОР
		|		КОГДА НЕ смартУправлениеАкциямиТовары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|			ТОГДА 1
		|		ИНАЧЕ смартУправлениеАкциямиТовары.КоличествоТоваров
		|	КОНЕЦ КАК Количество,
		|	смартУправлениеАкциямиТовары.Ссылка КАК ДокументАкции,
		|	смартУправлениеАкциямиТовары.Ссылка.Дата КАК Период
		|ИЗ
		|	Документ.смартУправлениеАкциями.Товары КАК смартУправлениеАкциямиТовары
		|ГДЕ
		|	смартУправлениеАкциямиТовары.Ссылка = &Ссылка";
		
		Если НЕ ВидАкции = Перечисления.смартВидыАкций.Распродажа Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И НЕ смартУправлениеАкциямиТовары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)";
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Движения.смартОстаткиАкционныхТоваров.Загрузить(Запрос.Выполнить().Выгрузить());
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидАкции = Перечисления.смартВидыАкций.ДемоЗал Тогда
		ПроверяемыеРеквизиты.Добавить("Товары.ОборудованиеДемозала");
	КонецЕсли;
	
КонецПроцедуры

