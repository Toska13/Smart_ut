&НаСервере
Процедура ПриЧтенииСозданииНаСервере()
	
	Реквизиты 					= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПрограммаОбучения, "ПродолжительностьОбучения, ОценкаОбучения");
	ПродолжительностьОбучения 	= Реквизиты.ПродолжительностьОбучения;	
	ОценкаОбучения 				= Реквизиты.ОценкаОбучения;

	УстановитьДоступностьЭлементов();
	РезультатыОбученияВТаблицуПоказателей();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	Элементы.Состояние.СписокВыбора.ЗагрузитьЗначения(ПолучитьСписокСостоянийПоВиду(Объект.ВидОтражения, Объект.МестоПроведения)); 
	
	ЭтоЧерновик 					= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.Черновик;
	ЭтоПланирование 				= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.Планирование;
	ЭтоОборудованиеЗарезервировано 	= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ОборудованиеЗарезервировано;
	ЭтоПроходящиеОбучениеУказаны 	= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ПроходящиеОбучениеУказаны;
	ЭтоОтражениеРезультатов 		= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ОтражениеРезультатов;
	ЭтоРезультатыОтражены 			= Объект.Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.РезультатыОтражены;
		
	ДоступностьРеквизитовПрограммы = ЭтоЧерновик
								 ИЛИ ЭтоПланирование
								 ИЛИ ЭтоОборудованиеЗарезервировано
								 ИЛИ ЭтоПроходящиеОбучениеУказаны;
	
	Элементы.ГруппаПрограмма.ТолькоПросмотр = НЕ ДоступностьРеквизитовПрограммы;
	Элементы.ГруппаПрограмма.Видимость      = Объект.ВидОтражения = 0;   
	
	Если Объект.ВидОтражения = 1 Тогда
		
		Элементы.ГруппаБронируемоеОборудование.Видимость = Ложь;
		Элементы.ГруппаПрисваемыеКвалификации.Видимость = Истина;
		Элементы.ГруппаПреподаватели.Видимость = Ложь;
		Элементы.ГруппаСотрудники.Видимость = Истина;
				
	Иначе
		
		//Элементы.ГруппаБронируемоеОборудование.Видимость = Истина;
		//Элементы.ГруппаПрисваемыеКвалификации.Видимость = Истина;
		//Элементы.ГруппаПреподаватели.Видимость = Истина;
		//Элементы.ГруппаСотрудники.Видимость = Истина;
		
		Если ЗначениеЗаполнено(ДокументБронирования) Тогда 		
			ЧастиСтроки = Новый Массив;
			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Документ бронирования:'"), Новый Шрифт(,,,,Ложь)));
			ЧастиСтроки.Добавить(" ");
			ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(Строка(ДокументБронирования), Новый Шрифт(,,,,Истина), ЦветаСтиля.ГиперссылкаЦвет,, ПолучитьНавигационнуюСсылку(ДокументБронирования)));
			
			Если ЭтоЧерновик ИЛИ ЭтоПланирование Тогда
				ЧастиСтроки.Добавить(" ");
				ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока("X", Новый Шрифт(,,Истина,,Ложь), WEBЦвета.Красный,, "УдалитьДокументБронирования"));
			КонецЕсли;
			ФорматированнаяСтрокаДокументБронирования = Новый ФорматированнаяСтрока(ЧастиСтроки);			
		Иначе 	
		    ФорматированнаяСтрокаДокументБронирования = Новый ФорматированнаяСтрока(НСтр("ru = '<Создать документ бронирования>'"), Новый Шрифт(,,,,Истина), ЦветаСтиля.ГиперссылкаЦвет,, "СоздатьДокументБронирования");
		КонецЕсли; 
		
		Элементы.ФорматированнаяСтрокаДокументБронирования.Доступность = НЕ ЭтоЧерновик;
		
		Элементы.ГруппаБронируемоеОборудование.Видимость 	= (ЭтоЧерновик ИЛИ ЭтоПланирование ИЛИ ЭтоОборудованиеЗарезервировано ИЛИ ЭтоПроходящиеОбучениеУказаны ИЛИ ЭтоОтражениеРезультатов)
															  И НЕ (ТипЗнч(Объект.МестоПроведения) = Тип("СправочникСсылка.CRM_Помещения"));
		Элементы.ГруппаПрисваемыеКвалификации.Видимость 	= ЭтоЧерновик ИЛИ ЭтоПланирование ИЛИ ЭтоОборудованиеЗарезервировано ИЛИ ЭтоПроходящиеОбучениеУказаны ИЛИ ЭтоОтражениеРезультатов;
			
		//Элементы.ГруппаПреподаватели.Видимость 	= ЭтоЧерновик ИЛИ ЭтоОборудованиеЗарезервировано ИЛИ ЭтоПроходящиеОбучениеУказаны ИЛИ ЭтоОтражениеРезультатов ИЛИ ЭтоРезультатыОтражены;
		//Элементы.ГруппаСотрудники.Видимость	 	= ЭтоЧерновик ИЛИ ЭтоОборудованиеЗарезервировано ИЛИ ЭтоПроходящиеОбучениеУказаны ИЛИ ЭтоОтражениеРезультатов ИЛИ ЭтоРезультатыОтражены;
		
		Элементы.ГруппаПреподаватели.Видимость 	= Истина;
		Элементы.ГруппаСотрудники.Видимость	 	= Истина; 
	КонецЕсли; 
	
	Элементы.ГруппаТаблицаПоказателей.Доступность = ЭтоОтражениеРезультатов ИЛИ ЭтоРезультатыОтражены;
	
	Если НЕ Пользователи.РолиДоступны("смартАдминистрированиеУчебногоЦентра") Тогда
		
		ТекущийПользователь = Пользователи.ТекущийПользователь();
		ЭтоПреподаватель 	= Объект.Преподаватели.НайтиСтроки(Новый Структура("Преподаватель", ТекущийПользователь)).Количество() > 0; 
		
		Элементы.ГруппаШапка.ТолькоПросмотр = Истина;
		Элементы.ГруппаПрограмма.ТолькоПросмотр = Истина;
			
		Элементы.ГруппаБронируемоеОборудование.ТолькоПросмотр = Истина;
		Элементы.ГруппаПрисваемыеКвалификации.ТолькоПросмотр = Истина;
		Элементы.ГруппаПреподаватели.ТолькоПросмотр = Истина;
		Элементы.ГруппаСотрудники.ТолькоПросмотр = Истина;
		
		Элементы.ГруппаТаблицаПоказателей.ТолькоПросмотр 	= НЕ ЭтоПреподаватель;

	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Состояние = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Состояние");
		Если Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.РезультатыОтражены Тогда
			ЭтаФорма.ТолькоПросмотр 							= Истина;
			Элементы.ГруппаТаблицаПоказателей.ТолькоПросмотр 	= Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокСостоянийПоВиду(ВидОтражения, МестоПроведения)
	Результат = Новый Массив;
	Если ВидОтражения = 0 Тогда
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.Черновик);
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.Планирование);
		Если НЕ ТипЗнч(МестоПроведения) = Тип("СправочникСсылка.CRM_Помещения") Тогда
			Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.ОборудованиеЗарезервировано); 
		КонецЕсли;
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.ПроходящиеОбучениеУказаны);
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.ОтражениеРезультатов);
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.РезультатыОтражены);
	Иначе
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.Черновик);
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.ОтражениеРезультатов);
		Результат.Добавить(Перечисления.смартСостоянияДокументовОбученияСотрудников.РезультатыОтражены);
	КонецЕсли;	
	Возврат Результат;
КонецФункции

#Область ТаблицаРезультатов

&НаСервере
Процедура КвалификацииСотрудникиПриИзменении()
	ТаблицаПоказателейВРезультатыОбучения(Объект);
    РезультатыОбученияВТаблицуПоказателей();
КонецПроцедуры

&НаСервере
Процедура РезультатыОбученияВТаблицуПоказателей() 
	ТаблицаКолонок = ПолучитьТаблицуКолонок(); 
	
	ТаблицаПоказателей.Очистить();
	УдалитьРеквизитыИЭлементыФормы("ТаблицаПоказателей");	
	СоздатьРеквизитыИЭлементыФормы("ТаблицаПоказателей", ТаблицаКолонок);
	
	Для Каждого СтрокаРезультата Из Объект.Квалификации Цикл		
		НоваяСтрока = ТаблицаПоказателей.Добавить();
		НоваяСтрока.Квалификация 			= СтрокаРезультата.Квалификация;
		НоваяСтрока.ЭтоОборудованиеКлиента 	= ТипЗнч(СтрокаРезультата.Квалификация) = Тип("СправочникСсылка.смартОборудованиеКлиентов");
		НоваяСтрока.ВариантОценки           = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРезультата.Квалификация, "ВариантОценки");
		Если Не ЗначениеЗаполнено(НоваяСтрока.ВариантОценки) И ЗначениеЗаполнено(ОценкаОбучения) Тогда 
			НоваяСтрока.ВариантОценки = ОценкаОбучения;
		ИначеЕсли Не ЗначениеЗаполнено(НоваяСтрока.ВариантОценки) Тогда
			НоваяСтрока.ВариантОценки = Перечисления.смартВариантыОценкиОбучения.ДесятибалльнаяШкала;   
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаРезультата Из Объект.РезультатыОбучения Цикл		
		УИНСотрудника = СтрЗаменить(Строка(СтрокаРезультата.Сотрудник.УникальныйИдентификатор()),"-","_");
		НайденныеСтроки = ТаблицаПоказателей.НайтиСтроки(Новый Структура("Квалификация", СтрокаРезультата.Квалификация));
		Если НайденныеСтроки.Количество() > 0 Тогда 
			СтрокаРезультатаПоКвалификации = НайденныеСтроки[0];
			СтрокаРезультатаПоКвалификации["Оцн_" + УИНСотрудника] = СтрокаРезультата.Оценка;
			СтрокаРезультатаПоКвалификации["Зач_" + УИНСотрудника] = СтрокаРезультата.Зачет;
			СтрокаРезультатаПоКвалификации["ЗРР_" + УИНСотрудника] = СтрокаРезультата.ЗРР;
			СтрокаРезультатаПоКвалификации["ПНР_" + УИНСотрудника] = СтрокаРезультата.ПНР;
		КонецЕсли; 	
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ТаблицаПоказателейВРезультатыОбучения(ТекущийОбъект)
	ТекущийОбъект.РезультатыОбучения.Очистить();
	ТаблицаЗначенийПоказателей = РеквизитФормыВЗначение("ТаблицаПоказателей", Тип("ТаблицаЗначений"));
	Для Каждого СтрокаТаблицыПоказателей Из ТаблицаЗначенийПоказателей Цикл		
		Квалификация = СтрокаТаблицыПоказателей.Квалификация;
		Для Каждого Колонка Из ТаблицаЗначенийПоказателей.Колонки Цикл		
			Если Колонка.Имя = "Квалификация" ИЛИ Колонка.Имя = "ЭтоОборудованиеКлиента" ИЛИ Колонка.Имя = "ВариантОценки" ИЛИ Колонка.Имя = "ПравыйОтступ" Тогда
				Продолжить;
			КонецЕсли;			
			УИНСотрудника = Новый УникальныйИдентификатор(СтрЗаменить(Сред(Колонка.Имя, 5),"_","-"));			
			Если НЕ ТипЗнч(УИНСотрудника) = Тип("УникальныйИдентификатор") Тогда
				Продолжить;
			КонецЕсли;
			Сотрудник = Справочники.Пользователи.ПолучитьСсылку(УИНСотрудника);			
			НайденныеСтроки = ТекущийОбъект.РезультатыОбучения.НайтиСтроки(Новый Структура("Квалификация, Сотрудник", Квалификация, Сотрудник));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаРезультат = НайденныеСтроки[0];
			Иначе
				СтрокаРезультат = ТекущийОбъект.РезультатыОбучения.Добавить();
				СтрокаРезультат.Квалификация  = Квалификация;
				СтрокаРезультат.Сотрудник = Сотрудник;
			КонецЕсли;
			Если Лев(Колонка.Имя, 4) = "Оцн_" Тогда
				СтрокаРезультат.Оценка = СтрокаТаблицыПоказателей[Колонка.Имя];
			ИначеЕсли Лев(Колонка.Имя, 4) = "Зач_" Тогда
				СтрокаРезультат.Зачет = СтрокаТаблицыПоказателей[Колонка.Имя];
			ИначеЕсли Лев(Колонка.Имя, 4) = "ЗРР_" Тогда
				СтрокаРезультат.ЗРР = СтрокаТаблицыПоказателей[Колонка.Имя];
			ИначеЕсли Лев(Колонка.Имя, 4) = "ПНР_" Тогда
				СтрокаРезультат.ПНР = СтрокаТаблицыПоказателей[Колонка.Имя];
			КонецЕсли;   		
		КонецЦикла;		
	КонецЦикла;
КонецПроцедуры   

&НаСервере
Функция ПолучитьТаблицуКолонок()
	ТаблицаКолонок = Новый ТаблицаЗначений;
	ТаблицаКолонок.Колонки.Добавить("Позиция");
	ТаблицаКолонок.Колонки.Добавить("ИмяКолонки");
	ТаблицаКолонок.Колонки.Добавить("ПредставлениеКолонки");
	ТаблицаКолонок.Колонки.Добавить("ТипКолонки"); 
	ТаблицаКолонок.Колонки.Добавить("ЦветФона");
	ТаблицаКолонок.Колонки.Добавить("Ширина");
	ТаблицаКолонок.Колонки.Добавить("Группировка");
	ТаблицаКолонок.Колонки.Добавить("Видимость", Новый ОписаниеТипов("Булево"));
	ТаблицаКолонок.Колонки.Добавить("ОтображатьВШапке", Новый ОписаниеТипов("Булево"));
	ТаблицаКолонок.Колонки.Добавить("ТолькоПросмотр", Новый ОписаниеТипов("Булево"));
	ТаблицаКолонок.Колонки.Добавить("ПредставлениеГруппировки");
	
	ЕстьКвалификацииПоОборудованию = Ложь;
	Для Каждого СтрокаКвалификации Из Объект.Квалификации Цикл		
		Если ТипЗнч(СтрокаКвалификации.Квалификация) = Тип("СправочникСсылка.смартОборудованиеКлиентов") Тогда	
			ЕстьКвалификацииПоОборудованию = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
    
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник) Тогда
			Продолжить;		
		КонецЕсли;

		Если НЕ ТаблицаКолонок.Найти(Строка(СтрокаСотрудник.Сотрудник), "ПредставлениеГруппировки") = Неопределено Тогда
			Продолжить;		
		КонецЕсли;
				
		УИНСотрудника 			= СтрЗаменить(Строка(СтрокаСотрудник.Сотрудник.УникальныйИдентификатор()),"-","_");
		ГруппировкаНовойСтроки 	= "Группировка_" + УИНСотрудника;
		
			
		НоваяСтрока = ТаблицаКолонок.Добавить();
		НоваяСтрока.Позиция 					= 0;
		НоваяСтрока.ИмяКолонки 					= "Оцн_" + УИНСотрудника;
		НоваяСтрока.ПредставлениеКолонки 		= "Оценка";
		НоваяСтрока.ТипКолонки 					= Новый ОписаниеТипов("Число");
		НоваяСтрока.Группировка             	= ГруппировкаНовойСтроки;
		НоваяСтрока.ПредставлениеГруппировки	= Строка(СтрокаСотрудник.Сотрудник);
		НоваяСтрока.ЦветФона                    = WebЦвета.Роса;
		НоваяСтрока.Ширина                      = 3;
		НоваяСтрока.Видимость                   = Истина;
		НоваяСтрока.ОтображатьВШапке            = Истина;
		
		НоваяСтрока = ТаблицаКолонок.Добавить();
		НоваяСтрока.Позиция 					= 0;
		НоваяСтрока.ИмяКолонки 					= "Зач_" + УИНСотрудника;
		НоваяСтрока.ПредставлениеКолонки 		= "Зачет";
		НоваяСтрока.ТипКолонки 					= Новый ОписаниеТипов("Булево");
		НоваяСтрока.Группировка             	= ГруппировкаНовойСтроки;
		НоваяСтрока.ПредставлениеГруппировки	= Строка(СтрокаСотрудник.Сотрудник);
		НоваяСтрока.ЦветФона                    = WebЦвета.Роса;
		НоваяСтрока.Ширина                      = 10;
		НоваяСтрока.Видимость                   = Истина;
		НоваяСтрока.ОтображатьВШапке            = Истина;
		
		НоваяСтрока = ТаблицаКолонок.Добавить();
		НоваяСтрока.Позиция 					= 1;
		НоваяСтрока.ИмяКолонки 					= "ЗРР_" + УИНСотрудника;
		НоваяСтрока.ПредставлениеКолонки 		= "ЗРР";
		НоваяСтрока.ТипКолонки 					= Новый ОписаниеТипов("Булево");
		НоваяСтрока.Группировка             	= ГруппировкаНовойСтроки;
		НоваяСтрока.ПредставлениеГруппировки	= Строка(СтрокаСотрудник.Сотрудник);
		НоваяСтрока.ЦветФона                    = Новый Цвет;
		НоваяСтрока.Ширина                      = 10;
		НоваяСтрока.Видимость                   = ЕстьКвалификацииПоОборудованию;
		НоваяСтрока.ОтображатьВШапке            = Истина;
		
		НоваяСтрока = ТаблицаКолонок.Добавить();
		НоваяСтрока.Позиция 					= 2;
		НоваяСтрока.ИмяКолонки 					= "ПНР_" + УИНСотрудника;
		НоваяСтрока.ПредставлениеКолонки 		= "ПНР";
		НоваяСтрока.ТипКолонки 					= Новый ОписаниеТипов("Булево");
		НоваяСтрока.Группировка             	= ГруппировкаНовойСтроки;
		НоваяСтрока.ПредставлениеГруппировки	= Строка(СтрокаСотрудник.Сотрудник);
		НоваяСтрока.ЦветФона                    = Новый Цвет;
		НоваяСтрока.Ширина                      = 10;
		НоваяСтрока.Видимость                   = ЕстьКвалификацииПоОборудованию;
		НоваяСтрока.ОтображатьВШапке            = Истина;
		
   	КонецЦикла;
	
	НоваяСтрока = ТаблицаКолонок.Добавить();
	НоваяСтрока.Позиция 					= 3;
	НоваяСтрока.ИмяКолонки 					= "ПравыйОтступ";
	НоваяСтрока.ПредставлениеКолонки 		= "Отступ";
	НоваяСтрока.ТипКолонки 					= Новый ОписаниеТипов("Строка");
	НоваяСтрока.Группировка             	= "";
	НоваяСтрока.ПредставлениеГруппировки	= "";
	НоваяСтрока.ЦветФона                    = Новый Цвет;
	НоваяСтрока.Ширина                      = 10;
	НоваяСтрока.Видимость                   = Истина;
	НоваяСтрока.ОтображатьВШапке            = Ложь;
	НоваяСтрока.ТолькоПросмотр	            = Истина;

	Возврат ТаблицаКолонок;
КонецФункции

#Область Интерфейс

&НаСервере
Процедура УдалитьРеквизитыИЭлементыФормы(ИмяТаблицы)
	МассивУдаляемыхРеквизитов = Новый Массив;
	МассивУдаляемыхЭлементов = Новый Массив;
	
	НайденныйЭлементФормы = Элементы.Найти(ИмяТаблицы);
	Если НЕ НайденныйЭлементФормы = Неопределено Тогда
		Для Каждого УдаляемыйЭлемент Из НайденныйЭлементФормы.ПодчиненныеЭлементы Цикл
			Если УдаляемыйЭлемент.Имя = ИмяТаблицы + "Квалификация" Тогда
				Продолжить;		
			КонецЕсли;
			
			Если ТипЗнч(УдаляемыйЭлемент) = Тип("ГруппаФормы") Тогда
				Для Каждого УдаляемыйЭлементВГруппе Из УдаляемыйЭлемент.ПодчиненныеЭлементы Цикл
					Если ТипЗнч(УдаляемыйЭлементВГруппе) = Тип("ГруппаФормы") Тогда
						Для Каждого УдаляемыйЭлементВГруппе2 Из УдаляемыйЭлементВГруппе.ПодчиненныеЭлементы Цикл
							МассивУдаляемыхРеквизитов.Добавить(УдаляемыйЭлементВГруппе2.ПутьКДанным);
						КонецЦикла;
					Иначе
						МассивУдаляемыхРеквизитов.Добавить(УдаляемыйЭлементВГруппе.ПутьКДанным);
					КонецЕсли;                                                                  				
				КонецЦикла;
			Иначе
				МассивУдаляемыхРеквизитов.Добавить(УдаляемыйЭлемент.ПутьКДанным);
			КонецЕсли;
			
			МассивУдаляемыхЭлементов.Добавить(УдаляемыйЭлемент);
		КонецЦикла;	
	КонецЕсли;
	Для Каждого ЭлементДляУдаления Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(ЭлементДляУдаления);
	КонецЦикла;
	ИзменитьРеквизиты(, МассивУдаляемыхРеквизитов);
КонецПроцедуры 

&НаСервере
Процедура СоздатьРеквизитыИЭлементыФормы(ИмяТаблицы, ТаблицаКолонок)
	СоздатьРеквизитыФормы(ИмяТаблицы, ТаблицаКолонок);
	СоздатьЭлементыФормы(ИмяТаблицы, ТаблицаКолонок);
	УстановитьУсловноеОформлениеТаблицы(ИмяТаблицы);
КонецПроцедуры 

&НаСервере
Процедура СоздатьРеквизитыФормы(ИмяТаблицы, ТаблицаКолонок)  
	МассивДобавляемыхРеквизитов = Новый Массив;
		
	Для Каждого Колонка Из ТаблицаКолонок Цикл
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Колонка.ИмяКолонки, Колонка.ТипКолонки, ИмяТаблицы, Колонка.ПредставлениеКолонки, Ложь));
	КонецЦикла; 

	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
КонецПроцедуры  

&НаСервере
Процедура СоздатьЭлементыФормы(ИмяТаблицы, ТаблицаКолонок)
	ГруппаКолонок = Неопределено;
	Для Каждого Колонка Из ТаблицаКолонок Цикл   
		Если НЕ ГруппаКолонок = Колонка.Группировка И ЗначениеЗаполнено(Колонка.Группировка) Тогда  
			ГруппаКолонок 										= Колонка.Группировка;
			НоваяГруппаКолонок									= Элементы.Добавить(ИмяТаблицы + Колонка.Группировка, Тип("ГруппаФормы"), Элементы[ИмяТаблицы]);
			НоваяГруппаКолонок.Заголовок 						= Колонка.ПредставлениеГруппировки;
			НоваяГруппаКолонок.ОтображатьВШапке 				= Истина;
			НоваяГруппаКолонок.Группировка 						= ГруппировкаКолонок.Горизонтальная; 
			НоваяГруппаКолонок.ГоризонтальноеПоложениеВШапке 	= ГоризонтальноеПоложениеЭлемента.Центр;
			
			//НоваяГруппаКолонок									= Элементы.Добавить(ИмяТаблицы + Колонка.Группировка + "_Оценка", Тип("ГруппаФормы"), Элементы[ИмяТаблицы + Колонка.Группировка]);
			//НоваяГруппаКолонок.Заголовок 						= Колонка.ПредставлениеГруппировки;
			//НоваяГруппаКолонок.ОтображатьВШапке 				= Ложь;
			//НоваяГруппаКолонок.Группировка 						= ГруппировкаКолонок.Горизонтальная; 
			//НоваяГруппаКолонок.ГоризонтальноеПоложениеВШапке 	= ГоризонтальноеПоложениеЭлемента.Центр;
			//НоваяГруппаКолонок.Ширина                           = Колонка.Ширина;
		КонецЕсли;   
		
		//Если Колонка.Позиция = 0 Тогда
		//	НоваяКолонка	= Элементы.Добавить(ИмяТаблицы + Колонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы + Колонка.Группировка + "_Оценка"]);
		//ИначеЕсли Колонка.Позиция = 3 Тогда
		//	НоваяКолонка	= Элементы.Добавить(ИмяТаблицы + Колонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы]);
		//Иначе
		//	НоваяКолонка	= Элементы.Добавить(ИмяТаблицы + Колонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы + Колонка.Группировка]);
		//КонецЕсли;  
		
		Если Колонка.Позиция = 3 Тогда
			НоваяКолонка	= Элементы.Добавить(ИмяТаблицы + Колонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы]);
		Иначе
			НоваяКолонка	= Элементы.Добавить(ИмяТаблицы + Колонка.ИмяКолонки, Тип("ПолеФормы"), Элементы[ИмяТаблицы + Колонка.Группировка]);
		КонецЕсли; 
		
		НоваяКолонка.Ширина 						= Колонка.Ширина;
		НоваяКолонка.Вид 							= ?(Колонка.ТипКолонки = Новый ОписаниеТипов("Булево"), ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
		НоваяКолонка.ПутьКДанным 					= ИмяТаблицы + "." + Колонка.ИмяКолонки;
		НоваяКолонка.Заголовок      				= Колонка.ПредставлениеКолонки;
		НоваяКолонка.ГоризонтальноеПоложениеВШапке 	= ГоризонтальноеПоложениеЭлемента.Лево;
		НоваяКолонка.ГоризонтальноеПоложение 		= ГоризонтальноеПоложениеЭлемента.Лево;
		НоваяКолонка.Видимость				 		= Колонка.Видимость; 
		НоваяКолонка.ЦветФона 						= Колонка.ЦветФона;
		НоваяКолонка.ОтображатьВШапке               = Колонка.ОтображатьВШапке;
		НоваяКолонка.ТолькоПросмотр             	= Колонка.ТолькоПросмотр;
		
		Если Колонка.ТипКолонки = Новый ОписаниеТипов("Число") Тогда 
			НоваяКолонка.ГоризонтальноеПоложениеВШапке 	= ГоризонтальноеПоложениеЭлемента.Центр;
			НоваяКолонка.ГоризонтальноеПоложение 		= ГоризонтальноеПоложениеЭлемента.Центр;
			НоваяКолонка.МинимальноеЗначение        	= 0;
			НоваяКолонка.МаксимальноеЗначение       	= 10;
		КонецЕсли;			
	КонецЦикла;  
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеТаблицы(ИмяТаблицы)

	УсловноеОформление.Элементы.Очистить();
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник) Тогда
			Продолжить;		
		КонецЕсли;

		УИНСотрудника	= СтрЗаменить(Строка(СтрокаСотрудник.Сотрудник.УникальныйИдентификатор()),"-","_");
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы + "ЗРР_" + УИНСотрудника].Имя);
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы + "ПНР_" + УИНСотрудника].Имя);

	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ЭтоОборудованиеКлиента");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина); 
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник) Тогда
			Продолжить;		
		КонецЕсли;

		УИНСотрудника	= СтрЗаменить(Строка(СтрокаСотрудник.Сотрудник.УникальныйИдентификатор()),"-","_");
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы + "Оцн_" + УИНСотрудника].Имя);
		
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ВариантОценки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.смартВариантыОценкиОбучения.ЗачетНезачет;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь); 
	
	//

	Элемент = УсловноеОформление.Элементы.Добавить();
	
	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник) Тогда
			Продолжить;		
		КонецЕсли;

		УИНСотрудника	= СтрЗаменить(Строка(СтрокаСотрудник.Сотрудник.УникальныйИдентификатор()),"-","_");
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы[ИмяТаблицы + "Зач_" + УИНСотрудника].Имя);
		
	КонецЦикла;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ВариантОценки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Перечисления.смартВариантыОценкиОбучения.ЗачетНезачет;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);


КонецПроцедуры

#КонецОбласти   

&НаСервере
Процедура ПрограммаОбученияПриИзмененииНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.ПрограммаОбучения) Тогда
		Возврат;	
	КонецЕсли;
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПрограммаОбучения, "НаименованиеПолное, ВидОбучения, МестоПроведения, ПродолжительностьОбучения, ОценкаОбучения, Преподаватели, ОборудованиеДИЦ, Квалификации");
	
	Если НЕ ЗначениеЗаполнено(Объект.ОписаниеПрограммы) Тогда
		Объект.ОписаниеПрограммы = Реквизиты.НаименованиеПолное;	
	КонецЕсли; 

	Если НЕ ЗначениеЗаполнено(Объект.ВидОбучения) Тогда
		Объект.ВидОбучения = Реквизиты.ВидОбучения;	
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Объект.МестоПроведения) Тогда
		Объект.МестоПроведения = Реквизиты.МестоПроведения;	
	КонецЕсли;  
	
	ПродолжительностьОбучения = Реквизиты.ПродолжительностьОбучения;	
		
	ОценкаОбучения = Реквизиты.ОценкаОбучения;	
	
	Если Объект.Преподаватели.Количество() = 0 Тогда
		Объект.Преподаватели.Загрузить(Реквизиты.Преподаватели.Выгрузить());	
	КонецЕсли; 
	
	Если Объект.БронируемоеОборудование.Количество() = 0 Тогда
		Объект.БронируемоеОборудование.Загрузить(Реквизиты.ОборудованиеДИЦ.Выгрузить());	
	КонецЕсли;

	Если Объект.Квалификации.Количество() = 0 Тогда
		Объект.Квалификации.Загрузить(Реквизиты.Квалификации.Выгрузить());	
	КонецЕсли;
	
	УстановитьДоступностьЭлементов();
КонецПроцедуры 

