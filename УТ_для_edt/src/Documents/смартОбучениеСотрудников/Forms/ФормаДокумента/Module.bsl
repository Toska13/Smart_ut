&НаКлиенте
Процедура ОткрытьМаркетинговыеМероприятияДокумент()
	ОткрытьФорму("Документ.МаркетинговыеМероприятияДокумент.ФормаОбъекта", Новый Структура("Основание", Объект.Ссылка), ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,
							Новый ОписаниеОповещения("ПослеСозданияМаркетинговогоМероприятия", ЭтаФорма));
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗаписиДокумента(Результат, Дополнительныепараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если Записать() Тогда
			ОткрытьФорму("Документ.МаркетинговыеМероприятияДокумент.ФормаОбъекта", Новый Структура("Основание", Объект.Ссылка), ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,
							Новый ОписаниеОповещения("ПослеСозданияМаркетинговогоМероприятия", ЭтаФорма));  
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 

&НаКлиенте
Процедура ПослеВопросаУдаленияДокументаБронирования(Результат, Дополнительныепараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если УдалитьДокументБронированияНаСервере(ДокументБронирования) Тогда
			ДокументБронирования = Неопределено;
			УстановитьДоступностьЭлементов();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция УдалитьДокументБронированияНаСервере(ДокументБронирования)
	Результат = Истина;
	Если НЕ ЗначениеЗаполнено(ДокументБронирования) Тогда
		Возврат Результат;	
	КонецЕсли;
	ДокументБронированияОбъект = ДокументБронирования.ПолучитьОбъект();
	ДокументБронированияОбъект.ПометкаУдаления = Истина;
	Попытка
		ДокументБронированияОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Исключение 
		Результат = Ложь;
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось пометить на удаление документ %1:%2", ДокументБронирования, ОписаниеОшибки()));
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
