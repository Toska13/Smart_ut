#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	Если Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ОборудованиеЗарезервировано
		И НЕ ЗначениеЗаполнено(Документы.смартОбучениеСотрудников.ПолучитьДокументБронирования(Ссылка)) Тогда 
		ОбщегоНазначения.СообщитьПользователю("Переход на этап ""Оборудование зарезервировано"" невозможен. Нет документа бронирования.", , "ФорматированнаяСтрокаДокументБронирования", , Отказ);
	КонецЕсли;
		
КонецПроцедуры 

Процедура ОбработкаУдаленияПроведения(Отказ)
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ИсключаемыеРеквизиты = Новый Массив;
	
	Если Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.Черновик Тогда
		
		ИсключаемыеРеквизиты.Добавить("ДатаНачала");
		ИсключаемыеРеквизиты.Добавить("ДатаОкончания");
		ИсключаемыеРеквизиты.Добавить("ВидОбучения");
		ИсключаемыеРеквизиты.Добавить("МестоПроведения");
		ИсключаемыеРеквизиты.Добавить("Ответственный");
		ИсключаемыеРеквизиты.Добавить("ПрограммаОбучения");
		ИсключаемыеРеквизиты.Добавить("ОписаниеПрограммы");
		ИсключаемыеРеквизиты.Добавить("Партнер");
		
		ИсключаемыеРеквизиты.Добавить("Сотрудники");
		ИсключаемыеРеквизиты.Добавить("Сотрудники.Сотрудник");
		ИсключаемыеРеквизиты.Добавить("Преподаватели");
		ИсключаемыеРеквизиты.Добавить("Преподаватели.Преподаватель");
		ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
		ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");
		ИсключаемыеРеквизиты.Добавить("Квалификации");
		ИсключаемыеРеквизиты.Добавить("Квалификации.Квалификация"); 
		ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента");
		ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента.КонтактноеЛицо");

		
	ИначеЕсли Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.Планирование Тогда
		
		ИсключаемыеРеквизиты.Добавить("Сотрудники");
		ИсключаемыеРеквизиты.Добавить("Сотрудники.Сотрудник");
		ИсключаемыеРеквизиты.Добавить("Преподаватели");
		ИсключаемыеРеквизиты.Добавить("Преподаватели.Преподаватель"); 
		
		Если ТипЗнч(МестоПроведения) = Тип("СправочникСсылка.CRM_Помещения") Тогда 		
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");	
		КонецЕсли;

	ИначеЕсли Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ОборудованиеЗарезервировано Тогда
		
		ИсключаемыеРеквизиты.Добавить("Сотрудники");
		ИсключаемыеРеквизиты.Добавить("Сотрудники.Сотрудник");
		ИсключаемыеРеквизиты.Добавить("Преподаватели");
		ИсключаемыеРеквизиты.Добавить("Преподаватели.Преподаватель");
		
		Если ТипЗнч(МестоПроведения) = Тип("СправочникСсылка.CRM_Помещения") Тогда 		
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");	
		КонецЕсли;
		
	ИначеЕсли Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ПроходящиеОбучениеУказаны Тогда
		
		Если ТипЗнч(МестоПроведения) = Тип("СправочникСсылка.CRM_Помещения") Тогда 		
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");	
		КонецЕсли;

	ИначеЕсли Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.ОтражениеРезультатов Тогда
		
		Если ВидОтражения = 1 Тогда
			ИсключаемыеРеквизиты.Добавить("ДатаНачала");
			ИсключаемыеРеквизиты.Добавить("ДатаОкончания");
			ИсключаемыеРеквизиты.Добавить("ВидОбучения");
			ИсключаемыеРеквизиты.Добавить("МестоПроведения");
			ИсключаемыеРеквизиты.Добавить("ПрограммаОбучения");
			ИсключаемыеРеквизиты.Добавить("ОписаниеПрограммы");
			ИсключаемыеРеквизиты.Добавить("Партнер");
		
			ИсключаемыеРеквизиты.Добавить("Преподаватели");
			ИсключаемыеРеквизиты.Добавить("Преподаватели.Преподаватель");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");
			ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента");
			ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента.КонтактноеЛицо");
		
		КонецЕсли;
		
	ИначеЕсли Состояние = Перечисления.смартСостоянияДокументовОбученияСотрудников.РезультатыОтражены Тогда
		
		Если ВидОтражения = 1 Тогда
			ИсключаемыеРеквизиты.Добавить("ДатаНачала");
			ИсключаемыеРеквизиты.Добавить("ДатаОкончания");
			ИсключаемыеРеквизиты.Добавить("ВидОбучения");
			ИсключаемыеРеквизиты.Добавить("МестоПроведения");
			ИсключаемыеРеквизиты.Добавить("ПрограммаОбучения");
			ИсключаемыеРеквизиты.Добавить("ОписаниеПрограммы");
			ИсключаемыеРеквизиты.Добавить("Партнер");
		
			ИсключаемыеРеквизиты.Добавить("Преподаватели");
			ИсключаемыеРеквизиты.Добавить("Преподаватели.Преподаватель");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование");
			ИсключаемыеРеквизиты.Добавить("БронируемоеОборудование.Оборудование");
			ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента");
			ИсключаемыеРеквизиты.Добавить("ПредставителиКлиента.КонтактноеЛицо");
			
		КонецЕсли;
	КонецЕсли;  
		
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, ИсключаемыеРеквизиты);
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	ПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазы(ЭтотОбъект, СтандартнаяОбработка, Префикс);
	
КонецПроцедуры  

