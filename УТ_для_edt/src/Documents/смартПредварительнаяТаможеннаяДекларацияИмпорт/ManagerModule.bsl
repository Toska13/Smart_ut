Функция ПрочитатьИсходныеДанные(АдресДанных, РасширениеФайла) Экспорт
	Результат = ИнициализироватьСтруктуруДляЗаполнения();
	
	ПутьКфайлу = смартПолучитьИмяВременногоФайла(РасширениеФайла);         
	
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	Данные.Записать(ПутьКфайлу);	
		
    ЧтениеXML = Новый ЧтениеXML;
    ЧтениеXML.ОткрытьФайл(ПутьКФайлу); 
    ПостроительDOM = Новый ПостроительDOM;  
    Документ = ПостроительDOM.Прочитать(ЧтениеXML); 
	
	Если Документ.ПервыйДочерний.ИмяУзла = "ED_Container" Тогда
		ПрочитатьИсходныеДанныеED_Container(Документ, Результат);	
	ИначеЕсли Документ.ПервыйДочерний.ИмяУзла = "AltaGTD" Тогда
		ПрочитатьИсходныеДанныеAltaGTD(Документ, Результат);
	КонецЕсли;
		
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ПутьКфайлу);

	Возврат Результат;
КонецФункции  

Процедура ПрочитатьИсходныеДанныеED_Container(Документ, Результат)
		
	Для Каждого ДочернийУзелДокумент Из Документ.ДочерниеУзлы Цикл
		Если ТипЗнч(ДочернийУзелДокумент) = Тип("КомментарийDOM") И СтрНайти(ДочернийУзелДокумент.ТекстовоеСодержимое, "ND=") > 0 Тогда
			Результат.НомерДекларации = СтрЗаменить(ДочернийУзелДокумент.ТекстовоеСодержимое, "ND=", "");	
		КонецЕсли;
		
		Если ТипЗнч(ДочернийУзелДокумент) = Тип("ЭлементDOM") Тогда
			Для Каждого ДочернийУзелED_Container Из Документ.ЭлементДокумента.ДочерниеУзлы Цикл
				
				Если ИмяУзла(ДочернийУзелED_Container) = "ContainerDoc" Тогда 
					УзелContainerDoc = ДочернийУзелED_Container;
					
					Для Каждого ДочернийУзелContainerDoc Из УзелContainerDoc.ДочерниеУзлы Цикл
						УзелDocBody = ДочернийУзелContainerDoc;
						
						Для Каждого ДочернийУзелDocBody Из УзелDocBody.ДочерниеУзлы Цикл
							УзелESADout_CU = ДочернийУзелDocBody;
							
