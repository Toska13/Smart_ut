Функция ДатаИзСтроки(ЗначениеСтрокой)
	Результат = Дата(1,1,1); 
	ДатаСтрокой = СтрЗаменить(ЗначениеСтрокой, "-","");
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, ":","");
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой, "T","");
	Если СтрНайти(ДатаСтрокой, "+") > 0 Тогда
		ДатаСтрокой = Лев(ДатаСтрокой, СтрНайти(ДатаСтрокой, "+") - 1);
	КонецЕсли;
	Попытка
		Результат = Дата(ДатаСтрокой);
	Исключение
	КонецПопытки;
	
	Возврат Результат;
КонецФункции 

Функция ПолучитьДатуПоНомеруДекларации(ПолныйНомерГТД)
	ДатаГТДСтрока 	= Сред(ПолныйНомерГТД, СтрНайти(ПолныйНомерГТД,"/")+1,6);
	День 			= Число(Лев(ДатаГТДСтрока, 2));
	Месяц			= Число(Сред(ДатаГТДСтрока, 3, 2));
	Год  			= 2000 + Число(Сред(ДатаГТДСтрока, 5));
	Возврат Дата(Год,Месяц,День); 	
КонецФункции 

Процедура ПрочитатьИсходныеДанныеAltaGTD(Документ, Результат)
	
	Для Каждого ДочернийУзелAltaGTD Из Документ.ЭлементДокумента.ДочерниеУзлы Цикл
		Если ДочернийУзелAltaGTD.ИмяУзла = "G_2_NAM" Тогда
			Результат.НаименованиеПоставщика = ДочернийУзелAltaGTD.ТекстовоеСодержимое;
		КонецЕсли;
		
		Если ДочернийУзелAltaGTD.ИмяУзла = "REGNUM" Тогда
			Результат.НомерДекларации 	= ДочернийУзелAltaGTD.ТекстовоеСодержимое;
			Результат.Дата	 			= ПолучитьДатуПоНомеруДекларации(Результат.НомерДекларации);
		КонецЕсли;
		
		ТекущийКодВидаПлатежа = "";
		Если ДочернийУзелAltaGTD.ИмяУзла = "BLOCK" Тогда
			СтрукутраРаздела = ПолучитьСтруктуруРаздела();
			
			Для Каждого ДочернийУзелBLOCK Из ДочернийУзелAltaGTD.ДочерниеУзлы Цикл
				Если ДочернийУзелBLOCK.ИмяУзла = "G_31" Тогда
					Для Каждого ДочернийУзелG_31 Из ДочернийУзелBLOCK.ДочерниеУзлы Цикл
						Если ДочернийУзелG_31.ИмяУзла = "NAME" Тогда
							СтрукутраРаздела.НаименованиеТоваров = СтрЗаменить(СтрЗаменить(ДочернийУзелBLOCK.ТекстовоеСодержимое, Символы.ПС, " "), "  ", " ");
						КонецЕсли; 
					КонецЦикла;
				КонецЕсли;
				Если ДочернийУзелBLOCK.ИмяУзла = "G_32_1" Тогда
					СтрукутраРаздела.НомерРаздела = ДочернийУзелBLOCK.ТекстовоеСодержимое;
				КонецЕсли;
				Если ДочернийУзелBLOCK.ИмяУзла = "G_34_1" Тогда
					СтрукутраРаздела.КодАльфа2СтраныПроисхожденияТоваровРаздела = ДочернийУзелBLOCK.ТекстовоеСодержимое;
				КонецЕсли;
				Если ДочернийУзелBLOCK.ИмяУзла = "G_33_1" Тогда
					СтрукутраРаздела.КодТНВЭД = ДочернийУзелBLOCK.ТекстовоеСодержимое;
				КонецЕсли;
				Если ДочернийУзелBLOCK.ИмяУзла = "G_45_0" Тогда
					СтрукутраРаздела.ТаможеннаяСтоимость = ДочернийУзелBLOCK.ТекстовоеСодержимое;
				КонецЕсли;  				
				
				Если Лев(ДочернийУзелBLOCK.ИмяУзла, 5) = "G_47_" Тогда
					ТекстовоеСодержимое = ДочернийУзелBLOCK.ТекстовоеСодержимое;
					
					Если ТекущийКодВидаПлатежа = "" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "1" Тогда
						ТекущийКодВидаПлатежа = ТекстовоеСодержимое;	
					ИначеЕсли ТекущийКодВидаПлатежа = "1010" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "4" Тогда
						Результат.ТаможенныйСбор = ТекстовоеСодержимое;
					ИначеЕсли ТекущийКодВидаПлатежа = "2010" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "3" Тогда
						СтрукутраРаздела.ВидСтавкиПошлины = "%";
						СтрукутраРаздела.СтавкаПошлины = СтрЗаменить(ТекстовоеСодержимое,"%","");
					ИначеЕсли ТекущийКодВидаПлатежа = "2010" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "4" Тогда
						СтрукутраРаздела.СуммаПошлины = ТекстовоеСодержимое;
					ИначеЕсли ТекущийКодВидаПлатежа = "5010" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "3" Тогда
						СтрукутраРаздела.СтавкаНДС = СтрЗаменить(ТекстовоеСодержимое,"%","");
					ИначеЕсли ТекущийКодВидаПлатежа = "5010" И Прав(ДочернийУзелBLOCK.ИмяУзла, 1) = "4" Тогда
						СтрукутраРаздела.СуммаНДС = ТекстовоеСодержимое;
					ИначеЕсли ТекстовоеСодержимое = "ИУ" Или ТекстовоеСодержимое = "HS" Тогда
						ТекущийКодВидаПлатежа = "";	
					КонецЕсли;  
				КонецЕсли;
				
				Если ДочернийУзелBLOCK.ИмяУзла = "TOVG" Тогда
					СтруктураТоварнойПозиции = ПолучитьСтруктуруТоварнойПозиции();
					Для Каждого ДочернийУзелTOVG Из ДочернийУзелBLOCK.ДочерниеУзлы Цикл
						Если ДочернийУзелTOVG.ИмяУзла = "G31_1" Тогда
							СтруктураТоварнойПозиции.Описание = СтруктураТоварнойПозиции.Описание + ?(ЗначениеЗаполнено(СтруктураТоварнойПозиции.Описание), " ","")
																						+ ДочернийУзелTOVG.ТекстовоеСодержимое;
						ИначеЕсли ДочернийУзелTOVG.ИмяУзла = "G31_15" Тогда
							Артикул = ДочернийУзелTOVG.ТекстовоеСодержимое;
							СтруктураТоварнойПозиции.Артикул = Артикул;
						ИначеЕсли ДочернийУзелTOVG.ИмяУзла = "KOLVO" Тогда
							СтруктураТоварнойПозиции.Количество = ДочернийУзелTOVG.ТекстовоеСодержимое;
						ИначеЕсли ДочернийУзелTOVG.ИмяУзла = "G31_38" Тогда
							СтруктураТоварнойПозиции.Вес = ДочернийУзелTOVG.ТекстовоеСодержимое;						
						ИначеЕсли ДочернийУзелTOVG.ИмяУзла = "G31_14" Тогда
							СтруктураТоварнойПозиции.Марка = СокрЛП(ДочернийУзелTOVG.ТекстовоеСодержимое);	
						ИначеЕсли ДочернийУзелTOVG.ИмяУзла = "CODE_EDI" Тогда
							СтруктураТоварнойПозиции.КодЕдиницыИзмерения = СокрЛП(ДочернийУзелTOVG.ТекстовоеСодержимое);	
							
							//Результат.Вставить("СерийныеНомера", 		Новый Массив);
							//Результат.Вставить("СерийныеНомераСтрокой", "");
							
						КонецЕсли;
					КонецЦикла;
					СтрукутраРаздела.ТоварныеПозиции.Добавить(СтруктураТоварнойПозиции); 
					
				КонецЕсли; 
			КонецЦикла;
			Результат.Разделы.Добавить(СтрукутраРаздела);
		КонецЕсли;
	КонецЦикла;   	
КонецПроцедуры

