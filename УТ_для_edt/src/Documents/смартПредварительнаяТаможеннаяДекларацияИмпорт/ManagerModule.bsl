															+ ЗначениеУзла(ДочернийУзелGoodsGroupDescription);													
														КонецЕсли;
														Если ИмяУзла(ДочернийУзелGoodsGroupDescription) = "GoodsGroupInformation" Тогда 
															
															СтруктураТоварнойПозиции = ПолучитьСтруктуруТоварнойПозиции();
															СтруктураТоварнойПозиции.Описание = ОписаниеGoodsDescription;
															
															УзелGoodsGroupInformation = ДочернийУзелGoodsGroupDescription;
															Для Каждого ДочернийУзелGoodsGroupInformation Из УзелGoodsGroupInformation.ДочерниеУзлы Цикл
																Если ИмяУзла(ДочернийУзелGoodsGroupInformation) = "GoodsMark" Тогда
																	СтруктураТоварнойПозиции.Марка = ЗначениеУзла(ДочернийУзелGoodsGroupInformation);													
																КонецЕсли;
																Если ИмяУзла(ДочернийУзелGoodsGroupInformation) = "GoodsMarking" Тогда
																	СтруктураТоварнойПозиции.Артикул = ЗначениеУзла(ДочернийУзелGoodsGroupInformation);													
																КонецЕсли; 
																Если ИмяУзла(ДочернийУзелGoodsGroupInformation) = "SerialNumber" Тогда
																	СтруктураТоварнойПозиции.СерийныеНомера.Добавить(ЗначениеУзла(ДочернийУзелGoodsGroupInformation));													
																КонецЕсли;
																Если ИмяУзла(ДочернийУзелGoodsGroupInformation) = "GoodsGroupQuantity" Тогда
																	УзелGoodsGroupQuantity = ДочернийУзелGoodsGroupInformation;
																	Для Каждого ДочернийУзелGoodsGroupQuantity Из УзелGoodsGroupQuantity.ДочерниеУзлы Цикл
																		Если ИмяУзла(ДочернийУзелGoodsGroupQuantity) = "GoodsQuantity" Тогда
																			СтруктураТоварнойПозиции.Количество = ЗначениеУзла(ДочернийУзелGoodsGroupQuantity);													
																		КонецЕсли;
																		Если ИмяУзла(ДочернийУзелGoodsGroupQuantity) = "MeasureUnitQualifierCode" Тогда
																			СтруктураТоварнойПозиции.КодЕдиницыИзмерения = ЗначениеУзла(ДочернийУзелGoodsGroupQuantity);													
																		КонецЕсли;
																	КонецЦикла;
																КонецЕсли;
															КонецЦикла; 
															СтруктураТоварнойПозиции.СерийныеНомераСтрокой = СтрСоединить(СтруктураТоварнойПозиции.СерийныеНомера, ", ");
															СтрукутраРаздела.ТоварныеПозиции.Добавить(СтруктураТоварнойПозиции);
															
														КонецЕсли;
													КонецЦикла;	
													//-- #7812 смарт: Тимофеева 07.08.2026
												КонецЕсли;
												
												Если ИмяУзла(ДочернийУзелESADout_CUGoods) = "ESADout_CUCustomsPaymentCalculation" Тогда
													УзелESADout_CUCustomsPaymentCalculation = ДочернийУзелESADout_CUGoods; 
													
													КодПлатежа 		= "";
													СуммаПлатежа 	= 0;
													Ставка 			= "";
													ВидСтавки 		= "";
													Для Каждого ДочернийУзелESADout_CUCustomsPaymentCalculation Из УзелESADout_CUCustomsPaymentCalculation.ДочерниеУзлы Цикл
														Если ИмяУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation) = "PaymentModeCode" Тогда
															КодПлатежа = ЗначениеУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation);													
														КонецЕсли;
														Если ИмяУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation) = "PaymentAmount" Тогда
															СуммаПлатежа = ЗначениеУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation);													
														КонецЕсли;
														Если ИмяУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation) = "Rate" Тогда
															Ставка = ЗначениеУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation);													
														КонецЕсли;
														Если ИмяУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation) = "RateTypeCode" Тогда
															ВидСтавки = ЗначениеУзла(ДочернийУзелESADout_CUCustomsPaymentCalculation);													
														КонецЕсли;
													КонецЦикла; 
													
													Если КодПлатежа = "1010" Тогда
														Результат.ТаможенныйСбор = СуммаПлатежа;
													КонецЕсли;
													
													Если КодПлатежа = "2010" Тогда
														СтрукутраРаздела.СуммаПошлины = СуммаПлатежа;
														СтрукутраРаздела.СтавкаПошлины = Ставка;
														СтрукутраРаздела.ВидСтавкиПошлины = ВидСтавки;
													КонецЕсли;
													
													//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
													Если КодПлатежа = "2050" Тогда
														Если СтрукутраРаздела.ВидСтавкиПошлины = ВидСтавки Тогда
															Попытка
																СуммаПошлиныРаздела = Число(СтрукутраРаздела.СуммаПошлины);
																СтавкаПошлиныРаздела = Число(СтрукутраРаздела.СтавкаПошлины);
															
																СтрукутраРаздела.СуммаПошлины = СуммаПошлиныРаздела + СуммаПлатежа;
																СтрукутраРаздела.СтавкаПошлины = СтавкаПошлиныРаздела + Ставка;
															Исключение
															КонецПопытки;
														Иначе
															//ToDo
														КонецЕсли;
													КонецЕсли; 
													//-- #6094 смарт: Тимофеева 17.03.26
													
													Если КодПлатежа = "5010" Тогда
														СтрукутраРаздела.СтавкаНДС = Ставка;
														СтрукутраРаздела.СуммаНДС = СуммаПлатежа;
													КонецЕсли; 										
													
												КонецЕсли;										
											КонецЦикла;	
										КонецЕсли;								
									КонецЦикла;								
								КонецЕсли;  					
							КонецЦикла;					
						КонецЦикла;	   			
					КонецЦикла;
				КонецЕсли; 		
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

