								Если ИмяУзла(ДочернийУзелESADout_CU) = "EECEDocHeaderAddInfo" Тогда
									УзелEECEDocHeaderAddInfo = ДочернийУзелESADout_CU;
									Для Каждого ДочернийУзелEECEDocHeaderAddInfo Из УзелEECEDocHeaderAddInfo.ДочерниеУзлы Цикл
										
										Если ИмяУзла(ДочернийУзелEECEDocHeaderAddInfo) = "EDocDateTime" Тогда
											Результат.Дата = ДатаИзСтроки(ЗначениеУзла(ДочернийУзелEECEDocHeaderAddInfo.ПервыйДочерний));									
										КонецЕсли;
										
									КонецЦикла;	
								КонецЕсли;
								
								Если ИмяУзла(ДочернийУзелESADout_CU) = "ESADout_CUGoodsShipment" Тогда
									УзелESADout_CUGoodsShipment = ДочернийУзелESADout_CU;
									Для Каждого ДочернийУзелESADout_CUGoodsShipment Из УзелESADout_CUGoodsShipment.ДочерниеУзлы Цикл
										
										Если ИмяУзла(ДочернийУзелESADout_CUGoodsShipment) = "ESADout_CUConsignor" Тогда
											УзелESADout_CUConsignor = ДочернийУзелESADout_CUGoodsShipment;
											
											Для Каждого ДочернийУзелESADout_CUConsignor Из УзелESADout_CUConsignor.ДочерниеУзлы Цикл
												
												Если ИмяУзла(ДочернийУзелESADout_CUConsignor) = "OrganizationName" Тогда
													Результат.НаименованиеПоставщика = ЗначениеУзла(ДочернийУзелESADout_CUConsignor);
												КонецЕсли;
												
											КонецЦикла;		
										КонецЕсли;    
										
