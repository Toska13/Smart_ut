//++ #7190 смарт: Тимофеева 19.06.2026 / В ПТД делить товар по характеристикам
&НаСервере
Процедура ЗаполнитьХарактеристикиПоПоступлениямНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока 							= Объект.Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	ТаблицаТоваровКОформлениюПоПоступлениям = ПолучитьТаблицуТоваровКОформлениюПоПоступлениям(Новый Массив, Объект.Груз, Объект.Валюта);
	ТаблицаТоваров 							= ТаблицаТоваровКОформлениюПоПоступлениям.Скопировать(Новый Структура("Номенклатура", ТекущаяСтрока.Номенклатура));
	
	ИтогоКоличество = ТаблицаТоваров.Итог("Количество"); 
	Если НЕ ТекущаяСтрока.Количество = ИтогоКоличество Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru='%1: Количество в документе и общее количество номенклатуры по поступлениям отличается. Заполнение невозможно.'"), ТекущаяСтрока.Номенклатура);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "Объект.Товары");
		Возврат;
	КонецЕсли; 
	
	ИндексТекущейСтроки		= Объект.Товары.Индекс(ТекущаяСтрока);
    КэшированныеЗначения	= Неопределено;
	Для Каждого Строка Из ТаблицаТоваров Цикл
		ИндексТекущейСтроки 			= ИндексТекущейСтроки + 1;
		НоваяСтрока 					= Объект.Товары.Вставить(ИндексТекущейСтроки);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока);
		
		НоваяСтрока.Характеристика 		= Строка.Характеристика;
		НоваяСтрока.Количество 			= Строка.Количество;
		НоваяСтрока.ДокументПоступления = Строка.ДокументПоступления;
		
		ОбработатьСтрокуТЧ(НоваяСтрока, КэшированныеЗначения);

		Элементы.Товары.ТекущаяСтрока  = НоваяСтрока.ПолучитьИдентификатор();
	КонецЦикла;
	
	Объект.Товары.Удалить(ТекущаяСтрока);

КонецПроцедуры
