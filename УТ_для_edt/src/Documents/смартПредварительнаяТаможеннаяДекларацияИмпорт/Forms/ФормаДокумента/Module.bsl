&НаСервереБезКонтекста
Функция НавигационнаяСсылкаФайлаДекларации(ФайлСсылка, ИдентификаторФормы)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлСсылка, ИдентификаторФормы);
		АдресФайла = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
		Расширение = ДанныеФайла.Расширение;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		АдресФайла = "";
		Расширение = "";
	КонецПопытки;
	
	Возврат Новый Структура("АдресФайла,Расширение", АдресФайла, Расширение);
	
КонецФункции

&НаСервере
Процедура СформироватьЛегенду()
	
	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Артикул'"), Новый Шрифт(,,,Истина)));
	ЧастиСтроки.Добавить(" - отличается артикул подобранной номенклатуры с артикулом из декларации;");
	ЧастиСтроки.Добавить("    "); 
	ЧастиСтроки.Добавить(Новый ФорматированнаяСтрока(НСтр("ru = 'Код ТНВЭД'"), , , WebЦвета.Розовый));
    ЧастиСтроки.Добавить(" - отличается код ТНВЭД подобранной номенклатуры с кодом ТНВЭД из декларации");

	ФорматированнаяСтрокаЛегенда = Новый ФорматированнаяСтрока(ЧастиСтроки);
		
КонецПроцедуры

#Область Загрузка 

&НаСервере
Процедура ПрочитатьВТаблицуИсходныеДанные(АдресДанных, РасширениеФайла)
	
	СтруктураДанныхТДИзФайла = Документы.смартПредварительнаяТаможеннаяДекларацияИмпорт.ПрочитатьИсходныеДанные(АдресДанных, РасширениеФайла);
	ЗаполнитьЗначенияСвойств(Объект, СтруктураДанныхТДИзФайла, "Дата, НомерДекларации, ТаможенныйСбор, Валюта");
	
	//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии 
	Если Объект.ВариантОформления = Перечисления.ХозяйственныеОперации.ОформлениеГТДСамостоятельно Тогда
		Объект.ВалютаВзаиморасчетов = Объект.Валюта;
	КонецЕсли;
	
	//Если ЗначениеЗаполнено(СтруктураДанныхТДИзФайла.ОрганизацияИНН) Тогда
	Если ЗначениеЗаполнено(СтруктураДанныхТДИзФайла.ОрганизацияИНН) И НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
	//-- #6094 смарт: Тимофеева 17.03.26
		Объект.Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", СтруктураДанныхТДИзФайла.ОрганизацияИНН);
		ОрганизацияПриИзмененииСервер();
	КонецЕсли; 
	
	//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
	//Если ЗначениеЗаполнено(СтруктураДанныхТДИзФайла.НаименованиеПоставщика) Тогда
	Если ЗначениеЗаполнено(СтруктураДанныхТДИзФайла.НаименованиеПоставщика)
		И НЕ ЗначениеЗаполнено(Объект.Поставщик) Тогда
	//-- #6094 смарт: Тимофеева 17.03.26
    	КонтрагентИПартнер = НайтиПоставщика(СтруктураДанныхТДИзФайла.НаименованиеПоставщика);
		Объект.Поставщик = КонтрагентИПартнер.Партнер;
		Объект.КонтрагентПоставщика = КонтрагентИПартнер.Контрагент;
		КонтрагентПоставщикаПриИзмененииСервер();
	КонецЕсли;  
	
	//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
	//Объект.Груз = НайтиГрузПоНомеруДекларации(Объект.НомерДекларации);	
	Если НЕ ЗначениеЗаполнено(Объект.Груз) Тогда
		Объект.Груз = НайтиГрузПоНомеруДекларации(Объект.НомерДекларации);
	КонецЕсли;
	//-- #6094 смарт: Тимофеева 17.03.26
    		
	КодыСтранМассив = Новый Массив;
	СтавкиНДСМассив = Новый Массив;
    КодыТНВЭДМассив = Новый Массив;
	АртикулыМассив  = Новый Массив;
	ОписанияМассив  = Новый Массив;
	КодыОКЕИМассив  = Новый Массив;
	
	Для Каждого Раздел Из СтруктураДанныхТДИзФайла.Разделы Цикл
		КодыСтранМассив.Добавить(Раздел.КодАльфа2СтраныПроисхожденияТоваровРаздела);
		СтавкиНДСМассив.Добавить(Раздел.СтавкаНДС);
		КодыТНВЭДМассив.Добавить(Раздел.КодТНВЭД); 
		
		Для Каждого ТоварРаздела Из Раздел.ТоварныеПозиции Цикл
        	АртикулыМассив.Добавить(ТоварРаздела.Артикул);
			КодыОКЕИМассив.Добавить(ТоварРаздела.КодЕдиницыИзмерения);
			ОписанияМассив.Добавить(ЛЕВ(ТоварРаздела.Описание, 1000));
		КонецЦикла;
	КонецЦикла;
	
	КодыСтранСоответствие = НайтиСтраныПоКодуАльфа2(КодыСтранМассив);
	СтавкиНДССоответствие = НайтиСтавкиНДСПоСтроке(СтавкиНДСМассив);
	КодыТНВЭДСоответствие = НайтиТНВЭД(КодыТНВЭДМассив);
	КодыОКЕИСоответствие  = НайтиЕдиницыИзмерения(КодыОКЕИМассив);
	АртикулыСоответствие  = НайтиТоварыПоАртикулу(АртикулыМассив);
	//++ #5962 смарт: Тимофеева 06.03.26 / Документ "Предварительная таможенная декларация". Доработки поиска и загрузки данных
	//ОписанияСоответствие  = НайтиТоварыПоОписанию(ОписанияМассив);
	ОписанияТаблица		  = НайтиТоварыПоОписаниюВТаблицу(ОписанияМассив);
	//-- #5962 смарт: Тимофеева 06.03.26
		
	ТаможеннаяПошлина   = 0;
	ТаможеннаяСтоимость = 0; 
	Объект.Разделы.Очистить();
	Объект.Товары.Очистить();
	//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
	КоличествоРазделов  = СтруктураДанныхТДИзФайла.Разделы.Количество();
	//-- #6094 смарт: Тимофеева 17.03.26
	Для Каждого СтруктураРаздела Из СтруктураДанныхТДИзФайла.Разделы Цикл
		НоваяСтрокаРаздела 							= Объект.Разделы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, СтруктураРаздела);
		
		НоваяСтрокаРаздела.СтавкаНДС 				= СтавкиНДССоответствие[СтруктураРаздела.СтавкаНДС];
		НоваяСтрокаРаздела.СтранаПроисхождения 		= КодыСтранСоответствие[СтруктураРаздела.КодАльфа2СтраныПроисхожденияТоваровРаздела];
		
		НоваяСтрокаРаздела.КодТНВЭД 				= СтруктураРаздела.КодТНВЭД;
		НоваяСтрокаРаздела.НаименованиеТоваров		= СтруктураРаздела.НаименованиеТоваров;
		
		ТаможеннаяПошлина							= ТаможеннаяПошлина + ?(СтруктураРаздела.СуммаПошлины = "", 0, СтруктураРаздела.СуммаПошлины);
		ТаможеннаяСтоимость							= ТаможеннаяСтоимость + ?(СтруктураРаздела.ТаможеннаяСтоимость = "", 0, СтруктураРаздела.ТаможеннаяСтоимость); 		
		
		Для Каждого ТоварнаяПозиция Из СтруктураРаздела.ТоварныеПозиции Цикл
			
			НоваяСтрокаТовары								= Объект.Товары.Добавить();
			НоваяСтрокаТовары.НомерРаздела 					= СтруктураРаздела.НомерРаздела;
			
			НоваяСтрокаТовары.АртикулПоДекларации  			= ТоварнаяПозиция.Артикул;
			НоваяСтрокаТовары.ОписаниеПоДекларации  		= ТоварнаяПозиция.Описание;
			НоваяСтрокаТовары.МаркаПоДекларации  			= ТоварнаяПозиция.Марка;
			НоваяСтрокаТовары.СерийныеНомераПоДекларации  	= ТоварнаяПозиция.СерийныеНомераСтрокой;
			НоваяСтрокаТовары.ЕдиницаИзмеренияПоДекларации	= КодыОКЕИСоответствие[ТоварнаяПозиция.КодЕдиницыИзмерения];
			НоваяСтрокаТовары.КодТНВЭДПоДекларации  		= КодыТНВЭДСоответствие[НоваяСтрокаРаздела.КодТНВЭД];
			
			//++ #6722  смарт: Тимофеева 30.04.2026 / Прогружается не вся информация в ПТД из файла
			Если ЗначениеЗаполнено(ТоварнаяПозиция.Количество)
				И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрЗаменить(СтрЗаменить(СтрЗаменить(ТоварнаяПозиция.Количество, ".", ""), "-", ""), ",", "")) Тогда
				НоваяСтрокаТовары.КоличествоУпаковок  		= Число(ТоварнаяПозиция.Количество);
			Иначе
				ТекстСообщения = СтрШаблон("Для строки %1 не удалось определить количество из файла загрузки. Установите значение вручную!", НоваяСтрокаТовары.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			//++ #6722  смарт: Тимофеева 30.04.2026 / Прогружается не вся информация в ПТД из файла

			НоваяСтрокаТовары.КодТНВЭДРаздела				= НоваяСтрокаРаздела.КодТНВЭД;
			НоваяСтрокаТовары.СтранаПроисхождения 			= НоваяСтрокаРаздела.СтранаПроисхождения;
			
			//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
			//НоваяСтрокаТовары.НомерДляСФ 					= НомерДляСФ(СокрЛП(Объект.НомерДекларации), НоваяСтрокаТовары.НомерСтроки); 
			НомерДополнения = НоваяСтрокаРаздела.НомерРаздела;
			Если КоличествоРазделов > 9 И КоличествоРазделов < 100 Тогда
				НомерДополнения = Формат(НомерДополнения, "ЧЦ=2; ЧВН=");
			ИначеЕсли КоличествоРазделов >= 100 Тогда
				НомерДополнения = Формат(НомерДополнения, "ЧЦ=3; ЧВН=");
			КонецЕсли;
			НоваяСтрокаТовары.НомерДляСФ 					= НомерДляСФ(СокрЛП(Объект.НомерДекларации), НомерДополнения);
			//-- #6094 смарт: Тимофеева 17.03.26
			
			//++ #5962 смарт: Тимофеева 06.03.26 / Документ "Предварительная таможенная декларация". Доработки поиска и загрузки данных
			//Номенклатура = АртикулыСоответствие[ТоварнаяПозиция.Артикул];
			//Если ЗначениеЗаполнено(Номенклатура) Тогда
			//	НоваяСтрокаТовары.Номенклатура 				= Номенклатура;
			//	НоваяСтрокаТовары.СпособСопоставления       = "По артикулу";
			//Иначе
			//	Номенклатура = ОписанияСоответствие[ТоварнаяПозиция.Описание];
			//    Если ЗначениеЗаполнено(Номенклатура) Тогда
			//		НоваяСтрокаТовары.Номенклатура 				= Номенклатура;
			//		НоваяСтрокаТовары.СпособСопоставления       = "По описанию";
			//    КонецЕсли;
			//КонецЕсли; 
			
			ОписаниеДляПоиска 	= Лев(ТоварнаяПозиция.Описание, 1000);
			АртикулДляПоиска    = ТоварнаяПозиция.Артикул;
			
			Номенклатура 		= Справочники.Номенклатура.ПустаяСсылка();
			Упаковка 			= Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
			СпособСопоставления	= "";
			
			//Поиск по уже сопоставленной таблице и артикулу
			Если ЗначениеЗаполнено(АртикулДляПоиска) И НЕ АртикулДляПоиска = "ОТСУТСТВУЕТ" Тогда
				НайденныеСтроки 	= ОписанияТаблица.НайтиСтроки(Новый Структура("ПредварительнаяДекларацияСсылка, Артикул, Описание", Объект.Ссылка, АртикулДляПоиска, ОписаниеДляПоиска)); 
			
				Если НайденныеСтроки.Количество() > 0 Тогда 			
					Номенклатура 		= НайденныеСтроки[0].Номенклатура;
					Упаковка 			= НайденныеСтроки[0].Упаковка;
					СпособСопоставления = НайденныеСтроки[0].СпособСопоставления; 			
				КонецЕсли;
			КонецЕсли;
			
			//Поиск по уже сопоставленной таблице
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				НайденныеСтроки 	= ОписанияТаблица.НайтиСтроки(Новый Структура("ПредварительнаяДекларацияСсылка, Описание", Объект.Ссылка, ОписаниеДляПоиска)); 
			
				Если НайденныеСтроки.Количество() > 0 Тогда 			
					Номенклатура 		= НайденныеСтроки[0].Номенклатура;
					Упаковка 			= НайденныеСтроки[0].Упаковка;
					СпособСопоставления = НайденныеСтроки[0].СпособСопоставления; 			
				КонецЕсли; 
			КонецЕсли;

			//Поиск по артикулу
			Если НЕ ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(АртикулДляПоиска) И НЕ АртикулДляПоиска = "ОТСУТСТВУЕТ" Тогда
				Номенклатура 		= АртикулыСоответствие[АртикулДляПоиска];
				СпособСопоставления = "По артикулу"; 
				
				НайденныеСтроки 	= ОписанияТаблица.НайтиСтроки(Новый Структура("Описание, Артикул, Подтверждено", ОписаниеДляПоиска, АртикулДляПоиска, Истина));
				Если НайденныеСтроки.Количество() > 0 Тогда
					Упаковка 		= НайденныеСтроки[0].Упаковка;
                КонецЕсли; 
			КонецЕсли; 
			
			//++ #6982 смарт: Тимофеева 27.05.2026 / В алгоритм поиска при загрузке файла ТД добавить поиск по полю Таможенное описание из карточки товаров
            //Поиск по таможенному описанию
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				Номенклатура 		= НайтиПоТаможенномуОписанию(ТоварнаяПозиция.Описание, АртикулДляПоиска);
				СпособСопоставления = "По таможенному описанию";
			КонецЕсли;
			//-- #6982 смарт: Тимофеева 27.05.2026
			
			//Поиск по описанию
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				НайденныеСтроки = ОписанияТаблица.НайтиСтроки(Новый Структура("Описание, Подтверждено", ОписаниеДляПоиска, Истина)); 
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					
					//пробуем найти с похожим артикулом
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						Если СтрНайти(НайденнаяСтрока.Артикул, АртикулДляПоиска) > 0
							ИЛИ СтрНайти(АртикулДляПоиска, НайденнаяСтрока.Артикул) > 0
							Тогда
							Номенклатура 		= НайденнаяСтрока.Номенклатура;
							Упаковка 			= НайденнаяСтрока.Упаковка;
							СпособСопоставления = "По описанию/артикулу";
							Прервать;
						КонецЕсли; 		
					КонецЦикла; 
					
					//берем первый сопоставленный
					Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
						Номенклатура 		= НайденныеСтроки[0].Номенклатура;
						Упаковка 			= НайденныеСтроки[0].Упаковка;
						СпособСопоставления = "По описанию";
					КонецЕсли; 
					
				КонецЕсли;
			КонецЕсли;
			
			//Нечеткий поиск по артикулу
			Если НЕ ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(АртикулДляПоиска) И НЕ АртикулДляПоиска = "ОТСУТСТВУЕТ"
				Тогда
				Номенклатура 		= НайтиПоПрямомуВхождениюАртикула(АртикулДляПоиска);
				СпособСопоставления = "По артикулу прямой";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(АртикулДляПоиска) И НЕ АртикулДляПоиска = "ОТСУТСТВУЕТ"
				И СтрДлина(АртикулДляПоиска) > 3 Тогда
				Номенклатура 		= НайтиПоОбратномуВхождениюАртикула(АртикулДляПоиска);
				СпособСопоставления = "По артикулу обратный";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Номенклатура)
				И ЗначениеЗаполнено(ОписаниеДляПоиска) Тогда
				Номенклатура 		= НайтиПоНаименованию(ОписаниеДляПоиска);
				СпособСопоставления = "По наименованию";
			КонецЕсли;  
			
			Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
				СпособСопоставления = "";
			КонецЕсли;
			
			НоваяСтрокаТовары.Номенклатура			= Номенклатура;
			НоваяСтрокаТовары.Упаковка				= Упаковка;
			НоваяСтрокаТовары.СпособСопоставления	= СпособСопоставления;
			//-- #5962 смарт: Тимофеева 06.03.26
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьТаблицуТоваровКОформлению()
	
	ТаблицаТоваровКОформлению   			= Объект.Товары.Выгрузить().СкопироватьКолонки();
	МассивНоменклатуры		 				= Объект.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура");	
	ТаблицаТоваровКОформлениюПоПоступлениям = ПолучитьТаблицуТоваровКОформлениюПоПоступлениям(МассивНоменклатуры, Объект.Груз, Объект.Валюта);
	КэшированныеЗначения                    = Неопределено;
	
	Для Каждого Раздел Из Объект.Разделы Цикл 	
		ТоварыРаздела = Объект.Товары.НайтиСтроки(Новый Структура("НомерРаздела", Раздел.НомерРаздела));		
		Для Каждого СтрокаТаблицыТовары Из ТоварыРаздела Цикл
			КоличествоКРаспределению = СтрокаТаблицыТовары.Количество;
			
			Отбор = Новый Структура("Номенклатура,Характеристика");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаТаблицыТовары);
			НайденныеСтроки = ТаблицаТоваровКОформлениюПоПоступлениям.НайтиСтроки(Отбор);			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если КоличествоКРаспределению > 0 И НайденнаяСтрока.Количество > 0 Тогда
					НоваяСтрока 					= ТаблицаТоваровКОформлению.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыТовары, "АртикулПоДекларации, ОписаниеПоДекларации, МаркаПоДекларации, ЕдиницаИзмеренияПоДекларации, 
																				|СерийныеНомераПоДекларации, КодТНВЭДПоДекларации, СпособСопоставления,
																				|НомерРаздела, Номенклатура, Характеристика, Упаковка, СтранаПроисхождения, НомерДляСФ");
				
										
					НоваяСтрока.Количество 			= Мин(КоличествоКРаспределению, НайденнаяСтрока.Количество);					
					НоваяСтрока.ТаможеннаяСтоимость	= НайденнаяСтрока.СуммаСНДС * НоваяСтрока.Количество / НайденнаяСтрока.Количество; 
					НоваяСтрока.Серия				= НайденнаяСтрока.Серия;
					НоваяСтрока.ДокументПоступления = НайденнаяСтрока.ДокументПоступления;
					//++ #7668 смарт: Тимофеева 30.07.2026 / Назначение в ПТД 
					НоваяСтрока.Назначение			= НайденнаяСтрока.Назначение;
					//-- #7668 смарт: Тимофеева 30.07.2026
					НоваяСтрока.Склад				= НайденнаяСтрока.Склад;
											
					КоличествоКРаспределению 		= КоличествоКРаспределению - НоваяСтрока.Количество;
					НайденнаяСтрока.Количество 		= НайденнаяСтрока.Количество - НоваяСтрока.Количество; 
					
					ОбработатьСтрокуТЧ(НоваяСтрока, КэшированныеЗначения);
				КонецЕсли;
			КонецЦикла;
			Если КоличествоКРаспределению > 0 Тогда
				НоваяСтрока 				= ТаблицаТоваровКОформлению.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыТовары, "АртикулПоДекларации, ОписаниеПоДекларации, МаркаПоДекларации, ЕдиницаИзмеренияПоДекларации, 
																				|СерийныеНомераПоДекларации, КодТНВЭДПоДекларации, СпособСопоставления,
																				|НомерРаздела, Номенклатура, Характеристика, Упаковка, СтранаПроисхождения, НомерДляСФ");
				
				НоваяСтрока.Количество 		= КоличествоКРаспределению;
				ОбработатьСтрокуТЧ(НоваяСтрока, КэшированныеЗначения);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрокаКОформлению Из ТаблицаТоваровКОформлению Цикл 
		Если НЕ ЗначениеЗаполнено(СтрокаКОформлению.ДокументПоступления) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("ВНИМАНИЕ! В поступлениях по грузу %1 не найдена номенклатура: %2,%3 - %4 %5",
															Объект.Груз,
															СтрокаКОформлению.Номенклатура,
															СтрокаКОформлению.Характеристика,
															СтрокаКОформлению.Количество,
															?(ЗначениеЗаполнено(СтрокаКОформлению.Упаковка), СтрокаКОформлению.Упаковка, 
																	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаКОформлению.Номенклатура, "ЕдиницаИзмерения"))));
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКОформлению Из ТаблицаТоваровКОформлениюПоПоступлениям Цикл 
		Если СтрокаКОформлению.Количество > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("ВНИМАНИЕ! Обнаружен нераспределенный остаток по документу %1: %2,%3,%4 - %5 %6",
															СтрокаКОформлению.ДокументПоступления,
															СтрокаКОформлению.Номенклатура,
															//++ #7668 смарт: Тимофеева 30.07.2026 / Назначение в ПТД 
															//СтрокаКОформлению.Характеристика,
															СтрШаблон("%1,%2", СтрокаКОформлению.Характеристика, СтрокаКОформлению.Назначение),
															//-- #7668 смарт: Тимофеева 30.07.2026
															СтрокаКОформлению.Серия,
															СтрокаКОформлению.Количество,
															ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаКОформлению.Номенклатура, "ЕдиницаИзмерения")));
		КонецЕсли;
	КонецЦикла;
	
	Объект.Товары.Загрузить(ТаблицаТоваровКОформлению);
	
	ЗаполнитьПорядковыйНомерТовараВТаблицеТоварыСервер();
КонецПроцедуры

&НаСервере
Процедура ОбработатьСтрокуТЧ(ТекущаяСтрока, КэшированныеЗначения)	
	Действия = Новый Структура;
	Действия.Вставить("ПроверитьХарактеристикуПоВладельцу", ТекущаяСтрока.Характеристика);
	Действия.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", ТекущаяСтрока.Упаковка);
	Действия.Вставить("ПересчитатьКоличествоУпаковок");
	Действия.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	Действия.Вставить("ЗаполнитьКодТНВЭД");
	
	Действия.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	Действия.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", ТекущаяСтрока.Склад, ПараметрыУказанияСерий));

	УчетПрослеживаемыхТоваровКлиентСерверЛокализация.ДополнитьОписаниеНастроекЗаполненияСлужебныхРеквизитовТабличнойЧасти(Действия);
	УчетПрослеживаемыхТоваровКлиентСерверЛокализация.ДополнитьОписаниеНастроекПересчетаРеквизитовТабличнойЧасти(
		Объект,
		Действия,
		"Склад",
		Истина);

	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, Действия, КэшированныеЗначения);
	
	ТекущаяСтрока.КодТНВЭДОтличен = НЕ ТекущаяСтрока.КодТНВЭДПоДекларации = ТекущаяСтрока.КодТНВЭД;
	ТекущаяСтрока.АртикулОтличен = НЕ ТекущаяСтрока.АртикулПоДекларации = ТекущаяСтрока.Артикул;

КонецПроцедуры 

#Область ПоискДанныхВБД

&НаСервере
Функция НайтиСтраныПоКодуАльфа2(МассивКодов)
	Результат = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтраныМира.КодАльфа2 КАК КодАльфа2,
	|	СтраныМира.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтраныМира КАК СтраныМира
	|ГДЕ
	|	СтраныМира.КодАльфа2 В(&МассивКодов)"; 	
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Вставить(ВыборкаДетальныеЗаписи.КодАльфа2, ВыборкаДетальныеЗаписи.Ссылка);	
	КонецЦикла;
	Возврат Результат;		
КонецФункции 

&НаСервере
Функция НайтиСтавкиНДСПоСтроке(МассивСтавок)
	Результат = Новый Соответствие;
	Для Каждого СтавкаНДССтрока Из МассивСтавок Цикл
		Если СтавкаНДССтрока = "0" ИЛИ СтавкаНДССтрока = "0.00" Тогда
			Результат.Вставить(СтавкаНДССтрока, Перечисления.СтавкиНДС.НДС0);
