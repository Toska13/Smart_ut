			Результат.Вставить(СтавкаНДССтрока, Перечисления.СтавкиНДС.НДС22);
		ИначеЕсли СтавкаНДССтрока = "" Тогда
			Результат.Вставить(СтавкаНДССтрока, Перечисления.СтавкиНДС.НДС22);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;		
