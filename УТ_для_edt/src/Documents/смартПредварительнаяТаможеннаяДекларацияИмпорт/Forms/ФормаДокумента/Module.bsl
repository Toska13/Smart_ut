&НаСервере
Процедура НастроитьВидимостьМаркируемыхТоваров()
    ОбновитьТаблицуМаркируемыхТоваров();
	Элементы.ГруппаВниманиеМаркируемыеТовары.Видимость = МаркируемыеТовары.Количество() > 0;  
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуМаркируемыхТоваров()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.КодТНВЭДПоДекларации КАК КодТНВЭДПоДекларации,
	|	ВЫРАЗИТЬ(смартПредварительнаяТаможеннаяДекларацияИмпортТовары.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	&Товары КАК смартПредварительнаяТаможеннаяДекларацияИмпортТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА КлассификаторТНВЭД.смартОбязательнаяМаркировка
	|			ТОГДА 1
	|		КОГДА КлассификаторТНВЭД.смартЭкспериментальныйРежимМаркировки
	|			ТОГДА 0
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ПризнакМаркировки
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|		ПО ВТ_Номенклатура.КодТНВЭДПоДекларации = КлассификаторТНВЭД.Ссылка
	|			И (КлассификаторТНВЭД.смартОбязательнаяМаркировка
	|				ИЛИ КлассификаторТНВЭД.смартЭкспериментальныйРежимМаркировки)
	|ГДЕ
	|	НЕ ВТ_Номенклатура.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Номенклатура.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить(,"КодТНВЭДПоДекларации,Номенклатура"));
	РезультатЗапроса = Запрос.Выполнить();
	МаркируемыеТовары.Загрузить(РезультатЗапроса.Выгрузить());
КонецПроцедуры

&НаСервере
Функция ПроверитьУпаковкиЕдиницыИзмерения()
	Результат	 = Истина;
	Запрос 		 = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.Номенклатура КАК Номенклатура,
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.Характеристика КАК Характеристика,
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.Упаковка КАК Упаковка
	|ПОМЕСТИТЬ ВТ_ТоварыПТД
	|ИЗ
	|	&Товары КАК смартПредварительнаяТаможеннаяДекларацияИмпортТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	ПриобретениеТоваровУслугТовары.Характеристика КАК Характеристика,
	|	ПриобретениеТоваровУслугТовары.Упаковка КАК Упаковка
	|ПОМЕСТИТЬ ВТ_ТоварыПоступлений
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка.Проведен
	|	И ПриобретениеТоваровУслугТовары.Ссылка.Груз = &Груз
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыПТД.Номенклатура КАК Номенклатура,
	|	ВТ_ТоварыПТД.Характеристика КАК Характеристика,
	|	ВЫБОР
	|		КОГДА ВТ_ТоварыПТД.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения.Наименование + "" (код по ОКЕИ "" + СпрНоменклатура.ЕдиницаИзмерения.Код + "")""
	|		ИНАЧЕ ВТ_ТоварыПТД.Упаковка
	|	КОНЕЦ КАК УпаковкаПТД,
	|	ВЫБОР
	|		КОГДА ВТ_ТоварыПоступлений.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА СпрНоменклатура.ЕдиницаИзмерения.Наименование + "" (код по ОКЕИ "" + СпрНоменклатура.ЕдиницаИзмерения.Код + "")""
	|		КОГДА НЕ ВТ_ТоварыПоступлений.Упаковка ЕСТЬ NULL
	|			ТОГДА ВТ_ТоварыПоступлений.Упаковка
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|	КОНЕЦ КАК УпаковкаПоступлений
	|ИЗ
	|	ВТ_ТоварыПТД КАК ВТ_ТоварыПТД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТоварыПоступлений КАК ВТ_ТоварыПоступлений
	|		ПО ВТ_ТоварыПТД.Номенклатура = ВТ_ТоварыПоступлений.Номенклатура
	|			И ВТ_ТоварыПТД.Характеристика = ВТ_ТоварыПоступлений.Характеристика
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_ТоварыПТД.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	НЕ ВТ_ТоварыПоступлений.Упаковка = ВТ_ТоварыПТД.Упаковка";
	Запрос.УстановитьПараметр("Груз", 	Объект.Груз);
	Запрос.УстановитьПараметр("Товары", Объект.Товары.Выгрузить(,"Номенклатура,Характеристика,Упаковка"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстСообщения = СтрШаблон("Внимание! %1 %2: в текущем документе используются %3, в приобретениях - %4", Выборка.Номенклатура, Выборка.Характеристика, Выборка.УпаковкаПТД, Выборка.УпаковкаПоступлений);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);		
		Результат = Ложь;	
	КонецЦикла;
		
	Возврат Результат;	
КонецФункции

