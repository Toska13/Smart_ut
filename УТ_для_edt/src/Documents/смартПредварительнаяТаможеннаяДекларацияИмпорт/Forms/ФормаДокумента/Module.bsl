//++ #7190 смарт: Тимофеева 19.06.2026 / В ПТД делить товар по характеристикам
&НаКлиенте
Процедура ЗаполнитьХарактеристикиПоПоступлениям(Команда)   
	
	ОчиститьСообщения();

	ТекстОшибки = "";
	Если НЕ ЗначениеЗаполнено(Объект.Груз) Тогда
		ТекстОшибки = НСтр("ru='Необходимо выбрать груз.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "Объект.Груз");
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	Если Объект.Разделы.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Необходимо создать хотя бы один раздел декларации и заполнить в нем товары.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "Объект.Разделы");
		Возврат;
	КонецЕсли;
	
	Если Объект.Товары.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru='Необходимо заполнить товары декларации. Это можно сделать с помощью команды ""Заполнить"" или вручную.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, "Объект.Товары");
		Возврат;
	КонецЕсли;

	Товары = ОбщегоНазначенияУТКлиентСервер.ВыделенныеЭлементыКоллекции(Объект.Товары, Элементы.Товары.ВыделенныеСтроки);
	Для Каждого СтрокаТовара Из Товары Цикл  	
		Если СтрокаТовара.ХарактеристикиИспользуются Тогда
			ЗаполнитьХарактеристикиПоПоступлениямНаСервере(СтрокаТовара.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры
