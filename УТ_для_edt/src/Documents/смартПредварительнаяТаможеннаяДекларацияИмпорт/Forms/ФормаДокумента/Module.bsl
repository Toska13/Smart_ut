//++ #6982 смарт: Тимофеева 27.05.2026 / В алгоритм поиска при загрузке файла ТД добавить поиск по полю Таможенное описание из карточки товаров
&НаСервере
Функция НайтиПоТаможенномуОписанию(смартТаможенноеОписание, АртикулДляПоиска = "")
	Результат 		= Справочники.Номенклатура.ПустаяСсылка();
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= 
	"ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_ГруппыНоменклатуры
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = ЗНАЧЕНИЕ(Справочник.смартПредопределенныеЗначения.ГруппыПоискаПоТаможенномуОписанию)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.смартТаможенноеОписание КАК смартТаможенноеОписание,
	|	Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ 
	//++ #7666 смарт: Тимофеева 30.07.2026 / 1С/ПДТ/ОШИБКА
	//|	Номенклатура.смартТаможенноеОписание ПОДОБНО &смартТаможенноеОписание
	|	Номенклатура.смартТаможенноеОписание ПОДОБНО &смартТаможенноеОписание СПЕЦСИМВОЛ ""~""
	//-- #7666 смарт: Тимофеева 30.07.2026
	|	И Номенклатура.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_ГруппыНоменклатуры.Значение
	|			ИЗ
	|				ВТ_ГруппыНоменклатуры)";
	
	//++ #7666 смарт: Тимофеева 30.07.2026 / 1С/ПДТ/ОШИБКА
	//Запрос.УстановитьПараметр("смартТаможенноеОписание", смартТаможенноеОписание);
    Запрос.УстановитьПараметр("смартТаможенноеОписание", ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(смартТаможенноеОписание));
	//-- #7666 смарт: Тимофеева 30.07.2026
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();	
	Если ТаблицаНоменклатуры.Количество() = 1 Тогда
		Возврат ТаблицаНоменклатуры[0].Ссылка;
	КонецЕсли; 
	
	НайденныеСтроки = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("смартТаможенноеОписание", смартТаможенноеОписание));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		//пробуем найти с похожим артикулом
		Если ЗначениеЗаполнено(АртикулДляПоиска) Тогда
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если ЗначениеЗаполнено(НайденнаяСтрока.Артикул) 
					И (СтрНайти(НайденнаяСтрока.Артикул, АртикулДляПоиска) > 0
					ИЛИ СтрНайти(АртикулДляПоиска, НайденнаяСтрока.Артикул) > 0)
					Тогда
					Результат 		= НайденнаяСтрока.Ссылка;
					Прервать;
				КонецЕсли; 		
			КонецЦикла; 
		КонецЕсли; 
		
		//берем первый сопоставленный
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат 		= НайденныеСтроки[0].Ссылка;
		КонецЕсли; 
		
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции	
