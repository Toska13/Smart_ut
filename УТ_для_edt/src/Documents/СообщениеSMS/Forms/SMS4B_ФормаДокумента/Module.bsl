// Процедура загружает данные из шалона
//
// Параметры:
//	ШаблонОбъект	- СправочникОъект	- Шалон
//
Процедура CRM_ЗагрузитьИзШаблонаНаСервере(ШаблонОбъект)
	ОписаниеРеквизитов = ПолучитьРеквизиты("Объект");
