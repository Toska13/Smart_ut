Процедура СортироватьТаблицуКомплектующих() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.Цена КАК Цена,
	|	ТЗ.Стоимость КАК Стоимость
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
	|	ВТ.Количество КАК Количество,
	|	ВТ.Цена КАК Цена,
	|	ВТ.Стоимость КАК Стоимость,
	|	смартIECHOКомплектующие.Порядок КАК Порядок
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующие
	|		ПО ВТ.НаименованиеКомплектующей = смартIECHOКомплектующие.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартIECHOКомплектующие.Порядок";
	
	Запрос.УстановитьПараметр("ТЗ", Комплектующие.Выгрузить());
	
	Комплектующие.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

