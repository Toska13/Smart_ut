Функция СформироватьНаименованиеОборудования()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Комплектующие.НаименованиеКомплектующей КАК Справочник.смартIECHOКомплектующие) КАК НаименованиеКомплектующей
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК Комплектующие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ТЧ.НаименованиеКомплектующей.Наименование КАК Наименование,
	|	ВТ_ТЧ.НаименованиеКомплектующей.ОсновнаяКомплектующая КАК ОсновнаяКомплектующая
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновнаяКомплектующая УБЫВ,
	|	Наименование";
	
	Запрос.УстановитьПараметр("ТЧ", Комплектующие.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = "";
	
	Пока Выборка.Следующий() Цикл
		
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), "_", "") + Выборка.Наименование;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#Область Печать

Функция СформироватьКоммерческоеПредложение() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	МакетКП = ПолучитьМакет("МакетКП");
	ОбластьКП = МакетКП.ПолучитьОбласть("ОбластьКП");
	ТабДок.Вывести(ОбластьКП);
	
	Возврат ТабДок;
	
КонецФункции

#КонецОбласти

