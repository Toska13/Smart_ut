Процедура ВыполнитьЗадачуБизнесПроцесса()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадачаИсполнителя.БизнесПроцесс КАК БизнесПроцесс,
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	НЕ ЗадачаИсполнителя.Выполнена
	|	И ЗадачаИсполнителя.ТочкаМаршрута = &ТочкаМаршрута
	|	И ЗадачаИсполнителя.Предмет = &Предмет";
	
	Запрос.УстановитьПараметр("Предмет", Ссылка);
	Запрос.УстановитьПараметр("ТочкаМаршрута", БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ПометитьСпецификациюНаУдаление); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Задача = Выборка.Ссылка.ПолучитьОбъект();		
		Задача.ВыполнитьЗадачу();
		// БП должен сам завершиться, т.к. это финальная точка
	Иначе
		
		// Завершить БП, если текущая точка маршрута любая другая
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартIECHOПродажа.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_БизнесПроцессы
		|ИЗ
		|	БизнесПроцесс.смартIECHOПродажа КАК смартIECHOПродажа
		|ГДЕ
		|	смартIECHOПродажа.Стартован
		|	И смартIECHOПродажа.Предмет = &Предмет
		|	И НЕ смартIECHOПродажа.Завершен";
		
		Запрос.УстановитьПараметр("Предмет", Ссылка);
		ВыборкаБП = Запрос.Выполнить().Выбрать();
		Пока ВыборкаБП.Следующий() Цикл
			смартОбщегоНазначения.ЗавершитьБизнесПроцессИЗадачи(ВыборкаБП.Ссылка, "Спецификация помечена на удаление. Бизнес-процесс остановлен");
		КонецЦикла;
			
	КонецЕсли;

КонецПроцедуры

