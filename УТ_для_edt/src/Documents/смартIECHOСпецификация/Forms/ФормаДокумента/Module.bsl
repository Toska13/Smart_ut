&НаСервере
//++ #1376 смарт: Фролов 06.09.2023 //доработка функционала консруктора iECHO (Глобализация параметров)  
Процедура ОбновитьСписокТиповДоставки(СброситьТипДоставки=Ложь) 
	Элементы.ТипДоставкиФорма.СписокВыбора.Очистить();
	Если Объект.СхемаЗаполненияСтоимости.Страна=Справочники.СтраныМира.Россия ТОгда
		Элементы.ТипДоставкиФорма.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.МорскойПлюсЖД,"Морской транспорт + ЖД"); 
		Элементы.ДекорацияВниманиеСтрана.Видимость=Ложь;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Объект.СхемаЗаполненияСтоимости) ТОгда
		Страна=НРег(Объект.СхемаЗаполненияСтоимости.Страна.Наименование); 
		Страна=Врег(Лев(Страна,1))+Сред(Страна,2,СтрДлина(Страна)-1);
		МасДляСтраны=ПолучитьСклоненияСтроки(Страна,"ПЛ=Мужской","ПД=Родительный");
		НаименованиеСтраны=МасДляСтраны[0];
		Элементы.ДекорацияВниманиеСтрана.Заголовок="Внимание! Расчет произведен для "+НаименованиеСтраны+"";
		Элементы.ДекорацияВниманиеСтрана.Видимость=Истина;
	КонецЕсли;
	Элементы.ТипДоставкиФорма.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.ЖелезнодорожныйТранспорт,"Железнодорожный транспорт");
	Элементы.ТипДоставкиФорма.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.АвтомобильныйТранспорт,"Автомобильный транспорт"); 
	Если СброситьТипДоставки И ЗначениеЗаполнено(Объект.СхемаЗаполненияСтоимости) Тогда
		Объект.ТипДоставки=Объект.СхемаЗаполненияСтоимости.ТипДоставки;
	Конецесли;
	ТипДоставкиФорма=Объект.ТипДоставки;
КонецПроцедуры	//-- #1376 смарт: Фролов 06.09.2023

//++ #1376 смарт: Фролов 03.10.2023 //доработка функционала консруктора iECHO (Глобализация параметров)
&НаСервере
Процедура ЗаполнитьСтоимостьИзПредопределенныхНастроек()
	Объект.СтоимостьДоставкиДоГраницыРФ 	= Объект.СхемаЗаполненияСтоимости.СтоимостьДоставкиДоГраницыРФ;
	Объект.СтоимостьТаможенногоОформления 	= Объект.СхемаЗаполненияСтоимости.СтоимостьТаможенногоОформления;
	Объект.СтоимостьДоставкиПоРФ 			= Объект.СхемаЗаполненияСтоимости.СтоимостьДоставкиПоРФ;
	Объект.СтоимостьДоставкиЖДТранспортом  = Объект.СхемаЗаполненияСтоимости.СтоимостьДоставкиЖДТранспортом;
	Объект.СтоимостьДоставкиАМТранспортом  = Объект.СхемаЗаполненияСтоимости.СтоимостьДоставкиАМТранспортом;
	
	Объект.СтавкаНДС                       = Объект.СхемаЗаполненияСтоимости.СтавкаНДС;
	
	Объект.ВалютаУчета                     = Объект.СхемаЗаполненияСтоимости.ВалютаУчета;
	
	Объект.Маржа = Объект.СхемаЗаполненияСтоимости.Маржа;
	
	КоличествоДней = Объект.СхемаЗаполненияСтоимости.КоличествоДнейДействияКП;
	Если ЗначениеЗаполнено(КоличествоДней) И ТипЗнч(КоличествоДней) = Тип("Число") Тогда			
		Объект.ДатаДействияКП = ТекущаяДата() + КоличествоДней * 86400;
	КонецЕсли;		
	
	КоличествоДней = Объект.СхемаЗаполненияСтоимости.СрокПоставкиДней;
	Объект.СрокПоставкиДней = КоличествоДней;
КонецПроцедуры	//-- #1376 смарт: Фролов 03.10.2023





