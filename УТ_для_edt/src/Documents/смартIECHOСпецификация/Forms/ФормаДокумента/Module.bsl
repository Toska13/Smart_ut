&НаКлиенте
Процедура ЗапуститьБизнесПроцесс()
	
	СуществующийБП = НайтиЗапущенныйБизнесПроцесс(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(СуществующийБП) Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("СуществующийБП", СуществующийБП);
		
		СписокЗначенийОтветов = Новый СписокЗначений;
		СписокЗначенийОтветов.Добавить("Перезапустить");
		СписокЗначенийОтветов.Добавить("Продолжить существующий");
				
		Оповещение = Новый ОписаниеОповещения("ВопросПередПерезапускомБПЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ТекстВопроса = НСтр("ru = 'Уже существует запущенный бизнес-процесс по спецификации. Продолжить его или перезапустить заново?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокЗначенийОтветов, , "Перезапустить");
		
	Иначе
		ЗапуститьБизнесПроцессНаСервере();
	КонецЕсли;
					
КонецПроцедуры

