&НаСервере
Процедура ПроверитьДублиКомплектующих(НаименованиеКомплектующей)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Комплектующие.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
	|	Комплектующие.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК Комплектующие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.НаименованиеКомплектующей КАК Наименование,
	|	КОЛИЧЕСТВО(ВТ_ТЧ.НомерСтроки) КАК Количество
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|ГДЕ
	|	ВТ_ТЧ.НаименованиеКомплектующей = &НаименованиеКомплектующей
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТЧ.НаименованиеКомплектующей
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ВТ_ТЧ.НомерСтроки) > 1";
	
	Запрос.УстановитьПараметр("ТЧ", Объект.Комплектующие.Выгрузить());
	Запрос.УстановитьПараметр("НаименованиеКомплектующей", НаименованиеКомплектующей);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю("Комплектующая " + Выборка.Наименование + " введена более одного раза (" + Выборка.Количество + ")");
	КонецЦикла;	
	
КонецПроцедуры

