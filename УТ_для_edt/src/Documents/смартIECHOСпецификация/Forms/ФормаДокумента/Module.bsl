	Об = РеквизитФормыВЗначение("Объект");
	Об.СортироватьТаблицуКомплектующих();
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	Модифицированность = Истина;
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

//++#1326 смарт: Лопато 20.03.2023 //Расчет маржи в спецификациях iECHO  
&НаСервере
Процедура РассчитатьРентабельность()

	Если Объект.ИтогоДляКлиента = 0 Тогда
		Рентабельность = 0;
	Иначе	
		Рентабельность = Окр(Объект.МаржаUSD / Объект.ИтогоДляКлиента * 100);
	КонецЕсли;
	
	Если Объект.Рентабельность <> Рентабельность Тогда
		Объект.Рентабельность = Рентабельность;
	КонецЕсли;	
		
КонецПроцедуры //--#1326 смарт: Лопато 20.03.2023

