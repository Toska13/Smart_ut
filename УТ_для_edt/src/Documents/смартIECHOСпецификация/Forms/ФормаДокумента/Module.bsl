&НаСервереБезКонтекста
Функция НайтиЗапущенныйБизнесПроцесс(Предмет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартIECHOПродажа.Ссылка КАК Ссылка
	|ИЗ
	|	БизнесПроцесс.смартIECHOПродажа КАК смартIECHOПродажа
	|ГДЕ
	|	смартIECHOПродажа.Предмет = &Предмет
	|	И НЕ смартIECHOПродажа.Завершен
	|	И смартIECHOПродажа.Стартован";
	
	Запрос.УстановитьПараметр("Предмет", Предмет);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции

