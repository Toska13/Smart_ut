&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	Элементы.Номенклатура.ТолькоПросмотр = НЕ РольДоступна("ПолныеПрава");
	//++ смарт:Белоусова 621 10.09.2021
	если не РольДоступна("ПолныеПрава") тогда
		элементы.ГруппаСуммы.Видимость = Ложь;
	КонецЕсли;
	//-- смарт:Белоусова 621 10.09.2021

	//++ смарт:ММ 621 23.09.2021
	ЕстьПолныеПрава = УправлениеДоступом.ЕстьРоль("ПолныеПрава");
	
	Если УправлениеДоступом.ЕстьРоль("смартIECHOДобавлениеИзменениеСпецификаций")
		ИЛИ ЕстьПолныеПрава Тогда
		Элементы.ГруппаРасчет.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ГруппаРасчет.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	//++ #1376 смарт: Фролов 06.10.2023 //Доработка функционала консруктора iECHO (Глобализация параметров) 
	//Переработаны доступы и видимость
	Если УправлениеДоступом.ЕстьРоль("смартIECHOЗакупщикКомплектующих")
		ИЛИ ЕстьПолныеПрава ИЛИ УправлениеДоступом.ЕстьРоль("смартIECHOАдминистрирование") Тогда
		Элементы.ГруппаРасчетДоставки.ТолькоПросмотр = Ложь;
		Элементы.ПоказателиДляДоставки.Видимость=Истина;
	Иначе
		Элементы.ПоказателиДляДоставки.Видимость=Ложь;
		//-- #1376 смарт: Фролов 06.10.2023
	КонецЕсли;
	//-- смарт:ММ 23.09.2021
	
КонецПроцедуры

