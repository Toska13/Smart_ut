// ++ 17.01.2021
&НаСервере
Процедура ДобавитьФайлВПрисоединенныеФайлы(ТабДок)
	
	Расширение = "pdf";
	
	ИмяФайла = "КП." + Расширение;
	ПолныйПутьФайла = КаталогВременныхФайлов() + ИмяФайла;
	
	ТабДок.Записать(ПолныйПутьФайла, ТипФайлаТабличногоДокумента.PDF);
	ДвоичныеДанныеФайла = Новый ДвоичныеДанные(ПолныйПутьФайла);
	
	АдресДанныхФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайла, Новый УникальныйИдентификатор);
	
	ПараметрыФайла = Новый Структура();
	
	Автор = Объект.Менеджер;
	
	ПараметрыФайла.Вставить("Автор",                          Автор);
	ПараметрыФайла.Вставить("ИмяБезРасширения",               "КП");
	ПараметрыФайла.Вставить("РасширениеБезТочки",             Расширение);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное",    ТекущаяУниверсальнаяДата());
	ПараметрыФайла.Вставить("ВладелецФайлов",                 Объект.Ссылка);
	ПараметрыФайла.Вставить("АдресФайлаВоВременномХранилище", АдресДанныхФайла);

	УжеЗаписанныйФайл = Справочники.смартIECHOСпецификацияПрисоединенныеФайлы.НайтиПоНаименованию("КП", Истина);
	
	Попытка
		Если ЗначениеЗаполнено(УжеЗаписанныйФайл) Тогда
			РаботаСФайлами.ОбновитьФайл(УжеЗаписанныйФайл, ПараметрыФайла)
		Иначе		
