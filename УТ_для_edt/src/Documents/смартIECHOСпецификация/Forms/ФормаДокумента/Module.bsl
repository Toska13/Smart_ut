&НаСервере
Процедура ЗапуститьБизнесПроцессНаСервере(СуществующийБП = Неопределено)
	
	Если ЗначениеЗаполнено(СуществующийБП) Тогда
		смартОбщегоНазначения.ЗавершитьБизнесПроцессИЗадачи(СуществующийБП, "Завершен пользователем. По предмету создан новый бизнес-процесс");
	КонецЕсли;

	Процесс = БизнесПроцессы.смартIECHOПродажа.СоздатьБизнесПроцесс();
	Процесс.Дата         = ТекущаяДатаСеанса();
	Процесс.Предмет      = Объект.Ссылка;
	Процесс.Автор        = Объект.Менеджер;
	Процесс.Наименование = "Продажа по спецификации №" + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ='dd.MM.yyyy ""г.""'");
	Процесс.Записать();
	Процесс.Старт();
	
КонецПроцедуры

