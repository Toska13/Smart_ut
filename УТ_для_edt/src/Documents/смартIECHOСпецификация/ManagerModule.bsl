Функция ПолучитьКоэффициентРасчетаСС(ТЧ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧ.НаименованиеКомплектующей КАК НаименованиеКомплектующей
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
	|	смартIECHOКомплектующиеСпр.КоэффициентРасчетаСебестоимости КАК КоэффициентРасчетаСебестоимости
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующиеСпр
	|		ПО ВТ_ТЧ.НаименованиеКомплектующей = смартIECHOКомплектующиеСпр.Ссылка
	|ГДЕ
	|	смартIECHOКомплектующиеСпр.ОсновнаяКомплектующая";
	
	Запрос.УстановитьПараметр("ТЧ", ТЧ);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	//++ #1361 смарт: Фролов 30.05.2023 //Изменения в модуле iECHO  
	//Если Выборка.Следующий() Тогда
	//	Возврат Выборка.КоэффициентРасчетаСебестоимости;
	//КонецЕсли; 
	
	//Возврат 1;
	КоэффициентРасчетаСебестоимости=0;
	Пока Выборка.Следующий() Цикл
		КоэффициентРасчетаСебестоимости=КоэффициентРасчетаСебестоимости+Выборка.КоэффициентРасчетаСебестоимости;
	КонецЦикла;
	Если КоэффициентРасчетаСебестоимости=0 Тогда
		Возврат 1;
	Иначе
		Возврат КоэффициентРасчетаСебестоимости;
	КонецЕсли;	
	//-- #1361 смарт: Фролов 30.05.2023
	
КонецФункции

#КонецЕсли
