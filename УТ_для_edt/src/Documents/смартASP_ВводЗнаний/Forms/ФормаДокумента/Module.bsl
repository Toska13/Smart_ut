
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Если Объект.ТаблицаЗнаний.Количество() = 0 Тогда
		ПерезаполнитьТаблицуНаСервере()
	Иначе
		ЗаполнитьТаблицуИзДанныхНаСервере()
	КонецЕсли;
	
	//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  
	Если НЕ ЗначениеЗаполнено(Объект.смартСтатусРасчетаБонусов) Тогда
		Объект.смартСтатусРасчетаБонусов = Перечисления.смартСтатусыДокументовРасчетаБонусов.ВРаботе;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	

	УстановитьДоступностьПоСтатусуРасчета();
	//--#1288 смарт: Лопато 26.12.2022
	
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ЗаполнитьТаблицуИзДанныхНаСервере()
	тзТабЗнаний.Очистить();
	СписокКолонок.Очистить();
	
	тз = РеквизитФормыВЗначение("тзТабЗнаний", Тип("ТаблицаЗначений"));
	
	МассивРеквизитов = Новый Массив;
    
    //Удалим ранее созданные колонки в ТЗ    
    Для Каждого Колонка Из тз.Колонки Цикл
        МассивРеквизитов.Добавить("тзТабЗнаний." + Колонка.Имя);        
    КонецЦикла;
    ИзменитьРеквизиты(,МассивРеквизитов);
	тз.Колонки.Очистить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ЕСТЬNULL(смартASP_Категории.Ссылка, ASP_ВводЗнанийТаблицаЗнаний.Категория) КАК Ссылка,
	                      |	ВЫБОР
	                      |		КОГДА смартASP_Категории.Ссылка ЕСТЬ NULL
	                      |			ТОГДА ASP_ВводЗнанийТаблицаЗнаний.Категория.Наименование
	                      |		ИНАЧЕ смартASP_Категории.Наименование
	                      |	КОНЕЦ КАК Наименование
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		ASP_ВводЗнанийТаблицаЗнаний.Ссылка КАК Ссылка,
	                      |		ASP_ВводЗнанийТаблицаЗнаний.Категория КАК Категория
	                      |	ИЗ
	                      |		Документ.смартASP_ВводЗнаний.ТаблицаЗнаний КАК ASP_ВводЗнанийТаблицаЗнаний
	                      |	ГДЕ
	                      |		ASP_ВводЗнанийТаблицаЗнаний.Ссылка = &Док) КАК ASP_ВводЗнанийТаблицаЗнаний
	                      |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			смартASP_Категории.Ссылка КАК Ссылка,
	                      |			смартASP_Категории.Наименование КАК Наименование
	                      |		ИЗ
	                      |			Справочник.смартASP_Категории КАК смартASP_Категории
	                      |		ГДЕ
	                      |			смартASP_Категории.Активен
	                      |			И НЕ смартASP_Категории.ПометкаУдаления) КАК смартASP_Категории
	                      |		ПО ASP_ВводЗнанийТаблицаЗнаний.Категория = смартASP_Категории.Ссылка
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Наименование");
	Запрос.УстановитьПараметр("Док", Объект.Ссылка);
	Рез = Запрос.Выполнить().Выгрузить();
	
	тз.Колонки.Добавить("Инженер", Новый ОписаниеТипов("СправочникСсылка.Пользователи"), "Инженер");
	
	сч = 0;
	Для Каждого стр Из Рез Цикл
		Если СписокКолонок.НайтиПоЗначению(стр.Наименование) <> Неопределено Тогда
			Продолжить
		КонецЕсли;
		
		сч=сч+1;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Число"));
		ПараметрыЧисла = Новый КвалификаторыЧисла(5,2,ДопустимыйЗнак.Любой);

		ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, , ПараметрыЧисла);

		тз.Колонки.Добавить("Колонка"+Формат(сч, "ЧГ=0"), ДопустимыеТипы, стр.Наименование);
		
		СписокКолонок.Добавить(стр.Наименование, "Колонка"+Формат(сч, "ЧГ=0"));
	КонецЦикла;
	Для Каждого стр Из Объект.ТаблицаЗнаний Цикл
		мСтрок = тз.НайтиСтроки(Новый Структура("Инженер", стр.Инженер));
		Если мСтрок.Количество() = 0 Тогда
			нов = тз.Добавить();
			нов.Инженер = стр.Инженер;
		Иначе
			нов = мСтрок[0]
		КонецЕсли;
		
		кол = СписокКолонок.НайтиПоЗначению(стр.Категория.Наименование);
		Если кол <> Неопределено Тогда
			нов[кол.Представление] = стр.Балл
		КонецЕсли;
	КонецЦикла;
	
	//////////////////
	ЭлементТаблица = Элементы.Найти("тзТабЗнаний");
    Если ЭлементТаблица <> Неопределено Тогда
        Элементы.Удалить(ЭлементТаблица);        
    КонецЕсли;     
    
    ЭлементТаблица=Элементы.Добавить("тзТабЗнаний", Тип("ТаблицаФормы"), Элементы.ГруппаТаблицы);
    ЭлементТаблица.ПутьКДанным = "тзТабЗнаний";
    ЭлементТаблица.Отображение = ОтображениеТаблицы.Список;
	ЭлементТаблица.УстановитьДействие("ПриИзменении", "тзТабЗнанийПриИзменении");
	
	//Создадим реквизиты ТЗ
    МассивРеквизитов.Очистить();
    Для Каждого Колонка ИЗ тз.Колонки Цикл
        НоваяКолонка = Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "тзТабЗнаний", Колонка.Заголовок);
        МассивРеквизитов.Добавить(НоваяКолонка);
    КонецЦикла;      
    ИзменитьРеквизиты(МассивРеквизитов);
	ЗначениеВРеквизитФормы(тз, "тзТабЗнаний");
	
	Для Каждого Колонка ИЗ тз.Колонки Цикл
        НовыйЭлементФормы = Элементы.Добавить("тзТабЗнаний"+Колонка.Имя, Тип("ПолеФормы"), Элементы.тзТабЗнаний);
        НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
        НовыйЭлементФормы.ПутьКДанным = "тзТабЗнаний." + Колонка.Имя;
		НовыйЭлементФормы.Заголовок = Колонка.Заголовок;
	КонецЦикла;

КонецПроцедуры

