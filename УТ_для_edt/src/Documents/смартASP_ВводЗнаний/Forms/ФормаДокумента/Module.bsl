//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	тз = РеквизитФормыВЗначение("тзТабЗнаний", Тип("ТаблицаЗначений"));
	тз.Колонки.Добавить("Счетчик");
	тз.ЗаполнитьЗначения(1, "Счетчик");
	тз.Свернуть("Инженер", "Счетчик");
	тз.Сортировать("Счетчик УБЫВ");
	Для Каждого стр Из тз Цикл
		Если стр.Счетчик < 2 Тогда
			Прервать
		КонецЕсли;
		Сообщить("Введено больше одной строки для инженера " + стр.Инженер, СтатусСообщения.ОченьВажное);
		Отказ = Истина
	КонецЦикла;
	
	Если НЕ Отказ Тогда
		
		тз = РеквизитФормыВЗначение("тзТабЗнаний", Тип("ТаблицаЗначений"));
		Для Каждого кол Из тз.Колонки Цикл
			Для Каждого тек Из СписокКолонок Цикл
				Если тек.Представление = кол.Имя Тогда
					кол.Заголовок = тек.Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ТаблицаЗнаний", тз);
		
		//++#1288 смарт: Лопато 20.01.2023 //Правка ошибки, при которой удаляются данные ТЧ при записи не из формы  
		ТекущийОбъект.ТаблицаЗнаний.Очистить();
		Для Каждого стр Из тз Цикл
			Для Каждого кол Из тз.Колонки Цикл
				Если кол.Имя = "Инженер" Тогда
					Продолжить;
				КонецЕсли;
				
				нов = ТекущийОбъект.ТаблицаЗнаний.Добавить();
				нов.Инженер = стр.Инженер;
				нов.Категория = Справочники.смартASP_Категории.НайтиПоНаименованию(кол.Заголовок);
				нов.Балл = стр[кол.Имя]
			КонецЦикла;
		КонецЦикла;	
		//--#1288 смарт: Лопато 20.01.2023
		
	КонецЕсли;
КонецПроцедуры

