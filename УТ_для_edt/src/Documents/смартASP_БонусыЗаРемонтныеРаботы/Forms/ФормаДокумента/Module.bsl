	Иначе
		КоэффициентКатегории = 0;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"
	// Выручка по подразделениям
	|ВЫБРАТЬ
	|	ВыручкаПоПодразделениям.Подразделение КАК Подразделение,
	|	ВыручкаПоПодразделениям.Выручка КАК Выручка
	|ПОМЕСТИТЬ ВТ_ВыручкаПоПодразделениям_тз
	|ИЗ
	|	&ВыручкаПоПодразделениямТЗ КАК ВыручкаПоПодразделениям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_ВыручкаПоПодразделениям.Подразделение) КАК Подразделение,
	|	СУММА(ВТ_ВыручкаПоПодразделениям.Выручка) КАК Выручка
	|ПОМЕСТИТЬ ВТ_ВыручкаПоПодразделениям
	|ИЗ
	|	ВТ_ВыручкаПоПодразделениям_тз КАК ВТ_ВыручкаПоПодразделениям
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартASP_ЗаменыПодразделений КАК смартASP_ЗаменыПодразделений
	|		ПО ВТ_ВыручкаПоПодразделениям.Подразделение = смартASP_ЗаменыПодразделений.ПодразделениеДляЗамены
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_ВыручкаПоПодразделениям.Подразделение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаРемонтныеРаботы.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Платная)
	|			ТОГДА ""Платный""
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Гарантия)
	|			ТОГДА ""Гарантия""
	|	КОНЕЦ КАК ВидРабот,
	|	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер КАК Инженер,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС
	|		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо
	|	КОНЕЦ КАК ДатаОкончанияРабот,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.Представительство = &ПустоеПодразделение
	|			ТОГДА &ГоловнойОфисМосква
	|		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.Представительство
	|	КОНЕЦ КАК Представительство
	|ПОМЕСТИТЬ ВТ_Заявки_вр
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	|ГДЕ
	|	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	|	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И смартЗаявкаНаРемонтныеРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтЗавершен)
	|	И (смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|			ИЛИ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ))
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	смартЗаявкаНаРемонтныеРаботы.Ссылка,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Платная)
	|			ТОГДА ""Платный""
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.ВидГарантии = ЗНАЧЕНИЕ(Перечисление.смартВидыГарантии.Гарантия)
	|			ТОГДА ""Гарантия""
	|	КОНЕЦ,
	|	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2
	|		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА смартЗаявкаНаРемонтныеРаботы.Представительство = &ПустоеПодразделение
	|			ТОГДА &ГоловнойОфисМосква
	|		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.Представительство
	|	КОНЕЦ
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	|ГДЕ
	|	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	|	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И смартЗаявкаНаРемонтныеРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтЗавершен)
	|	И (смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|			ИЛИ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.Ссылка КАК Ссылка,
	|	ВТ_Заявки.ВидРабот КАК ВидРабот,
	|	ВТ_Заявки.Инженер КАК Инженер,
	|	ВТ_Заявки.ДатаОкончанияРабот КАК ДатаОкончанияРабот,
	|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_Заявки.Представительство) КАК Представительство
	|ПОМЕСТИТЬ ВТ_Заявки
	|ИЗ
	|	ВТ_Заявки_вр КАК ВТ_Заявки
	|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.смартASP_ЗаменыПодразделений КАК смартASP_ЗаменыПодразделений
	|		ПО ВТ_Заявки.Представительство = смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Заявки.Ссылка) КАК КоличествоОбщее,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.ВидРабот = ""Гарантия""
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоГарантия,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.ВидРабот = ""Платный""
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПлатная
	|ПОМЕСТИТЬ ВТ_КоличествоЗаявокПоВидамГарантии
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|ГДЕ
	|	ВТ_Заявки.ДатаОкончанияРабот >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|	И ВТ_Заявки.ДатаОкончанияРабот <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&БонусныйФонд / ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоОбщее * ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоГарантия КАК БонусныйФондГарантия,
	|	&БонусныйФонд - &БонусныйФонд / ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоОбщее * ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоГарантия КАК БонусныйФондПлатная
	|ПОМЕСТИТЬ ВТ_БонусныйФондРаспределенный
	|ИЗ
	|	ВТ_КоличествоЗаявокПоВидамГарантии КАК ВТ_КоличествоЗаявокПоВидамГарантии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВыручкаПоПодразделениям.Подразделение КАК Подразделение,
	|	ВТ_ВыручкаПоПодразделениям.Выручка / &ВыручкаОбщая * ВТ_БонусныйФондРаспределенный.БонусныйФондПлатная КАК Выручка
	|ПОМЕСТИТЬ ВТ_СуммыПоПодразделениям
	|ИЗ
	|	ВТ_ВыручкаПоПодразделениям КАК ВТ_ВыручкаПоПодразделениям,
	|	ВТ_БонусныйФондРаспределенный КАК ВТ_БонусныйФондРаспределенный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.Представительство КАК Представительство,
	|	МАКСИМУМ(ЕСТЬNULL(ВТ_СуммыПоПодразделениям.Выручка, 0)) / КОЛИЧЕСТВО(ВТ_Заявки.Ссылка) КАК Цена
	|ПОМЕСТИТЬ ВТ_СтоимостьПлатнойЗаявкиПредставительства
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СуммыПоПодразделениям КА0К ВТ_СуммыПоПодразделениям
	|		ПО ВТ_Заявки.Представительство = ВТ_СуммыПоПодразделениям.Подразделение
	|ГДЕ
	|	ВТ_Заявки.ДатаОкончанияРабот >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|	И ВТ_Заявки.ДатаОкончанияРабот <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|	И ВТ_Заявки.Представительство <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|	И ВТ_Заявки.ВидРабот = ""Платный""
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заявки.Представительство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Заявки.Инженер КАК Инженер,
	|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_Заявки.Инженер.Подразделение) КАК Подразделение,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.ВидРабот = ""Гарантия""
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Гарантия,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_Заявки.ВидРабот = ""Платный""
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Платная
	|ПОМЕСТИТЬ ВТ_ИнженерыСКоличествомЗаявок
	|ИЗ
	|	ВТ_Заявки КАК ВТ_Заявки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартASP_ЗаменыПодразделений КАК смартASP_ЗаменыПодразделений
	|		ПО ВТ_Заявки.Инженер.Подразделение = смартASP_ЗаменыПодразделений.ПодразделениеДляЗамены
	|ГДЕ
	|	ВТ_Заявки.ДатаОкончанияРабот >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|	И ВТ_Заявки.ДатаОкончанияРабот <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Заявки.Инженер,
	|	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_Заявки.Инженер.Подразделение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИнженерыСКоличествомЗаявок.Инженер КАК Инженер,
	|	ВТ_ИнженерыСКоличествомЗаявок.Подразделение КАК Представительство,
	|	ВТ_ИнженерыСКоличествомЗаявок.Гарантия КАК КоличествоГарантийныхРабот,
	|	ВТ_ИнженерыСКоличествомЗаявок.Платная КАК КоличествоПлатныхРабот,
	|	ВТ_ИнженерыСКоличествомЗаявок.Платная * ЕСТЬNULL(ВТ_СтоимостьПлатнойЗаявкиПредставительства.Цена, 0) КАК СуммаЗаПлатныеРаботы,
	|	ВТ_ИнженерыСКоличествомЗаявок.Гарантия * (&БонусныйФонд / ЕСТЬNULL(ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоОбщее, 0)) КАК СуммаЗаГарантийныеРаботы,
	|	ВТ_ИнженерыСКоличествомЗаявок.Гарантия * (&БонусныйФонд / ЕСТЬNULL(ВТ_КоличествоЗаявокПоВидамГарантии.КоличествоОбщее, 0)) + ВТ_ИнженерыСКоличествомЗаявок.Платная * ЕСТЬNULL(ВТ_СтоимостьПлатнойЗаявкиПредставительства.Цена, 0) КАК СуммаКВыплате
	|ИЗ
	|	ВТ_ИнженерыСКоличествомЗаявок КАК ВТ_ИнженерыСКоличествомЗаявок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтоимостьПлатнойЗаявкиПредставительства КАК ВТ_СтоимостьПлатнойЗаявкиПредставительства
	|		ПО ВТ_ИнженерыСКоличествомЗаявок.Подразделение = ВТ_СтоимостьПлатнойЗаявкиПредставительства.Представительство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЗаявокПоВидамГарантии КАК ВТ_КоличествоЗаявокПоВидамГарантии
	|		ПО (ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ИнженерыСКоличествомЗаявок.Инженер.Наименование";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
