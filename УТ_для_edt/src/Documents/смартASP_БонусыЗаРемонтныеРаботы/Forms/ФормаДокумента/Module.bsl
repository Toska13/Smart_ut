#Область ОбработчикиСобытийЭлементовТаблицыФормыНачислениеБонусов
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура НачислениеБонусовКоличествоГарантийныхРаботПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НачислениеБонусов.ТекущиеДанные;
	
	Если ТекущиеДанные.КоличествоГарантийныхРаботСохр = 0 Тогда
		ТекущиеДанные.СуммаЗаГарантийныеРаботы = ТекущиеДанные.КоличествоГарантийныхРабот * ТекущиеДанные.СуммаЗаГарантийныеРаботы;
	Иначе
		ТекущиеДанные.СуммаЗаГарантийныеРаботы = ТекущиеДанные.КоличествоГарантийныхРабот * (ТекущиеДанные.СуммаЗаГарантийныеРаботы / ТекущиеДанные.КоличествоГарантийныхРаботСохр);
	КонецЕсли;
	
	ТекущиеДанные.СуммаКВыплате = ТекущиеДанные.СуммаЗаГарантийныеРаботы + ТекущиеДанные.СуммаЗаПлатныеРаботы;
	ТекущиеДанные.КоличествоГарантийныхРаботСохр = ТекущиеДанные.КоличествоГарантийныхРабот;
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура НачислениеБонусовКоличествоПлатныхРаботПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НачислениеБонусов.ТекущиеДанные;
	
	Если ТекущиеДанные.КоличествоПлатныхРаботСохр = 0 Тогда
		ТекущиеДанные.СуммаЗаПлатныеРаботы = ТекущиеДанные.КоличествоПлатныхРабот * ТекущиеДанные.СуммаЗаПлатныеРаботы;
	Иначе
		ТекущиеДанные.СуммаЗаПлатныеРаботы = ТекущиеДанные.КоличествоПлатныхРабот * (ТекущиеДанные.СуммаЗаПлатныеРаботы / ТекущиеДанные.КоличествоПлатныхРаботСохр);
	КонецЕсли;
	
	ТекущиеДанные.СуммаЗаПлатныеРаботы = ТекущиеДанные.КоличествоПлатныхРабот * (ТекущиеДанные.СуммаЗаПлатныеРаботы / ТекущиеДанные.КоличествоПлатныхРаботСохр);
	ТекущиеДанные.СуммаКВыплате = ТекущиеДанные.СуммаЗаГарантийныеРаботы + ТекущиеДанные.СуммаЗаПлатныеРаботы;
	ТекущиеДанные.КоличествоПлатныхРаботСохр = ТекущиеДанные.КоличествоПлатныхРабот;
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Для Каждого Стр Из Объект.НачислениеБонусов Цикл
		Стр.КоличествоГарантийныхРаботСохр = Стр.КоличествоГарантийныхРабот;
		Стр.КоличествоПлатныхРаботСохр = Стр.КоличествоПлатныхРабот;
	КонецЦикла;
	
