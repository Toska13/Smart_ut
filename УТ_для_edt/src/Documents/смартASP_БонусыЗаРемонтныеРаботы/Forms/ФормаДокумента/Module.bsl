	РезультатЗапросаТЗ.Колонки.Добавить("КоличествоГарантийныхРаботСохр");
	РезультатЗапросаТЗ.Колонки.Добавить("КоличествоПлатныхРаботСохр");
	
	
	//РезультатЗапросаТЗ.ЗагрузитьКолонку(ОписаниеНачисления, "ОписаниеНачисленияБонуса");
	РезультатЗапросаТЗ.ЗагрузитьКолонку(РезультатЗапросаТЗ.ВыгрузитьКолонку("КоличествоГарантийныхРабот"), "КоличествоГарантийныхРаботСохр");
