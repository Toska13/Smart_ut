	//	Если НЕ ЗначениеЗаполнено(Стр.Инженер) Тогда
	//		НачислениеБонусовТЗ.Удалить(Стр);
	//	КонецЕсли;
	//КонецЦикла;
	//
	//ОписаниеНачисления = НачислениеБонусовТЗ.ВыгрузитьКолонку("ОписаниеНачисленияБонуса");
	//
	//КоличествоСтрокТЧ = НачислениеБонусовТЗ.Количество();
	//НачислениеБонусовТЗ.Свернуть("Инженер");
	//КоличествоСтрокТЧСверка = НачислениеБонусовТЗ.Количество();
	//
	//Если КоличествоСтрокТЧ <> КоличествоСтрокТЧСверка Тогда
	//	Сообщить("Имеются строки с одинаковым полем ""Инженер""!");
	//	Возврат;
	//КонецЕсли;
	//
	//Инженеры = НачислениеБонусовТЗ.ВыгрузитьКолонку("Инженер");
	
	СтруктураДанныхПоОбороту = смартASP_ОбщийМодуль.ASP_ПолучитьДанныеОборотаПоРемонтнымРаботам(Объект.Дата,, Объект.СреднийКурсВалюты);
	Если Не СтруктураДанныхПоОбороту=Неопределено Тогда
		Если СтруктураДанныхПоОбороту.Выручка = Null  Тогда
			Сообщить("Нет данных по обороту!");
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ASP_БонусныйФондСрезПоследних.Коэффициент КАК Коэффициент
		|ИЗ
		|	РегистрСведений.смартASP_БонусныйФонд.СрезПоследних(&Дат, ) КАК ASP_БонусныйФондСрезПоследних
		|ГДЕ
		|	ASP_БонусныйФондСрезПоследних.Категория = &Категория";
	
