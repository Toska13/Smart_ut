	               |ГДЕ
	               |	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	               |	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |	И смартЗаявкаНаРемонтныеРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтЗавершен)
	               |	И (смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	               |				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	               |			ИЛИ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	               |				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ))
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	смартЗаявкаНаРемонтныеРаботы.Ссылка,
	               |	смартЗаявкаНаРемонтныеРаботы.ВидГарантии,
	               |	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2,
	               |	ВЫБОР
	               |		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 = ДАТАВРЕМЯ(1, 1, 1)
	               |			ТОГДА смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2
	               |		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА смартЗаявкаНаРемонтныеРаботы.Представительство = &ПустоеПодразделение
	               |			ТОГДА &ГоловнойОфисМосква
	               |		ИНАЧЕ смартЗаявкаНаРемонтныеРаботы.Представительство
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |				И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |			ТОГДА 0.5
	               |		ИНАЧЕ 1
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	               |ГДЕ
	               |	НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	               |	И смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	               |	И смартЗаявкаНаРемонтныеРаботы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.РемонтЗавершен)
	               |	И (смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	               |				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	               |			ИЛИ смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	               |				И смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ))
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Заявки.Ссылка КАК Ссылка,
	               |	ВТ_Заявки.ВидРабот КАК ВидРабот,
	               |	ВТ_Заявки.Инженер КАК Инженер,
	               |	ВТ_Заявки.ДатаОкончанияРабот КАК ДатаОкончанияРабот,
	               |	ЕСТЬNULL(смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение, ВТ_Заявки.Представительство) КАК Представительство,
	               |	ВТ_Заявки.Кол КАК Кол
	               |ИЗ
	               |	ВТ_Заявки_вр КАК ВТ_Заявки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартASP_ЗаменыПодразделений КАК смартASP_ЗаменыПодразделений
	               |		ПО ВТ_Заявки.Представительство = смартASP_ЗаменыПодразделений.ЗаменяющееПодразделение
	               |ГДЕ
	               |	ВТ_Заявки.ДатаОкончанияРабот >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	               |	И ВТ_Заявки.ДатаОкончанияРабот <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)";
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ПустоеПодразделение", Справочники.СтруктураПредприятия.ПустаяСсылка());
	Запрос.УстановитьПараметр("ГоловнойОфисМосква", Константы.смартASP_ПодразделениеДляЗаменыПустогоВЗаявках.Получить());
	
	тзЗаявок = Запрос.Выполнить().Выгрузить(); 
	//++ #1331 смарт: Фролов 24.03.2023 //Добавить в расчет бонусов бесплатные услуги
	Для Каждого Стр Из тзЗаявокБесплатные Цикл
		СтрокитзЗаявок=тзЗаявок.НайтиСтроки(Новый Структура("Ссылка",Стр.Ссылка));	
		Если СтрокитзЗаявок.Количество()=0 Тогда
			СтртзЗаявок=тзЗаявок.Добавить();		
			СтртзЗаявок.ссылка=Стр.Ссылка;
			СтртзЗаявок.ВидРабот=Перечисления.смартВидыГарантии.Платная;
			СтртзЗаявок.Инженер=Стр.Инженер;
			СтртзЗаявок.ДатаОкончанияРабот=Стр.ДатаОкончанияРабот;
			СтртзЗаявок.Представительство=Стр.Представительство;
			СтртзЗаявок.Кол=Стр.Кол;
		КонецЕсли;	
	КонецЦикла;	
	//-- #1331 смарт: Фролов 24.03.2023	
	тзЗаявок.Индексы.Добавить("ВидРабот, Представительство");
	
	ОбщееКоличествоЗаявок = тзЗаявок.Итог("Кол");
	
	
	////////////////////////////////
	//ОбщийФонд / ОбщееКоличествоЗаявок = Бонус за 1 гарантийную заявку (БонусГарантийнаяЗаявка). Гарантийная заявка для всех представительств стоит одинаково. 
	
	БонусГарантийнаяЗаявка = ОбщийФонд / ОбщееКоличествоЗаявок;
	
	
    ////////////////////////////////
	//БонусГарантийнаяЗаявка * Общее количество гарантийных заявок = ОбщийФондГарантийныеЗаявки
	
	Отбор = Новый Структура("ВидРабот", Перечисления.смартВидыГарантии.Гарантия);
	тзГарантийныхЗаявок = тзЗаявок.Скопировать(Отбор);
	
	КоличествоГарантийныхЗаявок = тзГарантийныхЗаявок.Итог("Кол");
	ОбщийФондГарантийныеЗаявки = БонусГарантийнаяЗаявка * КоличествоГарантийныхЗаявок; 

	
	////////////////////////////////
	//ОбщийФонд - ОбщийФондГарантийныеЗаявки = ОбщийФондПлатныеЗаявки
	
	ОбщийФондПлатныеЗаявки = ОбщийФонд - ОбщийФондГарантийныеЗаявки;
	
	
	////////////////////////////////
	//Оборот СЦ по платным услугам (ОборотПлатныеУслуги) = ОборотПлатныеУслугиПредставительство1 + ОборотПлатныеУслугиПредставительство2 + ОборотПлатныеУслугиПредставительство3
	//ОбщийФондПлатныеЗаявки делится между представительствами по пропорции:
	//БонусПлатныеЗаявкиПредставительство1 = ОборотПлатныеУслугиПредставительство1 / ОборотПлатныеУслуги
	//БонусПлатныеЗаявкиПредставительство2 = ОборотПлатныеУслугиПредставительство2 / ОборотПлатныеУслуги
	//БонусПлатныеЗаявкиПредставительство3 = ОборотПлатныеУслугиПредставительство3 / ОборотПлатныеУслуги
	//БонусПлатныеЗаявкиПредставительство1 / Количество платных заявок представительства 1 = Стоимость 1 платной заявки для инженеров представительства 1. 
	//БонусПлатныеЗаявкиПредставительство2 / Количество платных заявок представительства 2 = Стоимость 1 платной заявки для инженеров представительства 2.
	//БонусПлатныеЗаявкиПредставительство3 / Количество платных заявок представительства 3 = Стоимость 1 платной заявки для инженеров представительства 3.
	
	СтруктураДанныхПоОборотуПлатные = смартASP_ОбщийМодуль.ASP_ПолучитьДанныеОборотаПоРемонтнымРаботам(Объект.Дата,, Объект.СреднийКурсВалюты, ИСТИНА);
	
	тзВыручкаПоПодразделениям = СтруктураДанныхПоОборотуПлатные.ВыручкаПоПодразделениямТЗ;
	//++ #1331 смарт: Фролов 24.03.2023 //Добавить в расчет бонусов бесплатные услуги
	//тзВыручкаПоПодразделениям.Колонки.Добавить("Доля");
	//тзВыручкаПоПодразделениям.Колонки.Добавить("Бонус");
	//тзВыручкаПоПодразделениям.Колонки.Добавить("СтоимостьОднойПлатнойЗаявки"); 
	тзВыручкаПоПодразделениям.Колонки.Добавить("Доля",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	тзВыручкаПоПодразделениям.Колонки.Добавить("Бонус",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	тзВыручкаПоПодразделениям.Колонки.Добавить("СтоимостьОднойПлатнойЗаявки",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	тзВыручкаПоПодразделениям.Колонки.Добавить("ДоляБесплатные",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));  
	тзВыручкаПоПодразделениям.Колонки.Добавить("ВыручкаБесплатные",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой))); 
	тзВыручкаПоПодразделениям.Колонки.Добавить("БонусБесплатные",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	Для Каждого СтрБесплатные Из РезБесплатные Цикл
		СтрокитзВыручкаПоПодразделениям=тзВыручкаПоПодразделениям.НайтиСтроки(Новый Структура("Подразделение",СтрБесплатные.Подразделение));			
		Если СтрокитзВыручкаПоПодразделениям.Количество()=0 Тогда
			СтртзВыручкаПоПодразделениям=тзВыручкаПоПодразделениям.Добавить();		
			СтртзВыручкаПоПодразделениям.Подразделение=СтрБесплатные.Подразделение; 
			СтртзВыручкаПоПодразделениям.ВыручкаБесплатные=СтрБесплатные.Сумма; 
			СтртзВыручкаПоПодразделениям.Выручка=0;
		Иначе
			СтрокитзВыручкаПоПодразделениям[0].ВыручкаБесплатные=СтрБесплатные.Сумма;
		КонецЕсли;	
	КонецЦикла;
	//-- #1331 смарт: Фролов 24.03.2023
		
	Для Каждого стр Из тзВыручкаПоПодразделениям Цикл
		стр.Доля = стр.Выручка / СтруктураДанныхПоОборотуПлатные.Выручка;
		стр.Бонус = ОбщийФондПлатныеЗаявки * стр.Доля;
		
		//++ #1331 смарт: Фролов 24.03.2023 //Добавить в расчет бонусов бесплатные услуги 
		Если ИтогоБесплатные>0 Тогда
			стр.ДоляБесплатные = стр.ВыручкаБесплатные / ИтогоБесплатные;
			стр.БонусБесплатные = ОбщийФондБесплатныеЗаявки * стр.ДоляБесплатные;
		Иначе
			стр.ДоляБесплатные =0;
			стр.БонусБесплатные=0;
		КонецЕсли;
		
		стр.Бонус=стр.Бонус+стр.БонусБесплатные;
		//-- #1331 смарт: Фролов 24.03.2023
		
		Отбор = Новый Структура("ВидРабот, Представительство", Перечисления.смартВидыГарантии.Платная, стр.Подразделение);
		КолПлатЗаявокПодр = тзЗаявок.Скопировать(Отбор).Итог("Кол");
		
		Если КолПлатЗаявокПодр = 0 Тогда
			стр.СтоимостьОднойПлатнойЗаявки = 0
		Иначе
			стр.СтоимостьОднойПлатнойЗаявки = стр.Бонус / КолПлатЗаявокПодр
		КонецЕсли;
		
	КонецЦикла;
	тзВыручкаПоПодразделениям.Индексы.Добавить("Подразделение");
    
	////////////////////////////////
	//Итог:
	//БонусИнженерПредставительство1 = количество гарантийных заявок этого инженера * БонусГарантийнаяЗаявка + количество платных заявок этого инженера * Стоимость 1 платной заявки инженеров представительства 1.
	//БонусИнженерПредставительство2 = количество гарантийных заявок этого инженера * БонусГарантийнаяЗаявка + количество платных заявок этого инженера * Стоимость 1 платной заявки инженеров представительства 2.
	//БонусИнженерПредставительство3 = количество гарантийных заявок этого инженера * БонусГарантийнаяЗаявка + количество платных заявок этого инженера * Стоимость 1 платной заявки инженеров представительства 3.
	
	тзИнженеры = тзЗаявок.Скопировать(, "ВидРабот, Представительство, Инженер, Кол");
	тзИнженеры.Свернуть("ВидРабот, Представительство, Инженер", "Кол");
	тзИнженеры.Сортировать("Инженер");
	
	Отбор = Новый Структура("Инженер, Представительство");
	ОтборПодр = Новый Структура("Подразделение");
	
	Для Каждого стр Из тзИнженеры Цикл
		
		Отбор.Инженер = стр.Инженер;
		Отбор.Представительство = стр.Представительство;
		МасСтрок = Объект.НачислениеБонусов.НайтиСтроки(Отбор);
		
		Если МасСтрок.Количество() = 0 Тогда
			нов = Объект.НачислениеБонусов.Добавить();
			нов.Инженер = стр.Инженер;
			нов.Представительство = стр.Представительство;
		Иначе
			нов = МасСтрок[0]
		КонецЕсли;
		
		Если стр.ВидРабот = Перечисления.смартВидыГарантии.Гарантия Тогда
			нов.КоличествоГарантийныхРабот = стр.Кол;
			нов.СуммаЗаГарантийныеРаботы = нов.КоличествоГарантийныхРабот * БонусГарантийнаяЗаявка
		Иначе
			нов.КоличествоПлатныхРабот = стр.Кол;
			
			стрТЗ = тзВыручкаПоПодразделениям.Найти(стр.Представительство, "Подразделение");
			Если стрТЗ <> Неопределено Тогда			
				нов.СуммаЗаПлатныеРаботы = нов.КоличествоПлатныхРабот  * стрТЗ.СтоимостьОднойПлатнойЗаявки
			КонецЕсли;
		КонецЕсли;
		
		нов.СуммаКВыплате = нов.СуммаЗаГарантийныеРаботы + нов.СуммаЗаПлатныеРаботы;
	КонецЦикла;
	
	/////////////////////////////////////////////////////
	Объект.СуммаОборота=СтруктураДанныхПоОбороту.Выручка;
	
	//++#1288 смарт: Лопато 29.12.2022 //Дополннение в блоке расчета бонусов инженеров
	Сообщить("Таблица перезаполнена!");
	Модифицированность = Истина
	//--#1288 смарт: Лопато 29.12.2022
	
КонецПроцедуры

