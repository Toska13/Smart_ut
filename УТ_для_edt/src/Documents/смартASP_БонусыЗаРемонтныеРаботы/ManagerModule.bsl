//доработка внешней компании Асиситпро по проекту Бонусы инженеров
Процедура Печать(ТабДок, Ссылка) Экспорт
	//{{_КОНСТРУКТОР_ПЕЧАТИ(Печать)
	Макет = Документы.смартASP_БонусыЗаРемонтныеРаботы.ПолучитьМакет("Печать");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартASP_БонусыЗаРемонтныеРаботы.Дата КАК Дата,
	|	смартASP_БонусыЗаРемонтныеРаботы.Номер КАК Номер,
	|	смартASP_БонусыЗаРемонтныеРаботы.СуммаОборота КАК СуммаОборота,
	|	смартASP_БонусыЗаРемонтныеРаботы.НачислениеБонусов.(
	|		Представительство КАК Представительство,
	|		СУММА(КоличествоГарантийныхРабот) КАК КоличествоГарантийныхРабот,
	|		СУММА(КоличествоПлатныхРабот) КАК КоличествоПлатныхРабот,
	|		СУММА(СуммаЗаГарантийныеРаботы) КАК СуммаЗаГарантийныеРаботы,
	|		СУММА(СуммаЗаПлатныеРаботы) КАК СуммаЗаПлатныеРаботы,
	|		СУММА(СуммаКВыплате) КАК СуммаКВыплате
	|	) КАК НачислениеБонусов
	|ИЗ
	|	Документ.смартASP_БонусыЗаРемонтныеРаботы КАК смартASP_БонусыЗаРемонтныеРаботы
	|ГДЕ
	|	смартASP_БонусыЗаРемонтныеРаботы.Ссылка В(&Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	смартASP_БонусыЗаРемонтныеРаботы.НачислениеБонусов.(Представительство)";
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьНачислениеБонусовШапка = Макет.ПолучитьОбласть("НачислениеБонусовШапка");
	ОбластьНачислениеБонусов = Макет.ПолучитьОбласть("НачислениеБонусов");
	ОбластьНачисленияБонусовИтоги=Макет.ПолучитьОбласть("НачислениеИтоги");
	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;

		ТабДок.Вывести(ОбластьЗаголовок);

		Шапка.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(Шапка, Выборка.Уровень());

		ТабДок.Вывести(ОбластьНачислениеБонусовШапка);
		ВыборкаНачислениеБонусов = Выборка.НачислениеБонусов.Выбрать();
		Пока ВыборкаНачислениеБонусов.Следующий() Цикл
			ОбластьНачислениеБонусов.Параметры.Заполнить(ВыборкаНачислениеБонусов);
			ТабДок.Вывести(ОбластьНачислениеБонусов, ВыборкаНачислениеБонусов.Уровень());
		КонецЦикла; 
		//ТЗРЕз=Запрос.Выполнить().Выгрузить();
		//ОбластьНачисленияБонусовИтоги.Параметры.Заполнить(ТЗРез);
		//ТабДок.Вывести(ОбластьНачисленияБонусовИтоги);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;
	//}}
КонецПроцедуры

