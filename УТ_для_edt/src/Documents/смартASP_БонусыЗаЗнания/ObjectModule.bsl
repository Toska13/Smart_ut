Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.смартASP_НакоплениеБонусов.Очистить();
	Движения.смартASP_НакоплениеБонусов.Записывать = Истина;

	//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  
	Если смартСтатусРасчетаБонусов <> Перечисления.смартСтатусыДокументовРасчетаБонусов.РасчетЗавершен Тогда
		Возврат;
	КонецЕсли;	
	//--#1288 смарт: Лопато 26.12.2022
	
	Для Каждого ТекСтрокаБонусыЗнаний Из БонусыЗнаний Цикл
		Если ТекСтрокаБонусыЗнаний.Бонус <> 0 Тогда
			Движение = Движения.смартASP_НакоплениеБонусов.Добавить();
			Движение.Период = Дата;
			Движение.ТипБонуса = Перечисления.смартASP_ТипыБонусов.Знания;
			Движение.Инженер = ТекСтрокаБонусыЗнаний.Инженер;
			Движение.Сумма = ТекСтрокаБонусыЗнаний.Бонус;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

