
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ЗаполнитьНаСервере()
	Объект.БонусыЗнаний.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	смартASP_ТаблицаЗнаний.Инженер КАК Инженер,
		|	смартASP_ТаблицаЗнаний.Категория КАК Категория,
		|	смартASP_ТаблицаЗнаний.Балл КАК Балл,
		|	ЕСТЬNULL(смартASP_Категории.Коэффициент, 0) КАК Коэф,
		|	смартASP_ТаблицаЗнаний.Балл * ЕСТЬNULL(смартASP_Категории.Коэффициент, 0) КАК Сумма
		|ПОМЕСТИТЬ вр
		|ИЗ
		|	(ВЫБРАТЬ
		|		ASP_ТаблицаЗнанийСрезПоследних.Инженер КАК Инженер,
		|		ASP_ТаблицаЗнанийСрезПоследних.Категория КАК Категория,
		|		ASP_ТаблицаЗнанийСрезПоследних.Балл КАК Балл
		|	ИЗ
		|		РегистрСведений.смартASP_ТаблицаЗнаний.СрезПоследних(&Период, ) КАК ASP_ТаблицаЗнанийСрезПоследних) КАК смартASP_ТаблицаЗнаний
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартASP_Категории КАК смартASP_Категории
		|		ПО смартASP_ТаблицаЗнаний.Категория = смартASP_Категории.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	вр.Инженер КАК Инженер,
		|	СУММА(вр.Сумма) КАК Бонус
		|ИЗ
		|	вр КАК вр
		|
		|СГРУППИРОВАТЬ ПО
		|	вр.Инженер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Инженер";
	
	Запрос.УстановитьПараметр("Период", КонецМесяца(Объект.Дата));
	
	тз = Запрос.Выполнить().Выгрузить();
	
	К = Константы.смартASP_КоэффициентДляРасчетаБонусовЗаЗнания.Получить();
	Если К = 0 Тогда
		К = 1
	КонецЕсли;
	
	Для Каждого стр Из тз Цикл
		стр.Бонус = стр.Бонус * К;
		ЗаполнитьЗначенияСвойств(Объект.БонусыЗнаний.Добавить(), стр)
	КонецЦикла;

	//++#1288 смарт: Лопато 29.12.2022 //Дополннение в блоке расчета бонусов инженеров
	Модифицированность = Истина;
	//--#1288 смарт: Лопато 29.12.2022
	
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

