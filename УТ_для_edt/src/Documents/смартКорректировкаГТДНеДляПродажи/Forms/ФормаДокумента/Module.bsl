&НаСервере
Процедура ЗаполнитьОстаткамиНаСервере(Перезаполнять=Истина)
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура КАК Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДКВозмещению КАК НомерГТДКВозмещению,
	                    |	СУММА(смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.КоличествоОстаток) КАК КоличествоДляЗамены
	                    |ИЗ
	                    |	РегистрНакопления.смартКонтрольИспользованияЗапЧастейНеДляПродажи.Остатки(
	                    |			,
	                    |			КВозмещению
	                    |				И НЕ НеКомпенсировать) КАК смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДКВозмещению
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	ЗаявкаНаГарантийныйРемонт,
	                    |	Номенклатура");
	ЗапросПриходы=Новый Запрос("ВЫБРАТЬ
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура КАК Номенклатура,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДПриход КАК НомерГТДПриход,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия КАК Партия,
	                           |	СУММА(смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.КоличествоОстаток) КАК КоличествоПоступившее
	                           |ИЗ
	                           |	РегистрНакопления.смартКонтрольИспользованияЗапЧастейНеДляПродажи.Остатки(, НЕ КВозмещению) КАК смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки
	                           |
	                           |СГРУППИРОВАТЬ ПО
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДПриход,
	                           |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия"); 
	ЗапросОстаткиОрганизаций=Новый Запрос("ВЫБРАТЬ
	                                      |	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	                                      |	ТоварыОрганизацийОстатки.Организация КАК Организация,
	                                      |	ТоварыОрганизацийОстатки.ВидЗапасов КАК ВидЗапасов,
	                                      |	ТоварыОрганизацийОстатки.НомерГТД КАК НомерГТД,
	                                      |	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	                                      |	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Количество
	                                      |ИЗ
	                                      |	РегистрНакопления.ТоварыОрганизаций.Остатки(, ) КАК ТоварыОрганизацийОстатки"); 
	
	Рез=Запрос.Выполнить().Выгрузить();	
	РезОстаткиОрганизаций=ЗапросОстаткиОрганизаций.Выполнить().Выгрузить();
	РезПриходы=ЗапросПриходы.Выполнить().Выгрузить(); 
	ТабПриходы.Загрузить(РезПриходы);
	Если Перезаполнять Тогда
		Объект.Состав.Очистить();
		Для Каждого Стр Из Рез Цикл
			СтрокиРезПриходы=РезПриходы.НайтиСтроки(Новый Структура("ЗаявкаНаГарантийныйРемонт,Номенклатура",Стр.ЗаявкаНаГарантийныйРемонт,Стр.Номенклатура)); 
			Если СтрокиРезПриходы.Количество()>0 Тогда
				Нашли=Ложь;
				Для Каждого СтрРезПриходы ИЗ СтрокиРезПриходы Цикл
					СтрокиРезОстаткиОрганизаций=РезОстаткиОрганизаций.НайтиСтроки(Новый Структура("НомерГТД,Номенклатура",СтрРезПриходы.НомерГТДПриход,Стр.Номенклатура));
					Если СтрокиРезОстаткиОрганизаций.Количество()>0 ТОгда
						Нашли=Истина;
						Прервать;
					КонецЕсли;                                        
				КонецЦикла;
				Если Нашли Тогда
					СтрСостав=Объект.Состав.Добавить();
					СтрСостав.ЗаявкаНаГарантийныйРемонт=Стр.ЗаявкаНаГарантийныйРемонт;
					СтрСостав.Номенклатура=Стр.Номенклатура;
					СтрСостав.НомерГТДКВозмещению=Стр.НомерГТДКВозмещению;  
					СтрСостав.КоличествоДляЗамены=Стр.КоличествоДляЗамены; 
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстатками(Команда)
	ЗаполнитьОстаткамиНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоставПриАктивизацииСтрокиНаСервере(СтруктураДляСтроки)
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	                    |	ТоварыОрганизацийОстатки.Организация КАК Организация,
	                    |	ТоварыОрганизацийОстатки.ВидЗапасов КАК ВидЗапасов,
	                    |	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Количество
	                    |ИЗ
	                    |	РегистрНакопления.ТоварыОрганизаций.Остатки(
	                    |			,
	                    |			АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	                    |				И НомерГТД = &НомерГТД) КАК ТоварыОрганизацийОстатки");
	Запрос.УстановитьПараметр("Номенклатура",СтруктураДляСтроки.Номенклатура);  
	Запрос.УстановитьПараметр("НомерГТД",СтруктураДляСтроки.НомерГТД);  
	Рез=Запрос.Выполнить().Выгрузить();
	Для Каждого Стр Из Рез Цикл
		СтрТаблицаВыбора=ТаблицаВыбора.Добавить();		
		СтрТаблицаВыбора.АналитикаУчетаНоменклатуры=Стр.АналитикаУчетаНоменклатуры;
		СтрТаблицаВыбора.Организация=Стр.Организация;
		СтрТаблицаВыбора.ВидЗапасов=Стр.ВидЗапасов;
		СтрТаблицаВыбора.НомерГТД=СтруктураДляСтроки.НомерГТД;   
		СтрТаблицаВыбора.Партия=СтруктураДляСтроки.Партия;
		СтрТаблицаВыбора.ЗаявкаНаГарантийныйРемонт=СтруктураДляСтроки.ЗаявкаНаГарантийныйРемонт;
		СтрТаблицаВыбора.Номенклатура=СтруктураДляСтроки.Номенклатура;
		СтрТаблицаВыбора.КоличествоПоступившее=?(Стр.Количество>СтруктураДляСтроки.КоличествоПоступившее,СтруктураДляСтроки.КоличествоПоступившее,Стр.Количество);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура СоставПриАктивизацииСтроки(Элемент)
	ТаблицаВыбора.Очистить();
	ТекДанные=Элемент.ТекущиеДанные;
	Если ТекДанные=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	СтрокиТабПриходы=ТабПриходы.НайтиСтроки(Новый Структура("ЗаявкаНаГарантийныйРемонт,Номенклатура",ТекДанные.ЗаявкаНаГарантийныйРемонт,ТекДанные.Номенклатура));
	Для Каждого СтрТабПриходы ИЗ СтрокиТабПриходы Цикл
		//Если ЗначениеЗаполнено(СтрТабПриходы.НомерГТДПриход) Тогда
			СтруктураДляСтроки=Новый Структура("ЗаявкаНаГарантийныйРемонт,Номенклатура,НомерГТД,Партия,КоличествоПоступившее",СтрТабПриходы.ЗаявкаНаГарантийныйРемонт,СтрТабПриходы.Номенклатура,СтрТабПриходы.НомерГТДПриход,СтрТабПриходы.Партия,СтрТабПриходы.КоличествоПоступившее);
			СоставПриАктивизацииСтрокиНаСервере(СтруктураДляСтроки);            
		//КонецЕсли;
	КонецЦикла;
КонецПроцедуры

