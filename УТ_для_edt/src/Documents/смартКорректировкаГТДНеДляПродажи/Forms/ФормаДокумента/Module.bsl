			СтрСостав.ЗаявкаНаГарантийныйРемонт=Стр.ЗаявкаНаГарантийныйРемонт;
			СтрСостав.Номенклатура=Стр.Номенклатура;
			СтрСостав.НомерГТДКВозмещению=Стр.НомерГТДКВозмещению;  
			СтрСостав.КоличествоДляЗамены=Стр.КоличествоДляЗамены;
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОстаткамиКВозмещению(Команда)
	ЗаполнитьОстаткамиКВозмещениюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанныеИсх=Элемент.ТекущиеДанные;
	ТекДанныеКон=Элементы.Состав.ТекущиеДанные;
	ТекДанныеКон.ВидЗапасов=ТекДанныеИсх.ВидЗапасов;
	ТекДанныеКон.АналитикаУчетаНоменклатуры=ТекДанныеИсх.АналитикаУчетаНоменклатуры;
	ТекДанныеКон.НомерГТДПриход=ТекДанныеИсх.НомерГТД;
	ТекДанныеКон.Партия=ТекДанныеИсх.Партия; 
	ТекДанныеКон.Организация=ТекДанныеИсх.Организация;
	ТекДанныеКон.КоличествоПоступившее=?(ТекДанныеКон.КоличествоДляЗамены<ТекДанныеИсх.КоличествоПоступившее,ТекДанныеКон.КоличествоДляЗамены,ТекДанныеИсх.КоличествоПоступившее);
	//ТекДанныеКон.КоличествоДляЗамены=?(ТекДанныеКон.КоличествоДляЗамены>ТекДанныеИсх.КоличествоПоступившее,ТекДанныеИсх.КоличествоПоступившее,ТекДанныеКон.КоличествоДляЗамены);
	ТекДанныеКон.Пометка=Истина;
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаРегистровНажатие(Элемент, СтандартнаяОбработка)
	Если Не Объект.Ссылка.Пустая() Тогда
		Если ТипЗнч(ЭтаФорма.КорректировкаРегистров)=Тип("ДокументСсылка.КорректировкаРегистров") Тогда
			СтандартнаяОбработка=Ложь;
			ПоказатьЗначение(,ЭтаФорма.КорректировкаРегистров);
		КонецЕсли; 
	Иначе	
		Сообщить("Необходимо записать документ!");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Запрос=Новый Запрос("ВЫБРАТЬ
		|	КорректировкаРегистров.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
		|ГДЕ
		|	КорректировкаРегистров.смартКорректировкаГТДНеДляПродажи = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка",ТекущийОбъект.Ссылка); 
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЭтаФорма.КорректировкаРегистров=Выборка.Ссылка; 
		Элементы.КорректировкаРегистров.Видимость=Истина; 
	Иначе
		Элементы.КорректировкаРегистров.Видимость=Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДляПервоначальнойЧисткиНаСервере()
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт.Организация КАК Организация,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура КАК Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДКВозмещению КАК НомерГТДКВозмещению,
	                    |	СУММА(смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.КоличествоОстаток) КАК Количество
	                    |ПОМЕСТИТЬ КВозмещению
	                    |ИЗ
	                    |	РегистрНакопления.смартКонтрольИспользованияЗапЧастейНеДляПродажи.Остатки(, КВозмещению) КАК смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДКВозмещению,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт.Организация
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия.Организация КАК Организация,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт.Организация КАК ОрганизацияКВозмещению,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура КАК Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия КАК Партия,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДПриход КАК НомерГТДПриход,
	                    |	СУММА(смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.КоличествоОстаток) КАК Количество
	                    |ПОМЕСТИТЬ Приходы
	                    |ИЗ
	                    |	РегистрНакопления.смартКонтрольИспользованияЗапЧастейНеДляПродажи.Остатки(, НЕ КВозмещению) КАК смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Номенклатура,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.НомерГТДПриход,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.Партия.Организация,
	                    |	смартКонтрольИспользованияЗапЧастейНеДляПродажиОстатки.ЗаявкаНаГарантийныйРемонт.Организация
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	СебестоимостьТоваровОстатки.Организация КАК Организация,
	                    |	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	                    |	СебестоимостьТоваровОстатки.Партия КАК Партия,
	                    |	СУММА(СебестоимостьТоваровОстатки.КоличествоОстаток) КАК КоличествоОстаток
	                    |ПОМЕСТИТЬ Себестоимость
	                    |ИЗ
	                    |	РегистрНакопления.СебестоимостьТоваров.Остатки КАК СебестоимостьТоваровОстатки
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	СебестоимостьТоваровОстатки.Организация,
	                    |	СебестоимостьТоваровОстатки.Партия,
	                    |	СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.Номенклатура
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	ИСТИНА КАК Пометка,
	                    |	Приходы.ЗаявкаНаГарантийныйРемонт.Номер КАК Номер,
	                    |	Приходы.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	                    |	Приходы.ОрганизацияКВозмещению КАК ОрганизацияКВозмещению,
	                    |	Приходы.Организация КАК Организация,
	                    |	Приходы.Номенклатура КАК Номенклатура,
	                    |	КВозмещению.НомерГТДКВозмещению КАК НомерГТДКВозмещению,
	                    |	Приходы.НомерГТДПриход КАК НомерГТДПриход,
	                    |	Приходы.Партия КАК Партия,
	                    |	СУММА(ЕСТЬNULL(КВозмещению.Количество, 0)) КАК КоличествоДляЗамены,
	                    |	СУММА(Приходы.Количество) КАК КоличествоПоступившее,
	                    |	СУММА(ЕСТЬNULL(Себестоимость.КоличествоОстаток, 0)) КАК ОстаткиСебестоимость
	                    |ИЗ
	                    |	Приходы КАК Приходы
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ Себестоимость КАК Себестоимость
	                    |		ПО Приходы.Организация = Себестоимость.Организация
	                    |			И Приходы.Номенклатура = Себестоимость.Номенклатура
	                    |			И Приходы.Партия = Себестоимость.Партия
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КВозмещению КАК КВозмещению
	                    |		ПО Приходы.ЗаявкаНаГарантийныйРемонт = КВозмещению.ЗаявкаНаГарантийныйРемонт
	                    |			И Приходы.Номенклатура = КВозмещению.Номенклатура
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	Приходы.Номенклатура,
	                    |	Приходы.НомерГТДПриход,
	                    |	Приходы.ЗаявкаНаГарантийныйРемонт,
	                    |	Приходы.Организация,
	                    |	Приходы.Партия,
	                    |	КВозмещению.НомерГТДКВозмещению,
	                    |	Приходы.ЗаявкаНаГарантийныйРемонт.Номер,
	                    |	Приходы.ОрганизацияКВозмещению
	                    |
	                    |ИМЕЮЩИЕ
	                    |	СУММА(ЕСТЬNULL(Себестоимость.КоличествоОстаток, 0)) = 0
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Номер,
	                    |	Номенклатура,
	                    |	Партия"); 
	Объект.Состав.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДляПервоначальнойЧистки(Команда)
	ЗагрузитьДляПервоначальнойЧисткиНаСервере();
КонецПроцедуры

#КонецОбласти

