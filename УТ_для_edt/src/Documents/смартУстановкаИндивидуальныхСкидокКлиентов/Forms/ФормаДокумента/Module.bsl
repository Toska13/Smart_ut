КонецПроцедуры

&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
	
	ОбщегоНазначенияУТКлиент.ПровестиИЗакрыть(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроцентСкидкиНаценки(Команда)
	
	МассивСтрок = Элементы.Скидки.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'В списке отсутствуют выделенные строки'"));
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	ПоказатьВводЧисла(Новый ОписаниеОповещения("ЗаполнитьПроцентСкидкиНаценкиЗавершение", ЭтотОбъект, Новый Структура("МассивСтрок, ВыбранноеЗначение", МассивСтрок, ВыбранноеЗначение)), 
					  ВыбранноеЗначение, НСтр("ru = 'Введите процент скидки (наценки)'"), 5, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПроцентСкидкиНаценкиЗавершение(Число, ДополнительныеПараметры) Экспорт
    
    МассивСтрок = ДополнительныеПараметры.МассивСтрок;
    ВыбранноеЗначение = ?(Число = Неопределено, ДополнительныеПараметры.ВыбранноеЗначение, Число);
    
    Если (Число <> Неопределено) Тогда
        
        Для Каждого НомерСтроки Из МассивСтрок Цикл
            СтрокаТЧ = Объект.Скидки.НайтиПоИдентификатору(НомерСтроки);
            СтрокаТЧ.ПроцентСкидки = ВыбранноеЗначение;
        КонецЦикла;
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДатуНачалаДействия(Команда)
	
	МассивСтрок = Элементы.Скидки.ВыделенныеСтроки;
	Если МассивСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'В списке отсутствуют выделенные строки'"));
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	ПоказатьВводДаты(Новый ОписаниеОповещения("ЗаполнитьНачалоДействияЗавершение", ЭтотОбъект, Новый Структура("МассивСтрок, ВыбранноеЗначение", МассивСтрок, ВыбранноеЗначение)), 
					 ВыбранноеЗначение, НСтр("ru = 'Введите дату начала действия'"), ЧастиДаты.Дата);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНачалоДействияЗавершение(Число, ДополнительныеПараметры) Экспорт
    
    МассивСтрок = ДополнительныеПараметры.МассивСтрок;
    ВыбранноеЗначение = ?(Число = Неопределено, ДополнительныеПараметры.ВыбранноеЗначение, Число);
    
    Если (Число <> Неопределено) Тогда
        
        Для Каждого НомерСтроки Из МассивСтрок Цикл
            СтрокаТЧ = Объект.Скидки.НайтиПоИдентификатору(НомерСтроки);
            СтрокаТЧ.НачалоДействия = ВыбранноеЗначение;
        КонецЦикла;
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДействующимиСкидками(Команда)
	
	Если Объект.Скидки.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьДействующимиСкидкамиЗавершение", ЭтотОбъект), 
					   "При заполнении будет очищена таблица скидок. Продолжить?", РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
	Иначе
		ЗаполнитьДействующимиСкидкамиНаСервере();	
	КонецЕсли;		

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДействующимиСкидкамиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДействующимиСкидкамиНаСервере();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДействующимиСкидкамиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Клиент КАК Клиент,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Номенклатура КАК Номенклатура,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки КАК ПроцентСкидки,
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.Период КАК НачалоДействия
		|ИЗ
		|	РегистрСведений.смартИндивидуальныеСкидкиКлиентов.СрезПоследних(&Дата, ) КАК смартИндивидуальныеСкидкиКлиентовСрезПоследних
		|ГДЕ
		|	смартИндивидуальныеСкидкиКлиентовСрезПоследних.ПроцентСкидки <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	НачалоДействия,
		|	Клиент,
		|	Номенклатура,
		|	ПроцентСкидки
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
    Объект.Скидки.Загрузить(РезультатЗапроса);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлиентовПоОтбору(Команда)
	
	ДополнительныеДанные = CRM_ОбщегоНазначенияКлиент.СтруктураДополнительныхДанных();
	ДополнительныеДанные.ИмяРеквизитаАдресОтбор = "АдресОтборКлиенты";
	ДополнительныеДанные.ИмяСправочника = "Партнеры";
	ДополнительныеДанные.Оповещение = Новый ОписаниеОповещения("ДобавитьКлиентовПоСКД", ЭтотОбъект);
	
	ОткрытьОтборЗаполненияКлиентов(ЭтотОбъект, ДополнительныеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтборЗаполненияКлиентов(Форма, ДополнительныеДанные)
	
	ПараметрыСтруктура = Новый Структура();
	
	СтруктураСхемаКомпоновкиДанных = ПолучитьСтруктуруНастроекСхемыСКДИндивидуальныеСкидки("ОсновнаяСхемаКлиенты");
	
	ПараметрыСтруктура.Вставить("ТекстЗапроса", СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхЗапрос);
	ПараметрыСтруктура.Вставить("Заголовок", НСтр("ru='Настройка отбора клиентов'"));
	
	Если ЭтоАдресВременногоХранилища(Форма[ДополнительныеДанные.ИмяРеквизитаАдресОтбор]) Тогда
		ПараметрыСтруктура.Вставить("ОтборКомпоновкиДанных", ПолучитьИзВременногоХранилища(Форма[ДополнительныеДанные.ИмяРеквизитаАдресОтбор]));
	Иначе
		ПараметрыСтруктура.Вставить("ОтборКомпоновкиДанных", СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхОтборПоУмолчанию);
	КонецЕсли;
	
	ПараметрыСтруктура.Вставить("ДополнительныеПоля", Новый Массив);
	ПараметрыСтруктура.Вставить("ЗаголовокКомандыОК", НСтр("ru = 'Добавить'"));
	
	ДополнительныеДанные.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьОтборЗаполненияЗавершение", CRM_ОбщегоНазначенияКлиент, ДополнительныеДанные);
	ОткрытьФорму("ОбщаяФорма.CRM_ОтборКомпоновкиДанных", ПараметрыСтруктура, Форма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКлиентовПоСКД(Данные, ДополнительныеПараметры) Экспорт
	
	Если НЕ Данные.ОтборНастроен Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКлиентовПоСКДЗавершение(Неопределено, Данные);
			
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКлиентовПоСКДЗавершение(Ответ, ДополнительныеПараметры) Экспорт
		
	Если ДополнительныеПараметры.Свойство("Форма") Тогда
		ДополнительныеПараметры.Удалить("Форма");
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Оповещение") Тогда
		ДополнительныеПараметры.Удалить("Оповещение");
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Формирование списка клиентов'"),,
		НСтр("ru = 'Список сформирован.'")
	);
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма[ДополнительныеПараметры.ИмяРеквизитаАдресОтбор]) Тогда
		ТекОтбор = ПолучитьИзВременногоХранилища(ЭтаФорма[ДополнительныеПараметры.ИмяРеквизитаАдресОтбор]);
	Иначе
		ТекОтбор = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ТекОтбор) <> Тип("ОтборКомпоновкиДанных") Тогда
		ТекОтбор = Неопределено;
	КонецЕсли;
	
	СтруктураСхемаКомпоновкиДанных = ПолучитьСтруктуруНастроекСхемыСКДИндивидуальныеСкидки("ОсновнаяСхемаКлиенты");
	
	МассивСсылок = ПолучитьМассивСсылокПоОтборуСКД(СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхЗапрос, ТекОтбор, "Партнер"); 
	
	ДобавитьКлиентовПоРезультатуСКД(МассивСсылок);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКлиентовПоРезультатуСКД(МассивСсылок)
	
	Для Каждого ЭлементСписка Из МассивСсылок Цикл
		
		НовыйКлиент = Объект.Клиенты.Добавить();
		НовыйКлиент.Клиент = ЭлементСписка;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНоменклатуруПоОтбору(Команда)
	
	ДополнительныеДанные = CRM_ОбщегоНазначенияКлиент.СтруктураДополнительныхДанных();
	ДополнительныеДанные.ИмяРеквизитаАдресОтбор = "АдресОтборНоменклатура";
	ДополнительныеДанные.ИмяСправочника = "Номенклатура";
	ДополнительныеДанные.Оповещение = Новый ОписаниеОповещения("ДобавитьНоменклатуруПоСКД", ЭтотОбъект);
	
	ОткрытьОтборЗаполненияНоменклатуры(ЭтотОбъект, ДополнительныеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОтборЗаполненияНоменклатуры(Форма, ДополнительныеДанные)
	
	ПараметрыСтруктура = Новый Структура();
	
	СтруктураСхемаКомпоновкиДанных = ПолучитьСтруктуруНастроекСхемыСКДИндивидуальныеСкидки("ОсновнаяСхемаНоменклатура");
	
	ПараметрыСтруктура.Вставить("ТекстЗапроса", СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхЗапрос);
	ПараметрыСтруктура.Вставить("Заголовок", НСтр("ru='Настройка отбора номенклатуры'"));
	
	Если ЭтоАдресВременногоХранилища(Форма[ДополнительныеДанные.ИмяРеквизитаАдресОтбор]) Тогда
		ПараметрыСтруктура.Вставить("ОтборКомпоновкиДанных", ПолучитьИзВременногоХранилища(Форма[ДополнительныеДанные.ИмяРеквизитаАдресОтбор]));
	Иначе
		ПараметрыСтруктура.Вставить("ОтборКомпоновкиДанных", СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхОтборПоУмолчанию);
	КонецЕсли;
	
	ПараметрыСтруктура.Вставить("ДополнительныеПоля", Новый Массив);
	ПараметрыСтруктура.Вставить("ЗаголовокКомандыОК", НСтр("ru = 'Добавить'"));
	
	ДополнительныеДанные.Вставить("Форма", Форма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьОтборЗаполненияЗавершение", CRM_ОбщегоНазначенияКлиент, ДополнительныеДанные);
	ОткрытьФорму("ОбщаяФорма.CRM_ОтборКомпоновкиДанных", ПараметрыСтруктура, Форма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНоменклатуруПоСКД(Данные, ДополнительныеПараметры) Экспорт
	
	Если НЕ Данные.ОтборНастроен Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьНоменклатуруПоСКДЗавершение(Неопределено, Данные);
			
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНоменклатуруПоСКДЗавершение(Ответ, ДополнительныеПараметры) Экспорт
		
	Если ДополнительныеПараметры.Свойство("Форма") Тогда
		ДополнительныеПараметры.Удалить("Форма");
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Оповещение") Тогда
		ДополнительныеПараметры.Удалить("Оповещение");
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(
		НСтр("ru = 'Формирование списка номенклатуры'"),,
		НСтр("ru = 'Список сформирован.'")
	);
	
	Если ЭтоАдресВременногоХранилища(ЭтаФорма[ДополнительныеПараметры.ИмяРеквизитаАдресОтбор]) Тогда
		ТекОтбор = ПолучитьИзВременногоХранилища(ЭтаФорма[ДополнительныеПараметры.ИмяРеквизитаАдресОтбор]);
	Иначе
		ТекОтбор = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ТекОтбор) <> Тип("ОтборКомпоновкиДанных") Тогда
		ТекОтбор = Неопределено;
	КонецЕсли;
	
	СтруктураСхемаКомпоновкиДанных = ПолучитьСтруктуруНастроекСхемыСКДИндивидуальныеСкидки("ОсновнаяСхемаНоменклатура");

	МассивСсылок = ПолучитьМассивСсылокПоОтборуСКД(СтруктураСхемаКомпоновкиДанных.СхемаКомпоновкиДанныхЗапрос, ТекОтбор, "Номенклатура"); 
	
	ДобавитьНоменклатуруПоРезультатуСКД(МассивСсылок);

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНоменклатуруПоРезультатуСКД(МассивСсылок)
	
	Для Каждого ЭлементСписка Из МассивСсылок Цикл
		
		НоваяНоменклатура = Объект.Скидки.Добавить();
		НоваяНоменклатура.Номенклатура = ЭлементСписка;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруНастроекСхемыСКДИндивидуальныеСкидки(ИмяСхемы)

	СхемаКомпоновкиДанных = Документы.смартУстановкаИндивидуальныхСкидокКлиентов.ПолучитьМакет(ИмяСхемы);
	
	СтруктураСхемаКомпоновкиДанных = Новый Структура;
	СтруктураСхемаКомпоновкиДанных.Вставить("СхемаКомпоновкиДанныхЗапрос", 		     СхемаКомпоновкиДанных.НаборыДанных.ОсновнойНаборДанных.Запрос);
	СтруктураСхемаКомпоновкиДанных.Вставить("СхемаКомпоновкиДанныхОтборПоУмолчанию", СхемаКомпоновкиДанных.НастройкиПоУмолчанию.Отбор);
	
	Возврат СтруктураСхемаКомпоновкиДанных;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМассивСсылокПоОтборуСКД(СхемаКомпоновкиДанныхЗапрос, СхемаКомпоновкиДанныхОтбор, НаименованиеКолонки)
	
	ТаблицаПоОтбору = CRM_ОбщегоНазначенияСервер.ВыполнитьЗапросВКомпоновкеДанных(СхемаКомпоновкиДанныхЗапрос, СхемаКомпоновкиДанныхОтбор);	
	
	МассивСсылок = ТаблицаПоОтбору.ВыгрузитьКолонку(НаименованиеКолонки);	
	
	Возврат МассивСсылок;
	
КонецФункции

