&НаСервере
Процедура ЗаполнитьТаблицуПланированияПланом()
	
	Объект.Планирование.Очистить();
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоПодразделениям Тогда
		
		МасПодразделение = Объект.ДокументОснование.Планирование.Выгрузить(, "Подразделение").ВыгрузитьКолонку("Подразделение");
		МасПодразделение = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасПодразделение);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	смартПланПродажПоМенеджерамОбороты.Период КАК Период,
		|	смартПланПродажПоМенеджерамОбороты.Подразделение КАК Подразделение,
		|	СУММА(смартПланПродажПоМенеджерамОбороты.СуммаОборот) КАК СтарыйПлан
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(&ДатаНачала, &ДатаОкончания, 
		|" + ПериодичностьТекст + ", Подразделение В (&МасПодразделение) 
		|	И ТипУслуги = &ТипУслуги И ВидПлана = &ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Период,
		|	смартПланПродажПоМенеджерамОбороты.Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Подразделение.Наименование");
		Запрос.УстановитьПараметр("МасПодразделение", МасПодразделение);
		Запрос.УстановитьПараметр("ТипУслуги", Объект.ТипУслуги);
		Запрос.УстановитьПараметр("ВидПлана", Объект.ВидПлана);
		Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоПериода);
		Запрос.УстановитьПараметр("ДатаОкончания", Объект.ОкончаниеПериода);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Объект.Планирование.Добавить();
			НоваяСтрока.КоэффициентИзменения = 1;
			НоваяСтрока.Подразделение = Выборка.Подразделение;
			НоваяСтрока.НовыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.СтарыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.Период = Выборка.Период;
			
		КонецЦикла;
		
	ИначеЕсли Объект.ВидПлана = Перечисления.смартВидПлана.ПоМенеджерам Тогда	
		
		МасМенеджер = Объект.ДокументОснование.Планирование.Выгрузить(, "Менеджер").ВыгрузитьКолонку("Менеджер");
		МасМенеджер = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	смартПланПродажПоМенеджерамОбороты.Период КАК Период,
		|	смартПланПродажПоМенеджерамОбороты.Менеджер КАК Менеджер,
		|	СУММА(смартПланПродажПоМенеджерамОбороты.СуммаОборот) КАК СтарыйПлан
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(&ДатаНачала, &ДатаОкончания, 
		|" + ПериодичностьТекст + ", Менеджер В (&МасМенеджер) 
		|	И ТипУслуги = &ТипУслуги И ВидПлана = &ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Период,
		|	смартПланПродажПоМенеджерамОбороты.Менеджер
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Менеджер.Наименование");
		Запрос.УстановитьПараметр("МасМенеджер", МасМенеджер);
		Запрос.УстановитьПараметр("ТипУслуги", Объект.ТипУслуги);
		Запрос.УстановитьПараметр("ВидПлана", Объект.ВидПлана);
		Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоПериода);
		Запрос.УстановитьПараметр("ДатаОкончания", Объект.ОкончаниеПериода);
		
		Выборка=Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Объект.Планирование.Добавить();
			НоваяСтрока.КоэффициентИзменения = 1;
			НоваяСтрока.Менеджер = Выборка.Менеджер;
			НоваяСтрока.НовыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.СтарыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.Период = Выборка.Период;
			
		КонецЦикла;
		
	Иначе
		
		МасСегментов = Объект.ДокументОснование.Планирование.Выгрузить(, "СегментНоменклатуры").ВыгрузитьКолонку("СегментНоменклатуры");
		МасСегментов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасСегментов);
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	смартПланПродажПоМенеджерамОбороты.Период КАК Период,
		|	смартПланПродажПоМенеджерамОбороты.СегментНоменклатуры КАК СегментНоменклатуры,
		|	СУММА(смартПланПродажПоМенеджерамОбороты.СуммаОборот) КАК СтарыйПлан,
		|	СУММА(смартПланПродажПоМенеджерамОбороты.КоличествоОборот) КАК СтарыйПланКоличество
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(&ДатаНачала, &ДатаОкончания, 
		|" + ПериодичностьТекст + ", СегментНоменклатуры В (&МасСегментов) 
		|	И ВидПлана = &ВидПлана) КАК смартПланПродажПоМенеджерамОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Период,
		|	смартПланПродажПоМенеджерамОбороты.СегментНоменклатуры
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.СегментНоменклатуры.Наименование");
		Запрос.УстановитьПараметр("МасСегментов", МасСегментов);
		Запрос.УстановитьПараметр("ВидПлана", Объект.ВидПлана);
		Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоПериода);
		Запрос.УстановитьПараметр("ДатаОкончания", Объект.ОкончаниеПериода);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = Объект.Планирование.Добавить();
			НоваяСтрока.КоэффициентИзменения = 1;
			НоваяСтрока.СегментНоменклатуры = Выборка.СегментНоменклатуры;
			НоваяСтрока.НовыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.СтарыйПлан = Выборка.СтарыйПлан;
			НоваяСтрока.НовыйПланКоличество = Выборка.СтарыйПланКоличество;
			НоваяСтрока.СтарыйПланКоличество = Выборка.СтарыйПланКоличество;
			НоваяСтрока.Период = Выборка.Период;
			
		КонецЦикла;
		
	КонецЕсли;	
	
	ЗаполнитьДанныеПодвалаНаСервере();
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоПодразделениям Тогда
		ЗаполнитьДаннымиТабПланированияПоПодразделениям(Истина);
	ИначеЕсли Объект.ВидПлана = Перечисления.смартВидПлана.ПоМенеджерам Тогда	
		ЗаполнитьДаннымиТабПланирования(Истина);
	Иначе	
		ЗаполнитьДаннымиТабПланированияПоСегментам(Истина);
	КонецЕсли;	
	
КонецПроцедуры 
	
&НаСервере
Процедура ЗаполнитьДаннымиТабПланирования(НовыйДокумент=Ложь)
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	ТабИсходныхДанных.Менеджер КАК Менеджер,
	|	ТабИсходныхДанных.НовыйПлан КАК НовыйПлан,
	|	ТабИсходныхДанных.СтарыйПлан КАК СтарыйПлан,
	|	ТабИсходныхДанных.Период КАК Период,
	|	ТабИсходныхДанных.Комментарий КАК Комментарий,
	|	ТабИсходныхДанных.РучноеИзменение КАК РучноеИзменение
	|ПОМЕСТИТЬ ТабДанных
	|ИЗ
	|	&ТабИсходныхДанных КАК ТабИсходныхДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Менеджер КАК Менеджер,
	|	СУММА(ТабДанных.НовыйПлан) КАК НовыйПлан,
	|	СУММА(ТабДанных.СтарыйПлан) КАК СтарыйПлан,
	|	ТабДанных.Комментарий КАК Комментарий,
	|	ТабДанных.РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ") КАК ПериодПлана
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.Менеджер,
	|	ТабДанных.Комментарий,
	|	ТабДанных.РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Менеджер КАК Менеджер,
	|	СРЕДНЕЕ(ТабДанных.НовыйПлан) КАК СреднийПлан
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.Менеджер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Менеджер"); 
	Запрос.УстановитьПараметр("ТабИсходныхДанных",Объект.Планирование.Выгрузить()); 
	МасМенеджер=Объект.Планирование.Выгрузить(,"Менеджер").ВыгрузитьКолонку("Менеджер");
	МасМенеджер=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
	МасРезультатов=Запрос.ВыполнитьПакет();
	РезПланирование=МасРезультатов[1].Выгрузить();
	РезСреднее=МасРезультатов[2].Выгрузить();
	Для Каждого СтрМасМенеджер Из МасМенеджер Цикл
		СтрТабПланирования=ЭтаФорма.ТабПланирования.Добавить();
		СтрТабПланирования.Менеджер=СтрМасМенеджер;
		ИтогоПланНаПериод=0;
		ИтогоПланНаПериодСтарый=0; 
		РучноеИзменение=Ложь;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			СтрокиРезПланирование=РезПланирование.НайтиСтроки(Новый Структура("Менеджер,ПериодПлана",СтрТабПланирования.Менеджер,СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРезПланирование.Количество()>0 Тогда
				СтрТабПланирования["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=СтрокиРезПланирование[0].НовыйПлан;	
				СтрТабПланирования["КолонкаПланСтар_"+СтрТаблицаПериоды.ИмяКолонки]=СтрокиРезПланирование[0].СтарыйПлан;
				ИтогоПланНаПериод=ИтогоПланНаПериод+СтрокиРезПланирование[0].НовыйПлан;
				ИтогоПланНаПериодСтарый=ИтогоПланНаПериодСтарый+СтрокиРезПланирование[0].СтарыйПлан;
				СтрокиРезСреднее=РезСреднее.НайтиСтроки(Новый Структура("Менеджер",СтрТабПланирования.Менеджер));
				Если СтрокиРезСреднее.Количество()=0 Тогда
					РучноеИзменение=Истина;
				ИначеЕсли СтрокиРезПланирование[0].НовыйПлан<>СтрокиРезСреднее[0].СреднийПлан Тогда
					РучноеИзменение=Истина;
				КонецЕсли;
				СтрТабПланирования.Комментарий=СтрокиРезПланирование[0].Комментарий;
				Если Не НовыйДокумент ТОгда
					СтрТабПланирования.РучноеИзменение=СтрокиРезПланирование[0].РучноеИзменение;
				КонецЕсли;
			Иначе	
				РучноеИзменение=Истина;
			КонецЕсли;	
		КонецЦикла;
		Если НовыйДокумент ТОгда
			СтрТабПланирования.РучноеИзменение=РучноеИзменение;
		КонецЕсли;
		Если Объект.Периодичность=Перечисления.Периодичность.Месяц Тогда
			СтрТабПланирования.ПланНаМесяц=ИтогоПланНаПериод/ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаМесяцСтарый=ИтогоПланНаПериодСтарый/ТаблицаПериоды.Количество();
		Иначе
			СтрТабПланирования.ПланНаКвартал=ИтогоПланНаПериод/ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаКварталСтарый=ИтогоПланНаПериодСтарый/ТаблицаПериоды.Количество();
		КонецЕсли;	
		
	КонецЦикла;
	ЗаполнитьДанныеПодвалаНаСервере();
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДаннымиТабПланированияПоПодразделениям(НовыйДокумент=Ложь)
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	ТабИсходныхДанных.Подразделение КАК Подразделение,
	|	ТабИсходныхДанных.НовыйПлан КАК НовыйПлан,
	|	ТабИсходныхДанных.СтарыйПлан КАК СтарыйПлан,
	|	ТабИсходныхДанных.Период КАК Период,
	|	ТабИсходныхДанных.Комментарий КАК Комментарий,
	|	ТабИсходныхДанных.РучноеИзменение КАК РучноеИзменение
	|ПОМЕСТИТЬ ТабДанных
	|ИЗ
	|	&ТабИсходныхДанных КАК ТабИсходныхДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Подразделение КАК Подразделение,
	|	СУММА(ТабДанных.НовыйПлан) КАК НовыйПлан,
	|	СУММА(ТабДанных.СтарыйПлан) КАК СтарыйПлан,
	|	ТабДанных.Комментарий КАК Комментарий,
	|	ТабДанных.РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ") КАК ПериодПлана
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.Подразделение,
	|	ТабДанных.Комментарий,
	|	ТабДанных.РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.Подразделение КАК Подразделение,
	|	СРЕДНЕЕ(ТабДанных.НовыйПлан) КАК СреднийПлан
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.Подразделение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение"); 
	Запрос.УстановитьПараметр("ТабИсходныхДанных",Объект.Планирование.Выгрузить()); 
	МасПодразделение=Объект.Планирование.Выгрузить(,"Подразделение").ВыгрузитьКолонку("Подразделение");
	МасПодразделение=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасПодразделение);
	МасРезультатов=Запрос.ВыполнитьПакет();
	РезПланирование=МасРезультатов[1].Выгрузить();
	РезСреднее=МасРезультатов[2].Выгрузить();
	Для Каждого СтрМасПодразделение Из МасПодразделение Цикл
		СтрТабПланирования=ЭтаФорма.ТабПланирования.Добавить();
		СтрТабПланирования.Подразделение=СтрМасПодразделение;
		ИтогоПланНаПериод=0;
		ИтогоПланНаПериодСтарый=0; 
		РучноеИзменение=Ложь;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			СтрокиРезПланирование=РезПланирование.НайтиСтроки(Новый Структура("Подразделение,ПериодПлана",СтрТабПланирования.Подразделение,СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРезПланирование.Количество()>0 Тогда
				СтрТабПланирования["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=СтрокиРезПланирование[0].НовыйПлан;	
				СтрТабПланирования["КолонкаПланСтар_"+СтрТаблицаПериоды.ИмяКолонки]=СтрокиРезПланирование[0].СтарыйПлан;
				ИтогоПланНаПериод=ИтогоПланНаПериод+СтрокиРезПланирование[0].НовыйПлан;
				ИтогоПланНаПериодСтарый=ИтогоПланНаПериодСтарый+СтрокиРезПланирование[0].СтарыйПлан;
				СтрокиРезСреднее=РезСреднее.НайтиСтроки(Новый Структура("Подразделение",СтрТабПланирования.Подразделение));
				Если СтрокиРезСреднее.Количество()=0 Тогда
					РучноеИзменение=Истина;
				ИначеЕсли СтрокиРезПланирование[0].НовыйПлан<>СтрокиРезСреднее[0].СреднийПлан Тогда
					РучноеИзменение=Истина;
				КонецЕсли;
				СтрТабПланирования.Комментарий=СтрокиРезПланирование[0].Комментарий;
				Если Не НовыйДокумент ТОгда
					СтрТабПланирования.РучноеИзменение=СтрокиРезПланирование[0].РучноеИзменение;
				КонецЕсли;
			Иначе	
				РучноеИзменение=Истина;
			КонецЕсли;	
		КонецЦикла;
		Если НовыйДокумент ТОгда
			СтрТабПланирования.РучноеИзменение=РучноеИзменение;
		КонецЕсли;
		Если Объект.Периодичность=Перечисления.Периодичность.Месяц Тогда
			СтрТабПланирования.ПланНаМесяц=ИтогоПланНаПериод/ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаМесяцСтарый=ИтогоПланНаПериодСтарый/ТаблицаПериоды.Количество();
		Иначе
			СтрТабПланирования.ПланНаКвартал=ИтогоПланНаПериод/ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаКварталСтарый=ИтогоПланНаПериодСтарый/ТаблицаПериоды.Количество();
		КонецЕсли;	
		
	КонецЦикла;
	ЗаполнитьДанныеПодвалаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДаннымиТабПланированияПоСегментам(НовыйДокумент = Ложь)
	
	Запрос=Новый Запрос(
	"ВЫБРАТЬ
	|	ТабИсходныхДанных.СегментНоменклатуры КАК СегментНоменклатуры,
	|	ТабИсходныхДанных.НовыйПлан КАК НовыйПлан,
	|	ТабИсходныхДанных.СтарыйПлан КАК СтарыйПлан,
	|	ТабИсходныхДанных.НовыйПланКоличество КАК НовыйПланКоличество,
	|	ТабИсходныхДанных.СтарыйПланКоличество КАК СтарыйПланКоличество,
	|	ТабИсходныхДанных.Период КАК Период,
	|	ТабИсходныхДанных.Комментарий КАК Комментарий,
	|	ТабИсходныхДанных.РучноеИзменение КАК РучноеИзменение
	|ПОМЕСТИТЬ ТабДанных
	|ИЗ
	|	&ТабИсходныхДанных КАК ТабИсходныхДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.СегментНоменклатуры КАК СегментНоменклатуры,
	|	СУММА(ТабДанных.НовыйПлан) КАК НовыйПлан,
	|	СУММА(ТабДанных.СтарыйПлан) КАК СтарыйПлан, 
	|	СУММА(ТабДанных.НовыйПланКоличество) КАК НовыйПланКоличество,
	|	СУММА(ТабДанных.СтарыйПланКоличество) КАК СтарыйПланКоличество,
	|	ТабДанных.Комментарий КАК Комментарий,
	|	ТабДанных.РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ") КАК ПериодПлана
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.СегментНоменклатуры,
	|	ТабДанных.Комментарий,
	|	ТабДанных.РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(ТабДанных.Период, " + ПериодичностьТекст + ")
	|
	|УПОРЯДОЧИТЬ ПО
	|	СегментНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабДанных.СегментНоменклатуры КАК СегментНоменклатуры,
	|	СРЕДНЕЕ(ТабДанных.НовыйПлан) КАК СреднийПлан
	|ИЗ
	|	ТабДанных КАК ТабДанных
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабДанных.СегментНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	СегментНоменклатуры"); 
	Запрос.УстановитьПараметр("ТабИсходныхДанных", Объект.Планирование.Выгрузить()); 
	
	МасСегментов = Объект.Планирование.Выгрузить(, "СегментНоменклатуры").ВыгрузитьКолонку("СегментНоменклатуры");
	МасСегментов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасСегментов);
	
	МасРезультатов = Запрос.ВыполнитьПакет();
	РезПланирование = МасРезультатов[1].Выгрузить();
	РезСреднее = МасРезультатов[2].Выгрузить();
	
	Для Каждого СтрМасСегментов Из МасСегментов Цикл
		
		СтрТабПланирования = ЭтаФорма.ТабПланирования.Добавить();
		СтрТабПланирования.СегментНоменклатуры = СтрМасСегментов;
		ИтогоПланНаПериод = 0;
		ИтогоПланНаПериодСтарый = 0;
		ИтогоПланНаПериодКоличество = 0;
		ИтогоПланНаПериодСтарыйКоличество = 0; 
		РучноеИзменение = Ложь;
		
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРезПланирование = РезПланирование.НайтиСтроки(Новый Структура("СегментНоменклатуры, ПериодПлана",
				СтрТабПланирования.СегментНоменклатуры, СтрТаблицаПериоды.ДатаНачала));
				
			Если СтрокиРезПланирование.Количество() > 0 Тогда
				
				СтрТабПланирования["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].НовыйПлан;	
				СтрТабПланирования["КолонкаПланСтар_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].СтарыйПлан;
				СтрТабПланирования["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].НовыйПланКоличество;	
				СтрТабПланирования["КолонкаПланСтарКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].СтарыйПланКоличество;
				ИтогоПланНаПериод = ИтогоПланНаПериод + СтрокиРезПланирование[0].НовыйПлан;
				ИтогоПланНаПериодСтарый = ИтогоПланНаПериодСтарый + СтрокиРезПланирование[0].СтарыйПлан;
				ИтогоПланНаПериодКоличество = ИтогоПланНаПериодКоличество + СтрокиРезПланирование[0].НовыйПланКоличество;
				ИтогоПланНаПериодСтарыйКоличество = ИтогоПланНаПериодСтарыйКоличество + СтрокиРезПланирование[0].СтарыйПланКоличество;
				
				СтрокиРезСреднее = РезСреднее.НайтиСтроки(Новый Структура("СегментНоменклатуры", СтрТабПланирования.СегментНоменклатуры));
				Если СтрокиРезСреднее.Количество() = 0 Тогда
					РучноеИзменение = Истина;
				ИначеЕсли СтрокиРезПланирование[0].НовыйПлан <> СтрокиРезСреднее[0].СреднийПлан Тогда
					РучноеИзменение = Истина;
				КонецЕсли;
				
				СтрТабПланирования.Комментарий = СтрокиРезПланирование[0].Комментарий;
				
				Если Не НовыйДокумент ТОгда
					СтрТабПланирования.РучноеИзменение = СтрокиРезПланирование[0].РучноеИзменение;
				КонецЕсли;
				
			Иначе	
				
				РучноеИзменение = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НовыйДокумент Тогда
			СтрТабПланирования.РучноеИзменение = РучноеИзменение;
		КонецЕсли;
		
		Если Объект.Периодичность = Перечисления.Периодичность.Месяц Тогда
			СтрТабПланирования.ПланНаМесяц = ИтогоПланНаПериод / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаМесяцСтарый = ИтогоПланНаПериодСтарый / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаМесяцКоличество = ИтогоПланНаПериодКоличество / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаМесяцСтарыйКоличество = ИтогоПланНаПериодСтарыйКоличество / ТаблицаПериоды.Количество();
		Иначе
			СтрТабПланирования.ПланНаКвартал = ИтогоПланНаПериод / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаКварталСтарый = ИтогоПланНаПериодСтарый / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаКварталКоличество = ИтогоПланНаПериодКоличество / ТаблицаПериоды.Количество();
			СтрТабПланирования.ПланНаКварталСтарыйКоличество = ИтогоПланНаПериодСтарыйКоличество / ТаблицаПериоды.Количество();
		КонецЕсли;	
		
	КонецЦикла;
	
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Планирование.Очистить();
	
	ТабПланирования.Сортировать("Менеджер Возр");
	
	Для Каждого Стр Из ТабПланирования Цикл 
		
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрПланирование = Объект.Планирование.Добавить();
			СтрПланирование.Менеджер = Стр.Менеджер;
			СтрПланирование.СегментНоменклатуры = Стр.СегментНоменклатуры;
			СтрПланирование.Подразделение = Стр.Подразделение;
			СтрПланирование.Период = СтрТаблицаПериоды.ДатаНачала;
			СтрПланирование.КоэффициентИзменения = ?(Стр.РучноеИзменение, ?(Стр.ПланНаМесяцСтарый > 0, 
				Стр.ПланНаМесяц / Стр.ПланНаМесяцСтарый, 0), Объект.КоэффициентИзмененияОбщий);
			СтрПланирование.РучноеИзменение = Стр.РучноеИзменение;
			СтрПланирование.Комментарий = Стр.Комментарий;
			СтрПланирование.НовыйПлан = Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
			СтрПланирование.СтарыйПлан = Стр["КолонкаПланСтар_" + СтрТаблицаПериоды.ИмяКолонки];
			
			Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
				
				СтрПланирование.НовыйПланКоличество = Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
				СтрПланирование.СтарыйПланКоличество  =Стр["КолонкаПланСтарКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
				
			КонецЕсли;	
				
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура КоэффициентИзмененияОбщийПриИзменении(Элемент)
	
	Для Каждого Стр Из ТабПланирования Цикл 
		
		Если НЕ Стр.РучноеИзменение Тогда 
			
			Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
				
				НовыйНаКвартал = Стр.ПланНаКварталСтарый * Объект.КоэффициентИзмененияОбщий;
				Если НовыйНаКвартал > Окр(НовыйНаКвартал, -3) Тогда
					Стр.ПланНаКвартал = Окр(НовыйНаКвартал + 500, -3);
				Иначе
					Стр.ПланНаКвартал = Окр(НовыйНаКвартал, -3);
				КонецЕсли;
				
				Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
					
					НовыйНаКварталКоличество = Стр.ПланНаКварталСтарыйКоличество * Объект.КоэффициентИзмененияОбщий;
					Если НовыйНаКварталКоличество > Окр(НовыйНаКварталКоличество, 0) Тогда
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
					Иначе
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
					КонецЕсли;
					
				КонецЕсли;	
					
			Иначе
				
				НовыйНаМесяц = Стр.ПланНаМесяцСтарый * Объект.КоэффициентИзмененияОбщий;
				Если НовыйНаМесяц > Окр(НовыйНаМесяц, -3) Тогда
					Стр.ПланНаМесяц = Окр(НовыйНаМесяц + 500, -3);
				Иначе
					Стр.ПланНаМесяц = Окр(НовыйНаМесяц, -3);
				КонецЕсли;
				
				Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
					
					НовыйНаМесяцКоличество = Стр.ПланНаМесяцСтарыйКоличество * Объект.КоэффициентИзмененияОбщий;
					Если НовыйНаМесяцКоличество > Окр(НовыйНаМесяцКоличество, 0) Тогда
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
					Иначе
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЕсли; 
			
			Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
				
				Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),
					Стр.ПланНаКвартал, Стр.ПланНаМесяц);
					
				Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда	
					Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),
						Стр.ПланНаКварталКоличество, Стр.ПланНаМесяцКоличество);
				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияМесяцПриИзменении(Элемент)
	ТекущиеДанные=ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение=Истина;
	ПланНаСледПериод=0;
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ПланНаСледПериод=ПланНаСледПериод+ТекущиеДанные["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки];
	КонецЦикла;
	Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
		ТекущиеДанные.ПланНаКвартал=Окр(ПланНаСледПериод/ТаблицаПериоды.Количество(),0);
	Иначе	
		ТекущиеДанные.ПланНаМесяц=Окр(ПланНаСледПериод/ТаблицаПериоды.Количество(),0);
	КонецЕсли;
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияМесяцКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение = Истина;
	ПланНаСледПериод = 0;
	
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ПланНаСледПериод = ПланНаСледПериод + ТекущиеДанные["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
	КонецЦикла;
	
	Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
		ТекущиеДанные.ПланНаКварталКоличество = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), 0);
	Иначе	
		ТекущиеДанные.ПланНаМесяцКоличество = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), 0);
	КонецЕсли;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияРучноеИзменениеПриИзменении(Элемент)
	ТекущиеДанные=ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	Если НЕ ТекущиеДанные.РучноеИзменение Тогда
		Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
			НовыйНаКвартал=ТекущиеДанные.ПланНаКварталСтарый*Объект.КоэффициентИзмененияОбщий;
			Если НовыйНаКвартал>Окр(НовыйНаКвартал,-3) ТОгда
				ТекущиеДанные.ПланНаКвартал=Окр(НовыйНаКвартал+500,-3);
			Иначе
				ТекущиеДанные.ПланНаКвартал=Окр(НовыйНаКвартал,-3);
			КонецЕсли;	
		Иначе
			НовыйНаМесяц=ТекущиеДанные.ПланНаМесяцСтарый*Объект.КоэффициентИзмененияОбщий;
			Если НовыйНаМесяц>Окр(НовыйНаМесяц,-3) ТОгда
				ТекущиеДанные.ПланНаМесяц=Окр(НовыйНаМесяц+500,-3);
			Иначе
				ТекущиеДанные.ПланНаМесяц=Окр(НовыйНаМесяц,-3);
			КонецЕсли;	
		КонецЕсли;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			ТекущиеДанные["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),ТекущиеДанные.ПланНаКвартал,ТекущиеДанные.ПланНаМесяц);
		КонецЦикла;
	КонецЕсли;
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаМесяцПриИзменении(Элемент)
	ТекущиеДанные=ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение=Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=ТекущиеДанные.ПланНаМесяц;
	КонецЦикла;
    ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	Оповещение = Новый ОписаниеОповещения(
		"УстановитьИнтервалЗавершение",
		ЭтотОбъект);
		
	ОбщегоНазначенияУТКлиент.РедактироватьПериод(
		Объект, 
		Новый Структура("ДатаНачала, ДатаОкончания", "НачалоПериода", "ОкончаниеПериода"),
		Оповещение);
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСписокМенеджеров()
	МасМенеджер=ЭтаФорма.ТабПланирования.Выгрузить(,"Менеджер").ВыгрузитьКолонку("Менеджер");
	МасМенеджер=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
	Возврат МасМенеджер;
КонецФункции	

&НаКлиенте
Процедура УстановитьИнтервалЗавершение(Период, ДополнительныеПараметры) Экспорт 
	
	Если Период = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	СкорректироватьПериоды();
	ТабПланирования.Очистить();
	ПриИзмененииПериодовНаСервере();
	ЗаполнитьТаблицуПланированияПланом();
	
	Для Каждого Стр Из ТабПланирования Цикл 
		
		Стр.РучноеИзменение = Ложь; 
		Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
			
			НовыйНаКвартал = Стр.ПланНаКварталСтарый * Объект.КоэффициентИзмененияОбщий;
			Если НовыйНаКвартал > Окр(НовыйНаКвартал, -3) Тогда
				Стр.ПланНаКвартал = Окр(НовыйНаКвартал + 500, -3);
			Иначе
				Стр.ПланНаКвартал = Окр(НовыйНаКвартал, -3);
			КонецЕсли;
			
			Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
				
				НовыйНаКварталКоличество = Стр.ПланНаКварталСтарыйКоличество * Объект.КоэффициентИзмененияОбщий;
				Если НовыйНаКварталКоличество > Окр(НовыйНаКварталКоличество, 0) Тогда
					Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
				Иначе
					Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
				КонецЕсли;
				
			КонецЕсли;	
			
		Иначе
			
			НовыйНаМесяц = Стр.ПланНаМесяцСтарый * Объект.КоэффициентИзмененияОбщий;
			Если НовыйНаМесяц > Окр(НовыйНаМесяц, -3) Тогда
				Стр.ПланНаМесяц = Окр(НовыйНаМесяц + 500, -3);
			Иначе
				Стр.ПланНаМесяц = Окр(НовыйНаМесяц, -3);
			КонецЕсли; 
			
			Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
				
				НовыйНаМесяцКоличество = Стр.ПланНаМесяцСтарыйКоличество * Объект.КоэффициентИзмененияОбщий;
				Если НовыйНаМесяцКоличество > Окр(НовыйНаМесяцКоличество, 0) Тогда
					Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
				Иначе
					Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
				КонецЕсли; 
				
			КонецЕсли;	
			
		КонецЕсли;
			
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), 
				Стр.ПланНаКвартал, Стр.ПланНаМесяц);
				
			Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
				
				Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), 
					Стр.ПланНаКварталКоличество, Стр.ПланНаМесяцКоличество);
					
			КонецЕсли;	
				
		КонецЦикла;
		
	КонецЦикла;
	
	ВывестиДекорациюПериод();
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры 

&НаСервере
Процедура ПриИзмененииПериодовНаСервере(КорректироватьНачалоОкончаниеПериода = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл
		Стр.Замещен = Истина;
	КонецЦикла;	
	
	ДобавлениеДатаНачала = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуНачалаПериода(Объект.НачалоПериода, Объект.Периодичность);
	ДобавлениеДатаОкончания = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуОкончанияПериода(ДобавлениеДатаНачала, Объект.Периодичность);
	
	ТекущийПериод = 1;
	
	Пока ДобавлениеДатаНачала < КонецДня(Объект.ОкончаниеПериода) Цикл
		
		НайденныеСтроки = ТаблицаПериоды.НайтиСтроки(Новый Структура("ДатаНачала, ДатаОкончания", ДобавлениеДатаНачала, ДобавлениеДатаОкончания));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаПериоды.Добавить();
			НоваяСтрока.ИмяКолонки = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "_");
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Замещен=Ложь;
		КонецЕсли;
		НоваяСтрока.ДатаНачала = ДобавлениеДатаНачала;
		НоваяСтрока.ДатаОкончания = ДобавлениеДатаОкончания;
		
		НоваяСтрока.Заголовок = ПланированиеКлиентСервер.СформироватьЗаголовокПериода(Объект.Периодичность, ДобавлениеДатаНачала, ДобавлениеДатаОкончания, Ложь, Ложь);
		
		ДобавлениеДатаНачала = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуНачалаПериода(ДобавлениеДатаОкончания+1 , Объект.Периодичность);
		ДобавлениеДатаОкончания = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуОкончанияПериода(ДобавлениеДатаОкончания+1, Объект.Периодичность);
		
	КонецЦикла;
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		УбратьДобавитьКолонкиВТабПланированияПоСегментам();
	Иначе
		УбратьДобавитьКолонкиВТабПланирования();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УбратьДобавитьКолонкиВТабПланирования()
	
	КолонкиДобавляемые = Новый Массив;
	КолонкиУдаляемые = Новый Массив; 
	
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл 
		Если Стр.Замещен ТОгда
			КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаПлан_" + Стр.ИмяКолонки);
			КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаПланСтар_" + Стр.ИмяКолонки);
		Иначе	
			Если ЭтаФорма.Элементы.Найти("КолонкаПлан_" + Стр.ИмяКолонки) = Неопределено ТОгда
				КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаПлан_" + Стр.ИмяКолонки, Новый ОписаниеТипов("Число", 
					Новый КвалификаторыЧисла(10)), "ТабПланирования", Стр.Заголовок));
				КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаПланСтар_" + Стр.ИмяКолонки, 
					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)), "ТабПланирования", Стр.Заголовок)); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	ИзменитьРеквизиты(КолонкиДобавляемые,КолонкиУдаляемые);
	МасУдаляемых = ЭтаФорма.ТаблицаПериоды.НайтиСтроки(Новый Структура("Замещен", Истина));
	
	Для Каждого СтрУдаляемых Из МасУдаляемых Цикл
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("План_" + СтрУдаляемых.ИмяКолонки));
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("ПланСтар_" + СтрУдаляемых.ИмяКолонки));
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("Группа_" + СтрУдаляемых.ИмяКолонки));
		ЭтаФорма.ТаблицаПериоды.Удалить(СтрУдаляемых);	
	КонецЦикла;
	
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл
		НовыйЭлемент = Этаформа.Элементы.Вставить("Группа_"+Стр.ИмяКолонки,Тип("ГруппаФормы"),ЭтаФорма.Элементы.ТабПланирования,Элементы.ТабПланированияКомментарий);
		НовыйЭлемент.Вид = ВидГруппыФормы.ГруппаКолонок;
		НовыйЭлемент.Заголовок = Стр.Заголовок; 
		НовыйЭлемент.Группировка = ГруппировкаКолонок.Горизонтальная;
		НовыйЭлемент.Видимость=Истина;
		НовыйЭлемент.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		НовыйЭлемент.ОтображатьВШапке=Истина;
		
		ДобавленныйПериод=Элементы.Добавить("ПланСтар_"+Стр.ИмяКолонки,Тип("ПолеФормы"),ЭтаФорма.Элементы.Найти("Группа_"+Стр.ИмяКолонки));
		ДобавленныйПериод.Вид = ВидПоляФормы.ПолеВвода;
		ДобавленныйПериод.Заголовок="План старый"; 
		ДобавленныйПериод.ПутьКДанным = "ТабПланирования" + "." + "КолонкаПланСтар_"+Стр.ИмяКолонки;
		ДобавленныйПериод.Видимость=Истина;
		ДобавленныйПериод.ГоризонтальноеПоложениеВПодвале=ГоризонтальноеПоложениеЭлемента.Право;
		ДобавленныйПериод.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		ДобавленныйПериод.ЦветФона=Новый Цвет(248,242,216);
		ДобавленныйПериод.ТолькоПросмотр=Истина;  
		
		ДобавленныйПериод=Элементы.Добавить("План_"+Стр.ИмяКолонки,Тип("ПолеФормы"),ЭтаФорма.Элементы.Найти("Группа_"+Стр.ИмяКолонки));
		ДобавленныйПериод.Вид = ВидПоляФормы.ПолеВвода;
		ДобавленныйПериод.Заголовок="План"; 
		ДобавленныйПериод.ПутьКДанным = "ТабПланирования" + "." + "КолонкаПлан_"+Стр.ИмяКолонки;
		ДобавленныйПериод.КнопкаВыбора=Истина;
		ДобавленныйПериод.Видимость=Истина;
		ДобавленныйПериод.ГоризонтальноеПоложениеВПодвале=ГоризонтальноеПоложениеЭлемента.Право;
		ДобавленныйПериод.ГоризонтальноеПоложениеВШапке=ГоризонтальноеПоложениеЭлемента.Центр;
		ДобавленныйПериод.УстановитьДействие("ПриИзменении", "ТабПланированияМесяцПриИзменении");
		
		ЭлементОформления  = УсловноеОформление.Элементы.Добавить();
		ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("План_"+Стр.ИмяКолонки);
