
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Пользователи.РолиДоступны("смартПланПродажПоМенеджерамИзменение") Тогда
		ОбщегоНазначения.СообщитьПользователю("Просмотр запрещен!");
		Отказ=Истина;
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Параметры.ЗначениеКопирования) Тогда
		ОбщегоНазначения.СообщитьПользователю("Запрещено копировать данный документ!");
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) ТОгда
		Отказ=Истина;
		Возврат; 
	КонецЕсли;
	
	ПериодичностьТекст = ?(Объект.Периодичность = Перечисления.Периодичность.Месяц, "МЕСЯЦ", "КВАРТАЛ");
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
	
	Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПустаяСсылка(), "Вся номенклатура");
	Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаТоварыУслуги, "Продажа оборудования");
	Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти, "Продажа запчастей");
	Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаРасходныеМатериалы, "Продажа расходников");
	
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Дата=ТекущаяДата();
		Объект.Ответственный=ПараметрыСеанса.ТекущийПользователь;
		НовыйДокумент=Истина;
	Иначе
		НовыйДокумент=Ложь;
	КонецЕсли;  
	
	ПриИзмененииПериодовНаСервере();
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоПодразделениям Тогда
		ЗаполнитьДаннымиТабПланированияПоПодразделениям(НовыйДокумент);
	ИначеЕсли Объект.ВидПлана = Перечисления.смартВидПлана.ПоМенеджерам Тогда	
		ЗаполнитьДаннымиТабПланирования(НовыйДокумент);
	Иначе	
		ЗаполнитьДаннымиТабПланированияПоСегментам(НовыйДокумент);
	КонецЕсли;	
	
	ВидимостьЭлементовОтТипаПлана();
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		Если (Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Утвержден И Объект.Проведен) 
			ИЛИ Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Отменен Тогда
			ЭтаФорма.ТолькоПросмотр=Истина; 
			Элементы.ТабПланирования.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКоманднаяПанель.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКонтекстноеМеню.ТолькоПросмотр=Истина;
			Элементы.УстановитьИнтервал.Доступность=Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.Периодичность = Перечисления.Периодичность.Месяц Тогда
		
		Элементы.ТабПланированияПланНаКвартал.Видимость = Ложь;
		Элементы.ТабПланированияПланНаМесяц.Видимость = Истина;  
		Элементы.ТабПланированияПланНаКварталСтарый.Видимость = Ложь;
		Элементы.ТабПланированияПланНаМесяцСтарый.Видимость = Истина;
		
		Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
			
			Элементы.ТабПланированияПланНаКварталКоличество.Видимость = Ложь;
			Элементы.ТабПланированияПланНаМесяцКоличество.Видимость = Истина;  
			Элементы.ТабПланированияПланНаКварталСтарыйКоличество.Видимость = Ложь;
			Элементы.ТабПланированияПланНаМесяцСтарыйКоличество.Видимость = Истина;
			
		Иначе	
			
			Элементы.ТабПланированияПланНаКварталКоличество.Видимость = Ложь;
			Элементы.ТабПланированияПланНаМесяцКоличество.Видимость = Ложь;
			Элементы.ТабПланированияПланНаКварталСтарыйКоличество.Видимость = Ложь;
			Элементы.ТабПланированияПланНаМесяцСтарыйКоличество.Видимость = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.ТабПланированияПланНаКвартал.Видимость = Истина;
		Элементы.ТабПланированияПланНаМесяц.Видимость = Ложь;
