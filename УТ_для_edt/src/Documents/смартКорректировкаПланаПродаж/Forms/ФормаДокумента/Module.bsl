	ТекущиеДанные=ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение=Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=ТекущиеДанные.ПланНаКвартал;
	КонецЦикла;

	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ=Истина;
	Возврат;
КонецПроцедуры

&НаКлиенте
Процедура ВывестиДекорациюПериод()
	Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Элементы.ДекорацияПериод.Заголовок="Период с "+Формат(Объект.НачалоПериода,"ДФ=dd.MM.yyyy")+" по "+Формат(Объект.ОкончаниеПериода,"ДФ=dd.MM.yyyy")+"   ";	
	Иначе
		Элементы.ДекорацияПериод.Заголовок="Период не заполнен";
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура СкорректироватьПериоды()
	Если Объект.НачалоПериода<Объект.ДокументОснование.НачалоПериода ТОгда
		Объект.НачалоПериода=Объект.ДокументОснование.НачалоПериода	
	КонецЕсли;
	Если Объект.ОкончаниеПериода>Объект.ДокументОснование.ОкончаниеПериода ТОгда
		Объект.ОкончаниеПериода=Объект.ДокументОснование.ОкончаниеПериода	
	КонецЕсли;	
КонецПроцедуры	
     
&НаКлиенте
Процедура ЗаполнитьДанныеПодвала()
	ЗаполнитьДанныеПодвалаНаСервере();
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеПодвалаНаСервере()
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		
		Элементы.ТабПланированияПланНаМесяцСтарый.ТекстПодвала = ТабПланирования.Итог("ПланНаМесяцСтарыйКоличество");
		Элементы.ТабПланированияПланНаКварталСтарый.ТекстПодвала = ТабПланирования.Итог("ПланНаКварталСтарыйКоличество");
		Элементы.ТабПланированияПланНаКвартал.ТекстПодвала = ТабПланирования.Итог("ПланНаКварталКоличество");
		Элементы.ТабПланированияПланНаМесяц.ТекстПодвала = ТабПланирования.Итог("ПланНаМесяцКоличество");
		
	КонецЕсли;

	Элементы.ТабПланированияПланНаМесяцСтарый.ТекстПодвала = ТабПланирования.Итог("ПланНаМесяцСтарый");
	Элементы.ТабПланированияПланНаКварталСтарый.ТекстПодвала = ТабПланирования.Итог("ПланНаКварталСтарый");
	Элементы.ТабПланированияПланНаКвартал.ТекстПодвала = ТабПланирования.Итог("ПланНаКвартал");
	Элементы.ТабПланированияПланНаМесяц.ТекстПодвала = ТабПланирования.Итог("ПланНаМесяц");
	
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		
		Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
			
			Элементы["ПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки);
			Элементы["ПланСтарКоличество_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПланСтарКоличество_" + СтрТаблицаПериоды.ИмяКолонки);
			
		КонецЕсли;
	
		Элементы["План_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки);
		Элементы["ПланСтар_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПланСтар_" + СтрТаблицаПериоды.ИмяКолонки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВидимостьЭлементовОтТипаПлана()

	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		
		Элементы.ТабПланированияМенеджер.Видимость = Ложь;
		Элементы.ТабПланированияСегментНоменклатуры.Видимость = Ложь;
		Элементы.ТабПланированияПодразделение.Видимость = Истина;
		
	ИначеЕсли Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоМенеджерам") Тогда
		
		Элементы.ТабПланированияМенеджер.Видимость = Истина;
		Элементы.ТабПланированияСегментНоменклатуры.Видимость = Ложь;
		Элементы.ТабПланированияПодразделение.Видимость = Ложь;
		
	Иначе	
		
		Элементы.ТабПланированияМенеджер.Видимость = Ложь;
		Элементы.ТабПланированияСегментНоменклатуры.Видимость = Истина;
		Элементы.ТабПланированияПодразделение.Видимость = Ложь;
		
	КонецЕсли;		

КонецПроцедуры	

&НаКлиенте
Процедура ТипУслугиПриИзменении(Элемент)
	
	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		ЗаполнитьДаннымиТабПланированияПоПодразделениям(НовыйДокумент);
	Иначе	
		ЗаполнитьДаннымиТабПланирования(НовыйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаКварталКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение = Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаКварталКоличество;
	КонецЦикла;

	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаМесяцКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение = Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаМесяцКоличество;
	КонецЦикла;
	
    ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры
