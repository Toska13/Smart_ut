Процедура ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре(Параметры) Экспорт
	ИндексЦветаПоУмолчанию	= Константы.CRM_ЦветСобытияВКалендареПоУмолчанию.Получить();
	ОбработкаЗавершена = Истина;
	МассивСсылок = CRM_ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, "Документ.CRM_Взаимодействие",, 1000, Истина);
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	Для Каждого Взаимодействие Из МассивСсылок Цикл
		Попытка
			НачатьТранзакцию();
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("Документ.CRM_Взаимодействие");
			ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", Взаимодействие);
			БлокировкаДанных.Заблокировать();
			ОбновляемоеВзаимодействие	= Взаимодействие.ПолучитьОбъект();
			Если ЗначениеЗаполнено(ОбновляемоеВзаимодействие.ОсновнаяКатегория) Тогда
				ОбновляемоеВзаимодействие.ИндексЦвета	= ОбновляемоеВзаимодействие.ОсновнаяКатегория.ЦветИндекс;
			Иначе
				ОбновляемоеВзаимодействие.ИндексЦвета	= ИндексЦветаПоУмолчанию;
			КонецЕсли;
			Если ЗначениеЗаполнено(ОбновляемоеВзаимодействие.Ответственный) Тогда
				МассивСтрок	= ОбновляемоеВзаимодействие.СвоиЛица.НайтиСтроки(Новый Структура("Лицо", ОбновляемоеВзаимодействие.Ответственный));
				Если МассивСтрок.Количество() = 0 Тогда
					НоваяСтрока	= ОбновляемоеВзаимодействие.СвоиЛица.Вставить(0);
					НоваяСтрока.Лицо	= ОбновляемоеВзаимодействие.Ответственный; 
					НоваяСтрока.ПосетитМероприятие	= 1; 
					СтруктураПоиска	= Новый Структура("ОбъектКонтактнойИнформации", ОбновляемоеВзаимодействие.Ответственный); 
					СписокАдресов	= CRM_ОбщегоНазначенияСервер.СформироватьСписокКонтактнойИнформации(СтруктураПоиска, ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"));
					Если СписокАдресов.Количество() > 0 Тогда
						НоваяСтрока.Адрес	= СписокАдресов[0].Значение.Адрес;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбновляемоеВзаимодействие);
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Взаимодействие);
			ОбъектовОбработано = ОбъектовОбработано + 1;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			// Если не удалось обработать какой-либо документ, повторяем попытку снова.
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Не удалось обработать документ: %1 по причине:""%2';en='Failed to process document: %1 due to:""%2'"), 
				Взаимодействие, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				Взаимодействие.Метаданные(), Взаимодействие, ТекстСообщения);
		КонецПопытки;
	КонецЦикла;
	Если НЕ ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, "Документ.CRM_Взаимодействие") Тогда
		ОбработкаЗавершена = Ложь;
	КонецЕсли;
	Если (ОбъектовОбработано = 0) И (ПроблемныхОбъектов > 0) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Процедуре Документы.CRM_Взаимодействие.ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре не удалось обработать (пропущены): %1';en='Procedure Документы.CRM_Взаимодействие.ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре failed to processed (skipped): %1'"), 
			ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Процедура Документы.CRM_Взаимодействие.ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре обработала очередную порцию интересов: %1';en='Procedure Документы.CRM_Взаимодействие.ОбработатьДанныеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре processed another potion of leads: %1'"),
			ОбъектовОбработано));
	КонецЕсли;
	Параметры.ОбработкаЗавершена = ОбработкаЗавершена;
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсиюЗаполнениеЦветаВКалендаре(Параметры) Экспорт
	ОтработаныВсеВзаимодействия = Ложь;
	Ссылка = "";
	СписокСостояний	= Новый СписокЗначений;
	СписокСостояний.Добавить(Перечисления.CRM_ТипыСостоянийСобытий.ВРаботе);
	СписокСостояний.Добавить(Перечисления.CRM_ТипыСостоянийСобытий.Запланировано);
	Пока НЕ ОтработаныВсеВзаимодействия Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1000
			|	CRM_Взаимодействие.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
			|ГДЕ
			|	CRM_Взаимодействие.Ссылка > &Ссылка
			|	И НЕ CRM_Взаимодействие.ПометкаУдаления
			|	И CRM_Взаимодействие.СтатусВзаимодействия.ТипСостояния В(&СписокСостояний)
			|
			|УПОРЯДОЧИТЬ ПО
			|	CRM_Взаимодействие.Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("СписокСостояний", СписокСостояний);
		РезультатЗапроса = Запрос.Выполнить();
		МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"); 
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, МассивСсылок);
		КоличествоСсылок = МассивСсылок.Количество();
		Если КоличествоСсылок < 1000 Тогда
			ОтработаныВсеВзаимодействия = Истина;
		КонецЕсли;
		Если КоличествоСсылок > 0 Тогда
			Ссылка = МассивСсылок[КоличествоСсылок - 1];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

