#Область Прочее

&НаСервере
Функция ПолучитьТаблицуДляЗагрузкиДанных()
	
	КолонкиВыгрузки = "АртикулКодПоДаннымСклада,НоменклатураПоДаннымСклада,СерияПоДаннымСклада,КоличествоФакт,НомераСтрокФайла";
	ТЗФайла = Документы.смартОтражениеОстатковНоменклатурыСОХ.ПустаяСсылка().Товары.Выгрузить(, КолонкиВыгрузки);
	
	Возврат ТЗФайла;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеИзФайлаСервер(АдресДанных)
	
	Объект.Товары.Очистить();
	
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	Данные.Записать(ИмяВременногоФайла);
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Прочитать(ИмяВременногоФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Удалитьфайлы(ИмяВременногоФайла);
	
	ТЗФайла = ПолучитьТаблицуДляЗагрузкиДанных();
	
	Для каждого стрОбласть Из ТабДокумент.Области Цикл
		
		СтраницаДокумента = ТабДокумент.ПолучитьОбласть(стрОбласть.Имя);
		
		Для н = 2 По СтраницаДокумента.ВысотаТаблицы Цикл
			
			АртикулКодПоДаннымСклада = СокрЛП(СтраницаДокумента.Область(н, 2, н, 2).Текст);
			Если ЗначениеЗаполнено(АртикулКодПоДаннымСклада) Тогда
				
				СерияПоДаннымСклада = СокрЛП(СтраницаДокумента.Область(н, 4, н, 4).Текст);
				НайденныеСтроки = ТЗФайла.НайтиСтроки(Новый Структура("АртикулКодПоДаннымСклада, СерияПоДаннымСклада", АртикулКодПоДаннымСклада, СерияПоДаннымСклада));
				
				Если НайденныеСтроки.Количество() > 0 Тогда
					НоваяСтрока = НайденныеСтроки[0];
					НоваяСтрока.НомераСтрокФайла = СтрШаблон("%1, %2", НоваяСтрока.НомераСтрокФайла, Формат(н, "ЧГ="));
				Иначе
					НоваяСтрока = ТЗФайла.Добавить();
					НоваяСтрока.НомераСтрокФайла = Формат(н, "ЧГ=");
				КонецЕсли;
			
				НоваяСтрока.АртикулКодПоДаннымСклада = АртикулКодПоДаннымСклада;
				НоваяСтрока.НоменклатураПоДаннымСклада = СокрЛП(СтраницаДокумента.Область(н, 3, н, 3).Текст);
				НоваяСтрока.СерияПоДаннымСклада = СерияПоДаннымСклада;
				НоваяСтрока.КоличествоФакт = НоваяСтрока.КоличествоФакт + 
											 СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтраницаДокумента.Область(н, 6, н, 6).Текст);
				
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗагрузитьДанныеОбработатьПолученнуюТаблицу(ТЗФайла);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеОбработатьПолученнуюТаблицу(ТЗСДанымиДляЗагрузки)

	МассивВидовНоменклатуры = ПолучитьМассивВидовНоменклатурыСУчетомПоСериям();
	ТаблицаПользовательскихСоответствий = ПолучитьПользовательскиеСоответствия(ТЗСДанымиДляЗагрузки);
	
	Для каждого стрТЗФайла Из ТЗСДанымиДляЗагрузки Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стрТЗФайла);
		
		ПользовательскоеСоответствие = ТаблицаПользовательскихСоответствий.НайтиСтроки(Новый Структура("АртикулКодПоДаннымСклада", стрТЗФайла.АртикулКодПоДаннымСклада));
		НоваяСтрока.Исключить = ПользовательскоеСоответствие[0].Исключить;
		
		Если ПользовательскоеСоответствие[0].РучноеСопоставление Тогда
			
			НоваяСтрока.РучноеСопоставление = ПользовательскоеСоответствие[0].РучноеСопоставление;
			НоваяСтрока.Номенклатура = ПользовательскоеСоответствие[0].Номенклатура;
			НоваяСтрока.Серия = ПользовательскоеСоответствие[0].Серия;
			
		Иначе
		
			МассивКодАртикул = СтрРазделить(стрТЗФайла.АртикулКодПоДаннымСклада, ".", Истина);
			Если МассивКодАртикул.Количество() = 1 Тогда
				НоваяСтрока.Номенклатура = НайтиНоменклатуруПоКодуИлиАртикулу(МассивКодАртикул[0]);
			ИначеЕсли МассивКодАртикул.Количество() = 2 Тогда
				НоваяСтрока.Номенклатура = НайтиНоменклатуруПоКодуИлиАртикулу(МассивКодАртикул[0], МассивКодАртикул[1]);
			Иначе
				КодДляПоиска = МассивКодАртикул[МассивКодАртикул.Количество() - 1];
				АртикулДляПоиска = Лев(стрТЗФайла.АртикулКодПоДаннымСклада, СтрДлина(стрТЗФайла.АртикулКодПоДаннымСклада) - СтрДлина(КодДляПоиска) - 1);
				НоваяСтрока.Номенклатура = НайтиНоменклатуруПоКодуИлиАртикулу(АртикулДляПоиска, КодДляПоиска);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(ПользовательскоеСоответствие[0].Номенклатура) Тогда
				НоваяСтрока.Номенклатура = ПользовательскоеСоответствие[0].Номенклатура;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) И ЗначениеЗаполнено(НоваяСтрока.СерияПоДаннымСклада) 
				 И МассивВидовНоменклатуры.Найти(НоваяСтрока.Номенклатура.ВидНоменклатуры) <> Неопределено Тогда
				 
				НоваяСтрока.Серия = НайтиСериюНоменклатуры(НоваяСтрока.Номенклатура, НоваяСтрока.СерияПоДаннымСклада);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаполнитьУчетноеКоличество();
	
	КоличествоСтрок = Объект.Товары.Количество();
	КоличествоУдаленныхСтрок = 0;
	НумераторСтрок = 0;
	Пока НумераторСтрок < КоличествоСтрок - КоличествоУдаленныхСтрок - 1 Цикл
		
		стрТовары = Объект.Товары[НумераторСтрок];
		 
		Если МассивВидовНоменклатуры.Найти(стрТовары.Номенклатура.ВидНоменклатуры) = Неопределено Тогда
			
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АртикулКодПоДаннымСклада,Номенклатура",
																		 стрТовары.АртикулКодПоДаннымСклада, стрТовары.Номенклатура));
			МассивСерий = Новый Массив;
			Если ЗначениеЗаполнено(стрТовары.СерияПоДаннымСклада) Тогда
			 	МассивСерий.Добавить(стрТовары.СерияПоДаннымСклада);
			КонецЕсли;
			МассивСтрок = Новый Массив;
			МассивСтрок.Добавить(стрТовары.НомераСтрокФайла);
			 
			Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
				
				Если стрНайденныеСтроки <> стрТовары Тогда
					
					стрТовары.КоличествоФакт = стрТовары.КоличествоФакт + стрНайденныеСтроки.КоличествоФакт;
					Если ЗначениеЗаполнено(стрНайденныеСтроки.СерияПоДаннымСклада) Тогда
						МассивСерий.Добавить(стрНайденныеСтроки.СерияПоДаннымСклада);
					КонецЕсли;
					
					Объект.Товары.Удалить(стрНайденныеСтроки);
					КоличествоУдаленныхСтрок = КоличествоУдаленныхСтрок + 1;
					МассивСтрок.Добавить(стрНайденныеСтроки.НомераСтрокФайла);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если МассивСерий.Количество() > 0 Тогда
				стрТовары.СерияПоДаннымСклада = СтрСоединить(МассивСерий, ", ");
			КонецЕсли;
			стрТовары.НомераСтрокФайла = СтрСоединить(МассивСтрок, ", ");
			
		КонецЕсли;
		
		НумераторСтрок = НумераторСтрок + 1;
		
	КонецЦикла;
	
	ОбновитьИнформациюОРасхожденииПоСтрокамДокумента();
	РассчитатьИтоги();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПользовательскиеСоответствия(ТЗФайла)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗФайла", ТЗФайла);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗ.АртикулКодПоДаннымСклада КАК АртикулКодПоДаннымСклада
	|ПОМЕСТИТЬ ВТДанныеИзФайла
	|ИЗ
	|	&ТЗФайла КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТДанныеИзФайла.АртикулКодПоДаннымСклада КАК АртикулКодПоДаннымСклада,
	|	МАКСИМУМ(СОХТовары.Ссылка.Дата) КАК Дата
	|ПОМЕСТИТЬ ВТДатыПоследнихДокументовПоСкладу
	|ИЗ
	|	ВТДанныеИзФайла КАК ВТДанныеИзФайла
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартОтражениеОстатковНоменклатурыСОХ.Товары КАК СОХТовары
	|		ПО ВТДанныеИзФайла.АртикулКодПоДаннымСклада = СОХТовары.АртикулКодПоДаннымСклада
	|			И (СОХТовары.Ссылка.Дата <= &Дата)
	|			И (СОХТовары.Ссылка <> &Ссылка)
	|			И (НЕ СОХТовары.Ссылка.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДанныеИзФайла.АртикулКодПоДаннымСклада
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТДатыПоследнихДокументовПоСкладу.АртикулКодПоДаннымСклада КАК АртикулКодПоДаннымСклада,
	|	ЕСТЬNULL(смартОтражениеОстатковНоменклатурыСОХТовары.Исключить, ЛОЖЬ) КАК Исключить,
	|	ЕСТЬNULL(смартОтражениеОстатковНоменклатурыСОХТовары.РучноеСопоставление, ЛОЖЬ) КАК РучноеСопоставление,
	|	смартОтражениеОстатковНоменклатурыСОХТовары.Номенклатура КАК Номенклатура,
	|	смартОтражениеОстатковНоменклатурыСОХТовары.Серия КАК Серия
	|ИЗ
	|	ВТДатыПоследнихДокументовПоСкладу КАК ВТДатыПоследнихДокументовПоСкладу
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартОтражениеОстатковНоменклатурыСОХ.Товары КАК смартОтражениеОстатковНоменклатурыСОХТовары
	|		ПО ВТДатыПоследнихДокументовПоСкладу.АртикулКодПоДаннымСклада = смартОтражениеОстатковНоменклатурыСОХТовары.АртикулКодПоДаннымСклада
	|			И ВТДатыПоследнихДокументовПоСкладу.Дата = смартОтражениеОстатковНоменклатурыСОХТовары.Ссылка.Дата";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция НайтиНоменклатуруПоКодуИлиАртикулу(Артикул = Неопределено, Код = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		Номенклатура.Ссылка КАК Ссылка,
	|		1 КАК Приоритет
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Код = &Код
	|		И НЕ &Код = НЕОПРЕДЕЛЕНО
	|		И НЕ &Код = """"
	|		И НЕ Номенклатура.ЭтоГруппа
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Номенклатура.Ссылка,
	|		2
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Артикул = &Артикул
	|		И НЕ &Артикул = НЕОПРЕДЕЛЕНО
	|		И НЕ &Артикул = """"
	|		И НЕ Номенклатура.ЭтоГруппа) КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	КодСПрефиксом = Код;
	Если ЗначениеЗаполнено(Код) Тогда
		ПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазы(Справочники.Номенклатура.ПустаяСсылка(), , КодСПрефиксом);
	КонецЕсли;
	Запрос.УстановитьПараметр("Код", КодСПрефиксом);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Ссылка <> NULL Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиСериюНоменклатуры(Номенклатура, СерияПоДаннымСклада)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка КАК Ссылка,
	|		1 КАК Приоритет
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Наименование = &Наименование
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка,
	|		2
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Номер = &Номер
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка,
	|		3
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Номер = &НомБезДаты
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры) КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СерияПоДаннымСклада);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ПолучитьВладельцаСерий(Номенклатура));
	
	МассивНомеров = СтрРазделить(СерияПоДаннымСклада, ",", Истина);
	Запрос.УстановитьПараметр("Номер", МассивНомеров[0]);
	Запрос.УстановитьПараметр("НомБезДаты", МассивНомеров[0]);
	
	Если МассивНомеров.Количество() > 1 Тогда
		
		ДатаСерии = СтроковыеФункцииКлиентСервер.СтрокаВДату(СокрЛП(МассивНомеров[1]));
		Если ЗначениеЗаполнено(ДатаСерии) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "СерииНоменклатуры.Номер = &Номер",
													 "СерииНоменклатуры.Номер = &Номер И СерииНоменклатуры.ГоденДо = &Дата");
			Запрос.УстановитьПараметр("Дата", ДатаСерии);
		КонецЕсли;
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВладельцаСерий(Номенклатура)
	
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ВидНоменклатуры, ВидНоменклатуры.ВладелецСерий");
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.ВидНоменклатурыВладелецСерий) Тогда
		Возврат ДанныеНоменклатуры.ВидНоменклатурыВладелецСерий;
	Иначе
		Возврат ДанныеНоменклатуры.ВидНоменклатуры;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьУчетноеКоличество(НомерСтроки = Неопределено)
	
	//удаляем все что не из файла
	НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("АртикулКодПоДаннымСклада", ""));
	Для каждого стрНайденнаяСтрока Из НайденныеСтроки Цикл
		Объект.Товары.Удалить(стрНайденнаяСтрока);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидыНоменклатурыССериями", ПолучитьМассивВидовНоменклатурыСУчетомПоСериям());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Серия КАК Серия,
	|	Т.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТНоменклатура
	|ИЗ
	|	&ТЗ КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.ВидНоменклатуры В (&ВидыНоменклатурыССериями)
	|			ТОГДА Т.Серия
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	КОНЕЦ КАК Серия,
	|	СУММА(Т.ВНаличииОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&ДатаОстатков, Склад = &Склад) КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА Т.Номенклатура.ВидНоменклатуры В (&ВидыНоменклатурыССериями)
	|			ТОГДА Т.Серия
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	КОНЕЦ,
	|	Т.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТНоменклатура.Номенклатура КАК Номенклатура,
	|	ВТНоменклатура.Серия КАК Серия,
	|	ВТНоменклатура.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ВТОстатки.Количество, 0) КАК Количество
	|ИЗ
	|	ВТНоменклатура КАК ВТНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТОстатки КАК ВТОстатки
	|		ПО ВТНоменклатура.Номенклатура = ВТОстатки.Номенклатура
	|			И ВТНоменклатура.Серия = ВТОстатки.Серия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТОстатки.Номенклатура,
	|	ВТОстатки.Серия,
	|	-1,
	|	ВТОстатки.Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТНоменклатура КАК ВТНоменклатура
	|		ПО ВТОстатки.Номенклатура = ВТНоменклатура.Номенклатура
	|			И ВТОстатки.Серия = ВТНоменклатура.Серия
	|ГДЕ
	|	ВТНоменклатура.НомерСтроки ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("ДатаОстатков", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Объект.Склад);
	Запрос.УстановитьПараметр("ТЗ", Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Серия"));
	
	Если НЕ НомерСтроки = Неопределено Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТЗ КАК Т", "&ТЗ КАК Т
															  |ГДЕ
															  |	Т.НомерСтроки = &НомерСтроки");
		Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НомерСтроки <> -1 Тогда
			
			стрТовары = Объект.Товары[Выборка.НомерСтроки - 1];
			стрТовары.КоличествоУчет = Выборка.Количество;
			Если стрТовары.КоличествоУчет <> стрТовары.КоличествоФакт Тогда
				стрТовары.ЕстьРасхождения = Истина;
			Иначе
				стрТовары.ЕстьРасхождения = Ложь;
			КонецЕсли;
			
		Иначе
			
			стрТовары = Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(стрТовары, Выборка, "Номенклатура,Серия");
			стрТовары.КоличествоУчет = Выборка.Количество;
			стрТовары.ЕстьРасхождения = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	РассчитатьИтоги();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОРасхожденииПоСтрокамДокумента()
	
	Для каждого стрТовары Из Объект.Товары Цикл
		стрТовары.ЕстьРасхождения = стрТовары.КоличествоУчет <> стрТовары.КоличествоФакт;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОчиститьСерию(ИДСтроки)
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ИДСтроки);
	Если ТекущаяСтрока.Серия.ВидНоменклатуры <> ПолучитьВладельцаСерий(ТекущаяСтрока.Номенклатура) Тогда
		ТекущаяСтрока.Серия = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтоги()
	
	ТЗТовары = Объект.Товары.Выгрузить(Новый Структура("Исключить", Ложь));
	ИтогоУчетноеКоличество = ТЗТовары.Итог("КоличествоУчет");
	ИтогоФактическоеКоличество = ТЗТовары.Итог("КоличествоФакт");
	
	Объект.ЕстьРасхождение = Ложь;
	Для каждого стрТовары Из Объект.Товары Цикл
		Если стрТовары.КоличествоУчет <> стрТовары.КоличествоФакт И НЕ стрТовары.Исключить Тогда
			Объект.ЕстьРасхождение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.ЕстьРасхождение Тогда
		ИнформацияОРасхождении = "Есть расхождение";
	Иначе
		ИнформацияОРасхождении = "Расхождения нет";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборТабличнойЧастиТовары()
	
	СтруктураОтбора = Новый Структура;
	
	Если Элементы.ТоварыПоказыватьТолькоРасхождения.Пометка Тогда
		СтруктураОтбора.Вставить("ЕстьРасхождения", Истина);
	КонецЕсли;
	
	Если НЕ Элементы.ТоварыПоказыватьИсключенные.Пометка Тогда
		СтруктураОтбора.Вставить("Исключить", Ложь);
	КонецЕсли;
	
	Если СтруктураОтбора.Количество() > 0 Тогда
		Элементы.Товары.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	Иначе
		Элементы.Товары.ОтборСтрок = Неопределено;
	КонецЕсли;
	
	Элементы.Товары.Обновить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивВидовНоменклатурыСУчетомПоСериям()
	
	МассивВидовНоменклатуры = Новый Массив;
	МассивВидовНоменклатуры.Добавить(Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ТоварПлоттерыСерии"));
	
	Возврат МассивВидовНоменклатуры;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеССервераАдмиралНаСервере()
	
	Объект.Товары.Очистить();
	
	ТЗСайта = ПолучитьТаблицуДляЗагрузкиДанных();
	
	ПолученныеДанные = смартИнтеграцияСАдмирал.ПолучитьОстаткиАдмирал(Объект.Дата + 86400,, (Объект.Склад = Справочники.смартПредопределенныеЗначения.СкладАдмиралКовчег.Значение));
	Если ТипЗнч(ПолученныеДанные) = Тип("Структура") Тогда
		
		Для каждого стрТовары Из ПолученныеДанные.goods Цикл
			
			НоваяСтрока = ТЗСайта.Добавить();
			
			НоваяСтрока.АртикулКодПоДаннымСклада = стрТовары.product_id_ext;
			НоваяСтрока.НоменклатураПоДаннымСклада = стрТовары.product_name;
			НоваяСтрока.СерияПоДаннымСклада = стрТовары.serial;
			НоваяСтрока.КоличествоФакт = стрТовары.quantity;
											 
		КонецЦикла;
		
	КонецЕсли;
	
	ЗагрузитьДанныеОбработатьПолученнуюТаблицу(ТЗсайта);
	
КонецПроцедуры

#КонецОбласти 

