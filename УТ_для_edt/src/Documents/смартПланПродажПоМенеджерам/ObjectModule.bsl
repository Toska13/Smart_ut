#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Ссылка.Проведен и РежимЗаписи=РежимЗаписиДокумента.ОтменаПроведения ТОгда
		Запрос=Новый Запрос("ВЫБРАТЬ
						|	смартКорректировкаПланаПродаж.Ссылка КАК Ссылка
						|ИЗ
						|	Документ.смартКорректировкаПланаПродаж КАК смартКорректировкаПланаПродаж
						|ГДЕ
						|	смартКорректировкаПланаПродаж.ДокументОснование = &Ссылка
						|	И смартКорректировкаПланаПродаж.Проведен");
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() ТОгда
			ОбщегоНазначения.СообщитьПользователю("На основании документа создана корректировка, отмена проведения недопустима!");	
			Отказ=Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.смартПланПродажПоМенеджерам.Записывать = Истина;
	Если Статус=перечисления.смартСтатусыПланаПродаж.Утвержден Тогда
		Для Каждого ТекСтрокаПланирование Из Планирование Цикл
			
			Движение = Движения.смартПланПродажПоМенеджерам.Добавить();
			Движение.Период = ТекСтрокаПланирование.Период;
			Движение.ВидПлана = ВидПлана;
			Движение.ТипУслуги = ТипУслуги;
			Движение.Менеджер = ТекСтрокаПланирование.Менеджер;
			Движение.Подразделение = ТекСтрокаПланирование.Подразделение;
			Движение.СегментНоменклатуры = ТекСтрокаПланирование.СегментНоменклатуры;
			Движение.Количество = ТекСтрокаПланирование.НовыйПланКоличество;
			Движение.Цена = ТекСтрокаПланирование.Цена;
			Движение.Сумма = ТекСтрокаПланирование.НовыйПлан;
			Движение.СуммаРегл = ТекСтрокаПланирование.НовыйПлан*КурсДляРасчетаРублевогоПлана;
			Движение.КоэффициентИзменения = ТекСтрокаПланирование.КоэффициентИзменения;
			Движение.Комментарий = ТекСтрокаПланирование.Комментарий;
			
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
