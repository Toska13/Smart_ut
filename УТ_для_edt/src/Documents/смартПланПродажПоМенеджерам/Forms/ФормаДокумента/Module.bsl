&НаКлиенте
Процедура ТабПланированияПланНаКварталЦенаПриИзменении(Элемент)
	
	ТабПланированияПланНаКварталКоличествоПриИзменении(Элемент);
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.ПланНаКвартал = ТекущиеДанные.ПланНаКварталЦена * ТекущиеДанные.ПланНаКварталКоличество;
	ТекущиеДанные.ПланНаСледПериодЦена = ?(ТекущиеДанные.ПланНаСледПериодКоличество > 0, 
		ТекущиеДанные.ПланНаСледПериод / ТекущиеДанные.ПланНаСледПериодКоличество, 0);
		
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаМесяцЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ПланНаМесяцКоличество = ТекущиеДанные.ПланНаМесяцКоличество;
	ПланНаМесяцЦена = ТекущиеДанные.ПланНаМесяцЦена;
	
	ТекущиеДанные.ПланНаСледПериод = ПланНаМесяцЦена * ТекущиеДанные.ПланНаСледПериодКоличество;
	ТекущиеДанные.РучноеИзменение = Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаМесяцКоличество * ПланНаМесяцЦена;
	КонецЦикла;
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.ПланНаМесяц = ТекущиеДанные.ПланНаМесяцЦена * ТекущиеДанные.ПланНаМесяцКоличество;
	ТекущиеДанные.ПланНаСледПериодЦена = ?(ТекущиеДанные.ПланНаСледПериодКоличество > 0, 
		ТекущиеДанные.ПланНаСледПериод / ТекущиеДанные.ПланНаСледПериодКоличество, 0);
	
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаСледПериодЦенаПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.ПланНаСледПериод = ТекущиеДанные.ПланНаСледПериодЦена * ТекущиеДанные.ПланНаСледПериодКоличество;
	
	Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
		
		ТекущиеДанные.ПланНаКвартал = ТекущиеДанные.ПланНаСледПериодЦена * ТекущиеДанные.ПланНаКварталКоличество;
		ТекущиеДанные.ПланНаКварталЦена = ?(ТекущиеДанные.ПланНаКварталКоличество > 0, 
			ТекущиеДанные.ПланНаКвартал / ТекущиеДанные.ПланНаКварталКоличество, 0);
		
		ТабПланированияПланНаКварталПриИзменении(Элемент);
		
	Иначе
		
		ТекущиеДанные.ПланНаМесяц = ТекущиеДанные.ПланНаСледПериодЦена * ТекущиеДанные.ПланНаМесяцКоличество;
		ТекущиеДанные.ПланНаМесяцЦена = ?(ТекущиеДанные.ПланНаМесяцКоличество > 0, 
			ТекущиеДанные.ПланНаМесяц / ТекущиеДанные.ПланНаМесяцКоличество, 0);
		
		ТабПланированияПланНаМесяцПриИзменении(Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыбраныСегментыДляВнесенияВПлан" Тогда
		
		СписокВыбранных = Параметр;
		ДобавленыСегменты = Ложь;
		
		Для Каждого ЭлементСписка Из СписокВыбранных Цикл
				
			СтрокиТабПланирования = ЭтаФорма.ТабПланирования.НайтиСтроки(Новый Структура("СегментНоменклатуры", ЭлементСписка.Значение));
			Если СтрокиТабПланирования.Количество() > 0 Тогда
				ОбщегоназначенияКлиент.СообщитьПользователю("Сегмент номенклатуры " + ЭлементСписка.Значение + " уже присутствет в таблице");
				Продолжить;
			КонецЕсли;
			
			СтрТабПланирования = ТабПланирования.Добавить();	
			СтрТабПланирования.СегментНоменклатуры = ЭлементСписка.Значение;
			ЭтаФорма.Модифицированность = Истина;
			ДобавленыСегменты = Истина;
				
		КонецЦикла;
		
		Если ДобавленыСегменты Тогда
			
			Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
				ОбновитьДанныеВТаблице();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПартнерыИсключенияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ОбновитьДанныеВТаблице();
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Функция ПолучитьРозничнуюЦенуПоСегменту(СегментНоменклатуры)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * КурсыВалютСрезПоследних.Курс КАК Цена
	|ПОМЕСТИТЬ ЦенаВРублях
	|ИЗ
	|	Справочник.СегментыНоменклатуры КАК СегментыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
	|			ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	|		ПО СегментыНоменклатуры.смартТоварСегмента = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И СегментыНоменклатуры.смартВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|ГДЕ
	|	СегментыНоменклатуры.Ссылка = &СегментНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦенаВРублях.Цена / КурсыВалютСрезПоследних.Курс КАК ЦенаВЕВРО
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &EUR) КАК КурсыВалютСрезПоследних,
	|	ЦенаВРублях КАК ЦенаВРублях");
	Запрос.УстановитьПараметр("СегментНоменклатуры", СегментНоменклатуры);
	Запрос.УстановитьПараметр("EUR", Константы.ВалютаУправленческогоУчета.Получить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ЦенаВЕВРО, 0);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуРозничныхЦенПоСегментам()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СегментыНоменклатуры.Ссылка КАК СегментНоменклатуры,
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * КурсыВалютСрезПоследних.Курс КАК Цена
	|ПОМЕСТИТЬ ЦенаВРублях
	|ИЗ
	|	Справочник.СегментыНоменклатуры КАК СегментыНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
	|			ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	|		ПО СегментыНоменклатуры.смартТоварСегмента = ЦеныНоменклатурыСрезПоследних.Номенклатура
	|			И СегментыНоменклатуры.смартВидЦены = ЦеныНоменклатурыСрезПоследних.ВидЦены
	|ГДЕ
	|	СегментыНоменклатуры.смартИспользуетсяВПланированииПродаж
	|	И НЕ СегментыНоменклатуры.ПометкаУдаления
	|	И НЕ СегментыНоменклатуры.ЭтоГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦенаВРублях.СегментНоменклатуры КАК СегментНоменклатуры,
	|	ЦенаВРублях.Цена / КурсыВалютСрезПоследних.Курс КАК ЦенаВЕВРО
	|ИЗ
	|	РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &EUR) КАК КурсыВалютСрезПоследних,
	|	ЦенаВРублях КАК ЦенаВРублях");
	Запрос.УстановитьПараметр("EUR", Константы.ВалютаУправленческогоУчета.Получить());
	
	ЭтаФорма.ТаблицаРозничныхЦен.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
Процедура ТипУслугиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Обработчик = Новый ОписаниеОповещения("ВыбранСегментДляТипаНоменклатуры", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("Отбор", Новый Структура("смартИспользуетсяКакТипНоменклатуры", Истина));
	
	ОткрытьФорму("Справочник.СегментыНоменклатуры.ФормаВыбора", ПараметрыОткрытия, 
		ЭтотОбъект, , , , Обработчик, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры //-- #Б-2220 смарт: Фролов 28.02.2025
	
