	ПланНаМесяцКоличество = ТекущиеДанные.ПланНаМесяцКоличество;
	ПланНаМесяцЦена = ТекущиеДанные.ПланНаМесяцЦена;
	
	ТекущиеДанные.ПланНаСледПериодКоличество = ПланНаМесяцКоличество * ТаблицаПериоды.Количество();
	ТекущиеДанные.ПланНаСледПериод = ПланНаМесяцЦена * ТекущиеДанные.ПланНаСледПериодКоличество;
	ТекущиеДанные.РучноеИзменение = Истина; 

