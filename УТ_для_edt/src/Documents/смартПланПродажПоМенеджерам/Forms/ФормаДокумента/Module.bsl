&НаСервере
Процедура ЗаполнитьДанныеПредыдущегоПериодаПоСегментам(МассивСегментНоменклатуры, НачалоПериода, ОкончаниеПериода)
	
	Запрос=Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сегмент КАК СегментНоменклатуры,
	|	Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НоменклатураСегментов
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента
	|ГДЕ
	|	Сегмент В(&МассивСегментНоменклатуры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НоменклатураСегментов.СегментНоменклатуры КАК СегментНоменклатуры,
	|	СУММА(ВыручкаОбороты.КоличествоОборот) КАК КоличествоФакт,
	|	СУММА(ВыручкаОбороты.СуммаВыручкиОборот) КАК СуммаФакт
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			смартДатаЗакрытияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер В ИЕРАРХИИ (&СмартГруппаКомпаний)
	|				И АналитикаУчетаНоменклатуры.Номенклатура В
	|					(ВЫБРАТЬ
	|						Номенклатура
	|					ИЗ
	|						НоменклатураСегментов)) КАК ВыручкаОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураСегментов КАК НоменклатураСегментов
	|		ПО ВыручкаОбороты.АналитикаУчетаНоменклатуры.Номенклатура = НоменклатураСегментов.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	НоменклатураСегментов.СегментНоменклатуры");
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);
	Запрос.УстановитьПараметр("МассивСегментНоменклатуры", МассивСегментНоменклатуры);
	Запрос.УстановитьПараметр("СмартГруппаКомпаний", ЭтаФорма.ПартнерыИсключения);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ЭлементМассива Из МассивСегментНоменклатуры Цикл
		
		СтрокиТабПланирования = ТабПланирования.НайтиСтроки(Новый Структура("СегментНоменклатуры", ЭлементМассива));
		Если СтрокиТабПланирования.Количество() > 0 Тогда
			СтрТабПланирования = СтрокиТабПланирования[0];
		Иначе
			СтрТабПланирования = ТабПланирования.Добавить();
			СтрТабПланирования.СегментНоменклатуры = ЭлементМассива;
		КонецЕсли;
		
		СтрокиРез = Таблица.НайтиСтроки(Новый Структура("СегментНоменклатуры", ЭлементМассива));
		Если СтрокиРез.Количество() > 0 Тогда
			
			СтрТабПланирования.ИтогоЗаПредПериод = СтрокиРез[0].СуммаФакт;
			СтрТабПланирования.ИтогоЗаПредПериодКоличество = СтрокиРез[0].КоличествоФакт;
			СтрТабПланирования.ИтогоЗаПредПериодЦена = СтрокиРез[0].СуммаФакт / ?(СтрокиРез[0].КоличествоФакт = 0, 1, СтрокиРез[0].КоличествоФакт);
			
		Иначе
			
			СтрТабПланирования.ИтогоЗаПредПериод = 0;
			СтрТабПланирования.ИтогоЗаПредПериодКоличество = 0;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПредставлениеПредПериод = ПредставлениеПериода(ДобавитьМесяц(НачалоМесяца(Объект.НачалоПериода), -12),
		ДобавитьМесяц(КонецМесяца(Объект.ОкончаниеПериода), -12), "ФП = Истина");
	Элементы.ТабПланированияИтогоЗаПредПериод.Заголовок = "Итого за " + ПредставлениеПредПериод;
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
Функция ПолучитьМассивНоменклатурыПоСегменту()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента
	|ГДЕ
	|	Сегмент = &ТипУслуги");
	Запрос.УстановитьПараметр("ТипУслуги", Объект.ТипУслуги);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
КонецФункции //-- #Б-2220 смарт: Фролов 28.02.2025	

&НаКлиенте
Процедура КоэффициентИзмененияОбщийПриИзменении(Элемент)
	ЗаполнитьДанныеПланаПоПериодам();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПланаПоПериодам()
	
	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
		
		ЗаполнитьТаблицуРозничныхЦенПоСегментам();
		
		Для Каждого Стр Из ТабПланирования Цикл 
			
			Если НЕ Стр.РучноеИзменение Тогда 
				
				СтрокиТаблицаРозничныхЦен = ТаблицаРозничныхЦен.НайтиСтроки(Новый Структура("СегментНоменклатуры", Стр.СегментНоменклатуры));
				
				Если СтрокиТаблицаРозничныхЦен.Количество() > 0 Тогда
					ЦенаРозничная = СтрокиТаблицаРозничныхЦен[0].ЦенаВЕВРО;
				Иначе
					ЦенаРозничная = 0;
				КонецЕсли;	
				
				Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
					
					НовыйНаКварталЦена = ЦенаРозничная * 3; 
					Если НовыйНаКварталЦена > Окр(НовыйНаКварталЦена, 0) Тогда
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена + 1, 0);
					Иначе
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена, 0);
					КонецЕсли;
					
					НовыйНаКварталКоличество = Стр.ИтогоЗаПредПериодКоличество * Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					Если НовыйНаКварталКоличество > Окр(НовыйНаКварталКоличество, 0) Тогда
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество + 1, 0);
					Иначе
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
					КонецЕсли;
					
					Стр.ПланНаКвартал = Стр.ПланНаКварталЦена * Стр.ПланНаКварталКоличество;
					
				Иначе
					
					НовыйНаМесяцЦена = ЦенаРозничная;
					Если НовыйНаМесяцЦена > Окр(НовыйНаМесяцЦена, 0) Тогда
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена + 1, 0);
					Иначе
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена, 0);
					КонецЕсли;
					
					НовыйНаМесяцКоличество = Стр.ИтогоЗаПредПериодКоличество * Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					Если НовыйНаМесяцКоличество > Окр(НовыйНаМесяцКоличество, 0) Тогда
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество + 1, 0);
					Иначе
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
					КонецЕсли;
					
					Стр.ПланНаМесяц = Стр.ПланНаМесяцЦена * Стр.ПланНаМесяцКоличество;
					
				КонецЕсли;
				
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность =
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц);
					Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки]=?(Объект.Периодичность =
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталКоличество, Стр.ПланНаМесяцКоличество);
				КонецЦикла;
				
				Стр.ПланНаСледПериод = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),
					Стр.ПланНаКвартал, Стр.ПланНаМесяц) * ТаблицаПериоды.Количество();	
				Стр.ПланНаСледПериодКоличество = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),
					Стр.ПланНаКварталКоличество, Стр.ПланНаМесяцКоличество) * ТаблицаПериоды.Количество();
				Стр.ПланНаСледПериодЦена = ?(Стр.ПланНаСледПериодКоличество > 0, Стр.ПланНаСледПериод / Стр.ПланНаСледПериодКоличество, 0);	
				
				Стр.ПроцентИзмененияПлана=?(Стр.ИтогоЗаПредПериод=0,0,(Стр.ПланНаСледПериод-Стр.ИтогоЗаПредПериод)/Стр.ИтогоЗаПредПериод)*100;
				
			ИначеЕсли Стр.ПланНаКварталЦена = 0 И Стр.ПланНаМесяцЦена = 0 Тогда
				
				Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
					
					НовыйНаКварталЦена = ?(Стр.ПланНаКварталЦена > 0, Стр.ПланНаКварталЦена, ЦенаРозничная * 3);
					Если НовыйНаКварталЦена > Окр(НовыйНаКварталЦена, 0) Тогда
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена + 1, 0);
					Иначе
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена, 0);
					КонецЕсли;
					
					Стр.ПланНаКвартал = Стр.ПланНаКварталЦена * Стр.ПланНаКварталКоличество;
					
				Иначе
					
					НовыйНаМесяцЦена = ?(Стр.ПланНаМесяцЦена > 0, Стр.ПланНаКварталЦена, ЦенаРозничная);
					Если НовыйНаМесяцЦена > Окр(НовыйНаМесяцЦена, 0) Тогда
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена + 1, 0);
					Иначе
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена, 0);
					КонецЕсли;
					
					Стр.ПланНаМесяц = Стр.ПланНаМесяцЦена * Стр.ПланНаМесяцКоличество;
					
				КонецЕсли;
				
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					
					Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = 
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц);
					
				КонецЦикла;
				
				Стр.ПланНаСледПериод = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц) * ТаблицаПериоды.Количество();
				Стр.ПланНаСледПериодЦена = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталЦена, Стр.ПланНаМесяцЦена);
				Стр.ПроцентИзмененияПлана = ?(Стр.ИтогоЗаПредПериод=0, 0, (Стр.ПланНаСледПериод - Стр.ИтогоЗаПредПериод) / Стр.ИтогоЗаПредПериод) * 100;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе	
		
		Для Каждого Стр Из ТабПланирования Цикл 
			
			Если НЕ Стр.РучноеИзменение Тогда 
				
				Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
					
					НовыйНаКвартал = Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					
					Если НовыйНаКвартал > Окр(НовыйНаКвартал, -3) Тогда
						Стр.ПланНаКвартал = Окр(НовыйНаКвартал + 500, -3);
					Иначе
						Стр.ПланНаКвартал = Окр(НовыйНаКвартал, -3);
					КонецЕсли;
					
				Иначе
					
					НовыйНаМесяц = Стр.ИтогоЗаПредПериод * Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					
					Если НовыйНаМесяц > Окр(НовыйНаМесяц, -3) Тогда
						Стр.ПланНаМесяц = Окр(НовыйНаМесяц + 500, -3);
					Иначе
						Стр.ПланНаМесяц = Окр(НовыйНаМесяц, -3);
					КонецЕсли;
					
				КонецЕсли;
				
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц);
				КонецЦикла;
				
				Стр.ПланНаСледПериод = ?(Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),
					Стр.ПланНаКвартал, Стр.ПланНаМесяц) * ТаблицаПериоды.Количество();	
				
				Стр.ПроцентИзмененияПлана = ?(Стр.ИтогоЗаПредПериод = 0, 0, (Стр.ПланНаСледПериод - Стр.ИтогоЗаПредПериод) / Стр.ИтогоЗаПредПериод) * 100;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаМесяцПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ПланНаМесяц = ТекущиеДанные.ПланНаМесяц;
	
	ТекущиеДанные.ПланНаСледПериод = ПланНаМесяц * ТаблицаПериоды.Количество();
	
	ТекущиеДанные.ПланНаСледПериодЦена = ?(ТекущиеДанные.ПланНаСледПериодКоличество > 0, 
		ТекущиеДанные.ПланНаСледПериод / ТекущиеДанные.ПланНаСледПериодКоличество, 0);
	
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
	ТекущиеДанные.РучноеИзменение = Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаМесяц;
	КонецЦикла;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаСледПериодПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	
	Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
		
		ТекущиеДанные.ПланНаКвартал = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), -3);
		ТабПланированияПланНаКварталПриИзменении(Элемент);
		
	Иначе
		
		ТекущиеДанные.ПланНаМесяц = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), 0);
		ТабПланированияПланНаМесяцПриИзменении(Элемент);
		
	КонецЕсли;
	
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
		
	ТекущиеДанные.РучноеИзменение = Истина;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Объект.Планирование.Очистить();
	ТабПланирования.Сортировать("Менеджер Возр, Подразделение Возр, СегментНоменклатуры Возр");
	
	Для Каждого Стр Из ТабПланирования Цикл 
		
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрПланирование = Объект.Планирование.Добавить();
			СтрПланирование.Менеджер = Стр.Менеджер;
			СтрПланирование.Подразделение = Стр.Подразделение;
			СтрПланирование.СегментНоменклатуры = Стр.СегментНоменклатуры;
			СтрПланирование.Период = СтрТаблицаПериоды.ДатаНачала;
			СтрПланирование.КоэффициентИзменения = ?(Стр.РучноеИзменение, ?(Стр.ИтогоЗаПредПериод > 0,
			Стр.ПланНаСледПериод / Стр.ИтогоЗаПредПериод, 0), Объект.КоэффициентИзмененияОбщий);
			СтрПланирование.РучноеИзменение = Стр.РучноеИзменение;
			СтрПланирование.Комментарий = Стр.Комментарий;
			СтрПланирование.НовыйПлан = Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
			
			Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
				СтрПланирование.НовыйПланКоличество = Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
				Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
					СтрПланирование.Цена = Стр.ПланНаКварталЦена;
				Иначе	
					СтрПланирование.Цена = Стр.ПланНаМесяцЦена;
				КонецЕсли;	
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЦикла;
	
	Объект.ПартнерыИсключения.Очистить();
	Для Каждого СтрПартнерыИсключения Из ЭтаФорма.ПартнерыИсключения Цикл
		
		НоваяСтрока = Объект.ПартнерыИсключения.Добавить();
		НоваяСтрока.Партнер = СтрПартнерыИсключения.Значение;	
		
	КонецЦикла;	
	
КонецПроцедуры

