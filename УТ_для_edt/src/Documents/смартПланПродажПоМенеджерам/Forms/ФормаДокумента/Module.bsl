&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	Оповещение = Новый ОписаниеОповещения(
		"УстановитьИнтервалЗавершение",
		ЭтотОбъект);
		
	ОбщегоНазначенияУТКлиент.РедактироватьПериод(
		Объект, 
		Новый Структура("ДатаНачала, ДатаОкончания", "НачалоПериода", "ОкончаниеПериода"),
		Оповещение);
КонецПроцедуры 
	
&НаКлиенте
Процедура УстановитьИнтервалЗавершение(Период, ДополнительныеПараметры) Экспорт 
	Если Период=Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	ПриИзмененииПериодовНаСервере();
	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		ЗаполнитьТаблицуПланированияФактомПоПодразделениям(ПолучитьСписокПодразделений(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоПодразделениям();
	ИначеЕсли Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
		ЗаполнитьТаблицуПланированияФактомПоСегментам(ПолучитьСписокСегментовНоменклатуры(), Объект.НачалоПериода, Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоСегментам();
	Иначе	
		ЗаполнитьТаблицуПланированияФактом(ПолучитьСписокМенеджеров(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланом();
	КонецЕсли;
	ЗаполнитьДанныеПланаПоПериодам();
	ВывестиДекорациюПериод();
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность=Истина;
	
КонецПроцедуры 

&НаСервере
Процедура ПриИзмененииПериодовНаСервере(КорректироватьНачалоОкончаниеПериода = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл
		Стр.Замещен=Истина;
	КонецЦикла;	
	
	ДобавлениеДатаНачала = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуНачалаПериода(Объект.НачалоПериода, Объект.Периодичность);
	ДобавлениеДатаОкончания = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуОкончанияПериода(ДобавлениеДатаНачала, Объект.Периодичность);
	
	ТекущийПериод = 1;
	
	Пока ДобавлениеДатаНачала < КонецДня(Объект.ОкончаниеПериода) Цикл
		
		НайденныеСтроки = ТаблицаПериоды.НайтиСтроки(Новый Структура("ДатаНачала, ДатаОкончания", ДобавлениеДатаНачала, ДобавлениеДатаОкончания));
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаПериоды.Добавить();
			НоваяСтрока.ИмяКолонки = СтрЗаменить(Строка(Новый УникальныйИдентификатор),"-","_");
		Иначе
			НоваяСтрока = НайденныеСтроки[0];
			НоваяСтрока.Замещен=Ложь;
		КонецЕсли;
		НоваяСтрока.ДатаНачала = ДобавлениеДатаНачала;
		НоваяСтрока.ДатаОкончания = ДобавлениеДатаОкончания;
		
		НоваяСтрока.Заголовок = ПланированиеКлиентСервер.СформироватьЗаголовокПериода(Объект.Периодичность, ДобавлениеДатаНачала, ДобавлениеДатаОкончания, ложь, Ложь);
		
		ДобавлениеДатаНачала = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуНачалаПериода(ДобавлениеДатаОкончания+1 , Объект.Периодичность);
		ДобавлениеДатаОкончания = ПланированиеКлиентСерверПовтИсп.РассчитатьДатуОкончанияПериода(ДобавлениеДатаОкончания+1, Объект.Периодичность);
		
	КонецЦикла;
	УбратьДобавитьКолонкиВТабПланирования();
КонецПроцедуры

&НаСервере
Процедура УбратьДобавитьКолонкиВТабПланирования()
	
	КолонкиДобавляемые = Новый Массив;
	КолонкиУдаляемые = Новый Массив;
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		ЭтоПланПоСегментам = Истина;	
	Иначе		
		ЭтоПланПоСегментам = Ложь;	
	КонецЕсли;	
		
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл 
		
		Если Стр.Замещен Тогда
			
			КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаПлан_" + Стр.ИмяКолонки);
			КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаФакт_" + Стр.ИмяКолонки);
			
			Если НЕ ЭтаФорма.Элементы.Найти("КолонкаПланКоличество_" + Стр.ИмяКолонки) = Неопределено Тогда
				КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаПланКоличество_" + Стр.ИмяКолонки);
				КолонкиУдаляемые.Добавить("ТабПланирования." + "КолонкаФактКоличество_" + Стр.ИмяКолонки);
			КонецЕсли;	
			
		Иначе	
			
			Если ЭтаФорма.Элементы.Найти("КолонкаПлан_" + Стр.ИмяКолонки) = Неопределено ТОгда
				
				КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаПлан_" + Стр.ИмяКолонки,
					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)), "ТабПланирования", Стр.Заголовок));
				КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаФакт_" + Стр.ИмяКолонки,
					Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)), "ТабПланирования" ,Стр.Заголовок));
				
				Если ЭтоПланПоСегментам Тогда
					КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаПланКоличество_" + Стр.ИмяКолонки,
						Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)), "ТабПланирования", Стр.Заголовок));
					КолонкиДобавляемые.Добавить(Новый РеквизитФормы("КолонкаФактКоличество_" + Стр.ИмяКолонки,
						Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10)), "ТабПланирования", Стр.Заголовок));
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	ИзменитьРеквизиты(КолонкиДобавляемые, КолонкиУдаляемые);
	
	МасУдаляемых=ЭтаФорма.ТаблицаПериоды.НайтиСтроки(Новый Структура("Замещен", Истина));
	
	Для Каждого СтрУдаляемых Из МасУдаляемых Цикл
		
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("План_" + СтрУдаляемых.ИмяКолонки));
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("Факт_" + СтрУдаляемых.ИмяКолонки));
		
		Если НЕ ЭтаФорма.Элементы.Найти("ПланКоличество_" + Стр.ИмяКолонки) = Неопределено Тогда
			
			Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("ПланКоличество_" + СтрУдаляемых.ИмяКолонки));
			Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("ФактКоличество_" + СтрУдаляемых.ИмяКолонки));
			Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("ГруппаПлан_" + СтрУдаляемых.ИмяКолонки));
			Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("ГруппаФакт_" + СтрУдаляемых.ИмяКолонки));
			
		КонецЕсли;
		
		Этаформа.Элементы.Удалить(ЭтаФорма.Элементы.Найти("Группа_" + СтрУдаляемых.ИмяКолонки));
		
		ЭтаФорма.ТаблицаПериоды.Удалить(СтрУдаляемых);
		
	КонецЦикла;
	
	Для Каждого Стр Из ЭтаФорма.ТаблицаПериоды Цикл
		
		НовыйЭлемент = Этаформа.Элементы.Вставить("Группа_" + Стр.ИмяКолонки, Тип("ГруппаФормы"),
			ЭтаФорма.Элементы.ТабПланирования, Элементы.ТабПланированияГруппаИтогоЗаТекПериод);
		НовыйЭлемент.Вид = ВидГруппыФормы.ГруппаКолонок;
		НовыйЭлемент.Заголовок = Стр.Заголовок; 
		НовыйЭлемент.Группировка = ГруппировкаКолонок.Горизонтальная;
		НовыйЭлемент.Видимость = Истина;
		НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
		НовыйЭлемент.ОтображатьВШапке = Истина;
		
		Если ЭтоПланПоСегментам Тогда
			
			ДобавленныйПериодПлан=Элементы.Добавить("ГруппаПлан_" + Стр.ИмяКолонки, Тип("ГруппаФормы"), ЭтаФорма.Элементы.Найти("Группа_" + Стр.ИмяКолонки));
			ДобавленныйПериодПлан.Вид = ВидГруппыФормы.ГруппаКолонок;
			ДобавленныйПериодПлан.Заголовок = "План"; 
			ДобавленныйПериодПлан.Группировка = ГруппировкаКолонок.Горизонтальная;
			ДобавленныйПериодПлан.Видимость = Истина;
			ДобавленныйПериодПлан.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
			ДобавленныйПериодПлан.ОтображатьВШапке = Истина;
			
			ДобавленныйПериодПлан=Элементы.Добавить("ПланКоличество_" + Стр.ИмяКолонки, Тип("ПолеФормы"), ЭтаФорма.Элементы.Найти("ГруппаПлан_" + Стр.ИмяКолонки));
			ДобавленныйПериодПлан.Вид = ВидПоляФормы.ПолеВвода;
			ДобавленныйПериодПлан.Заголовок = "Кол."; 
			ДобавленныйПериодПлан.ПутьКДанным = "ТабПланирования" + "." + "КолонкаПланКоличество_" + Стр.ИмяКолонки;
			ДобавленныйПериодПлан.КнопкаВыбора = Истина;
			ДобавленныйПериодПлан.Видимость = Истина;
			ДобавленныйПериодПлан.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
			ДобавленныйПериодПлан.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
			ДобавленныйПериодПлан.УстановитьДействие("ПриИзменении", "ТабПланированияМесяцКоличествоПриИзменении");
			
			ДобавленныйПериодПлан = Элементы.Добавить("План_" + Стр.ИмяКолонки, Тип("ПолеФормы"), ЭтаФорма.Элементы.Найти("ГруппаПлан_" + Стр.ИмяКолонки));
			ДобавленныйПериодПлан.Вид = ВидПоляФормы.ПолеВвода;
			ДобавленныйПериодПлан.Заголовок = "Сумма"; 
			ДобавленныйПериодПлан.ПутьКДанным = "ТабПланирования" + "." + "КолонкаПлан_" + Стр.ИмяКолонки;
			ДобавленныйПериодПлан.КнопкаВыбора = Истина;
			ДобавленныйПериодПлан.Видимость = Истина;
			ДобавленныйПериодПлан.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
			ДобавленныйПериодПлан.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
			ДобавленныйПериодПлан.УстановитьДействие("ПриИзменении", "ТабПланированияМесяцПриИзменении");
			
			ДобавленныйПериодФакт = Элементы.Добавить("ГруппаФакт_" + Стр.ИмяКолонки, Тип("ГруппаФормы"), ЭтаФорма.Элементы.Найти("Группа_" + Стр.ИмяКолонки));
			ДобавленныйПериодФакт.Вид = ВидГруппыФормы.ГруппаКолонок;
			ДобавленныйПериодФакт.Заголовок = "Факт"; 
			ДобавленныйПериодФакт.Группировка = ГруппировкаКолонок.Горизонтальная;
			ДобавленныйПериодФакт.Видимость = Истина;
			ДобавленныйПериодФакт.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
			ДобавленныйПериодФакт.ОтображатьВШапке = Истина;
			
			ДобавленныйПериодФакт = Элементы.Добавить("ФактКоличество_" + Стр.ИмяКолонки, Тип("ПолеФормы"), ЭтаФорма.Элементы.Найти("ГруппаФакт_" + Стр.ИмяКолонки));
			ДобавленныйПериодФакт.Вид = ВидПоляФормы.ПолеВвода;
			ДобавленныйПериодФакт.Заголовок = "Кол."; 
			ДобавленныйПериодФакт.ПутьКДанным = "ТабПланирования" + "." + "КолонкаФактКоличество_" + Стр.ИмяКолонки;
			ДобавленныйПериодФакт.Видимость = Истина;
			ДобавленныйПериодФакт.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
			ДобавленныйПериодФакт.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
