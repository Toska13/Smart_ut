
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Пользователи.РолиДоступны("смартПланПродажПоМенеджерамИзменение") Тогда
		ОбщегоНазначения.СообщитьПользователю("Просмотр запрещен!");
		Отказ=Истина;
		Возврат;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	ПриИзмененииПериодовНаСервере();
	
	//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
	//Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПустаяСсылка(), "Вся номенклатура");
	//Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаТоварыУслуги, "Продажа оборудования");
	//Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти, "Продажа запчастей");
	//Элементы.ТипУслуги.СписокВыбора.Добавить(Справочники.CRM_ТипУслуги.ПоставкаРасходныеМатериалы, "Продажа расходников");
	//-- #Б-2220 смарт: Фролов 28.02.2025
	
	Если ЗначениеЗаполнено(ЭтотОбъект.Параметры.ЗначениеКопирования) Тогда
		Объект.ВидПлана = ЭтотОбъект.Параметры.ЗначениеКопирования.ВидПлана;
	ИначеЕсли Объект.Ссылка.Пустая() Тогда
		//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
		//Объект.ТипУслуги = Справочники.CRM_ТипУслуги.ПустаяСсылка();
		Объект.ТипУслуги = Справочники.СегментыНоменклатуры.ПустаяСсылка();
		//-- #Б-2220 смарт: Фролов 28.02.2025
	КонецЕсли;
	
	Для Каждого СтрПартнерыИсключения Из Объект.ПартнерыИсключения Цикл
		
		ЭтаФорма.ПартнерыИсключения.Добавить(СтрПартнерыИсключения.Партнер);
		
	КонецЦикла;	
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоПодразделениям Тогда
		Если Объект.Ссылка.Пустая() Тогда
			Объект.Дата=ТекущаяДата();
			Объект.Ответственный=ПараметрыСеанса.ТекущийПользователь;
			Объект.Периодичность=Перечисления.Периодичность.Месяц;
			Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Подготовка;
			Объект.КоэффициентИзмененияОбщий=1;
			Если ЗначениеЗаполнено(ЭтотОбъект.Параметры.ЗначениеКопирования) Тогда
				МасПодразделение=ЭтотОбъект.Параметры.ЗначениеКопирования.Планирование.Выгрузить(,"Подразделение").ВыгрузитьКолонку("Подразделение");
				МасПодразделение=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасПодразделение);
				Объект.НачалоПериода=ЭтотОбъект.Параметры.ЗначениеКопирования.НачалоПериода; 
				Объект.ОкончаниеПериода=ЭтотОбъект.Параметры.ЗначениеКопирования.ОкончаниеПериода;
				ЗаполнитьТаблицуПланированияФактомПоПодразделениям(МасПодразделение,Объект.НачалоПериода,Объект.ОкончаниеПериода); 
			КонецЕсли;		
		Иначе 
			Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) ТОгда  
				МасПодразделение=Объект.Планирование.Выгрузить(,"Подразделение").ВыгрузитьКолонку("Подразделение"); 
				МасПодразделение=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасПодразделение);
				ЗаполнитьТаблицуПланированияФактомПоПодразделениям(МасПодразделение,Объект.НачалоПериода,Объект.ОкончаниеПериода);
			КонецЕсли;
			ЗаполнитьТаблицуПланированияПланомПоПодразделениям();
		КонецЕсли;
	ИначеЕсли Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		
		Если Объект.Ссылка.Пустая() Тогда
			Объект.Дата = ТекущаяДата();
			Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			Объект.Периодичность = Перечисления.Периодичность.Месяц;
			Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Подготовка;
			Объект.КоэффициентИзмененияОбщий = 1;
			
			Если ЗначениеЗаполнено(ЭтотОбъект.Параметры.ЗначениеКопирования) Тогда
				
				МассивСегментНоменклатуры = ЭтотОбъект.Параметры.ЗначениеКопирования.
					Планирование.Выгрузить(, "СегментНоменклатуры").ВыгрузитьКолонку("СегментНоменклатуры");
				МасСегменМассивСегментНоменклатурытНоменклатуры = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСегментНоменклатуры);
				Объект.НачалоПериода = ЭтотОбъект.Параметры.ЗначениеКопирования.НачалоПериода; 
				Объект.ОкончаниеПериода = ЭтотОбъект.Параметры.ЗначениеКопирования.ОкончаниеПериода;
				ЗаполнитьТаблицуПланированияФактомПоСегментам(МассивСегментНоменклатуры, Объект.НачалоПериода, Объект.ОкончаниеПериода);
				
			КонецЕсли;
			
		Иначе 
			
			Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда  
				
				МассивСегментНоменклатуры = Объект.Планирование.Выгрузить(, "СегментНоменклатуры").ВыгрузитьКолонку("СегментНоменклатуры"); 
				МассивСегментНоменклатуры = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСегментНоменклатуры);
				ЗаполнитьТаблицуПланированияФактомПоСегментам(МассивСегментНоменклатуры, Объект.НачалоПериода, Объект.ОкончаниеПериода);
				
			КонецЕсли;
			
			ЗаполнитьТаблицуПланированияПланомПоСегментам();
			
		КонецЕсли;
		
	Иначе	
		
		Если Объект.Ссылка.Пустая() Тогда
			Объект.Дата=ТекущаяДата();
			Объект.ВидПлана = Перечисления.смартВидПлана.ПоМенеджерам;
			Объект.Ответственный=ПараметрыСеанса.ТекущийПользователь;
			Объект.Периодичность=Перечисления.Периодичность.Месяц;
			Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Подготовка;
			Объект.КоэффициентИзмененияОбщий=1;
			Если ЗначениеЗаполнено(ЭтотОбъект.Параметры.ЗначениеКопирования) Тогда
				МасМенеджер=ЭтотОбъект.Параметры.ЗначениеКопирования.Планирование.Выгрузить(,"Менеджер").ВыгрузитьКолонку("Менеджер");
				МасМенеджер=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
				Объект.НачалоПериода=ЭтотОбъект.Параметры.ЗначениеКопирования.НачалоПериода; 
				Объект.ОкончаниеПериода=ЭтотОбъект.Параметры.ЗначениеКопирования.ОкончаниеПериода;
				ЗаполнитьТаблицуПланированияФактом(МасМенеджер,Объект.НачалоПериода,Объект.ОкончаниеПериода); 
			КонецЕсли;		
		Иначе 
			Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) ТОгда  
				МасМенеджер=Объект.Планирование.Выгрузить(,"Менеджер").ВыгрузитьКолонку("Менеджер"); 
				МасМенеджер=ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
				ЗаполнитьТаблицуПланированияФактом(МасМенеджер,Объект.НачалоПериода,Объект.ОкончаниеПериода);
			КонецЕсли;
			ЗаполнитьТаблицуПланированияПланом();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		Если (Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Утвержден И Объект.Проведен) 
			ИЛИ Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Отменен Тогда
			ЭтаФорма.ТолькоПросмотр=Истина; 
			Элементы.ТабПланирования.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКоманднаяПанель.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКонтекстноеМеню.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияПодборМенеджеров.Доступность=Ложь;
			Элементы.ТабПланированияЗаполнитьДаннымиПериода.Доступность=Ложь;
			Элементы.ТабПланированияСформировать.Доступность=Ложь;
			Элементы.УстановитьИнтервал.Доступность=Ложь;
		КонецЕсли;
	КонецЕсли;  
	
	Если Объект.Периодичность=Перечисления.Периодичность.Месяц Тогда
		Элементы.ТабПланированияГруппаПланНаКвартал.Видимость = Ложь;
		Элементы.ТабПланированияГруппаПланНаМесяц.Видимость = Истина;
	Иначе
		Элементы.ТабПланированияГруппаПланНаКвартал.Видимость = Истина;
		Элементы.ТабПланированияГруппаПланНаМесяц.Видимость = Ложь;
	КонецЕсли;	

	ЭлементОформления  = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабПланированияИтогоЗаТекПериод");
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТабПланирования." + "ИтогоЗаТекПериод"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ТабПланирования." + "ПланНаСледПериод");
	ЭлементОтбора.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(200,0,0));
	ЭлементОформления.Использование = Истина;
	
	ЭлементОформления  = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТабПланированияИтогоЗаТекПериод");
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТабПланирования." + "ИтогоЗаТекПериод"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ТабПланирования." + "ПланНаСледПериод");
	ЭлементОтбора.Использование = Истина;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0,150,70));
	ЭлементОформления.Использование = Истина;  
	
	ВидимостьЭлементовОтТипаПлана();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
	ВывестиДекорациюПериод();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи); 
	
	ЕстьДубли = Ложь;
	
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоПодразделениям Тогда
		
		Запрос=Новый Запрос(
		"ВЫБРАТЬ
		|	смартПланПродажПоМенеджерамОбороты.Период КАК Период,
		|	ВЫБОР
		|	КОГДА смартПланПродажПоМенеджерамОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|		ТОГДА смартПланПродажПоМенеджерамОбороты.Подразделение
		|		ИНАЧЕ смартПланПродажПоМенеджерамОбороты.Подразделение.смартПодразделениеДляПланирования
		|	КОНЕЦ КАК Подразделение,
		|	смартПланПродажПоМенеджерамОбороты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			Подразделение В (&МасПодразделение)
		|				И ТипУслуги = &ТипУслуги) КАК смартПланПродажПоМенеджерамОбороты
		|ГДЕ
		|	смартПланПродажПоМенеджерамОбороты.Регистратор ССЫЛКА Документ.смартПланПродажПоМенеджерам
		|	И 1 = 1
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВЫБОР
		|	КОГДА смартПланПродажПоМенеджерамОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|		ТОГДА смартПланПродажПоМенеджерамОбороты.Подразделение.Наименование
		|		ИНАЧЕ смартПланПродажПоМенеджерамОбороты.Подразделение.смартПодразделениеДляПланирования.Наименование
		|	КОНЕЦ");
		Запрос.УстановитьПараметр("ДатаНачала",Объект.НачалоПериода);
		Запрос.УстановитьПараметр("ДатаОкончания",Объект.ОкончаниеПериода); 
		Запрос.УстановитьПараметр("ТипУслуги",Объект.ТипУслуги);
		МасПодразделение = Объект.Планирование.Выгрузить(,"Подразделение").ВыгрузитьКолонку("Подразделение");
		МасПодразделение = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасПодразделение);
		Запрос.УстановитьПараметр("МасПодразделение",МасПодразделение);
		
		Если НЕ Объект.Ссылка.Пустая() ТОгда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"1 = 1","смартПланПродажПоМенеджерамОбороты.Регистратор <> &Ссылка");
			Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
		КонецЕсли;
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОбщегоНазначения.СообщитьПользователю("Для подразделения "+Выборка.Подразделение+" в периоде "+Формат(Выборка.Период,"ДФ='ММММ гггг'")+" уже сформирован План продаж № "+Выборка.Регистратор.Номер+" используйте корректировку плана!");
			ЕстьДубли=Истина;	
			
		КонецЦикла;
		
	ИначеЕсли Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		
		Запрос=Новый Запрос(
		"ВЫБРАТЬ
		|	Период КАК Период,
		|	СегментНоменклатуры КАК СегментНоменклатуры,
		|	Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			СегментНоменклатуры В (&МассивСегментНоменклатуры))
		|ГДЕ
		|	Регистратор ССЫЛКА Документ.смартПланПродажПоМенеджерам
		|	И 1 = 1
		|
		|УПОРЯДОЧИТЬ ПО
		|	СегментНоменклатуры");
		Запрос.УстановитьПараметр("ДатаНачала", Объект.НачалоПериода);
		Запрос.УстановитьПараметр("ДатаОкончания", Объект.ОкончаниеПериода);
		
		МассивСегментНоменклатуры = Объект.Планирование.Выгрузить(, "СегментНоменклатуры").ВыгрузитьКолонку("СегментНоменклатуры");
		МассивСегментНоменклатуры = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСегментНоменклатуры);
		Запрос.УстановитьПараметр("МассивСегментНоменклатуры", МассивСегментНоменклатуры);
		
		Если НЕ Объект.Ссылка.Пустая() Тогда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Регистратор <> &Ссылка");
			Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		КонецЕсли;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОбщегоНазначения.СообщитьПользователю("Для сегмента номенклатуры " + Выборка.СегментНоменклатуры +
				" в периоде " + Формат(Выборка.Период, "ДФ='ММММ гггг'") + " уже сформирован План продаж № " +
				Выборка.Регистратор.Номер + " используйте корректировку плана!");
			ЕстьДубли = Истина;	
			
		КонецЦикла;
		
	Иначе	
		
		Запрос=Новый Запрос(
		"ВЫБРАТЬ
		|	смартПланПродажПоМенеджерамОбороты.Период КАК Период,
		|	смартПланПродажПоМенеджерамОбороты.Менеджер КАК Менеджер,
		|	смартПланПродажПоМенеджерамОбороты.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрНакопления.смартПланПродажПоМенеджерам.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Регистратор,
		|			Менеджер В (&МасМенеджер)
		|				И ТипУслуги = &ТипУслуги) КАК смартПланПродажПоМенеджерамОбороты
		|ГДЕ
		|	смартПланПродажПоМенеджерамОбороты.Регистратор ССЫЛКА Документ.смартПланПродажПоМенеджерам
		|	И 1 = 1
		|
		|УПОРЯДОЧИТЬ ПО
		|	смартПланПродажПоМенеджерамОбороты.Менеджер.Наименование");
		Запрос.УстановитьПараметр("ДатаНачала",Объект.НачалоПериода); 
		Запрос.УстановитьПараметр("ДатаОкончания",Объект.ОкончаниеПериода);
		Запрос.УстановитьПараметр("ТипУслуги",Объект.ТипУслуги);
		МасМенеджер = Объект.Планирование.Выгрузить(,"Менеджер").ВыгрузитьКолонку("Менеджер");
		МасМенеджер = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МасМенеджер);
		Запрос.УстановитьПараметр("МасМенеджер",МасМенеджер);
		
		Если НЕ Объект.Ссылка.Пустая() ТОгда 
			Запрос.Текст = СтрЗаменить(Запрос.Текст,"1 = 1","смартПланПродажПоМенеджерамОбороты.Регистратор <> &Ссылка");
			Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
		КонецЕсли;
		
		Выборка=Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОбщегоНазначения.СообщитьПользователю("Для менеджера "+Выборка.Менеджер+" в периоде "+Формат(Выборка.Период,"ДФ='ММММ гггг'")+" уже сформирован План продаж № "+Выборка.Регистратор.Номер+" используйте корректировку плана!");
			ЕстьДубли=Истина;	
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьДубли Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава") Тогда
		Если (Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Утвержден И Объект.Проведен) 
			ИЛИ Объект.Статус=Перечисления.смартСтатусыПланаПродаж.Отменен Тогда
			ЭтаФорма.ТолькоПросмотр=Истина; 
			Элементы.ТабПланирования.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКоманднаяПанель.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияКонтекстноеМеню.ТолькоПросмотр=Истина;
			Элементы.ТабПланированияПодборМенеджеров.Доступность=Ложь;
			Элементы.ТабПланированияЗаполнитьДаннымиПериода.Доступность=Ложь;
			Элементы.ТабПланированияСформировать.Доступность=Ложь;
			Элементы.УстановитьИнтервал.Доступность=Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
