&НаСервере
Процедура ЗаполнитьТаблицуПланированияПланом()
	
	ПериодичностьПлана = ?(Объект.Периодичность=Перечисления.Периодичность.Месяц, "МЕСЯЦ", "КВАРТАЛ");
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	смартПланПродажПоМенеджерамПланирование.Менеджер КАК Менеджер,
	|	смартПланПродажПоМенеджерамПланирование.Комментарий КАК Комментарий,
	|	смартПланПродажПоМенеджерамПланирование.РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамПланирование.Период, " + ПериодичностьПлана + ") КАК ПериодПлан,
	|	СУММА(смартПланПродажПоМенеджерамПланирование.НовыйПлан) КАК НовыйПлан
	|ИЗ
	|	Документ.смартПланПродажПоМенеджерам.Планирование КАК смартПланПродажПоМенеджерамПланирование
	|ГДЕ
	|	смартПланПродажПоМенеджерамПланирование.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	смартПланПродажПоМенеджерамПланирование.Менеджер,
	|	смартПланПродажПоМенеджерамПланирование.Комментарий,
	|	смартПланПродажПоМенеджерамПланирование.РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамПланирование.Период, " + ПериодичностьПлана + ")"); 
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	РезПланирование = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТабПланирования Из ТабПланирования Цикл
		
		Если СтрТабПланирования.РучноеИзменение Тогда
			Продолжить;
		КонецЕсли;
		
		ПланНаСледПериод = 0;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРезПланирование = РезПланирование.НайтиСтроки(Новый Структура("Менеджер, ПериодПлан",
				СтрТабПланирования.Менеджер, СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРезПланирование.Количество() > 0 Тогда
				СтрТабПланирования["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].НовыйПлан;		
				ПланНаСледПериод = ПланНаСледПериод + СтрокиРезПланирование[0].НовыйПлан;
			КонецЕсли;	
			
		КонецЦикла;
		
		СтрокиМенеджер = РезПланирование.НайтиСтроки(Новый Структура("Менеджер",СтрТабПланирования.Менеджер));
		Если СтрокиМенеджер.Количество() > 0 Тогда
			СтрТабПланирования.РучноеИзменение = СтрокиМенеджер[0].РучноеИзменение;
			СтрТабПланирования.Комментарий = СтрокиМенеджер[0].Комментарий;
			
			Если Объект.Периодичность = Перечисления.Периодичность.Месяц Тогда
				СтрТабПланирования.ПланНаМесяц = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), -3); 
				СтрТабПланирования.ПланНаСледПериод=СтрТабПланирования.ПланНаМесяц*ТаблицаПериоды.Количество();
			Иначе
				СтрТабПланирования.ПланНаКвартал = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), -3); 
				СтрТабПланирования.ПланНаСледПериод = СтрТабПланирования.ПланНаКвартал*ТаблицаПериоды.Количество();
			КонецЕсли;
			
		КонецЕсли;
		
		СтрТабПланирования.ПроцентИзмененияПлана = ?(СтрТабПланирования.ИтогоЗаПредПериод = 0, 0,
			(ПланНаСледПериод - СтрТабПланирования.ИтогоЗаПредПериод) / СтрТабПланирования.ИтогоЗаПредПериод) * 100;
		
	КонецЦикла;
	
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПланированияПланомПоПодразделениям()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВЫБОР
	|	КОГДА смартПланПродажПоМенеджерамПланирование.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|		ТОГДА смартПланПродажПоМенеджерамПланирование.Подразделение
	|		ИНАЧЕ смартПланПродажПоМенеджерамПланирование.Подразделение.смартПодразделениеДляПланирования
	|	КОНЕЦ КАК Подразделение,
	|	смартПланПродажПоМенеджерамПланирование.Комментарий КАК Комментарий,
	|	смартПланПродажПоМенеджерамПланирование.РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамПланирование.Период, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+") КАК ПериодПлан,
	|	СУММА(смартПланПродажПоМенеджерамПланирование.НовыйПлан) КАК НовыйПлан
	|ИЗ
	|	Документ.смартПланПродажПоМенеджерам.Планирование КАК смартПланПродажПоМенеджерамПланирование
	|ГДЕ
	|	смартПланПродажПоМенеджерамПланирование.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|	КОГДА смартПланПродажПоМенеджерамПланирование.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|		ТОГДА смартПланПродажПоМенеджерамПланирование.Подразделение
	|		ИНАЧЕ смартПланПродажПоМенеджерамПланирование.Подразделение.смартПодразделениеДляПланирования
	|	КОНЕЦ,
	|	смартПланПродажПоМенеджерамПланирование.Комментарий,
	|	смартПланПродажПоМенеджерамПланирование.РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(смартПланПродажПоМенеджерамПланирование.Период, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+")"); 
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	РезПланирование =Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТабПланирования Из ТабПланирования Цикл
		
		Если СтрТабПланирования.РучноеИзменение Тогда
			Продолжить;
		КонецЕсли;
		
		ПланНаСледПериод = 0;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРезПланирование = РезПланирование.НайтиСтроки(Новый Структура("Подразделение,ПериодПлан",СтрТабПланирования.Подразделение,СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРезПланирование.Количество()>0 Тогда
				СтрТабПланирования["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].НовыйПлан;		
				ПланНаСледПериод = ПланНаСледПериод+СтрокиРезПланирование[0].НовыйПлан;
			КонецЕсли;	
			
		КонецЦикла;
		
		Подразделение = РезПланирование.НайтиСтроки(Новый Структура("Подразделение",СтрТабПланирования.Подразделение));
		Если Подразделение.Количество() > 0 Тогда
			СтрТабПланирования.РучноеИзменение = Подразделение[0].РучноеИзменение;
			СтрТабПланирования.Комментарий = Подразделение[0].Комментарий;
			
			Если Объект.Периодичность=Перечисления.Периодичность.Месяц Тогда
				СтрТабПланирования.ПланНаМесяц = Окр(ПланНаСледПериод/ТаблицаПериоды.Количество(),-3); 
				СтрТабПланирования.ПланНаСледПериод=СтрТабПланирования.ПланНаМесяц*ТаблицаПериоды.Количество();
			Иначе
				СтрТабПланирования.ПланНаКвартал = Окр(ПланНаСледПериод/ТаблицаПериоды.Количество(),-3); 
				СтрТабПланирования.ПланНаСледПериод = СтрТабПланирования.ПланНаКвартал*ТаблицаПериоды.Количество();
			КонецЕсли;
			
		КонецЕсли;
		
		СтрТабПланирования.ПроцентИзмененияПлана = ?(СтрТабПланирования.ИтогоЗаПредПериод=0,0,(ПланНаСледПериод-СтрТабПланирования.ИтогоЗаПредПериод)/СтрТабПланирования.ИтогоЗаПредПериод)*100;
		
	КонецЦикла;
	
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПланированияПланомПоСегментам()
	
	ПериодичностьПлана = ?(Объект.Периодичность = Перечисления.Периодичность.Месяц, "МЕСЯЦ", "КВАРТАЛ");
	ЗаполнитьТаблицуРозничныхЦенПоСегментам();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СегментНоменклатуры КАК СегментНоменклатуры,
	|	Комментарий КАК Комментарий,
	|	РучноеИзменение КАК РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(Период," + ПериодичностьПлана + ") КАК ПериодПлан,
	|	СУММА(НовыйПланКоличество) КАК НовыйПланКоличество,
	|	СРЕДНЕЕ(Цена) КАК Цена,
	|	СУММА(НовыйПлан) КАК НовыйПлан
	|ИЗ
	|	Документ.смартПланПродажПоМенеджерам.Планирование
	|ГДЕ
	|	Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Комментарий,
	|	РучноеИзменение,
	|	НАЧАЛОПЕРИОДА(Период, " + ПериодичностьПлана + "),
	|	СегментНоменклатуры"); 
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ТаблицаПланирование = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТабПланирования Из ТабПланирования Цикл
		
		Если СтрТабПланирования.РучноеИзменение Тогда
			Продолжить;
		КонецЕсли;
		
		ПланНаСледПериод = 0;
		ПланНаСледПериодКоличество = 0;
		
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРезПланирование = ТаблицаПланирование.НайтиСтроки(Новый 
				Структура("СегментНоменклатуры, ПериодПлан", СтрТабПланирования.СегментНоменклатуры, СтрТаблицаПериоды.ДатаНачала));
				
			Если СтрокиРезПланирование.Количество() > 0 Тогда
				СтрТабПланирования["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРезПланирование[0].НовыйПланКоличество;
					ПланНаСледПериодКоличество = ПланНаСледПериодКоличество + СтрокиРезПланирование[0].НовыйПланКоличество;
				СтрТабПланирования["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(СтрокиРезПланирование[0].НовыйПлан = 0, 
					СтрокиРезПланирование[0].Цена * СтрокиРезПланирование[0].НовыйПланКоличество, СтрокиРезПланирование[0].НовыйПлан);
					ПланНаСледПериод = ПланНаСледПериод + СтрТабПланирования["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
			КонецЕсли;	
			
		КонецЦикла;
		
		СегментНоменклатуры = ТаблицаПланирование.НайтиСтроки(Новый Структура("СегментНоменклатуры", СтрТабПланирования.СегментНоменклатуры));
		
		СтрокиТаблицаРозничныхЦен = ТаблицаРозничныхЦен.НайтиСтроки(Новый Структура("СегментНоменклатуры", СтрТабПланирования.СегментНоменклатуры));
		
		Если СтрокиТаблицаРозничныхЦен.Количество() > 0 Тогда
			ЦенаРозничная = СтрокиТаблицаРозничныхЦен[0].ЦенаВЕВРО;
		Иначе
			ЦенаРозничная = 0;
		КонецЕсли;	
		
		Если ЦенаРозничная > Окр(ЦенаРозничная, 0) Тогда
			ЦенаРозничная = Окр(ЦенаРозничная + 1, 0);
		Иначе
			ЦенаРозничная = Окр(ЦенаРозничная, 0);
		КонецЕсли;
		
		Если СегментНоменклатуры.Количество() > 0 Тогда
			
			СтрТабПланирования.РучноеИзменение = СегментНоменклатуры[0].РучноеИзменение;
			СтрТабПланирования.Комментарий = СегментНоменклатуры[0].Комментарий;
			
			Если Объект.Периодичность = Перечисления.Периодичность.Месяц Тогда
				СтрТабПланирования.ПланНаМесяц = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), 0); 
				СтрТабПланирования.ПланНаСледПериод = СтрТабПланирования.ПланНаМесяц * ТаблицаПериоды.Количество();
				СтрТабПланирования.ПланНаМесяцКоличество = Окр(ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), 0); 
				СтрТабПланирования.ПланНаСледПериодКоличество = ПланНаСледПериодКоличество;
				Если СегментНоменклатуры[0].Цена = 0 ИЛИ НЕ СтрТабПланирования.РучноеИзменение Тогда
					СтрТабПланирования.ПланНаМесяцЦена = ЦенаРозничная;
				Иначе
					СтрТабПланирования.ПланНаМесяцЦена = СегментНоменклатуры[0].Цена;
				КонецЕсли;	
			Иначе
				СтрТабПланирования.ПланНаКвартал = Окр(ПланНаСледПериод / ТаблицаПериоды.Количество(), 0); 
				СтрТабПланирования.ПланНаСледПериод = СтрТабПланирования.ПланНаКвартал * ТаблицаПериоды.Количество();
				СтрТабПланирования.ПланНаКварталКоличество = Окр(ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), 0); 
				СтрТабПланирования.ПланНаСледПериодКоличество = ПланНаСледПериодКоличество;
				Если СегментНоменклатуры[0].Цена = 0 ИЛИ НЕ СтрТабПланирования.РучноеИзменение Тогда
					СтрТабПланирования.ПланНаКварталЦена = ЦенаРозничная * 3;
				Иначе	
					СтрТабПланирования.ПланНаКварталЦена = СегментНоменклатуры[0].Цена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		Если СтрТабПланирования.ПланНаСледПериодКоличество > 0 Тогда
			СтрТабПланирования.ПланНаСледПериодЦена = СтрТабПланирования.ПланНаСледПериод / СтрТабПланирования.ПланНаСледПериодКоличество;	
		КонецЕсли;
		
		СтрТабПланирования.ПроцентИзмененияПлана = ?(СтрТабПланирования.ИтогоЗаПредПериод = 0, 0,
			(ПланНаСледПериод - СтрТабПланирования.ИтогоЗаПредПериод) / СтрТабПланирования.ИтогоЗаПредПериод) * 100;
		
	КонецЦикла;
	
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПланированияФактом(МасМенеджер, НачалоПериода, ОкончаниеПериода)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер КАК Менеджер,
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.смартДатаЗакрытияЗаказа, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+") КАК ПериодФакта,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК СуммаФакт,
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер.Наименование КАК МенеджерНаименование
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			смартДатаЗакрытияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|				И Менеджер В (&МасМенеджер) И 1 = 1) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.смартДатаЗакрытияЗаказа, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+"),
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер,
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	МенеджерНаименование");
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("МасМенеджер",МасМенеджер);
	
	//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
	//МасНоменклатура = Справочники.CRM_ТипУслуги.ПолучитьМассивНоменклатурыПоТипу(Объект.ТипУслуги);
	МасНоменклатура = ПолучитьМассивНоменклатурыПоСегменту();
	//-- #Б-2220 смарт: Фролов 28.02.2025
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "АналитикаУчетаНоменклатуры.Номенклатура В (&МасНоменклатура)");
	Запрос.УстановитьПараметр("МасНоменклатура", МасНоменклатура);
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрМенеджер Из МасМенеджер Цикл 
		
		СтрокиТабПланирования = ТабПланирования.НайтиСтроки(Новый Структура("Менеджер",СтрМенеджер));
		Если СтрокиТабПланирования.Количество() > 0 Тогда
			СтрТабПланирования = СтрокиТабПланирования[0];
		Иначе
			СтрТабПланирования = ТабПланирования.Добавить();
			СтрТабПланирования.Менеджер=СтрМенеджер;
		КонецЕсли;
		
		ИтогоЗаТекПериод = 0;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРез = Рез.НайтиСтроки(Новый Структура("Менеджер,ПериодФакта",СтрМенеджер,СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРез.Количество() > 0 Тогда
				СтрТабПланирования["КолонкаФакт_"+СтрТаблицаПериоды.ИмяКолонки] = СтрокиРез[0].СуммаФакт;	
				ИтогоЗаТекПериод = ИтогоЗаТекПериод+СтрокиРез[0].СуммаФакт;
			КонецЕсли;	
			
		КонецЦикла;
		
		СтрТабПланирования.ИтогоЗаТекПериод = ИтогоЗаТекПериод;
	КонецЦикла;
	
	ЗаполнитьДанныеПредыдущегоПериода(МасМенеджер,НачалоМесяца(ДобавитьМесяц(НачалоПериода,-1*(ТаблицаПериоды.Количество()))),КонецМесяца(ДобавитьМесяц(ОкончаниеПериода,-1*(ТаблицаПериоды.Количество()))));
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПланированияФактомПоПодразделениям(МасПодразделение, НачалоПериода, ОкончаниеПериода)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СтруктураПредприятия.Ссылка КАК Подразделение
	|ПОМЕСТИТЬ ПодразделенияПодчиненные
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.смартПодразделениеДляПланирования В(&МасПодразделение)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования
	|	КОНЕЦ КАК Подразделение,
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.смартДатаЗакрытияЗаказа, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+") КАК ПериодФакта,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК СуммаФакт,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.Наименование
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования.Наименование
	|	КОНЕЦ КАК ПодразделениеНаименование
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			смартДатаЗакрытияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|				И 1 = 1
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер В ИЕРАРХИИ (&СмартГруппаКомпаний)
	|				И (Подразделение В (&МасПодразделение)
	|					ИЛИ Подразделение В
	|						(ВЫБРАТЬ
	|							ПодразделенияПодчиненные.Подразделение
	|						ИЗ
	|							ПодразделенияПодчиненные))) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВыручкаИСебестоимостьПродажОбороты.смартДатаЗакрытияЗаказа, "+?(Объект.Периодичность=Перечисления.Периодичность.Месяц,"МЕСЯЦ","КВАРТАЛ")+"),
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА ВыручкаИСебестоимостьПродажОбороты.Подразделение.Наименование
	|		ИНАЧЕ ВыручкаИСебестоимостьПродажОбороты.Подразделение.смартПодразделениеДляПланирования.Наименование
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПодразделениеНаименование");
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("МасПодразделение",МасПодразделение);
	Запрос.УстановитьПараметр("СмартГруппаКомпаний",ЭтаФорма.ПартнерыИсключения);
	
	//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
	//МасНоменклатура = Справочники.CRM_ТипУслуги.ПолучитьМассивНоменклатурыПоТипу(Объект.ТипУслуги);
	МасНоменклатура = ПолучитьМассивНоменклатурыПоСегменту();
	//-- #Б-2220 смарт: Фролов 28.02.2025
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "АналитикаУчетаНоменклатуры.Номенклатура В (&МасНоменклатура)");
	Запрос.УстановитьПараметр("МасНоменклатура", МасНоменклатура);
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрПодразделение Из МасПодразделение Цикл 
		
		СтрокиТабПланирования = ТабПланирования.НайтиСтроки(Новый Структура("Подразделение",СтрПодразделение));
		Если СтрокиТабПланирования.Количество() > 0 Тогда
			СтрТабПланирования = СтрокиТабПланирования[0];
		Иначе
			СтрТабПланирования = ТабПланирования.Добавить();
			СтрТабПланирования.Подразделение=СтрПодразделение;
		КонецЕсли;
		
		ИтогоЗаТекПериод = 0;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРез = Рез.НайтиСтроки(Новый Структура("Подразделение,ПериодФакта",СтрПодразделение,СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРез.Количество() > 0 Тогда
				СтрТабПланирования["КолонкаФакт_"+СтрТаблицаПериоды.ИмяКолонки] = СтрокиРез[0].СуммаФакт;	
				ИтогоЗаТекПериод = ИтогоЗаТекПериод+СтрокиРез[0].СуммаФакт;
			КонецЕсли;	
			
		КонецЦикла;
		
		СтрТабПланирования.ИтогоЗаТекПериод = ИтогоЗаТекПериод;
	КонецЦикла;
	
	ЗаполнитьДанныеПредыдущегоПериодаПоПодразделениям(МасПодразделение,НачалоМесяца(ДобавитьМесяц(НачалоПериода,-1*(ТаблицаПериоды.Количество()))),КонецМесяца(ДобавитьМесяц(ОкончаниеПериода,-1*(ТаблицаПериоды.Количество()))));
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПланированияФактомПоСегментам(МассивСегментНоменклатуры, НачалоПериода, ОкончаниеПериода)
	
	ПериодичностьПлана = ?(Объект.Периодичность = Перечисления.Периодичность.Месяц, "МЕСЯЦ", "КВАРТАЛ");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сегмент КАК СегментНоменклатуры,
	|	Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НоменклатураСегментов
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента
	|ГДЕ
	|	Сегмент В(&МассивСегментНоменклатуры)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НоменклатураСегментов.СегментНоменклатуры КАК СегментНоменклатуры,
	|	НАЧАЛОПЕРИОДА(ВыручкаОбороты.смартДатаЗакрытияЗаказа, " + ПериодичностьПлана + ") КАК ПериодФакта,
	|	СУММА(ВыручкаОбороты.КоличествоОборот) КАК КоличествоФакт,
	|	СУММА(ВыручкаОбороты.СуммаВыручкиОборот) КАК СуммаФакт
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			смартДатаЗакрытияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|				И НЕ АналитикаУчетаПоПартнерам.Партнер В ИЕРАРХИИ (&СмартГруппаКомпаний)
	|				И АналитикаУчетаНоменклатуры.Номенклатура В
	|					(ВЫБРАТЬ
	|						Номенклатура
	|					ИЗ
	|						НоменклатураСегментов)) КАК ВыручкаОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураСегментов КАК НоменклатураСегментов
	|		ПО ВыручкаОбороты.АналитикаУчетаНоменклатуры.Номенклатура = НоменклатураСегментов.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(ВыручкаОбороты.смартДатаЗакрытияЗаказа,  " + ПериодичностьПлана + "),
	|	НоменклатураСегментов.СегментНоменклатуры");
	
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", ОкончаниеПериода);
	Запрос.УстановитьПараметр("МассивСегментНоменклатуры", МассивСегментНоменклатуры);
	Запрос.УстановитьПараметр("СмартГруппаКомпаний", ЭтаФорма.ПартнерыИсключения);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ЭлементМассива Из МассивСегментНоменклатуры Цикл 
		
		СтрокиТабПланирования = ТабПланирования.НайтиСтроки(Новый Структура("СегментНоменклатуры", ЭлементМассива));
		Если СтрокиТабПланирования.Количество() > 0 Тогда
			СтрТабПланирования = СтрокиТабПланирования[0];
		Иначе
			СтрТабПланирования = ТабПланирования.Добавить();
			СтрТабПланирования.СегментНоменклатуры = ЭлементМассива;
		КонецЕсли;
		
		ИтогоЗаТекПериод = 0;
		ИтогоЗаТекПериодКоличество = 0;
		
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			
			СтрокиРез = Таблица.НайтиСтроки(Новый Структура("СегментНоменклатуры, ПериодФакта", ЭлементМассива, СтрТаблицаПериоды.ДатаНачала));
			Если СтрокиРез.Количество() > 0 Тогда
				
				СтрТабПланирования["КолонкаФакт_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРез[0].СуммаФакт;	
				ИтогоЗаТекПериод = ИтогоЗаТекПериод + СтрокиРез[0].СуммаФакт;
				
				СтрТабПланирования["КолонкаФактКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = СтрокиРез[0].КоличествоФакт;	
				ИтогоЗаТекПериодКоличество = ИтогоЗаТекПериодКоличество + СтрокиРез[0].КоличествоФакт;
				
			КонецЕсли;	
			
		КонецЦикла;
		
		СтрТабПланирования.ИтогоЗаТекПериод = ИтогоЗаТекПериод;
		СтрТабПланирования.ИтогоЗаТекПериодКоличество = ИтогоЗаТекПериодКоличество;
		
	КонецЦикла;
	
	ЗаполнитьДанныеПредыдущегоПериодаПоСегментам(МассивСегментНоменклатуры, НачалоМесяца(ДобавитьМесяц(НачалоПериода, -1 * (ТаблицаПериоды.Количество()))),
		КонецМесяца(ДобавитьМесяц(ОкончаниеПериода, -1 * (ТаблицаПериоды.Количество()))));
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеПредыдущегоПериода(МасМенеджер, НачалоПериода, ОкончаниеПериода)
	
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер КАК Менеджер,
	|	СУММА(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот) КАК СуммаФакт,
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер.Наименование КАК МенеджерНаименование
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			смартДатаЗакрытияЗаказа МЕЖДУ &ДатаНачала И &ДатаОкончания
	|				И Менеджер В (&МасМенеджер) И 1 = 1) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер,
	|	ВыручкаИСебестоимостьПродажОбороты.Менеджер.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	МенеджерНаименование");
	Запрос.УстановитьПараметр("ДатаНачала",НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания",ОкончаниеПериода);
	Запрос.УстановитьПараметр("МасМенеджер",МасМенеджер);
	
	//++ #Б-2220 смарт: Фролов 28.02.2025 //План продаж и План-фактный анализ (доработка новых потребностей)
	//МасНоменклатура = Справочники.CRM_ТипУслуги.ПолучитьМассивНоменклатурыПоТипу(Объект.ТипУслуги);
	МасНоменклатура = ПолучитьМассивНоменклатурыПоСегменту();
	//-- #Б-2220 смарт: Фролов 28.02.2025

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "АналитикаУчетаНоменклатуры.Номенклатура В (&МасНоменклатура)");
	Запрос.УстановитьПараметр("МасНоменклатура", МасНоменклатура);
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрМенеджер Из МасМенеджер Цикл
		
		СтрокиТабПланирования = ТабПланирования.НайтиСтроки(Новый Структура("Менеджер",СтрМенеджер));
		Если СтрокиТабПланирования.Количество() > 0 Тогда
			СтрТабПланирования = СтрокиТабПланирования[0];
		Иначе
			СтрТабПланирования = ТабПланирования.Добавить();
			СтрТабПланирования.Менеджер = СтрМенеджер;
		КонецЕсли;
		
		СтрокиРез = Рез.НайтиСтроки(Новый Структура("Менеджер",СтрМенеджер));
		Если СтрокиРез.Количество() > 0 Тогда
			СтрТабПланирования.ИтогоЗаПредПериод = СтрокиРез[0].СуммаФакт;
		Иначе	
			СтрТабПланирования.ИтогоЗаПредПериод = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	ПредставлениеПредПериод = ПредставлениеПериода(ДобавитьМесяц(НачалоМесяца(Объект.НачалоПериода), -12),
		ДобавитьМесяц(КонецМесяца(Объект.ОкончаниеПериода), -12), "ФП = Истина");
	Элементы.ТабПланированияИтогоЗаПредПериод.Заголовок = "Итого за " + ПредставлениеПредПериод;
	ЗаполнитьДанныеПодвалаНаСервере();
	
КонецПроцедуры

