		Иначе	
			ЗаполнитьТаблицуПланированияФактом(ПолучитьСписокМенеджеров(),ДобавитьМесяц(Объект.НачалоПериода,-12),ДобавитьМесяц(Объект.ОкончаниеПериода,-12)); 
		КонецЕсли;
	Иначе	
		ОбщегоНазначенияКлиент.СообщитьПользователю("Заполните период планирования!",,"Объект.ПериодУстановкиПлана");
	КонецЕсли; 
