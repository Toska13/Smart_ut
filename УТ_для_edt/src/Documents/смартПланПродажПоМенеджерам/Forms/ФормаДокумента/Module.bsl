&НаКлиенте
Процедура ТабПланированияМесяцПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение = Истина;
	ТекущиеДанные.ПланНаСледПериод = 0;
	
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные.ПланНаСледПериод = ТекущиеДанные.ПланНаСледПериод + ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
	КонецЦикла;
	
	Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
		ТекущиеДанные.ПланНаКвартал = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), 0);
	Иначе	
		ТекущиеДанные.ПланНаМесяц = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), 0);
	КонецЕсли;
	
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияМесяцКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.РучноеИзменение = Истина;
	ТекущиеДанные.ПланНаСледПериодКоличество = 0;
	ТекущиеДанные.ПланНаСледПериод = 0;
	
	
	
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		
		ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные["КолонкаПланКоличество_" + 
			СтрТаблицаПериоды.ИмяКолонки] *	?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), 
			ТекущиеДанные.ПланНаКварталЦена, ТекущиеДанные.ПланНаМесяцЦена);
		
		ТекущиеДанные.ПланНаСледПериодКоличество = ТекущиеДанные.ПланНаСледПериодКоличество + ТекущиеДанные["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
		ТекущиеДанные.ПланНаСледПериод = ТекущиеДанные.ПланНаСледПериод + ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
		
	КонецЦикла;
	
	Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
		ТекущиеДанные.ПланНаКварталКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(),0);
		ТекущиеДанные.ПланНаКвартал = ТекущиеДанные.ПланНаКварталКоличество * ТекущиеДанные.ПланНаКварталЦена;
	Иначе	
		ТекущиеДанные.ПланНаМесяцКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(),0);
		ТекущиеДанные.ПланНаМесяц = ТекущиеДанные.ПланНаМесяцКоличество * ТекущиеДанные.ПланНаМесяцЦена;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборМенеджеров(Команда)
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ЭлементПользовательскойНастройки", Ложь);
	ПараметрыОбработчика.Вставить("ОграничиватьВыборУказаннымиЗначениями", Ложь);
	ПараметрыОбработчика.Вставить("ИмяЭлемента", Элементы.ТабПланирования.Имя);
	ПараметрыОбработчика.Вставить("ТипВыбора", "Менеджер");
	
	Обработчик = Новый ОписаниеОповещения("смартЗавершитьВыборИзСписка", ЭтотОбъект, ПараметрыОбработчика);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.Пользователи"));	
	
	ПараметрыОткрытия = Новый Структура;
	//ПараметрыОткрытия.Вставить("Отмеченные", ОтмеченныеЗначения);
	ПараметрыОткрытия.Вставить("ОписаниеТипов", Новый ОписаниеТипов(МассивТипов));
	ПараметрыОткрытия.Вставить("ЗначенияДляВыбораЗаполнены", Ложь);
	ПараметрыОткрытия.Вставить("ОграничиватьВыборУказаннымиЗначениями", Ложь);
	ПараметрыОткрытия.Вставить("Представление", "Подбор менеджеров");
	ПараметрыОткрытия.Вставить("ПараметрыВыбора", Новый Массив());
	ПараметрыОткрытия.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыОткрытия.Вставить("БыстрыйВыбор", Ложь);
	
	ОткрытьФорму("ОбщаяФорма.ВводЗначенийСпискомСФлажками", ПараметрыОткрытия, ЭтотОбъект,,,, Обработчик);
КонецПроцедуры

&НаКлиенте
Процедура смартЗавершитьВыборИзСписка(Список, ПараметрыВыбора) Экспорт
	Если ТипЗнч(Список) = Тип("Массив") Тогда
		ВыбранныеЗначения = Список;
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(ВыбранныеЗначения);
		Список.ЗаполнитьПометки(Истина);
	ИначеЕсли ТипЗнч(Список) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавленыМенеджеры = Ложь;	
	ДобавленыПодразделения = Ложь;
	ДобавленыСегменты = Ложь;
	
	Если ПараметрыВыбора.ТипВыбора = "Менеджер" Тогда
		
		Для Каждого ЭлементСписка Из Список Цикл
			СтрокиТабПланирования=ЭтаФорма.ТабПланирования.НайтиСтроки(Новый Структура("Менеджер",ЭлементСписка.Значение));
			Если СтрокиТабПланирования.Количество()>0 ТОгда
				ОбщегоназначенияКлиент.СообщитьПользователю("Менеджер "+ЭлементСписка.Значение+" уже присутствет в таблице");
				Продолжить;
			КонецЕсли;	
			СтрТабПланирования=ТабПланирования.Добавить();	
			СтрТабПланирования.Менеджер=ЭлементСписка.Значение;
			ЭтаФорма.Модифицированность=Истина;
			ДобавленыМенеджеры=Истина;
		КонецЦикла;

	ИначеЕсли ПараметрыВыбора.ТипВыбора = "СегментНоменклатуры" Тогда
		
		Для Каждого ЭлементСписка Из Список Цикл
			
			Если НЕ ЭлементСписка.Пометка Тогда
				Продолжить;
			КонецЕсли;	
			
			СтрокиТабПланирования = ЭтаФорма.ТабПланирования.НайтиСтроки(Новый Структура("СегментНоменклатуры", ЭлементСписка.Значение));
			Если СтрокиТабПланирования.Количество() > 0 Тогда
				ОбщегоназначенияКлиент.СообщитьПользователю("Сегмент номенклатуры " + ЭлементСписка.Значение + " уже присутствет в таблице");
				Продолжить;
			КонецЕсли;
			
			СтрТабПланирования = ТабПланирования.Добавить();	
			СтрТабПланирования.СегментНоменклатуры = ЭлементСписка.Значение;
			ЭтаФорма.Модифицированность = Истина;
			ДобавленыСегменты = Истина;
			
		КонецЦикла;

	Иначе
		
		Для Каждого ЭлементСписка Из Список Цикл
			СтрокиТабПланирования=ЭтаФорма.ТабПланирования.НайтиСтроки(Новый Структура("Подразделение",ЭлементСписка.Значение));
			Если СтрокиТабПланирования.Количество()>0 ТОгда
				ОбщегоназначенияКлиент.СообщитьПользователю("Подразделение "+ЭлементСписка.Значение+" уже присутствет в таблице");
				Продолжить;
			КонецЕсли;	
			СтрТабПланирования=ТабПланирования.Добавить();	
			СтрТабПланирования.Подразделение=ЭлементСписка.Значение;
			ЭтаФорма.Модифицированность=Истина;
			ДобавленыПодразделения=Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДобавленыПодразделения ИЛИ ДобавленыМенеджеры ИЛИ ДобавленыСегменты Тогда
		Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
			ОбновитьДанныеВТаблице();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры 	
	
