&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	ПриИзмененииПериодовНаСервере();
	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		ЗаполнитьТаблицуПланированияФактомПоПодразделениям(ПолучитьСписокПодразделений(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоПодразделениям();
		ЗаполнитьДанныеПланаПоПериодам();
	ИначеЕсли Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
		ЗаполнитьТаблицуПланированияФактомПоСегментам(ПолучитьСписокСегментовНоменклатуры(), Объект.НачалоПериода, Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоСегментам();
	Иначе	
		ЗаполнитьТаблицуПланированияФактом(ПолучитьСписокМенеджеров(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланом();
		ЗаполнитьДанныеПланаПоПериодам();
	КонецЕсли;
	Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") Тогда
		Элементы.ТабПланированияГруппаПланНаКвартал.Видимость = Ложь;
		Элементы.ТабПланированияГруппаПланНаМесяц.Видимость = Истина;
	Иначе
		Элементы.ТабПланированияГруппаПланНаКвартал.Видимость = Истина;
		Элементы.ТабПланированияГруппаПланНаМесяц.Видимость = Ложь;
	КонецЕсли;
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаКварталПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ПланНаКвартал = ТекущиеДанные.ПланНаКвартал;
	
	ТекущиеДанные.ПланНаСледПериод = ПланНаКвартал * ТаблицаПериоды.Количество();
	
	ТекущиеДанные.ПроцентИзмененияПлана = ?(ТекущиеДанные.ИтогоЗаПредПериод = 0, 0,
		(ТекущиеДанные.ПланНаСледПериод - ТекущиеДанные.ИтогоЗаПредПериод) / ТекущиеДанные.ИтогоЗаПредПериод) * 100;
	ТекущиеДанные.РучноеИзменение=Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=ТекущиеДанные.ПланНаКвартал;
	КонецЦикла;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность=Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		ОбновитьДанныеВТаблице();
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен период!");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеВТаблице()
	
	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		
		ЗаполнитьТаблицуПланированияФактомПоПодразделениям(ПолучитьСписокПодразделений(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоПодразделениям();
		Для Каждого Стр Из ТабПланирования Цикл 
			Если НЕ Стр.РучноеИзменение ТОгда 
				Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
					НовыйНаКвартал=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
					Если НовыйНаКвартал>Окр(НовыйНаКвартал,-3) ТОгда
						Стр.ПланНаКвартал=Окр(НовыйНаКвартал+500,-3);
					Иначе
						Стр.ПланНаКвартал=Окр(НовыйНаКвартал,-3);
					КонецЕсли;	
				Иначе
					НовыйНаМесяц=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
					Если НовыйНаМесяц>Окр(НовыйНаМесяц,-3) ТОгда
						Стр.ПланНаМесяц=Окр(НовыйНаМесяц+500,-3);
					Иначе
						Стр.ПланНаМесяц=Окр(НовыйНаМесяц,-3);
					КонецЕсли;	
				КонецЕсли;
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					Стр["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц);
				КонецЦикла;
				Стр.ПланНаСледПериод=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц)*ТаблицаПериоды.Количество();
				Стр.ПроцентИзмененияПлана=?(Стр.ИтогоЗаПредПериод=0,0,(Стр.ПланНаСледПериод-Стр.ИтогоЗаПредПериод)/Стр.ИтогоЗаПредПериод)*100;
			КонецЕсли;
		КонецЦикла;	
		ЗаполнитьДанныеПодвала();
		
	ИначеЕсли Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
		
		ЗаполнитьТаблицуПланированияФактомПоСегментам(ПолучитьСписокСегментовНоменклатуры(), Объект.НачалоПериода, Объект.ОкончаниеПериода);
		
		//ЗаполнитьТаблицуПланированияПланомПоСегментам();
		
		ЗаполнитьТаблицуРозничныхЦенПоСегментам();
		
		Для Каждого Стр Из ТабПланирования Цикл 
			
			СтрокиТаблицаРозничныхЦен = ТаблицаРозничныхЦен.НайтиСтроки(Новый Структура("СегментНоменклатуры", Стр.СегментНоменклатуры));
			
			Если СтрокиТаблицаРозничныхЦен.Количество() > 0 Тогда
				ЦенаРозничная = СтрокиТаблицаРозничныхЦен[0].ЦенаВЕВРО;
			Иначе
				ЦенаРозничная = 0;
			КонецЕсли;	
			
			Если НЕ Стр.РучноеИзменение Тогда 
				
				Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
					
					НовыйНаКварталЦена = ЦенаРозничная * 3; 
					Если НовыйНаКварталЦена > Окр(НовыйНаКварталЦена, 0) Тогда
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена + 1, 0);
					Иначе
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена, 0);
					КонецЕсли;
					
					НовыйНаКварталКоличество = Стр.ИтогоЗаПредПериодКоличество * Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					Если НовыйНаКварталКоличество > Окр(НовыйНаКварталКоличество, 0) Тогда
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество + 1, 0);
					Иначе
						Стр.ПланНаКварталКоличество = Окр(НовыйНаКварталКоличество, 0);
					КонецЕсли;
					
					Стр.ПланНаКвартал = Стр.ПланНаКварталЦена * Стр.ПланНаКварталКоличество;
					
				Иначе
					
					НовыйНаМесяцЦена = ЦенаРозничная;
					Если НовыйНаМесяцЦена > Окр(НовыйНаМесяцЦена, 0) Тогда
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена + 1, 0);
					Иначе
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена, 0);
					КонецЕсли;

					НовыйНаМесяцКоличество = Стр.ИтогоЗаПредПериодКоличество * Объект.КоэффициентИзмененияОбщий / ТаблицаПериоды.Количество();
					Если НовыйНаМесяцКоличество > Окр(НовыйНаМесяцКоличество, 0) Тогда
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество + 1, 0);
					Иначе
						Стр.ПланНаМесяцКоличество = Окр(НовыйНаМесяцКоличество, 0);
					КонецЕсли;
					
					Стр.ПланНаМесяц = Стр.ПланНаМесяцЦена * Стр.ПланНаМесяцКоличество;
					
				КонецЕсли;
				
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					
					Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = 
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц);
					Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = 
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталКоличество, Стр.ПланНаМесяцКоличество);
						
				КонецЦикла;
				
				Стр.ПланНаСледПериод = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКвартал, Стр.ПланНаМесяц) * ТаблицаПериоды.Количество();
				Стр.ПланНаСледПериодКоличество = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталКоличество, 
					Стр.ПланНаМесяцКоличество) * ТаблицаПериоды.Количество();
				Стр.ПланНаСледПериодЦена = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталЦена, Стр.ПланНаМесяцЦена);
				Стр.ПроцентИзмененияПлана = ?(Стр.ИтогоЗаПредПериод=0, 0, (Стр.ПланНаСледПериод - Стр.ИтогоЗаПредПериод) / Стр.ИтогоЗаПредПериод) * 100;
				
			ИначеЕсли Стр.ПланНаКварталЦена = 0 И Стр.ПланНаМесяцЦена = 0 Тогда
				
				Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
					
					НовыйНаКварталЦена = ?(Стр.ПланНаКварталЦена > 0, Стр.ПланНаКварталЦена, ЦенаРозничная * 3);
					Если НовыйНаКварталЦена > Окр(НовыйНаКварталЦена, 0) Тогда
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена + 1, 0);
					Иначе
						Стр.ПланНаКварталЦена = Окр(НовыйНаКварталЦена, 0);
					КонецЕсли;
					
				Иначе
					
					НовыйНаМесяцЦена =  ?(Стр.ПланНаМесяцЦена > 0, Стр.ПланНаКварталЦена, ЦенаРозничная);
					Если НовыйНаМесяцЦена > Окр(НовыйНаМесяцЦена, 0) Тогда
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена + 1, 0);
					Иначе
						Стр.ПланНаМесяцЦена = Окр(НовыйНаМесяцЦена, 0);
					КонецЕсли;
					
				КонецЕсли;
				
				Стр.ПланНаСледПериод = 0;
				
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					
					Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ?(Объект.Периодичность = 
						ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталЦена, Стр.ПланНаМесяцЦена)
						* Стр["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки];
						
					Стр.ПланНаСледПериод = Стр.ПланНаСледПериод + Стр["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки];
					
				КонецЦикла;
				
				Стр.ПланНаСледПериодЦена = ?(Объект.Периодичность =
					ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"), Стр.ПланНаКварталЦена, Стр.ПланНаМесяцЦена);
				Стр.ПроцентИзмененияПлана = ?(Стр.ИтогоЗаПредПериод=0, 0, (Стр.ПланНаСледПериод - Стр.ИтогоЗаПредПериод) / Стр.ИтогоЗаПредПериод) * 100;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаполнитьДанныеПодвала();
		
	Иначе	
		
		ЗаполнитьТаблицуПланированияФактом(ПолучитьСписокМенеджеров(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланом();
		Для Каждого Стр Из ТабПланирования Цикл 
			Если НЕ Стр.РучноеИзменение ТОгда 
				Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
					НовыйНаКвартал=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
					Если НовыйНаКвартал>Окр(НовыйНаКвартал,-3) ТОгда
						Стр.ПланНаКвартал=Окр(НовыйНаКвартал+500,-3);
					Иначе
						Стр.ПланНаКвартал=Окр(НовыйНаКвартал,-3);
					КонецЕсли;	
				Иначе
					НовыйНаМесяц=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
					Если НовыйНаМесяц>Окр(НовыйНаМесяц,-3) ТОгда
						Стр.ПланНаМесяц=Окр(НовыйНаМесяц+500,-3);
					Иначе
						Стр.ПланНаМесяц=Окр(НовыйНаМесяц,-3);
					КонецЕсли;	
				КонецЕсли;
				Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
					Стр["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц);
				КонецЦикла;
				Стр.ПланНаСледПериод=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц)*ТаблицаПериоды.Количество();
				Стр.ПроцентИзмененияПлана=?(Стр.ИтогоЗаПредПериод=0,0,(Стр.ПланНаСледПериод-Стр.ИтогоЗаПредПериод)/Стр.ИтогоЗаПредПериод)*100;
			КонецЕсли;
		КонецЦикла;	
		ЗаполнитьДанныеПодвала();
		
	КонецЕсли;
	ЭтаФорма.Модифицированность=Истина;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВывестиДекорациюПериод()
	Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
		Объект.ПериодПлана=ПредставлениеПериода(НачалоМесяца(Объект.НачалоПериода),КонецМесяца(Объект.ОкончаниеПериода),"ФП = Истина");
	Иначе
		Объект.ПериодПлана="Период не заполнен";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияМенеджерПриИзменении(Элемент)
	ТекМенеджер=ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.Менеджер;
	СтрокиТабПланирования=ЭтаФорма.ТабПланирования.НайтиСтроки(Новый Структура("Менеджер",ТекМенеджер));
	Если СтрокиТабПланирования.Количество()>1 ТОгда
		ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.Менеджер=Неопределено;
		ОбщегоназначенияКлиент.СообщитьПользователю("Менеджер уже присутствет в таблице");
	Иначе	
		Если ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.ОкончаниеПериода) Тогда
			ОбновитьДанныеВТаблице();
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДанныеПодвала()
	ЗаполнитьДанныеПодвалаНаСервере();
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеПодвалаНаСервере()
	
	Элементы.ТабПланированияИтогоЗаПредПериод.ТекстПодвала = ТабПланирования.Итог("ИтогоЗаПредПериод");
	Элементы.ТабПланированияПланНаСледПериод.ТекстПодвала = ТабПланирования.Итог("ПланНаСледПериод");
	Объект.ИтогоПланНаСледПериод = ТабПланирования.Итог("ПланНаСледПериод");
	Элементы.ТабПланированияПланНаКвартал.ТекстПодвала = ТабПланирования.Итог("ПланНаКвартал");
	Элементы.ТабПланированияПланНаМесяц.ТекстПодвала = ТабПланирования.Итог("ПланНаМесяц");
	Элементы.ТабПланированияИтогоЗаТекПериод.ТекстПодвала = ТабПланирования.Итог("ИтогоЗаТекПериод");
	Элементы.ТабПланированияПроцентИзмененияПлана.ТекстПодвала = Окр(?(ТабПланирования.Итог("ИтогоЗаПредПериод") = 0, 0,
		(ТабПланирования.Итог("ПланНаСледПериод") - ТабПланирования.Итог("ИтогоЗаПредПериод")) / ТабПланирования.Итог("ИтогоЗаПредПериод")) * 100);
		
	Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
		
		Элементы.ТабПланированияПланНаСледПериодКоличество.ТекстПодвала = ТабПланирования.Итог("ПланНаСледПериодКоличество");
		Элементы.ТабПланированияИтогоЗаПредПериодКоличество.ТекстПодвала = ТабПланирования.Итог("ИтогоЗаПредПериодКоличество");
		Элементы.ТабПланированияИтогоЗаТекПериодКоличество.ТекстПодвала = ТабПланирования.Итог("ИтогоЗаТекПериодКоличество");
			
	КонецЕсли;		
			
	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		
		Элементы["План_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки);
		Элементы["Факт_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаФакт_" + СтрТаблицаПериоды.ИмяКолонки);		
		
		Если Объект.ВидПлана = Перечисления.смартВидПлана.ПоСегментамНоменклатуры Тогда
			Элементы["ПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки);
			Элементы["ФактКоличество_" + СтрТаблицаПериоды.ИмяКолонки].ТекстПодвала = ТабПланирования.Итог("КолонкаФактКоличество_" + СтрТаблицаПериоды.ИмяКолонки);		
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогоПланНаСледПериодПриИзменении(Элемент)
	ВсегоЗаПредПериод=ТабПланирования.Итог("ИтогоЗаПредПериод");
	ИтогоПланНаСледПериодБезРучных=Объект.ИтогоПланНаСледПериод;
	СтрокиРучноеИзменение=ТабПланирования.НайтиСтроки(Новый Структура("РучноеИзменение",Истина));
	Для Каждого СтрРучноеИзменение Из СтрокиРучноеИзменение Цикл
		ИтогоПланНаСледПериодБезРучных=ИтогоПланНаСледПериодБезРучных-СтрРучноеИзменение.ПланНаСледПериод;
		ВсегоЗаПредПериод=ВсегоЗаПредПериод-СтрРучноеИзменение.ИтогоЗаПредПериод;
	КонецЦикла;	
	Если ВсегоЗаПредПериод=0 ТОгда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнены данные предыдущего периода!");
		Возврат;
	КонецЕсли;	
	Объект.КоэффициентИзмененияОбщий=ИтогоПланНаСледПериодБезРучных/ВсегоЗаПредПериод;
	Для Каждого Стр Из ТабПланирования Цикл
		Если Стр.РучноеИзменение Тогда
			Продолжить;
		КонецЕсли;	
		Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
			НовыйНаКвартал=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
			Если НовыйНаКвартал>Окр(НовыйНаКвартал,-3) ТОгда
				Стр.ПланНаКвартал=Окр(НовыйНаКвартал+500,-3);
			Иначе
				Стр.ПланНаКвартал=Окр(НовыйНаКвартал,-3);
			КонецЕсли;	
		Иначе
			НовыйНаМесяц=Стр.ИтогоЗаПредПериод*Объект.КоэффициентИзмененияОбщий/ТаблицаПериоды.Количество();
			Если НовыйНаМесяц>Окр(НовыйНаМесяц,-3) ТОгда
				Стр.ПланНаМесяц=Окр(НовыйНаМесяц+500,-3);
			Иначе
				Стр.ПланНаМесяц=Окр(НовыйНаМесяц,-3);
			КонецЕсли;	
		КонецЕсли;
		Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
			Стр["КолонкаПлан_"+СтрТаблицаПериоды.ИмяКолонки]=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц);
		КонецЦикла;
		Стр.ПланНаСледПериод=?(Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"),Стр.ПланНаКвартал,Стр.ПланНаМесяц)*ТаблицаПериоды.Количество();	
	КонецЦикла;
	ЗаполнитьДанныеПодвала();
	ЭтаФорма.Модифицированность=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПроцентИзмененияПланаПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ТекущиеДанные.ПланНаСледПериод = (1 + ТекущиеДанные.ПроцентИзмененияПлана / 100) * ТекущиеДанные.ИтогоЗаПредПериод;
	ТекущиеДанные.ПланНаСледПериодКоличество = (1 + ТекущиеДанные.ПроцентИзмененияПлана / 100) * ТекущиеДанные.ИтогоЗаПредПериодКоличество;
	
	Если Объект.Периодичность=ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
		ТекущиеДанные.ПланНаКвартал = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), -3);
		ТекущиеДанные.ПланНаКварталКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), -1);
		ТабПланированияПланНаКварталПриИзменении(Элемент);
		Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
			ТабПланированияПланНаКварталКоличествоПриИзменении(Элемент);
		КонецЕсли;	
	Иначе
		ТекущиеДанные.ПланНаМесяц = Окр(ТекущиеДанные.ПланНаСледПериод / ТаблицаПериоды.Количество(), -3);
		ТекущиеДанные.ПланНаМесяцКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), -1);
		ТабПланированияПланНаМесяцПриИзменении(Элемент);
		Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
			ТабПланированияПланНаМесяцКоличествоПриИзменении(Элемент);
		КонецЕсли;	
	КонецЕсли;
	
	ТекущиеДанные.РучноеИзменение = Истина;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

Процедура ВидимостьЭлементовОтТипаПлана()

