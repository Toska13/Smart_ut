&НаКлиенте
Процедура ПодборПодразделений(Команда)
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ЭлементПользовательскойНастройки", Ложь);
	ПараметрыОбработчика.Вставить("ОграничиватьВыборУказаннымиЗначениями", Ложь);
	ПараметрыОбработчика.Вставить("ИмяЭлемента", Элементы.ТабПланирования.Имя);
	ПараметрыОбработчика.Вставить("ТипВыбора", "Подразделение");
	
	Обработчик = Новый ОписаниеОповещения("смартЗавершитьВыборИзСписка", ЭтотОбъект, ПараметрыОбработчика);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.СтруктураПредприятия"));	
	
	ПараметрыОткрытия = Новый Структура;

	ПараметрыОткрытия.Вставить("ОписаниеТипов", Новый ОписаниеТипов(МассивТипов));
	ПараметрыОткрытия.Вставить("ЗначенияДляВыбораЗаполнены", Ложь);
	ПараметрыОткрытия.Вставить("ОграничиватьВыборУказаннымиЗначениями", Ложь);
	ПараметрыОткрытия.Вставить("Представление", "Подбор подразделений");
	ПараметрыОткрытия.Вставить("ПараметрыВыбора", Новый Массив());
	ПараметрыОткрытия.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыОткрытия.Вставить("БыстрыйВыбор", Ложь);
	
	ОткрытьФорму("ОбщаяФорма.ВводЗначенийСпискомСФлажками", ПараметрыОткрытия, ЭтотОбъект,,,, Обработчик);
	
КонецПроцедуры 

&НаКлиенте
Процедура ВидПланаПриИзменении(Элемент)
		
	ВидимостьЭлементовОтТипаПлана();
	
	ПриИзмененииПериодовНаСервере();
	
	ТабПланирования.Очистить();
	
	ЭтаФорма.Модифицированность=Истина;

КонецПроцедуры

&НаКлиенте
Процедура ТипУслугиПриИзменении(Элемент)

	Если Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоПодразделениям") Тогда
		ЗаполнитьТаблицуПланированияФактомПоПодразделениям(ПолучитьСписокПодразделений(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоПодразделениям();
		ЗаполнитьДанныеПланаПоПериодам();
	ИначеЕсли Объект.ВидПлана = ПредопределенноеЗначение("Перечисление.смартВидПлана.ПоСегментамНоменклатуры") Тогда
		ЗаполнитьТаблицуПланированияФактомПоСегментам(ПолучитьСписокСегментовНоменклатуры(), Объект.НачалоПериода, Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланомПоСегментам();
	Иначе	
		ЗаполнитьТаблицуПланированияФактом(ПолучитьСписокМенеджеров(),Объект.НачалоПериода,Объект.ОкончаниеПериода);
		ЗаполнитьТаблицуПланированияПланом();
		ЗаполнитьДанныеПланаПоПериодам();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСегментовДляПланирования()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СегментыНоменклатуры
	|ГДЕ
	|	смартИспользуетсяВПланированииПродаж
	|	И НЕ ЭтоГруппа
	|	И НЕ ПометкаУдаления");
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

&НаКлиенте
Процедура ПодборСегментовНоменклатуры(Команда)
	
	МассивСегментовДокумента = ПолучитьСписокСегментовНоменклатуры();
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("МассивСегментовДокумента", МассивСегментовДокумента);
	
	ПараметрыОбработчика = Новый Структура;
	
	Обработчик = Новый ОписаниеОповещения("смартЗавершитьВыборИзСписка", ЭтотОбъект, ПараметрыОбработчика);
	
	ОткрытьФорму("Справочник.СегментыНоменклатуры.Форма.смартФормаВыбораВВидеДерева", ПараметрыОткрытия, ЭтотОбъект, , , , Обработчик);

КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияСегментНоменклатурыНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Обработчик = Новый ОписаниеОповещения("смартВыбранСегментНоменклатуры", ЭтотОбъект);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("Отбор", Новый Структура("смартИспользуетсяВПланированииПродаж", Истина));
	
	ОткрытьФорму("Справочник.СегментыНоменклатуры.ФормаВыбора", ПараметрыОткрытия, 
		ЭтотОбъект, , , , Обработчик, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура смартВыбранСегментНоменклатуры(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранноеЗначение <> Неопределено Тогда 
    	ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.СегментНоменклатуры = ВыбранноеЗначение;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаСледПериодКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	
	Если Объект.Периодичность = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") ТОгда
		ТекущиеДанные.ПланНаКварталКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), 0);
		ТабПланированияПланНаКварталКоличествоПриИзменении(Элемент);
	Иначе
		ТекущиеДанные.ПланНаМесяцКоличество = Окр(ТекущиеДанные.ПланНаСледПериодКоличество / ТаблицаПериоды.Количество(), 0);
		ТабПланированияПланНаМесяцКоличествоПриИзменении(Элемент);
	КонецЕсли;
	
	ТекущиеДанные.РучноеИзменение = Истина;
	
	ЗаполнитьДанныеПодвала();
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаКварталКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = ЭтаФорма.ТекущийЭлемент.ТекущиеДанные;
	ПланНаКварталКоличество = ТекущиеДанные.ПланНаКварталКоличество;
	ПланНаКварталЦена = ТекущиеДанные.ПланНаКварталЦена;
	
	ТекущиеДанные.ПланНаСледПериодКоличество = ПланНаКварталКоличество * ТаблицаПериоды.Количество();
	ТекущиеДанные.ПланНаСледПериод = ПланНаКварталЦена * ТекущиеДанные.ПланНаСледПериодКоличество;
	ТекущиеДанные.РучноеИзменение = Истина; 

	Для Каждого СтрТаблицаПериоды Из ТаблицаПериоды Цикл
		ТекущиеДанные["КолонкаПланКоличество_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаКварталКоличество;
		ТекущиеДанные["КолонкаПлан_" + СтрТаблицаПериоды.ИмяКолонки] = ТекущиеДанные.ПланНаКварталКоличество * ПланНаКварталЦена;
	КонецЦикла;
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабПланированияПланНаМесяцКоличествоПриИзменении(Элемент)
	
