&НаКлиенте
Процедура ПроверкаЗаполненияПередЗаписью(Отказ)
	
	//++ смарт:ММ 591 13.08.2021
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.ОшибочнаяЗаявка") Тогда
	//-- смарт:ММ 13.08.2021
	
	Если Объект.КонтактныеЛица.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны контактные лица контрагента. Документ не записан", Объект.Ссылка, "КонтактныеЛица", "Объект");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.Оборудование.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено оборудование. Документ не записан", Объект.Ссылка, "Оборудование", "Объект");
		Отказ = Истина;
	КонецЕсли;
	
	//++ смарт:ММ 591 13.08.2021
	КонецЕсли;
	//-- смарт:ММ 13.08.2021

	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.НазначенИнженер") Тогда 
		
		Если НЕ ЗначениеЗаполнено(Объект.НазначенныйНаРемонтИнженер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен назначенный на ремонт инженер. Документ не записан", Объект.Ссылка, "НазначенныйНаРемонтИнженер", "Объект");
			Отказ = Истина;
		КонецЕсли;
		//rnp 23.04.2021 дополнительные проверки
		Если НЕ ЗначениеЗаполнено(Объект.НазначеннаяДатаРемонтаС) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена назначенная дата ремонта первого инженера. Документ не записан", Объект.Ссылка, "НазначеннаяДатаРемонтаС", "Объект");
			Отказ = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.НазначенныйНаРемонтИнженер2) И НЕ ЗначениеЗаполнено(Объект.НазначеннаяДатаРемонтаС2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнена назначенная дата ремонта второго инженера. Документ не записан", Объект.Ссылка, "НазначеннаяДатаРемонтаС2", "Объект");
			Отказ = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.НазначенныйНаРемонтИнженер2) И ЗначениеЗаполнено(Объект.НазначеннаяДатаРемонтаС2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен назначенный на ремонт второй инженер. Документ не записан", Объект.Ссылка, "НазначенныйНаРемонтИнженер2", "Объект");
			Отказ = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.НазначеннаяДатаРемонтаПо) и Объект.НазначеннаяДатаРемонтаПо<Объект.НазначеннаяДатаРемонтаС Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не верно заполнена назначенная дата ремонта первого инженера. Документ не записан", Объект.Ссылка, "НазначеннаяДатаРемонтаПо", "Объект");
			Отказ = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.НазначеннаяДатаРемонтаПо2) и Объект.НазначеннаяДатаРемонтаПо2<Объект.НазначеннаяДатаРемонтаС2 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не верно заполнена назначенная дата ремонта второго инженера. Документ не записан", Объект.Ссылка, "НазначеннаяДатаРемонтаПо2", "Объект");
			Отказ = Истина;
		КонецЕсли;
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.ОтправленаВПредставительство") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Представительство) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено представительство. Документ не записан", Объект.Ссылка, "Представительство", "Объект");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

