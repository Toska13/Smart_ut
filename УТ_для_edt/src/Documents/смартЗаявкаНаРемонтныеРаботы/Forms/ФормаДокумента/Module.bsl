&НаСервереБезКонтекста
Функция СчетОплачен(ДокументОснование)
	
	СчетОплачен = Ложь;
	
	Запрос = Новый Запрос;
    //Смарт {[*](фрагмент ИЗМЕНЕН), Подкин Алексей Иванович 09.12.2021 15:45:41 задача 813
	Запрос.Текст = 
	"ВЫБРАТЬ
    |   ЗаказКлиента.Ссылка КАК Ссылка
    |ПОМЕСТИТЬ ВТ_ЗаказКлиента
    |ИЗ
    |   Документ.ЗаказКлиента КАК ЗаказКлиента
    |ГДЕ
    |   НЕ ЗаказКлиента.ПометкаУдаления
    |   И ЗаказКлиента.Проведен
    |   И ЗаказКлиента.ДокументОснование = &ДокументОснование
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |   РасчетыСКлиентамиОстатки.СуммаОстаток КАК СуммаОстаток,
    |   РасчетыСКлиентамиОстатки.КОплатеОстаток КАК КОплатеОстаток,
    |   ВТ_ЗаказКлиента.Ссылка КАК Ссылка
    |ИЗ
    |   РегистрНакопления.РасчетыСКлиентами.Остатки(
    |           ,
    |           ЗаказКлиента В
    |               (ВЫБРАТЬ
    |                   ВТ.Ссылка
    |               ИЗ
