Функция ПоказатьПредупреждениеПоКлиенту(Клиент)
	
	КлиентИзЧерногоСписка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЧерныйСписокКлиентовЗаявкиНаРемонт.Клиент КАК Клиент
