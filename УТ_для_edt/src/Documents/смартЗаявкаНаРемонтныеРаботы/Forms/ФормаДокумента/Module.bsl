&НаКлиенте
Процедура СтатусПриИзменении(Элемент) 
	
	НастроитьВидимостьДоступностьОбщее(); 
	
	//++ #1940 смарт: Мосолов 18.09.2024 //Изменения статусов в Заявках на ремонт Представительствами. 
	Если НЕ ЕстьПраваНаСтатусИПредставительство() Тогда  
		
		Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка") Тогда
			
			СтандартнаяОбработка = Ложь;         
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Статус ""Новая заявка"" не предназначен для выбора!", 
				Объект.Ссылка, 
				"Статус", 
				"Объект");
				
			Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.ПустаяСсылка");
				
		КонецЕсли;   
			
	КонецЕсли;
	//-- #1940 смарт: Мосолов 18.09.2024
	
	//++ #Б-3532 смарт: Фролов 17.06.2025 //Оптимизация прохождения по этапам воронки для документов ЗРР и ЗНП 
	СтатусПриИзмененииНаСервере();
	//-- #Б-3552 смарт: Фролов 17.06.2025
	
	//++ #Б-5028 смарт: Фролов 24.11.2025 //Доработка документа Заявка на ремонтные работы, по новому регламенту
	Если ИспользоватьМеханизмГибкойНастройкиЗРР Тогда
	
		СтрокиДоступныеСтатусыИПереходы = ДоступныеСтатусыИПереходы.НайтиСтроки(Новый Структура("Статус", Объект.Статус));
		Если СтрокиДоступныеСтатусыИПереходы.Количество() > 0 Тогда
			
			Если НЕ Объект.Этап = СтрокиДоступныеСтатусыИПереходы[0].Этап Тогда
				
				Если ЗначениеЗаполнено(СтрокиДоступныеСтатусыИПереходы[0].Этап) Тогда
					
					Объект.Этап = СтрокиДоступныеСтатусыИПереходы[0].Этап;
					
				Иначе
					
					Объект.Этап = ТекущийЭтап;
					
				КонецЕсли;

			КонецЕсли;
			
			//++ #Б-5892 смарт: Фролов 07.04.2026 //Создание механизма гибкой настройки ЗРР.
			ПроверкаПрошла = ПроверитьСкорректироватьСтатусИЭтап();
			//-- #Б-5892 смарт: Фролов 08.04.2026
			
			ЗаполнитьЦветаЭтапа();
			
			КомментарийЭтапаОбязателен = СтрокиДоступныеСтатусыИПереходы[0].ТребоватьКомментарий;
			Элементы.КомментарийЭтапа.Видимость = СтрокиДоступныеСтатусыИПереходы[0].Комментарий;
			Если КомментарийЭтапаОбязателен Тогда
				Элементы.КомментарийЭтапа.АвтоОтметкаНезаполненного = Истина;
			Иначе
				Элементы.КомментарийЭтапа.АвтоОтметкаНезаполненного = Ложь;
			КонецЕсли;	
			
			Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаРемонтныеРаботы.ЗаявкаАннулирована") Тогда
				
				Элементы.ПричинаЗакрытия.Видимость = Истина;
				
			Иначе	
				
				Элементы.ПричинаЗакрытия.Видимость = Ложь;
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

