	Запрос.УстановитьПараметр("Клиент", Клиент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ТекстСообщения = "Данный клиент недобросовестно (несвоевременно) оплачивает выезды инженеров. Все последующие выезды к данному клиенту должны осуществляться только на условии 100% предоплаты. Сформируйте счет на предоплату непосредственно из данной заявки. Возможность выезда станет доступной только после получения оплаты по созданному счету.";
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КлиентИзЧерногоСписка = Истина;
	КонецЕсли;
	
	Возврат КлиентИзЧерногоСписка;
	
