Процедура ЗаполнитьЦветаЭтапа()
	
	Если ЗначениеЗаполнено(Объект.Этап) Тогда
		
		Элементы.ГруппаРамкаЭтап.ЦветФона = Объект.Этап.ЦветФона.Получить();
		Элементы.Этап.ЦветТекста = Объект.Этап.ЦветТекста.Получить();
		
	КонецЕсли;	
	
КонецПроцедуры	

