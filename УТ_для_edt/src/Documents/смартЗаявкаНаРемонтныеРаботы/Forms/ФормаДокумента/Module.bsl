	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ЗаполнитьДокументОснованиеВЗаказе(ДополнительныеПараметры.ЗаказКлиента);		
	
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 31.05.2021

//++ смарт:ММ #082 397 31.05.2021
&НаСервере
Процедура ЗаполнитьДокументОснованиеВЗаказе(ВыбранныйЗаказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокОбъект = ВыбранныйЗаказ.ПолучитьОбъект();
	ДокОбъект.ДокументОснование = Объект.Ссылка;
	
	Попытка
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
