Функция ПреобрпзоватьИмяРеквизитаВСиноним(ИсходнаяСтрока)
	
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		
		ТекСимвол = Сред(ИсходнаяСтрока, Индекс, 1);
		
		// Если символ заглавный
		Если ТекСимвол = ВРег(ТекСимвол) И ТекСимвол <> " " Тогда
			
			// Добавляем пробел перед заглавной, если это не первый символ
			Если Индекс > 1 Тогда
				Результат = Результат + " ";
			КонецЕсли;
			
			// Первую букву строки делаем заглавной, остальные заглавные - строчными
			Если Индекс = 1 Тогда
				Результат = Результат + ВРег(ТекСимвол);
			Иначе
				Результат = Результат + НРег(ТекСимвол);
			КонецЕсли;
			
		Иначе
			Результат = Результат + ТекСимвол;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

