//++ #Б-5892 смарт: Фролов 07.04.2026 //Создание механизма гибкой настройки ЗРР.
Функция ПроверитьСкорректироватьСтатусИЭтап()
	
	ПроверкаПрошла = Истина;

	Если Справочники.смартПредопределенныеЗначения.Настройки.ИспользоватьМеханизмГибкойНастройкиЗРР Тогда  
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	смартШаблоныЭтаповПроцессовПредставительства.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ШаблоныЭтапов
		|ИЗ
		|	Справочник.смартШаблоныЭтаповПроцессов.Представительства КАК смартШаблоныЭтаповПроцессовПредставительства
		|ГДЕ
		|	смартШаблоныЭтаповПроцессовПредставительства.Представительство = &Представительство
		|	И смартШаблоныЭтаповПроцессовПредставительства.Ссылка.ОбластьПримененияЭтаповПроцессов = &ОбластьПримененияЭтаповПроцессов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартШаблоныЭтаповПроцессовЭтапыПроцессов.Этап КАК Этап
		|ПОМЕСТИТЬ Этапы
		|ИЗ
		|	Справочник.смартШаблоныЭтаповПроцессов.ЭтапыПроцессов КАК смартШаблоныЭтаповПроцессовЭтапыПроцессов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ШаблоныЭтапов КАК ШаблоныЭтапов
		|		ПО смартШаблоныЭтаповПроцессовЭтапыПроцессов.Ссылка = ШаблоныЭтапов.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	смартЭтапыПроцессовКонтрольПереходовПоЭтапам.ИмяРеквизита КАК ИмяРеквизита
		|ИЗ
		|	Этапы КАК Этапы,
		|	Справочник.смартЭтапыПроцессов.КонтрольПереходовПоЭтапам КАК смартЭтапыПроцессовКонтрольПереходовПоЭтапам
		|ГДЕ
		|	смартЭтапыПроцессовКонтрольПереходовПоЭтапам.Статус = &Статус
		|	И смартЭтапыПроцессовКонтрольПереходовПоЭтапам.Этап = &Этап
		|	И смартЭтапыПроцессовКонтрольПереходовПоЭтапам.Ссылка = &ТекущийЭтап");
		Запрос.УстановитьПараметр("Представительство", Объект.Представительство);
		Запрос.УстановитьПараметр("ОбластьПримененияЭтаповПроцессов", ПланыВидовХарактеристик.смартОбластиПримененияЭтаповПроцессов.смартЗаявкаНаРемонтныеРаботы);
		Запрос.УстановитьПараметр("Статус", Объект.Статус);
		Запрос.УстановитьПараметр("Этап", Объект.Этап);
		Запрос.УстановитьПараметр("ТекущийЭтап", ТекущийЭтап);
		
		РеквизитыДляПроверкиНаЭтапе.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяРеквизита"));
		
		Для Каждого СтрРеквизитыДляПроверкиНаЭтапе Из РеквизитыДляПроверкиНаЭтапе Цикл
			
			Если (ТипЗнч(Объект[СтрРеквизитыДляПроверкиНаЭтапе.Значение]) = Тип("Булево") 
				И НЕ Объект[СтрРеквизитыДляПроверкиНаЭтапе.Значение])
				ИЛИ НЕ ЗначениеЗаполнено(Объект[СтрРеквизитыДляПроверкиНаЭтапе.Значение]) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнен реквизит " + ПреобрпзоватьИмяРеквизитаВСиноним(СтрРеквизитыДляПроверкиНаЭтапе.Значение), 
					, "Объект." + СтрРеквизитыДляПроверкиНаЭтапе.Значение);
					
				Объект.Статус = ТекущийСтатус;
				Объект.Этап = ТекущийЭтап; 
				
				ПроверкаПрошла = Ложь;

			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат ПроверкаПрошла;
		
КонецФункции //-- #Б-5892 смарт: Фролов 08.04.2026	

