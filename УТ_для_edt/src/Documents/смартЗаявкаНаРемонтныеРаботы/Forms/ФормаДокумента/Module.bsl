
#Область ОбработчикиСобытийФормыИЭлементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
			
	Если Параметры.Ключ.Пустая() Тогда
		 		
		Если НЕ ЗначениеЗаполнено(Объект.Статус) Тогда
			Объект.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка;
		КонецЕсли;
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		
	//	
	//	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
	//		Отказ = Истина;
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ можно ввести только на основании Заказа клиента");
	//	КонецЕсли;
	//
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	НастроитьВидимостьДоступностьОборудования();
	НастроитьВидимостьДоступностьОбщее();
	
	ЗаполнитьСписокВыбораАдресаДоставки();

	// ++ 12.02.2021
	Элементы.ДанныеИзПисьмаОснования.Видимость = ЗначениеЗаполнено(Объект.ДанныеИзПисьмаОснования);
	// -- 12.02.2021
	
	//++ смарт:ММ 596 31.08.2021
	Если НЕ Параметры.Ключ.Пустая() Тогда
		
		Если НЕ РольДоступна("ПолныеПрава") И РольДоступна("смартДобавлениеИзменениеЗаявкиНаРемонт") Тогда

			ПодразделениеПользователя = ПараметрыСеанса.ТекущийПользователь.Подразделение;
			
			Если ПодразделениеПользователя <> смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ПодразделениеГоловнойОфисМосква", Ложь) 
				И ПодразделениеПользователя <> Объект.Представительство Тогда
				ЭтаФорма.ТолькоПросмотр = Истина;
				Элементы.СвязатьСЗаказомКлиента.Видимость = Ложь;
				Элементы.ПодменюСоздатьНаОсновании.Видимость = Ложь;
				Элементы.ПодменюПечать.Видимость = Ложь;
			КонецЕсли;
		КонецЕсли;
		//++ #1248 смарт: Фролов 16.12.2022 //Интерактивная карта в 1С  
		Если НЕ РольДоступна("ПолныеПрава") Тогда
			Элементы.ГруппаКоординаты.Видимость=Ложь;		
		КонецЕсли;	
		//-- #1248 смарт: Фролов 16.12.2022
	КонецЕсли;
	
	//-- смарт:ММ 31.08.2021
	
	//++ смарт:ММ 655 28.09.2021 
	ЗаметкиПоДокументу.Параметры.УстановитьЗначениеПараметра("Предмет", Объект.Ссылка);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаметкиПоДокументу, "Предмет", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно,, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	//-- смарт:ММ 28.09.2021

	//++ смарт:ММ 684 20.10.2021 
	КлиентИзЧерногоСписка = ПоказатьПредупреждениеПоКлиенту(Объект.Партнер);
	//-- смарт:ММ 20.10.2021
	//++ #1325 смарт: Фролов 20.03.2023 //Добавить в зявку на ремонт учет бесплатных услуг 
	ЭтаФорма.ИтогоБесплатныеУслуги=Объект.БесплатныеУслуги.Итог("Сумма");
	Если Объект.Ссылка.Пустая() Тогда   
		
		//++ #1940 смарт: Мосолов 18.09.2024 //Изменения статусов в Заявках на ремонт Представительствами. 
		Если НЕ (Параметры.Свойство("Основание") И ЗначениеЗаполнено(Параметры.Основание) И ЗначениеЗаполнено(Объект.Представительство)) Тогда
		//-- #1940 смарт: Мосолов 18.09.2024
	
		Объект.Представительство = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ПодразделениеГоловнойОфисМосква", Ложь);
		
		//++ #1940 смарт: Мосолов 18.09.2024 //Изменения статусов в Заявках на ремонт Представительствами. 
		КонецЕсли;
		//-- #1940 смарт: Мосолов 18.09.2024
		
	КонецЕсли;	
	//-- #1325 смарт: Фролов 20.03.2023 
	
	//++ #Б-3640 смарт: Фролов 26.06.2025 //Добавление функционала работы с взаимодействиями в заявки СЦ.
	Взаимодействия.Параметры.УстановитьЗначениеПараметра("ДокументОснование", Объект.Ссылка);
	
	Если Параметры.Свойство("ПозиционироватьНаВзаимодействие") Тогда
		КлючОткрываемойАктивности = Параметры.ПозиционироватьНаВзаимодействие;
	КонецЕсли;
	//-- #Б-3640 смарт: Фролов 26.06.2025
	
	//++ #2038 смарт: Мосолов 06.09.2024 // Доработка гарантийного блока / Добавить Организацию продавца оборудования (заявка на ремонтные работы)
    ОпределитьВывестиОрганизациюПродавца();
	//-- #2038 смарт: Мосолов 06.09.2024
	
	//++ #3948 смарт: Шляпников 04.08.2025 / Установить запрет на редактирование поля "Описание неисправности" в заявке на ремонт
	Элементы.ОписаниеНеисправности.ТолькоПросмотр = НЕ Пользователи.РолиДоступны("ПолныеПрава,смартРазрешеноРедактироватьОписаниеНеисправностиВЗаявкеНаРемонт");
	//-- #3948 смарт: Шляпников 04.08.2025
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Партнер");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
		
	//++ #Б-5892 смарт: Фролов 02.03.2026 //Создание механизма гибкой настройки ЗРР.
	Если Справочники.смартПредопределенныеЗначения.Настройки.ИспользоватьМеханизмГибкойНастройкиЗРР Тогда
		
		ИспользоватьМеханизмГибкойНастройкиЗРР = Истина;
		
		Если Объект.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ЗаявкаАннулирована Тогда
		
			Элементы.ПричинаЗакрытия.Видимость = Истина;
			
		КонецЕсли;	
		
		Элементы.СтраницаБесплатныеУслуги.Видимость = Ложь;
		Элементы.СтраницаДополнительно.Видимость = Ложь;
		Элементы.СтраницаЗаметки.Видимость = Ложь;
		Элементы.СтраницаВзаимодействия.Видимость = Ложь;
		
		ШаблонДляЗРР = Справочники.смартШаблоныДанныхКонструктора.НайтиПоНаименованию("Шаблон для ЗРР");
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ПредварительнаяПроверкаЛ Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаПредварительнаяПроверкаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаПредварительнаяПроверкаЛево);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ДиагностикаЛ Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаДиагностикаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаДиагностикаЛево);
				
			КонецЕсли;	
			
		КонецЦикла;	

		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ИнженернаяСлужбаЛ Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаИнженернаяСлужбаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаИнженернаяСлужбаЛево);
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ОККЛ Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаОККТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаОККЛево);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ПредварительнаяПроверкаП Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаПредварительнаяПроверкаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаПредварительнаяПроверкаПраво);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ДиагностикаП Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаДиагностикаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаДиагностикаПраво);
				
			КонецЕсли;	
			
		КонецЦикла;	

		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ИнженернаяСлужбаП Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаИнженернаяСлужбаТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаИнженернаяСлужбаПраво);
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		Для Каждого СтрШаблонДляЗРР Из ШаблонДляЗРР.ОККП Цикл
			
			Если Тип(Элементы[СтрШаблонДляЗРР.ИмяРеквизита]) = Тип("ТаблицаФормы") Тогда
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаОККТаблицы);
				
			Иначе
				
				Элементы.Переместить(Элементы[СтрШаблонДляЗРР.ИмяРеквизита], Элементы.ГруппаОККПраво);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		//++ #Б-5028 смарт: Фролов 24.11.2025 //Доработка документа Заявка на ремонтные работы, по новому регламенту
		Если Объект.Ссылка.Пустая() Тогда
			
			Если Объект.Представительство = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ПодразделениеГоловнойОфисМосква", Ложь) Тогда
				
				Объект.Этап = Справочники.смартЭтапыПроцессов.ПредварительнаяПроверка;
				
			Иначе
				
				Объект.Этап = Справочники.смартЭтапыПроцессов.ВсеЭтапы;
				
			КонецЕсли;	
			
		ИначеЕсли НЕ ЗначениеЗаполнено(Объект.Этап) И Объект.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка Тогда
			
			Если Объект.Представительство = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ПодразделениеГоловнойОфисМосква", Ложь) Тогда
				
				Объект.Этап = Справочники.смартЭтапыПроцессов.ПредварительнаяПроверка;
				
			Иначе
				
				Объект.Этап = Справочники.смартЭтапыПроцессов.ВсеЭтапы;
				
			КонецЕсли;	
			
		КонецЕсли;
	
		ТекущийЭтап = Объект.Этап;
		ТекущийСтатус = Объект.Статус;
		
		ЗаполнитьЦветаЭтапа();

		ДССостояния.Параметры.УстановитьЗначениеПараметра("Заявка", Объект.Ссылка);
		ЗаполнитьТаблицуСтатусовИПереходов();
		МассивСтатусов = ДоступныеСтатусыИПереходы.Выгрузить().ВыгрузитьКолонку("Статус");
		Элементы.Статус.РежимВыбораИзСписка = Истина;
		Элементы.Статус.СписокВыбора.ЗагрузитьЗначения(ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСтатусов));
		Если Элементы.Статус.СписокВыбора.НайтиПоЗначению(Объект.Статус) = Неопределено Тогда
			Элементы.Статус.СписокВыбора.Добавить(Объект.Статус);
		КонецЕсли;
		Элементы.КомментарийЭтапа.Видимость = Ложь;
					
	Иначе
		
		Элементы.СтраницаПредварительнаяПроверка.Видимость = Ложь;
		Элементы.СтраницаДиагностика.Видимость = Ложь;
		Элементы.СтраницаИнженернаяСлужба.Видимость = Ложь;
		Элементы.СтраницаОКК.Видимость = Ложь;
		
		Элементы.Переместить(Элементы.Статус, Элементы.ГруппаДляВсемогущих, Элементы.ГруппаИнженер);
		
		Элементы.ГруппаЭтапыИЛента.Видимость = Ложь;
		
	КонецЕсли;
	//-- #Б-5892 смарт: Фролов 04.03.2026
	
	//++ #6302 смарт: Тимофеева 17.04.2026 / Создать оповещение о незаконченной заявке на гарантийный ремонт 
	Элементы.ЗаявкаНаГарантийныйРемонтНеТребуется.Видимость = Объект.ВидГарантии = Перечисления.смартВидыГарантии.Гарантия;
	Элементы.ДатаЗавершенияРемонта.Видимость = Пользователи.РолиДоступны("ПолныеПрава");
	//-- #6302 смарт: Тимофеева 17.04.2026
	
	//++ #Б-7076 смарт: Фролов 08.06.2026 //Заявка на ремонтные работы. Доработка формы. Отражение информации по технической отсрочке.
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;	
	смартОбновитьСостояниеСтопЛистаТехническойОтсрочки();	
	//-- #Б-7076 смарт: Фролов 08.06.2026
	
КонецПроцедуры

//++ #2038 смарт: Мосолов 06.09.2024 // Доработка гарантийного блока / Добавить Организацию продавца оборудования (заявка на ремонтные работы)
&НаСервере
Процедура ОпределитьВывестиОрганизациюПродавца() 
	
	Если Объект.Оборудование.Количество() Тогда
		
		Запрос = Новый Запрос;  
		Запрос.УстановитьПараметр("Номенклатура", Объект.Оборудование[0].Оборудование);
		Запрос.УстановитьПараметр("Серия", Объект.Оборудование[0].Серия);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВыручкаИСебестоимостьПродажОбороты.ВидЗапасов.Организация КАК Организация
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
		|				И АналитикаУчетаНоменклатуры.Серия = &Серия) КАК ВыручкаИСебестоимостьПродажОбороты
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВыручкаИСебестоимостьПродажОбороты.Период УБЫВ"; 
		
		//++ #Б-1188 смарт: Мосолов 18.10.2024 // Проблема работы с документом Заявка на ремонтные работы.  
		УстановитьПривилегированныйРежим(Истина);
		//-- #Б-1188 смарт: Мосолов 18.10.2024   
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		//++ #Б-1188 смарт: Мосолов 18.10.2024 // Проблема работы с документом Заявка на ремонтные работы.  
		УстановитьПривилегированныйРежим(Ложь);
		//-- #Б-1188 смарт: Мосолов 18.10.2024   

		Если Выборка.Следующий() Тогда
			
			ОрганизацияПродавец = Выборка.Организация;
			
