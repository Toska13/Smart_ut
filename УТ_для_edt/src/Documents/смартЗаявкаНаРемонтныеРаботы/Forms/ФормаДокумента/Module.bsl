		Если НЕ Выборка.Валюта=Рубли Тогда
			Цена=РаботаСКурсамиВалют.ПересчитатьВВалюту(Цена,Выборка.Валюта,Рубли,?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата()));	
		КонецЕсли;	
		Возврат Цена;
	Иначе
		Возврат 0;		
	КонецЕсли;	
КонецФункции //-- #1325 смарт: Фролов 20.03.2023 

