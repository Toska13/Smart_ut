	ОбновитьБалансНаСервере();
КонецПроцедуры //-- смарт:ММ 19.09.2021

//++ смарт:ММ 615 19.09.2021 СМС инженеру 
&НаСервере
Процедура ОбновитьБалансНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	НастройкиОтправкиSMS = ОтправкаSMS.НастройкиОтправкиSMS();
	УстановитьПривилегированныйРежим(Ложь);
	
	ЛогинДляОтправкиSMS 	= НастройкиОтправкиSMS.Логин;
	ПарольДляОтправкиSMS 	= НастройкиОтправкиSMS.Пароль;
	
	Баланс = ОтправкаSMSЧерезSMSRU.смартПолучитьБаланс(ЛогинДляОтправкиSMS, ПарольДляОтправкиSMS);
	
	Если ТипЗнч(Баланс) = Тип("Число") Тогда
		смартОбщегоНазначения.ОбновитьБаланс(Баланс); // Обновление в справочнике смартПредопределенныеЗначения
		ОбновитьНадписьБаланс();
	Иначе
		ОбщегоНазначения.СообщитьПользователю("Не удалось запросить баланс");
	КонецЕсли;
		
КонецПроцедуры //-- смарт:ММ 19.09.2021


&НаКлиенте
//++ #Б-6426 смарт: Фролов 17.04.2026 //Реализовать предпросмотр присоединенных PDF файлов
Процедура СписокФайловПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.СписокФайлов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И РасширенияПоддерживающиеПредпросмотр.НайтиПоЗначению(ТекущиеДанные.Расширение) <> Неопределено Тогда

		Попытка
			
			ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(ТекущиеДанные.Ссылка, Неопределено, УникальныйИдентификатор,, АдресДанныхФайла);

			Если ДанныеФайла.Расширение = "pdf" Тогда
				
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресДанныхФайла);
				Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
				ЭтаФорма.PDFДокумент.Прочитать(Поток);

				Элементы.PDFДокумент.Видимость = Истина; 
				Элементы.АдресДанныхФайла.Видимость = Ложь;
				Элементы.PDFДокумент.Документ = ЭтаФорма.PDFДокумент;
				
			Иначе
				
				Элементы.PDFДокумент.Видимость = Ложь;
				Элементы.АдресДанныхФайла.Видимость = Истина;
				АдресДанныхФайла = ДанныеФайла.СсылкаНаДвоичныеДанныеФайла;
				
			КонецЕсли;

		Исключение
			// Если файла не существует, то будет вызвано исключение.
			АдресДанныхФайла         = Неопределено;
			ТекстНевыбраннойКартинки = НСтр("ru = 'Предварительный просмотр недоступен по причине:'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

	Иначе

		АдресДанныхФайла         = Неопределено;
		ТекстНевыбраннойКартинки = НСтр("ru = 'Нет данных для предварительного просмотра'");

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(АдресДанныхФайла) Тогда
		Элементы.АдресДанныхФайла.ТекстНевыбраннойКартинки = ТекстНевыбраннойКартинки;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
//++ #Б-6426 смарт: Фролов 17.04.2026 //Реализовать предпросмотр присоединенных PDF файлов
Процедура СписокПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
			
		ЭтаФорма.СписокФайлов.Параметры.УстановитьЗначениеПараметра("ВладелецФайла", ТекущиеДанные.Ссылка);
		
	Иначе
		
		ЭтаФорма.СписокФайлов.Параметры.УстановитьЗначениеПараметра("ВладелецФайла", ПредопределенноеЗначение("Документ.смартЗаявкаНаПускоНаладку.ПустаяСсылка"));
		
	КонецЕсли;
	
	Элементы.PDFДокумент.Видимость = Ложь; 
	ЭтаФорма.АдресДанныхФайла = Неопределено;
	Элементы.АдресДанныхФайла.Видимость = Истина;
	
КонецПроцедуры
