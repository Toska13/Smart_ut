Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		НезаполняемыеСвойства = "Дата, Номер, ПервичнаяЗаявка, НазначеннаяДатаРемонтаС, НазначеннаяДатаРемонтаПо, Командировка, НазначенныйНаРемонтИнженер, НазначенныйНаРемонтИнженер2, Статус,НазначеннаяДатаРемонтаС2, НазначеннаяДатаРемонтаПо2";
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, , НезаполняемыеСвойства);
		ПервичнаяЗаявка = ДанныеЗаполнения;
		Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ПовторныйВыезд;
		
		Для Каждого Строка Из ДанныеЗаполнения.КонтактныеЛица Цикл
			НоваяСтрока = КонтактныеЛица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
		
		Для Каждого Строка Из ДанныеЗаполнения.Оборудование Цикл
			НоваяСтрока = Оборудование.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;

		//++ #Б-2908 смарт: Лопато 01.04.2025 //Ошибка ТГ Бота. При копировании заявки на ремонтные работы не очищаются реквизиты.  
		ОчиститьРеквизитыЗаполняемыеИнженером(ЭтотОбъект);
		//-- #Б-2908 смарт: Лопато 01.04.2025
		
	//++ смарт:ММ 596 30.08.2021
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов") Тогда
		
		ДокументОснование 	= ДанныеЗаполнения;
		Статус 				= Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка;
		Партнер 			= ДанныеЗаполнения.Клиент;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		
		ЗаявкаНаПНР = ДанныеЗаполнения.ДокументОснование;
		
		Если ЗначениеЗаполнено(ЗаявкаНаПНР) Тогда
			
			Организация = ЗаявкаНаПНР.Организация;
			АдресВыезда = ЗаявкаНаПНР.АдресВыезда;
			АдресВыездаЗначение 		= ЗаявкаНаПНР.АдресВыездаЗначение;
			АдресВыездаЗначенияПолей 	= ЗаявкаНаПНР.АдресВыездаЗначенияПолей;
			Представительство = ЗаявкаНаПНР.Представительство;
			ПостроениеЦветовыхПрофилей = ЗаявкаНаПНР.ПостроениеЦветовыхПрофилей;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ОборудованиеКлиентов", ДанныеЗаполнения.Оборудование);
			Отбор.Вставить("Серия", ДанныеЗаполнения.Серия);
			НайденныеСтроки = ЗаявкаНаПНР.Оборудование.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденнаяСтрока = НайденныеСтроки[0];
				СтрокаОборудование = Оборудование.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаОборудование, НайденнаяСтрока);
			КонецЕсли;
			
			Для Каждого СтрокаКЛ Из ЗаявкаНаПНР.КонтактныеЛица Цикл
				СтрокаКонтактноеЛицо = КонтактныеЛица.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаКонтактноеЛицо, СтрокаКЛ);
			КонецЦикла;
			
		Иначе
			НоваяСтрокаОборудование = Оборудование.Добавить();
			НоваяСтрокаОборудование.ОборудованиеКлиентов = ДанныеЗаполнения.Оборудование;
			НоваяСтрокаОборудование.Серия = ДанныеЗаполнения.Серия;			
		КонецЕсли;
		
		//++ #1940 смарт: Мосолов 18.09.2024 //Изменения статусов в Заявках на ремонт Представительствами. 
		Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ПолученаВРаботу;  
		
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Подразделение) Тогда  
			Представительство = ДанныеЗаполнения.Подразделение;
		Иначе
			Представительство = Партнер.смартОсновнойМенеджерСервисЦентра;
		КонецЕсли;
		//-- #1940 смарт: Мосолов 18.09.2024  
		
	//-- смарт:ММ 30.08.2021
	//++ #1259 смарт: Фролов 29.11.2022 //Заявка на ПНР и ремонтные работы (смарт) - доработка форм заявок  
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда	
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ДанныеЗаполнения);
		ДокументОснование 	= ДанныеЗаполнения;
		Дата=ТекущаяДатаСеанса();
		УстановитьНовыйНомер("ПНР");
		ВидГарантии=Перечисления.смартВидыГарантии.Гарантия;
		Для Каждого СтрокаКЛ Из ДанныеЗаполнения.КонтактныеЛица Цикл
			СтрокаКонтактноеЛицо = КонтактныеЛица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКонтактноеЛицо, СтрокаКЛ);
		КонецЦикла; 
		Для Каждого СтрокаОб Из ДанныеЗаполнения.Оборудование Цикл
			СтрокаОборудование = Оборудование.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОборудование, СтрокаОб);
		КонецЦикла;
	//-- #1259 смарт: Фролов 29.11.2022
	//++ #1259 смарт: Фролов 08.12.2022 //Дополнение  
		КомментарийМенеджера="";
		ДокументыОтКлиента="";
		ДанныеИзПисьмаОснования="";
		КтоОплачиваетВыездСИ="";
		ПереченьНеобходимыхРабот="";
		ПостроениеЦветовыхПрофилей=0;
	//-- #1259 смарт: Фролов 08.12.2022
	// ++ 28.02.2021    
	
		//++ #1940 смарт: Мосолов 18.09.2024 //Изменения статусов в Заявках на ремонт Представительствами. 
		Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ПолученаВРаботу;  
		
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Представительство) Тогда  
			Представительство = ДанныеЗаполнения.Представительство;
		Иначе
			Представительство = ДанныеЗаполнения.Партнер.смартОсновнойМенеджерСервисЦентра;
		КонецЕсли;
		//-- #1940 смарт: Мосолов 18.09.2024  
		
		//++ #Б-2908 смарт: Лопато 01.04.2025 //Ошибка ТГ Бота. При копировании заявки на ремонтные работы не очищаются реквизиты.  
		ОчиститьРеквизитыЗаполняемыеИнженером(ЭтотОбъект);
		//-- #Б-2908 смарт: Лопато 01.04.2025
		
	//++ #1646 смарт: Мосолов 20.02.2024 // Контроль разобранного оборудования и снятых запчастей 
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ДокументОснование 	= ДанныеЗаполнения;
		Партнер 			= ДанныеЗаполнения.Партнер;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		Организация 		= ДанныеЗаполнения.Организация;   
	//-- #1646 смарт: Мосолов 20.02.2024 	
	
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
	//-- #1989 смарт: Лопато 15.08.2024
	
	Иначе
		ВидГарантии = Перечисления.смартВидыГарантии.Платная;
