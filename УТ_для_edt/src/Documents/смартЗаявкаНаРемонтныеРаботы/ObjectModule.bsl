		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер2", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер", Справочники.Пользователи.ПустаяСсылка());
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер2", Справочники.Пользователи.ПустаяСсылка());
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийСтатус", Ссылка.Статус);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартСсылкаПроведен", Ссылка.Проведен);
		
