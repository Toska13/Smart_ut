				//Иначе	
				//	
				//	РольИсполнителя = Представительство.смартИсполнительОтПодразделения; 
				
				//КонецЕсли;
				
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	Исполнитель КАК Исполнитель
				|ИЗ
				|	РегистрСведений.ИсполнителиЗадач
				|ГДЕ
				|	РольИсполнителя = &РольИсполнителя");
				Запрос.УстановитьПараметр("РольИсполнителя", РольИсполнителя);
				
				Выборка = Запрос.Выполнить().Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
					ЗадачаОбъект.Дата = ТекущаяДатаСеанса();
					ЗадачаОбъект.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
					ЗадачаОбъект.смартВидЗадачи = Справочники.смартВидыЗадач.ОформлениеКомандировки;
					ЗадачаОбъект.CRM_Личная = Истина;
					
					ЗадачаОбъект.Исполнитель = Выборка.Исполнитель;
					
					ЗадачаОбъект.Предмет = Ссылка;
					
					ЗадачаОбъект.Описание = "Необходимо оформить командировку по заявке на ремонтные работы " + Ссылка;
					ЗадачаОбъект.Наименование = "Необходимо оформить командировку по заявке на ремонтные работы";
					ЗадачаОбъект.Автор = Пользователи.ТекущийПользователь();
					ЗадачаОбъект.СрокИсполнения = ЗадачаОбъект.Дата + 86400;
					ЗадачаОбъект.Записать();
					
				КонецЦикла;
				
			КонецЕсли;
			//-- #Б-3668 смарт: Фролов 01.07.2025
			
		КонецЕсли;	
		
	КонецЕсли;
