Функция ПолучитьДанныеКонтактногоЛица(КонтактноеЛицо) Экспорт
	
	СтруктураВозврат = Новый Структура;
	СтруктураВозврат.Вставить("Телефон", "");
	СтруктураВозврат.Вставить("ЭлПочта", "");
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Телефон.Представление КАК Телефон,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ ВТ_ПриоритетыТелефонов
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК Телефон
	|ГДЕ
	|	Телефон.Ссылка = &КонтактноеЛицо
	|	И Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Мобильный.Представление,
	|	2
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК Мобильный
	|ГДЕ
	|	Мобильный.Ссылка = &КонтактноеЛицо
	|	И Мобильный.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И Мобильный.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВТ_ПриоритетыТелефонов.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВТ_МинимальныйПриоритет
	|ИЗ
	|	ВТ_ПриоритетыТелефонов КАК ВТ_ПриоритетыТелефонов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ПриоритетыТелефонов.Телефон КАК Телефон
	|ПОМЕСТИТЬ ВТ_Телефон
	|ИЗ
	|	ВТ_МинимальныйПриоритет КАК ВТ_МинимальныйПриоритет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПриоритетыТелефонов КАК ВТ_ПриоритетыТелефонов
	|		ПО ВТ_МинимальныйПриоритет.Приоритет = ВТ_ПриоритетыТелефонов.Приоритет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ЭлАдрес.Представление) КАК ЭлПочта
	|ПОМЕСТИТЬ ВТ_ЭлПочта
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК ЭлАдрес
	|ГДЕ
	|	ЭлАдрес.Ссылка = &КонтактноеЛицо
	|	И ЭлАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И ЭлАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтактногоЛица)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_Телефон.Телефон, """") КАК Телефон,
	|	ЕСТЬNULL(ВТ_ЭлПочта.ЭлПочта, """") КАК ЭлПочта
	|ИЗ
	|	ВТ_Телефон КАК ВТ_Телефон
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ЭлПочта КАК ВТ_ЭлПочта
	|		ПО (ИСТИНА)";
		
	Запрос.УстановитьПараметр("КонтактноеЛицо", КонтактноеЛицо);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СтруктураВозврат.Телефон = Выборка.Телефон;
		СтруктураВозврат.ЭлПочта = Выборка.ЭлПочта;
		
	КонецЕсли;

	Возврат СтруктураВозврат;
	
КонецФункции

