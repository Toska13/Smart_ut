	АдресВыезда = "";
	АдресВыездаЗначенияПолей = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияАдрес.Представление, """") КАК АдресВыезда,
