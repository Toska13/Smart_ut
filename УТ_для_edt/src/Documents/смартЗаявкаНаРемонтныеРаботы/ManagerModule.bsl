	ПервыйДокумент = Истина;
	ВыборкаДокументы = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
		ОбластьШапка.Параметры.Дата = Формат(ВыборкаДокументы.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		ОбластьШапка.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокументы.Номер);
