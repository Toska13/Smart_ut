Функция СформироватьПредставлениеДокумента(ДокументСсылка)
	
	НомерДляПечати = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументСсылка.Номер);
	
	//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
	НомерДляПечати = СокрЛП(НомерДляПечати);
	//-- смарт:ММ 04.03.2021
	
	Возврат "Заявка на ремонтные работы №" + НомерДляПечати + " от " + Формат(ДокументСсылка.Дата, "ДФ='dd.MM.yyyy ""г.""'");
	
