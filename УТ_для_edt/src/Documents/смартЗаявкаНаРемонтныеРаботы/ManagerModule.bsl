			Вложения.Добавить(Вложение);
			
			// ++ 30.08.2021
			// Добавить во вложения присоединенные к документу файлы	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.Ссылка КАК Ссылка,
			|	смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.Расширение КАК Расширение,
			|	смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
			|	смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.ФайлХранилище КАК ФайлХранилище,
			|	смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.Наименование КАК Наименование
			|ИЗ
			|	Справочник.смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы КАК смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы
			|ГДЕ
			|	НЕ смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.ПометкаУдаления
			|	И смартЗаявкаНаРемонтныеРаботыПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла";
			
			Запрос.УстановитьПараметр("ВладелецФайла", ДокументСсылка);
						
			ВыборкаФайл = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаФайл.Следующий() Цикл
				
				Вложение = Новый Структура;
				
				Формат = "." + ВыборкаФайл.Расширение;

				ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ВыборкаФайл.Ссылка);
				
				Если ДвоичныеДанные = Неопределено Тогда
					Продолжить;
				КонецЕсли;			
				
				ПредставлениеДокумента = ВыборкаФайл.Наименование;
				ИмяВложения = "" + ПредставлениеДокумента + Формат;
				ИмяВременногоФайла = ПутьКВФ + ИмяВложения;
				ДвоичныеДанные.Записать(ИмяВременногоФайла);
				
				Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайла);
				Вложение.Вставить("Представление", ИмяВложения);
				
				Вложения.Добавить(Вложение);
				
			КонецЦикла;
			
			// --
		КонецЕсли;
		//--
			
		ПараметрыОтправки.Вставить("ТекстПисьма", ТекстПисьма);
		ПараметрыОтправки.Вставить("Вложения", Вложения);
		
		Успех = ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений);
		
		Если Успех Тогда
			МассивСообщений.Добавить("     Отправлено уведомление инженеру о назначении на заявку");
			//++ смарт:ММ 615 15.09.2021 СМС инженеру
			Если ОтправлятьСМС Тогда
				
				ТекстСообщения = "Проверьте почту. Для вас есть новая заявка:";
				
				//++ #1803 смарт: Мосолов 27.04.2024 //Доработать отправку СМС из документа Заявка на ремонтные работы
				ТекстСообщения = ТекстСообщения + " № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"); 
				//-- #1803 смарт: Мосолов 27.04.2024
				
				Результат = смартОбщегоНазначения.ОтправитьСМСПользователю(Пользователь, ТекстСообщения);
				
				Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					МассивСообщений.Добавить("		Не удалось отправить SMS инженеру: " + Результат.ОписаниеОшибки);
				Иначе
					МассивСообщений.Добавить("		Отправлено SMS инженеру");
				КонецЕсли;

			КонецЕсли;
			//-- смарт:ММ 15.09.2021
		Иначе
			МассивСообщений.Добавить("     Ошибка при отправке уведомления инженеру о назначении на заявку");
		КонецЕсли;

		// ++ 30.08.2021
		Попытка
			Для Каждого Вложение Из Вложения Цикл
				УдалитьФайлы(Вложение.АдресВоВременномХранилище);
			КонецЦикла;			
		Исключение
		КонецПопытки;		
		// --
		
	ИначеЕсли ВидУведомления = "Отмена" Тогда
		
		//ТекстПисьма = "Отмена заявки на ремонтные работы №" + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ='dd.MM.yyyy ""г.""'")
		//+ Символы.ПС + Символы.ПС + "Контрагент: " + Контрагент 
		//+ Символы.ПС + "Оборудование: " + ТекстОборудование;
		ТекстПисьма = "Для вас отменены работы по заявке № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		ПараметрыОтправки.Вставить("ТекстПисьма", ТекстПисьма);

		Успех = ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений);
	
		Если Успех Тогда
			МассивСообщений.Добавить("     Отправлено уведомление инженеру об отмене заявки");
			//++ смарт:ММ 615 15.09.2021 СМС инженеру
			Если ОтправлятьСМС Тогда
				
