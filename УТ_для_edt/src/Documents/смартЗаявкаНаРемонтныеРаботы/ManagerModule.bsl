//-- смарт:ММ 05.10.2021
//-- смарт:ММ 15.09.2021
	// ++ 28.02.2021
	Настройка = Справочники.смартПредопределенныеЗначения.ОтправлятьУведомленияПриЗагрузкеЗаявкиНаРемонт;
