Функция ПолучитьАдресРуководителяПредставительства(Представительство, АдресаДляОтправкиСтрокой = "") 
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ПользователиДляОтправки.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ПользователиДляОтправки.смартРабочаяПочта
	|	КОНЕЦ КАК Значение,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ ВТ_ВсеПриоритеты
	|ИЗ
	|	Справочник.Пользователи КАК ПользователиДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиДляОтправки.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
	|ГДЕ
	|	ПользователиДляОтправки.Ссылка = &смартРуководительСервисногоЦентра
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПользователиДляОтправки.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ПользователиДляОтправки.смартРабочаяПочта
	|	КОНЕЦ КАК Значение,
	|	2 КАК Приоритет
	|ИЗ
	|	Справочник.Пользователи КАК ПользователиДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиДляОтправки.Ссылка
	|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)
	|ГДЕ
	|	ПользователиДляОтправки.ФизическоеЛицо = &ФизическоеЛицо
	//++ #4438 смарт: Тимофеева 26.09.2025 / Рассылка по Заявке на ремонтные работы (смарт). Доработка 
	|	И &ФизическоеЛицоРуководительЗаполнено
	//-- #4438 смарт: Тимофеева 26.09.2025
	|;
	|ВЫБРАТЬ
	|  МИНИМУМ(ВТ.Приоритет) КАК МинимальныйПриоритет
	|ПОМЕСТИТЬ ВТ_МинимальныйПриоритет
	|ИЗ
	|  ВТ_ВсеПриоритеты КАК ВТ
	|;
	|
	|ВЫБРАТЬ
	|  ВТ_ВсеПриоритеты.Значение
	|ИЗ 
	|	ВТ_ВсеПриоритеты КАК ВТ_ВсеПриоритеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МинимальныйПриоритет КАК ВТ_МинимальныйПриоритет
	|		ПО ВТ_ВсеПриоритеты.Приоритет = ВТ_МинимальныйПриоритет.МинимальныйПриоритет";
	
	Запрос.УстановитьПараметр("ПочтаПользователя", Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	Запрос.УстановитьПараметр("ФизическоеЛицо", Представительство.ТекущийРуководитель);
	Запрос.УстановитьПараметр("смартРуководительСервисногоЦентра", Представительство.смартРуководительСервисногоЦентра);
	//++ #4438 смарт: Тимофеева 26.09.2025 / Рассылка по Заявке на ремонтные работы (смарт). Доработка 
	Запрос.УстановитьПараметр("ФизическоеЛицоРуководительЗаполнено", ЗначениеЗаполнено(Представительство.ТекущийРуководитель));
	//-- #4438 смарт: Тимофеева 26.09.2025 
		
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

//++ #1366 смарт: Фролов 05.06.2023 //Отслеживать появление на складах запчастей, требуемых для выполнения заявок со статусом  
Функция ОтправитьОповещениеПоОжидаемымЗапчастям(МассивСообщений = Неопределено,ТекстПисьма,ДокументСсылка,Получатель,ТемаПисьмаТекст) Экспорт
	
	Успех = Ложь;
	
	Если МассивСообщений = Неопределено Тогда
		МассивСообщений = Новый Массив;
	КонецЕсли;     
	
    НомерДокумента=ДокументСсылка.Номер;

	АдресаДляОтправкиСтрокой = "";
	//МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой); 
	МассивАдресовДляОтправки=Новый Массив;
	Если ЗначениеЗаполнено(Получатель) Тогда
		ПочтаПолучатель=ПолучитьАдресОтветственного(Получатель, АдресаДляОтправкиСтрокой);
		Если ПочтаПолучатель.Количество()>0 Тогда
			МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес,Представление", ПочтаПолучатель[0].Адрес, ПочтаПолучатель[0].Адрес));	
		КонецЕсли;
	КонецЕсли; 
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ДополнительныеСведения.Значение КАК Объект
	                    |ИЗ
	                    |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	                    |ГДЕ
	                    |	ДополнительныеСведения.Свойство.Имя = &Имя
	                    |	И ДополнительныеСведения.Объект = &Получатель");
	Запрос.УстановитьПараметр("Имя","ПользователиСовместноПолучающиеИнформациюОбОповещенияОбОжидаемыхЗапчастях");
	Запрос.УстановитьПараметр("Получатель",Получатель); 
	Выборка=Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Объект) Тогда
			ПочтаПолучатель=ПолучитьАдресОтветственного(Выборка.Объект, АдресаДляОтправкиСтрокой);
			Если ПочтаПолучатель.Количество()>0 Тогда
				МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес,Представление", ПочтаПолучатель[0].Адрес, ПочтаПолучатель[0].Адрес));	
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;	
	//Если ЗначениеЗаполнено(ДокументСсылка.НазначенныйНаРемонтИнженер2) Тогда
	//	ПочтаНазначенныйНаРемонтИнженер2=ПолучитьАдресОтветственного(ДокументСсылка.НазначенныйНаРемонтИнженер2, АдресаДляОтправкиСтрокой);
	//	Если ПочтаНазначенныйНаРемонтИнженер2.Количество()>0 Тогда
	//		МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес,Представление", ПочтаНазначенныйНаРемонтИнженер2[0].Адрес, ПочтаНазначенныйНаРемонтИнженер2[0].Адрес));	
	//	КонецЕсли;	
	//КонецЕсли;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	ТемаПисьма=""+ТемаПисьмаТекст+" "+НомерДокумента+"";
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо по заявке на ремонт " + НомерДокумента + " НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
			Иначе
				
			ТекстСообщения = "Отправлено письмо по заявке на ремонт " + НомерДокумента + " на почту " +  АдресаДляОтправкиСтрокой;
			
			КонецЕсли;
				
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Успех = Истина;
		Исключение
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ДокументСсылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить письмо по ожидаемым запчастям по заявке на ремонт "  + НомерДокумента + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецПопытки;
	КонецЕсли; 
	
	Возврат Успех;
	
КонецФункции //-- #1366 смарт: Фролов 05.06.2023

