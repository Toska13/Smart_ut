Функция ПолучитьАдресаКлиентаДляОтправки(ДокументСсылка, АдресаДляОтправкиСтрокой = "")
	
	МассивАдресов = Новый Массив;
	//rnp 26.04.2021
	//++ смарт:ММ #082 397 26.05.2021 - не нашелся такой предопределенный, пока заменила на похожий
	//СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.АдресДляТестовыхУведомленийКлиенту;
	СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.ТестовыйАдресУведомленийКлиенту;
	//-- смарт:ММ 26.05.2021
	АдресТест = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаНаПредопределенноеЗначение, АдресаДляОтправкиСтрокой, Ложь);
	Если ЗначениеЗаполнено(АдресТест) Тогда
		Возврат АдресТест;
	КонецЕсли;
	//
	Для Каждого СтрокаКЛ Из ДокументСсылка.КонтактныеЛица Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаКЛ.АдресЭПКонтактногоЛица) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(СтрокаКЛ.АдресЭПКонтактногоЛица);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

