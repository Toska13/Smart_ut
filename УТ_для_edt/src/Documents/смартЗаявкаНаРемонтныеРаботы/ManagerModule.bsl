	Если ЗначениеЗаполнено(ДокументСсылка.НазначенныйНаРемонтИнженер2) Тогда
		ТекстИнженер = "инженеров " + ДокументСсылка.НазначенныйНаРемонтИнженер + " и " + ДокументСсылка.НазначенныйНаРемонтИнженер2;
	Иначе
		ТекстИнженер = "инженера " + ДокументСсылка.НазначенныйНаРемонтИнженер;
	КонецЕсли;

	ТекстПисьма = "К Вашему клиенту " + ДокументСсылка.Партнер + " будет осуществлен выезд " 
	+ ТекстИнженер + " по заявке № " + ПараметрыОтправки.НомерДокумента;

	// В параметрах отправки уже есть тема, учетная запись
	
	ПараметрыОтправки.Вставить("ТекстПисьма", ТекстПисьма);
	ПараметрыОтправки.Вставить("МассивАдресовДляОтправки", МассивАдресовДляОтправки);
	ПараметрыОтправки.Вставить("АдресаДляОтправкиСтрокой", АдресаДляОтправкиСтрокой);
	
	Успех = ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений);
	
	Если Успех Тогда
		МассивСообщений.Добавить("     Отправлено уведомление ответственному менеджеру СЦ о назначении инженера(ов)");
	Иначе
		МассивСообщений.Добавить("     Ошибка при отправке уведомления ответственному менеджеру СЦ о назначении инженера(ов)");
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции //-- смарт:ММ 05.10.2021

