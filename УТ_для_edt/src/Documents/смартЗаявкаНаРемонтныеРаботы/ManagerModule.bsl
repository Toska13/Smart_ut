		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДокументы.НазначеннаяДатаРемонтаС) Тогда
			ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС = Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаС, "ДФ='dd.MM.yyyy ""г.""'");
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДокументы.НазначеннаяДатаРемонтаПо) И ВыборкаДокументы.НазначеннаяДатаРемонтаС <> ВыборкаДокументы.НазначеннаяДатаРемонтаПо Тогда
			ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС = "с " + Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаС, "ДФ='dd.MM.yyyy ""г.""'") + " по " + Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаПо, "ДФ='dd.MM.yyyy ""г.""'");
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДокументы.НазначеннаяДатаРемонтаПо2) И ВыборкаДокументы.НазначеннаяДатаРемонтаС2 <> ВыборкаДокументы.НазначеннаяДатаРемонтаПо2 Тогда
			ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС = ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС + Символы.ПС + " и с " + Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаС2, "ДФ='dd.MM.yyyy ""г.""'") + " по " + Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаПо2, "ДФ='dd.MM.yyyy ""г.""'");
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДокументы.НазначеннаяДатаРемонтаС2) Тогда
			ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС = ОбластьШапка.Параметры.НазначеннаяДатаРемонтаС + Символы.ПС + " и " + Формат(ВыборкаДокументы.НазначеннаяДатаРемонтаС2, "ДФ='dd.MM.yyyy ""г.""'");	
		КонецЕсли;
		//
		//++ #5242 смарт: Тимофеева 29.12.2025 / Заявка на ремонтные работы. Добавить реквизит для выбора договора. 
		//ТабДокумент.Вывести(ОбластьШапка);
		Если ЗначениеЗаполнено(ВыборкаДокументы.ДоговорНаСервисноеОбслуживание) Тогда
			ЗаполнитьЗначенияСвойств(ОбластьШапкаСДоговором.Параметры, ОбластьШапка.Параметры);
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаДокументы.ДоговорНаСервисноеОбслуживание, "Номер, Дата");
			ОбластьШапкаСДоговором.Параметры.Договор = СтрШаблон("№ %1 от %2", РеквизитыДоговора.Номер, Формат(РеквизитыДоговора.Дата, "ДФ=dd.MM.yyyy"));
			//++ #Б-6270 смарт: Фролов 01.04.2026 //Заявка на ремонтные работы. Добавить реквизит для ДС. Обновить доработку по сервисным договорам РТО.
			ОбластьШапкаСДоговором.Параметры.ДополнительноеСоглашение = ?(ЗначениеЗаполнено(ВыборкаДокументы.ДополнительноеСоглашение), "от " + Формат(ВыборкаДокументы.ДополнительноеСоглашение, "ДФ=dd.MM.yyyy"), "");
			//-- #Б-6270 смарт: Фролов 01.04.2026
			ТабДокумент.Вывести(ОбластьШапкаСДоговором);	
		Иначе
			ТабДокумент.Вывести(ОбластьШапка);		
		КонецЕсли;
		//-- #5242 смарт: Тимофеева 29.12.2025
					
			
		// Вывод контактных лиц
		ВыборкаКонтактныеЛица = ВыборкаДокументы.КонтактныеЛица.Выбрать();
		
		Сч = 0;
		ОбластьКонтактныеЛица = Неопределено;
		НомерПП = 1;
		
		Пока ВыборкаКонтактныеЛица.Следующий() Цикл
			
			Сч = Сч + 1;
			
			Если Сч = 3 Тогда
				Сч = 1;
			КонецЕсли;
			
			Если Сч = 1 Тогда
				ОбластьКонтактныеЛица = Макет.ПолучитьОбласть("КонтактныеЛица|КолонкаЛево");
				ОбластьКонтактныеЛица.Параметры.НомерКЛ = НомерПП;
				ОбластьКонтактныеЛица.Параметры.КонтактноеЛицо = ВыборкаКонтактныеЛица.КонтактноеЛицо;
				ОбластьКонтактныеЛица.Параметры.ТелефонКонтактногоЛица = ВыборкаКонтактныеЛица.ТелефонКонтактногоЛица;
				ОбластьКонтактныеЛица.Параметры.АдресЭПКонтактногоЛица = ВыборкаКонтактныеЛица.АдресЭПКонтактногоЛица;
				ТабДокумент.Вывести(ОбластьКонтактныеЛица);
			КонецЕсли;
									
			НомерПП = НомерПП + 1;
		КонецЦикла;
		
		//++ #Б2452 смарт: Шляпников 20.02.2025 / Добавление информации об Основном менеджере СЦ в печатную форму заявки на выезд сервисного инженера
		ОбластьКонтактныеЛица = Макет.ПолучитьОбласть("КонтактныеЛица|КолонкаПраво");
		ОбластьКонтактныеЛица.Параметры.КонтактноеЛицо2 = ВыборкаДокументы.МенеджерСЦ;
		ОбластьКонтактныеЛица.Параметры.ТелефонКонтактногоЛица2 = ВыборкаДокументы.МенеджерСЦТелефон;
		ОбластьКонтактныеЛица.Параметры.АдресЭПКонтактногоЛица2 = ВыборкаДокументы.МенеджерСЦПочта;
		ТабДокумент.Присоединить(ОбластьКонтактныеЛица);
		//-- #Б2452 смарт: Шляпников 20.02.2025
				
		// Вывод оборудования
		ТабДокумент.Вывести(ОбластьОборудованиеШапка);
		
		ВыборкаОборудование = ВыборкаДокументы.Оборудование.Выбрать();
		
		НомерПП = 1;
		
		Пока ВыборкаОборудование.Следующий() Цикл
			
			ОбластьОборудование = Макет.ПолучитьОбласть("Оборудование");
			ОбластьОборудование.Параметры.НомерПП = НомерПП;
			ЗаполнитьЗначенияСвойств(ОбластьОборудование.Параметры, ВыборкаОборудование);
			
			//++ смарт:ММ 591 13.08.2021
			//Если ЗначениеЗаполнено(ВыборкаОборудование.Серия) Тогда
			//	// ++ 13.02.2021
			//	//ОбластьОборудование.Параметры.Оборудование = "" + ВыборкаОборудование.Оборудование + Символы.ПС + "Серия: " + ВыборкаОборудование.Серия;
			//	
			//	Если ЗначениеЗаполнено(ВыборкаОборудование.ОборудованиеКлиентов) Тогда
			//		ТекущееОборудование = ВыборкаОборудование.ОборудованиеКлиентов;					
			//	Иначе
			//		ТекущееОборудование = ВыборкаОборудование.Оборудование;
			//	КонецЕсли;
			//	
			//	ОбластьОборудование.Параметры.Оборудование = "" + ТекущееОборудование + Символы.ПС + "Серия: " + ВыборкаОборудование.Серия;
			//	// --
			//КонецЕсли;
			
			ТекстОборудование = ВыборкаОборудование.Оборудование;
			Если Строка(ТекстОборудование) = "Не определена (для заявок на ремонт)" Тогда
				ТекстОборудование = "";
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ВыборкаОборудование.Серия) Тогда
				ТекстОборудование = "" + ТекстОборудование + Символы.ПС + "Серия: " + ВыборкаОборудование.Серия;	
			КонецЕсли;
			
			ОбластьОборудование.Параметры.Оборудование = ТекстОборудование;
			
			ОбластьОборудование.Параметры.ОборудованиеКлиента = ВыборкаОборудование.ОборудованиеКлиентов;
			//-- смарт:ММ 13.08.2021
			
			ТабДокумент.Вывести(ОбластьОборудование);

			НомерПП = НомерПП + 1;			
		КонецЦикла;
		
		
		// Подвал
		ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, ВыборкаДокументы);
		ТабДокумент.Вывести(ОбластьПодвал);
		
		//++смарт:Белоусова 669 08.10.21
		если ЗначениеЗаполнено( ВыборкаДокументы.ДанныеИзПисьмаОснования) тогда		
			ОбластьДанныеИзПисьмаОснования =  Макет.ПолучитьОбласть("ДанныеИзПисьмаОснования");
			ОбластьДанныеИзПисьмаОснования.параметры.ДанныеИзПисьмаОснования = ВыборкаДокументы.ДанныеИзПисьмаОснования;		
			ТабДокумент.Вывести(ОбластьДанныеИзПисьмаОснования);
		КонецЕсли;
		//--смарт:Белоусова 669 08.10.21

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
// Добавляет команду создания документа "Заявка на ремонтные работы".
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Функция ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании) Экспорт

	Если ПравоДоступа("Добавление", Метаданные.Документы.смартЗаявкаНаРемонтныеРаботы) Тогда

		КомандаСоздатьНаОсновании = КомандыСозданияНаОсновании.Добавить();
		КомандаСоздатьНаОсновании.Менеджер = Метаданные.Документы.смартЗаявкаНаРемонтныеРаботы.ПолноеИмя();
		КомандаСоздатьНаОсновании.Представление = ОбщегоНазначенияУТ.ПредставлениеОбъекта(Метаданные.Документы.смартЗаявкаНаРемонтныеРаботы);
		КомандаСоздатьНаОсновании.РежимЗаписи = "Проводить";
		
		Возврат КомандаСоздатьНаОсновании;
		
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции //-- #1989 смарт: Лопато 15.08.2024

//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
// Определяет список команд создания на основании.
//
// Параметры:
//   КомандыСозданияНаОсновании - ТаблицаЗначений - Таблица с командами создания на основании. Для изменения.
//       См. описание 1 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры СозданиеНаОснованииПереопределяемый.ПередДобавлениемКомандСозданияНаОсновании().
//
Процедура ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры) Экспорт
	
	Задачи.ЗадачаИсполнителя.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.ЗаказКлиента.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.ЗаказНаВнутреннееПотребление.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.ЗаказНаСборку.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.смартЗаявкаНаРазборкуОборудования.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	
	//++ #Б-1136 смарт: Мосолов 15.10.2024 //Доработка Воронки РТО
	Документы.ЗаказНаПеремещение.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	//-- #Б-1136 смарт: Мосолов 15.10.2024 
	
КонецПроцедуры //-- #1989 смарт: Лопато 15.08.2024

#КонецЕсли
