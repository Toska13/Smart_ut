#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Заявка на ремонтные работы
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "смартЗаявкаНаРемонтныеРаботы";
	КомандаПечати.Представление = НСтр("ru = 'Заявка на ремонт'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;

	//++ #Б-7128 смарт: Фролов 11.06.2026 //Создать печатную форму Служебной Записки
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "смартСлужебноеЗадание";
	КомандаПечати.Представление = НСтр("ru = 'Служебное задание'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	//-- #Б-7128 смарт: Фролов 11.06.2026
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартЗаявкаНаРемонтныеРаботы") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартЗаявкаНаРемонтныеРаботы",
				НСтр("ru = 'Заявка на ремонт'"),
				ПечатьЗаявкаНаРемонт(МассивОбъектов, ОбъектыПечати));
				
	//++ #Б-7128 смарт: Фролов 11.06.2026 //Создать печатную форму Служебной Записки			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартСлужебноеЗадание") Тогда
				
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартСлужебноеЗадание",
				НСтр("ru = 'Служебное задание'"),
				ПечатьСлужебноеЗадание(МассивОбъектов, ОбъектыПечати));
	//-- #Б-7128 смарт: Фролов 11.06.2026			

	КонецЕсли;
			
	СборкаТоваровЛокализация.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

//++ #Б-7128 смарт: Фролов 11.06.2026 //Создать печатную форму Служебной Записки
Функция ПечатьСлужебноеЗадание(МассивОбъектов, ОбъектыПечати)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаРемонтныеРаботы.Номер КАК Номер,
	|	смартЗаявкаНаРемонтныеРаботы.Дата КАК Дата,
	|	смартЗаявкаНаРемонтныеРаботы.ПервичнаяЗаявка.Номер КАК ПервичныйНомер,
	|	смартЗаявкаНаРемонтныеРаботы.ПервичнаяЗаявка.Дата КАК ПервичнаяДата,
	|	смартЗаявкаНаРемонтныеРаботы.Организация КАК Организация,
	|	смартЗаявкаНаРемонтныеРаботы.Контрагент КАК Контрагент,
	|	смартЗаявкаНаРемонтныеРаботы.АдресВыезда КАК АдресВыезда,
	|	смартЗаявкаНаРемонтныеРаботы.Ответственный КАК Ответственный,
	|	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер КАК НазначенныйНаРемонтИнженер,
	|	смартЗаявкаНаРемонтныеРаботы.НазначенныйНаРемонтИнженер2 КАК НазначенныйНаРемонтИнженер2,
	|	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС КАК НазначеннаяДатаРемонтаС,
	|	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо КАК НазначеннаяДатаРемонтаПо,
	|	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаС2 КАК НазначеннаяДатаРемонтаС2,
	|	смартЗаявкаНаРемонтныеРаботы.НазначеннаяДатаРемонтаПо2 КАК НазначеннаяДатаРемонтаПо2,
	|	смартЗаявкаНаРемонтныеРаботы.ЖелаемаяДатаРемонта КАК ЖелаемаяДатаРемонта,
	|	смартЗаявкаНаРемонтныеРаботы.КомментарийМенеджера КАК КомментарийМенеджера,
	|	смартЗаявкаНаРемонтныеРаботы.ДокументыОтКлиента КАК ДокументыОтКлиента,
	|	смартЗаявкаНаРемонтныеРаботы.ПереченьНеобходимыхРабот КАК ПереченьНеобходимыхРабот,
	|	смартЗаявкаНаРемонтныеРаботы.ПостроениеЦветовыхПрофилей КАК ПостроениеЦветовыхПрофилей,
	|	смартЗаявкаНаРемонтныеРаботы.ОписаниеНеисправности КАК ОписаниеНеисправности,
	|	смартЗаявкаНаРемонтныеРаботы.ВидГарантии КАК ВидГарантии,
	|	смартЗаявкаНаРемонтныеРаботы.Оборудование.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Оборудование КАК Оборудование,
	|		ОборудованиеКлиентов КАК ОборудованиеКлиентов,
	|		ГарантийныйСрокНаОборудование КАК ГарантийныйСрокНаОборудование,
	|		ГарантийныйСрокНаПечатающиеГоловки КАК ГарантийныйСрокНаПечатающиеГоловки,
	|		РастровыйПроцессор КАК РастровыйПроцессор,
	|		ТипЧернилОборудование КАК ТипЧернил,
	|		КонфигурацияЧернил КАК КонфигурацияЧернил,
	|		ДатаОтгрузки КАК ДатаОтгрузки,
	|		Серия КАК Серия
	|	) КАК Оборудование,
	|	смартЗаявкаНаРемонтныеРаботы.Ссылка КАК Ссылка,
	|	смартЗаявкаНаРемонтныеРаботы.Партнер.смартОсновнойМенеджерСервисЦентра КАК смартОсновнойМенеджерСервисЦентра,
	|	смартЗаявкаНаРемонтныеРаботы.Партнер.смартОсновнойМенеджерСервисЦентра.смартРабочаяПочта КАК МенеджерСЦПочта,
	|	смартЗаявкаНаРемонтныеРаботы.Партнер.смартОсновнойМенеджерСервисЦентра.Наименование КАК МенеджерСЦ,
	|	смартЗаявкаНаРемонтныеРаботы.ДоговорНаСервисноеОбслуживание КАК ДоговорНаСервисноеОбслуживание,
	|	смартЗаявкаНаРемонтныеРаботы.ДоговорНаСервисноеОбслуживание.смартДополнительноеСоглашениеДата КАК ДополнительноеСоглашение,
	|	смартЗаявкаНаРемонтныеРаботы.ДанныеИзПисьмаОснования КАК ДанныеИзПисьмаОснования
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	|ГДЕ
	|	смартЗаявкаНаРемонтныеРаботы.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМекет.смартСлужебноеЗадание");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_смартСлужебноеЗадание";
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

	ПервыйДокумент = Истина;
	ВыборкаДокументы = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументы.Следующий() Цикл		
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
		
		ОбластьШапка.Параметры.СтранаГород = ВыборкаДокументы.АдресВыезда;
		ОбластьШапка.Параметры.ФИО = ВыборкаДокументы.НазначенныйНаРемонтИнженер.ФизическоеЛицо.Наименование;
		ОбластьШапка.Параметры.Должность = ВыборкаДокументы.НазначенныйНаРемонтИнженер.ФизическоеЛицо.смартДолжность;
		ОбластьШапка.Параметры.ТабельныйНомер = ВыборкаДокументы.НазначенныйНаРемонтИнженер.ФизическоеЛицо.смартТабельныйНомер;
		ОбластьШапка.Параметры.Подразделение = ВыборкаДокументы.НазначенныйНаРемонтИнженер.Подразделение;
		ОбластьШапка.Параметры.Клиент = ВыборкаДокументы.Контрагент.Наименование;
		ОбластьШапка.Параметры.ДатаНачала = ВыборкаДокументы.НазначеннаяДатаРемонтаС;
		ОбластьШапка.Параметры.ДатаОкончания = ВыборкаДокументы.НазначеннаяДатаРемонтаПо;
		ДатаСоставленияПредварительная = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ВыборкаДокументы.НазначеннаяДатаРемонтаС, 1, "Назад");
		ОбластьШапка.Параметры.ДатаСоставления = ?(ДатаСоставленияПредварительная < ВыборкаДокументы.Дата, ВыборкаДокументы.Дата, ДатаСоставленияПредварительная);
		ОбластьШапка.Параметры.ДатаВозврата = НачалоДня(ВыборкаДокументы.НазначеннаяДатаРемонтаС) + 86400 * 25;
		ОбластьШапка.Параметры.КоличествоДней = (КонецДня(ВыборкаДокументы.НазначеннаяДатаРемонтаПо) - НачалоДня(ВыборкаДокументы.НазначеннаяДатаРемонтаС) + 1) / 86400;
		
		// Вывод оборудования
		ВыборкаОборудование = ВыборкаДокументы.Оборудование.Выбрать();
		
		НомерПП = 1; 
		
		Цель = "Ремонт оборудования ";
		
		Пока ВыборкаОборудование.Следующий() Цикл
			
			Цель = Цель + ?(Цель = "Ремонт оборудования ", "", Символы.ПС) + ВыборкаОборудование.ОборудованиеКлиентов.Наименование;
			
		КонецЦикла;
		
		ОбластьШапка.Параметры.Цель = Цель;

		ТабДокумент.Вывести(ОбластьШапка);
		// Подвал
		
		Если ЗначениеЗаполнено(ВыборкаДокументы.НазначенныйНаРемонтИнженер2) Тогда
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
			
			ОбластьШапка.Параметры.ФИО = ВыборкаДокументы.НазначенныйНаРемонтИнженер2.ФизическоеЛицо.Наименование;
			ОбластьШапка.Параметры.Должность = ВыборкаДокументы.НазначенныйНаРемонтИнженер2.ФизическоеЛицо.смартДолжность;
			ОбластьШапка.Параметры.ТабельныйНомер = ВыборкаДокументы.НазначенныйНаРемонтИнженер2.ФизическоеЛицо.смартТабельныйНомер;
			ОбластьШапка.Параметры.Подразделение = ВыборкаДокументы.НазначенныйНаРемонтИнженер2.Подразделение;
			ДатаСоставленияПредварительная = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ВыборкаДокументы.НазначеннаяДатаРемонтаС2, 1, "Назад");
			ОбластьШапка.Параметры.ДатаСоставления = ?(ДатаСоставленияПредварительная < ВыборкаДокументы.Дата, ВыборкаДокументы.Дата, ДатаСоставленияПредварительная);
			ОбластьШапка.Параметры.ДатаНачала = ВыборкаДокументы.НазначеннаяДатаРемонтаС2;
			ОбластьШапка.Параметры.ДатаОкончания = ВыборкаДокументы.НазначеннаяДатаРемонтаПо2;
			ОбластьШапка.Параметры.ДатаВозврата = НачалоДня(ВыборкаДокументы.НазначеннаяДатаРемонтаС2) + 86400 * 25;
			ОбластьШапка.Параметры.КоличествоДней = (КонецДня(ВыборкаДокументы.НазначеннаяДатаРемонтаПо2) 
				- НачалоДня(ВыборкаДокументы.НазначеннаяДатаРемонтаС2) + 1) / 86400;
			
			ТабДокумент.Вывести(ОбластьШапка);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции //-- #Б-7128 смарт: Фролов 11.06.2026

