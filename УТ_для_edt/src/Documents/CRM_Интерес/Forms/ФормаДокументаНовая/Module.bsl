&НаСервереБезКонтекста
Функция ПолучитьШиринуЭлемента(ЗначениеЭлемента, Полужирный = Ложь, ВебКлиент = Ложь)
	СтрокаЗначения = Строка(ЗначениеЭлемента);
	ДлинаПредставления = СтрДлина(СтрокаЗначения);
	Если ДлинаПредставления > 30 Тогда
		ШиринаЭлемента	= Окр(ДлинаПредставления / 1.4, 0, РежимОкругления.Окр15как20);
	ИначеЕсли ДлинаПредставления > 24 Тогда
		ШиринаЭлемента	= Окр(ДлинаПредставления / 1.35, 0, РежимОкругления.Окр15как20);
	ИначеЕсли ДлинаПредставления > 18 Тогда
		ШиринаЭлемента	= Окр(ДлинаПредставления / 1.3, 0, РежимОкругления.Окр15как20);
	ИначеЕсли ДлинаПредставления > 12 Тогда
		ШиринаЭлемента	= Окр(ДлинаПредставления / 1.25, 0, РежимОкругления.Окр15как20);
	Иначе	
		ШиринаЭлемента	= ДлинаПредставления;
	КонецЕсли;
	Если НЕ ВебКлиент Тогда
		ШиринаЭлемента	= ШиринаЭлемента - 1;
	КонецЕсли;	
	Если Полужирный	Тогда
		Если ДлинаПредставления > 18 Тогда
			ШиринаЭлемента	= ШиринаЭлемента + 2;
		Иначе	
			ШиринаЭлемента	= ШиринаЭлемента + 1;
		КонецЕсли;	
	КонецЕсли;
	Если ВРег(СтрокаЗначения) = СтрокаЗначения Тогда
		ШиринаЭлемента	= ШиринаЭлемента + 2;
	КонецЕсли;
	Возврат ШиринаЭлемента;
КонецФункции

&НаСервере
Процедура ОбновитьКомандыЛенты(ВебКлиент = Ложь)
	КоличествоЭлементов = Элементы.Лента_ОбычныйВвод.ПодчиненныеЭлементы.Количество();
	Для НомерЭлемента = 1 По КоличествоЭлементов Цикл
		ЭлементПанели = Элементы.Лента_ОбычныйВвод.ПодчиненныеЭлементы[КоличествоЭлементов - НомерЭлемента];
		Если ЭлементПанели.Имя = "ОбычныйВвод_ПоказатьЕще" Тогда
			ЭлементПанели.Видимость	= Истина;
			Продолжить;
		КонецЕсли;
		Элементы.Удалить(ЭлементПанели);
	КонецЦикла;
	ОписанияКоманд = CRM_ЛентаСобытий.КомандыОбычногоВводаЛенты("ЛентаИнтереса", Лента_ЗначенияНастроек);
	Для Каждого ОписаниеКоманды Из ОписанияКоманд Цикл
		ЭлементСписка = ОбычныйВвод_Команды.НайтиПоЗначению(ОписаниеКоманды.Значение);
		Если НЕ (ЭлементСписка = Неопределено) Тогда
			ОбычныйВвод_Команды.Удалить(ЭлементСписка);
		КонецЕсли;	
	КонецЦикла;
	ШиринаПанели = Элементы.ОбычныйВвод_ПоказатьЕще.Ширина + Элементы.Лента_Обновить.Ширина + Элементы.Лента_Отбор.Ширина;
	Для Каждого Элемент Из Элементы.Лента_КомандыЛево.ПодчиненныеЭлементы Цикл
		Если Элемент.Видимость Тогда
			Если (ШиринаПанели + Элемент.МаксимальнаяШирина) > ШиринаЛенты Тогда 
				Элемент.Видимость = Ложь;
				ИмяЭлемента = СтрЗаменить(Элемент.Имя, "БыстрыйВвод_", "");
				ОбычныйВвод_Команды.Добавить(Элемент.Имя, ИмяЭлемента, (ИмяЭлемента = БыстрыйВвод_ТекущийТипОбъекта));
			Иначе
				Элемент.Видимость = Истина;
				ШиринаПанели = ШиринаПанели + Элемент.МаксимальнаяШирина;
			КонецЕсли;
		Иначе
			ЭлементСписка = ОбычныйВвод_Команды.НайтиПоЗначению(Элемент.Имя);
			Если НЕ (ЭлементСписка = Неопределено) Тогда
				Если (ШиринаПанели + Элемент.МаксимальнаяШирина) > ШиринаЛенты Тогда
					ОбычныйВвод_Команды.Сдвинуть(ЭлементСписка, ОбычныйВвод_Команды.Количество() - 1);
				Иначе	
					Элемент.Видимость = Истина;
					ШиринаПанели = ШиринаПанели + Элемент.МаксимальнаяШирина;
					ОбычныйВвод_Команды.Удалить(ЭлементСписка);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	Для Каждого ОписаниеКоманды Из ОписанияКоманд Цикл
		НоваяКоманда = ОбычныйВвод_Команды.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяКоманда, ОписаниеКоманды);
	КонецЦикла;
	Пока ОбычныйВвод_Команды.Количество() > 0 Цикл
		КомандаЛенты = ОбычныйВвод_Команды[0];
		ШиринаЭлемента = ПолучитьШиринуЭлемента(КомандаЛенты.Представление,, ВебКлиент);
		Если (ШиринаПанели + ШиринаЭлемента) > ШиринаЛенты Тогда
			Если ОбычныйВвод_Команды.Количество() = 1 Тогда
				Если (ШиринаПанели + ШиринаЭлемента - Элементы.ОбычныйВвод_ПоказатьЕще.Ширина) > ШиринаЛенты Тогда
					Прервать;
				КонецЕсли;
			Иначе
				Прервать;
			КонецЕсли;	
		КонецЕсли;
		ДекорацияПанели	= Элементы.Вставить("ОбычныйВвод_" + КомандаЛенты.Значение, Тип("ДекорацияФормы"), Элементы.Лента_ОбычныйВвод, Элементы.ОбычныйВвод_ПоказатьЕще);
		ДекорацияПанели.Заголовок	= КомандаЛенты.Представление;
		ДекорацияПанели.ЦветТекста	= ЦветаСтиля.CRM_ОсновнойГолубой;
		ДекорацияПанели.РастягиватьПоГоризонтали	= Ложь;
		ДекорацияПанели.РастягиватьПоВертикали		= Ложь;
		ДекорацияПанели.ВертикальноеПоложениеВГруппе	= ВертикальноеПоложениеЭлемента.Центр;
		ДекорацияПанели.Ширина		= ШиринаЭлемента;
		ДекорацияПанели.Гиперссылка	= Истина;
		ДекорацияПанели.УстановитьДействие("Нажатие", "Подключаемый_ОбработкаКомандыЛенты");
		ОбычныйВвод_Команды.Удалить(КомандаЛенты);
	КонецЦикла;
	Если ОбычныйВвод_Команды.Количество() = 0 Тогда
		Элементы.ОбычныйВвод_ПоказатьЕще.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура СкрытоеПолеТеговПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Если CRM_ОбщегоНазначенияКлиент.ЭтоМобильныйКлиент() Тогда
		clientWidth = 1028;
	Иначе	
		Если Элемент.Документ = Неопределено Тогда
			clientWidth = 0;
		ИначеЕсли Элемент.Документ.parentWindow = Неопределено Тогда
			clientWidth = Элемент.Документ.defaultView.Document.children[0].clientWidth;
		Иначе
			clientWidth = Элемент.Документ.parentWindow.Document.children[0].clientWidth;
		КонецЕсли; 
	КонецЕсли;
	Если clientWidth > 0 Тогда
		НоваяШиринаТегов = Окр(clientWidth / 10, 0, РежимОкругления.Окр15как20) - 5;
		Если НЕ (ШиринаТегов = НоваяШиринаТегов) Тогда
			ШиринаТегов	= НоваяШиринаТегов;
			ОбновитьОблакоТегов();
			НоваяШиринаСостояний = ШиринаТегов + ШиринаЛенты + 4;
			Если НЕ (ШиринаСостояний = НоваяШиринаСостояний) Тогда
				ШиринаСостояний	= НоваяШиринаСостояний;
				#Если ВебКлиент Тогда
				ЗаполнитьПанельСостоянийИнтереса(, Истина);
				#Иначе	
				ЗаполнитьПанельСостоянийИнтереса();
				#КонецЕсли
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	Элементы.СкрытоеПолеТеговВеб.Видимость	= Ложь;
КонецПроцедуры

