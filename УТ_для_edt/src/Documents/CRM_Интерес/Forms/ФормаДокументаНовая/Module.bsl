	//	CRM_ЛентаСобытийКлиент.НастроитьОбластьВводаПослеФормированияЛенты(ПолучателиЧата, ЭтотОбъект);
	//	ВидимостьКомандыЧат = (БыстрыйВвод_ЧатПолучатели.Количество() > 0);
	//	Если БыстрыйВвод_ТекущийТипОбъекта = "Чат" И Не ВидимостьКомандыЧат Тогда
	//		ПереключитьСтраницуБыстрогоВвода("Примечание");
	//	КонецЕсли;
	//КонецЕсли;
	CRM_ЛентаСобытийКлиентСервер.ОбластьВводаНастритьВидимостьКомандПослеФормированияЛенты(ЭтотОбъект);
	
	Если Лента_ЗначенияНастроек.ИспользоватьЧаты Тогда
		
		ПараметрыДополнения = Новый Структура;
		ПараметрыДополнения.Вставить("Ссылка", Объект.Ссылка);
		ПараметрыДополнения.Вставить("УчетнаяЗапись", БыстрыйВвод_ЧатУчетнаяЗапись);
		ПараметрыДополнения.Вставить("ПартнерыКИ", ЭтотОбъект["КонтактнаяИнформацияОбъектовОписаниеДополнительныхРеквизитов"]);
		
