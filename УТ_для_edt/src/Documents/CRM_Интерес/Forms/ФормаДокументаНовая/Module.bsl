	Объект.СостояниеИнтереса = Справочники.CRM_СостоянияИнтересов.ПервичноеСостояниеСценария(СценарийИнтереса);
	Записать();
	//ЗаполнитьПанельСостоянийИнтереса();
	ЗаблокироватьРеквизитыПоСостояниюИнтереса();	
