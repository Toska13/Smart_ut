// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура ОтчетПоПредзаказу(Команда)
	ПараметрыОтчета=Новый Структура("Отбор,КлючНазначенияИспользования,КлючВарианта,СформироватьПриОткрытии",
					Новый Структура("ПредзаказПоставщику",Объект.Ссылка),
					,"Основной",Истина);
	
	ОткрытьФорму("Отчет.смартОтчетПоПредзаказам.Форма",ПараметрыОтчета,ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымДокумента(Команда)
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполните валюту документа",,"Объект.Валюта");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НалогообложениеНДС) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Укажите тип налогообладения документа",,"Объект.НалогообложениеНДС");
		Возврат;
	КонецЕсли;

	Список=Новый СписокЗначений;
	Список.Добавить("ЗаказПоставщику");
	Список.Добавить("ПриобретениеТоваровУслуг");

	Оп=Новый ОписаниеОповещения("ПослеВыбораТипаДокумента",ЭтотОбъект);
	ПоказатьВыборИзСписка(Оп,Список);
КонецПроцедуры

