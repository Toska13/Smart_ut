#Область ОписаниеПеременных

&НаКлиенте
Перем КэшированныеЗначения; //используется механизмом обработки изменения реквизитов ТЧ

#КонецОбласти

#Область ОбработчикиСобытийИЭлементовФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Автор=Пользователи.ТекущийПользователь();
		Объект.Менеджер=Объект.Автор;
	КонецЕсли;
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Импорт=Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС")
			И Не Объект.Валюта=Константы.ВалютаРегламентированногоУчета.Получить()
			И Не Объект.ЦенаВключаетНДС ;
			
	//++ смарт:КМД #3_2 179 28.12.2020
	//добавлена кнопка и команда заполнения цен поставщиков и другие элементы формы программно
	смарт_ДобавитьЭлементыФормы();
	//-- смарт:КМД #3_2 179 28.12.2020
	
	//++ смарт:КМД #3_3 423 28.12.2020
	смарт_ИзменитьФормуДокументОснование();
	ЭтотОбъект.ПредзаказПоЗаказу = ЗначениеЗаполнено(Объект.ДокументОснование);
	//-- смарт:КМД #3_3 423 28.12.2020
	
	//++ #Б2434 смарт: Шляпников 04.03.2025 / Заявка на гарантийный ремонт. Дополнительные статусы.
	// Обработчик механизма "Назначения"
	Справочники.Назначения.ФормаДокументаПриСозданииНаСервере(ЭтаФорма);
	//-- #Б2434 смарт: Шляпников 04.03.2025
	
	//++ #Б2710 смарт: Шляпников 18.03.2025 / Заявка на разборку оборудования. Обработка Подбор товара.
	Элементы.Переместить(Элементы.ТоварыПодборДанныхПоПотребностямЗаявокНаРазборку, Элементы.ГруппаТоварыЗаполнить);
	//-- #Б2710 смарт: Шляпников 18.03.2025
	
	//++ #Б6770 смарт: Шляпников 04.05.2026 / Маркировка. Документ Предзаказ поставщику. Добавит пиктограммы ЧЗ.
	смартМаркировка.ДобавитьВТабличнуюЧастьКолонкиМаркировки(ЭтаФорма);
	//-- #Б6770 смарт: Шляпников 04.05.2026
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЕстьНДС=Не Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС");
	Элементы.ЦенаВключаетНДС.Доступность=ЕстьНДС;
	Элементы.ГруппаСтраницыВсего.ТекущаяСтраница=?(ЕстьНДС,Элементы.СтраницаВсегоСНДС,Элементы.СтраницаВсегоБезНДС);
КонецПроцедуры

&НаКлиенте
Процедура НалогообложениеНДСПриИзменении(Элемент)
	ЕстьНДС=Не Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС");
	Объект.ЦенаВключаетНДС=?(ЕстьНДС,Объект.ЦенаВключаетНДС,Ложь);
	Элементы.ЦенаВключаетНДС.Доступность=ЕстьНДС;
	Элементы.ГруппаСтраницыВсего.ТекущаяСтраница=?(ЕстьНДС,Элементы.СтраницаВсегоСНДС,Элементы.СтраницаВсегоБезНДС);
	Элементы.ТоварыСуммаСНДС.Заголовок=?(ЕстьНДС,"Сумма с НДС","Сумма всего");
	
	ПересчитатьТабличнуюЧастьТовары();
КонецПроцедуры

&НаКлиенте
Процедура ЦенаВключаетНДСПриИзменении(Элемент)
	ПересчитатьТабличнуюЧастьТовары();
КонецПроцедуры

&НаКлиенте
Процедура ИмпортПриИзменении(Элемент)
	Если Импорт Тогда 
		Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС");
		Объект.ЦенаВключаетНДС=Ложь;
		Объект.Валюта=ПолучитьВалютуУправленческогоУчета();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьТовары(Команда)
	
	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(Истина,
		"Документ.смартПредзаказПоставщику.смарт_ФормаДокумента.Команда.ПодобратьТовары");
	
	Отказ = Ложь;
	Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Валюта документа не заполнена",,"Объект.Валюта",,Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ",        Объект.Ссылка);
	ПараметрыФормы.Вставить("Партнер",         Объект.Партнер);
	ПараметрыФормы.Вставить("Склад",      	   Объект.Склады);
	ПараметрыФормы.Вставить("ЦенаВключаетНДС", Объект.ЦенаВключаетНДС);
	ПараметрыФормы.Вставить("Валюта",          Объект.Валюта);
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти", Ложь);

	ПараметрыФормы.Вставить("ОтборПоТипуНоменклатуры", Новый ФиксированныйМассив(НоменклатураКлиентСервер.ОтборПоТоваруМногооборотнойТаре(Ложь)));
	ПараметрыФормы.Вставить("СкрыватьРучныеСкидки", Истина);
		
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	
	ОткрытьФорму("Обработка.ПодборТоваровВДокументЗакупки.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументЗакупки.Форма.Форма" Тогда
		ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
	КонецЕсли;
	
	Объект.СуммаДокумента=Объект.Товары.Итог("СуммаСНДС");
	
	//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	//-- #Б6794 смарт: Шляпников 07.05.2026
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	КэшированныеЗначения=Объект.Валюта;
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	Если Не Объект.Валюта=КэшированныеЗначения И ЗначениеЗаполнено(КэшированныеЗначения) Тогда 
		ПересчитатьТоварыИзВалютыВВалюту(КэшированныеЗначения,Объект.Валюта);
		Объект.СуммаДокумента=Объект.Товары.Итог("СуммаСНДС");
	КонецЕсли;
	КэшированныеЗначения=Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	//++ #Б6948 смарт: Шляпников 11.06.2026 / Маркировка. Алгоритм действий системы и БП при заказе нового товара при наличии остатков на складах.
	смартМаркировкаКлиент.ВывестиСообщениеОБудущейМаркировкеНоменклатурыПоДокументу(Объект);
	//-- #Б6948 смарт: Шляпников 11.06.2026
	
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыПересчитатьСумму(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если Элемент.Имя="ТоварыСуммаРучнойСкидки" Тогда 
		ТекущаяСтрока.ПроцентРучнойСкидки=ТекущаяСтрока.СуммаРучнойСкидки/(ТекущаяСтрока.КоличествоУпаковок*ТекущаяСтрока.Цена)*100;
	КонецЕсли;	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата", Объект.НалогообложениеНДС, Объект.Дата));
	ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, ЭтаФорма);
	
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
	Объект.СуммаДокумента=Объект.Товары.Итог("СуммаСНДС");
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоУпаковокПриИзменении(Элемент)

	//++#1894 смарт: Лопато 09.07.2024 //Процент выполнения предзаказа
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	ТоварыПересчитатьСумму(Элемент);
	
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		
		ВыполнитьКонтрольКоличестваПоСтроке(ТекущаяСтрока);
	
	КонецЕсли;
	//--#1894 смарт: Лопато 09.07.2024
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	Стр = Элементы.Товары.ТекущиеДанные;
	
	//++ #3942 смарт: Шляпников 01.08.2025 / Запрет выбора в документах закупки (Предзаказ, Заказ поставщика) номенклатуры из папки Архив (только запчасти!)
	Если НЕ смартСервер.ПроверитьДоступностьИспользованияНоменклатурыВДокументеЗакупки(стр.Номенклатура) Тогда
		стр.Номенклатура = Неопределено;
	КонецЕсли;
	//-- #3942 смарт: Шляпников 01.08.2025
	
	Стр.Цена = ПолучитьЦенуНоменклатурыПоставщика(ПолучитьОтборДляЦеныПоставщика(Стр));
	ТоварыПересчитатьСумму(Элемент);
	
	//++ #1388 смарт: Фролов 13.07.2023 //Доработка печатной формы предзаказа  
	//ЗаполнитьНоменклатуруПоставщикаПоНашейНоменклатуре(Стр.ПолучитьИдентификатор());
	УстановитьИспользоватьХарактеристику(Стр.ПолучитьИдентификатор());
	Стр.НоменклатураПартнера = ПолучитьНоменклатуруПоставщика(Стр.Номенклатура,Стр.НомерСтроки); 
	//-- #1388 смарт: Фролов 13.07.2023
	
	//++ #6726  смарт: Тимофеева 22.05.2026 / Предзаказ поставщику. Доработка документа. Новые реквизиты Пошлина и Таможенный сбор.
	ЗаполнитьЗначенияСвойств(Стр, ПолучитьЗначенияПошлиныИТаможенногоСбора(Стр.Номенклатура));
    //-- #6726  смарт: Тимофеева 22.05.2026
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПоставщикаПриИзменении(Элемент)
	Стр=Элементы.Товары.ТекущиеДанные;
	ЗаполнитьНоменклатуруПоДаннымПоставщика(Стр.ПолучитьИдентификатор());
	Если ЗначениеЗаполнено(Стр.Номенклатура) Тогда			
		ТоварыНоменклатураПриИзменении(Элемент);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыВидЦеныПоставщикаПриИзменении(Элемент)
	Стр=Элементы.Товары.ТекущиеДанные;
	Стр.Цена=ПолучитьЦенуНоменклатурыПоставщика(ПолучитьОтборДляЦеныПоставщика(Стр));
	ТоварыПересчитатьСумму(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	ТоварыПересчитатьСумму(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогТоваров(Элемент, НоваяСтрока, ОтменаРедактирования)
	Объект.СуммаДокумента=Объект.Товары.Итог("СуммаСНДС");	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПередУдалением(Элемент, Отказ)
	Если Не Объект.Ссылка.Пустая() Тогда 
		Отказ=Не ЕстьВозможностьИзменитьСтроку(Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Не Объект.Ссылка.Пустая() Тогда
		КэшированныеЗначения=Элементы.Товары.ТекущиеДанные;
		Если Не ЕстьВозможностьИзменитьСтроку(Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор()) Тогда
			СтандартнаяОбработка=Ложь;
			ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные,КэшированныеЗначения);
		КонецЕсли;
		КэшированныеЗначения=Неопределено;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыХарактеристикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Не Объект.Ссылка.Пустая() Тогда
		КэшированныеЗначения=Элементы.Товары.ТекущиеДанные;
		Если Не ЕстьВозможностьИзменитьСтроку(Элементы.Товары.ТекущиеДанные.ПолучитьИдентификатор()) Тогда
			СтандартнаяОбработка=Ложь;
			ЗаполнитьЗначенияСвойств(Элементы.Товары.ТекущиеДанные,КэшированныеЗначения);			
		КонецЕсли;
		КэшированныеЗначения=Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыУпаковкаПриИзменении(Элемент)
	//++ #3974 смарт: Тимофеева 06.08.2025 / Создание Заказа поставщика из Предзаказа, задвоение количества
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	ТоварыПересчитатьСумму(Элемент); 
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		
		ВыполнитьКонтрольКоличестваПоСтроке(ТекущаяСтрока);
	
	КонецЕсли;
	//-- #3974 смарт: Тимофеева 06.08.2025
КонецПроцедуры

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
&НаСервере
Процедура ЗаполнитьДанныеОМаркировкеНоменклатуры()
	
	смартМаркировка.ЗаполнитьИнформациюОМаркировкеВТаблицуНоменклатуры(Объект.Товары);
	
КонецПроцедуры

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
    ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат)
    ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
