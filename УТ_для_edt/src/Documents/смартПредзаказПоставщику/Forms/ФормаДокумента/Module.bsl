		|ГДЕ
		|	НоменклатураКонтрагентов.Владелец = &Владелец
		|	И НоменклатураКонтрагентов.Номенклатура = &Номенклатура
		|");
	Запрос.Параметры.Вставить("Владелец", Объект.Партнер);
	Запрос.Параметры.Вставить("Номенклатура", Номенклатура); 
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Количество()=1 Тогда
		Если Выборка.Следующий() Тогда
			Возврат Выборка.НоменклатураПартнера;
		КонецЕсли;
	ИначеЕсли Выборка.Количество()=0 Тогда	
		Сообщить("Для номенклатуры "+Номенклатура+" в строке "+НомПП+" на найдена номенклатура поставщика");
		Возврат Неопределено;
	Иначе	
		Сообщить("Для номенклатуры "+Номенклатура+" в строке "+НомПП+" найдено более одной номенклатуры поставщика, выберите вручную");
		Возврат Неопределено;
	КонецЕсли;                                               
КонецФункции //-- #1388 смарт: Фролов 13.07.2023

//++ #6726  смарт: Тимофеева 22.05.2026 / Предзаказ поставщику. Доработка документа. Новые реквизиты Пошлина и Таможенный сбор.
&НаСервереБезКонтекста
Функция ПолучитьЗначенияПошлиныИТаможенногоСбора(Номенклатура)
	Результат = Новый Структура("СтавкаПошлины,ПовышенныйТаможенныйСбор", "", Ложь);
	
	КодТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КодТНВЭД");
	Если ЗначениеЗаполнено(КодТНВЭД) Тогда
		ЗначенияРеквизитов 					= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КодТНВЭД, "смартБазоваяСтавка,смартПовышенныйТаможенныйСбор");
		Результат.СтавкаПошлины 			= ЗначенияРеквизитов.смартБазоваяСтавка;
		Результат.ПовышенныйТаможенныйСбор 	= ЗначенияРеквизитов.смартПовышенныйТаможенныйСбор;
	КонецЕсли;
	Возврат Результат;
КонецФункции
