&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		//++ #3942 смарт: Шляпников 01.08.2025 / Запрет выбора в документах закупки (Предзаказ, Заказ поставщика) номенклатуры из папки Архив (только запчасти!)
		Если НЕ смартСервер.ПроверитьДоступностьИспользованияНоменклатурыВДокументеЗакупки(СтрокаТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		//-- #3942 смарт: Шляпников 01.08.2025
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара, "НоменклатураПартнера, Номенклатура, Характеристика, Упаковка, ВидЦеныПоставщика, Цена, КоличествоУпаковок");
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата", Объект.НалогообложениеНДС, Объект.Дата));
		
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, ЭтаФорма);
		
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		//++ #6726  смарт: Тимофеева 22.05.2026 / Предзаказ поставщику. Доработка документа. Новые реквизиты Пошлина и Таможенный сбор.
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПолучитьЗначенияПошлиныИТаможенногоСбора(ТекущаяСтрока.Номенклатура));
		//-- #6726  смарт: Тимофеева 22.05.2026
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ЕстьВозможностьИзменитьСтроку(ИДСтроки)
	Стр=Объект.Товары.НайтиПоИдентификатору(ИДСтроки);
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ПредзаказПоставщику",Объект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура",Стр.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Стр.Характеристика);
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	смартПредзаказыПоставщикам.Регистратор КАК Регистратор
	             |ИЗ
	             |	РегистрНакопления.смартПредзаказыПоставщикам КАК смартПредзаказыПоставщикам
	             |ГДЕ
	             |	смартПредзаказыПоставщикам.ПредзаказПоставщику = &ПредзаказПоставщику
	             |	И НЕ смартПредзаказыПоставщикам.Регистратор = &ПредзаказПоставщику
	             |	И смартПредзаказыПоставщикам.Номенклатура = &Номенклатура
	             |	И смартПредзаказыПоставщикам.Характеристика = &Характеристика";
	МассивДокументов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	Если МассивДокументов.Количество() Тогда 
		ТекстОшибки="По данной строке есть заказы поставщикам. Изменения не могут быть внесены.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции	

&НаСервере
Функция ВозможноеИзменениеКоличества(ИДСтроки,Кол)
	КоличествоДляИзменения=Кол;
	
	Стр=Объект.Товары.НайтиПоИдентификатору(ИДСтроки);
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ПредзаказПоставщику",Объект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура",Стр.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Стр.Характеристика);
	Запрос.УстановитьПараметр("Кол",Кол);
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	Т.ЗаказаноПриход КАК СтароеКоличество,
	             |	ЕСТЬNULL(Т.ЗаказаноРасход, 0) КАК ВЗаказах,
	             |	ЕСТЬNULL(Т.ЗаказаноКонечныйОстаток, 0) >= ЕСТЬNULL(Т.ЗаказаноПриход, 0) - &Кол КАК Можно
	             |ИЗ
	             |	РегистрНакопления.смартПредзаказыПоставщикам.ОстаткиИОбороты(
	             |			,
	             |			,
	             |			,
	             |			,
	             |			ПредзаказПоставщику = &ПредзаказПоставщику
	             |				И Номенклатура = &Номенклатура
	             |				И Характеристика = &Характеристика) КАК Т";
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() И Не Рез.Можно Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В подчиенных заказах поставщикам уже заказно "+Рез.ВЗаказах);
		КоличествоДляИзменения=Рез.СтароеКоличество;
	КонецЕсли;
	Возврат КоличествоДляИзменения;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТипаДокумента(ВыбранноеЗначение,ДопПараметры)Экспорт 
	Если Не ВыбранноеЗначение=Неопределено Тогда
		ОП=Новый ОписаниеОповещения("ПослеВыбораДокументаДляЗаполнения",ЭтотОбъект);
		ОткрытьФорму("Документ."+ВыбранноеЗначение.Значение+".ФормаВыбора",,ЭтаФорма,,,,ОП,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
