#Область ОбработчикиСобытий

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.смартПредзаказПоставщику.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	смартСервер.ОтразитьПредзаказыПоставщикам(ДополнительныеСвойства, Движения, Отказ);
	
	СформироватьСписокРегистровДляКонтроля();
	
	// Запись наборов записей
	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры //++ #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
	// Перенесено из расширения
	
	Если ТипЗнч(ДанныеЗаполнения)=Тип("Структура") И ДанныеЗаполнения.Свойство("ТоварыКЗаказу") Тогда 
		Для Каждого Стр Из ДанныеЗаполнения.ТоварыКЗаказу Цикл 
			ЗаполнитьЗначенияСвойств(Товары.Добавить(),Стр);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ДокументОснование=ДанныеЗаполнения;
		Склады=ДанныеЗаполнения.Склад;
		
		//++ смарт:КМД #3_2 179 28.12.2020
		Организация = ДанныеЗаполнения.Организация;
		//-- смарт:КМД #3_2 179 28.12.2020
		
		Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл 
			ЗаполнитьЗначенияСвойств(Товары.Добавить(),Стр,"Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Количество");
		КонецЦикла;	
		
	//++ смарт:ММ #095 458 13.02.2021 На основании заказа на сборку создавать предзаказ поставщику
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
		
		ДокументОснование 	= ДанныеЗаполнения;
		Склады 				= ДанныеЗаполнения.Склад;		
		Организация 		= ДанныеЗаполнения.Организация;
		
		Для Каждого Стр Из ДанныеЗаполнения.Товары Цикл 
			ЗаполнитьЗначенияСвойств(Товары.Добавить(), Стр,"Номенклатура,Характеристика,Упаковка,КоличествоУпаковок,Количество");
		КонецЦикла;
		
	//-- смарт:ММ 13.02.2021
	
	КонецЕсли;
	НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ЭтотОбъект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата", НалогообложениеНДС, Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Товары,СтруктураДействий, Неопределено);
	
	//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
	
КонецПроцедуры //++ #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ПриКопировании(ОбъектКопирования)
	
	ДокументОснование = Неопределено;
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ОбработкаУдаленияПроведения(Отказ)

	//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
	// Перенесено из расширения  
	// Переделать под стандарты
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ПредзаказПоставщику",Ссылка);
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	             |	смартПредзаказыПоставщикам.Регистратор КАК Регистратор
	             |ИЗ
	             |	РегистрНакопления.смартПредзаказыПоставщикам КАК смартПредзаказыПоставщикам
	             |ГДЕ
	             |	смартПредзаказыПоставщикам.ПредзаказПоставщику = &ПредзаказПоставщику
	             |	И НЕ смартПредзаказыПоставщикам.Регистратор = &ПредзаказПоставщику";
	МассивПодчиненных=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	Если МассивПодчиненных.Количество() Тогда
		ТекстОшибки="У предзаказа есть подчиненные документы:";
		Для Каждого Док Из МассивПодчиненных Цикл 
			ТекстОшибки=ТекстОшибки+"
						|"+Док;
		КонецЦикла;
		ТекстОшибки=ТекстОшибки+"
					|Предзаказ не может быть распроведен.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,,,Отказ);
	КонецЕсли;	
	//-- #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
	
КонецПроцедуры //++ #1637 смарт Ермаков 14.02.2024

#КонецОбласти

#Область Прочее

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура СформироватьСписокРегистровДляКонтроля()
	
	Массив = Новый Массив;
	Массив.Добавить(Движения.смартПредзаказыПоставщикам);
	
	ДополнительныеСвойства.ДляПроведения.Вставить("РегистрыДляКонтроля", Массив);

КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

#КонецОбласти

