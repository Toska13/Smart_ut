//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.смартПредзаказПоставщику";
	КомандаПечати.Идентификатор = "ПредзаказИностранномуПоставщику";
	КомандаПечати.Представление = НСтр("ru = 'Предзаказ поставщику'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.ДополнительныеПараметры.Вставить("Тип", "ПредзаказИностранномуПоставщику"); 
	
	//++ #1388 смарт: Фролов 05.07.2023 //Доработка печатной формы предзаказа  
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.смартПредзаказПоставщику";
	КомандаПечати.Идентификатор = "ПредзаказИностранномуПоставщикуНоменклатураПоставщика";
	КомандаПечати.Представление = НСтр("ru = 'Предзаказ поставщику (Номенклатура поставщика)'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Истина;
	КомандаПечати.ДополнительныеПараметры.Вставить("Тип", "ПредзаказИностранномуПоставщикуНоменклатураПоставщика");
	//-- #1388 смарт: Фролов 05.07.2023	

КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Функция ПолучитьДанныеДляПечатнойФормыЗаказаНаТоварыУслуги(МассивОбъектов, ПараметрыПечати) Экспорт
	
	Запрос = Новый Запрос();
	ТекстЗапроса =  
	"ВЫБРАТЬ
	|	Документы.Ссылка										КАК Ссылка,
	|	Документы.Номер											КАК Номер,
	|	Документы.Дата											КАК Дата,

	|
	|	ВЫБОР КОГДА Документы.НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС) ТОГДА
	|		ИСТИНА
	|	ИНАЧЕ
	|		ЛОЖЬ
	|	КОНЕЦ													КАК УчитыватьНДС,
	|	Документы.ЦенаВключаетНДС								КАК ЦенаВключаетНДС,
	|	Документы.Партнер										КАК Отправитель,
	|	Документы.Организация.НаименованиеМеждународное			КАК Получатель,
	|	Документы.Валюта										КАК Валюта,
	|	Документы.Менеджер.ФизическоеЛицо						КАК Менеджер,
	|	Документы.Комментарий									КАК Комментарий,
	|
	|	НЕОПРЕДЕЛЕНО											КАК Грузоотправитель,
	|	НЕОПРЕДЕЛЕНО											КАК Грузополучатель,
	// Параметры для выбора областей макета отчета
	|	ЛОЖЬ													КАК ПоказыватьНДСВСтроках,
	|	ИСТИНА													КАК ИспользоватьАвтоСкидки,
	|	&Тип													КАК Тип,
	|	&ПредставлениеДокумента									КАК ПредставлениеДокумента,
	|	&ПредставлениеВОшибке									КАК ПредставлениеВОшибке
	|
	|ИЗ
	|	Документ.смартПредзаказПоставщику КАК Документы
	|
	|ГДЕ
	|	Документы.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документы.МоментВремени
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Ссылка,
	|	НЕОПРЕДЕЛЕНО КАК НомерСтроки,
	|	НЕОПРЕДЕЛЕНО КАК ДатаПлатежа,
	|	НЕОПРЕДЕЛЕНО КАК ВариантОплаты,
	|	НЕОПРЕДЕЛЕНО КАК ПроцентПлатежа,
	|	НЕОПРЕДЕЛЕНО КАК СуммаПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Ссылка											КАК Ссылка,
	|	Товары.НомерСтроки										КАК НомерСтроки,
	|	Товары.НоменклатураПартнера.Наименование				КАК НаименованиеНоменклатурыИсполнителя,
	|	Товары.НоменклатураПартнера.Код						КАК КодИсполнителя,
	|	Товары.НоменклатураПартнера.Артикул					КАК АртикулИсполнителя,
	|	Товары.ВидЦеныПоставщика								КАК ВидЦеныИсполнителя,
	|	Товары.Номенклатура										КАК Номенклатура,
	|	Товары.Номенклатура.Код									КАК Код,
	|	Товары.Номенклатура.Артикул								КАК Артикул,
	|	Товары.Номенклатура.НаименованиеПолное					КАК НаименованиеПолное,
	|   Товары.Номенклатура.НаименованиеАнгл                    КАК НаименованиеАнгл,
	|	Товары.Характеристика.НаименованиеПолное				КАК Характеристика,
	|	""""													КАК Содержание,
	|
	|	Товары.КоличествоУпаковок								КАК Количество,
	|
	|	Товары.Цена												КАК Цена,
	|	Товары.Сумма											КАК Сумма,
	|	Товары.СтавкаНДС										КАК СтавкаНДС,
	|	Товары.СуммаСНДС-Товары.Сумма							КАК СуммаНДС,
	|
	|	Товары.ПроцентРучнойСкидки                              КАК ПроцентСкидки,
	|	Товары.Сумма/Товары.КоличествоУпаковок           		КАК ЦенаСоСкидкой,
	|
	|	ВЫБОР КОГДА Товары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка) ТОГДА
	|		ПРЕДСТАВЛЕНИЕ(Товары.Номенклатура.ЕдиницаИзмерения)
	|	ИНАЧЕ
	|		ПРЕДСТАВЛЕНИЕ(Товары.Упаковка)
	|	КОНЕЦ													КАК ЕдиницаИзмерения,
	|
	|	ВЫБОР КОГДА ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1) = 1 ТОГДА
	|		НЕОПРЕДЕЛЕНО
	|	ИНАЧЕ
	|		Товары.Упаковка.Наименование
	|	КОНЕЦ													КАК Упаковка
	|
	|ИЗ
	|	Документ.смартПредзаказПоставщику.Товары КАК Товары
	|
	|ГДЕ
	|	Товары.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
		"Товары.Упаковка",
		"Товары.Номенклатура"));
		
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("МассивОбъектов",			МассивОбъектов);
	Запрос.УстановитьПараметр("Тип",					ПараметрыПечати["Тип"]);
	Запрос.УстановитьПараметр("ПредставлениеДокумента",	НСтр("ru='Заказ поставщику'"));
	Запрос.УстановитьПараметр("ПредставлениеВОшибке",	НСтр("ru='заказа поставщику'"));
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанныхДляПечати = Новый Структура;
	СтруктураДанныхДляПечати.Вставить("РезультатПоШапке",			ПакетРезультатовЗапроса[0]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоЭтапамОплаты",	ПакетРезультатовЗапроса[1]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоТабличнойЧасти",	ПакетРезультатовЗапроса[2]);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ЗаполнитьСтруктуруПолучателейПечатныхФорм(СтруктураДанныхОбъектаПечати) Экспорт
	
	СтруктураДанныхОбъектаПечати.ОсновнойПолучатель = "Партнер";
	
	СтруктураДанныхОбъектаПечати.МассивРеквизитовПолучателей.Добавить("Партнер");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьПартнеровИКонтрагентов") Тогда 
		СтруктураДанныхОбъектаПечати.МассивРеквизитовПолучателей.Добавить("Контрагент");
	КонецЕсли;
	СтруктураДанныхОбъектаПечати.МассивРеквизитовПолучателей.Добавить("КонтактноеЛицо");
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПредзаказИностранномуПоставщику") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПредзаказИностранномуПоставщику",
			НСтр("ru = 'Предзаказ поставщику'"),
			СформироватьПечатнуюФормуЗаказаКлиента(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
		Для н=0 По МассивОбъектов.Количество()-1 Цикл 
			КоллекцияПечатныхФорм[н].СинонимМакета="PRE-ORDER "+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(МассивОбъектов[0].Номер,Истина,Истина)	
		КонецЦикла;	
	КонецЕсли;  
	
	//++ #1388 смарт: Фролов 05.07.2023 //Доработка печатной формы предзаказа  
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПредзаказИностранномуПоставщикуНоменклатураПоставщика") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПредзаказИностранномуПоставщикуНоменклатураПоставщика",
			НСтр("ru = 'Предзаказ поставщику (Номенклатура поставщика)'"),
			СформироватьПечатнуюФормуЗаказаКлиента(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
		Для н=0 По МассивОбъектов.Количество()-1 Цикл 
			КоллекцияПечатныхФорм[н].СинонимМакета="PRE-ORDER "+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(МассивОбъектов[0].Номер,Истина,Истина)	
		КонецЦикла;	
	КонецЕсли;
	//-- #1388 смарт: Фролов 05.07.2023
	
	ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, СтруктураТипов, КоллекцияПечатныхФорм);
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Функция СформироватьПечатнуюФормуЗаказаКлиента(СтруктураТипов, ОбъектыПечати, ПараметрыПечати) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	//++ #1388 смарт: Фролов 05.07.2023 //Доработка печатной формы предзаказа  
	//ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаказКлиента";
	Если  ПараметрыПечати.Тип="ПредзаказИностранномуПоставщикуНоменклатураПоставщика" Тогда
		ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПредзаказИностранномуПоставщикуНоменклатураПоставщика";
	Иначе
		ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ПредзаказИностранномуПоставщику";
	КонецЕсли;	
	//-- #1388 смарт: Фролов 05.07.2023
	НомерТипаДокумента = 0;
	
	Для Каждого СтруктураОбъектов Из СтруктураТипов Цикл
			
		НомерТипаДокумента = НомерТипаДокумента + 1;
		Если НомерТипаДокумента > 1 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтруктураОбъектов.Ключ);
		
		// Данные для массива объектов
		ДанныеДляПечати = МенеджерОбъекта.ПолучитьДанныеДляПечатнойФормыЗаказаНаТоварыУслуги(
			СтруктураОбъектов.Значение,
			ПараметрыПечати);
		
		// Сформированный тбаличный документ
		ЗаполнитьТабличныйДокументЗаказаНаТоварыУслуги(
			ТабличныйДокумент,
			ДанныеДляПечати,
			ОбъектыПечати,
			"Документ.смартПредзаказПоставщику.ПФ_MXL_ПредзаказИностранномуПоставщику");
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //-- #1637 смарт Ермаков 14.02.2024

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"
Процедура ЗаполнитьТабличныйДокументЗаказаНаТоварыУслуги(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ИмяМакета)
	
	ШаблонОшибкиТовары	= НСтр("ru = 'В документе %1 отсутствуют товары. Печать %2 не требуется'");

	ДанныеПечати	= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ЭтапыОплаты		= ДанныеДляПечати.РезультатПоЭтапамОплаты.Выгрузить();
	Товары			= ДанныеДляПечати.РезультатПоТабличнойЧасти.Выгрузить();
	
	ПервыйДокумент	= Истина;
	
	Пока ДанныеПечати.Следующий() Цикл
		
		Макет = УправлениеПечатью.МакетПечатнойФормы(ИмяМакета);
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеПечати.Ссылка);
		
		ТаблицаТовары = Товары.НайтиСтроки(СтруктураПоиска);
		
		Если ТаблицаТовары.Количество() = 0 Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ШаблонОшибкиТовары,
				ДанныеПечати.Ссылка,
				ДанныеПечати.ПредставлениеВОшибке);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, ДанныеПечати.Ссылка);
			Продолжить;
			
		КонецЕсли;
		
		ТаблицаЭтапыОплаты = ЭтапыОплаты.НайтиСтроки(СтруктураПоиска);
		
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ВыводитьВидЦены = Ложь;
		Для Каждого СтрокаТовары Из ТаблицаТовары Цикл
			
			Если ЗначениеЗаполнено(СтрокаТовары.ВидЦеныИсполнителя) Тогда
				ВыводитьВидЦены = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ПоказыватьНДС	= ДанныеПечати.ПоказыватьНДСВСтроках И ДанныеПечати.УчитыватьНДС;
		
		// ШАПКА - ЗАГОЛОВОК
		
		ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
		УстановитьПараметр(ОбластьМакета,"ТекстЗаголовка","PRE-ORDER №"+ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер,Истина,Истина));
		
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(
			ТабличныйДокумент,
			Макет,
			ОбластьМакета,
			ДанныеПечати.Ссылка);
		
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета=Макет.ПолучитьОбласть("КонтактнаяИнформация");
		УстановитьПараметр(ОбластьМакета,"ПредставлениеВалюты",ДанныеПечати.Валюта);
		
//		// ШАПКА - ЗАКАЗЧИК
		
		УстановитьПараметр(ОбластьМакета, "ПредставлениеПоставщика", ДанныеПечати.Отправитель);
		УстановитьПараметр(ОбластьМакета, "ПредставлениеПолучателя", ДанныеПечати.Получатель);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		

		
		// ТАБЛИЦА ТОВАРЫ - ШАПКА
		ОбластьШапкаТаблицы=Макет.ПолучитьОбласть("ОбластьШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
		// ТАБЛИЦА ТОВАРЫ - СТРОКИ
		
		МассивПроверкиВывода = Новый Массив;

		Сумма			= 0;
		СуммаНДС		= 0;

		НомерСтроки = 0;
		
		ПустыеДанные = НаборыСервер.ПустыеДанные();
		ВыводШапки = 0;

		Для Каждого СтрокаТовары Из ТаблицаТовары Цикл
			ОбластьСтрокаТЧ=Макет.ПолучитьОбласть("ОбластьСтрокаТЧ");
			ОбластьСтрокаТЧ.Параметры.Заполнить(СтрокаТовары);                                                                                          
			//++ #1388 смарт: Фролов 05.07.2023 //Доработка печатной формы предзаказа  
			//ОбластьСтрокаТЧ.Параметры.Товар=?(ПустаяСтрока(СтрокаТовары.НаименованиеАнгл),СтрокаТовары.НаименованиеПолное,СтрокаТовары.НаименованиеАнгл);
			Если ТабличныйДокумент.ИмяПараметровПечати="ПАРАМЕТРЫ_ПЕЧАТИ_ПредзаказИностранномуПоставщикуНоменклатураПоставщика" ТОгда
				ОбластьСтрокаТЧ.Параметры.Артикул=СтрокаТовары.АртикулИсполнителя;
				ОбластьСтрокаТЧ.Параметры.Товар=СтрокаТовары.НаименованиеНоменклатурыИсполнителя;
			Иначе
				ОбластьСтрокаТЧ.Параметры.Товар=?(ПустаяСтрока(СтрокаТовары.НаименованиеАнгл),СтрокаТовары.НаименованиеПолное,СтрокаТовары.НаименованиеАнгл);
			КонецЕсли;	
			//-- #1388 смарт: Фролов 05.07.2023
			
			ТабличныйДокумент.Вывести(ОбластьСтрокаТЧ);
				Сумма    = Сумма    + СтрокаТовары.Сумма;

		КонецЦикла;
		
		// ТАБЛИЦА ТОВАРЫ - ПОДВАЛ
		ОбластьМакета=Макет.ПолучитьОбласть("ОбластьПодвалТаблицы");
		УстановитьПараметр(ОбластьМакета,"Всего",Формат(Сумма,"ЧЦ=15; ЧДЦ=2"));
		УстановитьПараметр(ОбластьМакета,"ПредставлениеВалюты",ДанныеПечати.Валюта);
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
		ОбластьМакета=Макет.ПолучитьОбласть("ОбластьКомментарий");
		ТабличныйДокумент.Вывести(ОбластьМакета);
		
	КонецЦикла;
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

#КонецОбласти

#Область КомандныйИнтерфейс

//++ #1637 смарт Ермаков 14.02.2024 / Рефакторинг объектов "Предзаказ поставщику"

// Определяет список команд отчетов.
//
// Параметры:
//   КомандыОтчетов - ТаблицаЗначений - Таблица с командами отчетов. Для изменения.
//       См. описание 1 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//   Параметры - Структура - Вспомогательные параметры. Для чтения.
//       См. описание 2 параметра процедуры ВариантыОтчетовПереопределяемый.ПередДобавлениемКомандОтчетов().
//
Процедура ДобавитьКомандыОтчетов(КомандыОтчетов, Параметры) Экспорт

	ИнтеграцияИСПереопределяемый.ДобавитьКомандуСтруктураПодчиненности(КомандыОтчетов);
	
	КомандаОтчет = Отчеты.АнализПричинОтменыЗаказовПоставщикамПоДокументу.ДобавитьКомандуОтчета(КомандыОтчетов);
	Если КомандаОтчет <> Неопределено Тогда
		КомандаОтчет.ВидимостьВФормах = "ФормаДокумента,СписокДокументов";
	КонецЕсли;
	
	Отчеты.РезультатыСогласованияЗакупки.ДобавитьКомандуОтчетаПоДокументу(КомандыОтчетов);
	
	// ФормаСпискаДокументов
	КомандаОтчет = Отчеты.АнализПричинОтменыЗаказовПоставщикамПоДокументу.ДобавитьКомандуОтчета(КомандыОтчетов);
	Если КомандаОтчет <> Неопределено Тогда
		КомандаОтчет.ВидимостьВФормах = "ФормаСпискаДокументов";
		КомандаОтчет.Важность = "СмТакже";
		КомандаОтчет.Порядок = 2;
	КонецЕсли;
	
КонецПроцедуры //-- #1637 смарт Ермаков 14.02.2024

