
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура  РассчитатьНаСервере()
	СтруктураДанныхПоОбороту = смартASP_ОбщийМодуль.ASP_ПолучитьДанныеОборотаПоРемонтнымРаботам(Объект.Дата,, Объект.СреднийКурсВалюты);
	Если Не СтруктураДанныхПоОбороту=Неопределено Тогда
		Если СтруктураДанныхПоОбороту.Выручка = Null  Тогда
			Сообщить("Нет данных по обороту!");
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ASP_БонусныйФондСрезПоследних.Коэффициент КАК Коэффициент
		|ИЗ
		|	РегистрСведений.смартASP_БонусныйФонд.СрезПоследних(&Дат, ) КАК ASP_БонусныйФондСрезПоследних
		|ГДЕ
		|	ASP_БонусныйФондСрезПоследних.Категория = &Категория";
	
	Запрос.УстановитьПараметр("Категория",Перечисления.смартASP_Константы.ПроцентОборотаБФСЦ);
	Запрос.УстановитьПараметр("Дат",КонецМесяца(Объект.Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		КоэффициентКатегории = Выборка.Коэффициент;
	Иначе
		КоэффициентКатегории = 0;
	КонецЕсли;
	Объект.СуммаРаспределения=СтруктураДанныхПоОбороту.Выручка*КоэффициентКатегории/100;

	//++#1288 смарт: Лопато 29.12.2022 //Дополннение в блоке расчета бонусов инженеров
	Модифицированность = Истина;
	//--#1288 смарт: Лопато 29.12.2022
	
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура РассчитатьДоступнуюСумму(Команда)
	РассчитатьНаСервере();
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Дата = ТекущаяДата();
		Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

	//++#1288 смарт: Лопато 26.12.2022 //Дополннение в блоке расчета бонусов инженеров  
	Если НЕ ЗначениеЗаполнено(Объект.смартСтатусРасчетаБонусов) Тогда
		Объект.смартСтатусРасчетаБонусов = Перечисления.смартСтатусыДокументовРасчетаБонусов.ВРаботе;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	

	УстановитьДоступностьПоСтатусуРасчета();
	//--#1288 смарт: Лопато 26.12.2022
	
КонецПроцедуры

