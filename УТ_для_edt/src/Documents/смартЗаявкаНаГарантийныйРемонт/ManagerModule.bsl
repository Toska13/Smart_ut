#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьТекстКомментарияКДокументу(ЗаявкаНаГарантийныйРемонт = Неопределено, Номер = "") Экспорт
	
	Если ЗначениеЗаполнено(Номер) Тогда
		Возврат "#" + Номер + " (заявка на гарантийный ремонт)";
	ИначеЕсли ЗаявкаНаГарантийныйРемонт <> Неопределено Тогда
		Возврат "#" + ЗаявкаНаГарантийныйРемонт.Номер + " (заявка на гарантийный ремонт)";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Параметры:
//	 ПараметрыСоответствие - соответствие ДокументСсылка - Массив номеров позиций из ТЧ ЗаполняетсяСпециалистомПоПретензиям
Функция ОтправитьПисьма(ПараметрыСоответствие, МассивСообщений = Неопределено) Экспорт
	
	Успех = Ложь;
	
	Если ТипЗнч(ПараметрыСоответствие) <> Тип("Соответствие") Тогда
		Возврат Успех;
	КонецЕсли;
	
	Если МассивСообщений = Неопределено Тогда
		МассивСообщений = Новый Массив;
	КонецЕсли;
	
	Для Каждого ЭлементСоответствия Из ПараметрыСоответствие Цикл
		
		МассивНомеровПозиций = ЭлементСоответствия.Значение;
		ДокСсылка = ЭлементСоответствия.Ключ;
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = ДокОбъект.ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой);
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);	
		//-- смарт:ММ 03.03.2021
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
		//И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ ЭтоТестоваяБаза) Тогда
		
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		//-- смарт:ММ 03.03.2021
		
			НомерЗаявки = ДокСсылка.Номер;
			ТемаПисьма = НомерЗаявки;
			
			ТекстПисьма = "<body>";
			
			// В текст письма сразу должно подставляться:номер заявки, оборудование - серия и название, 
			// запчасть из таблицы специалиста - артикул и название, контрагент из заявки.
			ТекстПисьма = ТекстПисьма + "Заявка на гарантийный ремонт №" + НомерЗаявки + "<br>";
			ТекстСерия = ?(ЗначениеЗаполнено(ДокСсылка.Серия), " Серия: " + ДокСсылка.Серия, "");
			ТекстПисьма = ТекстПисьма + "Оборудование: " + ДокСсылка.Оборудование + ТекстСерия + "<br>";
			ТекстПисьма = ТекстПисьма + "Контрагент: " + ДокСсылка.Контрагент + "<br><br>";
			ТекстПисьма = ТекстПисьма + "Запчасти:" + "<br>";
			
			РаскрашенныйTH = "<th style=""padding: 3px;  border: 1px solid black; font-family: Arial; font-size: 10pt"">";
			ТаблицаТекст = "<table style=""border: 1px solid black; border-collapse: collapse"">
			|<tr>
			|" + РаскрашенныйTH + "Артикул</th>
			|" + РаскрашенныйTH + "Наименование</th>
			|" + РаскрашенныйTH + "Количество</th>
			|</tr>";
			
			РаскрашенныйTR = "<tr>";
			РаскрашенныйTD = "<td style=""padding: 3px; border: 1px solid black; font-family: Arial;font-size: 10pt;"">";
	
			Для Каждого Строка Из ДокСсылка.ЗаполняетсяСпециалистомПоПретензиям Цикл
				Если МассивНомеровПозиций.Найти(Строка.НомерПозиции) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаТекст = ТаблицаТекст 
				+ РаскрашенныйTR 
				+ РаскрашенныйTD + Строка.Номенклатура.Артикул + "</td>" 
				+ РаскрашенныйTD + Строка.Номенклатура + "</td>"
				+ РаскрашенныйTD + Строка.Количество + "</td>"
				+ "</td></tr>";				
			КонецЦикла;
			
			ТаблицаТекст = ТаблицаТекст + "</table><br>";

			
			ТекстПисьма = ТекстПисьма + ТаблицаТекст;
			
			ТекстПисьма = ТекстПисьма + "<P style=""font-size: 7pt;"">Письмо создано роботом и не требует ответа.</P>";
			ТекстПисьма = ТекстПисьма + "</body>"; 
			ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			//ПараметрыПисьма = ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза,, Ложь);
			//-- смарт:ММ 03.03.2021
			
			Попытка					
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
				
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				Если ПараметрыПисьма.ТестоваяБаза Тогда
					ТекстСообщения = "Отправлено письмо по заявке на гарантийный ремонт " + НомерЗаявки + " НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
				Иначе
				//-- смарт:ММ 03.03.2021

				ТекстСообщения = "Отправлено письмо по заявке на гарантийный ремонт " + НомерЗаявки + " на почту " +  АдресаДляОтправкиСтрокой;
				
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				КонецЕсли;
				//-- смарт:ММ 03.03.2021
				
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Исключение
				//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
				смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ДокСсылка,ТекстПисьма);
				//-- #1416 смарт: Фролов 30.08.2023
				ТекстСообщения = "Не удалось отправить письмо по заявке на гарантийный ремонт "  + НомерЗаявки + Символы.ПС + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;

КонецФункции

Функция ПолучитьПараметрыОтправки(МассивАдресов, Данные) Экспорт
	
	ДанныеДляОтправки = Новый Структура;
	
	ДанныеДляОтправки.Вставить("Кому",	 	МассивАдресов);
	ДанныеДляОтправки.Вставить("Тема", 		Данные.Тема);
	ДанныеДляОтправки.Вставить("Тело", 		Данные.Заголовок);
	ДанныеДляОтправки.Вставить("ТипТекста",	ТипТекстаПочтовогоСообщения.HTML);
	ДанныеДляОтправки.Вставить("Важность",	ВажностьИнтернетПочтовогоСообщения.Обычная);	
	
	Возврат ДанныеДляОтправки;
	
КонецФункции 


#Область Проведение
//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства, Регистры = Неопределено) Экспорт

	// Создание запроса инициализации движений и заполенение его параметров.
	Запрос = Новый Запрос;
	ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка);

	// Формирование текста запроса.
	ТекстыЗапроса = Новый СписокЗначений;
	ТекстЗапросаТаблицаДвиженияГарантийныхЗапасныхЧастей(Запрос, ТекстыЗапроса, Регистры);
	ТекстЗапросаТаблицаГарантияВПути(Запрос, ТекстыЗапроса, Регистры);

	// Исполнение запроса и выгрузка полученных таблиц для движений.
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);

КонецПроцедуры
//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  

//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
Процедура ЗаполнитьПараметрыИнициализации(Запрос, ДокументСсылка)

	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Дата             КАК Период,
		|	Таблица.Номер            КАК Номер,
		|	Таблица.Ссылка           КАК Ссылка,
		|	Таблица.Ответственный    КАК Ответственный,
		|	Таблица.Комментарий      КАК Комментарий,
		|	Таблица.ПометкаУдаления  КАК ПометкаУдаления,
		|	Таблица.Проведен         КАК Проведен,
		|	Таблица.Организация      КАК Организация,
		|	Таблица.Поставщик        КАК Поставщик,		
		|	Таблица.Клиент           КАК Клиент,				
		|	Таблица.Статус           КАК Статус,						
		|	Таблица.Оборудование     КАК Оборудование						
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка";

	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Запрос.УстановитьПараметр("Период",				Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация",		Реквизиты.Организация);
	Запрос.УстановитьПараметр("Поставщик",			Реквизиты.Поставщик);
	Запрос.УстановитьПараметр("Клиент",				Реквизиты.Клиент);
	Запрос.УстановитьПараметр("Статус",				Реквизиты.Статус);
	Запрос.УстановитьПараметр("Оборудование",		Реквизиты.Оборудование);
	
	Запрос.УстановитьПараметр("Номер",				Реквизиты.Номер);
	Запрос.УстановитьПараметр("Ответственный",		Реквизиты.Ответственный);
	Запрос.УстановитьПараметр("Комментарий",		Реквизиты.Комментарий);
	Запрос.УстановитьПараметр("ПометкаУдаления",	Реквизиты.ПометкаУдаления);
	Запрос.УстановитьПараметр("Проведен",			Реквизиты.Проведен);
	
	ЗначенияПараметровПроведения = ЗначенияПараметровПроведения(Реквизиты);
	Для каждого КлючИЗначение Из ЗначенияПараметровПроведения Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла; 
	
КонецПроцедуры
//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  

//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
Функция ЗначенияПараметровПроведения(Реквизиты = Неопределено)

	ЗначенияПараметровПроведения = Новый Структура;
	ЗначенияПараметровПроведения.Вставить("ИдентификаторМетаданных", ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.смартЗаявкаНаГарантийныйРемонт"));
	ЗначенияПараметровПроведения.Вставить("НазваниеДокумента", НСтр("ru='Заявка на гарантийный ремонт'"));

	Возврат ЗначенияПараметровПроведения;
	
КонецФункции
//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  

//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
Функция ТекстЗапросаТаблицаДвиженияГарантийныхЗапасныхЧастей(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартДвиженияГарантийныхЗапасныхЧастей";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) 					КАК ВидДвижения,
		|	&Период 												КАК Период,
		|	&Ссылка													КАК Заявка,
		|	НоменклатураПринятаяОтКлиента 							КАК Номенклатура,
		|	ЗаказНаПеремещениеЗапчастейСИнженера.СкладПолучатель 	КАК Склад,
		|	Количество 												КАК Количество,
		|	ЗНАЧЕНИЕ(Перечисление.смартВидыКонтроляГарантийныхЗапчастей.СдачаЗапчастиКлиентаНаСклад) КАК ВидКонтроля
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером
		|ГДЕ
		|	Ссылка = &Ссылка
		|	И НЕ ЗаказНаПеремещениеЗапчастейСИнженера = ЗНАЧЕНИЕ(Документ.ЗаказНаПеремещение.ПустаяСсылка)	
		|	И ЗаказНаПеремещениеЗапчастейСИнженера.СкладПолучатель.смартНазначениеСклада 
		|		= ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ГарантийныеЗапчастиНеДляПродажи)
		//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA
		|	И НЕ ТипDOA = ЗНАЧЕНИЕ(Перечисление.смартТипыDOA.Недостача)	
		//-- #1603 смарт: Мосолов 18.01.2024 
      	|
		|ОБЪЕДИНИТЬ ВСЕ
        |
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
		|	&Период,
		|	&Ссылка,
		|	НоменклатураПринятаяОтКлиента,
		|	ДокументПолученияЗапчасти.СкладПолучатель,
		|	Количество,
		|	ЗНАЧЕНИЕ(Перечисление.смартВидыКонтроляГарантийныхЗапчастей.ПолучениеЗапчастиДляКлиента)
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером
		|ГДЕ
		|	Ссылка = &Ссылка
		|	И НЕ ДокументПолученияЗапчасти = ЗНАЧЕНИЕ(Документ.ЗаказНаПеремещение.ПустаяСсылка)
        |
		|ОБЪЕДИНИТЬ ВСЕ
        |
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
		|	&Период,
		|	&Ссылка,
		|	НоменклатураУстановленнаяКлиенту,
		|	ДокументЗаказНаВнутреннееПотребление.Склад,
		|	Количество,
		|	ЗНАЧЕНИЕ(Перечисление.смартВидыКонтроляГарантийныхЗапчастей.СписаниеНаВнутреннееПотребление)
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером
		|ГДЕ
		|	Ссылка = &Ссылка
		|	И НЕ ДокументЗаказНаВнутреннееПотребление = ЗНАЧЕНИЕ(Документ.ЗаказНаВнутреннееПотребление.ПустаяСсылка)
		|";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;

КонецФункции
//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  

//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
Функция ТекстЗапросаТаблицаГарантияВПути(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартГарантияВПути";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	&Период				КАК Период,
		|	Номенклатура		КАК Номенклатура,
		|	СУММА(Количество) 	КАК Количество
		|ИЗ
		|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям
		|ГДЕ
		|	Ссылка = &Ссылка
		|	И Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
		|
        |СГРУППИРОВАТЬ ПО
		|	&Период, Номенклатура
		|";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;

КонецФункции
