Процедура УстановитьОтборНеПолучена(Значение)
	
	// Отключить 2 отбора, вместо них один
	ЗначениеЛожь = Ложь;
	
	Для Каждого ЭлементОтбора Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если Значение Тогда
			
			Если ЭлементОтбора.Представление = "Отправлена, но не получена" Тогда // Группа И
				ЭлементОтбора.Использование = ЗначениеЛожь;
				Для Каждого ПользовательскаяНастройка Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
					Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки 
						И ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
						ПользовательскаяНастройка.Использование = ЗначениеЛожь;
						Прервать;
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
			
			Если ЭлементОтбора.Представление = "Не отправлена и не получена" Тогда // Группа И
				ЭлементОтбора.Использование = ЗначениеЛожь;
				Для Каждого ПользовательскаяНастройка Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
					Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки 
						И ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
						ПользовательскаяНастройка.Использование = ЗначениеЛожь;
						Прервать;
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
		КонецЕсли;
		
		Если ЭлементОтбора.Представление = "Не получена" Тогда // Группа И
			ЭлементОтбора.Использование = Значение;
			Для Каждого ПользовательскаяНастройка Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
				Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки 
					И ЗначениеЗаполнено(ЭлементОтбора.ИдентификаторПользовательскойНастройки) Тогда
					ПользовательскаяНастройка.Использование = Значение;
					Прервать;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.ЗапчастиПоЗаявкам.Обновить();

КонецПроцедуры //-- смарт:ММ 14.11.2021

