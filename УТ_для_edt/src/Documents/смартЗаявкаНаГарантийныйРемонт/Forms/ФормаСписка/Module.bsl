// ++ 01.07.2020
&НаКлиенте
Процедура УстановитьОтборСписок(Значение, ИмяПоля, Представление, ИмяТЧ)
	
	Если НЕ ЗначениеЗаполнено(ИмяПоля)
		ИЛИ НЕ ЗначениеЗаполнено(Представление)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	//++ #1943 смарт: Шляпников 23.01.2025 / Доработка создания Заказа клиента из Спецификации.
	Если ИмяПоля = "КОбработке" ИЛИ ИмяПоля = "КОтправке" ИЛИ ИмяПоля = "КСписанию" Тогда
		ПредставлениеГруппы = "К обработке или к отправке или к списанию";
	КонецЕсли;
	//-- #1943 смарт: Шляпников 23.01.2025
	
	Для Каждого ЭлементДетальный Из ЭтотОбъект[ИмяТЧ].КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ЭлементДетальный.Представление = Представление Тогда 
			
			ПолеКомпоновки = Новый ПолеКомпоновкиДанных(ИмяПоля);
			
			Если ЭлементДетальный.ЛевоеЗначение = ПолеКомпоновки Тогда
				
				ЭлементДетальный.Использование = Значение;
				
				Для Каждого ПользовательскаяНастройка Из ЭтотОбъект[ИмяТЧ].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
					Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементДетальный.ИдентификаторПользовательскойНастройки 
						И ЗначениеЗаполнено(ЭлементДетальный.ИдентификаторПользовательскойНастройки) Тогда
						ПользовательскаяНастройка.Использование = Значение;
						Прервать;
					КонецЕсли;
				КонецЦикла;					

				Элементы[ИмяТЧ].Обновить();
				Прервать;
			КонецЕсли; 
		// ++ 23.11.2020
		ИначеЕсли ЭлементДетальный.Представление = ПредставлениеГруппы Тогда
			
			//++ #1943 смарт: Шляпников 23.01.2025 / Доработка создания Заказа клиента из Спецификации.
			Если ИмяТЧ = "Список" Тогда
				ЭлементДетальный.Использование = КОбработкеОсновная ИЛИ КОтправкеОсновная ИЛИ КСписаниюОсновная;
			ИначеЕсли ИмяТЧ = "ЗапчастиПоЗаявкам" Тогда
				ЭлементДетальный.Использование = КОбработке ИЛИ КОтправке ИЛИ КСписанию;
			КонецЕсли;
			//-- #1943 смарт: Шляпников 23.01.2025
			
			Для Каждого ПользовательскаяНастройка Из ЭтотОбъект[ИмяТЧ].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
				Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементДетальный.ИдентификаторПользовательскойНастройки 
					И ЗначениеЗаполнено(ЭлементДетальный.ИдентификаторПользовательскойНастройки) Тогда
					ПользовательскаяНастройка.Использование = ЭлементДетальный.Использование;
					Прервать;
				КонецЕсли;
			КонецЦикла;
				
			Для Каждого ЭлементБолееДетальный ИЗ ЭлементДетальный.Элементы Цикл
				ПолеКомпоновки = Новый ПолеКомпоновкиДанных(ИмяПоля);
				
				Если ЭлементБолееДетальный.ЛевоеЗначение = ПолеКомпоновки Тогда				   
					ЭлементБолееДетальный.Использование = Значение;  
					
					Для Каждого ПользовательскаяНастройка Из ЭтотОбъект[ИмяТЧ].КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
						Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементБолееДетальный.ИдентификаторПользовательскойНастройки 
							И ЗначениеЗаполнено(ЭлементБолееДетальный.ИдентификаторПользовательскойНастройки) Тогда
							ПользовательскаяНастройка.Использование = Значение;
							Прервать;
						КонецЕсли;
					КонецЦикла;	
					
					Элементы[ИмяТЧ].Обновить();
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		// --
		КонецЕсли;	
	КонецЦикла;
			
КонецПроцедуры

