// ++ 27.08.2020
Процедура ОбновитьОтборЭлемент(ИмяПоля, Значение, Использование)
	
	Для Каждого ЭлементДетальный Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
		
		Если ТипЗнч(ЭлементДетальный) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ПолеКомпоновки = Новый ПолеКомпоновкиДанных(ИмяПоля);
			
			Если ЭлементДетальный.ЛевоеЗначение = ПолеКомпоновки Тогда
				ЭлементДетальный.ПравоеЗначение = Значение;
				ЭлементДетальный.Использование = Использование;
				
				Для Каждого ПользовательскаяНастройка Из ЗапчастиПоЗаявкам.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
					Если ПользовательскаяНастройка.ИдентификаторПользовательскойНастройки = ЭлементДетальный.ИдентификаторПользовательскойНастройки 
						И ЗначениеЗаполнено(ЭлементДетальный.ИдентификаторПользовательскойНастройки) Тогда
						
						ПользовательскаяНастройка.Использование = Использование; 
						ПользовательскаяНастройка.ПравоеЗначение = ЭлементДетальный.ПравоеЗначение;
						Прервать;
						
					КонецЕсли;
				КонецЦикла;	
				
				Элементы.ЗапчастиПоЗаявкам.Обновить();
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


// ++ 28.06.2020
&НаСервере
Процедура ДобавитьЭлементыПрограммно()
	
	Для Каждого Колонка Из Элементы.ЗапчастиПоЗаявкам.ПодчиненныеЭлементы Цикл	
		
		ИмяКолонки = Колонка.Имя;
		ДобавляемыеРеквизиты	= Новый Массив;
		
		НовыйРеквизит = Новый РеквизитФормы(ИмяКолонки, Новый ОписаниеТипов("Булево"));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Если Колонка.Видимость Тогда
			ЭтаФорма[ИмяКолонки] = Истина;
		КонецЕсли;
		
		ИмяЭлемента = ИмяКолонки + "Элемент";
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Элементы.ГруппаВыбранныеКолонки);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = ИмяКолонки;
		НовыйЭлемент.Заголовок = СтрЗаменить(ИмяКолонки, "ЗапчастиПоЗаявкам", "");
		
		Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
			НовыйЭлемент.Заголовок = Колонка.Заголовок;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

