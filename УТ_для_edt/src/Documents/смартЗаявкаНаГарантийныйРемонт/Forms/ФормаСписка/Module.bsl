&НаСервере
Процедура НастроитьКоманднуюПанельФормы() 
	
	Для Каждого Элемент Из Элементы.ФормаКоманднаяПанель.ПодчиненныеЭлементы Цикл
		
		Если НЕ (Элемент.Имя = "ФормаИзменитьФорму"
			Или Элемент.Имя = "ФормаГруппаКонтроль"
			Или Элемент.Имя = "ПодменюОтчеты") Тогда
			
			Элемент.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //-- #Б-1176 смарт: Мосолов 25.10.2024

