// ++ 17.05.2021
&НаКлиенте
Процедура СкопироватьWarrentyDenideВНовуюЗаявку(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	МассивДокументов = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ТекДок = Неопределено;
		Если ТипЗнч(ВыделеннаяСтрока) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт") Тогда
			ТекДок = ВыделеннаяСтрока;
		ИначеЕсли ТипЗнч(ВыделеннаяСтрока) = Тип("Число") Тогда
			ТекущиеДанные = Элементы.Список.ДанныеСтроки(ВыделеннаяСтрока);
			ТекДок = ТекущиеДанные.Ссылка;
		Иначе
			ТекДок = ВыделеннаяСтрока.Ссылка;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекДок) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивДокументов.Добавить(ТекДок);
	КонецЦикла;
	
	Форма = ПолучитьФорму("Документ.смартЗаявкаНаГарантийныйРемонт.ФормаОбъекта");
	ДанныеФормы = Форма.Объект; // Получаем объект формы в переменную
	СкопироватьWarrentyDenideВНовуюЗаявкуНаСервере(МассивДокументов, ДанныеФормы); // Заполняем документ на сервере
	КопироватьДанныеФормы(ДанныеФормы, Форма.Объект); // копируем наш объект в объект формы и далее открываем ее
	
	
	Элементы.Список.Обновить();
	Элементы.ЗапчастиПоЗаявкам.Обновить();
	Элементы.ЗапчастиПоДокументу.Обновить();
	
	Форма.Открыть();
	
КонецПроцедуры

// ++ 17.05.2021
&НаСервере
Процедура СкопироватьWarrentyDenideВНовуюЗаявкуНаСервере(МассивДокументов, ДанныеФормы)

	// Подразумевается, что выделен будет один документ.
	// Если выделили несколько, то шапка берется из одного любого, а табличная часть заполняется данными из всех выделенных документов
	
	Если МассивДокументов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Не выбраны документы для копирования");
		Возврат;
	КонецЕсли;
	
	ДокументОснова = МассивДокументов[0];
	
	ДокОбъект = ДокументОснова.Скопировать();
	ДокОбъект.Дата = ТекущаяДата();
	WarrantyDenied = Перечисления.смартРешенияПоставщика.WarrantyDenied;
	
	// на вкладке инженера в правой части должны заполниться запчасти и количество, 
	// по которым в исходной заявке на вкладке специалиста решение поставщика = warrenty denide
	ИДСтроки = 0;
	
	Для Каждого Док Из МассивДокументов Цикл
		
		Для Каждого СтрокаСпециалист Из Док.ЗаполняетсяСпециалистомПоПретензиям Цикл
			
			Если СтрокаСпециалист.РешениеПоставщика <> WarrantyDenied Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаИнженер = ДокОбъект.ЗаполняетсяИнженером.Добавить();
			НоваяСтрокаИнженер.ИДСтрокиЗаполняетсяИнженером = ИДСтроки;
			НоваяСтрокаИнженер.НоменклатураПринятаяОтКлиента = СтрокаСпециалист.Номенклатура;
			НоваяСтрокаИнженер.Количество = СтрокаСпециалист.Количество;
			
			ИДСтроки = ИДСтроки + 1;
			
		КонецЦикла;			
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ДокОбъект, ДанныеФормы);
	
КонецПроцедуры

