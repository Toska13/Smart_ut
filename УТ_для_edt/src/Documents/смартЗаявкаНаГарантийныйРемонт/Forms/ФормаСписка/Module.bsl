&НаКлиенте
Процедура ЗапчастиПоЗаявкамВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// ++ 17.07.2020
	//ПоказатьЗначение(,ВыбраннаяСтрока.Ссылка);
	Если Поле.Имя = "ЗапчастиПоЗаявкамПримечание" Тогда
		
		ТекущиеДанные = Элементы.ЗапчастиПоЗаявкам.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено 
			// ++ 05.11.2020
			И ТекущиеДанные.Свойство("ГруппировкаСтроки") = Ложь
			//--
			Тогда
			СтандартнаяОбработка = Ложь;
			ПоказатьЗначение(, ТекущиеДанные.Примечание);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ЗапчастиПоЗаявкамДатаОтправления" 
		ИЛИ Поле.Имя = "ЗапчастиПоЗаявкамКаталогФайлов" Тогда
		
		ТекущиеДанные = Элементы.ЗапчастиПоЗаявкам.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено
			// ++ 05.11.2020
			И ТекущиеДанные.Свойство("ГруппировкаСтроки") = Ложь
			//--
			И ((Поле.Имя = "ЗапчастиПоЗаявкамДатаОтправления" И ЗначениеЗаполнено(ТекущиеДанные.ДатаОтправления))
					ИЛИ Поле.Имя <> "ЗапчастиПоЗаявкамДатаОтправления") 
			И ЗначениеЗаполнено(ТекущиеДанные.КаталогФайлов) Тогда
			
			КаталогПоНомеру = ТекущиеДанные.КаталогФайлов;
			ФайлКлиента = Новый Файл(КаталогПоНомеру);
			Если ФайлКлиента.Существует() Тогда	
				СтандартнаяОбработка = Ложь;
				ЗапуститьПриложение(КаталогПоНомеру);
			КонецЕсли;
				
		КонецЕсли;
				
	Иначе
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ВыбраннаяСтрока.Ссылка);
	КонецЕсли;
		
КонецПроцедуры

