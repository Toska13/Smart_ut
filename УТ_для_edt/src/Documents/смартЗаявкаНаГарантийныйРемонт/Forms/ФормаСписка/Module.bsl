// ++ 28.10.2020
&НаСервере
Процедура ЗакрытьЗаявкиНаСервере(МассивДокументовКЗакрытию)
	
	Если ТипЗнч(МассивДокументовКЗакрытию) <> Тип("Массив") 
		ИЛИ МассивДокументовКЗакрытию.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не обнаружено заявок к закрытию");
		Возврат;
	КонецЕсли;
	
	СтатусЗакрыта = Перечисления.СтатусыКассовойСмены.Закрыта;
	
	ЗакрытоДокументов = 0;
	
	Для Каждого Док Из МассивДокументовКЗакрытию Цикл
		
		Если Док.Статус = СтатусЗакрыта 
			ИЛИ НЕ Док.ГотоваКЗакрытию Тогда 
			Продолжить;
		КонецЕсли;
		
		ДокОбъект = Док.ПолучитьОбъект();	
		ДокОбъект.Статус = СтатусЗакрыта;
		ДокОбъект.Записать();
		
		ЗакрытоДокументов = ЗакрытоДокументов + 1;
		
	КонецЦикла;
	
	Если ЗакрытоДокументов > 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Закрыто заявок: " + ЗакрытоДокументов);
	КонецЕсли;
	
КонецПроцедуры

