&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Свойство("Ссылка") Тогда
		СсылкаДокумент = ?(ЗначениеЗаполнено(ТекущиеДанные.Ссылка), ТекущиеДанные.Ссылка, ПредопределенноеЗначение("Документ.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка"));
	Иначе
		СсылкаДокумент = ПредопределенноеЗначение("Документ.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка");
	КонецЕсли;
	
	ЗапчастиПоДокументу.Параметры.УстановитьЗначениеПараметра("Ссылка", СсылкаДокумент);	
	Элементы.ЗапчастиПоДокументу.Обновить();

	// ++ 28.10.2020
	НастроитьВидимостьДоступностьЭлементовПоДаннымСтроки(ТекущиеДанные);
	
КонецПроцедуры

