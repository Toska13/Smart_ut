	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиентаНаФормеСписка(ЭтаФорма,
																		 "ДокументсмартЗаявкаНаГарантийныйРемонт", 
																		 "Документ.смартЗаявкаНаГарантийныйРемонт КАК ДокументсмартЗаявкаНаГарантийныйРемонт", 
																		 "ДокументсмартЗаявкаНаГарантийныйРемонт.ГотоваКЗакрытию КАК КЗакрытию",
																		 , "Клиент",, "Клиент");
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
	//++ смарт:Подкин #959 12.04.2022 17:07:00
	НоваяКоманда = Команды.Добавить("КомандаОткрытьДвиженияЛОА");
	НоваяКоманда.Действие = "ДвиженияЛОА";//Имя процедуры
	НоваяКоманда.Заголовок = "Движение детали ЛОА";
	НоваяКоманда.Картинка=БиблиотекаКартинок.Отчет;
	
	НовыйЭлемент = Элементы.Добавить("ЭлементОткрытьДвиженияЛОА",
	Тип("КнопкаФормы"),
	КоманднаяПанель.ПодчиненныеЭлементы.ФормаГруппаКонтроль);
