&НаКлиенте
Процедура ЗабратьНаСкладе(Команда)
	
	ТабличныйДокумент = СформироватьТабличныйДокументЗабратьНаСкладе();
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ЗабратьНаСкладе");    
    КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
    КоллекцияПечатныхФорм[0].Экземпляров = 1;
    КоллекцияПечатныхФорм[0].СинонимМакета = "Забрать на складе";  
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма);
	
КонецПроцедуры

Функция СформироватьТабличныйДокументЗабратьНаСкладе() 
	
	Макет = Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьМакет("ЗабратьНаСкладе");
	
	ТабДок = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаГарантийныйРемонт.Номер КАК НомерЗаявки,
	|	НоменклатураСпр.Артикул КАК Артикул,
	|	НоменклатураСпр.Наименование КАК НаименованиеДетали,
	|	СУММА(смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Количество) КАК Количество
	|ИЗ
	|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура = НоменклатураСпр.Ссылка
	|ГДЕ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Статус = &ОжидаетсяОтправка
	|	И смартЗаявкаНаГарантийныйРемонт.КОтправке
	|
	|СГРУППИРОВАТЬ ПО
	|	смартЗаявкаНаГарантийныйРемонт.Номер,
	|	НоменклатураСпр.Наименование,
	|	НоменклатураСпр.Артикул
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки,
	|	Артикул";
	
	Запрос.УстановитьПараметр("ОжидаетсяОтправка", Перечисления.смартСтатусыПоГарантии.ОжидаетсяОтправка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	НомерПП = 1;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьШапка);
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ОбластьСтрока.Параметры.НомерПП = НомерПП;
		ТабДок.Вывести(ОбластьСтрока);
		
		НомерПП = НомерПП + 1;
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

