&НаКлиенте
Процедура НастроитьВидимостьДоступностьЭлементовПоДаннымСтроки(ТекущиеДанные)
	
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.СписокЗакрытьЗаявки.Доступность = ТекущиеДанные.КЗакрытию;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапчастиПоДокументуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ЗапчастиПоДокументуНомерОтправления" Тогда
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДатаЗаявки = ПолучитьДатуЗаявки(ТекущиеДанные.Ссылка);
		
		ТекущиеДанныеЗапчасти = Элементы.ЗапчастиПоДокументу.ТекущиеДанные;
		Если ТекущиеДанныеЗапчасти = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НомерОтправления = ТекущиеДанныеЗапчасти.НомерОтправления;
		// 28.06.2020 - Каталог открывается и без заполненного номера отправления
		//Если НЕ ЗначениеЗаполнено(НомерОтправления) Тогда
		//	Возврат;
		//КонецЕсли;
		//
		
		Если ЗначениеЗаполнено(ТекущиеДанныеЗапчасти.КаталогФайлов) Тогда
			КаталогПоНомеру = ТекущиеДанныеЗапчасти.КаталогФайлов;
		Иначе
			// 28.06.2020
			Если ЗначениеЗаполнено(НомерОтправления) Тогда
			//
				КаталогПоНомеру = смартОбщегоНазначения.СформироватьПутьККаталогуГарантийныхЗапчастей(НомерОтправления, ДатаЗаявки);
			КонецЕсли;	
		КонецЕсли;
			
		Если НЕ ЗначениеЗаполнено(КаталогПоНомеру) Тогда
			Возврат;
		КонецЕсли;
		
		ФайлКлиента = Новый Файл(КаталогПоНомеру);
		Если ФайлКлиента.Существует() Тогда
			СтандартнаяОбработка = Ложь;
			ЗапуститьПриложение(КаталогПоНомеру);
		Иначе
			// 28.06.2020
			//ТекстСообщения = "Создайте каталог " + КаталогПоНомеру + " и разместите в нем необходимые файлы. После этого файлы будут доступны на просмотр";
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	//++ #Б-2204 смарт: Лопато 10.02.2025 //Документ Заявка на гарантийный ремонт (смарт). Доработка.  
	ИначеЕсли Поле.Имя = "ЗапчастиПоДокументуНоменклатура" Тогда

		ТекущиеДанные = Элементы.ЗапчастиПоДокументу.ТекущиеДанные;
		
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ПроверитьДоступностьРолейНаСервере("смартСпециалистПоПретензиям") Тогда
			
			ОткрытьЗначение(ТекущиеДанные.Номенклатура);
			
		КонецЕсли;
	//-- #Б-2204 смарт: Лопато 10.02.2025
		
	КонецЕсли;

КонецПроцедуры

