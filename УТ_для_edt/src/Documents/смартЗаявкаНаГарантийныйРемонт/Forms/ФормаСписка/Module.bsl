Процедура ПослеВыбораНомераЗаявкиНаРемонтPRE(ВыбранноеЗначение, ДопПараметры) Экспорт 
	
	Если ВыбранноеЗначение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Сообщить("Документы перемещения не созданы. Необходимо указать номер заявки на ремонт.");
		Возврат;
	КонецЕсли;

	СоздатьДокументыНаКлиенте(ДопПараметры.Склад, ДопПараметры.ВидСклада, ВыбранноеЗначение);
	
КонецПроцедуры //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаКлиенте
Процедура СоздатьДокументыНаКлиенте(Склад, ВидСклада, НомерЗаявкиНаРемонт = "")
	
	МассивВыделенныхСтрок = Новый Массив;
	
	СтрокаЗаявка = Элементы.Список.ТекущиеДанные;
	Если СтрокаЗаявка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Заявка = СтрокаЗаявка.Ссылка;
	НомераПозиций = Новый Массив;
	
	ВыделенныеСтроки = Элементы.ЗапчастиПоДокументу.ВыделенныеСтроки;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ТекСтрока = ВыделеннаяСтрока;
		
		Если ТипЗнч(ВыделеннаяСтрока) = Тип("Число") Тогда
			ТекСтрока = Элементы.ЗапчастиПоДокументу.ДанныеСтроки(ВыделеннаяСтрока);
		КонецЕсли;
		
		СтруктураДанныеСтроки = Новый Структура;
		СтруктураДанныеСтроки.Вставить("Номенклатура", 	ТекСтрока.Номенклатура);
		СтруктураДанныеСтроки.Вставить("Количество", 	ТекСтрока.Количество);
		СтруктураДанныеСтроки.Вставить("Заявка", 		Заявка);

		МассивВыделенныхСтрок.Добавить(СтруктураДанныеСтроки);
		
		НомераПозиций.Добавить(ТекСтрока.НомерПозиции);
		
	КонецЦикла;
	
	Если МассивВыделенныхСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не выбрано ни одной запчасти для обработки!");
		Возврат;
	КонецЕсли;
	
	ЗаказНаПеремещение = СоздатьЗаказНаПеремещениеPRE(ВидСклада, Склад, МассивВыделенныхСтрок, НомерЗаявкиНаРемонт);
			
	Если ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
		
		// Добавить статус в заявке на гарантийный ремонт
		ДобавитьСтатусВЗаявкеНаГарантийныйРемонт(ВидСклада, Заявка, ЗаказНаПеремещение, НомераПозиций);
		
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Создан документ " + ЗаказНаПеремещение, ЗаказНаПеремещение);
		
		ПеремещениеТоваров = СоздатьПеремещениеТоваровPRE(ЗаказНаПеремещение, Заявка);
		
		Если ЗначениеЗаполнено(ПеремещениеТоваров) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Создан документ " + ПеремещениеТоваров, ПеремещениеТоваров);
		КонецЕсли;
		
		ПоказатьПечатнуюФормуДокумента(ЗаказНаПеремещение);
		
		//++rnp 16.11.2021 - отправка уведомления на склад, если перемещение из Москвы в регионы 
		ОтправитьУведомлениеПоЗаказуНаПеремещение(ЗаказНаПеремещение);
		//
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 13.11.2021 
&НаСервере
Функция СоздатьЗаказНаПеремещениеPRE(ВидСклада, ВыбранныйСклад, МассивВыделенныхСтрок, НомерЗаявкиНаРемонт)
	
	ОсновнойСкладДляЗапчастейПодЗаказ = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ОсновнойСкладДляЗапчастейПодЗаказ", Ложь);

	Если НЕ ЗначениеЗаполнено(ОсновнойСкладДляЗапчастейПодЗаказ) Тогда
		ОбщегоНазначения.СообщитьПользователю("Не заполнена настройка ""Основной склад для запчастей ""под заказ"""" в справочнике ""Предопределенные значения (смарт)"". Документы перемещения не созданы!");
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументЗаказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	
	ДокументЗаказ.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокументЗаказ.Статус 			= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказ.СпособДоставки 	= Перечисления.СпособыДоставки.Самовывоз;
	ДокументЗаказ.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ДокументЗаказ.смартЗапчастиГарантийные = Истина;
	//-- #Б1376 смарт: Шляпников 19.11.2024
		
	НомераЗаявок = "";
	МассивНомеровЗаявок = Новый Массив;
	
	Организация = Неопределено;
	
	Для Каждого ТекСтрока Из МассивВыделенныхСтрок Цикл
		
		НомерЗаявки = СокрЛП(ТекСтрока.Заявка.Номер);
		
		НоваяСтрока = ДокументЗаказ.Товары.Добавить();
		НоваяСтрока.Количество 			= ТекСтрока.Количество;
		НоваяСтрока.КоличествоУпаковок	= ТекСтрока.Количество;
		НоваяСтрока.Номенклатура 		= ТекСтрока.Номенклатура;
		НоваяСтрока.НачалоОтгрузки 		= ТекущаяДата();
		НоваяСтрока.ОкончаниеПоступления 	= НоваяСтрока.НачалоОтгрузки;
		НоваяСтрока.ВариантОбеспечения 		= Перечисления.ВариантыОбеспечения.Отгрузить;
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = НомерЗаявки;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = ТекСтрока.Заявка.Ссылка;
		//-- #Б1132 смарт: Шляпников 14.10.2024
		
		Если МассивНомеровЗаявок.Найти(НомерЗаявки) = Неопределено Тогда
			МассивНомеровЗаявок.Добавить(НомерЗаявки);
			НомераЗаявок = НомераЗаявок + ?(ЗначениеЗаполнено(НомераЗаявок), ", ", "") + НомерЗаявки
		КонецЕсли;
		
		Организация = ТекСтрока.Заявка.Организация;
		
	КонецЦикла;
	
	ДокументЗаказ.Организация = Организация;  // Предполагается, что выбраны строки по одной организации
	ДокументЗаказ.Дата = ТекущаяДата();
	ДокументЗаказ.Комментарий = Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьТекстКомментарияКДокументу(, НомераЗаявок);

	Если ВидСклада = "склад-получатель" Тогда  
		// взять с PRE
		ДокументЗаказ.СкладОтправитель 	= ОсновнойСкладДляЗапчастейПодЗаказ;
		ДокументЗаказ.СкладПолучатель 	= ВыбранныйСклад;
		ДокументЗаказ.Комментарий = ДокументЗаказ.Комментарий + ". Для заявки на ремонт №" + НомерЗаявкиНаРемонт;
	Иначе 
		// Вернуть на PRE
		ДокументЗаказ.СкладОтправитель 	= ВыбранныйСклад;
		ДокументЗаказ.СкладПолучатель 	= ОсновнойСкладДляЗапчастейПодЗаказ;
	КонецЕсли;

	ДокументЗаказ.ДополнительныеСвойства.Вставить("смартНеДобавлятьСтрокуСтатусаВЗаявкуНаГарантийныйРемонт", Истина);
	
	Попытка
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		СинонимДокумента = ДокументЗаказ.Метаданные().Синоним;
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ записан без проведения.");
	КонецПопытки;

	Возврат ДокументЗаказ.Ссылка;
	
КонецФункции //-- смарт:ММ 13.11.2021

//++ смарт:ММ 702 13.11.2021 
&НаСервере
Функция СоздатьПеремещениеТоваровPRE(ЗаказНаПеремещение, Заявка)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументПеремещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(ЗаказНаПеремещение);

	ДанныеЗаполнения = Новый Структура;
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "ПеремещениеТоваров");
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	ДокументПеремещение.Заполнить(ДанныеЗаполнения);
	
	ДокументПеремещение.Дата = ЗаказНаПеремещение.Дата;
	
	ДокументПеремещение.Комментарий = ЗаказНаПеремещение.Комментарий;
	
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ДокументПеремещение.смартЗапчастиГарантийные = Истина;
	//-- #Б1376 смарт: Шляпников 19.11.2024
	
	Для Каждого Строка Из ДокументПеремещение.Товары Цикл
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//Строка.смартНомерЗаявкиНаГарантийныйРемонт = Заявка.Номер;
		Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Заявка.Ссылка;
		//-- #Б1132 смарт: Шляпников 14.10.2024
	КонецЦикла;
	
	Попытка
		ДокументПеремещение.Записать(РежимЗаписиДокумента.Проведение);
	Исключение				
			СинонимДокумента = ДокументПеремещение.Метаданные().Синоним;
			ДокументПеремещение.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки() + "
			|Документ записан без проведения.", ДокументПеремещение.Ссылка);
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументПеремещение.Ссылка;
	
КонецФункции //-- смарт:ММ 13.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаКлиенте
Процедура ПоказатьПечатнуюФормуДокумента(ЗаказНаПеремещение)
	
	Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) 
		ИЛИ ТипЗнч(ЗаказНаПеремещение) <> Тип("ДокументСсылка.ЗаказНаПеремещение")
		Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = ПолучитьТабДокНаСервере(ЗаказНаПеремещение);
	СинонимМакета = "Заказ на перемещение №" + ПолучитьРеквизитОбъекта(ЗаказНаПеремещение, "Номер");
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ЗаказНаПеремещение");    
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;
	КоллекцияПечатныхФорм[0].ИмяФайлаПечатнойФормы = СинонимМакета;
	
	ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма, СинонимМакета);
	
КонецПроцедуры //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаСервереБезКонтекста
Функция ПолучитьТабДокНаСервере(ЗаказНаПеремещение)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ЗаказНаПеремещение);
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ЗаказНаПеремещение);

	КоллекцияПечатныхФорм = ПодготовитьКоллекциюПечатныхФорм("ЗаказНаПеремещение");
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода(); 
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ЗаказНаПеремещение);
	
	ПараметрыПечати = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	Документы.ЗаказНаПеремещение.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КоллекцияПечатныхФорм[0].ТабличныйДокумент; 
		
КонецФункции //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
Функция ПолучитьРеквизитОбъекта(СсылкаНаОбъект, Свойство)
	Возврат СсылкаНаОбъект[Свойство];
КонецФункции //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаКлиенте
Процедура ПечатьДокументов(КоллекцияПечатныхФорм, Знач ОбъектыПечати = Неопределено, ВладелецФормы = Неопределено, ЗаголовокФормы = "")
	
	Если ОбъектыПечати = Неопределено Тогда
		ОбъектыПечати = Новый СписокЗначений;
	КонецЕсли;
	
	КлючУникальности = Строка(Новый УникальныйИдентификатор);
	
	ПараметрыОткрытия = Новый Структура("ИмяМенеджераПечати,ИменаМакетов,ПараметрКоманды,ПараметрыПечати");
	ПараметрыОткрытия.ПараметрКоманды = Новый Массив;
	ПараметрыОткрытия.ПараметрыПечати = Новый Структура("ЗаголовокФормы", ЗаголовокФормы);
	ПараметрыОткрытия.Вставить("КоллекцияПечатныхФорм", КоллекцияПечатныхФорм);
	ПараметрыОткрытия.Вставить("ОбъектыПечати", ОбъектыПечати);
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ВладелецФормы, КлючУникальности);
КонецПроцедуры //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаСервереБезКонтекста
Функция ПодготовитьКоллекциюПечатныхФорм(Знач Идентификаторы)
	
	Результат = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из УправлениеПечатьюКлиентСервер.ИменаПолейКоллекцииПечатныхФорм() Цикл
		Результат.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Если ТипЗнч(Идентификаторы) = Тип("Строка") Тогда
		Идентификаторы = СтрРазделить(Идентификаторы, ",");
	КонецЕсли;
	
	Для Каждого Идентификатор Из Идентификаторы Цикл
		ПечатнаяФорма = Результат.Найти(Идентификатор, "ИмяМакета");
		Если ПечатнаяФорма = Неопределено Тогда
			ПечатнаяФорма = Результат.Добавить();
			ПечатнаяФорма.ИмяМакета = Идентификатор;
			ПечатнаяФорма.ИмяВРЕГ = ВРег(Идентификатор);
			ПечатнаяФорма.Экземпляров = 1;
		Иначе
			ПечатнаяФорма.Экземпляров = ПечатнаяФорма.Экземпляров + 1;
		КонецЕсли;
	КонецЦикла;
	
	Результат.Индексы.Добавить("ИмяВРЕГ");
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 14.11.2021

//++ смарт:ММ 702 14.11.2021 
&НаСервере
Процедура ДобавитьСтатусВЗаявкеНаГарантийныйРемонт(ВидСклада, Заявка, ЗаказНаПеремещение, НомераПозиций)
	
	УстанавливаемыйСтатус = Неопределено;
	
	Если ВидСклада = "склад-получатель" Тогда 
		// Перемещение со склада PRE на другой склад
		УстанавливаемыйСтатус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.ПеремещеноНаДругиеЦели");			
	ИначеЕсли ВидСклада = "склад-отправитель" Тогда 
		// Перемещение на склад PRE с другого склада
		УстанавливаемыйСтатус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.ВозвращеноПоНазначению");
	КонецЕсли;
	
	ЗаявкаОбъект = Заявка.ПолучитьОбъект();
	
	Для Каждого НомерПозиции Из НомераПозиций Цикл
		НоваяСтрока = ЗаявкаОбъект.Статусы.Добавить();
		НоваяСтрока.НомерПозиции 			= НомерПозиции;
		НоваяСтрока.ДатаИзмененияСтатуса 	= ТекущаяДата();
		НоваяСтрока.Статус 					= УстанавливаемыйСтатус;
		НоваяСтрока.ДокументДвижения 		= ЗаказНаПеремещение;
	КонецЦикла;
	
	Попытка
		ЗаявкаОбъект.Записать();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры //-- смарт:ММ 14.11.2021

//++rnp 702 16.11.2021 процедура и функция скопированы из модуля формы документа смартЗаявкаНаГарантийныйРемонт 
&НаСервере
Процедура ОтправитьУведомлениеПоЗаказуНаПеремещение(ЗаказНаПеремещение)
	Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
		Возврат;
	КонецЕсли;
	Представительство = ЗаказНаПеремещение.СкладПолучатель.Подразделение; 
	Если Представительство <> Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение
		И ЗаказНаПеремещение.СкладОтправитель.Подразделение <> Представительство Тогда
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийРаспроведениеРО(АдресаДляОтправкиСтрокой);
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		МассивАдресовСервисногоЦентраВРегионеПолучения = смартОбщегоНазначения.ПолучитьАдресРуководителяПредставительства(Представительство, АдресаДляОтправкиСтрокой);
		Для Каждого Адрес Из МассивАдресовСервисногоЦентраВРегионеПолучения Цикл
			МассивАдресовДляОтправки.Добавить(Адрес);
		КонецЦикла;
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			//-- смарт:ММ 03.03.2021
			
			//Номер = Объект.Номер;
			
			ТемаПисьма = "Перемещение запчастей со склада Гарантийные запчасти - не для продажи";
			
			ТекстПисьма = " Необходима отправка запчастей в региональное представительство " +  Представительство.Наименование + ". Необходимо обработать Заказ на перемещение №" 
			+ ЗаказНаПеремещение.Номер + " от " + Формат(ЗаказНаПеремещение.Дата, "ДФ='dd.MM.yyyy ""г.""'");
			
			ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			//-- смарт:ММ 03.03.2021
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				Если ПараметрыПисьма.ТестоваяБаза Тогда
					ТекстСообщения = "Отправлено уведомление о перемещении гарантийных запчастей НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
				Иначе
					//-- смарт:ММ 03.03.2021
					
					ТекстСообщения = "Отправлено уведомление о перемещении гарантийных запчастей на почту " +  АдресаДляОтправкиСтрокой;		
					
					//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				КонецЕсли;
				//-- смарт:ММ 03.03.2021
				
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Исключение 
				//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
				смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказНаПеремещение,ТекстПисьма);
				//-- #1416 смарт: Фролов 30.08.2023
				ТекстСообщения = "Не удалось отправить уведомление о перемещении гарантийных запчастей" + Символы.ПС + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьАдресаПолучателейУведомленийРаспроведениеРО(АдресаДляОтправкиСтрокой = "") Экспорт
	
	// Уведомление отправляется получаетелям, которые задаются в справочнике смартПредопределенныеЗначения
	
	СсылкаНаПредопределенноеЗначение = Справочники.смартПредопределенныеЗначения.АдресаДляУведомленийОНеобходимостиРаспровестиРасходныйОрдерПриОтменеОтправки;
	
	// Раскомментировать, если в справочнике должны будут храниться пользователи, а не адреса эл. почты
	//Возврат смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаНаПредопределенноеЗначение, АдресаДляОтправкиСтрокой);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
	|	И НЕ смартПредопределенныеЗначения.СписокЗначений
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений";
	
	Запрос.УстановитьПараметр("ПредопределенноеЗначение", СсылкаНаПредопределенноеЗначение);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

