    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>//++ #Б-6304 смарт: Фролов 02.04.2026 //Создать новый реквизит в карточке товаров
ВЫБРАТЬ
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка КАК Ссылка,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура.смартВозможенВозвратаБракаПочтой = ЗНАЧЕНИЕ(перечисление.смартПроблемыСУпаковкой.Да)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОтправкаТЭКПредварительная
ПОМЕСТИТЬ ВозможенВозвратБракаПочтой
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям

СГРУППИРОВАТЬ ПО
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка
;
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка КАК Ссылка,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура.смартВозможенВозвратаБракаПочтой = ЗНАЧЕНИЕ(перечисление.смартПроблемыСУпаковкой.Нет)
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК ОтправкаТЭКПредварительная
ПОМЕСТИТЬ НеВозможенВозвратБракаПочтой
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям

СГРУППИРОВАТЬ ПО
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка
;
//-- #Б-6304 смарт: Фролов 02.04.2026
////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументсмартЗаявкаНаГарантийныйРемонт.Ссылка,
	ДокументсмартЗаявкаНаГарантийныйРемонт.ПометкаУдаления,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Номер,
	//++ #1601 смарт: Мосолов 17.01.2023 //Доработка гарантийного блока / Форма списка документов   
	ДокументсмартЗаявкаНаГарантийныйРемонт.Дата,
	//-- #1601 смарт: Мосолов 17.01.2023    
	ДокументсмартЗаявкаНаГарантийныйРемонт.ДатаЗаявки,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Проведен,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Организация,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Поставщик,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Клиент,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Статус,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Оборудование,
	ДокументсмартЗаявкаНаГарантийныйРемонт.СкладИнженера,
	ДокументсмартЗаявкаНаГарантийныйРемонт.СкладГарантийныхЗапчастей,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Комментарий,
	ДокументсмартЗаявкаНаГарантийныйРемонт.УдалитьЗаказНаПеремещениеЗапчастейСИнженера,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Ответственный,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Контрагент,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Серия,
	ДокументсмартЗаявкаНаГарантийныйРемонт.КОбработке,
	ДокументсмартЗаявкаНаГарантийныйРемонт.КОтправке,
	// ++ 17.05.2021
	ДокументсмартЗаявкаНаГарантийныйРемонт.КСписанию,
	// --
	ДокументсмартЗаявкаНаГарантийныйРемонт.ОтменаОтправки,
	//++ #Б-1498 смарт: Фролов 11.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
	ДокументсмартЗаявкаНаГарантийныйРемонт.ОтправкаПретензииПоставщику,
	//-- #Б-1498 смарт: Фролов 11.12.2024
	ДокументсмартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером,
	ДокументсмартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям,
	ДокументсмартЗаявкаНаГарантийныйРемонт.Статусы,
	ДокументсмартЗаявкаНаГарантийныйРемонт.ИсторияРешенийПоставщика,
	ДокументсмартЗаявкаНаГарантийныйРемонт.МоментВремени,
	//++ #Б-6304 смарт: Фролов 02.04.2026 //Создать новый реквизит в карточке товаров
	ВЫБОР
		КОГДА ЕСТЬNULL(ВозможенВозвратБракаПочтой.ОтправкаТЭКПредварительная, 0) = 0
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОтправкаТЭК,
	ВЫБОР
		КОГДА ЕСТЬNULL(НеВозможенВозвратБракаПочтой.ОтправкаТЭКПредварительная, 0) = 0
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОтправкаТЭКНет,
	//-- #Б-6304 смарт: Фролов 02.04.2026
	ДокументсмартЗаявкаНаГарантийныйРемонт.DOA,
	ВЫБОР
		КОГДА ДокументсмартЗаявкаНаГарантийныйРемонт.КОбработке ТОГДА
			0
		ИНАЧЕ
			1
	КОНЕЦ КАК КартинкаКОбработке,
	ВЫБОР
		КОГДА ДокументсмартЗаявкаНаГарантийныйРемонт.КОтправке ТОГДА
			0
		ИНАЧЕ
			1
	КОНЕЦ КАК КартинкаКОтправке,
	ВЫБОР
		КОГДА ДокументсмартЗаявкаНаГарантийныйРемонт.ОтменаОтправки ТОГДА
			0
		ИНАЧЕ
			1
	КОНЕЦ КАК КартинкаОтменаОтправки,
	ДокументсмартЗаявкаНаГарантийныйРемонт.ГотоваКЗакрытию КАК КЗакрытию
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт КАК ДокументсмартЗаявкаНаГарантийныйРемонт
	//++ #Б-6304 смарт: Фролов 02.04.2026 //Создать новый реквизит в карточке товаров
	ЛЕВОЕ СОЕДИНЕНИЕ ВозможенВозвратБракаПочтой КАК ВозможенВозвратБракаПочтой
		ПО ДокументсмартЗаявкаНаГарантийныйРемонт.Ссылка = ВозможенВозвратБракаПочтой.Ссылка
	ЛЕВОЕ СОЕДИНЕНИЕ НеВозможенВозвратБракаПочтой КАК НеВозможенВозвратБракаПочтой
		ПО ДокументсмартЗаявкаНаГарантийныйРемонт.Ссылка = НеВозможенВозвратБракаПочтой.Ссылка
	//-- #Б-6304 смарт: Фролов 02.04.2026
	</queryText>
      <mainTable>Document.смартЗаявкаНаГарантийныйРемонт</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
