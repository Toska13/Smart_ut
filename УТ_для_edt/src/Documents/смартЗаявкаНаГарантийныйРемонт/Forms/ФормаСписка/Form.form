  <attributes>
    <name>ЗапчастиПоЗаявкам</name>
    <title>
      <key>ru</key>
      <value>Запчасти по заявкам</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка КАК СсылкаНаДокумент,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерСтроки КАК НомерСтроки,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК Отправлена,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика)
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ) КАК Получена,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление)
				ТОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.ДатаИзмененияСтатуса
			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		КОНЕЦ) КАК ДатаСтатусаОжидаетсяПоступление,
	МАКСИМУМ(ВЫБОР
			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика)
				ТОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.ДатаИзмененияСтатуса
			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		КОНЕЦ) КАК ДатаСтатусаПолученоОтПоставщика
ПОМЕСТИТЬ ВТ_НаличиеСтатусов
ИЗ
	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.Статусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка = смартЗаявкаНаГарантийныйРемонтСтатусы.Ссылка
			И смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерПозиции = смартЗаявкаНаГарантийныйРемонтСтатусы.НомерПозиции

СГРУППИРОВАТЬ ПО
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка,
	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерСтроки
;
