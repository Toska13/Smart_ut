&НаСервере
Процедура ПроверитьОстаткиНаСкладахСервер()
		
	// Заполнить список доступных складов
	
	ОсновнойСклад = Справочники.смартПредопределенныеЗначения.ОсновнойСклад.Значение;
	ОсновнойСкладДляЗапчастейПодЗаказ = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
	
	Для Каждого СтрокаИнженер Из Объект.ЗаполняетсяИнженером Цикл
		
		СтрокаИнженер.СкладыСОстатками.Очистить();
		
		//Если ЗначениеЗаполнено(СтрокаИнженер.НоменклатураУстановленнаяКлиенту) Тогда
		//	Продолжить;
		//КонецЕсли;
		//
		//Если ЗначениеЗаполнено(СтрокаИнженер.Склад) Тогда
		//	Продолжить;
		//КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаИнженер.ДокументПолученияЗапчасти) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСкладов = ПолучитьМассивСкладовСДоступнымиОстатками(СтрокаИнженер.НоменклатураПринятаяОтКлиента, СтрокаИнженер.Количество, СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером);
				
		Если МассивСкладов.Найти(ОсновнойСклад) <> Неопределено и СтрокаИнженер.Склад <> ОсновнойСкладДляЗапчастейПодЗаказ Тогда
			СтрокаИнженер.Склад = ОсновнойСклад;
		КонецЕсли;
		
		Если МассивСкладов.Количество() > 0 Тогда
			СтрокаИнженер.СкладыСОстатками.ЗагрузитьЗначения(МассивСкладов);
			СтрокаИнженер.ЗаполняетсяСписокСкладов = Истина; 
		Иначе
			СтрокаИнженер.СписокСкладовПустой = Истина;
			
			//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
			ОбщегоНазначения.СообщитьПользователю("Нет доступных гарантийных деталей.
												 |Сформируйте отчет ""Остатки и доступность"" для получения информации о доступных коммерческих деталей.");
			//-- #Б1376 смарт: Шляпников 19.11.2024
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

