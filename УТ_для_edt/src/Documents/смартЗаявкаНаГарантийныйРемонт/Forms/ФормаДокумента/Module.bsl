	//	ПоказатьПредупреждение(, "По данной заявке еще не создан документ ""Заказ на перемещение"". Заполнение невозможно.");
	//	Возврат;
	//КонецЕсли;

	// Проверка наличия документав "Заказ на перемещение" по запчастям со страницы инженера
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ЗаказНаПеремещениеЗапчастейСИнженера", ПредопределенноеЗначение("Документ.ЗаказНаПеремещение.ПустаяСсылка"));
	
	НайденныеСтроки = Объект.ЗаполняетсяИнженером.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		// Есть строки с незаполненными Заказами на перемещение
		ПоказатьПредупреждение(, "По данной заявке еще не создан документ(ы) ""Заказ на перемещение"". Заполнение невозможно.");
		Возврат;
	КонецЕсли;	
	// --
	
	ДокументОприходования = Неопределено;
	//
	//СтатусОприходованияЗапчастейНаСкладГарантия = ПолучитьСтатусОприходования(Объект.ЗаказНаПеремещениеЗапчастейСИнженера, ДокументОприходования);
	НеОбработанныйЗаказНаПеремещениеЗапчастейСИнженера = ПолучитьНеОбработанныйЗаказНаПеремещениеЗапчастейСИнженера();
	
	Если НЕ ЗначениеЗаполнено(НеОбработанныйЗаказНаПеремещениеЗапчастейСИнженера) Тогда
		// Что-то пошло не так - сюда попадать не должно (не сработали проверки ранее)
		СтатусОприходованияЗапчастейНаСкладГарантия = "НеОприходованы";
	Иначе
		СтатусОприходованияЗапчастейНаСкладГарантия = ПолучитьСтатусОприходования(НеОбработанныйЗаказНаПеремещениеЗапчастейСИнженера, ДокументОприходования);	
	КонецЕсли;

	Если СтатусОприходованияЗапчастейНаСкладГарантия = "Оприходованы" Тогда
		
		ЗаполнитьТаблицуСпециалистаПоПретензиям(ДокументОприходования);
		
		Модифицированность = Истина;
		
		Если Объект.ЗаполняетсяСпециалистомПоПретензиям.Количество() > 0 Тогда
			
			Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущаяСтрока = Объект.ЗаполняетсяСпециалистомПоПретензиям[0].ПолучитьИдентификатор();
			
		КонецЕсли;
				
	Иначе
		
		Если СтатусОприходованияЗапчастейНаСкладГарантия = "ОприходованыЧастично" Тогда
			ТекстСообщения = "По данной заявке не все товары оприходованы на склад " + Объект.СкладГарантийныхЗапчастей + ". Заполнение невозможно.";
		ИначеЕсли СтатусОприходованияЗапчастейНаСкладГарантия = "НеОприходованы" Тогда
			ТекстСообщения = "По данной заявке товары не оприходованы на склад " + Объект.СкладГарантийныхЗапчастей + ". Заполнение невозможно.";			
		КонецЕсли;
		
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

// ++ 08.04.2020
&НаСервере
Функция ПолучитьНеОбработанныйЗаказНаПеремещениеЗапчастейСИнженера()
	
	МассивОбработанныхСтрокИнженера = Новый Массив;
	
	Для Каждого Строка Из Объект.ЗаполняетсяСпециалистомПоПретензиям Цикл
		Если МассивОбработанныхСтрокИнженера.Найти(Строка.ИДСтрокиЗаполняетсяИнженером) = Неопределено  Тогда
			МассивОбработанныхСтрокИнженера.Добавить(Строка.ИДСтрокиЗаполняетсяИнженером);
		КонецЕсли;
	КонецЦикла;
	
	// Подразумевается, что необработанный заказ на перемещение всегда один (первый подходящий по ИД строки)
	Для Каждого СтрокаИнженер Из Объект.ЗаполняетсяИнженером Цикл
		Если МассивОбработанныхСтрокИнженера.Найти(СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером) = Неопределено Тогда
			Возврат СтрокаИнженер.ЗаказНаПеремещениеЗапчастейСИнженера;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ЗаказНаПеремещение.ПустаяСсылка();
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСтатус(Команда)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	СтатусОжидаютсяДействия = Неопределено;
	// 08.04.2020
	//ОбновитьСтатусНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.НомерПозиции, СтатусОжидаютсяДействия);
	ОбновитьСтатусНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.НомерПозиции, СтатусОжидаютсяДействия, ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером);
	
	Если ЗначениеЗаполнено(СтатусОжидаютсяДействия) Тогда
		ТекущиеДанные.Статус = СтатусОжидаютсяДействия;
		НастроитьВидимостьДоступностьЭлементовПоСтатусу(ТекущиеДанные.Статус, ТекущиеДанные.НомерПозиции);
		
		// 06.04.2020
		ЗаполнитьЗависимыеОтСтатусаКолонки(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда
		
		ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение);
		
	//++ #1852 смарт: Шляпников 15.01.2025 / Подбор документа поступления в Заявку на гарантийный ремонт. Доработка алгоритма.
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.ПоступлениеТоваровНаСклад.Форма.ФормаВыбора" Тогда
		
		Объект.ДокументПриобретения = ВыбранноеЗначение; 
		
		НастроитьВидимостьДоступность();
	//-- #1852 смарт: Шляпников 15.01.2025
		
		//++ #1963 смарт: Мосолов 26.08.2024 //Доработка гарантийного блока / автозаполнение полей документ Заявка на гарантийный ремонт
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаВыбора" Тогда
		
		Объект.ДокументПриобретения = ВыбранноеЗначение; 
		
		НастроитьВидимостьДоступность();
		//-- #1963 смарт: Мосолов 26.08.2024   
 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполняетсяСпециалистомПоПретензиямСтатусПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	// ++ 29.08.2020
	Отказ = Ложь;
	ПроверитьВозможностьУстановкиСтатуса(ТекущиеДанные.Статус, ТекущиеДанные.НомерПозиции, ТекущиеДанные.Номенклатура, Отказ);
	Если Отказ Тогда
		ТекущиеДанные.Статус = ПредыдущийСтатусОтправкиПоСтроке;
		Возврат;
	КонецЕсли;
	
	НомерПозиции = ТекущиеДанные.НомерПозиции;
	
	ДобавитьСтрокуСоСтатусомНаСервере(НомерПозиции, ТекущиеДанные.Статус);	
	
	НастроитьВидимостьДоступностьЭлементовПоСтатусу(ТекущиеДанные.Статус, НомерПозиции);
	НастроитьВидимостьКолонокКомпенсации();
	ЗаполнитьЗависимыеОтСтатусаКолонки(ТекущиеДанные);
	
	УстановитьСтатусЗакрытаЕслиВозможно(ТекущиеДанные.Статус);
	
КонецПроцедуры

