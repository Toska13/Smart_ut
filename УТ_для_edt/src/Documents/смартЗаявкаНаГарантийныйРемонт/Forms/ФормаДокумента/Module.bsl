Функция ПолучитьАртикул(Номенклатура)
	
	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Номенклатура.Артикул;
	
