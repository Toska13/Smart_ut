Функция ЗапчастьЕщеНеОтправлялась(ИДСтрокиЗаполняетсяИнженером)
	
	Результат = Истина;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
	НайденныеСтроки = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		// ++ 01.04.2021
		//Если НайденныеСтроки[0].Статус <> Перечисления.смартСтатусыПоГарантии.НечемЗаменить Тогда // Не отправлена
		Если НайденныеСтроки[0].Статус <> Перечисления.смартСтатусыПоГарантии.НечемЗаменить 
			И ЗначениеЗаполнено(НайденныеСтроки[0].Статус) Тогда // Не отправлена
		// --
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции


