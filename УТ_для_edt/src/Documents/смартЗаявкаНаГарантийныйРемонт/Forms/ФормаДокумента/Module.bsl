//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 06.12.2021 10:38:26 задача 801
&НаСервере
Функция ПроверкаОстатков(ТекСклад)
    
    Если ЗначениеЗаполнено(ТекСклад) И Объект.ЗаполняетсяИнженером.Количество() Тогда
      
        Запрос = Новый Запрос;
        Запрос.Текст = 
        "ВЫБРАТЬ
        |   Ном.НоменклатураПринятаяОтКлиента КАК Номенклатура,
        |   Ном.Количество КАК Количество,
        |   Ном.Склад КАК Склад
        |ПОМЕСТИТЬ ВременнаяТаблица
        |ИЗ
        |   &ТЗЗаполняетсяИнженером КАК Ном
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   ВременнаяТаблица.Номенклатура КАК Номенклатура,
        |   ВременнаяТаблица.Склад КАК Склад,
        |   ВременнаяТаблица.Количество КАК Количество,
        |   ЕСТЬNULL(ТоварыОрганизацийОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
        |   ЕСТЬNULL(ТоварыОрганизацийОстатки.КоличествоОстаток, 0) - ВременнаяТаблица.Количество КАК Дельта
        |ИЗ
        |   ВременнаяТаблица КАК ВременнаяТаблица
        |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыОрганизаций.Остатки(, Организация = &Организация) КАК ТоварыОрганизацийОстатки
        |       ПО ВременнаяТаблица.Номенклатура = ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура
        |           И (ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения = ВременнаяТаблица.Склад)
        |ГДЕ
        |   ВременнаяТаблица.Номенклатура ЕСТЬ НЕ NULL 
        |   И ЕСТЬNULL(ТоварыОрганизацийОстатки.КоличествоОстаток, 0) - ВременнаяТаблица.Количество < 0";
        
        Запрос.УстановитьПараметр("Организация", Объект.Организация);
        СтруктураОтбора=Новый Структура;
        СтруктураОтбора.Вставить("Склад",ТекСклад); 
		//++ #1967 смарт: Лопато 06.08.2024 //Доработка гарантийного блока / создание документов перемещения по кнопке Взять на складе  
		СтруктураОтбора.Вставить("ДокументПолученияЗапчасти", Документы.ЗаказНаПеремещение.ПустаяСсылка()); 
		//-- #1967 смарт: Лопато 06.08.2024
        
        //++ смарт:Подкин #910 11.04.2022 17:25:15
        ТзЗаполняетсяИнженером=Объект.ЗаполняетсяИнженером.Выгрузить(СтруктураОтбора,"ИДСтрокиЗаполняетсяИнженером,НоменклатураПринятаяОтКлиента,Количество,Склад"); 
        Для каждого СтрЗИ Из ТзЗаполняетсяИнженером Цикл
            МассивСтрокСП=Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Новый Структура("ИДСтрокиЗаполняетсяИнженером",СтрЗИ.ИДСтрокиЗаполняетсяИнженером));
            Если МассивСтрокСП.Количество()=1 И ЗначениеЗаполнено(МассивСтрокСП[0].АналогОтПоставщика) Тогда
                СтрЗИ.НоменклатураПринятаяОтКлиента=МассивСтрокСП[0].АналогОтПоставщика; 
            КонецЕсли;
        КонецЦикла;
        Запрос.УстановитьПараметр("ТЗЗаполняетсяИнженером",ТзЗаполняетсяИнженером); 
        //-- смарт:Подкин #910 11.04.2022 17:25:15
        
        РезультатЗапроса = Запрос.Выполнить();
        Если НЕ РезультатЗапроса.Пустой() Тогда
            ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
            
            Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
                ОбщегоНазначения.СообщитьПользователю("По организации "+Объект.Организация.Наименование+" не хватает "+ВыборкаДетальныеЗаписи.Дельта*-1+" шт. товара "+ВыборкаДетальныеЗаписи.Номенклатура+" на складе "+ВыборкаДетальныеЗаписи.Склад);    
            КонецЦикла;
            
            Возврат Ложь;
            
        КонецЕсли; 
    КонецЕсли; 
    
    Возврат Истина;
 
КонецФункции

// ++ 16.06.2021
&НаСервере
Процедура ОтправитьУведомлениеПоЗаказуНаПеремещение(ЗаказНаПеремещение)
	Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
		Возврат;
	КонецЕсли;
	Представительство = ЗаказНаПеремещение.СкладПолучатель.Подразделение; 
	Если Представительство <> Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение
		И ЗаказНаПеремещение.СкладОтправитель.Подразделение <> Представительство Тогда
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомленийРаспроведениеРО(АдресаДляОтправкиСтрокой);
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
		МассивАдресовСервисногоЦентраВРегионеПолучения = смартОбщегоНазначения.ПолучитьАдресРуководителяПредставительства(Представительство, АдресаДляОтправкиСтрокой);
		Для Каждого Адрес Из МассивАдресовСервисногоЦентраВРегионеПолучения Цикл
			МассивАдресовДляОтправки.Добавить(Адрес);
		КонецЦикла;
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			//-- смарт:ММ 03.03.2021
			
			Номер = Объект.Номер;
			
			ТемаПисьма = "Перемещение запчастей по заявке на гарантийный ремонт №" + Номер;
			
			ТекстПисьма = "По заявке на гарантийный ремонт №" + Номер + " необходима отправка запчастей в региональное представительство " +  Представительство.Наименование + ". Необходимо обработать Заказ на перемещение №" 
			+ ЗаказНаПеремещение.Номер + " от " + Формат(ЗаказНаПеремещение.Дата, "ДФ='dd.MM.yyyy ""г.""'");
			
			ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			//-- смарт:ММ 03.03.2021
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
				//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				Если ПараметрыПисьма.ТестоваяБаза Тогда
					ТекстСообщения = "Отправлено уведомление о перемещении гарантийных запчастей НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
				Иначе
					//-- смарт:ММ 03.03.2021
					
					ТекстСообщения = "Отправлено уведомление о перемещении гарантийных запчастей на почту " +  АдресаДляОтправкиСтрокой;		
					
					//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
				КонецЕсли;
				//-- смарт:ММ 03.03.2021
				
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Исключение 
				//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
				смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ЗаказНаПеремещение,ТекстПисьма);
				//-- #1416 смарт: Фролов 30.08.2023
				ТекстСообщения = "Не удалось отправить уведомление о перемещении гарантийных запчастей" + Символы.ПС + ОписаниеОшибки();
				ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


