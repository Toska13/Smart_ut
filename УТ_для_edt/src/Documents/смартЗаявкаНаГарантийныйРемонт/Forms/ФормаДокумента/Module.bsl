//Процедура ОбновитьСтатусНаСервере(Номенклатура, НомерПозиции, СтатусОжидаютсяДействия)
Процедура ОбновитьСтатусНаСервере(Номенклатура, НомерПозиции, СтатусОжидаютсяДействия, ИДСтрокиЗаполняетсяИнженером)
	
	ДокументОприходования = Неопределено;
	
	// ++ 08.04.2020
	//ЗаказНаПеремещение = Объект.ЗаказНаПеремещениеЗапчастейСИнженера;
	ЗаказНаПеремещение = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
	
	НайденныеСтроки = Объект.ЗаполняетсяИнженером.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		ЗаказНаПеремещение = НайденныеСтроки[0].ЗаказНаПеремещениеЗапчастейСИнженера;
	КонецЕсли;
		
	СтатусОприходованияЗапчастиНаСкладГарантия = ПолучитьСтатусОприходования(ЗаказНаПеремещение, ДокументОприходования, Номенклатура);
			
	Если СтатусОприходованияЗапчастиНаСкладГарантия = "Оприходованы" Тогда
		
		Если ДокументОприходования <> Неопределено Тогда
            
            Если ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
                ДатаИзмененияСтатуса = ЗаказНаПеремещение.Дата;
            Иначе
                ДатаИзмененияСтатуса = ДокументОприходования.Дата;
            КонецЕсли;
            
            //++ смарт:Подкин #933 31.03.2022 15:07:58
            НайденСтатус=Объект.Статусы.НайтиСтроки(Новый Структура("НомерПозиции,Статус,ДокументДвижения",НомерПозиции,ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаютсяДействия"),ДокументОприходования)); 
            Если НЕ НайденСтатус.Количество() Тогда  
                СтатусОжидаютсяДействия = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаютсяДействия");
                ДобавитьСтрокуСтатусаНаСервере(НомерПозиции, ДатаИзмененияСтатуса, СтатусОжидаютсяДействия, ДокументОприходования);
                Модифицированность = Истина;
            КонецЕсли;  
            //-- смарт:Подкин #933 31.03.2022 15:07:58 
            
        КонецЕсли;
        
	ИначеЕсли СтатусОприходованияЗапчастиНаСкладГарантия = "ОприходованыЧастично" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запчасть """ + Номенклатура + """ оприходована на склад частично. Статус не обновлен."); 
		
	ИначеЕсли СтатусОприходованияЗапчастиНаСкладГарантия = "НеОприходованы" Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запчасть """ + Номенклатура + """ не оприходована на склад. Статус не обновлен."); 
		
	КонецЕсли;
	
КонецПроцедуры

