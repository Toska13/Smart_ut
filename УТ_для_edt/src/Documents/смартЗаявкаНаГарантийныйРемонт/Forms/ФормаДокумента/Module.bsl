// ++ 16.08.2020
&НаКлиенте
Процедура РазбитьСтрокуЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	Если НоваяСтрока <> Неопределено Тогда
		
		// ++ 20.12.2020
		// Строку инженера тоже требуется разделить, чтобы они соответствовали строкам специалиста
		Отбор = Новый Структура;
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", НоваяСтрока.ИДСтрокиЗаполняетсяИнженером);
		СтрокиИнженера = Объект.ЗаполняетсяИнженером.НайтиСтроки(Отбор);
		Если СтрокиИнженера.Количество() > 0 Тогда
			СтрокаИнженер = СтрокиИнженера[0];
			
			НоваяСтрокаИнженер = Объект.ЗаполняетсяИнженером.Вставить(СтрокаИнженер.НомерСтроки);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаИнженер, СтрокаИнженер);
			НоваяСтрокаИнженер.ИДСтрокиЗаполняетсяИнженером = ПолучитьСледующийИДСтроки();
			НоваяСтрокаИнженер.Количество = НоваяСтрока.Количество; 
			СтрокаИнженер.Количество = СтрокаИнженер.Количество - НоваяСтрока.Количество;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером);
			
			СтрокиДопДействия = Объект.ДополнительныеДействияИнженер.НайтиСтроки(Отбор);
			Для Каждого СтрокаДД Из СтрокиДопДействия Цикл
				НоваяСтрокаДопДействия = Объект.ДополнительныеДействияИнженер.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДопДействия, СтрокаДД);
				НоваяСтрокаДопДействия.ИДСтрокиЗаполняетсяИнженером = НоваяСтрокаИнженер.ИДСтрокиЗаполняетсяИнженером;	
			КонецЦикла;	
			
			НоваяСтрока.ИДСтрокиЗаполняетсяИнженером = НоваяСтрокаИнженер.ИДСтрокиЗаполняетсяИнженером;
			НоваяСтрока.ДатаДобавления = ТекущаяДата();
		КонецЕсли;		
		// --
		
		НоваяСтрока.НомерПозиции = ПолучитьСледующийНомерПозиции();
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", ТекущаяСтрока.НомерПозиции);
		
		НайденныеСтрокиСтатус = Объект.Статусы.НайтиСтроки(Отбор);		
		Для Каждого СтрокаСтатус Из НайденныеСтрокиСтатус Цикл
			НоваяСтрокаСтатус = Объект.Статусы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСтатус, СтрокаСтатус);
			НоваяСтрокаСтатус.НомерПозиции = НоваяСтрока.НомерПозиции;
		КонецЦикла;
		
		НайденныеСтрокиИсторияРешений = Объект.ИсторияРешенийПоставщика.НайтиСтроки(Отбор);
		Для Каждого СтрокаИстория Из НайденныеСтрокиИсторияРешений Цикл
			НоваяСтрокаИстория = Объект.ИсторияРешенийПоставщика.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаИстория, СтрокаИстория);
			НоваяСтрокаИстория.НомерПозиции = НоваяСтрока.НомерПозиции;
		КонецЦикла;
		
		НайденныеСтрокиДопДействия = Объект.ДополнительныеДействия.НайтиСтроки(Отбор);
		Для Каждого СтрокаДопДействия Из НайденныеСтрокиДопДействия Цикл
			НоваяСтрокаДопДействия = Объект.ДополнительныеДействия.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДопДействия, СтрокаДопДействия);
			НоваяСтрокаДопДействия.НомерПозиции = НоваяСтрока.НомерПозиции;
		КонецЦикла;
				
	КонецЕсли;

КонецПроцедуры

