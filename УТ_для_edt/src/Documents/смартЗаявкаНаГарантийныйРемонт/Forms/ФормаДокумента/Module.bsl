// ++ 24.11.2020
&НаКлиенте
Процедура РазбитьСтрокуИнженераЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	ТекущаяСтрока = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	
	Если НоваяСтрока <> Неопределено Тогда
		
		НоваяСтрока.ИДСтрокиЗаполняетсяИнженером = ПолучитьСледующийИДСтроки(); 
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ТекущаяСтрока.ИДСтрокиЗаполняетсяИнженером);
		
		// ++ 15.12.2020
		СтрокиДопДействия = Объект.ДополнительныеДействияИнженер.НайтиСтроки(Отбор);
		Для Каждого СтрокаДД Из СтрокиДопДействия Цикл
			НоваяСтрокаДопДействия = Объект.ДополнительныеДействияИнженер.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДопДействия, СтрокаДД);
			НоваяСтрокаДопДействия.ИДСтрокиЗаполняетсяИнженером = НоваяСтрока.ИДСтрокиЗаполняетсяИнженером;	
		КонецЦикла;		
		// --
		
		НайденныеСтрокиСпециалист = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		
		// Разбить строку специалиста с последующим разбиением строк во всех зависимых таблицах
		Если НайденныеСтрокиСпециалист.Количество() > 0 Тогда
			
			СтрокаСпециалист = НайденныеСтрокиСпециалист[0];
			СтрокаСпециалист.Количество = ТекущаяСтрока.Количество;
			
			НоваяСтрокаСпециалист = Объект.ЗаполняетсяСпециалистомПоПретензиям.Вставить(СтрокаСпециалист.НомерСтроки);
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСпециалист, СтрокаСпециалист);
			НоваяСтрокаСпециалист.ИДСтрокиЗаполняетсяИнженером = НоваяСтрока.ИДСтрокиЗаполняетсяИнженером; // 17.12.2020 - исправление
			НоваяСтрокаСпециалист.НомерПозиции = ПолучитьСледующийНомерПозиции();
			НоваяСтрокаСпециалист.Количество = НоваяСтрока.Количество;
			// ++ 20.12.2020
			НоваяСтрокаСпециалист.ДатаДобавления = ТекущаяДата();
			// --
			
			Отбор = Новый Структура;
			Отбор.Вставить("НомерПозиции", СтрокаСпециалист.НомерПозиции);
			
			НайденныеСтрокиСтатус = Объект.Статусы.НайтиСтроки(Отбор);		
			Для Каждого СтрокаСтатус Из НайденныеСтрокиСтатус Цикл
				НоваяСтрокаСтатус = Объект.Статусы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаСтатус, СтрокаСтатус);
				НоваяСтрокаСтатус.НомерПозиции = НоваяСтрокаСпециалист.НомерПозиции;
			КонецЦикла;
			
			НайденныеСтрокиИсторияРешений = Объект.ИсторияРешенийПоставщика.НайтиСтроки(Отбор);
			Для Каждого СтрокаИстория Из НайденныеСтрокиИсторияРешений Цикл
				НоваяСтрокаИстория = Объект.ИсторияРешенийПоставщика.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаИстория, СтрокаИстория);
				НоваяСтрокаИстория.НомерПозиции = НоваяСтрокаСпециалист.НомерПозиции;
			КонецЦикла;
			
			НайденныеСтрокиДопДействия = Объект.ДополнительныеДействия.НайтиСтроки(Отбор);
			Для Каждого СтрокаДопДействия Из НайденныеСтрокиДопДействия Цикл
				НоваяСтрокаДопДействия = Объект.ДополнительныеДействия.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаДопДействия, СтрокаДопДействия);
				НоваяСтрокаДопДействия.НомерПозиции = НоваяСтрокаСпециалист.НомерПозиции;
			КонецЦикла;
			
		КонецЕсли;			
						
	КонецЕсли;

КонецПроцедуры

