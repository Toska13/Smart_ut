//++ смарт:ММ #044 224 15.07.2021 - Заявка на гарантийный ремонт 
&НаСервереБезКонтекста
Функция ПодобратьНоменклатуруНеLOA(Номенклатура)
	
	ПодобранныйАртикул = СокрЛП(Номенклатура.Артикул);
	
	Артикул = Лев(ПодобранныйАртикул, СтрДлина(ПодобранныйАртикул) - 3);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	1 КАК Порядок
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И НЕ Номенклатура.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка,
	|	2
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул = &Артикул
	|	И Номенклатура.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВТ.Порядок) КАК Порядок
	|ПОМЕСТИТЬ ВТ_Приоритет
	|ИЗ
	|	ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Приоритет КАК ВТ_Приоритет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО ВТ_Приоритет.Порядок = ВТ.Порядок";
	
	Запрос.УстановитьПараметр("Артикул", Артикул);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;	
	
КонецФункции //-- смарт:ММ 15.07.2021

