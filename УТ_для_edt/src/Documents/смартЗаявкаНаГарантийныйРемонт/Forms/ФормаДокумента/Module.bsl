Функция НайтиЗаказНаПеремещениеНаСкладПодЗаказ(НомерПозиции, СтатусОжидаетсяПоступление, Номенклатура)
	
	ЗаказНаПеремещение = Неопределено;
	
	//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
	//НомерЗаявки = Объект.Номер;
	//-- #Б1132 смарт: Шляпников 01.11.2024
	
	// Попытка найти заказ в табличной части со статусами
	
	ОтборСтатус = Новый Структура;
	ОтборСтатус.Вставить("НомерПозиции", НомерПозиции);
	ОтборСтатус.Вставить("Статус", СтатусОжидаетсяПоступление);
	СтрокиСтатус = Объект.Статусы.НайтиСтроки(ОтборСтатус);
	
	Если СтрокиСтатус.Количество() > 0 Тогда
		ЗаказНаПеремещение = СтрокиСтатус[0].ДокументДвиженияДоп;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) Тогда
		
		// Попытка найти заказ среди всех документов
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		//|	ЗаказНаПеремещениеТовары.Ссылка КАК Ссылка
		//|ИЗ
		//|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		//|ГДЕ
		//|	ЗаказНаПеремещениеТовары.Ссылка.Проведен
		//|	И ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонт = &смартНомерЗаявкиНаГарантийныйРемонт
		//|	И ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		//|	И ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель = &СкладПолучатель";
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗаказНаПеремещениеТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Ссылка.Проведен
		|	И ЗаказНаПеремещениеТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка = &смартНомерЗаявкиНаГарантийныйРемонтСсылка
		|	И ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
		|	И ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель = &СкладПолучатель";
		//-- #Б1132 смарт: Шляпников 01.11.2024
		
		Запрос.УстановитьПараметр("СкладПолучатель", ОсновнойСкладДляЗапчастейПодЗаказ);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		//++ #Б1132 смарт: Шляпников 01.11.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//Запрос.УстановитьПараметр("смартНомерЗаявкиНаГарантийныйРемонт", НомерЗаявки);
		Запрос.УстановитьПараметр("смартНомерЗаявкиНаГарантийныйРемонт", Объект.Ссылка);
		//-- #Б1132 смарт: Шляпников 01.11.2024
		
		ВыборкаЗаказ = Запрос.Выполнить().Выбрать();
		Если ВыборкаЗаказ.Следующий() Тогда
			ЗаказНаПеремещение = ВыборкаЗаказ.Ссылка;
		КонецЕсли;
		
	КонецЕсли;

	Возврат ЗаказНаПеремещение;
	
