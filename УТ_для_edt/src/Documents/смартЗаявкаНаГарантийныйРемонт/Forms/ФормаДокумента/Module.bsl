// ++ 28.01.2021
&НаСервере
Функция ПолучитьМассивСкладовСДоступнымиОстатками(НоменклатураПринятаяОтКлиента, КоличествоДляВключенияВСписокСкладов, ИДСтрокиЗаполняетсяИнженером)
	
	НоменклатураДляПроверкиОстатка = НоменклатураПринятаяОтКлиента;
	
	Если Элементы.ЗаполняетсяСпециалистомПоПретензиямАналогОтПоставщика.Видимость = Истина Тогда
		
		// Есть заполненные колонки с аналогом. Проверка, указан ли аналог для текущей строки инженера
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
		
		СтрокиСпециалиста = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		
		Если СтрокиСпециалиста.Количество() <> 0 Тогда
			
			СтатусПолученоОтПоставщика = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика");
			
			НомерПозиции = СтрокиСпециалиста[0].НомерПозиции;
			АналогОтПоставщикаИзТаблицыСпециалиста = СтрокиСпециалиста[0].АналогОтПоставщика;
			Если ЗначениеЗаполнено(АналогОтПоставщикаИзТаблицыСпециалиста) Тогда
				НоменклатураДляПроверкиОстатка = АналогОтПоставщикаИзТаблицыСпециалиста;
			КонецЕсли;
			
		КонецЕсли;		
	КонецЕсли;

	МассивСкладов = Новый Массив;
	
	СформироватьТекстОстатокНаСкладах(НоменклатураДляПроверкиОстатка, МассивСкладов, КоличествоДляВключенияВСписокСкладов, Истина);
	
	// ++ 16.02.2021
	//СкладПодЗаказ = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
	
	Если БылоПоступлениеНаСкладДляГарантийныхЗапчастейПодЗаказ(ИДСтрокиЗаполняетсяИнженером) Тогда
		Если МассивСкладов.Найти(ОсновнойСкладДляЗапчастейПодЗаказ) = Неопределено Тогда
			МассивСкладов.Добавить(ОсновнойСкладДляЗапчастейПодЗаказ);
		КонецЕсли;
	Иначе
		Если МассивСкладов.Найти(ОсновнойСкладДляЗапчастейПодЗаказ) <> Неопределено Тогда
			МассивСкладов.Удалить(МассивСкладов.Найти(ОсновнойСкладДляЗапчастейПодЗаказ));
		КонецЕсли;		
	КонецЕсли;
	// --
		
	Возврат МассивСкладов;
	
КонецФункции

// ++ 01.07.2020
&НаКлиенте
Процедура ЗаполняетсяИнженеромЗапчастьОтКлиентаПринялПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда		
				
		// ++ 01.04.2021
		Если ЗначениеЗаполнено(ТекущиеДанные.НоменклатураУстановленнаяКлиенту) 
			И НЕ ЗначениеЗаполнено(ТекущиеДанные.НоменклатураПринятаяОтКлиента) 
			И ТекущиеДанные.ЗапчастьОтКлиентаПринял = Истина Тогда
			//++ смарт:ММ #044 224 15.07.2021 - Заявка на гарантийный ремонт 
			Если НЕ НоменклатураДоступнаДляВыбора(ТекущиеДанные.НоменклатураУстановленнаяКлиенту) Тогда
				ТекущиеДанные.НоменклатураПринятаяОтКлиента = ПодобратьНоменклатуруНеLOA(ТекущиеДанные.НоменклатураУстановленнаяКлиенту);
			Иначе
			//-- смарт:ММ 15.07.2021
			ТекущиеДанные.НоменклатураПринятаяОтКлиента = ТекущиеДанные.НоменклатураУстановленнаяКлиенту;	
			//++ смарт:ММ #044 224 15.07.2021 - Заявка на гарантийный ремонт 
			КонецЕсли;
			//-- смарт:ММ 15.07.2021	
		КонецЕсли;
		// --
		
		НастроитьДоступностьКолонок(ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

