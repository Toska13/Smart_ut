// ++ 13.10.2020
&НаСервере
Функция НайтиДокументЗаказНаПеремещение(Номенклатура)
	
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Склад КАК Склад,
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК ВНаличииОстаток
	|ПОМЕСТИТЬ ВТ_ОстатокНаСкладе
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			,
	|			Склад = &Склад
	|				И Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстатки
	|ГДЕ
	|	ТоварыНаСкладахОстатки.ВНаличииОстаток <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыКПоступлению.Регистратор КАК Регистратор,
	|	ТоварыКПоступлению.Период КАК Период
	|ПОМЕСТИТЬ ВТ_ВсеЗаказыНаПеремещение
	|ИЗ
	|	РегистрНакопления.ТоварыКПоступлению КАК ТоварыКПоступлению
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОстатокНаСкладе КАК ВТ_ОстатокНаСкладе
	|		ПО ТоварыКПоступлению.Номенклатура = ВТ_ОстатокНаСкладе.Номенклатура
	|			И ТоварыКПоступлению.Склад = ВТ_ОстатокНаСкладе.Склад
	|			И (&УчитыватьТекущийОстаток)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ЗаказНаПеремещение
	|		ПО ((ВЫРАЗИТЬ(ТоварыКПоступлению.Регистратор КАК Документ.ЗаказНаПеремещение)) = ЗаказНаПеремещение.Ссылка)
	|ГДЕ
	|	ТоварыКПоступлению.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение
	|	И ТоварыКПоступлению.Склад = &Склад
	|	И ТоварыКПоступлению.Номенклатура = &Номенклатура
	|	И ТоварыКПоступлению.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	// ++ 13.12.2020
	//|	И НЕ ЗаказНаПеремещение.Комментарий ПОДОБНО ""%pre%""
	|	И ЗаказНаПеремещение.Комментарий ПОДОБНО &НомерЗаявки
	// --
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ВсеЗаказыНаПеремещение.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ДатаСреза
	|ИЗ
	|	ВТ_ВсеЗаказыНаПеремещение КАК ВТ_ВсеЗаказыНаПеремещение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_ВсеЗаказыНаПеремещение.Регистратор) КАК Регистратор
	|ИЗ
	|	ВТ_ВсеЗаказыНаПеремещение КАК ВТ_ВсеЗаказыНаПеремещение
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДатаСреза КАК ВТ_ДатаСреза
	|		ПО ВТ_ВсеЗаказыНаПеремещение.Период = ВТ_ДатаСреза.Период";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Склад", Объект.СкладИнженера);
	Запрос.УстановитьПараметр("УчитыватьТекущийОстаток", Истина);	// временно
	// ++ 13.12.2020
	Запрос.УстановитьПараметр("НомерЗаявки", "%" + ВнешнийНомер + "%");
	// --
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Регистратор;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

