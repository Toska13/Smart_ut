&НаСервере
Процедура УдалитьСтрокиСтатусаНаСервере(НомерПозиции)
		
	Сч = Объект.Статусы.Количество() - 1;

	Пока Сч >= 0 Цикл
		
		СтрокаСтатус = Объект.Статусы[Сч];
		Если СтрокаСтатус.НомерПозиции = НомерПозиции Тогда
			Объект.Статусы.Удалить(СтрокаСтатус);
		КонецЕсли;
		
		Сч = Сч - 1;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ДокументНеобходимоПровести()
	
	ДокументНеобходимоПровести = Ложь;
	
	Запрос = Новый Запрос;
	// 03.06.2020
	// если по детали с текущим статусом ОжидаетсяПоступление нет статуса ОтправленоПоставщику в таблице статусов, то можно не проводить,
	// т.е. обязательно проведение только если текущий статус ОжидаетсяПоступление и в истории есть статус ОтправленоПоставщику или текущий статус ОтправленоПоставщику
	
	//Запрос.Текст = 
	//"ВЫБРАТЬ
	//|	ЗаполняетсяСпециалистомПоПретензиям.Статус КАК Статус
	//|ПОМЕСТИТЬ ВТ_ТЧ
	//|ИЗ
