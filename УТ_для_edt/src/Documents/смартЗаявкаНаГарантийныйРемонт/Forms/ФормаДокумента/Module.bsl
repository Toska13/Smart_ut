// 29.08.2020
&НаКлиенте
Процедура ПроверитьВозможностьУстановкиСтатуса(Статус, НомерПозиции, Запчасть, Отказ)
	
	Отказ = Ложь;
	
	// 29.10.2020
	Если НЕ РольДоступнаСервер("ПолныеПрава") Тогда
		Если ПредыдущийСтатусОтправкиПоСтроке = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.НечемЗаменить") Тогда // Не отправлена
			МассивЗапрещенныхСтатусов = Новый Массив;
			МассивЗапрещенныхСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуется")); // Отгрузка не требуется, списать
			МассивЗапрещенныхСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ВГарантииОтказано"));  // Списать по служебной записке 
			МассивЗапрещенныхСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Списано"));
			МассивЗапрещенныхСтатусов.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Отправлено"));
			
			Если МассивЗапрещенныхСтатусов.Найти(Статус) <> Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запчасть " + Запчасть + " еще не принята на склад");
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

	//--
	
	// ++ 22.03.2021
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтатусовСписано = Новый Массив;
	МассивСтатусовСписано.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуется")); // Отгрузка не требуется, списать
	МассивСтатусовСписано.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуетсяНедовложение")); // ОтгрузкаНеТребуетсяНедовложение
	МассивСтатусовСписано.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ВГарантииОтказано")); // Списать по служебной записке
	МассивСтатусовСписано.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Списано"));
	
	Если МассивСтатусовСписано.Найти(ПредыдущийСтатусОтправкиПоСтроке) <> Неопределено 
		И Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка") Тогда  
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запчасть " + Запчасть + " уже списана!" );
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
	Если (ПредыдущийСтатусОтправкиПоСтроке = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка")
		ИЛИ ПредыдущийСтатусОтправкиПоСтроке = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику")) // Передано со склада для отправки
		И МассивСтатусовСписано.Найти(Статус) <> Неопределено		
		Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для изменения статуса следует сначала отменить отправку, используйте кнопку ""Отменить отправку"" в заявке");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// --
	
	Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОплаченоКлиентомИнженером") Тогда
		
		// Проверка, что по запчасти нет статусов списания - ОтгрузкаНеТребуется или ВГарантииОтказано, 
		// не разрешать выбирать статус "Оплачено"
		
		МассивСтатусовДляПроверки = Новый Массив;
		МассивСтатусовДляПроверки.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуется"));
		МассивСтатусовДляПроверки.Добавить(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ВГарантииОтказано"));
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", НомерПозиции);
		СтрокиСтатусыПоЗапчасти = Объект.Статусы.НайтиСтроки(Отбор);
		
		СинонимСтатуса = "";
		ВИсторииЕстьСтатусИзПроверямых = Ложь;
		
		Для Каждого СтрокаСтатус Из СтрокиСтатусыПоЗапчасти Цикл
			Если МассивСтатусовДляПроверки.Найти(СтрокаСтатус.Статус) <> Неопределено Тогда
				ВИсторииЕстьСтатусИзПроверямых = Истина;
				СинонимСтатуса = СтрокаСтатус.Статус;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ВИсторииЕстьСтатусИзПроверямых Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По запчасти " + Запчасть + " уже был установлен статус списания " + СинонимСтатуса);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// ++ 26.12.2020 
&НаКлиенте
Процедура ЗаполняетсяСпециалистомПоПретензиямВозвратНеиспользованнойЗапчастиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.ВозвратНеиспользованнойЗапчасти Тогда
			ТекстОстатокНаСкладах = СформироватьТекстОстатокНаСкладах(ТекущиеДанные.Номенклатура);
			ПоказатьПредупреждение(, "Укажите нужный склад в колонке ""со склада""!" + Символы.ПС + ТекстОстатокНаСкладах);		
		КонецЕсли;		
	КонецЕсли;	
	
КонецПроцедуры 

