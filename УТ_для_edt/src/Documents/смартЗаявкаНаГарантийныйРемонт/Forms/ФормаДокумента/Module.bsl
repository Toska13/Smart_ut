&НаКлиенте
Процедура ЗаполняетсяИнженеромДокументПолученияЗапчастиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанные.НоменклатураУстановленнаяКлиенту) Тогда
			
			ЗаказыДляОтбора = ПолучитьЗаказыНаПеремещениеДляОтбора(ТекущиеДанные.НоменклатураУстановленнаяКлиенту, Объект.СкладИнженера, Объект.Организация);
			
			Если ЗаказыДляОтбора.Количество() > 0 Тогда
				
				фиксНастройки = Новый НастройкиКомпоновкиДанных;
				
				эОтбор = фиксНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				эОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
				эОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				эОтбор.ПравоеЗначение = ЗаказыДляОтбора;
				эОтбор.Использование = Истина;
				
				эОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
				
				ПараметрыФормы = Новый Структура;
				ПараметрыФормы.Вставить("ФиксированныеНастройки", фиксНастройки);
				
				ОткрытьФорму("Документ.ЗаказНаПеремещение.Форма.ФормаВыбора", ПараметрыФормы, Элементы.ЗаполняетсяИнженеромДокументПолученияЗапчасти);
				
				СтандартнаяОбработка = Ложь;
			КонецЕсли;
		КонецЕсли;		
				
	КонецЕсли;
		
КонецПроцедуры

// ++ 13.12.2020
&НаСервереБезКонтекста
Функция ПолучитьЗаказыНаПеремещениеДляОтбора(Номенклатура, СкладПолучатель, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказНаПеремещениеТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|ГДЕ
	|	ЗаказНаПеремещениеТовары.Номенклатура = &Номенклатура
	|	И ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель = &СкладПолучатель
	|	И ЗаказНаПеремещениеТовары.Ссылка.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// ++ 15.12.2020
&НаКлиенте
Процедура ЗаполняетсяИнженеромПередУдалением(Элемент, Отказ)
	
	// ++ 12.01.2021
	СтрокаЗаполнена = Ложь;
	ТекущиеДанные = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.НоменклатураПринятаяОтКлиента)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.Количество)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументРазборки)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ЗаказНаПеремещениеЗапчастейСИнженера)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.НоменклатураУстановленнаяКлиенту)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументПолученияЗапчасти)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументВводОстатков)
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументЗаказНаВнутреннееПотребление)
			//++ #Б-3168 смарт: Лопато 06.05.2025 //Заявка на гарантийный ремонт. Дата установки запчасти клиенту.  
			// Отключил код
			//ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДатаУстановкиЗапчастиКлиенту)
			//-- #Б-3168 смарт: Лопато 06.05.2025
			ИЛИ ЗначениеЗаполнено(ТекущиеДанные.Склад)
			Тогда
			СтрокаЗаполнена = Истина;
		КонецЕсли;
		
	КонецЕсли;
		
	Если СтрокаЗаполнена Тогда 
		
		//++ #5824 смарт: Тимофеева 05.03.26 / Заявка на гарантийный ремонт. Расширение доступа для Специалиста по претензиям
		Если РольДоступнаСервер("смартСпециалистПоПретензиям") Тогда
			
			Оповещение = Новый ОписаниеОповещения("ЗаполняетсяИнженеромПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("ТекущиеДанные", Элемент.ТекущиеДанные));
			ПоказатьВопрос(Оповещение, "В строке присутствуют заполненные поля. Все равно удалить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
            Отказ = Истина;
			Возврат;
			
		КонецЕсли;
        //-- #5824 смарт: Тимофеева 05.03.26
		
	// --
		Если НЕ РольДоступнаСервер("ПолныеПрава") Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю("Недостаточно прав!");
			Отказ = Истина;
		КонецЕсли;
	// ++ 12.01.2021
	КонецЕсли;
	// --
	
	//++ #5824 смарт: Тимофеева 05.03.26 / Заявка на гарантийный ремонт. Расширение доступа для Специалиста по претензиям
	Если НЕ Отказ И НЕ ТекущиеДанные = Неопределено  Тогда
		ИнформироватьОНеобходимостиУдаленияСтрокиВТаблице(ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером, "ЗаполняетсяСпециалистомПоПретензиям");						
	КонецЕсли;
	//-- #5824 смарт: Тимофеева 05.03.26

КонецПроцедуры

//++ #5824 смарт: Тимофеева 05.03.26 / Заявка на гарантийный ремонт. Расширение доступа для Специалиста по претензиям
&НаКлиенте
Процедура ЗаполняетсяИнженеромПередУдалениемЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда		
		ИнформироватьОНеобходимостиУдаленияСтрокиВТаблице(ДополнительныеПараметры.ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером, "ЗаполняетсяСпециалистомПоПретензиям");
		Объект.ЗаполняетсяИнженером.Удалить(ДополнительныеПараметры.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ИнформироватьОНеобходимостиУдаленияСтрокиВТаблице(ИдентификаторСтроки, ИмяТаблицы)
	
	НайденныеСтроки = Объект[ИмяТаблицы].НайтиСтроки(Новый Структура("ИДСтрокиЗаполняетсяИнженером", ИдентификаторСтроки));  
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
		
		ТекстСообщения = СтрШаблон("В таблице ""%1"" требуется удалить строку №%2", 
							?(ИмяТаблицы = "ЗаполняетсяСпециалистомПоПретензиям", "Заполняется специалистом по претензиям", "Заполняется инженером"), 
							НайденнаяСтрока.НомерСтроки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);	
	КонецЦикла;
	
КонецПроцедуры

