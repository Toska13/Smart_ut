	Если Поле.Имя = "ЗаполняетсяСпециалистомПоПретензиямНомерОтправления" Тогда
		
		ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			
			Статус = ТекущиеДанные.Статус;			
			Если Статус <> ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику") 
				// ++ 15.04.2020
				И Статус <> ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка") Тогда
				// --
				
				НомерОтправления = ТекущиеДанные.НомерОтправления;
				// 28.06.2020 - Каталог открывается и без заполненного номера отправления
				//Если НЕ ЗначениеЗаполнено(НомерОтправления) Тогда
				//	Возврат;
				//КонецЕсли;
				//
				
				Если ЗначениеЗаполнено(ТекущиеДанные.КаталогФайлов) Тогда
					КаталогПоНомеру = ТекущиеДанные.КаталогФайлов;
				Иначе
					// 28.06.2020
					Если ЗначениеЗаполнено(НомерОтправления) Тогда
					//
						КаталогПоНомеру = смартОбщегоНазначения.СформироватьПутьККаталогуГарантийныхЗапчастей(НомерОтправления, Объект.Дата);
						ТекущиеДанные.КаталогФайлов = КаталогПоНомеру;
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(КаталогПоНомеру) Тогда
					Возврат;
				КонецЕсли;
				
				ФайлКлиента = Новый Файл(КаталогПоНомеру);
				Если ФайлКлиента.Существует() Тогда	
					ЗапуститьПриложение(КаталогПоНомеру);
				// 28.06.2020
				//Иначе 
				//	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден каталог " + КаталогПоНомеру);
				//	ТекстСообщения = "Создайте каталог " + КаталогПоНомеру + " и разместите в нем необходимые файлы. После этого файлы будут доступны на просмотр";
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	// ++ 17.07.2020
	ИначеЕсли Поле.Имя = "ЗаполняетсяСпециалистомПоПретензиямДатаОтправления"
		ИЛИ Поле.Имя = "ЗаполняетсяСпециалистомПоПретензиямКаталогФайлов" Тогда
		
		ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено 
			И ЗначениеЗаполнено(ТекущиеДанные.ДатаОтправления) 
			И ЗначениеЗаполнено(ТекущиеДанные.КаталогФайлов) Тогда
			
			КаталогПоНомеру = ТекущиеДанные.КаталогФайлов;
			ФайлКлиента = Новый Файл(КаталогПоНомеру);
			Если ФайлКлиента.Существует() Тогда	
				ЗапуститьПриложение(КаталогПоНомеру);
			КонецЕсли;
				
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ЗаполняетсяСпециалистомПоПретензиямПримечание" Тогда
		
		ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, );
			ПоказатьВводСтроки(Оповещение, ТекущиеДанные.Примечание, "Примечание",, Истина);
		КонецЕсли;
	//
	КонецЕсли;
	
