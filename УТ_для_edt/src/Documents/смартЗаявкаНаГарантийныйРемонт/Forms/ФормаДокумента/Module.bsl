&НаКлиенте
Процедура ЗаполняетсяИнженеромКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Объект.Ссылка)
			И ТекущиеДанные.ПредыдущееКоличество <> 0 
			И ТекущиеДанные.ПредыдущееКоличество <> ТекущиеДанные.Количество Тогда
			
			ВыбранноеЗначение = "";
			Массив = Новый Массив;
			Массив.Добавить(Тип("Строка"));
			ОписаниеТипов = Новый ОписаниеТипов(Массив, , Новый КвалификаторыСтроки(150));
		
			ПараметрыСтруктура = Новый Структура;
			ПараметрыСтруктура.Вставить("ИДСтрокиЗаполняетсяИнженером", ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером);
			ПараметрыСтруктура.Вставить("Запчасть", ТекущиеДанные.НоменклатураПринятаяОтКлиента);
			
			Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияИнженер", ЭтотОбъект, ПараметрыСтруктура);
			ПоказатьВводЗначения(Оповещение, ВыбранноеЗначение, "Укажите причину изменения количества", ОписаниеТипов);
			
		Иначе
			ТекущиеДанные.ПредыдущееКоличество = ТекущиеДанные.Количество;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

