&НаСервере
Процедура НастроитьСвязиПараметровВыбораНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
		Элементы.Контрагент.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый Массив);
	Иначе
		Если Элементы.Контрагент.СвязиПараметровВыбора.Количество() = 0 Тогда

			НоваяСвязь = Новый СвязьПараметраВыбора("Отбор.Партнер", "Объект.Клиент");
			НовыйМассив = Новый Массив();
			НовыйМассив.Добавить(НоваяСвязь);
			НовыеСвязи = Новый ФиксированныйМассив(НовыйМассив);
			Элементы.Контрагент.СвязиПараметровВыбора = НовыеСвязи;

		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

