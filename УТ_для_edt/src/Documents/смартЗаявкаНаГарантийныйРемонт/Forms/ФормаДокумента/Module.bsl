		СтрокаТовар = ЗаполняетсяИнженером.Получить(Индекс);
		
		Если ЗначениеЗаполнено(СтрокаТовар.НоменклатураУстановленнаяКлиенту) Тогда
			
			// ++ 13.12.2020
			Если РольДоступна("смартИнженер") Тогда
			// --
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.ДокументПолученияЗапчасти) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "В строке " + (Индекс + 1) + " таблицы ""Заполняется инженером"" не заполнен документ получения запчасти";
				Сообщение.Поле = "Объект.ЗаполняетсяИнженером[" + Индекс + "].ДокументПолученияЗапчасти";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				// Пока разрешена запись
				
				Отказ = Истина; // 13.12.2020 - раскомментировано
			КонецЕсли;
			
			//++ #Б-3168 смарт: Лопато 06.05.2025 //Заявка на гарантийный ремонт. Дата установки запчасти клиенту.  
			// Отключил код
			//// ++ 13.12.2020
			//Если НЕ ЗначениеЗаполнено(СтрокаТовар.ДатаУстановкиЗапчастиКлиенту) Тогда
			//	//rnp 24.12.2020 разрешена запись, т.к. при нажатии на кнопку Взять на складе запчасть получают до выезда клиенту и дата установки клиенту еще не известна
			//	//Сообщение = Новый СообщениеПользователю();
			//	//Сообщение.Текст = "В строке " + (Индекс + 1) + " таблицы ""Заполняется инженером"" не заполнена дата установки запчасти клиенту";
			//	//Сообщение.Поле = "Объект.ЗаполняетсяИнженером[" + Индекс + "].ДатаУстановкиЗапчастиКлиенту";
			//	//Сообщение.УстановитьДанные(ЭтотОбъект);
			//	//Сообщение.Сообщить();
			//	//Отказ = Истина;
			//КонецЕсли;
			//// --	
			//-- #Б-3168 смарт: Лопато 06.05.2025
					
			КонецЕсли;
			// --
			
			////++ смарт:ММ #044 224 16.11.2020 - Заявка на гарантийный ремонт
			//Если СтрокаТовар.Количество = 0 Тогда
			//	Сообщение = Новый СообщениеПользователю();
			//	Сообщение.Текст = "В строке " + (Индекс + 1) + " таблицы ""Заполняется инженером"" не заполнено количество";
			//	Сообщение.Поле = "ЗаполняетсяИнженером[" + Индекс + "].Количество";
			//	Сообщение.УстановитьДанные(ЭтотОбъект);
			//	Сообщение.Сообщить();
			//	Отказ = Истина;
			//КонецЕсли;
			////-- смарт:ММ 16.11.2020
		КонецЕсли;
		
	КонецЦикла;
	// --

	Для Индекс = 0 По ЗаполняетсяСпециалистомПоПретензиям.Количество() - 1 Цикл
		
		СтрокаТовар = ЗаполняетсяСпециалистомПоПретензиям.Получить(Индекс);
		
		ПроверятьДатуОтправления 	= Ложь;
		ПроверятьНомерОтправления 	= Ложь;
		ПроверятьКонтрагента 	= Ложь;
		
		Если СтрокаТовар.Статус = СтатусОтправлено Тогда
			
			ПроверятьДатуОтправления 	= Истина;
			ПроверятьНомерОтправления 	= Истина;
			ПроверятьКонтрагента 		= Истина;
			
		ИначеЕсли СтрокаТовар.Статус = СтатусКомпенсация 
			ИЛИ СтрокаТовар.Статус = СтатусОжидаетсяОтправка Тогда
			
			ПроверятьКонтрагента 		= Истина;
		КонецЕсли;
		
		Если ПроверятьДатуОтправления Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.ДатаОтправления) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "В строке " + (Индекс + 1) + " не заполнена дата отправления";
				Сообщение.Поле = "ЗаполняетсяСпециалистомПоПретензиям[" + Индекс + "].ДатаОтправления";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверятьНомерОтправления Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.НомерОтправления) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "В строке " + (Индекс + 1) + " не заполнен номер отправления";
				Сообщение.Поле = "ЗаполняетсяСпециалистомПоПретензиям[" + Индекс + "].НомерОтправления";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		Если ПроверятьКонтрагента Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТовар.Контрагент) Тогда
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "В строке " + (Индекс + 1) + " не заполнен контрагент";
				Сообщение.Поле = "ЗаполняетсяСпециалистомПоПретензиям[" + Индекс + "].Контрагент";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

