&НаСервере
Процедура ПриСозданииНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// ++ 21.02.2021
	ОсновнойСкладДляЗапчастейПодЗаказ = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ, Ложь);
	// --
		
	//++ смарт:ММ 25.10.2020
	Если ЗначениеЗаполнено(Параметры.Основание) 
		И ТипЗнч(Параметры.Основание) = Тип("ДокументСсылка.ЗаказНаПеремещение") 
		И Параметры.Основание.СкладПолучатель <> Справочники.смартПредопределенныеЗначения.СкладГарантийныхЗапчастейПоУмолчанию.Значение Тогда
		НеОткрывать = Истина;
	КонецЕсли;
	
	//-- смарт:ММ 25.10.2020
	//++ #1287 смарт: Фролов 03.04.2023 //Работа с гарантийными и коммерческими запасными частями  
	Если Объект.Ссылка.Пустая() И НЕ ЗначениеЗаполнено(Параметры.Основание) 
		
		//++ #Б-1498 смарт: Фролов 11.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
		//И НЕ РольДоступна("смартСпециалистПоПретензиям") Тогда
		И НЕ Пользователи.РолиДоступны("смартСпециалистПоПретензиям") Тогда
		//-- #Б-1498 смарт: Фролов 11.12.2024
		
		Сообщить("Заявка на гарантийный ремонт может быть создана только на основании другого документа!");
		НеОткрывать = Истина;
	КонецЕсли;	
	//-- #1287 смарт: Фролов 03.04.2023
	
	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если Не Параметры.Ключ.Пустая() Тогда
			
		УстановитьДоступностьДатыНомера(Истина);
				
		// ++ 29.08.2020
		Если Объект.Статус = Перечисления.СтатусыКассовойСмены.Закрыта 
			И НЕ ЕстьПолныеПрава()
			И НЕ УправлениеДоступом.ЕстьРоль("смартСпециалистПоПретензиям")
			И УправлениеДоступом.ЕстьРоль("смартИнженер") Тогда
			ЭтаФорма.ТолькоПросмотр = Истина;	
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Номер) Тогда
		// Разбить стандартный номер на префикс и цифровой внешний номер заявки
		СтруктураПрефиксНомер = смартОбщегоНазначения.РазбитьСтрокуНаПрефиксИНомер(Объект.Номер);
		Префикс 		= СтруктураПрефиксНомер.Префикс;
		ВнешнийНомер 	= СтруктураПрефиксНомер.Номер;
	Иначе
		Если ЗначениеЗаполнено(Объект.Поставщик) Тогда
			Префикс = ПолучитьПрефиксНаСервере(Объект.Поставщик);
		КонецЕсли;
	КонецЕсли;
	
	// 31.03.2020
	ДополнительныеСтатусы.Параметры.УстановитьЗначениеПараметра("НомерЗаявки", Объект.Номер);
	ДополнительныеСтатусы.Параметры.УстановитьЗначениеПараметра("Артикул", "");
	
	НастроитьВидимостьДоступность();
	
	ОбновитьРешенияПоставщика();
	
	// 25.04.2020
	ОбновитьКолонкуНоменклатурыРавны();
	
	// 15.12.2020
	ЗаполнитьКолонкуПредыдущееКоличество();  
	
    //++ #1287 смарт: Фролов 14.03.2023 //Работа с гарантийными и коммерческими запасными частями  
	УстановитьВидимостьОтчетМимаки();
    //-- #1287 смарт: Фролов 14.03.2023  
	
	//++ #2033 смарт: Мосолов 06.09.2024 //Доработка гарантийного блока / Добавить Организацию продавца оборудования (заявка на гарантийный ремонт)
    ОпределитьВывестиОрганизациюПродавца();
	//-- #2033 смарт: Мосолов 06.09.2024
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Партнер");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Клиент);
	//-- #Б3960 смарт: Шляпников 16.09.2025

КонецПроцедуры

//++ #2033 смарт: Мосолов 06.09.2024 //Доработка гарантийного блока / Добавить Организацию продавца оборудования (заявка на гарантийный ремонт)
&НаСервере
Процедура ОпределитьВывестиОрганизациюПродавца() 
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Номенклатура", Объект.Оборудование);
	Запрос.УстановитьПараметр("Серия", Объект.Серия);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВыручкаИСебестоимостьПродажОбороты.ВидЗапасов.Организация КАК Организация
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
	|				И АналитикаУчетаНоменклатуры.Серия = &Серия) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыручкаИСебестоимостьПродажОбороты.Период УБЫВ"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОрганизацияПродавец = Выборка.Организация;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОрганизацияПродавец) И ОрганизацияПродавец <> Объект.Организация Тогда
		
		Элементы.ОрганизацияПродавец.Видимость = Истина;
		
	КонецЕсли;
		
КонецПроцедуры //-- #2033 смарт: Мосолов 06.09.2024

