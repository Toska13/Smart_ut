&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//++ #1348 смарт: Фролов 02.05.2023 //Добавить предупреждение при создании Гар. заявки на основании Заявки на ремонт  
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.ДокументОснование) ТОгда
		РезультатПроверки=ПроверитьНаличиеГарантийныхЗаявок(); 
		Если НЕ РезультатПроверки=Неопределено ТОгда
			СпсКнопок=Новый СписокЗначений;
			СпсКнопок.Добавить("Отмена");
			Если РезультатПроверки.Количество()=1 Тогда
				СпсКнопок.Добавить("ПерейтиКЗаявке","Перейти к заявке");
			КонецЕсли;
			СпсКнопок.Добавить("ВсеРавноСоздатьНовую","Все равно создать новую");
			ДопПараметры=Новый Структура("Заявка",РезультатПроверки[0]);
			Оповещение = Новый ОписаниеОповещения("ПриСозданииНовогоДокументаЗавершение", ЭтотОбъект,ДопПараметры);
			Если РезультатПроверки.Количество()=1 Тогда 
				СтруктураРеквизитов=ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъекта(РезультатПроверки[0],"Номер");
				ТекстВопроса = НСтр("ru = 'Внимание! По данной заявке уже есть Заявка на гарантийный ремонт №"+СтруктураРеквизитов.Номер+"?'");
			Иначе
				ТекстНомера=""+Символы.ПС;
				Для Каждого Стр Из РезультатПроверки Цикл  
					СтруктураРеквизитов=ОбщегоНазначенияУТВызовСервера.ЗначенияРеквизитовОбъекта(Стр,"Номер");
					ТекстНомера=ТекстНомера+СтруктураРеквизитов.Номер+Символы.ПС;			
				КонецЦикла;	
			    ТекстВопроса = НСтр("ru = 'Внимание! По данной заявке уже есть следующие Заявки на гарантийный ремонт "+ТекстНомера+"'");
			КонецЕсли;
			ПоказатьВопрос(Оповещение, ТекстВопроса, СпсКнопок, , "Отмена");
		КонецЕсли;  
	КонецЕсли;
	//-- #1348 смарт: Фролов 02.05.2023
	
	//++ смарт:ММ 25.10.2020
	Если НеОткрывать Тогда
		ЭтаФорма.Закрыть();
	КонецЕсли;
	//-- смарт:ММ 25.10.2020
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	
	// Если есть хоть одна строка со статусом компенсация, то колонки сумма и валюта видны
	НастроитьВидимостьКолонокКомпенсации();
	
КонецПроцедуры 

