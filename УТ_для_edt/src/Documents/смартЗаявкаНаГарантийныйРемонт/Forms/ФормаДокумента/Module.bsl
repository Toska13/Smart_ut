Функция СоздатьПервичныйДокумент(ДатаДокумента)
	
	ДокументПервичныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
	
	ДокументПервичныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ВнутренняяНакладная;
	ДокументПервичныйДокумент.Дата 			= ДатаДокумента;
	ДокументПервичныйДокумент.Номер 			= Объект.Номер;
	ДокументПервичныйДокумент.Организация 	= Объект.Организация;
	ДокументПервичныйДокумент.Комментарий  	= ПолучитьТекстКомментарияКДокументу();
	//ДокументПервичныйДокумент.Валюта 		= ДанныеСтроки.Валюта;
	//ДокументПервичныйДокумент.СуммаДокумента = ДанныеСтроки.Сумма;
	//ДокументПервичныйДокумент.СуммаРегл 		= ДанныеСтроки.СуммаРегл;
	ДокументПервичныйДокумент.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоНакладным;
	
	СинонимДокумента = ДокументПервичныйДокумент.Метаданные().Синоним;

	
	
	Попытка
		ДокументПервичныйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		Возврат ДокументПервичныйДокумент.Ссылка;
	Исключение
		СинонимДокумента = ДокументПервичныйДокумент.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ не создан.");
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// ++ 27.02.2020
&НаСервере
Функция СоздатьДокументЗаказНаСборкуТоваров(Номенклатура, АналогНоменклатуры, КоличествоН)
	УстановитьПривилегированныйРежим(Истина);
	ДокументЗаказ = Документы.ЗаказНаСборку.СоздатьДокумент();
	
	ТекДата = ТекущаяДата();
	
	ДокументЗаказ.Дата 				= ТекДата;
	ДокументЗаказ.Организация 		= Объект.Организация;
	ДокументЗаказ.Склад 			= Объект.СкладИнженера;
	ДокументЗаказ.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	//ДокументЗаказ.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокументЗаказ.Статус 					= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказ.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.СборкаТоваров;
	ДокументЗаказ.Номенклатура 				= Номенклатура;
	ДокументЗаказ.Количество 				= КоличествоН;
	ДокументЗаказ.КоличествоУпаковок		= КоличествоН;
	ДокументЗаказ.НачалоСборкиРазборки 		= ТекДата;
	ДокументЗаказ.ОкончаниеСборкиРазборки 	= ТекДата;
	ДокументЗаказ.ВариантОбеспечения 		= Перечисления.ВариантыОбеспечения.Требуется;
	ДокументЗаказ.СборкаПодДеятельность 	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокументЗаказ.ВариантПриемкиТоваров 	= Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	//++ #1287 смарт: Фролов 10.03.2023 //Работа с гарантийными и коммерческими запасными частями  
	ДокументЗаказ.ДокументОснование			= Объект.Ссылка;
	//-- #1287 смарт: Фролов 10.03.2023
	Комментарий = ПолучитьТекстКомментарияКДокументу();
	Если НЕ ЗначениеЗаполнено(Комментарий) Тогда
		Комментарий = Объект.Номер;
	КонецЕсли;
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ДокументЗаказ.смартЗапчастиГарантийные = Истина;
	//-- #Б1376 смарт: Шляпников 19.11.2024
	
	ДокументЗаказ.Комментарий = "" + Комментарий + Символы.ПС + "отправляли " + Номенклатура.Артикул 
			+ Символы.ПС + "фактически получили " + АналогНоменклатуры.Артикул
			+ Символы.ПС + АналогНоменклатуры.Артикул + " переделана в " + Номенклатура.Артикул + " путем сборки";

	НоваяСтрока = ДокументЗаказ.Товары.Добавить();
	НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
	НоваяСтрока.Количество = КоличествоН;
	НоваяСтрока.КоличествоУпаковок = КоличествоН;
	НоваяСтрока.Номенклатура = АналогНоменклатуры;
		
	Попытка
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		СинонимДокумента = ДокументЗаказ.Метаданные().Синоним;
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ записан без проведения.");
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ДокументЗаказ.Ссылка;
		
КонецФункции

