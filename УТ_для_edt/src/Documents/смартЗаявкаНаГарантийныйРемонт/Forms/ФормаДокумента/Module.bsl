&НаСервере
Процедура ОбработатьИзменениеНоменклатурыСерии()  
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Объект.ДокументПриобретения = ДокументОбъект.НайтиДокументПриобретения(Объект.Оборудование, Объект.Серия);
	Объект.Поставщик = ?(ЗначениеЗаполнено(Объект.ДокументПриобретения), Объект.ДокументПриобретения.Партнер, ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"));
	ДокументОбъект.УстановитьНовыйНомер();    
	
	СтруктураПрефиксНомер = смартОбщегоНазначения.РазбитьСтрокуНаПрефиксИНомер(ДокументОбъект.Номер);
	Префикс 		= СтруктураПрефиксНомер.Префикс;
	ВнешнийНомер 	= СтруктураПрефиксНомер.Номер;
	
КонецПроцедуры //-- #1963 смарт: Мосолов 26.08.2024

