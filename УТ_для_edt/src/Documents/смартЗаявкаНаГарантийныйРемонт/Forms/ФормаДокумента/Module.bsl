	//|ИЗ
	//|	ВТ_ТЧ КАК ВТ_ТЧ
	//|ГДЕ
	//|	ВТ_ТЧ.Статус В(&Статусы)";
	
	//МассивСтатусы = Новый Массив;
	//МассивСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.ОтправленоПоставщику);
	//МассивСтатусы.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление);
	
	//Запрос.УстановитьПараметр("ТЧ", 		Объект.ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	//Запрос.УстановитьПараметр("Статусы", 	МассивСтатусы);
	
	//РезультатЗапроса = Запрос.Выполнить();
	//Если НЕ РезультатЗапроса.Пустой() Тогда
	//	ДокументНеобходимоПровести = Истина;
	//КонецЕсли;


	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.НомерПозиции КАК НомерПозиции,
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.Статус КАК Статус
	|ПОМЕСТИТЬ ВТ_Сатусы
	|ИЗ
	|	&ТЧСтатусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаполняетсяСпециалистомПоПретензиям.НомерСтроки КАК НомерСтроки,
	|	ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
	|	ЗаполняетсяСпециалистомПоПретензиям.Статус КАК Статус
	|ПОМЕСТИТЬ ВТ_ЗаполняетсяСпециалистомПоПретензиям
	|ИЗ
	|	&ТЧЗаполняетсяСпециалистом  КАК ЗаполняетсяСпециалистомПоПретензиям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.НомерСтроки,
	|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
	|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.Статус КАК Статус
	|ПОМЕСТИТЬ ВТ_СтрокиДляПроверки
	|ИЗ
	|	ВТ_ЗаполняетсяСпециалистомПоПретензиям КАК ВТ_ЗаполняетсяСпециалистомПоПретензиям
	|ГДЕ
	|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.Статус В(&Статусы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СтрокиДляПроверки.НомерСтроки,
	|	ВТ_СтрокиДляПроверки.НомерПозиции КАК НомерПозиции,
	|	ВТ_СтрокиДляПроверки.Статус,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_Сатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОтправлялосьПоставщику
	|ИЗ
	|	ВТ_СтрокиДляПроверки КАК ВТ_СтрокиДляПроверки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сатусы КАК ВТ_Сатусы
	|	    ПО ВТ_СтрокиДляПроверки.НомерПозиции = ВТ_Сатусы.НомерПозиции 
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_СтрокиДляПроверки.НомерСтроки,
	|	ВТ_СтрокиДляПроверки.НомерПозиции,
	|	ВТ_СтрокиДляПроверки.Статус
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_Сатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) = ИСТИНА";
	
	СтатусОтправленоПоставщику = Перечисления.смартСтатусыПоГарантии.ОтправленоПоставщику;
	МассивСтатусы = Новый Массив;
	МассивСтатусы.Добавить(СтатусОтправленоПоставщику);
	//++ смарт:ММ #044 224 20.07.2020
	//МассивСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.ОжидаетсяПоступление);
	МассивСтатусы.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление);
	//-- смарт:ММ 20.07.2020

	Запрос.УстановитьПараметр("Статусы", 	МассивСтатусы);
	Запрос.УстановитьПараметр("ТЧСтатусы", 	Объект.Статусы.Выгрузить());
	Запрос.УстановитьПараметр("ТЧЗаполняетсяСпециалистом", Объект.ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДокументНеобходимоПровести = ?(Выборка.Количество() = 0, Ложь, Истина);
	
	Если ДокументНеобходимоПровести Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ необходимо провести, т.к." + Символы.ПС);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Статус = СтатусОтправленоПоставщику Тогда
			ТекстСообщения = "	в строке " + Выборка.НомерСтроки + " установлен статус ""Отправлено поставщику"""; 
		Иначе
			ТекстСообщения = "	в строке " + Выборка.НомерСтроки + " в истории был статус ""Отправлено поставщику""";
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;
	
	Возврат ДокументНеобходимоПровести;
	
КонецФункции

&НаКлиенте
Процедура НастроитьВидимостьДоступностьЭлементовПоСтатусу(Статус, НомерПозиции)
	
	Если НЕ ДоступенСпециалистПоПретензиям() Тогда
		Возврат;
	КонецЕсли;
		
	//Элементы.ЗаполняетсяСпециалистомПоПретензиямКонтрагент.ТолькоПросмотр = Истина;
	
	Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику") 
		// ++ 15.04.2020
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка") Тогда
		// --
		Элементы.ЗаполняетсяСпециалистомПоПретензиямГруппаДатаНомерОтправления.ТолькоПросмотр = Ложь;
		//Элементы.ЗаполняетсяСпециалистомПоПретензиямКонтрагент.ТолькоПросмотр = Ложь;
	Иначе		
		Элементы.ЗаполняетсяСпециалистомПоПретензиямГруппаДатаНомерОтправления.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	//++ смарт:ММ #044 224 20.07.2020
	//Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Компенсация") Тогда
	Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.Компенсация") Тогда
	//-- смарт:ММ 20.07.2020
		Элементы.ЗаполняетсяСпециалистомПоПретензиямГруппаКомпенсация.ТолькоПросмотр = Ложь;
		//Элементы.ЗаполняетсяСпециалистомПоПретензиямКонтрагент.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.ЗаполняетсяСпециалистомПоПретензиямГруппаКомпенсация.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	//// ++ 27.02.2020
	//Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОтгрузкаНеТребуется") Тогда
	//	Элементы.ЗаполняетсяСпециалистомПоПретензиямКонтрагент.ТолькоПросмотр = Ложь;
	//КонецЕсли; 
	//// --
	
	// ++ 21.06.2020
	//Элементы.ЗаполняетсяСпециалистомПоПретензиямОбновитьСтатус.Доступность = Ложь;
	//
	//Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика")
	//	И ЕстьВИсторииСтрокиСтатус(ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.НечемЗаменить"), НомерПозиции) Тогда
	//	
	//	Элементы.ЗаполняетсяСпециалистомПоПретензиямОбновитьСтатус.Доступность = Истина;
	//	
	//КонецЕсли;
	// --
	
	// 25.04.2020
	// Доступность кнопки ОтменитьОтправку
	// Доступна только если в текущей строке статус «ожидается отправка» и в таблице статусов заполнен документ возврата поставщику
	
	Элементы.ЗаполняетсяСпециалистомПоПретензиямОтменитьОтправку.Доступность = Ложь;
	
	Если Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаетсяОтправка") 
		// ++ 08.10.2020
		ИЛИ Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Отправлено")
		// --
		Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", НомерПозиции);
		Отбор.Вставить("Статус", Статус);
		
		НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(НайденныеСтроки[0].ДокументДвижения) 
				// ++ 08.10.2020
				ИЛИ Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.Отправлено") // Этому статусу никакой документ не соответствует
				// --
				Тогда  // Статусу ОжидаетсяОтправка соответствует документ движения Возврат товаров поставщику
				Элементы.ЗаполняетсяСпециалистомПоПретензиямОтменитьОтправку.Доступность = Истина;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
		
КонецПроцедуры

