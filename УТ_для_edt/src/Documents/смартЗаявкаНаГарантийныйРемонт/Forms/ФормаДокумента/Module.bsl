		|	Номенклатура,
		|	Характеристика,
		|	Склад
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад КАК Склад,
		|	Таблица.ВНаличии КАК ВНаличии,
		|	0 КАК ПриходОсновной,
		|	Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
		|	Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
		|	0 КАК ВРезервеГрафика,
		|	Таблица.КОтгрузке КАК КОтгрузке,
		|	Таблица.ВРезервеСоСклада КАК ВРезервеСоСклада,
		|	Таблица.ВРезервеПодЗаказ КАК ВРезервеПодЗаказ
		|ПОМЕСТИТЬ ВТ_Набор2
		|ИЗ
		|	ВтСвободныеОстатки КАК Таблица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика,
		|	Таблица.Склад,
		|	0,
		//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
		|	Таблица.смартКоличествоИзЗаказовГарантийныеОстаток,
		//-- #Б1610 смарт: Шляпников 09.12.2024
		|	0,
		|	0,
		|	0,
		|	0,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ГрафикПоступленияТоваров.Остатки(, Номенклатура = &Номенклатура) КАК Таблица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика,
		|	Таблица.Склад,
		|	0,
		|	0,
		//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
		|	Таблица.смартКоличествоИзЗаказовГарантийныеОстаток,
		//-- #Б1610 смарт: Шляпников 09.12.2024
		|	0,
		|	0,
		|	0,
		|	0,
		|	0
		|ИЗ
		|	РегистрНакопления.ГрафикОтгрузкиТоваров.Остатки(, Номенклатура = &Номенклатура) КАК Таблица
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Таблица.Номенклатура,
		|	Таблица.Характеристика,
		|	Таблица.Склад,
		|	0,
		|	0,
		|	0,
		|	0,
		//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
		|	- Таблица.смартКоличествоГарантийные,
		//-- #Б1610 смарт: Шляпников 09.12.2024
		|	0,
		|	0,
		|	0
		|ИЗ
		|	РегистрСведений.ДоступныеОстаткиПланируемыхПоступлений КАК Таблица
		|ГДЕ
		//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
		|	( Таблица.смартКоличествоГарантийные < 0 )
		//-- #Б1610 смарт: Шляпников 09.12.2024
		|	И Таблица.ДатаДоступности = ДАТАВРЕМЯ(1, 1, 1)
		|	И Таблица.Номенклатура = &Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Набор.Номенклатура КАК Номенклатура,
		|	Набор.Характеристика КАК Характеристика,
		|	Набор.Склад КАК Склад,
		|	МАКСИМУМ(Набор.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаХранения,
		|	МАКСИМУМ(Набор.Номенклатура.ЕдиницаДляОтчетов) КАК ЕдиницаДляОтчетов,
		|	МАКСИМУМ(Набор.Номенклатура.КоэффициентЕдиницыДляОтчетов) КАК КоэффициентЕдиницыДляОтчетов,
		|	СУММА(Набор.ВНаличии) КАК ВНаличии,
		|	СУММА(Набор.ПриходОсновной) КАК ПриходОсновной,
		|	СУММА(Набор.РасходОсновной) КАК РасходОсновной,
		|	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) КАК ВРезервеСоСкладаИПодЗаказ,
		|	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика) КАК ВРезерве,
		|	СУММА(Набор.КОтгрузке) КАК Котгрузке,
		|	СУММА(Набор.ВНаличии) - СУММА(Набор.КОтгрузке) - СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) - СУММА(Набор.ВРезервеГрафика) КАК Доступно,
		|	Набор.Номенклатура.ЕдиницаДляОтчетов КАК НоменклатураЕдиницаДляОтчетов,
		|	Набор.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
		|	Набор.Номенклатура.Наименование КАК НоменклатураНаименование,
		|	Набор.Склад.Наименование КАК СкладНаименование,
		|	Набор.Характеристика.Наименование КАК ХарактеристикаНаименование,
		|	СУММА(Набор.ВРезервеСоСклада) КАК ВРезервеСоСклада,
		|	СУММА(Набор.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
		|	СУММА(Набор.ВРезервеГрафика) КАК ВРезервеГрафика
		|ПОМЕСТИТЬ ВТ_ОстаткиПоСкладам
		|ИЗ
		|	ВТ_Набор2 КАК Набор
		|
		|СГРУППИРОВАТЬ ПО
		|	Набор.Номенклатура,
		|	Набор.Характеристика,
		|	Набор.Склад,
		|	Набор.Номенклатура.ЕдиницаДляОтчетов,
		|	Набор.Номенклатура.ЕдиницаИзмерения,
		|	Набор.Номенклатура.Наименование,
		|	Набор.Склад.Наименование,
		|	Набор.Характеристика.Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ОстаткиПоСкладам.Номенклатура КАК Номенклатура,
		|	СУММА(ВТ_ОстаткиПоСкладам.Доступно) КАК Доступно,
		|	СУММА(ВТ_ОстаткиПоСкладам.ВРезерве) КАК ВРезерве,
		|	СУММА(ВТ_ОстаткиПоСкладам.ВРезервеСоСклада) КАК ВРезервеСоСклада,
		|	СУММА(ВТ_ОстаткиПоСкладам.ВРезервеПодЗаказ) КАК ВРезервеПодЗаказ,
		|	СУММА(ВТ_ОстаткиПоСкладам.ВРезервеГрафика) КАК ВРезервеГрафика,
		|	СУММА(ВТ_ОстаткиПоСкладам.ПриходОсновной) КАК ПриходОсновной,
		|	ВТ_ОстаткиПоСкладам.НоменклатураЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
		|	ВТ_ОстаткиПоСкладам.Склад КАК Склад
		|ИЗ
		|	ВТ_ОстаткиПоСкладам КАК ВТ_ОстаткиПоСкладам
		// ++ 23.02.2021
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &ОтборСкладовПоРЛС
		|				ТОГДА ВТ_ОстаткиПоСкладам.Склад В (&ДоступныеСклады)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		// --
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОстаткиПоСкладам.Номенклатура,
		|	ВТ_ОстаткиПоСкладам.НоменклатураЕдиницаИзмерения,
		|	ВТ_ОстаткиПоСкладам.Склад";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	// ++ 23.02.2021
	Если РольДоступна("ПолныеПрава") Тогда
		ОтборСкладовПоРЛС = Ложь;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОтборСкладовПоРЛС", ОтборСкладовПоРЛС);
	МассивДоступныхПоРЛССкладов = Новый Массив;
	Если ОтборСкладовПоРЛС Тогда
		Если РольДоступна("смартИнженер") 
			И НЕ РольДоступна("ПолныеПрава") Тогда
			МассивДоступныхПоРЛССкладов = ПолучитьМассивДоступныхСкладов();
			//rnp 16.06.2021
			ИндексСвоегоСклада = МассивДоступныхПоРЛССкладов.Найти(Объект.СкладИнженера);
			Если Не ИндексСвоегоСклада = Неопределено  Тогда 
				МассивДоступныхПоРЛССкладов.Удалить(ИндексСвоегоСклада);
			КонецЕсли;
			//
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДоступныеСклады", МассивДоступныхПоРЛССкладов);
	// --
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстИтог = "Остаток на складах:";
	Пока Выборка.Следующий() Цикл
		
		Доступно =  Выборка.Доступно; 
		
		Если Доступно <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстИтог = ТекстИтог + Символы.ПС + Выборка.Склад + ": " + Доступно;
		
		//++ смарт:ММ #044 224 12.01.2021 - Заявка на гарантийный ремонт 
		Если Доступно >= КоличествоДляВключенияВСписокСкладов Тогда
			Если МассивСкладов.Найти(Выборка.Склад) = Неопределено Тогда
				МассивСкладов.Добавить(Выборка.Склад);
			КонецЕсли;
		КонецЕсли;		
		//-- смарт:ММ 12.01.2021
		
	КонецЦикла;
	
	Возврат ТекстИтог;
	
КонецФункции 

// ++ 23.02.20221
&НаСервереБезКонтекста
Функция ПолучитьМассивДоступныхСкладов()
	
	МассивРезультат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыДоступаПользователи.Ссылка КАК ГруппаДоступа
	|ПОМЕСТИТЬ ВТ_ГруппаДоступа
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
	|ГДЕ
	|	ГруппыДоступаПользователи.Пользователь = &Пользователь
	|	И ГруппыДоступаПользователи.Ссылка.Профиль = &Профиль
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ГруппаДоступа.ГруппаДоступа КАК ГруппаДоступа,
	|	ГруппыДоступаВидыДоступа.ВсеРазрешены КАК ВсеРазрешены,
	|	ГруппыДоступаЗначенияДоступа.ЗначениеДоступа КАК ЗначениеДоступа
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	ВТ_ГруппаДоступа КАК ВТ_ГруппаДоступа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.ВидыДоступа КАК ГруппыДоступаВидыДоступа
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.ЗначенияДоступа КАК ГруппыДоступаЗначенияДоступа
	|			ПО ГруппыДоступаВидыДоступа.Ссылка = ГруппыДоступаЗначенияДоступа.Ссылка
	|				И ГруппыДоступаВидыДоступа.ВидДоступа = ГруппыДоступаЗначенияДоступа.ВидДоступа
	|		ПО ВТ_ГруппаДоступа.ГруппаДоступа = ГруппыДоступаВидыДоступа.Ссылка
	|			И (ГруппыДоступаВидыДоступа.ВидДоступа ССЫЛКА Справочник.Склады)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.ЗначениеДоступа КАК ЗначениеДоступа
	|ПОМЕСТИТЬ ВТ_ДоступныеСклады
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|ГДЕ
	|	ВременнаяТаблица.ВсеРазрешены = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.ЗначениеДоступа КАК ЗначениеДоступа
	|ПОМЕСТИТЬ ВТ_ЗапрещенныеСклады
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|ГДЕ
	|	ВременнаяТаблица.ВсеРазрешены = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДоступныеСклады.ЗначениеДоступа КАК Ссылка
	|ИЗ
	|	ВТ_ДоступныеСклады КАК ВТ_ДоступныеСклады
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Склады.Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗапрещенныеСклады КАК ВТ_ЗапрещенныеСклады
	|		ПО (ВТ_ЗапрещенныеСклады.ЗначениеДоступа = Склады.Ссылка)
	|ГДЕ
	|	ВТ_ЗапрещенныеСклады.ЗначениеДоступа ЕСТЬ NULL
	|	И 1 В
	|			(ВЫБРАТЬ
	|				1
	|			ИЗ
	|				ВТ_ЗапрещенныеСклады КАК ВТ_ЗапрещенныеСклады)";
	
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	
	Настройка = Справочники.смартПредопределенныеЗначения.ПрофильГруппыДоступаПраваИнженераСвойСклад;
	ПрофильПраваИнженераСвойСклад = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);
	
	Если НЕ ЗначениеЗаполнено(ПрофильПраваИнженераСвойСклад) Тогда
		Возврат МассивРезультат;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Профиль", ПрофильПраваИнженераСвойСклад);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
		
	МассивРезультат = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивРезультат;
	
КонецФункции

