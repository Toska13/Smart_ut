// ++ 15.12.2020
&НаКлиенте
Процедура ПослеВводаЗначенияИнженер(ВыбЗнач, ПараметрыСтруктура) Экспорт
	
	ИДСтрокиЗаполняетсяИнженером = ПараметрыСтруктура.ИДСтрокиЗаполняетсяИнженером;
	Запчасть = ПараметрыСтруктура.Запчасть;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
	НайденныеСтроки = Объект.ЗаполняетсяИнженером.НайтиСтроки(Отбор);
	
	Если ЗначениеЗаполнено(ВыбЗнач) Тогда
				
		НоваяСтрока = Объект.ДополнительныеДействияИнженер.Добавить();
		НоваяСтрока.ИДСтрокиЗаполняетсяИнженером = ИДСтрокиЗаполняетсяИнженером;
		НоваяСтрока.Дата = ТекущаяДата();
		НоваяСтрока.Комментарий = ВыбЗнач;
		
		Если СтрокиИнженераГдеМенялосьКоличество.НайтиПоЗначению(ИДСтрокиЗаполняетсяИнженером) = Неопределено Тогда
			СтрокиИнженераГдеМенялосьКоличество.Добавить(ИДСтрокиЗаполняетсяИнженером);
		КонецЕсли;
		
		//Если НЕ ЕстьПолныеПрава() Тогда
		//	ОтправитьУведомлениеОбИзмененииКоличестваВТаблицеИнженера(Запчасть);
		//КонецЕсли;
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].ПредыдущееКоличество = НайденныеСтроки[0].Количество;
		КонецЕсли;
		
	Иначе
		// Вернуть старое значение
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Количество = НайденныеСтроки[0].ПредыдущееКоличество;
		КонецЕсли;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для изменения введенного ранее количества необходимо указать причину");
	КонецЕсли;
	
КонецПроцедуры

