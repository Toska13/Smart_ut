&НаСервереБезКонтекста
Функция ПолучитьСтатусОприходования(ЗаказНаПеремещение, ДокументОприходования, Номенклатура = Неопределено)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДвижениеТоваров.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ДвижениеТоваров.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|				ТОГДА ДвижениеТоваров.Регистратор
	|			ИНАЧЕ ЗНАЧЕНИЕ(Документ.ПриходныйОрдерНаТовары.ПустаяСсылка)
	|		КОНЕЦ) КАК ПриходныйОрдер,
	|	СУММА(ДвижениеТоваров.ПланируемоеПоступление) КАК ПланируемоеПоступление,
	|	СУММА(ВЫБОР
	|			КОГДА ДвижениеТоваров.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение
	|				ТОГДА ДвижениеТоваров.ПланируемоеПоступление
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоВЗаказе,
	|	СУММА(ВЫБОР
	|			КОГДА ДвижениеТоваров.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|				ТОГДА -ДвижениеТоваров.ПланируемоеПоступление
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоВПриходныхОрдерах
	|ИЗ
	|	РегистрНакопления.ДвижениеТоваров КАК ДвижениеТоваров
	|ГДЕ
	|	(ВЫРАЗИТЬ(ДвижениеТоваров.Распоряжение КАК Документ.ЗаказНаПеремещение)) = &ЗаказНаПеремещение
	|	И ВЫБОР
	|			КОГДА ДвижениеТоваров.Регистратор ССЫЛКА Документ.ЗаказНаПеремещение
	|				ТОГДА ИСТИНА
	|			КОГДА ДвижениеТоваров.Регистратор ССЫЛКА Документ.ПриходныйОрдерНаТовары
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоНоменклатуре
	|				ТОГДА ДвижениеТоваров.Номенклатура = &Номенклатура
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ДвижениеТоваров.Номенклатура";
	
	Запрос.УстановитьПараметр("ЗаказНаПеремещение", 	ЗаказНаПеремещение);
	Запрос.УстановитьПараметр("ОтборПоНоменклатуре", 	?(ЗначениеЗаполнено(Номенклатура), Истина, Ложь));
	Запрос.УстановитьПараметр("Номенклатура", 			Номенклатура);
		
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	ДокументОприходования = Выборка.ПриходныйОрдер;
	
	Если Выборка.ПланируемоеПоступление = 0 Тогда
		Возврат "Оприходованы";
	КонецЕсли;
	
	Если Выборка.КоличествоВПриходныхОрдерах <> Неопределено И Выборка.КоличествоВПриходныхОрдерах <> 0 Тогда
		Возврат "ОприходованыЧастично";
	Иначе
		Возврат "НеОприходованы";
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСпециалистаПоПретензиям(ДокументОприходования)
	
	СтатусОжидаютсяДействия = Перечисления.смартСтатусыПоГарантии.ОжидаютсяДействия;
	
	// 08.04.2020
	//ДатаИзмененияСтатуса = Дата("00010101");
	//
	//Если ЗначениеЗаполнено(Объект.ЗаказНаПеремещениеЗапчастейСИнженера) Тогда
	//	ДатаИзмененияСтатуса = Объект.ЗаказНаПеремещениеЗапчастейСИнженера.Дата;
	//КонецЕсли;
	
	//Объект.Статусы.Очистить();
	//--
	
	// ++ 13.12.2020
	Об = РеквизитФормыВЗначение("Объект");
	// --
	
	НомерСтроки = Объект.ЗаполняетсяСпециалистомПоПретензиям.Количество() + 1;
	
	УжеОбработанныеСтроки = Объект.ЗаполняетсяСпециалистомПоПретензиям.Выгрузить().ВыгрузитьКолонку("ИДСтрокиЗаполняетсяИнженером");
	Если Объект.ЗаполняетсяСпециалистомПоПретензиям.Количество() < Объект.ЗаполняетсяИнженером.Количество() Тогда //временно для обновления реквизитов

	Для Каждого СтрокаИнженер Из Объект.ЗаполняетсяИнженером Цикл
		
		Если УжеОбработанныеСтроки.Найти(СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		

		Для Сч = 1 По СтрокаИнженер.Количество Цикл
			
			СтрокаПретензия = Объект.ЗаполняетсяСпециалистомПоПретензиям.Добавить();
			//СтрокаПретензия.Номенклатура 	= СтрокаИнженер.Номенклатура;
			СтрокаПретензия.Номенклатура 	= СтрокаИнженер.НоменклатураПринятаяОтКлиента;
			СтрокаПретензия.Количество 		= 1;
			СтрокаПретензия.Статус 			= СтатусОжидаютсяДействия;
			СтрокаПретензия.НомерПозиции 	= НомерСтроки;
			
			// 08.04.2020
			ДатаИзмененияСтатуса = СтрокаИнженер.ЗаказНаПеремещениеЗапчастейСИнженера.Дата;
			СтрокаПретензия.ИДСтрокиЗаполняетсяИнженером = СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером;
			//--
			// 07.06.2020
			СтрокаПретензия.ДатаДобавления = ТекущаяДата();
			
			// ++ 13.12.2020
			СтрокаПретензия.Контрагент = Об.ПолучитьКонтрагентаДляТЧСпециалиста();
			// --
		
			ДобавитьСтрокуСтатусаНаСервере(НомерСтроки, ДатаИзмененияСтатуса, СтатусОжидаютсяДействия, ДокументОприходования);
						
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
	
		
		
	КонецЦикла;
	КонецЕсли;//временно для обновления реквизитов
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Сч = 1;
	ИДСтроки = 0;
	//Если ТаблицаТоваров.Количество() > 0 Тогда
	//	СтрокаТовара = ТаблицаТоваров[0];
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл	
		
		ДобавляетсяНоваяСтрока = Ложь;
		
		Если Сч = 1 Тогда			
			ТекущаяСтрока = Объект.ЗаполняетсяИнженером.НайтиПоИдентификатору(ИдентификаторРедактируемойСтроки);
			//ИДСтроки = ИдентификаторРедактируемойСтроки
		ИначеЕсли Сч = 2 Тогда
			ИДСтроки = ПолучитьСледующийИДСтроки();
			ДобавляетсяНоваяСтрока = Истина;
		Иначе
			ИДСтроки = ИДСтроки + 1;			
			ДобавляетсяНоваяСтрока = Истина;
		КонецЕсли;
		
		Если ДобавляетсяНоваяСтрока Тогда
			ТекущаяСтрока = Объект.ЗаполняетсяИнженером.Добавить();
			ТекущаяСтрока.ИДСтрокиЗаполняетсяИнженером = ИДСтроки;	
		КонецЕсли;
		
		Если ТекущаяСтрока <> Неопределено Тогда
			ТекущаяСтрока.НоменклатураУстановленнаяКлиенту = СтрокаТовара.Номенклатура;
			
			// ++ 27.11.2020
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Количество) Тогда
			// --
			ТекущаяСтрока.Количество = СтрокаТовара.Количество;
			// ++ 15.12.2020
			ТекущаяСтрока.ПредыдущееКоличество = СтрокаТовара.Количество;
			
			// ++ 27.11.2020
			КонецЕсли;
			// --
			// ++ 13.10.2020
			ТекущаяСтрока.ДокументПолученияЗапчасти = НайтиДокументЗаказНаПеремещение(ТекущаяСтрока.НоменклатураУстановленнаяКлиенту);
			// ++ 30.06.2021
			Если ЗначениеЗаполнено(ТекущаяСтрока.ДокументПолученияЗапчасти) 
				И НЕ ЗначениеЗаполнено(ТекущаяСтрока.Склад) Тогда
				ТекущаяСтрока.Склад = ТекущаяСтрока.ДокументПолученияЗапчасти.СкладОтправитель;
			КонецЕсли;
			// --
		КонецЕсли;		
				
		Сч = Сч + 1;
		
	КонецЦикла;

	// ++ 29.02.2020
	Если ТаблицаТоваров.Количество() > 0 Тогда
		ЭтаФорма.Модифицированность = Истина;
		//НастроитьВидимостьДоступность();
	КонецЕсли;
	// --
	// ++ 30.06.2021
	НастроитьВидимостьДоступность();
	// --
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполняетсяСпециалистомПоПретензиямПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		НомерТекущейСтроки = ТекущиеДанные.НомерПозиции;	
		Элементы.Статусы.ОтборСтрок = Новый ФиксированнаяСтруктура("НомерПозиции", НомерТекущейСтроки);
		
		// 30.04.2020
		Элементы.ИсторияРешенийПоставщика.ОтборСтрок = Новый ФиксированнаяСтруктура("НомерПозиции", НомерТекущейСтроки);
		Элементы.ДополнительныеДействия.ОтборСтрок = Новый ФиксированнаяСтруктура("НомерПозиции", НомерТекущейСтроки);
		//
		
		НастроитьВидимостьДоступностьЭлементовПоСтатусу(ТекущиеДанные.Статус, НомерТекущейСтроки);
		
		// ++ 26.04.2020 - очищалась дата отправки при активизации строки
		//// 06.04.2020
		//ЗаполнитьЗависимыеОтСтатусаКолонки(ТекущиеДанные, Истина);
		
		// 31.03.2020
		ДополнительныеСтатусы.Параметры.УстановитьЗначениеПараметра("Артикул", ПолучитьАртикул(ТекущиеДанные.Номенклатура));

		// ++ 27.11.2020
		НастроитьВидимостьДоступностьЭлементовСпециалист(ТекущиеДанные);
		// --
	КонецЕсли;
	
КонецПроцедуры

