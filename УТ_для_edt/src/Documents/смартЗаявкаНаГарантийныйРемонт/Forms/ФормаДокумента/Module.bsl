&НаСервере
Процедура ОбновитьРешенияПоставщика()
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаполняетсяСпециалистомПоПретензиям", Объект.ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	Запрос.УстановитьПараметр("ИсторияРешенийПоставщика", Объект.ИсторияРешенийПоставщика.Выгрузить());

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтИсторияРешенийПоставщика.НомерСтроки КАК НомерСтроки,
	|	смартЗаявкаНаГарантийныйРемонтИсторияРешенийПоставщика.НомерПозиции КАК НомерПозиции
	|ПОМЕСТИТЬ ВТ_ИсторияРешений
	|ИЗ
	|	&ИсторияРешенийПоставщика КАК смартЗаявкаНаГарантийныйРемонтИсторияРешенийПоставщика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
	|	ВЫРАЗИТЬ(смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_Артикулы
	|ИЗ
	|	&ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИсторияРешений.НомерСтроки КАК НомерСтроки,
	|	ВТ_Артикулы.Номенклатура.Артикул КАК Артикул
	|ИЗ
	|	ВТ_ИсторияРешений КАК ВТ_ИсторияРешений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Артикулы КАК ВТ_Артикулы
	|		ПО ВТ_ИсторияРешений.НомерПозиции = ВТ_Артикулы.НомерПозиции";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Объект.ИсторияРешенийПоставщика[Выборка.НомерСтроки - 1].Артикул = Выборка.Артикул;	
	КонецЦикла;	
	
КонецПроцедуры

// ++ 25.04.2020
&НаКлиенте
Процедура ОтменитьОтправку(Команда)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		ВыбранноеЗначение = "";
		Массив = Новый Массив;
		Массив.Добавить(Тип("Строка"));
		ОписаниеТипов = Новый ОписаниеТипов(Массив, , Новый КвалификаторыСтроки(150));
		
		ПараметрыСтруктура = Новый Структура;
		ПараметрыСтруктура.Вставить("НомерПозиции", ТекущиеДанные.НомерПозиции);
		// ++ 08.10.2020
		ПараметрыСтруктура.Вставить("СтатусСтроки", ТекущиеДанные.Статус);
		// --
		
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначения", ЭтотОбъект, ПараметрыСтруктура);
		ПоказатьВводЗначения(Оповещение, ВыбранноеЗначение, "Введите причину отмены отправки", ОписаниеТипов);
		
	КонецЕсли;

КонецПроцедуры

// ++ 25.04.2020
&НаКлиенте
Процедура ПослеВводаЗначения(ВыбЗнач, ПараметрыСтруктура) Экспорт
	
	Если ЗначениеЗаполнено(ВыбЗнач) Тогда
		ОбработатьОтменуОтправки(ВыбЗнач, ПараметрыСтруктура);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для отмены отправки запчасти поставщику необходимо указать причину");
	КонецЕсли;
	
КонецПроцедуры

// ++ 25.04.2020
&НаСервере
Процедура ОбработатьОтменуОтправки(КомментарийОтмены, ПараметрыСтруктура)
	
	// ++ 08.10.2020
	// 0. Если статус = Отправлено, то проверяется наличие Расходного ордера на товары в истории статусов для ОтправленоПоставщику
	// Если Расходный ордер проведен, то выдается сообщение пользователю, отправляется уведомление, дальнейшая обработка не происходит
	// Если Расходный ордер не проведен, то дополнительно удалить из истории статусов строку со статусом ОтправленоПоставщику
	// --
	
	// 1. в таблице статусов удаляется статус «Ожидается отправка», помечаются на удаление документы  Возврат поставщику
	// 2. в новую табчасть «Дополнительные действия» делается запись с текущей датой и комментарием, который ввел пользователь в качестве причины
	// 3. устанавливается признак "ОтменаОтправки" у документа
	
	Если ТипЗнч(ПараметрыСтруктура) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	НомерПозиции = ПараметрыСтруктура.НомерПозиции;
	
	// ++ 08.10.2020
	
	СтатусСтроки = ПараметрыСтруктура.СтатусСтроки;

	СтатусОжидаетсяОтправка 	= Перечисления.смартСтатусыПоГарантии.ОжидаетсяОтправка;
	СтатусОтправлено 			= Перечисления.смартСтатусыПоГарантии.Отправлено;
	СтатусОтправленоПоставщику 	= Перечисления.смартСтатусыПоГарантии.ОтправленоПоставщику; // "Передано со склада для отправки"
	
	Если СтатусСтроки = СтатусОтправлено Тогда
		
		// Перед удалением Возврата поставщику необходимо проверить, есть ли проведенный Расходный ордер.
		// Если есть, то поругаться, отправить уведомление, Возврат поставщику не трогать
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", НомерПозиции);
		Отбор.Вставить("Статус", СтатусОтправленоПоставщику);
				
		НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			
			СтрокаСтатус = НайденныеСтроки[0];
			ДокументРасходныйОрдер = СтрокаСтатус.ДокументДвижения;
			
			Если ДокументРасходныйОрдер.Проведен И НЕ ДокументРасходныйОрдер.ПометкаУдаления Тогда
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Предварительно необходимо, чтобы склад распровел ордер, и затем повторить отмену отправки");
				ОтправитьУведомлениеОНеобходимостиРаспровестиРасходныйОрдер(ДокументРасходныйОрдер);
				
				Возврат;
			КонецЕсли;	
		КонецЕсли;		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	// --
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерПозиции", НомерПозиции);
	Отбор.Вставить("Статус", СтатусОжидаетсяОтправка);

	НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		
		СтрокаСтатус = НайденныеСтроки[0];
		ДокументВозвратПоставщику = СтрокаСтатус.ДокументДвижения;
		
		Если ЗначениеЗаполнено(ДокументВозвратПоставщику) Тогда
			ДокументВозвратПоставщикуОбъект = ДокументВозвратПоставщику.ПолучитьОбъект();
			ДокументВозвратПоставщикуОбъект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		
		Объект.Статусы.Удалить(СтрокаСтатус);
		
		// ++ 08.10.2020
		Если СтатусСтроки = СтатусОтправлено Тогда
			
			// Удалить строку со статусом Отправлено
			Отбор = Новый Структура;
			Отбор.Вставить("НомерПозиции", НомерПозиции);
			Отбор.Вставить("Статус", СтатусОтправлено);
			
			НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() <> 0 Тогда
				СтрокаСтатус = НайденныеСтроки[0];
				Объект.Статусы.Удалить(СтрокаСтатус);
			КонецЕсли;
			
			// Удалить строку со статусом ОтправленоПоставщику
			Отбор.Вставить("Статус", СтатусОтправленоПоставщику);
			
			НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() <> 0 Тогда
				СтрокаСтатус = НайденныеСтроки[0];
				Объект.Статусы.Удалить(СтрокаСтатус);
			КонецЕсли;
			
		КонецЕсли;

		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", НомерПозиции);
		// --

		НайденныеСтрокиСпециалист = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		Если НайденныеСтрокиСпециалист.Количество() > 0 Тогда
			// ++ 08.10.2020
			//НайденныеСтрокиСпециалист[0].Статус = Перечисления.смартСтатусыПоГарантии.ОжидаютсяДействия;
			Статус = Перечисления.смартСтатусыПоГарантии.ОжидаютсяДействия; // "Сдано на склад, ожидаются действия"

			Отбор = Новый Структура;
			Отбор.Вставить("НомерПозиции", НомерПозиции);
			Отбор.Вставить("Статус", Статус);
			НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор); 
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("НомерПозиции", НомерПозиции);
				Отбор.Вставить("Статус", СтатусОтправлено);
				НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() <> 0 Тогда
					Статус = СтатусОтправлено; 
				Иначе
					Отбор = Новый Структура;
					Отбор.Вставить("НомерПозиции", НомерПозиции);
					НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
					Если НайденныеСтроки.Количество() <> 0 Тогда
						Статус = НайденныеСтроки[0].Статус; 
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НайденныеСтрокиСпециалист[0].Статус = Статус;
			// --
		КонецЕсли;
				
		НоваяСтрокаКомментарий = Объект.ДополнительныеДействия.Добавить();
		НоваяСтрокаКомментарий.Дата 		= ТекущаяДата();
		НоваяСтрокаКомментарий.НомерПозиции = НомерПозиции;
		НоваяСтрокаКомментарий.Комментарий 	= КомментарийОтмены;
		
		Объект.ОтменаОтправки = Истина;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	// ++ 08.10.2020		
	УстановитьПривилегированныйРежим(Ложь);
	// --
	
КонецПроцедуры

