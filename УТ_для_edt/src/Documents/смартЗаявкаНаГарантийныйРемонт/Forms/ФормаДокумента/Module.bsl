&НаКлиенте
Процедура ЗаполняетсяИнженеромПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяИнженером.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		НастроитьДоступностьКолонок(ТекущиеДанные);		
		
		// ++ 15.12.2020
		Элементы.ДополнительныеДействияИнженер.ОтборСтрок = Новый ФиксированнаяСтруктура("ИДСтрокиЗаполняетсяИнженером", ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером);
		// --
		// ++ 27.01.2021
		// Событие ПриНачалеРедактирования почему-то не отрабатывает при добавлении первой строки, например (еще иногда при копировании)
		// Поэтому доп. проверка, если ИД = 0, то заполнить его
		Если ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером = 0 
			И НЕ ЗначениеЗаполнено(ТекущиеДанные.НоменклатураПринятаяОтКлиента) Тогда // Строка новая, чтобы не зацепить существующие документы
			ТекущиеДанные.ИДСтрокиЗаполняетсяИнженером = ПолучитьСледующийИДСтроки();
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
		// --
		
	КонецЕсли;	
		
КонецПроцедуры

// ++ 01.07.2020
&НаКлиенте
Процедура НастроитьДоступностьКолонок(ТекущиеДанные)
	
	Элементы.ЗаполняетсяИнженеромНоменклатурыРавны.ТолькоПросмотр = Ложь;
	Элементы.ЗаполняетсяИнженеромДокументРазборки.ТолькоПросмотр = Ложь;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.НоменклатураУстановленнаяКлиенту) Тогда
		Элементы.ЗаполняетсяИнженеромНоменклатурыРавны.ТолькоПросмотр = Истина;
		Элементы.ЗаполняетсяИнженеромДокументРазборки.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	// ++ 16.08.2020
	Если ЗначениеЗаполнено(ТекущиеДанные.ЗаказНаПеремещениеЗапчастейСИнженера) Тогда
		Элементы.ЗаполняетсяИнженеромЗапчастьОтКлиентаПринял.ТолькоПросмотр = Истина;
		Элементы.ЗаполняетсяИнженеромНоменклатурыРавны.ТолькоПросмотр = Истина;
		Элементы.ЗаполняетсяИнженеромНоменклатура.ТолькоПросмотр = Истина;
		Элементы.ЗаполняетсяИнженеромКоличество.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ЗаполняетсяИнженеромЗапчастьОтКлиентаПринял.ТолькоПросмотр = Ложь;
		Элементы.ЗаполняетсяИнженеромНоменклатурыРавны.ТолькоПросмотр = Ложь;
		Элементы.ЗаполняетсяИнженеромНоменклатура.ТолькоПросмотр = Ложь;
		Элементы.ЗаполняетсяИнженеромКоличество.ТолькоПросмотр = Ложь;
	КонецЕсли;
	// --
	
    // ++ 27.11.2020
    Если ТекущиеДанные.Количество <= 1 Тогда
        //++ смарт:Подкин #909 17.02.2022 14:11:44  
        Элементы.ЗаполняетсяИнженеромРазбитьСтрокуИнженер.Доступность = Ложь;

    ИначеЕсли (ЗначениеЗаполнено(ТекущиеДанные.НоменклатураУстановленнаяКлиенту)
        ИЛИ ЗначениеЗаполнено(ТекущиеДанные.Склад) 
        ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументПолученияЗапчасти)
        ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДокументЗаказНаВнутреннееПотребление))
        И Не РолиДоступныСервер("ПолныеПрава") 
        //-- смарт:Подкин #909 17.02.2022 14:11:44
        Тогда
        Элементы.ЗаполняетсяИнженеромРазбитьСтрокуИнженер.Доступность = Ложь;
    Иначе
        Элементы.ЗаполняетсяИнженеромРазбитьСтрокуИнженер.Доступность = Истина;
    КонецЕсли;
    // --
	
	//Элементы.ЗаполняетсяИнженеромНоменклатура.ТолькоПросмотр = НЕ ТекущиеДанные.ЗапчастьОтКлиентаПринял;
	
КонецПроцедуры

