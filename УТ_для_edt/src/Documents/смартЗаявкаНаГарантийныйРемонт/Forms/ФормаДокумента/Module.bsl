	ЗаполняетсяСпециалистомПоПретензиям = Объект.ЗаполняетсяСпециалистомПоПретензиям;

	
	СтатусОтправлено = Перечисления.смартСтатусыПоГарантии.ОтправленоПоставщику;
	//++ смарт:ММ #044 224 20.07.2020
