&НаСервере
Процедура ДобавитьСтрокуСоСтатусомНаСервере(НомерПозиции, Статус)
	
	//++ смарт:ММ #025 137 24.03.2020 
	// Если в последней строке по НомеруПозиции не заполнен документ, то новая строка не добавляется, а меняется статус в последней
	// Исключение: если последняя строка со статусом "Нечем заменить", то документ всегда не заполнен и добвляется новая строка для нового статуса
	
	//++ 30.10.2020
	// Если последний статус ПолученоОтПоставщика и при этом в текущей строке установлен флаг ПрямаяПоставка,
	// то ДокументДвижения тоже может быть не заполнен и необхоидмо добавлять новую строку
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерПозиции", НомерПозиции);	
	НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
	
	ДобавитьНовуюСтроку = Истина;
	
	Если НайденныеСтроки.Количество() <> 0 Тогда
		ПоследняяСтрока = НайденныеСтроки[НайденныеСтроки.Количество() - 1];
		Если ПоследняяСтрока.Статус <> Перечисления.смартСтатусыПоГарантии.НечемЗаменить Тогда
			
			//++ смарт:ММ 31.10.2020
			ПроверятьНаличиеДокументаДвижения = Истина;
			Если ПоследняяСтрока.Статус = Перечисления.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика Тогда
				НайденныеСтрокиСпециалист = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
				Если НайденныеСтрокиСпециалист[0].ПрямаяПоставка Тогда
					ПроверятьНаличиеДокументаДвижения = Ложь;
				КонецЕсли;				
			КонецЕсли;
			
			Если ПроверятьНаличиеДокументаДвижения Тогда
			//-- смарт:ММ 31.10.2020
			
			Если НЕ ЗначениеЗаполнено(ПоследняяСтрока.ДокументДвижения) Тогда
				ДобавитьНовуюСтроку = Ложь;
				НоваяСтрокаСтатус = ПоследняяСтрока;
			КонецЕсли;
			
			//++ смарт:ММ 31.10.2020
			КонецЕсли;
			//-- смарт:ММ 31.10.2020
		КонецЕсли;
	КонецЕсли;	
	
	// ++ 16.08.2020
	// Если уже есть один из статусов ОтгрузкаНеТребуется ИЛИ ВГарантииОтказано, 
	// то просто заменить статус, новую строку со статусом не добавлять
	
	МассивСтатусовСписания = Новый Массив;
	МассивСтатусовСписания.Добавить(Перечисления.смартСтатусыПоГарантии.ОтгрузкаНеТребуется);
	МассивСтатусовСписания.Добавить(Перечисления.смартСтатусыПоГарантии.ВГарантииОтказано);
	
	Если МассивСтатусовСписания.Найти(Статус) <> Неопределено Тогда
		Для Каждого Строка Из НайденныеСтроки Цикл
			Если МассивСтатусовСписания.Найти(Строка.Статус) <> Неопределено Тогда
				ДобавитьНовуюСтроку = Ложь;
				НоваяСтрокаСтатус = Строка;
				Прервать;
			КонецЕсли;			
		КонецЦикла;
	КонецЕсли;
	
	// --
	
	Если ДобавитьНовуюСтроку Тогда	
		НоваяСтрокаСтатус = смартОбщегоНазначения.ПолучитьСтрокуСоСтатусом(Объект, НомерПозиции, Статус); 
	КонецЕсли;
	
	НоваяСтрокаСтатус.НомерПозиции 			= НомерПозиции;
	НоваяСтрокаСтатус.ДатаИзмененияСтатуса 	= ТекущаяДата();
	НоваяСтрокаСтатус.Статус 					= Статус;
	
КонецПроцедуры

