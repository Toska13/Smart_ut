//++ #1348 смарт: Фролов 02.05.2023 //Добавить предупреждение при создании Гар. заявки на основании Заявки на ремонт  
&НаСервере
Функция ПроверитьНаличиеГарантийныхЗаявок()
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	смартЗаявкаНаГарантийныйРемонт.Ссылка КАК ссылка
	                    |ИЗ
	                    |	Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	                    |ГДЕ
	                    |	смартЗаявкаНаГарантийныйРемонт.ДокументОснование = &ДокументОснование
	                    |	И НЕ смартЗаявкаНаГарантийныйРемонт.ПометкаУдаления");
	Запрос.УстановитьПараметр("ДокументОснование",Объект.ДокументОснование);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда 
		МассивДокументов=Новый Массив;
		Для Каждого Стр Из Рез Цикл
			МассивДокументов.Добавить(Стр.ссылка);			
		КонецЦикла;	
		Возврат МассивДокументов;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции //-- #1348 смарт: Фролов 02.05.2023

