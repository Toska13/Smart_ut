// ++ 21.11.2020
&НаКлиенте
Процедура ПоказатьПечатнуюФормуДокумента(ЗаказНаПеремещение)
	
	Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) 
		ИЛИ ТипЗнч(ЗаказНаПеремещение) <> Тип("ДокументСсылка.ЗаказНаПеремещение")
		Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = ПолучитьТабДокНаСервере(ЗаказНаПеремещение);
	СинонимМакета = "Заказ на перемещение №" + ПолучитьРеквизитОбъекта(ЗаказНаПеремещение, "Номер");
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ЗаказНаПеремещение");    
	КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
	КоллекцияПечатныхФорм[0].Экземпляров = 1;
	КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;
	КоллекцияПечатныхФорм[0].ИмяФайлаПечатнойФормы = СинонимМакета;
	
	ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма, СинонимМакета);
	
КонецПроцедуры

// ++ 21.11.2020
&НаСервереБезКонтекста
Функция ПолучитьТабДокНаСервере(ЗаказНаПеремещение)
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ЗаказНаПеремещение);
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ЗаказНаПеремещение);

	КоллекцияПечатныхФорм = ПодготовитьКоллекциюПечатныхФорм("ЗаказНаПеремещение");
	ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода(); 
	
	ОбъектыПечати = Новый СписокЗначений;
	ОбъектыПечати.Добавить(ЗаказНаПеремещение);
	
	ПараметрыПечати = Неопределено;
	
	УстановитьПривилегированныйРежим(Истина);
	Документы.ЗаказНаПеремещение.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат КоллекцияПечатныхФорм[0].ТабличныйДокумент; 
		
КонецФункции

