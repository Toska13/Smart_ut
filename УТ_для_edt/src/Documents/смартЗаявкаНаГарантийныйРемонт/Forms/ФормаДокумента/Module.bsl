	//-- #5824 смарт: Тимофеева 05.03.26
	
	// 08.04.2020
	// Доступность команды "Сдать на склад" - доступна, если есть пустые значения Заказ на перемещение в таблице инженера
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ЗаказНаПеремещениеЗапчастейСИнженера", Документы.ЗаказНаПеремещение.ПустаяСсылка());
	// 02.11.2020
	ПараметрыОтбора.Вставить("ЗапчастьОтКлиентаПринял", Истина);
	
	НайденныеСтроки = Объект.ЗаполняетсяИнженером.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Элементы.ЗаполняетсяИнженеромСдатьНаСклад.Доступность = Ложь;
	Иначе
		Элементы.ЗаполняетсяИнженеромСдатьНаСклад.Доступность = Истина;
	КонецЕсли;
	
	// ++ 14.10.2020
	// Доступность команды "Взять на складе" - доступна, если есть пустые значения НоменклатураУстановленнаяКлиенту
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("НоменклатураУстановленнаяКлиенту", Справочники.Номенклатура.ПустаяСсылка());
	
	НайденныеСтроки = Объект.ЗаполняетсяИнженером.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Элементы.ЗаполняетсяИнженеромВзятьНаСкладе.Доступность = Ложь;
	Иначе
		Элементы.ЗаполняетсяИнженеромВзятьНаСкладе.Доступность = Истина;
	КонецЕсли;
	//
	//06.11.2020
	//Элементы.Оборудование.Видимость = Не Объект.DOA;
	//Элементы.Серия.Видимость = Не Объект.DOA;
	
	// ++ 30.05.2021
	//Видимость = Ложь;
	//Если ЕстьПолныеПрава() ИЛИ РольДоступна("смартИзменениеДатыУстановкиЗапчастиКлиенту") Тогда //rnp 02.07.2021, пока что отказались от заполнения даты ответственным
		Видимость = Истина;
	//КонецЕсли;
	
	//++ #Б-3168 смарт: Лопато 06.05.2025 //Заявка на гарантийный ремонт. Дата установки запчасти клиенту.  
	// Отключил код
	//Элементы.ЗаполняетсяИнженеромДатаУстановкиЗапчастиКлиенту.Видимость = Видимость;
	//-- #Б-3168 смарт: Лопато 06.05.2025
	// --
	
	// ++ 30.06.2021
	// Если в левой части вкладки инженера заполнен документ получения запчасти (заказ на перемещение) во всех строках, то кнопка Проверить остатки должна быть не доступна
	ДоступностьПроверки = Ложь;

	Для Каждого ТекСтрока Из Объект.ЗаполняетсяИнженером Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДокументПолученияЗапчасти) Тогда
			ДоступностьПроверки = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Элементы.ЗаполняетсяИнженеромПроверитьОстаткиНаСкладах.Доступность = ДоступностьПроверки;
	// --
	
	//++ #1596 смарт: Мосолов 17.01.2024 //Доработка гарантийного блока / автозаполнение полей документ Заявка на гарантийный ремонт 
	Элементы.Поставщик.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ДокументПриобретения);
	Элементы.ДокументПриобретения.Видимость = ЗначениеЗаполнено(Объект.ДокументПриобретения);
	//-- #1596 смарт: Мосолов 17.01.2024 
	
	//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA
	Если Объект.DOA Тогда 
		
		Элементы.DOA.Видимость = Истина;
		Элементы.ЗаполняетсяИнженеромТипDOA.Видимость = Ложь;
		Элементы.ДекорацияDOA.Видимость = Ложь;  
		
	Иначе
		
		Элементы.DOA.Видимость = Ложь;
		Элементы.ЗаполняетсяИнженеромТипDOA.Видимость = Истина;
		Элементы.ДекорацияDOA.Видимость = Истина;
		
	КонецЕсли;  
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ЗаполняетсяИнженеромЗапчастьОтКлиентаПринял.Имя);
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ЗаполняетсяИнженером.ТипDOA");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Перечисления.смартТипыDOA.Недостача;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	//-- #1603 смарт: Мосолов 18.01.2024 
	
	//++ #1963 смарт: Мосолов 26.08.2024 //Доработка гарантийного блока / автозаполнение полей документ Заявка на гарантийный ремонт 
	Элементы.Поставщик.ТолькоПросмотр = Истина;
	Элементы.Префикс.ТолькоПросмотр = Истина;
	//++ #1852 смарт: Шляпников 15.01.2025 / Подбор документа поступления в Заявку на гарантийный ремонт. Доработка алгоритма.
	Элементы.ГруппаИзменениеДокументаПриобретения.Видимость = Ложь;
	//-- #1852 смарт: Шляпников 15.01.2025

	Если (Пользователи.ЭтоПолноправныйПользователь() 
		ИЛИ РольДоступна("смартСпециалистПоПретензиям")) 
		И (Объект.ЗаполняетсяИнженером.Количество() = 0
			И Объект.ЗаполняетсяСпециалистомПоПретензиям.Количество() = 0) Тогда
			
		Элементы.Поставщик.ТолькоПросмотр = Ложь;
		Элементы.Префикс.ТолькоПросмотр = Ложь;
		//++ #1852 смарт: Шляпников 15.01.2025 / Подбор документа поступления в Заявку на гарантийный ремонт. Доработка алгоритма.
		Элементы.ГруппаИзменениеДокументаПриобретения.Видимость = Истина;
		//-- #1852 смарт: Шляпников 15.01.2025
			
	КонецЕсли;
	//-- #1963 смарт: Мосолов 26.08.2024 
	
	//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
	Элементы.ЗаполняетсяИнженеромСписатьДеталь.Доступность = Ложь;
	Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("смартСпециалистПоПретензиям") ИЛИ РольДоступна("смартИнженер") Тогда
		
		//++ #Б-2024 смарт: Лопато 30.01.2025 //Заявка на гарантийный ремонт. Доработки.  
		ЕстьСтрокаДляСписания = Ложь;
		//-- #Б-2024 смарт: Лопато 30.01.2025
		
		Для каждого стрИнженер Из Объект.ЗаполняетсяИнженером Цикл
			
			Если ЗначениеЗаполнено(стрИнженер.НоменклатураУстановленнаяКлиенту)
				И ЗначениеЗаполнено(стрИнженер.Склад)
				И ( ЗначениеЗаполнено(стрИнженер.ДокументРазборки) ИЛИ ЗначениеЗаполнено(стрИнженер.ДокументПолученияЗапчасти) )
				И НЕ ЗначениеЗаполнено(стрИнженер.ДокументЗаказНаВнутреннееПотребление) Тогда
				
				//++ #Б-2024 смарт: Лопато 30.01.2025 //Заявка на гарантийный ремонт. Доработки.  
				ЕстьСтрокаДляСписания = Истина;
				//-- #Б-2024 смарт: Лопато 30.01.2025
				
			КонецЕсли;
			
		КонецЦикла;
		
		//++ #Б-2024 смарт: Лопато 30.01.2025 //Заявка на гарантийный ремонт. Доработки.  
		Если ЕстьСтрокаДляСписания Тогда
			Элементы.ЗаполняетсяИнженеромСписатьДеталь.Доступность = Истина;
		КонецЕсли;	
		//-- #Б-2024 смарт: Лопато 30.01.2025
		
	КонецЕсли;
	//-- #Б1610 смарт: Шляпников 09.12.2024
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНоменклатуруКлиента(Клиент)
	
	МассивНоменклатуры = Новый Массив;
		
	Если НЕ ЗначениеЗаполнено(Клиент) Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КлючиАналитикиУчетаПоПартнерам.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_КлючиАналитикиПартнеры
	|ИЗ
	|	Справочник.КлючиАналитикиУчетаПоПартнерам КАК КлючиАналитикиУчетаПоПартнерам
	|ГДЕ
	|	КлючиАналитикиУчетаПоПартнерам.Партнер = &Клиент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КлючиАналитикиУчетаНоменклатуры.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			АналитикаУчетаПоПартнерам В
	|				(ВЫБРАТЬ
	|					ВТ_КлючиАналитикиПартнеры.Ссылка
	|				ИЗ
	|					ВТ_КлючиАналитикиПартнеры КАК ВТ_КлючиАналитикиПартнеры)) КАК ВыручкаИСебестоимостьПродажОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|			ПО КлючиАналитикиУчетаНоменклатуры.Номенклатура = НоменклатураСпр.Ссылка
	|		ПО ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
	|ГДЕ
	|	НоменклатураСпр.ВидНоменклатуры = &ТоварПлоттерыСерии";
	
	ТоварПлоттерыСерии = Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение;
	
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("ТоварПлоттерыСерии", ТоварПлоттерыСерии);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура");
		
КонецФункции

&НаСервере
// ++ 21.11.2020
//Процедура СдатьНаСкладСервер()
Функция СдатьНаСкладСервер()
	
	ЗаказНаПеремещение = Неопределено;
	
	Если Модифицированность Тогда
		Записать();
	КонецЕсли;
	
	// 08.04.2020
	//Объект.ЗаказНаПеремещениеЗапчастейСИнженера = СоздатьДокументЗаказНаПеремещение();
	
	//Если ЗначениеЗаполнено(Объект.ЗаказНаПеремещениеЗапчастейСИнженера) И Объект.ЗаказНаПеремещениеЗапчастейСИнженера.Проведен Тогда
	//	СоздатьДокументПеремещениеТоваров();
	//КонецЕсли;
		
	// ++ 30.06.2021
	НачатьТранзакцию();
	Успех = Истина;
	// --
	
	// ++ 21.06.2020
	// Создание Ввода начальных остатков для строк, в которых не заполнена номенклатура, установленная клиенту
	НеобходимДокументВводОстатков = Ложь;
	ВводНачальныхОстатков = СоздатьДокументВводНачальныхОстатков(НеобходимДокументВводОстатков);
	
	// ++ 30.06.2021	
	Если Объект.СкладИнженера <> Объект.СкладГарантийныхЗапчастей Тогда
	// --
	Если (Не НеобходимДокументВводОстатков)
		ИЛИ (НеобходимДокументВводОстатков И ЗначениеЗаполнено(ВводНачальныхОстатков)) Тогда
	// --
		
		ЗаказНаПеремещение = СоздатьДокументЗаказНаПеремещение();
		Если ЗначениеЗаполнено(ЗаказНаПеремещение) И ЗаказНаПеремещение.Проведен Тогда
			ПеремещениеТоваров = СоздатьДокументПеремещениеТоваров(ЗаказНаПеремещение);
		КонецЕсли;
		
		// ++ 30.06.2021
		Если НЕ ЗначениеЗаполнено(ЗаказНаПеремещение) ИЛИ НЕ ЗначениеЗаполнено(ПеремещениеТоваров) 
			ИЛИ (ЗначениеЗаполнено(ЗаказНаПеремещение) И НЕ ЗаказНаПеремещение.Проведен)
			ИЛИ (ЗначениеЗаполнено(ПеремещениеТоваров) И НЕ ПеремещениеТоваров.Проведен)
			Тогда
			Успех = Ложь;
		Иначе
		// --
		Записать();
		// ++ 30.06.2021
		КонецЕсли;
		// --
		
	// ++ 21.06.2020
	КонецЕсли;
	// --

	// ++ 30.06.2021
	Иначе
		
		Если ЗначениеЗаполнено(ВводНачальныхОстатков) Тогда
			СтатусОжидаютсяДействия = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантии.ОжидаютсяДействия");
			
			Для Каждого СтрокаИнженер Из Объект.ЗаполняетсяИнженером Цикл
				
				Если СтрокаИнженер.ДокументВводОстатков <> ВводНачальныхОстатков Тогда
					Продолжить;
				КонецЕсли;
				
				ИДСтрокиЗаполняетсяИнженером = СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером;
				Отбор = Новый Структура;
				Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", ИДСтрокиЗаполняетсяИнженером);
				НайденныеСтроки = Объект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаСпециалист = НайденныеСтроки[0];
				НомерПозиции = СтрокаСпециалист.НомерПозиции;
				СтрокаСпециалист.Статус = СтатусОжидаютсяДействия;
				
				ДатаИзмененияСтатуса = ТекущаяДата();
				ДокументОприходования = ВводНачальныхОстатков;
				ДобавитьСтрокуСтатусаНаСервере(НомерПозиции, ДатаИзмененияСтатуса, СтатусОжидаютсяДействия, ДокументОприходования);
				
				Модифицированность = Истина;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	Если Успех Тогда
		ЗафиксироватьТранзакцию();
	Иначе 
		ОтменитьТранзакцию();
	КонецЕсли;
	// --
	
	НастроитьВидимостьДоступность();

	// ++ 21.11.2020
	Возврат ЗаказНаПеремещение;
	
КонецФункции

// ++ 21.06.2020
&НаСервере
Функция СоздатьДокументВводНачальныхОстатков(НеобходимДокументВводОстатков)
	
	// ++ 31.03.2021
	Если Объект.DOA И ТипЗнч(Объект.Контрагент) = Тип("СправочникСсылка.Склады") Тогда
		НеобходимДокументВводОстатков = Ложь;
		Возврат Неопределено;
	КонецЕсли;
	// --
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументВводОстатков = Документы.ВводОстатков.СоздатьДокумент();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВидыЗапасов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЗапасов КАК ВидыЗапасов
	|ГДЕ
	|	НЕ ВидыЗапасов.ПометкаУдаления
	|	И ВидыЗапасов.Организация = &Организация
	|	И ВидыЗапасов.ТипЗапасов = &ТипЗапасов";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипЗапасов", Перечисления.ТипыЗапасов.Товар);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВидЗапасов = Неопределено;
	Если Выборка.Следующий() Тогда
		ВидЗапасов = Выборка.Ссылка;
	КонецЕсли;
	
	// ++ 21.11.2020
	МассивСтрокДляКоторыхВведенВводОстатков = Новый Массив;
	// --
	
	// ++ 31.03.2021
	НастройкаВидЦены = Справочники.смартПредопределенныеЗначения.ВидЦеныДляОприходованияЗапчастейПринятыхОтКлиента;
	ВидЦеныДляОприходования = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(НастройкаВидЦены, Ложь);
	// --
	
	Для Каждого ТекСтрока Из Объект.ЗаполняетсяИнженером Цикл
		
		Если ЗначениеЗаполнено(ТекСтрока.ЗаказНаПеремещениеЗапчастейСИнженера) Тогда
			Продолжить;
		КонецЕсли;
		
		// ++ 31.03.2021
		//Если ЗначениеЗаполнено(ТекСтрока.НоменклатураУстановленнаяКлиенту) Тогда
		//	Продолжить;
		//КонецЕсли;
		// -- 31.03.2021
		
		Если НЕ ТекСтрока.ЗапчастьОтКлиентаПринял Тогда
			Продолжить;
		КонецЕсли;
		
		НеобходимДокументВводОстатков = Истина;
		
		НоваяСтрока = ДокументВводОстатков.Товары.Добавить();
		НоваяСтрока.Номенклатура = ТекСтрока.НоменклатураПринятаяОтКлиента;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.КоличествоУпаковок = ТекСтрока.Количество;
		НоваяСтрока.ВидЗапасов = ВидЗапасов;		
		//НоваяСтрока.АналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.НайтиПоНаименованию();
		
		//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
		НоваяСтрока.НомерГТД = Справочники.НомераГТД.смартГарантийнаяЗапчасть;
		//-- #Б1610 смарт: Шляпников 09.12.2024

		// ++ 21.11.2020
		МассивСтрокДляКоторыхВведенВводОстатков.Добавить(ТекСтрока);
		// --
		
		//// ОТЛАДКА
		//ДокументВводОстатковДата = ТекСтрока.ДатаУстановкиЗапчастиКлиенту;
		//// --
	КонецЦикла;
	
	Если ДокументВводОстатков.Товары.Количество() = 0 Тогда
		ДокументВводОстатков = Неопределено;
		Возврат Неопределено;
	КонецЕсли;
		
	ДокументВводОстатков.Партия = СоздатьПервичныйДокумент(ТекущаяДата());
	Если НЕ ЗначениеЗаполнено(ДокументВводОстатков.Партия) Тогда
		ДокументВводОстатков = Неопределено;
		ВОзврат Неопределено;
	КонецЕсли;
	
	ДокументВводОстатков.Организация 	= Объект.Организация;
	ДокументВводОстатков.ТипОперации 	= Перечисления.ТипыОперацийВводаОстатков.ОстаткиСобственныхТоваров;
	ДокументВводОстатков.Склад 			= Объект.СкладИнженера;
	ДокументВводОстатков.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументВводОстатков.Подразделение 	= Справочники.смартПредопределенныеЗначения.ПодразделениеПоЗаявкамНаГарантийныйРемонт.Значение;
	ДокументВводОстатков.ЦенаВключаетНДС 			= Истина;
	ДокументВводОстатков.ОтражатьВОперативномУчете 	= Истина;
	// ++ 02.12.2020
	//ДокументВводОстатков.ОтражатьСебестоимость 		= Ложь;
	ДокументВводОстатков.ОтражатьСебестоимость 		= Истина;
	// --
	ДокументВводОстатков.ВидДеятельностиНДС 		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		
	ДокументВводОстатков.Комментарий 	= ПолучитьТекстКомментарияКДокументу();

	ДокументВводОстатков.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДатаПроверки = ТекущаяДатаСеанса();
	Если РасчетСебестоимостиПовтИсп.ПартионныйУчетВерсии21(ДатаПроверки) Тогда
		ДокументВводОстатков.ВводОстатков22 = Истина;
	КонецЕсли;
    //++ #1287 смарт: Фролов 10.03.2023 //Работа с гарантийными и коммерческими запасными частями  
	ДокументВводОстатков.Основание=Объект.Ссылка;
	//-- #1287 смарт: Фролов 10.03.2023
	ДокументВводОстатков.Дата = ТекущаяДата();

	//++ #6294 смарт: Тимофеева 30.03.2026 /  Перевод запчастей на серийный учет. ЗГР. Не отображается серия в документе Ввод начальных остатков.
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(ДокументВводОстатков, Документы.ВводОстатков));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументВводОстатков, ПараметрыУказанияСерий);
	
	СерииПоУмолчаниюСоответствие = смартСервер.ПолучитьСерииПоУмолчаниюСоответствие();
	Для Каждого ТекСтрока Из ДокументВводОстатков.Товары Цикл
		Если ТекСтрока.СтатусУказанияСерий = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Номенклатура, "ВидНоменклатуры");
		СерияПоУмолчанию = СерииПоУмолчаниюСоответствие.Получить(ВидНоменклатуры);    
		
		Если НоменклатураКлиентСервер.ВЭтомСтатусеСерииУказываютсяВТЧТовары(ТекСтрока.СтатусУказанияСерий, ПараметрыУказанияСерий) Тогда
			ТекСтрока.Серия = СерияПоУмолчанию;	
		ИначеЕсли НоменклатураКлиентСервер.ВЭтомСтатусеСерииУказываютсяВТЧСерии(ТекСтрока.СтатусУказанияСерий, ПараметрыУказанияСерий) Тогда
			НоваяСтрокаСерии = ДокументВводОстатков.Серии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСерии, ТекСтрока);
			НоваяСтрокаСерии.Серия = СерияПоУмолчанию;
		КонецЕсли;
	КонецЦикла; 
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(ДокументВводОстатков, ПараметрыУказанияСерий);
	//-- #6294 смарт: Тимофеева 30.03.2026

	//// ОТЛАДКА
	//ДокументВводОстатков.Дата = ДокументВводОстатковДата;
	//
	////
	
	
	// ++ 31.03.2021
	СтавкаНДС_20 = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС20");
	ЦеныНоменклатуры = ПолучитьЦеныНоменклатуры(ДокументВводОстатков.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"), ВидЦеныДляОприходования, ТекущаяДата());
	ВалютаУправленческогоУчета = Константы.ВалютаУправленческогоУчета.Получить();
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	КоэффициентПересчетаИзВалютыУпрВРегл = КоэффициентПересчета(ВалютаУправленческогоУчета, ВалютаРегламентированногоУчета, ДокументВводОстатков.Дата);
	
	Для Каждого ТекСтрока Из ДокументВводОстатков.Товары Цикл
		
		//++ #6294 смарт: Тимофеева 30.03.2026 /  Перевод запчастей на серийный учет. ЗГР. Не отображается серия в документе Ввод начальных остатков.
		//ТекСтрока.СтавкаНДС = СтавкаНДС_20;
		СтавкаНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрока.Номенклатура, "СтавкаНДС");
		ТекСтрока.СтавкаНДС = ?(ЗначениеЗаполнено(СтавкаНДС), СтавкаНДС, Перечисления.СтавкиНДС.НДС22);
		//-- #6294 смарт: Тимофеева 30.03.2026
		ТекСтрока.Цена = ЦеныНоменклатуры.Получить(ТекСтрока.Номенклатура);
		
		Если ЗначениеЗаполнено(ТекСтрока.Цена) Тогда
			
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументВводОстатков);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьСумму");
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);		
			СтруктураДействий.Вставить("ПересчитатьСуммуБезНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСуммуРегл", КоэффициентПересчетаИзВалютыУпрВРегл);
			СтруктураДействий.Вставить("ПересчитатьНДСРегл", СтруктураПересчетаСуммы);
			
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекСтрока, СтруктураДействий, Неопределено);
			
		КонецЕсли;			
	КонецЦикла;	
	// -- 31.03.2021

	Попытка
		ДокументВводОстатков.Записать(РежимЗаписиДокумента.Проведение);
		
		// ++ 21.11.2020
		Для Каждого СтрокаИнженер Из МассивСтрокДляКоторыхВведенВводОстатков Цикл
			СтрокаИнженер.ДокументВводОстатков = ДокументВводОстатков.Ссылка;
		КонецЦикла;		
		// --

	Исключение
		СинонимДокумента = ДокументВводОстатков.Метаданные().Синоним;
		//ДокументВводОстатков.Записать(РежимЗаписиДокумента.Запись);
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		//|" + ОписаниеОшибки() + "
		//|Документ записан без проведения.");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ не создан.");
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументВводОстатков.Ссылка;
	
КонецФункции

// ++ 31.03.2021
&НаСервере
Функция ПолучитьЦеныНоменклатуры(МассивНоменклатуры, ВидЦеныДляОприходования, ДатаСведений)
	
	СоответствиеРезультат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаСреза,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура В (&МассивНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидЦены", 			ВидЦеныДляОприходования);
	Запрос.УстановитьПараметр("ДатаСреза", 			ДатаСведений);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СоответствиеРезультат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;

	Возврат СоответствиеРезультат;
	
КонецФункции

