	РезультатЗаписиДокумента = Ложь;
    ТестОошибкиЗаписиДокумента = "Не удалось записать Заявку на гарантийный ремонт! Проверьте заполнение реквизитов!";

	ОбОтчет = Справочники.смартОтчетПоГарантииМимаки.СоздатьЭлемент();
	ОбОтчет.УстановитьНовыйКод(ЭтаФорма.Префикс);

	НовыйКодОтчета = ОбОтчет.Код;
	СтруктураПрефиксНомер = смартОбщегоНазначения.РазбитьСтрокуНаПрефиксИНомер(НовыйКодОтчета);

	ЭтаФорма.ВнешнийНомер = СтруктураПрефиксНомер.Номер;
	ЭтаФорма.Элементы.ВнешнийНомер.ТолькоПросмотр=Истина; 
	
	НеПроверятьРеквизиты = Истина;
	
	Попытка
		РезультатЗаписиДокумента = Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	Исключение
		Сообщить(ТестОошибкиЗаписиДокумента);
		ОтменитьТранзакцию();	
		Возврат;                                                                                       
    КонецПопытки;

	НеПроверятьРеквизиты = Ложь;
	
	Если НЕ РезультатЗаписиДокумента Тогда
		Сообщить(ТестОошибкиЗаписиДокумента);
		ОтменитьТранзакцию();	
		Возврат;
	Иначе

		ОбОтчет.Наименование 	  = "Отчет по гарантии Мимаки (смарт) №"+ОбОтчет.Код+" от "+Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
		ОбОтчет.ДокументОснование = Объект.Ссылка;                             
		ОбОтчет.Серия 			  = Объект.Серия;	
		ОбОтчет.Оборудование 	  = Объект.Оборудование;
		
		Попытка		
			ОбОтчет.Записать();

			ЗафиксироватьТранзакцию();
			
			ЭтаФорма.ОтчетМимаки = ОбОтчет.Ссылка; 
		Исключение
			Сообщить("Не удалось записать ""Отчет по гарантии Мимаки"" с кодом: " + НовыйКодОтчета + "!");
			
			ОтменитьТранзакцию();	
			
			ЭтаФорма.ВнешнийНомер = ""; 
			ЭтаФорма.ОтчетМимаки = Неопределено; 
		КонецПопытки;
		
	КонецЕсли;	

	ЭтаФорма.Модифицированность = Истина; 
	//-- #1287 смарт: Лопато 20.06.2023
	
КонецПроцедуры //-- #1287 смарт: Фролов 24.04.2023	

