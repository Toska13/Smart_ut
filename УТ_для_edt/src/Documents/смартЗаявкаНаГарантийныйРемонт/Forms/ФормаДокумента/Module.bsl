&НаСервере
Функция СоздатьДокументСборкаТоваров(ЗаказНаСборку)
	
	Если НЕ ЗаказНаСборку.Проведен Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументСборка = Документы.СборкаТоваров.СоздатьДокумент();
	
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(ЗаказНаСборку);

	ДанныеЗаполнения = Новый Структура;
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "СборкаТоваров");
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	ДокументСборка.Заполнить(ДанныеЗаполнения);

	ДокументСборка.Дата = ТекущаяДата();
	ДокументСборка.Ответственный = Пользователи.ТекущийПользователь();
