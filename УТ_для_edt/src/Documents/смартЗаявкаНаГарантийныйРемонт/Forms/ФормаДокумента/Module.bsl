			Отбор = Новый Структура;
			Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", Стр.ИДСтрокиЗаполняетсяИнженером);
			НайденныеСтроки = ТЗ.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				Стр.ПредыдущееКоличество 	= НайденныеСтроки[0].ПредыдущееКоличество;
				Стр.ЗаполняетсяСписокСкладов = НайденныеСтроки[0].ЗаполняетсяСписокСкладов;
				Стр.СписокСкладовПустой 	= НайденныеСтроки[0].СписокСкладовПустой;
				Стр.СкладыСОстатками 		= НайденныеСтроки[0].СкладыСОстатками;
			КонецЕсли;
			
		КонецЦикла;
		
		ТЗ = Неопределено;
		// --
	КонецЕсли;
	
	// ++ 21.11.2020
	Возврат ЗаказНаПеремещение;
	
КонецФункции


// ++ 30.10.2020
&НаКлиенте
Процедура ЗаполняетсяСпециалистомПоПретензиямПрямаяПоставкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаполняетсяСпециалистомПоПретензиям.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.ПрямаяПоставка = Истина Тогда
			СтатусПолучения = ПредопределенноеЗначение("Перечисление.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление");
			Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СтатусПолучения) Тогда
				ТекущиеДанные.СтатусПолучения = СтатусПолучения;
				Отбор = Новый Структура;
				Отбор.Вставить("НомерПозиции", ТекущиеДанные.НомерПозиции);
				НайденныеСтроки = Объект.Статусы.НайтиСтроки(Отбор);
				ДобавитьСтрокуСтатусаНаСервере(ТекущиеДанные.НомерПозиции, ТекущаяДата(), СтатусПолучения);
			КонецЕсли;
		Иначе
			// ?Удалить последнюю строку, если статус Получено от поставщика и не заполнен документ движения
				
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

