&НаКлиенте
Процедура ВопросПередЗаписьюДокументаЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		Для Каждого СтрокаИнженер Из Объект.ЗаполняетсяИнженером Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаИнженер.Склад) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаИнженер.ДокументПолученияЗапчасти) Тогда
				СтрокаИнженер.Склад = Неопределено;	
			КонецЕсли;
		КонецЦикла;
		
		Записать();
 		
	Иначе

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ЗначениеЗаполнено(Префикс) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен префикс Поставщика!", Объект.Ссылка, "Префикс");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВнешнийНомер) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен номер документа!", Объект.Ссылка, "ВнешнийНомер");
	КонецЕсли;
	
	//++ смарт:ММ #044 224 16.11.2020 - Заявка на гарантийный ремонт
	Если НЕ Отказ И ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Отказ = НЕ ПроверитьЗаполнение();
	КонецЕсли;
	//-- смарт:ММ 16.11.2020
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийОбъект.Номер = Префикс + ВнешнийНомер;
	
	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		
		Отказ = ДокументНеобходимоПровести();
		
		// 03.06.2020
		//Если Отказ Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ необходимо провести, т.к. в табличной части присутствует статус ""Отправлено поставщику""!");
		//КонецЕсли;

	КонецЕсли;
	//++ #Б-6932 смарт: Фролов 25.05.2026 //Заявка на гарантийный ремонт. Права доступа к отчету Мимаки.
	//++ #1287 смарт: Фролов 24.04.2023 //Работа с гарантийными и коммерческими запасными частями  
	//++ #1287 смарт: Лопато 20.06.2023 //Работа с гарантийными и коммерческими запасными частями 	
	//++#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)
	// Закомментировал ниже
	// Если НЕ РольДоступна("ПолныеПрава") И НЕ НеПроверятьРеквизиты И ПоставщикМимаки() Тогда
	// Добавил ниже
	Если НЕ Пользователи.РолиДоступны("смартСпециалистПоПретензиям") И НЕ НеПроверятьРеквизиты И Мимаки_УсловияОбъектаВыполнены() Тогда
	//Если НЕ РольДоступна("ПолныеПрава") И НЕ НеПроверятьРеквизиты И Мимаки_УсловияОбъектаВыполнены() Тогда
	//--#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)
	//-- #1287 смарт: Лопато 20.06.2023
	//-- #Б-6932 смарт: Фролов 25.05.2026
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	смартОтчетПоГарантииМимаки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.смартОтчетПоГарантииМимаки КАК смартОтчетПоГарантииМимаки
		|ГДЕ
		|	смартОтчетПоГарантииМимаки.ДокументОснование = &ДокументОснование 
		//++ #1287 смарт: Лопато 20.06.2023 //Работа с гарантийными и коммерческими запасными частями  
		|	И НЕ смартОтчетПоГарантииМимаки.ДокументОснование = ЗНАЧЕНИЕ(Документ.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка)
		//-- #1287 смарт: Лопато 20.06.2023
		|	И НЕ смартОтчетПоГарантииМимаки.ПометкаУдаления"); 
		Запрос.УстановитьПараметр("ДокументОснование",Объект.ссылка);
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() ТОгда                                     
			ДокументОтчет=Выборка.ссылка;  
			Если (ДокументОтчет.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.HeadNozzle") 
				ИЛИ ДокументОтчет.ПричинаПоломки=ПредопределенноеЗначение("Перечисление.смартПричиныПоломки.PrintQuality")) И ДокументОтчет.Чернила.Количество()=0 Тогда
				Сообщить("Необходимо заполнить чернила в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.ДатаПроблемы) Тогда
				Сообщить("Необходимо заполнить дату проблемы в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.Оборудование) Тогда
				Сообщить("Необходимо заполнить оборудование в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.ОписаниеПроблемы) Тогда
				Сообщить("Необходимо заполнить описание проблемы в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.ОписаниеУстраненияПроблемы) Тогда
				Сообщить("Необходимо заполнить описание устранения проблемы в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.Серия) Тогда
				Сообщить("Необходимо заполнить серию в отчете МИМАКИ!");
				Отказ=Истина;
			КонецЕсли;
			НетФайлов=Ложь;
			Если НЕ ЗначениеЗаполнено(ДокументОтчет.ФотоОборудования) 
				ИЛИ НЕ ЗначениеЗаполнено(ДокументОтчет.ФотоШильдаОборудования) 
				ИЛИ НЕ ЗначениеЗаполнено(ДокументОтчет.ParametersПослеИнсталяции) Тогда 
				НетФайлов=Истина;
				Отказ=Истина;	
			КонецЕсли;	
			Если НЕ Лев(ДокументОтчет.Серия.Номер,2)="CG" Тогда
				Если НЕ ЗначениеЗаполнено(ДокументОтчет.LogПослеИнсталяции) Тогда 
					НетФайлов=Истина;
					Отказ=Истина;	
				КонецЕсли;
			КонецЕсли;
			Если НетФайлов ТОгда
				Сообщить("Не заполнены файлы в отчете МИМАКИ!");
			КонецЕсли;	
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		//++ #4410 смарт: Тимофеева 29.09.2025 / Заявка на гарантийный ремонт. Issue report.
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен отчет Мимаки", Объект.Ссылка, "ОтчетМимаки",, Отказ);	
		//-- #4410 смарт: Тимофеева 29.09.2025	
		КонецЕсли;
	КонецЕсли;
	//-- #1287 смарт: Фролов 24.04.2023
	
	//++ #Б-1498 смарт: Фролов 13.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
	Если Объект.Дата > Дата("20241219") Тогда
		
		Если НЕ Объект.Ссылка.Пустая() Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Ссылка КАК Ссылка,
			|	Наименование КАК Наименование
			|ИЗ
			|	Справочник.смартЗаявкаНаГарантийныйРемонтПрисоединенныеФайлы
			|ГДЕ
			|	ВладелецФайла = &ВладелецФайла
			|	И НазначениеФайла = ЗНАЧЕНИЕ(Перечисление.смартНазначенияФайлов.ПустаяСсылка)
			|	И НЕ ПометкаУдаления");
			Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				ОбщегоНазначения.СообщитьПользователю("У приложенного файла " + Выборка.Наименование + " не заполнено Назначение файла, запись документа не возможна!");
				Отказ = Истина;
				
			КонецЦикла;	
			
		КонецЕсли;
	
	КонецЕсли;
	//-- #Б-1498 смарт: Фролов 13.12.2024

	// ++ 16.12.2020
	Если НЕ Отказ Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("СтрокиИнженераГдеМенялосьКоличество", СтрокиИнженераГдеМенялосьКоличество);
	КонецЕсли;
	
	//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
	Если НЕ Отказ Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("СписатьТовар", СписатьТовар);
	КонецЕсли;
	//-- #Б1610 смарт: Шляпников 09.12.2024
	
КонецПроцедуры

