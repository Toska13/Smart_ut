		НоваяСтрока.ВариантОбеспечения 	= Перечисления.ВариантыОбеспечения.Отгрузить;
		//++ #6622 смарт: Тимофеева 28.05.2026 / Заявка на гарантийный ремонт. Изменение логики подстановки статья расходов.
		//НоваяСтрока.СтатьяРасходов 		= СтатьяРасходов;
		Если ТекСтрока.Статус = Перечисления.смартСтатусыПоГарантии.ОтгрузкаНеТребуется
			И ТекСтрока.РешениеПоставщика = Перечисления.смартРешенияПоставщика.WarrantyDenied 
			ИЛИ ТекСтрока.Статус = Перечисления.смартСтатусыПоГарантии.ВГарантииОтказано
			Тогда
			НоваяСтрока.СтатьяРасходов 		= СтатьяРасходовНекомпенсируемыеЗапчасти;
		Иначе
			НоваяСтрока.СтатьяРасходов 		= СтатьяРасходов;
		КонецЕсли;
		//-- #6622 смарт: Тимофеева 28.05.2026

		НоваяСтрока.АналитикаРасходов 	= Аналитика;
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = Номер;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
		//-- #Б1132 смарт: Шляпников 14.10.2024

	КонецЕсли;
	
	Попытка
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументЗаказ.Ссылка, ДокументЗаказ.Ссылка);
	Исключение
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
		СинонимДокумента = ДокументЗаказ.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки() + "
			|Документ записан без проведения.", ДокументЗаказ.Ссылка);
	КонецПопытки;
	
	Возврат ДокументЗаказ.Ссылка;
	
КонецФункции

Функция СоздатьДокументВнутреннееПотребление(ЗаказНаВнутреннееПотребление = Неопределено, Проводить = Истина, ДатаДокумента = Неопределено, НомерПозиции = Неопределено)
	
	Если ЗаказНаВнутреннееПотребление = Неопределено Тогда
		
		СтатьяРасходов 	= Справочники.смартПредопределенныеЗначения.СтатьяРасходовПоЗаявкамНаГарантийныйРемонт.Значение;
		//++ смарт:ММ 25.10.2020
		//Аналитика 		= Справочники.смартПредопределенныеЗначения.АналитикаПоЗаявкамНаГарантийныйРемонт.Значение;
		Аналитика = Оборудование;
		//-- смарт:ММ 25.10.2020
		Подразделение 	= Справочники.смартПредопределенныеЗначения.ПодразделениеПоЗаявкамНаГарантийныйРемонт.Значение;
	
		// Создание документа вручную
		ДокументВнутреннееПотребление = Документы.ВнутреннееПотреблениеТоваров.СоздатьДокумент();
		
		ДокументВнутреннееПотребление.Дата 				= ДатаДокумента;
		ДокументВнутреннееПотребление.Организация 		= Организация;
		ДокументВнутреннееПотребление.Склад 			= СкладГарантийныхЗапчастей;
		ДокументВнутреннееПотребление.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
		ДокументВнутреннееПотребление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию; // Синоним = Списание на расходы
		ДокументВнутреннееПотребление.Подразделение 	= Подразделение;
		ДокументВнутреннееПотребление.ДатаРаспоряжения  = ДатаДокумента;
		
		ДокументВнутреннееПотребление.Комментарий 		= ПолучитьТекстКомментарияКДокументу();
		
		//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
		ДокументВнутреннееПотребление.смартЗапчастиГарантийные = Истина;
		//-- #Б1376 смарт: Шляпников 19.11.2024
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);
		
		НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(ПараметрыПоиска);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекСтрока = НайденныеСтроки[0];
			
			НоваяСтрока = ДокументВнутреннееПотребление.Товары.Добавить();
			НоваяСтрока.Количество 			= ТекСтрока.Количество;
			НоваяСтрока.КоличествоУпаковок	= ТекСтрока.Количество;
			НоваяСтрока.Номенклатура 		= ТекСтрока.Номенклатура;
			НоваяСтрока.СтатьяРасходов 		= СтатьяРасходов;
			НоваяСтрока.АналитикаРасходов 	= Аналитика;
			//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = Номер;
			НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
			//-- #Б1132 смарт: Шляпников 14.10.2024
		КонецЕсли;
	
	Иначе
		
		// Создание документа на основании Заказа на внутреннее потребление
		
		Если НЕ ЗначениеЗаполнено(ЗаказНаВнутреннееПотребление) 
			ИЛИ НЕ ЗаказНаВнутреннееПотребление.Проведен Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДокументВнутреннееПотребление = Документы.ВнутреннееПотреблениеТоваров.СоздатьДокумент();
		
		МассивЗаказов = Новый Массив;
		МассивЗаказов.Добавить(ЗаказНаВнутреннееПотребление);
		
		ДанныеЗаполнения = Новый Структура;
		ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "ВнутреннееПотреблениеТоваров");
		ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
		
		ДокументВнутреннееПотребление.Заполнить(ДанныеЗаполнения);
		
		ДокументВнутреннееПотребление.Дата 			= ЗаказНаВнутреннееПотребление.Дата;
		ДокументВнутреннееПотребление.Комментарий 	= ПолучитьТекстКомментарияКДокументу();
		//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
		ДокументВнутреннееПотребление.смартЗапчастиГарантийные = Истина;
		//-- #Б1376 смарт: Шляпников 19.11.2024
		
		Для Каждого Строка Из ДокументВнутреннееПотребление.Товары Цикл
			//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Строка.смартНомерЗаявкиНаГарантийныйРемонт = Номер;
			Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
			//-- #Б1132 смарт: Шляпников 14.10.2024
		КонецЦикла;
		
	КонецЕсли;

	Если Проводить Тогда
		
		Попытка
			ДокументВнутреннееПотребление.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументВнутреннееПотребление.Ссылка, ДокументВнутреннееПотребление.Ссылка);
		Исключение
			ДокументВнутреннееПотребление.Записать(РежимЗаписиДокумента.Запись);
			СинонимДокумента = ДокументВнутреннееПотребление.Метаданные().Синоним;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки() + "
			|Документ записан без проведения.", ДокументВнутреннееПотребление.Ссылка);
		КонецПопытки;
		
	Иначе
		Попытка 
			ДокументВнутреннееПотребление.Записать(РежимЗаписиДокумента.Запись);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и записан (без проведения) документ " + ДокументВнутреннееПотребление.Ссылка, ДокументВнутреннееПотребление.Ссылка);
		Исключение
			СинонимДокумента = ДокументВнутреннееПотребление.Метаданные().Синоним;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки() + "
			|Документ не создан.");
		КонецПопытки;
	
	КонецЕсли;

	
	Возврат ДокументВнутреннееПотребление.Ссылка;
	
КонецФункции

Функция СоздатьДокументВводНачальныхОстатков(НомерПозиции)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);

	НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда	
		
		ТекСтрока = НайденныеСтроки[0];
		
		Если ТекСтрока.СуммаКомпенсации = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	
	ДокументВводНО = Документы.ВводОстатков.СоздатьДокумент();
	
	ДокументВводНО.Организация 		= Организация;
	ДокументВводНО.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументВводНО.ТипОперации 		= Перечисления.ТипыОперацийВводаОстатков.ОстаткиПоАвансамПоставщикам;
	ДокументВводНО.ОтражатьВОперативномУчете = Истина;
	ДокументВводНО.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокументВводНО.ЦенаВключаетНДС 	= Истина;
	ДокументВводНО.ВидЦенностиНДС 	= Перечисления.ВидыЦенностей.Товары;
	 	
	ДокументВводНО.Дата 			= ТекущаяДата();
	ДокументВводНО.Комментарий 		= ПолучитьТекстКомментарияКДокументу();

	// ++ 02.12.2020
	ДокументВводНО.ОтражатьСебестоимость = Истина;
	// --
	
	ВалютаРегламентированногоУчета 	= Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУправленческогоУчета 		= Константы.ВалютаУправленческогоУчета.Получить();
	
	КонтрагентИзСтроки = ТекСтрока.Контрагент;
	
	ДокументВводНО.Контрагент = КонтрагентИзСтроки;
	
	ДокументВводНО.Валюта = ТекСтрока.ВалютаКомпенсации;
	
	НоваяСтрока = ДокументВводНО.РасчетыСПартнерами.Добавить();
	НоваяСтрока.Партнер 				= Поставщик;
	НоваяСтрока.Контрагент 				= КонтрагентИзСтроки;
	НоваяСтрока.ВалютаВзаиморасчетов 	= ТекСтрока.ВалютаКомпенсации;
	НоваяСтрока.Сумма	 				= ТекСтрока.СуммаКомпенсации;
	
	
	РасчитанныеСуммы = РассчитатьСуммы(
			НоваяСтрока.Сумма,
			НоваяСтрока.ВалютаВзаиморасчетов,
			ВалютаРегламентированногоУчета,
			ВалютаУправленческогоУчета,
			ДокументВводНО.Дата);
	
	НоваяСтрока.СуммаРегл = РасчитанныеСуммы.СуммаРегл;
	НоваяСтрока.СуммаУпр = РасчитанныеСуммы.СуммаУпр;
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("Сумма", 		НоваяСтрока.Сумма);
	ДанныеСтроки.Вставить("Валюта", 	НоваяСтрока.ВалютаВзаиморасчетов);
	ДанныеСтроки.Вставить("СуммаРегл", 	НоваяСтрока.СуммаРегл);
	ДанныеСтроки.Вставить("Партнер", 	НоваяСтрока.Партнер);
	ДанныеСтроки.Вставить("Контрагент", НоваяСтрока.Контрагент);
	
	НоваяСтрока.ОбъектРасчетов 		= СоздатьДокументОплатаПоставщику(ДанныеСтроки);
	НоваяСтрока.ДокументРасчетов 	= НоваяСтрока.ОбъектРасчетов;
	
	СинонимДокумента = ДокументВводНО.Метаданные().Синоним;

	Попытка
		ДокументВводНО.Записать();//РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументВводНО.Ссылка, ДокументВводНО.Ссылка);
	Исключение
		Попытка
			ДокументВводНО.Записать(РежимЗаписиДокумента.Запись);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
				|" + ОписаниеОшибки() + "
				|Документ записан без проведения.", ДокументВводНО.Ссылка);

		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
				|" + ОписаниеОшибки()); 
		КонецПопытки;
	КонецПопытки;
	
	Возврат ДокументВводНО.Ссылка;
	
КонецФункции

// 11.08.2020
Функция СоздатьДокументВводНачальныхОстатковОтказГарантии(НомерПозиции)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);

	НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда	
		
		ТекСтрока = НайденныеСтроки[0];
				
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	ДокументВводОстатков = Документы.ВводОстатков.СоздатьДокумент();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВидыЗапасов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЗапасов КАК ВидыЗапасов
	|ГДЕ
	|	НЕ ВидыЗапасов.ПометкаУдаления
	|	И ВидыЗапасов.Организация = &Организация
	|	И ВидыЗапасов.ТипЗапасов = &ТипЗапасов";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ТипЗапасов", Перечисления.ТипыЗапасов.Товар);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВидЗапасов = Неопределено;
	Если Выборка.Следующий() Тогда
		ВидЗапасов = Выборка.Ссылка;
	КонецЕсли;

	ДокументВводОстатков.Организация 	= Организация;
	ДокументВводОстатков.ТипОперации 	= Перечисления.ТипыОперацийВводаОстатков.ОстаткиСобственныхТоваров;
	ДокументВводОстатков.Склад 			= СкладИнженера;
	ДокументВводОстатков.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументВводОстатков.Подразделение 	= Справочники.смартПредопределенныеЗначения.ПодразделениеПоЗаявкамНаГарантийныйРемонт.Значение;
	ДокументВводОстатков.ЦенаВключаетНДС 			= Истина;
	ДокументВводОстатков.ОтражатьВОперативномУчете 	= Истина;
	ДокументВводОстатков.ВидДеятельностиНДС 		= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	// ++ 29.08.2020
	ДокументВводОстатков.ОтражатьСебестоимость 		= Истина;

	ВалютаРегл = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУпр = Константы.ВалютаУправленческогоУчета.Получить();
	
	
	НоваяСтрока = ДокументВводОстатков.Товары.Добавить();
	НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
	НоваяСтрока.Количество = ТекСтрока.Количество;
	НоваяСтрока.КоличествоУпаковок = ТекСтрока.Количество;
	НоваяСтрока.ВидЗапасов = ВидЗапасов;
	// ++ 29.08.2020
	НоваяСтрока.СтавкаНДС = ТекСтрока.Номенклатура.СтавкаНДС;
	//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
	НоваяСтрока.НомерГТД = Справочники.НомераГТД.смартГарантийнаяЗапчасть;
	//-- #Б1610 смарт: Шляпников 09.12.2024
	
	// Ватащить из возврата поставщику, по какой себестоимости прошло расходное движение этой запчасти
	НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПустаяСсылка(); // Вытянется из Возврата товаров поставщику. Наверно, должно подойти
	Цена = ПолучитьСебестоимостьЗапчастиИзВозвратаПоставщику(НомерПозиции, НалогообложениеНДС, ТекСтрока.Номенклатура);
	
	ДокументВводОстатков.НалогообложениеНДС = НалогообложениеНДС;
	
	НоваяСтрока.Цена = Цена;
	
	// Пересчет строки (скопированы типовые функции, которые вызываются при изменении колонки Цена в документе ВводОстатков)
	#Область ПересчетСтроки
	
	Если Цена <> 0 Тогда
		КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		
		СтруктураПересчетаСуммы = Новый Структура;
		СтруктураПересчетаСуммы.Вставить("ЦенаВключаетНДС", ДокументВводОстатков.ЦенаВключаетНДС);
		СтруктураПересчетаСуммы.Вставить("НалогообложениеНДС", ДокументВводОстатков.НалогообложениеНДС);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураПараметровДействия = Ложь;
		
		Если СтруктураДействий.Свойство("ПересчитатьСуммуНДС", СтруктураПараметровДействия) Тогда
			
			НалогообложениеНДС = Неопределено;
			СтруктураПараметровДействия.Свойство("НалогообложениеНДС", НалогообложениеНДС);
			
			НоваяСтрока.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
				НоваяСтрока.Сумма,
				УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС),
				СтруктураПараметровДействия.ЦенаВключаетНДС,
				НалогообложениеНДС);
		КонецЕсли;
		
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСНДСВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		Если Не ДокументВводОстатков.ЦенаВключаетНДС Тогда
			НоваяСтрока.СуммаБезНДС = НоваяСтрока.Сумма;
		Иначе
			СтруктураДействий.Вставить("ПересчитатьСуммуБезНДС", СтруктураПересчетаСуммы);
		КонецЕсли;
		
		КоэффициентПересчетаИзВалютыУпрВРегл = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(ВалютаУпр, ВалютаРегл, ТекущаяДата());
		
		СтруктураДействий.Вставить("ПересчитатьСуммуРегл", КоэффициентПересчетаИзВалютыУпрВРегл);
		СтруктураДействий.Вставить("ПересчитатьНДСРегл", СтруктураПересчетаСуммы);
		
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуРеглВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьНДСРеглВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;	
	#КонецОбласти
	// --
	
	//НоваяСтрока.АналитикаУчетаНоменклатуры = Справочники.КлючиАналитикиУчетаНоменклатуры.НайтиПоНаименованию();
		
	Если ДокументВводОстатков.Товары.Количество() = 0 Тогда
		ДокументВводОстатков = Неопределено;
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументВводОстатков.Партия = СоздатьПервичныйДокумент();
	Если НЕ ЗначениеЗаполнено(ДокументВводОстатков.Партия) Тогда
		ДокументВводОстатков = Неопределено;
		ВОзврат Неопределено;
	КонецЕсли;		
		
	ДокументВводОстатков.Комментарий 	= ПолучитьТекстКомментарияКДокументу();
	ДокументВводОстатков.Валюта = ВалютаРегл;
	
	ДатаПроверки = ТекущаяДатаСеанса();
	Если РасчетСебестоимостиПовтИсп.ПартионныйУчетВерсии21(ДатаПроверки) Тогда
		ДокументВводОстатков.ВводОстатков22 = Истина;
	КонецЕсли;

	ДокументВводОстатков.Дата = ТекущаяДата();
	
	Попытка
		ДокументВводОстатков.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументВводОстатков.Ссылка, ДокументВводОстатков.Ссылка);
	Исключение
		СинонимДокумента = ДокументВводОстатков.Метаданные().Синоним;
		//ДокументВводОстатков.Записать(РежимЗаписиДокумента.Запись);
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		//|" + ОписаниеОшибки() + "
		//|Документ записан без проведения.");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ не создан.");
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДокументВводОстатков.Ссылка;
	
КонецФункции

