	СтандартнаяОбработка = Ложь;  
	
	Префикс = ПолучитьПрефиксНомераДокумента(Оборудование.Производитель, Поставщик);;
	ВнешнийНомер = Прав(ДокументОснование.Номер, 6);
	Номер = Префикс + ВнешнийНомер; 
	
