			ЕстьDOA = Истина;
			
			//++ #Б-7016 смарт: Фролов 16.06.2026 //Заявка на гарантийный ремонт. Ошибки в использовании
			Если СтрокаИнженер.ТипDOA = Перечисления.смартТипыDOA.Недостача Тогда
				
				НоменклатураНедостачи = СтрокаИнженер.НоменклатураПринятаяОтКлиента;
				
				Для Каждого СтрЗаполняетсяСпециалистомПоПретензиям Из ЗаполняетсяСпециалистомПоПретензиям Цикл
					
					Если СтрЗаполняетсяСпециалистомПоПретензиям.Номенклатура = НоменклатураНедостачи 
