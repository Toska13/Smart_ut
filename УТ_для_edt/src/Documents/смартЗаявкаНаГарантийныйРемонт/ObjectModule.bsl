	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы")
	//-- #1596 смарт: Мосолов 17.01.2024
		
		  ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда
	//--#1211 смарт: Лопато 19.10.2022
	
		//++ смарт:ММ 591 13.08.2021
		ДокументОснование = ДанныеЗаполнения;
		//-- смарт:ММ 13.08.2021
		
		Организация 	= ДанныеЗаполнения.Организация;
		Ответственный 	= Пользователи.ТекущийПользователь();
		Статус 			= Перечисления.СтатусыКассовойСмены.Открыта;
		Контрагент 		= ДанныеЗаполнения.Контрагент;
		Клиент 			= ДанныеЗаполнения.Партнер;
		
		Если ДанныеЗаполнения.Оборудование.Количество() > 0 Тогда
			
			СтрокаОборудование = ДанныеЗаполнения.Оборудование[0];
			Оборудование = СтрокаОборудование.Оборудование;
			Серия = СтрокаОборудование.Серия; 
			
			//++ #1596 смарт: Мосолов 17.01.2024 //Доработка гарантийного блока / автозаполнение полей документ Заявка на гарантийный ремонт  
			
			Если Не ЗначениеЗаполнено(Оборудование) ИЛИ НЕ ЗначениеЗаполнено(Оборудование.Производитель) Тогда
				ВызватьИсключение "У номенклатуры " + Оборудование + " не указан производитель!
					|Ввод заявки на гарантийный ремонт на основании невозможен";  
			КонецЕсли;
			
			СкладГарантийныхЗапчастей = Справочники.смартПредопределенныеЗначения.СкладГарантийныхЗапчастейПоУмолчанию.Значение; 
			ДокументПриобретения = НайтиДокументПриобретения(Оборудование, Серия);
			Поставщик = ?(ЗначениеЗаполнено(ДокументПриобретения), ДокументПриобретения.Партнер, ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"));
			УстановитьНовыйНомер(); 
			
			Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда
				ДатаЗаявки = СтрокаОборудование.ДатаПодписанияАктаНаПНР; 
			ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
				ДатаЗаявки = Макс(ДанныеЗаполнения.НазначеннаяДатаРемонтаПо, ДанныеЗаполнения.НазначеннаяДатаРемонтаПо2); 
			КонецЕсли;
			
			//-- #1596 смарт: Мосолов 17.01.2024

			Если ЗначениеЗаполнено(Серия) Тогда
				ДанныеПоСерии = ПолучитьДанныеПоСерии(Серия);
				
				Если ЗначениеЗаполнено(ДанныеПоСерии.Номенклатура) Тогда
					Оборудование = ДанныеПоСерии.Номенклатура;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДанныеПоСерии.Контрагент) Тогда
					Контрагент = ДанныеПоСерии.Контрагент;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДанныеПоСерии.Партнер) Тогда
					Клиент = ДанныеПоСерии.Партнер;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

	//-- смарт:ММ 28.02.2021	
	КонецЕсли;

КонецПроцедуры
	
