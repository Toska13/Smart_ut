		|ГДЕ
		|	Контрагенты.Партнер = &Партнер
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		//-- #4050 смарт: Тимофеева 19.08.2025
		
		Запрос.УстановитьПараметр("НаименованиеПоставщика", Поставщик.Наименование);
		Запрос.УстановитьПараметр("Партнер", Поставщик);
				
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда			
			Возврат Выборка.Ссылка;
		КонецЕсли;;
				
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

// 15.12.2020
Процедура ОтправитьУведомлениеОбИзмененииКоличестваВТаблицеИнженера(Запчасти)
	
	ИмяСобытияЖР = "смартОтправкаУведомленияОбИзмененииКоличестваВТаблицеИнженера";
	
	АдресаДляОтправкиСтрокой = "";
	
	СсылкаПредопределнноеЗначение = Справочники.смартПредопределенныеЗначения.АдресаДляУведомленийОбОтменеОтправкиГарантийныхЗапчастей;
	
	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(СсылкаПредопределнноеЗначение, АдресаДляОтправкиСтрокой, Истина);

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И (МассивАдресовДляОтправки.Количество() > 0 ИЛИ НЕ смартОбщегоНазначения.смартРабочаяБаза()) Тогда
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
	
		ТемаПисьма = "Заявка на гарантийный ремонт №" + Номер;
		
		ТекстЗапчасти = "";
		
		Для Каждого Запчасть Из Запчасти Цикл
			ТекстЗапчасти = ТекстЗапчасти + ?(ЗначениеЗаполнено(ТекстЗапчасти), ", ", "") + Запчасть + " артикул " + Запчасть.Артикул;
		КонецЦикла;
		
		ТекстПисьма = "В заявке №" + Номер + " на вкладке ""Заполняется инженером"" изменено количество по запчасти " + ТекстЗапчасти + ". Изменение внес пользователь " + ПараметрыСеанса.ТекущийПользователь;
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление об изменении количества в заявке на гарантийный ремонт №" + Номер + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);	
			Иначе
				ТекстСообщения = "Отправлено уведомление об изменении количества в заявке на гарантийный ремонт №" + Номер + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			
		Исключение
			ТекстСообщения = "Не удалось отправить уведомление об изменении количества в заявке на гарантийный ремонт №" + Номер + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации(ИмяСобытияЖР, УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецЕсли; 
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,Ссылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// 28.02.2021
Функция ПолучитьДанныеПоСерии(мСерия) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	СтруктураВозврата.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	СтруктураВозврата.Вставить("Партнер", Справочники.Партнеры.ПустаяСсылка());
	
	Если НЕ ЗначениеЗаполнено(мСерия) Тогда
		Возврат СтруктураВозврата;
	КонецЕсли;
	
	ТекстЗапроса =
	//смарт rnp 25.03.2021 изменен текст запроса, т.к. не попадает в выборку расходный ордер по реализации, а именно он является последним движением при сложной схеме (реалиация-сборка-отгрузка)
	//"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	//|	ДвиженияСерийТоваров.Номенклатура КАК Номенклатура,
	//|	ВЫБОР
	//|		КОГДА ДвиженияСерийТоваров.Получатель ССЫЛКА Справочник.Склады
	//|			ТОГДА ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	//|		КОГДА ДвиженияСерийТоваров.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	//|			ТОГДА РеализацияТоваровУслуг.Партнер
	//|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	//|	КОНЕЦ КАК Партнер,
	//|	ВЫБОР
	//|		КОГДА ДвиженияСерийТоваров.Получатель ССЫЛКА Справочник.Склады
	//|			ТОГДА ДвиженияСерийТоваров.Получатель
	//|		КОГДА ДвиженияСерийТоваров.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	//|			ТОГДА РеализацияТоваровУслуг.Контрагент
	//|		ИНАЧЕ ДвиженияСерийТоваров.Получатель
	//|	КОНЕЦ КАК Контрагент
	//|ИЗ
	//|	РегистрНакопления.ДвиженияСерийТоваров КАК ДвиженияСерийТоваров
	//|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//|		ПО ((ВЫРАЗИТЬ(ДвиженияСерийТоваров.Регистратор КАК Документ.РеализацияТоваровУслуг)) = РеализацияТоваровУслуг.Ссылка)
	//|ГДЕ
	//|	ДвиженияСерийТоваров.Серия = &Серия
	//|	И ВЫБОР
	//|			КОГДА ДвиженияСерийТоваров.Получатель ССЫЛКА Справочник.Склады
	//|				ТОГДА ИСТИНА
	//|			КОГДА ДвиженияСерийТоваров.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	//|				ТОГДА ИСТИНА
	//|			ИНАЧЕ ЛОЖЬ
	//|		КОНЕЦ
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	ДвиженияСерийТоваров.Период УБЫВ";
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ДвиженияСерийТоваров.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ДвиженияСерийТоваров.Получатель ССЫЛКА Справочник.Партнеры
	|			ТОГДА ДвиженияСерийТоваров.Получатель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|	КОНЕЦ КАК Партнер,
	|	ВЫБОР
	|		КОГДА РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение ССЫЛКА Документ.ЗаказКлиента
	|			ТОГДА РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение.Контрагент
	|		ИНАЧЕ ДвиженияСерийТоваров.Получатель
	|	КОНЕЦ КАК Контрагент,
	|	ДвиженияСерийТоваров.Период КАК Период,
	|	ДвиженияСерийТоваров.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ДвиженияСерийТоваров КАК ДвиженияСерийТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ПО ДвиженияСерийТоваров.Регистратор = РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	|			И ДвиженияСерийТоваров.Документ = РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка
	|			И ДвиженияСерийТоваров.Серия = РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Серия
	|ГДЕ
	|	ДвиженияСерийТоваров.Серия = &Серия
	|	И ДвиженияСерийТоваров.ЭтоСкладскоеДвижение И НЕ ДвиженияСерийТоваров.Регистратор ССЫЛКА Документ.ПередачаТоваровМеждуОрганизациями
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДвиженияСерийТоваров.Период УБЫВ";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
		
	Запрос.УстановитьПараметр("Серия", мСерия);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда		
		Возврат СтруктураВозврата;		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураВозврата, Выборка);
	
	Возврат СтруктураВозврата;
			
КонецФункции

//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт 
Функция СоздатьДокументРасходныйОрдер(ЗаказНаВнутреннееПотребление)
	
	Если НЕ ЗначениеЗаполнено(ЗаказНаВнутреннееПотребление) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	РаспоряженияНаОтгрузку = Новый Массив;
	РаспоряженияНаОтгрузку.Добавить(ЗаказНаВнутреннееПотребление);
	
	СтруктураПараметровСозданияРасходныхОрдеров = СкладыСервер.ПараметрыПереоформленияРасходныхОрдеров();
	СтруктураПараметровСозданияРасходныхОрдеров.Склад = СкладИнженера;
	
	СтруктураПараметровСозданияРасходныхОрдеров.Получатель = ЗаказНаВнутреннееПотребление.Подразделение;
	СтруктураПараметровСозданияРасходныхОрдеров.РаспоряженияНаОтгрузку = РаспоряженияНаОтгрузку;
	
	Ордера = СкладыСервер.ПереоформитьРасходныеОрдера(СтруктураПараметровСозданияРасходныхОрдеров);
	
	// ++ 09.08.2021
	ДействиеОтгрузить = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
	ДействиеОтобрать = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отобрать;
	// --
	
	Для Каждого СтрокаДок Из Ордера.ОформленныеОрдера Цикл
		
		Если ТипЗнч(СтрокаДок.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			
			РасходныеОрдерОбъект = СтрокаДок.РасходныйОрдер.ПолучитьОбъект();
			
			Для Каждого ЗаполняемаяСтрокаТовар Из РасходныеОрдерОбъект.ТоварыПоРаспоряжениям Цикл								
				//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
				//ЗаполняемаяСтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонт = Номер;
				ЗаполняемаяСтрокаТовар.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
				//-- #Б1132 смарт: Шляпников 14.10.2024
			КонецЦикла;
			
			//++ #Б-7016 смарт: Фролов 16.06.2026 //Заявка на гарантийный ремонт. Ошибки в использовании
			//Комментарий = ПолучитьТекстКомментарияКДокументу();
			//-- #Б-7016 смарт: Фролов 16.06.2026
			
			// ++ 09.08.2021			
			РасходныеОрдерОбъект.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен;
			
			Для Каждого ТекСтр Из РасходныеОрдерОбъект.ОтгружаемыеТовары Цикл
				ТекСтр.Действие = ДействиеОтгрузить;
			КонецЦикла;			
			// --
			
			//++ #Б-7016 смарт: Фролов 16.06.2026 //Заявка на гарантийный ремонт. Ошибки в использовании
			//РасходныеОрдерОбъект.Комментарий = Комментарий;
			РасходныеОрдерОбъект.Комментарий = ПолучитьТекстКомментарияКДокументу();
			//-- #Б-7016 смарт: Фролов 16.06.2026
			
			//++ #6428 смарт: Тимофеева 09.04.2026 / Ошибка в формировании пакета документов на списание запчастей в ГЗ
			РасходныеОрдерОбъект.ДополнительныеСвойства.Вставить("смартПроверятьНаличиеРолиВзятиеРасходногоОрдераВРаботу", Ложь);
            //-- #6428 смарт: Тимофеева 09.04.2026
			Попытка
				//++ #6354 смарт: Тимофеева 06.04.2026 / Перевод запчастей на серийный учет. ЗГР. Ошибочное автоматическое заполнение регистров расходного ордера.
				//РасходныеОрдерОбъект.Записать();
				РасходныеОрдерОбъект.Записать(РежимЗаписиДокумента.Проведение);
				//-- #6354 смарт: Тимофеева 06.04.2026
				ОбщегоНазначения.СообщитьПользователю("Создан и проведен документ " + РасходныеОрдерОбъект.Ссылка, РасходныеОрдерОбъект.Ссылка);
			Исключение
				// ++ 09.08.2021			
				РасходныеОрдерОбъект.Статус = Перечисления.СтатусыРасходныхОрдеров.Подготовлено;
				
				Для Каждого ТекСтр Из РасходныеОрдерОбъект.ОтгружаемыеТовары Цикл
					ТекСтр.Действие = ДействиеОтобрать;
				КонецЦикла;	
				РасходныеОрдерОбъект.Записать();
				ОбщегоНазначения.СообщитьПользователю("Создан и проведен документ " + РасходныеОрдерОбъект.Ссылка + символы.ПС + "(Не удалось изменить статус на ""К отгрузке"")", РасходныеОрдерОбъект.Ссылка);
				// --

			КонецПопытки;
		КонецЕсли;	
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецФункции //-- смарт:ММ 08.08.2021

// ++ 01.04.2021 - перенесено из модуля формы (с изменениями)
// ++ 21.11.2020
&НаСервере
Функция СоздатьЗаказНаВнутреннееПотребление(СтрокиДляСозданияЗаказаНаВнутреннееПотребление)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДатаДокумента = ТекущаяДата();
	
	СтатьяРасходов 	= Справочники.смартПредопределенныеЗначения.СтатьяРасходовПоЗаявкамНаГарантийныйРемонт.Значение;
	Аналитика = Оборудование;
	Подразделение 	= Справочники.смартПредопределенныеЗначения.ПодразделениеПоЗаявкамНаГарантийныйРемонт.Значение;
	
	ДокументЗаказ = Документы.ЗаказНаВнутреннееПотребление.СоздатьДокумент();
	ДокументЗаказ.Дата 				= ДатаДокумента;
	ДокументЗаказ.ДатаОтгрузки 		= ДатаДокумента;
	ДокументЗаказ.Организация 		= Организация;
	ДокументЗаказ.Склад 			= СкладИнженера;
	ДокументЗаказ.Ответственный 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию; // Синоним = Списание на расходы
	ДокументЗаказ.Статус 			= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказ.Подразделение 	= Подразделение;
