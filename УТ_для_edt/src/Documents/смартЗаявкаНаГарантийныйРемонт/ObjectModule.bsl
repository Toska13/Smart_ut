	|	ВТ_АктуальныеРешения.ДатаРешения КАК ДатаРешения,
	|	ВТ_АктуальныеРешения.РешениеПоставщика КАК РешениеПоставщика
	|ИЗ
	|	ВТ_АктуальныеРешения КАК ВТ_АктуальныеРешения
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоследнееРешениеВИстории КАК ВТ_ПоследнееРешениеВИстории
	|		ПО ВТ_АктуальныеРешения.НомерПозиции = ВТ_ПоследнееРешениеВИстории.НомерПозиции
	|			И ВТ_АктуальныеРешения.РешениеПоставщика = ВТ_ПоследнееРешениеВИстории.РешениеПоставщика
	|ГДЕ
	|	ВТ_АктуальныеРешения.ДатаРешения <> ВТ_ПоследнееРешениеВИстории.ДатаРешения
	//-- #Б-3660 смарт: Лопато 03.07.2025
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерПозиции";
		
	//++ #Б-3660 смарт: Лопато 03.07.2025 //Заявка на гарантийный ремонт. Решения поставщика с верными датами.  
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Выборка = РезультатЗапроса[5].Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ИсторияРешенийПоставщика.Добавить();

		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ДатаИзменения = ТекущаяДата();
		
	КонецЦикла;

	ВыборкаОбновление = РезультатЗапроса[6].Выбрать();
	
	Пока ВыборкаОбновление.Следующий() Цикл
		
		ОтборСтрокИстории = Новый Структура;
		ОтборСтрокИстории.Вставить("НомерПозиции", 	 	ВыборкаОбновление.НомерПозиции);
		ОтборСтрокИстории.Вставить("РешениеПоставщика", ВыборкаОбновление.РешениеПоставщика);
		
		СтрокиИстории = ИсторияРешенийПоставщика.НайтиСтроки(ОтборСтрокИстории);
		
		Для Каждого СтрИстории Из СтрокиИстории Цикл
			СтрИстории.ДатаРешения = ВыборкаОбновление.ДатаРешения;
		КонецЦикла;
		
	КонецЦикла;

	БылиИзменения = Выборка.Количество() > 0
					ИЛИ ВыборкаОбновление.Количество() > 0;
	//-- #Б-3660 смарт: Лопато 03.07.2025
		
КонецПроцедуры

Функция ПроверитьКоличествоСтрокВТаблицах(Отказ)
	
	// 16.08.2020
	Возврат Неопределено;
	// --
	
	Если Статус = Перечисления.СтатусыКассовойСмены.Закрыта Тогда
		Если ЗаполняетсяИнженером.Количество() <> ЗаполняетсяСпециалистомПоПретензиям.Количество() Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Количество строк в таблицах ""Заполняется инженером"" и ""Заполняется специалистом по претензиям"" должно быть одинаково."); 
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

// 30.04.2020
Процедура ОтправитьУведомлениеОбОтменеОтправкиЗапчастей(КомментарииОтменыОтправки)
	
	Если ТипЗнч(КомментарииОтменыОтправки) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если КомментарииОтменыОтправки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой);
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
		ТемаПисьма = Номер;
		
		ТекстОтмены = "";
		Для Каждого Строка Из КомментарииОтменыОтправки Цикл
			ТекстОтмены = ТекстОтмены + ?(ЗначениеЗаполнено(ТекстОтмены), ", ", "") + Строка.Комментарий + " (" + Строка.Артикул + ")";
		КонецЦикла;
				
		ТекстПисьма = "ВНИМАНИЕ!!! По заявке на гарантийный ремонт № " + Номер + " нет возможности выполнить отправку поставщику по причине: "
		+ ТекстОтмены + ". За уточнениями необходимо обратиться к Федору Акимову.";
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено уведомление об отмене отправки гарантийных запчастей НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
			Иначе
			//-- смарт:ММ 03.03.2021
				
			ТекстСообщения = "Отправлено уведомление об отмене отправки гарантийных запчастей на почту " +  АдресаДляОтправкиСтрокой;
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			КонецЕсли;
			//-- смарт:ММ 03.03.2021
				
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Исключение  
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,Ссылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить уведомление об отмене отправки гарантийных запчастей" + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой = "") Экспорт
	
	// Уведомление об отмене отправки запчастей отправляется ответственному из документа, 
	// а также получаетлям, которые задаются в справочнике смартПредопределенныеЗначения
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
	|	И НЕ смартПредопределенныеЗначения.СписокЗначений
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ПользователиСпр.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ПользователиСпр.смартРабочаяПочта
	|	КОНЕЦ
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПРАВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ПользователиСпр.Ссылка
	|			И ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя
	|ГДЕ
	|	ПользователиСпр.Ссылка = &Пользователь";
	
	Запрос.УстановитьПараметр("Пользователь", 		Ответственный);
	Запрос.УстановитьПараметр("ПочтаПользователя", 	Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	Запрос.УстановитьПараметр("ПредопределенноеЗначение", Справочники.смартПредопределенныеЗначения.АдресаДляУведомленийОбОтменеОтправкиГарантийныхЗапчастей);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

// 08.10.2020
Процедура СинхронизироватьНоменклатуруВТаблицах()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЧИнженер.НоменклатураПринятаяОтКлиента КАК НоменклатураПринятаяОтКлиента,
	|	ТЧИнженер.ИДСтрокиЗаполняетсяИнженером КАК ИДСтрокиЗаполняетсяИнженером
	|ПОМЕСТИТЬ ВТ_Инженер
	|ИЗ
	|	&ТЧИнженер КАК ТЧИнженер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТЧСпециалист.ИДСтрокиЗаполняетсяИнженером КАК ИДСтрокиЗаполняетсяИнженером,
	|	ТЧСпециалист.Номенклатура КАК Номенклатура,
	|	ТЧСпециалист.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Специалист
	|ИЗ
	|	&ТЧСпециалист КАК ТЧСпециалист
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Инженер.НоменклатураПринятаяОтКлиента КАК НоменклатураПринятаяОтКлиента,
	|	ВТ_Специалист.ИДСтрокиЗаполняетсяИнженером КАК ИДСтрокиЗаполняетсяИнженером,
	|	ВТ_Специалист.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_Инженер КАК ВТ_Инженер
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Специалист КАК ВТ_Специалист
	|		ПО ВТ_Инженер.НоменклатураПринятаяОтКлиента <> ВТ_Специалист.Номенклатура
	|			И ВТ_Инженер.ИДСтрокиЗаполняетсяИнженером = ВТ_Специалист.ИДСтрокиЗаполняетсяИнженером";
	
	Запрос.УстановитьПараметр("ТЧИнженер", 		ЗаполняетсяИнженером.Выгрузить());
	Запрос.УстановитьПараметр("ТЧСпециалист", 	ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерСтроки", Выборка.НомерСтроки);
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", Выборка.ИДСтрокиЗаполняетсяИнженером);
		НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденныеСтроки[0].Номенклатура = Выборка.НоменклатураПринятаяОтКлиента;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// 13.06.2020
Процедура ДобавитьСтрокиИзИнженераВСпециалиста(Отказ)
		
	СтатусНеОтправлялась = Перечисления.смартСтатусыПоГарантии.НечемЗаменить;
	
	//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA
	СтатусОтправкаНеТребуется = Перечисления.смартСтатусыПоГарантии.ОтгрузкаНеТребуетсяНедовложение;
	//-- #1603 смарт: Мосолов 18.01.2024 
	
	НомерСтроки = ЗаполняетсяСпециалистомПоПретензиям.Количество() + 1;

	Для Каждого СтрокаИнженер Из ЗаполняетсяИнженером Цикл
				
		//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA 
		
		ЭтоНедостача = СтрокаИнженер.ТипDOA = Перечисления.смартТипыDOA.Недостача;
		
		//-- #1603 смарт: Мосолов 18.01.2024 
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером);
		НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);  
        
        Если НайденныеСтроки.Количество() <> 0 Тогда   
            
            //++ смарт:Подкин #939 24.03.2022 13:09:45  
            Для каждого СтрЗИ Из НайденныеСтроки Цикл
				Если НЕ ЗначениеЗаполнено(СтрЗИ.Статус) Тогда
					
					//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA 
					//СтрЗИ.Статус=СтатусНеОтправлялась;  
					СтрЗИ.Статус = ?(ЭтоНедостача, СтатусОтправкаНеТребуется, СтатусНеОтправлялась);
					//-- #1603 смарт: Мосолов 18.01.2024 
					
					СтрокаСтатус = Статусы.Добавить();
					СтрокаСтатус.ДатаИзмененияСтатуса = ТекущаяДата();
					СтрокаСтатус.НомерПозиции = СтрЗИ.НомерПозиции; 
					
					//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA 
					//СтрокаСтатус.Статус = СтатусНеОтправлялась; 
					СтрокаСтатус.Статус = СтрЗИ.Статус; 
					//-- #1603 смарт: Мосолов 18.01.2024 
					
                КонецЕсли;
            КонецЦикла;
            //-- смарт:Подкин #939 24.03.2022 13:09:45  
            
            Продолжить;
        КонецЕсли;		
		 
		//++ смарт:ММ 10.08.2020
		
		Если НЕ ЗначениеЗаполнено(СтрокаИнженер.НоменклатураПринятаяОтКлиента) Тогда
			// 08.10.2020
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + СтрокаИнженер.НомерСтроки + " не заполнена запчасть клиента");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + СтрокаИнженер.НомерСтроки + " не заполнена запчасть клиента" + ?(ЗначениеЗаполнено(Ссылка), " (" + Ссылка + ")", ""));
			// --
			Отказ = Истина;
		КонецЕсли;		
		//-- смарт:ММ 10.08.2020

		СтрокаПретензия = ЗаполняетсяСпециалистомПоПретензиям.Добавить();
		СтрокаПретензия.Номенклатура = СтрокаИнженер.НоменклатураПринятаяОтКлиента;
		СтрокаПретензия.ИДСтрокиЗаполняетсяИнженером = СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером;
		СтрокаПретензия.Количество = СтрокаИнженер.Количество;
		СтрокаПретензия.НомерПозиции = НомерСтроки;
		СтрокаПретензия.ДатаДобавления = ТекущаяДата();
		
		// ++ 13.12.2020
		СтрокаПретензия.Контрагент = ПолучитьКонтрагентаДляТЧСпециалиста();
		// --
		
		НомерСтроки = НомерСтроки + 1;
		
		Если СтрокаИнженер.ЗапчастьОтКлиентаПринял Тогда
			// Статус не устанавливается
		Иначе

			//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA 
			//СтрокаПретензия.Статус = СтатусНеОтправлялась;
			СтрокаПретензия.Статус = ?(ЭтоНедостача, СтатусОтправкаНеТребуется, СтатусНеОтправлялась);
			//-- #1603 смарт: Мосолов 18.01.2024 
			
			СтрокаСтатус = Статусы.Добавить();
			СтрокаСтатус.ДатаИзмененияСтатуса = ТекущаяДата();
			СтрокаСтатус.НомерПозиции = СтрокаПретензия.НомерПозиции;
			
			//++ #1603 смарт: Мосолов 18.01.2024 //Доработка гарантийного блока / Изменить логику DOA 
			//СтрокаСтатус.Статус = СтатусНеОтправлялась;
			СтрокаСтатус.Статус = СтрокаПретензия.Статус;
			//-- #1603 смарт: Мосолов 18.01.2024
			
		КонецЕсли;		
		
	КонецЦикла;
КонецПроцедуры

// 16.08.2020
Процедура ПроверитьКоличествоЗапчастейПоСтрокам()
	
	// Обработка ситуации, когда в таблице инженера изменилось количество в уже существующем документе
	
	// 1. Если статус отправки по строке в таблице специалиста «не отправлена» и статус получения не заполнен, 
	// то можно в таблице специалиста в строке количество корректировать. 
	// 2. Если же статусы уже начали меняться, то надо отдельную строку в таблицу специалиста добавлять
	
	СтатусНеОтправлена = Перечисления.смартСтатусыПоГарантии.НечемЗаменить; // Не отправлена
	
	Для Каждого СтрокаИнженер Из ЗаполняетсяИнженером Цикл
				
		Отбор = Новый Структура;
		Отбор.Вставить("ИДСтрокиЗаполняетсяИнженером", СтрокаИнженер.ИДСтрокиЗаполняетсяИнженером);
		НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		
		КоличествоВСтрокахСпециалиста = 0;
		
		Для Каждого СтрокаСпециалист Из НайденныеСтроки Цикл
			КоличествоВСтрокахСпециалиста = КоличествоВСтрокахСпециалиста + СтрокаСпециалист.Количество;	
		КонецЦикла;
		
		Разница = СтрокаИнженер.Количество - КоличествоВСтрокахСпециалиста;
		
		Если СтрокаИнженер.Количество <> КоличествоВСтрокахСпециалиста Тогда
			
			ИзмененоКоличество = Ложь;
			
			Для Каждого СтрокаСпециалист Из НайденныеСтроки Цикл
				Если СтрокаСпециалист.Статус = СтатусНеОтправлена 
					И НЕ ЗначениеЗаполнено(СтрокаСпециалист.СтатусПолучения) Тогда
					// 1. 
					
					СтрокаСпециалист.Количество = СтрокаСпециалист.Количество + Разница;
					ИзмененоКоличество = Истина;
				КонецЕсли;	
			КонецЦикла;
			
			Если НЕ ИзмененоКоличество 
				И НайденныеСтроки.Количество() > 0 
				И Разница > 0 Тогда
				// 2.
				СтрокаЗаполняетсяСпециалистом = НайденныеСтроки[0];
				НоваяСтрока = ЗаполняетсяСпециалистомПоПретензиям.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаполняетсяСпециалистом);
				НоваяСтрока.Количество = Разница;
				НоваяСтрока.НомерПозиции = ПолучитьСледующийНомерПозиции();
				// ++ 05.11.2020
				НоваяСтрока.Статус = СтатусНеОтправлена;
				//--
				
				Отбор = Новый Структура;
				Отбор.Вставить("НомерПозиции", СтрокаЗаполняетсяСпециалистом.НомерПозиции);
			
				НайденныеСтрокиСтатус = Статусы.НайтиСтроки(Отбор);
				// ++ 05.11.2020
				//Для Каждого СтрокаСтатус Из НайденныеСтрокиСтатус Цикл
				//	НоваяСтрокаСтатус = Статусы.Добавить();
				//	ЗаполнитьЗначенияСвойств(НоваяСтрокаСтатус, СтрокаСтатус);
				//	НоваяСтрокаСтатус.НомерПозиции = НоваяСтрока.НомерПозиции;
				//КонецЦикла;
				
				//НайденныеСтрокиИсторияРешений = ИсторияРешенийПоставщика.НайтиСтроки(Отбор);
				//Для Каждого СтрокаИстория Из НайденныеСтрокиИсторияРешений Цикл
				//	НоваяСтрокаИстория = ИсторияРешенийПоставщика.Добавить();
				//	ЗаполнитьЗначенияСвойств(НоваяСтрокаИстория, СтрокаИстория);
				//	НоваяСтрокаИстория.НомерПозиции = НоваяСтрока.НомерПозиции;
				//КонецЦикла;
				//
				//НайденныеСтрокиДопДействия = ДополнительныеДействия.НайтиСтроки(Отбор);
				//Для Каждого СтрокаДопДействия Из НайденныеСтрокиДопДействия Цикл
				//	НоваяСтрокаДопДействия = ДополнительныеДействия.Добавить();
				//	ЗаполнитьЗначенияСвойств(НоваяСтрокаДопДействия, СтрокаДопДействия);
				//	НоваяСтрокаДопДействия.НомерПозиции = НоваяСтрока.НомерПозиции;
				//КонецЦикла;
				
				НоваяСтрокаСтатус = Статусы.Добавить();
				НоваяСтрокаСтатус.НомерПозиции = НоваяСтрока.НомерПозиции;
				НоваяСтрокаСтатус.ДатаИзмененияСтатуса = ТекущаяДата();
				НоваяСтрокаСтатус.Статус = СтатусНеОтправлена;
				// --				
						
			КонецЕсли;			
		КонецЕсли;		
	КонецЦикла;
	 
КонецПроцедуры

Функция ПолучитьСледующийИДСтроки() Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.ИДСтрокиЗаполняетсяИнженером КАК ИДСтрокиЗаполняетсяИнженером
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВТ.ИДСтрокиЗаполняетсяИнженером), 0) КАК ИДСтрокиЗаполняетсяИнженером
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("ТЗ", ЗаполняетсяИнженером.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИДСтрокиЗаполняетсяИнженером + 1;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Функция ПолучитьСледующийНомерПозиции() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК ЗаполняетсяСпециалистомПоПретензиям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВТ.НомерПозиции), 0) КАК НомерПозиции
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("ТЗ", ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерПозиции + 1;
	КонецЕсли;
	
	Возврат 1;
		
КонецФункции

// 11.08.2020
Функция ПолучитьПредыдущийСтатус(НомерПозиции, НомерСтроки)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Статусы.Статус КАК Статус,
	|	Статусы.НомерПозиции КАК НомерПозиции,
	|	Статусы.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК Статусы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_МаксимальнаяСтрока
	|ИЗ
	|	ВТ КАК ВТ
	|ГДЕ
	|	ВТ.НомерПозиции = &НомерПозиции
	|	И ВТ.НомерСтроки < &НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Статус КАК Статус
	|ИЗ
	|	ВТ_МаксимальнаяСтрока КАК ВТ_МаксимальнаяСтрока
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО ВТ_МаксимальнаяСтрока.НомерСтроки = ВТ.НомерСтроки";
	
	Запрос.УстановитьПараметр("ТЗ", Статусы.Выгрузить());
	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	Запрос.УстановитьПараметр("НомерПозиции", НомерПозиции);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Статус;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// 29.08.2020
Функция ПолучитьСебестоимостьЗапчастиИзВозвратаПоставщику(НомерПозиции, НалогообложениеНДС, Номенклатура)
	
	Результат = 0;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерПозиции", НомерПозиции);
	Отбор.Вставить("Статус", Перечисления.смартСтатусыПоГарантии.ОжидаетсяОтправка);
	
	НайденныеСтроки = Статусы.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		СтрокаСтатус = НайденныеСтроки[0];
		
		Если ЗначениеЗаполнено(СтрокаСтатус.ДокументДвижения) 
			И ТипЗнч(СтрокаСтатус.ДокументДвижения) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
			
			ДокументВозвратПоставщику = СтрокаСтатус.ДокументДвижения;
			
			НалогообложениеНДС = ДокументВозвратПоставщику.НалогообложениеНДС;
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СебестоимостьТоваров.Стоимость КАК Стоимость,
			|	СебестоимостьТоваров.СтоимостьБезНДС КАК СтоимостьБезНДС,
			|	СебестоимостьТоваров.СтоимостьРегл КАК СтоимостьРегл,
			|	СебестоимостьТоваров.СтоимостьУпр КАК СтоимостьУпр
			|ИЗ
			|	РегистрНакопления.СебестоимостьТоваров КАК СебестоимостьТоваров
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК КлючиАналитикиУчетаНоменклатуры
			|		ПО СебестоимостьТоваров.АналитикаУчетаНоменклатуры = КлючиАналитикиУчетаНоменклатуры.Ссылка
			|ГДЕ
			|	СебестоимостьТоваров.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			|	И СебестоимостьТоваров.Регистратор = &ДокументВозвратПоставщику
			|	И СебестоимостьТоваров.РасчетСебестоимости
			|	И КлючиАналитикиУчетаНоменклатуры.Номенклатура = &Номенклатура";
			
			Запрос.УстановитьПараметр("ДокументВозвратПоставщику", ДокументВозвратПоставщику);
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
						
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Результат = Выборка.Стоимость;				
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// 29.10.2020
Функция УстановитьПризнакГотоваКЗакрытию()
	
	// Готовой к закрытию считается заявка, каждая запчасть таблицы специалиста которой удовлетворяет одному из наборов условий:
	//	1) запчасть имеет в истории статусов статус отправки "отправлено", 
	//		статус получения "получено от поставщика" 
	//		и в таблице специалиста решение поставщика "Warranty provided"
	//	2) запчасть имеет в истории статусов статус отправки "отправлено", 
	//		статус получения  пустой 
	//		и в таблице специалиста решение поставщика "Warranty denied"

	ГотоваКЗакрытию = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерСтроки КАК НомерСтроки,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.СтатусПолучения КАК СтатусПолучения,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.РешениеПоставщика КАК РешениеПоставщика
	|ПОМЕСТИТЬ ВТ_ВсеСтрокиСпециалист
	|ИЗ
	|	&ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.НомерПозиции КАК НомерПозиции,
	|	смартЗаявкаНаГарантийныйРемонтСтатусы.Статус КАК Статус
	|ПОМЕСТИТЬ ВТ_Статусы
	|ИЗ
	|	&Статусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеСтрокиСпециалист.НомерСтроки КАК НомерСтроки,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.Отправлено)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСтатусОтправлено,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА смартЗаявкаНаГарантийныйРемонтСтатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСтатусПолученоОтПоставщика,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_ВсеСтрокиСпециалист.СтатусПолучения = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПустаяСсылка)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьПустойСтатусПолучения,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_ВсеСтрокиСпециалист.РешениеПоставщика = ЗНАЧЕНИЕ(Перечисление.смартРешенияПоставщика.WarrantyDenied)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьРешениеПоставщикаWarrantyDenied,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВТ_ВсеСтрокиСпециалист.РешениеПоставщика = ЗНАЧЕНИЕ(Перечисление.смартРешенияПоставщика.WarrantyProvided)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьРешениеПоставщикаWarrantyProvided
	|ПОМЕСТИТЬ ВТ_ПодготовительнаяДляОтбора
	|ИЗ
	|	ВТ_ВсеСтрокиСпециалист КАК ВТ_ВсеСтрокиСпециалист
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Статусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
	|		ПО ВТ_ВсеСтрокиСпециалист.НомерПозиции = смартЗаявкаНаГарантийныйРемонтСтатусы.НомерПозиции
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВсеСтрокиСпециалист.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(ВЫБОР
	|			КОГДА &Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Закрыта)
	|				ТОГДА ЛОЖЬ
	|			КОГДА ВТ_ПодготовительнаяДляОтбора.ЕстьСтатусОтправлено = ИСТИНА
	|					И ВТ_ПодготовительнаяДляОтбора.ЕстьСтатусПолученоОтПоставщика = ИСТИНА
	|					И ВТ_ПодготовительнаяДляОтбора.ЕстьРешениеПоставщикаWarrantyProvided = ИСТИНА
	|				ТОГДА ИСТИНА
	|			КОГДА ВТ_ПодготовительнаяДляОтбора.ЕстьСтатусОтправлено = ИСТИНА
	|					И ВТ_ПодготовительнаяДляОтбора.ЕстьПустойСтатусПолучения = ИСТИНА
	|					И ВТ_ПодготовительнаяДляОтбора.ЕстьРешениеПоставщикаWarrantyDenied = ИСТИНА
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК КЗакрытию
	|ИЗ
	|	ВТ_ПодготовительнаяДляОтбора КАК ВТ_ПодготовительнаяДляОтбора";
	
	Запрос.УстановитьПараметр("Статус", Статус);
	Запрос.УстановитьПараметр("ЗаполняетсяСпециалистомПоПретензиям", ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	Запрос.УстановитьПараметр("Статусы", Статусы.Выгрузить());
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.КЗакрытию = Истина Тогда
			ГотоваКЗакрытию = Истина;
		КонецЕсли;
	КонецЕсли;

КонецФункции

