Процедура ЗаполнитьИсториюРешенийПоставщика()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаполняетсяСпециалистомПоПретензиям", ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
	Запрос.УстановитьПараметр("ИсторияРешенийПоставщика", ИсторияРешенийПоставщика.Выгрузить());
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
