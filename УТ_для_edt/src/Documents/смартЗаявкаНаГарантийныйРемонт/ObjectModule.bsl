				|Документ записан без проведения.", ДокументОплатаПоставщику.Ссылка);

		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки()); 
		КонецПопытки;
	КонецПопытки;
	
	Возврат ДокументОплатаПоставщику.Ссылка;	
	
КонецФункции

Функция СоздатьДокументВозвратТоваровПоставщику(НомерПозиции)
	
	ТекКонтрагент = Неопределено;
	ТекСтрока = Неопределено;
	ДатаОтправления = Неопределено; // 01.06.2020
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);

	НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда	
		
		ТекСтрока = НайденныеСтроки[0];
		ТекКонтрагент = ТекСтрока.Контрагент;
		ДатаОтправления = ТекСтрока.ДатаОтправления; // 01.06.2020
	КонецЕсли;	
	
	ДокументВозвратТоваров = Документы.ВозвратТоваровПоставщику.СоздатьДокумент();
	
	// 01.06.2020
	// ДокументВозвратТоваров.Дата = ТекущаяДата();
	ДокументВозвратТоваров.Дата = ?(ЗначениеЗаполнено(ДатаОтправления), ДатаОтправления, ТекущаяДата());
	//
	ДокументВозвратТоваров.Организация 	= Организация;
	ДокументВозвратТоваров.Партнер 		= Поставщик;
	ДокументВозвратТоваров.Склад 		= СкладГарантийныхЗапчастей;
	ДокументВозвратТоваров.Контрагент 	= ТекКонтрагент;
	ДокументВозвратТоваров.СпособКомпенсации = Перечисления.СпособыКомпенсацииВозвратовТоваров.ЗаменитьТовары;
	ДокументВозвратТоваров.Комментарий  = ПолучитьТекстКомментарияКДокументу();
	ДокументВозвратТоваров.Менеджер 	= ПараметрыСеанса.ТекущийПользователь;
	ДокументВозвратТоваров.НалогообложениеНДС 		= Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	ДокументВозвратТоваров.ХозяйственнаяОперация 	= Перечисления.ХозяйственныеОперации.ВозвратТоваровПоставщику;
	ДокументВозвратТоваров.СпособКомпенсации 		= Перечисления.СпособыКомпенсацииВозвратовТоваров.ОставитьВКачествеАванса;
	ДокументВозвратТоваров.СпособДоставки 			= Перечисления.СпособыДоставки.Самовывоз;
	ДокументВозвратТоваров.Валюта 					= Константы.ВалютаРегламентированногоУчета.Получить();
	//++ #Б1610 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Заявка на гарантийный ремонт.
	ДокументВозвратТоваров.смартЗапчастиГарантийные = Истина;
	//-- #Б1610 смарт: Шляпников 09.12.2024
		
	Если ТекСтрока <> Неопределено Тогда
		НоваяСтрока = ДокументВозвратТоваров.Товары.Добавить();
		НоваяСтрока.Количество 			= ТекСтрока.Количество;
		НоваяСтрока.КоличествоУпаковок	= ТекСтрока.Количество;
		НоваяСтрока.Номенклатура 		= ТекСтрока.Номенклатура;
		НоваяСтрока.СтавкаНДС 			= Перечисления.СтавкиНДС.БезНДС;
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = Номер;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
		//-- #Б1132 смарт: Шляпников 14.10.2024
		
		// ++ 21.11.2020
		Если ЗначениеЗаполнено(ТекСтрока.СоСклада) Тогда
			ДокументВозвратТоваров.Склад = ТекСтрока.СоСклада;
		КонецЕсли;
		// --
		
	КонецЕсли;	
	
	СинонимДокумента = ДокументВозвратТоваров.Метаданные().Синоним;
	
	Попытка
		ДокументВозвратТоваров.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументВозвратТоваров.Ссылка, ДокументВозвратТоваров.Ссылка);
	Исключение
		Попытка
			ДокументВозвратТоваров.Записать(РежимЗаписиДокумента.Запись);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
				|" + ОписаниеОшибки() + "
				|Документ записан без проведения.", ДокументВозвратТоваров.Ссылка);

		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки()); 
		КонецПопытки;
	КонецПопытки;
	
	Возврат ДокументВозвратТоваров.Ссылка;
	
КонецФункции

Функция СоздатьДокументКорректировкаРегистров(НомерПозиции)
	
	// Документ должен отсторнировать созданный ранее по этой номенклатуре документ Возврат товаров поставщику
	
	ОтменяемыйВозвратТоваровПоставщику = Неопределено;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);

	НайденныеСтроки = Статусы.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			Если ТипЗнч(Строка.ДокументДвижения) = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Тогда
				ОтменяемыйВозвратТоваровПоставщику = Строка.ДокументДвижения;
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтменяемыйВозвратТоваровПоставщику) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	
	ДокументКорректировка = Документы.КорректировкаРегистров.СоздатьДокумент();
	
	ДокументКорректировка.Дата = ТекущаяДата();
	ДокументКорректировка.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		
	ДокументОбъект = ОтменяемыйВозвратТоваровПоставщику.ПолучитьОбъект();
	
	МетаданныеДвижений = ДокументОбъект.Метаданные().Движения;
	
	Для Каждого ТаблицаДвижений Из МетаданныеДвижений Цикл
		
		ИмяТаблицы = ТаблицаДвижений.Имя;
		ДокументОбъект.Движения[ИмяТаблицы].Прочитать();
		
		Если ДокументОбъект.Движения[ИмяТаблицы].Количество() > 0 Тогда
			ДокументКорректировка.ТаблицаРегистров.Добавить().Имя = ИмяТаблицы;
			ТаблицаДвиженийВыгруженная = ДокументОбъект.Движения[ИмяТаблицы].Выгрузить();
			СторнироватьТаблицу(ТаблицаДвиженийВыгруженная);
			ДокументКорректировка.Движения[ИмяТаблицы].Загрузить(ТаблицаДвиженийВыгруженная);
		КонецЕсли;
	КонецЦикла;
	
	ДокументКорректировка.Комментарий = ПолучитьТекстКомментарияКДокументу() + Символы.ПС + "Сторно документа " + ОтменяемыйВозвратТоваровПоставщику;
	СинонимДокумента = ДокументКорректировка.Метаданные().Синоним;
	
	
	Попытка
		ДокументКорректировка.Записать();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокументКорректировка.Ссылка, ДокументКорректировка.Ссылка);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки()); 
	КонецПопытки;
	
	Возврат ДокументКорректировка.Ссылка;
	
КонецФункции

Функция ЗаявкуМожноЗакрыть(ПроверкаТекущихСтатусов = Истина, ПроверкаОтправкиПоставщикуВИстории = Истина) Экспорт
	
	ЗаявкуМожноЗакрыть = Ложь;
	
	Проверка1 = Ложь;
	Проверка2 = Ложь;
	
	Если ПроверкаТекущихСтатусов Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЧ.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&ТЧ КАК ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ.Статус КАК Статус
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	НЕ ВТ.Статус В(&ИтоговыеСтатусы)";
				
		ИтоговыеСтатусы = Новый Массив;
		ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.ВГарантииОтказано);
		//++ смарт:ММ #044 224 20.07.2020
		//ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.ПолученоОтПоставщика);
		//ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.Компенсация);
		ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика);
		ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.Компенсация);
		//-- смарт:ММ 20.07.2020
		
		// ++27.02.2020
		//ИтоговыеСтатусы.Добавить(Перечисления.смартСтатусыПоГарантии.ОтгрузкаНеТребуется);
		// --
				
		Запрос.УстановитьПараметр("ТЧ", 			ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
		Запрос.УстановитьПараметр("ИтоговыеСтатусы", ИтоговыеСтатусы);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			// В документе нет статусов, которые противоречат закрытию заявки
			Проверка1 = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПроверкаОтправкиПоставщикуВИстории Тогда
		// Все запчасти, у которых сейчас статус "ПолученоОтПоставщика", должны иметь в истории статус "ОтправленоПоставщику"
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	смартЗаявкаНаГарантийныйРемонтСтатусы.НомерПозиции КАК НомерПозиции,
		|	смартЗаявкаНаГарантийныйРемонтСтатусы.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ_Сатусы
		|ИЗ
		|	&ТЧСтатусы КАК смартЗаявкаНаГарантийныйРемонтСтатусы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
		|	ЗаполняетсяСпециалистомПоПретензиям.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ_ЗаполняетсяСпециалистомПоПретензиям
		|ИЗ
		|	&ТЧЗаполняетсяСпециалистом  КАК ЗаполняетсяСпециалистомПоПретензиям
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВТ_Сатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ОтправлялосьПоставщику
		|ИЗ
		|	ВТ_ЗаполняетсяСпециалистомПоПретензиям КАК ВТ_ЗаполняетсяСпециалистомПоПретензиям
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сатусы КАК ВТ_Сатусы
		|	    ПО ВТ_ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции = ВТ_Сатусы.НомерПозиции 
		|ГДЕ
		//++ смарт:ММ #044 224 20.07.2020
		//| 	ВТ_ЗаполняетсяСпециалистомПоПретензиям.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ПолученоОтПоставщика)
		| 	ВТ_ЗаполняетсяСпециалистомПоПретензиям.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика)
		//-- смарт:ММ 20.07.2020
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ЗаполняетсяСпециалистомПоПретензиям.НомерПозиции
		|ИМЕЮЩИЕ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ВТ_Сатусы.Статус = ЗНАЧЕНИЕ(Перечисление.смартСтатусыПоГарантии.ОтправленоПоставщику)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("ТЧСтатусы", Статусы.Выгрузить());
		Запрос.УстановитьПараметр("ТЧЗаполняетсяСпециалистом", ЗаполняетсяСпециалистомПоПретензиям.Выгрузить());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Проверка2 = Истина;
		КонецЕсли;
		
	КонецЕсли;

	Если ПроверкаТекущихСтатусов И ПроверкаОтправкиПоставщикуВИстории Тогда
		ЗаявкуМожноЗакрыть = Проверка1 И Проверка2;
	ИначеЕсли ПроверкаТекущихСтатусов Тогда
		ЗаявкуМожноЗакрыть = Проверка1;
	ИначеЕсли ПроверкаОтправкиПоставщикуВИстории Тогда
		ЗаявкуМожноЗакрыть = Проверка2;
	КонецЕсли;
	
	Возврат ЗаявкуМожноЗакрыть;
	
КонецФункции

Функция РассчитатьСуммы(Сумма, Валюта, ВалютаРегл, ВалютаУпр, ДатаДокумента)
	
	Если Валюта = ВалютаРегл Тогда
		СуммаРегл = Сумма;
	Иначе
		КоэффициентПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(Валюта, ВалютаРегл, ДатаДокумента);
		СуммаРегл = Окр(Сумма * КоэффициентПересчета, 2, 1);
	КонецЕсли;
	
	Если Валюта = ВалютаУпр Тогда
		СуммаУпр = Сумма;
	Иначе
		КоэффициентПересчета = РаботаСКурсамиВалютУТ.ПолучитьКоэффициентПересчетаИзВалютыВВалюту(Валюта, ВалютаУпр, ДатаДокумента);
		СуммаУпр = Окр(Сумма * КоэффициентПересчета, 2, 1);
	КонецЕсли;
	
	Возврат Новый Структура("СуммаРегл, СуммаУпр", СуммаРегл, СуммаУпр);
	
КонецФункции

Процедура СторнироватьТаблицу(Таблица)
	
	Для Каждого ТекСтрока Из Таблица Цикл
		
		ТекСтрока["Активность"] = Истина;
		
		Для Каждого ТекКолонка Из Таблица.Колонки Цикл
			
			Если ТекКолонка.Имя = "НомерСтроки" ИЛИ ТекКолонка.Имя = "КодСтроки" Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекКолонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока[ТекКолонка.Имя] = - ТекСтрока[ТекКолонка.Имя];	
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

