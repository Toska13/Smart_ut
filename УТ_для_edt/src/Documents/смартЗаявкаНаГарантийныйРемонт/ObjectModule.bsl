//++ #Б2434 смарт: Шляпников 04.03.2025 / Заявка на гарантийный ремонт. Дополнительные статусы.
//++ #Б-5952 смарт: Фролов 06.04.2026 //Доработка гарантийной заявки. Новый статус
//Функция СоздатьДокументыДляОперацииПеремещеноДляРемонта(ДатаДокумента, НомерПозиции)
Функция СоздатьДокументыДляОперацииПеремещеноДляРемонта(ДатаДокумента, НомерПозиции, ПеремещениеНаФСО = Ложь)
//-- #Б-5952 смарт: Фролов 06.04.2026	
	
	//1. Заказ на перемещение
	ДокументЗаказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	ДокументЗаказ.Дата = ТекущаяДатаСеанса();
	ДокументЗаказ.Организация 		= Организация;
	ДокументЗаказ.СкладОтправитель 	= СкладГарантийныхЗапчастей;
	
	//++ #Б-5952 смарт: Фролов 06.04.2026 //Доработка гарантийной заявки. Новый статус
	Если ПеремещениеНаФСО Тогда
		
		ДокументЗаказ.СкладПолучатель 	= Справочники.смартПредопределенныеЗначения.Настройки.СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика;
		
	Иначе	
		
		ДокументЗаказ.СкладПолучатель 	= Справочники.смартПредопределенныеЗначения.Настройки.СкладРемонтаИПодмены;
		
	КонецЕсли;
	//-- #Б-5952 смарт: Фролов 06.04.2026
	
	ДокументЗаказ.Ответственный 	= Пользователи.АвторизованныйПользователь();
	ДокументЗаказ.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокументЗаказ.Статус 			= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказ.СпособДоставки 	= Перечисления.СпособыДоставки.Самовывоз;
	ДокументЗаказ.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	
	ДокументЗаказ.Комментарий 		= СтрШаблон("Перемещено для ремонта по %1", Ссылка);
	ДокументЗаказ.ДокументОснование = Ссылка;
	ДокументЗаказ.смартЗапчастиГарантийные = Истина;
		
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерПозиции", НомерПозиции);

	НайденныеСтроки = ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(ПараметрыПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ТекСтрока = НайденныеСтроки[0];
		
		НоваяСтрока = ДокументЗаказ.Товары.Добавить();
		НоваяСтрока.Количество 			 = ТекСтрока.Количество;
		НоваяСтрока.КоличествоУпаковок	 = ТекСтрока.Количество;
		НоваяСтрока.Номенклатура 		 = ТекСтрока.Номенклатура;
		НоваяСтрока.НачалоОтгрузки 		 = ДокументЗаказ.Дата;
		НоваяСтрока.ОкончаниеПоступления = ДокументЗаказ.Дата;
		НоваяСтрока.ВариантОбеспечения 	 = Перечисления.ВариантыОбеспечения.Отгрузить;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;

	КонецЕсли;
	
	Если ДокументЗаказ.Товары.Количество() = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не обнаружена номенклатура для перемещения");
		Возврат Неопределено;
		
	КонецЕсли;
	
	Попытка
		
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументЗаказ.Ссылка, ДокументЗаказ.Ссылка);
		
	Исключение
		
		СинонимДокумента = ДокументЗаказ.Метаданные().Синоним;
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
        |" + ОписаниеОшибки() + "
        |Документ записан без проведения.");
		
		Возврат Неопределено;

	КонецПопытки;
	
	//2. Перемещение
	ДокументПеремещение = Документы.ПеремещениеТоваров.СоздатьДокумент();
	
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(ДокументЗаказ.Ссылка);

	ДанныеЗаполнения = Новый Структура;
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "ПеремещениеТоваров");
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	ДокументПеремещение.Заполнить(ДанныеЗаполнения);
	
	ДокументПеремещение.Дата = ДокументЗаказ.Дата + 1;
	ДокументПеремещение.Комментарий = ДокументЗаказ.Комментарий;
	ДокументПеремещение.смартЗапчастиГарантийные = Истина;
	
	Для Каждого Строка Из ДокументПеремещение.Товары Цикл
		Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Ссылка;
	КонецЦикла;
	
	Попытка
		
		ДокументПеремещение.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументПеремещение.Ссылка, ДокументПеремещение.Ссылка);
		
	Исключение
		
		СинонимДокумента = ДокументПеремещение.Метаданные().Синоним;
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
        |" + ОписаниеОшибки() + "
        |Документ записан без проведения.");
		
	КонецПопытки;
	
	Возврат ДокументЗаказ.Ссылка;
	
КонецФункции

