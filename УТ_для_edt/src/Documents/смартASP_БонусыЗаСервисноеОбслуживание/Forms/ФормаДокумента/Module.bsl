
//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Функция НачислениеБонусовПриНачалеРедактированияНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ASP_ТарифыСрезПоследних.Тариф КАК Тариф,
		|	ASP_ТарифыСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.смартASP_Тарифы.СрезПоследних(&Дата, ) КАК ASP_ТарифыСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Объект.Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Тарифы = Новый Структура;
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Тарифы;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Тарифы.Вставить(ПолучитьИмяПеречисления(ВыборкаДетальныеЗаписи.Тариф), ВыборкаДетальныеЗаписи.Значение);	
	КонецЦикла;
	
	Возврат Тарифы;
КонецФункции

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура НачислениеБонусовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	Тарифы = НачислениеБонусовПриНачалеРедактированияНаСервере();
	
	Если НЕ Тарифы.Свойство("БазовыйТариф") И НЕ Тарифы.Свойство("ПовышенныйТариф") Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.ТекущиеДанные.ВнешнийВид			= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.РаспорядокРаботы		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.КвалификацияЗнания	= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.Инструменты			= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ЗвонокКлиенту 		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ПодготовкаКЗаявке		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ПоведениеУКлиента		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ПравилаВыполненияРабот= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ЗавершениеЗаявки		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.ОформлениеДокументов	= Тарифы.ПовышенныйТариф;
	Элемент.ТекущиеДанные.КоммуникацияСКлиентом	= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.РаботаСПроизводителем	= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.РаботаСМенеджером		= Тарифы.БазовыйТариф;
	Элемент.ТекущиеДанные.Командировка			= Тарифы.БазовыйТариф;
	
	Элемент.ТекущиеДанные.СуммаКВыплате			= (Тарифы.БазовыйТариф * 13) + Тарифы.ПовышенныйТариф;
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Функция ПолучитьИмяПеречисления(Значение)
     Если Значение.Пустая() Тогда
         Возврат "";
     КонецЕсли;

	ИмяПеречисления = Значение.Метаданные().Имя;
	НужныйИндекс = Перечисления[ИмяПеречисления].Индекс(Значение);
	ИмяЗначения = Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[НужныйИндекс].Имя;     
	       
	Возврат ИмяЗначения;        
КонецФункции

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура НачислениеБонусовПриИзменении(Элемент)
	СтрокаТЧ = Элементы.НачислениеБонусов.ТекущиеДанные;
	СтрокаТЧ.СуммаКВыплате = СтрокаТЧ.ВнешнийВид + СтрокаТЧ.РаспорядокРаботы + СтрокаТЧ.КвалификацияЗнания + СтрокаТЧ.Инструменты
				+ СтрокаТЧ.ЗвонокКлиенту + СтрокаТЧ.ПодготовкаКЗаявке + СтрокаТЧ.ПоведениеУКлиента + СтрокаТЧ.ПравилаВыполненияРабот 
				+ СтрокаТЧ.ЗавершениеЗаявки + СтрокаТЧ.ОформлениеДокументов + СтрокаТЧ.КоммуникацияСКлиентом + СтрокаТЧ.РаботаСПроизводителем
				+ СтрокаТЧ.РаботаСМенеджером + СтрокаТЧ.Командировка;
				
	Массив = Новый Массив;
	Массив.Добавить(СтрокаТЧ.КвалификацияЗнания);
	Массив.Добавить(СтрокаТЧ.ЗавершениеЗаявки);
	Массив.Добавить(СтрокаТЧ.ОформлениеДокументов);
	Массив.Добавить(СтрокаТЧ.РаботаСПроизводителем);
	
	КоличествоНулей = 0;
	Для Каждого Стр Из Массив Цикл
		Если Стр = 0 Тогда
			КоличествоНулей = КоличествоНулей + 1;
		КонецЕсли;
	КонецЦикла;
		
	Если КоличествоНулей = 1 Тогда
		СтрокаТЧ.СуммаКВыплате = СтрокаТЧ.СуммаКВыплате * 0.5;
	ИначеЕсли КоличествоНулей >= 2 Тогда
		СтрокаТЧ.СуммаКВыплате = 0;
	КонецЕсли;
			
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Процедура ДобавитьКомментарийДляЯчейкиНаСервере(ИмяТекущегоЭлемента, Инженер, Комментарий)
	МенеджерЗаписи = РегистрыСведений.смартASP_КомментарииДляЯчеек.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Период = Объект.Дата;
	МенеджерЗаписи.Инженер = Инженер;
	МенеджерЗаписи.ТипБонуса = ИмяТекущегоЭлемента;
	МенеджерЗаписи.Комментарий = Комментарий;

	МенеджерЗаписи.Записать();
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура ДобавитьКомментарийДляЯчейки(Команда)
	ИмяТекущегоЭлемента = Элементы.НачислениеБонусов.ТекущийЭлемент.Имя;	
	Если ИмяТекущегоЭлемента = "НачислениеБонусовНомерСтроки" Тогда
		Сообщить("Не выбрана ячейка!");
		Возврат;
	КонецЕсли;
	
	Инженер = Элементы.НачислениеБонусов.ТекущиеДанные.Инженер;
	Если Инженер = ПустаяСсылкаСправочникаПользователи() Тогда
		Сообщить("Не заполнено поле ""Инженер""!");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект);
 
    ПоказатьВводСтроки(
        Оповещение,
        ,
        "Введите комментарий",
        0,
        Истина
    );
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура ПослеВводаСтроки(Результат, Параметры) Экспорт

	ИмяТекущегоЭлемента = Элементы.НачислениеБонусов.ТекущийЭлемент.Имя;
	Инженер = Элементы.НачислениеБонусов.ТекущиеДанные.Инженер;
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобавитьКомментарийДляЯчейкиНаСервере(ИмяТекущегоЭлемента, Инженер, Результат);
КонецПроцедуры

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаСервере
Функция ПосмотретьКомментарийДляЯчейкиНаСервере(ИмяТекущегоЭлемента, Инженер)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ASP_КомментарииДляЯчеекСрезПоследних.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.смартASP_КомментарииДляЯчеек.СрезПоследних(
		|			,
		|			Инженер = &Инженер
		|				И ТипБонуса = &ТипБонуса
		|				И НАЧАЛОПЕРИОДА(Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)) КАК ASP_КомментарииДляЯчеекСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Инженер", Инженер);
	Запрос.УстановитьПараметр("ТипБонуса", ИмяТекущегоЭлемента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Комментарий = "Для данной ячейки нет комментария!";
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Комментарий = ВыборкаДетальныеЗаписи.Комментарий;
	КонецЕсли;
	
	Возврат Комментарий;
КонецФункции

//доработка внешней компании Асиситпро по проекту Бонусы инженеров
&НаКлиенте
Процедура ПосмотретьКомментарийДляЯчейки(Команда)
	ИмяТекущегоЭлемента = Элементы.НачислениеБонусов.ТекущийЭлемент.Имя;
	Если ИмяТекущегоЭлемента = "НачислениеБонусовНомерСтроки" Тогда
		Сообщить("Не выбрана ячейка!");
		Возврат;
	КонецЕсли;
	
	Инженер = Элементы.НачислениеБонусов.ТекущиеДанные.Инженер;
	Если Инженер = ПустаяСсылкаСправочникаПользователи() Тогда
		Сообщить("Не заполнено поле ""Инженер""!");
		Возврат;
	КонецЕсли;
	
	Комментарий = ПосмотретьКомментарийДляЯчейкиНаСервере(ИмяТекущегоЭлемента, Инженер);
	
	
	ПоказатьЗначение(,Комментарий);
КонецПроцедуры

