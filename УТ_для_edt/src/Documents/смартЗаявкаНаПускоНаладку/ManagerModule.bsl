#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда	
	
// Параметры:
//	 ВидУведомления - "Проведение" или "ОтменаПроведения"
Функция ОтправитьПисьма(ДокументСсылка, ВидУведомления, МассивСообщений = Неопределено) Экспорт
	
	Успех = Ложь;
	
	Если МассивСообщений = Неопределено Тогда
		МассивСообщений = Новый Массив;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Успех;
	КонецЕсли;
	
	
	НомерДокумента 	= ДокументСсылка.Номер;
	Контрагент 		= ДокументСсылка.Контрагент;
	Оборудование 	= ДокументСсылка.Оборудование;
	ЖелаемаяДата 	= ДокументСсылка.ЖелаемаяДатаИнсталляции;
	Представительство = ДокументСсылка.Представительство;
	
	ТекстОборудование = "";
	Для Каждого Строка Из Оборудование Цикл
		ТекстОборудование = ТекстОборудование + ?(ЗначениеЗаполнено(ТекстОборудование), Символы.ПС, "") + Строка.Оборудование;
	КонецЦикла;
	
	Если ВидУведомления = "Проведение" 
		ИЛИ ВидУведомления = "ПроведениеСоСтатусомОтправленаВПредставительство" Тогда
		
		ТемаПисьма = "Новая заявка на пусконаладку № " + НомерДокумента;
				
		ТекстПисьма = "Номер заявки " + НомерДокумента + Символы.ПС
		 + "Контрагент: " + Контрагент + Символы.ПС
		 + "Оборудование: " + ТекстОборудование + Символы.ПС
		 + "Желаемая дата инсталляции: " + Формат(ЖелаемаяДата, "ДФ='dd.MM.yyyy ""г.""'");
		 
	 ИначеЕсли ВидУведомления = "ОтменаПроведения" Тогда
		 
		ТемаПисьма = "Отмена заявки на пусконаладку № " + НомерДокумента;
		
		ТекстПисьма = "Заявка на пусконаладку № " + НомерДокумента + " отменена пользователем " + ПараметрыСеанса.ТекущийПользователь;
		// ++ 28.06.2020
		ТекстПисьма = ТекстПисьма + Символы.ПС + Символы.ПС + "Контрагент: " + Контрагент 
		+ Символы.ПС + Символы.ПС + "Оборудование: " + ТекстОборудование;
		 // --
		
	Иначе 
		Возврат Успех;
	КонецЕсли;

	АдресаДляОтправкиСтрокой = "";
	Если ВидУведомления = "ПроведениеСоСтатусомОтправленаВПредставительство" Тогда
		// Руководитель структурного подразделения (представительства)
		МассивАдресовДляОтправки = ПолучитьАдресРуководителяПредставительства(Представительство, АдресаДляОтправкиСтрокой);
	Иначе
		// Из смартПредопределенныеЗначения
		МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой);
	КонецЕсли;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		
	//++ #1330 смарт: Фролов 23.03.2023 //Доработать уведомление инженера о назначениие ПНР (добавить файл PDF)  
	МассивОбъектов=Новый Массив();
	МассивОбъектов.Добавить(ДокументСсылка); 
	ОбъектыПечати=Новый СписокЗначений;
	ТабДок=ПечатьЗаявкаНаПускоНаладку(МассивОбъектов, ОбъектыПечати); 
	
	ПутьКВФ = КаталогВременныхФайлов();
	Формат = ".PDF";
	ТипФайла = ТипФайлаТабличногоДокумента.PDF;
	ИмяВложения = "Заявка на пусконаладку " + ДокументСсылка.Номер + Формат;
	ИмяВременногоФайла = ПутьКВФ + ИмяВложения;
	ТабДок.Записать(ИмяВременногоФайла, ТипФайла);

	Вложения = Новый Массив;
	Вложение = Новый Структура;
	Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайла);
	Вложение.Вставить("Представление", ИмяВложения);
	Вложения.Добавить(Вложение);
	//-- #1330 смарт: Фролов 23.03.2023
		
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021
		//++ #1330 смарт: Фролов 23.03.2023 //Доработать уведомление инженера о назначениие ПНР (добавить файл PDF)	
		//ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма); 
		ДанныеОтправки = Новый Структура("Тема,Заголовок,Вложения", ТемаПисьма, ТекстПисьма,Вложения);
		//-- #1330 смарт: Фролов 23.03.2023
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо по заявке на пусконаладку " + НомерДокумента + " НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
			Иначе
			//-- смарт:ММ 03.03.2021
				
			ТекстСообщения = "Отправлено письмо по заявке на пусконаладку " + НомерДокумента + " на почту " +  АдресаДляОтправкиСтрокой;
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			КонецЕсли;
			//-- смарт:ММ 03.03.2021
				
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Успех = Истина;
		Исключение
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ДокументСсылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить письмо по заявке на пусконаладку "  + НомерДокумента + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецПопытки;
	КонецЕсли; 
	//++ #1330 смарт: Фролов 23.03.2023 //Доработать уведомление инженера о назначениие ПНР (добавить файл PDF)
	Попытка
		Для Каждого Вложение Из Вложения Цикл
			УдалитьФайлы(Вложение.АдресВоВременномХранилище);
		КонецЦикла;			
	Исключение
	КонецПопытки;		
    //-- #1330 смарт: Фролов 23.03.2023
	
	Возврат Успех;
	
КонецФункции

Функция ОтправитьУведомлениеОСменеСтатуса(ДокументСсылка, МассивСообщений = Неопределено) Экспорт
	
	Успех = Ложь;
	
	Если МассивСообщений = Неопределено Тогда
		МассивСообщений = Новый Массив;
	КонецЕсли;
	
	Статус = ДокументСсылка.Статус;
	
	СтатусПолученаВРаботу 		= Перечисления.смартСтатусыЗаявокНаПускоНаладку.ПолученаВРаботу;
	СтатусСозвонилисьСКлиентом 	= Перечисления.смартСтатусыЗаявокНаПускоНаладку.СозвонилисьСКлиентом;
	СтатусНазначенИнженер 		= Перечисления.смартСтатусыЗаявокНаПускоНаладку.НазначенИнженер;
	СтатусВыполнена 			= Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена;
	// ++ 05.05.2021
	СтатусТребуетКорректировки 	= Перечисления.смартСтатусыЗаявокНаПускоНаладку.ТребуетКорректировки;
	// --
	
	Если Статус <> СтатусПолученаВРаботу
		И Статус <> СтатусСозвонилисьСКлиентом
		И Статус <> СтатусНазначенИнженер
		// ++ 05.05.2021 
		И Статус <> СтатусТребуетКорректировки
		// --
		И Статус <> СтатусВыполнена Тогда
		Возврат Успех;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Успех;
	КонецЕсли;

	Ответственный 	= ДокументСсылка.Ответственный;
	НомерДокумента 	= ДокументСсылка.Номер;
	Контрагент 		= ДокументСсылка.Контрагент;
	
	// ++ 28.06.2020
	Оборудование 	= ДокументСсылка.Оборудование;
	
	ТекстОборудование = "";
	Для Каждого Строка Из Оборудование Цикл
		ТекстОборудование = ТекстОборудование + ?(ЗначениеЗаполнено(ТекстОборудование), Символы.ПС, "") + Строка.Оборудование;
	КонецЦикла;
	//
	
	ТемаПисьма = "Смена статуса заявки на пусконаладку № " + НомерДокумента;
	
	Если Статус = СтатусПолученаВРаботу Тогда
		ТекстПисьма = "Заявка на пусконаладку № " + НомерДокумента + " находится в работе.";
	ИначеЕсли Статус = СтатусСозвонилисьСКлиентом Тогда
		ТекстПисьма = "По заявке на пусконаладку № " + НомерДокумента + " состоялся созвон с клиентом.";
	ИначеЕсли Статус = СтатусНазначенИнженер Тогда
		ТекстПисьма = "По заявке на пусконаладку № " + НомерДокумента + " назначен инженер.";
	ИначеЕсли Статус = СтатусВыполнена Тогда
		ТекстПисьма = "По заявке на пусконаладку № " + НомерДокумента + " все работы проведены, заявка закрыта.";
	// ++ 05.05.2021
	ИначеЕсли Статус = СтатусТребуетКорректировки Тогда
	   	ТемаПисьма = "Корректировка заявки на пусконаладку № " + НомерДокумента;
		ТекстПисьма = "Необходимо откорректировать заявку на пусконаладку № " + НомерДокумента + " в связи с предоставлением неактуальных, недостоверных и/или неполных данных.";
	// --
	КонецЕсли;
		
	// ++ 28.06.2020
	ТекстПисьма = ТекстПисьма + Символы.ПС + Символы.ПС + "Контрагент: " + Контрагент 
	+ Символы.ПС + Символы.ПС + "Оборудование: " + ТекстОборудование;
	// --
		 
	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = ПолучитьАдресОтветственного(Ответственный, АдресаДляОтправкиСтрокой);
	
	Если Статус = СтатусВыполнена Тогда
		МассивДополнительныхАдресов = ПолучитьДополнительныеАдресаДляУведомленияОЗакрытииЗаявки(АдресаДляОтправкиСтрокой);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивАдресовДляОтправки, МассивДополнительныхАдресов, Истина);
	КонецЕсли;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
	//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
	//-- смарт:ММ 03.03.2021

		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
		//ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		//-- смарт:ММ 03.03.2021
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо по заявке на пусконаладку " + НомерДокумента + " НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
			Иначе
			//-- смарт:ММ 03.03.2021
					
			ТекстСообщения = "Отправлено письмо по заявке на пусконаладку " + НомерДокумента + " на почту " +  АдресаДляОтправкиСтрокой;
			
			//++ смарт:ММ #098 464 03.03.2021 Доработка рассылок на тестовые адреса
			КонецЕсли;
			//-- смарт:ММ 03.03.2021
		
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Успех = Истина;
		Исключение 
			//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,ДокументСсылка,ТекстПисьма);
			//-- #1416 смарт: Фролов 30.08.2023
			ТекстСообщения = "Не удалось отправить письмо по заявке на пусконаладку "  + НомерДокумента + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецПопытки;
	КонецЕсли;

	Возврат Успех;	
	
КонецФункции

Функция ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой = "") 
	
	// Пользователи из смартПредопределенныеЗначения
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(смартПредопределенныеЗначения.Значение КАК Справочник.Пользователи) КАК Пользователь
	|ПОМЕСТИТЬ ВТ_ПользователиДляОтправки
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
	|	И НЕ смартПредопределенныеЗначения.СписокЗначений
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(смартПредопределенныеЗначенияЗначения.Значение КАК Справочник.Пользователи)
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенноеЗначение
	|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
	|
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ВТ_ПользователиДляОтправки.Пользователь.смартРабочаяПочта = """"
	|			ТОГДА ЕСТЬNULL(ПользователиКонтактнаяИнформация.Представление, """")
	|		ИНАЧЕ ВТ_ПользователиДляОтправки.Пользователь.смартРабочаяПочта
	|	КОНЕЦ КАК Значение
	|ИЗ
	|	ВТ_ПользователиДляОтправки КАК ВТ_ПользователиДляОтправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|		ПО ПользователиКонтактнаяИнформация.Ссылка = ВТ_ПользователиДляОтправки.Пользователь
	|			И (ПользователиКонтактнаяИнформация.Вид = &ПочтаПользователя)";
	
	Запрос.УстановитьПараметр("ПочтаПользователя", 	Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	Запрос.УстановитьПараметр("ПредопределенноеЗначение", Справочники.смартПредопределенныеЗначения.ПользователиДляОповещенияОЗаявкахНаПускоНаладку);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.Значение);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции

Функция ПолучитьДополнительныеАдресаДляУведомленияОЗакрытииЗаявки(АдресаДляОтправкиСтрокой = "")
	
