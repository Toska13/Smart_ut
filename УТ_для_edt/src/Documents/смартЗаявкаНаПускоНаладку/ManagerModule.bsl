//++ #Б-6888 смарт: Фролов 19.05.2026 //Оповещения инженеров о назначении на заявку ПНР
Функция ОтправитьУведомлениеИнженеру(Параметры, МассивСообщений = Неопределено, ВыводитьСообщения = Ложь, ОтправлятьСМС = Ложь) Экспорт
	
	ДокументСсылка 	= Параметры.Ссылка;
	Пользователь 	= Параметры.Пользователь;
	ВидУведомления = Параметры.ВидУведомления;

	Если МассивСообщений = Неопределено Тогда
		МассивСообщений = Новый Массив;
	КонецЕсли;
	
	Успех = Ложь;
	
	АдресаДляОтправкиСтрокой = "";
	НомерДокумента 	= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументСсылка.Номер);
	ДатаДокумента 	= ДокументСсылка.Дата;
	Контрагент 		= ДокументСсылка.Контрагент;
	Оборудование 	= ДокументСсылка.Оборудование;
	
	ТекстОборудование = "";
	Для Каждого Строка Из Оборудование Цикл
		
		ТекущееОборудование = Строка.ОборудованиеКлиентов;

		ТекстОборудование = ТекстОборудование + ?(ЗначениеЗаполнено(ТекстОборудование), Символы.ПС, "") + ТекущееОборудование;
		
	КонецЦикла;
	
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ПараметрыОтправки = Новый Структура;
	ПараметрыОтправки.Вставить("УчетнаяЗапись", УчетнаяЗапись);
	ПараметрыОтправки.Вставить("НомерДокумента", НомерДокумента);
	
	ПредставлениеДокумента = СформироватьПредставлениеДокумента(ДокументСсылка);
	
	МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(Пользователь, АдресаДляОтправкиСтрокой);	
	
	ТемаПисьма = ПредставлениеДокумента;
		
	ПараметрыОтправки.Вставить("ТемаПисьма", ТемаПисьма);
	ПараметрыОтправки.Вставить("МассивАдресовДляОтправки", МассивАдресовДляОтправки);
	ПараметрыОтправки.Вставить("АдресаДляОтправкиСтрокой", АдресаДляОтправкиСтрокой);
		
	Если ВидУведомления = "Назначение" Тогда

		ТекстПисьма = "Вы назначены на выполнение работ по заявке на ПНР № " + НомерДокумента 
		+ ". Период исполнения заявки с " + Формат(Параметры.НазначеннаяДатаЗапускаС, "ДФ=dd.MM.yyyy") + " по " + Формат(Параметры.НазначеннаяДатаЗапускаПо, "ДФ=dd.MM.yyyy") 
		+ ". Бланк заявки во вложении к письму. Пожалуйста, изучите заявку и свяжитесь с клиентом в течение 15 минут с момента получения.";

		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ДокументСсылка);
		СписокОбъектов = Новый СписокЗначений;
		СписокОбъектов.Добавить(ДокументСсылка);
		ДокументРезультат = ПечатьЗаявкаНаПускоНаладку(МассивОбъектов, СписокОбъектов);
		
		Если ДокументРезультат.ВысотаТаблицы = 0 Тогда
			МассивСообщений.Добавить("Ошибка при формировании и отправке инженеру печатной формы заявки на ПНР");
		Иначе
			
			// Формирование вложения
			Вложения = Новый Массив;
			Вложение = Новый Структура;
			
			ПутьКВФ = КаталогВременныхФайлов();
			Формат = ".pdf";
			ТипФайла = ТипФайлаТабличногоДокумента.PDF;
			
			ИмяВложения = "" + ПредставлениеДокумента + Формат;
			ИмяВременногоФайла = ПутьКВФ + ИмяВложения;
			ДокументРезультат.Записать(ИмяВременногоФайла, ТипФайла);
			
			Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайла);
			Вложение.Вставить("Представление", ИмяВложения);
			
			Вложения.Добавить(Вложение);

			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.Ссылка КАК Ссылка,
			|	смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.Расширение КАК Расширение,
			|	смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.ПутьКФайлу КАК ПутьКФайлу,
			|	смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.ФайлХранилище КАК ФайлХранилище,
			|	смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.Наименование КАК Наименование
			|ИЗ
			|	Справочник.смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы КАК смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы
			|ГДЕ
			|	НЕ смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.ПометкаУдаления
			|	И смартЗаявкаНаПускоНаладкуПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла";
			
			Запрос.УстановитьПараметр("ВладелецФайла", ДокументСсылка);
						
			ВыборкаФайл = Запрос.Выполнить().Выбрать();
			
			Пока ВыборкаФайл.Следующий() Цикл
				
				Вложение = Новый Структура;
				
				Формат = "." + ВыборкаФайл.Расширение;

				ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ВыборкаФайл.Ссылка);
				
				Если ДвоичныеДанные = Неопределено Тогда
					Продолжить;
				КонецЕсли;			
				
				ПредставлениеДокумента = ВыборкаФайл.Наименование;
				ИмяВложения = "" + ПредставлениеДокумента + Формат;
				ИмяВременногоФайла = ПутьКВФ + ИмяВложения;
				ДвоичныеДанные.Записать(ИмяВременногоФайла);
				
				Вложение.Вставить("АдресВоВременномХранилище", ИмяВременногоФайла);
				Вложение.Вставить("Представление", ИмяВложения);
				
				Вложения.Добавить(Вложение);
				
			КонецЦикла;
			
		КонецЕсли;
			
		ПараметрыОтправки.Вставить("ТекстПисьма", ТекстПисьма);
		ПараметрыОтправки.Вставить("Вложения", Вложения);
		
		Успех = ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений);
		
		Если Успех Тогда
			МассивСообщений.Добавить("     Отправлено уведомление инженеру о назначении на заявку на ПНР");

			Если ОтправлятьСМС Тогда
				
				ТекстСообщения = "Проверьте почту. Для вас есть новая заявка на ПНР:";
				
				ТекстСообщения = ТекстСообщения + " № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"); 
				
				Результат = смартОбщегоНазначения.ОтправитьСМСПользователю(Пользователь, ТекстСообщения);
				
				Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					МассивСообщений.Добавить("		Не удалось отправить SMS инженеру: " + Результат.ОписаниеОшибки);
				Иначе
					МассивСообщений.Добавить("		Отправлено SMS инженеру");
				КонецЕсли;

			КонецЕсли;

		Иначе
			МассивСообщений.Добавить("     Ошибка при отправке уведомления инженеру о назначении на заявку на ПНР");
		КонецЕсли;

		Попытка
			Для Каждого Вложение Из Вложения Цикл
				УдалитьФайлы(Вложение.АдресВоВременномХранилище);
			КонецЦикла;			
		Исключение
		КонецПопытки;		
		
	ИначеЕсли ВидУведомления = "Отмена" Тогда
		
		ТекстПисьма = "Для вас отменены работы по заявке на ПНР № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		ПараметрыОтправки.Вставить("ТекстПисьма", ТекстПисьма);

		Успех = ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений);
	
		Если Успех Тогда
			МассивСообщений.Добавить("     Отправлено уведомление инженеру об отмене заявки на ПНР");

			Если ОтправлятьСМС Тогда
				
				ТекстСообщения = "Проверьте почту. Для вас есть новая заявка на ПНР"; 
				

				ТекстСообщения = ТекстСообщения + " № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yyyy"); 

				
				Результат = смартОбщегоНазначения.ОтправитьСМСПользователю(Пользователь, ТекстСообщения);
				
				Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					МассивСообщений.Добавить("		Не удалось отправить SMS инженеру: " + Результат.ОписаниеОшибки);
				Иначе
					МассивСообщений.Добавить("		Отправлено SMS инженеру");
				КонецЕсли;
				
			КонецЕсли;

		Иначе
			МассивСообщений.Добавить("     Ошибка при отправке уведомления инженеру об отмене заявки на ПНР");
		КонецЕсли;

	Иначе
		Возврат Успех;
	КонецЕсли;
	
	Если НЕ ВыводитьСообщения Тогда
		МассивСообщений.Очистить();
	КонецЕсли;
	
КонецФункции //-- #Б-6888 смарт: Фролов 19.05.2026

//++ #Б-6888 смарт: Фролов 19.05.2026 //Оповещения инженеров о назначении на заявку ПНР
Функция ОтправитьУведомлениеАдресатам(ПараметрыОтправки, МассивСообщений)
	
	Успех = Ложь;
	
	МассивАдресовДляОтправки = ПараметрыОтправки.МассивАдресовДляОтправки;
	УчетнаяЗапись 	= ПараметрыОтправки.УчетнаяЗапись;
	ТемаПисьма 		= ПараметрыОтправки.ТемаПисьма;
	ТекстПисьма 	= ПараметрыОтправки.ТекстПисьма;
	АдресаДляОтправкиСтрокой = ПараметрыОтправки.АдресаДляОтправкиСтрокой;
	НомерДокумента = ПараметрыОтправки.НомерДокумента;
	
	Вложения = Неопределено;
	Если ПараметрыОтправки.Свойство("Вложения") Тогда
		Вложения = ПараметрыОтправки.Вложения;
	КонецЕсли;
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();

	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
		
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		ТестоваяБаза = ПараметрыПисьма.ТестоваяБаза;
		ТестовыеАдреса = ПараметрыПисьма.ТестовыеАдреса;
		
		Если ЗначениеЗаполнено(Вложения) Тогда
			ПараметрыПисьма.Вставить("Вложения", Вложения);
		КонецЕсли;
		
		Попытка
			
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			
			Если ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо по заявке на ПНР №" + НомерДокумента + " на ТЕСТОВУЮ почту " + ТестовыеАдреса + " (в рабочей базе отправилось бы на адрес " +  АдресаДляОтправкиСтрокой + ")";
			Иначе
				ТекстСообщения = "Отправлено письмо по заявке на ПНР №" + НомерДокумента + " на почту " +  АдресаДляОтправкиСтрокой;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			Успех = Истина;
			
		Исключение
			
			Если ТестоваяБаза Тогда
				ТекстСообщения = "Не удалось отправить письмо по заявке на ПНР №"  + НомерДокумента + " на ТЕСТОВУЮ почту " + ТестовыеАдреса + " (в рабочей базе был бы адрес " +  АдресаДляОтправкиСтрокой + ")" + Символы.ПС + ОписаниеОшибки();
			Иначе
				ТекстСообщения = "Не удалось отправить письмо по заявке на ПНР №"  + НомерДокумента + Символы.ПС + ОписаниеОшибки();
			КонецЕсли;

			смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,,ТекстПисьма);

			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
			МассивСообщений.Добавить(ТекстСообщения);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции //-- #Б-6888 смарт: Фролов 19.05.2026

//++ #Б-6888 смарт: Фролов 19.05.2026 //Оповещения инженеров о назначении на заявку ПНР
Функция СформироватьПредставлениеДокумента(ДокументСсылка)
	
