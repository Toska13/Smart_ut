Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаявкаНаПускоНаладку") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ЗаявкаНаПускоНаладку",
				НСтр("ru = 'Заявка на пусконаладку'"),
				ПечатьЗаявкаНаПускоНаладку(МассивОбъектов, ОбъектыПечати));
				
	//++ #Б-7128 смарт: Фролов 11.06.2026 //Создать печатную форму Служебной Записки			
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартСлужебноеЗадание") Тогда
				
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартСлужебноеЗадание",
				НСтр("ru = 'Служебное задание'"),
				ПечатьСлужебноеЗадание(МассивОбъектов, ОбъектыПечати));
	//-- #Б-7128 смарт: Фролов 11.06.2026			

	КонецЕсли;
			
	СборкаТоваровЛокализация.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

//++ #Б-7128 смарт: Фролов 11.06.2026 //Создать печатную форму Служебной Записки
Функция ПечатьСлужебноеЗадание(МассивОбъектов, ОбъектыПечати)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаПускоНаладку.Ссылка КАК Ссылка,
	|	смартЗаявкаНаПускоНаладку.Номер КАК Номер,
	|	смартЗаявкаНаПускоНаладку.Дата КАК Дата,
	|	смартЗаявкаНаПускоНаладку.Партнер КАК Партнер,
	|	смартЗаявкаНаПускоНаладку.Контрагент КАК Контрагент,
	|	смартЗаявкаНаПускоНаладку.АдресВыезда КАК АдресВыезда,
	|	смартЗаявкаНаПускоНаладку.АдресВыездаЗначенияПолей КАК АдресВыездаЗначенияПолей,
	|	смартЗаявкаНаПускоНаладку.Ответственный КАК Ответственный,
	|	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер КАК НазначенныйНаЗапускИнженер,
	|	смартЗаявкаНаПускоНаладку.Представительство КАК Представительство,
	|	смартЗаявкаНаПускоНаладку.Маркетинг КАК Маркетинг,
	|	смартЗаявкаНаПускоНаладку.НазначенныйНаЗапускИнженер2 КАК НазначенныйНаЗапускИнженер2,
	|	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС КАК НазначеннаяДатаЗапускаС,
	|	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаС2 КАК НазначеннаяДатаЗапускаС2,
	|	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо КАК НазначеннаяДатаЗапускаПо,
	|	смартЗаявкаНаПускоНаладку.НазначеннаяДатаЗапускаПо2 КАК НазначеннаяДатаЗапускаПо2,
	|	смартЗаявкаНаПускоНаладку.Командировка КАК Командировка,
	|	смартЗаявкаНаПускоНаладку.АдресВыездаЗначение КАК АдресВыездаЗначение,
	|	смартЗаявкаНаПускоНаладку.ДатаВыполнения КАК ДатаВыполнения,
	|	смартЗаявкаНаПускоНаладку.ОтветственныйСЦ КАК ОтветственныйСЦ,
	|	смартЗаявкаНаПускоНаладку.Инженер КАК Инженер,
	|	смартЗаявкаНаПускоНаладку.Оборудование.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		Оборудование КАК Оборудование,
	|		ГарантийныйСрокНаОборудование КАК ГарантийныйСрокНаОборудование,
	|		ГарантийныйСрокНаПечатающиеГоловки КАК ГарантийныйСрокНаПечатающиеГоловки,
	|		РастровыйПроцессор КАК РастровыйПроцессор,
	|		КонфигурацияЧернил КАК КонфигурацияЧернил,
	|		ДатаОтгрузки КАК ДатаОтгрузки,
	|		Серия КАК Серия,
	|		ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	|		ТипЧернилОборудование КАК ТипЧернилОборудование,
	|		ОборудованиеКлиентов КАК ОборудованиеКлиентов,
	|		СрокДополнительнойГарантии КАК СрокДополнительнойГарантии,
	|		ДатаНачалаДополнительнойГарантии КАК ДатаНачалаДополнительнойГарантии
	|	) КАК Оборудование
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
	|ГДЕ
	|	смартЗаявкаНаПускоНаладку.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМекет.смартСлужебноеЗадание");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_смартСлужебноеЗадание";
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");

	ПервыйДокумент = Истина;
	ВыборкаДокументы = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДокументы.Следующий() Цикл		
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
		
		ОбластьШапка.Параметры.СтранаГород = ВыборкаДокументы.АдресВыезда;
		ОбластьШапка.Параметры.ФИО = ВыборкаДокументы.НазначенныйНаЗапускИнженер.ФизическоеЛицо.Наименование;
		ОбластьШапка.Параметры.Должность = ВыборкаДокументы.НазначенныйНаЗапускИнженер.ФизическоеЛицо.смартДолжность;
		ОбластьШапка.Параметры.ТабельныйНомер = ВыборкаДокументы.НазначенныйНаЗапускИнженер.ФизическоеЛицо.смартТабельныйНомер;
		ОбластьШапка.Параметры.Подразделение = ВыборкаДокументы.НазначенныйНаЗапускИнженер.Подразделение;
		ОбластьШапка.Параметры.Клиент = ВыборкаДокументы.Контрагент.Наименование;
		ОбластьШапка.Параметры.ДатаНачала = ВыборкаДокументы.НазначеннаяДатаЗапускаС;
		ОбластьШапка.Параметры.ДатаОкончания = ВыборкаДокументы.НазначеннаяДатаЗапускаПо;
		ДатаСоставленияПредварительная = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ВыборкаДокументы.НазначеннаяДатаЗапускаС, 1, "Назад");
		ОбластьШапка.Параметры.ДатаСоставления = ?(ДатаСоставленияПредварительная < ВыборкаДокументы.Дата, ВыборкаДокументы.Дата, ДатаСоставленияПредварительная);
		ОбластьШапка.Параметры.ДатаВозврата = НачалоДня(ВыборкаДокументы.НазначеннаяДатаЗапускаС) + 86400 * 25;
		ОбластьШапка.Параметры.КоличествоДней = (КонецДня(ВыборкаДокументы.НазначеннаяДатаЗапускаПо) - НачалоДня(ВыборкаДокументы.НазначеннаяДатаЗапускаС) + 1) / 86400;
		
		// Вывод оборудования
		ВыборкаОборудование = ВыборкаДокументы.Оборудование.Выбрать();
		
		НомерПП = 1; 
		
		Цель = "Запуск оборудования ";
		
		Пока ВыборкаОборудование.Следующий() Цикл
			
			Цель = Цель + ?(Цель = "Запуск оборудования ", "", Символы.ПС) + ВыборкаОборудование.ОборудованиеКлиентов.Наименование;
			
		КонецЦикла;
		
		ОбластьШапка.Параметры.Цель = Цель;

		ТабДокумент.Вывести(ОбластьШапка);
		// Подвал
		
		Если ЗначениеЗаполнено(ВыборкаДокументы.НазначенныйНаЗапускИнженер2) Тогда
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
			
			ОбластьШапка.Параметры.ФИО = ВыборкаДокументы.НазначенныйНаЗапускИнженер2.ФизическоеЛицо.Наименование;
			ОбластьШапка.Параметры.Должность = ВыборкаДокументы.НазначенныйНаЗапускИнженер2.ФизическоеЛицо.смартДолжность;
			ОбластьШапка.Параметры.ТабельныйНомер = ВыборкаДокументы.НазначенныйНаЗапускИнженер2.ФизическоеЛицо.смартТабельныйНомер;
			ОбластьШапка.Параметры.Подразделение = ВыборкаДокументы.НазначенныйНаЗапускИнженер2.Подразделение;
			ДатаСоставленияПредварительная = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ВыборкаДокументы.НазначеннаяДатаЗапускаС2, 1, "Назад");
			ОбластьШапка.Параметры.ДатаСоставления = ?(ДатаСоставленияПредварительная < ВыборкаДокументы.Дата, ВыборкаДокументы.Дата, ДатаСоставленияПредварительная);
			ОбластьШапка.Параметры.ДатаНачала = ВыборкаДокументы.НазначеннаяДатаЗапускаС2;
			ОбластьШапка.Параметры.ДатаОкончания = ВыборкаДокументы.НазначеннаяДатаЗапускаПо2;
			ОбластьШапка.Параметры.ДатаВозврата = НачалоДня(ВыборкаДокументы.НазначеннаяДатаЗапускаС2) + 86400 * 25;
			ОбластьШапка.Параметры.КоличествоДней = (КонецДня(ВыборкаДокументы.НазначеннаяДатаЗапускаПо2) 
				- НачалоДня(ВыборкаДокументы.НазначеннаяДатаЗапускаС2) + 1) / 86400;
			
			ТабДокумент.Вывести(ОбластьШапка);
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабДокумент;
	
КонецФункции //-- #Б-7128 смарт: Фролов 11.06.2026

Функция ПечатьЗаявкаНаПускоНаладку(МассивОбъектов, ОбъектыПечати)
		
	ЗапросПоДокументам = Новый Запрос;
	ЗапросПоДокументам.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаПускоНаладку.Ссылка КАК Ссылка,
	|	смартЗаявкаНаПускоНаладку.Номер КАК Номер,
	|	смартЗаявкаНаПускоНаладку.Дата КАК Дата,
	// ++ 03.12.2020
	|	смартЗаявкаНаПускоНаладку.ДокументОснование,
	// ++ 24.03.2021
	|	смартЗаявкаНаПускоНаладку.Ответственный КАК Менеджер,
	// --
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(смартЗаявкаНаПускоНаладку.Контрагент) КАК Контрагент,
	|	смартЗаявкаНаПускоНаладку.АдресВыезда КАК АдресВыезда,
	|	смартЗаявкаНаПускоНаладку.НомерТелефонаКонтрагента КАК НомерТелефонаКонтрагента,
	|	смартЗаявкаНаПускоНаладку.ПереченьНеобходимыхРабот КАК ПереченьНеобходимыхРабот,
	|	смартЗаявкаНаПускоНаладку.ПостроениеЦветовыхПрофилей КАК ПостроениеЦветовыхПрофилей,
	|	смартЗаявкаНаПускоНаладку.ДокументыОтКлиента КАК ДокументыОтКлиента,
	|	смартЗаявкаНаПускоНаладку.ЖелаемаяДатаИнсталляции КАК ЖелаемаяДатаИнсталляции,
	|	смартЗаявкаНаПускоНаладку.КтоОплачиваетВыездСИ КАК КтоОплачиваетВыездСИ,
	|	смартЗаявкаНаПускоНаладку.КомментарийМенеджера КАК КомментарийМенеджера,
	|	смартЗаявкаНаПускоНаладку.КонтактныеЛица.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ПРЕДСТАВЛЕНИЕ(КонтактноеЛицо) КАК КонтактноеЛицо,
	|		ТелефонКонтактногоЛица КАК ТелефонКонтактногоЛица,
	|		АдресЭПКонтактногоЛица КАК АдресЭПКонтактногоЛица
	|	) КАК КонтактныеЛица,
	|	смартЗаявкаНаПускоНаладку.Оборудование.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	//++ смарт:ММ 04.10.2020
	|		ПРЕДСТАВЛЕНИЕ(Серия) КАК Серия,
	//-- смарт:ММ 04.10.2020
	|		ПРЕДСТАВЛЕНИЕ(Оборудование) КАК Оборудование,
	|		ГарантийныйСрокНаОборудование КАК ГарантийныйСрокНаОборудование,
	|		ГарантийныйСрокНаПечатающиеГоловки КАК ГарантийныйСрокНаПечатающиеГоловки,
	|		ПРЕДСТАВЛЕНИЕ(РастровыйПроцессор) КАК РастровыйПроцессор,
	|		ПРЕДСТАВЛЕНИЕ(ТипЧернилОборудование) КАК ТипЧернил,
	|		ПРЕДСТАВЛЕНИЕ(КонфигурацияЧернил) КАК КонфигурацияЧернил
	|	) КАК Оборудование,
	//++ #1328 смарт: Фролов 21.03.2023 //Добавить спецификацию оборудования iECHO в Заявку на пусконаладку
	|	смартЗаявкаНаПускоНаладку.Комплектующие.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ПРЕДСТАВЛЕНИЕ(НаименованиеКомплектующей) КАК НаименованиеКомплектующей,
	|		Количество КАК Количество,
	|		Цена КАК Цена,
	|		Стоимость КАК Стоимость
	|	) КАК Комплектующие
	//-- #1328 смарт: Фролов 21.03.2023
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку КАК смартЗаявкаНаПускоНаладку
	|ГДЕ
	|	смартЗаявкаНаПускоНаладку.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	ЗапросПоДокументам.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
		
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_смартЗаявкаНаПускоНаладку";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.смартЗаявкаНаПускоНаладку.ПФ_MXL_ЗаявкаНаПускоНаладку");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьОборудованиеШапка = Макет.ПолучитьОбласть("ОборудованиеШапка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ПервыйДокумент = Истина;
	ВыборкаДокументы = ЗапросПоДокументам.Выполнить().Выбрать();
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаДокументы);
		ОбластьШапка.Параметры.Дата = Формат(ВыборкаДокументы.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		// ++ 03.12.2020
		ЗаказКлиента = ВыборкаДокументы.ДокументОснование;
		Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
			ОбластьШапка.Параметры.ТекстЗаказКлиента = "Заказ клиента №" + ЗаказКлиента.Номер + " от " + Формат(ЗаказКлиента.Дата, "ДФ='dd.MM.yyyy ""г.""'")
		КонецЕсли;
		// --
		ТабДокумент.Вывести(ОбластьШапка);		
		
		// Вывод контактных лиц
		ВыборкаКонтактныеЛица = ВыборкаДокументы.КонтактныеЛица.Выбрать();
		
		Сч = 0;
		ОбластьКонтактныеЛица = Неопределено;
		НомерПП = 1;
		
		Пока ВыборкаКонтактныеЛица.Следующий() Цикл
			
			Сч = Сч + 1;
			
			Если Сч = 3 Тогда
				Сч = 1;
			КонецЕсли;
			
			Если Сч = 1 Тогда
				ОбластьКонтактныеЛица = Макет.ПолучитьОбласть("КонтактныеЛица|КолонкаЛево");
				ОбластьКонтактныеЛица.Параметры.НомерКЛ = НомерПП;
				ОбластьКонтактныеЛица.Параметры.КонтактноеЛицо = ВыборкаКонтактныеЛица.КонтактноеЛицо;
				ОбластьКонтактныеЛица.Параметры.ТелефонКонтактногоЛица = ВыборкаКонтактныеЛица.ТелефонКонтактногоЛица;
				ОбластьКонтактныеЛица.Параметры.АдресЭПКонтактногоЛица = ВыборкаКонтактныеЛица.АдресЭПКонтактногоЛица;
				ТабДокумент.Вывести(ОбластьКонтактныеЛица);
			Иначе
				ОбластьКонтактныеЛица = Макет.ПолучитьОбласть("КонтактныеЛица|КолонкаПраво");
				ОбластьКонтактныеЛица.Параметры.НомерКЛ2 = НомерПП;
				ОбластьКонтактныеЛица.Параметры.КонтактноеЛицо2 = ВыборкаКонтактныеЛица.КонтактноеЛицо;
				ОбластьКонтактныеЛица.Параметры.ТелефонКонтактногоЛица2 = ВыборкаКонтактныеЛица.ТелефонКонтактногоЛица;
				ОбластьКонтактныеЛица.Параметры.АдресЭПКонтактногоЛица2 = ВыборкаКонтактныеЛица.АдресЭПКонтактногоЛица;	
				ТабДокумент.Присоединить(ОбластьКонтактныеЛица);
			КонецЕсли;
									
			НомерПП = НомерПП + 1;
		КонецЦикла;
				
		// Вывод оборудования
		ТабДокумент.Вывести(ОбластьОборудованиеШапка);
		
		ВыборкаОборудование = ВыборкаДокументы.Оборудование.Выбрать();
		
		НомерПП = 1;
		
		Пока ВыборкаОборудование.Следующий() Цикл
			
			ОбластьОборудование = Макет.ПолучитьОбласть("Оборудование");
			ОбластьОборудование.Параметры.НомерПП = НомерПП;
			ЗаполнитьЗначенияСвойств(ОбластьОборудование.Параметры, ВыборкаОборудование);
			
			//++ смарт:ММ 04.10.2020
			Если ЗначениеЗаполнено(ВыборкаОборудование.Серия) Тогда
				ОбластьОборудование.Параметры.Оборудование = ВыборкаОборудование.Оборудование + Символы.ПС + "Серия: " + ВыборкаОборудование.Серия;
			КонецЕсли;
			//-- смарт:ММ 04.10.2020
			
			ТабДокумент.Вывести(ОбластьОборудование);

			НомерПП = НомерПП + 1;			
		КонецЦикла;
			
		//++ #1328 смарт: Фролов 21.03.2023 //Добавить спецификацию оборудования iECHO в Заявку на пусконаладку  
		ВыборкаКомплектующие = ВыборкаДокументы.Комплектующие.Выбрать();
		НомерПП = 1;
		Если ВыборкаКомплектующие.Количество()>0 Тогда
			ОбластьСпецификацияШапка = Макет.ПолучитьОбласть("СпецификацияШапка");
			ТабДокумент.Вывести(ОбластьСпецификацияШапка); 
		КонецЕсли;	
		Пока ВыборкаКомплектующие.Следующий() Цикл
			
			ОбластьСпецификацияСтрока = Макет.ПолучитьОбласть("СпецификацияСтрока");
			ЗаполнитьЗначенияСвойств(ОбластьСпецификацияСтрока.Параметры, ВыборкаКомплектующие);
			ОбластьСпецификацияСтрока.Параметры.НомерПП = НомерПП;
			ТабДокумент.Вывести(ОбластьСпецификацияСтрока); 
			НомерПП = НомерПП + 1;
		КонецЦикла; 
		Если ВыборкаКомплектующие.Количество()>0 Тогда
			ОбластьСпецификацияПодвал = Макет.ПолучитьОбласть("СпецификацияПодвал");
			ТабДокумент.Вывести(ОбластьСпецификацияПодвал); 
		КонецЕсли;	
		//-- #1328 смарт: Фролов 21.03.2023
		
		// Подвал
		ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, ВыборкаДокументы);
		ТабДокумент.Вывести(ОбластьПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
