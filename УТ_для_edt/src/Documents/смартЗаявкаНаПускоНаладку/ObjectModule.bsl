			НавСсылка = ПолучитьНавигационнуюСсылку(Ссылка);
			
			ТекстПисьма = Символы.ПС + "Завершена пусконаладка оборудования - акт подписан: " + Формат(ДатаПодписанияАктаПНР, "ДФ=dd.MM.yyyy");
