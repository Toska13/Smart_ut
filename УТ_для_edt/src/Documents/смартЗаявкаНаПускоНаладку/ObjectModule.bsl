//++ #Б-3180 смарт: Лопато 18.07.2025 //Лицензии IECHO. Отражение в учетной программе. 
Процедура АктивироватьЛицензииПО(Ссылка, ТаблицаОборудование);
	
	УстановитьПривилегированныйРежим(Истина);
	
	СегментIECHOСЛицензиейПНР = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "IECHOСЛицензиейПНР"); 

	Если НЕ ЗначениеЗаполнено(СегментIECHOСЛицензиейПНР) Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	ТаблицаОборудование.Колонки.Добавить("Заявка", Новый ОписаниеТипов("ДокументСсылка.смартЗаявкаНаПускоНаладку"));
	ТаблицаОборудование.ЗаполнитьЗначения(Ссылка, "Заявка");
	
	Запрос.УстановитьПараметр("ТаблицаЗаявка", ТаблицаОборудование);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗаявка.Заявка КАК Заявка,
	|	ТаблицаЗаявка.Оборудование КАК Номенклатура,
	|	ТаблицаЗаявка.Серия КАК Серия,
	|	ТаблицаЗаявка.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР
	|ПОМЕСТИТЬ ВТ_ТаблицаЗаявкаВрем
	|ИЗ
	|	&ТаблицаЗаявка КАК ТаблицаЗаявка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заявка КАК Заявка,
	|	Номенклатура КАК Номенклатура,
	|	Серия КАК Серия,
	|	СпрСерииНоменклатуры.Номер КАК СерияНомер,
	|	ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР
	|ПОМЕСТИТЬ ВТ_ТаблицаЗаявка
	|ИЗ
	|	ВТ_ТаблицаЗаявкаВрем
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_ТаблицаЗаявкаВрем.Номенклатура = СпрНоменклатура.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииНоменклатуры КАК СпрСерииНоменклатуры
	|		ПО ВТ_ТаблицаЗаявкаВрем.Серия = СпрСерииНоменклатуры.Ссылка
	|ГДЕ
	|	Заявка <> ЗНАЧЕНИЕ(Документ.смартЗаявкаНаПускоНаладку.ПустаяСсылка)
	|	И Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И Серия <> ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|	И ДатаПодписанияАктаНаПНР <> ДАТАВРЕМЯ(1, 1, 1)
	|	И СпрНоменклатура.ВидНоменклатуры.ИспользоватьСерии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заявка КАК Заявка,
	|	Номенклатура КАК Номенклатура,
	|	Серия КАК Серия,
	|	ТипЛицензии КАК ТипЛицензии,
	|	Период КАК Период,
	|	ДатаОкончания КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТ_ТаблицаЛицензииПО
	|ИЗ
	|	РегистрСведений.смартЛицензииПО.СрезПоследних(
	|			,
	|			(Заявка, Номенклатура, Серия) В
	|				(ВЫБРАТЬ
	|					ВТ_ТаблицаЗаявка.Заявка,
	|					ВТ_ТаблицаЗаявка.Номенклатура,
	|					ВТ_ТаблицаЗаявка.Серия
	|				ИЗ
	|					ВТ_ТаблицаЗаявка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТаблицаЗаявка.Заявка КАК Заявка,
	|	ВТ_ТаблицаЗаявка.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаЗаявка.Серия КАК Серия,
	|	ВТ_ТаблицаЗаявка.СерияНомер КАК СерияНомер,
	|	ВТ_ТаблицаЗаявка.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	|	ВТ_ТаблицаЛицензииПО.Период КАК Период
	|ИЗ
	|	ВТ_ТаблицаЗаявка КАК ВТ_ТаблицаЗаявка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТаблицаЛицензииПО КАК ВТ_ТаблицаЛицензииПО
	|		ПО (ВТ_ТаблицаЗаявка.Заявка = ВТ_ТаблицаЛицензииПО.Заявка)
	|			И (ВТ_ТаблицаЗаявка.Номенклатура = ВТ_ТаблицаЛицензииПО.Номенклатура)
	|			И (ВТ_ТаблицаЗаявка.Серия = ВТ_ТаблицаЛицензииПО.Серия)
	|ГДЕ
	|	ВТ_ТаблицаЛицензииПО.Период ЕСТЬ NULL";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
				
		ТЗНоменклатураСегментаIECHOСЛицензиейПНР = СегментыСервер.СписокЭлементовСКД(СегментIECHOСЛицензиейПНР);
		МасОборудованиеIECHOСЛицензиейПНР = ТЗНоменклатураСегментаIECHOСЛицензиейПНР.ВыгрузитьКолонку("ЭлементСписка");

		Выборка = РезультатЗапроса.Выбрать();

		Пока Выборка.Следующий() Цикл

			Если МасОборудованиеIECHOСЛицензиейПНР.Найти(Выборка.Номенклатура) <> Неопределено Тогда
				
				//Создаем запись лицензии
				МенеджерЗаписиЛицензии = РегистрыСведений.смартЛицензииПО.СоздатьМенеджерЗаписи();
					
				МенеджерЗаписиЛицензии.Заявка 		 = Выборка.Заявка;
				МенеджерЗаписиЛицензии.Номенклатура  = Выборка.Номенклатура;
				МенеджерЗаписиЛицензии.Серия 		 = Выборка.Серия;
				МенеджерЗаписиЛицензии.СерийныйНомер = Выборка.СерияНомер;
				МенеджерЗаписиЛицензии.Период 		 = Выборка.ДатаПодписанияАктаНаПНР;
				МенеджерЗаписиЛицензии.ДатаОкончания = МенеджерЗаписиЛицензии.Период + 30 * 24 * 60 * 60;
				МенеджерЗаписиЛицензии.ТипЛицензии   = Перечисления.смартТипыЛицензии.Временная;

				МенеджерЗаписиЛицензии.Записать();
				
			КонецЕсли;	
				
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-3180 смарт: Лопато 18.07.2025

