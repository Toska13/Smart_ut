				//
				//Если НЕ ЗначениеЗаполнено(РассчитаннаяДата) Тогда
				
				//rnp надо бы делать проверку на заполненность произв. календаря, но...
				
				//Если ПроизводственныйКалендарьНеЗаполнен  Тогда
				//	Отказ = Истина;
				//	Возврат;
				//КонецЕсли;
				//т.к. на 3 года вперед календарь точно не будет заполнен, то в регистр пишем просто дату ТО, не расчетную

					//МассивДат = Новый Массив;
					//МассивДат.Добавить(ДатаТОУКлиента);
					//
					//
					//					
					//ДатыБлижайшихРабочихДней = КалендарныеГрафики.ДатыБлижайшихРабочихДней(График, МассивДат, Истина,,Истина);
					//РассчитаннаяДата = ДатыБлижайшихРабочихДней.Получить(ДатаТОУКлиента);
				//КонецЕсли;
				
				Движение.ДатаТОУКлиента = ?(ЗначениеЗаполнено(РассчитаннаяДата), РассчитаннаяДата, ДатаТОУКлиента);
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры //-- смарт:ММ 23.03.2021

//++ #Б-3550 смарт: Фролов 16.06.2025 //Оптимизация прохождения по этапам воронки для документов ЗПР
