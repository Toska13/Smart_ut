#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ПометкаУдаления 
		И УведомлениеОтправлено Тогда 
		Успех = ОтправитьУведомление("ОтменаПроведения");
		Если Успех Тогда
			УведомлениеОтправлено = Ложь;
			ЭтотОбъект.УстановитьПометкуУдаления(Истина);
			//ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;
	
	// ++ 25.03.2021
	Если ЭтоНовый() Тогда
		Для Каждого Строка Из Оборудование Цикл
			Если НЕ ЗначениеЗаполнено(Строка.ОборудованиеКлиентов) Тогда
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю("В строке " + Строка.НомерСтроки + " не заполнена колонка ""Оборудование клиента""");
			КонецЕсли;		
		КонецЦикла;	
	КонецЕсли;
	//--
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийСтатус", Перечисления.смартСтатусыЗаявокНаПускоНаладку.ПустаяСсылка());
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийСтатус", Ссылка.Статус);
	КонецЕсли;

	//++ #1887 смарт: Мосолов 03.07.2024 //Доработать документы сервисного центра. Затраченное время.
	Если Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена Тогда  
		
		ДатаНачалаОтраженияВремени = Справочники.смартПредопределенныеЗначения.ДатаНачалаОтраженияЗатраченногоИнженерамиВремени.Значение;
		
		Если ЗначениеЗаполнено(ДатаНачалаОтраженияВремени) 
			И ДатаНачалаОтраженияВремени <= Дата Тогда
			
			Если (ЗначениеЗаполнено(НазначенныйНаЗапускИнженер) И ЗатраченоЧасов = 0)
				ИЛИ (ЗначениеЗаполнено(НазначенныйНаЗапускИнженер2) И ЗатраченоЧасов2 = 0) Тогда
				
				ВызватьИсключение НСтр("ru = 'Укажите затраченное инженерами время!'");
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	//-- #1887 смарт: Мосолов 03.07.2024 
	
	//++ #Б3428 смарт: Шляпников 28.05.2025 / Заявка на пусконаладку. Доработка.
	Если НЕ Отказ И НЕ ЗначениеЗаполнено(ДатаВыполнения) Тогда
		
		Если Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена
			ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно
			ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.КлиентЗапустилОборудованиеСамостоятельно Тогда
			
			ДатаВыполнения = ТекущаяДатаСеанса();
			
		КонецЕсли;
		
	ИначеЕсли НЕ Отказ И ЗначениеЗаполнено(ДатаВыполнения) Тогда
		
		Если НЕ (Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена
			ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно
			ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.КлиентЗапустилОборудованиеСамостоятельно) Тогда
			
			ДатаВыполнения = Дата(1, 1, 1);
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #Б3428 смарт: Шляпников 28.05.2025
	
	//++ #Б-3550 смарт: Фролов 16.06.2025 //Оптимизация прохождения по этапам воронки для документов ЗПР
	Если НЕ Командировка = Ссылка.Командировка Тогда
		
		ДополнительныеСвойства.Вставить("ТребуетсяОформлениеКомандировки", Истина);
		
	КонецЕсли;
	//-- #Б-3550 смарт: Фролов 16.06.2025
	
	//++ #Б-6888 смарт: Фролов 19.05.2026 //Оповещения инженеров о назначении на заявку ПНР
	ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер", Ложь);
	ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер2", Ложь);
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийСтатус", Перечисления.смартСтатусыЗаявокНаПускоНаладку.ПустаяСсылка());
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартСсылкаПроведен", Ложь);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер2", Истина);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер", Справочники.Пользователи.ПустаяСсылка());
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер2", Справочники.Пользователи.ПустаяСсылка());
	Иначе
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийСтатус", Ссылка.Статус);
		ЭтотОбъект.ДополнительныеСвойства.Вставить("смартСсылкаПроведен", Ссылка.Проведен);
		
		Если НазначенныйНаЗапускИнженер <> Ссылка.НазначенныйНаЗапускИнженер Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер", Истина);
			ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер", Ссылка.НазначенныйНаЗапускИнженер);
		КонецЕсли;
		
		Если НазначенныйНаЗапускИнженер2 <> Ссылка.НазначенныйНаЗапускИнженер2 Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("смартИзменилсяИнженер2", Истина);
			ЭтотОбъект.ДополнительныеСвойства.Вставить("смартПредыдущийИнженер2", Ссылка.НазначенныйНаЗапускИнженер2);
		КонецЕсли;

	КонецЕсли;
	//-- #Б-6888 смарт: Фролов 19.05.2026
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		//++ #1390 смарт: Фролов 04.07.2023 //Снятие ограничений для Полных прав  
		Если НЕ РольДоступна("ПолныеПрава") Тогда 
			Если НЕ смартОбщегоНазначения.смартЗаказКлиентаОтгруженОформлен(ДанныеЗаполнения) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! По заказу оформлены не все документы отгрузки. Заявку на пусконаладку можно создать только для полностью отгруженного заказа.");
				Возврат;
			КонецЕсли;
		КонецЕсли;	
		//++#1336 смарт: Лопато 04.04.2023 //Ограничение создания заявки на ПНР (только после полной отгрузки)  
		//Если НЕ смартОбщегоНазначения.смартЗаказКлиентаОтгруженОформлен(ДанныеЗаполнения) Тогда
		//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! По заказу оформлены не все документы отгрузки. Заявку на пусконаладку можно создать только для полностью отгруженного заказа.");
		//	Возврат;
		//КонецЕсли;	
		//--#1336 смарт: Лопато 04.04.2023
		//-- #1390 смарт: Фролов 04.07.2023 
		
		ДокументОснование = ДанныеЗаполнения;
		Партнер 	= ДанныеЗаполнения.Партнер;
		Контрагент 	= ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		Статус 		= Перечисления.смартСтатусыЗаявокНаПускоНаладку.Размещена;
		Ответственный = ПараметрыСеанса.ТекущийПользователь;		
				
		//++ смарт:ММ #093 449 04.02.2021 - Доработка Заявки на ПНР
		Если ДанныеЗаполнения.смартПродажаЧерезДилера Тогда
			
			// Контрагент и контактные лица не заполняются
			
			ИзменитьКонтрагентаИКлиентаВРучномРежиме = Истина;
			
			Партнер = ДанныеЗаполнения.смартКонечныйПокупатель;
			Контрагент = Неопределено;
			
		Иначе

		//-- смарт:ММ 05.02.2021
		
		ЗаполнитьРеквизитыПоКонтрагенту();

		// Контактные лица
		
		Если ЗначениеЗаполнено(ДанныеЗаполнения.КонтактноеЛицо) Тогда
			
			НоваяСтрока = КонтактныеЛица.Добавить();
			НоваяСтрока.КонтактноеЛицо = ДанныеЗаполнения.КонтактноеЛицо;
			
			СтруктураДанныеКонтактногоЛица = ПолучитьДанныеКонтактногоЛица(НоваяСтрока.КонтактноеЛицо);			
			НоваяСтрока.ТелефонКонтактногоЛица = СтруктураДанныеКонтактногоЛица.Телефон;
			НоваяСтрока.АдресЭПКонтактногоЛица = СтруктураДанныеКонтактногоЛица.ЭлПочта;
			
		КонецЕсли;
		
		//++ смарт:ММ #093 449 05.02.2021 - Доработка Заявки на ПНР
		КонецЕсли;
		//-- смарт:ММ 04.02.2021
					
		// Оборудование
		
		ГарантийныйСрокНаОборудование = Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаОборудованиеПоУмолчанию.Значение;		
		ГарантийныйСрокНаПечатающиеГоловки = Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаПечатающиеГоловкиПоУмолчанию.Значение;
		РастровыйПроцессор = Справочники.смартПредопределенныеЗначения.РастровыйПроцессорПоУмолчанию.Значение;
		
		ЗапросОборудование = Новый Запрос;
		//++ #1847 смарт: Фролов 10.06.2024 //Оборудование в Заявке на ПНР:
		//ЗапросОборудование.Текст = ПолучитьТекстЗапросаОборудованиеИзЗаказаКлиента();
		ЗапросОборудование.Текст = ПолучитьТекстЗапросаОборудованиеИзЗаказаКлиента(Истина);
		//-- #1847 смарт: Фролов 10.06.2024
		ЗапросОборудование.УстановитьПараметр("ТоварПлоттерыСерии", Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение);
		ЗапросОборудование.УстановитьПараметр("ЗаказКлиента", ДокументОснование);
		ЗапросОборудование.УстановитьПараметр("ОтборНоменклатура", Ложь);
		ЗапросОборудование.УстановитьПараметр("Номенклатура", Неопределено);
		
		Выборка = ЗапросОборудование.Выполнить().Выбрать();
		
		//++ смарт:ММ #094 411 07.02.2021
		МассивНоменклатураОборудование = Новый Массив;
		//-- смарт:ММ 07.02.2021
		
		Пока Выборка.Следующий() Цикл
			
			//++ смарт:ММ #090 436 30.12.2020 - Фоновое изменение заявки на пусконаладку при изменении заказа клиента
			Если Выборка.Отменено Тогда
				Продолжить;
			КонецЕсли;
			//-- смарт:ММ 30.12.2020
			
			НоваяСтрока = Оборудование.Добавить();
			НоваяСтрока.Оборудование 						= Выборка.Номенклатура;

			//++ #Б-2768 смарт: Лопато 21.03.2025 //Заполнение корректного срока гарантии на оборудование и ПГ при формировании ПНР.  
			СтруктураГарантияНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСтрока.Оборудование, "смартГарантияНаОборудование, смартГарантияНаПечатающиеГоловки");
			
			НоваяСтрока.ГарантийныйСрокНаОборудование 		= ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаОборудование), 
																СтруктураГарантияНоменклатуры.смартГарантияНаОборудование, 
																ГарантийныйСрокНаОборудование);

			НоваяСтрока.ГарантийныйСрокНаПечатающиеГоловки	= ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки), 
																СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки, 
																ГарантийныйСрокНаПечатающиеГоловки);
			//-- #Б-2768 смарт: Лопато 21.03.2025

			НоваяСтрока.РастровыйПроцессор 					= РастровыйПроцессор;
			НоваяСтрока.ДатаОтгрузки 						= Выборка.ДатаОтгрузки;
			//++ смарт:ММ 04.10.2020
			НоваяСтрока.Серия 								= Выборка.Серия;
			//-- смарт:ММ 04.10.2020
			//++ смарт:ММ #094 411 07.02.2021
			НоваяСтрока.ОборудованиеКлиентов 				= Выборка.смартСоответствиеСОбрудованиемИЧерниламиКлиентов;
			МассивНоменклатураОборудование.Добавить(НоваяСтрока.Оборудование);
			//-- смарт:ММ 07.02.2021
			
		КонецЦикла;
		
		//++ смарт:ММ #094 411 07.02.2021
		// Дозаполнение чернил из Заказа клиента в уже добавленные строки с оборудованием
		ЗапросОборудование.Текст = ПолучитьТекстЗапросаЧернилаИзЗаказаКлиента();
		ЗапросОборудование.УстановитьПараметр("СписокОборудования", МассивНоменклатураОборудование);
		
		ВыборкаЧернила = ЗапросОборудование.Выполнить().Выбрать();
		
		СсылкаНаПредопределенныйСправочник = Справочники.смартПредопределенныеЗначения.ОборудованиеГруппаЧернила;
		
		ГруппаЧернила = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(СсылкаНаПредопределенныйСправочник, Ложь);
				
		Если ЗначениеЗаполнено(ГруппаЧернила) Тогда
			
			Пока ВыборкаЧернила.Следующий() Цикл
				// Проверка, является ли чернилами
				ЭтоЧернила = ВыборкаЧернила.смартСоответствиеСОбрудованиемИЧерниламиКлиентов.ПринадлежитЭлементу(ГруппаЧернила);
				
				Если НЕ ЭтоЧернила Тогда
					Продолжить;
				КонецЕсли;
				
				НайденныйТипЧернилОборудование = ВыборкаЧернила.смартСоответствиеСОбрудованиемИЧерниламиКлиентов;
				
				// Первый найденный тип чернил подставляется во все строки
				Для Каждого ТекСтрока Из Оборудование Цикл
					ТекСтрока.ТипЧернилОборудование = НайденныйТипЧернилОборудование;	
				КонецЦикла;
				
				// Дальше строки не обрабатываются
				Прервать; 
				
			КонецЦикла;
		КонецЕсли;
		//-- смарт:ММ 07.02.2021
		//++ #1328 смарт: Фролов 21.03.2023 //Добавить спецификацию оборудования iECHO в Заявку на пусконаладку 
		Если ТипЗнч(ДокументОснование)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Если ТипЗнч(ДокументОснование.ДокументОснование)=Тип("ДокументСсылка.смартIECHOСпецификация") Тогда		
				Запрос=Новый Запрос("ВЫБРАТЬ
				                    |	смартIECHOСпецификацияКомплектующие.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
				                    |	смартIECHOСпецификацияКомплектующие.Количество КАК Количество,
				                    |	смартIECHOСпецификацияКомплектующие.Цена КАК Цена,
				                    |	смартIECHOСпецификацияКомплектующие.Стоимость КАК Стоимость
				                    |ИЗ
				                    |	Документ.смартIECHOСпецификация.Комплектующие КАК смартIECHOСпецификацияКомплектующие
				                    |ГДЕ
				                    |	смартIECHOСпецификацияКомплектующие.Ссылка = &Ссылка
				                    |	И НЕ смартIECHOСпецификацияКомплектующие.НаименованиеКомплектующей.ОсновнаяКомплектующая");
				Запрос.УстановитьПараметр("Ссылка",ДокументОснование.ДокументОснование);
				Рез=Запрос.Выполнить().Выгрузить();
				Комплектующие.Загрузить(Рез);
			КонецЕсли;
		КонецЕсли;	
		//-- #1328 смарт: Фролов 21.03.2023
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	УведомлениеОтправлено = Ложь;
	Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДокументОснование = Неопределено;
	Статус = Неопределено;
	
	//++ #Б-2726 смарт: Лопато 19.03.2025 //Новая ветка ТГ Бота - Документ Заявка на ПНР.  
	РезультатОтправлен = Ложь;
	КоличествоПостроенныхЦветовыхПрофилей = 0;
	КоличествоПостроенныхКартСтола = 0;
	ПроблемаСУпаковкой = Неопределено;
	ДатаПодписанияАктаПНР = Неопределено;
	ЗамечанияСоСтороныЗаказчика = "";
	ЗамечанияСоСтороныИнженера = "";
	//-- #Б-2726 смарт: Лопато 19.03.2025

	//++ #Б-2804 смарт: Лопато 28.03.2025 //ТГ Бот. Добавить в ЗНР и ПНР возможность выбора операционной системы клиента.  
	ОСКлиента = Неопределено;
	//-- #Б-2804 смарт: Лопато 28.03.2025
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	//++ смарт:ММ #099 409 23.03.2021 Регламентное обслуживание
	ОтразитьсмартТехническоеОбслуживаниеОборудованияПоКлиентам();
	//-- смарт:ММ 23.03.2021

	//++ смарт:ММ #094 411 07.02.2021
	НеОтправлятьУведомления = Ложь;
	Если ДополнительныеСвойства.Свойство("НеОтправлятьУведомления") = Истина Тогда
		НеОтправлятьУведомления = ДополнительныеСвойства.НеОтправлятьУведомления;
	КонецЕсли;
	
	Если НЕ НеОтправлятьУведомления Тогда
	//-- смарт:ММ 07.02.2021
	
	// ++ 05.05.2021
	ПовторноеРазмещение = Ложь;
	// --
	
	Если ДополнительныеСвойства.Свойство("смартПредыдущийСтатус") = Истина 
		И ДополнительныеСвойства.смартПредыдущийСтатус <> Статус Тогда
		
		МассивСообщений = Новый Массив;
		Документы.смартЗаявкаНаПускоНаладку.ОтправитьУведомлениеОСменеСтатуса(Ссылка, МассивСообщений);
		
		Для Каждого Сообщение Из МассивСообщений Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		КонецЦикла;
		
		// ++ 05.05.2021
		Если ДополнительныеСвойства.смартПредыдущийСтатус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ТребуетКорректировки Тогда
			ПовторноеРазмещение = Истина;
		КонецЕсли;
		// --
		
		Если Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ОтправленаВПредставительство Тогда
			
			// Уведомление руководителю подразделения (представительства)
			Успех = ОтправитьУведомление("ПроведениеСоСтатусомОтправленаВПредставительство");
			
		КонецЕсли;
		
		//++ #Б-2282 смарт: Фролов 11.03.2025 //Оповещение руководителей при назначении новому партнеру менеджера по расходке
		Если Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена Тогда
			
			Если ЗначениеЗаполнено(Партнер) Тогда
				
				Если НЕ ЗначениеЗаполнено(Партнер.смартМенеджерПоРасходнымМатериалам) 
					ИЛИ Партнер.смартМенеджерПоРасходнымМатериалам = Партнер.ОсновнойМенеджер Тогда
					
					Если ЗначениеЗаполнено(Партнер.БизнесРегион) Тогда
						
						БизнесРегионВерхнегоУровня = смартОбщегоНазначения.НайтиРегионВерхнегоУровня(Партнер.БизнесРегион);
						
						Если ЗначениеЗаполнено(БизнесРегионВерхнегоУровня) Тогда
							
							БизнесРегионЦФО = Справочники.смартПредопределенныеЗначения.ЦентральныйФО.Значение;
							
							НайденноеПредставительство = БизнесРегионВерхнегоУровня.смартОтветственоеПодразделение; 
							
							Запрос = Новый Запрос(
							"ВЫБРАТЬ РАЗЛИЧНЫЕ
							|	Пользователь КАК Менеджер
							|ПОМЕСТИТЬ МенеджерыПоРасходке
							|ИЗ
							|	Справочник.смартКвалификацииМенеджеров.Пользователи
							|ГДЕ
							|	Пользователь.Подразделение = &НайденноеПредставительство
							|	И Ссылка.ТипПродукта = &Расходка
							|;
							|
							|////////////////////////////////////////////////////////////////////////////////
							|ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	МенеджерыПоРасходке.Менеджер КАК Менеджер,
							|	СУММА(ЕСТЬNULL(ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиОборот, 0)) КАК СуммаВыручки
							|ИЗ
							|	МенеджерыПоРасходке КАК МенеджерыПоРасходке
							|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&ДатаНачала, &ДатаОкончания, Период, 
							|		) КАК ВыручкаИСебестоимостьПродажОбороты
							|		ПО МенеджерыПоРасходке.Менеджер = ВыручкаИСебестоимостьПродажОбороты.Менеджер
							|
							|СГРУППИРОВАТЬ ПО
							|	МенеджерыПоРасходке.Менеджер
							|
							|УПОРЯДОЧИТЬ ПО
							|	СуммаВыручки");
							Запрос.УстановитьПараметр("ДатаНачала", ДобавитьМесяц(ТекущаяДата(), -30));
							Запрос.УстановитьПараметр("ДатаОкончания", ТекущаяДата());
							Запрос.УстановитьПараметр("Расходка", Справочники.смартТипыПродуктов.Расходка); 
							Запрос.УстановитьПараметр("НайденноеПредставительство", НайденноеПредставительство);
							
							Выборка = Запрос.Выполнить().Выбрать();
							
							Если Выборка.Следующий() Тогда
								
								УчетнаяЗаписьПочты = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
								
								ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
								ТестовыеАдресаСтрока = "";
								ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
								
								Если БизнесРегионВерхнегоУровня = БизнесРегионЦФО ИЛИ НЕ ЗначениеЗаполнено(Партнер.смартМенеджерПоРасходнымМатериалам) Тогда
									
									АдресаДляОтправкиСтрокой = "";
									МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(Выборка.Менеджер, АдресаДляОтправкиСтрокой);
									
									МассивАдресовДляОтправкиКопии = Новый Массив;
									АдресаДляОтправкиСтрокойКопии = "";
									
									ГоловнойОфисМосква=Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение;
									ПодразделениеПользователя = Выборка.Менеджер.Подразделение;
									
									Если ЗначениеЗаполнено(ПодразделениеПользователя) И НЕ ПодразделениеПользователя = ГоловнойОфисМосква Тогда	
										
										Если ЗначениеЗаполнено(ПодразделениеПользователя.ТекущийРуководитель) Тогда
											
											МассивАдресовДляОтправкиКопии = смартОбщегоНазначения.ПолучитьАдресПользователяПоФизЛицу(ПодразделениеПользователя.ТекущийРуководитель
											, АдресаДляОтправкиСтрокойКопии);	
											
										КонецЕсли;
										
									КонецЕсли;
									
									МассивАдресов = Справочники.смартПредопределенныеЗначения.Настройки.ПолучателиРассылокПоРасходнымМатериалам.ВыгрузитьКолонку("АдресПочты");	
									
									Для Каждого ЭлементАдрес Из МассивАдресов Цикл
										
										АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(ЭлементАдрес);
										
										Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
											
											Если НЕ ЗначениеЗаполнено(ЭлементСтруктуры.ОписаниеОшибки) Тогда
												
												МассивАдресовДляОтправкиКопии.Добавить(Новый Структура("Адрес, Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
												АдресаДляОтправкиСтрокойКопии = АдресаДляОтправкиСтрокойКопии 
												+ ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокойКопии), ", ", "") + ЭлементСтруктуры.Адрес;
												
											КонецЕсли;	
											
										КонецЦикла;
										
									КонецЦикла;
									
									ОбПартнер = Партнер.ПолучитьОбъект();
									НавСсылка = ПолучитьНавигационнуюСсылку(ОбПартнер);
									ТекстПисьма = "";
									
									ТемаПисьма = "Пользователь назначен менеджером по РМ!";
									
									ТекстПисьма = Символы.ПС + "Менеджер: " + Выборка.Менеджер + Символы.ПС;
									ТекстПисьма = ТекстПисьма + "назначен основным менеджером по расходным материалам партнера: " + Партнер + Символы.ПС;
									ТекстПисьма = ТекстПисьма + "Ссылка на партнера: " + НавСсылка + Символы.ПС;
									
									Если ЗначениеЗаполнено(УчетнаяЗаписьПочты)
										И (ТестовыеАдресаМассив.Количество() > 0
										ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
										
										ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
										ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, МассивАдресовДляОтправкиКопии, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
										
										Попытка
											
											ОбПартнер.смартМенеджерПоРасходнымМатериалам = Выборка.Менеджер;
											ОбПартнер.Записать();
											
											ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗаписьПочты, ПараметрыПисьма);
											
										Исключение
											
											ТекстСообщения = "Не удалось отправить письмо, полльзователю " + Выборка.Менеджер 
											+ " по назначению ответственным по РМ партнера " + Партнер + Символы.ПС + ОписаниеОшибки(); 
											ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
											
										КонецПопытки;
										
									КонецЕсли;
									
								ИначеЕсли ЗначениеЗаполнено(Партнер.смартМенеджерПоРасходнымМатериалам)
									И НЕ Выборка.Менеджер = Партнер.смартМенеджерПоРасходнымМатериалам Тогда
									
									МассивАдресовДляОтправки = Новый Массив;
									АдресаДляОтправкиСтрокой = "";
									
									ГоловнойОфисМосква=Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение;
									ПодразделениеПользователя = Выборка.Менеджер.Подразделение;
									
									Если ЗначениеЗаполнено(ПодразделениеПользователя) И НЕ ПодразделениеПользователя = ГоловнойОфисМосква Тогда	
										
										Если ЗначениеЗаполнено(ПодразделениеПользователя.ТекущийРуководитель) Тогда
											
											МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресПользователяПоФизЛицу(ПодразделениеПользователя.ТекущийРуководитель
											, АдресаДляОтправкиСтрокой);	
											
										КонецЕсли;
										
									КонецЕсли;
									
									МассивАдресов = Справочники.смартПредопределенныеЗначения.Настройки.ПолучателиРассылокПоРасходнымМатериалам.ВыгрузитьКолонку("АдресПочты");	
									
									Для Каждого ЭлементАдрес Из МассивАдресов Цикл
										
										АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(ЭлементАдрес);
										
										Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
											
											Если НЕ ЗначениеЗаполнено(ЭлементСтруктуры.ОписаниеОшибки) Тогда
												
												МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
												АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой 
												+ ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
												
											КонецЕсли;	
											
										КонецЦикла;
										
									КонецЦикла;
									
									ОбПартнер = Партнер.ПолучитьОбъект();
									НавСсылка = ПолучитьНавигационнуюСсылку(ОбПартнер);
									ТекстПисьма = "";
									
									ТемаПисьма = "Рекомендуемая замена менеджера по РМ!";
									
									ТекстПисьма = Символы.ПС + "Основной менедждер: " + Партнер.ОсновнойМенеджер + Символы.ПС;
									ТекстПисьма = Символы.ПС + "Основной менедждер по РМ: " + Партнер.смартМенеджерПоРасходнымМатериалам + Символы.ПС;
									ТекстПисьма = ТекстПисьма + "Основываясь на данных по загрузке менеджеров, рекомендуем менеджера по РМ: " + Выборка.Менеджер + Символы.ПС;
									ТекстПисьма = ТекстПисьма + "Ссылка на партнера: " + НавСсылка + Символы.ПС;
									
									Если ЗначениеЗаполнено(УчетнаяЗаписьПочты)
										И (ТестовыеАдресаМассив.Количество() > 0
										ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
										
										ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
										ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, , ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
										
										Попытка
											
											ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗаписьПочты, ПараметрыПисьма);
											
										Исключение
											
											ТекстСообщения = "Не удалось отправить письмо, полльзователю " + Выборка.Менеджер 
											+ " по рекомендации назначения ответственным по РМ партнера " + Партнер + Символы.ПС + ОписаниеОшибки(); 
											ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
											
										КонецПопытки;
										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;	
							
						КонецЕсли;	
						
					КонецЕсли;	
					
				КонецЕсли;	
				
			КонецЕсли;	
				
		КонецЕсли;
		//-- #Б-2282 смарт: Фролов 11.03.2025
		
		//++ #Б-3180 смарт: Лопато 18.07.2025 //Лицензии IECHO. Отражение в учетной программе. 
		Если НЕ Отказ
			И (Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена
			   ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно) Тогда
			   
			АктивироватьЛицензииПО(Ссылка, Оборудование.Выгрузить(, "Оборудование, Серия, ДатаПодписанияАктаНаПНР"));
			
		КонецЕсли;
		//-- #Б-3180 смарт: Лопато 18.07.2025
		
	КонецЕсли;
	
	Если НЕ УведомлениеОтправлено 
		// ++ 05.05.2021
		ИЛИ ПовторноеРазмещение 
		// --
		Тогда
		Успех = ОтправитьУведомление("Проведение");
		Если Успех Тогда
			// Повторная запись объекта для изменения реквизита
			УведомлениеОтправлено = Истина;
			ЭтотОбъект.ОбменДанными.Загрузка = Истина;
			ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
	КонецЕсли;

	//++ смарт:ММ #094 411 07.02.2021
	КонецЕсли;
	//-- смарт:ММ 07.02.2021
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	Если НЕ ПометкаУдаления Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заявка не отменена. Для отмены пометьте заявку на удаление");	
	КонецЕсли;
	
КонецПроцедуры

