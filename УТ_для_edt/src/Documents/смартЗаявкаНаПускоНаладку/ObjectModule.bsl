			МесяцевДобавить = СоответствиеКоличествоМесяцев.Получить(Выборка.СрокЗамены);
					
			Если МесяцевДобавить <> 0 Тогда
				
				ДатаТОУКлиента = ДобавитьМесяц(ДатаПодписанияАктаНаПНР, МесяцевДобавить);
				
				РассчитаннаяДата = Неопределено;
