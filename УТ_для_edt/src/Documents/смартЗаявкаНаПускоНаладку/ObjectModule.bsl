Процедура ОтразитьсмартТехническоеОбслуживаниеОборудованияПоКлиентам()
	
	Движения.смартТехническоеОбслуживаниеОборудованияПоКлиентам.Записывать = Истина;
	
	Если Статус <> Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена Тогда
		Движения.смартТехническоеОбслуживаниеОборудованияПоКлиентам.Очистить();
		Возврат;
	КонецЕсли;
	
	СоответствиеКоличествоМесяцев = Новый Соответствие; 
	//++ #Б-1606 смарт: Ермаков 06.12.2024 / Сроки замены запчастей (смарт). Дополнения.
	СоответствиеКоличествоМесяцев.Вставить(ПредопределенноеЗначение("Перечисление.смартСрокиЗаменыЗапчастей.Три"), 3);
	//-- #Б-1606 смарт: Ермаков 06.12.2024
	СоответствиеКоличествоМесяцев.Вставить(ПредопределенноеЗначение("Перечисление.смартСрокиЗаменыЗапчастей.Шесть"), 6);
	СоответствиеКоличествоМесяцев.Вставить(ПредопределенноеЗначение("Перечисление.смартСрокиЗаменыЗапчастей.Двенадцать"), 12);
	СоответствиеКоличествоМесяцев.Вставить(ПредопределенноеЗначение("Перечисление.смартСрокиЗаменыЗапчастей.ТридцатьШесть"), 36);
	СоответствиеКоличествоМесяцев.Вставить(ПредопределенноеЗначение("Перечисление.смартСрокиЗаменыЗапчастей.Шестьдесят"), 60);

	График = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
	
	Для Каждого СтрокаОборудование Из Оборудование Цикл
		
		ДатаПодписанияАктаНаПНР = СтрокаОборудование.ДатаПодписанияАктаНаПНР;
		
		Если НЕ ЗначениеЗаполнено(ДатаПодписанияАктаНаПНР) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекОборудование = СтрокаОборудование.ОборудованиеКлиентов;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартТехническоеОбслуживаниеОборудования.Оборудование КАК Оборудование,
		|	смартТехническоеОбслуживаниеОборудования.Запчасть КАК Запчасть,
		|	смартТехническоеОбслуживаниеОборудования.СрокЗамены КАК СрокЗамены,
		|	смартТехническоеОбслуживаниеОборудования.Количество КАК Количество
		|ИЗ
		|	РегистрСведений.смартТехническоеОбслуживаниеОборудования КАК смартТехническоеОбслуживаниеОборудования
		|ГДЕ
		|	смартТехническоеОбслуживаниеОборудования.Оборудование = &Оборудование";
		
