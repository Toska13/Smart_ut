					ЗадачаОбъект.Описание = "Необходимо оформить командировку по заявке на пуско-наладке " + Ссылка;
					ЗадачаОбъект.Наименование = "Необходимо оформить командировку по заявке на пуско-наладке";
					ЗадачаОбъект.Автор = Пользователи.ТекущийПользователь();
					ЗадачаОбъект.СрокИсполнения = ЗадачаОбъект.Дата + 86400;
					ЗадачаОбъект.Записать();
					
