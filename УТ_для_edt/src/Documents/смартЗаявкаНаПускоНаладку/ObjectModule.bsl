		//ОбИнтерес.ТипУслуги = Справочники.CRM_ТипУслуги.ПусконаладкаПусконаладкаОборудования;
		//ОбИнтерес.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		//ОбИнтерес.смартВоронкаНовые = Истина;
		//ОбИнтерес.Тема = "Заявка на ПНР " + Ссылка.Партнер + " от " + ТекущаяДата();
