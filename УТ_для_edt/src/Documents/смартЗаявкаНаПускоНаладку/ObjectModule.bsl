		КонецЕсли;	
		
	КонецЕсли;
	
	//++ #Б-5954 смарт: Фролов 25.03.2026 //Автозадачи. Звонок после ПНР
	Если (Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена
		ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно
		ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.КлиентЗапустилОборудованиеСамостоятельно) 
		И НачалоДня(ДатаПодписанияАктаПНР) <= НачалоДня(ТекущаяДата()) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Документ.CRM_Взаимодействие
