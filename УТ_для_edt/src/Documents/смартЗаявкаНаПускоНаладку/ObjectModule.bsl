		//ОбИнтерес.смартИнтересКанал = Справочники.смартПредопределенныеЗначения.Настройки.КаналДляРемонтныхРабот;
		//ОбИнтерес.смартИнтересИсточник = Справочники.смартПредопределенныеЗначения.Настройки.ИсточникДляРемонтныхРабот;
		//ОбИнтерес.ЦенаВключаетНДС = Истина;
