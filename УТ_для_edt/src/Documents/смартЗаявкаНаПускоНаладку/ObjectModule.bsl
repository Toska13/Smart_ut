		//	ОбИнтерес.Подразделение = Ссылка.ОтветственныйСЦ.Подразделение;
		//	ОбИнтерес.Офис = Ссылка.ОтветственныйСЦ.Подразделение.CRM_офис;
		//	
		//КонецЕсли;
		//
		//ОбИнтерес.Записать(РежимЗаписиДокумента.Запись);
