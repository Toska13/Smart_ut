	|ГДЕ
	|	НЕ CRM_Интерес.ПометкаУдаления
	|	И CRM_Интерес.ДокументОснование = &ЗРР");
	Запрос.УстановитьПараметр("ЗРР", Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
