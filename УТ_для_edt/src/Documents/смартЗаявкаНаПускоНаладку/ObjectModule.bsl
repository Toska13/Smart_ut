Процедура ЗаполнитьРеквизитыПоКонтрагенту() Экспорт
	
	АдресВыезда = "";
	АдресВыездаЗначенияПолей = "";
	НомерТелефонаКонтрагента = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияАдрес.Представление, """") КАК АдресВыезда,
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияАдрес.ЗначенияПолей, """") КАК АдресВыездаЗначенияПолей
	|ПОМЕСТИТЬ ВТ_Адрес
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияАдрес
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформацияАдрес.Ссылка = &Контрагент
	|	И КонтрагентыКонтактнаяИнформацияАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И КонтрагентыКонтактнаяИнформацияАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КонтрагентыКонтактнаяИнформацияТелефон.Представление, """") КАК НомерТелефонаКонтрагента
	|ПОМЕСТИТЬ ВТ_Телефон
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияТелефон
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформацияТелефон.Ссылка = &Контрагент
	|	И КонтрагентыКонтактнаяИнформацияТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтрагентыКонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_Адрес.АдресВыезда, """") КАК АдресВыезда,
	|	ЕСТЬNULL(ВТ_Адрес.АдресВыездаЗначенияПолей, """") КАК АдресВыездаЗначенияПолей,
	|	ЕСТЬNULL(ВТ_Телефон.НомерТелефонаКонтрагента, """") КАК НомерТелефонаКонтрагента
	|ИЗ
	|	ВТ_Адрес КАК ВТ_Адрес
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_Телефон КАК ВТ_Телефон
	|		ПО (ИСТИНА)";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		АдресВыезда = Выборка.АдресВыезда;
		АдресВыездаЗначенияПолей = Выборка.АдресВыездаЗначенияПолей;
		НомерТелефонаКонтрагента = Выборка.НомерТелефонаКонтрагента;
	КонецЕсли;

КонецПроцедуры

Функция ОтправитьУведомление(ВидУведомления)
	
	МассивСообщений = Новый Массив;
	Успех = Документы.смартЗаявкаНаПускоНаладку.ОтправитьПисьма(Ссылка, ВидУведомления, МассивСообщений);
	
	Для Каждого Сообщение Из МассивСообщений Цикл
