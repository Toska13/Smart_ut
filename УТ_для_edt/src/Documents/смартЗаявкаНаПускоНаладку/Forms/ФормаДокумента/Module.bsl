
#Область ОбработчикиСобытийФормыИЭлементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
			
	Если Параметры.Ключ.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ можно ввести только на основании Заказа клиента");
		КонецЕсли;
		
	КонецЕсли;
	
	//++ Смарт: Белоусова 579 12.07.2021
	этаформа.Элементы.КорректировкаВыполнена.Видимость = Ложь;
	если объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ТребуетКорректировки тогда
		этаформа.Элементы.КорректировкаВыполнена.Видимость = истина;
	КонецЕсли;
	//-- Смарт: Белоусова 579 12.07.2021

	
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	НастроитьВидимостьДоступностьОборудования();
	НастроитьВидимостьДоступностьОбщее();
	
	//++ смарт:ММ #075 372 06.10.2020 - Доработка заявки на пусконаладку - ввод адреса из списка 
	ЗаполнитьСписокВыбораАдресаДоставки();
	//-- смарт:ММ 06.10.2020

	// ++ 03.12.2020
	ПредыдущийСтатус = Объект.Статус;
	// --
	
	//++ смарт:ММ #093 449 05.02.2021 - Доработка Заявки на ПНР
	НастроитьВидимостьДоступность();
	//-- смарт:ММ 05.02.2021
	
	//++ смарт:ММ 657 30.09.2021 
	ЗаметкиПоДокументу.Параметры.УстановитьЗначениеПараметра("Предмет", Объект.Ссылка);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗаметкиПоДокументу, "Предмет", Объект.Ссылка, ВидСравненияКомпоновкиДанных.Равно,, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	//-- смарт:ММ 30.09.2021
	
	//++ #1248 смарт: Фролов 17.01.2023 //Интерактивная карта в 1С  
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Элементы.ГруппаКоординаты.Видимость=Ложь;		
	КонецЕсли;	
	//-- #1248 смарт: Фролов 17.01.2023
    //++ #1287 смарт: Фролов 14.03.2023 //Работа с гарантийными и коммерческими запасными частями  
	УстановитьВидимостьОтчетМимаки();
    //-- #1287 смарт: Фролов 14.03.2023
	
	//++ #Б-3640 смарт: Фролов 26.06.2025 //Добавление функционала работы с взаимодействиями в заявки СЦ.
	Взаимодействия.Параметры.УстановитьЗначениеПараметра("ДокументОснование", Объект.Ссылка);
	
	Если Параметры.Свойство("ПозиционироватьНаВзаимодействие") Тогда
		КлючОткрываемойАктивности = Параметры.ПозиционироватьНаВзаимодействие;
	КонецЕсли;
	//-- #Б-3640 смарт: Фролов 26.06.2025
	
	//++ #Б-3180 смарт: Лопато 10.07.2025 //Лицензии IECHO. Отражение в учетной программе. 
	Элементы.ГруппаКнопокЛицензии.Доступность = ДоступнаРольРедактированияЛицензииСервер();
	//-- #Б-3180 смарт: Лопато 10.07.2025
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Партнер");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ #Б-3640 смарт: Фролов 27.06.2025 //Добавление функционала работы с взаимодействиями в заявки СЦ.
	Если ЭтаФорма.КлючОткрываемойАктивности <> Неопределено Тогда
		ПодключитьОбработчикОжидания("ПозиционироватьНаВзаимодействие", 0.2, Истина);
	КонецЕсли;
	//-- #Б-3640 смарт: Фролов 27.06.2025
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ПроверкаЗаполненияПередЗаписью(Отказ);
	
	// ++ 05.05.2021	
	Если НЕ Отказ Тогда
		Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.ТребуетКорректировки") Тогда
			Если ПолучитьТекущегоПользователя() = Объект.Ответственный 
				И НЕ НеЗадаватьВопросПередЗаписью Тогда
				Отказ = Истина;
				Оповещение = Новый ОписаниеОповещения("ВопросПередЗаписьюЗавершение", ЭтотОбъект, );
				ТекстВопроса = НСтр("ru = 'Изменить статус заявки на «Размещена» для уведомления Сервисного центра?'");
				ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
			КонецЕсли;
			НеЗадаватьВопросПередЗаписью = Ложь;
		КонецЕсли;
	КонецЕсли;	
	// --
	
КонецПроцедуры 

//++ #1287 смарт: Фролов 04.04.2023 //Работа с гарантийными и коммерческими запасными частями 
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//++ #1838 смарт: Ермаков 03.06.2024 / Изменить условие обязательного заполнения отчета
	// Отключил
	//Если Объект.Дата > НачалоДня(Дата("20230405")) Тогда
	// Дополнил
	Если Не Объект.Дата > НачалоДня(Дата("20230405")) Тогда
		Возврат;	
	КонецЕсли;
	//-- #1838 смарт: Ермаков 03.06.2024
		
	//++#1466 смарт: Ермаков 21.09.2023 // Изменить условие обязательного заполнения отчета (отчет mimaki)
