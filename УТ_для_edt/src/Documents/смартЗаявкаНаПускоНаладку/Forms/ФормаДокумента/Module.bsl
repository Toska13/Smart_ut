//++ #1328 смарт: Фролов 21.03.2023 //Добавить спецификацию оборудования iECHO в Заявку на пусконаладку  
&НаСервере
Процедура ЗаполнитьНаСервере()
	Если ТипЗнч(Объект.ДокументОснование)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Если ТипЗнч(Объект.ДокументОснование.ДокументОснование)=Тип("ДокументСсылка.смартIECHOСпецификация") Тогда		
			Запрос=Новый Запрос("ВЫБРАТЬ
			                    |	смартIECHOСпецификацияКомплектующие.НаименованиеКомплектующей КАК НаименованиеКомплектующей,
			                    |	смартIECHOСпецификацияКомплектующие.Количество КАК Количество,
			                    |	смартIECHOСпецификацияКомплектующие.Цена КАК Цена,
			                    |	смартIECHOСпецификацияКомплектующие.Стоимость КАК Стоимость
			                    |ИЗ
			                    |	Документ.смартIECHOСпецификация.Комплектующие КАК смартIECHOСпецификацияКомплектующие
			                    |ГДЕ
			                    |	смартIECHOСпецификацияКомплектующие.Ссылка = &Ссылка
								|	И НЕ смартIECHOСпецификацияКомплектующие.НаименованиеКомплектующей.ОсновнаяКомплектующая");
			Запрос.УстановитьПараметр("Ссылка",Объект.ДокументОснование.ДокументОснование);
			Рез=Запрос.Выполнить().Выгрузить();          
			Объект.Комплектующие.Загрузить(Рез); 
			ЭтаФорма.Модифицированность=Истина;
		Иначе	
			Сообщить("Спецификация не обнаружена!");
		КонецЕсли;
	Иначе	
		Сообщить("Спецификация не обнаружена!");
	КонецЕсли;	
КонецПроцедуры //-- #1328 смарт: Фролов 21.03.2023

