	ВыбранныйДокумент = Неопределено;
	
	Если РезультатЗакрытия <> Неопределено И ТипЗнч(РезультатЗакрытия) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт") Тогда
		
