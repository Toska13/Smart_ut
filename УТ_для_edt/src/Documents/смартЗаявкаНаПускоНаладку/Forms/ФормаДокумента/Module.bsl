//++ #Б-3180 смарт: Лопато 10.07.2025 //Лицензии IECHO. Отражение в учетной программе. 
#Область Лицензии

&НаСервере
Процедура ПоказатьЛицензииСервер(ТекНоменклатура = Неопределено, ТекСерия = Неопределено)

	ЛицензииПО.Отбор.Элементы.Очистить();	
		
	ЭлементОтбораЗаявка = ЛицензииПО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбораЗаявка.ЛевоеЗначение 	 = Новый ПолеКомпоновкиДанных("Заявка"); 
	ЭлементОтбораЗаявка.ВидСравнения 	 = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбораЗаявка.Использование 	 = Истина; 
	ЭлементОтбораЗаявка.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
	ЭлементОтбораЗаявка.ПравоеЗначение 	 = Объект.Ссылка; 

	ЭлементОтбораНоменклатура = ЛицензииПО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбораНоменклатура.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Номенклатура"); 
	ЭлементОтбораНоменклатура.ВидСравнения 	   = ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбораНоменклатура.Использование    = Истина; 
	ЭлементОтбораНоменклатура.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
	ЭлементОтбораНоменклатура.ПравоеЗначение   = ТекНоменклатура; 

	ЭлементОтбораСерия = ЛицензииПО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
	ЭлементОтбораСерия.ЛевоеЗначение 	= Новый ПолеКомпоновкиДанных("Серия"); 
	ЭлементОтбораСерия.ВидСравнения 	= ВидСравненияКомпоновкиДанных.Равно; 
	ЭлементОтбораСерия.Использование 	= Истина; 
	ЭлементОтбораСерия.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
	ЭлементОтбораСерия.ПравоеЗначение 	= ТекСерия; 

КонецПроцедуры

&НаКлиенте
Процедура ЛицензииДобавить(Команда)
	
	ТекущиеДанныеОборудование = Элементы.Оборудование.ТекущиеДанные;
	
	Если ПроверитьВозможностьРедактированияЛицензии(ТекущиеДанныеОборудование) Тогда

		ОткрытьФормуРедактированиеЛицензии(ТекущиеДанныеОборудование);

	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицензииИзменить(Команда)

	ТекущиеДанныеЛицензии = Элементы.ЛицензииПО.ТекущиеДанные;
	
	Если ТекущиеДанныеЛицензии = Неопределено Тогда
		Возврат;
	КонецЕсли;	
		
	ТекущиеДанныеОборудование = Элементы.Оборудование.ТекущиеДанные;
	
	Если ПроверитьВозможностьРедактированияЛицензии(ТекущиеДанныеОборудование) Тогда

		ОткрытьФормуРедактированиеЛицензии(ТекущиеДанныеОборудование, ТекущиеДанныеЛицензии);

	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированиеЛицензии(ТекущиеДанныеОборудование, ТекущиеДанныеЛицензии = Неопределено)

	Если ТекущиеДанныеЛицензии = Неопределено Тогда
		
		ФормаИзмененияСтатуса = ПолучитьФорму("РегистрСведений.смартЛицензииПО.ФормаЗаписи");
		
		ФормаИзмененияСтатуса.Запись.Заявка 	  = Объект.Ссылка;
		ФормаИзмененияСтатуса.Запись.Номенклатура = ТекущиеДанныеОборудование.Оборудование;
		ФормаИзмененияСтатуса.Запись.Серия 		  = ТекущиеДанныеОборудование.Серия;

		ФормаИзмененияСтатуса.Открыть();
		
	Иначе
		
		СтруктураЗаписиЛицензииПО = Новый Структура("Период, Заявка, Номенклатура, Серия", 
													ТекущиеДанныеЛицензии.Период, 
													Объект.Ссылка, 
													ТекущиеДанныеОборудование.Оборудование, 
													ТекущиеДанныеОборудование.Серия);
			
		МассивСтруктураЗаписиЛицензииПО = Новый Массив;
		МассивСтруктураЗаписиЛицензииПО.Добавить(СтруктураЗаписиЛицензииПО);
		КлючЗаписиЛицензииПО = Новый("РегистрСведенийКлючЗаписи.смартЛицензииПО", МассивСтруктураЗаписиЛицензииПО);
		                              
		ПараметрыформыЛицензииПО = Новый Структура("Ключ", КлючЗаписиЛицензииПО);                            
		ОткрытьФорму("РегистрСведений.смартЛицензииПО.ФормаЗаписи", ПараметрыформыЛицензииПО);
		
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьРедактированияЛицензии(ТекДанные)

	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сначала необходимо записать документ!");
		Возврат Ложь;
	КонецЕсли;	
	
	Если ТекДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ДоступнаРольРедактированияЛицензииСервер() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Недостаточно прав для ввода лицензий!");
		Возврат Ложь;
	КонецЕсли;	
	
	Если НЕ ПроверитьОборудованиеНаВозможностьВводаЛицензии(ТекДанные.Оборудование, ТекДанные.Серия) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ДоступнаРольРедактированияЛицензииСервер()
	
	Возврат Пользователи.РолиДоступны("смартРедактированиеЛицензийПО");	

КонецФункции

&НаСервере
Функция ЭтоПолноправныйПользователь()
	
	Возврат Пользователи.ЭтоПолноправныйПользователь();	

КонецФункции

&НаСервере
Функция ПроверитьОборудованиеНаВозможностьВводаЛицензии(Номенклатура, Серия)
	
	ТекстОшибок = "";

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ТекстОшибок = ТекстОшибок + "Не заполнено оборудование!" + Символы.ПС;
	КонецЕсли;	
	
	ИспользоватьСерии = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидНоменклатуры.ИспользоватьСерии");
	
	Если НЕ ИспользоватьСерии Тогда
		ТекстОшибок = ТекстОшибок + "По оборудованию " + СокрЛП(Номенклатура) + " не ведется серийный учет!" + Символы.ПС;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Серия) Тогда
		ТекстОшибок = ТекстОшибок + "Не заполнена серия!" + Символы.ПС;
	КонецЕсли;	
	
	СегментIECHOСЛицензиейПНР = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "IECHOСЛицензиейПНР"); 

	Если ЗначениеЗаполнено(СегментIECHOСЛицензиейПНР) Тогда

		ТЗНоменклатураСегментаIECHOСЛицензиейПНР = СегментыСервер.СписокЭлементовСКД(СегментIECHOСЛицензиейПНР);
		МасОборудованиеIECHOСЛицензиейПНР = ТЗНоменклатураСегментаIECHOСЛицензиейПНР.ВыгрузитьКолонку("ЭлементСписка");
		
		Если МасОборудованиеIECHOСЛицензиейПНР.Найти(Номенклатура) = Неопределено Тогда
			ТекстОшибок = ТекстОшибок + "Оборудование " + СокрЛП(Номенклатура) + " не принаджлежит сегменту ""Сегмент номенклатуры IECHO с лицензией""!";
		КонецЕсли;	
		
	Иначе
		
		ТекстОшибок = ТекстОшибок + "Сегмент ""Сегмент номенклатуры IECHO с лицензией"" не найден!";
		
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ТекстОшибок) Тогда
	    ОбщегоНазначения.СообщитьПользователю(СокрЛП(ТекстОшибок));
		Возврат Ложь;
	Иначе	
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьДобавленияЛицензии(Номенклатура, Серия)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Период КАК Период
	|ИЗ
	|	РегистрСведений.смартЛицензииПО.СрезПоследних(
	|			,
	|			Заявка = &Заявка
	|			И Номенклатура = &Номенклатура
	|			И Серия = &Серия)";
	
	Запрос.УстановитьПараметр("Заявка", 	  Объект.Ссылка);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Серия", 		  Серия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Возврат НЕ ВыборкаДетальныеЗаписи.Следующий();

КонецФункции

&НаКлиенте
Процедура ОборудованиеПередУдалением(Элемент, Отказ)
	
	ТекущиеДанныеОборудование = Элементы.Оборудование.ТекущиеДанные;
	
	Если ТекущиеДанныеОборудование <> Неопределено
		И ЗначениеЗаполнено(ТекущиеДанныеОборудование.Оборудование)
		И ЗначениеЗаполнено(ТекущиеДанныеОборудование.Серия) Тогда
		
		Если КоличествоЛицензийПОСервер(ТекущиеДанныеОборудование.Оборудование, ТекущиеДанныеОборудование.Серия) > 0 Тогда
			
		    ОбщегоНазначенияКлиент.СообщитьПользователю("Для данный строки оборудования введены лицензии!");
			
			Отказ = Истина;	
			
		КонецЕсли;	
		
	КонецЕсли;	
	        			
КонецПроцедуры

&НаСервере
Функция КоличествоЛицензийПОСервер(Оборудование, Серия);

	НаборЗаписейЛицензииПО = РегистрыСведений.смартЛицензииПО.СоздатьНаборЗаписей();

	НаборЗаписейЛицензииПО.Отбор.Заявка.Установить(Объект.Ссылка);
	НаборЗаписейЛицензииПО.Отбор.Номенклатура.Установить(Оборудование);
	НаборЗаписейЛицензииПО.Отбор.Серия.Установить(Серия);
	
	НаборЗаписейЛицензииПО.Прочитать();
	
	Возврат НаборЗаписейЛицензииПО.Количество();
	
КонецФункции

&НаКлиенте
Процедура ЛицензииУдалить(Команда)

	ТекущиеДанныеЛицензии = Элементы.ЛицензииПО.ТекущиеДанные;
	
	Если ТекущиеДанныеЛицензии <> Неопределено Тогда

		Если Объект.Проведен
			И НЕ ЭтоПолноправныйПользователь() Тогда

		    ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя удалять лицензии у проведенного документа! Обратитесь к администратору!");

		Иначе
			
			Оповещение = Новый ОписаниеОповещения("ВопросПередУдалениемЛицензииПОЗавершение", ЭтотОбъект);
			ТекстВопроса = НСтр("ru = 'Вы уверены, что хотите удалить лицензию ПО?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

		КонецЕсли;	
	
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередУдалениемЛицензииПОЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда

		ТекущиеДанныеОборудование = Элементы.Оборудование.ТекущиеДанные;
		ТекущиеДанныеЛицензии = Элементы.ЛицензииПО.ТекущиеДанные;
	
		Если ЗначениеЗаполнено(Объект.Ссылка)
			И ТекущиеДанныеЛицензии <> Неопределено
			И ЗначениеЗаполнено(ТекущиеДанныеЛицензии.Период)
			И ТекущиеДанныеОборудование <> Неопределено
			И ЗначениеЗаполнено(ТекущиеДанныеОборудование.Оборудование)
			И ЗначениеЗаполнено(ТекущиеДанныеОборудование.Серия) Тогда
		
			УдалитьЛицензиюПоНаСервере(Новый Структура("Заявка, Период, Номенклатура, Серия",
									   Объект.Ссылка,
									   ТекущиеДанныеЛицензии.Период,
									   ТекущиеДанныеОборудование.Оборудование, 
									   ТекущиеДанныеОборудование.Серия));
									   
			ПоказатьЛицензииСервер(ТекущиеДанныеОборудование.Оборудование, 
								   ТекущиеДанныеОборудование.Серия);

			УстановитьДоступностьРедактированияЛицензийПОНаСервере(ТекущиеДанныеОборудование.Оборудование, 
															 	   ТекущиеДанныеОборудование.Серия);
																   
			Элементы.ЛицензииПО.Обновить();	
													   
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЛицензиюПоНаСервере(СтруктураЗаписиЛицензииПО);

	ЗаписьЛицензииПО = РегистрыСведений.смартЛицензииПО.СоздатьМенеджерЗаписи();
	
	ЗаполнитьЗначенияСвойств(ЗаписьЛицензииПО, СтруктураЗаписиЛицензииПО);
	
	Попытка
		ЗаписьЛицензииПО.Удалить();
	Исключение	
	    ОбщегоНазначения.СообщитьПользователю("Не удалось удалить лицензию");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьРедактированияЛицензийПОНаСервере(Номенклатура, Серия);

	Элементы.ЛицензииЛицензииДобавить.Доступность = Элементы.ГруппаКнопокЛицензии.Доступность
													И ПроверитьВозможностьДобавленияЛицензии(Номенклатура, Серия);		
														
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Элементы.ЛицензииПО.Обновить();
	
КонецПроцедуры
	
