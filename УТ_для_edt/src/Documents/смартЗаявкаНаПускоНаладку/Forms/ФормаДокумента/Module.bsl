&НаСервере
Процедура НастроитьВидимостьДоступностьОборудования()
		
	ВидимостьДопКолонокОборудования = Ложь;
	Для Каждого Строка Из Объект.Оборудование Цикл
		Если ЭтоПлоттер(Строка.Оборудование) Тогда
			ВидимостьДопКолонокОборудования = Истина;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	Элементы.ОборудованиеГруппаДопКолонки.Видимость = ВидимостьДопКолонокОборудования;	
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьДоступностьОбщее()
	
	Если УправлениеДоступом.ЕстьРоль("смартЗакрытиеЗаявкиНаПускоНаладку") Тогда // Проверка на полные права включена в ЕстьРоль		
		Элементы.ГруппаДляВсемогущих.ТолькоПросмотр = Ложь;
		Элементы.ГруппаДляВсемогущих.ЦветФона = WebЦвета.Роса;
		//++ #Б-3180 смарт: Лопато 10.07.2025 //Лицензии IECHO. Отражение в учетной программе. 
		Элементы.ГруппаИнженеры.ТолькоПросмотр = Ложь;
		Элементы.ГруппаИнженеры.ЦветФона = WebЦвета.Роса;
		//-- #Б-3180 смарт: Лопато 10.07.2025
	КонецЕсли;
	
	// Доступность флага Маркетинг
	ПользовательИзМаркетинга = ТекущийПользовательИзМаркетинга();	
	Элементы.Маркетинг.ТолькоПросмотр = НЕ ПользовательИзМаркетинга;
	
	Если УправлениеДоступом.ЕстьРоль("смартДобавлениеИзменениеАналитикиОборудования") Тогда
		Элементы.БонусЗаПНРНачислен.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьКолонок()
	
	ТекущиеДанные = Элементы.Оборудование.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоПоттер = ЭтоПлоттер(ТекущиеДанные.Оборудование);
		
	Элементы.ОборудованиеГарантийныйСрокНаПечатающиеГоловки.ТолькоПросмотр = НЕ ЭтоПоттер;
	Элементы.ОборудованиеРастровыйПроцессор.ТолькоПросмотр 		= НЕ ЭтоПоттер;
	Элементы.ОборудованиеТипЧернилОборудование.ТолькоПросмотр 				= НЕ ЭтоПоттер;
	Элементы.ОборудованиеКонфигурацияЧернил.ТолькоПросмотр 		= НЕ ЭтоПоттер;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоПлоттер(Оборудование)
	
	ТоварыПлоттерыСерии = Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение;
	
	Возврат Оборудование.ВидНоменклатуры = ТоварыПлоттерыСерии;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНоменклатуруЗаказаКлиента(ЗаказКлиента)
	
	МассивНоменклатуры = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат МассивНоменклатуры;
	КонецЕсли;
	
	МассивНоменклатуры = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Номенклатура");	
	
	Возврат МассивНоменклатуры;
	
КонецФункции

