КонецФункции

&НаСервере
Функция ПолучитьДанныеСтрокиПоУмолчанию(ТекОборудование)
	
	СтруктураВозврат = Новый Структура;
	СтруктураВозврат.Вставить("ГарантийныйСрокНаОборудование", "");
	СтруктураВозврат.Вставить("ГарантийныйСрокНаПечатающиеГоловки", "");
	СтруктураВозврат.Вставить("РастровыйПроцессор", "");
	СтруктураВозврат.Вставить("ДатаОтгрузки", "");
	//++ смарт:ММ #094 411 07.02.2021
	СтруктураВозврат.Вставить("смартСоответствиеСОбрудованиемИЧерниламиКлиентов", "");
	//-- смарт:ММ 07.02.2021
	
	Если НЕ ЗначениеЗаполнено(ТекОборудование) Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Об = РеквизитФормыВЗначение("Объект");
	
	ЗапросОборудование = Новый Запрос;
	ЗапросОборудование.Текст = Об.ПолучитьТекстЗапросаОборудованиеИзЗаказаКлиента();
	ЗапросОборудование.УстановитьПараметр("ТоварПлоттерыСерии", Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение);
	ЗапросОборудование.УстановитьПараметр("ЗаказКлиента", Объект.ДокументОснование);
	ЗапросОборудование.УстановитьПараметр("ОтборНоменклатура", Истина);
	ЗапросОборудование.УстановитьПараметр("Номенклатура", ТекОборудование);
	
	Выборка = ЗапросОборудование.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда // Если несколько отгрузок по выбранной номенклатуре, то выбирается первая попавшаяся
		
		СтруктураВозврат.Вставить("ДатаОтгрузки", Выборка.ДатаОтгрузки);
		
		//++ смарт:ММ #094 411 07.02.2021
		СтруктураВозврат.Вставить("смартСоответствиеСОбрудованиемИЧерниламиКлиентов", Выборка.смартСоответствиеСОбрудованиемИЧерниламиКлиентов);
		//-- смарт:ММ 07.02.2021
		
	КонецЕсли;

	Если НЕ ЭтоПлоттер(ТекОборудование) Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	//++ #Б-2768 смарт: Лопато 21.03.2025 //Заполнение корректного срока гарантии на оборудование и ПГ при формировании ПНР.  
	СтруктураГарантияНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекОборудование, "смартГарантияНаОборудование, смартГарантияНаПечатающиеГоловки");
	
	СтруктураВозврат.Вставить("ГарантийныйСрокНаОборудование", ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаОборудование), 
																 СтруктураГарантияНоменклатуры.смартГарантияНаОборудование, 
																 Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаОборудованиеПоУмолчанию.Значение));

	СтруктураВозврат.Вставить("ГарантийныйСрокНаПечатающиеГоловки", ?(ЗначениеЗаполнено(СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки), 
																	  СтруктураГарантияНоменклатуры.смартГарантияНаПечатающиеГоловки, 
																	  Справочники.смартПредопределенныеЗначения.ГарантийныйСрокНаПечатающиеГоловкиПоУмолчанию.Значение));
	//-- #Б-2768 смарт: Лопато 21.03.2025
	
	СтруктураВозврат.Вставить("РастровыйПроцессор", Справочники.смартПредопределенныеЗначения.РастровыйПроцессорПоУмолчанию.Значение);
	
	Возврат СтруктураВозврат;
	
КонецФункции

&НаКлиенте
Процедура ПроверкаЗаполненияПередЗаписью(Отказ)
	
	Если Объект.КонтактныеЛица.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны контактные лица контрагента. Документ не записан", Объект.Ссылка, "КонтактныеЛица", "Объект");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.Оборудование.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено оборудование. Документ не записан", Объект.Ссылка, "Оборудование", "Объект");
		Отказ = Истина;
	КонецЕсли;
	
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.НазначенИнженер") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НазначенныйНаЗапускИнженер) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен назначенный на запуск инженер. Документ не записан", Объект.Ссылка, "НазначенныйНаЗапускИнженер", "Объект");
			Отказ = Истина;
		КонецЕсли;
		
	ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.ОтправленаВПредставительство") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Представительство) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнено представительство. Документ не записан", Объект.Ссылка, "Представительство", "Объект");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийПользовательИзМаркетинга()
	
	ИзМаркетинга = Ложь;
	
	Если РольДоступна("ПолныеПрава") Тогда
		ИзМаркетинга = Истина;
		Возврат ИзМаркетинга;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Пользователь
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &Ссылка
	|	И НЕ смартПредопределенныеЗначения.ПометкаУдаления
	|	И НЕ смартПредопределенныеЗначения.СписокЗначений
	|	И смартПредопределенныеЗначения.Значение ССЫЛКА Справочник.Пользователи
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка.Ссылка = &Ссылка
	|	И НЕ смартПредопределенныеЗначенияЗначения.Ссылка.ПометкаУдаления
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений
	|	И смартПредопределенныеЗначенияЗначения.Значение ССЫЛКА Справочник.Пользователи";
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.смартПредопределенныеЗначения.ПользователиДляДопРассылкиОЗакрытииЗаявкиНаПускоНаладку);
	
	МассивПользователейМаркетинг = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь");
	
	Если МассивПользователейМаркетинг.Найти(ПараметрыСеанса.ТекущийПользователь) <> Неопределено Тогда
		ИзМаркетинга = Истина;
	КонецЕсли;
	
	Возврат ИзМаркетинга;
	
КонецФункции

//++ смарт:ММ #075 372 06.10.2020 - Доработка заявки на пусконаладку - ввод адреса из списка 
&НаСервере
Процедура ЗаполнитьСписокВыбораАдресаДоставки()
		
	СписокВыбора = Новый СписокЗначений;
	
	// Адреса из Контрагента и Партнера
	АдресаПолучателяИзКонтактнойИнформации = АдресаПолучателяИзКонтактнойИнформации();
	Для Каждого Стр Из АдресаПолучателяИзКонтактнойИнформации Цикл
		НайденныйЭлементСЗ = ДоставкаТоваровКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
		Если НайденныйЭлементСЗ = Неопределено Тогда
			СтруктураВыбора = СтруктураВыбора();
			ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
			СписокВыбора.Добавить(СтруктураВыбора, Стр.Вид + ": " + Стр.АдресДоставки);
		Иначе
			ДозаполнитьПустыеСвойства(НайденныйЭлементСЗ.Значение, Стр);
		КонецЕсли;
	КонецЦикла;
	
	// Адрес из заказа клиента
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		АдресДоставкиИзЗаказаКлиента = ПолучитьАдресДоставкиИзЗаказаКлиента(Объект.ДокументОснование);
		Для Каждого Стр Из АдресДоставкиИзЗаказаКлиента Цикл
			НайденныйЭлементСЗ = ДоставкаТоваровКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
			Если НайденныйЭлементСЗ = Неопределено Тогда
				СтруктураВыбора = СтруктураВыбора();
				ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
				СписокВыбора.Добавить(СтруктураВыбора, Стр.АдресДоставки);
			Иначе
				ДозаполнитьПустыеСвойства(НайденныйЭлементСЗ.Значение, Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	
	СкопироватьСписокЗначений(Элементы.АдресВыезда.СписокВыбора, СписокВыбора);
	
КонецПроцедуры //-- смарт:ММ 06.10.2020

//++ смарт:ММ #075 372 06.10.2020 - Доработка заявки на пусконаладку - ввод адреса из списка 
&НаСервереБезКонтекста
Функция ПолучитьАдресДоставкиИзЗаказаКлиента(ЗаказКлиента)
	
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.АдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	|	ЗаказКлиента.АдресДоставки КАК АдресДоставки,
	|	ЗаказКлиента.ЗонаДоставки КАК ЗонаДоставки,
	|	ЗаказКлиента.ДополнительнаяИнформацияПоДоставке КАК ДополнительнаяИнформацияПоДоставке,
	|	ЗаказКлиента.ВремяДоставкиС КАК ВремяДоставкиС,
	|	ЗаказКлиента.ВремяДоставкиПо КАК ВремяДоставкиПо
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Ссылка";
	
	СпособыДоставкиДоМестаПередачи = Новый Массив;
	СпособыДоставкиДоМестаПередачи.Добавить(Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу);
	СпособыДоставкиДоМестаПередачи.Добавить(Перечисления.СпособыДоставки.СиламиПеревозчикаДоПунктаПередачи);

	Запрос.УстановитьПараметр("СпособыДоставкиДоМестаПередачи", СпособыДоставкиДоМестаПередачи);
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //-- смарт:ММ 06.10.2020

//++ смарт:ММ #075 372 06.10.2020 - Доработка заявки на пусконаладку - ввод адреса из списка 
&НаСервере
Функция АдресаПолучателяИзКонтактнойИнформации()
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК АдресДоставки,
		|	КонтактнаяИнформация.Вид.Представление КАК Вид,
		|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Партнер
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК АдресДоставки,
		|	КонтактнаяИнформация.Вид.Представление КАК Вид,
		|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей
		|ИЗ
		|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Контрагент
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)");
		
	Запрос.УстановитьПараметр("Партнер", 	Объект.Партнер);
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции //-- смарт:ММ 06.10.2020

//++ смарт:ММ #075 372 06.10.2020 - Доработка заявки на пусконаладку - ввод адреса из списка 
Процедура ДозаполнитьПустыеСвойства(СтруктураПриемник, Источник)
	
	СтруктураЗаполнения = Новый Структура;
	Для Каждого Элемент Из СтруктураПриемник Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтруктураЗаполнения.Вставить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Источник);
	ЗаполнитьЗначенияСвойств(СтруктураПриемник, СтруктураЗаполнения);
	
КонецПроцедуры //-- смарт:ММ 06.10.2020

