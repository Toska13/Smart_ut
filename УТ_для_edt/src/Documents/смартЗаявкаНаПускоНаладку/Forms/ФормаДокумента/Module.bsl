&НаКлиенте
Процедура СтатусПриИзменении(Элемент)
	
	Отказ = Ложь; 
	              
	Если Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.Выполнена") 
		// ++ смарт:Минаева # 1258 25.11.2022 - добавление статусов в ПНР
		ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно") 
		ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.КлиентЗапустилОборудованиеСамостоятельно")
		// -- смарт:Минаева # 1258 25.11.2022 - добавление статусов в ПНР
		Тогда
		
		ЭтотОбъект.ЗаписатьИнформациюОбОборудованииВКарточкуКлиента = Истина;//rnp 507 28.04.2021
		
		Для Каждого Строка Из Объект.Оборудование Цикл
			Если ЗначениеЗаполнено(Строка.ДатаПодписанияАктаНаПНР) Тогда
				Продолжить;
			КонецЕсли;
			
			Отказ = Истина;
			
			Объект.Статус = ПредыдущийСтатус;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "В строке " + Строка.НомерСтроки + " не заполнена дата подписания Акта на ПНР. Статус не установлен";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Поле = "Объект.Оборудование[" + (Строка.НомерСтроки - 1) + "].ДатаПодписанияАктаНаПНР";
			Сообщение.Сообщить();
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		ПредыдущийСтатус = Объект.Статус;
	КонецЕсли;
	
	//++ смарт: Белоусова 579 12.07.2021
	если объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаПускоНаладку.ТребуетКорректировки") тогда
		 этаформа.Элементы.КорректировкаВыполнена.Видимость = Истина;
	 иначе
		 этаформа.Элементы.КорректировкаВыполнена.Видимость = Ложь;
	КонецЕсли;
	//-- смарт: Белоусова 579 12.07.2021
	
	//++ #Б-3550 смарт: Фролов 16.06.2025 //Оптимизация прохождения по этапам воронки для документов ЗПР
	СтатусПриИзмененииНаСервере();
	//-- #Б-3550 смарт: Фролов 16.06.2025
	
КонецПроцедуры

