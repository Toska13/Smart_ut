//++ #1420 смарт: Фролов 24.08.2023 //Добавить возможность выбора контактных лиц из Клиента по КА в Заявку на ПНР.  
&НаКлиенте
Процедура КонтактныеЛицаКонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ИзменитьКонтрагентаИКлиентаВРучномРежиме Тогда
		СтандартнаяОбработка=Ложь;                                               
		СписокОтбора=Новый СписокЗначений; 
		СписокОтбора.Добавить(Объект.Партнер);
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда 
			СписокОтбора.Добавить(Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Контрагент,"Партнер"));
		КонецЕсли;
		СтруктураОтбора=Новый Структура("СписокОтбора",СписокОтбора);
		ОткрытьФорму("Справочник.КонтактныеЛицаПартнеров.Форма.смартФормаВыбораНесколькоВладельцев",СтруктураОтбора);
	КонецЕсли;
КонецПроцедуры  //-- #1420 смарт: Фролов 24.08.2023

//++ #1420 смарт: Фролов 24.08.2023 //Добавить возможность выбора контактных лиц из Клиента по КА в Заявку на ПНР.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник) 
	Если ИмяСобытия = "ВыбраноКонтактноеЛицо" Тогда 
		ТекущиеДанные = Элементы.КонтактныеЛица.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
	    ТекущиеДанные.КонтактноеЛицо=Параметр;
		ЗаполнитьРеквизитыПоКонтактномуЛицу(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры  //-- #1420 смарт: Фролов 24.08.2023

