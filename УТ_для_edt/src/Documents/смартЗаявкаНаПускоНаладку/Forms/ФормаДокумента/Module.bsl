	// ++ 13.08.2021
	Если Объект.КтоОплачиваетВыездСИ <> "Дилер" Тогда
	// --	
	Отбор.Вставить("Партнер", 		Объект.Партнер);
	Отбор.Вставить("Контрагент", 	Объект.Контрагент);
	// ++ 13.08.2021
	КонецЕсли;
	// --
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	ПараметрыОткрытия.Вставить("МножественныйВыбор", Ложь);
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("Отбор", Отбор);
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПривязатьЗаказКлиентаЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма,,,, ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
