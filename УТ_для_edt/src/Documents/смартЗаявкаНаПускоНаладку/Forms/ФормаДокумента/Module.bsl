//++ #Б-3550 смарт: Фролов 16.06.2025 //Оптимизация прохождения по этапам воронки для документов ЗПР
Процедура СтатусПриИзмененииНаСервере()
	
	ДатаКонтроля = Справочники.смартПредопределенныеЗначения.Настройки.ДатаНачалаКонтроляОтветственногоСЦ;
	
	Если ЗначениеЗаполнено(ДатаКонтроля) И Объект.Дата > ДатаКонтроля Тогда
	
		Если НЕ ЗначениеЗаполнено(Объект.ОтветственныйСЦ) 
			И НЕ Объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ПолученаВРаботу
			И НЕ Объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ОтправленаВПредставительство Тогда
			
			Объект.ОтветственныйСЦ = Пользователи.ТекущийПользователь();	
			
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры //-- #Б-3550 смарт: Фролов 16.06.2025	

