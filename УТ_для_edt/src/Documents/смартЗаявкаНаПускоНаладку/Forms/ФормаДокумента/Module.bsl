	// Дополнил ниже
	
	//++ #1838 смарт: Ермаков 03.06.2024 / Изменить условие обязательного заполнения отчета
	// Отключил
	//Если ЗначениеЗаполнено(смартОбщегоНазначения.Мимаки_ПолучитьСсылкуНаПроизводителя()) И Мимаки_УсловияОбъектаВыполнены() И НЕ Объект.Ссылка.Пустая() Тогда
	// Дополнил
	Если Не Объект.Ссылка.Пустая() И Мимаки_УсловияОбъектаВыполнены() Тогда
    //-- #1838 смарт: Ермаков 03.06.2024
	//--#1466 смарт: Ермаков 21.09.2023
	
		Если Объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.Выполнена
			Или Объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.ВыполненаДистанционно
			Или Объект.Статус = Перечисления.смартСтатусыЗаявокНаПускоНаладку.КлиентЗапустилОборудованиеСамостоятельно Тогда
			
			Запрос=Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.смартОтчетЗапускаМимаки
			|ГДЕ
			|	ДокументОснование = &ДокументОснование"); 
			Запрос.УстановитьПараметр("ДокументОснование",Объект.ссылка);
			
			Выборка=Запрос.Выполнить().Выбрать();
			
			Если Не Выборка.Следующий() ТОгда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнен Отчет запуска Мимаки!",,,, Отказ);
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//++ #1838 смарт: Ермаков 03.06.2024 / Изменить условие обязательного заполнения отчета
	// Отключил
	//КонецЕсли;
	//-- #1838 смарт: Ермаков 03.06.2024
	
