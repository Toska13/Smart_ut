			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Иначе
			ЗаполнитьДокументОснованиеВЗаявкеНаГарантийныйРемонт(ВыбранныйДокумент);
		КонецЕсли;
		
	КонецЕсли;
		
