//++ #1287 смарт: Фролов 14.03.2023 //Работа с гарантийными и коммерческими запасными частями  
&НаКлиенте
Процедура ОтчетМимакиНажатие(Элемент, СтандартнаяОбработка)
	Если Не Объект.Ссылка.Пустая() Тогда
		Если ТипЗнч(ЭтаФорма.ОтчетМимаки)=Тип("СправочникСсылка.смартОтчетЗапускаМимаки") Тогда
			СтандартнаяОбработка=Ложь;
			ПоказатьЗначение(,ЭтаФорма.ОтчетМимаки);
		Иначе
			СтандартнаяОбработка=Ложь;
			ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
			ОткрытьФорму("Справочник.смартОтчетЗапускаМимаки.Форма.ФормаЭлемента",ПараметрыФормы,ЭтаФорма);
		КонецЕсли; 
	Иначе	
		Сообщить("Необходимо записать документ!");
	КонецЕсли;
