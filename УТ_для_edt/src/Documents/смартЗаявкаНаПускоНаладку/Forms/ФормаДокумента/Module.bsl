//++ #Б-3640 смарт: Фролов 26.06.2025 //Добавление функционала работы с взаимодействиями в заявки СЦ.
Процедура ВзаимодействияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Партнер", Объект.Партнер);
	ПараметрыЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ПараметрыЗаполнения.Вставить("ВидВзаимодействия", смартОбщегоНазначения.ВернутьЗначениеНастройкиПредопределенногоСмарт("ТелефонныйЗвонокВПартнере"));
	ПараметрыЗаполнения.Вставить("КонтактноеЛицо", ?(Объект.КонтактныеЛица.Количество() = 0, Неопределено, Объект.КонтактныеЛица[0].КонтактноеЛицо));
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
	
	ОткрытьФорму("Документ.CRM_Взаимодействие.Форма.ФормаДокумента", ПараметрыЗаполнения, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
	Отказ = Истина;
	
	Возврат;
	
КонецПроцедуры //-- #Б-3640 смарт: Фролов 26.06.2025

