	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьРеквизитыПоКонтрагенту();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоКонтактномуЛицу(ИдентификаторСтроки)
		
	СтрокаКЛ = Объект.КонтактныеЛица.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаКЛ = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Об = РеквизитФормыВЗначение("Объект");	
	СтруктураДанныеКонтактногоЛица = Об.ПолучитьДанныеКонтактногоЛица(СтрокаКЛ.КонтактноеЛицо);
	
	СтрокаКЛ.ТелефонКонтактногоЛица = СтруктураДанныеКонтактногоЛица.Телефон;
	СтрокаКЛ.АдресЭПКонтактногоЛица = СтруктураДанныеКонтактногоЛица.ЭлПочта;
		
КонецПроцедуры

