&НаКлиенте
Процедура КонтрагентОчистка(Элемент, СтандартнаяОбработка)
	Объект.НомерТелефонаКонтрагента = "";
	Объект.АдресВыезда = "";
	Объект.АдресВыездаЗначенияПолей = "";
