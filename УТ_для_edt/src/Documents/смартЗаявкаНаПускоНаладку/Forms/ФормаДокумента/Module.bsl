&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗаписатьИнформациюОбОборудованииВКарточкуКлиента Тогда
		
		КлиентИзменен = Ложь;
		КлиентОбъект = Объект.Партнер.ПолучитьОбъект();
		
		Для Каждого ТекСтрока Из Объект.Оборудование Цикл
			
			// 1. Обновление номененклатуры при необходимости
			
	//++ смарт: Белоусова 590 11.08.2021
			
			//Если ЗначениеЗаполнено(ТекСтрока.ОборудованиеКлиентов) 
			//	И ТекСтрока.ОборудованиеКлиентов <> ТекСтрока.Оборудование.смартСоответствиеСОбрудованиемИЧерниламиКлиентов
			//	Тогда
			//	УстановитьПривилегированныйРежим(Истина);
			//	СправочникОбъект = ТекСтрока.Оборудование.ПолучитьОбъект();
			//	СправочникОбъект.смартСоответствиеСОбрудованиемИЧерниламиКлиентов = ТекСтрока.ОборудованиеКлиентов;
			//	СправочникОбъект.ОбменДанными.Загрузка = Истина;
			//	СправочникОбъект.Записать();
			//	УстановитьПривилегированныйРежим(Ложь);
			//КонецЕсли;
			
	//++ смарт: Белоусова 590 11.08.2021
			
			// 2. Обновление оборудования и чернил клиента
			
			Если ЗначениеЗаполнено(ТекСтрока.ОборудованиеКлиентов) Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("смартОборудованиеКлиента", ТекСтрока.ОборудованиеКлиентов);
				//++ #5306 смарт: Тимофеева 20.01.26 / Cписок оборудования клиента в карточке клиента
				Отбор.Вставить("смартИдентификатор", Строка(Объект.Ссылка.УникальныйИдентификатор()));
				//-- #5306 смарт: Тимофеева 20.01.26

				НайденныеСтроки = КлиентОбъект.смартОборудованиеКлиентов.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрокаОборудование = КлиентОбъект.смартОборудованиеКлиентов.Добавить();
					//НоваяСтрокаОборудование.смартНаименованиеОборудования 	= ТекСтрока.ОборудованиеКлиентов;
					НоваяСтрокаОборудование.смартДатаДобавления 			= ТекущаяДата();
					НоваяСтрокаОборудование.смартОборудованиеКлиента 		= ТекСтрока.ОборудованиеКлиентов;
					НоваяСтрокаОборудование.смартКомментарий 				= "Запуск " + Формат(Объект.ЖелаемаяДатаИнсталляции, "ДФ='dd.MM.yyyy ""г.""'");
					//++ #5306 смарт: Тимофеева 20.01.26 / Cписок оборудования клиента в карточке клиента
					НоваяСтрокаОборудование.смартИдентификатор				= Строка(Объект.Ссылка.УникальныйИдентификатор());
					//-- #5306 смарт: Тимофеева 20.01.26 
					КлиентИзменен = Истина;
				КонецЕсли;
			Иначе
				ОбщегоНазначения.СообщитьПользователю("Для записи в карточку клиента заполните ""Оборудование клиента"" в строке " + ТекСтрока.НомерСтроки);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекСтрока.ТипЧернилОборудование) Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("смартЧернилаКлиента", ТекСтрока.ТипЧернилОборудование);
				
				НайденныеСтроки = КлиентОбъект.смартЧернилаКлиента.НайтиСтроки(Отбор);
				
				Если НайденныеСтроки.Количество() = 0 Тогда
					НоваяСтрокаОборудование = КлиентОбъект.смартЧернилаКлиента.Добавить();
					НоваяСтрокаОборудование.смартЧернилаКлиента = ТекСтрока.ТипЧернилОборудование;
					НоваяСтрокаОборудование.смартДатаДобавления = ТекущаяДата();
					НоваяСтрокаОборудование.смартКомментарий 	= Строка(ТекСтрока.КонфигурацияЧернил);
					КлиентИзменен = Истина;
				КонецЕсли;
				
			//Иначе //rnp 25.02.2021 закомментировано, т.к. не все оборудование требует заполнения типа чернил
				//ОбщегоНазначения.СообщитьПользователю("Для записи в карточку клиента заполните ""Тип чернил (оборудование)"" в строке " + ТекСтрока.НомерСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		Если КлиентИзменен Тогда
			УстановитьПривилегированныйРежим(Истина);//rnp 507 28.04.2021
			КлиентОбъект.ОбменДанными.Загрузка = Истина;
			КлиентОбъект.Записать();
			УстановитьПривилегированныйРежим(Ложь);//rnp 507 28.04.2021
			ОбщегоНазначения.СообщитьПользователю("Обновлены оборудование и расходные материалы клиента " + Объект.Партнер, Объект.Партнер);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 07.02.2021

