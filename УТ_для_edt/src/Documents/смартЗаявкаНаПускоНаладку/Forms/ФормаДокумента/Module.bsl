//++ #1887 смарт: Мосолов 03.07.2024 //Доработать документы сервисного центра. Затраченное время.
&НаКлиенте
Процедура ПроверитьСтрокуНаКорректностьДат(ТекущиеДанные)
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаИВремяНачалаРабот) 
		И Не ЗначениеЗаполнено(ТекущиеДанные.ДатаИВремяОкончанияРабот)
		И ТекущиеДанные.ДатаИВремяНачалаРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) Тогда 
		
		ТекущиеДанные.ДатаИВремяНачалаРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 9 * 60 * 60;
		ТекущиеДанные.ДатаИВремяОкончанияРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 18 * 60 * 60;  
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДатаИВремяНачалаРабот) 
		И ЗначениеЗаполнено(ТекущиеДанные.ДатаИВремяОкончанияРабот) Тогда
		
		Если НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) <> НачалоДня(ТекущиеДанные.ДатаИВремяОкончанияРабот) Тогда  
			
			ТекущиеДанные.ДатаИВремяНачалаРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 9 * 60 * 60;
			ТекущиеДанные.ДатаИВремяОкончанияРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 18 * 60 * 60;
			
			ПоказатьПредупреждение(Неопределено, "Данные строки должны быть в пределах одних суток!");
			
			Возврат;
			
		КонецЕсли;
		
		Если ТекущиеДанные.ДатаИВремяНачалаРабот > ТекущиеДанные.ДатаИВремяОкончанияРабот Тогда  
			
			ТекущиеДанные.ДатаИВремяНачалаРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 9 * 60 * 60;
			ТекущиеДанные.ДатаИВремяОкончанияРабот = НачалоДня(ТекущиеДанные.ДатаИВремяНачалаРабот) + 18 * 60 * 60;
			
			ПоказатьПредупреждение(Неопределено, "Дата окончания работ должна быть больше даты начала работ!");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- #1887 смарт: Мосолов 03.07.2024

//++ #1887 смарт: Мосолов 03.07.2024 //Доработать документы сервисного центра. Затраченное время.
&НаСервере
Процедура РассчитатьЗатраченноеВремя()
	
	ЕстьНезаполненныеПоля = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.ЗатраченноеВремяИнженера Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяНачалаРабот) 
			И ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяОкончанияРабот) Тогда 
			
			СтрокаТаблицы.Часы = (СтрокаТаблицы.ДатаИВремяОкончанияРабот - СтрокаТаблицы.ДатаИВремяНачалаРабот) / 60 / 60;
			
		Иначе
			
			ЕстьНезаполненныеПоля = Истина;
			СтрокаТаблицы.Часы = 0;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Объект.ЗатраченоЧасов = ?(ЕстьНезаполненныеПоля, 0, Объект.ЗатраченноеВремяИнженера.Итог("Часы"));
	
	ЕстьНезаполненныеПоля = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.ЗатраченноеВремяИнженера2 Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяНачалаРабот) 
			И ЗначениеЗаполнено(СтрокаТаблицы.ДатаИВремяОкончанияРабот) Тогда 
			
			СтрокаТаблицы.Часы = (СтрокаТаблицы.ДатаИВремяОкончанияРабот - СтрокаТаблицы.ДатаИВремяНачалаРабот) / 60 / 60;
			
		Иначе
			
			ЕстьНезаполненныеПоля = Истина;
			СтрокаТаблицы.Часы = 0;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Объект.ЗатраченоЧасов2 = ?(ЕстьНезаполненныеПоля, 0, Объект.ЗатраченноеВремяИнженера2.Итог("Часы"));
	
КонецПроцедуры //-- #1887 смарт: Мосолов 03.07.2024

//++ #1887 смарт: Мосолов 03.07.2024 //Доработать документы сервисного центра. Затраченное время.
&НаКлиенте
