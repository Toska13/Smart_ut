
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ++ 01.12.2020
	БлокируемыеПоля = Новый Массив;
	БлокируемыеПоля.Добавить("Серия");
	БлокируемыеПоля.Добавить("ОборудованиеТЧ");
	
	Список.УстановитьОграниченияИспользованияВГруппировке(БлокируемыеПоля);
	Список.УстановитьОграниченияИспользованияВОтборе(БлокируемыеПоля);
	Список.УстановитьОграниченияИспользованияВПорядке(БлокируемыеПоля);
	
	Список.Параметры.УстановитьЗначениеПараметра("Ссылка", Неопределено);
	Список.Параметры.УстановитьЗначениеПараметра("ОтборОборудование", Ложь);
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиентаНаФормеСписка(ЭтаФорма,
																		 "ДокументсмартЗаявкаНаПускоНаладку", 
																		 "И (смартЗаявкаНаПускоНаладкуОборудование.НомерСтроки = 1)", 
																		 "ЕСТЬNULL(смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов, ЗНАЧЕНИЕ(Справочник.смартОборудованиеКлиентов.ПустаяСсылка)) КАК ОборудованиеКлиента",
																		 ,,, "Контрагент");
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
	//++ #Б-6426 смарт: Фролов 17.04.2026 //Реализовать предпросмотр присоединенных PDF файлов
	РасширенияПоддерживающиеПредпросмотр = РаботаСФайламиСлужебный.СписокРасширенийДляПредпросмотра();
	
	Элементы.PDFДокумент.Видимость = Ложь;
	Элементы.АдресДанныхФайла.Видимость = Истина;
	//-- #Б-6426 смарт: Фролов 17.04.2026
	
КонецПроцедуры

