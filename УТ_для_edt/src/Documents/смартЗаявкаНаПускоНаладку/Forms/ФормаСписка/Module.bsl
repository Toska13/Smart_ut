Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтаФорма, Команда);
	
КонецПроцедуры

//++ смарт:ММ #084 407 01.12.2020 - Доработка Заявки на пусконаладку
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	//++ #6750  смарт: Тимофеева 30.04.2026 / При попытке вывести список из журнала ПНР, выходит ошибка, и дальнейшие действия "Завершить" или "Закрыть" программу.
	КлючиСтрок = Строки.ПолучитьКлючи();
	Если КлючиСтрок.Количество() > 0 
		И НЕ Строки[КлючиСтрок[0]].Данные.Свойство("Серия")
		И НЕ Строки[КлючиСтрок[0]].Данные.Свойство("ОборудованиеТЧ") Тогда
	    Возврат;
	КонецЕсли;
	//-- #6750  смарт: Тимофеева 30.04.2026
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаПускоНаладкуОборудование.Оборудование КАК Оборудование,
	|	смартЗаявкаНаПускоНаладкуОборудование.Серия КАК Серия,
	|	смартЗаявкаНаПускоНаладкуОборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
	|ГДЕ
	|	смартЗаявкаНаПускоНаладкуОборудование.Ссылка В(&МассивДокументов)
	|ИТОГИ ПО
	|	Ссылка";
	
	//++ #6750  смарт: Тимофеева 30.04.2026 / При попытке вывести список из журнала ПНР, выходит ошибка, и дальнейшие действия "Завершить" или "Закрыть" программу.
	//Запрос.УстановитьПараметр("МассивДокументов", Строки.ПолучитьКлючи());
	Запрос.УстановитьПараметр("МассивДокументов", КлючиСтрок);
	//-- #6750  смарт: Тимофеева 30.04.2026
		
	ВыборкаСсылка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Серия = "";
		Оборудование = "";
		Выборка = ВыборкаСсылка.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Серия = "" + Серия + ?(ЗначениеЗаполнено(Серия), ", ", "") + Выборка.Серия;
			Оборудование = "" + Оборудование + ?(ЗначениеЗаполнено(Оборудование), ", ", "") + Выборка.Оборудование;
		КонецЦикла;
		
		Строка = Строки[ВыборкаСсылка.Ссылка];
		//++ #6750  смарт: Тимофеева 30.04.2026 / При попытке вывести список из журнала ПНР, выходит ошибка, и дальнейшие действия "Завершить" или "Закрыть" программу.
		//Строка.Данные.Серия = Серия;
		//Строка.Данные.ОборудованиеТЧ = Оборудование; 
		Если Строка.Данные.Свойство("Серия") Тогда
			Строка.Данные.Серия = Серия;
		КонецЕсли;
		Если Строка.Данные.Свойство("ОборудованиеТЧ") Тогда
			Строка.Данные.ОборудованиеТЧ = Оборудование;
		КонецЕсли;
		//-- #6750  смарт: Тимофеева 30.04.2026  		
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 01.12.2020

//++ смарт:ММ #084 407 01.12.2020 - Доработка Заявки на пусконаладку
&НаКлиенте
Процедура ОборудованиеОтборПриИзменении(Элемент)
		
	Если ЗначениеЗаполнено(Оборудование) Тогда
		МассивСсылок = ПолучитьДокументыПоОборудованию(Оборудование);
		Список.Параметры.УстановитьЗначениеПараметра("Ссылка", МассивСсылок);
		Список.Параметры.УстановитьЗначениеПараметра("ОтборОборудование", Истина);
	Иначе
		Список.Параметры.УстановитьЗначениеПараметра("Ссылка", Неопределено);
		Список.Параметры.УстановитьЗначениеПараметра("ОтборОборудование", Ложь);
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 01.12.2020

//++ смарт:ММ #084 407 01.12.2020 - Доработка Заявки на пусконаладку
&НаСервереБезКонтекста
Функция ПолучитьДокументыПоОборудованию(Оборудование)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаПускоНаладкуОборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
	|ГДЕ
	|	смартЗаявкаНаПускоНаладкуОборудование.Оборудование В(&Оборудование)";
	
	Запрос.УстановитьПараметр("Оборудование", Оборудование);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции //-- смарт:ММ 01.12.2020


