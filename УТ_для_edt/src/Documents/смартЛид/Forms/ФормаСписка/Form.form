    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	смартИсторияРаботыСЛидом.Лид КАК Лид,
	смартИсторияРаботыСЛидом.Менеджер КАК Менеджер,
	смартИсторияРаботыСЛидом.ДатаОбработки КАК ДатаОбработки,
	смартИсторияРаботыСЛидом.ДатаКонтроля КАК ДатаКонтроля,
	смартИсторияРаботыСЛидом.ПервыйКонтакт КАК ПервыйКонтакт
ПОМЕСТИТЬ ИсторияЛидов
ИЗ
	РегистрСведений.смартИсторияРаботыСЛидом КАК смартИсторияРаботыСЛидом
ГДЕ
	НЕ смартИсторияРаботыСЛидом.ЗавершенНеУдачно
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументсмартЛид.Ссылка КАК Ссылка,
	ДокументсмартЛид.ПометкаУдаления КАК ПометкаУдаления,
	ДокументсмартЛид.Номер КАК Номер,
	ДокументсмартЛид.Дата КАК Дата,
	ДокументсмартЛид.Проведен КАК Проведен,
	ДокументсмартЛид.Ответственный КАК Ответственный,
	ДокументсмартЛид.Комментарий КАК Комментарий,
	ДокументсмартЛид.Партнер КАК Партнер,
	ДокументсмартЛид.Имя КАК Имя,
	ДокументсмартЛид.Телефон КАК Телефон,
	ДокументсмартЛид.ЭлектроннаяПочта КАК ЭлектроннаяПочта,
	ДокументсмартЛид.ДокументОснование КАК ДокументОснование,
	ДокументсмартЛид.ИсточникПолученияЛида КАК ИсточникПолученияЛида,
	ДокументсмартЛид.СостояниеЛида КАК СостояниеЛида,
	ДокументсмартЛид.Продукт КАК Продукт,
	ДокументсмартЛид.ПричинаОтклонения КАК ПричинаОтклонения,
	ДокументсмартЛид.ТекстИсточника КАК ТекстИсточника,
	ДокументсмартЛид.КонтактноеЛицо КАК КонтактноеЛицо,
	ДокументсмартЛид.РезультатыПоискаПоКИ КАК РезультатыПоискаПоКИ,
	ДокументсмартЛид.Тема КАК Тема,
	ДокументсмартЛид.БизнесРегионТекст КАК БизнесРегионТекст,
	ДокументсмартЛид.БизнесРегион КАК БизнесРегион,
	ДокументсмартЛид.Квалификация КАК Квалификация,
	ДокументсмартЛид.ТипТовара КАК ТипТовара,
	ДокументсмартЛид.Заметка КАК Заметка,
	ДокументсмартЛид.МоментВремени КАК МоментВремени,
	ДокументсмартЛид.Распределил КАК Распределил,
	ИсторияЛидов.ДатаОбработки КАК ДатаОбработки,
	ИсторияЛидов.ДатаКонтроля КАК ДатаКонтроля,
	ИсторияЛидов.ПервыйКонтакт КАК ПервыйКонтакт
ИЗ
	Документ.смартЛид КАК ДокументсмартЛид
		ЛЕВОЕ СОЕДИНЕНИЕ ИсторияЛидов КАК ИсторияЛидов
		ПО ДокументсмартЛид.Ссылка = ИсторияЛидов.Лид
			И ДокументсмартЛид.Ответственный = ИсторияЛидов.Менеджер
ГДЕ
	ДокументсмартЛид.СостояниеЛида В(&amp;МасСостояний)</queryText>
      <mainTable>Document.смартЛид</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
