#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	//++ #1623 смарт: Фролов 13.02.2024 //Автоматическое распределение лидов. Форма добавления лида вручную
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;	
	//-- #1623 смарт: Фролов 13.02.2024
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	УстановитьУсловноеОформление();
	
	//Переопеределяемый модуль
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	//Переопеределяемый модуль
	
	//++ #1624 смарт: Фролов 13.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
	Если ЗначениеЗаполнено(Объект.Партнер) Тогда
		
		Элементы.СоздатьКлиента.Видимость = Ложь;
		
	КонецЕсли;
	
	Заметки.Параметры.УстановитьЗначениеПараметра("Лид", Объект.Ссылка);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартЛид.Дата КАК Дата,
	|	смартЛид.Ссылка КАК Ссылка,
	|	смартЛид.ТипТовара КАК ТипТовара,
	|	смартЛид.Продукт КАК Продукт,
	|	смартЛид.СостояниеЛида КАК СостояниеЛида,
	|	смартЛид.Ответственный КАК Ответственный,
	|	смартЛид.Имя КАК Имя,
	|	смартЛид.БизнесРегион КАК БизнесРегион,
	|	смартЛид.Номер КАК Номер,
	|	смартЛид.Партнер КАК Клиент
	|ИЗ
	|	Документ.смартЛид КАК смартЛид
	|ГДЕ
	|	(смартЛид.Партнер = &Партнер
	|			ИЛИ смартЛид.ЭлектроннаяПочта = &ЭлектроннаяПочта
	|			ИЛИ смартЛид.КонтактноеЛицо = &КонтактноеЛицо
	|			ИЛИ смартЛид.Телефон = &Телефон)
	|	И НЕ смартЛид.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Партнер", ?(Объект.Партнер.Пустая(), "ХХХХХХХХХХХХХ", Объект.Партнер));
	Запрос.УстановитьПараметр("ЭлектроннаяПочта", ?(Объект.ЭлектроннаяПочта = "", "ХХХХХХХХХХХХХ", Объект.ЭлектроннаяПочта));
	Запрос.УстановитьПараметр("КонтактноеЛицо", ?(Объект.КонтактноеЛицо.Пустая(), "ХХХХХХХХХХХХХ", Объект.КонтактноеЛицо));
	Запрос.УстановитьПараметр("Телефон", ?(Объект.Телефон = "", "ХХХХХХХХХХХХХ", Объект.Телефон));
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.ИсторияЛидов.Загрузить(Результат);
	
	ЭтаФорма.Элементы.СтраницаИсторияЛидов.Заголовок = "Другие лиды клиента (" + Результат.Количество() + ")";
	
	Если ЗначениеЗаполнено(Объект.Квалификация) Тогда
		ЗаполнитьСписокВыбораОтветственных();	
	КонецЕсли;	
	//-- #1624 смарт: Фролов 13.02.2024
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Партнер");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	//++ #1623 смарт: Фролов 13.02.2024 //Автоматическое распределение лидов. Форма добавления лида вручную
	Если Объект.Ссылка.Пустая() Тогда
		
		ОткрытьФорму("Документ.смартЛид.Форма.ФормаВводаНовогоЛида");
		ЭтаФорма.Закрыть();
		
	КонецЕсли;
	//-- #1623 смарт: Фролов 13.02.2024
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	МодификацияКонфигурацииПереопределяемый.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//++ #1624 смарт: Фролов 16.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
	Если Элементы.ПричинаСменыОтветственного.Видимость Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ПричинаСменыОтветственного) Тогда
			
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Не заполнена причина смены ответственного!",,"Объект.ПричинаСменыОтветственного");
			Возврат;
			
		КонецЕсли;	
		
	КонецЕсли;
	//-- #1624 смарт: Фролов 16.02.2024
	
	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи); 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	//++ #1624 смарт: Фролов 21.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
	Элементы.ОчиститьСменуОтветственного.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ТекущийОбъект.Партнер) Тогда
		
		УстановитьПартнераВЗаметки();
		
	КонецЕсли;
	//-- #1624 смарт: Фролов 21.02.2024
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
//++ #1624 смарт: Фролов 13.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОповещениеОНовомПартнереЛиду" ТОгда
		
		Если Источник.ВладелецФормы = ЭтаФорма Тогда
			
			Если Параметр.СозданиеВыполнено	ТОгда
				
				Объект.Партнер = Параметр.ПартнерВыбор;
				Объект.КонтактноеЛицо = Параметр.КонтактноеЛицо;
				Записать(Новый Структура("РежимЗаписи",РежимЗаписиДокумента.Запись));
				Элементы.СоздатьКлиента.Видимость = Ложь;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- #1624 смарт: Фролов 13.02.2024

