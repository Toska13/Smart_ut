&НаКлиенте
//++ #1624 смарт: Фролов 13.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
Процедура СоздатьКлиента(Команда)
	
	ПараметрыКИ = Новый Структура;
	СтруктураКИ = Новый Структура;
	СтруктураКИ.Вставить("Телефон", Объект.Телефон);
	СтруктураКИ.Вставить("ЭлектроннаяПочта", Объект.ЭлектроннаяПочта);
	СтруктураКИ.Вставить("Имя", Объект.Имя);
	СтруктураКИ.Вставить("БизнесРегион", Объект.БизнесРегион);
	СтруктураКИ.Вставить("ОсновнойМенеджер", Объект.Ответственный);
	ПараметрыКИ.Вставить("КонтактныеДанныеЛида", СтруктураКИ);
	
	ОткрытьФорму("Справочник.Партнеры.Форма.ПомощникНового", ПараметрыКИ, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры //-- #1624 смарт: Фролов 13.02.2024

&НаКлиенте
//++ #1624 смарт: Фролов 14.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
Процедура ЗавершенУспешно(Команда)
	
	Проверка = ПроверитьУспешно();
		
	Если Проверка Тогда
		
		Объект.СостояниеЛида = ПредопределенноеЗначение("Перечисление.смартСостоянияЛидов.ЗавершенУспешно");
		ЭтаФорма.Элементы.ПричинаОтклонения.ОтметкаНезаполненного = Ложь;
		УстановитьВидимостьДоступностьЭлементов();
		
	КонецЕсли;
	
КонецПроцедуры //-- #1624 смарт: Фролов 14.02.2024

&НаСервере
//++ #1624 смарт: Фролов 16.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
Функция ПроверитьУспешно()
	
	Проверка = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		
			ОбщегоНазначения.СообщитьПользователю("Для успешного завершения лида необходимо заполнить клиента!",,"Объект.Партнер");
			Проверка = Ложь;

	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Объект.КонтактноеЛицо) Тогда
		
			ОбщегоНазначения.СообщитьПользователю("Для успешного завершения лида необходимо заполнить контактное лицо!",,"Объект.КонтактноеЛицо");
			Проверка = Ложь;
			
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Заметки
	|ГДЕ
	|	смартИсточник = &Лид
	|	И НЕ ЭтоГруппа
	|	И НЕ ПометкаУдаления");
	Запрос.УстановитьПараметр("Лид", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Для успешного завершения лида необходимо заполнить заметку с информацией по результату обработки!");
		Проверка = Ложь;
			
	КонецЕсли;
	
	Возврат Проверка;
	
КонецФункции //-- #1624 смарт: Фролов 16.02.2024	

&НаКлиенте 
