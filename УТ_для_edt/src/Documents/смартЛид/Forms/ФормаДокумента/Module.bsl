Процедура ЗаполнитьСписокВыбораОтветственных()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартКвалификацииМенеджеровПользователи.Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи КАК смартКвалификацииМенеджеровПользователи
	|ГДЕ
	|	НЕ смартКвалификацииМенеджеровПользователи.Пользователь В
	|				(ВЫБРАТЬ
	|					РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних.Менеджер КАК Менеджер
	|				ИЗ
	|					РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(, ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент))
	|				ГДЕ
	|					РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних.ВыдачаЗаблокирована)
	|	И смартКвалификацииМенеджеровПользователи.Ссылка.Ссылка = &Квалификация
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартКвалификацииМенеджеровПользователи.Пользователь.Наименование");
	Запрос.УстановитьПараметр("Квалификация", Объект.Квалификация);
	
	Элементы.Ответственный.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь"));
	
