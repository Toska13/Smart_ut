//++ #1624 смарт: Фролов 16.02.2024 //Автоматическое распределение лидов. Работа менеджера с лидом.
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	//++ смарт:Каратеев 01.02.2024 //Временное переопределение доступности на время тестирования для ручного заполнения Лидов
	//Удалить этот кусок, когда будет реализована форма ручного добавления лидов.
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		Элементы.Имя.ТолькоПросмотр = Ложь;
		Элементы.Телефон.ТолькоПросмотр = Ложь;
		Элементы.ЭлектроннаяПочта.ТолькоПросмотр = Ложь;
		Элементы.Продукт.ТолькоПросмотр = Ложь;
		Элементы.ИсточникПолученияЛида.ТолькоПросмотр = Ложь;
		Элементы.Тема.ТолькоПросмотр = Ложь; 
		//++ #Б-5036 смарт: Фролов 21.11.2025 //Убрать создание лида при создании интереса из заказа клиента.
		Элементы.Распределил.ТолькоПросмотр = Истина;
		//-- #Б-5036 смарт: Фролов 21.11.2025
		
	КонецЕсли;
	//-- смарт:Каратеев 01.02.2024 //Временное переопределение доступности на время тестирования для ручного заполнения Лидов
	
	Если НЕ Пользователи.РолиДоступны("смартДобавлениеИзменениеКвалификацийМенеджеров") Тогда
		
		Если ЗначениеЗаполнено(Объект.Партнер) Тогда
			
			Элементы.Партнер.ТолькоПросмотр = Истина;
			Элементы.КонтактноеЛицо.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
		Элементы.ДокументОснование.Гиперссылка = Ложь;
		Элементы.БизнесРегион.ТолькоПросмотр = Истина;
		Элементы.Квалификация.ТолькоПросмотр = Истина;
		Элементы.СостояниеЛида.ТолькоПросмотр = Истина;
		Элементы.Ответственный.ТолькоПросмотр = Объект.Ответственный <> ПараметрыСеанса.ТекущийПользователь;
		
		Если Объект.СостояниеЛида = Перечисления.смартСостоянияЛидов.ЗавершенУспешно
			ИЛИ Объект.СостояниеЛида = Перечисления.смартСостоянияЛидов.ЗавершенНеУспешно Тогда
			
				Элементы.ЗавершенНеУспешно.Доступность = Ложь;
				Элементы.ЗавершенУспешно.Доступность = Ложь;
				Элементы.Партнер.ТолькоПросмотр = Истина;
				Элементы.КонтактноеЛицо.ТолькоПросмотр = Истина;
				Элементы.ПричинаОтклонения.ТолькоПросмотр = Истина;
				Элементы.Ответственный.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ПричинаСменыОтветственного) Тогда
		
		Элементы.ДекорацияСменаОтветственного.Заголовок = "Передал: " + Объект.ПредыдущийОтветственный + Символы.ПС +
			"Причина: " + Объект.ПричинаСменыОтветственного;
		Элементы.ГруппаСманаОтветственного.Видимость = Истина;
		
		Элементы.Ответственный.ТолькоПросмотр = НЕ Пользователи.РолиДоступны("смартДобавлениеИзменениеКвалификацийМенеджеров");
		
	КонецЕсли;
	
КонецПроцедуры //-- #1624 смарт: Фролов 16.02.2024

