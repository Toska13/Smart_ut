#Область СлужебныеПроцедурыИФункции

Процедура УстановитьУсловноеОформление()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Элементы.ДокументОснование.Видимость = Истина;
		Элементы.ДекорацияДокументСозданВручную.Видимость = Ложь;
		
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее") 
			И Объект.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
			HTMLТекст = "<!DOCTYPE html>
				|<html lang=""ru"">
				|<head>
				|
				|</head>
				|<body>" + Объект.ТекстИсточника+"</body>
				|</html>";
			
			ТекстИсточникаHTML = HTMLТекст;
			Элементы.ТекстИсточникаTXT.Видимость = Ложь;
			Элементы.ТекстИсточникаHTML.Видимость = Истина;
		Иначе
			Элементы.ТекстИсточникаTXT.Видимость = Истина;
			Элементы.ТекстИсточникаHTML.Видимость = Ложь;
		КонецЕсли;
		
	Иначе
		
		//Переопределение видимости реквизита формы "Документ основание"
		Элементы.ДокументОснование.Видимость = Ложь;
		Элементы.ДекорацияДокументСозданВручную.Видимость = Истина;
		
		Если Объект.Ссылка = Документы.смартЛид.ПустаяСсылка() Тогда
			Элементы.ДекорацияДокументСозданВручную.Заголовок = "Документ заполняется вручную";
		КонецЕсли;
		//Переопределение видимости реквизита формы "Документ основание"
		
		Элементы.ТекстИсточникаTXT.Видимость = Истина;
		Элементы.ТекстИсточникаHTML.Видимость = Ложь;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	УстановитьВидимостьДоступностьЭлементов();
		
КонецПроцедуры

