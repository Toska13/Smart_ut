    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Заметки.ДатаЗаметки КАК ДатаЗаметки,
	Заметки.ТекстСодержания КАК Содержание,
	Заметки.Автор КАК Автор
ИЗ
	Справочник.Заметки КАК Заметки
ГДЕ
	Заметки.смартИсточник = &amp;Лид
	И НЕ Заметки.ЭтоГруппа
	И НЕ Заметки.ПометкаУдаления</queryText>
      <mainTable>Catalog.Заметки</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
