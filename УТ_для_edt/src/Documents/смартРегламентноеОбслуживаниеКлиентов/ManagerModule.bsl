Функция ПолучитьСерию(Оборудование, ЗаявкаНаПНР) Экспорт
	
	Серия = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Оборудование)
		ИЛИ НЕ ЗначениеЗаполнено(ЗаявкаНаПНР) Тогда
		Возврат Серия;	
	КонецЕсли;
		
	Отбор = Новый Структура;
	Отбор.Вставить("ОборудованиеКлиентов", Оборудование);
	НайденныеСтроки = ЗаявкаНаПНР.Оборудование.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() = 1 Тогда
		Серия = НайденныеСтроки[0].Серия;	
	КонецЕсли;
	
	Возврат Серия;	
	
КонецФункции //-- смарт:ММ 05.06.2021

