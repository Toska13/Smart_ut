	ПоследняяЗаметка.ДатаЗаметки КАК ДатаПоследнейЗаметки,
	//-- смарт:ММ 25.10.2021
	МАКСИМУМ(ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентОплаты, 0)) КАК ПроцентОплаты
ИЗ
	Документ.смартРегламентноеОбслуживаниеКлиентов КАК ДокументсмартРегламентноеОбслуживаниеКлиентов
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДокумент
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
			ПО ЗаказКлиентаДокумент.Ссылка = СостоянияЗаказовКлиентов.Заказ
		ПО ДокументсмартРегламентноеОбслуживаниеКлиентов.Ссылка = ЗаказКлиентаДокумент.ДокументОснование
		//++ смарт:ММ 694 25.10.2021 
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
							Заметки.Предмет КАК Предмет,
							МАКСИМУМ(Заметки.ДатаЗаметки) КАК ДатаЗаметки
						ИЗ
							Справочник.Заметки КАК Заметки
						СГРУППИРОВАТЬ ПО
							Заметки.Предмет) КАК ПоследняяЗаметка
		ПО ДокументсмартРегламентноеОбслуживаниеКлиентов.Ссылка = ПоследняяЗаметка.Предмет
		//-- смарт:ММ 25.10.2021
СГРУППИРОВАТЬ ПО
	//++ смарт:ММ 694 25.10.2021 
	ПоследняяЗаметка.ДатаЗаметки,
	//-- смарт:ММ 25.10.2021
	ДокументсмартРегламентноеОбслуживаниеКлиентов.Ссылка,
