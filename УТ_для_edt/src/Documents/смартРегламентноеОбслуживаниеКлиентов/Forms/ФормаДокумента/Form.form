  <attributes>
    <name>ЗаявкаНаРемонтныеРаботы</name>
    <title>
      <key>ru</key>
      <value>Заявка на ремонтные работы</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DocumentRef.смартЗаявкаНаРемонтныеРаботы</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
