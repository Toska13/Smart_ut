		ЭтотОбъект.Записать();
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументСсылка.ЗаказКлиента") 
		И Источник.ДокументОснование = Объект.Ссылка Тогда
		
		Объект.Статус = Перечисления.смартСтатусыРегламентногоОбслуживания.ВыставленСчетНаКомплект;
		Модифицированность = Истина;
		
		ЭтотОбъект.Записать();

	КонецЕсли;
		
КонецПроцедуры //-- смарт:ММ 30.08.2021

