//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаКлиенте
Процедура ПривязатьЗаявкаНаРемонтныеРаботы(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Документ не записан. Действие не может быть выполнено.");		
		Возврат;
	КонецЕсли;
	
	СуществующаяСвязьСЗаявкой = НайтиЗаявкуНаРемонтныеРаботы();
	Если ЗначениеЗаполнено(СуществующаяСвязьСЗаявкой) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Уже существует связь с %1", СуществующаяСвязьСЗаявкой), СуществующаяСвязьСЗаявкой);
		Возврат;
	КонецЕсли;
	
	МассивПодходящихЗаявокНаРемонт = НайтиЗаявкиНаРемонтПоОборудованиюИСерии();
	Если МассивПодходящихЗаявокНаРемонт.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Не найдено заявок на ремонт с оборудованием '%1' и серией '%2'", 
															  Объект.Оборудование, Объект.Серия));
		Возврат;
	ИначеЕсли МассивПодходящихЗаявокНаРемонт.Количество() = 1 Тогда
		ПривязатьЗаявкаНаРемонтныеРаботыЗавершение(МассивПодходящихЗаявокНаРемонт[0], Новый Структура);
	Иначе
	
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
		ПараметрыОткрытия.Вставить("МножественныйВыбор", Ложь);
		ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
		ПараметрыОткрытия.Вставить("Отбор", Новый Структура("Ссылка", МассивПодходящихЗаявокНаРемонт));
		
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПривязатьЗаявкаНаРемонтныеРаботыЗавершение", ЭтотОбъект);
		
		ОткрытьФорму("Документ.смартЗаявкаНаРемонтныеРаботы.Форма.ФормаВыбора", ПараметрыОткрытия, ЭтаФорма, , , , 
					 ОписаниеОповещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаКлиенте
Процедура ОтвязатьЗаявкаНаРемонтныеРаботы(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Документ не записан. Действие не может быть выполнено.");		
		Возврат;
	КонецЕсли;
	
	СуществующаяСвязьСЗаявкой = НайтиЗаявкуНаРемонтныеРаботы();
	Если НЕ ЗначениеЗаполнено(СуществующаяСвязьСЗаявкой) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не существует связи с заявкой на ремонтые работы. Отвязка не может быть произведена");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЗаявкаНаРемонт", СуществующаяСвязьСЗаявкой);
			
	Оповещение = Новый ОписаниеОповещения("ВопросПередОтвязкойДокументОснованияЗаявкиНаРемонтныеРаботыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	ТекстВопроса = НСтр(СтрШаблон("ru = 'Вы уверены, что хотите отвязать связь с %1'", СуществующаяСвязьСЗаявкой));
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	
КонецПроцедуры

#КонецОбласти

#Область ПривязкаОтвязкаЗаявкиНаРемонтныеРаботы

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаСервере
Процедура ЗаполнитьДокументОснованиеВЗаявкеНаРемонт(ЗаявкаНаРемонт, Отвязать = Ложь)
	
	Модифицированность = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокОбъект = ЗаявкаНаРемонт.ПолучитьОбъект();
	Если Отвязать Тогда
		ДокОбъект.ДокументОснование = Неопределено;
	Иначе
		ДокОбъект.ДокументОснование = Объект.Ссылка;
	КонецЕсли;
	
	Попытка
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		ЭтотОбъект.Записать();
		
		Если Отвязать Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Для документа %1 сброшена связь с документом %2", ЗаявкаНаРемонт, Объект.Ссылка), ЗаявкаНаРемонт);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Для документа %1 указан документ-основание %2", ЗаявкаНаРемонт, Объект.Ссылка), ЗаявкаНаРемонт);
		КонецЕсли;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось записать документ %1 по причине %2%3", ЗаявкаНаРемонт, Символы.ПС, ОписаниеОшибки()), ЗаявкаНаРемонт);
	КонецПопытки;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //-- смарт:ММ 27.08.2021

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаКлиенте
Процедура ПривязатьЗаявкаНаРемонтныеРаботыЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено И ТипЗнч(РезультатЗакрытия) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		ДокОснование = ПолучитьРеквизитОбъекта(РезультатЗакрытия, "ДокументОснование");
		
		Если ЗначениеЗаполнено(ДокОснование) Тогда
			
			Если ДокОснование = Объект.Ссылка Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("В выбранной заявке на ремонт уже привязан текущий документ");
				Возврат;
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЗаявкаНаРемонт", РезультатЗакрытия);
			
			Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемДокументОснованияЗаявкиНаРемонтныеРаботыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ТекстВопроса = НСтр("ru = 'В заявке на ремонт уже заполнен документ-основание. Заменить документ-основание на текущий?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Иначе
			ЗаполнитьДокументОснованиеВЗаявкеНаРемонт(РезультатЗакрытия);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
Функция НайтиЗаявкиНаРемонтПоОборудованиюИСерии()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы.Оборудование КАК Т
	|ГДЕ
	|	Т.Серия = &Серия
	|	И НЕ Т.Ссылка.ПометкаУдаления
	|	И Т.ОборудованиеКлиентов = &Оборудование";
	
	Запрос.УстановитьПараметр("Оборудование", Объект.Оборудование);
	Запрос.УстановитьПараметр("Серия", Объект.Серия);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаКлиенте
Процедура ВопросПередЗаполнениемДокументОснованияЗаявкиНаРемонтныеРаботыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		ЗаполнитьДокументОснованиеВЗаявкеНаРемонт(ДополнительныеПараметры.ЗаявкаНаРемонт);		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б1298 смарт: Шляпников 08.11.2024 / Механизм связки документов в рамках задачи Доплнительно гарантии
&НаКлиенте
Процедура ВопросПередОтвязкойДокументОснованияЗаявкиНаРемонтныеРаботыЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		ЗаполнитьДокументОснованиеВЗаявкеНаРемонт(ДополнительныеПараметры.ЗаявкаНаРемонт, Истина);		
	КонецЕсли;
	
КонецПроцедуры
