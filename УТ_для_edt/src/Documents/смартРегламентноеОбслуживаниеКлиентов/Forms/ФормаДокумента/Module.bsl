	|	И НЕ смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	|
	//rnp 31.08.2021 помеченные на удаление не показываем
	//|ОБЪЕДИНИТЬ ВСЕ
	//|
	//|ВЫБРАТЬ
	//|	смартЗаявкаНаРемонтныеРаботы.Ссылка,
	//|	2
	//|ИЗ
	//|	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	//|ГДЕ
	//|	смартЗаявкаНаРемонтныеРаботы.ДокументОснование = &ДокументОснование
	//|	И смартЗаявкаНаРемонтныеРаботы.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МИНИМУМ(ВТ_Приоритеты.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВТ_МинимальныйПриоритет
	|ИЗ
	|	ВТ_Приоритеты КАК ВТ_Приоритеты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВТ_Приоритеты.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Приоритеты КАК ВТ_Приоритеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МинимальныйПриоритет КАК ВТ_МинимальныйПриоритет
	|		ПО ВТ_Приоритеты.Приоритет = ВТ_МинимальныйПриоритет.Приоритет";
	
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
КонецФункции //-- смарт:ММ 30.08.2021

