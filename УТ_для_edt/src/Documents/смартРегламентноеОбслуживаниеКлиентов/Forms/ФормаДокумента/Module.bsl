//++ смарт:ММ 596 27.08.2021
&НаКлиенте
Процедура ПривязатьЗаказКлиентаЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ВыбранныйЗаказ = Неопределено;
	
	Если РезультатЗакрытия <> Неопределено И ТипЗнч(РезультатЗакрытия) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ВыбранныйЗаказ = РезультатЗакрытия;		
		
		ДокОснование = ПолучитьРеквизитОбъекта(ВыбранныйЗаказ, "ДокументОснование");
		
		Если ЗначениеЗаполнено(ДокОснование) Тогда
			
			Если ДокОснование = Объект.Ссылка Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю("В выбранном заказе клиента уже привязан текущий документ");
				Возврат;
			КонецЕсли;
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("ЗаказКлиента", ВыбранныйЗаказ);
			
			Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемДокументОснованияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ТекстВопроса = НСтр("ru = 'В заказе клиента уже заполнен документ-основание. Заменить документ-основание на текущий?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Иначе
			ЗаполнитьДокументОснованиеВЗаказе(ВыбранныйЗаказ);
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры //-- смарт:ММ 27.08.2021

//++ смарт:ММ 596 27.08.2021
&НаКлиенте
Процедура ВопросПередЗаполнениемДокументОснованияЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ЗаполнитьДокументОснованиеВЗаказе(ДополнительныеПараметры.ЗаказКлиента);		
	
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 27.08.2021

//++ смарт:ММ 596 27.08.2021
&НаСервере
Процедура ЗаполнитьДокументОснованиеВЗаказе(ВыбранныйЗаказ)
	
	Модифицированность = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокОбъект = ВыбранныйЗаказ.ПолучитьОбъект();
	ДокОбъект.ДокументОснование = Объект.Ссылка;
	
	Попытка
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыРегламентногоОбслуживания.ВыставленСчетНаКомплект");
		
		ЭтотОбъект.Записать();
		
		ОбщегоНазначения.СообщитьПользователю("Для документа " + ВыбранныйЗаказ + " указан документ-основание " + Объект.Ссылка, ВыбранныйЗаказ);
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Не удалось записать документ " + ВыбранныйЗаказ + Символы.ПС + ОписаниеОшибки(), ВыбранныйЗаказ);
	КонецПопытки;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры //-- смарт:ММ 27.08.2021

//++ смарт:ММ 596 27.08.2021
&НаКлиенте
Процедура ОтвязатьЗаказКлиентаЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
		
	Если РезультатЗакрытия <> Неопределено И ТипЗнч(РезультатЗакрытия) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ОтвязатьОтЗаказаКлиентаЗапись(РезультатЗакрытия, Объект.Ссылка);
			
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 27.08.2021

//++ смарт:ММ 596 27.08.2021
&НаСервере
Процедура ОтвязатьОтЗаказаКлиентаЗапись(ЗаказКлиента, ЗаявкаНаРемонтныеРаботы)
	
	Модифицированность = Истина;
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(ЗаказКлиента) Тогда
		
		ДокОбъект = ЗаказКлиента.ПолучитьОбъект();
		ДокОбъект.ДокументОснование = Неопределено;
		
		Попытка
			Если ДокОбъект.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыРегламентногоОбслуживания.ПовторныйЗвонокКлиенту");
			
			ЭтотОбъект.Записать();
			
			ОбщегоНазначения.СообщитьПользователю("Для документа " + ЗаказКлиента + " очищен документ-основание " + Объект.Ссылка, ЗаказКлиента);
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось записать документ " + ЗаказКлиента + Символы.ПС + ОписаниеОшибки(), ЗаказКлиента);
		КонецПопытки;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры //-- смарт:ММ 27.08.2021

