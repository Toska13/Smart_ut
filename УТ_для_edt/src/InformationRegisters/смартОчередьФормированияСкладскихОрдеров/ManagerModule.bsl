Процедура ДобавитьЗапись(ДокументОснование, ДокументСобытие, Действие, ОписаниеОшибки = "") Экспорт 
	МенеджерЗаписи = Регистрысведений.смартОчередьФормированияСкладскихОрдеров.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ДокументОснование = ДокументОснование;
	МенеджерЗаписи.ДокументСобытие   = ДокументСобытие;
	МенеджерЗаписи.Действие          = Действие;
	МенеджерЗаписи.Прочитать();
	Если МенеджерЗаписи.Выбран() Тогда
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			МенеджерЗаписи.ДатаОбработки	  = ТекущаяДатаСеанса();
			МенеджерЗаписи.КоличествоПопыток  = МенеджерЗаписи.КоличествоПопыток + 1;
			МенеджерЗаписи.ОписаниеОшибки	  = ОписаниеОшибки;
	        МенеджерЗаписи.Записать();
		КонецЕсли;			
	Иначе
		МенеджерЗаписи.ДокументОснование = ДокументОснование;
		МенеджерЗаписи.ДокументСобытие   = ДокументСобытие;
		МенеджерЗаписи.Действие          = Действие;
		Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
			МенеджерЗаписи.ДатаОбработки	  = ТекущаяДатаСеанса();
			МенеджерЗаписи.КоличествоПопыток  = 1;
			МенеджерЗаписи.ОписаниеОшибки	  = ОписаниеОшибки;
		КонецЕсли;	
		МенеджерЗаписи.Записать();
	КонецЕсли;
КонецПроцедуры 

Процедура УдалитьЗапись(СтруктураЗаписи) Экспорт 
	МенеджерЗаписи = Регистрысведений.смартОчередьФормированияСкладскихОрдеров.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтруктураЗаписи); 
	МенеджерЗаписи.Удалить();
КонецПроцедуры

