#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;
	Иначе
		ОбщегоНазначения.СообщитьПользователю("В форму не передан параметр 'Номенклатура'",,,, Отказ);
	КонецЕсли;
	
	Параметр = СписокАналогов.Параметры.Элементы.Найти("Номенклатура");
	Параметр.Значение = Номенклатура;
	Параметр.Использование = Истина;
	
	Параметр = СписокАналогов.Параметры.Элементы.Найти("ВидЦеныРозничнаяРуб");
	Параметр.Значение = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ВидЦеныРозничнаяRUB");
	Параметр.Использование = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СобытияЭлементовИКоманды

&НаКлиенте
Процедура Выбрать(Команда)
	
	ТекущаяСтрока = Элементы.СписокАналогов.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		Закрыть(ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокАналоговВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыбраннаяСтрока <> Неопределено Тогда
		Закрыть(ВыбраннаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти