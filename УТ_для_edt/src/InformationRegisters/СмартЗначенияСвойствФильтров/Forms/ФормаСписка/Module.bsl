		КомандаПеренестиФильтр.Заголовок = "Выбрать";
		
		Кнопка = Элементы.Добавить("Выбрать", Тип("КнопкаФормы"),);
		Кнопка.Заголовок = "Выбрать";
		Кнопка.ИмяКоманды = "Выбрать";
	КонецЕсли; 
