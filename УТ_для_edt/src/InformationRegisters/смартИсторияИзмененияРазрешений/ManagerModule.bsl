#Область Интерфейс

Функция ЗаписатьРазрешениеВИсторию(Документ, ДопПараметры = Неопределено, ВидРазрешения, Разрешено, ИДЗаписи = Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИДЗаписи = Неопределено Тогда
		ИДЗаписи = СокрЛП(Новый УникальныйИдентификатор);
	КонецЕсли;
	
	рег = РегистрыСведений.смартИсторияИзмененияРазрешений.СоздатьНаборЗаписей();
	рег.Отбор.Документ.Установить(Документ, Истина);
	рег.Отбор.ИД.Установить(ИДЗаписи, Истина);
	рег.Отбор.ВидРазрешения.Установить(ВидРазрешения, Истина);
	
	Запись = рег.Добавить();
	Запись.Документ = Документ;
	Запись.ИД = ИДЗаписи;
	Запись.ВидРазрешения = ВидРазрешения;
	Запись.Разрешено = Разрешено;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Ответственный = Пользователи.АвторизованныйПользователь();
	
	Если НЕ ДопПараметры = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Запись, ДопПараметры);
	КонецЕсли;
	
	рег.ОбменДанными.Загрузка = Истина;
	рег.Записать(Истина);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ИДЗаписи;
	
КонецФункции

Функция ПолучитьИнформациюОПоследнемРазрешении(Документ, ВидРазрешения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	*
	|ИЗ
	|	РегистрСведений.смартИсторияИзмененияРазрешений КАК смартИсторияИзмененияРазрешений
	|ГДЕ
	|	смартИсторияИзмененияРазрешений.Документ = &Документ
	|	И смартИсторияИзмененияРазрешений.ВидРазрешения = &ВидРазрешения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаИзменения УБЫВ";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ВидРазрешения", ВидРазрешения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьИнформациюПоРазрешению(Документ, ИД, ВидРазрешения) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	РегистрСведений.смартИсторияИзмененияРазрешений КАК смартИсторияИзмененияРазрешений
	|ГДЕ
	|	смартИсторияИзмененияРазрешений.Документ = &Документ
	|	И смартИсторияИзмененияРазрешений.ИД = &ИД
	|	И смартИсторияИзмененияРазрешений.ВидРазрешения = &ВидРазрешения";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ИД", ИД);
	Запрос.УстановитьПараметр("ВидРазрешения", ВидРазрешения);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

