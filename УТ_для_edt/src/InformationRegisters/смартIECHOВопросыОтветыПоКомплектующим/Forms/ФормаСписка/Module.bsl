&НаКлиенте
Процедура СкопироватьДругим(Команда)
	
	ОписаниеОпопвещенияОЗакрытии = Новый ОписаниеОповещения("смартПослеЗакрытияСкопироватьДругим", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.смартIECHOВопросыОтветыПоКомплектующим.Форма.ПодобранныеКомплектующие", , ЭтаФорма,,,, ОписаниеОпопвещенияОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

//++ смарт:ММ 621 30.09.2021 
&НаКлиенте
Процедура смартПослеЗакрытияСкопироватьДругим(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("Массив") Тогда
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		Если ТекущиеДанные <> Неопределено Тогда
			смартСкопироватьДругимСервер(РезультатЗакрытия, ТекущиеДанные.ИсходнаяКомплектующая);
			Оповестить("смартИзмененРегистрсмартIECHOВопросыОтветыПоКомплектующим");
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

//++ смарт:ММ 621 30.09.2021  
&НаСервере
Процедура смартСкопироватьДругимСервер(МассивКомплектующих, ИсходнаяКомплектующая)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартIECHOВопросыОтветыПоКомплектующим.Вопрос,
	|	смартIECHOВопросыОтветыПоКомплектующим.Ответ,
	|	смартIECHOВопросыОтветыПоКомплектующим.Комплектующая
	|ИЗ
	|	РегистрСведений.смартIECHOВопросыОтветыПоКомплектующим КАК смартIECHOВопросыОтветыПоКомплектующим
	|ГДЕ 
	|   смартIECHOВопросыОтветыПоКомплектующим.ИсходнаяКомплектующая = &ИсходнаяКомплектующая
	|";
	
	Запрос.УстановитьПараметр("ИсходнаяКомплектующая", ИсходнаяКомплектующая);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для Каждого ЭлементМассива Из МассивКомплектующих Цикл
			
			МенеджерЗаписи = РегистрыСведений.смартIECHOВопросыОтветыПоКомплектующим.СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
			МенеджерЗаписи.ИсходнаяКомплектующая = ЭлементМассива;
						
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

//++ смарт:ММ 621 30.09.2021 
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "смартИзмененРегистрсмартIECHOВопросыОтветыПоКомплектующим" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 30.09.2021

