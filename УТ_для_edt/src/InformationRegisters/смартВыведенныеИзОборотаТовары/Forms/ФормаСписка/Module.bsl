#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.Список.КонтекстноеМеню.ПодчиненныеЭлементы.СписокКонтекстноеМенюИзменить.Видимость = Ложь;
	Элементы.Список.КонтекстноеМеню.ПодчиненныеЭлементы.СписокКонтекстноеМенюКопированиеИВыделение.Видимость = Ложь;
	
	//++ #1877 смарт: Мосолов 26.06.2024 // Роль "только чтение" на отчет "Выведенные из оборота товары(смарт)" 
	Если Не ЕстьПраваНаИзменение() Тогда
		
		ТолькоПросмотр = Истина;
		
	КонецЕсли;
	//-- #1877 смарт: Мосолов 26.06.2024 
	
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
	
	//++ #1877 смарт: Мосолов 26.06.2024 // Роль "только чтение" на отчет "Выведенные из оборота товары(смарт)" 
	Если ЕстьПраваНаИзменение() Тогда
	//-- #1877 смарт: Мосолов 26.06.2024 
		
	ОткрытьФормуИзмененияТоваров(); 
	
	//++ #1877 смарт: Мосолов 26.06.2024 // Роль "только чтение" на отчет "Выведенные из оборота товары(смарт)" 
	КонецЕсли;
	//-- #1877 смарт: Мосолов 26.06.2024 
	
КонецПроцедуры  

//++ #1877 смарт: Мосолов 26.06.2024 // Роль "только чтение" на отчет "Выведенные из оборота товары(смарт)" 
&НаСервере
Функция ЕстьПраваНаИзменение()
	
	Возврат РольДоступна("ПолныеПрава") ИЛИ РольДоступна("смартДобавлениеИзменениеВыводаТоваровИзОборота"); 
	
КонецФункции //-- #1877 смарт: Мосолов 26.06.2024


&НаСервере
Процедура ПолучитьДокументКорректировки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Корректировка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРегистров КАК Корректировка
	|ГДЕ
	|	НЕ Корректировка.ПометкаУдаления
	|	И Корректировка.смартВыводТоваровИзОборота";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		
		Корректировка = Выборка.Ссылка; 
		
	Иначе 
		
		УстановитьПривилегированныйРежим(Истина); 
	
		КорректировкаРегистров = Документы.КорректировкаРегистров.СоздатьДокумент();
		КорректировкаРегистров.Дата = ТекущаяДата(); 
		КорректировкаРегистров.Операция = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
		КорректировкаРегистров.смартВыводТоваровИзОборота = Истина;
		
		СтрокаСРегистром = КорректировкаРегистров.ТаблицаРегистров.Добавить();
		СтрокаСРегистром.Имя = "ТоварыКОтгрузке";
		
		СтрокаСРегистром = КорректировкаРегистров.ТаблицаРегистров.Добавить();
		СтрокаСРегистром.Имя = "СвободныеОстатки";
		
		КорректировкаРегистров.Записать();
		
		Корректировка = Корректировка.Ссылка; 
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТовары(Команда)   
	
	ОткрытьФормуИзмененияТоваров();  
	
КонецПроцедуры    

&НаКлиенте
Процедура ОткрытьФормуИзмененияТоваров()
	
	ПолучитьДокументКорректировки();
	
	ПараметрыФормы = Новый Структура("Ключ", Корректировка);
	ОткрытьФорму("РегистрСведений.смартВыведенныеИзОборотаТовары.Форма.ФормаВыводаТоваровИзОборота", 
			ПараметрыФормы,
			ЭтаФорма,,,,
			Новый ОписаниеОповещения("ПослеИзмененияТоваров", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);   

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияТоваров(Результат, ДополнительныеПараметры) Экспорт  
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

