
&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
	
	//Отказ = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Курс КАК Курс
	|ПОМЕСТИТЬ КурсыЕВРО
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Валюта = &EUR
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Курс КАК Курс
	|ПОМЕСТИТЬ КурсыДоллар
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Валюта = &USD
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КурсыВалют.Период КАК Период,
	|	КурсыВалют.Курс КАК Курс
	|ПОМЕСТИТЬ КурсыЮань
	|ИЗ
	|	РегистрСведений.КурсыВалют КАК КурсыВалют
	|ГДЕ
	|	КурсыВалют.Валюта = &CNY
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартИсточникиРекламногоВоздействияОборудованиеИОператоры.Партнер КАК Партнер,
	|	смартИсточникиРекламногоВоздействияОборудованиеИОператоры.Оборудование КАК Оборудование,
	|	смартИсточникиРекламногоВоздействияОборудованиеИОператоры.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ПартнерыВИсточниках
	|ИЗ
	|	Справочник.смартИсточникиРекламногоВоздействия.ОборудованиеИОператоры КАК смартИсточникиРекламногоВоздействияОборудованиеИОператоры
	|ГДЕ
	|	НЕ смартИсточникиРекламногоВоздействияОборудованиеИОператоры.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаТовары.РекламноеВоздействие КАК ИсточникБонусов,
	|	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	|	ЕСТЬNULL(ОборудованиеИОператорыБезПартнера.Оператор, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Сотрудник,
	|	ЗаказКлиентаТовары.Номенклатура КАК Оборудование,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &EUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЕВРО.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &USD
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыДоллар.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &CNY
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЮань.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &RUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС
	|		ИНАЧЕ ЗаказКлиентаТовары.СуммаСНДС
	|	КОНЕЦ КАК СуммаВыручки,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &EUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЕВРО.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &USD
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыДоллар.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &CNY
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЮань.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &RUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС
	|		ИНАЧЕ ЗаказКлиентаТовары.СуммаСНДС
	|	КОНЕЦ * ВЫБОР
	|		КОГДА ЕСТЬNULL(ОборудованиеИОператорыБезПартнера.Оператор, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ОборудованиеИОператорыБезПартнера.Процент
	|	КОНЕЦ / 100 КАК БонусНачисленный
	|ПОМЕСТИТЬ ПредварительныеЛанные
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыЕВРО КАК КурсыЕВРО
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыЕВРО.Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыДоллар КАК КурсыДоллар
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыДоллар.Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыЮань КАК КурсыЮань
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыЮань.Период)
	|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.смартИсточникиРекламногоВоздействия.ОборудованиеИОператоры КАК ОборудованиеИОператорыБезПартнера
	|		ПО (ОборудованиеИОператорыБезПартнера.Ссылка = ЗаказКлиентаТовары.РекламноеВоздействие)
	|			И ЗаказКлиентаТовары.Номенклатура = ОборудованиеИОператорыБезПартнера.Оборудование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ЗаказКлиентаТовары.Ссылка = СостоянияЗаказовКлиентов.Заказ
	|ГДЕ
	|	ЗаказКлиентаТовары.РекламноеВоздействие В
	|			(ВЫБРАТЬ
	|				ПартнерыВИсточниках.Ссылка
	|			ИЗ
	|				ПартнерыВИсточниках)
	|	И ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И НЕ ЗаказКлиентаТовары.Отменено
	|	И СостоянияЗаказовКлиентов.ПроцентОплаты > 0
	|	И ОборудованиеИОператорыБезПартнера.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|	И НЕ (ЗаказКлиентаТовары.Номенклатура, ЗаказКлиентаТовары.Ссылка.Партнер) В
	|				(ВЫБРАТЬ
	|					ПартнерыВИсточниках.Оборудование,
	|					ПартнерыВИсточниках.Партнер
	|				ИЗ
	|					ПартнерыВИсточниках)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.РекламноеВоздействие,
	|	ЗаказКлиентаТовары.Ссылка,
	|	ЕСТЬNULL(ОборудованиеИОператорыСПартнером.Оператор, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)),
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &EUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЕВРО.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &USD
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыДоллар.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &CNY
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЮань.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &RUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС
	|		ИНАЧЕ ЗаказКлиентаТовары.СуммаСНДС
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &EUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЕВРО.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &USD
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыДоллар.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &CNY
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС * ЕСТЬNULL(КурсыЮань.Курс, 1)
	|		КОГДА ЗаказКлиентаТовары.Ссылка.Валюта = &RUR
	|			ТОГДА ЗаказКлиентаТовары.СуммаСНДС
	|		ИНАЧЕ ЗаказКлиентаТовары.СуммаСНДС
	|	КОНЕЦ * ОборудованиеИОператорыСПартнером.Процент / 100
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыЕВРО КАК КурсыЕВРО
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыЕВРО.Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыДоллар КАК КурсыДоллар
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыДоллар.Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КурсыЮань КАК КурсыЮань
	|		ПО (НАЧАЛОПЕРИОДА(ЗаказКлиентаТовары.Ссылка.Дата, ДЕНЬ) = КурсыЮань.Период)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ЗаказКлиентаТовары.Ссылка = СостоянияЗаказовКлиентов.Заказ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартИсточникиРекламногоВоздействия.ОборудованиеИОператоры КАК ОборудованиеИОператорыСПартнером
	|		ПО ЗаказКлиентаТовары.РекламноеВоздействие = ОборудованиеИОператорыСПартнером.Ссылка
	|			И ЗаказКлиентаТовары.Номенклатура = ОборудованиеИОператорыСПартнером.Оборудование
	|			И ЗаказКлиентаТовары.Ссылка.Партнер = ОборудованиеИОператорыСПартнером.Партнер
	|ГДЕ
	|	ЗаказКлиентаТовары.РекламноеВоздействие В
	|			(ВЫБРАТЬ
	|				ПартнерыВИсточниках.Ссылка
	|			ИЗ
	|				ПартнерыВИсточниках)
	|	И ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И НЕ ЗаказКлиентаТовары.Отменено
	|	И СостоянияЗаказовКлиентов.ПроцентОплаты > 0
	|	И НЕ ОборудованиеИОператорыСПартнером.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредварительныеЛанные.ИсточникБонусов КАК ИсточникБонусов,
	|	ПредварительныеЛанные.ЗаказКлиента КАК ЗаказКлиента,
	|	ПредварительныеЛанные.Сотрудник КАК Сотрудник,
	|	ПредварительныеЛанные.Оборудование КАК Оборудование,
	|	ПредварительныеЛанные.СуммаВыручки КАК СуммаВыручки,
	|	ПредварительныеЛанные.БонусНачисленный КАК БонусНачисленный
	|ИЗ
	|	ПредварительныеЛанные КАК ПредварительныеЛанные
	|ГДЕ
	|	НЕ ПредварительныеЛанные.Сотрудник = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)"); 
	Запрос.УстановитьПараметр("CNY", Справочники.Валюты.НайтиПоКоду("156"));
	Запрос.УстановитьПараметр("EUR", Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("USD", Справочники.Валюты.НайтиПоКоду("840"));
	Запрос.УстановитьПараметр("RUR", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.смартБонусыИнженеров.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИсточникБонусов.Установить(Выборка.ИсточникБонусов);
		НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
		НаборЗаписей.Отбор.ЗаказКлиента.Установить(Выборка.ЗаказКлиента);
		НаборЗаписей.Отбор.Оборудование.Установить(Выборка.Оборудование);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			
			СтрНаборЗаписей = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(СтрНаборЗаписей, Выборка);
			НаборЗаписей.Записать(Истина);
			
		ИначеЕсли НЕ НаборЗаписей[0].БонусВыплачен Тогда
			
			ЗаполнитьЗначенияСвойств(НаборЗаписей[0], Выборка);
			НаборЗаписей.Записать(Истина);				
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Выплатить(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ", Элементы.Список.ТекущаяСтрока);
	ПараметрыОткрытия.Вставить("ПланируетсяВыплата", Истина);
	
	Оповещение = Новый ОписаниеОповещения("смартОбновитьСписокПослеУстановкиВыплаты", ЭтаФорма);
	
	ОткрытьФорму("РегистрСведений.смартБонусыИнженеров.Форма.ФормаЗаписи", ПараметрыОткрытия, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура смартОбновитьСписокПослеУстановкиВыплаты(Значение, ДопПараметры) Экспорт
	
	Элементы.Список.Обновить();	

КонецПроцедуры	
