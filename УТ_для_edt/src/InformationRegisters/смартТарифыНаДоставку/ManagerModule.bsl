#Область Интерфейс

Функция РассчитатьДоставкуПоЗаказуКлиента(ЗаказКлиента, УчитыватьОтгруженныеЗаказы = Истина, СчитатьПоМаксимальномуТарифу = Ложь) Экспорт
	
	Результат = Новый Структура("ЗаказКлиента,РегионЗаказа,ГородЗаказа,РасстояниеЗаказа,ВесЗаказа,СуммаЗаказа,СкидкаНаценка,СтоимостьДоставки,ДополнительныеДанные");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	МассивТекстов = Новый Массив;
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ДокЗаказ.Ссылка.Партнер) КАК Партнер,
		|	МАКСИМУМ(ДокЗаказ.Ссылка.АдресДоставки) КАК АдресДоставки,
		|	МАКСИМУМ(ДокЗаказ.ДатаОтгрузки) КАК ЖелаемаяДатаОтгрузки,
		|	МАКСИМУМ(ДокЗаказ.Ссылка.СпособДоставки) КАК СпособДоставки
		|ПОМЕСТИТЬ ВТПараметрыЗаказа
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ДокЗаказ
		|ГДЕ
		|	ДокЗаказ.Ссылка = &ЗаказКлиента
		|	И ДокЗаказ.Ссылка.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ДоКлиента)";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	&Партнер КАК Партнер,
		|	&АдресДоставки КАК АдресДоставки,
		|	&ЖелаемаяДатаОтгрузки КАК ЖелаемаяДатаОтгрузки,
		|	&СпособДоставки КАК СпособДоставки
		|ПОМЕСТИТЬ ВТПараметрыЗаказа
		|ГДЕ
		|	&СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ДоКлиента)";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("Партнер", ЗаказКлиента.Партнер);
		Запрос.УстановитьПараметр("АдресДоставки", ЗаказКлиента.АдресДоставки);
		Запрос.УстановитьПараметр("СпособДоставки", ЗаказКлиента.СпособДоставки);
		
		ДатаДоставки = ЗаказКлиента.ЖелаемаяДатаОтгрузки;
		Для каждого стрТовары Из ЗаказКлиента.Товары Цикл
			ДатаДоставки = Макс(ДатаДоставки, стрТовары.ДатаОтгрузки);
		КонецЦикла;
		Запрос.УстановитьПараметр("ЖелаемаяДатаОтгрузки", ДатаДоставки);
		
	КонецЕсли;
		
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДокЗаказ.Ссылка КАК Ссылка,
	|	ДокЗаказ.Ссылка.СуммаДокумента КАК СуммаДокумента,
	|	ДокЗаказ.Ссылка.Валюта КАК Валюта
	|ПОМЕСТИТЬ ВТЗаказы
	|ИЗ
	|	ВТПараметрыЗаказа КАК ВТПараметрыЗаказа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ДокЗаказ
	|		ПО ВТПараметрыЗаказа.Партнер = ДокЗаказ.Ссылка.Партнер
	|			И ВТПараметрыЗаказа.АдресДоставки = ДокЗаказ.Ссылка.АдресДоставки
	|			И ВТПараметрыЗаказа.ЖелаемаяДатаОтгрузки = ДокЗаказ.ДатаОтгрузки
	|			И ВТПараметрыЗаказа.СпособДоставки = ДокЗаказ.Ссылка.СпособДоставки
	|			И (ДокЗаказ.Ссылка.Проведен)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО (ДокЗаказ.Ссылка = СостоянияЗаказовКлиентов.Заказ)
	|ГДЕ
	|	(НЕ СостоянияЗаказовКлиентов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт)
	|				И НЕ СостоянияЗаказовКлиентов.ПроцентОтгрузки = 100
	|			ИЛИ &УчитыватьВсеЗаказы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТЗаказы.Ссылка КАК Заказ,
	|	СУММА(-ЗаказКлиентаСкидкиНаценки.Сумма) КАК СуммаДоставки
	|ПОМЕСТИТЬ ВТСуммыДоставки
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.СкидкиНаценки КАК ЗаказКлиентаСкидкиНаценки
	|		ПО ВТЗаказы.Ссылка = ЗаказКлиентаСкидкиНаценки.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаДоставки, ) КАК смартТарифыНаДоставкуСрезПоследних
	|		ПО (ЗаказКлиентаСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка)
	|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
	|ГДЕ
	|	ЗаказКлиентаСкидкиНаценки.Ссылка = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТЗаказы.Ссылка";
	
	МассивТекстов.Добавить(ТекстЗапроса);
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
	
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	МАКСИМУМ(ДанныеОРегионе.Значение) КАК РегионЗаказа,
		|	МАКСИМУМ(ДанныеОГороде.Значение) КАК ГородЗаказа,
		|	МАКСИМУМ(ДанныеОРасстоянии.Значение) КАК РасстояниеЗаказа,
		|	СУММА(ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеОВесе.Значение КАК ЧИСЛО(15, 2)), 0)) КАК ВесЗаказа,
		|	СУММА(ДокЗаказ.СуммаДокумента * КурсыВалютСрезПоследних.Курс / ВЫБОР
		|			КОГДА КурсыВалютСрезПоследних.Кратность = 0
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалютСрезПоследних.Кратность
		|		КОНЕЦ) - СУММА(ЕСТЬNULL(ВТСуммыДоставки.СуммаДоставки, 0) * КурсыВалютСрезПоследних.Курс / ВЫБОР
		|			КОГДА КурсыВалютСрезПоследних.Кратность = 0
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалютСрезПоследних.Кратность
		|		КОНЕЦ) КАК Сумма
		|ПОМЕСТИТЬ ВТДанныеДляРасчетаДоставки
		|ИЗ
		|	ВТЗаказы КАК ДокЗаказ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОРегионе
		|		ПО ДокЗаказ.Ссылка = ДанныеОРегионе.Объект
		|			И (ДанныеОРегионе.Свойство.Имя = ""РегионДоставки"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОГороде
		|		ПО ДокЗаказ.Ссылка = ДанныеОГороде.Объект
		|			И (ДанныеОГороде.Свойство.Имя = ""ГородДоставки"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОВесе
		|		ПО ДокЗаказ.Ссылка = ДанныеОВесе.Объект
		|			И (ДанныеОВесе.Свойство.Имя = ""ВесЗаказа"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОРасстоянии
		|		ПО ДокЗаказ.Ссылка = ДанныеОРасстоянии.Объект
		|			И (ДанныеОРасстоянии.Свойство.Имя = ""РасстояниеДоставки"")
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
		|		ПО ДокЗаказ.Валюта = КурсыВалютСрезПоследних.Валюта
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСуммыДоставки КАК ВТСуммыДоставки
		|		ПО ДокЗаказ.Ссылка = ВТСуммыДоставки.Заказ";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
		
	Иначе
		
		СуммаЗаказа = РаботаСКурсамиВалют.ПересчитатьВВалюту(ЗаказКлиента.СуммаДокумента - ПолучитьРассчитаннуюСуммуДоставки(ЗаказКлиента), 
															ЗаказКлиента.Валюта, 
															смартОбщегоНазначенияСКэш.ВалютаРегламентированногоУчета(), 
															ЗаказКлиента.Дата);
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Данные.РегионЗаказа) КАК РегионЗаказа,
		|	СУММА(Данные.ВесЗаказа) КАК ВесЗаказа,
		|	СУММА(Данные.Сумма) КАК Сумма,
		|	МАКСИМУМ(Данные.ГородЗаказа) КАК ГородЗаказа,
		|	МАКСИМУМ(Данные.РасстояниеЗаказа) КАК РасстояниеЗаказа
		|ПОМЕСТИТЬ ВТДанныеДляРасчетаДоставки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДанныеОРегионе.Значение КАК РегионЗаказа,
		|		ДанныеОРегионе.Значение КАК ГородЗаказа,
		|		ДанныеОРасстоянии.Значение КАК РасстояниеЗаказа,
		|		ЕСТЬNULL(ВЫРАЗИТЬ(ДанныеОВесе.Значение КАК ЧИСЛО(15, 2)), 0) КАК ВесЗаказа,
		|		ДокЗаказ.СуммаДокумента * КурсыВалютСрезПоследних.Курс / ВЫБОР
		|			КОГДА КурсыВалютСрезПоследних.Кратность = 0
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалютСрезПоследних.Кратность
		|		КОНЕЦ - ЕСТЬNULL(ВТСуммыДоставки.СуммаДоставки, 0) * КурсыВалютСрезПоследних.Курс / ВЫБОР
		|			КОГДА КурсыВалютСрезПоследних.Кратность = 0
		|				ТОГДА 1
		|			ИНАЧЕ КурсыВалютСрезПоследних.Кратность
		|		КОНЕЦ КАК Сумма
		|	ИЗ
		|		ВТЗаказы КАК ДокЗаказ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОРегионе
		|			ПО ДокЗаказ.Ссылка = ДанныеОРегионе.Объект
		|				И (ДанныеОРегионе.Свойство.Имя = ""РегионДоставки"")
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОГороде
		|			ПО ДокЗаказ.Ссылка = ДанныеОГороде.Объект
		|				И (ДанныеОГороде.Свойство.Имя = ""ГородДоставки"")
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОВесе
		|			ПО ДокЗаказ.Ссылка = ДанныеОВесе.Объект
		|				И (ДанныеОВесе.Свойство.Имя = ""ВесЗаказа"")
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДанныеОРасстоянии
		|			ПО ДокЗаказ.Ссылка = ДанныеОРасстоянии.Объект
		|				И (ДанныеОРасстоянии.Свойство.Имя = ""РасстояниеДоставки"")
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
		|			ПО ДокЗаказ.Валюта = КурсыВалютСрезПоследних.Валюта
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТСуммыДоставки КАК ВТСуммыДоставки
		|			ПО ДокЗаказ.Ссылка = ВТСуммыДоставки.Заказ
		|	ГДЕ
		|		ДокЗаказ.Ссылка <> &ЗаказКлиента
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		&РегионЗаказа,
		|		&ГородЗаказа,
		|		&РасстояниеЗаказа,
		|		&ВесЗаказа,
		|		&СуммаДокумента) КАК Данные";
		
		МассивТекстов.Добавить(ТекстЗапроса);
		
		Запрос.УстановитьПараметр("РегионЗаказа", ЗаказКлиента.ДополнительныеСвойства.Регион);
		Запрос.УстановитьПараметр("ГородЗаказа", ЗаказКлиента.ДополнительныеСвойства.Город);
		Запрос.УстановитьПараметр("ВесЗаказа", ЗаказКлиента.ДополнительныеСвойства.ВесЗаказа);
		Запрос.УстановитьПараметр("РасстояниеЗаказа", ЗаказКлиента.ДополнительныеСвойства.Расстояние);
		Запрос.УстановитьПараметр("СуммаДокумента", СуммаЗаказа);
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента.Ссылка);
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВТЗаказы.Ссылка КАК Ссылка,
	|	ВТЗаказы.СуммаДокумента КАК СуммаДокумента,
	|	ВТЗаказы.Валюта КАК Валюта,
	|	ЕСТЬNULL(ВТСуммыДоставки.СуммаДоставки, 0) КАК СуммаДоставки
	|ИЗ
	|	ВТЗаказы КАК ВТЗаказы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСуммыДоставки КАК ВТСуммыДоставки
	|		ПО ВТЗаказы.Ссылка = ВТСуммыДоставки.Заказ";
	
	МассивТекстов.Добавить(ТекстЗапроса);
	
	Если СчитатьПоМаксимальномуТарифу Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	МАКСИМУМ(смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка) КАК СкидкаНаценка,
		|	МАКСИМУМ(смартТарифыНаДоставкуСрезПоследних.СтоимостьДоставки) КАК СтоимостьДоставки,
		|	ДанныеОДоставке.РегионЗаказа КАК РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа КАК ВесЗаказа,
		|	ДанныеОДоставке.Сумма КАК СуммаЗаказа,
		|	ДанныеОДоставке.РасстояниеЗаказа КАК РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа КАК ГородЗаказа,
		|	1 КАК Приоритет,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента КАК СегментКлиента
		|ИЗ
		|	РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаДоставки, СегментКлиента В (&СегментыКлиента)) КАК смартТарифыНаДоставкуСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДанныеДляРасчетаДоставки КАК ДанныеОДоставке
		|		ПО смартТарифыНаДоставкуСрезПоследних.Регион = ДанныеОДоставке.РегионЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.ВесЗаказа >= ДанныеОДоставке.ВесЗаказа
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|ГДЕ
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа >= ДанныеОДоставке.Сумма
		|	И ДанныеОДоставке.Сумма <> 0
		|	И смартТарифыНаДоставкуСрезПоследних.СегментКлиента <> ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеОДоставке.РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа,
		|	ДанныеОДоставке.Сумма,
		|	ДанныеОДоставке.РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	МАКСИМУМ(смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка),
		|	МАКСИМУМ(смартТарифыНаДоставкуСрезПоследних.СтоимостьДоставки),
		|	ДанныеОДоставке.РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа,
		|	ДанныеОДоставке.Сумма,
		|	ДанныеОДоставке.РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа,
		|	2,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента
		|ИЗ
		|	РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаДоставки, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДанныеДляРасчетаДоставки КАК ДанныеОДоставке
		|		ПО смартТарифыНаДоставкуСрезПоследних.Регион = ДанныеОДоставке.РегионЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.ВесЗаказа >= ДанныеОДоставке.ВесЗаказа
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|ГДЕ
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа >= ДанныеОДоставке.Сумма
		|	И ДанныеОДоставке.Сумма <> 0
		|	И смартТарифыНаДоставкуСрезПоследних.СегментКлиента = ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДанныеОДоставке.РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа,
		|	ДанныеОДоставке.Сумма,
		|	ДанныеОДоставке.РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	СегментКлиента,
		|	ВесЗаказа,
		|	ДанныеОДоставке.Сумма,
		|	ГородЗаказа УБЫВ";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка КАК СкидкаНаценка,
		|	смартТарифыНаДоставкуСрезПоследних.СтоимостьДоставки КАК СтоимостьДоставки,
		|	ДанныеОДоставке.РегионЗаказа КАК РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа КАК ВесЗаказа,
		|	ДанныеОДоставке.Сумма КАК СуммаЗаказа,
		|	ДанныеОДоставке.РасстояниеЗаказа КАК РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа КАК ГородЗаказа,
		|	1 КАК Приоритет,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента КАК СегментКлиента,
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа КАК СуммаЗаказаПоТарифу,
		|	смартТарифыНаДоставкуСрезПоследних.ВесЗаказа КАК ВесЗаказаПоТарифу
		|ИЗ
		|	РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаДоставки, СегментКлиента В (&СегментыКлиента)) КАК смартТарифыНаДоставкуСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДанныеДляРасчетаДоставки КАК ДанныеОДоставке
		|		ПО смартТарифыНаДоставкуСрезПоследних.Регион = ДанныеОДоставке.РегионЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.ВесЗаказа >= ДанныеОДоставке.ВесЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.Расстояние >= ДанныеОДоставке.РасстояниеЗаказа
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|			И (смартТарифыНаДоставкуСрезПоследних.Город = ДанныеОДоставке.ГородЗаказа
		|				ИЛИ смартТарифыНаДоставкуСрезПоследних.Город = """")
		|ГДЕ
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа >= ДанныеОДоставке.Сумма
		|	И ДанныеОДоставке.Сумма <> 0
		|	И смартТарифыНаДоставкуСрезПоследних.СегментКлиента <> ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка,
		|	смартТарифыНаДоставкуСрезПоследних.СтоимостьДоставки,
		|	ДанныеОДоставке.РегионЗаказа,
		|	ДанныеОДоставке.ВесЗаказа,
		|	ДанныеОДоставке.Сумма,
		|	ДанныеОДоставке.РасстояниеЗаказа,
		|	ДанныеОДоставке.ГородЗаказа,
		|	2,
		|	смартТарифыНаДоставкуСрезПоследних.СегментКлиента,
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа,
		|	смартТарифыНаДоставкуСрезПоследних.ВесЗаказа
		|ИЗ
		|	РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаДоставки, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДанныеДляРасчетаДоставки КАК ДанныеОДоставке
		|		ПО смартТарифыНаДоставкуСрезПоследних.Регион = ДанныеОДоставке.РегионЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.ВесЗаказа >= ДанныеОДоставке.ВесЗаказа
		|			И смартТарифыНаДоставкуСрезПоследних.Расстояние >= ДанныеОДоставке.РасстояниеЗаказа
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|			И (смартТарифыНаДоставкуСрезПоследних.Город = ДанныеОДоставке.ГородЗаказа
		|				ИЛИ смартТарифыНаДоставкуСрезПоследних.Город = """")
		|ГДЕ
		|	смартТарифыНаДоставкуСрезПоследних.СуммаЗаказа >= ДанныеОДоставке.Сумма
		|	И ДанныеОДоставке.Сумма <> 0
		|	И смартТарифыНаДоставкуСрезПоследних.СегментКлиента = ЗНАЧЕНИЕ(Справочник.СегментыПартнеров.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	СегментКлиента,
		|	ВесЗаказаПоТарифу,
		|	СуммаЗаказаПоТарифу,
		|	ГородЗаказа УБЫВ";
		
	КонецЕсли;
	
	МассивТекстов.Добавить(ТекстЗапроса);
	
	Запрос.Текст = СтрСоединить(МассивТекстов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Запрос.УстановитьПараметр("ДатаДоставки", ЗаказКлиента.Дата);
	Запрос.УстановитьПараметр("УчитыватьВсеЗаказы", УчитыватьОтгруженныеЗаказы);
	Запрос.УстановитьПараметр("СегментыКлиента", смартОбщегоНазначения.ПолучитьМассивСегментовПартнера(ЗаказКлиента.Партнер));
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Выборка = Пакет[Пакет.Количество() - 1].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		Результат.ЗаказКлиента = ЗаказКлиента;
	КонецЕсли;
	
	Результат.ДополнительныеДанные = Новый Структура;
	Результат.ДополнительныеДанные.Вставить("Заказы", Пакет[Пакет.Количество() - 2].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Функция ПроверитьПравильностьРасчетаДоставкиПоЗаказу(ЗаказКлиента, УчитыватьОтгруженныеЗаказы = Истина, ПревышениеСуммыНеСчитаетсяОшибкой = Ложь, СчитатьПоМаксимальномуТарифу = Ложь) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("смартНаценкаПоДоставкеРассчитана", Ложь);
	Результат.Вставить("смартНаценкаПоДоставке", Неопределено);
	Результат.Вставить("смартНаценкаПоДоставкеСумма", 0);
	Результат.Вставить("смартНаценкаПоДоставкеРассчитанаСОшибкой", Ложь);
	Результат.Вставить("смартНаценкаПоДоставкеОписаниеОшибки", "");
	Результат.Вставить("смартНаценкаПоДоставкеПоТарифу", Неопределено);
	Результат.Вставить("смартНаценкаПоДоставкеСуммаПоТарифу", 0);
	
	ДоставкаПоТарифу = РассчитатьДоставкуПоЗаказуКлиента(ЗаказКлиента, УчитыватьОтгруженныеЗаказы, СчитатьПоМаксимальномуТарифу);
	
	Результат.Вставить("ДополнительныеДанные", ДоставкаПоТарифу.ДополнительныеДанные);
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказКлиентаСкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
		|	СУММА(ЗаказКлиентаСкидкиНаценки.Сумма) КАК Сумма
		|ИЗ
		|	Документ.ЗаказКлиента.СкидкиНаценки КАК ЗаказКлиентаСкидкиНаценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ПО ЗаказКлиентаСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
		|			И НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется
		|ГДЕ
		|	ЗаказКлиентаСкидкиНаценки.Ссылка В (&ЗаказКлиента)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаСкидкиНаценки.СкидкаНаценка";
		
		МассивЗаказов = ДоставкаПоТарифу.ДополнительныеДанные.Заказы.ВыгрузитьКолонку("Ссылка");
		МассивЗаказов.Добавить(ЗаказКлиента);
		
		Запрос.УстановитьПараметр("ДатаЗаказа", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента, "Дата"));
		Запрос.УстановитьПараметр("ЗаказКлиента", МассивЗаказов);
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.СкидкаНаценка КАК СкидкаНаценка,
		|	Т.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТСкидкиНаценки
		|ИЗ
		|	&ТЗ КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.СкидкаНаценка КАК СкидкаНаценка,
		|	Т.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТСкидкиНаценкиФинальные
		|ИЗ
		|	ВТСкидкиНаценки КАК Т
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказКлиентаСкидкиНаценки.СкидкаНаценка,
		|	СУММА(ЗаказКлиентаСкидкиНаценки.Сумма)
		|ИЗ
		|	Документ.ЗаказКлиента.СкидкиНаценки КАК ЗаказКлиентаСкидкиНаценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ПО ЗаказКлиентаСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|ГДЕ
		|	ЗаказКлиентаСкидкиНаценки.Ссылка В(&ЗаказКлиента)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаСкидкиНаценки.СкидкаНаценка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
		|	СУММА(ВТСкидкиНаценки.Сумма) КАК Сумма
		|ИЗ
		|	ВТСкидкиНаценкиФинальные КАК ВТСкидкиНаценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ПО ВТСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТСкидкиНаценки.СкидкаНаценка";
		
		МассивЗаказов = ДоставкаПоТарифу.ДополнительныеДанные.Заказы.ВыгрузитьКолонку("Ссылка");
		
		Запрос.УстановитьПараметр("ДатаЗаказа", ЗаказКлиента.Дата);
		Запрос.УстановитьПараметр("ТЗ", ЗаказКлиента.СкидкиНаценки.Выгрузить());
		Запрос.УстановитьПараметр("ЗаказКлиента", МассивЗаказов);
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Результат.смартНаценкаПоДоставкеРассчитана = Истина;
		Результат.смартНаценкаПоДоставке = Выборка.СкидкаНаценка;
		Результат.смартНаценкаПоДоставкеСумма = - Выборка.Сумма;
		
	КонецЦикла;
	
	Результат.смартНаценкаПоДоставкеПоТарифу = ДоставкаПоТарифу.СкидкаНаценка;
	Результат.смартНаценкаПоДоставкеСуммаПоТарифу = ДоставкаПоТарифу.СтоимостьДоставки;
	
	Если Результат.смартНаценкаПоДоставкеРассчитана И Результат.смартНаценкаПоДоставкеСумма <> 0 И НЕ ЗначениеЗаполнено(ДоставкаПоТарифу.СкидкаНаценка) И НЕ ПревышениеСуммыНеСчитаетсяОшибкой Тогда
		
		Результат.смартНаценкаПоДоставкеРассчитанаСОшибкой = Истина;
		Результат.смартНаценкаПоДоставкеОписаниеОшибки = "Наценка на доставку > 0, по тарифам доставки нет";
		
	ИначеЕсли Результат.смартНаценкаПоДоставкеРассчитана И Результат.смартНаценкаПоДоставкеСумма <> 0 И ЗначениеЗаполнено(ДоставкаПоТарифу.СкидкаНаценка) Тогда
		
		Если ДоставкаПоТарифу.СкидкаНаценка <> Результат.смартНаценкаПоДоставке И Результат.смартНаценкаПоДоставкеСумма = ДоставкаПоТарифу.СтоимостьДоставки Тогда
			
			Если НЕ (ПревышениеСуммыНеСчитаетсяОшибкой И Результат.смартНаценкаПоДоставкеСумма > ДоставкаПоТарифу.СтоимостьДоставки) Тогда
				
				Результат.смартНаценкаПоДоставкеРассчитанаСОшибкой = Истина;
				Результат.смартНаценкаПоДоставкеОписаниеОшибки = "Выбран неверный вид наценки";
				
			КонецЕсли;
			
		ИначеЕсли Результат.смартНаценкаПоДоставкеСумма <> ДоставкаПоТарифу.СтоимостьДоставки Тогда
			
			Если НЕ (ПревышениеСуммыНеСчитаетсяОшибкой И Результат.смартНаценкаПоДоставкеСумма > ДоставкаПоТарифу.СтоимостьДоставки) Тогда
				
				Результат.смартНаценкаПоДоставкеРассчитанаСОшибкой = Истина;
				Результат.смартНаценкаПоДоставкеОписаниеОшибки = СтрШаблон("Неверное рассчитана сумма доставки. Минимальная стоимость доставки %1", ДоставкаПоТарифу.СтоимостьДоставки);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли НЕ Результат.смартНаценкаПоДоставкеРассчитана И ЗначениеЗаполнено(ДоставкаПоТарифу.СкидкаНаценка) Тогда
		
		Результат.смартНаценкаПоДоставкеРассчитанаСОшибкой = Истина;
		Результат.смартНаценкаПоДоставкеОписаниеОшибки = СтрШаблон("Необходимо было рассчитать доставку. Наценка %1, сумма %2", ДоставкаПоТарифу.СкидкаНаценка, ДоставкаПоТарифу.СтоимостьДоставки);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СуществуетДоставкаДоКлиентаВРегионе(РегионДоставки, ГородДоставки, РасстояниеДоставки) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	смартТарифыНаДоставкуСрезПоследних.Регион КАК Регион
	|ИЗ
	|	РегистрСведений.смартТарифыНаДоставку.СрезПоследних(
	|			,
	|			Регион = &РегионДоставки
	|				И (Город = &ГородДоставки
	|					ИЛИ Город = """")
	|				И Расстояние >= &РасстояниеДоставки) КАК смартТарифыНаДоставкуСрезПоследних
	|ГДЕ
	|	НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется";
	
	Запрос.УстановитьПараметр("РегионДоставки", РегионДоставки);
	Запрос.УстановитьПараметр("ГородДоставки", ГородДоставки);
	Запрос.УстановитьПараметр("РасстояниеДоставки", РасстояниеДоставки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Регион <> NULL Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьРассчитаннуюСуммуДоставки(ЗаказКлиента) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(-ЗаказКлиентаСкидкиНаценки.Сумма) КАК СуммаДоставки
		|ИЗ
		|	Документ.ЗаказКлиента.СкидкиНаценки КАК ЗаказКлиентаСкидкиНаценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ПО ЗаказКлиентаСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)
		|ГДЕ
		|	ЗаказКлиентаСкидкиНаценки.Ссылка = &ЗаказКлиента";
		
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
		Запрос.УстановитьПараметр("ДатаЗаказа", ЗаказКлиента.Дата);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.СуммаДоставки <> NULL Тогда
			Возврат Выборка.СуммаДоставки;
		КонецЕсли;
		
		Возврат 0;
		
	Иначе
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.СкидкаНаценка КАК СкидкаНаценка,
		|	- Т.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТСкидкиНаценки
		|ИЗ
		|	&ТЗ КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТСкидкиНаценки.Сумма) КАК СуммаДоставки
		|ИЗ
		|	ВТСкидкиНаценки КАК ВТСкидкиНаценки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
		|		ПО ВТСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
		|			И (НЕ смартТарифыНаДоставкуСрезПоследних.НеИспользуется)";
		
		Запрос.УстановитьПараметр("ТЗ", ЗаказКлиента.СкидкиНаценки.Выгрузить());
		Запрос.УстановитьПараметр("ДатаЗаказа", ЗаказКлиента.Дата);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.СуммаДоставки <> NULL Тогда
			Возврат Выборка.СуммаДоставки;
		КонецЕсли;
		
		Возврат 0;
		
	КонецЕсли;
															
КонецФункции

#КонецОбласти