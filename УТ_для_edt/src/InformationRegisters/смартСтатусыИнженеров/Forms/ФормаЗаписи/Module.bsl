&НаКлиенте
Процедура ИнженерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", "Пользователи");
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	Пользователи = ПолучитьИнженеровИзНастройки();
	ПараметрыФормы.Вставить("смартОтображаемыеПользователи", Пользователи);
	
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаСписка", ПараметрыФормы, Элемент,,,, , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьИнженера(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Действие", "Добавить");
	Оповещение = Новый ОписаниеОповещения("ОкончаниеДобавленияУдаленияПользователя", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", "Пользователи");
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	СкрываемыеПользователи = ПолучитьИнженеровИзНастройки();
	ПараметрыФормы.Вставить("СкрываемыеПользователи", СкрываемыеПользователи);
	
	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьИнженера(Команда)
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Действие", "Удалить");
	Оповещение = Новый ОписаниеОповещения("ОкончаниеДобавленияУдаленияПользователя", ЭтотОбъект, ДопПараметры);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", "Пользователи");
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	смартОтображаемыеПользователи = ПолучитьИнженеровИзНастройки();
	ПараметрыФормы.Вставить("смартОтображаемыеПользователи", смартОтображаемыеПользователи);

	ОткрытьФорму("Справочник.Пользователи.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнженеровИзНастройки()
	
	РезультатСписокЗначений = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенныйЭлемент";
	
	ПредопределенныйЭлемент = Справочники.смартПредопределенныеЗначения.СписокИнженеров;
	
	Запрос.УстановитьПараметр("ПредопределенныйЭлемент", ПредопределенныйЭлемент);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат РезультатСписокЗначений;
	КонецЕсли;
	
	РезультатСписокЗначений.ЗагрузитьЗначения(РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Значение"));
	
	Возврат РезультатСписокЗначений;
	
КонецФункции

&НаКлиенте
Процедура ОкончаниеДобавленияУдаленияПользователя(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("СправочникСсылка.Пользователи") Тогда		
		МассивПользователей = Новый Массив;
		МассивПользователей.Добавить(РезультатЗакрытия);
	ИначеЕсли ТипЗнч(РезультатЗакрытия) = Тип("Массив") Тогда
		МассивПользователей = РезультатЗакрытия;
	Иначе
		Возврат;
	КонецЕсли;	
	
	Если ДополнительныеПараметры.Действие = "Добавить" Тогда
		ДобавитьИнженераНаСервере(МассивПользователей);
	Иначе
		УдалитьИнженераНаСервере(МассивПользователей);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ДобавитьИнженераНаСервере(МассивПользователей)
	
	Если НЕ ЗначениеЗаполнено(МассивПользователей) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенныйЭлемент
	|	И смартПредопределенныеЗначенияЗначения.Значение В (&МассивПользователей)";
	
	ПредопределенныйЭлемент = Справочники.смартПредопределенныеЗначения.СписокИнженеров;
	
	Запрос.УстановитьПараметр("МассивПользователей", МассивПользователей);
	Запрос.УстановитьПараметр("ПредопределенныйЭлемент", ПредопределенныйЭлемент);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;
	
	Об = ПредопределенныйЭлемент.ПолучитьОбъект();
	
	Для Каждого ТекПользователь Из МассивПользователей Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Значение", ТекПользователь);
		НайденныеСтроки = Об.Значения.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Об.Значения.Добавить();
		НоваяСтрока.Значение = ТекПользователь;
	КонецЦикла;

	Об.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьИнженераНаСервере(МассивПользователей)
	
	Если НЕ ЗначениеЗаполнено(МассивПользователей) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартПредопределенныеЗначенияЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &ПредопределенныйЭлемент
	|	И смартПредопределенныеЗначенияЗначения.Значение В (&МассивПользователей)";
	
	ПредопределенныйЭлемент = Справочники.смартПредопределенныеЗначения.СписокИнженеров;
	
	Запрос.УстановитьПараметр("МассивПользователей", МассивПользователей);
	Запрос.УстановитьПараметр("ПредопределенныйЭлемент", ПредопределенныйЭлемент);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		УстановитьПривилегированныйРежим(Ложь);
		Возврат;
	КонецЕсли;
	
	Об = ПредопределенныйЭлемент.ПолучитьОбъект();
	
	Сч = Об.Значения.Количество() - 1;
	
	Пока Сч >= 0 Цикл
		
		ТекСтрока = Об.Значения[Сч];
		Если МассивПользователей.Найти(ТекСтрока.Значение) <> Неопределено Тогда
			Об.Значения.Удалить(Сч);
		КонецЕсли;
		
		Сч = Сч - 1;

	КонецЦикла;
	
	Об.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры



