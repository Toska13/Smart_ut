  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	смартСтопЛистТехническойОтсрочки.Партнер КАК Партнер,
	смартСтопЛистТехническойОтсрочки.Контрагент КАК Контрагент,
	смартСтопЛистТехническойОтсрочки.ЗаказКлиента КАК ЗаказКлиента,
	смартСтопЛистТехническойОтсрочки.Период КАК ДатаПопадания,
	смартСтопЛистТехническойОтсрочки1.Период КАК ДатаВыхода,
	ВЫБОР
		КОГДА смартСтопЛистТехническойОтсрочки1.Период ЕСТЬ NULL
			ТОГДА РАЗНОСТЬДАТ(смартСтопЛистТехническойОтсрочки.Период, &amp;ТекущаяДата, ДЕНЬ)
		ИНАЧЕ РАЗНОСТЬДАТ(смартСтопЛистТехническойОтсрочки.Период, смартСтопЛистТехническойОтсрочки1.Период, ДЕНЬ)
	КОНЕЦ КАК КоличествоДнейВСписке,
	смартСтопЛистТехническойОтсрочки.СуммаЗадолженности КАК СуммаЗадолженности
ИЗ
	РегистрСведений.смартСтопЛистТехническойОтсрочки КАК смартСтопЛистТехническойОтсрочки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСтопЛистТехническойОтсрочки КАК смартСтопЛистТехническойОтсрочки1
		ПО смартСтопЛистТехническойОтсрочки.Партнер = смартСтопЛистТехническойОтсрочки1.Партнер
			И смартСтопЛистТехническойОтсрочки.Контрагент = смартСтопЛистТехническойОтсрочки1.Контрагент
			И смартСтопЛистТехническойОтсрочки.ЗаказКлиента = смартСтопЛистТехническойОтсрочки1.ЗаказКлиента
			И НЕ смартСтопЛистТехническойОтсрочки1.ПродажаОтгрузкаЗапрещена
ГДЕ
	смартСтопЛистТехническойОтсрочки.ПродажаОтгрузкаЗапрещена</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
