
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоПолноправныйПользователь = Пользователи.ЭтоПолноправныйПользователь();
	
	Элементы.Заявка.ТолькоПросмотр 		 = НЕ ЭтоПолноправныйПользователь;
	Элементы.Номенклатура.ТолькоПросмотр = НЕ ЭтоПолноправныйПользователь;
	Элементы.Серия.ТолькоПросмотр 		 = НЕ ЭтоПолноправныйПользователь;

	Если Параметры.Ключ.Пустой() Тогда
		
		Запись.ТипЛицензии = Перечисления.смартТипыЛицензии.Временная;
		
	Иначе
		
		Если Запись.ТипЛицензии = Перечисления.смартТипыЛицензии.Постоянная
			И НЕ ЭтоПолноправныйПользователь Тогда
			
			Элементы.ТипЛицензии.ТолькоПросмотр  					= Истина;
			Элементы.Период.ТолькоПросмотр 		 					= Истина;
			Элементы.ДатаОкончания.ТолькоПросмотр 					= Истина;
			
		КонецЕсли;;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьДатуОкончания()
	
	Если Запись.ТипЛицензии = ПредопределенноеЗначение("Перечисление.смартТипыЛицензии.Временная") Тогда
		
		Если ЗначениеЗаполнено(Запись.Период) Тогда
			Запись.ДатаОкончания = Запись.Период + 30 * 24 * 60 * 60;
		КонецЕсли;
		
	Иначе
		
		Запись.ДатаОкончания = Неопределено;
		
		Если НЕ ЗначениеЗаполнено(Запись.ДатаУстановкиПостояннойЛицензии) Тогда
			Запись.ДатаУстановкиПостояннойЛицензии = ТекущаяДата();
		КонецЕсли;	
		
	КонецЕсли;	
	
	ЭтоПостояннаяЛицензия 
		= Запись.ТипЛицензии = ПредопределенноеЗначение("Перечисление.смартТипыЛицензии.Постоянная");
	
	Элементы.ДатаОкончания.ТолькоПросмотр 			   = ЭтоПостояннаяЛицензия;
	Элементы.ДатаУстановкиПостояннойЛицензии.Видимость = ЭтоПостояннаяЛицензия;
		
КонецПроцедуры

&НаКлиенте
Процедура ТипЛицензииПриИзменении(Элемент)
	
	РассчитатьДатуОкончания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	РассчитатьДатуОкончания();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Параметры.Ключ.Пустой() Тогда
		
		РассчитатьДатуОкончания();

		УстановитьСерийныйНомерНаСервере();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСерийныйНомерНаСервере()

	Если ЗначениеЗаполнено(Запись.Серия) Тогда
		
		НомерСерии = СокрЛП(Запись.Серия.Номер);
		
		Если Запись.СерийныйНомер <> НомерСерии Тогда
			Запись.СерийныйНомер = НомерСерии;
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СерияПриИзменении(Элемент)
	
	УстановитьСерийныйНомерНаСервере();
	
КонецПроцедуры
