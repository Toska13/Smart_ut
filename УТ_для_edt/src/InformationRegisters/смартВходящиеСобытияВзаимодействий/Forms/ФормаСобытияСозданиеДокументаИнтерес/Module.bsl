

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтотОбъект.Параметры.НаборДанных.Количество() = 0 Тогда
		
		Отказ = Истина;
		Возврат;  
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЭтотОбъект.Параметры.НаборДанных[0].Данные);					
	
	//++ #1789 смарт: Ермаков 22.04.2024 / Доработка механизма оповещений менеджеров.	
	Элементы.ГруппаНовыйЗвонок.Видимость = 
		ЭтотОбъект.Параметры.ВидСобытия = Перечисления.смартВидыСобытийВзаимодействий.НайденСуществующийПартнер;
		
	Элементы.ГруппаНовыйИнтерес.Видимость = Не Элементы.ГруппаНовыйЗвонок.Видимость; 	
	//-- #1789 смарт: Ермаков 22.04.2024
	
	Если Элементы.ГруппаНовыйИнтерес.Видимость Тогда
	
		//++ #1760 смарт: Фролов 18.04.2024 // Создание механизма оповещений менеджеров о назначенных Интересах.
		Если ЗначениеЗаполнено(Документ.ДокументОснование) Тогда
			
			Если ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.смартЛид") ИЛИ
				ТипЗнч(Документ.ДокументОснование) = Тип("ДокументСсылка.CRM_Заявка") Тогда
				
				ПисьмоИлиЗвонок = Документ.ДокументОснование.ДокументОснование;
				
				Если ТипЗнч(ПисьмоИлиЗвонок) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее") Тогда
					
					Если ПисьмоИлиЗвонок.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
						
						HTMLТекст = "<!DOCTYPE html>
						|<html lang=""ru"">
						|<head>
						|
						|</head>
						|<body>" + ПисьмоИлиЗвонок.ТекстHTML + "</body>
						|</html>";
						
						ПотребностьHTML = HTMLТекст;
						Элементы.Потребность.Видимость = Ложь;
						Элементы.ПотребностьHTML.Видимость = Истина;
						
					Иначе
						
						Элементы.Потребность.Видимость = Истина;
						Элементы.ПотребностьHTML.Видимость = Ложь;
						
					КонецЕсли;
					
				Иначе
					
					Элементы.Потребность.Видимость = Истина;
					Элементы.ПотребностьHTML.Видимость = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		//-- #1760 смарт: Фролов 18.04.2024
		
		Элементы.Канал.Видимость = ЗначениеЗаполнено(Партнер);
		
		Если ЭтотОбъект.КоличествоДокументов > 0 Тогда
			
			Элементы.ВниманиеНеразобранныеИнтересы.Заголовок = 
				"Внимание! У вас " 
				+ Строка(ЭтотОбъект.КоличествоДокументов) 
				+ " интереса в статусе " 
				+ Символ(34) + "Неразобранное" + Символ(34);
				
			//++ #1760 смарт: Саломадин 12.04.2024 / Изменение видимости декорации	
			Элементы.ВыдачаИнтересов.Видимость = Истина;	
	        //-- #1760 смарт: Саломадин 12.04.2024 	
			
		КонецЕсли; 
		
	КонецЕсли;
	
	//++ #1789 смарт: Ермаков 22.04.2024 / Доработка механизма оповещений менеджеров.	
	Если Элементы.ГруппаНовыйЗвонок.Видимость Тогда
		
		Элементы.Переместить(Элементы.Партнер, Элементы.ГруппаНовыйЗвонок);
		Элементы.ВамНазначенНовыйИнтерес.Заголовок = "Входящий звонок !";
		
	КонецЕсли;
	//-- #1789 смарт: Ермаков 22.04.2024
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗначениеГиперссылки(Элемент, СтандартнаяОбработка)
	
	//++ #1789 смарт: Ермаков 22.04.2024 / Доработка механизма оповещений менеджеров.	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьЗначение(ЭтаФорма[Элемент.Имя]);
	Закрыть();
	//-- #1789 смарт: Ермаков 22.04.2024
	
КонецПроцедуры

#КонецОбласти