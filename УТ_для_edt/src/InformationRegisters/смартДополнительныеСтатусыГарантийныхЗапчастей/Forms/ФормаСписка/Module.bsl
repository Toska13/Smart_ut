
///////////////////////////////////////////////////////////////////////////////////
// События формы и элементов

#Область СобытияФормыИЭлементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТолькоПоследниеИзменения") = Истина Тогда
		ТолькоПоследниеИзменения = Параметры.ТолькоПоследниеИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборТолькоПоследниеИзменения();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоПоследниеИзмененияПриИзменении(Элемент)
	
	УстановитьОтборТолькоПоследниеИзменения();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаписиДоДаты(Команда)
	
	Оповещение = Новый ОписаниеОповещения("УдалитьЗаписиДоДатыЗакрытиеФормы", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей.Форма.ФормаВводаДатыУдаления",, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЗаписиДоДатыЗакрытиеФормы(РезультатЗакрытия, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		УдалитьЗаписиИзРегистра(РезультатЗакрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписиИзРегистра(ДатаУдаления)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки КАК ДатаЗагрузки,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.НомерЗаявки КАК НомерЗаявки,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.Артикул КАК Артикул
	|ИЗ
	|	РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК смартДополнительныеСтатусыГарантийныхЗапчастей
	|ГДЕ
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки < &ДатаУдаления";
	
	Запрос.УстановитьПараметр("ДатаУдаления", ДатаУдаления);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	УдаленоЗаписей = 0;
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.смартДополнительныеСтатусыГарантийныхЗапчастей.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ДатаЗагрузки.Установить(Выборка.ДатаЗагрузки);
		НаборЗаписей.Отбор.НомерЗаявки.Установить(Выборка.НомерЗаявки);
		НаборЗаписей.Отбор.Артикул.Установить(Выборка.Артикул);
		НаборЗаписей.Прочитать();
		
		УдаленоЗаписей = УдаленоЗаписей + НаборЗаписей.Количество();
		
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Удалено записей: " + УдаленоЗаписей);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

///////////////////////////////////////////////////////////////////////////////////
// Прочие процедуры и функции

#Область ПрочиеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборТолькоПоследниеИзменения()
	
	Если ТолькоПоследниеИзменения Тогда
		ПоследняяДатаЗагрузки = ПолучитьПоследнююДатуЗагрузки();
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаЗагрузки", ПоследняяДатаЗагрузки);		
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Список, "ДатаЗагрузки");		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьПоследнююДатуЗагрузки()
	
	ДатаВозврата = Дата(1, 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки) КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК смартДополнительныеСтатусыГарантийныхЗапчастей";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаВозврата = Выборка.ДатаЗагрузки;
	КонецЕсли;
	
	Возврат ДатаВозврата;
	
КонецФункции

#КонецОбласти

