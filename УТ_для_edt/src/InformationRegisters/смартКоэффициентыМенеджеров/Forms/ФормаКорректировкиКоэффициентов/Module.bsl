	//-- #Б-3406 смарт: Фролов 27.05.2025
	|ИЗ
	|	ТаблицаКоэффициентов КАК ТаблицаКоэффициентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Отпуска КАК Отпуска
	|		ПО ТаблицаКоэффициентов.Менеджер = Отпуска.Менеджер
	|
	|УПОРЯДОЧИТЬ ПО
	|	МенеджерНаименование";
	//++ #Б-3406 смарт: Фролов 27.05.2025 //Создание механизма для отражения информации по отпускам менеджеров.
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	//-- #Б-3406 смарт: Фролов 27.05.2025
	
	Если НЕ Менеджер = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Менеджер = &Менеджер");
		Запрос.УстановитьПараметр("Менеджер", Менеджер);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура СохранитьСервере()
	
	Результат = ЗаполнитьДаннымиКоэффициентовМенеджеров();
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Квалификация
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи 
	|ГДЕ
	|	Пользователь = &Менеджер");
	
	ДатаВнесения=ТекущаяДата();
	Для Каждого СтрМенеджеры Из Менеджеры Цикл
		
		СтрокиРезультат = Результат.НайтиСтроки(Новый Структура("Менеджер", СтрМенеджеры.Менеджер));
		Если СтрокиРезультат.Количество() > 0 Тогда
			
			Если СтрокиРезультат[0].КоэффициентОтКоммерческогоОтдела <> СтрМенеджеры.КоэффициентОтКоммерческогоОтдела Тогда
				МенеджерЗаписи=РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = ДатаВнесения;
				МенеджерЗаписи.Менеджер = СтрМенеджеры.Менеджер;
				МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела;
				МенеджерЗаписи.Коэффициент = СтрМенеджеры.КоэффициентОтКоммерческогоОтдела;
				МенеджерЗаписи.ИзменениеКоэффициента = СтрМенеджеры.КоэффициентОтКоммерческогоОтдела;
				МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			Если СтрокиРезультат[0].КоэффициентОтМаркетинговогоОтдела <> СтрМенеджеры.КоэффициентОтМаркетинговогоОтдела Тогда
				МенеджерЗаписи=РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = ДатаВнесения;
				МенеджерЗаписи.Менеджер = СтрМенеджеры.Менеджер;
				МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела;
				МенеджерЗаписи.Коэффициент = СтрМенеджеры.КоэффициентОтМаркетинговогоОтдела;
				МенеджерЗаписи.ИзменениеКоэффициента = СтрМенеджеры.КоэффициентОтМаркетинговогоОтдела;
				МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
				МенеджерЗаписи.Записать();
			КонецЕсли;
			
			Если СтрокиРезультат[0].ИтоговыйКоэффициент <> СтрМенеджеры.ИтоговыйКоэффициент 
				//++ #Б-3704 смарт: Фролов 07.07.2025 //Корректировка данных по отпускам и блокирование выдачи Интересов на основании данных регистра "График отсутствия сотрудников"
				ИЛИ СтрокиРезультат[0].ВыдачаЗаблокированаВручную <> СтрМенеджеры.ВыдачаЗаблокированаВручную
				//-- #Б-3704 смарт: Фролов 07.07.2025
				ИЛИ СтрокиРезультат[0].ВыдачаЗаблокирована <> СтрМенеджеры.ВыдачаЗаблокирована Тогда
					МенеджерЗаписи=РегистрыСведений.смартКоэффициентыМенеджеров.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Период = ДатаВнесения;
					МенеджерЗаписи.Менеджер = СтрМенеджеры.Менеджер;
					МенеджерЗаписи.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент;
					МенеджерЗаписи.Коэффициент = СтрМенеджеры.ИтоговыйКоэффициент;
					МенеджерЗаписи.ИзменениеКоэффициента = СтрМенеджеры.ИтоговыйКоэффициент;
					МенеджерЗаписи.Ответственный = ПараметрыСеанса.ТекущийПользователь;
					МенеджерЗаписи.ВыдачаЗаблокирована = СтрМенеджеры.ВыдачаЗаблокирована;
					//++ #Б-3704 смарт: Фролов 07.07.2025 //Корректировка данных по отпускам и блокирование выдачи Интересов на основании данных регистра "График отсутствия сотрудников"
					МенеджерЗаписи.ВыдачаЗаблокированаВручную = СтрМенеджеры.ВыдачаЗаблокированаВручную;
					//-- #Б-3704 смарт: Фролов 07.07.2025
					МенеджерЗаписи.Записать();
					
					//++ #1681 смарт: Фролов 13.03.2024 //Механизм перераспределения Лидов/Интересов по ответственным.
					Если СтрМенеджеры.ВыдачаЗаблокирована Тогда
						
						СброситьВыданныеЛидыИИнтересы(СтрМенеджеры.Менеджер);
						
					КонецЕсли;	
					//-- #1681 смарт: Фролов 13.03.2024
					
					Запрос.УстановитьПараметр("Менеджер",СтрМенеджеры.Менеджер);
					Выборка = Запрос.Выполнить().Выбрать();
					
					Пока Выборка.Следующий() Цикл
						
						НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Менеджер.Установить(СтрМенеджеры.Менеджер);
						НаборЗаписей.Отбор.Квалификация.Установить(Выборка.Квалификация);
						НаборЗаписей.Прочитать();
						
						Если СтрМенеджеры.ВыдачаЗаблокирована ТОгда
							НаборЗаписей.Очистить();
						Иначе	
							Если НаборЗаписей.Количество() > 0 Тогда
								НаборЗаписей[0].ВыдатьЛидов = СтрМенеджеры.ИтоговыйКоэффициент;
								НаборЗаписей[0].ВыданоЛидов = НаборЗаписей[0].ВыданоЛидов;
							Иначе
								ЗаписьНЗ = НаборЗаписей.Добавить();
								ЗаписьНЗ.Менеджер = СтрМенеджеры.Менеджер;
								ЗаписьНЗ.Квалификация = Выборка.Квалификация;
								ЗаписьНЗ.ВыдатьЛидов = СтрМенеджеры.ИтоговыйКоэффициент;
								ЗаписьНЗ.ВыданоЛидов = 0;
							КонецЕсли;
						КонецЕсли;
						
						НаборЗаписей.Записать(Истина);
						
					КонецЦикла;
				
			КонецЕсли;
		
		КонецЕсли;
		
		//++ #Б-3406 смарт: Фролов 27.05.2025 //Создание механизма для отражения информации по отпускам менеджеров.
		Если ЗначениеЗаполнено(СтрМенеджеры.НачалоОтпуска) И ЗначениеЗаполнено(СтрМенеджеры.ОкончаниеОтпуска) Тогда
			
			ЗапросОтпуск = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Пользователь КАК Пользователь
			|ИЗ
			|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(, Пользователь = &Менеджер)
			|ГДЕ
			|	Статус = ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.ВОтпуске)
			|	И НАЧАЛОПЕРИОДА(До, ДЕНЬ) = &ОкончаниеОтпуска");
			ЗапросОтпуск.УстановитьПараметр("Менеджер", СтрМенеджеры.Менеджер);
			ЗапросОтпуск.УстановитьПараметр("ОкончаниеОтпуска", СтрМенеджеры.ОкончаниеОтпуска);
			
			Если ЗапросОтпуск.Выполнить().Пустой() Тогда
				
				МенеджерЗаписи = РегистрыСведений.смартИсторияСтатусовСотрудников.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Период = СтрМенеджеры.НачалоОтпуска;
				МенеджерЗаписи.Пользователь = СтрМенеджеры.Менеджер;
				МенеджерЗаписи.Статус = Справочники.смартСтатусыСотрудников.ВОтпуске;
				МенеджерЗаписи.До = СтрМенеджеры.ОкончаниеОтпуска;
				ОтсрочкаПоОтпуску = (СтрМенеджеры.ОкончаниеОтпуска - СтрМенеджеры.НачалоОтпуска) / 2;
				МенеджерЗаписи.ДатаОтсрочкиПоОтпуску = НачалоДня(СтрМенеджеры.ОкончаниеОтпуска + ОтсрочкаПоОтпуску);
				МенеджерЗаписи.Записать(Истина);
				
			КонецЕсли;
			//-- #Б-3406 смарт: Фролов 27.05.2025
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
