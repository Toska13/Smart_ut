
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Результат = ЗаполнитьДаннымиКоэффициентовМенеджеров();
	
	ЭтаФорма.Менеджеры.Загрузить(Результат);
	
	Если РольДоступна("смартРедактированиеКоэффициентовОтКоммерческогоОтдела") Тогда
		ЭтаФорма.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела;
		Элементы.МенеджерыКоэффициентОтКоммерческогоОтдела.ТолькоПросмотр = Ложь;
		Элементы.МенеджерыКоэффициентОтМаркетинговогоОтдела.ЦветФона = Новый Цвет(248,242,216);
	ИначеЕсли РольДоступна("смартРедактированиеКоэффициентовОтМаркетинговогоОтдела") Тогда
		ЭтаФорма.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела;
		Элементы.МенеджерыКоэффициентОтМаркетинговогоОтдела.ТолькоПросмотр = Ложь;
		Элементы.МенеджерыКоэффициентОтКоммерческогоОтдела.ЦветФона = Новый Цвет(248,242,216);
	ИначеЕсли Пользователи.ЭтоПолноправныйПользователь() Тогда
		ЭтаФорма.ВидКоэффициента = Перечисления.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент;
		Элементы.МенеджерыКоэффициентОтКоммерческогоОтдела.ТолькоПросмотр = Ложь;
		Элементы.МенеджерыКоэффициентОтМаркетинговогоОтдела.ТолькоПросмотр = Ложь;
	//++ #Б-7014 смарт: Фролов 01.06.2026 //У руководителей ОП должна быть возможность смотреть отчет	
	Иначе	
		Элементы.ФормаСохранитьИЗакрыть.Доступность = Ложь;
		Элементы.ФормаСохранить.Доступность = Ложь;
		Элементы.Менеджеры.ТолькоПросмотр = Истина;
		Элементы.МаксимальноеКоличествоЛидовВДень.ТолькоПросмотр = Истина;
	//-- #Б-7014 смарт: Фролов 01.06.2026	
	КонецЕсли;
	
	ЭтаФорма.МаксимальноеКоличествоЛидовВДень = Константы.смартМаксимальноеКоличествоЛидовВДень.Получить();
	
	Элементы.ДекорацияСохранитеИзменения.Видимость = Ложь;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("МенеджерыКоэффициентОтКоммерческогоОтдела"); 
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтКоммерческогоОтдела");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементУсловия.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтКоммерческогоОтделаДляСравнения");;
	ЭлементУсловия.Использование = Истина;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("МенеджерыКоэффициентОтМаркетинговогоОтдела"); 
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтМаркетинговогоОтдела");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
	ЭлементУсловия.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтМаркетинговогоОтделаДляСравнения");;
	ЭлементУсловия.Использование = Истина;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("МенеджерыКоэффициентОтКоммерческогоОтдела"); 
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтКоммерческогоОтдела");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ЭлементУсловия.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтКоммерческогоОтделаДляСравнения");;
	ЭлементУсловия.Использование = Истина;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0,150,70));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("МенеджерыКоэффициентОтМаркетинговогоОтдела"); 
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтМаркетинговогоОтдела");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	ЭлементУсловия.ПравоеЗначение = Новый ПолеКомпоновкиДанных("Менеджеры.КоэффициентОтМаркетинговогоОтделаДляСравнения");;
	ЭлементУсловия.Использование = Истина;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(0,150,70));

КонецПроцедуры

&НаСервере
Функция ЗаполнитьДаннымиКоэффициентовМенеджеров(Менеджер = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	смартКоэффициентыМенеджеровСрезПоследних.Менеджер КАК Менеджер,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ИтоговыйКоэффициент,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтВыручки)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.ИзменениеКоэффициента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтВыручки,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтКонверсии)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.ИзменениеКоэффициента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтКонверсии,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтПотериЛидов)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.ИзменениеКоэффициента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтПотериЛидов,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.ИзменениеКоэффициента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтКоммерческогоОтдела,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.ИзменениеКоэффициента
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтМаркетинговогоОтдела,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ИтоговыйКоэффициентСтарый,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтВыручки)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтВыручкиСтарый,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтКонверсии)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтКонверсииСтарый,
	|	МАКСИМУМ(смартКоэффициентыМенеджеровСрезПоследних.ВыдачаЗаблокирована) КАК КоэффициентОтПотериЛидовСтарый,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтКоммерческогоОтдела)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтКоммерческогоОтделаСтарый,
	|	СУММА(ВЫБОР
	|			КОГДА смартКоэффициентыМенеджеровСрезПоследних.ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.КоэффициентОтМаркетинговогоОтдела)
	|				ТОГДА смартКоэффициентыМенеджеровСрезПоследних.Коэффициент
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоэффициентОтМаркетинговогоОтделаСтарый,
	|	смартКоэффициентыМенеджеровСрезПоследних.Менеджер.Наименование КАК МенеджерНаименование,
	//++ #Б-3704 смарт: Фролов 07.07.2025 //Корректировка данных по отпускам и блокирование выдачи Интересов на основании данных регистра "График отсутствия сотрудников"
	|	МАКСИМУМ(смартКоэффициентыМенеджеровСрезПоследних.ВыдачаЗаблокированаВручную) КАК ВыдачаЗаблокированаВручную,
	//-- #Б-3704 смарт: Фролов 07.07.2025
	|	МАКСИМУМ(смартКоэффициентыМенеджеровСрезПоследних.ВыдачаЗаблокирована) КАК ВыдачаЗаблокирована
	|ПОМЕСТИТЬ ТаблицаКоэффициентов
	|ИЗ
	|	РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(
	|			,
	|			Менеджер В
	|					(ВЫБРАТЬ
	|						Ссылка КАК Ссылка
	|					ИЗ
	|						Справочник.Пользователи
	|					ГДЕ
	|						НЕ Недействителен)
	|				И Менеджер В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Пользователь КАК Пользователь
	|					ИЗ
	|						Справочник.смартКвалификацииМенеджеров.Пользователи)
	|				И 1 = 1) КАК смартКоэффициентыМенеджеровСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	смартКоэффициентыМенеджеровСрезПоследних.Менеджер,
	|	смартКоэффициентыМенеджеровСрезПоследних.Менеджер.Наименование
	|;
	|
	//++ #Б-3406 смарт: Фролов 27.05.2025 //Создание механизма для отражения информации по отпускам менеджеров.
