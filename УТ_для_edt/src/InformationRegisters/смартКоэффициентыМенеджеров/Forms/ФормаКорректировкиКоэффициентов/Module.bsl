&НаСервере
Функция ПолучитьКоэффициентыПоМенеджеру(Менеджер)
	
	Результат = ЗаполнитьДаннымиКоэффициентовМенеджеров(Менеджер);
	Если Результат.Количество() > 0 ТОгда
		ИтКоэфф = Результат[0].ИтоговыйКоэффициент;
		КоэфКоммерчОтдела = Результат[0].КоэффициентОтКоммерческогоОтдела;
		КоэфМаркетОтдела = Результат[0].КоэффициентОтМаркетинговогоОтдела;
		Возврат Новый Структура("ИтоговыйКоэффициент,КоэффициентОтКоммерческогоОтдела,КоэффициентОтМаркетинговогоОтдела", ИтКоэфф, КоэфКоммерчОтдела, КоэфМаркетОтдела);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Процедура МенеджерыВыдачаЗаблокированаПриИзменении(Элемент)
	
	ТекущиеДанные = Элемент.Родитель.ТекущиеДанные;
	
	Если ТекущиеДанные.ВыдачаЗаблокирована Тогда
		
		ТекущиеДанные.ИтоговыйКоэффициент = 0;
		
	Иначе
		
		//++ #Б-2900 смарт: Фролов 01.04.2025 //Ошибка. Корректировка коэффициентов менеджеров.
		//Результат = ПолучитьКоэффициентыПоМенеджеру(ТекущиеДанные.Менеджер);
		//Если НЕ Результат = Неопределено Тогда
		//	ТекущиеДанные.ИтоговыйКоэффициент = ?(Результат.ИтоговыйКоэффициент = 0, 2, Результат.ИтоговыйКоэффициент);
		//Иначе	
		//	ТекущиеДанные.ИтоговыйКоэффициент = 2;
		//КонецЕсли;
		РассчитатьИтоговыйКоэффициент(ТекущиеДанные);
		//-- #Б-2900 смарт: Фролов 01.04.2025
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Истина;
	
	//++ #Б-3704 смарт: Фролов 07.07.2025 //Корректировка данных по отпускам и блокирование выдачи Интересов на основании данных регистра "График отсутствия сотрудников"
	ТекущиеДанные.ВыдачаЗаблокированаВручную = ТекущиеДанные.ВыдачаЗаблокирована;
	//-- #Б-3704 смарт: Фролов 07.07.2025
	
	Элементы.ДекорацияСохранитеИзменения.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьЗначениеЗнаменателя(ТекущиеДанные)
	
	Знаменатель = 0;
	Если ТекущиеДанные.КоэффициентОтПотериЛидов <> 0 Тогда
		Знаменатель = Знаменатель + 1;	
	КонецЕсли;
	
	Если ТекущиеДанные.КоэффициентОтКоммерческогоОтдела <> 0 Тогда
		Знаменатель = Знаменатель + 1;	
	КонецЕсли;
	
	Если ТекущиеДанные.КоэффициентОтМаркетинговогоОтдела <> 0 Тогда
		Знаменатель = Знаменатель + 1;	
	КонецЕсли;
	
	Если ТекущиеДанные.КоэффициентОтВыручки <> 0 Тогда
		Знаменатель = Знаменатель + 1;	
	КонецЕсли;
	
	Если ТекущиеДанные.КоэффициентОтКонверсии <> 0 Тогда
		Знаменатель = Знаменатель + 1;	
	КонецЕсли;
	
	Возврат Знаменатель;
	
КонецФункции	

&НаКлиенте
Процедура РассчитатьИтоговыйКоэффициент(ТекущиеДанные)
	
	Результат = ПолучитьКоэффициентыПоМенеджеру(ТекущиеДанные.Менеджер);
	
	Знаменатель = ПолучитьЗначениеЗнаменателя(ТекущиеДанные);
	
	КоэфПотериЛидов = ТекущиеДанные.КоэффициентОтПотериЛидов;
	КоэфКоммерчОтдела = ТекущиеДанные.КоэффициентОтКоммерческогоОтдела;
	КоэфМаркетОтдела = ТекущиеДанные.КоэффициентОтМаркетинговогоОтдела;
	КоэфОтВыручки = ТекущиеДанные.КоэффициентОтВыручки;
	КоэфОтКонверсии = ТекущиеДанные.КоэффициентОтКонверсии;
	
	Если Знаменатель > 0 ТОгда
		
		ИзменениеКоэффициента = Окр((КоэфПотериЛидов + КоэфКоммерчОтдела + КоэфМаркетОтдела 
			+ КоэфОтВыручки + КоэфОтКонверсии) / Знаменатель);
		ТекущиеДанные.ИтоговыйКоэффициент = 2 + ИзменениеКоэффициента;
		ЭтаФорма.Модифицированность = Истина;
		Элементы.ДекорацияСохранитеИзменения.Видимость = Истина;
		
	Иначе
		
		//++ #Б-2900 смарт: Фролов 01.04.2025 //Ошибка. Корректировка коэффициентов менеджеров.
		//ТекущиеДанные.ИтоговыйКоэффициент = Результат.ИтоговыйКоэффициент;
		ТекущиеДанные.ИтоговыйКоэффициент = 2;
		//-- #Б-2900 смарт: Фролов 01.04.2025
		
	КонецЕсли;
	
	Если ТекущиеДанные.ИтоговыйКоэффициент < 1 Тогда
		
		ТекущиеДанные.ИтоговыйКоэффициент = 1;
		
	ИначеЕсли ТекущиеДанные.ИтоговыйКоэффициент > 4 Тогда
		
		ТекущиеДанные.ИтоговыйКоэффициент = 4;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура МенеджерыКоэффициентОтКоммерческогоОтделаПриИзменении(Элемент)
	
	РассчитатьИтоговыйКоэффициент(Элемент.Родитель.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура МенеджерыКоэффициентОтМаркетинговогоОтделаПриИзменении(Элемент)

	РассчитатьИтоговыйКоэффициент(Элемент.Родитель.ТекущиеДанные);
	
КонецПроцедуры

