&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность И НЕ ЗавершениеРаботы ТОгда
		Отказ = Истина;
		Режим = РежимДиалогаВопрос.ДаНетОтмена;
		Оповещение = Новый ОписаниеОповещения("ОбработкаОтветаПриЗакрытии",ЭтотОбъект);
		ПоказатьВопрос(Оповещение,"Изменения не сохранены, сохранить?", Режим,,КодВозвратаДиалога.Отмена,"Изменения не сохранены");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтветаПриЗакрытии(Результат,ДопПараметры)Экспорт
	
	Если Результат=КодВозвратаДиалога.Да Тогда 
		СохранитьСервере();
		ЭтаФорма.Модифицированность = Ложь;
		ЭтаФорма.Закрыть();
	ИначеЕсли Результат=КодВозвратаДиалога.Нет Тогда
		ЭтаФорма.Модифицированность = Ложь;
		ЭтаФорма.Закрыть();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
//++ #1681 смарт: Фролов 13.03.2024 //Механизм перераспределения Лидов/Интересов по ответственным.
Процедура СброситьВыданныеЛидыИИнтересы(Менеджер)
	//++ #1681 смарт: Фролов 22.04.2024 //Механизм перераспределения Лидов/Интересов по ответственным.
	УстановитьПривилегированныйРежим(Истина);
	//-- #1681 смарт: Фролов 22.04.2024
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартИсторияРаботыСЛидом.Лид КАК Лид,
	|	CRM_Интерес.Ссылка КАК Интерес
	|ИЗ
	|	РегистрСведений.смартИсторияРаботыСЛидом КАК смартИсторияРаботыСЛидом
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.CRM_Интерес КАК CRM_Интерес
	|		ПО смартИсторияРаботыСЛидом.Лид = CRM_Интерес.ДокументОснование
	|ГДЕ
	|	смартИсторияРаботыСЛидом.ДатаВыдачи > &ДатаВыдачи
	|	И смартИсторияРаботыСЛидом.Менеджер = &Менеджер
	|	И смартИсторияРаботыСЛидом.ДатаОбработки = ДАТАВРЕМЯ(1, 1, 1)");
	Запрос.УстановитьПараметр("ДатаВыдачи", Началодня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

		ОбЛид = Выборка.Лид.ПолучитьОбъект();
		ОбЛид.Ответственный = Неопределено;
		ОбЛид.СостояниеЛида = Перечисления.смартСостоянияЛидов.Новый;
		ОбЛид.Записать(РежимЗаписиДокумента.Запись);
		
		Если ЗначениеЗаполнено(Выборка.Интерес) Тогда
			
			ОбИнтерес = Выборка.Интерес.ПолучитьОбъект();
			ОбИнтерес.Ответственный = Неопределено;
			ОбИнтерес.Записать(РежимЗаписиДокумента.Запись);
			
		КонецЕсли;	
		
		НаборЗаписей = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Менеджер.Установить(Менеджер);
		НаборЗаписей.Отбор.Лид.Установить(Выборка.Лид);
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		НаборЗаписей.Записать(Истина);
		
		//++ #Б-5936 смарт: Фролов 06.03.2026 //Ошибка. Доработать механизм перераспределения лидов.
		НаборЗаписей = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Лид.Установить(Выборка.Лид);
		НаборЗаписей.Отбор.Менеджер.Установить(Менеджер);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			СтрНаборЗаписей = НаборЗаписей[0];
			СтрНаборЗаписей.ДатаЗавершения = ТекущаяДата();
			СтрНаборЗаписей.ПервыйКонтакт = "Лид передан в связи с блокировкой";
			СтрНаборЗаписей.ЗавершенНеУдачно = Истина;
			НаборЗаписей.Записать(Истина);
		КонецЕсли;
		//-- #Б-5936 смарт: Фролов 06.03.2026
		
		ЛидИлиИнтерес = ?(ЗначениеЗаполнено(Выборка.Интерес),"Лид","Интерес");
		
		ОтправитьНаПочтуМенеджеру("Выданный ранее " + ЛидИлиИнтерес	+ " передан другому менеджеру", 
			Менеджер, Выборка.Лид, ?(ЗначениеЗаполнено(Выборка.Интерес), Выборка.Интерес, Неопределено));
			
	КонецЦикла;	
	
КонецПроцедуры	//-- #1681 смарт: Фролов 13.03.2024

&НаСервере
Процедура ОтправитьНаПочтуМенеджеру(ТемаПисьма, Менеджер, Лид, Интерес)

	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();

	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 

	АдресаДляОтправкиСтрокой = "";
	МассивАдресовДляОтправки = ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой, Менеджер);

	ОбЛид = Лид.ПолучитьОбъект();
	НавСсылка = ПолучитьНавигационнуюСсылку(ОбЛид);

	//++ #Б-4362 смарт: Фролов 17.09.2025 //Ошибка ЖР. РС смартКоэффициентыМенеджеров
	//Если Лид.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
	Если ЗначениеЗаполнено(Лид.ДокументОснование) 
		И ТипЗнч(Лид.ДокументОснование) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее")
		И Лид.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
	//-- #Б-4362 смарт: Фролов 17.09.2025
		ТекстСодержания = Взаимодействия.ПолучитьОбычныйТекстИзHTML(Лид.ТекстИсточника);
	Иначе	
		ТекстСодержания = Лид.ТекстИсточника;
	КонецЕсли;

	Если Интерес = Неопределено ТОгда
		
		ТекстПисьма = "Лид ранее назначенный Вам, передан другому менеджеру: " + 
		ТекстПисьма = ТекстПисьма + Лид.Номер+" от "+Формат(Лид.Дата,"ДФ=dd.MM.yyyy")+" | "; 
		ТекстПисьма = ТекстПисьма + "Навигационная ссылка на документ: " + НавСсылка + "" + Символы.ПС;
		ТекстПисьма = ТекстПисьма + "Телефон: " + Лид.Телефон + Символы.ПС + "Электронная почта: "
			+ Лид.ЭлектроннаяПочта + Символы.ПС + "Регион: " + Лид.БизнесРегионТекст + Символы.ПС;
		ТекстПисьма = ТекстПисьма + "Продукт: " + Лид.Продукт + Символы.ПС + "Контакт: " + Лид.Имя + Символы.ПС;
		ТекстПисьма = ТекстПисьма + "=================================================================================" + Символы.ПС + Символы.ПС;
		ТекстПисьма = ТекстПисьма + "Текст источника: " + ТекстСодержания + Символы.ПС;
		
	Иначе	
		
		ОбИнтерес = Интерес.ПолучитьОбъект();
		НавСсылкаИнтерес = ПолучитьНавигационнуюСсылку(ОбИнтерес);
		ТекстПисьма = "Интерес ранее назначенный Вам, передан другому менеджеру: "+ Символы.ПС + Символы.ПС + Символы.ПС;
		ТекстПисьма = ТекстПисьма + Интерес.Номер+" от "+Формат(Интерес.Дата,"ДФ=dd.MM.yyyy")+" | "+Интерес.Тема+Символы.ПС;
		ТекстПисьма = ТекстПисьма + "Навигационная ссылка на документ: " + НавСсылкаИнтерес + "" + Символы.ПС;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
		И (ТестовыеАдресаМассив.Количество() > 0
		ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма + " - " + Лид.Тема + "", ТекстПисьма);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, 
			, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
		Исключение
			ТекстСообщения = "Не удалось отправить письмо, менеджеру " + Менеджер + " по лиду " + Лид + Символы.ПС + ОписаниеОшибки(); 
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой = "", Менеджер=Неопределено) 
	
	МассивАдресов = Новый Массив;
	
	АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Менеджер.смартРабочаяПочта);
	
	Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
		
		МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		
	КонецЦикла;
	
	Возврат МассивАдресов;
	
КонецФункции
