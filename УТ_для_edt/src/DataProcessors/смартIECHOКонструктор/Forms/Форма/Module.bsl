&НаСервере
Процедура ДобавитьЭлементыНаФорму()
	
	Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	ДобавленныеСтраницы.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартIECHOКомплектующие.Ссылка КАК Ссылка,
	|	смартIECHOКомплектующие.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ смартIECHOКомплектующиеДетальныеЗаписи.Ссылка) КАК КоличествоПодчиненных
	////++ смарт: Белоусова 621 03.09.21
	//|	смартIECHOКомплектующие.Порядок КАК Порядок
	////-- смарт: Белоусова 621 03.09.21
	|ИЗ
	|	Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующиеРодитель
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующиеРодительРодитель
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующиеРодительРодительРодитель
	|				ПО смартIECHOКомплектующиеРодительРодитель.Родитель = смартIECHOКомплектующиеРодительРодительРодитель.Ссылка
	|			ПО смартIECHOКомплектующиеРодитель.Родитель = смартIECHOКомплектующиеРодительРодитель.Ссылка
	|		ПО смартIECHOКомплектующие.Родитель = смартIECHOКомплектующиеРодитель.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующиеДетальныеЗаписи
	|		ПО смартIECHOКомплектующие.Ссылка = смартIECHOКомплектующиеДетальныеЗаписи.Родитель
	|			И (НЕ смартIECHOКомплектующиеДетальныеЗаписи.ЭтоГруппа)
	|ГДЕ
	|	НЕ смартIECHOКомплектующие.ПометкаУдаления
	|	И смартIECHOКомплектующие.ЭтоГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	смартIECHOКомплектующие.Ссылка,
	|	смартIECHOКомплектующие.Наименование,
	|	смартIECHOКомплектующиеРодитель.Наименование,
	|	смартIECHOКомплектующиеРодительРодитель.Наименование,
	|	смартIECHOКомплектующиеРодительРодительРодитель.Наименование
	////++ смарт: Белоусова 621 03.09.21
	//|	смартIECHOКомплектующие.Порядок
	////-- смарт: Белоусова 621 03.09.21
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ смартIECHOКомплектующиеДетальныеЗаписи.Ссылка) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	////++ смарт: Белоусова 621 03.09.21
	//|	Порядок,
	////-- смарт: Белоусова 621 03.09.21
	//++ #1361 смарт: Фролов 29.05.2023 //Изменения в модуле iECHO  
	//|	ВЫБОР
	//|		КОГДА смартIECHOКомплектующиеРодитель.Наименование ЕСТЬ NULL
	//|			ТОГДА 1
	//|		КОГДА смартIECHOКомплектующиеРодительРодитель.Наименование ЕСТЬ NULL
	//|			ТОГДА 2
	//|		КОГДА смартIECHOКомплектующиеРодительРодительРодитель.Наименование ЕСТЬ NULL
	//|			ТОГДА 3
	//|		ИНАЧЕ 0
	//|	КОНЕЦ,
	//|	смартIECHOКомплектующие.Наименование";
	|	смартIECHOКомплектующие.Наименование ИЕРАРХИЯ";
	//-- #1361 смарт: Фролов 29.05.2023
	
	ВыборкаГруппы = Запрос.Выполнить().Выбрать();
	
	МассивДобавляемыхРеквизитов = Новый Массив;
		
	Сч = 0;
	
	Пока ВыборкаГруппы.Следующий() Цикл
		
		Сч = Сч + 1;
		
		ИмяРеквизита = "ТЗ_" + Сч;
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("ТаблицаЗначений")));
		
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Наименование", Новый ОписаниеТипов("СправочникСсылка.смартIECHOКомплектующие"), ИмяРеквизита, "Наименование"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Количество", Новый ОписаниеТипов("Число", ,, Новый КвалификаторыЧисла(15,2)), ИмяРеквизита, "Количество"));
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Цена", Новый ОписаниеТипов("Число", ,, Новый КвалификаторыЧисла(15,2)), ИмяРеквизита, "Цена"));		
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Подитог", Новый ОписаниеТипов("Число", ,, Новый КвалификаторыЧисла(15,2)), ИмяРеквизита, "Подитог"));		
		
		НоваяСтрока = ДобавленныеСтраницы.Добавить();
		НоваяСтрока.ГруппаСправочника = ВыборкаГруппы.Ссылка;
		// ++ 01.02.2021
		//НоваяСтрока.Наименование = ВыборкаГруппы.Наименование;
		НоваяСтрока.Наименование = ПолучитьПолныйПутьРекурсивно(ВыборкаГруппы.Ссылка, ВыборкаГруппы.Наименование);
		// --
		НоваяСтрока.Номер = Сч;
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	Для Сч1 = 1 По Сч Цикл
		
		ИмяРеквизита = "ТЗ_" + Сч1;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номер", Сч1);
		НайденныеСтроки = ДобавленныеСтраницы.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Наименование = НайденныеСтроки[0].Наименование;

		ЭлементСтраница = ДобавитьСтраницуНаФорму("Страница_" + Сч1, Наименование);
		
		ВывестиТаблицуНаФорму(ЭтаФорма, ИмяРеквизита, ЭлементСтраница, Наименование);
		
	КонецЦикла;
	
	КоличествоСтраниц = Сч;
	
	ЗаполнитьТаблицыКомплектующих();
				
КонецПроцедуры

// ++ 01.02.2021
&НаСервереБезКонтекста
Функция ПолучитьПолныйПутьРекурсивно(ГруппаСправочника, знач ИтоговоеНаименование)
	
	Если ЗначениеЗаполнено(ГруппаСправочника.Родитель) Тогда
		ИтоговоеНаименование = "" + ГруппаСправочника.Родитель + " - " + ИтоговоеНаименование;
		Возврат ПолучитьПолныйПутьРекурсивно(ГруппаСправочника.Родитель, ИтоговоеНаименование);
	Иначе
		Возврат ИтоговоеНаименование;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицыКомплектующих(ПервоначальноеЗаполнение = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартIECHOКомплектующие.Родитель КАК Родитель,
	|	смартIECHOКомплектующие.Ссылка КАК Ссылка,
	|	смартIECHOКомплектующие.Цена КАК Цена
	//++ смарт:ММ 621 30.09.2021 
	////++ смарт: Белоусова 621 03.09.21
	//|	смартIECHOКомплектующие.Порядок КАК Порядок
	////-- смарт: Белоусова 621 03.09.21
	//-- смарт:ММ 30.09.2021
	|ИЗ
	|	Справочник.смартIECHOКомплектующие КАК смартIECHOКомплектующие
	|ГДЕ
	|	НЕ смартIECHOКомплектующие.ПометкаУдаления
	|	И НЕ смартIECHOКомплектующие.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	//++ смарт:ММ 621 30.09.2021 
	////++ смарт: Белоусова 621 03.09.21
	//|	Порядок,
	////-- смарт: Белоусова 621 03.09.21
	//-- смарт:ММ 30.09.2021
	|	Родитель,
	|	смартIECHOКомплектующие.Наименование
	|ИТОГИ ПО
	|	Родитель";
	
	ВыборкаИерархия = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаИерархия.Следующий() Цикл
				
		Отбор = Новый Структура;
		Отбор.Вставить("ГруппаСправочника", ВыборкаИерархия.Родитель);
		НайденныеСтроки = ДобавленныеСтраницы.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтраницы = НайденныеСтроки[0].Номер;
				
		ИмяРеквизитаТЧ = "ТЗ_" + НомерСтраницы;
		
		ВыборкаДетальная = ВыборкаИерархия.Выбрать();
		
		Пока ВыборкаДетальная.Следующий() Цикл
			
			ДобавитьСтроку = Ложь;
			
			Если ПервоначальноеЗаполнение Тогда
				ДобавитьСтроку = Истина;
			Иначе
				Отбор = Новый Структура;
				Отбор.Вставить("Наименование", ВыборкаДетальная.Ссылка);
				НайденныеСтроки = ЭтаФорма[ИмяРеквизитаТЧ].НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() = 0 Тогда
					ДобавитьСтроку = Истина;
				Иначе
					НайденнаяСтрока = НайденныеСтроки[0];
					Если НайденнаяСтрока.Цена <> ВыборкаДетальная.Цена Тогда
						НайденнаяСтрока.Цена = ВыборкаДетальная.Цена;
						НайденнаяСтрока.Подитог = НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;
					КонецЕсли;
				КонецЕсли;				
			КонецЕсли;
			
			Если ДобавитьСтроку Тогда
				НоваяСтрока = ЭтаФорма[ИмяРеквизитаТЧ].Добавить();
				НоваяСтрока.Наименование = ВыборкаДетальная.Ссылка;
				НоваяСтрока.Цена = ВыборкаДетальная.Цена;
			КонецЕсли;			
		КонецЦикла;
		
		// ++ 01.02.2021
		//++ смарт: Белоусова 621 03.09.21
		//ЭтаФорма[ИмяРеквизитаТЧ].Сортировать("Наименование");
		//-- смарт: Белоусова 621 03.09.21

		// --
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ДобавитьСтраницуНаФорму(ИмяРеквизита, СинонимСтраницы)
	
	НоваяСтраница = Элементы.Вставить(ИмяРеквизита, Тип("ГруппаФормы"), Элементы.ГруппаСтраницы, Элементы.СтраницаФинальная);
	НоваяСтраница.Вид = ВидГруппыФормы.Страница;
	НоваяСтраница.Заголовок = СинонимСтраницы;
	
	Возврат НоваяСтраница;
	
КонецФункции

&НаСервере
Процедура ВывестиТаблицуНаФорму(Форма, ИмяТаблицы, Родитель, ЗаголовокТаблицы)
    
    ТаблицаФормы = Форма.Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), Родитель);
    ТаблицаФормы.ПутьКДанным = ИмяТаблицы;
    ТаблицаФормы.Заголовок = ЗаголовокТаблицы;
    ТаблицаФормы.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ТаблицаФормы.ЦветТекстаЗаголовка = Новый Цвет(51, 102, 255);
	ТаблицаФормы.ШрифтЗаголовка = Новый Шрифт(ТаблицаФормы.ШрифтЗаголовка,, 14, Истина);
    ТаблицаФормы.ИзменятьПорядокСтрок = Ложь;
    ТаблицаФормы.ИзменятьСоставСтрок = Ложь;
    ТаблицаФормы.РазрешитьНачалоПеретаскивания = Ложь;
	ТаблицаФормы.КоманднаяПанель.Видимость = Ложь;
