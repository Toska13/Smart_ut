&НаКлиенте
Процедура ВыполнитьНеобходимыеДействияПриПереходеПоСтраницам(Знач Оповещение, Команда)
	
	Если Команда.Имя = "Далее" Тогда 
		//++ #1487 смарт: Фролов 09.10.2023 //Изменения консруктора iECHO
		//++ #Б4216 смарт: Шляпников 12.09.2025 / Корректировка Конструктора IECHO.
		//Если СтрЗаменить(Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок,"70 Опции","")<> Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок 
		//	И ЭтаФорма["ТЗ_3"].Итог("Количество")=0 Тогда
		//	НомерТекущейСтраницы=22;		
		//КонецЕсли;
		//-- #Б4216 смарт: Шляпников 12.09.2025
		//-- #1487 смарт: Фролов 09.10.2023
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница <> Элементы.СтраницаФинальная Тогда
			
			ВсегоЭлементов = КоличествоСтраниц;
			
			Если НомерТекущейСтраницы = ВсегоЭлементов Тогда
				ПерейтиНаФинальнуюСтраницу();
				НомерТекущейСтраницы = НомерТекущейСтраницы + 1;
			Иначе
				//++ #1487 смарт: Фролов 11.10.2023 //Изменения консруктора iECHO
				ПроверкаСледующейСтраницы=НомерТекущейСтраницы+1;
				Пока ЭтаФорма["ТЗ_"+ПроверкаСледующейСтраницы].Количество()=0 Цикл
					ПроверкаСледующейСтраницы=ПроверкаСледующейСтраницы+1;
				КонецЦикла;
				НомерТекущейСтраницы=ПроверкаСледующейСтраницы-1; 
				//-- #1487 смарт: Фролов 11.10.2023
				НомерСледующейСтраницы = НомерТекущейСтраницы + 1;
				Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница_" + НомерСледующейСтраницы];
				НомерТекущейСтраницы = НомерСледующейСтраницы;
			КонецЕсли;
			
			//ОбновитьСписокЗапчастей();
			
		ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаФинальная Тогда
			
			ДокументСсылка = СоздатьДокументСпецификация();
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда
				
				Если ОткрытьПослеСоздания Тогда
					ПоказатьЗначение(, ДокументСсылка);
				КонецЕсли;
				
				ЭтаФорма.Закрыть();
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		//++ #1487 смарт: Фролов 09.10.2023 //Изменения консруктора iECHO
		//++ #Б4216 смарт: Шляпников 12.09.2025 / Корректировка Конструктора IECHO.
		//Если СтрЗаменить(Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок,"90 SOFTWARE","")<> Элементы.ГруппаСтраницы.ТекущаяСтраница.Заголовок 
		//	И ЭтаФорма["ТЗ_3"].Итог("Количество")=0 Тогда
		//	НомерТекущейСтраницы=11;		
		//КонецЕсли; 
		//-- #Б4216 смарт: Шляпников 12.09.2025
		ПроверкаСледующейСтраницы=НомерТекущейСтраницы-1;
		Пока ЭтаФорма["ТЗ_"+ПроверкаСледующейСтраницы].Количество()=0 Цикл
			ПроверкаСледующейСтраницы=ПроверкаСледующейСтраницы-1;
		КонецЦикла;
		НомерТекущейСтраницы=ПроверкаСледующейСтраницы+1; 
		//-- #1487 смарт: Фролов 09.10.2023
		Если НомерТекущейСтраницы <> 1 Тогда
			НомерПредыдущейСтраницы = НомерТекущейСтраницы - 1;
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["Страница_" + НомерПредыдущейСтраницы];
			НомерТекущейСтраницы = НомерПредыдущейСтраницы;
			//ОбновитьСписокЗапчастей();
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьНеобходимыеДействияПриПереходеПоСтраницамФрагмент(Оповещение);
	
КонецПроцедуры

