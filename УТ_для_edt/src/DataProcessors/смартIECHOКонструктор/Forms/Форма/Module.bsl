&НаКлиенте
Функция ПолучитьИмяТекущейТЧ()
	
	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница;
	ИмяТекущейСтраницы = ТекущаяСтраница.Имя;
	НомерЗнака_ = СтрНайти(ИмяТекущейСтраницы, "_");
	Если НомерЗнака_ = 0 Тогда
		Возврат "";
	КонецЕсли;
	НомерСтраницы = Прав(ИмяТекущейСтраницы, СтрДлина(ИмяТекущейСтраницы) - НомерЗнака_);
	
	ИмяТЧ = "ТЗ_" + НомерСтраницы;
	
	Возврат ИмяТЧ;
	
КонецФункции //-- смарт:ММ 23.09.2021

