
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДобавитьЭлементыНаФорму();
	НомерТекущейСтраницы = 1;
	ОткрытьПослеСоздания = Истина;
		
	//++ #1376 смарт: Фролов 06.09.2023 //доработка функционала консруктора iECHO (Глобализация параметров)  
	//ЗаполнитьСтоимостьИзПредопределенныхНастроек(); 
	ЕстьПолныеПрава = УправлениеДоступом.ЕстьРоль("ПолныеПрава");
	Если НЕ (УправлениеДоступом.ЕстьРоль("смартIECHOЗакупщикКомплектующих")
		ИЛИ ЕстьПолныеПрава ИЛИ УправлениеДоступом.ЕстьРоль("смартIECHOАдминистрирование")) Тогда
		Элементы.ГруппаСтоимость.Видимость=Ложь;
	КонецЕсли;	
	//-- #1376 смарт: Фролов 06.09.2023 
	
	//++ #Б-5346 смарт: Фролов 30.12.2025 //Доработка Конструктора IECHO
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартiECHOЗаполнениеСтоимости
	|ГДЕ
	|	СхемаПоУмолчанию");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЭтаФорма.СхемаЗаполненияСтоимости = Выборка.Ссылка;
		
	КонецЕсли;
	//-- #Б-5346 смарт: Фролов 30.12.2025
	
КонецПроцедуры

