//++ #Б-3928 смарт: Лопато 28.07.2025 //Доработка конструктора IECHO. Уточнение наценки по моделям.  
&НаКлиенте
Процедура ПолучитьМаржуПоМоделиКомплектующейКлиент()

	МодельОсновнойКомплектующей = Неопределено;
	
	Если ВыбранныеОсновныеКомплектующие.Количество() > 0 Тогда
		
		Для Каждого ЭлементСпискаОсновнаяКомплектующая Из ВыбранныеОсновныеКомплектующие Цикл
			
			ПолучитьМаржуПоМоделиКомплектующейСервер(Маржа, ЭтаФорма.СхемаЗаполненияСтоимости, ЭлементСпискаОсновнаяКомплектующая.Значение);

		КонецЦикла;
		
	Иначе
		
		ИмяТЧ = ПолучитьИмяТекущейТЧ();
		
		Если ИмяТЧ = "ТЗ_1" Тогда

			ТекущиеДанные = Элементы[ИмяТЧ].ТекущиеДанные;
			
			Если ТекущиеДанные <> Неопределено Тогда
				
				ПолучитьМаржуПоМоделиКомплектующейСервер(Маржа, ЭтаФорма.СхемаЗаполненияСтоимости, ТекущиеДанные.Наименование);

			КонецЕсли;				
				
		КонецЕсли;

	КонецЕсли;	

КонецПроцедуры //-- #Б-3928 смарт: Лопато 28.07.2025

//++ #Б-3928 смарт: Лопато 28.07.2025 //Доработка конструктора IECHO. Уточнение наценки по моделям.  
&НаСервере
Процедура ПолучитьМаржуПоМоделиКомплектующейСервер(Маржа, Знач Схема, Знач Комплектующая)

	Если ЗначениеЗаполнено(Схема)
		И ЗначениеЗаполнено(Комплектующая) Тогда
		
		МодельКомплектующей = Комплектующая.Model;
			
		Если ЗначениеЗаполнено(МодельКомплектующей) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Маржа КАК Маржа
			|ИЗ
			|	Справочник.смартiECHOЗаполнениеСтоимости.НаценкаПоМоделям
			|ГДЕ
			|	Ссылка = &Схема
			|	И Модель = &Модель";
			
			Запрос.УстановитьПараметр("Схема", Схема);
			Запрос.УстановитьПараметр("Модель", МодельКомплектующей);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				
				Маржа = ВыборкаДетальныеЗаписи.Маржа;
				
			КонецЕсли;
			
		КонецЕсли;

	КонецЕсли;
			
КонецПроцедуры //-- #Б-3928 смарт: Лопато 28.07.2025

