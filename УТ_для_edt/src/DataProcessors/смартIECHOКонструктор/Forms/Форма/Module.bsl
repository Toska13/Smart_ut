&НаСервере
Процедура ДобавитьУдалитьКомплектующуюСписокЗначений(ТекущаяКомплектующая, УдалитьИзСписка = Ложь)
		
	Если ТекущаяКомплектующая.ОсновнаяКомплектующая Тогда
		СписокЗнач = ВыбранныеОсновныеКомплектующие;
	Иначе
		СписокЗнач = ВыбранныеКомплектующие;
	КонецЕсли;
	
	Если УдалитьИзСписка Тогда
		Если СписокЗнач.НайтиПоЗначению(ТекущаяКомплектующая) <> Неопределено Тогда
			СписокЗнач.Удалить(СписокЗнач.НайтиПоЗначению(ТекущаяКомплектующая));
		КонецЕсли;
	Иначе
		Если СписокЗнач.НайтиПоЗначению(ТекущаяКомплектующая) = Неопределено Тогда
			СписокЗнач.Добавить(ТекущаяКомплектующая);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПроверитьСоответствиеМоделейНаСервере(ТекущаяКомплектующая)
	
	Если ТекущаяКомплектующая.ОсновнаяКомплектующая Тогда
				
		Для Каждого ЭлементСпискаОсновнаяКомплектующая Из ВыбранныеОсновныеКомплектующие Цикл
			
			ОсновнаяКомплектующая = ЭлементСпискаОсновнаяКомплектующая.Значение;
			ТекущаяМодель = ОсновнаяКомплектующая.Model;
			// ++ 01.02.2021
			ТекущийРазмер = ОсновнаяКомплектующая.Размер;
			// --
			
			Для Сч = 1 По КоличествоСтраниц Цикл
				
				ИмяТЧ = "ТЗ_" + Сч;
				
				Для Каждого ТекСтрока Из ЭтаФорма[ИмяТЧ] Цикл
					
					Если ТекСтрока.Количество = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					// ++ 01.02.2021
					ОграничениеИспользованияПоМоделям = ТекСтрока.Наименование.ОграничениеИспользованияПоМоделям;
					ОграничениеИспользованияПоРазмеру = ТекСтрока.Наименование.ОграничениеИспользованияПоРазмеру;
					 
					Если НЕ ОграничениеИспользованияПоМоделям 						
						И НЕ ОграничениеИспользованияПоРазмеру
					// --
						Тогда
						Продолжить;
					КонецЕсли;
					
					// ++ 01.02.2021
					Если ОграничениеИспользованияПоМоделям Тогда
					// --
						
						КомплектующаяПодходитДляТекущихМоделей = Ложь;
						Отбор = Новый Структура;
						Отбор.Вставить("Модель", ТекущаяМодель);
						НайденныеСтроки = ТекСтрока.Наименование.МоделиДляИспользования.НайтиСтроки(Отбор);
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							КомплектующаяПодходитДляТекущихМоделей = Истина;
						КонецЕсли;
										
						Если НЕ КомплектующаяПодходитДляТекущихМоделей Тогда
							ТекстСообщения = "Комплектующая " + ТекСтрока.Наименование + " не используется с " + ОсновнаяКомплектующая + " (ограничение по модели)";
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
							ТекСтрока.Количество = 0;
							ТекСтрока.Подитог = 0;
							ВыбранныеКомплектующие.Удалить(ВыбранныеКомплектующие.НайтиПоЗначению(ТекСтрока.Наименование));
						КонецЕсли;
						
					// ++ 01.02.2021
					КонецЕсли;
					
					Если ОграничениеИспользованияПоРазмеру Тогда
					
						КомплектующаяПодходитДляТекущихРазмеров = Ложь;
						Отбор = Новый Структура;
						Отбор.Вставить("Размер", ТекущийРазмер);
						НайденныеСтроки = ТекСтрока.Наименование.РазмерыДляИспользования.НайтиСтроки(Отбор);
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							КомплектующаяПодходитДляТекущихРазмеров = Истина;
						КонецЕсли;
										
						Если НЕ КомплектующаяПодходитДляТекущихРазмеров Тогда
							ТекстСообщения = "Комплектующая " + ТекСтрока.Наименование + " не используется с " + ОсновнаяКомплектующая + " (ограничение по размеру)";
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
							ТекСтрока.Количество = 0;
							ТекСтрока.Подитог = 0;
							ВыбранныеКомплектующие.Удалить(ВыбранныеКомплектующие.НайтиПоЗначению(ТекСтрока.Наименование));
						КонецЕсли;
					КонецЕсли;
					// --

				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокДоступныхКомплектующих(ТекущаяКомплектующая)
	
	// Удалить несоответствующие комплектующие
	
	Если ТекущаяКомплектующая = Неопределено  
		ИЛИ ТекущаяКомплектующая.ОсновнаяКомплектующая Тогда
		
		// Сначала добавить все возможные комплектующие (если, например, поменялась основная комплектующая и требуется вернуть ранее удаленные из списка элементы)
		ЗаполнитьТаблицыКомплектующих(Ложь);

		Для Каждого ЭлементСпискаОсновнаяКомплектующая Из ВыбранныеОсновныеКомплектующие Цикл
			
			ОсновнаяКомплектующая = ЭлементСпискаОсновнаяКомплектующая.Значение;
			ТекущаяМодель = ОсновнаяКомплектующая.Model;
			
			// ++ 01.02.2021
			ТекущийРазмер = ОсновнаяКомплектующая.Размер;
			// --
			
			Для Сч = 1 По КоличествоСтраниц Цикл
				
				ИмяТЧ = "ТЗ_" + Сч;
				
				СтрокиДляУдаления = Новый Массив;
				
				Для Каждого ТекСтрока Из ЭтаФорма[ИмяТЧ] Цикл
					
					// ++ 01.02.2021
					ОграничениеИспользованияПоМоделям = ТекСтрока.Наименование.ОграничениеИспользованияПоМоделям;
					ОграничениеИспользованияПоРазмеру = ТекСтрока.Наименование.ОграничениеИспользованияПоРазмеру;
					 
					Если НЕ ОграничениеИспользованияПоМоделям 						
						И НЕ ОграничениеИспользованияПоРазмеру						
						// --
						Тогда
						Продолжить;
					КонецЕсли;
					
					// ++ 01.02.2021
					Если ОграничениеИспользованияПоМоделям Тогда
					// --
						КомплектующаяПодходитДляТекущихМоделей = Ложь;
						Отбор = Новый Структура;
						Отбор.Вставить("Модель", ТекущаяМодель);
						НайденныеСтроки = ТекСтрока.Наименование.МоделиДляИспользования.НайтиСтроки(Отбор);
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							КомплектующаяПодходитДляТекущихМоделей = Истина;
						КонецЕсли;
						
						Если НЕ КомплектующаяПодходитДляТекущихМоделей Тогда
							// ++ 01.02.2021
							//ЭтаФорма[ИмяТЧ].Удалить(ТекСтрока);
							СтрокиДляУдаления.Добавить(ТекСтрока);
							
							Продолжить;
							// --
						КонецЕсли;
					
					// ++ 01.02.2021
					КонецЕсли;
				
					Если ОграничениеИспользованияПоРазмеру Тогда
						
						КомплектующаяПодходитДляТекущихРазмеров = Ложь;
						Отбор = Новый Структура;
						Отбор.Вставить("Размер", ТекущийРазмер);
						НайденныеСтроки = ТекСтрока.Наименование.РазмерыДляИспользования.НайтиСтроки(Отбор);
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							КомплектующаяПодходитДляТекущихРазмеров = Истина;
						КонецЕсли;
						
						Если НЕ КомплектующаяПодходитДляТекущихРазмеров Тогда
							//ЭтаФорма[ИмяТЧ].Удалить(ТекСтрока);	
							СтрокиДляУдаления.Добавить(ТекСтрока);
						КонецЕсли;
					КонецЕсли;
					// --
					
				КонецЦикла;
				
				// ++ 01.02.2021
				Счетчик = ЭтаФорма[ИмяТЧ].Количество() - 1;
				
				Пока Счетчик >= 0 Цикл
					
					ТекущаяСтрока = ЭтаФорма[ИмяТЧ][Счетчик];
					
					Если СтрокиДляУдаления.Найти(ТекущаяСтрока) <> Неопределено Тогда
						
						Если ТекущаяСтрока.Количество <> 0 Тогда
							ДобавитьУдалитьКомплектующуюСписокЗначений(ТекущаяСтрока.Наименование, Истина);	
						КонецЕсли;
						
						ЭтаФорма[ИмяТЧ].Удалить(ТекущаяСтрока);
					КонецЕсли;
					
					Счетчик = Счетчик - 1;
				КонецЦикла;
				// --
			КонецЦикла;	
		КонецЦикла;
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция СоздатьДокументСпецификация()
	
	Результат = Документы.смартIECHOСпецификация.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда
		ОбщегоНазначения.СообщитьПользователю("Необходимо указать клиента!", , "Клиент", "Объект");
		Возврат Результат;
	КонецЕсли;
	
	ДокОбъект = Документы.смартIECHOСпецификация.СоздатьДокумент();
	
	ДокОбъект.Дата 			= ТекущаяДата();
	ДокОбъект.Валюта	 	= Справочники.Валюты.НайтиПоКоду("840"); // доллар
	КурсВалютыСтруктура 	= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокОбъект.Валюта, ТекущаяДата());
	ДокОбъект.Клиент 		= Объект.Клиент;
	ДокОбъект.Менеджер 		= ПараметрыСеанса.ТекущийПользователь;
	ДокОбъект.НаименованиеОборудования = НаименованиеОборудования();	
	ДокОбъект.Итого 		= Итого;
	// ++ 02.02.2021
	ДокОбъект.ИтогоДляКлиента = ИтогоДляКлиента;
	// --
	ДокОбъект.Курс	 		= КурсВалютыСтруктура.Курс;
	//ДокОбъект.ИтогоРуб 		= Итого * КурсВалютыСтруктура.Курс / КурсВалютыСтруктура.Кратность;
	
	// ++ 22.04.2021
	ДокОбъект.КонтактноеЛицо 	= КонтактноеЛицо;
	ДокОбъект.Маржа 			= Маржа;
	ДокОбъект.ДатаДействияКП 	= ДатаДействияКП;
	ДокОбъект.СрокПоставкиДней 	= СрокПоставкиДней;
	ДокОбъект.СтоимостьДоставкиДоГраницыРФ 		= СтоимостьДоставкиДоГраницыРФ;
	ДокОбъект.СтоимостьДоставкиПоРФ 			= СтоимостьДоставкиПоРФ;
	ДокОбъект.СтоимостьТаможенногоОформления 	= СтоимостьТаможенногоОформления;
	
	//++ #1376 смарт: Фролов 18.06.2023 //доработка функционала консруктора iECHO (Глобализация параметров)  
	ДокОбъект.СтоимостьДоставкиЖДТранспортом 		= СтоимостьДоставкиЖДТранспортом;
	ДокОбъект.СтоимостьДоставкиАМТранспортом 		= СтоимостьДоставкиАМТранспортом;
	ДокОбъект.ВалютаУчета 		= ВалютаУчета; 
	ДокОбъект.СтавкаНДС         = СтавкаНДС;
	КурсВалютыСтруктураВалютаУчета 		= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокОбъект.ВалютаУчета, ТекущаяДата());
	ДокОбъект.СхемаЗаполненияСтоимости=СхемаЗаполненияСтоимости;
	ДокОбъект.ТипДоставки=ТипДоставки;
	//-- #1376 смарт: Фролов 18.06.2023
	
	// ++ 04.05.2021
	ДокОбъект.СебестоимостьОборудования = СебестоимостьОборудования;
	ДокОбъект.ИтогоДляКлиентаРуб = ИтогоДляКлиента * КурсВалютыСтруктура.Курс / КурсВалютыСтруктура.Кратность;
	// --
	
	// ++ 12.05.2021
	ДокОбъект.СкидкаНаЗакупку = СкидкаНаЗакупку;
	ДокОбъект.ИтогоЦенаЗакупкиСоСкидкой = ИтогоЦенаЗакупкиСоСкидкой;
	ДокОбъект.ИтогоРуб = ИтогоЦенаЗакупкиСоСкидкой * КурсВалютыСтруктура.Курс / КурсВалютыСтруктура.Кратность;
	// --
	
	//++ смарт:ММ 621 28.09.2021 
	ДокОбъект.МаржаUSD = МаржаUSD;
	//-- смарт:ММ 28.09.2021
	
	Для Сч = 1 По КоличествоСтраниц Цикл
						
		ИмяТЧ = "ТЗ_" + Сч;
		
		Для Каждого ТекСтрока Из ЭтаФорма[ИмяТЧ] Цикл
			
			Если ТекСтрока.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокОбъект.Комплектующие.Добавить();
			НоваяСтрока.НаименованиеКомплектующей = ТекСтрока.Наименование;
			НоваяСтрока.Количество = ТекСтрока.Количество;
			НоваяСтрока.Цена = ТекСтрока.Цена;
			НоваяСтрока.Стоимость = ТекСтрока.Подитог;						
		КонецЦикла;		
	КонецЦикла;
	
	//++ смарт:ММ 621 30.09.2021 
	ДокОбъект.СортироватьТаблицуКомплектующих();
	//-- смарт:ММ 30.09.2021
	
	Попытка
		ДокОбъект.Записать();
		Результат = ДокОбъект.Ссылка;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПерейтиНаФинальнуюСтраницу()
	
	ЗаполнитьИтоговуюИнформацию();
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаФинальная;
	
