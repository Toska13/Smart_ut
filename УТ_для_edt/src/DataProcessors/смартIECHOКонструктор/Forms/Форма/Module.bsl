&НаСервереБезКонтекста
Функция ПолучитьЗависимыеКомплектующие(ТекКомплектующая, Вопрос, Ответ)
	
	МассивРезультат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартIECHOВопросыОтветыПоКомплектующим.Комплектующая КАК Комплектующая
	|ИЗ
	|	РегистрСведений.смартIECHOВопросыОтветыПоКомплектующим КАК смартIECHOВопросыОтветыПоКомплектующим
	|ГДЕ
	|	смартIECHOВопросыОтветыПоКомплектующим.ИсходнаяКомплектующая = &ТекКомплектующая
	|	И смартIECHOВопросыОтветыПоКомплектующим.Вопрос = &Вопрос
	|	И смартIECHOВопросыОтветыПоКомплектующим.Ответ = &Ответ";
	
	Запрос.УстановитьПараметр("ТекКомплектующая", 	ТекКомплектующая);
	Запрос.УстановитьПараметр("Вопрос", 			Вопрос);
	Запрос.УстановитьПараметр("Ответ", 				Ответ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Комплектующая) Тогда
			МассивРезультат.Добавить(Выборка.Комплектующая);
		КонецЕсли;
	КонецЦикла;
		
	Возврат МассивРезультат;	
	
КонецФункции //-- смарт:ММ 22.09.2021

//++ смарт:ММ 621 23.09.2021 
&НаКлиенте
Функция ОбработатьВопросы(ТекущаяКомплектующая, ТекущиеДанные = Неопределено)
	
	//++ смарт:ММ 621 28.09.2021 
	Если СписокКомплектующихИзВопросов.НайтиПоЗначению(ТекущаяКомплектующая) = Неопределено Тогда
		СписокКомплектующихИзВопросов.Добавить(ТекущаяКомплектующая);
	КонецЕсли;
	//-- смарт:ММ 28.09.2021
	
	МассивВопросов = ПолучитьВопросыПоКомплектующей(ТекущаяКомплектующая);
	
	Если МассивВопросов.Количество() > 0 Тогда
		НомерПоследнегоОбработанногоВопросаИзМассива = 0;
		ЗадатьВопросы(МассивВопросов, НомерПоследнегоОбработанногоВопросаИзМассива, ТекущаяКомплектующая, ТекущиеДанные);
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущаяКомплектующая", ТекущаяКомплектующая);
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);	
	
	КомплектующиеКоличествоПриИзмененииЗавершение(ДополнительныеПараметры);
	
КонецФункции //-- смарт:ММ 23.09.2021

//++ смарт:ММ 621 23.09.2021 
&НаКлиенте
Процедура ЗадатьВопросы(МассивВопросов, НомерПоследнегоОбработанногоВопросаИзМассива = 0, ТекущаяКомплектующая, ТекущиеДанные)
	
	Сч = 1;
	
	Для Каждого Вопрос Из МассивВопросов Цикл
		
		Если Сч = НомерПоследнегоОбработанногоВопросаИзМассива + 1 Тогда
			ЗадатьВопрос(Вопрос, ТекущаяКомплектующая, НомерПоследнегоОбработанногоВопросаИзМассива, МассивВопросов, ТекущиеДанные);
		КонецЕсли;
		
		Сч = Сч + 1;
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 23.09.2021

//++ смарт:ММ 621 23.09.2021 
&НаКлиенте
Процедура ЗадатьВопрос(Вопрос, ТекущаяКомплектующая, НомерПоследнегоОбработанногоВопросаИзМассива, МассивВопросов, ТекущиеДанные)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ТекущиеДанные", ТекущиеДанные);
	ДополнительныеПараметры.Вставить("МассивВопросов", МассивВопросов);
	ДополнительныеПараметры.Вставить("Вопрос", Вопрос);
	ДополнительныеПараметры.Вставить("ТекущаяКомплектующая", ТекущаяКомплектующая);
	ДополнительныеПараметры.Вставить("НомерПоследнегоОбработанногоВопросаИзМассива", НомерПоследнегоОбработанногоВопросаИзМассива);
		
	ОписаниеОповещения = Новый ОписаниеОповещения("КомплектующиеКоличествоПриИзмененииОтветНаВопросЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	//++ #Б4216 смарт: Шляпников 12.09.2025 / Корректировка Конструктора IECHO.
	ДанныеАвтоОтвета = ПроверитьВопросНаАвтоматическийОтвет(Вопрос);
	Если ДанныеАвтоОтвета.ЕстьАвтоматическийОтвет Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, ?(ДанныеАвтоОтвета.АвтоматическийОтвет = Истина, КодВозвратаДиалога.Да, КодВозвратаДиалога.Нет));
		Возврат;
	КонецЕсли;
	//-- #Б4216 смарт: Шляпников 12.09.2025

	ПоказатьВопрос(ОписаниеОповещения, Вопрос, РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры //-- смарт:ММ 23.09.2021

//++ смарт:ММ 621 22.09.2021 
&НаКлиенте
Процедура КомплектующиеКоличествоПриИзмененииОтветНаВопросЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	МассивВопросов = ДополнительныеПараметры.МассивВопросов;
	
	НомерПоследнегоОбработанногоВопросаИзМассива = ДополнительныеПараметры.НомерПоследнегоОбработанногоВопросаИзМассива;
	НомерПоследнегоОбработанногоВопросаИзМассива = НомерПоследнегоОбработанногоВопросаИзМассива + 1;
	
	Ответ = Неопределено;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Ответ = Истина;
	Иначе
		Ответ = Ложь;
	КонецЕсли;	
	
	ТекущаяКомплектующая = ДополнительныеПараметры.ТекущаяКомплектующая;
	Вопрос = ДополнительныеПараметры.Вопрос;
	
	ЗависимыеКомплектующие = ПолучитьЗависимыеКомплектующие(ТекущаяКомплектующая, Вопрос, Ответ);
	
	Для Каждого ЗависимаяКомплектующая Из ЗависимыеКомплектующие Цикл
		
		// Пройтись по всем ТЧ и отметить количество = 1 для выбранной комплектующей.
		// Пересчитать подитог
		// Проверить и задать вопросы при необходимости (если они есть в РС)
		
		//++ смарт:ММ 621 28.09.2021 
		Если СписокКомплектующихИзВопросов.НайтиПоЗначению(ЗависимаяКомплектующая) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		//-- смарт:ММ 28.09.2021
		
		ОтметитьКоличествоПоКомплектующей(ЗависимаяКомплектующая);
		ОбработатьВопросы(ЗависимаяКомплектующая, ТекущиеДанные);
	КонецЦикла;
	
	ЗадатьВопросы(МассивВопросов, НомерПоследнегоОбработанногоВопросаИзМассива, ТекущаяКомплектующая, ТекущиеДанные);
	
КонецПроцедуры //-- смарт:ММ 22.09.2021

