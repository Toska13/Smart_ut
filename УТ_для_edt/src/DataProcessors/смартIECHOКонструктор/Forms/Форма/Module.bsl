&НаКлиенте
Процедура ОтметитьКоличествоПоКомплектующей(ЗависимаяКомплектующая)
		
	Для Сч = 1 По КоличествоСтраниц Цикл
		
		ИмяТЧ = "ТЗ_" + Сч;
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", ЗависимаяКомплектующая);
		НайденныеСтроки = ЭтаФорма[ИмяТЧ].НайтиСтроки(Отбор);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.Количество = 1;
			ПересчитатьСтроку(НайденнаяСтрока);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Автоматически добавлена комплектующая " + ЗависимаяКомплектующая + " (кол-во = 1)");
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 23.09.2021

