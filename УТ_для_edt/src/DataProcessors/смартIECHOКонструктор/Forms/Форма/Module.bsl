&НаСервере
Процедура ЗаполнитьИтоговуюИнформацию()
	
	Об = РеквизитФормыВЗначение("Объект");
	ИтоговаяИнформация = Об.ПолучитьМакет("Макет").ПолучитьТекст();

	Если КлиентскоеПриложение.ТекущийВариантИнтерфейса() = ВариантИнтерфейсаКлиентскогоПриложения.Такси Тогда
		ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#fcfaeb", "#ffffff");
	КонецЕсли;
	
	Итого = 0;
	КомплектующаяТекст = "";
	
	Для Сч = 1 По КоличествоСтраниц Цикл
						
		ИмяТЧ = "ТЗ_" + Сч;
		
		Для Каждого ТекСтрока Из ЭтаФорма[ИмяТЧ] Цикл
			
			Если ТекСтрока.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстТекущаяСтрока = "" + ТекСтрока.Наименование + ", " + ТекСтрока.Количество + " шт., $" + ТекСтрока.Подитог;
			Итого = Итого + ТекСтрока.Подитог;
			
			КомплектующаяТекст = КомплектующаяТекст + ?(ЗначениеЗаполнено(КомплектующаяТекст), "<br>", "") + ТекстТекущаяСтрока;
						
		КонецЦикла;		
	КонецЦикла;	
	
	НаименованиеОборудования = НаименованиеОборудования();
	
	// ++ 03.02.2021
	ИтогоДляКлиента = 0;
	ИтогоДляКлиентаРасчет = "";
	
	// ++ 16.05.2021
	КоэффициентРасчетаСебестоимости = 1;
	
	Если ВыбранныеОсновныеКомплектующие.Количество() > 0 Тогда
		//++ #1361 смарт: Фролов 30.05.2023 //Изменения в модуле iECHO  
		//ОК = ВыбранныеОсновныеКомплектующие[0].Значение; 
		//КоэффициентРасчетаСебестоимости = ОК.КоэффициентРасчетаСебестоимости; 
		КоэффициентРасчетаСебестоимости=0;
		Для Каждого ОК Из ВыбранныеОсновныеКомплектующие Цикл
			КоэффициентРасчетаСебестоимости=КоэффициентРасчетаСебестоимости+ОК.Значение.КоэффициентРасчетаСебестоимости;
		КонецЦикла;	
		//-- #1361 смарт: Фролов 30.05.2023
	КонецЕсли;
	// --
	
	Если Итого <> 0 Тогда
		//++ #1376 смарт: Фролов 18.06.2023 //доработка функционала консруктора iECHO (Глобализация параметров)  
        КоэффициентНДСТекст=СтавкаНДС/100+1;
		// ++ 16.05.2021
		//ДоставкаПоРФиТаможняРубли = СтоимостьДоставкиПоРФ + СтоимостьТаможенногоОформления;
		Если ТипДоставки=Перечисления.смартТипыДоставки.МорскойПлюсЖД Тогда
			ДоставкаПоРФиТаможняРубли = СтоимостьДоставкиПоРФ * КоэффициентРасчетаСебестоимости + СтоимостьТаможенногоОформления * КоэффициентРасчетаСебестоимости;
			// --
			
			Рубли = Справочники.Валюты.НайтиПоКоду("643");
			Доллары = Справочники.Валюты.НайтиПоКоду("840");
			Курс2 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Доллары, ТекущаяДата());
			КурсВалюты = Курс2.Курс;
			
			ДоставкаПоРФиТаможняДоллары = РаботаСКурсамиВалют.ПересчитатьВВалюту(ДоставкаПоРФиТаможняРубли, Рубли, Доллары, ТекущаяДата());
			
			// ++ 12.05.2021
			ИтогоЦенаЗакупкиСоСкидкой = смартОбщегоНазначения.РассчитатьСуммуСоСкидкойНаЗакупку(СкидкаНаЗакупку, Итого);
			//--

			// 16.05.2021
			//СебестоимостьОборудования = (ИтогоЦенаЗакупкиСоСкидкой + СтоимостьДоставкиДоГраницыРФ) * 1.2 + ДоставкаПоРФиТаможняДоллары;
			СебестоимостьОборудования = (ИтогоЦенаЗакупкиСоСкидкой + СтоимостьДоставкиДоГраницыРФ * КоэффициентРасчетаСебестоимости) * +КоэффициентНДСТекст + ДоставкаПоРФиТаможняДоллары;
			// --
			
			ИтогоДляКлиентаРасчет = 
			"Себестоимость оборудования = (Стоимость закупки + Доставка до границы РФ * Коэффициент расчета себестоимости) * "+КоэффициентНДСТекст+" (НДС) + (Доставка по РФ * Коэффициент расчета себестоимости + Таможенное оформление * Коэффициент расчета себестоимости) / Курс USD-RUB =" + "<br>"
			+ "(" + ИтогоЦенаЗакупкиСоСкидкой + " + " + СтоимостьДоставкиДоГраницыРФ + " * " + КоэффициентРасчетаСебестоимости + ") * "+КоэффициентНДСТекст+" + (" + СтоимостьДоставкиПоРФ + " * " + КоэффициентРасчетаСебестоимости + " + " + СтоимостьТаможенногоОформления + " * " + КоэффициентРасчетаСебестоимости + ") / " + КурсВалюты + " = " + СебестоимостьОборудования;
		Иначе
			Если ЭтаФорма.ТипДоставки=Перечисления.смартТипыДоставки.ЖелезнодорожныйТранспорт Тогда
				СтоимостьДоставкиВВалютеУчета=СтоимостьДоставкиЖДТранспортом;
			Иначе
				СтоимостьДоставкиВВалютеУчета=СтоимостьДоставкиАМТранспортом;
			КонецЕсли;	
			КурсВалютаУчетаСтруктура = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаУчета, ТекущаяДата());
			ИтогоЦенаЗакупкиСоСкидкой = смартОбщегоНазначения.РассчитатьСуммуСоСкидкойНаЗакупку(СкидкаНаЗакупку, Итого);
			ДоставкаТаможняВВалютеУчета = СтоимостьТаможенногоОформления * КоэффициентРасчетаСебестоимости;
			Доллары = Справочники.Валюты.НайтиПоКоду("840");
			Курс2 = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Доллары, ТекущаяДата());
			КурсВалюты = Курс2.Курс;
			КурсВалютаУчета=КурсВалютаУчетаСтруктура.Курс;
			КратностьКурса=КурсВалютаУчетаСтруктура.Кратность;
			КроссКурс=Формат(КурсВалюты/КурсВалютаУчета,"ЧЦ=10; ЧДЦ=4");
			
			СтоимостьДоставкиДоллары= РаботаСКурсамиВалют.ПересчитатьВВалюту(СтоимостьДоставкиВВалютеУчета, ВалютаУчета, Доллары, ТекущаяДата());
			ТаможняДоллары = РаботаСКурсамиВалют.ПересчитатьВВалюту(ДоставкаТаможняВВалютеУчета, ВалютаУчета, Доллары, ТекущаяДата());
			СебестоимостьОборудования = (ИтогоЦенаЗакупкиСоСкидкой + СтоимостьДоставкиДоллары * КоэффициентРасчетаСебестоимости) * +КоэффициентНДСТекст + ТаможняДоллары;
			
			ИтогоДляКлиентаРасчет = 
			"Себестоимость оборудования = (Стоимость закупки + "+ЭтаФорма.ТипДоставки+" * Коэффициент расчета себестоимости) * "+КоэффициентНДСТекст+" (НДС) + ( Таможенное оформление * Коэффициент расчета себестоимости) / Кросс курс USD-"+ВалютаУчета.Наименование+" * Кратность курса =" + "<br>"
			+ "(" + ИтогоЦенаЗакупкиСоСкидкой + " + " + СтоимостьДоставкиДоллары + " * " + КоэффициентРасчетаСебестоимости + ") * "+КоэффициентНДСТекст+" + ("+ СтоимостьТаможенногоОформления + " * " + КоэффициентРасчетаСебестоимости + ") / " + КроссКурс + " * "+ КратностьКурса+ " = " + СебестоимостьОборудования;
		КонецЕсли;
		
		//-- #1376 смарт: Фролов 18.06.2023
		
		//++ смарт:ММ 621 30.09.2021 
		//ИтогоДляКлиента = Окр(СебестоимостьОборудования + СебестоимостьОборудования * Маржа / 100, 2);
		МаржаUSD = Окр(СебестоимостьОборудования * Маржа / 100, 2);
		//++ #1518 смарт: Фролов 19.10.2023 //Изменения консруктора iECHO (продолжение задачи 1376)
		//Изменил разрядность округления
		ИтогоДляКлиента = Окр(СебестоимостьОборудования + МаржаUSD, -1);
		//-- #1518 смарт: Фролов 19.10.2023
		//-- смарт:ММ 30.09.2021
		
		ИтогоДляКлиентаРасчет = ИтогоДляКлиентаРасчет +  "<br>"
		+ "Цена для клиента = Себестоимость оборудования + Себестоимость оборудования * Маржа = " + Символы.ПС
		+ СебестоимостьОборудования + " + " + СебестоимостьОборудования + " * " + Маржа + "% = " + ИтогоДляКлиента;
	КонецЕсли;	
	// --
	
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#НаименованиеОборудования#", НаименованиеОборудования);
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#Менеджер#", ПараметрыСеанса.ТекущийПользователь);
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#Клиент#", Объект.Клиент);
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#Итого#", "" + Итого + "$");
	// ++ 03.02.2021
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#ИтогоДляКлиента#", "" + ИтогоДляКлиента + "$");
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#ИтогоДляКлиентаРасчет#", ИтогоДляКлиентаРасчет);
	// 12.05.2021
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#СкидкаНаЗакупку#", Строка(СкидкаНаЗакупку));
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#ИтогоСоСкидкой#", "" + ИтогоЦенаЗакупкиСоСкидкой + "$");
	// --
	ИтоговаяИнформация = СтрЗаменить(ИтоговаяИнформация, "#КомплектующаяТекст#", КомплектующаяТекст);
	
	НачалоТегHTML = СтрНайти(ИтоговаяИнформация, "<html");
	Если НачалоТегHTML <> 0 Тогда
		ИтоговаяИнформация = Прав(ИтоговаяИнформация, СтрДлина(ИтоговаяИнформация) - НачалоТегHTML + 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НаименованиеОборудования()
	
	Результат = "";
	
	Для Каждого ОК Из ВыбранныеОсновныеКомплектующие Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), "_", "") + ОК.Значение;
	КонецЦикла;
	
	Для Каждого Комплектующая Из ВыбранныеКомплектующие Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), "_", "") + Комплектующая.Значение;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

