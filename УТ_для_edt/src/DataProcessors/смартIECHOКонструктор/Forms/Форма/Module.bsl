//++ #1376 смарт: Фролов 06.09.2023 //доработка функционала консруктора iECHO (Глобализация параметров)  
Процедура ОбновитьСписокТиповДоставки() 
	Элементы.ТипДоставки.СписокВыбора.Очистить();
	Если ЭтаФорма.СхемаЗаполненияСтоимости.Страна=Справочники.СтраныМира.Россия ТОгда
		Элементы.ТипДоставки.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.МорскойПлюсЖД,"Морской транспорт + ЖД");
		Элементы.ДекорацияВниманиеСтрана.Видимость=Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭтаФорма.СхемаЗаполненияСтоимости) ТОгда
		Страна=НРег(ЭтаФорма.СхемаЗаполненияСтоимости.Страна.Наименование); 
		Страна=Врег(Лев(Страна,1))+Сред(Страна,2,СтрДлина(Страна)-1);
		МасДляСтраны=ПолучитьСклоненияСтроки(Страна,"ПЛ=Мужской","ПД=Родительный");
		НаименованиеСтраны=МасДляСтраны[0];
		Элементы.ДекорацияВниманиеСтрана.Заголовок="Внимание! Расчет произведен для "+НаименованиеСтраны+"";
		Элементы.ДекорацияВниманиеСтрана.Видимость=Истина;
	КонецЕсли;	
	Элементы.ТипДоставки.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.ЖелезнодорожныйТранспорт,"Железнодорожный транспорт");
	Элементы.ТипДоставки.СписокВыбора.Добавить(Перечисления.смартТипыДоставки.АвтомобильныйТранспорт,"Автомобильный транспорт"); 
	ЭтаФорма.ТипДоставки=ЭтаФорма.СхемаЗаполненияСтоимости.ТипДоставки;
КонецПроцедуры	//-- #1376 смарт: Фролов 06.09.2023

