    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОбращенияСписок.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОбращенияСписок.Сценарий</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОбращенияСписок.Тема</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>ОбращенияСписок.ТипОбращения</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Обращения.Ссылка КАК Ссылка,
	Обращения.Номер КАК Номер,
	Обращения.Дата КАК Дата,
	Обращения.Проведен КАК Проведен,
	Обращения.Автор КАК Автор,
	Обращения.Валюта КАК Валюта,
	Обращения.ДатаЗакрытия КАК ДатаЗакрытия,
	Обращения.Завершен КАК Завершен,
	Обращения.КонтактноеЛицо КАК КонтактноеЛицо,
	Обращения.Описание КАК Описание,
	Обращения.Организация КАК Организация,
	Обращения.Ответственный КАК Ответственный,
	Обращения.Партнер КАК Партнер,
	Обращения.Подразделение КАК Подразделение,
	Обращения.ПотенциальныйКлиент КАК ПотенциальныйКлиент,
	Обращения.ПричинаОтказа КАК ПричинаОтказа,
	Обращения.СостояниеИнтереса КАК СостояниеИнтереса,
	Состояния.Родитель КАК Сценарий,
	Обращения.Тема КАК Тема,
	Обращения.ТипУслуги КАК ТипУслуги,
	Обращения.ТипОбращения КАК ТипОбращения,
	Обращения.УровеньПоддержки КАК УровеньПоддержки,
	Обращения.СрокРеакции КАК СрокРеакции,
	ВЫБОР
		КОГДА Обращения.Завершен
			ТОГДА Обращения.ДатаЗакрытия
		ИНАЧЕ Обращения.СрокРешения
	КОНЕЦ КАК СрокРешения,
	Обращения.ПричинаОтказаКомментарий КАК ПричинаОтказаКомментарий,
	Типы.ИндексКартинки КАК ИндексКартинки,
	Состояния.КатегорияСостояния КАК КатегорияОбращения,
	НЕ ЕСТЬNULL(СведенияПоддержки.ЕстьОтвет, ЛОЖЬ) КАК ТребуетсяРеакция,
	Обращения.СрокРеакции &lt; ЕСТЬNULL(СведенияПоддержки.ДатаОтвета, &amp;ТекущаяДата) КАК СрокРеакцииПросрочен,
	Обращения.СрокРешения &lt; ВЫБОР
		КОГДА Обращения.Завершен
			ТОГДА Обращения.ДатаЗакрытия
		ИНАЧЕ &amp;ТекущаяДата
	КОНЕЦ КАК СрокРешенияПросрочен,
	ВЫБОР
		КОГДА Обращения.СрокРеакции &lt; ЕСТЬNULL(СведенияПоддержки.ДатаОтвета, &amp;ТекущаяДата)
			ТОГДА 3
		КОГДА НЕ ЕСТЬNULL(СведенияПоддержки.ЕстьОтвет, ЛОЖЬ)
			ТОГДА 2
		ИНАЧЕ 0
	КОНЕЦ КАК СрокРеакцииСостояние,
	ВЫБОР
		КОГДА Обращения.СрокРешения &lt; ВЫБОР
				КОГДА Обращения.Завершен
					ТОГДА Обращения.ДатаЗакрытия
				ИНАЧЕ &amp;ТекущаяДата
			КОНЕЦ
			ТОГДА 3
		КОГДА НЕ Обращения.Завершен
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК СрокРешенияСостояние,
	Обращения.СрокРеакции &lt; ЕСТЬNULL(СведенияПоддержки.ДатаОтвета, &amp;ТекущаяДата)
		ИЛИ Обращения.СрокРешения &lt; ВЫБОР
			КОГДА Обращения.Завершен
				ТОГДА Обращения.ДатаЗакрытия
			ИНАЧЕ &amp;ТекущаяДата
		КОНЕЦ КАК Просрочено
ИЗ
	Документ.CRM_Интерес КАК Обращения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CRM_ТипыОбращений КАК Типы
		ПО Обращения.ТипОбращения = Типы.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.CRM_СостоянияИнтересов КАК Состояния
		ПО Обращения.СостояниеИнтереса = Состояния.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СведенияПоддержки КАК СведенияПоддержки
		ПО (СведенияПоддержки.Обращение = Обращения.Ссылка)
ГДЕ
	НЕ Обращения.ТипОбращения = ЗНАЧЕНИЕ(Справочник.CRM_ТипыОбращений.Интерес)</queryText>
      <mainTable>Document.CRM_Интерес</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
