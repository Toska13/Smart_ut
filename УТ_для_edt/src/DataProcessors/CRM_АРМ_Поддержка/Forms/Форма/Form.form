    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список_Новые.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot; КАК СписокПолей_Начало,
	ЭлектронноеПисьмоВходящее.Ссылка КАК Ссылка,
	ЭлектронноеПисьмоВходящее.Тема КАК Тема,
	&quot;&quot; КАК ПустаяЯчейка,
	ЭлектронноеПисьмоВходящее.Дата КАК ДатаДляСортировки,
	ЭлектронноеПисьмоВходящее.ОтправительПредставление КАК Отправитель,
	ЭлектронноеПисьмоВходящее.Ответственный КАК Ответственный,
	ВЫБОР
		КОГДА ЭлектронноеПисьмоВходящее.Дата &lt; &amp;ПериодПросроченных
				И ЭлектронноеПисьмоВходящее.Дата > &amp;ПустаяДата
			ТОГДА 1
		КОГДА ЭлектронноеПисьмоВходящее.Дата &lt; &amp;ПериодТекущих
				И ЭлектронноеПисьмоВходящее.Дата > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ КАК Просрочено,
	ЭлектронноеПисьмоВходящее.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая) КАК Избранный,
	ВЫБОР
		КОГДА ЭлектронноеПисьмоВходящее.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая)
			ТОГДА 0
		ИНАЧЕ -1
	КОНЕЦ КАК ИзбранныйИндексКартинки,
	СостоянияОбращений.Описание КАК ТекстОснования,
	1 + ВЫБОР
		КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
			ТОГДА 5
		ИНАЧЕ 9
	КОНЕЦ КАК ВидКартинки,
	ЭлектронноеПисьмоВходящее.УчетнаяЗапись КАК КаналПолучения,
	ЭлектронноеПисьмоВходящее.CRM_РольОтветственного КАК CRM_РольОтветственного,
	ЭлектронноеПисьмоВходящее.УчетнаяЗапись КАК КаналПолученияСсылка,
	ЛОЖЬ КАК НеОтображатьЗаписи,
	ЭлектронноеПисьмоВходящее.CRM_СкрытьВАРМ КАК CRM_СкрытьВАРМ,
	&quot;СписокПолей_Окончание&quot; КАК СписокПолей_Окончание
ИЗ
	РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронноеПисьмоВходящее КАК ЭлектронноеПисьмоВходящее
		ПО СостоянияОбращений.Лид = ЭлектронноеПисьмоВходящее.Ссылка
			И (СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
				ИЛИ СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
					И НЕ &amp;СкрытьПовторныеОбращения)
			И (&amp;ОтображатьПисьма)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot;,
	ЭлектронноеПисьмоИсходящее.Ссылка,
	ЭлектронноеПисьмоИсходящее.Тема,
	&quot;&quot; КАК ПустаяЯчейка,
	ЭлектронноеПисьмоИсходящее.Дата,
	ЭлектронноеПисьмоИсходящее.ОтправительПредставление,
	ЭлектронноеПисьмоИсходящее.Ответственный,
	ВЫБОР
		КОГДА ЭлектронноеПисьмоИсходящее.Дата &lt; &amp;ПериодПросроченных
				И ЭлектронноеПисьмоИсходящее.Дата > &amp;ПустаяДата
			ТОГДА 1
		КОГДА ЭлектронноеПисьмоИсходящее.Дата &lt; &amp;ПериодТекущих
				И ЭлектронноеПисьмоИсходящее.Дата > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ,
	ЭлектронноеПисьмоИсходящее.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая) КАК Избранный,
	ВЫБОР
		КОГДА ЭлектронноеПисьмоИсходящее.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая)
			ТОГДА 0
		ИНАЧЕ -1
	КОНЕЦ,
	СостоянияОбращений.Описание КАК ТекстОснования,
	1 + ВЫБОР
		КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
			ТОГДА 5
		ИНАЧЕ 10
	КОНЕЦ,
	ЭлектронноеПисьмоИсходящее.УчетнаяЗапись,
	ЗНАЧЕНИЕ(Справочник.РолиИсполнителей.ПустаяСсылка),
	ЭлектронноеПисьмоИсходящее.УчетнаяЗапись,
	ЛОЖЬ КАК НеОтображатьЗаписи,
	ЭлектронноеПисьмоИсходящее.CRM_СкрытьВАРМ,
	&quot;СписокПолей_Окончание&quot;
ИЗ
	РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронноеПисьмоИсходящее КАК ЭлектронноеПисьмоИсходящее
		ПО СостоянияОбращений.Лид = ЭлектронноеПисьмоИсходящее.Ссылка
			И (СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
				ИЛИ СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
					И НЕ &amp;СкрытьПовторныеОбращения)
			И (&amp;ОтображатьПисьма)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot;,
	ТелефонныйЗвонок.Ссылка,
	ТелефонныйЗвонок.Тема,
	&quot;&quot;,
	ТелефонныйЗвонок.Дата,
	ТелефонныйЗвонок.АбонентПредставление,
	ТелефонныйЗвонок.Ответственный,
	ВЫБОР
		КОГДА ТелефонныйЗвонок.Дата &lt; &amp;ПериодПросроченных
				И ТелефонныйЗвонок.Дата > &amp;ПустаяДата
			ТОГДА 1
		КОГДА ТелефонныйЗвонок.Дата &lt; &amp;ПериодТекущих
				И ТелефонныйЗвонок.Дата > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ,
	ТелефонныйЗвонок.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая),
	ВЫБОР
		КОГДА ТелефонныйЗвонок.Важность = ЗНАЧЕНИЕ(Перечисление.ВариантыВажностиВзаимодействия.Высокая)
			ТОГДА 0
		ИНАЧЕ -1
	КОНЕЦ,
	СостоянияОбращений.Описание,
	3 + ВЫБОР
		КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
			ТОГДА 5
		ИНАЧЕ 0
	КОНЕЦ + ВЫБОР
		КОГДА ТелефонныйЗвонок.сфпСостояниеЗвонка = ЗНАЧЕНИЕ(перечисление.сфпСостоянияЗвонков.Пропущенный)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ,
	ВЫРАЗИТЬ(ВЫБОР
			КОГДА ТелефонныйЗвонок.сфпСостояниеЗвонка = ЗНАЧЕНИЕ(перечисление.сфпСостоянияЗвонков.Пропущенный)
				ТОГДА &amp;СтрокаПропущенныйТелефонныйЗвонок
			ИНАЧЕ &amp;СтрокаТелефонныйЗвонок
		КОНЕЦ КАК СТРОКА(200)),
	ТелефонныйЗвонок.CRM_РольОтветственного,
	НЕОПРЕДЕЛЕНО,
	ЛОЖЬ,
	ТелефонныйЗвонок.CRM_СкрытьВАРМ,
	&quot;СписокПолей_Окончание&quot;
ИЗ
	РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
		ПО СостоянияОбращений.Лид = ТелефонныйЗвонок.Ссылка
			И (СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
				ИЛИ СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
					И НЕ &amp;СкрытьПовторныеОбращения)
			И (ВЫБОР
				КОГДА ТелефонныйЗвонок.сфпСостояниеЗвонка = ЗНАЧЕНИЕ(перечисление.сфпСостоянияЗвонков.Пропущенный)
					ТОГДА НЕ &amp;СкрытьПропущенныеТелефонныеЗвонки
				КОГДА ТелефонныйЗвонок.сфпСостояниеЗвонка = ЗНАЧЕНИЕ(перечисление.сфпСостоянияЗвонков.Отвеченный)
					ТОГДА НЕ &amp;СкрытьОтвеченныеТелефонныеЗвонки
				ИНАЧЕ ИСТИНА
			КОНЕЦ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot;,
	Заявка.Ссылка,
	Заявка.Тема,
	&quot;&quot;,
	Заявка.Дата,
	&quot;&quot;,
	Заявка.Ответственный,
	ВЫБОР
		КОГДА Заявка.Дата &lt; &amp;ПериодПросроченных
				И Заявка.Дата > &amp;ПустаяДата
			ТОГДА 1
		КОГДА Заявка.Дата &lt; &amp;ПериодТекущих
				И Заявка.Дата > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ,
	ЛОЖЬ,
	-1,
	СостоянияОбращений.Описание,
	2 + ВЫБОР
		КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
			ТОГДА 5
		ИНАЧЕ 0
	КОНЕЦ,
	Заявка.ИсточникПолучения,
	Заявка.CRM_РольОтветственного,
	Заявка.ИсточникПолучения,
	ЛОЖЬ,
	Заявка.CRM_СкрытьВАРМ,
	&quot;СписокПолей_Окончание&quot;
ИЗ
	РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CRM_Заявка КАК Заявка
		ПО СостоянияОбращений.Лид = Заявка.Ссылка
			И (СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
				ИЛИ СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
					И НЕ &amp;СкрытьПовторныеОбращения)
			И (НЕ &amp;СкрытьЗаявки)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot;,
	СообщениеМессенджера.Ссылка,
	СообщениеМессенджера.ТекстСообщения,
	&quot;&quot;,
	СообщениеМессенджера.Дата,
	СообщениеМессенджера.КонтактПредставление,
	СообщениеМессенджера.Ответственный,
	ВЫБОР
		КОГДА СообщениеМессенджера.Дата &lt; &amp;ПериодПросроченных
				И СообщениеМессенджера.Дата > &amp;ПустаяДата
			ТОГДА 1
		КОГДА СообщениеМессенджера.Дата &lt; &amp;ПериодТекущих
				И СообщениеМессенджера.Дата > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ,
	ЛОЖЬ,
	-1,
	СостоянияОбращений.Описание,
	0 + ВЫБОР
		КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
			ТОГДА 5
		ИНАЧЕ 0
	КОНЕЦ,
	СообщениеМессенджера.УчетнаяЗапись,
	СообщениеМессенджера.CRM_РольОтветственного,
	СообщениеМессенджера.УчетнаяЗапись,
	ЛОЖЬ,
	СообщениеМессенджера.CRM_СкрытьВАРМ,
	&quot;СписокПолей_Окончание&quot;
ИЗ
	РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CRM_СообщениеМессенджера КАК СообщениеМессенджера
		ПО СостоянияОбращений.Лид = СообщениеМессенджера.Ссылка
			И (СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
				ИЛИ СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
					И НЕ &amp;СкрытьПовторныеОбращения)
			И (НЕ &amp;СкрытьСообщения)</queryText>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
      <keyField>Ссылка</keyField>
    </extInfo>
