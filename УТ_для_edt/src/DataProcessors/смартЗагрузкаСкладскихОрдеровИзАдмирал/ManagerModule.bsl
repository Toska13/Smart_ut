#Область Интерфейс

Функция ЗаписатьОбъектВJSON(ТекОбъект) Экспорт
	
	Запись = Новый ЗаписьJSON;
	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "	", Истина);
    Запись.УстановитьСтроку(ПараметрыЗаписи);
    ЗаписатьJSON(Запись, ТекОбъект);
	
    Возврат Запись.Закрыть();
	
КонецФункции

Функция ПрочитатьОбъектИзJSON(Стр, Соответствие = Ложь) Экспорт
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Попытка
    	ТекОбъект = ПрочитатьJSON(Чтение, Соответствие);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		ТекОбъект = Неопределено;
		ЗаписьЖурналаРегистрации("Запрос в Адмирал", УровеньЖурналаРегистрации.Ошибка, , Стр, ОписаниеОшибки);
	КонецПопытки;
	
    Возврат ТекОбъект;
	
КонецФункции

Функция ПолучитьВладельцаСерий(Номенклатура) Экспорт
	
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ВидНоменклатуры, ВидНоменклатуры.ВладелецСерий");
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.ВидНоменклатурыВладелецСерий) Тогда
		Возврат ДанныеНоменклатуры.ВидНоменклатурыВладелецСерий;
	Иначе
		Возврат ДанныеНоменклатуры.ВидНоменклатуры;
	КонецЕсли;
	
КонецФункции

Функция НайтиСериюНоменклатуры(Номенклатура, СерияПоДаннымСклада) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка КАК Ссылка,
	|		1 КАК Приоритет
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Наименование = &Наименование
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка,
	|		2
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Номер = &Номер
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СерииНоменклатуры.Ссылка,
	|		3
	|	ИЗ
	|		Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|	ГДЕ
	|		СерииНоменклатуры.Номер = &НомБезДаты
	|		И СерииНоменклатуры.ВидНоменклатуры = &ВидНоменклатуры) КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("Наименование", СерияПоДаннымСклада);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ПолучитьВладельцаСерий(Номенклатура));
	
	МассивНомеров = СтрРазделить(СерияПоДаннымСклада, ",", Истина);
	Запрос.УстановитьПараметр("Номер", МассивНомеров[0]);
	Запрос.УстановитьПараметр("НомБезДаты", МассивНомеров[0]);
	
	Если МассивНомеров.Количество() > 1 Тогда
		
		ДатаСерии = СтроковыеФункцииКлиентСервер.СтрокаВДату(СокрЛП(МассивНомеров[1]));
		Если ЗначениеЗаполнено(ДатаСерии) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "СерииНоменклатуры.Номер = &Номер",
													 "СерииНоменклатуры.Номер = &Номер И СерииНоменклатуры.ГоденДо = &Дата");
			Запрос.УстановитьПараметр("Дата", ДатаСерии);
		КонецЕсли;
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СерииНоменклатуры.ПустаяСсылка();
	
КонецФункции

Функция НайтиНоменклатуруПоКодуИлиАртикулу(Артикул = Неопределено, Код = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Данные.Ссылка КАК Ссылка,
	|	Данные.Приоритет КАК Приоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		Номенклатура.Ссылка КАК Ссылка,
	|		1 КАК Приоритет
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Код = &Код
	|		И НЕ &Код = НЕОПРЕДЕЛЕНО
	|		И НЕ &Код = """"
	|		И НЕ Номенклатура.ЭтоГруппа
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Номенклатура.Ссылка,
	|		2
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Номенклатура.Артикул = &Артикул
	|		И НЕ &Артикул = НЕОПРЕДЕЛЕНО
	|		И НЕ &Артикул = """"
	|		И НЕ Номенклатура.ЭтоГруппа) КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	КодСПрефиксом = Код;
	Если ЗначениеЗаполнено(Код) Тогда
		ПрефиксацияОбъектовСобытия.УстановитьПрефиксИнформационнойБазы(Справочники.Номенклатура.ПустаяСсылка(), , КодСПрефиксом);
	КонецЕсли;
	Запрос.УстановитьПараметр("Код", КодСПрефиксом);
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Ссылка <> NULL Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

Функция ПолучитьРасходныйОрдерПоНомеруАдмирал(Номер, Дата = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РасходныйОрдерНаТовары.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
	|ГДЕ
	|	РасходныйОрдерНаТовары.смартИдентификаторWMS = &смартИдентификаторWMS
	|	И РасходныйОрдерНаТовары.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, ГОД) И КОНЕЦПЕРИОДА(&Дата, ГОД)";
	
	Если ЗначениеЗаполнено(Дата) Тогда
		Запрос.УстановитьПараметр("Дата", Дата);
	Иначе
		Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	КонецЕсли;
	
	Запрос.УстановитьПараметр("смартИдентификаторWMS", Номер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.РасходныйОрдерНаТовары.ПустаяСсылка();
	
КонецФункции

