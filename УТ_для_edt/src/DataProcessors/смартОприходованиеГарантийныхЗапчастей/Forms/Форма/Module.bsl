
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастроитьВидимостьДоступность();
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОприходоватьНаСклад(Команда)
	
	// Пока просто ругается, без запретов
	ПроверитьНулевоеКоличествоПришло();
	
	ОприходоватьНаСкладСервер();
	
КонецПроцедуры


&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	МассивИменКолонок = Новый Массив;
	
	МассивИменКолонок.Добавить("НоменклатураАртикул");
	МассивИменКолонок.Добавить("Номенклатура");
	МассивИменКолонок.Добавить("Отметка");
	МассивИменКолонок.Добавить("КоличествоОжидается");
	//МассивИменКолонок.Добавить("КоличествоПришло");  // Она доступна всем и так
	МассивИменКолонок.Добавить("НомерЗаявки");
	МассивИменКолонок.Добавить("Склад");
	
	Если РольДоступна("ПолныеПрава") Тогда
		Для Каждого Имя Из МассивИменКолонок Цикл
			Элементы["Запчасти" + Имя].ТолькоПросмотр = Ложь;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ЗаполнитьНаСервере();
	ЗначениеВРеквизитФормы(Об, "Объект");
		
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНулевоеКоличествоПришло()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Отметка", Истина);
	Отбор.Вставить("КоличествоПришло", 0);
	НайденныеСтроки = Объект.Запчасти.НайтиСтроки(Отбор);
	
	Для Каждого Стр Из НайденныеСтроки Цикл
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + Стр.НомерСтроки + " не заполнена колонка ""Количество пришло""");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОприходоватьНаСкладСервер()
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ОприходоватьНаСкладСервер();	
	
КонецПроцедуры


