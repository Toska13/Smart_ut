        <choiceList>
          <presentation>
            <key>ru</key>
            <value>в настройки СКД (отбор)</value>
          </presentation>
          <value xsi:type="core:StringValue">
            <value>СКД</value>
          </value>
        </choiceList>
        <choiceList>
          <presentation>
            <key>ru</key>
            <value>без СКД</value>
          </presentation>
          <value xsi:type="core:StringValue">
            <value>БезСКД</value>
          </value>
