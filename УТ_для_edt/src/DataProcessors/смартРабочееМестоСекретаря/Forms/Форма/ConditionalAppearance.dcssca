			</item>
			<item>
				<field>МенеджерыСтатус</field>
			</item>
			<item>
				<field>МенеджерыЗанятДо</field>
			</item>
			<item>
				<field>МенеджерыВыданоЛидов</field>
			</item>
			<item>
				<field>МенеджерыВыдатьЛидов</field>
			</item>
			<item>
