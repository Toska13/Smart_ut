		<filter>
			<item xsi:type="FilterItemComparison">
				<left xsi:type="dcscor:Field">ОсновныеМенеджеры.Статус</left>
				<comparisonType>NotInList</comparisonType>
				<right xsi:type="dcscor:DesignTimeValue">Справочник.смартСтатусыСотрудников.НаРабочемМесте</right>
				<right xsi:type="dcscor:DesignTimeValue">Справочник.смартСтатусыСотрудников.ТелефонЗанят</right>
			</item>
