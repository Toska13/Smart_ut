&НаСервере
Процедура ЗаполнитьМенеджеровАбонента()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(АбонентКомпания) Тогда
		
		ОсновныеМенеджеры.Очистить();
		
		Если НЕ АбонентКомпания.ОсновнойМенеджер.Пустая() Тогда
			СтрОсновныеМенеджеры = ОсновныеМенеджеры.Добавить();
			СтрОсновныеМенеджеры.ВидМенеджера = "Основной менеджер";
			СтрОсновныеМенеджеры.Менеджер = АбонентКомпания.ОсновнойМенеджер;
			СтрОсновныеМенеджеры.Подразделение = АбонентКомпания.ОсновнойМенеджер.Подразделение;
			СтрОсновныеМенеджеры.Статус = ПолучитьСтатусМенеджера(АбонентКомпания.ОсновнойМенеджер, АбонентКомпания, Истина);
			//++ #Б-7314 смарт: Фролов 12.08.2026 //Рабочее место секретаря. Доработка ТЧ ОсновныеМенеджеры
			СтрОсновныеМенеджеры.СостояниеПартнера = ПолучитьСостояниеПартнера(АбонентКомпания);
			//-- #Б-7314 смарт: Фролов 12.08.2026
			Телефоны = ПолучитьТелефоныМенеджеров(АбонентКомпания.ОсновнойМенеджер);
			СтрОсновныеМенеджеры.ЛичныйТелефон = Телефоны.ЛичныйТелефон;
			СтрОсновныеМенеджеры.МобильныйТелефон = Телефоны.МобильныйТелефон;
			СтрОсновныеМенеджеры.ВнутреннийТелефон = Телефоны.ВнутреннийТелефон;
		КонецЕсли;
		
		Если НЕ АбонентКомпания.смартМенеджерПоРасходнымМатериалам.Пустая() Тогда
			СтрОсновныеМенеджеры = ОсновныеМенеджеры.Добавить();
			СтрОсновныеМенеджеры.ВидМенеджера = "Расходные материалы";
			СтрОсновныеМенеджеры.Менеджер = АбонентКомпания.смартМенеджерПоРасходнымМатериалам;
			СтрОсновныеМенеджеры.Подразделение = АбонентКомпания.смартМенеджерПоРасходнымМатериалам.Подразделение;
			СтрОсновныеМенеджеры.Статус = ПолучитьСтатусМенеджера(АбонентКомпания.смартМенеджерПоРасходнымМатериалам, 
				АбонентКомпания, АбонентКомпания.ОсновнойМенеджер = АбонентКомпания.смартМенеджерПоРасходнымМатериалам);
			//++ #Б-7314 смарт: Фролов 12.08.2026 //Рабочее место секретаря. Доработка ТЧ ОсновныеМенеджеры	
			СтрОсновныеМенеджеры.СостояниеПартнера = ПолучитьСостояниеПартнера(АбонентКомпания, "РМ");
			//-- #Б-7314 смарт: Фролов 12.08.2026
			Телефоны = ПолучитьТелефоныМенеджеров(АбонентКомпания.смартМенеджерПоРасходнымМатериалам);
			СтрОсновныеМенеджеры.ЛичныйТелефон = Телефоны.ЛичныйТелефон;
			СтрОсновныеМенеджеры.МобильныйТелефон = Телефоны.МобильныйТелефон;
			СтрОсновныеМенеджеры.ВнутреннийТелефон = Телефоны.ВнутреннийТелефон;
		КонецЕсли;
		
		Если НЕ АбонентКомпания.смартОсновнойМенеджерСервисЦентра.Пустая() Тогда
			СтрОсновныеМенеджеры = ОсновныеМенеджеры.Добавить();
			СтрОсновныеМенеджеры.ВидМенеджера = "Сервис центр";
			СтрОсновныеМенеджеры.Менеджер = АбонентКомпания.смартОсновнойМенеджерСервисЦентра;
			СтрОсновныеМенеджеры.Подразделение = АбонентКомпания.смартОсновнойМенеджерСервисЦентра.Подразделение;
			СтрОсновныеМенеджеры.Статус = ПолучитьСтатусМенеджера(АбонентКомпания.смартОсновнойМенеджерСервисЦентра, 
				АбонентКомпания, АбонентКомпания.ОсновнойМенеджер = АбонентКомпания.смартОсновнойМенеджерСервисЦентра);
			//++ #Б-7314 смарт: Фролов 12.08.2026 //Рабочее место секретаря. Доработка ТЧ ОсновныеМенеджеры	
			СтрОсновныеМенеджеры.СостояниеПартнера = ПолучитьСостояниеПартнера(АбонентКомпания, "СЦ");
			//-- #Б-7314 смарт: Фролов 12.08.2026
			Телефоны = ПолучитьТелефоныМенеджеров(АбонентКомпания.смартОсновнойМенеджерСервисЦентра);
			СтрОсновныеМенеджеры.ЛичныйТелефон = Телефоны.ЛичныйТелефон;
			СтрОсновныеМенеджеры.МобильныйТелефон = Телефоны.МобильныйТелефон;
			СтрОсновныеМенеджеры.ВнутреннийТелефон = Телефоны.ВнутреннийТелефон;
		КонецЕсли;
		
		Элементы.ОсновныеМенеджерыЭП.Видимость = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
//++ #Б-7314 смарт: Фролов 12.08.2026 //Рабочее место секретаря. Доработка ТЧ ОсновныеМенеджеры
Функция ПолучитьСостояниеПартнера(Партнер, ВидСостояния = "")

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартСостояниеПартнеров.Состояние" + ВидСостояния + " КАК Состояние
	|ИЗ
	|	РегистрСведений.смартСостояниеПартнеров КАК смартСостояниеПартнеров
	|ГДЕ
	|	смартСостояниеПартнеров.Партнер = &Партнер");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Состояние;
	Иначе
		Возврат Неопределено;	
	КонецЕсли;	
	
КонецФункции //-- #Б-7314 смарт: Фролов 12.08.2026	

&НаСервере
Функция ПолучитьСтатусМенеджера(Менеджер, Партнер, Основной)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Менеджер) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Партнер КАК Партнер
		|ИЗ
		|	РегистрСведений.смартСостояниеПартнеров
		|ГДЕ
		|	Партнер = &Партнер
		|	И Состояние В(&МассивСостояний)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(Статус, ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте)) КАК Статус
		|ИЗ
		//++ #Б-7054 смарт: Фролов 01.06.2026 //Отпуска сотрудников на текущую дату
		//|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(, Пользователь = &Менеджер)"); 
		|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(&ТекущаяДата, Пользователь = &Менеджер)");
		//-- #Б-7054 смарт: Фролов 01.06.2026
		Запрос.УстановитьПараметр("Менеджер", Менеджер);
		Запрос.УстановитьПараметр("Партнер", Партнер);
		//++ #Б-7054 смарт: Фролов 01.06.2026 //Отпуска сотрудников на текущую дату
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		//-- #Б-7054 смарт: Фролов 01.06.2026
		МассивСостояний = Новый Массив;
		МассивСостояний.Добавить(Перечисления.смартСостоянияПартнеров.Закреплен);
		МассивСостояний.Добавить(Перечисления.смартСостоянияПартнеров.НеСвободен);
		Запрос.УстановитьПараметр("МассивСостояний", МассивСостояний);
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		ВыборкаЗакрепленных = МассивРезультатов[0].Выбрать();
		ВыборкаСтатусы = МассивРезультатов[1].Выбрать();
		
		Если ВыборкаЗакрепленных.Следующий() ИЛИ НЕ Основной Тогда
			
			Если ВыборкаСтатусы.Следующий() Тогда
				Возврат ВыборкаСтатусы.Статус;	
			Иначе
				Возврат Справочники.смартСтатусыСотрудников.НаРабочемМесте;
			КонецЕсли;
			
		Иначе	
			
			Возврат Справочники.смартСтатусыСотрудников.НетВыдачи; 
			
		КонецЕсли;
		
	Иначе	
		
		Возврат "";
		
	КонецЕсли;	
	
КонецФункции	

