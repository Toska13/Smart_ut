&НаКлиенте
Процедура ОбработатьВыборФайла(Результат, АдресВременногоХранилища, ВыбранноеИмя, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ПозицияСлеша = СтрНайти(ВыбранноеИмя, "\", НаправлениеПоиска.СКонца);
	
	Если ПозицияСлеша > 0 Тогда
		ИмяСРасширением = Сред(ВыбранноеИмя, ПозицияСлеша + 1);
	Иначе
		ИмяСРасширением = ВыбранноеИмя;
	КонецЕсли;
	
	ПозицияТочки = СтрНайти(ИмяСРасширением, ".", НаправлениеПоиска.СКонца);
	
	Если ПозицияТочки > 0 Тогда
		Расширение = НРег(Прав(ИмяСРасширением, СтрДлина(ИмяСРасширением) - ПозицияТочки));
		ИмяБезРасширения = Лев(ИмяСРасширением, ПозицияТочки - 1);
	Иначе
		Расширение = "";
		ИмяБезРасширения = ИмяСРасширением;
	КонецЕсли;
	
	Расширение = НРег(Расширение);
	
	СтрПрикрепленныеФайлы = ПрикрепленныеФайлы.Добавить();
	СтрПрикрепленныеФайлы.АдресФайла = АдресВременногоХранилища; 
	СтрПрикрепленныеФайлы.Расширение = Расширение;
	СтрПрикрепленныеФайлы.ИндексКартинки = РаботаСФайламиСлужебныйКлиентСервер.ПолучитьИндексПиктограммыФайла(Расширение);
	СтрПрикрепленныеФайлы.ИмяФайла = ИмяБезРасширения;
	
	Элементы.ПрикрепленныеФайлы.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьПрикрепленныеФайлы()
	
	Для Каждого СтрПрикрепленныеФайлы Из ПрикрепленныеФайлы Цикл
		
		УдалитьИзВременногоХранилища(СтрПрикрепленныеФайлы.АдресФайла);	
		
	КонецЦикла;
	
	ПрикрепленныеФайлы.Очистить();
	
КонецПроцедуры	

