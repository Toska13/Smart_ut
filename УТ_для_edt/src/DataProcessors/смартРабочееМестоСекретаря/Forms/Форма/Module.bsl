		ОбИнтерес.Офис = ВыбранныйСотрудник.Подразделение.CRM_офис;
		ОбИнтерес.Записать(РежимЗаписиДокумента.Запись); 
		
		//++ #Б-7240 смарт: Фролов 02.07.2026 //Файлы из Рабочего места секретаря переносить в Интересы и Лиды
		Для Каждого СтрПрикрепленныеФайлы Из ПрикрепленныеФайлы Цикл
			
			ПараметрыФайла = Новый Структура();
