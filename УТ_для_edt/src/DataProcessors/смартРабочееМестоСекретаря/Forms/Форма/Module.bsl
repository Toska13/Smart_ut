КонецПроцедуры

&НаСервере
Функция ТелефонПриИзмененииНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураВозврата = Новый Структура;
	Если ЗначениеЗаполнено(ЭтаФорма.Телефон) Тогда
		ТелефонДляПоиска=ОставитьТолькоЦиФрыВСтроке(ЭтаФорма.Телефон); 
		
		СтруктураПроверки = Новый Структура();
		СтруктураПроверки.Вставить("Телефон",ТелефонДляПоиска);
		СтруктураПроверки.Вставить("ДатаЛида",ТекущаяДата());
		
		МасПартнеров=Новый СписокЗначений;
		МасКонтактов=Новый СписокЗначений;
		//Пытаемся по конактным данным найти Партнерра и Контактное лицо
		СтруктураТелефона = сфпСофтФонПроСервер.сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(ТелефонДляПоиска);
		Клиент_Телефон = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(СтруктураТелефона.КодСтраны, СтруктураТелефона.КодГорода, СтруктураТелефона.НомерТелефона, СтруктураТелефона.Добавочный, "");
		лКэшПоиска = CRM_ПоискКонтактов.СтруктураДанныхКэша();
		лКэшЗаполнения = CRM_ПоискКонтактов.СтруктураДанныхКэша();
		лУсловияПоиска = Новый Массив;
		лСтрокаПоискаНормализованная = CRM_ПоискКонтактов.НормализоватьСтрокуПоискаИДополнитьКэш(Клиент_Телефон, лКэшПоиска, лКэшЗаполнения);
		лРезультатПоиска = CRM_ПоискКонтактов.ВыполнитьПоискКонтактов(лСтрокаПоискаНормализованная, 2, Истина,Истина);
		Для Каждого СтрлРезультатПоиска Из лРезультатПоиска.Элементы Цикл
			Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.Партнеры") И МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено ТОгда
				МасПартнеров.Добавить(СтрлРезультатПоиска,""+СтрлРезультатПоиска + " - "+СтрлРезультатПоиска.Код+"");
			КонецЕсли;
			Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.КонтактныеЛицаПартнеров") И МасКонтактов.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено ТОгда
				МасКонтактов.Добавить(СтрлРезультатПоиска,СтрлРезультатПоиска);
				Если МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска.Владелец)=Неопределено ТОгда
					МасПартнеров.Добавить(СтрлРезультатПоиска.Владелец,""+СтрлРезультатПоиска.Владелец + " - "+СтрлРезультатПоиска.Владелец.Код+"");
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
		
		РезультатыПоискаПоКИ="Контактная информация найдена у: ";
		Если МасПартнеров.Количество()=1 ТОгда
			АбонентКомпания=МасПартнеров[0].Значение;
			//Неддействительным не даем лид
		ИначеЕсли МасПартнеров.Количество()>1 ТОгда	
			Для Каждого СтрМасПартнеров Из МасПартнеров Цикл
				РезультатыПоискаПоКИ=РезультатыПоискаПоКИ+Символы.ПС+" - "+СтрМасПартнеров.Представление;	
			КонецЦикла;
		КонецЕсли;
		Если МасКонтактов.Количество()=1 ТОгда
			АбонентИмя = МасКонтактов[0].Значение;
			АбонентИмяСтр = МасКонтактов[0].Значение.Наименование;
		ИначеЕсли МасКонтактов.Количество()>1 ТОгда	
			Для Каждого СтрМасКонтактов Из МасКонтактов Цикл
				РезультатыПоискаПоКИ=РезультатыПоискаПоКИ+Символы.ПС+" - "+СтрМасКонтактов.Представление;	
			КонецЦикла;
		КонецЕсли;
		Если НЕ РезультатыПоискаПоКИ="Контактная информация найдена у: " Тогда
			Элементы.ДекорацияКонтакт.Заголовок = РезультатыПоискаПоКИ;
			Элементы.ГруппаАбонентСтр.Видимость = Истина;
			Элементы.ГруппаАбонент.Видимость = Ложь;
			Элементы.ОсновныеМенеджеры.Видимость = Ложь;
		ИначеЕсли МасПартнеров.Количество() = 0 И МасКонтактов.Количество() = 0 Тогда
			Элементы.ДекорацияКонтакт.Заголовок = "Телефон в базе не найден!";
			Элементы.ГруппаАбонентСтр.Видимость = Истина;
			Элементы.ГруппаАбонент.Видимость = Ложь;
			Элементы.ОсновныеМенеджеры.Видимость = Ложь;
		Иначе	
			Элементы.ДекорацияКонтакт.Заголовок = "";
			Элементы.ГруппаАбонентСтр.Видимость = Ложь;
			Элементы.ГруппаАбонент.Видимость = Истина;
			Элементы.ОсновныеМенеджеры.Видимость = Истина;
			ЗаполнитьМенеджеровАбонента();
		КонецЕсли;	
		//Ищем Бизнес-регион по телефону с помощью DaData пока что текстовое значение
		РегионОпределенный=ОбработатьТелефонНаСервере(ТелефонДляПоиска);
		РегионСсылка=НайтиРегион(РегионОпределенный);
		Если ЗначениеЗаполнено(РегионСсылка) И НЕ ЗначениеЗаполнено(РегионСсылка.смартОтветственоеПодразделение) ТОгда
			Регион=РегионСсылка;
			//Регион=НайтиРегионВерхнегоУровня(РегионСсылка);
			СтруктураВозврата.Вставить("Регион", Регион);
		ИначеЕсли ЗначениеЗаполнено(РегионСсылка) И ЗначениеЗаполнено(РегионСсылка.смартОтветственоеПодразделение) ТОгда	
			Регион=РегионСсылка;
			СтруктураВозврата.Вставить("Регион", Регион);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ОставитьТолькоЦиФрыВСтроке(СтрокаОбработки)
	НовСтрока = "";
	ПравильныеСимволы = "0123456789";
	Для Сч = 1 по СтрДлина(СтрокаОбработки) Цикл
		ТекСимв = Сред(СтрокаОбработки, Сч, 1);
		Если Найти(ПравильныеСимволы, ТекСимв) > 0 Тогда
			НовСтрока = НовСтрока + ТекСимв;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НовСтрока;
КонецФункции

&НаСервере
Функция НайтиРегион(СтрокаРегион) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтрокаРегион1 = СтрЗаменить(СтрокаРегион, "Край", "");
	СтрокаРегион2 = СтрЗаменить(СтрокаРегион1, "Область", "");
	СтрокаРегион3 = СтрЗаменить(СтрокаРегион2, "Республика", "");
	МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРегион3, " ");
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БизнесРегионы
	|ГДЕ
	|	Наименование ПОДОБНО &Регион
	|	И НЕ ПометкаУдаления
	|	И НЕ CRM_КодСтраны = """"");
	
	Для Каждого СтрМассивПодстрок Из МассивПодстрок Цикл
		
		Запрос.УстановитьПараметр("Регион", СтрМассивПодстрок + "%");
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() ТОгда
			
			Возврат Выборка.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Справочники.БизнесРегионы.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиРегионВерхнегоУровня(Регион)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегионПоиска=Регион;
	Пока ЗначениеЗаполнено(РегионПоиска.Родитель) Цикл
		РегионПоиска=НайтиРегионВерхнегоУровня(РегионПоиска.Родитель);
	КонецЦикла;	
	Возврат РегионПоиска;
КонецФункции

&НаСервере
Функция ОбработатьТелефонНаСервере(Телефон) Экспорт
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type" , "application/json");
	Заголовки.Вставить("Authorization", "Token " + "326380939ea6d417cad8a93feb42914f0c26e506");
	Заголовки.Вставить("X-Secret"     , "f7feaa44d6be717d4e0b1e64dc322b4890c943b2");
	
	Запрос = Новый HTTPЗапрос("/api/v1/clean/phone", Заголовки);
	Запрос.УстановитьТелоИзСтроки("[""" + Телефон + """]", КодировкаТекста.UTF8, 
								  ИспользованиеByteOrderMark.НеИспользовать);
	Соединение = Новый HTTPСоединение("cleaner.dadata.ru", 443,,,,, Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено),);
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния=200 ТОгда
		Попытка
			ОтветСервера = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			Чтение=Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ОтветСервера);
			Прочитанное=ПрочитатьJSON(Чтение);
			Если ТипЗнч(Прочитанное)=Тип("Массив") И Прочитанное.Количество()>0 ТОгда
				Возврат ?(ЗначениеЗаполнено(Прочитанное[0].region),Прочитанное[0].region,Прочитанное[0].country);	
			Иначе	
				ОбщегоНазначения.СообщитьПользователю("Для телефона "+Телефон+" не удалось определить телефон!");
				Возврат Неопределено;
			КонецЕсли;	
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Для телефона "+Телефон+" не удалось определить телефон!");
			Возврат Неопределено;
		КонецПопытки;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ТелефонПриИзменении(Элемент)
	
	Перем ТекСтрИдентиф;
	
	СтруктураПоиска = ТелефонПриИзмененииНаСервере();
	
	Если СтруктураПоиска.Свойство("Регион") Тогда
		
		ОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Регион", ТекСтрИдентиф, Регионы.ПолучитьЭлементы(), СтруктураПоиска.Регион, Ложь);
		Элементы.Регионы.ТекущаяСтрока = ТекСтрИдентиф;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьИнтересИПеревестиЗвонокНаСервере(ОтправлятьСМС = Ложь)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	ОбЛид = Неопределено;
	
	Попытка
		
		Если ЗначениеЗаполнено(АбонентКомпания) Тогда
			
			смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(Перечисления.смартВидыСобытийВзаимодействий.НайденСуществующийПартнер,
			"НайденСуществующийПартнер", Новый Структура("Партнер, Пользователь", АбонентКомпания, ВыбранныйСотрудник));
			
			ЗафиксироватьТранзакцию();
			
			УстановитьЗначенияИВидимостьПоУмолчанию();
			
		Иначе	
			
			//++ #Б-5936 смарт: Фролов 06.03.2026 //Ошибка. Доработать механизм перераспределения лидов.
			//ДатаКонтроля = ВернутьКонтрольныеДатуВремя(ВыбранныйСотрудник,ВыбраннаяКвалификация);
			ДатаКонтроля = смартОбщегоНазначения.ВернутьКонтрольныеДатуВремя(ВыбранныйСотрудник, ВыбраннаяКвалификация);
			//-- #Б-5936 смарт: Фролов 06.03.2026
			
			ОбЛид = Документы.смартЛид.СоздатьДокумент();
			ОбЛид.Ответственный = ВыбранныйСотрудник;
			ОбЛид.Распределил = ПараметрыСеанса.ТекущийПользователь;
			ОбЛид.СостояниеЛида = Перечисления.смартСостоянияЛидов.Распределен;
			ОбЛид.БизнесРегион = ВыбранныйРегион;
			ОбЛид.Квалификация = ВыбраннаяКвалификация;
			ОбЛид.Дата = ТекущаяДата();
			ОбЛид.БизнесРегионТекст = РегионОпределенный;
			ОбЛид.ДокументОснование = ДокументТелефонныйЗвонок.Ссылка;
			ОбЛид.КонтактноеЛицо = АбонентИмя;
			ОбЛид.Имя = АбонентИмяСтр;
			ОбЛид.Партнер = АбонентКомпания;
			//++ #Б-6692 смарт: Фролов 27.04.2026 //Ошибка. Вы не обработали вовремя Лид (смарт)
			Если НЕ Элементы.ДекорацияКонтакт.Заголовок = "Телефон в базе не найден!" Тогда
				ОбЛид.РезультатыПоискаПоКИ = Элементы.ДекорацияКонтакт.Заголовок;
			КонецЕсли;	
			//-- #Б-6692 смарт: Фролов 27.04.2026
			ОбЛид.Тема = "Звонок по квалификации " + ВыбраннаяКвалификация;
			ОбЛид.ТекстИсточника = Потребность;
			ОбЛид.Телефон = Телефон;
			ОбЛид.Записать(РежимЗаписиДокумента.Запись);
			
			ОбИнтерес=Документы.CRM_Интерес.СоздатьДокумент();
			ОбИнтерес.Дата=ТекущаяДата();
			ОбИнтерес.ДокументОснование = ОбЛид.Ссылка;
			ОбИнтерес.КонтактноеЛицо = ОбЛид.КонтактноеЛицо;
			//++ #Б-7790 смарт: Фролов 06.08.2026 //Добавить Источник в рабочее место секретаря
			ОбИнтерес.смартИнтересКанал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Входящий звонок");
			//ОбИнтерес.смартИнтересИсточник = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоНаименованию("+7-495-663-9111");
			ОбИнтерес.смартИнтересИсточник = ЭтаФорма.ИсточникТелефон;
			//-- #Б-7790 смарт: Фролов 06.08.2026
			ОбИнтерес.ЦенаВключаетНДС = Истина;
			ОбИнтерес.Партнер = ОбЛид.Партнер;
			ОбИнтерес.РучнойВводДатыПродажи = Истина;
			ОбИнтерес.ТипУслуги = ВыбраннаяКвалификация.ТипУслуги;
			Если ОбИнтерес.ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти Тогда
				ОбИнтерес.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
			Иначе	
				ОбИнтерес.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
			КонецЕсли;
			ОбИнтерес.смартВоронкаНовые = Истина;
			ОбИнтерес.Тема = ОбЛид.Тема;
			ОбИнтерес.Ответственный = ОбЛид.Ответственный;
			ОбИнтерес.Организация = CRM_ОбщегоНазначенияПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(ОбИнтерес.Ответственный, "ОсновнаяОрганизация");
			ОбИнтерес.смартПредварительнаяКвалификация	= ВыбраннаяКвалификация;
			ОбИнтерес.СостояниеИнтереса = ВыбраннаяКвалификация.СтартовыйЭтап;
			ОбИнтерес.СрокРеакции = ДатаКонтроля;
			ОбИнтерес.Подразделение = ВыбранныйСотрудник.Подразделение;
			ОбИнтерес.Офис = ВыбранныйСотрудник.Подразделение.CRM_офис;
			ОбИнтерес.Записать(РежимЗаписиДокумента.Запись);
			
			НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Менеджер.Установить(ВыбранныйСотрудник);
			НаборЗаписей.Отбор.Квалификация.Установить(ВыбраннаяКвалификация);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей[0].ВыданоЛидов=НаборЗаписей[0].ВыданоЛидов + 1;
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.смартИсторияРаботыСЛидом.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Лид.Установить(ОбЛид.Ссылка);
			НаборЗаписей.Отбор.Менеджер.Установить(ВыбранныйСотрудник);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 0 Тогда
				СтрНаборЗаписей = НаборЗаписей.Добавить();
			Иначе	
				СтрНаборЗаписей = НаборЗаписей[0];	
			КонецЕсли;
			СтрНаборЗаписей.Лид = ОбЛид.Ссылка;
			СтрНаборЗаписей.Менеджер = ВыбранныйСотрудник;
			СтрНаборЗаписей.ДатаВыдачи = ТекущаяДата();
			СтрНаборЗаписей.ДатаКонтроля = ДатаКонтроля;
			СтрНаборЗаписей.ДатаОбработки = Неопределено;
			СтрНаборЗаписей.ПервыйКонтакт = Неопределено;
			НаборЗаписей.Записать(Истина);
			
			смартСервер.УдалитьМенеджераИзОбщейОчереди(ВыбранныйСотрудник);
			
			смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(Перечисления.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес,
			"СозданНовыйИнтерес", ОбИнтерес.Ссылка);
			
			ЗафиксироватьТранзакцию();
			
			Если ОтправлятьСМС Тогда
				
				ТекстСообщения = "" + Константы.смартТекстЗаголовкаСМС.Получить() + "тел: " + Телефон + ", " + ?(ЗначениеЗаполнено(АбонентИмя), АбонентИмя, АбонентИмяСтр) + ", " 
				+ ?(ЗначениеЗаполнено(АбонентКомпания), АбонентКомпания, АбонентКомпанияСтр) + ", " + ВыбраннаяКвалификация + ""; 
				
				Результат = смартОбщегоНазначения.ОтправитьСМСПользователю(ВыбранныйСотрудник, ТекстСообщения);
				
				Если ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
					ОбщегоНазначения.СообщитьПользователю("Не удалось отправить SMS менеджеру: " + Результат.ОписаниеОшибки);
				Иначе
					ОбщегоНазначения.СообщитьПользователю("Отправлено SMS менеджеру");
				КонецЕсли;
				
			КонецЕсли;
			
			УстановитьЗначенияИВидимостьПоУмолчанию();
			
		КонецЕсли;
		
	Исключение
		
		ОтменитьТранзакцию();
		ОбщегоНазначения.СообщитьПользователю("Не удалось создать документы");
		
	КонецПопытки;
	
	Если ТипЗнч(ОбЛид) = Тип("ДокументОбъект.смартЛид") Тогда
	
		ОтправитьПисьмоПоЛиду(ОбЛид.Ссылка.Тема, ВыбраннаяКвалификация, ОбЛид.Ссылка, 1);
		
	КонецЕсли;	
	
КонецПроцедуры

