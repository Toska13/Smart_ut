&НаКлиенте
Процедура НазначитьЭПСотруднику(Команда)

	Если НЕ ЗначениеЗаполнено(Письмо) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо указать письмо", , "Письмо");
		Возврат;
	КонецЕсли;
	
	НазначитьЭПСотрудникуНаСервере();
	
	ЗаполнитьПервичныеДанныеФормы();

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеМенеджерыЭППриАктивизацииСтроки(Элемент)

	Если Элементы.ОсновныеМенеджерыЭП.ТекущиеДанные <> Неопределено Тогда
		ЭтаФорма.ВыбранныйСотрудник = Элементы.ОсновныеМенеджерыЭП.ТекущиеДанные.Менеджер;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПисьмоПриИзмененииНаСервере(ВыбраноеПисьмо)
	
	Письмо = ВыбраноеПисьмо;
	
	Если ЗначениеЗаполнено(ВыбраноеПисьмо.ОтправительКонтакт) И ТипЗнч(ВыбраноеПисьмо.ОтправительКонтакт) = Тип("СправочникСсылка.Партнеры") Тогда
		
		АбонентКомпания = ВыбраноеПисьмо.ОтправительКонтакт;
		АбонентКомпанияСтр = "";
		
		Элементы.АбонентКомпанияСтрЭП.Видимость = Ложь;
		Элементы.АбонентКомпанияЭП.Видимость = Истина;
		
		ЗаполнитьМенеджеровАбонента();
		
	Иначе
		
		АбонентКомпания = Неопределено;
		АбонентКомпанияСтр = "";
		
		Элементы.АбонентКомпанияСтрЭП.Видимость = Истина;
		Элементы.АбонентКомпанияЭП.Видимость = Ложь;
		
	КонецЕсли;	
	
	ТемаПисьма = ВыбраноеПисьмо.Тема;
	
	Если ВыбраноеПисьмо.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
		HTMLТекст = "<!DOCTYPE html>
		|<html lang=""ru"">
		|<head>
		|
		|</head>
		|<body>" + ВыбраноеПисьмо.ТекстHTML + "</body>
		|</html>";
		
		ТекстПисьмаHTML = HTMLТекст;
		Элементы.ТекстПисьма.Видимость = Ложь;
		Элементы.ТекстПисьмаHTML.Видимость = Истина;
	Иначе
		ТекстПисьма = ВыбраноеПисьмо.Текст;
		Элементы.ТекстПисьма.Видимость = Истина;
		Элементы.ТекстПисьмаHTML.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

