&НаКлиенте
Процедура ПринятьЗвонок(Команда)
	
	Перем ТекСтрИдентиф;
	
	Телефон = ТелефонВходящий;
	ТелефонВходящий = "";
	ВходящиеЗвонки.Очистить();	
	
	Если ЭтоНеНомерСотрудника(Телефон) Тогда
	
		СтруктураПоиска = ТелефонПриИзмененииНаСервере();
	
		Если СтруктураПоиска.Свойство("Регион") Тогда
			
			ОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Регион", ТекСтрИдентиф, Регионы.ПолучитьЭлементы(), СтруктураПоиска.Регион, Ложь);
			Элементы.Регионы.ТекущаяСтрока = ТекСтрИдентиф;
		
		КонецЕсли;
	
	
		СоздатьТелефонныйЗвонок();
		
		Элементы.ДекорацияЗвонокСотрудника.Видимость = Ложь;
		Элементы.ДекорацияКонтакт.Видимость = Истина;
		
	Иначе
		
		Элементы.ДекорацияЗвонокСотрудника.Видимость = Истина;
		Элементы.ДекорацияКонтакт.Видимость = Ложь;
	
	КонецЕсли;
	
	Элементы.ГруппаВходящийЗвонок.Видимость = Ложь;
	ОжиданиеЗвонка = Ложь;

КонецПроцедуры

&НаСервере
Функция ЭтоНеНомерСотрудника(НомерТелефона)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	| Ссылка КАК Сотрудник
	|ИЗ
	| Справочник.Пользователи.КонтактнаяИнформация
	|ГДЕ
	| НомерТелефона = &НомерТелефона
	|";
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();

КонецФункции

&НаСервере
Процедура СоздатьТелефонныйЗвонок()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументТелефонныйЗвонок = сфпСофтФонПроСервер.СоздатьТелефонныйЗвонок(Неопределено, Телефон, 
																		   ПараметрыСеанса.ТекущийПользователь, ПараметрыСеанса.ТекущийПользователь, 
																		   ПараметрыСеанса.ТекущийПользователь.смартВнутреннийНомерВАТС, Истина, ТекущаяДатаСеанса(), 
																		   ИдентификаторЗвонка);
																		   
	Успех = смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(ИдентификаторСобытия);
	
КонецПроцедуры	

&НаКлиенте
Процедура ПоискПоРегионуАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ Элемент.ТекстРедактирования = "" Тогда
		ДанныеВыбора = ПолучитьДанные(Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанные(СтрокаПоиска)
	
	УстановитьПривилегированныйРежим(Истина);
	
	лЗапрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 10
	|	АдресныеОбъекты.КодСубъектаРФ КАК КодСубъектаРФ,
	|	БизнесРегионы.Ссылка КАК Регион,
	|	АдресныеОбъекты.Наименование КАК Наименование,
	|	АдресныеОбъекты.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БизнесРегионы КАК БизнесРегионы
	|		ПО АдресныеОбъекты.КодСубъектаРФ = БизнесРегионы.СмартКодСубъектаРФ
	|ГДЕ
	|	АдресныеОбъекты.Сокращение = &Сокращение
	|	И АдресныеОбъекты.Наименование ПОДОБНО &Наименование");

	лЗапрос.УстановитьПараметр("Наименование", "%"+СтрокаПоиска+"%");
	лЗапрос.УстановитьПараметр("Сокращение", "г");
	
	Список = Новый СписокЗначений;
	
	ТабВыборка = лЗапрос.Выполнить().Выгрузить();
	
	Для Каждого СтрТабВыборка Из ТабВыборка Цикл
		Список.Добавить(СтрТабВыборка.КодСубъектаРФ, ""+СтрТабВыборка.Наименование + " ("+СтрТабВыборка.Регион+")");	
	КонецЦикла;	

	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура ПоискПоРегионуОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ТекСтрИдентиф;
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ПоискПоРегиону = Элемент.ТекстРедактирования;
		ОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Регион", ТекСтрИдентиф, Регионы.ПолучитьЭлементы(), НайтиРегионПоКодуСубъекта(ВыбранноеЗначение), Ложь);
		Элементы.Регионы.ТекущаяСтрока = ТекСтрИдентиф;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиРегионПоКодуСубъекта(КодСубъектаРФ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	БизнесРегионы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	НЕ БизнесРегионы.ПометкаУдаления
	|	И БизнесРегионы.СмартКодСубъектаРФ = &КодСубъектаРФ");
	Запрос.УстановитьПараметр("КодСубъектаРФ", КодСубъектаРФ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	Иначе
		Возврат Справочники.БизнесРегионы.ПустаяСсылка();
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ВходящиеЗвонкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Перем ТекСтрИдентиф;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		Телефон = ТекущиеДанные.Телефон;
		ИдентификаторЗвонка = ТекущиеДанные.ИдентификаторЗвонка;
		ИдентификаторСобытия = ТекущиеДанные.ИдентификаторСобытия;
		ТелефонВходящий = "";
		ВходящиеЗвонки.Очистить();	
		
		ЗаполнитьПервичныеДанныеФормы();
		
		Если ЭтоНеНомерСотрудника(ОставитьТолькоЦиФрыВСтроке(Телефон)) Тогда
			
			СтруктураПоиска = ТелефонПриИзмененииНаСервере();
			
			Если СтруктураПоиска.Свойство("Регион") Тогда
				
				ОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Регион", ТекСтрИдентиф, 
					Регионы.ПолучитьЭлементы(), СтруктураПоиска.Регион, Ложь);
				Элементы.Регионы.ТекущаяСтрока = ТекСтрИдентиф;
				
			КонецЕсли;
			
			СоздатьТелефонныйЗвонок();
			
			Элементы.ДекорацияЗвонокСотрудника.Видимость = Ложь;
			Элементы.ДекорацияКонтакт.Видимость = Истина;
		Иначе
			
			Элементы.ДекорацияЗвонокСотрудника.Видимость = Истина;
			Элементы.ДекорацияКонтакт.Видимость = Ложь;
			
			Успех = смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(ИдентификаторСобытия);
			
		КонецЕсли;
		
		Элементы.ГруппаВходящийЗвонок.Видимость = Ложь;
		ОжиданиеЗвонка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ОжиданиеЗвонка Тогда
		
		Если ИмяСобытия = "ВходящийТелефонныйЗвонок" Тогда
			
			ВходящиеЗвонки.Очистить();
			
			Для Каждого Стр Из Параметр.НаборДанных Цикл
				
				Если Стр.Удалить Тогда
					
					Успех = смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(Стр.ИдентификаторСобытия);
					
				Иначе
					
					Если ЭтоНеНомерСотрудника(ОставитьТолькоЦиФрыВСтроке(Стр.Данные.Кто)) Тогда
						
						СтрВходящиеЗвонки = ВходящиеЗвонки.Добавить();
						СтрВходящиеЗвонки.Телефон = Стр.Данные.Кто;
						СтрВходящиеЗвонки.ИдентификаторЗвонка = Стр.Данные.uid;
						СтрВходящиеЗвонки.ИдентификаторСобытия = Стр.ИдентификаторСобытия;
						Если Стр.Данные.Свойство("КтоВзялТрубку") Тогда
							СтрВходящиеЗвонки.КтоВзялТрубку = Стр.Данные.КтоВзялТрубку;
						КонецЕсли;
						
					Иначе
						
						Успех = смартСобытияВзаимодействий.ОбработатьДанныеСобытияВзаимодействий(Стр.ИдентификаторСобытия);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			//Если ВходящиеЗвонки.Количество() > 0 Тогда
			//	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаТелефонныйЗвонок;
			//КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

