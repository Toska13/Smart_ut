&НаСервере
Процедура НазначитьЭПСотрудникуНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		//++ #Б-5936 смарт: Фролов 06.03.2026 //Ошибка. Доработать механизм перераспределения лидов.
		//ДатаКонтроля = ВернутьКонтрольныеДатуВремя(ВыбранныйСотрудник,ВыбраннаяКвалификация);
		ДатаКонтроля = смартОбщегоНазначения.ВернутьКонтрольныеДатуВремя(ВыбранныйСотрудник, ВыбраннаяКвалификация);
		//-- #Б-5936 смарт: Фролов 06.03.2026
		
		ОбЛид = Документы.смартЛид.СоздатьДокумент();
		ОбЛид.Ответственный = ВыбранныйСотрудник;
		ОбЛид.Распределил = ПараметрыСеанса.ТекущийПользователь;
		ОбЛид.СостояниеЛида = Перечисления.смартСостоянияЛидов.Распределен;
		ОбЛид.БизнесРегион = ВыбранныйРегион;
		ОбЛид.Квалификация = ВыбраннаяКвалификация;
		ОбЛид.Дата = ТекущаяДата();
		ОбЛид.БизнесРегионТекст = РегионОпределенный;
		ОбЛид.ДокументОснование = Письмо.Ссылка;
		ОбЛид.КонтактноеЛицо = АбонентИмя;
		ОбЛид.Имя = АбонентИмяСтр;
		ОбЛид.Партнер = АбонентКомпания;
		ОбЛид.Тема = ТемаПисьма;
		Если Письмо.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
			ОбЛид.ТекстИсточника = Письмо.ТекстHTML;
		Иначе	
			ОбЛид.ТекстИсточника = Письмо.Текст;
		КонецЕсли;	
		ОбЛид.ЭлектроннаяПочта =Письмо.ОтправительАдрес;
		ОбЛид.Записать(РежимЗаписиДокумента.Запись);
		
		ОбИнтерес=Документы.CRM_Интерес.СоздатьДокумент();
		ОбИнтерес.Дата=ТекущаяДата();
		ОбИнтерес.ДокументОснование = ОбЛид.Ссылка;
		ОбИнтерес.смартИнтересКанал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Входящее письмо");
		ОбИнтерес.смартИнтересИсточник = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоНаименованию("info@smart-t.ru");
		ОбИнтерес.ЦенаВключаетНДС = Истина;
		ОбИнтерес.Партнер = ОбЛид.Партнер;
		ОбИнтерес.РучнойВводДатыПродажи = Истина;
		ОбИнтерес.ТипУслуги = ВыбраннаяКвалификация.ТипУслуги;
		Если ОбИнтерес.ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти Тогда
			ОбИнтерес.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		Иначе	
			ОбИнтерес.Валюта = Константы.ВалютаУправленческогоУчета.Получить();
		КонецЕсли;
