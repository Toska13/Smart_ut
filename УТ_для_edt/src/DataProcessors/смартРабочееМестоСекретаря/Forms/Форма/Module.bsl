		Запрос.УстановитьПараметр("ВладелецФайла", Письмо.Ссылка);
		Результат = Запрос.Выполнить().Выбрать();
		Пока Результат.Следующий() Цикл
			НовыйФайл = Справочники.CRM_ИнтересПрисоединенныеФайлы.СоздатьЭлемент();
