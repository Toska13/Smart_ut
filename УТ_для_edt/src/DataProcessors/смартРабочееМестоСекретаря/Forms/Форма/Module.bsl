		СтрНаборЗаписей.ДатаВыдачи = ТекущаяДата();
		СтрНаборЗаписей.ДатаКонтроля = ДатаКонтроля;
		СтрНаборЗаписей.ДатаОбработки = Неопределено;
		СтрНаборЗаписей.ПервыйКонтакт = Неопределено;
		НаборЗаписей.Записать(Истина);
		
		смартСервер.УдалитьМенеджераИзОбщейОчереди(ВыбранныйСотрудник);
		
		смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(Перечисления.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес,
		"СозданНовыйИнтерес", ОбИнтерес.Ссылка);
		
		
		ЗафиксироватьТранзакцию();
		
		УстановитьЗначенияИВидимостьПоУмолчанию();
		
		ОтправитьПисьмоПоЛиду(ОбЛид.Тема, ВыбраннаяКвалификация, ОбЛид.Ссылка, 3);
		
	Исключение
		
		ОтменитьТранзакцию();
		ОбщегоНазначения.СообщитьПользователю("Не удалось создать документы");
		
	КонецПопытки;
	
	ЗаполнитьПервичныеДанныеФормы();

КонецПроцедуры

&НаКлиенте
Процедура НазначитьПРСотруднику(Команда)
	
	Если НЕ ЗначениеЗаполнено(Канал) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить Канал", , "Канал");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить Источник", , "Источник");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Потребность) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо заполнить Потребность", , "Потребность");
		Возврат;
	КонецЕсли;
	
	НазначитьПРСотрудникуНаСервере();
	
	Элементы.ПрикрепленныеФайлы.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьПисьмоПоЛиду(ТемаПисьма, Квалификация, Лид, Вариант)
	
	УстановитьПривилегированныйРежим(Истина);
	
	УчетнаяЗапись=РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
	АдресаДляОтправкиСтрокой = "";
	
	//++ #Б-6630 смарт: Фролов 28.05.2026 //Сделать механизм оповещений о новых Инцидентах.
	//++ #Б-3858 смарт: Фролов 18.07.2025 //Расширение настройки отправки оповещений о обработке Интересов.
	//МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомленийПоТипуПродукта(Квалификация, Лид.Ответственный, АдресаДляОтправкиСтрокой, "Новые");
	МассивАдресовДляОтправки = Новый Массив;
	
	МассивПользователей = смартОбщегоНазначения.ПолучитьПользователейПоНастройкамОбОповещениях("Интересы", Лид.Ответственный.Подразделение, Квалификация.ТипПродукта, "Новые");
	
	Если НЕ МассивПользователей = Неопределено Тогда
		
		Для Каждого Пользователь Из МассивПользователей Цикл
			
			МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
			
		КонецЦикла;
		
	КонецЕсли;
	//-- #Б-6630 смарт: Фролов 28.05.2026
	
	Если МассивАдресовДляОтправки.Количество() = 0 Тогда
		
		МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(Справочники.смартПредопределенныеЗначения.ПолучателиОтчетаПоРаспределениюЛидов,
			АдресаДляОтправкиСтрокой, Истина);
		
	КонецЕсли;	
	//-- #Б-3858 смарт: Фролов 21.07.2025
	МассивАдресовДляОтправкиПоКвалификации = смартОбщегоНазначения.ПолучитьАдресаПолучателейУведомленийПоКвалификации(Квалификация, АдресаДляОтправкиСтрокой);
	Для Каждого СтрМассивАдресовДляОтправкиПоКвалификации Из МассивАдресовДляОтправкиПоКвалификации Цикл
		МассивАдресовДляОтправки.Добавить(СтрМассивАдресовДляОтправкиПоКвалификации);	
	КонецЦикла;	
	
	ОбЛид = Лид.ПолучитьОбъект();
	НавСсылка=ПолучитьНавигационнуюСсылку(ОбЛид);
	Если ЗначениеЗаполнено(Лид.ДокументОснование) И ТипЗнч(Лид.ДокументОснование) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее") Тогда
		
		Если Лид.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
			ТекстСодержания = Взаимодействия.ПолучитьОбычныйТекстИзHTML(Лид.ТекстИсточника);
		Иначе	
			ТекстСодержания = Лид.ТекстИсточника;
		КонецЕсли;
		
	Иначе 
		
		ТекстСодержания = Лид.ТекстИсточника;
	
	КонецЕсли;
	
	ТекстПисьма = "";
	ТекстПисьма=ТекстПисьма+"Распределение: ручное" + Символы.ПС;
	Если Вариант = 1 Тогда
		ТекстПисьма=ТекстПисьма+"Канал: Телефонный звонок "+""+Символы.ПС+Символы.ПС;
	ИначеЕсли Вариант = 2 Тогда
		ТекстПисьма=ТекстПисьма+"Канал: Электронное письмо "+""+Символы.ПС+Символы.ПС;
	Иначе
		ТекстПисьма=ТекстПисьма+"Канал: Прочее "+""+Символы.ПС+Символы.ПС;
	КонецЕсли;
	ТекстПисьма=ТекстПисьма+"Ответственный " + Лид.Ответственный + ""+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"Квалификация " + Лид.Квалификация + ""+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"Регион " + Лид.БизнесРегион + ""+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"Распределен "+Строка(Лид)+Символы.ПС+"Навигационная ссылка на документ: "+НавСсылка+""+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"Телефон: "+Лид.Телефон+Символы.ПС+"Электронная почта: "+Лид.ЭлектроннаяПочта+Символы.ПС+"Регион: "+Лид.БизнесРегионТекст+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"================================================================================="+Символы.ПС+Символы.ПС;
	ТекстПисьма=ТекстПисьма+"Текст источника: "+ТекстСодержания+Символы.ПС;
	
	Вложения = Новый Массив;
	
	Для Каждого СтрПрикрепленныеФайлы Из ПрикрепленныеФайлы Цикл
		
		ДанныеВложения = Новый Структура();
		ДанныеВложения.Вставить("Представление", СтрПрикрепленныеФайлы.ИмяФайла + "." + СтрПрикрепленныеФайлы.Расширение);
		ДанныеВложения.Вставить("АдресВоВременномХранилище", СтрПрикрепленныеФайлы.АдресФайла);
		Вложения.Добавить(ДанныеВложения);
					
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
		И (ТестовыеАдресаМассив.Количество() > 0
		ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
		ДанныеОтправки = Новый Структура("Тема, Заголовок, Вложения", ТемаПисьма +" - "+ Лид.Тема+"", ТекстПисьма, Вложения);
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		Попытка
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
		Исключение
			ТекстСообщения = "Не удалось отправить письмо, по квалификации "+Квалификация+" по лиду "+Лид+ Символы.ПС + ОписаниеОшибки(); 
			ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, ТекстСообщения);
		КонецПопытки;
	КонецЕсли;
	ТекстПисьма = "";
	
	ОчиститьПрикрепленныеФайлы();
	
КонецПроцедуры

&НаСервере
Процедура КаналПриИзмененииНаСервере()
	
	НеБлокироватьВыдачу = Ложь;
	
	Если Канал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Маркетплейсы") Тогда
		ИсточникРодитель = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоКоду("00000000089");	
	ИначеЕсли Канал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Рекомендация сотрудника") Тогда
		ИсточникРодитель = Неопределено;
	ИначеЕсли Канал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Интернет магазин") Тогда
		ИсточникРодитель = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоКоду("00000000075");
	ИначеЕсли Канал = ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Выставка Реклама") Тогда
		ИсточникРодитель = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоКоду("00000000010"); 
		НеБлокироватьВыдачу = Истина;
	Иначе
		ИсточникРодитель = Справочники.смартИсточникиРекламногоВоздействия.НайтиПоКоду("00000000084");
	КонецЕсли;	
	
	Если ИсточникРодитель = Неопределено Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи");
		
	Иначе	
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.смартИсточникиРекламногоВоздействия 
		|ГДЕ
		|	Родитель = &Родитель");
		Запрос.УстановитьПараметр("Родитель", ИсточникРодитель);
		
	КонецЕсли;
	
	Элементы.Источник.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	ЗаполнитьПервичныеДанныеФормы(НеБлокироватьВыдачу);
	
КонецПроцедуры

&НаКлиенте
Процедура КаналПриИзменении(Элемент)
	КаналПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Функция ПоискПоКонтактнойИнформацииНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураВозврата = Новый Структура;
	Если ЗначениеЗаполнено(ЭтаФорма.ТелефонПр) ИЛИ ЗначениеЗаполнено(ЭтаФорма.ПочтаПр) Тогда
		
		МасПартнеров=Новый СписокЗначений;
		МасКонтактов=Новый СписокЗначений;
		
		//Пытаемся по конактным данным найти Партнерра и Контактное лицо
		Если ЗначениеЗаполнено(ЭтаФорма.ТелефонПр) Тогда
			ТелефонДляПоиска=ОставитьТолькоЦиФрыВСтроке(ЭтаФорма.ТелефонПр); 
			
			СтруктураПроверки = Новый Структура();
			СтруктураПроверки.Вставить("Телефон",ТелефонДляПоиска);
			СтруктураПроверки.Вставить("ДатаЛида",ТекущаяДата());
			
			СтруктураТелефона = сфпСофтФонПроСервер.сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(ТелефонДляПоиска);
			Клиент_Телефон = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(СтруктураТелефона.КодСтраны, СтруктураТелефона.КодГорода, СтруктураТелефона.НомерТелефона, СтруктураТелефона.Добавочный, "");
			лКэшПоиска = CRM_ПоискКонтактов.СтруктураДанныхКэша();
			лКэшЗаполнения = CRM_ПоискКонтактов.СтруктураДанныхКэша();
			лУсловияПоиска = Новый Массив;
			лСтрокаПоискаНормализованная = CRM_ПоискКонтактов.НормализоватьСтрокуПоискаИДополнитьКэш(Клиент_Телефон, лКэшПоиска, лКэшЗаполнения);
			лРезультатПоиска = CRM_ПоискКонтактов.ВыполнитьПоискКонтактов(лСтрокаПоискаНормализованная, 2, Истина,Истина);
			Для Каждого СтрлРезультатПоиска Из лРезультатПоиска.Элементы Цикл
				Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.Партнеры") И МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено ТОгда
					МасПартнеров.Добавить(СтрлРезультатПоиска,""+СтрлРезультатПоиска + " - "+СтрлРезультатПоиска.Код+"");
				КонецЕсли;
				Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.КонтактныеЛицаПартнеров") И МасКонтактов.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено ТОгда
					МасКонтактов.Добавить(СтрлРезультатПоиска,СтрлРезультатПоиска);
					Если МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска.Владелец)=Неопределено ТОгда
						МасПартнеров.Добавить(СтрлРезультатПоиска.Владелец,""+СтрлРезультатПоиска.Владелец + " - "+СтрлРезультатПоиска.Владелец.Код+"");
					КонецЕсли;
				КонецЕсли;	
			КонецЦикла;
			//Ищем Бизнес-регион по телефону с помощью DaData пока что текстовое значение
			РегионОпределенный=ОбработатьТелефонНаСервере(ТелефонДляПоиска);
			РегионСсылка=НайтиРегион(РегионОпределенный);
			Если ЗначениеЗаполнено(РегионСсылка) И НЕ ЗначениеЗаполнено(РегионСсылка.смартОтветственоеПодразделение) ТОгда
				Регион=РегионСсылка;
				//Регион=НайтиРегионВерхнегоУровня(РегионСсылка);
				СтруктураВозврата.Вставить("Регион", Регион);
			ИначеЕсли ЗначениеЗаполнено(РегионСсылка) И ЗначениеЗаполнено(РегионСсылка.смартОтветственоеПодразделение) ТОгда	
				Регион=РегионСсылка;
				СтруктураВозврата.Вставить("Регион", Регион);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтаФорма.ПочтаПр) Тогда
			лРезультатПоиска = CRM_ПоискКонтактов.ВыполнитьПоискКонтактов(ЭтаФорма.ПочтаПр, 2, Истина,Истина);
			Для Каждого СтрлРезультатПоиска Из лРезультатПоиска.Элементы Цикл
				Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.Партнеры") И МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено И НЕ СтрлРезультатПоиска.ПометкаУдаления ТОгда
					МасПартнеров.Добавить(СтрлРезультатПоиска,""+СтрлРезультатПоиска + " - "+СтрлРезультатПоиска.Код+"");
				КонецЕсли;
				Если ТипЗнч(СтрлРезультатПоиска)=Тип("СправочникСсылка.КонтактныеЛицаПартнеров") И МасКонтактов.НайтиПоЗначению(СтрлРезультатПоиска)=Неопределено И НЕ СтрлРезультатПоиска.ПометкаУдаления ТОгда
					МасКонтактов.Добавить(СтрлРезультатПоиска,СтрлРезультатПоиска);
					Если МасПартнеров.НайтиПоЗначению(СтрлРезультатПоиска.Владелец)=Неопределено ТОгда
						МасПартнеров.Добавить(СтрлРезультатПоиска.Владелец,""+СтрлРезультатПоиска.Владелец + " - "+СтрлРезультатПоиска.Владелец.Код+"");
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
		
		РезультатыПоискаПоКИ="Контактная информация найдена у: ";
		Если МасПартнеров.Количество()=1 ТОгда
			АбонентКомпания=МасПартнеров[0].Значение;
		ИначеЕсли МасПартнеров.Количество()>1 ТОгда	
			Для Каждого СтрМасПартнеров Из МасПартнеров Цикл
				РезультатыПоискаПоКИ=РезультатыПоискаПоКИ+Символы.ПС+" - "+СтрМасПартнеров.Представление;	
			КонецЦикла;
		КонецЕсли;
		Если МасКонтактов.Количество()=1 ТОгда
			АбонентИмя = МасКонтактов[0].Значение;
			АбонентИмяСтр = МасКонтактов[0].Значение.Наименование;
		ИначеЕсли МасКонтактов.Количество()>1 ТОгда	
			Для Каждого СтрМасКонтактов Из МасКонтактов Цикл
				РезультатыПоискаПоКИ=РезультатыПоискаПоКИ+Символы.ПС+" - "+СтрМасКонтактов.Представление;	
			КонецЦикла;
		КонецЕсли;
		Если НЕ РезультатыПоискаПоКИ="Контактная информация найдена у: " Тогда
			Элементы.ДекорацияКонтакт.Заголовок = РезультатыПоискаПоКИ;
			Элементы.ГруппаАбонентСтрПр.Видимость = Истина;
			Элементы.ГруппаАбонентПр.Видимость = Ложь;
			Элементы.ОсновныеМенеджерыПр.Видимость = Ложь;
		ИначеЕсли МасПартнеров.Количество() = 0 И МасКонтактов.Количество() = 0 Тогда
			Элементы.ДекорацияКонтакт.Заголовок = "Телефон в базе не найден!";
			Элементы.ГруппаАбонентСтрПр.Видимость = Истина;
			Элементы.ГруппаАбонентПр.Видимость = Ложь;
			Элементы.ОсновныеМенеджерыПр.Видимость = Ложь;
		Иначе	
			Элементы.ДекорацияКонтакт.Заголовок = "";
			Элементы.ГруппаАбонентСтрПр.Видимость = Ложь;
			Элементы.ГруппаАбонентПр.Видимость = Истина;
			Элементы.ОсновныеМенеджерыПр.Видимость = Истина;
			ЗаполнитьМенеджеровАбонента();
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ПоискПоКонтактным(Команда)
	
	Перем ТекСтрИдентиф;
	
	СтруктураПоиска = ПоискПоКонтактнойИнформацииНаСервере();
	
	Если СтруктураПоиска.Свойство("Регион") Тогда
		
		ОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Регион", ТекСтрИдентиф, Регионы.ПолучитьЭлементы(), СтруктураПоиска.Регион, Ложь);
		Элементы.Регионы.ТекущаяСтрока = ТекСтрИдентиф;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеМенеджерыПрПриАктивизацииСтроки(Элемент)
	
	Если Элементы.ОсновныеМенеджерыПр.ТекущиеДанные <> Неопределено Тогда
		ЭтаФорма.ВыбранныйСотрудник = Элементы.ОсновныеМенеджерыПр.ТекущиеДанные.Менеджер;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТелефоныМенеджеров(Менеджер)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПользователиКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	ПользователиКонтактнаяИнформация.Представление КАК Представление
	|ПОМЕСТИТЬ ЛичныйТелефон
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|ГДЕ
	|	ПользователиКонтактнаяИнформация.Вид = &ВидЛичныйТелефон
	|	И ПользователиКонтактнаяИнформация.Ссылка = &Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПользователиКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	ПользователиКонтактнаяИнформация.Представление КАК Представление
	|ПОМЕСТИТЬ РабочийТелефон
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|ГДЕ
	|	ПользователиКонтактнаяИнформация.Вид = &ВидМобильныйТелефон
	|	И ПользователиКонтактнаяИнформация.Ссылка = &Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка,
	|	ЛичныйТелефон.Представление КАК ЛичныйТелефон,
	|	Пользователи.смартРабочийТелефон КАК ВнутреннийТелефон,
	|	РабочийТелефон.Представление КАК МобильныйТелефон
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЛичныйТелефон КАК ЛичныйТелефон
	|		ПО Пользователи.Ссылка = ЛичныйТелефон.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РабочийТелефон КАК РабочийТелефон
	|		ПО Пользователи.Ссылка = РабочийТелефон.Ссылка
	|ГДЕ
	|	Пользователи.Ссылка = &Менеджер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование");
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("ВидЛичныйТелефон", Справочники.ВидыКонтактнойИнформации.НайтиПоРеквизиту("ИдентификаторДляФормул", "ЛичныйТелефон"));
	Запрос.УстановитьПараметр("ВидМобильныйТелефон", Справочники.ВидыКонтактнойИнформации.CRM_МобильныйТелефонПользователя);
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаРезультата.Количество() > 0 Тогда
		Возврат Новый Структура("ЛичныйТелефон, МобильныйТелефон, ВнутреннийТелефон", ТаблицаРезультата[0].ЛичныйТелефон, ТаблицаРезультата[0].МобильныйТелефон, ТаблицаРезультата[0].ВнутреннийТелефон);	
	Иначе
		Возврат Новый Структура("ЛичныйТелефон, МобильныйТелефон, ВнутреннийТелефон", "", "", "");
	КонецЕсли;	
	
КонецФункции	

