
&НаСервере
Процедура ПеревестиЗвонокНаСервере()

	УстановитьЗначенияИВидимостьПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеревестиЗвонок(Команда)
	
	ПеревестиЗвонокНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//++ #Б-6048 смарт: Фролов 12.03.2026 //Ошибка. Доработка рабочего места секретаря.
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Пользователь КАК Пользователь,
	|	ДатаОтсрочкиПоОтпуску КАК ДатаОтсрочкиПоОтпуску
	|ИЗ
	|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних
	|ГДЕ
	|	Статус = ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.ВОтпуске)
	|	И До < &ТекущаяДата");
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаписьРегистра = РегистрыСведений.смартИсторияСтатусовСотрудников.СоздатьМенеджерЗаписи();
		ЗаписьРегистра.Период = ТекущаяДата();
		ЗаписьРегистра.Пользователь = Выборка.Пользователь;
		ЗаписьРегистра.Статус = Справочники.смартСтатусыСотрудников.НаРабочемМесте;
		ЗаписьРегистра.ДатаОтсрочкиПоОтпуску = Выборка.ДатаОтсрочкиПоОтпуску;
		ЗаписьРегистра.Записать();
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	//-- #Б-6048 смарт: Фролов 12.03.2026
	
	ЗаполнитьПервичныеДанныеФормы();
	
	УстановитьЗначенияИВидимостьПоУмолчанию();
	
	Элементы.Канал.СписокВыбора.Добавить(ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Маркетплейсы"));
	Элементы.Канал.СписокВыбора.Добавить(ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Социальные сети"));
	Элементы.Канал.СписокВыбора.Добавить(ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Рекомендация сотрудника"));
	Элементы.Канал.СписокВыбора.Добавить(ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Интернет магазин"));
	Элементы.Канал.СписокВыбора.Добавить(ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию("Выставка Реклама"));
	
	ИсторияРаспределения.Параметры.УстановитьЗначениеПараметра("Распределил", ПараметрыСеанса.ТекущийПользователь);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПервичныеДанныеФормы(НеБлокироватьВыдачу = Ложь)
	УстановитьПривилегированныйРежим(Истина);
	
	КвалификацияНепределено = Справочники.смартКвалификацииМенеджеров.НайтиПоНаименованию("Неопределено");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартКвалификацииМенеджеровПользователи.Ссылка КАК Квалификация,
	|	смартКвалификацииМенеджеровПользователи.Пользователь КАК Менеджер
	|ПОМЕСТИТЬ МенеджерыКвалификаций
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи КАК смартКвалификацииМенеджеровПользователи
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &НеБлокироватьВыдачу
	|				ТОГДА НЕ смартКвалификацииМенеджеровПользователи.Ссылка = &КвалификацияНепределено
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	//++ #Б-4442 смарт: Фролов 30.09.2025 //Доработка механизма Квалификаций менеджеров.
	|	И НЕ смартКвалификацииМенеджеровПользователи.Ссылка.НеАктуальна
	//-- #Б-4442 смарт: Фролов 30.09.2025
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартИсторияРаботыСЛидом.Менеджер КАК Менеджер,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ смартИсторияРаботыСЛидом.Лид) КАК Лид
	|ПОМЕСТИТЬ МенеджерыНЕДляВыдачи
	|ИЗ
	|	РегистрСведений.смартИсторияРаботыСЛидом КАК смартИсторияРаботыСЛидом
	|ГДЕ
	|	смартИсторияРаботыСЛидом.ДатаВыдачи МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|СГРУППИРОВАТЬ ПО
	|	смартИсторияРаботыСЛидом.Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартВыдачаЛидов.Менеджер КАК Менеджер,
	|	смартВыдачаЛидов.Квалификация КАК Квалификация,
	|	смартВыдачаЛидов.ВыдатьЛидов КАК ВыдатьЛидов,
	|	смартВыдачаЛидов.ВыданоЛидов КАК ВыданоЛидов
	|ПОМЕСТИТЬ ВыдачаЛидов
	|ИЗ
	|	РегистрСведений.смартВыдачаЛидов КАК смартВыдачаЛидов
	|ГДЕ
	|	НЕ смартВыдачаЛидов.Менеджер.Недействителен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартОбщаяОчередьВыдачиЛидов.Менеджер КАК Менеджер
	|ПОМЕСТИТЬ ОбщаяОчередь
	|ИЗ
	|	РегистрСведений.смартОбщаяОчередьВыдачиЛидов КАК смартОбщаяОчередьВыдачиЛидов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	БизнесРегионы.Ссылка КАК Регион
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	НЕ БизнесРегионы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Регион ИЕРАРХИЯ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПользователиКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	ПользователиКонтактнаяИнформация.Представление КАК Представление
	|ПОМЕСТИТЬ МобильныеТелефоны
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
	|ГДЕ
	|	ПользователиКонтактнаяИнформация.Вид = &МобильныйТелефон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МенеджерыКвалификаций.Квалификация КАК Квалификация,
	|	МенеджерыКвалификаций.Менеджер КАК Менеджер,
	|	МенеджерыКвалификаций.Менеджер.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.Статус, ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте)) = ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте)
	|				И ЧАС(ДОБАВИТЬКДАТЕ(&ТекущаяДата, СЕКУНДА, (МенеджерыКвалификаций.Менеджер.Подразделение.CRM_Офис.CRM_ВремяПоГринвичу_GMT - 3) * 3600)) > 18
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НеРабочееВремя)
	|		ИНАЧЕ ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.Статус, ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте))
	|	КОНЕЦ КАК Статус,
	|	ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.До, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗанятДо,
	|	ВыдачаЛидов.ВыдатьЛидов КАК ВыдатьЛидов,
	|	ВыдачаЛидов.ВыданоЛидов КАК ВыданоЛидов,
	|	МенеджерыКвалификаций.Менеджер.смартРабочийТелефон КАК ВнТелефон,
	|	ВЫБОР
	|		КОГДА &НеБлокироватьВыдачу
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА МенеджерыКвалификаций.Квалификация.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаТоварыУслуги)
	|					ТОГДА ВЫБОР
	|							КОГДА ВыдачаЛидов.ВыданоЛидов >= ВыдачаЛидов.ВыдатьЛидов
	|								ТОГДА ИСТИНА
	|							ИНАЧЕ ЛОЖЬ
	|						КОНЕЦ
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|	КОНЕЦ КАК БлокироватьВыдачу,
	|	МенеджерыКвалификаций.Менеджер.смартВнутреннийНомерВАТС КАК ВАТС,
	|	ЧАС(ДОБАВИТЬКДАТЕ(&ТекущаяДата, СЕКУНДА, (МенеджерыКвалификаций.Менеджер.Подразделение.CRM_Офис.CRM_ВремяПоГринвичу_GMT - 3) * 3600)) КАК ВРЕМЯЧАС,
	|	МобильныеТелефоны.Представление КАК МобильныйТелефон
	|ИЗ
	|	МенеджерыКвалификаций КАК МенеджерыКвалификаций
	//++ #Б-7054 смарт: Фролов 01.06.2026 //Отпуска сотрудников на текущую дату
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних) КАК смартИсторияСтатусовСотрудниковСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(&ТекущаяДата, ) КАК смартИсторияСтатусовСотрудниковСрезПоследних
	//-- #Б-7054 смарт: Фролов 01.06.2026
	|		ПО МенеджерыКвалификаций.Менеджер = смартИсторияСтатусовСотрудниковСрезПоследних.Пользователь
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВыдачаЛидов КАК ВыдачаЛидов
	|		ПО МенеджерыКвалификаций.Менеджер = ВыдачаЛидов.Менеджер
	|			И МенеджерыКвалификаций.Квалификация = ВыдачаЛидов.Квалификация
	|		ЛЕВОЕ СОЕДИНЕНИЕ МобильныеТелефоны КАК МобильныеТелефоны
	|		ПО МенеджерыКвалификаций.Менеджер = МобильныеТелефоны.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗанятДо,
	|	ВыданоЛидов,
	|	ВыдатьЛидов УБЫВ,
	|	Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МенеджерыКвалификаций.Квалификация КАК Квалификация
	|ИЗ
	|	МенеджерыКвалификаций КАК МенеджерыКвалификаций
	|
	|УПОРЯДОЧИТЬ ПО
	|	МенеджерыКвалификаций.Квалификация.Сортировка,
	|	МенеджерыКвалификаций.Квалификация.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МенеджерыКвалификаций.Менеджер КАК Менеджер,
	|	МенеджерыКвалификаций.Менеджер.Подразделение КАК Подразделение,
	|	ЛОЖЬ КАК БлокироватьВыдачу,
	|	МенеджерыКвалификаций.Менеджер.Наименование КАК МенеджерНаименование
	|ИЗ
	|	МенеджерыКвалификаций КАК МенеджерыКвалификаций
	|
	|УПОРЯДОЧИТЬ ПО
	|	МенеджерНаименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартПредопределенныеЗначенияМенеджерыТехЦентра.Менеджер КАК Менеджер,
	|	смартПредопределенныеЗначенияМенеджерыТехЦентра.Менеджер.Наименование КАК МенеджерНаименование
	|ПОМЕСТИТЬ МенеджерыТехЦентра
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.МенеджерыТехЦентра КАК смартПредопределенныеЗначенияМенеджерыТехЦентра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МенеджерыТехЦентра.Менеджер КАК Менеджер,
	|	МенеджерыТехЦентра.Менеджер.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.Статус, ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте)) = ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте)
	|				И ЧАС(ДОБАВИТЬКДАТЕ(&ТекущаяДата, СЕКУНДА, (МенеджерыТехЦентра.Менеджер.Подразделение.CRM_Офис.CRM_ВремяПоГринвичу_GMT - 3) * 3600)) > 18
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НеРабочееВремя)
	|		ИНАЧЕ ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.Статус, ЗНАЧЕНИЕ(Справочник.смартСтатусыСотрудников.НаРабочемМесте))
	|	КОНЕЦ КАК Статус,
	|	ЕСТЬNULL(смартИсторияСтатусовСотрудниковСрезПоследних.До, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗанятДо,
	|	МенеджерыТехЦентра.Менеджер.смартРабочийТелефон КАК ВнТелефон,
	|	МенеджерыТехЦентра.Менеджер.смартВнутреннийНомерВАТС КАК ВАТС,
	|	ЧАС(ДОБАВИТЬКДАТЕ(&ТекущаяДата, СЕКУНДА, (МенеджерыТехЦентра.Менеджер.Подразделение.CRM_Офис.CRM_ВремяПоГринвичу_GMT - 3) * 3600)) КАК ВРЕМЯЧАС,
	|	МобильныеТелефоны.Представление КАК МобильныйТелефон
	|ИЗ
	|	МенеджерыТехЦентра КАК МенеджерыТехЦентра
	//++ #Б-7054 смарт: Фролов 01.06.2026 //Отпуска сотрудников на текущую дату
	//|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних КАК смартИсторияСтатусовСотрудниковСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(&ТекущаяДата, ) КАК смартИсторияСтатусовСотрудниковСрезПоследних
	//-- #Б-7054 смарт: Фролов 01.06.2026
	|		ПО МенеджерыТехЦентра.Менеджер = смартИсторияСтатусовСотрудниковСрезПоследних.Пользователь
	|		ЛЕВОЕ СОЕДИНЕНИЕ МобильныеТелефоны КАК МобильныеТелефоны
	|		ПО МенеджерыТехЦентра.Менеджер = МобильныеТелефоны.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗанятДо,
	|	Подразделение,
	|	МенеджерыТехЦентра.МенеджерНаименование");
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Запрос.УстановитьПараметр("НеБлокироватьВыдачу", НеБлокироватьВыдачу);
	Запрос.УстановитьПараметр("КвалификацияНепределено", КвалификацияНепределено); 
	Запрос.УстановитьПараметр("МобильныйТелефон", Справочники.ВидыКонтактнойИнформации.CRM_МобильныйТелефонПользователя);
	
	МасРезультатов = Запрос.ВыполнитьПакет();
	
	ДеревоРегионов = МасРезультатов[4].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЭтаФорма.Менеджеры.Загрузить(МасРезультатов[6].Выгрузить());
	ЭтаФорма.Квалификации.ЗагрузитьЗначения(МасРезультатов[7].Выгрузить().ВыгрузитьКолонку("Квалификация"));
	МенеджерыНеопределено = МасРезультатов[8].Выгрузить();
	ЭтаФорма.МенеджерыТЦ.Загрузить(МасРезультатов[10].Выгрузить());
	
	Если НеБлокироватьВыдачу Тогда
		
		ЭтаФорма.Квалификации.Добавить(КвалификацияНепределено);
		
		Для Каждого СтрМенеджерыНеопределено Из МенеджерыНеопределено Цикл
			
			СтрМенеджеры = ЭтаФорма.Менеджеры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрМенеджеры, СтрМенеджерыНеопределено);
			СтрМенеджеры.Квалификация = КвалификацияНепределено;
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	КоллекцияЭлементовДерева = ЭтаФорма.Регионы.ПолучитьЭлементы();
	КоллекцияЭлементовДерева.Очистить();
	
	ОбщегоНазначения.ЗаполнитьКоллекциюЭлементовДереваДанныхФормы(КоллекцияЭлементовДерева, ДеревоРегионов); 
	
	//++ #Б-7790 смарт: Фролов 06.08.2026 //Добавить Источник в рабочее место секретаря
	ЭтаФорма.Источник = Неопределено; 
