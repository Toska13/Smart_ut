&НаСервере
Процедура ОбновитьКартинкуДополнительныхОпцийНаФорме()
	
	Если Элементы.ДополнительныеОпции.ТекущаяСтрока = Неопределено Тогда
		АдресКартинкиДополнительныеОпции = "";
		Элементы.ДополнительныеОпцииОписание.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	Данные = ДополнительныеОпции.НайтиПоИдентификатору(Элементы.ДополнительныеОпции.ТекущаяСтрока);
	Если ТипЗнч(Данные.Номенклатура) = Тип("Строка") Тогда
		АдресКартинкиДополнительныеОпции = "";
		Элементы.ДополнительныеОпцииОписание.Заголовок = "";
		Возврат
	ИначеЕсли ТипЗнч(Данные.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если НЕ Элементы.ДополнительныеОпцииОписание.Заголовок = Данные.Номенклатура.Описание Тогда
			Элементы.ДополнительныеОпцииОписание.Заголовок = Данные.Номенклатура.Описание;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные.Номенклатура) = Тип("СправочникСсылка.смартКонструкторОборудования") Тогда
		Если НЕ Элементы.ДополнительныеОпцииОписание.Заголовок = Данные.Номенклатура.Описание Тогда
			Элементы.ДополнительныеОпцииОписание.Заголовок = Данные.Номенклатура.Описание;
		КонецЕсли;
	КонецЕсли;
	
	Если Данные.Номенклатура.ФайлКартинки.Пустая() Тогда
		АдресКартинкиДополнительныеОпции = "";
	Иначе
		
		УстановитьПривилегированныйРежим(Истина);
		Попытка
			АдресКартинкиДополнительныеОпции = РаботаСФайлами.ДанныеФайла(Данные.Номенклатура.ФайлКартинки, УникальныйИдентификатор).СсылкаНаДвоичныеДанныеФайла;
		Исключение
			АдресКартинкиДополнительныеОпции = "";
		КонецПопытки;
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

