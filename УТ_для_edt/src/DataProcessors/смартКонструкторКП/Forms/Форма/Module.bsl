#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидимостьДоступность();
	КПМенеджер = Пользователи.АвторизованныйПользователь();
	Валюта = Справочники.смартПредопределенныеЗначения.Настройки.ВидЦеныРозничнаяUSD.ВалютаЦены;
	ДатаКП = ТекущаяДатаСеанса();
	
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры 

&НаКлиенте
//++ #Б-3142 смарт: Фролов 21.04.2025 //Вывод SMART Конструктора в внешнюю обработку.
Процедура ПриОткрытии(Отказ)
	
	Если смартПользователи.РольДоступнаПользователю("смартИспользованиеSMARTКонструктор") 
		ИЛИ смартПользователи.РольДоступнаПользователю("ПолныеПрава") Тогда
		
		ВнешняяФорма = смартОбщегоНазначения.ПолучитьссылкуНаВнешнююОбработку("смартКонструкторКП");
		Если ЗначениеЗаполнено(ВнешняяФорма) Тогда
			
			ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВнешняяФорма);
			ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма");
			
			ЭтаФорма.Закрыть();
			
		КонецЕсли; 
		
	Иначе
		
		ЭтаФорма.Закрыть();
	
	КонецЕсли;

КонецПроцедуры //-- #Б-3142 смарт: Фролов 21.04.2025

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПриИзмененииОтбораНаФорме(Элемент)
	
	УстановитьВидимостьДоступность();
	
	Если Элемент.Имя = "БрендОтбор" Тогда
		Если БрендОтбор = ПолучитьБрендСпринтер() Тогда
			ОбновитьКонфигураторСпринтер();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДоступногоОборудованияПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("СформироватьПодвалКлиент", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииНаСсылкуПолезнойИнформации(Элемент)
	
	Если ЗначениеЗаполнено(Элемент.Подсказка) Тогда
		ЗапуститьПриложение(Элемент.Подсказка);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДоступногоОборудованияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.СписокДоступногоОборудования.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ВыбранноеОборудование = Элементы.СписокДоступногоОборудования.ТекущаяСтрока Тогда
		
		ОчиститьКП();
		ВыборДоступногоОборудованияСервер();
		УстановитьВидимостьДоступность();
		
	КонецЕсли;
	
	ОбновитьКартинкуПечатающейГоловкиНаФорме();
	
	ОбновитьСопутствующиеТоварыИДополнительныеОпции();
	
	РассчитатьИтоговоеКП();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКонфигурацииСпринтер(Элемент)
	
	Если НЕ ЗначениеЗаполнено(БрендОтбор) Тогда
		БрендОтбор = ПолучитьБрендСпринтер();
	КонецЕсли;
	
	Если Элемент.Имя = "СпринтерФорматыПринтеровВыбрано" Тогда
		
		ТекущаяСтрока = Элементы.СпринтерФорматыПринтеров.ТекущаяСтрока;
		Таблица = СпринтерФорматыПринтеров;
		
	ИначеЕсли Элемент.Имя = "СпринтерПечатающиеГоловкиВыбрано" Тогда
		
		ТекущаяСтрока = Элементы.СпринтерПечатающиеГоловки.ТекущаяСтрока;
		Таблица = СпринтерПечатающиеГоловки;
		
	ИначеЕсли Элемент.Имя = "СпринтерОсновныеКонфигурацииВыбрано" Тогда
		
		ТекущаяСтрока = Элементы.СпринтерОсновныеКонфигурации.ТекущаяСтрока;
		Таблица = СпринтерОсновныеКонфигурации;
		ВыбранноеОборудование = Элементы.СпринтерОсновныеКонфигурации.ТекущиеДанные.ОсновнаяКонфигурация;
		ОбновитьСопутствующиеТоварыИДополнительныеОпции();
		ОбновитьКартинкуПечатающейГоловкиНаФорме();
		
	ИначеЕсли Элемент.Имя = "СпринтерЦветовыеКонфигурацииВыбрано" Тогда
		
		ТекущаяСтрока = Элементы.СпринтерЦветовыеКонфигурации.ТекущаяСтрока;
		Таблица = СпринтерЦветовыеКонфигурации;
		
	Иначе
		Таблица = Неопределено;
	КонецЕсли;
	
	Если НЕ Таблица = Неопределено Тогда
		
		Для каждого стрТаблица Из Таблица Цикл
			
			Если стрТаблица.ПолучитьИдентификатор() <> ТекущаяСтрока Тогда
				стрТаблица.Выбрано = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьКонфигураторСпринтер();
	
	РассчитатьИтоговоеКП();
	
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеОпцииПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбновитьКартинкуДополнительныхОпцийНаФормеКлиент", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СопутствующиеТоварыПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбновитьКартинкуСопутствующихТоваровНаФормеКлиент", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура КПКлиентПриИзменении(Элемент)
	ПриИзмененииКПКлиентСервер();
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеОпцииВыбраноПриИзменении(Элемент)
	
	РассчитатьИтоговоеКП();
	
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры

&НаКлиенте
Процедура СопутствующиеТоварыВыбраноПриИзменении(Элемент)
	
	РассчитатьИтоговоеКП();
	
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютаПриИзменении(Элемент)
	
