КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписокДоступногоОборудования(Команда)
	
	Элементы.СписокДоступногоОборудования.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКонфигураторСпринтер 
		И Элементы.СтраницаДополнительныеОпции.Доступность Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДополнительныеОпции;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДополнительныеОпции 
		И Элементы.СтраницаСопутствующиеТовары.Доступность Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСопутствующиеТовары;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСопутствующиеТовары Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКПКлиента;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьКП(Команда)
	
	СформироватьКППоТекущимДанным();
	Элементы.СписокКП.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьДоступность()
	
	
    ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"ВидОборудования",
																			ВидОборудованияОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ВидОборудованияОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"Бренд",
																			БрендОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(БрендОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"ФорматПринтера",
																			ФорматПринтераОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ФорматПринтераОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"ТехнологияПечати",
																			ТехнологияПечатиОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ТехнологияПечатиОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"ШиринаПечати",
																			ШиринаПечатиОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ШиринаПечатиОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"Оборудование.Материалы.Материал",
																			ВидМатериалаОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ВидМатериалаОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДоступногоОборудования,
																			"Оборудование.Применения.Применяется",
																			ПроизводимаяПродукцияОтбор,
																			ВидСравненияКомпоновкиДанных.Равно,
																			,
																			ЗначениеЗаполнено(ПроизводимаяПродукцияОтбор),
																			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
																			
	Элементы.СтраницаКонфигураторСпринтер.Видимость = (ВыбранноеОборудование.Бренд = Справочники.смартПредопределенныеЗначения.Настройки.БрендСпринтер)
													ИЛИ (НЕ ЗначениеЗаполнено(ВыбранноеОборудование) И БрендОтбор = Справочники.смартПредопределенныеЗначения.Настройки.БрендСпринтер);
													
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокКП, "Клиент", КППартнер, ВидСравненияКомпоновкиДанных.Равно,, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПодвалКлиент() Экспорт
	
	СформироватьПодвал();
	
КонецПроцедуры
	
&НаСервере
Процедура СформироватьПодвал()
	
	Если Элементы.СписокДоступногоОборудования.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееОборудование = Элементы.СписокДоступногоОборудования.ТекущаяСтрока;
	Если ТекущаяСтрокаСписка = ТекущееОборудование Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеОписание = СтрШаблон("%1%2Страница на сайте: %3", ТекущееОборудование.Описание, Символы.ПС, ТекущееОборудование.СтраницаНаСайте);
	
	МассивОчищаемыхГрупп = Новый Массив;
	МассивОчищаемыхГрупп.Добавить(Элементы.ГруппаПолезнаяИнформацияЛеваяКолонка);
	МассивОчищаемыхГрупп.Добавить(Элементы.ГруппаПолезнаяИнформацияСредняяКолонка);
	МассивОчищаемыхГрупп.Добавить(Элементы.ГруппаОстаткиДемозалыЛеваяКолонка);
	МассивОчищаемыхГрупп.Добавить(Элементы.ГруппаОстаткиДемозалыПраваяКолонка);
	
	Для каждого ОчищаемаяГруппа Из МассивОчищаемыхГрупп Цикл
		
		КоличествоЭлементов = ОчищаемаяГруппа.ПодчиненныеЭлементы.Количество();
		Для н = 1 По КоличествоЭлементов Цикл
			
			Элемент = ОчищаемаяГруппа.ПодчиненныеЭлементы.Получить(0);
			Элементы.Удалить(Элемент);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Середина = Окр(ТекущееОборудование.ПолезныеМатериалы.Количество() / 2);
	Счетчик = 0;
	Для каждого стрПолезныеМатериалы Из ТекущееОборудование.ПолезныеМатериалы Цикл
		
		Счетчик = Счетчик + 1;
		ИмяЭлемента = СтрШаблон("МатериалСсылка%1", Формат(Счетчик, "ЧГ="));
		ИмяГруппы = СтрШаблон("ГруппаСсылка%1", Формат(Счетчик, "ЧГ="));
		Колонка = ?(Счетчик <= Середина, Элементы.ГруппаПолезнаяИнформацияЛеваяКолонка, Элементы.ГруппаПолезнаяИнформацияСредняяКолонка);
		
		Группа = Элементы.Добавить(ИмяГруппы, Тип("ГруппаФормы"), Колонка);
		Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		Группа.ОтображатьЗаголовок = Ложь;
		Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		
		Элемент = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = стрПолезныеМатериалы.ВидМатериала;
		
		Элемент = Элементы.Добавить(ИмяЭлемента+"С", Тип("ДекорацияФормы"), Группа);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = стрПолезныеМатериалы.Заголовок;
		Элемент.Гиперссылка = Истина;
		Элемент.Подсказка = стрПолезныеМатериалы.АдресСсылки;
		Элемент.УстановитьДействие("Нажатие", "ПриНажатииНаСсылкуПолезнойИнформации");
		
	КонецЦикла;
	
	ОстаткиВДемоЗалах = ПолучитьОстаткиОборудованияВДемоЗалах(ТекущееОборудование);
	Если ОстаткиВДемоЗалах.Количество() = 0 Тогда
		Элементы.НадписьНаличиеВДемоЗалах.Заголовок = "Нет в демозалах !";
		Элементы.НадписьНаличиеВДемоЗалах.ЦветТекста = WebЦвета.ТемноКрасный;
	Иначе
		Элементы.НадписьНаличиеВДемоЗалах.Заголовок = "Есть в демозале !";
		Элементы.НадписьНаличиеВДемоЗалах.ЦветТекста = WebЦвета.ТемноЗеленый;
	КонецЕсли;
	
	Счетчик = 0;
	Для каждого стрОстатокНаСкладе Из ОстаткиВДемоЗалах Цикл
		
		Счетчик = Счетчик + 1;
		
		ИмяЭлемента = СтрШаблон("ДемозалОстаток%1", Формат(Счетчик, "ЧГ="));
		
 		Элемент = Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), Элементы.ГруппаОстаткиДемозалыЛеваяКолонка);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = стрОстатокНаСкладе.Склад;
		
		Элемент = Элементы.Добавить(ИмяЭлемента + "Количество", Тип("ДекорацияФормы"), Элементы.ГруппаОстаткиДемозалыПраваяКолонка);
		Элемент.Вид = ВидДекорацииФормы.Надпись;
		Элемент.Заголовок = СтрШаблон(" - %1", стрОстатокНаСкладе.ВНаличииОстаток);
		
	КонецЦикла;
	
	ТекущаяСтрокаСписка = ТекущееОборудование;
	
	Если ЗначениеЗаполнено(ТекущееОборудование.Номенклатура) Тогда
		
		Элементы.СтраницаХарактеристики.Видимость = Истина;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СмартЗначенияСвойствФильтров.ВидСвойств КАК Свойство,
		|	ВЫБОР
		|		КОГДА СмартЗначенияСвойствФильтров.ВидСвойств.Множественное
		|			ТОГДА СмартЗначенияСвойствФильтров.ЗначениеСтрока
		|		ИНАЧЕ СмартЗначенияСвойствФильтров.Значение
		|	КОНЕЦ КАК Значение
		|ИЗ
		|	РегистрСведений.СмартЗначенияСвойствФильтров КАК СмартЗначенияСвойствФильтров
		|ГДЕ
		|	СмартЗначенияСвойствФильтров.НаборСвойств = &НаборСвойств
		|	И НЕ ВЫБОР
		|				КОГДА СмартЗначенияСвойствФильтров.ВидСвойств.Множественное
		|					ТОГДА СмартЗначенияСвойствФильтров.ЗначениеСтрока
		|				ИНАЧЕ СмартЗначенияСвойствФильтров.Значение
		|			КОНЕЦ В ("""", ЗНАЧЕНИЕ(Справочник.СмартДопФильтрыНоменклатуры.ПустаяСсылка), НЕОПРЕДЕЛЕНО)
		|	И НЕ СмартЗначенияСвойствФильтров.ВидСвойств.Код = ""000000020""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СмартЗначенияСвойствФильтров.ЗначениеСтрока КАК ОбластьПрименения
		|ИЗ
		|	РегистрСведений.СмартЗначенияСвойствФильтров КАК СмартЗначенияСвойствФильтров
		|ГДЕ
		|	СмартЗначенияСвойствФильтров.НаборСвойств = &НаборСвойств
		|	И СмартЗначенияСвойствФильтров.ВидСвойств.Код = ""000000020""";
		
		Запрос.УстановитьПараметр("НаборСвойств", ТекущееОборудование.Номенклатура);
		
		Пакет = Запрос.ВыполнитьПакет();
		
		ТаблицаДопФильтров.Загрузить(Пакет[0].Выгрузить());
		ТаблицаОбластиПрименения.Очистить();
		
		Выборка = Пакет[1].Выбрать();
		Если Выборка.Следующий() Тогда
			
			МассивОбластей = СтрРазделить(Выборка.ОбластьПрименения, ";");
			Для каждого стрОбласть Из МассивОбластей Цикл
				
				НоваяСтрока = ТаблицаОбластиПрименения.Добавить();
				НоваяСтрока.ОбластьПрименения = стрОбласть;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ТаблицаДопФильтров.Очистить();
		ТаблицаОбластиПрименения.Очистить();
		Элементы.СтраницаХарактеристики.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОстаткиОборудованияВДемоЗалах(Оборудование)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СвободныеОстаткиОстатки.ВНаличииОстаток КАК ВНаличииОстаток,
	|	СвободныеОстаткиОстатки.Склад КАК Склад
	|ИЗ
	|	РегистрНакопления.СвободныеОстатки.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Склад.смартНазначениеСклада = ЗНАЧЕНИЕ(Перечисление.смартНазначенияСкладов.ДемоЗал)) КАК СвободныеОстаткиОстатки";
	
	Запрос.УстановитьПараметр("Номенклатура", Оборудование.Номенклатура);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ОчиститьКП()
	
	ТаблицаНоменклатурыКП.Очистить();
	СопутствующиеТовары.Очистить();
	ДополнительныеОпции.Очистить();
	СпринтерФорматыПринтеров.Очистить();
	СпринтерПечатающиеГоловки.Очистить();
	СпринтерКоличествоГолов = 0;
	СпринтерНужноЛиПечататьГлянец = Ложь;
	СпринтерОсновныеКонфигурации.Очистить();
	СпринтерЦветовыеКонфигурации.Очистить();
	ВыбранноеОборудование = Неопределено;
	ВыбраннаяПечатающаяГоловка = Неопределено;
	ВыбраннаяЦветоваяКонфигурация = Неопределено;
	ВыбранныйФорматПринтера = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКонфигураторСпринтер(НеОбнулятьВыбор = Ложь)
	
	ВыбраннаяЦветоваяКонфигурация = Неопределено;
		
	Если НЕ НеОбнулятьВыбор Тогда
		
		ВыбранныйФорматПринтера = Неопределено;
		ВыбраннаяПечатающаяГоловка = Неопределено;
		ВыбранноеОборудование = Неопределено;
		
		Для каждого стр Из СпринтерФорматыПринтеров Цикл
			Если стр.Выбрано Тогда
				ВыбранныйФорматПринтера = стр.ФорматПринтера;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого стр Из СпринтерПечатающиеГоловки Цикл
			Если стр.Выбрано Тогда
				ВыбраннаяПечатающаяГоловка = стр.ПечатающаяГоловка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для каждого стр Из СпринтерОсновныеКонфигурации Цикл
			Если стр.Выбрано Тогда
				ВыбранноеОборудование = стр.ОсновнаяКонфигурация;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ВыбранноеОборудование.ФорматПринтера <> ВыбранныйФорматПринтера Тогда
		ВыбранноеОборудование = Неопределено;
	КонецЕсли;
	
	Для каждого стр Из СпринтерЦветовыеКонфигурации Цикл
		Если стр.Выбрано Тогда
			ВыбраннаяЦветоваяКонфигурация = стр.ЦветоваяКонфигурация;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьДоступныеВариантыВыбораКонфигуратораСпринтер();
	
	ОбновитьИнформациюПоПечатнымГоловкам();
	
	ПроверитьСкорректироватьКоличествоГолов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоступныеВариантыВыбораКонфигуратораСпринтер()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартКонструкторОборудования.ФорматПринтера КАК ФорматПринтера,
	|	ИСТИНА КАК Доступно,
	|	ВЫБОР
	|		КОГДА смартКонструкторОборудования.ФорматПринтера = &ВыбранныйФорматПринтера
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Выбрано
	|ИЗ
	|	Справочник.смартКонструкторОборудования КАК смартКонструкторОборудования
	|ГДЕ
	|	НЕ смартКонструкторОборудования.ПометкаУдаления
	|	И смартКонструкторОборудования.Бренд = &Бренд
	|	И смартКонструкторОборудования.ОсновнаяКонфигурация
	|	И смартКонструкторОборудования.ВидОборудования = ЗНАЧЕНИЕ(Справочник.смартВидыОборудования.ДляПечати)
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартКонструкторОборудования.ФорматПринтера.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПечатающиеГоловки.ПечатающаяГоловка КАК ПечатающаяГоловка,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПечатающиеГоловки.Ссылка.ФорматПринтера = &ВыбранныйФорматПринтера
	|					И ВЫБОР
	|						КОГДА ПечатающиеГоловки.Ссылка = &ВыбранноеОборудование
	|								ИЛИ &ВыбранноеОборудование = ЗНАЧЕНИЕ(Справочник.смартКонструкторОборудования.ПустаяСсылка)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Доступно,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА ПечатающиеГоловки.Ссылка.ФорматПринтера = &ВыбранныйФорматПринтера
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|					И ПечатающиеГоловки.ПечатающаяГоловка = &ВыбраннаяПечатающаяГоловка
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Выбрано,
	|	ПечатающиеГоловки.ПечатающаяГоловка.Цена КАК Цена,
	|	ПечатающиеГоловки.ПечатающаяГоловка.Валюта КАК Валюта
	|ИЗ
	|	Справочник.смартКонструкторОборудования.ПечатающиеГоловки КАК ПечатающиеГоловки
	|ГДЕ
	|	НЕ ПечатающиеГоловки.Ссылка.ПометкаУдаления
	|	И ПечатающиеГоловки.Ссылка.Бренд = &Бренд
	|	И ПечатающиеГоловки.Ссылка.ОсновнаяКонфигурация
	|	И ПечатающиеГоловки.Ссылка.ВидОборудования = ЗНАЧЕНИЕ(Справочник.смартВидыОборудования.ДляПечати)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПечатающиеГоловки.ПечатающаяГоловка,
	|	ПечатающиеГоловки.ПечатающаяГоловка.Цена,
	|	ПечатающиеГоловки.ПечатающаяГоловка.Валюта
	|
	|УПОРЯДОЧИТЬ ПО
	|	Доступно УБЫВ,
	|	ПечатающиеГоловки.ПечатающаяГоловка.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартКонструкторОборудования.Ссылка КАК ОсновнаяКонфигурация,
	|	МАКСИМУМ(смартКонструкторОборудования.Цена) КАК Цена,
	|	МАКСИМУМ(смартКонструкторОборудования.Валюта) КАК Валюта,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА смартКонструкторОборудования.ФорматПринтера = &ВыбранныйФорматПринтера
	|					И (ПечатающиеГоловкиОборудования.ПечатающаяГоловка = &ВыбраннаяПечатающаяГоловка
	|						ИЛИ &ВыбраннаяПечатающаяГоловка = ЗНАЧЕНИЕ(Справочник.смартПечатающиеГоловки.ПустаяСсылка)
	|							И смартКонструкторОборудования.Ссылка = &ВыбранноеОборудование)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Доступно,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА смартКонструкторОборудования.ФорматПринтера = &ВыбранныйФорматПринтера
	|								И (ПечатающиеГоловкиОборудования.ПечатающаяГоловка = &ВыбраннаяПечатающаяГоловка
	|									ИЛИ &ВыбраннаяПечатающаяГоловка = ЗНАЧЕНИЕ(Справочник.смартПечатающиеГоловки.ПустаяСсылка)
	|										И смартКонструкторОборудования.Ссылка = &ВыбранноеОборудование)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|					И смартКонструкторОборудования.Ссылка = &ВыбранноеОборудование
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Выбрано
	|ИЗ
	|	Справочник.смартКонструкторОборудования КАК смартКонструкторОборудования
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартКонструкторОборудования.ПечатающиеГоловки КАК ПечатающиеГоловкиОборудования
	|		ПО (ПечатающиеГоловкиОборудования.Ссылка = смартКонструкторОборудования.Ссылка)
	|ГДЕ
	|	смартКонструкторОборудования.Бренд = &Бренд
	|
	|СГРУППИРОВАТЬ ПО
	|	смартКонструкторОборудования.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Доступно УБЫВ,
	|	смартКонструкторОборудования.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЦветовыеСхемы.ЦветоваяСхема КАК ЦветоваяКонфигурация,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЦветовыеСхемы.Ссылка.ФорматПринтера = &ВыбранныйФорматПринтера
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Доступно,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА ЦветовыеСхемы.Ссылка.ФорматПринтера = &ВыбранныйФорматПринтера
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|					И ЦветовыеСхемы.ЦветоваяСхема = &ВыбраннаяЦветоваяКонфигурация
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК Выбрано,
	|	ЦветовыеСхемы.ВозможенГлянец КАК ВозможенГлянец,
	|	ЦветовыеСхемы.ГлянецОт КАК ГлянецОт,
	|	ЦветовыеСхемы.ГлянецДо КАК ГлянецДо,
	|	ЦветовыеСхемы.БезГлянцаОт КАК БезГлянцаОт,
	|	ЦветовыеСхемы.БезГлянцаДо КАК БезГлянцаДо
	|ИЗ
	|	Справочник.смартКонструкторОборудования.ЦветовыеСхемы КАК ЦветовыеСхемы
	|ГДЕ
	|	НЕ ЦветовыеСхемы.Ссылка.ПометкаУдаления
	|	И ЦветовыеСхемы.Ссылка.Бренд = &Бренд
	|	И ЦветовыеСхемы.Ссылка.ОсновнаяКонфигурация
	|	И ЦветовыеСхемы.Ссылка.ВидОборудования = ЗНАЧЕНИЕ(Справочник.смартВидыОборудования.ДляПечати)
	|	И ЦветовыеСхемы.Ссылка = &ВыбранноеОборудование
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦветовыеСхемы.ЦветоваяСхема,
	|	ЦветовыеСхемы.ВозможенГлянец,
	|	ЦветовыеСхемы.ГлянецОт,
	|	ЦветовыеСхемы.ГлянецДо,
	|	ЦветовыеСхемы.БезГлянцаОт,
	|	ЦветовыеСхемы.БезГлянцаДо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Доступно УБЫВ,
	|	ЦветовыеСхемы.ЦветоваяСхема.Наименование";
	
	Запрос.УстановитьПараметр("Бренд", ПолучитьБрендСпринтер());
	Запрос.УстановитьПараметр("ВыбранныйФорматПринтера", ВыбранныйФорматПринтера);
	Запрос.УстановитьПараметр("ВыбраннаяПечатающаяГоловка", ВыбраннаяПечатающаяГоловка);
	Запрос.УстановитьПараметр("ВыбранноеОборудование", ВыбранноеОборудование);
	Запрос.УстановитьПараметр("ВыбраннаяЦветоваяКонфигурация", ВыбраннаяЦветоваяКонфигурация);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	СпринтерФорматыПринтеров.Загрузить(Пакет[0].Выгрузить());
	СпринтерПечатающиеГоловки.Загрузить(Пакет[1].Выгрузить());
	СпринтерОсновныеКонфигурации.Загрузить(Пакет[2].Выгрузить());
	СпринтерЦветовыеКонфигурации.Загрузить(Пакет[3].Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ВыборДоступногоОборудованияСервер()
	
	ВыбранноеОборудование = Элементы.СписокДоступногоОборудования.ТекущаяСтрока;
	ВыбранныйФорматПринтера = ВыбранноеОборудование.ФорматПринтера;
	ВыбраннаяПечатающаяГоловка = ВыбранноеОборудование.ПечатающаяГоловка;
	
	Если ВыбранноеОборудование.Бренд = ПолучитьБрендСпринтер() Тогда
		
		ОбновитьКонфигураторСпринтер(Истина);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаКонфигураторСпринтер;
		
	КонецЕсли;
	
КонецПроцедуры

