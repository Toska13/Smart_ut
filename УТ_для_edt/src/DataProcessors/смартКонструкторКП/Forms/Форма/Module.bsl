&НаСервере
Процедура РассчитатьИтоговоеКП()
	
	ТаблицаНоменклатурыКП.Очистить();
	
	Если Элементы.СтраницаКонфигураторСпринтер.Видимость Тогда
		
		ЦенаОсновнойКонфигурацииСпринтер = 0;
		
		Для каждого стр Из СпринтерПечатающиеГоловки Цикл
			
			Если стр.Выбрано Тогда
				
				НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
				НоваяСтрокаКП.Номенклатура = стр.ПечатающаяГоловка;
				НоваяСтрокаКП.Количество = СпринтерКоличествоГолов;
				НоваяСтрокаКП.Цена = РаботаСКурсамиВалют.ПересчитатьВВалюту(стр.Цена, стр.Валюта, Валюта, ТекущаяДатаСеанса());
				НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого стр Из СпринтерОсновныеКонфигурации Цикл
			
			Если стр.Выбрано Тогда
				
				ЦенаОсновнойКонфигурацииСпринтер = ЦенаОсновнойКонфигурацииСпринтер + РаботаСКурсамиВалют.ПересчитатьВВалюту(стр.Цена, стр.Валюта, Валюта, ТекущаяДатаСеанса());
				
				НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
				НоваяСтрокаКП.Номенклатура = стр.ОсновнаяКонфигурация;
				НоваяСтрокаКП.Количество = 1;
				НоваяСтрокаКП.Цена = ЦенаОсновнойКонфигурацииСпринтер;
				НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		//Если СпринтерНужноЛиПечататьГлянец Тогда
		//	
		//	НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
		//	НоваяСтрокаКП.Номенклатура = "LED блок";
		//	НоваяСтрокаКП.Количество = 1;
		//	НоваяСтрокаКП.Цена = РаботаСКурсамиВалют.ПересчитатьВВалюту(3200, Справочники.смартПредопределенныеЗначения.Настройки.ВидЦеныРозничнаяUSD.ВалютаЦены, Валюта, ТекущаяДатаСеанса());
		//	НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
		//	
		//КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ВыбранноеОборудование) И ЗначениеЗаполнено(ВыбранноеОборудование.Номенклатура) Тогда
			
			Цены = ПолучитьЦеныНоменклатуры(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВыбранноеОборудование.Номенклатура));
			
			НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
			НоваяСтрокаКП.Номенклатура = ВыбранноеОборудование.Номенклатура;
			НоваяСтрокаКП.Количество = 1;
			НоваяСтрокаКП.Цена = ?(Цены.Количество() > 0, РаботаСКурсамиВалют.ПересчитатьВВалюту(Цены[0].Цена, Цены[0].Валюта, Валюта, ТекущаяДатаСеанса()), 0);
			НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого стр Из СопутствующиеТовары Цикл
		
		Если стр.Выбрано И НЕ стр.Номенклатура = "Не выбрано" Тогда
			
			НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
			НоваяСтрокаКП.Номенклатура = стр.Номенклатура;
			НоваяСтрокаКП.Количество = 1;
			НоваяСтрокаКП.Цена = РаботаСКурсамиВалют.ПересчитатьВВалюту(стр.Цена, стр.Валюта, Валюта, ТекущаяДатаСеанса());
			НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого стр Из ДополнительныеОпции Цикл
		
		Если стр.Выбрано И НЕ стр.Номенклатура = "Не выбрано" Тогда
			
			НоваяСтрокаКП = ТаблицаНоменклатурыКП.Добавить();
			НоваяСтрокаКП.Номенклатура = стр.Номенклатура;
			НоваяСтрокаКП.Количество = 1;
			НоваяСтрокаКП.Цена = РаботаСКурсамиВалют.ПересчитатьВВалюту(стр.Цена, стр.Валюта, Валюта, ТекущаяДатаСеанса());
			НоваяСтрокаКП.Стоимость = НоваяСтрокаКП.Цена * НоваяСтрокаКП.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СуммаКП = ТаблицаНоменклатурыКП.Итог("Стоимость");
	Элементы.ТаблицаНоменклатурыКПСтоимость.ТекстПодвала = Формат("ЧДЦ=2");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСопутствующиеТоварыИДополнительныеОпции()
	
	ПредыдущиеДанные = СопутствующиеТовары.Выгрузить();
	МассивНоменклатуры = Новый Массив;
	
	СопутствующиеТовары.Очистить();
	НоваяСтрока = СопутствующиеТовары.Добавить();
	НоваяСтрока.Номенклатура = "Не выбрано";
		
	ДополнительныеОпции.Очистить();
	НоваяСтрока = ДополнительныеОпции.Добавить();
	НоваяСтрока.Номенклатура = "Не выбрано";
	
	Для каждого стрДанные Из ВыбранноеОборудование.СопутствующиеТовары Цикл
		
		НоваяСтрока = СопутствующиеТовары.Добавить();
		НоваяСтрока.Номенклатура = стрДанные.Номенклатура;
		
		Если ТипЗнч(стрДанные.Номенклатура) = Тип("СправочникСсылка.смартКонструкторОборудования") Тогда
			
			НоваяСтрока.Цена = стрДанные.Номенклатура.Цена;
			НоваяСтрока.Валюта = стрДанные.Номенклатура.Валюта;
			
		Иначе
			МассивНоменклатуры.Добавить(стрДанные.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого стрДанные Из ВыбранноеОборудование.ДополнительныеОпции Цикл
		
		НоваяСтрока = ДополнительныеОпции.Добавить();
		НоваяСтрока.Номенклатура = стрДанные.Номенклатура;
		
		Если ТипЗнч(стрДанные.Номенклатура) = Тип("СправочникСсылка.смартКонструкторОборудования") Тогда
			
			НоваяСтрока.Цена = стрДанные.Номенклатура.Цена;
			НоваяСтрока.Валюта = стрДанные.Номенклатура.Валюта;
			
		Иначе
			МассивНоменклатуры.Добавить(стрДанные.Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	ЦеныНоменклатуры = ПолучитьЦеныНоменклатуры(МассивНоменклатуры);
	Для каждого стрЦена Из ЦеныНоменклатуры Цикл
		
		НайденныеСтроки = СопутствующиеТовары.НайтиСтроки(Новый Структура("Номенклатура", стрЦена.Номенклатура));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			стрНайденныеСтроки.Цена = стрЦена.Цена;
			стрНайденныеСтроки.Валюта = стрЦена.Валюта;
		КонецЦикла;
		
		НайденныеСтроки = ДополнительныеОпции.НайтиСтроки(Новый Структура("Номенклатура", стрЦена.Номенклатура));
		Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
			стрНайденныеСтроки.Цена = стрЦена.Цена;
			стрНайденныеСтроки.Валюта = стрЦена.Валюта;
		КонецЦикла;
		
	КонецЦикла;
	
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЦеныНоменклатуры(МассивНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.ВидЦены.ВалютаЦены КАК Валюта
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			Номенклатура В (&МассивНоменклатуры)
	|				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("ВидЦены", Справочники.смартПредопределенныеЗначения.Настройки.ВидЦеныРозничнаяUSD);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ОбновитьИнформациюПоПечатнымГоловкам()
	
	Элементы.СпринтерНужноЛиПечататьГлянец.Видимость = Ложь;
	НайденныеСтроки = СпринтерЦветовыеКонфигурации.НайтиСтроки(Новый Структура("Выбрано", Истина));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Элементы.ГруппаСпринтерКоличествоГолов.Видимость = Истина;
		
		Если НайденныеСтроки[0].ВозможенГлянец Тогда
			Элементы.СпринтерНужноЛиПечататьГлянец.Видимость = Истина;
		Иначе
			СпринтерНужноЛиПечататьГлянец = Ложь;
		КонецЕсли;
		
		МинимальноеКоличество = 0;
		МаксимальноеКоличество = 0;
		
		Если СпринтерНужноЛиПечататьГлянец Тогда
			
			Элементы.ДекорацияМинимумГолов.Заголовок = СтрШаблон("от %1", НайденныеСтроки[0].ГлянецОт);
			Элементы.ДекорацияМаксимумГолов.Заголовок = СтрШаблон("до %1", НайденныеСтроки[0].ГлянецДо);
			
			МинимальноеКоличество = НайденныеСтроки[0].ГлянецОт;
			МаксимальноеКоличество = НайденныеСтроки[0].ГлянецДо;
			
		Иначе
			
			Элементы.ДекорацияМинимумГолов.Заголовок = СтрШаблон("от %1", НайденныеСтроки[0].БезГлянцаОт);
			Элементы.ДекорацияМаксимумГолов.Заголовок = СтрШаблон("до %1", НайденныеСтроки[0].БезГлянцаДо);
			
			МинимальноеКоличество = НайденныеСтроки[0].БезГлянцаОт;
			МаксимальноеКоличество = НайденныеСтроки[0].БезГлянцаДо;
			
		КонецЕсли;
		
		Элементы.СпринтерКоличествоГолов.СписокВыбора.Очистить();
		Элементы.СпринтерКоличествоГолов.СписокВыбора.Добавить(0, "0");
		Для н = МинимальноеКоличество По МаксимальноеКоличество Цикл
			Если НЕ н = 0 Тогда
				Элементы.СпринтерКоличествоГолов.СписокВыбора.Добавить(н, н);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Элементы.ГруппаСпринтерКоличествоГолов.Видимость = Ложь;
		СпринтерНужноЛиПечататьГлянец = Ложь;
	КонецЕсли;
	
	НайденныеСтроки = ДополнительныеОпции.НайтиСтроки(Новый Структура("Номенклатура", "LED блок"));
	Если СпринтерНужноЛиПечататьГлянец И НайденныеСтроки.Количество() = 0 Тогда
		
		НоваяСтрока = ДополнительныеОпции.Добавить();
		НоваяСтрока.Номенклатура = "LED блок";
		НоваяСтрока.Цена = 3200;
		НоваяСтрока.Валюта = Справочники.смартПредопределенныеЗначения.Настройки.ВидЦеныРозничнаяUSD.ВалютаЦены;
		НоваяСтрока.Выбрано = Истина;
		НоваяСтрока.Доступно = Истина;
		
	ИначеЕсли НЕ СпринтерНужноЛиПечататьГлянец И НЕ НайденныеСтроки.Количество() = 0 Тогда
		
		ДополнительныеОпции.Удалить(НайденныеСтроки[0]);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьСкорректироватьКоличествоГолов()
	
	Если СпринтерКоличествоГолов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = СпринтерЦветовыеКонфигурации.НайтиСтроки(Новый Структура("Выбрано", Истина));
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Если СпринтерНужноЛиПечататьГлянец Тогда
			
			СпринтерКоличествоГолов = Мин(СпринтерКоличествоГолов, НайденныеСтроки[0].ГлянецДо);
			СпринтерКоличествоГолов = Макс(СпринтерКоличествоГолов, НайденныеСтроки[0].ГлянецОт);
			
		Иначе
			
			СпринтерКоличествоГолов = Мин(СпринтерКоличествоГолов, НайденныеСтроки[0].БезГлянцаДо);
			СпринтерКоличествоГолов = Макс(СпринтерКоличествоГолов, НайденныеСтроки[0].БезГлянцаОт);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьСтраницИВозможностиПерехода()
	
	ДоступностьПредыдущих = Истина;
	
	//дополнительные опции
	Элементы.СтраницаДополнительныеОпции.Доступность = ЗначениеЗаполнено(ВыбранноеОборудование) И НЕ Элементы.СтраницаКонфигураторСпринтер.Видимость;
	Если НЕ Элементы.СтраницаДополнительныеОпции.Доступность И Элементы.СтраницаКонфигураторСпринтер.Видимость Тогда
		
		ВыделенныеСтроки = СпринтерФорматыПринтеров.Выгрузить(Новый Структура("Выбрано", Истина));
		Элементы.СтраницаДополнительныеОпции.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
		
		Если Элементы.СтраницаДополнительныеОпции.Доступность Тогда
			ВыделенныеСтроки = СпринтерПечатающиеГоловки.Выгрузить(Новый Структура("Выбрано", Истина));
			Элементы.СтраницаДополнительныеОпции.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
		КонецЕсли;
		
		Если Элементы.СтраницаДополнительныеОпции.Доступность Тогда
			ВыделенныеСтроки = СпринтерПечатающиеГоловки.Выгрузить(Новый Структура("Выбрано", Истина));
			Элементы.СтраницаДополнительныеОпции.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
		КонецЕсли;
		
		Если Элементы.СтраницаДополнительныеОпции.Доступность Тогда
			ВыделенныеСтроки = СпринтерОсновныеКонфигурации.Выгрузить(Новый Структура("Выбрано", Истина));
			Элементы.СтраницаДополнительныеОпции.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
		КонецЕсли;
		
		Если Элементы.СтраницаДополнительныеОпции.Доступность Тогда
			ВыделенныеСтроки = СпринтерЦветовыеКонфигурации.Выгрузить(Новый Структура("Выбрано", Истина));
			Элементы.СтраницаДополнительныеОпции.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
		КонецЕсли;
		
		Если Элементы.СтраницаДополнительныеОпции.Доступность Тогда
			Элементы.СтраницаДополнительныеОпции.Доступность = (СпринтерКоличествоГолов > 0) И ДоступностьПредыдущих;
		КонецЕсли;
		
		Элементы.КнопкаДалееСпринтер.Доступность = Элементы.СтраницаДополнительныеОпции.Доступность;
		
	КонецЕсли;
	ДоступностьПредыдущих = Элементы.СтраницаДополнительныеОпции.Доступность;
	
	//сопутствующие товары
	ВыделенныеСтроки = ДополнительныеОпции.Выгрузить(Новый Структура("Выбрано", Истина));
	Элементы.СтраницаСопутствующиеТовары.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
	ДоступностьПредыдущих = Элементы.СтраницаСопутствующиеТовары.Доступность;
	Элементы.КнопкаДалееДополнительныеОпции.Доступность = Элементы.СтраницаСопутствующиеТовары.Доступность;
	
	//КП клиента
	ВыделенныеСтроки = СопутствующиеТовары.Выгрузить(Новый Структура("Выбрано", Истина));
	Элементы.СтраницаКПКлиента.Доступность = (ВыделенныеСтроки.Количество() > 0) И ДоступностьПредыдущих;
	Элементы.КнопкаДалееСопутствующиеТовары.Доступность = Элементы.СтраницаКПКлиента.Доступность;
	
	Элементы.СтраницаКПКлиента.Доступность = Истина; //пока не определятся аналитики
	
КонецПроцедуры

&НаСервере
Процедура СформироватьКППоТекущимДанным()
	
	УстановитьПривилегированныйРежим(Истина);
	
	КП = Документы.КоммерческоеПредложениеКлиенту.СоздатьДокумент();
	
	КП.Дата = ТекущаяДатаСеанса();
	КП.Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
	КП.Автор = Пользователи.АвторизованныйПользователь();
	КП.CRM_Автор = КП.Автор;
	КП.Менеджер = КПМенеджер;
	КП.Клиент = КППартнер;
	КП.Контрагент = КПКлиент;
	КП.КонтактноеЛицо = КПКонтактноеЛицо;
	КП.Валюта = Валюта;
	КП.ХозяйственнаяОперация = Перечисления.ВидыОперацийКоммерческихПредложений.ЗакупкаУПоставщика;
	КП.ВариантУказанияСрокаПоставки = Перечисления.ВариантыСроковПоставкиКоммерческихПредложений.НеУказывается;
	КП.Налогообложение = Истина;
	КП.СкидкиРассчитаны = Истина;
	КП.СрокДействия = КП.Дата + 86400 * 3;
	КП.Статус = Перечисления.СтатусыКоммерческихПредложенийКлиентам.Черновик;
	КП.СуммаДокумента = СуммаКП;
	КП.ЦенаВключаетНДС = Истина;
	
	СтрокаВарианта = КП.CRM_КомментарииВариантов.Добавить();
	СтрокаВарианта.ИДВарианта = 1;
	СтрокаВарианта.КомментарийВарианта = "Основной";
	
	Для каждого стрТовары Из ТаблицаНоменклатурыКП Цикл
		
		НоваяСтрока = КП.Товары.Добавить();
		НоваяСтрока.Номенклатура = стрТовары.Номенклатура;
		НоваяСтрока.CRM_Содержание = стрТовары.Номенклатура;
		НоваяСтрока.Количество = стрТовары.Количество;
		НоваяСтрока.Цена = стрТовары.Цена;
		НоваяСтрока.Сумма = стрТовары.Стоимость;
		НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		НоваяСтрока.СуммаСНДС = стрТовары.Стоимость;
		
		НоваяСтрока.CRM_ИДВарианта = СтрокаВарианта.ИДВарианта;
		НоваяСтрока.CRM_ИмяВарианта = СтрокаВарианта.КомментарийВарианта;
		
	КонецЦикла;
	
	КП.Записать(РежимЗаписиДокумента.Запись);
	Попытка
		КП.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ОчиститьКП();
	УстановитьВидимостьДоступность();
	ОбновитьДоступностьСтраницИВозможностиПерехода();
	
КонецПроцедуры


#КонецОбласти
