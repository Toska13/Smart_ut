#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ВыполнитьПроверкуНеобходимостиПроведенияТОУКлиентов(ДатаПроверки = Неопределено) Экспорт

	ИмяСобытияДляЖР = "ПроверкаНеобходимостиПроведенияТОУКлиентов_смарт";

	ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР, УровеньЖурналаРегистрации.Информация,,, "Начало");

	//Определение интервала проверки
	Если НЕ ЗначениеЗаполнено(ДатаПроверки) Тогда
		ДатаПроверки = ТекущаяДатаСеанса();
	КонецЕсли;

	КоличествоДней = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("РабочихДнейДляУведомленияОТО", Ложь);

	Если НЕ ЗначениеЗаполнено(КоличествоДней) Тогда
		КоличествоДней = 15;
	КонецЕсли;
	
	ДатаНачала 	  = НачалоДня(ДатаПроверки);
	ДатаОкончания = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ДатаНачала, КоличествоДней); 
	
	//Получение выборки
	Запрос = Новый Запрос;
	Запрос.Текст = 
	//++ #Б-2892 смарт: Лопато 01.04.2025 //Ошибка при создании интереса/Регламентное обслуживание клиентов  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	//-- #Б-2892 смарт: Лопато 01.04.2025
	|	ТехОбслуживаниеПоКлиентам.ДатаТОУКлиента КАК ДатаТОУКлиента,
	|	ТехОбслуживаниеПоКлиентам.Клиент КАК Клиент,
	|	ТехОбслуживаниеПоКлиентам.Контрагент КАК Контрагент,
	|	ТехОбслуживаниеПоКлиентам.Оборудование КАК Оборудование,
	|	ТехОбслуживаниеПоКлиентам.Серия КАК Серия,
	|	ТехОбслуживаниеПоКлиентам.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	|	ТехОбслуживаниеПоКлиентам.СрокЗамены КАК СрокЗамены,
	|	ТехОбслуживаниеПоКлиентам.Запчасть КАК Запчасть,
	|	ТехОбслуживаниеПоКлиентам.Количество КАК Количество,
	|	ТехОбслуживаниеПоКлиентам.Регистратор КАК Регистратор,
	|	ТехОбслуживаниеПоКлиентам.Представительство КАК Представительство
	|ПОМЕСТИТЬ ВТ_Записи
	|ИЗ
	|	РегистрСведений.смартТехническоеОбслуживаниеОборудованияПоКлиентам КАК ТехОбслуживаниеПоКлиентам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТехническоеОбслуживаниеОборудования КАК ТехОбслужОборудования
	|		ПО ТехОбслуживаниеПоКлиентам.Оборудование = ТехОбслужОборудования.Оборудование
	|ГДЕ
	|	ТехОбслуживаниеПоКлиентам.ДатаТОУКлиента >= &ДатаНачала
	|	И ТехОбслуживаниеПоКлиентам.ДатаТОУКлиента <= &ДатаОкончания
	|	И НЕ ТехОбслуживаниеПоКлиентам.СозданДокументРегламентноеОбслуживание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Записи.Регистратор КАК Регистратор,
	|	смартРуководителиМенеджеровСЦ.Менеджер КАК Менеджер,
	|	смартРуководителиМенеджеровСЦ.Руководитель КАК Руководитель
	|ПОМЕСТИТЬ ВТ_МенеджерыРуководители
	|ИЗ
	|	ВТ_Записи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартРуководителиМенеджеровСЦ КАК смартРуководителиМенеджеровСЦ
	|		ПО ВТ_Записи.Клиент.ОсновнойМенеджер = смартРуководителиМенеджеровСЦ.Менеджер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Записи.ДатаТОУКлиента КАК ДатаТОУКлиента,
	|	ВТ_Записи.Клиент КАК Клиент,
	|	ВТ_Записи.Контрагент КАК Контрагент,
	|	ВТ_Записи.Оборудование КАК Оборудование,
	|	ВТ_Записи.Серия КАК Серия,
	|	ВТ_Записи.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	|	ВТ_Записи.СрокЗамены КАК СрокЗамены,
	|	ВТ_Записи.Запчасть КАК Запчасть,
	|	ВТ_Записи.Количество КАК Количество,
	//++ #Б-2674 смарт: Лопато 17.03.2025 //Автоматически создавать интересы на основании документа "Регламентное обслуживание клиентов"  
	|	ЕСТЬNULL(ЦеныЗапчастей.Цена, 0) КАК ЦенаЗапчасти,
	//-- #Б-2674 смарт: Лопато 17.03.2025
	|	ВТ_Записи.Регистратор КАК Регистратор,
	|	ВТ_Записи.Представительство КАК Представительство,
	|	ВТ_МенеджерыРуководители.Менеджер КАК Менеджер,
	|	ВТ_МенеджерыРуководители.Руководитель КАК Руководитель
	|ИЗ
	|	ВТ_Записи КАК ВТ_Записи
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МенеджерыРуководители КАК ВТ_МенеджерыРуководители
	|		ПО ВТ_Записи.Регистратор = ВТ_МенеджерыРуководители.Регистратор
	//++ #Б-2674 смарт: Лопато 17.03.2025 //Автоматически создавать интересы на основании документа "Регламентное обслуживание клиентов"  
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены.Идентификатор = ""РозничнаяRUB"" 
	|				И Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|				И Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) КАК ЦеныЗапчастей
	|		ПО ВТ_Записи.Запчасть = ЦеныЗапчастей.Номенклатура
	//-- #Б-2674 смарт: Лопато 17.03.2025
	|ИТОГИ
	|	МАКСИМУМ(ДатаТОУКлиента),
	|	МАКСИМУМ(Контрагент),
	|	МАКСИМУМ(Регистратор),
	|	МАКСИМУМ(Представительство),
	|	МАКСИМУМ(Менеджер),
	|	МАКСИМУМ(Руководитель)
	|ПО
	|	Клиент,
	|	Оборудование,
	|	Серия,
	|	ДатаПодписанияАктаНаПНР,
	|	СрокЗамены";

	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	//Создание документов
	ВыборкаКлиент = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКлиент.Следующий() Цикл
	
		ВыборкаОборудование = ВыборкаКлиент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
		Пока ВыборкаОборудование.Следующий() Цикл
			
			ВыборкаСерия = ВыборкаОборудование.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаСерия.Следующий() Цикл
				
				ВыборкаДатаПодписанияАктаНаПНР = ВыборкаСерия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

				Пока ВыборкаДатаПодписанияАктаНаПНР.Следующий() Цикл
					
					ВыборкаСрокЗамены = ВыборкаДатаПодписанияАктаНаПНР.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Пока ВыборкаСрокЗамены.Следующий() Цикл
						
						НачатьТранзакцию();
						
						НовыйДокумент = Документы.смартРегламентноеОбслуживаниеКлиентов.СоздатьДокумент();

						НовыйДокумент.Дата 					  = ТекущаяДата();
						НовыйДокумент.Статус 				  = Перечисления.смартСтатусыРегламентногоОбслуживания.НеобходимоСвязатьсяСКлиентом;
						НовыйДокумент.НазначенныйМенеджерСЦ   = ВыборкаСрокЗамены.Клиент.смартОсновнойМенеджерСервисЦентра;

						НовыйДокумент.ДатаПодписанияАктаНаПНР = ВыборкаСрокЗамены.ДатаПодписанияАктаНаПНР;
						НовыйДокумент.Клиент 				  = ВыборкаСрокЗамены.Клиент;
						НовыйДокумент.Контрагент 			  = ВыборкаСрокЗамены.Контрагент;
						НовыйДокумент.Оборудование 			  = ВыборкаСрокЗамены.Оборудование;
						НовыйДокумент.ДатаТОУКлиента 		  = ВыборкаСрокЗамены.ДатаТОУКлиента;
						НовыйДокумент.СрокЗамены 			  = ВыборкаСрокЗамены.СрокЗамены;
						НовыйДокумент.ДокументОснование 	  = ВыборкаСрокЗамены.Регистратор;
						НовыйДокумент.Серия 				  = ВыборкаСрокЗамены.Серия;
						НовыйДокумент.Подразделение 		  = ВыборкаСрокЗамены.Представительство;
						
						//++ #Б-2674 смарт: Лопато 17.03.2025 //Автоматически создавать интересы на основании документа "Регламентное обслуживание клиентов"  
						ВыручкаЗапчасти = 0;
						//-- #Б-2674 смарт: Лопато 17.03.2025
						
						Выборка = ВыборкаСрокЗамены.Выбрать();
						
						Пока Выборка.Следующий() Цикл
							
							НоваяСтрока = НовыйДокумент.Запчасти.Добавить();
							
							НоваяСтрока.Запчасть   = Выборка.Запчасть;
							НоваяСтрока.Количество = Выборка.Количество;

							//++ #Б-2674 смарт: Лопато 17.03.2025 //Автоматически создавать интересы на основании документа "Регламентное обслуживание клиентов"  
							ВыручкаЗапчасти = ВыручкаЗапчасти + (Выборка.Количество * Выборка.ЦенаЗапчасти);
							//-- #Б-2674 смарт: Лопато 17.03.2025
							
						КонецЦикла;
						
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
						
						//Установка признака, что создан документ
						НаборЗаписей = РегистрыСведений.смартТехническоеОбслуживаниеОборудованияПоКлиентам.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаСрокЗамены.Регистратор);
						
						НаборЗаписей.Прочитать();
						
						Если НаборЗаписей.Количество() > 0 Тогда
							
							Для Каждого Запись Из НаборЗаписей Цикл
								
								Если Запись.ДатаТОУКлиента = ВыборкаСрокЗамены.ДатаТОУКлиента
									И Запись.Клиент = ВыборкаСрокЗамены.Клиент
									И Запись.Контрагент = ВыборкаСрокЗамены.Контрагент
									И Запись.Оборудование = ВыборкаСрокЗамены.Оборудование
									И Запись.Серия = ВыборкаСрокЗамены.Серия
									И Запись.ДатаПодписанияАктаНаПНР = ВыборкаСрокЗамены.ДатаПодписанияАктаНаПНР
									И Запись.СрокЗамены = ВыборкаСрокЗамены.СрокЗамены Тогда
									
									Запись.СозданДокументРегламентноеОбслуживание = Истина;
									
								КонецЕсли;
								
							КонецЦикла;
							
						КонецЕсли;
						
						НаборЗаписей.Записать();
						
						//++ #Б-2674 смарт: Лопато 17.03.2025 //Автоматически создавать интересы на основании документа "Регламентное обслуживание клиентов"  
						Интерес = Документы.CRM_Интерес.СоздатьДокумент();

						Интерес.Дата 				  = НовыйДокумент.Дата;
						Интерес.ДокументОснование 	  = НовыйДокумент.Ссылка;
						Интерес.ЦенаВключаетНДС 	  = Истина;
						Интерес.РучнойВводДатыПродажи = Истина;
						Интерес.ТипУслуги 			  = Справочники.CRM_ТипУслуги.ПоставкаРегламентноеОбслуживаниеКлиентов;
						Интерес.Валюта 				  = Константы.ВалютаРегламентированногоУчета.Получить();
						Интерес.Партнер 			  = НовыйДокумент.Клиент;
						Интерес.Контрагент 			  = НовыйДокумент.Контрагент;
						Интерес.Ответственный 		  = НовыйДокумент.НазначенныйМенеджерСЦ;
						Интерес.СрокРеакции 		  = НовыйДокумент.ДатаТОУКлиента;
						Интерес.Подразделение 		  = НовыйДокумент.НазначенныйМенеджерСЦ.Подразделение;
						Интерес.Офис 				  = НовыйДокумент.НазначенныйМенеджерСЦ.Подразделение.CRM_Офис;  
						Интерес.ОжидаемаяДатаПродажи  = НовыйДокумент.ДатаТОУКлиента;   

						Интерес.ОжидаемаяВыручка = ВыручкаЗапчасти; 
						
						Интерес.Тема = "Предложение РТО для "+ НовыйДокумент.Клиент.Наименование + " на: " + НовыйДокумент.Оборудование.Наименование;
						Интерес.Организация = CRM_ОбщегоНазначенияПовтИсп.ПолучитьЗначениеПоУмолчаниюПользователя(Интерес.Ответственный, "ОсновнаяОрганизация");

						Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.СтартовыйЭтапВоронкиРТО.Значение) Тогда
							Интерес.СостояниеИнтереса = Справочники.смартПредопределенныеЗначения.СтартовыйЭтапВоронкиРТО.Значение;
						КонецЕсли;
						
						Интерес.Записать(РежимЗаписиДокумента.Запись);
						
						смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(
							Перечисления.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес,
							"СозданНовыйИнтерес", 
							Интерес.Ссылка);					
						//-- #Б-2674 смарт: Лопато 17.03.2025
						
						ЗафиксироватьТранзакцию();
						
					КонецЦикла;
					
				КонецЦикла;

			КонецЦикла;

		КонецЦикла;
		
	КонецЦикла;

	ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР, УровеньЖурналаРегистрации.Информация,,, "Окончание");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли