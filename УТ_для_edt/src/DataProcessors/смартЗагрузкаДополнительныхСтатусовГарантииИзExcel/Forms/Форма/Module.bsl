	|	ПромежуточнаяТЗ.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТ_НайденнаяНоменклатура
	|ИЗ
	|	РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК ПромежуточнаяТЗ
	|ГДЕ
	|   ПромежуточнаяТЗ.ДатаЗагрузки = &ДатаЗагрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_НайденнаяНоменклатура.НомерСтрокиВФайле КАК НомерСтрокиВФайле,
	|	ВТ_НайденнаяНоменклатура.ДатаЗагрузки КАК ДатаЗагрузки,
	|	ВТ_НайденнаяНоменклатура.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_НайденнаяНоменклатура.Артикул КАК Артикул,
	|	ВТ_НайденнаяНоменклатура.Количество КАК Количество,
	|	ВТ_НайденнаяНоменклатура.Описание КАК Описание,
	|	ВТ_НайденнаяНоменклатура.ДатаСоздания КАК ДатаСоздания,
	|	ВТ_НайденнаяНоменклатура.ДатаОтправки КАК ДатаОтправки,
	|	ВТ_НайденнаяНоменклатура.СпособОтправки КАК СпособОтправки,
	|	ВТ_НайденнаяНоменклатура.НомерОтслеживания КАК НомерОтслеживания,
	|	ВТ_НайденнаяНоменклатура.Сотрудник КАК Сотрудник,
	|	ВТ_НайденнаяНоменклатура.Статус КАК Статус,
	|	ВТ_НайденнаяНоменклатура.Дилер КАК Дилер,
	|	ВТ_НайденнаяНоменклатура.РешениеПоставщика КАК РешениеПоставщика,
	|	ВТ_НайденнаяНоменклатура.Номенклатура КАК Номенклатура,
	|	смартЗаявкаНаГарантийныйРемонт.Ссылка КАК ДокументСсылка
	|ИЗ
	|	ВТ_НайденнаяНоменклатура КАК ВТ_НайденнаяНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|		ПО ВТ_НайденнаяНоменклатура.НомерЗаявки = смартЗаявкаНаГарантийныйРемонт.Номер
	|ИТОГИ ПО
	|	ДокументСсылка";
	
	ВыборкаДокумент = ЗапросЗаявка.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДокумент.ДокументСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = ВыборкаДокумент.ДокументСсылка.ПолучитьОбъект();
		БылиИзменения = Ложь;
		Выборка = ВыборкаДокумент.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			// ++ 21.11.2020
			Если НЕ ЗначениеЗаполнено(Выборка.Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			// --
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Выборка.Номенклатура); 
			
			НайденныеСтроки = ДокументОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				// ++ 21.11.2020
				Отбор = Новый Структура;
				Отбор.Вставить("АналогОтПоставщика", Выборка.Номенклатура); 
				
				НайденныеСтроки = ДокументОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() = 0 Тогда
				//--

				// Не должно быть!!!
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена строка в таблице ""Заполняется специалистом по претензиям"" по номенклатуре " + Выборка.Номенклатура + " в Заявке на гарантийный ремонт №" + Выборка.НомерЗаявки, ВыборкаДокумент.ДокументСсылка);
				Продолжить;
				
				// ++ 21.11.2020
				КонецЕсли;
			    // --
			КонецЕсли;
			
			// ++ 21.11.2020
			//РедактируемаяСтрока = НайденныеСтроки[0];
			Для Каждого РедактируемаяСтрока Из НайденныеСтроки Цикл
			// --
			
			Если РедактируемаяСтрока.РешениеПоставщикаИзмененоВручную Тогда
				Если РедактируемаяСтрока.РешениеПоставщика = Выборка.РешениеПоставщика Тогда
					РедактируемаяСтрока.РешениеПоставщикаИзмененоВручную = Ложь;
					БылиИзменения = Истина;
				КонецЕсли;
			Иначе
				
				Если РедактируемаяСтрока.РешениеПоставщика <> Выборка.РешениеПоставщика Тогда
					РедактируемаяСтрока.РешениеПоставщика = Выборка.РешениеПоставщика;
					БылиИзменения = Истина;
				КонецЕсли;
				
			КонецЕсли;
			
			//++ смарт:ММ 702 14.11.2021 
			Если РедактируемаяСтрока.ДатаОтправки <> Выборка.ДатаОтправки Тогда
				РедактируемаяСтрока.ДатаОтправки = Выборка.ДатаОтправки;
				БылиИзменения = Истина;
			КонецЕсли;
			
			Если РедактируемаяСтрока.НомерОтслеживания <> Выборка.НомерОтслеживания Тогда
				РедактируемаяСтрока.НомерОтслеживания = Выборка.НомерОтслеживания;
				БылиИзменения = Истина;
			КонецЕсли;
			//-- смарт:ММ 14.11.2021
			
			// ++ 21.11.2020
			КонецЦикла;
		    // --
		КонецЦикла;
		
		Если БылиИзменения Тогда
			ДокументОбъект.ОбменДанными.Загрузка = Истина;//++rnp 702 17.11.2021
			ДокументОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;	
		
КонецПроцедуры //-- смарт:ММ 20.07.2020

