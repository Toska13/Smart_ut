&НаКлиенте
Процедура ВывестиОтчетКлиент()
	
	ТабДокументОтличия = СформироватьТабличныйДокументСравнения();

	ИмяМакета = "Отличия";
	СинонимМакета = "Отличия"; 
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИмяМакета);    
