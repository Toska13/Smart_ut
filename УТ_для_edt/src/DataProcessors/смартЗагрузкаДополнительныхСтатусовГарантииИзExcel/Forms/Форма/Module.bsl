//++ смарт:ММ #044 224 29.11.2020 - Заявка на гарантийный ремонт 
&НаКлиенте
Процедура СформироватьОтчетПоследняяЗагрузкаСебестоимость(Команда)
	
	ТабДокументОтличия = СформироватьТабличныйДокументПоследняяЗагрузка();

	ИмяМакета = "ПоследняяЗагрузка";
	СинонимМакета = "ПоследняяЗагрузка"; 
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИмяМакета);    
    КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабДокументОтличия; 
    КоллекцияПечатныхФорм[0].Экземпляров = 1;
    КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;  
	
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма);
	
КонецПроцедуры //-- смарт:ММ 29.11.2020

//++ смарт:ММ #044 224 29.11.2020 - Заявка на гарантийный ремонт 
&НаСервере
Функция СформироватьТабличныйДокументПоследняяЗагрузка()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = Обработки.смартЗагрузкаДополнительныхСтатусовГарантииИзExcel.ПолучитьМакет("ПоследняяЗагрузка");
	
	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьТекстЗапросаОтчетПоследняяЗагрузка();
	
	Запрос.УстановитьПараметр("ОсновнойСклад", Справочники.смартПредопределенныеЗначения.ОсновнойСклад.Значение);
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(ТекущаяДата(), -12));
	Запрос.УстановитьПараметр("КонецПериода", ТекущаяДата());
	Запрос.УстановитьПараметр("ЕдиницыКоличества", 0);
	Запрос.УстановитьПараметр("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение);

	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	
	
	ТабДок.Вывести(ОбластьШапка);
		
	МассивОтсутствующихЗаявок = Новый Массив;
	НомераОтсутствующихЗаявокСтрока = "";
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
		
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
	
КонецФункции

