&НаСервере
Функция ПрочитатьЛисты(АдресФайла)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяФайла = ПолучитьИмяВременногоФайла("xlsx"); 
	ДвоичныеДанные.Записать(ИмяФайла);
	ИмяВременногоФайлаНаСервере = ИмяФайла;

	Возврат ПолучитьСписокЛистов_EXCEL1C(ИмяФайла);
	
КонецФункции

&НаСервере
Функция ЗаполнитьСоответствиеСтатусов()
	
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить("Backorder", 						Перечисления.смартДополнительныеСтатусыПоГарантии.Backorder);
	СоответствиеСтатусов.Вставить("Closed", 						Перечисления.смартДополнительныеСтатусыПоГарантии.Closed);
	СоответствиеСтатусов.Вставить("Waiting booking", 				Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingBooking);
	СоответствиеСтатусов.Вставить("Waiting damaged parts return", 	Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingDamagedPartsReturn);
	СоответствиеСтатусов.Вставить("Waiting decision", 				Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingDecision);
	СоответствиеСтатусов.Вставить("Waiting final decision", 		Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingFinalDecision);
	СоответствиеСтатусов.Вставить("Waiting invoicing", 				Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingInvoicing);
	СоответствиеСтатусов.Вставить("Waiting missing information", 	Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingMissingInformation);
	СоответствиеСтатусов.Вставить("Waiting shipment", 	            Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingShipment);
	СоответствиеСтатусов.Вставить("Waiting first check", 	        Перечисления.смартДополнительныеСтатусыПоГарантии.WaitingFirstCheck);
	Возврат СоответствиеСтатусов;
	
КонецФункции

