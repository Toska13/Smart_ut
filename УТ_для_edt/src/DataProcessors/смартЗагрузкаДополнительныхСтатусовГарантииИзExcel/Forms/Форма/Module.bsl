	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ПродолжитьЗагрузкуНаКлиенте();		
	
	КонецЕсли;
	
КонецПроцедуры

// ++ 02.05.2020
&НаКлиенте 
Процедура ПродолжитьЗагрузкуНаКлиенте()
	
	Отказ = ПереместитьФайлНаСервер(Объект.ПутьКФайлу);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайла = Объект.АдресФайлаВоВременномХранилище;
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(АдресФайла) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru = 'Не удалось получить данные для загрузки: не найден файл'"));
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДанныеСЛиста(АдресФайла);
	
	ВывестиОтчетКлиент();

	//++ смарт:ММ #044 224 21.07.2020
	ИзменитьРешениеПоставщикаВЗаявках();
	//-- смарт:ММ 21.07.2020
	
КонецПроцедуры

