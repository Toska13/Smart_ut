&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//Если НЕ ФайловыеФункцииСлужебныйКлиент.РасширениеРаботыСФайламиПодключено() Тогда
	//	Возврат;
	//КонецЕсли;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.ПроверятьСуществованиеФайла = Истина;
	
	ДиалогВыбора.Фильтр 					= "XLSX (*.xlsx)|*.xlsx|XLS (*.xls)|*.xls";
	ДиалогВыбора.Заголовок 					= "Выбор XLSX-файла";
	ДиалогВыбора.ПредварительныйПросмотр	= Ложь;
	
	РезультатВыбора = ДиалогВыбора.Выбрать();
	
	Если РезультатВыбора Тогда
		
		//ИмяЛистаПоУмолчанию = "Warranty_parts";
		ИмяЛистаПоУмолчанию = "WarrApp_Item_Status";
		
		Объект.ПутьКФайлу = СокрЛП(ДиалогВыбора.ПолноеИмяФайла);
		
		Отказ = ПереместитьФайлНаСервер(Объект.ПутьКФайлу);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		СписокЛистов = ПрочитатьЛисты(Объект.АдресФайлаВоВременномХранилище);
		Если ТипЗнч(СписокЛистов) = Тип("СписокЗначений") Тогда
			Элементы.Лист.СписокВыбора.ЗагрузитьЗначения(СписокЛистов.ВыгрузитьЗначения());
			Если СписокЛистов.НайтиПоЗначению(ИмяЛистаПоУмолчанию) <> Неопределено Тогда
				Объект.Лист = ИмяЛистаПоУмолчанию;
			КонецЕсли;
		КонецЕсли;

		ПрочитатьДатуИзНазванияФайла();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗагрузить(Команда)
	
	Если НЕ ЗначениеЗаполнено(ОБъект.ДатаЗагрузки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать дату загрузки!");
		Возврат
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Лист) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо выбрать лист!");
		Возврат
	КонецЕсли;
	
	Если УжеЕстьДанныеЗаВыбраннуюДату() Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗагрузкойЗавершение", ЭтотОбъект, );
		ТекстВопроса = НСтр("ru = 'В базе уже имются данные на дату " + Формат(Объект.ДатаЗагрузки, "ДФ='dd.MM.yyyy ""г.""'") + " Перезаписать?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
	Иначе
		ПродолжитьЗагрузкуНаКлиенте();
	КонецЕсли;
				
КонецПроцедуры

