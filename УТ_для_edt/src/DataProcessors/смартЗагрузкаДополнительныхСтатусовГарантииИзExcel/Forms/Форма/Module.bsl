// ++ 02.05.2020
&НаКлиенте
Функция ПрочитатьДатуИзНазванияФайла()
	
	ИмяФайлаСтрока = Объект.ПутьКФайлу; // "..../Smart-T ISS status report 3-3-2020.xslx"
	
	ПоследнийСимволГода = СтрНайти(ИмяФайлаСтрока, "-20") + 4;
	ИмяФайлаСтрока = Лев(ИмяФайлаСтрока, ПоследнийСимволГода);
	
	Год = Прав(ИмяФайлаСтрока, 4);
	НомерПредПослднегоСимволаТире = СтрНайти(ИмяФайлаСтрока, "-", НаправлениеПоиска.СКонца,, 2);
	НомерПоследнегоПробела = СтрНайти(ИмяФайлаСтрока, " ", НаправлениеПоиска.СКонца);
	
	ЧислоСимволовМесяц = СтрДлина(ИмяФайлаСтрока) - 5 - НомерПредПослднегоСимволаТире;  
	Месяц = Сред(ИмяФайлаСтрока, НомерПредПослднегоСимволаТире + 1, ЧислоСимволовМесяц);
	Если СтрДлина(Месяц) = 1 Тогда 
		Месяц = "0" + Месяц;
	КонецЕсли;
	
	ЧислоСимволовДень = НомерПредПослднегоСимволаТире - НомерПоследнегоПробела - 1;
	День = Сред(ИмяФайлаСтрока, НомерПоследнегоПробела + 1, ЧислоСимволовДень); 
	Если СтрДлина(День) = 1 Тогда
		День = "0" + День;
	КонецЕсли;
	
	Попытка
		ДатаИзФайла = Дата("" + Год + Месяц + День);
	Исключение
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДатаИзФайла) Тогда
		Объект.ДатаЗагрузки = ДатаИзФайла;
	КонецЕсли;
	
КонецФункции

// ++ 02.05.2020
&НаСервере
Функция УжеЕстьДанныеЗаВыбраннуюДату()
	
	УжеЕстьДанные = Ложь;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки КАК ДатаЗагрузки
	|ИЗ
	|	РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК смартДополнительныеСтатусыГарантийныхЗапчастей
	|ГДЕ
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки = &ДатаЗагрузки";
	
	Запрос.УстановитьПараметр("ДатаЗагрузки", Объект.ДатаЗагрузки);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УжеЕстьДанные = НЕ РезультатЗапроса.Пустой();
	
	Возврат УжеЕстьДанные;
	
КонецФункции

&НаСервере
Процедура УдалитьСуществующиеЗаписи()
	
	НаборЗаписей = РегистрыСведений.смартДополнительныеСтатусыГарантийныхЗапчастей.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДатаЗагрузки.Установить(Объект.ДатаЗагрузки);
	НаборЗаписей.Прочитать();
	
	КоличествоЗаписей = НаборЗаписей.Количество();
	
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Удалено записей: " + КоличествоЗаписей);
	
КонецПроцедуры

