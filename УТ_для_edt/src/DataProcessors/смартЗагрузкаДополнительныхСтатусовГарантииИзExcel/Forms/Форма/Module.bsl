КонецПроцедуры

// ++ 26.04.2020
&НаСервере
Функция СформироватьТабличныйДокументСравнения()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = Обработки.смартЗагрузкаДополнительныхСтатусовГарантииИзExcel.ПолучитьМакет("Отличия");
	
	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьТекстЗапросаОтчетОСравнении();
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДаты = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать();
	ВыборкаДаты.Следующий();
	ПредыдущаяДата = ВыборкаДаты.ПредыдущаяДата;
	АктуальнаяДата = ВыборкаДаты.АктуальнаяДата;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЛегенда = Макет.ПолучитьОбласть("Легенда");
	ОбластьОтсутствующиеЗаявки = Макет.ПолучитьОбласть("ОтсутствующиеВБазеЗаявки");
	
	// ++ 23.11.2020
	ОбластьОтсутствующиеВБазеАртикулы = Макет.ПолучитьОбласть("ОтсутствующиеВБазеАртикулы");
	ОтсутствующиеВБазеАртикулыСоответствие = Новый Соответствие; // Номер заявки - массив артикулов
	// --
	
	ОбластьШапка.Параметры.ПредыдущаяДата = ПредыдущаяДата;
	ОбластьШапка.Параметры.АктуальнаяДата = АктуальнаяДата;
	ТабДок.Вывести(ОбластьШапка);
	
	Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
	
	МассивОтсутствующихЗаявок = Новый Массив;
	НомераОтсутствующихЗаявокСтрока = "";
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ВидСтроки = 1 Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("ДобавиласьСтрока");
		ИначеЕсли Выборка.ВидСтроки = 2 Тогда 
			ОбластьСтрока = Макет.ПолучитьОбласть("УдалиласьСтрока");
		ИначеЕсли Выборка.ВидСтроки = 3 Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("ИзменилсяСтатус");
		ИначеЕсли Выборка.ВидСтроки = 4 Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("ИзменилосьРешение");
		ИначеЕсли Выборка.ВидСтроки = 5 Тогда
			ОбластьСтрока = Макет.ПолучитьОбласть("ИзменилисьСтатусИРешение");
		// ++ 23.11.200
		ИначеЕсли Выборка.ВидСтроки = 6 Тогда // Артикулы, по которым не нашлось номенклатуры
			
			МассивИзСоответствия = ОтсутствующиеВБазеАртикулыСоответствие.Получить(Выборка.WarrApp_PreNo);
			
			Если МассивИзСоответствия = Неопределено Тогда
				МассивИзСоответствия = Новый Массив;
			КонецЕсли;
			
			Если МассивИзСоответствия.Найти(Выборка.Itemcode) = Неопределено Тогда
				МассивИзСоответствия.Добавить(Выборка.Itemcode);
			КонецЕсли;
			
			ОтсутствующиеВБазеАртикулыСоответствие.Вставить(Выборка.WarrApp_PreNo, МассивИзСоответствия);
			
			Продолжить;
		// --
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
		
		Если Выборка.ЗаявкаОтсутствуетВПредыдущейЗагрузке И ЗначениеЗаполнено(Выборка.WarrApp_PreNo1) Тогда
			ОбластьСтрока.Область(1, 6).ЦветФона = Новый Цвет(255, 225, 0);
		КонецЕсли;
		
		Если Выборка.ЗаявкаОтсутствуетВБазе И ЗначениеЗаполнено(Выборка.WarrApp_PreNo1) Тогда
			Если МассивОтсутствующихЗаявок.Найти(Выборка.WarrApp_PreNo1) = Неопределено Тогда
				МассивОтсутствующихЗаявок.Добавить(Выборка.WarrApp_PreNo1);
			КонецЕсли;
		КонецЕсли;

		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	
	ТабДок.Вывести(ОбластьЛегенда);
	
	Для Каждого НомерЗаявки Из МассивОтсутствующихЗаявок Цикл
		НомераОтсутствующихЗаявокСтрока = НомераОтсутствующихЗаявокСтрока 
			+ ?(ЗначениеЗаполнено(НомераОтсутствующихЗаявокСтрока), ", ", "") 
			+ НомерЗаявки;
	КонецЦикла;
	
	ОбластьОтсутствующиеЗаявки.Параметры.ОтсутствующиеВБазеЗаявки = НомераОтсутствующихЗаявокСтрока;
	ТабДок.Вывести(ОбластьОтсутствующиеЗаявки);
	
	// ++ 23.11.2020
	ОтсутствующиеВБазеАртикулыТекст = "";
	Для Каждого ЭлементСоответствия Из ОтсутствующиеВБазеАртикулыСоответствие Цикл
		
		СписокАртикулов = "";
		Для Каждого ТекАртикул Из ЭлементСоответствия.Значение Цикл
			СписокАртикулов = СписокАртикулов + ?(ЗначениеЗаполнено(СписокАртикулов), ", ", "") + ТекАртикул;
		КонецЦикла;
		
		ОтсутствующиеВБазеАртикулыТекст = ОтсутствующиеВБазеАртикулыТекст + ?(ЗначениеЗаполнено(ОтсутствующиеВБазеАртикулыТекст), Символы.ПС, "")
		+ ЭлементСоответствия.Ключ + ": " + СписокАртикулов;
	КонецЦикла;
	
	ОбластьОтсутствующиеВБазеАртикулы.Параметры.ОтсутствующиеВБазеАртикулы = ОтсутствующиеВБазеАртикулыТекст;
	ТабДок.Вывести(ОбластьОтсутствующиеВБазеАртикулы);
	// --
	
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
	
КонецФункции

// ++ 26.04.2020
&НаСервереБезКонтекста
Функция СформироватьТекстЗапросаОтчетОСравнении()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки) КАК АктуальнаяДата
	|ПОМЕСТИТЬ ВТ_АктуальнаяДата
	|ИЗ
	|	РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК смартДополнительныеСтатусыГарантийныхЗапчастей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки) КАК ПредыдущаяДата
	|ПОМЕСТИТЬ ВТ_ПредыдущаяДата
	|ИЗ
	|	ВТ_АктуальнаяДата КАК ВТ_АктуальнаяДата
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартДополнительныеСтатусыГарантийныхЗапчастей КАК смартДополнительныеСтатусыГарантийныхЗапчастей
	|		ПО ВТ_АктуальнаяДата.АктуальнаяДата > смартДополнительныеСтатусыГарантийныхЗапчастей.ДатаЗагрузки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.НомерСтрокиВФайле КАК НомерСтрокиВФайле,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.НомерЗаявки КАК НомерЗаявки,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.Артикул КАК Артикул,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.Статус КАК Статус,
	|	смартДополнительныеСтатусыГарантийныхЗапчастей.РешениеПоставщика КАК РешениеПоставщика
	|ПОМЕСТИТЬ ВТ_ВсеПредыдущиеДанные
	|ИЗ
