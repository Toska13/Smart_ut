          <currentRowUse>Auto</currentRowUse>
        </extInfo>
      </items>
      <items xsi:type="form:FormGroup">
        <name>ГруппаЗаполнитьУровниДоступа</name>
        <id>413</id>
        <items xsi:type="form:Button">
          <name>ЗаполнитьУровниДоступа</name>
          <id>415</id>
          <title>
            <key>ru</key>
            <value>Заполнить уровни доступа</value>
          </title>
          <title>
            <key>en</key>
            <value>Fill in permission access levels</value>
          </title>
          <visible>true</visible>
          <enabled>true</enabled>
          <userVisible>
            <common>true</common>
          </userVisible>
          <extendedTooltip>
            <name>ЗаполнитьУровниДоступаРасширеннаяПодсказка</name>
            <id>416</id>
            <title>
              <key>ru</key>
              <value>Открывает обработку для групповой установки уровней доступа клиентам и пользователям.</value>
            </title>
            <title>
              <key>en</key>
              <value>Opens processing for group setting of access levels to customers and users.</value>
            </title>
            <type>Label</type>
            <width>40</width>
            <autoMaxWidth>true</autoMaxWidth>
            <autoMaxHeight>true</autoMaxHeight>
            <extInfo xsi:type="form:LabelDecorationExtInfo">
