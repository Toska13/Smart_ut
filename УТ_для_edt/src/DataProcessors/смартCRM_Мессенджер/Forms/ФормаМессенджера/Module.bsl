&НаКлиенте
Процедура Диалог_Файлы(Команда)
	ОкноБраузера.showFiles();
	Если Не ФайлыВыведены Тогда
		ОкноБраузера.addFiles(ПолучитьФайлыВДиалоге(ТекущийДиалог));
		ФайлыВыведены = Истина;
