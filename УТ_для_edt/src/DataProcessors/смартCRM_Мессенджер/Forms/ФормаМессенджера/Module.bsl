&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	ПериодОбновления = 5;
	Если Параметры.Свойство("Ключ") Тогда
		ТекущаяГруппа = Параметры.Ключ.Группа;
