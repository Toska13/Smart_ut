    <id>22</id>
    <items xsi:type="form:FormGroup">
      <name>ГруппаСераяЗона</name>
      <id>36</id>
      <items xsi:type="form:FormField">
        <name>ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП</name>
        <id>27</id>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <dataPath xsi:type="form:DataPath">
          <segments>ПроверятьПотребительскиеУпаковкиНаВхождениеВСеруюЗонуМОТП</segments>
        </dataPath>
