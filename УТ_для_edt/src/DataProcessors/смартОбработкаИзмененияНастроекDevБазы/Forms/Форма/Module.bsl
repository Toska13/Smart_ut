Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьПараметрыПочтыДляУстановки();
	ЗаполнитьПараметрыСМСДляУстановки();
	ЗаполнитьПараметрыОбменаССайтомДляУстановки();
	ЗаполнитьПараметрыСинхронизацииДляУстановки();
	
