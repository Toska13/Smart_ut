КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоТЧ(Строка,СписокРеквизитов)
	Для Каждого ТЧ Из СписокРеквизитов Цикл
		ЗаполнитьТЧ(Строка, ТЧ);
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧ(Строка,ТЧ)
	НовСтрока=Строка.Добавить();
	НовСтрока.Реквизит=ТЧ.Имя;
	НовСтрока.ТипРеквизита = "(ТабличнаяЧасть)";
	НовСтрока.ЭтоТабличнаяЧасть = ИСТИНА;
	НовСтрока.РеквизитПредставление=ТЧ.Синоним+" (табличная часть)";
	//НовСтрока.РеквизитКартинка = БиблиотекаКартинок.Папка;	
	НовСтрока.ИндексКартинки = 2;	
	
	ВеткаРодителя = НовСтрока.ПолучитьРодителя();
	Если ВеткаРодителя = Неопределено Тогда 
		НовСтрока.ПолноеИмя=ТЧ.Имя;
	Иначе
		НовСтрока.ПолноеИмя=ВеткаРодителя.ПолноеИмя + ?(ЗначениеЗаполнено(ВеткаРодителя.ПолноеИмя),".","") + ТЧ.Имя;
	КонецЕсли;

	ЗаполнитьПоСпискуРеквизитов(НовСтрока.ПолучитьЭлементы(),ТЧ.Реквизиты, ИСТИНА);
КонецПроцедуры	

