&НаКлиенте
Процедура ВыбранныеПоляПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив") Тогда
		
		Для Каждого ВеткаДерева Из ПараметрыПеретаскивания.Значение Цикл
			СтрокаВыбранныеПоля = ВыбранныеПоля.Добавить();
			СтрокаВыбранныеПоля.Поле = ?(ВеткаДерева.ЭтоТабличнаяЧасть, "гвсу_ТабЧасть"+ВеткаДерева.ПолноеИмя, ВеткаДерева.ПолноеИмя);
			
			УстановитьПолеФорматированное(СтрокаВыбранныеПоля);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

