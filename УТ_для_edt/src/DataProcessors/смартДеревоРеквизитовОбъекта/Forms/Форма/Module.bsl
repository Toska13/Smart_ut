&НаСервере
Процедура ЗаполнитьПоСпискуРеквизитов(Строка,СписокРеквизитов, ЭтоТабличнаяЧасть = Ложь)
	
	Для Каждого Рекв Из СписокРеквизитов Цикл
		НовСтрока=Строка.Добавить();
		НовСтрока.Реквизит=Рекв.Имя;
		Если ЗначениеЗаполнено(Рекв.Синоним) Тогда
			НовСтрока.Реквизитпредставление=Рекв.Синоним;
		Иначе	
			НовСтрока.Реквизитпредставление=Рекв.Имя;
		КонецЕсли; 
		НовСтрока.ТипРеквизита=Рекв.Тип;
		НовСтрока.ЭтоТабличнаяЧасть=ЭтоТабличнаяЧасть;
		
		ВеткаРодителя = НовСтрока.ПолучитьРодителя();
		Если ВеткаРодителя = Неопределено Тогда 
			НовСтрока.ПолноеИмя=Рекв.Имя;
		Иначе
			НовСтрока.ПолноеИмя=ВеткаРодителя.ПолноеИмя + ?(ЗначениеЗаполнено(ВеткаРодителя.ПолноеИмя),".","") + Рекв.Имя;
		КонецЕсли;
		
		Типы=Рекв.Тип.Типы();
		
		Есть=Ложь;
		Для К=0 По Типы.ВГраница() Цикл
			Если Справочники.ТипВсеСсылки().СодержитТип(Типы[К]) ИЛИ Документы.ТипВсеСсылки().СодержитТип(Типы[К]) Тогда 
				Нов=НовСтрока.ПолучитьЭлементы().Добавить();
				Нов.Реквизит="+++";
				Есть=Истина;
				НовСтрока.РеквизитСсылка=Рекв.Тип;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;	
КонецПроцедуры

