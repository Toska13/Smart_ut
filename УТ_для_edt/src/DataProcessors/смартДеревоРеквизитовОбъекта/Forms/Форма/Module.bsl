&НаСервере
Процедура КорягаПередРазворачиванием(Строка) Экспорт 
	
	Если Строка.ПолучитьЭлементы()[0].Реквизит = "+++" Тогда 
		Типы=Строка.РеквизитСсылка.Типы();
		Для К=0 По Типы.ВГраница() Цикл
			Если Справочники.ТипВсеСсылки().СодержитТип(Типы[К]) ИЛИ Документы.ТипВсеСсылки().СодержитТип(Типы[К]) Тогда 
				
				СписокРеквизитовСтандартные=Метаданные.НайтиПоТипу(Типы[К]).СтандартныеРеквизиты;
				ЗаполнитьДеревоСтандартные(Строка.ПолучитьЭлементы(), СписокРеквизитовСтандартные);
				
				СписокРеквизитов=Метаданные.НайтиПоТипу(Типы[К]).Реквизиты;
				ЗаполнитьДерево(Строка.ПолучитьЭлементы(),СписокРеквизитов);
				
				//// Табличные части
				СписокТабличныхЧастей=Метаданные.НайтиПоТипу(Типы[К]).ТабличныеЧасти;
				ЗаполнитьДеревоТЧ(Строка.ПолучитьЭлементы(), СписокТабличныхЧастей);

			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	//УстановитьКартинкиКоряги(Коряга);
КонецПроцедуры


