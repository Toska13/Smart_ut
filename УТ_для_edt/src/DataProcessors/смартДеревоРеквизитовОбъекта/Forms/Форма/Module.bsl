&НаКлиенте
Процедура УстановитьПолеФорматированное(ТекущаяСтрока)
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ФорматВывода) Тогда 
		
		ТекущаяСтрока.ПолеФорматированное = ТекущаяСтрока.Поле +"(" + ТекущаяСтрока.ФорматВывода + ")";
	Иначе
		
		ТекущаяСтрока.ПолеФорматированное = ТекущаяСтрока.Поле;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ВыбранныеПоля.ТекущиеДанные;
	
	Конструктор=Новый КонструкторФорматнойСтроки();
	Конструктор.ОткрытьМодально();
	
	Если НЕ ЗначениеЗаполнено(Конструктор.Текст) И  ЗначениеЗаполнено(ТекущаяСтрока.ФорматВывода) Тогда 
		
		Ответ = Вопрос(
		НСтр("ru = 'Форматная строка не задана. Очистить текущее значение?'"),
		РежимДиалогаВопрос.ДаНет);
		
		Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяСтрока.ФорматВывода = Конструктор.Текст;
	
	УстановитьПолеФорматированное(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРеквизитовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	РезультатСтруктура = Новый Структура;
	РезультатСтруктура.Вставить("ПолноеИмяРеквизита", Элемент.ТекущиеДанные.ПолноеИмя);
	РезультатСтруктура.Вставить("ТипРеквизита", Элемент.ТекущиеДанные.ТипРеквизита);
	РезультатСтруктура.Вставить("ПредставлениеРеквизита", Элемент.ТекущиеДанные.РеквизитПредставление);
	РезультатСтруктура.Вставить("ЭтоТабличнаяЧасть", Элемент.ТекущиеДанные.ЭтоТабличнаяЧасть);
	
	Закрыть(РезультатСтруктура);
	
КонецПроцедуры


