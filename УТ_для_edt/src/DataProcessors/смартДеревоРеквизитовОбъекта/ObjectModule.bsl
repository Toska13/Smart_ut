Функция ПолучитьПоляМетаданного(ТекущийОбъект)

	//КС = Новый КвалификаторыСтроки(20);
	//	Массив.Добавить(Тип("Строка"));
	//ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	//ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ТекущийОбъект));
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТекущийОбъект);
	
	СписокРеквизитов = Новый СписокЗначений;
	Если Не ОбъектМетаданных = Неопределено Тогда
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			//Если Реквизит.Тип = ТИП("Булево") Тогда 
				СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Синоним);
			//КонецЕсли;	
		КонецЦикла;
		Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			//Если Реквизит.Тип = ТИП("Булево") Тогда 
				СписокРеквизитов.Добавить(Реквизит.Имя, Реквизит.Имя);
			//КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	 
	Возврат СписокРеквизитов;
	
КонецФункции

Процедура ПоляОбъектаВДерево(СтрокаДерева, СписокПолей, КоличествоУровней)
	
	//ДочерниеСтроки = ТекущиеДанные.ПолучитьЭлементы();
	Для каждого РеквизитОбъекта Из СписокПолей Цикл
		
		ТекущаяСтрокаДерева = СтрокаДерева.Строки.Добавить();
		ТекущаяСтрокаДерева.ДоступныеПоля = РеквизитОбъекта;
		//ЗаполнитьЗначенияСвойств(ТекущаяСтрокаДерева, РеквизитОбъекта);
		
		// Превышено количество вложенных уровней дерева
		Если ТекущаяСтрокаДерева.Уровень() > КоличествоУровней Тогда 
			Возврат;
		КонецЕсли;	
		
		СписокПолейВложенных = ПолучитьПоляМетаданного(ТипЗнч(РеквизитОбъекта));
		ПоляОбъектаВДерево(ТекущаяСтрокаДерева, СписокПолейВложенных, КоличествоУровней);
		
		
	КонецЦикла;
	
КонецПроцедуры

