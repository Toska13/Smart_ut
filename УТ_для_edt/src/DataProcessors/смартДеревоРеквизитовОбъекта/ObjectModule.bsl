Процедура ЗаполнитьПоСпискуРеквизитов(Строка,СписокРеквизитов)
	
	Для Каждого Рекв Из СписокРеквизитов Цикл
		НовСтрока=Строка.Строки.Добавить();
		НовСтрока.Реквизит=Рекв.Имя;
		НовСтрока.Реквизитпредставление=Рекв.Синоним;
		НовСтрока.ТипРеквизита=Рекв.Тип;
		Если ТипЗнч(Строка)=Тип("ДеревоЗначений") Тогда
			НовСтрока.ПолноеИмя=Рекв.Имя;
		Иначе
			НовСтрока.ПолноеИмя=Строка.ПолноеИмя + ?(ЗначениеЗаполнено(Строка.ПолноеИмя),".","") + Рекв.Имя;
		КонецЕсли;
		Типы=Рекв.Тип.Типы();
		
		Есть=Ложь;
		Для К=0 По Типы.ВГраница() Цикл
			Если Справочники.ТипВсеСсылки().СодержитТип(Типы[К]) ИЛИ Документы.ТипВсеСсылки().СодержитТип(Типы[К]) Тогда 
				Нов=НовСтрока.Строки.Добавить();
				Нов.Реквизит="+++";
				Есть=Истина;
				НовСтрока.РеквизитСсылка=Рекв;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаполнитьДерево(Строка,СписокРеквизитов)
	Строка.Строки.Очистить();
	ЗаполнитьПоСпискуРеквизитов(Строка,СписокРеквизитов);
КонецПроцедуры

Процедура ЗаполнитьТЧ(Строка,ТЧ)
	НовСтрока=Строка.Строки.Добавить();
	НовСтрока.Реквизит=ТЧ.Имя;
	НовСтрока.ТипРеквизита = "(ТабличнаяЧасть)";
	НовСтрока.РеквизитПредставление=ТЧ.Синоним+" (табличная часть)";
	ЗаполнитьПоСпискуРеквизитов(НовСтрока,ТЧ.Реквизиты);
КонецПроцедуры	

// ОБработка раскрытия ветки дерева
Процедура КорягаПередРазворачиванием(Строка) Экспорт 
	
	Если Строка.Строки[0].Реквизит="+++" Тогда
		Типы=Строка.РеквизитСсылка.Тип.Типы();
		Для К=0 По Типы.ВГраница() Цикл
			Если Справочники.ТипВсеСсылки().СодержитТип(Типы[К]) ИЛИ Документы.ТипВсеСсылки().СодержитТип(Типы[К]) Тогда 
				СписокРеквизитов=Метаданные.НайтиПоТипу(Типы[К]).Реквизиты;
				ЗаполнитьДерево(Строка,СписокРеквизитов);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
	//УстановитьКартинкиКоряги(Коряга);
КонецПроцедуры
