#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ПолучитьДанныеЗаголовковДинамическихСписков(ПараметрыВыполнения, АдресХранилища) Экспорт
	
	ДанныеКолонок = ПараметрыВыполнения.ДанныеКолонок;
	
	Результат = Новый Структура;
	
	Для Каждого КлючИЗначение Из ДанныеКолонок Цикл
		
		ИмяСписка = КлючИЗначение.Ключ;
		Если ИмяСписка = "НеРазобраноСводныеДанные" Тогда
			ДанныеЗаголовка = СводныеДанныеКолонкиНеРазобрано(КлючИЗначение.Значение);
		Иначе
			ДанныеЗаголовка = ДанныеЗаголовкаДинамическогоСписка(ИмяСписка, КлючИЗначение.Значение);
		КонецЕсли;
		Результат.Вставить(ИмяСписка, ДанныеЗаголовка);
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Результат, АдресХранилища);
	
КонецПроцедуры

Функция ДанныеЗаголовкаДинамическогоСписка(ИмяСписка, Параметры)
	
	СхемаКомпоновкиДанных = Параметры.СхемаКомпоновкиДанных;
	НастройкиКомпоновкиДанных = Параметры.НастройкиКомпоновкиДанных;
	НаименованиеСписка = Параметры.НаименованиеСписка;
	ВалютаПредставление = Параметры.ВалютаПредставление;
	
	ДанныеЗаголовка = Новый Структура;
	ДанныеЗаголовка.Вставить("Название", НаименованиеСписка);
	
	ДанныеСтрок = ДанныеДинамическогоСписка(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных);
	Количество = ДанныеСтрок.Количество();
	Если ИмяСписка = "Этап_НеРазобрано" Тогда
		Сумма = 0;
	Иначе
		Сумма = ДанныеСтрок.Итог("ОжидаемаяВыручка");
	КонецЕсли;
	
	Если Количество = 0 Тогда
		Если ИмяСписка = "Этап_НеРазобрано" Тогда
			ЗаголовокКоличество = НСтр("ru = 'Нет обращений'");
			ЗаголовокСумма = "0";
		Иначе
			ЗаголовокКоличество = НСтр("ru = 'Нет интересов'");
			ЗаголовокСумма = "0";
		КонецЕсли;
	Иначе
		СтрокаКоличествоСделок = Формат(Количество, "ЧДЦ=; ЧН=0; ЧГ=");
		Если ИмяСписка = "Этап_НеРазобрано" Тогда
			СтрокаЗаголовка = ЧислоПрописью(СтрокаКоличествоСделок, "Л=" + НСтр("ru='ru_RU';en='en_US'") 
				+ ";НД=Ложь", НСтр("ru='обращение, обращения, обращений,
				| с'"));
			СтрокаЗаголовкаТМП = ЧислоПрописью(СтрокаКоличествоСделок, "Л=" + НСтр("ru='ru_RU';en='en_US'") 
				+ ";НД=Ложь;НП=Ложь", НСтр("ru='обращение, обращения, обращений,
				| с'"));
		Иначе
			СтрокаЗаголовка = ЧислоПрописью(СтрокаКоличествоСделок, "Л=" + НСтр("ru='ru_RU';en='en_US'") 
				+ ";НД=Ложь", НСтр("ru='интерес, интереса, интересов,
				| м'"));
			СтрокаЗаголовкаТМП = ЧислоПрописью(СтрокаКоличествоСделок, "Л=" + НСтр("ru='ru_RU';en='en_US'") 
				+ ";НД=Ложь;НП=Ложь", НСтр("ru='интерес, интереса, интересов,
				| м'"));
		КонецЕсли;
		СтрокаЗаголовкаТМП = СокрЛП(СтрЗаменить(СтрокаЗаголовкаТМП, "00", ""));
		СтрокаЗаголовка = СокрЛП(СтрЗаменить(СтрокаЗаголовка, "00", ""));
		ЗаголовокКоличество = СокрЛП(СтрЗаменить(СтрокаЗаголовка, СтрокаЗаголовкаТМП, СтрокаКоличествоСделок));
		ЗаголовокСумма = ?(Сумма = 0, "0", Формат(Сумма, "ЧДЦ=; ЧН=0; ЧГ=3,0"));
	КонецЕсли;
	
	Если ИмяСписка <> "Этап_НеРазобрано" Тогда
		ЗаголовокКоличество = ЗаголовокКоличество + ":";
	КонецЕсли;
	
	ДанныеЗаголовка.Вставить("Сумма", ЗаголовокКоличество);
	ДанныеЗаголовка.Вставить("Сумма1", ЗаголовокСумма + " " + ВалютаПредставление);
	
	Возврат ДанныеЗаголовка;
	
КонецФункции

Функция СводныеДанныеКолонкиНеРазобрано(Параметры)
	
	СхемаКомпоновкиДанных = Параметры.СхемаКомпоновкиДанных;
	НастройкиКомпоновкиДанных = Параметры.НастройкиКомпоновкиДанных;
	
	ДанныеСтрок = ДанныеДинамическогоСписка(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных);
	
	ДанныеЗаголовка = Новый Структура;
	Всего = 0;
	Для Каждого Строка Из ДанныеСтрок Цикл
		Если ЗначениеЗаполнено(Строка.Светофор) Тогда
			ДанныеЗаголовка.Вставить(Строка.Светофор, Строка.Количество);
			Всего = Всего + Строка.Количество;
		КонецЕсли;
	КонецЦикла;
	ДанныеЗаголовка.Вставить("Всего", Всего);
	
	Возврат ДанныеЗаголовка;
	
КонецФункции

Функция ДанныеДинамическогоСписка(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных)
	
	ДанныеСписка = Новый Структура;
	
	РезультатКомпоновки = Новый ТаблицаЗначений;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновкиДанных, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(РезультатКомпоновки);
	Процессорвывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат РезультатКомпоновки;
	
КонецФункции

#КонецОбласти

#КонецЕсли

