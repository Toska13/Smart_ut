  <attributes>
    <name>НеРазобрано</name>
    <title>
      <key>ru</key>
      <value>Не разобрано</value>
    </title>
    <title>
      <key>en</key>
      <value>Not parsed</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>НеРазобрано.Контакт</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>НеРазобрано.КонтактАдрес</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>НеРазобрано.Пользователь</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>НеРазобрано.Телефон</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>НеРазобрано.Ответственный</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	&quot;СписокПолей_Начало&quot; КАК СписокПолей_Начало,
	Обращения.Объект КАК Ссылка,
	Обращения.Заголовок КАК Заголовок,
	Обращения.Ответственный КАК Ответственный,
	&quot;&quot; КАК ПустаяЯчейка,
	ВЫБОР
		КОГДА Обращения.СмещениеДатыЗаполнено
			ТОГДА ДОБАВИТЬКДАТЕ(Обращения.Дата, СЕКУНДА, -Обращения.СмещениеДаты + &amp;CRM_СмещениеДатыТекущегоСеанса)
		ИНАЧЕ Обращения.Дата
	КОНЕЦ КАК ДатаДляСортировки,
	ВЫБОР
		КОГДА Обращения.СмещениеДатыЗаполнено
			ТОГДА ДОБАВИТЬКДАТЕ(Обращения.Дата, СЕКУНДА, -Обращения.СмещениеДаты + &amp;CRM_СмещениеДатыТекущегоСеанса)
		ИНАЧЕ Обращения.Дата
	КОНЕЦ КАК КрайнийСрок,
	ЕСТЬNULL(CRM_СрокиОбработкиОбращений.СрокОбработки, ВЫБОР
			КОГДА Обращения.СмещениеДатыЗаполнено
				ТОГДА ДОБАВИТЬКДАТЕ(Обращения.Дата, СЕКУНДА, -Обращения.СмещениеДаты + &amp;CRM_СмещениеДатыТекущегоСеанса)
			ИНАЧЕ Обращения.Дата
		КОНЕЦ) КАК КрайнийСрокОкончание,
	Обращения.Избранный КАК Избранный,
	ВЫБОР
		КОГДА Обращения.Избранный
			ТОГДА 0
		ИНАЧЕ -1
	КОНЕЦ КАК ИзбранныйИндексКартинки,
	СостоянияОбращений.Описание КАК ТекстОснования,
	ВЫБОР
		КОГДА Обращения.Объект ССЫЛКА Документ.ЭлектронноеПисьмоВходящее
			ТОГДА 1 + ВЫБОР
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
						ТОГДА 5
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
						ТОГДА 23
					ИНАЧЕ 9
				КОНЕЦ
		КОГДА Обращения.Объект ССЫЛКА Документ.ЭлектронноеПисьмоИсходящее
			ТОГДА 1 + ВЫБОР
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
						ТОГДА 5
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
						ТОГДА 24
					ИНАЧЕ 10
				КОНЕЦ
		КОГДА Обращения.Объект ССЫЛКА Документ.ТелефонныйЗвонок
			ТОГДА 3 + ВЫБОР
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
						ТОГДА 5
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
						ТОГДА 14
					ИНАЧЕ 0
				КОНЕЦ + ВЫБОР
					КОГДА Обращения.Звонок_Состояние = ЗНАЧЕНИЕ(Перечисление.сфпСостоянияЗвонков.Пропущенный)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ
		КОГДА Обращения.Объект ССЫЛКА Документ.CRM_Заявка
			ТОГДА 2 + ВЫБОР
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
						ТОГДА 5
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
						ТОГДА 14
					ИНАЧЕ 0
				КОНЕЦ
		КОГДА Обращения.Объект ССЫЛКА Справочник.CRM_Диалоги
			ТОГДА 0 + ВЫБОР
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Повторный)
						ТОГДА 5
					КОГДА СостоянияОбращений.Состояние = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияЛидов.Новый)
						ТОГДА 14
					ИНАЧЕ 0
				КОНЕЦ
	КОНЕЦ КАК ВидКартинки,
	ВЫБОР
		КОГДА Обращения.Объект ССЫЛКА Документ.ТелефонныйЗвонок
			ТОГДА ВЫРАЗИТЬ(ВЫБОР
						КОГДА Обращения.Звонок_Состояние = ЗНАЧЕНИЕ(Перечисление.сфпСостоянияЗвонков.Пропущенный)
							ТОГДА &amp;СтрокаПропущенныйТелефонныйЗвонок
						ИНАЧЕ &amp;СтрокаТелефонныйЗвонок
					КОНЕЦ КАК СТРОКА(200))
		ИНАЧЕ Обращения.КаналПолучения
	КОНЕЦ КАК КаналПолучения,
	Обращения.КаналПолучения КАК КаналПолученияСсылка,
	CRM_СрокиОбработкиОбращений.СрокОбработки КАК СрокОбработки,
	ВЫБОР
		КОГДА (ВЫРАЗИТЬ(РАЗНОСТЬДАТ(&amp;ТекущаяДата, CRM_СрокиОбработкиОбращений.СрокОбработки, ЧАС) / 24 - 0.5 КАК ЧИСЛО(10, 0))) &lt; 0
			ТОГДА (ВЫРАЗИТЬ(РАЗНОСТЬДАТ(&amp;ТекущаяДата, CRM_СрокиОбработкиОбращений.СрокОбработки, ЧАС) / 24 - 0.5 КАК ЧИСЛО(10, 0))) + 1
		ИНАЧЕ ВЫРАЗИТЬ(РАЗНОСТЬДАТ(&amp;ТекущаяДата, CRM_СрокиОбработкиОбращений.СрокОбработки, ЧАС) / 24 - 0.5 КАК ЧИСЛО(10, 0))
	КОНЕЦ КАК СрокДней,
	ВЫБОР
		КОГДА &amp;ТекущаяДата &lt;= CRM_СрокиОбработкиОбращений.СрокОбработки
			ТОГДА ДОБАВИТЬКДАТЕ(&amp;ПустаяДата, МИНУТА, РАЗНОСТЬДАТ(&amp;ТекущаяДата, CRM_СрокиОбработкиОбращений.СрокОбработки, МИНУТА))
		ИНАЧЕ ДОБАВИТЬКДАТЕ(&amp;ПустаяДата, МИНУТА, -РАЗНОСТЬДАТ(&amp;ТекущаяДата, CRM_СрокиОбработкиОбращений.СрокОбработки, МИНУТА))
	КОНЕЦ КАК СрокВремя,
	ВЫБОР
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки ЕСТЬ NULL
			ТОГДА -1
		ИНАЧЕ 0
	КОНЕЦ КАК СрокКартинка,
	ВЫБОР
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки &lt; &amp;ТекущаяДата
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Просрочено,
	ВЫБОР
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки ЕСТЬ NULL
			ТОГДА &quot;Прочие&quot;
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки &lt; &amp;ТекущаяДата
				И CRM_СрокиОбработкиОбращений.СрокОбработки > &amp;ПустаяДата
			ТОГДА &quot;Просрочено&quot;
		КОГДА CRM_СрокиОбработкиОбращений.СрокОбработки &lt; &amp;ПериодТекущих
				И CRM_СрокиОбработкиОбращений.СрокОбработки > &amp;ПустаяДата
			ТОГДА &quot;Сегодня&quot;
		ИНАЧЕ &quot;ВОжидании&quot;
	КОНЕЦ КАК Светофор,
	1 КАК Количество,
	&quot;СписокПолей_Окончание&quot; КАК СписокПолей_Окончание
ИЗ
	РегистрСведений.CRM_ОбъектыАРМ_Обращения КАК Обращения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СостоянияЛидов КАК СостоянияОбращений
		ПО (СостоянияОбращений.Лид = Обращения.Объект)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_СрокиОбработкиОбращений КАК CRM_СрокиОбработкиОбращений
		ПО Обращения.Объект = CRM_СрокиОбработкиОбращений.Обращение
ГДЕ
	Обращения.ВидКанала В(&amp;ВидыКаналов)
	И (&amp;БезСценария
			ИЛИ Обращения.КаналПолучения В (&amp;ИсточникиЛидов))
{ГДЕ
	Обращения.Ответственный В(&amp;Пользователь),
	(СостоянияОбращений.Состояние = &amp;СостояниеЛидов),
	(НЕ Обращения.Звонок_Состояние В (&amp;СкрываемыеЗвонки))}</queryText>
      <mainTable>InformationRegister.CRM_ОбъектыАРМ_Обращения</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ТекущийЭтап</name>
    <id>6</id>
    <valueType>
      <types>String</types>
      <stringQualifiers/>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>СписокВиджетовПользователя</name>
    <id>7</id>
    <valueType>
      <types>ValueList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:ValueListExtInfo">
      <itemValueType/>
    </extInfo>
  </attributes>
  <attributes>
    <name>КоличествоВиджетовНаФорме</name>
    <id>8</id>
    <valueType>
      <types>Number</types>
      <numberQualifiers>
        <precision>2</precision>
        <nonNegative>true</nonNegative>
      </numberQualifiers>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>ИмяЭлементаЗавершенные</name>
    <id>10</id>
    <valueType>
      <types>String</types>
      <stringQualifiers/>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>ТаблицаУспешно</name>
    <title>
      <key>ru</key>
      <value>Таблица успешно</value>
    </title>
    <title>
      <key>en</key>
      <value>Table successfully</value>
    </title>
    <id>12</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	CRM_ОбъектыАРМ.Объект КАК Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ КАК НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса КАК СостояниеИнтереса,
	МАКСИМУМ(CRM_ОбъектыАРМ.Пользователь) КАК Пользователь,
	МИНИМУМ(CRM_ОбъектыАРМ.Соисполнение) КАК Соисполнение
ПОМЕСТИТЬ ОбъектыПользователя
ИЗ
	РегистрСведений.CRM_ОбъектыАРМ КАК CRM_ОбъектыАРМ
ГДЕ
	CRM_ОбъектыАРМ.НаименованиеАРМ = &quot;МоиПродажи&quot;
	И CRM_ОбъектыАРМ.ИзмерениеАРМ = &quot;&quot;
{ГДЕ
	CRM_ОбъектыАРМ.КрайнийСрок >= &amp;КрайнийСрокНачало И CRM_ОбъектыАРМ.КрайнийСрок &lt;= &amp;КрайнийСрокКонец,
	CRM_ОбъектыАРМ.СостояниеИнтереса В (&amp;СостояниеИнтереса),
	CRM_ОбъектыАРМ.Пользователь В(&amp;Пользователь)}

СГРУППИРОВАТЬ ПО
	CRM_ОбъектыАРМ.Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса

;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	CRM_ОбъектыАРМ.Объект КАК Объект,
	CRM_ОбъектыАРМ.КрайнийСрок КАК КрайнийСрок,
	CRM_ОбъектыАРМ.Заголовок КАК Заголовок,
	CRM_ОбъектыАРМ.ТекстОснования КАК ТекстОснования,
	CRM_ОбъектыАРМ.ДатаДляСортировки КАК ДатаДляСортировки,
	CRM_ОбъектыАРМ.День КАК День,
	CRM_ОбъектыАРМ.Время КАК Время,
	CRM_ОбъектыАРМ.ОписаниеИнтереса КАК ОписаниеИнтереса,
	&quot;&quot; КАК ПустаяЯчейка,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Партнер КАК Партнер,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Партнер.Наименование КАК ПартнерНаименование,
	CRM_ОбъектыАРМ.КрайнийСрок КАК КрайнийСрокОкончание,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ТипУслуги КАК ТипУслуги,
	ВложенныйЗапрос.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
	ВложенныйЗапрос.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
	CRM_ОбъектыАРМ.Объект.Проект КАК Проект,
	CRM_ОбъектыАРМ.Объект.Автор КАК Автор,
	ЕСТЬNULL(ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ОжидаемаяВыручка, 0) КАК ОжидаемаяВыручка,
	ЕСТЬNULL(ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ДатаЗакрытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ОбъектДатаЗакрытия
ИЗ
	РегистрСведений.CRM_ОбъектыАРМ КАК CRM_ОбъектыАРМ
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбъектыПользователя КАК ОбъектыПользователя
		ПО CRM_ОбъектыАРМ.Объект = ОбъектыПользователя.Объект
			И CRM_ОбъектыАРМ.Пользователь = ОбъектыПользователя.Пользователь
			И CRM_ОбъектыАРМ.НаименованиеАРМ = ОбъектыПользователя.НаименованиеАРМ
			И CRM_ОбъектыАРМ.СостояниеИнтереса = ОбъектыПользователя.СостояниеИнтереса
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИсточникиПервичногоИнтересаСрезПоследних.Период КАК Период,
			ИсточникиПервичногоИнтересаСрезПоследних.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
			ИсточникиПервичногоИнтересаСрезПоследних.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
			ИсточникиПервичногоИнтересаСрезПоследних.Сделка КАК Сделка
		ИЗ
			РегистрСведений.ИсточникиПервичногоИнтереса.СрезПоследних КАК ИсточникиПервичногоИнтересаСрезПоследних) КАК ВложенныйЗапрос
		ПО CRM_ОбъектыАРМ.Объект = ВложенныйЗапрос.Сделка
ГДЕ
	CRM_ОбъектыАРМ.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение)
</queryText>
      <mainTable>InformationRegister.CRM_ОбъектыАРМ</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ТаблицаНеудачно</name>
    <title>
      <key>ru</key>
      <value>Таблица успешно</value>
    </title>
    <title>
      <key>en</key>
      <value>Table successfully</value>
    </title>
    <id>13</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	CRM_ОбъектыАРМ.Объект КАК Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ КАК НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса КАК СостояниеИнтереса,
	МАКСИМУМ(CRM_ОбъектыАРМ.Пользователь) КАК Пользователь,
	МИНИМУМ(CRM_ОбъектыАРМ.Соисполнение) КАК Соисполнение
ПОМЕСТИТЬ ОбъектыПользователя
ИЗ
	РегистрСведений.CRM_ОбъектыАРМ КАК CRM_ОбъектыАРМ
ГДЕ
	CRM_ОбъектыАРМ.НаименованиеАРМ = &quot;МоиПродажи&quot;
	И CRM_ОбъектыАРМ.ИзмерениеАРМ = &quot;&quot;
{ГДЕ
	CRM_ОбъектыАРМ.КрайнийСрок >= &amp;КрайнийСрокНачало И CRM_ОбъектыАРМ.КрайнийСрок &lt;= &amp;КрайнийСрокКонец,
	CRM_ОбъектыАРМ.СостояниеИнтереса В (&amp;СостояниеИнтереса),
	CRM_ОбъектыАРМ.Пользователь В(&amp;Пользователь)}

СГРУППИРОВАТЬ ПО
	CRM_ОбъектыАРМ.Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса

;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	CRM_ОбъектыАРМ.Объект КАК Объект,
	CRM_ОбъектыАРМ.КрайнийСрок КАК КрайнийСрок,
	CRM_ОбъектыАРМ.Заголовок КАК Заголовок,
	CRM_ОбъектыАРМ.ТекстОснования КАК ТекстОснования,
	CRM_ОбъектыАРМ.ДатаДляСортировки КАК ДатаДляСортировки,
	CRM_ОбъектыАРМ.День КАК День,
	CRM_ОбъектыАРМ.Время КАК Время,
	CRM_ОбъектыАРМ.ОписаниеИнтереса КАК ОписаниеИнтереса,
	&quot;&quot; КАК ПустаяЯчейка,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Партнер КАК Партнер,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Партнер.Наименование КАК ПартнерНаименование,
	CRM_ОбъектыАРМ.КрайнийСрок КАК КрайнийСрокОкончание,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ТипУслуги КАК ТипУслуги,
	ВложенныйЗапрос.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
	ВложенныйЗапрос.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Проект КАК Проект,
	ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).Автор КАК Автор,
	ЕСТЬNULL(ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ОжидаемаяВыручка, 0) КАК ОжидаемаяВыручка,
	ЕСТЬNULL(ВЫРАЗИТЬ(CRM_ОбъектыАРМ.Объект КАК Документ.CRM_Интерес).ДатаЗакрытия, ДАТАВРЕМЯ(1, 1, 1)) КАК ОбъектДатаЗакрытия
ИЗ
	ОбъектыПользователя КАК ОбъектыПользователя
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ОбъектыАРМ КАК CRM_ОбъектыАРМ
		ПО CRM_ОбъектыАРМ.Объект = ОбъектыПользователя.Объект
			И CRM_ОбъектыАРМ.Пользователь = ОбъектыПользователя.Пользователь
			И CRM_ОбъектыАРМ.НаименованиеАРМ = ОбъектыПользователя.НаименованиеАРМ
			И CRM_ОбъектыАРМ.СостояниеИнтереса = ОбъектыПользователя.СостояниеИнтереса
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ИсточникиПервичногоИнтересаСрезПоследних.Период КАК Период,
			ИсточникиПервичногоИнтересаСрезПоследних.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
			ИсточникиПервичногоИнтересаСрезПоследних.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
			ИсточникиПервичногоИнтересаСрезПоследних.Сделка КАК Сделка
		ИЗ
			РегистрСведений.ИсточникиПервичногоИнтереса.СрезПоследних КАК ИсточникиПервичногоИнтересаСрезПоследних) КАК ВложенныйЗапрос
		ПО CRM_ОбъектыАРМ.Объект = ВложенныйЗапрос.Сделка
ГДЕ
	CRM_ОбъектыАРМ.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
</queryText>
      <mainTable>InformationRegister.CRM_ОбъектыАРМ</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
