    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	CRM_ОбъектыАРМ.Объект КАК Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ КАК НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса КАК СостояниеИнтереса,
	МАКСИМУМ(CRM_ОбъектыАРМ.Пользователь) КАК Пользователь,
	МИНИМУМ(CRM_ОбъектыАРМ.Соисполнение) КАК Соисполнение
ПОМЕСТИТЬ ОбъектыПользователя
ИЗ
	РегистрСведений.CRM_ОбъектыАРМ КАК CRM_ОбъектыАРМ
ГДЕ
	CRM_ОбъектыАРМ.НаименованиеАРМ = &quot;МоиПродажи&quot;
	И НЕ CRM_ОбъектыАРМ.СостояниеИнтереса.Завершено
{ГДЕ
	CRM_ОбъектыАРМ.КрайнийСрок &lt;= &amp;КрайнийСрок,
	CRM_ОбъектыАРМ.Пользователь В(&amp;Пользователь)}

СГРУППИРОВАТЬ ПО
	CRM_ОбъектыАРМ.Объект,
	CRM_ОбъектыАРМ.НаименованиеАРМ,
	CRM_ОбъектыАРМ.СостояниеИнтереса
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	Интерес.Ссылка КАК Объект,
	Интерес.Ссылка КАК ИнтересСсылка,
	Интерес.КонтактноеЛицо КАК КонтактноеЛицо,
	ВЫБОР
		КОГДА Интерес.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
			ТОГДА Интерес.ПотенциальныйКлиент
		ИНАЧЕ Интерес.Партнер
	КОНЕЦ КАК Партнер,
	Интерес.Партнер.Наименование КАК ПартнерНаименование,
	ОбъектыАРМ.НаименованиеАРМ КАК НаименованиеАРМ,
	ОбъектыАРМ.ИзмерениеАРМ КАК ИзмерениеАРМ,
	ОбъектыАРМ.СостояниеИнтереса КАК СостояниеИнтереса,
	ОбъектыАРМ.СостояниеИнтереса.ИндексЦвета КАК ИндексЦвета,
	ОбъектыАРМ.Пользователь КАК Пользователь,
	ОбъектыАРМ.Заголовок КАК ИнтересКлиента,
	ВЫРАЗИТЬ(ОбъектыАРМ.ТемаСледующейАктивности КАК СТРОКА(500)) КАК Заголовок,
	ВЫБОР
		КОГДА ОбъектыАРМ.КрайнийСрок &lt; &amp;ПериодПросроченных
				И ОбъектыАРМ.КрайнийСрок > &amp;ПустаяДата
			ТОГДА 1
		КОГДА ОбъектыАРМ.КрайнийСрок &lt; &amp;ПериодТекущих
				И ОбъектыАРМ.КрайнийСрок > &amp;ПустаяДата
			ТОГДА 2
		ИНАЧЕ 3
	КОНЕЦ КАК Просрочено,
	ВЫБОР
		КОГДА ОбъектыАРМ.КрайнийСрок &lt; &amp;ПериодПросроченных
				И ОбъектыАРМ.КрайнийСрок > &amp;ПустаяДата
			ТОГДА 1
		ИНАЧЕ 2
	КОНЕЦ КАК ПросроченоДляСортировки,
	ОбъектыАРМ.ДатаДляСортировки КАК ДатаДляСортировки,
	ОбъектыАРМ.День КАК День,
	ОбъектыАРМ.Время КАК Время,
	ОбъектыАРМ.ОписаниеИнтереса КАК ОписаниеИнтереса,
	&quot;&quot; КАК ПустаяЯчейка,
	Интерес.ТипУслуги КАК ТипУслуги,
	ОбъектыАРМ.КрайнийСрок КАК КрайнийСрок,
	ОбъектыАРМ.КрайнийСрок КАК КрайнийСрокОкончание,
	ИсточникиПервичногоИнтересаСрез.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
	ИсточникиПервичногоИнтересаСрез.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
	ОбъектыАРМ.ВидКартинки КАК КартинкаСписка,
	Интерес.ОжидаемаяВыручка КАК ОжидаемаяВыручка,
	Интерес.Избранный КАК Избранный,
	Интерес.ОжидаемаяВыручка КАК Сумма,
	Интерес.Подразделение КАК Подразделение,
	ЕСТЬNULL(Интерес.Автор, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Автор,
	Интерес.Проект КАК Проект,
	ВЫБОР
		КОГДА ОбъектыПользователя.Соисполнение
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Соисполнение
ИЗ
	ОбъектыПользователя КАК ОбъектыПользователя
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.CRM_ОбъектыАРМ КАК ОбъектыАРМ
		ПО ОбъектыАРМ.Объект = ОбъектыПользователя.Объект
			И ОбъектыАРМ.Пользователь = ОбъектыПользователя.Пользователь
			И ОбъектыАРМ.НаименованиеАРМ = ОбъектыПользователя.НаименованиеАРМ
			И ОбъектыАРМ.СостояниеИнтереса = ОбъектыПользователя.СостояниеИнтереса
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.CRM_Интерес КАК Интерес
		ПО ОбъектыАРМ.Объект = Интерес.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсточникиПервичногоИнтереса.СрезПоследних КАК ИсточникиПервичногоИнтересаСрез
		ПО ОбъектыАРМ.Объект = ИсточникиПервичногоИнтересаСрез.Сделка</queryText>
      <mainTable>InformationRegister.CRM_ОбъектыАРМ</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
