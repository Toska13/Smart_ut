КонецПроцедуры

// ++ 04.11.2020
&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Элементы.ГарантийныеЗапчастиСклад.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЗаявкаНаГарантийныйРемонт.Ссылка КАК ЗаявкаНаГарантийныйРемонт,
	|	смартЗаявкаНаГарантийныйРемонт.Номер КАК НомерЗаявки,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура КАК ЗапчастьГарантийнаяОжидаемая,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Номенклатура КАК ЗапчастьОтправленнаяПоставщиком,
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт 
	//|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерСтроки КАК НомерСтроки,
	//|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.НомерПозиции КАК НомерПозиции,
	//-- смарт:ММ 08.08.2021
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Контрагент КАК Контрагент,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Количество КАК Количество,
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Количество КАК КоличествоВЗаявке,
	// ++ 15.06.2020
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураУстановленнаяКлиенту, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА &СкладПодЗаказ
	// ++ 25.10.2020
	|		КОГДА ЕСТЬNULL(смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.НоменклатураУстановленнаяКлиенту, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			И ЕСТЬNULL(смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.ДокументРазборки, ЗНАЧЕНИЕ(Документ.СборкаТоваров.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.СборкаТоваров.ПустаяСсылка)
	|			ТОГДА &СкладПодЗаказ
	// --
	|		ИНАЧЕ &ОсновнойСклад
	|	КОНЕЦ КАК Склад
	// --
	|ИЗ
	|	Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяСпециалистомПоПретензиям КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка = смартЗаявкаНаГарантийныйРемонт.Ссылка
	// ++ 15.06.2020
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт.ЗаполняетсяИнженером КАК смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером
	|		ПО смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.Ссылка = смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.Ссылка
	|			И смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.ИДСтрокиЗаполняетсяИнженером = смартЗаявкаНаГарантийныйРемонтЗаполняетсяИнженером.ИДСтрокиЗаполняетсяИнженером
	// --
	|ГДЕ
	|	смартЗаявкаНаГарантийныйРемонтЗаполняетсяСпециалистомПоПретензиям.СтатусПолучения НЕ В(&Статусы)
	|	И ВЫБОР
	|			КОГДА &ОтборПоНомерамЗаявок
	|				ТОГДА смартЗаявкаНаГарантийныйРемонт.Номер В (&НомераЗаявок)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоКонтрагентам
	|				ТОГДА смартЗаявкаНаГарантийныйРемонт.Поставщик В (&МассивПартнеров)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И смартЗаявкаНаГарантийныйРемонт.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)";
	
	МассивСтатусов = Новый Массив;
	//24.08.2020 статус отправки заменен на статус получения, у логиста должно отображаться в обработке, если статус получения не заполнен
	//МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантии.ОтгрузкаНеТребуется); // 27.02.2020 раскомментировано
	//МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантии.ОтправленоПоставщику);
	//МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантии.НечемЗаменить);
	//// 29.02.2020
	//МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантии.ОжидаютсяДействия);
	//// 02.06.2020
	//МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантии.ОжидаетсяОтправка);
	МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.Компенсация);
	МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление);
	МассивСтатусов.Добавить(Перечисления.смартСтатусыПоГарантииПолучение.ПолученоОтПоставщика);
	
	
	МассивПартнеров = Партнер.ВыгрузитьЗначения();
	МассивНомеровЗаявок = НомерЗаявки.ВыгрузитьЗначения();
	
	Запрос.УстановитьПараметр("Статусы", 				МассивСтатусов);
	Запрос.УстановитьПараметр("ОтборПоНомерамЗаявок", 	?(МассивНомеровЗаявок.Количество() = 0, Ложь, Истина));
	Запрос.УстановитьПараметр("НомераЗаявок", 			МассивНомеровЗаявок);
	Запрос.УстановитьПараметр("ОтборПоКонтрагентам", 	?(МассивПартнеров.Количество() = 0, Ложь, Истина));
	Запрос.УстановитьПараметр("МассивПартнеров", 		МассивПартнеров);
	
	// ++ 15.06.2020
	Запрос.УстановитьПараметр("СкладПодЗаказ", Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение);
	Запрос.УстановитьПараметр("ОсновнойСклад", Справочники.смартПредопределенныеЗначения.ОсновнойСклад.Значение);
	// --
	
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт 
	//ГарантийныеЗапчасти.Загрузить(Запрос.Выполнить().Выгрузить());
	ПромежуточнаяТЗ = Запрос.Выполнить().Выгрузить();
	ПромежуточнаяТЗ.Свернуть("ЗаявкаНаГарантийныйРемонт,НомерЗаявки,ЗапчастьГарантийнаяОжидаемая,ЗапчастьОтправленнаяПоставщиком,Контрагент,Склад", "Количество,КоличествоВЗаявке");
	ГарантийныеЗапчасти.Загрузить(ПромежуточнаяТЗ);
	//-- смарт:ММ 08.08.2021
	
	//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	//-- #Б6794 смарт: Шляпников 07.05.2026

КонецПроцедуры


&НаКлиенте
Процедура ПринятьКУчету(Команда)
	
	Отказ = Ложь;
	
	Отказ = ПроверитьЗаполненностьПолей();
	
	Если НЕ Отказ Тогда
		ПринятьКУчетуВариант2НаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполненностьПолей()
	
	Отказ = Ложь;
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Отметка", Истина);
	СтруктураПоиска.Вставить("Контрагент", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	// ++ 26.11.2020
	СтруктураПоиска.Вставить("ПрямаяПоставка", Ложь);
	// --
	
	НайденныеСтроки = ГарантийныеЗапчасти.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Для Каждого ТекСтрока Из НайденныеСтроки Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строке " + ТекСтрока.НомерСтроки + " не указан контрагент");
		КонецЦикла;
		Отказ = Истина;
		
	КонецЕсли;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Процедура ПринятьКУчетуВариант2НаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВТ.Контрагент КАК Контрагент,
	|	ВТ.ДатаПоставки КАК ДатаПоставки,
	|	ВТ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ.Количество КАК Количество,
	|	ВТ.КоличествоВЗаявке КАК КоличествоВЗаявке,
	|	ВЫРАЗИТЬ(ВТ.ЗаявкаНаГарантийныйРемонт КАК Документ.смартЗаявкаНаГарантийныйРемонт) КАК ЗаявкаНаГарантийныйРемонт,
	|	ВТ.ЗапчастьГарантийнаяОжидаемая КАК ЗапчастьГарантийнаяОжидаемая,
	|	ВТ.ЗапчастьОтправленнаяПоставщиком КАК ЗапчастьОтправленнаяПоставщиком,
	|	ВТ.Отметка КАК Отметка,	
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт
	//|	ВТ.НомерСтроки КАК НомерСтроки,
	//|	ВТ.НомерПозиции КАК НомерПозиции,
	//-- смарт:ММ 08.08.2021
	// ++ 26.11.2020
	|	ВТ.ПрямаяПоставка КАК ПрямаяПоставка,
	// ++ 22.03.2021
	|	ВТ.УстановкаНеТребуется КАК УстановкаНеТребуется,
	// --
	|	ВТ.Склад КАК Склад
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.ДатаПоставки КАК ДатаПоставки,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.КоличествоВЗаявке КАК КоличествоВЗаявке,
	|	ВТ_ТЧ.ЗапчастьГарантийнаяОжидаемая КАК ЗапчастьГарантийнаяОжидаемая,
	|	ВТ_ТЧ.ЗапчастьОтправленнаяПоставщиком КАК Номенклатура,
	|	ВТ_ТЧ.Отметка КАК Отметка,
	|	ВТ_ТЧ.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	|	ВТ_ТЧ.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(смартЗаявкаНаГарантийныйРемонт.Организация, """") КАК Организация,	
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт 
	//|	ВТ_ТЧ.НомерСтроки КАК НомерСтроки,
	//|	ВТ_ТЧ.НомерПозиции КАК НомерПозиции,
	//-- смарт:ММ 08.08.2021
	|	смартЗаявкаНаГарантийныйРемонт.Поставщик КАК Партнер,
	// ++ 26.11.2020
	|	ВТ_ТЧ.ПрямаяПоставка КАК ПрямаяПоставка,
	// ++ 22.03.2021
	|	ВТ_ТЧ.УстановкаНеТребуется КАК УстановкаНеТребуется,
	// --
	|	ВТ_ТЧ.Склад КАК Склад
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|		ПО ВТ_ТЧ.ЗаявкаНаГарантийныйРемонт = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|ГДЕ
	|	ВТ_ТЧ.Отметка
	// ++ 26.11.2020
	|	И НЕ ВТ_ТЧ.ПрямаяПоставка
	// --
	|ИТОГИ
	|	МАКСИМУМ(Партнер)
	|ПО
	|	ДатаПоставки,
	|	Организация,
	|	Контрагент
	// ++ 26.11.2020
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.ДатаПоставки КАК ДатаПоставки,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.КоличествоВЗаявке КАК КоличествоВЗаявке,
	|	ВТ_ТЧ.ЗапчастьГарантийнаяОжидаемая КАК ЗапчастьГарантийнаяОжидаемая,
	|	ВТ_ТЧ.ЗапчастьОтправленнаяПоставщиком КАК Номенклатура,
	|	ВТ_ТЧ.Отметка КАК Отметка,
	|	ВТ_ТЧ.ЗаявкаНаГарантийныйРемонт КАК ЗаявкаНаГарантийныйРемонт,
	|	ВТ_ТЧ.Контрагент КАК Контрагент,
	|	ЕСТЬNULL(смартЗаявкаНаГарантийныйРемонт.Организация, """") КАК Организация,	
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт
	//|	ВТ_ТЧ.НомерСтроки КАК НомерСтроки,
	//|	ВТ_ТЧ.НомерПозиции КАК НомерПозиции,
	//-- смарт:ММ 08.08.2021
	|	смартЗаявкаНаГарантийныйРемонт.Поставщик КАК Партнер,
	|	ВТ_ТЧ.ПрямаяПоставка КАК ПрямаяПоставка,
	// ++ 22.03.2021
	|	ВТ_ТЧ.УстановкаНеТребуется КАК УстановкаНеТребуется,
	// --
	|	ВТ_ТЧ.Склад КАК Склад
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|		ПО ВТ_ТЧ.ЗаявкаНаГарантийныйРемонт = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|ГДЕ
	|	ВТ_ТЧ.Отметка
	|	И ВТ_ТЧ.ПрямаяПоставка";
	// --
	
	ОсновнойСклад = Справочники.смартПредопределенныеЗначения.ОсновнойСклад.Значение;
	
	Запрос.УстановитьПараметр("ВТ", ГарантийныеЗапчасти.Выгрузить());
	
	//++ смарт:ММ #044 224 20.07.2020
	//СтатусОжидаетсяПоступление = Перечисления.смартСтатусыПоГарантии.ОжидаетсяПоступление;
	СтатусОжидаетсяПоступление = Перечисления.смартСтатусыПоГарантииПолучение.ОжидаетсяПоступление;
	//-- смарт:ММ 20.07.2020

	// ++ 26.11.2020
	//РезультатЗапроса = Запрос.Выполнить();
	
	//ВыборкаДатаПоставки = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаПрямаяПоставка = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
	Пока ВыборкаПрямаяПоставка.Следующий() Цикл
		
		ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(ВыборкаПрямаяПоставка, Неопределено, СтатусОжидаетсяПоступление, Неопределено, Истина);		
		
	КонецЦикла;
	
	ВыборкаДатаПоставки = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	// --
	
		
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Пока ВыборкаДатаПоставки.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДатаПоставки.ДатаПоставки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не во всех отмеченных строках указана дата поставки!");
			Продолжить;
		КонецЕсли;
				
		ВыборкаОрганизация = ВыборкаДатаПоставки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаОрганизация.Следующий() Цикл
			
			ВыборкаКонтрагент = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаКонтрагент.Следующий() Цикл
				
				ДокументЗаказПоставщику = СоздатьЗаказПоставщику(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад);			
							
				Если ЗначениеЗаполнено(ДокументЗаказПоставщику) И ДокументЗаказПоставщику.Проведен Тогда
					// ++ 13.06.2020
					// Приобретение товаров будут создавать вручную
					//	ДокументПриобретениеТоваров = СоздатьПриобретениеТоваров(ВыборкаКонтрагент, ДокументЗаказПоставщику);
					// --
					
					// ++ 15.06.2020
					//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
					ДокументЗаказНаПеремещение = СоздатьЗаказНаПеремещение(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад, ДокументЗаказПоставщику);
					//-- #Б-3170 смарт: Лопато 05.05.2025
					// --
					
					Выборка = ВыборкаКонтрагент.Выбрать();
					
					Выборка.Сбросить();
					Пока Выборка.Следующий() Цикл						
						// ++ 01.11.2020
						//ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументЗаказПоставщику.Ссылка, СтатусОжидаетсяПоступление);
						ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументЗаказПоставщику.Ссылка, СтатусОжидаетсяПоступление, ДокументЗаказНаПеремещение);
						// --
					КонецЦикла;
					
					//++ #Б-3010 смарт: Фролов 30.04.2025 //Заявка на гарантийный ремонт. Заказ на перемещение (Основной - Склад ФСО).
					//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
					ДокументЗаказНаПеремещение = СоздатьЗаказНаПеремещениеНеГарантийка(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад, ДокументЗаказПоставщику);
					//-- #Б-3170 смарт: Лопато 05.05.2025
					
					Выборка.Сбросить();
					Пока Выборка.Следующий() Цикл						

						ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументЗаказПоставщику.Ссылка, СтатусОжидаетсяПоступление, ДокументЗаказНаПеремещение);

					КонецЦикла;
					//-- #Б-3010 смарт: Фролов 30.04.2025

				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция СоздатьЗаказПоставщику(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад)
	
	ДокументЗаказПоставщику = Документы.ЗаказПоставщику.СоздатьДокумент();
	ДокументЗаказПоставщику.Дата 			= ВыборкаКонтрагент.ДатаПоставки;
	ДокументЗаказПоставщику.ДатаПоступления = ВыборкаКонтрагент.ДатаПоставки;
	ДокументЗаказПоставщику.Организация 	= ВыборкаКонтрагент.Организация;
	ДокументЗаказПоставщику.Склад 			= ОсновнойСклад;
	ДокументЗаказПоставщику.Контрагент 		= ВыборкаКонтрагент.Контрагент;
	ДокументЗаказПоставщику.Партнер 		= ВыборкаКонтрагент.Партнер;
	ДокументЗаказПоставщику.Менеджер 		= ТекущийПользователь;
	ДокументЗаказПоставщику.Приоритет 		= Справочники.Приоритеты.ПолучитьПриоритетПоУмолчанию(Неопределено);
	ДокументЗаказПоставщику.Статус 			= Перечисления.СтатусыЗаказовПоставщикам.Подтвержден; // если не подвержден, то не даст ввести документ на основани этого
	ДокументЗаказПоставщику.Валюта 			= Константы.ВалютаУправленческогоУчета.Получить();
	
	Если НЕ ЗначениеЗаполнено(ВыборкаКонтрагент.Контрагент.ИНН) Тогда
		ДокументЗаказПоставщику.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту;
	Иначе
		ДокументЗаказПоставщику.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	КонецЕсли;
	
	//++ смарт:ММ 221 19.07.2021
	ДокументЗаказПоставщику.смартЗапчастиГарантийные = Истина;
	//-- смарт:ММ 19.07.2021
	
	Выборка = ВыборкаКонтрагент.Выбрать();
	
	НомераЗаявок = "";
	НомераЗаявокМассив = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		ТекНомерЗаявки = Выборка.НомерЗаявки;
		НоваяСтрока = ДокументЗаказПоставщику.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		
		// ++ 13.06.2020
		//НоваяСтрока.Количество 			= 1;
		//НоваяСтрока.КоличествоУпаковок 	= 1;		
		НоваяСтрока.Количество 			= Выборка.Количество;
		НоваяСтрока.КоличествоУпаковок 	= Выборка.Количество;

		НоваяСтрока.Склад 				= ОсновнойСклад;
		НоваяСтрока.ДатаПоступления 	= Выборка.ДатаПоставки;
		НоваяСтрока.СтавкаНДС 			= Перечисления.СтавкиНДС.БезНДС;
		
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = ТекНомерЗаявки;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Выборка.ЗаявкаНаГарантийныйРемонт;
		//-- #Б1132 смарт: Шляпников 14.10.2024

		
		Если НомераЗаявокМассив.Найти(ТекНомерЗаявки) = Неопределено Тогда
			НомераЗаявок = НомераЗаявок + ?(ЗначениеЗаполнено(НомераЗаявок), ", ", "") + ТекНомерЗаявки;
			НомераЗаявокМассив.Добавить(ТекНомерЗаявки);
		КонецЕсли;
	КонецЦикла;
	
	//ДокументЗаказПоставщику.Комментарий 	= "#Создан на основании Заявки на гарантийный ремонт №" + НомераЗаявок;
	ДокументЗаказПоставщику.Комментарий = Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьТекстКомментарияКДокументу(, НомераЗаявок);
	
	Попытка
		ДокументЗаказПоставщику.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументЗаказПоставщику.Ссылка, ДокументЗаказПоставщику.Ссылка);
	Исключение
		ДокументЗаказПоставщику.Записать(РежимЗаписиДокумента.Запись);
		СинонимДокумента = ДокументЗаказПоставщику.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ записан без проведения.");
	КонецПопытки;
	
	Возврат ДокументЗаказПоставщику.Ссылка;
	
КонецФункции

&НаСервере
Функция СоздатьПриобретениеТоваров(ВыборкаКонтрагент, ДокументЗаказПоставщику)
	
	ДокументПриобретениеТоваров = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
	
	ДокументПриобретениеТоваров.Заполнить(ДокументЗаказПоставщику);
	
	ДокументПриобретениеТоваров.Дата 			= ВыборкаКонтрагент.ДатаПоставки;
	
	ДокументПриобретениеТоваров.ЗаказПоставщику = ДокументЗаказПоставщику;
	ДокументПриобретениеТоваров.Комментарий = ДокументЗаказПоставщику.Комментарий;
	
	Для Каждого Строка Из ДокументПриобретениеТоваров.Товары Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", Строка.Номенклатура);
		ПараметрыОтбора.Вставить("Количество", Строка.Количество);
		
		НайденныеСтроки = ДокументЗаказПоставщику.Товары.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() > 0 Тогда
			//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
			//Строка.смартНомерЗаявкиНаГарантийныйРемонт = НайденныеСтроки[0].смартНомерЗаявкиНаГарантийныйРемонт;
			Строка.смартНомерЗаявкиНаГарантийныйРемонтСсылка = НайденныеСтроки[0].смартНомерЗаявкиНаГарантийныйРемонтСсылка;
			//-- #Б1132 смарт: Шляпников 14.10.2024
		КонецЕсли;
	
	КонецЦикла;	
	
	Попытка
		// 14.04.2020
		//ДокументПриобретениеТоваров.Записать(РежимЗаписиДокумента.Проведение);
		ДокументПриобретениеТоваров.Записать(РежимЗаписиДокумента.Запись);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокументПриобретениеТоваров.Ссылка, ДокументПриобретениеТоваров.Ссылка);
	Исключение
		//ДокументПриобретениеТоваров.Записать(РежимЗаписиДокумента.Запись);
		//СинонимДокумента = ДокументПриобретениеТоваров.Метаданные().Синоним;
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		//|" + ОписаниеОшибки() + "
		//|Документ записан без проведения.");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ДокументПриобретениеТоваров.Ссылка;
	
КонецФункции

// + 01.11.2020
//Процедура ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументДвижения, СтатусОжидаетсяПоступление)
//Процедура ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументДвижения, СтатусОжидаетсяПоступление, ДокументЗаказНаПеремещение)
Процедура ИзменитьСтатусВЗаявкеНаГарантийныйРемонт(Выборка, ДокументДвижения, СтатусОжидаетсяПоступление, ДокументЗаказНаПеремещение, ПрямаяПоставка = Ложь) // 26.11.2020
// --	
	
	// ++ 13.06.2020
	// Может быть ситуация, когда в табл.части специалиста указано одно количество, 
	// а ожидается поступление меньшего количества. В этом случае надо разделить строку в заявке на гар.ремонт 
	// с сохранением всех статусов, причем делить строку надо как в табл инженера, так и в табл специалиста.
	// В одной строке должен остаться статус тот, который текущий, а в другую строку должна скопироваться вся история статусов 
	// и измениться статус на «ожидается поступление»
		
	ИзменилосьКоличество = Ложь;
	Если Выборка.Количество <> Выборка.КоличествоВЗаявке Тогда
		ИзменилосьКоличество = Истина;
	КонецЕсли;
	// --
	
	ДокОбъект = Выборка.ЗаявкаНаГарантийныйРемонт.ПолучитьОбъект();
	
	// ++ 13.06.2020
	//ТекСтрока = ДокОбъект.ЗаполняетсяСпециалистомПоПретензиям[Выборка.НомерСтроки - 1];
	//++ смарт:ММ #044 224 08.08.2021 - Заявка на гарантийный ремонт 
	//Отбор = Новый Структура;
	//Отбор.Вставить("НомерПозиции", Выборка.НомерПозиции);
	//НайденныеСтроки = ДокОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
	//Если НайденныеСтроки.Количество() = 0 Тогда
	//	// Сюда не должно попасть!
	//	Возврат;
	//КонецЕсли;
	
	//ТекСтрока = НайденныеСтроки[0];
	
	Отбор = Новый Структура;
	 //++ смарт:Подкин #910 14.02.2022 11:40:59       
    Отбор.Вставить("Номенклатура", Выборка.ЗапчастьГарантийнаяОжидаемая);
    //	Отбор.Вставить("Номенклатура", Выборка.Номенклатура);
    //-- смарт:Подкин #910 14.02.2022 11:40:59

	НайденныеСтрокиСпециалист = ДокОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
	Если НайденныеСтрокиСпециалист.Количество() = 0 Тогда
		// Сюда не должно попасть!
		Возврат;
	КонецЕсли;

	КоличествоКЗаказуОстаток = Выборка.Количество;
	
	// Обходятся все строки заявки с указанной номенклатурой.
	// Если по сумме всех строк количество в заявке совпадает с количеством из обработки, то статус меняется у всех строк
	// Если заказано меньше, то строки обходятся по порядку, пока не будет поменян статус у нужного колиества. Возможно, какую-то строку придется разбить, т.к. количество в обработке может быть меньше, чем в заявке 
	
	// Отсортировать по возрастанию количества
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерПозиции");
	Таблица.Колонки.Добавить("Количество");
	
	Для Каждого ТекСтрокаСпециалист Из НайденныеСтрокиСпециалист Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерПозиции = ТекСтрокаСпециалист.НомерПозиции;
		НоваяСтрока.Количество = ТекСтрокаСпециалист.Количество;
	КонецЦикла;
	
	Таблица.Сортировать("Количество");
	
	Для Каждого СтрокаТаблица Из Таблица Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерПозиции", СтрокаТаблица.НомерПозиции);
		НайденныеСтроки = ДокОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтрока = НайденныеСтроки[0];
		
		Если ИзменилосьКоличество Тогда
			
			Если КоличествоКЗаказуОстаток <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если ТекСтрока.Количество <= КоличествоКЗаказуОстаток Тогда
				// У строки меняется статус, количества по строке хватило 
				
			Иначе
				
				// Необходимо разбить строку, т.к. в заявке количество больше, чем осталось оформить из заказанного
				
				// 1. Найти соответствующую строку инженера, изменить количество
				// 2. Добавить новую строку инженера - копию из п.1, откорректировать количество
				// 3. Добавить новую строку специалиста по претенциям, копию ТекСтрока
				// 4. Добавить новые строки истории статусов
				
				// 1. Найти соответствующую строку инженера, изменить количество 
				
				//ТекСтрока.Количество = Выборка.КоличествоВЗаявке - Выборка.Количество;
				
				ТекСтрока.Количество = ТекСтрока.Количество - КоличествоКЗаказуОстаток; // Количество по строке, у которой не будет изменен статус (незаказанное количество)
				
				СтруктураОтбора = Новый Структура;
				СтруктураОтбора.Вставить("ИДСтрокиЗаполняетсяИнженером", ТекСтрока.ИДСтрокиЗаполняетсяИнженером);
				НайденныеСтрокиИнженера = ДокОбъект.ЗаполняетсяИнженером.НайтиСтроки(СтруктураОтбора);
				
				Если НайденныеСтрокиИнженера.Количество() > 0 Тогда
					ИсходнаяСтрокаИнженера = НайденныеСтрокиИнженера[0];
					ИсходнаяСтрокаИнженера.Количество = ТекСтрока.Количество; // Исходное количество - Ожидаемое от поставщика фактическое количество
					
					// 2. Добавить новую строку инженера - копию из п.1, откорректировать количество
					
					НоваяСтрокаИнженера = ДокОбъект.ЗаполняетсяИнженером.Вставить(ИсходнаяСтрокаИнженера.НомерСтроки);
					ЗаполнитьЗначенияСвойств(НоваяСтрокаИнженера, ИсходнаяСтрокаИнженера);
					НоваяСтрокаИнженера.ИДСтрокиЗаполняетсяИнженером = ДокОбъект.ПолучитьСледующийИДСтроки();
