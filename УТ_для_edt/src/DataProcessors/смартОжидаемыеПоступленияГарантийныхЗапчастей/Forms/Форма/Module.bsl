//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
Функция СоздатьЗаказНаПеремещение(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад, ДокументЗаказПоставщику)
//-- #Б-3170 смарт: Лопато 05.05.2025
	
	ЗначениеВозврат = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	
	ЕстьСтрокиКПеремещению = Ложь;
		
	ОсновнойСкладДляЗапчастейПодЗаказ = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
	
	//++ #Б-3010 смарт: Фролов 30.04.2025 //Заявка на гарантийный ремонт. Заказ на перемещение (Основной - Склад ФСО).
	СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика = 
		Справочники.смартПредопределенныеЗначения.Настройки.СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика;
	//-- #Б-3010 смарт: Фролов 30.04.2025
	
	Если НЕ ЗначениеЗаполнено(ОсновнойСкладДляЗапчастейПодЗаказ) Тогда
		Возврат ЗначениеВозврат;
	КонецЕсли;
	
	Выборка = ВыборкаКонтрагент.Выбрать();
	
	НомераЗаявок = "";
	НомераЗаявокМассив = Новый Массив;

	ДокументЗаказНаПеремещение = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	ВариантОбеспеченияИзЗаказов = Перечисления.ВариантыОбеспечения.ИзЗаказов; // Резервировать к дате

	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Склад <> ОсновнойСкладДляЗапчастейПодЗаказ Тогда
			Продолжить;
		КонецЕсли;
		
		// ++ 22.03.2021
		Если Выборка.УстановкаНеТребуется Тогда
			Продолжить;
		КонецЕсли;
		// --
		
		ЕстьСтрокиКПеремещению = Истина;
		
		ТекНомерЗаявки = Выборка.НомерЗаявки;
		
		НоваяСтрока = ДокументЗаказНаПеремещение.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;		
		НоваяСтрока.Количество 			= Выборка.Количество;
		НоваяСтрока.КоличествоУпаковок 	= Выборка.Количество;
		НоваяСтрока.ВариантОбеспечения 	= ВариантОбеспеченияИзЗаказов; 
		НоваяСтрока.НачалоОтгрузки 		= Выборка.ДатаПоставки;
		НоваяСтрока.ОкончаниеПоступления = Выборка.ДатаПоставки;
		
		//++ #Б1132 смарт: Шляпников 14.10.2024 / Ссылки на документ Заявка на гарантийный ремонт
		//НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонт = ТекНомерЗаявки;
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Выборка.ЗаявкаНаГарантийныйРемонт;
		//-- #Б1132 смарт: Шляпников 14.10.2024
		
		Если НомераЗаявокМассив.Найти(ТекНомерЗаявки) = Неопределено Тогда
			НомераЗаявок = НомераЗаявок + ?(ЗначениеЗаполнено(НомераЗаявок), ", ", "") + ТекНомерЗаявки;
			НомераЗаявокМассив.Добавить(ТекНомерЗаявки);
		КонецЕсли;

	КонецЦикла;
	
	Если НЕ ЕстьСтрокиКПеремещению Тогда
		ДокументЗаказНаПеремещение = Неопределено;
		Возврат ЗначениеВозврат;
	КонецЕсли;
		
	ДокументЗаказНаПеремещение.Дата 			= ВыборкаКонтрагент.ДатаПоставки;
	ДокументЗаказНаПеремещение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокументЗаказНаПеремещение.Организация 		= ВыборкаКонтрагент.Организация;
	//ДокументЗаказНаПеремещение.Ответственный 	= ТекущийПользователь; //закомментировано по просьбе Стрекалова 30.09.2020
	ДокументЗаказНаПеремещение.Комментарий 		= Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьТекстКомментарияКДокументу(, НомераЗаявок);
	ДокументЗаказНаПеремещение.СкладОтправитель = ОсновнойСклад;
	ДокументЗаказНаПеремещение.СкладПолучатель 	= ОсновнойСкладДляЗапчастейПодЗаказ;
	ДокументЗаказНаПеремещение.Статус 			= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказНаПеремещение.СпособДоставки 	= Перечисления.СпособыДоставки.Самовывоз;
	ДокументЗаказНаПеремещение.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным; 
	
	//++ смарт:ММ #044 224 21.11.2020 - Заявка на гарантийный ремонт 
	ДокументЗаказНаПеремещение.смартКонечнаяДатаРезерва = ДобавитьМесяц(ДокументЗаказНаПеремещение.Дата, 1);
	//-- смарт:ММ 21.11.2020
	
	//++ #Б1598 смарт: Шляпников 09.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Дополнение.
	ДокументЗаказНаПеремещение.смартЗапчастиГарантийные = Истина;
	//-- #Б1598 смарт: Шляпников 09.12.2024
	
	//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
	ДокументЗаказНаПеремещение.ДокументОснование = ДокументЗаказПоставщику;
	//-- #Б-3170 смарт: Лопато 05.05.2025
	
	Попытка
		ДокументЗаказНаПеремещение.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументЗаказНаПеремещение.Ссылка, ДокументЗаказНаПеремещение.Ссылка);
	Исключение
		ДокументЗаказНаПеремещение.Записать(РежимЗаписиДокумента.Запись);
		СинонимДокумента = ДокументЗаказНаПеремещение.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ записан без проведения.", ДокументЗаказНаПеремещение.Ссылка);
	КонецПопытки;
	
	ЗначениеВозврат = ДокументЗаказНаПеремещение.Ссылка;
	
	Возврат ЗначениеВозврат;
	
КонецФункции 

&НаСервере
//++ #Б-3010 смарт: Фролов 30.04.2025 //Заявка на гарантийный ремонт. Заказ на перемещение (Основной - Склад ФСО).
//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
Функция СоздатьЗаказНаПеремещениеНеГарантийка(ВыборкаКонтрагент, ТекущийПользователь, ОсновнойСклад, ДокументЗаказПоставщику)
//-- #Б-3170 смарт: Лопато 05.05.2025
	
	ЗначениеВозврат = Документы.ЗаказНаПеремещение.ПустаяСсылка();
	
	ЕстьСтрокиКПеремещению = Ложь;
		
	ОсновнойСкладДляЗапчастейПодЗаказ = Справочники.смартПредопределенныеЗначения.ОсновнойСкладДляЗапчастейПодЗаказ.Значение;
	
	СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика = 
		Справочники.смартПредопределенныеЗначения.Настройки.СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика;
	
	Если НЕ ЗначениеЗаполнено(ОсновнойСкладДляЗапчастейПодЗаказ) Тогда
		Возврат ЗначениеВозврат;
	КонецЕсли;
	
	Выборка = ВыборкаКонтрагент.Выбрать();
	
	НомераЗаявок = "";
	НомераЗаявокМассив = Новый Массив;

	ДокументЗаказНаПеремещение = Документы.ЗаказНаПеремещение.СоздатьДокумент();
	ВариантОбеспеченияИзЗаказов = Перечисления.ВариантыОбеспечения.ИзЗаказов; // Резервировать к дате

	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Склад = ОсновнойСкладДляЗапчастейПодЗаказ Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.УстановкаНеТребуется Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьСтрокиКПеремещению = Истина;
		
		ТекНомерЗаявки = Выборка.НомерЗаявки;
		
		НоваяСтрока = ДокументЗаказНаПеремещение.Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;		
		НоваяСтрока.Количество 			= Выборка.Количество;
		НоваяСтрока.КоличествоУпаковок 	= Выборка.Количество;
		НоваяСтрока.ВариантОбеспечения 	= ВариантОбеспеченияИзЗаказов; 
		НоваяСтрока.НачалоОтгрузки 		= Выборка.ДатаПоставки;
		НоваяСтрока.ОкончаниеПоступления = Выборка.ДатаПоставки;
		
		НоваяСтрока.смартНомерЗаявкиНаГарантийныйРемонтСсылка = Выборка.ЗаявкаНаГарантийныйРемонт;
		
		Если НомераЗаявокМассив.Найти(ТекНомерЗаявки) = Неопределено Тогда
			НомераЗаявок = НомераЗаявок + ?(ЗначениеЗаполнено(НомераЗаявок), ", ", "") + ТекНомерЗаявки;
			НомераЗаявокМассив.Добавить(ТекНомерЗаявки);
		КонецЕсли;

	КонецЦикла;
	
	Если НЕ ЕстьСтрокиКПеремещению Тогда
		ДокументЗаказНаПеремещение = Неопределено;
		Возврат ЗначениеВозврат;
	КонецЕсли;
		
	ДокументЗаказНаПеремещение.Дата 			= ВыборкаКонтрагент.ДатаПоставки;
	ДокументЗаказНаПеремещение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокументЗаказНаПеремещение.Организация 		= ВыборкаКонтрагент.Организация;
	ДокументЗаказНаПеремещение.Комментарий 		= Документы.смартЗаявкаНаГарантийныйРемонт.ПолучитьТекстКомментарияКДокументу(, НомераЗаявок);
	ДокументЗаказНаПеремещение.СкладОтправитель = ОсновнойСклад;
	
	ДокументЗаказНаПеремещение.СкладПолучатель 	= СкладДляПеремещенияПриобретенныхДеталейПоГарантииОтПоставщика;
	
	ДокументЗаказНаПеремещение.Статус 			= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ДокументЗаказНаПеремещение.СпособДоставки 	= Перечисления.СпособыДоставки.Самовывоз;
	ДокументЗаказНаПеремещение.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным; 
	
	ДокументЗаказНаПеремещение.смартКонечнаяДатаРезерва = ДобавитьМесяц(ДокументЗаказНаПеремещение.Дата, 1);
	
	ДокументЗаказНаПеремещение.смартЗапчастиГарантийные = Истина;

	//++ #Б-3170 смарт: Лопато 05.05.2025 //Заявка на гарантийный ремонт. Заказ на перемещение.  
	ДокументЗаказНаПеремещение.ДокументОснование = ДокументЗаказПоставщику;
	//-- #Б-3170 смарт: Лопато 05.05.2025
	
	Попытка
		ДокументЗаказНаПеремещение.Записать(РежимЗаписиДокумента.Проведение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан и проведен документ " + ДокументЗаказНаПеремещение.Ссылка, ДокументЗаказНаПеремещение.Ссылка);
	Исключение
		ДокументЗаказНаПеремещение.Записать(РежимЗаписиДокумента.Запись);
		СинонимДокумента = ДокументЗаказНаПеремещение.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки() + "
		|Документ записан без проведения.", ДокументЗаказНаПеремещение.Ссылка);
	КонецПопытки;
	
	ЗначениеВозврат = ДокументЗаказНаПеремещение.Ссылка;
	
	Возврат ЗначениеВозврат;
	
КонецФункции //-- #Б-3010 смарт: Фролов 30.04.2025

