Функция ОбработатьWebhook(УчетнаяЗапись, ТелоЗапроса) Экспорт
	
	СтруктураПараметровДоступа = CRM_РаботаСМессенджерамиСерверПовтИсп.СтруктураПараметровДоступа(УчетнаяЗапись);
	Если СтруктураПараметровДоступа = Неопределено Тогда
		ДанныеОтвета = Новый Структура("error", "Сервис не найден!");
		Ответ = CRM_РаботаСМессенджерамиСервер.HTTPОтвет(ДанныеОтвета);
		Возврат Ответ; 
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		Возврат ОбработатьWebhookGreen(УчетнаяЗапись, ТелоЗапроса, СтруктураПараметровДоступа);
	КонецЕсли;
	
	Оповещение = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ТелоЗапроса);
	
	Если Оповещение.Свойство("update_type") И Оповещение.update_type = "message_created"
		И Оповещение.Свойство("message") Тогда
		МассивСообщений = Новый Массив;
		Сообщение = СообщениеИзДанныхMAX(УчетнаяЗапись, Оповещение.message);
		Если Сообщение <> Неопределено Тогда
			МассивСообщений.Добавить(Сообщение);
		КонецЕсли;
		Если МассивСообщений.Количество() > 0 Тогда
			CRM_РаботаСМессенджерамиСервер.СоздатьСообщенияИзПолученныхДанных(УчетнаяЗапись, МассивСообщений);
		КонецЕсли;
	КонецЕсли;
	
	ДанныеОтвета = Новый Структура("status", "ок");
	Ответ = CRM_РаботаСМессенджерамиСервер.HTTPОтвет(ДанныеОтвета);
	Возврат Ответ;
	
КонецФункции

Функция УстановитьWebhook(УчетнаяЗапись, СтруктураПараметровДоступа) Экспорт
	
	Если СтруктураПараметровДоступа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		Возврат УстановитьWebhookGreen(УчетнаяЗапись, СтруктураПараметровДоступа);
	КонецЕсли;
	
	Если Не СтруктураПараметровДоступа.Свойство("АдресWebhook")
		Или Не ЗначениеЗаполнено(СтруктураПараметровДоступа.АдресWebhook) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	АдресWebhook = СтруктураПараметровДоступа.АдресWebhook;
	АдресWebhook = АдресWebhook + ?(Прав(АдресWebhook, 1) = "/", "", "/")
		+ Строка(УчетнаяЗапись.Ссылка.УникальныйИдентификатор());
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("url", АдресWebhook);
	МассивТиповСобытий = Новый Массив;
	МассивТиповСобытий.Добавить("message_created");
	// message_edited не запрашиваем: изменения сообщений не поддерживаются (ВозможноИзменениеСообщений = Ложь).
	МассивТиповСобытий.Добавить("bot_started");
	ДанныеЗапроса.Вставить("update_types", МассивТиповСобытий);
	Если СтруктураПараметровДоступа.Свойство("СекретWebhook")
		И ЗначениеЗаполнено(СтруктураПараметровДоступа.СекретWebhook) Тогда
		ДанныеЗапроса.Вставить("secret", СтруктураПараметровДоступа.СекретWebhook);
	КонецЕсли;
	
	СтрокаЗапроса = CRM_РаботаСМессенджерамиСервер.ПолучитьСтрокуJSON(ДанныеЗапроса);
	СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ВыполнитьЗапросMAX(
		URLМетода("subscriptions"), СтрокаЗапроса, СтруктураПараметровДоступа));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
	// При ошибке подписки API возвращает код 200 и success = false.
	Если СтруктураОтвета.Свойство("success") И Не СтруктураОтвета.success Тогда
		СообщениеОбОшибке = ?(СтруктураОтвета.Свойство("message"), СтруктураОтвета.message,
			"Не удалось установить подписку на Webhook");
		ВызватьИсключение СообщениеОбОшибке;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

