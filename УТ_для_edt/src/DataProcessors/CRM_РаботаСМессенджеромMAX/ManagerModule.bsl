Функция Отключиться(СтруктураПараметровДоступа) Экспорт
	
	Если СтруктураПараметровДоступа = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		Возврат ОтключитьсяGreen(СтруктураПараметровДоступа);
	КонецЕсли;
	
	// MAX не предоставляет метода отключения бота через API.
	// Для отключения достаточно удалить подписку на Webhook (если она была).
	Если СтруктураПараметровДоступа.Свойство("ИспользоватьWebhook")
		И СтруктураПараметровДоступа.ИспользоватьWebhook Тогда
		Если СтруктураПараметровДоступа.Свойство("АдресWebhook")
			И ЗначениеЗаполнено(СтруктураПараметровДоступа.АдресWebhook) Тогда
			Ресурс = URLМетода("subscriptions") + "?url=" + КодироватьСтроку(
				СтруктураПараметровДоступа.АдресWebhook, СпособКодированияСтроки.КодировкаURL);
			Попытка
				ВыполнитьЗапросMAX(Ресурс, , СтруктураПараметровДоступа, Истина);
			Исключение
				ЗаписьЖурналаРегистрации("CRM_РаботаСМессенджеромMAX.Отключиться",
					УровеньЖурналаРегистрации.Предупреждение, , ,
					"Не удалось удалить подписку на Webhook: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

