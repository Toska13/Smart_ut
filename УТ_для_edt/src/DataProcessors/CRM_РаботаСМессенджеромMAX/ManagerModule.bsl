#Область СлужебныеПроцедурыИФункции

// Выполняет запрос к API MAX.
//
// Параметры:
//  Ресурс			   - Строка - Ресурс (относительный путь метода API).
//  СтрокаЗапроса	   - Строка - Строка запроса (тело JSON).
//  СтруктураПараметровДоступа - Структура - Параметры доступа (содержит Токен и ПараметрыПрокси).
//  Удаление			   - Булево - Признак использования HTTP-метода DELETE.
//
// Возвращаемое значение:
//  Строка - Текст ответа сервера.
//
Функция ВыполнитьЗапросMAX(Ресурс, СтрокаЗапроса = "", СтруктураПараметровДоступа, Удаление = Ложь)
	
	Если СтруктураПараметровДоступа.Свойство("ПараметрыПрокси") Тогда
		ПараметрыПрокси = СтруктураПараметровДоступа.ПараметрыПрокси;
	Иначе
		ПараметрыПрокси = Неопределено;
	КонецЕсли;
	
	Если ПараметрыПрокси <> Неопределено Тогда
		HTTPПрокси = Новый ИнтернетПрокси;	
		HTTPПрокси.Установить("https", ПараметрыПрокси.Сервер, ПараметрыПрокси.Порт,
			ПараметрыПрокси.Пользователь, ПараметрыПрокси.Пароль, Ложь); 
	Иначе
		HTTPПрокси = Неопределено;
	КонецЕсли;
	
	HTTPСоединение = Новый HTTPСоединение(СерверMAX(), , , , HTTPПрокси, 30, Новый ЗащищенноеСоединениеOpenSSL);
	
	ЗаголовокHTTP = Новый Соответствие;
	ЗаголовокHTTP.Вставить("Content-Type", "application/json");
	Если СтруктураПараметровДоступа.Свойство("Токен") И ЗначениеЗаполнено(СтруктураПараметровДоступа.Токен) Тогда
		ЗаголовокHTTP.Вставить("Authorization", СтруктураПараметровДоступа.Токен);
	КонецЕсли;
	
	HTTPЗапрос = Новый HTTPЗапрос(Ресурс, ЗаголовокHTTP);
	Если Удаление Тогда
		Ответ = HTTPСоединение.Удалить(HTTPЗапрос);
	ИначеЕсли ЗначениеЗаполнено(СтрокаЗапроса) Тогда
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Иначе
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	КонецЕсли;
	
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда
		ТекстОтвета = ПолучитьТекстОшибки(ТекстОтвета, Ответ.КодСостояния);
	КонецЕсли;
	
	Возврат ТекстОтвета;
	
КонецФункции

// Загружает вложение в MAX и возвращает токен файла.
//
// Параметры:
//  Данные			   - ДвоичныеДанные - Данные файла.
//  ИмяФайла			   - Строка - Имя файла с расширением.
//  ТипВложения		   - Строка - Тип вложения (image, video, audio, file).
//  СтруктураПараметровДоступа - Структура - Параметры доступа.
//
// Возвращаемое значение:
//  Строка - Токен загруженного файла.
//
Функция ЗагрузитьВложениеMAX(Данные, ИмяФайла, ТипВложения, СтруктураПараметровДоступа)
	
	ТокенФайла = "";
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение(СерверMAX(), , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
		ЗаголовокHTTP = Новый Соответствие;
		Если СтруктураПараметровДоступа.Свойство("Токен") И ЗначениеЗаполнено(СтруктураПараметровДоступа.Токен) Тогда
			ЗаголовокHTTP.Вставить("Authorization", СтруктураПараметровДоступа.Токен);
		КонецЕсли;
		
		HTTPЗапрос = Новый HTTPЗапрос(URLМетода("uploads"), ЗаголовокHTTP);
		HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(Данные);
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
		СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ТекстОтвета);
		Если СтруктураОтвета.Свойство("token") Тогда
			ТокенФайла = СтруктураОтвета.token;
		ИначеЕсли СтруктураОтвета.Свойство("error") Тогда
			ВызватьИсключение СтруктураОтвета.error;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("CRM_РаботаСМессенджеромMAX.ЗагрузитьВложениеMAX",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось загрузить вложение <" + ИмяФайла + ">: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ТокенФайла;
	
КонецФункции

// Заполняет массив сообщений из обновлений MAX.
//
// Параметры:
//  УчетнаяЗапись   - СправочникСсылка.CRM_УчетныеЗаписиМессенджеров - Учетная запись.
//  Обновления	   - Массив - Массив объектов Update.
//  МассивСообщений - Массив - Заполняемый массив сообщений.
//
Процедура ЗаполнитьСообщенияИзОбновлений(УчетнаяЗапись, Обновления, МассивСообщений)
	
	Для каждого Обновление Из Обновления Цикл
		Если Обновление.Свойство("update_type")
			И Обновление.update_type = "message_created"
			И Обновление.Свойство("message") Тогда
			Сообщение = СообщениеИзДанныхMAX(УчетнаяЗапись, Обновление.message);
			Если Сообщение <> Неопределено Тогда
				МассивСообщений.Добавить(Сообщение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Преобразует объект Message из API MAX в структуру сообщения мессенджера.
//
// Параметры:
//  УчетнаяЗапись - СправочникСсылка.CRM_УчетныеЗаписиМессенджеров - Учетная запись.
//  ДанныеСообщения - Структура - Объект Message из API MAX.
//
// Возвращаемое значение:
//  Структура, Неопределено - Структура сообщения мессенджера.
//
Функция СообщениеИзДанныхMAX(УчетнаяЗапись, ДанныеСообщения)
	
	Если (Не ДанныеСообщения.Свойство("sender") Или ДанныеСообщения.sender = Неопределено)
		И (Не ДанныеСообщения.Свойство("recipient") Или ДанныеСообщения.recipient = Неопределено) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Сообщение = CRM_РаботаСМессенджерамиСервер.СтруктураСообщенияМесенджера();
	Если ДанныеСообщения.Свойство("timestamp") Тогда
		Сообщение.Дата = МестноеВремя(Дата(1970, 1, 1) + Число(ДанныеСообщения.timestamp) / 1000);
	КонецЕсли;
	
	ИмяПользователя = "";
	user_id = "";
	Если ДанныеСообщения.Свойство("sender") И ДанныеСообщения.sender <> Неопределено Тогда
		user_id = Формат(ДанныеСообщения.sender.user_id, "ЧГ=0");
		Если ДанныеСообщения.sender.Свойство("first_name") Тогда
			ИмяПользователя = ДанныеСообщения.sender.first_name;
		КонецЕсли;
		Если ДанныеСообщения.sender.Свойство("last_name") И ЗначениеЗаполнено(ДанныеСообщения.sender.last_name) Тогда
			ИмяПользователя = ИмяПользователя + " " + ДанныеСообщения.sender.last_name;
		КонецЕсли;
	КонецЕсли;
	
	chat_id = "";
	Если ДанныеСообщения.Свойство("recipient") И ДанныеСообщения.recipient <> Неопределено Тогда
		Если ДанныеСообщения.recipient.Свойство("chat_id") Тогда
			chat_id = Формат(ДанныеСообщения.recipient.chat_id, "ЧГ=0");
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(user_id) И ПустаяСтрока(chat_id) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПустаяСтрока(user_id) Тогда
		user_id = chat_id;
	КонецЕсли;
	
	Сообщение.ID_Пользователя = user_id;
	Сообщение.КонтактПредставление = ИмяПользователя;
	Сообщение.Группа = chat_id;
	Сообщение.ГруппаПредставление = chat_id;
	Сообщение.ВидСообщения = "Входящее";
	
	Если ДанныеСообщения.Свойство("body") И ДанныеСообщения.body <> Неопределено Тогда
		Если ДанныеСообщения.body.Свойство("mid") Тогда
			Сообщение.ID_Сообщения = ДанныеСообщения.body.mid;
		КонецЕсли;
		Если ДанныеСообщения.body.Свойство("text") Тогда
			Сообщение.ТекстСообщения = СтрЗаменить(ДанныеСообщения.body.text, "<br>", Символы.ПС);
		КонецЕсли;
		Если ДанныеСообщения.body.Свойство("attachments") И ДанныеСообщения.body.attachments.Количество() > 0 Тогда
			ЗаполнитьВложенияСообщения(Сообщение, ДанныеСообщения.body.attachments, УчетнаяЗапись);
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеСообщения.Свойство("link") И ДанныеСообщения.link <> Неопределено
		И ДанныеСообщения.link.Свойство("message") Тогда
		Если ДанныеСообщения.link.message.Свойство("body") И ДанныеСообщения.link.message.body.Свойство("mid") Тогда
			Сообщение.ID_СообщенияОснования = ДанныеСообщения.link.message.body.mid;
		КонецЕсли;
	КонецЕсли;
	
	Контакт = CRM_РаботаСМессенджерамиСерверПовтИсп.НайтиКонтактПоКонтактнойИнформации(
		ПредставлениеКонтактнойИнформацииПользователя(user_id),
		УчетнаяЗапись, ТипКИМессенджера());
	Если ЗначениеЗаполнено(Контакт) Тогда
		Сообщение.Контакт = Контакт;
	КонецЕсли;
	
	Возврат Сообщение;
	
КонецФункции

// Заполняет вложения сообщения.
//
// Параметры:
//  Сообщение	 - Структура - Структура сообщения мессенджера.
//  Вложения	 - Массив - Массив вложений из API MAX.
//  УчетнаяЗапись - СправочникСсылка.CRM_УчетныеЗаписиМессенджеров - Учетная запись.
//
Процедура ЗаполнитьВложенияСообщения(Сообщение, Вложения, УчетнаяЗапись)
	
	Для каждого Вложение Из Вложения Цикл
		Если Не Вложение.Свойство("type") Тогда
			Продолжить;
		КонецЕсли;
		
		ТипВложения = Вложение.type;
		Если ТипВложения = "inline_keyboard" Или ТипВложения = "location" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Вложение.Свойство("payload") Тогда
			Продолжить;
		КонецЕсли;
		
		АдресФайла = "";
		ИмяФайла = "";
		Если Вложение.payload.Свойство("url") Тогда
			АдресФайла = Вложение.payload.url;
		КонецЕсли;
		Если Вложение.payload.Свойство("filename") Тогда
			ИмяФайла = Вложение.payload.filename;
		КонецЕсли;
		Если Вложение.payload.Свойство("name") Тогда
			ИмяФайла = Вложение.payload.name;
		КонецЕсли;
		
		Если ПустаяСтрока(АдресФайла) Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФайла = СкачатьФайлMAX(АдресФайла, ИмяФайла);
		Если ПараметрыФайла <> Неопределено Тогда
			Сообщение.Вложения.Добавить(ПараметрыФайла);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Скачивает файл вложения по ссылке.
//
// Параметры:
//  АдресФайла - Строка - URL файла.
//  ИмяФайла  - Строка - Имя файла (может быть пустым).
//
// Возвращаемое значение:
//  Структура, Неопределено - Параметры файла.
//
Функция СкачатьФайлMAX(АдресФайла, ИмяФайла)
	
	ПараметрыФайла = Неопределено;
	
	Попытка
		ЧастиАдреса = РазбитьURL(АдресФайла);
		Хост = ЧастиАдреса.Хост;
		ОтносительныйАдрес = ЧастиАдреса.ОтносительныйАдрес;
		
		Соединение = Новый HTTPСоединение(Хост, , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		ВебЗапрос = Новый HTTPЗапрос(ОтносительныйАдрес);
		Ответ = Соединение.Получить(ВебЗапрос);
		Если Ответ.КодСостояния = 200 Тогда
			Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
			Если ПустаяСтрока(ИмяФайла) Тогда
				ИмяФайла = Строка(Новый УникальныйИдентификатор());
			КонецЕсли;
			АдресФайлаВХранилище = ПоместитьВоВременноеХранилище(Данные);
			ПараметрыФайла = Новый Структура;
			ПараметрыФайла.Вставить("ВладелецФайлов", Неопределено);
			ПараметрыФайла.Вставить("Автор", Неопределено);
			Если СтрНайти(ИмяФайла, ".") > 0 Тогда
				ПараметрыФайла.Вставить("ИмяБезРасширения", Лев(ИмяФайла, СтрНайти(ИмяФайла, ".") - 1));
				ПараметрыФайла.Вставить("РасширениеБезТочки", Сред(ИмяФайла, СтрНайти(ИмяФайла, ".") + 1));
			Иначе
				ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяФайла);
				ПараметрыФайла.Вставить("РасширениеБезТочки", "");
			КонецЕсли;
			ПараметрыФайла.Вставить("ВремяИзменения", Неопределено);
			ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", Неопределено);
			ПараметрыФайла.Вставить("АдресФайлаВХранилище", АдресФайлаВХранилище);
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("CRM_РаботаСМессенджеромMAX.СкачатьФайлMAX",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось скачать файл <" + АдресФайла + ">: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат ПараметрыФайла;
	
КонецФункции

// Разбивает URL на хост и относительный адрес.
//
// Параметры:
//  УРЛ - Строка - URL.
//
// Возвращаемое значение:
//  Структура - Структура с полями Хост и ОтносительныйАдрес.
//
Функция РазбитьURL(УРЛ)
	
	ЧастиУРЛ = СтрРазделить(УРЛ, "/", Ложь);
	Хост = "";
	Если ЧастиУРЛ.Количество() > 1 Тогда
		Хост = ЧастиУРЛ[1];
		Если Хост = "" И ЧастиУРЛ.Количество() > 2 Тогда
			Хост = ЧастиУРЛ[2];
		КонецЕсли;
	КонецЕсли;
	
	ЧастиБезПротокола = Новый Массив;
	Для Каждого Часть Из ЧастиУРЛ Цикл
		Если Часть = "http:" Или Часть = "https:" Или Часть = "" Или Часть = Хост Тогда
			Продолжить;
		КонецЕсли;
		ЧастиБезПротокола.Добавить(Часть);
	КонецЦикла;
	
	ОтносительныйАдрес = "/" + СтрСоединить(ЧастиБезПротокола, "/");
	Возврат Новый Структура("Хост, ОтносительныйАдрес", Хост, ОтносительныйАдрес);
	
КонецФункции

// Возвращает URL метода API MAX.
//
// Параметры:
//  Метод - Строка - Имя метода.
//
// Возвращаемое значение:
//  Строка - Относительный путь метода.
//
Функция URLМетода(Метод)
	Возврат "/" + Метод;
КонецФункции

// Возвращает сервер API MAX.
//
// Возвращаемое значение:
//  Строка - Имя сервера.
//
Функция СерверMAX()
	Возврат "platform-api2.max.ru";
КонецФункции

// Возвращает тип вложения по расширению файла.
//
// Параметры:
//  ИмяФайла - Строка - Имя файла с расширением.
//
// Возвращаемое значение:
//  Строка - Тип вложения (image, video, audio, file).
//
Функция ТипВложенияПоРасширению(ИмяФайла)
	
	Расширение = НРег(Прав(ИмяФайла, СтрДлина(ИмяФайла) - СтрНайти(ИмяФайла, ".")));
	Если Расширение = "" Тогда
		Расширение = НРег(ИмяФайла);
	КонецЕсли;
	
	МассивИзображений = Новый Массив;
	МассивИзображений.Добавить("jpg");
	МассивИзображений.Добавить("jpeg");
	МассивИзображений.Добавить("png");
	МассивИзображений.Добавить("gif");
	МассивИзображений.Добавить("tiff");
	МассивИзображений.Добавить("bmp");
	МассивИзображений.Добавить("heic");
	Если МассивИзображений.Найти(Расширение) <> Неопределено Тогда
		Возврат "image";
	КонецЕсли;
	
	МассивВидео = Новый Массив;
	МассивВидео.Добавить("mp4");
	МассивВидео.Добавить("mov");
	МассивВидео.Добавить("mkv");
	МассивВидео.Добавить("webm");
	Если МассивВидео.Найти(Расширение) <> Неопределено Тогда
		Возврат "video";
	КонецЕсли;
	
	МассивАудио = Новый Массив;
	МассивАудио.Добавить("mp3");
	МассивАудио.Добавить("wav");
	МассивАудио.Добавить("m4a");
	МассивАудио.Добавить("ogg");
	Если МассивАудио.Найти(Расширение) <> Неопределено Тогда
		Возврат "audio";
	КонецЕсли;
	
	Возврат "file";
	
КонецФункции

// Возвращает текст ошибки из ответа сервера.
//
// Параметры:
//  ТекстОтвета - Строка - Текст ответа сервера.
//  КодСостояния - Число - Код состояния HTTP.
//
// Возвращаемое значение:
//  Строка - Текст ошибки в формате JSON.
//
Функция ПолучитьТекстОшибки(ТекстОтвета, КодСостояния)
	
	ОписаниеОшибки = "Ошибка HTTP " + Формат(КодСостояния, "ЧГ=0") + ": " + ТекстОтвета;
	СтруктураОшибки = Новый Структура("error", ОписаниеОшибки);
	Возврат CRM_РаботаСМессенджерамиСервер.ПолучитьСтрокуJSON(СтруктураОшибки);
	
КонецФункции

#КонецОбласти

#КонецЕсли
