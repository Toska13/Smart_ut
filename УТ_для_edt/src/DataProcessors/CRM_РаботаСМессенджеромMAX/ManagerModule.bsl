Функция ПолучитьСообщения(УчетнаяЗапись) Экспорт
	
	СтруктураПараметровДоступа = CRM_РаботаСМессенджерамиСерверПовтИсп.СтруктураПараметровДоступа(УчетнаяЗапись);
	Если СтруктураПараметровДоступа = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		Возврат ПолучитьСообщенияGreen(УчетнаяЗапись, СтруктураПараметровДоступа);
	КонецЕсли;
	
	МассивСообщений = Новый Массив;
	
	// Без marker API возвращает только последнее обновление - храним маркер между опросами.
	Ресурс = URLМетода("updates") + ПараметрыОбновлений(УчетнаяЗапись);
	СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ВыполнитьЗапросMAX(
		Ресурс, , СтруктураПараметровДоступа));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("updates") Тогда
		ЗаполнитьСообщенияИзОбновлений(УчетнаяЗапись, СтруктураОтвета.updates, МассивСообщений);
		СохранитьМаркерОбновлений(УчетнаяЗапись, СтруктураОтвета);
	КонецЕсли;
	
	Возврат МассивСообщений;
	
КонецФункции

Функция ОтправитьСообщение(Сообщение, УчетнаяЗапись, IDПользователя, СписокФайлов, ДопПараметры) Экспорт
	
	СтруктураПараметровДоступа = CRM_РаботаСМессенджерамиСерверПовтИсп.СтруктураПараметровДоступа(УчетнаяЗапись);
	Если СтруктураПараметровДоступа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		Возврат ОтправитьСообщениеGreen(Сообщение, УчетнаяЗапись, IDПользователя,
			СписокФайлов, СтруктураПараметровДоступа);
	КонецЕсли;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("text", Сообщение);
	
	Если СписокФайлов <> Неопределено И СписокФайлов.Количество() > 0 Тогда
		МассивВложений = Новый Массив;
		Для каждого Вложение Из СписокФайлов Цикл
			ДанныеВложения = Вложение.Значение;
			Если ТипЗнч(ДанныеВложения) = Тип("ДвоичныеДанные") Тогда
				ТипВложения = ТипВложенияПоРасширению(Вложение.Представление);
				ТокенВложения = ЗагрузитьВложениеMAX(ДанныеВложения, Вложение.Представление,
					ТипВложения, СтруктураПараметровДоступа);
				Если ЗначениеЗаполнено(ТокенВложения) Тогда
					ВложениеMAX = Новый Структура("type, payload", ТипВложения,
						Новый Структура("token", ТокенВложения));
					МассивВложений.Добавить(ВложениеMAX);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если МассивВложений.Количество() > 0 Тогда
			ДанныеЗапроса.Вставить("attachments", МассивВложений);
		КонецЕсли;
	КонецЕсли;
	
	Ресурс = URLМетода("messages");
	Если ЗначениеЗаполнено(IDПользователя) Тогда
		Ресурс = Ресурс + "?user_id=" + IDПользователя;
	КонецЕсли;
	
	СтрокаЗапроса = CRM_РаботаСМессенджерамиСервер.ПолучитьСтрокуJSON(ДанныеЗапроса);
	СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ВыполнитьЗапросMAX(
		Ресурс, СтрокаЗапроса, СтруктураПараметровДоступа));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("message")
		И СтруктураОтвета.message.Свойство("body")
		И СтруктураОтвета.message.body.Свойство("mid") Тогда
		Возврат СтруктураОтвета.message.body.mid;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОжиданиеСобытий(УчетнаяЗапись, ОднаИтерация = Ложь) Экспорт
	
	// MAX получает события через Long Polling (GET /updates) либо Webhook.
	// Long Polling используется как резервный способ получения обновлений
	// для учётных записей без настроенного Webhook.
	// Для Green-API — через receiveNotification / webhook Green.
	
	СтруктураПараметровДоступа = CRM_РаботаСМессенджерамиСерверПовтИсп.СтруктураПараметровДоступа(УчетнаяЗапись);
	Если СтруктураПараметровДоступа = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтруктураПараметровДоступа.Свойство("ИспользоватьWebhook")
		И СтруктураПараметровДоступа.ИспользоватьWebhook Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоПровайдерGreen(СтруктураПараметровДоступа) Тогда
		ОжиданиеСобытийGreen(УчетнаяЗапись, СтруктураПараметровДоступа);
		Возврат;
	КонецЕсли;
	
	МассивСообщений = Новый Массив;
	// Без marker API возвращает только последнее обновление - храним маркер между опросами.
	Ресурс = URLМетода("updates") + ПараметрыОбновлений(УчетнаяЗапись);
	СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ВыполнитьЗапросMAX(
		Ресурс, , СтруктураПараметровДоступа));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("updates") Тогда
		ЗаполнитьСообщенияИзОбновлений(УчетнаяЗапись, СтруктураОтвета.updates, МассивСообщений);
		Если МассивСообщений.Количество() > 0 Тогда
			CRM_РаботаСМессенджерамиСервер.СоздатьСообщенияИзПолученныхДанных(УчетнаяЗапись, МассивСообщений);
		КонецЕсли;
		СохранитьМаркерОбновлений(УчетнаяЗапись, СтруктураОтвета);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьВидКИМессенджера(Контакт) Экспорт
	
	Наименование = "MAX";
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВидыКонтактнойИнформации.Ссылка КАК Ссылка,
	                      |	ВидыКонтактнойИнформации.ПометкаУдаления КАК ПометкаУдаления
	                      |ИЗ
	                      |	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	                      |ГДЕ
	                      |	ВидыКонтактнойИнформации.Наименование = &Наименование
	                      |	И ВидыКонтактнойИнформации.Тип = &Тип
	                      |	И ВидыКонтактнойИнформации.Родитель = &Родитель");
	
	Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Партнеры") Тогда
		Родитель = Справочники.ВидыКонтактнойИнформации.CRM_СправочникПартнерыЧастноеЛицо;
	ИначеЕсли ТипЗнч(Контакт) = Тип("СправочникСсылка.КонтактныеЛицаПартнеров") Тогда
		Родитель = Справочники.ВидыКонтактнойИнформации.СправочникКонтактныеЛицаПартнеров;
	ИначеЕсли ТипЗнч(Контакт) = Тип("СправочникСсылка.CRM_ПотенциальныеКлиенты") Тогда
		Родитель = Справочники.ВидыКонтактнойИнформации.СправочникCRM_ПотенциальныеКлиенты;
	КонецЕсли;
	
	ТипКИ = ТипКИМессенджера();
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Тип", ТипКИ);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ПометкаУдаления Тогда
			Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Возврат Выборка.Ссылка;
	Иначе
		УстановитьПривилегированныйРежим(Истина);
		НовыйВидКИ = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
		НовыйВидКИ.Родитель = Родитель;
		НовыйВидКИ.Наименование = Наименование;
		НовыйВидКИ.Тип = ТипКИ;
		НовыйВидКИ.Используется = Истина;
		НовыйВидКИ.ВидРедактирования = "Диалог";
		НовыйВидКИ.Записать();
		УстановитьПривилегированныйРежим(Ложь);
		Возврат НовыйВидКИ.Ссылка;
	КонецЕсли;
	
КонецФункции

