			Ресурс, СтруктураПараметровДоступа.ПараметрыПрокси));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
КонецПроцедуры

Функция СерверGreen(СтруктураПараметровДоступа)
	
	Если СтруктураПараметровДоступа.Свойство("Сервер") И ЗначениеЗаполнено(СтруктураПараметровДоступа.Сервер) Тогда
		Возврат НормализоватьХостGreen(СтруктураПараметровДоступа.Сервер);
	КонецЕсли;
	Возврат "api.green-api.com";
	
КонецФункции

Функция СерверMediaGreen(СтруктураПараметровДоступа)
	
	Если СтруктураПараметровДоступа.Свойство("MediaURL") И ЗначениеЗаполнено(СтруктураПараметровДоступа.MediaURL) Тогда
		Возврат НормализоватьХостGreen(СтруктураПараметровДоступа.MediaURL);
	КонецЕсли;
	
	ХостAPI = СерверGreen(СтруктураПараметровДоступа);
	Возврат СтрЗаменить(ХостAPI, ".api.", ".media.");
	
КонецФункции

Функция НормализоватьХостGreen(Знач Хост)
	
	Хост = СокрЛП(Хост);
	Хост = СтрЗаменить(Хост, "https://", "");
	Хост = СтрЗаменить(Хост, "http://", "");
	Пока Прав(Хост, 1) = "/" Цикл
		Хост = Лев(Хост, СтрДлина(Хост) - 1);
	КонецЦикла;
	Возврат Хост;
	
КонецФункции

Функция URLМетодаСервисаGreen(Инстанс, Токен, Метод)
	
	Возврат СтрШаблон("waInstance%1/%2/%3", Инстанс, Метод, Токен);
	
КонецФункции

