Процедура ПроверитьПодключение(ПараметрыПроверки, ПараметрыПрокси) Экспорт
	
	СтруктураПараметровДоступа = Новый Структура;
	СтруктураПараметровДоступа.Вставить("Токен", ПараметрыПроверки.Токен);
	СтруктураПараметровДоступа.Вставить("ПараметрыПрокси", ПараметрыПрокси);
	
	Если ПараметрыПроверки.Свойство("Провайдер") И ПараметрыПроверки.Провайдер = 1 Тогда
		СтруктураПараметровДоступа.Вставить("Провайдер", 1);
		СтруктураПараметровДоступа.Вставить("ApiURL", ПараметрыПроверки.ApiURL);
		СтруктураПараметровДоступа.Вставить("Сервер", ПараметрыПроверки.Сервер);
		ПроверитьПодключениеGreen(СтруктураПараметровДоступа);
		Возврат;
	КонецЕсли;
	
	СтруктураОтвета = CRM_РаботаСМессенджерамиСервер.ПолучитьЗначениеИзОтветаJSON(ВыполнитьЗапросMAX(
		URLМетода("me"), , СтруктураПараметровДоступа));
	Если СтруктураОтвета.Свойство("error") Тогда
		ВызватьИсключение СтруктураОтвета.error;
	КонецЕсли;
	
КонецПроцедуры

