#КонецОбласти

#Область ОпределитьАбонентов

Процедура ОпределитьАбонентов(СтруктураПараметров, АдресРезультата = Неопределено) Экспорт
	
	ЗаполнитьНастройкиОбработки();
	
	//По умолчанию определение абонентов за последние 6 месяцев
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаНачала) Тогда
		СтруктураПараметров.ДатаНачала = НачалоДня(ДобавитьМесяц(ТекущаяДата(), -6));
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаОкончания) Тогда
		СтруктураПараметров.ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;	
	
	Если СтруктураПараметров.ВыполнятьВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, "Формирование списка телефонов партнеров");
		ДлительныеОперации.СообщитьПрогресс(0, "Обработка телефонных звонков");
	КонецЕсли;	
	
	ОбработаноЗаписей = 0;
	
	ОбработатьЗвонкиБезАбонентов(СтруктураПараметров, ОбработаноЗаписей);
	
	Если СтруктураПараметров.ВыполнятьВФоне Тогда
		ПоместитьВоВременноеХранилище(ОбработаноЗаписей, АдресРезультата);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ОбработатьЗвонкиБезАбонентов(СтруктураПараметров, КоличествоИтераций = 0)
	
	ТЗТелефоныПартнеров = ПолучитьТелефоныПартнеров(СтруктураПараметров.ВыполнятьВФоне);
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ДатаНачала", 	   СтруктураПараметров.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	   СтруктураПараметров.ДатаОкончания);
	Запрос.УстановитьПараметр("ТелефоныПартнеров", ТЗТелефоныПартнеров);

	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТелефонныйЗвонок.Ссылка КАК Ссылка,
		|	СОКРЛП(ТелефонныйЗвонок.АбонентКакСвязаться) КАК АбонентКакСвязаться,
		|	ТелефонныйЗвонок.АбонентКонтакт КАК АбонентКонтакт,
		|	ТИПЗНАЧЕНИЯ(ТелефонныйЗвонок.АбонентКонтакт) КАК ТипАбонента,
		|	ТелефонныйЗвонок.АбонентПредставление КАК АбонентПредставление
		|ПОМЕСТИТЬ ВТ_Звонки
		|ИЗ
		|	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
		|ГДЕ
		|	ТелефонныйЗвонок.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И (ТИПЗНАЧЕНИЯ(ТелефонныйЗвонок.АбонентКонтакт) <> ТИП(Справочник.Партнеры)
		|			ИЛИ ТелефонныйЗвонок.АбонентКонтакт = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВрТелефоныПартнеров.Абонент КАК Абонент,
		|	ВЫРАЗИТЬ(СОКРЛП(ВрТелефоныПартнеров.НомерТелефона) КАК СТРОКА(20)) КАК НомерТелефона
		|ПОМЕСТИТЬ ВТ_ТелефоныПартнеровИсх
		|ИЗ
		|	&ТелефоныПартнеров КАК ВрТелефоныПартнеров
		|ГДЕ
		|	ДЛИНАСТРОКИ(ВЫРАЗИТЬ(СОКРЛП(ВрТелефоныПартнеров.НомерТелефона) КАК СТРОКА(20))) > 2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТелефоныПартнеровИсх.НомерТелефона КАК НомерТелефона,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ТелефоныПартнеровИсх.Абонент) КАК КолВоАбонентов
		|ПОМЕСТИТЬ ВТ_ДублиНомеров
		|ИЗ
		|	ВТ_ТелефоныПартнеровИсх КАК ВТ_ТелефоныПартнеровИсх
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ТелефоныПартнеровИсх.НомерТелефона
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ТелефоныПартнеровИсх.НомерТелефона КАК НомерТелефона,
		|	ВТ_ТелефоныПартнеровИсх.Абонент КАК Абонент,
		|	ВТ_ДублиНомеров.КолВоАбонентов КАК КолВоАбонентов
		|ПОМЕСТИТЬ ВТ_ТелефоныПартнеров
		|ИЗ
		|	ВТ_ТелефоныПартнеровИсх КАК ВТ_ТелефоныПартнеровИсх
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДублиНомеров КАК ВТ_ДублиНомеров
		|		ПО ВТ_ТелефоныПартнеровИсх.НомерТелефона = ВТ_ДублиНомеров.НомерТелефона
		|ГДЕ
		|	ВТ_ДублиНомеров.КолВоАбонентов = 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Звонки.Ссылка КАК Ссылка,
		|	ВТ_Звонки.АбонентПредставление КАК ТелефонныйЗвонокАбонентПредставление,
		|	ВТ_Звонки.АбонентКакСвязаться КАК АбонентКакСвязаться,
		|	ВТ_Звонки.АбонентКонтакт КАК АбонентКонтакт,
		|	ВТ_ТелефоныПартнеров.Абонент КАК Абонент,
		|	ВЫБОР
		|		КОГДА ВТ_ДублиНомеров.КолВоАбонентов = 1
		|			ТОГДА ПРЕДСТАВЛЕНИЕ(ВТ_ТелефоныПартнеров.Абонент)
		|		КОГДА ВТ_ДублиНомеров.КолВоАбонентов > 1
		|			ТОГДА СТРОКА(ВТ_ДублиНомеров.КолВоАбонентов) + "" дублей номеров абонентов!""
		|		КОГДА ВТ_ДублиНомеров.КолВоАбонентов ЕСТЬ NULL
		|			ТОГДА ""<Номер не найден!>""
		|	КОНЕЦ КАК АбонентПредставление,
		|	ВТ_ДублиНомеров.КолВоАбонентов КАК КолВоАбонентов
		|ИЗ
		|	ВТ_Звонки КАК ВТ_Звонки
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТелефоныПартнеров КАК ВТ_ТелефоныПартнеров
		|		ПО ВТ_Звонки.АбонентКакСвязаться = ВТ_ТелефоныПартнеров.НомерТелефона
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДублиНомеров КАК ВТ_ДублиНомеров
		|		ПО ВТ_Звонки.АбонентКакСвязаться = ВТ_ДублиНомеров.НомерТелефона
		|ГДЕ
		|	НЕ ВТ_ДублиНомеров.КолВоАбонентов ЕСТЬ NULL
		|	И ВТ_Звонки.АбонентКонтакт = НЕОПРЕДЕЛЕНО";
	
	Результат = Запрос.Выполнить();

	Выборка = Результат.Выбрать();
	
	КоличествоИтераций = Выборка.Количество();
	
	ТекстОшибок = "";
	
	Ин = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Абонент) 
			ИЛИ (ЗначениеЗаполнено(Выборка.АбонентПредставление) И Выборка.АбонентПредставление <> Выборка.ТелефонныйЗвонокАбонентПредставление) Тогда
		
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			Если ЗначениеЗаполнено(Выборка.Абонент) Тогда
				
				ДокОбъект.АбонентКонтакт = Выборка.Абонент;
				ДокОбъект.АбонентПредставление = СокрЛП(Выборка.АбонентПредставление);
				
			Иначе
				
				ДокОбъект.АбонентКонтакт = Неопределено;
				
				Если НЕ ЗначениеЗаполнено(Выборка.ТелефонныйЗвонокАбонентПредставление) 
					ИЛИ Выборка.ТелефонныйЗвонокАбонентПредставление = "!!!Не определен!!!" 
					ИЛИ Выборка.ТелефонныйЗвонокАбонентПредставление = "<Номер не найден!>"
					ИЛИ СтрНайти(Выборка.ТелефонныйЗвонокАбонентПредставление, "дублей номеров абонентов") <> 0 Тогда
					
					ДокОбъект.АбонентПредставление = СокрЛП(Выборка.АбонентПредставление);
					
				КонецЕсли;
				
			КонецЕсли;	

			ДокОбъект.ОбменДанными.Загрузка	= Истина;
			
			Успешно = Ложь;
			
			Попытка							   
				ДокОбъект.Записать();
				Успешно = Истина;
			Исключение
				ЗаписьЖурналаРегистрации("ОпределениеАбонентовТелефонныхЗвонков", УровеньЖурналаРегистрации.Ошибка, , , "Не удалось записать: " + СокрЛП(Выборка.Ссылка));
			КонецПопытки;	
			
		КонецЕсли;
		
		Если СтруктураПараметров.ВыполнятьВФоне Тогда
			Ин = Ин + 1;
			ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
			ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Определение абонентов: " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
		КонецЕсли;	
		
	КонецЦикла;

	Если ТекстОшибок <> "" Тогда

		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибки обновления тэгов звонков в сервисе речевой аналитики imot.io'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибок);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция ПрочитатьНастройкиОбновленияТэгов(ИдентификаторОбработки) Экспорт

	ДополнительнаяОбработкаСсылка = ПолучитьЭлементСправочникаДополнительныеОтчетыИОбработки(ИдентификаторОбработки);
	
	Если ДополнительнаяОбработкаСсылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
   
	НастройкиОбработки = ДополнительнаяОбработкаСсылка.ХранилищеНастроек.Получить();
	
	Если ТипЗнч(НастройкиОбработки) = Тип("Структура") Тогда
		
		Возврат НастройкиОбработки;
		
	Иначе
		
		Возврат Неопределено;	
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЭлементСправочникаДополнительныеОтчетыИОбработки(Идентификатор) Экспорт
	
	Результат = Справочники.ДополнительныеОтчетыИОбработки.ПустаяСсылка();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ДополнительныеОтчетыИОбработкиКоманды.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Справочник.ДополнительныеОтчетыИОбработки.Команды КАК ДополнительныеОтчетыИОбработкиКоманды
	                      |ГДЕ
	                      |	ДополнительныеОтчетыИОбработкиКоманды.Идентификатор = &Идентификатор");
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Ссылка;
	
	КонецЕсли;
	
	Возврат Результат;	
	
КонецФункции

Функция ПолучитьПараметрыОбновленияТэговIMOTIO(ДокОбъект, НастройкиОбновленияТэгов, ТекстОшибок)
	
	ТекстОшибки = "";
	
    ПараметрыОбновления = Новый Структура;

	ПараметрыОбновления.Вставить("HTTPМетод",  		     "POST");
	ПараметрыОбновления.Вставить("ЗащищенноеСоединение", Новый ЗащищенноеСоединениеOpenSSL());
	ПараметрыОбновления.Вставить("Соединение", 		   	 НастройкиОбновленияТэгов.АдресAPI);
	ПараметрыОбновления.Вставить("АдресРесурса",	 	 "/call/" + ДокОбъект.смартИдентификаторIMOT + "/params");
	ПараметрыОбновления.Вставить("Токен",      			 НастройкиОбновленияТэгов.APIKey); 
	
	ПараметрыОбновления.Вставить("ТелефонныйЗвонок", 	 ДокОбъект.Ссылка);
	
	ПараметрыОбновления.Вставить("ТелефонКлиента",       ДокОбъект.АбонентКакСвязаться); 
	ПараметрыОбновления.Вставить("ДатаЗвонка",  		 ПолучитьДатуUnixTimeStamp(ДокОбъект.Дата)); 
	
	ТэгиДляОбновления = Новый Соответствие;
	ТэгиДляОбновления.Вставить("Клиент", 				 СокрЛП(ДокОбъект.АбонентПредставление));
	ТэгиДляОбновления.Вставить("Контакт",   			 СокрЛП(ДокОбъект.АбонентКонтакт));
	ТэгиДляОбновления.Вставить("Сотрудник", 			 СокрЛП(ДокОбъект.Ответственный));
	
	ПараметрыОбновления.Вставить("ТэгиДляОбновления", 	 ТэгиДляОбновления); 
	
	Возврат ПараметрыОбновления;
	
КонецФункции

Процедура ОбновитьТэгиЗвонковВРечевойАналитикеIMOTIO(ПараметрыВыгрузки, ТекстОшибок)

	//HTTP-запрос
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Accept", 	   "application/json");
	ЗаголовокЗапросаHTTP.Вставить("Authorization", "Bearer " + ПараметрыВыгрузки.Токен);
	ЗаголовокЗапросаHTTP.Вставить("Content-Type",  "application/json");
	
	ТелоЗапроса = Новый Структура;
	
	Если ПараметрыВыгрузки.Свойство("ТелефонКлиента") Тогда
		ТелоЗапроса.Вставить("client_phone", ПараметрыВыгрузки.ТелефонКлиента);
	КонецЕсли;

	Если ПараметрыВыгрузки.Свойство("ДатаЗвонка") Тогда
		ТелоЗапроса.Вставить("call_time", ПараметрыВыгрузки.ДатаЗвонка);
	КонецЕсли;
	
	//Обновление тэгов
	МассивТэгов = Новый Массив;
	
	Для Каждого Тэг Из ПараметрыВыгрузки.ТэгиДляОбновления Цикл
		
		СтруктураПараметровТэга = Новый Структура;
			
		СтруктураПараметровТэга.Вставить("tag_type", "upload");
		СтруктураПараметровТэга.Вставить("name", 	 Тэг.Ключ);
		СтруктураПараметровТэга.Вставить("value",    ?(Тэг.Значение = "Удалить", "", Тэг.Значение));
		СтруктураПараметровТэга.Вставить("visible",  Тэг.Значение <> "Удалить");
		
		МассивТэгов.Добавить(СтруктураПараметровТэга);
		
	КонецЦикла;
	
	ТелоЗапроса.Вставить("tags", МассивТэгов);
	
	HTTPЗапрос = Новый HTTPЗапрос(ПараметрыВыгрузки.АдресРесурса, ЗаголовокЗапросаHTTP);

	ДанныеТелаЗапроса = смартОбщегоНазначения.ЗначениеВJSON(ТелоЗапроса);
	HTTPЗапрос.УстановитьТелоИзСтроки(ДанныеТелаЗапроса);

	Соединение = Новый HTTPСоединение(ПараметрыВыгрузки.Соединение, , , , , 60, ПараметрыВыгрузки.ЗащищенноеСоединение); 
	
	HTTPОтвет = Неопределено;
	
	Попытка

		HTTPОтвет = Соединение.ВызватьHTTPМетод(ПараметрыВыгрузки.HTTPМетод, HTTPЗапрос);
		
	Исключение

		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
					  + "Ошибка соединения " + ПараметрыВыгрузки.Соединение 
					  + " при обновлении парамеров звонка в сервисе речевой аналитики imot.io: " 
					  + СокрЛП(ПараметрыВыгрузки.ТелефонныйЗвонок);
					  
	КонецПопытки;
		
	//Обработка ответа
	Если HTTPОтвет <> Неопределено И ТипЗнч(HTTPОтвет) = Тип("HTTPОтвет") Тогда

		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
		
		Если HTTPОтвет.КодСостояния = 200 Тогда
			

		Иначе
			
			ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
						  + "Ошибка обновлении парамеров звонка в сервисе речевой аналитики imot.io: " 
						  + СокрЛП(ПараметрыВыгрузки.ТелефонныйЗвонок) + Символы.ПС
						  + ТелоОтвета;
			
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДатуUnixTimeStamp(ДатаЗвонка) 

	Возврат Формат(УниверсальноеВремя(ДатаЗвонка) - Дата(1970, 1, 1), "ЧГ=0");
	
КонецФункции

Процедура ОбновитьAPIТокенIMOTIO(НастройкиIMOTIO) Экспорт
	
	Если НЕ (ЗначениеЗаполнено(НастройкиIMOTIO.Логин)
			 И ЗначениеЗаполнено(НастройкиIMOTIO.Пароль)) Тогда
		Возврат;
	КонецЕсли;	

	ТекстОшибок = "";
	
    ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("HTTPМетод",  		     "POST");
	ПараметрыОбновления.Вставить("ЗащищенноеСоединение", Новый ЗащищенноеСоединениеOpenSSL());
	ПараметрыОбновления.Вставить("Соединение", 		   	 НастройкиIMOTIO.АдресAPI);
	ПараметрыОбновления.Вставить("АдресРесурса",	 	 "/token");
	ПараметрыОбновления.Вставить("Логин",  	    		 НастройкиIMOTIO.Логин); 
	ПараметрыОбновления.Вставить("Пароль",      		 НастройкиIMOTIO.Пароль); 
	
	//HTTP-запрос
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Accept", 	   		 "application/json");
	ЗаголовокЗапросаHTTP.Вставить("Content-Type",  		 "application/x-www-form-urlencoded");
	
	ПараметрыТелаЗапроса = Новый Структура;
	
	ПараметрыТелаЗапроса.Вставить("grant_type",	   		 "");
	ПараметрыТелаЗапроса.Вставить("username",	   		 ПараметрыОбновления.Логин);
	ПараметрыТелаЗапроса.Вставить("password", 	   		 ПараметрыОбновления.Пароль);
	ПараметрыТелаЗапроса.Вставить("scope", 	   	   		 "");
	ПараметрыТелаЗапроса.Вставить("client_id",	   		 "");
	ПараметрыТелаЗапроса.Вставить("client_secret", 		 "");
	
	ТелоЗапроса = "";
	
	Для Каждого ПараметрТелаЗапроса Из ПараметрыТелаЗапроса Цикл
		
		ТелоЗапроса = ТелоЗапроса + ПараметрТелаЗапроса.Ключ + "=";
		
		Если ЗначениеЗаполнено(ПараметрТелаЗапроса.Значение) Тогда
			ТелоЗапроса = ТелоЗапроса + ПараметрТелаЗапроса.Значение;
		КонецЕсли;	
			
		ТелоЗапроса = ТелоЗапроса + "&";
		
	КонецЦикла;	
	
	ТелоЗапроса = Лев(ТелоЗапроса, СтрДлина(ТелоЗапроса) - 1);
	
	HTTPЗапрос = Новый HTTPЗапрос(ПараметрыОбновления.АдресРесурса, ЗаголовокЗапросаHTTP);
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса, , ИспользованиеByteOrderMark.НеИспользовать);
	Соединение = Новый HTTPСоединение(ПараметрыОбновления.Соединение, , , , , , ПараметрыОбновления.ЗащищенноеСоединение); 
	HTTPОтвет = Неопределено;
	
	Попытка

		HTTPОтвет = Соединение.ВызватьHTTPМетод(ПараметрыОбновления.HTTPМетод, HTTPЗапрос);
		
	Исключение

		ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
					  + "Ошибка соединения " + ПараметрыОбновления.Соединение 
					  + " при обновлении API токена речевой аналитики imot.io";
					  
	КонецПопытки;
		
	//Обработка ответа
	Если HTTPОтвет <> Неопределено И ТипЗнч(HTTPОтвет) = Тип("HTTPОтвет") Тогда

		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();

		Если HTTPОтвет.КодСостояния = 200 
			ИЛИ HTTPОтвет.КодСостояния = 422 Тогда
		
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
			
			Если ЗначениеЗаполнено(ТелоОтвета) Тогда
			
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
				
				Попытка
					
					СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
					
				Исключение
					
					ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
								  + "Ошибка обновлении API токена речевой аналитики imot.io: " 
								  + Символы.ПС
								  + ТелоОтвета;

					СтруктураИзJSON = Неопределено;
								  
				КонецПопытки;
		
				Если ТипЗнч(СтруктураИзJSON) = Тип("Структура") Тогда

					Если HTTPОтвет.КодСостояния = 200 Тогда
					
						Если СтруктураИзJSON.Свойство("access_token") Тогда

							НастройкиIMOTIO.APIKey = СтруктураИзJSON.access_token;
							
						КонецЕсли;	
					
					КонецЕсли;

				КонецЕсли;

			Иначе
				
				ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
							  + "Ошибка обновлении API токена речевой аналитики imot.io: " 
							  + Символы.ПС
							  + ТелоОтвета;
				
			КонецЕсли;
			
		Иначе
			
			ТекстОшибок = ТекстОшибок + Символы.ПС + Символы.ПС 
						  + "Ошибка обновлении API токена речевой аналитики imot.io: " 
						  + Символы.ПС
						  + ТелоОтвета;
			
		КонецЕсли;

	КонецЕсли;

	Если ТекстОшибок <> "" Тогда

		ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибки выгрузки звонков в сервис речевой аналитики imot.io'", 
								 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибок);
		
	КонецЕсли;	
	
КонецПроцедуры

