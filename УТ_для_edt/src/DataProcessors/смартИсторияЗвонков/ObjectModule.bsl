
#Область Интерфейс

Процедура ЗаполнитьНастройкиОбработки() Экспорт
	
	СЗНомеровСекретаря.ЗагрузитьЗначения(Справочники.смартПредопределенныеЗначения.Настройки.НомераСекретарей.ВыгрузитьКолонку("НомерТелефона"));
	
КонецПроцедуры

Процедура ПолучитьИсториюЗвонков(СтруктураПараметров, АдресРезультата = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаНачала) Тогда
		СтруктураПараметров.ДатаНачала = НачалоДня(ТекущаяДата());
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаОкончания) Тогда
		СтруктураПараметров.ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;	

	Звонки.Очистить();

	Если СтруктураПараметров.АТС = ""
		ИЛИ СтруктураПараметров.АТС = Справочники.смартВидыАТС.Мегафон
		ИЛИ СтруктураПараметров.АТС = Справочники.смартВидыАТС.МегафонКовчег
		Тогда

		// Мегафон
		ПользователиАТС.Очистить();

		Если СтруктураПараметров.Организация = "" Тогда

			МегафонПолучитьИсториюЗвонковНаСервере(СтруктураПараметров, Справочники.смартВидыАТС.Мегафон);
			МегафонПолучитьИсториюЗвонковНаСервере(СтруктураПараметров, Справочники.смартВидыАТС.МегафонКовчег);
			
			ПолучитьПользователейВАТСНаСервере(СтруктураПараметров, Справочники.смартВидыАТС.Мегафон);
			ПолучитьПользователейВАТСНаСервере(СтруктураПараметров, Справочники.смартВидыАТС.МегафонКовчег);
			
		Иначе	
			
			МегафонПолучитьИсториюЗвонковНаСервере(СтруктураПараметров, СтруктураПараметров.АТС);
			ПолучитьПользователейВАТСНаСервере(СтруктураПараметров, СтруктураПараметров.АТС);
			
		КонецЕсли;

	КонецЕсли;
	
	Если СтруктураПараметров.АТС = "" 
		ИЛИ СтруктураПараметров.АТС = Справочники.смартВидыАТС.Asterisk 
		Тогда

		// Asterisk
		AsteriskПолучитьИсториюЗаПериодНаСервере(СтруктураПараметров, Справочники.смартВидыАТС.Asterisk);

	КонецЕсли;
	
	Если Звонки.Количество() > 0 Тогда
		
		ОпределитьАбонентовВИсторииЗвонков(Звонки.Выгрузить(), ПользователиАТС.Выгрузить(), СтруктураПараметров);
	
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область РаботаСоЗвонками

Процедура ОпределитьАбонентовВИсторииЗвонков(ТаблицаЗвонки, ПользователиАТС, СтруктураПараметров)
	
	Запрос = Новый Запрос;

	// Установка значений параметров
	Запрос.УстановитьПараметр("ТекущаяДата", 	 	 ТекущаяДата());
	Запрос.УстановитьПараметр("ТаблицаЗвонки",   	 ТаблицаЗвонки);
	Запрос.УстановитьПараметр("ПользователиАТС", 	 ПользователиАТС);
	Запрос.УстановитьПараметр("НомерТелефонаФильтр", СтруктураПараметров.НомерТелефона);
	Запрос.УстановитьПараметр("ТолькоНеСозданные",   СтруктураПараметров.ТолькоНеСозданные);

	ЗаполнитьНастройкиОбработки();
	
	Если СЗНомеровСекретаря.Количество() > 0 Тогда
		
		МассивНомеровСекретаря = СЗНомеровСекретаря.ВыгрузитьЗначения();
		
	Иначе		
														  
		МассивНомеровСекретаря = Новый Массив;
		МассивНомеровСекретаря.Добавить("101");
		МассивНомеровСекретаря.Добавить("108");
		МассивНомеровСекретаря.Добавить("262");
		МассивНомеровСекретаря.Добавить("263");
		МассивНомеровСекретаря.Добавить("300");
		
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("МассивНомеровСекретаря", МассивНомеровСекретаря);
	Запрос.УстановитьПараметр("ПользовательСекретарь",  Справочники.Пользователи.ПолучитьСсылку(
														    Новый УникальныйИдентификатор("2AD3C3C6-0C04-11E8-BA91-000C2952BB0F"))); // Секретарь

