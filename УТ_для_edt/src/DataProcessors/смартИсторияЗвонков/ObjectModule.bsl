	|	Таблица.Date";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Звонки.Загрузить(Результат);
	
КонецПроцедуры

Процедура СоздатьЗвонки(СтруктураПараметров) Экспорт

	Ин = 0;
	КоличествоИтераций = Звонки.Количество();
	
	Для Каждого СтрокаЗвонок Из Звонки Цикл
		
		ДокументТелефонныйЗвонок = СтрокаЗвонок.ТелефонныйЗвонок;
		
		Если НЕ СтруктураПараметров.ЗагружатьПринудительно 
			И ЗначениеЗаполнено(ДокументТелефонныйЗвонок) Тогда
			
			Если СтрокаЗвонок.смартЗагруженИзАТС Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(СокрЛП(ВернутьТолькоЦифры(СтрокаЗвонок.CLIENT))) Тогда
			Продолжить;
		КонецЕсли;	
		
		//Параметры звонка
		ПараметрыДокумента = Новый Структура("Абонент, 
											 |АбонентПредставление, 
											 |НомерТелефонаАбонента, 
											 |Пользователь, 
											 |Сотрудник, 
											 |ВнутреннийНомерПользователя, 
											 |Входящий, 
											 |ДатаНачалаРазговора, 
											 |ВремяОжидания, 
											 |Продолжительность, 
											 |Пропущенный, 
											 |СсылкаНаЗапись, 
											 |ИдентификаторЗвонка, 
											 |ИдентификаторЗвонкаОснование, 
											 |Комментарий,
											 |смартВидАТС,
											 |смартПолученныеДаныеОтАТС");
		
		ПараметрыДокумента.смартВидАТС 				    = СтрокаЗвонок.АТС;
		ПараметрыДокумента.смартПолученныеДаныеОтАТС    = СтрокаЗвонок.JSON;	
		
		ПараметрыДокумента.ДатаНачалаРазговора 		    = СтрокаЗвонок.DATE;	
		ПараметрыДокумента.ИдентификаторЗвонка 		    = СтрокаЗвонок.UID;
		ПараметрыДокумента.ИдентификаторЗвонкаОснование = СтрокаЗвонок.TRANSFER_UID;
		ПараметрыДокумента.СсылкаНаЗапись 	   		    = СтрокаЗвонок.RECORD;
		
		ПараметрыДокумента.Абонент 				 	    = СтрокаЗвонок.CLIENT_Абонент;
		ПараметрыДокумента.АбонентПредставление  	    = СтрокаЗвонок.CLIENT_Представление;
		ПараметрыДокумента.НомерТелефонаАбонента 	    = СтрокаЗвонок.CLIENT;

		ПараметрыДокумента.Пользователь 			    = СтрокаЗвонок.USER_Абонент;
		ПараметрыДокумента.Сотрудник 				    = ПараметрыДокумента.Пользователь;
		ПараметрыДокумента.ВнутреннийНомерПользователя  = НомерБезКода(СтрокаЗвонок.USER);
		
		СтруктураДопПараметры = Новый Структура;
		
		СтруктураДопПараметры.Вставить("Входящий", 			СтрокаЗвонок.Входящий);
		СтруктураДопПараметры.Вставить("Продолжительность",	СтрокаЗвонок.DURATION);
		СтруктураДопПараметры.Вставить("ВремяОжидания",		СтрокаЗвонок.TO_ANSWER);
		СтруктураДопПараметры.Вставить("Комментарий", 		"");

		Если ТипЗнч(СтрокаЗвонок.АТС) = Тип("СправочникСсылка.смартВидыАТС") Тогда
			СтруктураДопПараметры.Вставить("АТС", СокрЛП(СтрокаЗвонок.АТС));
		Иначе
			СтруктураДопПараметры.Вставить("АТС", "");
		КонецЕсли;	

		Если СтрокаЗвонок.АТС = Справочники.смартВидыАТС.Asterisk Тогда
		
			Отвеченный  = ?(НРег(СтрокаЗвонок.STATUS) = "answered", Истина, Ложь);
			БезОтвета   = ?(НРег(СтрокаЗвонок.STATUS) = "no answer" ИЛИ НРег(СтрокаЗвонок.STATUS) = "failed", Истина, Ложь);
			Пропущенный = ?(НРег(СтрокаЗвонок.STATUS) = "busy", 	Истина, Ложь);

		ИначеЕсли СтрокаЗвонок.АТС = Справочники.смартВидыАТС.Мегафон
			ИЛИ СтрокаЗвонок.АТС = Справочники.смартВидыАТС.МегафонКовчег Тогда

			Если СтруктураПараметров.ВерсияAPI = "V1" Тогда
			
				Отвеченный  = ?(НРег(СтрокаЗвонок.status) = "success",  Истина, Ложь);
				БезОтвета   = ?(НРег(СтрокаЗвонок.status) = "noanswer", Истина, Ложь);
				Пропущенный = ?(НРег(СтрокаЗвонок.status) = "missed",   Истина, Ложь);
				
			Иначе
				
				Отвеченный  = ?(НРег(СтрокаЗвонок.TYPE) <> "missed"  И НРег(СтрокаЗвонок.DURATION) <> 0, Истина, Ложь);
				БезОтвета   = ?(НРег(СтрокаЗвонок.TYPE) <> "missed"  И НРег(СтрокаЗвонок.DURATION) = 0,  Истина, Ложь);
				Пропущенный = ?(НРег(СтрокаЗвонок.TYPE) =  "missed", Истина, Ложь);
				
			КонецЕсли;	
			
		КонецЕсли;

		СтруктураДопПараметры.Вставить("Отвеченный",  Отвеченный);
		СтруктураДопПараметры.Вставить("БезОтвета",   БезОтвета);
		СтруктураДопПараметры.Вставить("Пропущенный", Пропущенный);
		
		ПараметрыДокумента.Входящий = СтруктураДопПараметры;
		
		//Создание документа телефонный звонок
		Если НЕ ЗначениеЗаполнено(ДокументТелефонныйЗвонок) 
			  И ЗначениеЗаполнено(ПараметрыДокумента.Сотрудник) Тогда
			
			ДокументТелефонныйЗвонок = сфпСофтФонПроСервер.СоздатьТелефонныйЗвонок(ПараметрыДокумента.Абонент, 
																				   ПараметрыДокумента.НомерТелефонаАбонента, 
																		   		   ПараметрыДокумента.Пользователь, 
																				   ПараметрыДокумента.Сотрудник, 
																		   		   ПараметрыДокумента.ВнутреннийНомерПользователя, 
																				   ПараметрыДокумента.Входящий, 
																				   ПараметрыДокумента.ДатаНачалаРазговора, 
																		   		   ПараметрыДокумента.ИдентификаторЗвонка);
		КонецЕсли;
		
		//Заполнение документа телефонный звонок
		Если ЗначениеЗаполнено(ДокументТелефонныйЗвонок) Тогда
			
			ДокОбъект = ДокументТелефонныйЗвонок.ПолучитьОбъект();

			Если Не ЗначениеЗаполнено(ДокОбъект.сфпИдентификаторЗвонка) Тогда
				ДокОбъект.сфпИдентификаторЗвонка = ПараметрыДокумента.ИдентификаторЗвонка;
			КонецЕсли;	
			
			ДокОбъект.Дата 							  = ПараметрыДокумента.ДатаНачалаРазговора;
			ДокОбъект.Входящий 						  = ПараметрыДокумента.Входящий["Входящий"];
			ДокОбъект.сфпДлительностьЗвонка 		  = ПараметрыДокумента.Входящий["Продолжительность"];
 			ДокОбъект.смартДлительностьОжиданияЗвонка = ПараметрыДокумента.Входящий["ВремяОжидания"];
			ДокОбъект.сфпИдентификаторЗаписи 		  = ПараметрыДокумента.СсылкаНаЗапись;
			ДокОбъект.смартВидАТС					  = ПараметрыДокумента.смартВидАТС;
			ДокОбъект.смартПолученныеДаныеОтАТС 	  = ПараметрыДокумента.смартПолученныеДаныеОтАТС;
			
			Если ПараметрыДокумента.Входящий["Пропущенный"] Тогда
				ДокОбъект.сфпСостояниеЗвонка = Перечисления.сфпСостоянияЗвонков.Пропущенный;
			Иначе
				ДокОбъект.сфпСостояниеЗвонка = Перечисления.сфпСостоянияЗвонков.Отвеченный;
			КонецЕсли;	
			
			ДокОбъект.Ответственный = ПараметрыДокумента.Сотрудник;
			ДокОбъект.Автор 		= ДокОбъект.Ответственный;

			ДокОбъект.АбонентКакСвязаться = ПараметрыДокумента.НомерТелефонаАбонента; 
			
			Если ЗначениеЗаполнено(ПараметрыДокумента.Абонент) 
				И ТипЗнч(ПараметрыДокумента.Абонент) <> Тип("Строка") Тогда
				
				ДокОбъект.АбонентКонтакт 	   = ПараметрыДокумента.Абонент;
				ДокОбъект.АбонентПредставление = СокрЛП(ДокОбъект.АбонентКонтакт);
				
			Иначе
				
				ДокОбъект.АбонентКонтакт = Неопределено;
				ДокОбъект.АбонентПредставление = ПараметрыДокумента.АбонентПредставление;
					
			КонецЕсли;
			
			АТС = "";
			Если ПараметрыДокумента.Входящий.Свойство("АТС") И ЗначениеЗаполнено(ПараметрыДокумента.Входящий["АТС"]) Тогда
				АТС = " ("+ПараметрыДокумента.Входящий["АТС"]+")";
			КонецЕсли;	

			Если ПараметрыДокумента.Входящий.Свойство("Отвеченный") 
				И ПараметрыДокумента.Входящий.Отвеченный 
				И ДокОбъект.сфпДлительностьЗвонка > 0 Тогда
				
				ДокОбъект.сфпСостояниеЗвонка = Перечисления.сфпСостоянияЗвонков.Отвеченный;
				ДокОбъект.Описание 			 = сфпСофтФонПроСервер.сфпЗаполнитьОписаниеТелефонногоЗвонка(ДокОбъект.сфпДлительностьЗвонка) + АТС;
				
			ИначеЕсли ПараметрыДокумента.Входящий.Свойство("Пропущенный") 
					И ПараметрыДокумента.Входящий.Пропущенный Тогда
				
				ДокОбъект.сфпСостояниеЗвонка = Перечисления.сфпСостоянияЗвонков.Пропущенный;
				ДокОбъект.Описание 			 = "Звонок пропущен" + АТС;
				
			ИначеЕсли (ПараметрыДокумента.Входящий.Свойство("БезОтвета") И ПараметрыДокумента.Входящий.БезОтвета) 
				ИЛИ ДокОбъект.сфпДлительностьЗвонка = 0 Тогда
				
				ДокОбъект.сфпСостояниеЗвонка = Перечисления.сфпСостоянияЗвонков.Пропущенный;
				ДокОбъект.Описание 			 = "Звонок без ответа" + АТС;
				
			КонецЕсли;
				
			Если НЕ ЗначениеЗаполнено(ДокОбъект.Комментарий) 
				И ДокОбъект.Описание <> "Ожидание загрузки данных из АТС" Тогда
				
				ДокОбъект.Комментарий = "Загружен автоматически из " + СокрЛП(ПараметрыДокумента.смартВидАТС);
				
			КонецЕсли;

			ДокОбъект.Тема = сфпСофтФонПроСервер.сфпЗаполнитьТемуТелефонногоЗвонка(ДокОбъект.Входящий, ДокОбъект.Дата);
			
			Если ЗначениеЗаполнено(ПараметрыДокумента.ИдентификаторЗвонкаОснование) Тогда
				
				ДокОбъект.ВзаимодействиеОснование = Документы.ТелефонныйЗвонок.НайтиПоРеквизиту("сфпИдентификаторЗвонка", 
																								ПараметрыДокумента.ИдентификаторЗвонкаОснование);
																								
			КонецЕсли;																					
			
			ДокОбъект.смартЗагруженИзАТС = ЗначениеЗаполнено(ДокОбъект.сфпИдентификаторЗвонка); 
			
			//Запись документа
			Попытка
				
				ДокОбъект.Записать();
				
			Исключение
				
				ТекстОшибки = "Ошибка записи звонка после заполнения " + СокрЛП(ДокОбъект.Ссылка) 
							  + Символы.ПС + ПараметрыДокумента.смартПолученныеДаныеОтАТС;
							  
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка записи документа звонка " + СокрЛП(ДокОбъект.Ссылка) + "'", 
										 ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
										 
			КонецПопытки;
			
			//Запись истории
			ДополнитьИсториюЗвонков(ДокументТелефонныйЗвонок, ПараметрыДокумента);
			
		КонецЕсли;
		
		Если СтруктураПараметров.ВыполнятьВФоне Тогда
			
			Ин = Ин + 1;
			ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
			ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Загрузка звонков из " + ПараметрыДокумента.Входящий.АТС 
																		  + ": " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
																		  
		КонецЕсли;	
		
    КонецЦикла;
	
КонецПроцедуры	

Процедура ДополнитьИсториюЗвонков(Звонок, ПараметрыДокумента)
	
	НаборЗаписей = РегистрыСведений.сфпИсторияЗвонков.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Звонок.Установить(Звонок);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		
		СтрокаЗаписи = НаборЗаписей[0];
		
		СтрокаЗаписи.ДатаНачала 		 = ПараметрыДокумента.ДатаНачалаРазговора;
		СтрокаЗаписи.НомерТелефона 		 = ПараметрыДокумента.НомерТелефонаАбонента;

		СтрокаЗаписи.ВнутреннийНомер 	 = ПараметрыДокумента.ВнутреннийНомерПользователя;
		СтрокаЗаписи.Входящий 			 = ПараметрыДокумента.Входящий["Входящий"];
		СтрокаЗаписи.ДатаОкончания 		 = СтрокаЗаписи.ДатаНачала + ПараметрыДокумента.Входящий["Продолжительность"];
		СтрокаЗаписи.ДатаОтвета 		 = СтрокаЗаписи.ДатаНачала + ПараметрыДокумента.Входящий["ВремяОжидания"];
		СтрокаЗаписи.ИдентификаторЗаписи = ПараметрыДокумента.СсылкаНаЗапись;
		СтрокаЗаписи.ИдентификаторЗвонка = ПараметрыДокумента.ИдентификаторЗвонка;
		СтрокаЗаписи.АбонентКонтакт 	 = Звонок.АбонентКонтакт;
		СтрокаЗаписи.Ответственный 		 = ПараметрыДокумента.Сотрудник;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция НомерБезКода(Номер)

	Если СтрДлина(Номер) = 11 Тогда 
		Возврат Сред(Номер, 2);
	Иначе
		Возврат Номер;
	КонецЕсли;
	
КонецФункции

Функция НайтиДокументПоIDЗвонка(UID)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
		|ВЫБРАТЬ
		|	Ссылка КАК ТелефонныйЗвонок
		|ИЗ
		|	Документ.ТелефонныйЗвонок
		|ГДЕ
		|	сфпИдентификаторЗвонка = &UID
		|";
	
	Запрос.УстановитьПараметр("UID", СокрЛП(UID));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ТелефонныйЗвонок;
	Иначе
		Результат = Неопределено;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьВДату(СтрокаДата)
	
	СтрокаДата = СтрЗаменить(СтрокаДата, "-", "");
	СтрокаДата = СтрЗаменить(СтрокаДата, ":", "");
	СтрокаДата = СтрЗаменить(СтрокаДата, " ", "");
	
	ЗначениеДаты = Дата(СтрокаДата);
	
	Возврат ЗначениеДаты;

КонецФункции

Функция ПривестиТелефонныйНомерКФормату(ОригТелНомер)
	
	ТелНомер = СокрЛП(ОригТелНомер);
	
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, ";");
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, ",");
	ТелНомер = ПолучитьСтрокуДоСимвола(ТелНомер, "/");
	
	ТелНомер = СтрЗаменить(ТелНомер, "+7", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, ":7", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, "+8", "7");     
	ТелНомер = СтрЗаменить(ТелНомер, ":8", "7");     
	
	Если СтрДлина(ТелНомер) >= 6 Тогда
		ТелНомер = сфпСофтФонПроСерверПереопределяемый.ПреобразоватьНомерДляКонтактнойИнформации(ТелНомер);
	КонецЕсли;	

	ТелНомер = ВернутьТолькоЦифры(ТелНомер);
	
	Если СтрДлина(ТелНомер) = 10 Тогда
		ТелНомер = "7" + ТелНомер;
	КонецЕсли;

	Если Лев(ТелНомер, 1) = "8" И СтрДлина(ТелНомер) = 11 Тогда
		ТелНомер = "7" + Сред(ТелНомер, 2);
	КонецЕсли;

	Возврат ТелНомер;	

КонецФункции

Функция ВернутьТолькоЦифры(Строка)
	
	ДлинаСтроки = СтрДлина(Строка);
	
	Итог = "";

	Для Сч = 1 По ДлинаСтроки Цикл
		
		Символ = Сред(Строка, Сч, 1);

		КодСимвола = КодСимвола(Символ);
		
		Если КодСимвола > 47 И КодСимвола < 58 Тогда
			Итог = Итог + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

Функция ПолучитьСтрокуДоСимвола(ТелНомер, Символ)

	Если СтрНайти(ТелНомер, Символ) > 0 Тогда
		
		ТелНомер = Лев(ТелНомер, СтрНайти(ТелНомер, Символ) - 1);
		
	КонецЕсли;	           
	
	Возврат ТелНомер;
	
КонецФункции

Функция ПолучитьТелефоныПартнеров(ВыполнениеВФоне = Ложь)
	
	Если ВыполнениеВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, "Формируется список телефонов клиентов");
	КонецЕсли;	
	
	ЗапросТелефоныПартнеров = Новый Запрос;
	ЗапросТелефоныПартнеров.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец КАК Абонент,
	|	СТРЗАМЕНИТЬ(СОКРЛП(КонтактныеЛицаПартнеровКонтактнаяИнформация.НомерТелефона), "" "", """") КАК НомерТелефона,
	|	""КонтактныеЛицаПартнеров"" КАК Откуда
	|ПОМЕСТИТЬ ВТ_ТелефоныКлиентов
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И ДЛИНАСТРОКИ(СТРЗАМЕНИТЬ(СОКРЛП(КонтактныеЛицаПартнеровКонтактнаяИнформация.НомерТелефона), "" "", """")) > 2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПартнерыКонтактнаяИнформация.Ссылка,
	|	СТРЗАМЕНИТЬ(СОКРЛП(ПартнерыКонтактнаяИнформация.НомерТелефона), "" "", """"),
	|	""Партнеры""
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	|ГДЕ
	|	ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И ДЛИНАСТРОКИ(СТРЗАМЕНИТЬ(СОКРЛП(ПартнерыКонтактнаяИнформация.НомерТелефона), "" "", """")) > 2
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.Ссылка.Партнер,
	|	СТРЗАМЕНИТЬ(СОКРЛП(КонтрагентыКонтактнаяИнформация.НомерТелефона), "" "", """"),
	|	""Контрагенты""
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И ДЛИНАСТРОКИ(СТРЗАМЕНИТЬ(СОКРЛП(КонтрагентыКонтактнаяИнформация.НомерТелефона), "" "", """")) > 2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_ТелефоныКлиентов.Абонент КАК Абонент,
	|	ВТ_ТелефоныКлиентов.НомерТелефона КАК НомерТелефона
	|ИЗ
	|	ВТ_ТелефоныКлиентов КАК ВТ_ТелефоныКлиентов
	|ГДЕ
	|	НЕ ВТ_ТелефоныКлиентов.Абонент.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерТелефона";

	ВыгрузкаТел = ЗапросТелефоныПартнеров.Выполнить().Выгрузить();

	Ин = 0;
	КоличествоИтераций = ВыгрузкаТел.Количество();
	
	Для Каждого СтрТел Из ВыгрузкаТел Цикл 
		
		СтрТел.НомерТелефона = ПривестиТелефонныйНомерКФормату(СтрТел.НомерТелефона);
		
		Если ВыполнениеВФоне Тогда
			Ин = Ин + 1;
			ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
			ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Формирование списка телефонов клиентов: " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
		КонецЕсли;	
		
	КонецЦикла;	

	ВыгрузкаТел.Свернуть("Абонент, НомерТелефона");
	
	Возврат ВыгрузкаТел;
	
КонецФункции

#КонецОбласти

#Область Мегафон
	        
Процедура ПолучитьПользователейВАТСНаСервере(СтруктураПараметров, АТС = Неопределено)

	Если СтруктураПараметров.ВыполнятьВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, СтрШаблон("Запрос пользователей ВАТС из %1", СокрЛП(АТС)));
	КонецЕсли;	
	
	ПараметрыЗапроса = Новый Структура;
	
	ПараметрыЗапроса.Вставить("ИмяМетода", "accounts");
	
	Если АТС = Справочники.смартВидыАТС.МегафонКовчег Тогда
		ПараметрыЗапроса.Вставить("ИсходящийНомер", "700");
	КонецЕсли;	
		
	HTTPОтвет = смартОбщегоНазначения.смартТелефонияВыполнитьHTTPЗапрос(ПараметрыЗапроса);
	
	Если HTTPОтвет <> "" Тогда

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HTTPОтвет);

		СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
		
	КонецЕсли;
	
	Если ТипЗнч(СтруктураИзJSON) = Тип("Массив") Тогда
	
		Для Каждого ЭлементСтруктуры Из СтруктураИзJSON Цикл
			
			СтрокаПользователя = ПользователиАТС.Добавить();

			СтрокаПользователя.LOGIN 	  = ЭлементСтруктуры.Name;
			СтрокаПользователя.NAME 	  = ЭлементСтруктуры.realName;
			СтрокаПользователя.INT_NUMBER = ЭлементСтруктуры.ext;

			Если ЭлементСтруктуры.Свойство("telnum") И ЗначениеЗаполнено(ЭлементСтруктуры.telnum) Тогда
				СтрокаПользователя.TELEPHONE = ЭлементСтруктуры.telnum;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура МегафонПолучитьИсториюЗвонковНаСервере(СтруктураПараметров, АТС = Неопределено)

	МассивСтрок = Новый Массив;
	
	Если СтруктураПараметров.ВыполнятьВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, СтрШаблон("Запрос данных из %1", СокрЛП(АТС)));
	КонецЕсли;	
	
	ПараметрыЗвонка = Новый Структура;

	ПараметрыЗвонка.Вставить("start", 	  ЗаписатьДатуJSON(СтруктураПараметров.ДатаНачала,    ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
	ПараметрыЗвонка.Вставить("end", 	  ЗаписатьДатуJSON(СтруктураПараметров.ДатаОкончания, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата));
	ПараметрыЗвонка.Вставить("ИмяМетода", "history");
	ПараметрыЗвонка.Вставить("type",	  "all");

	Если АТС = Справочники.смартВидыАТС.МегафонКовчег Тогда
		ПараметрыЗвонка.Вставить("ИсходящийНомер", "700");
	КонецЕсли;	
	
	Если СтруктураПараметров.ВерсияAPI = "V1" Тогда
		HTTPОтвет = смартТелефонияВыполнитьHTTPЗапросМегафонНовыйAPI(ПараметрыЗвонка);
	Иначе	
		HTTPОтвет = смартОбщегоНазначения.смартТелефонияВыполнитьHTTPЗапрос(ПараметрыЗвонка);
	КонецЕсли;	
		
	Если HTTPОтвет <> "" Тогда
		
		Если СтруктураПараметров.ВерсияAPI = "V1" Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(HTTPОтвет);
			
			МассивСтрок = ПрочитатьJSON(ЧтениеJSON);
			
		Иначе	
			
			МассивСтрок = СтрРазделить(HTTPОтвет, Символы.ПС);
			
		КонецЕсли;	
		
	Иначе
		
		Возврат;
		
	КонецЕсли;

	Если ТипЗнч(МассивСтрок) = Тип("Массив") И МассивСтрок.Количество() > 0 Тогда

		Ин = 0;
		
		КоличествоИтераций = МассивСтрок.Количество();
		
		Для Каждого Стр Из МассивСтрок Цикл
			
			Попытка

				СтрокаЗвонка = Звонки.Добавить();

				СтрокаЗвонка.АТС = АТС;
				
				Если СтруктураПараметров.ВерсияAPI = "V1" Тогда //Стр - структура
					
					//Входящие данные:
					
					//uid: 		   Уникальный идентификатор звонка
					////direction: in out
					//type:		   in out
					//status: 	   success missed noanswer
					//client: 	   Номер клиента
					//account: 	   Логин сотрудника
					//diversion:   Номер телефона, через который пришел звонок
					//destination: Адресат входящего звонка - user group telnum ivr onduty offtime hello vm am
					//user: 	   Логин сотрудника
					//user_name:   Имя сотрудника
					//group_name:  Имя группы через которую прошел звонок
					//start: 	   Время начала звонка
					//wait: 	   Время ожидания на линии (сек)
					//duration:    Длительность разговора (сек)
					//record: 	   Ссылка на запись разговора
					//rating: 	   Оценка качества обслуживания

					//Таблица-приемник:
					
					//UID 			- идентификатор звонка
					//Transfer_UID 	- идентификатор родительского звонка (откуда перевели вызов)
					//Date 			- дата звонка
					//Type 			- тип звонка: входящий, исходящий (in, out)
					//Number 		- внешний номер, через который проходит звонок
					//Source 		- номер того, кто звонит
					//Destination 	- номер того, кому звонят
					//disposotion 	- результат звонка: принят, не принят, занято
					//to_answer 	- количество секунд до ответа
					//to_complete 	- количество секунд до завершения разговора
					//duration 		- общее количество секунд

					//destination: Адресат входящего звонка
					//user ‑ Сотрудник принял звонок.
					//group ‑ Звонок пропущен отделом.
					//telnum ‑ Внешний телефонный номер.
					//ivr ‑ Меню самообслуживания.
					//onduty ‑ Дежурный в нерабочее время.
					//offtime ‑ Сообщение о нерабочем времени.
					//hello ‑ Звонок оборвался на приветствии.
					//vm ‑ Автоответчик, клиент оставил сообщение.
					//am ‑ Сообщение автоответчика.
					
					СтрокаЗвонка.JSON = смартОбщегоНазначения.ЗначениеВJSON(Стр);

					СтрокаЗвонка.UID 		  = Стр.UID;
					СтрокаЗвонка.TRANSFER_UID = "";
					СтрокаЗвонка.DATE 		  = ПрочитатьДатуJSON(Стр.start, ФорматДатыJSON.ISO);
					СтрокаЗвонка.TYPE 		  = Стр.type;
					СтрокаЗвонка.NUMBER 	  = Стр.diversion;
					СтрокаЗвонка.STATUS  	  = Стр.status;
					СтрокаЗвонка.CLIENT   	  = Стр.client;
					СтрокаЗвонка.USER  	  	  = Стр.diversion;
					
					Если Стр.Свойство("USER_NAME") Тогда
						СтрокаЗвонка.USER_NAME = Стр.USER_NAME;
					КонецЕсли;

					Если Стр.Свойство("record") Тогда
						СтрокаЗвонка.RECORD = Стр.record;
					КонецЕсли;
					
					Если Стр.Свойство("duration") Тогда
						Длительность = ?(ТипЗнч(Стр.duration) = Тип("Число"), Стр.duration, 0);
					Иначе
						Длительность = 0;
					КонецЕсли;

					Ожидание = ?(ТипЗнч(Стр.wait) = Тип("Число"), Стр.wait, 0);
					
				Иначе //Стр - строка

					//СтрокаЗвонка.UID = МассивРеквизитов[0];
					//СтрокаЗвонка.type = МассивРеквизитов[1];
					//СтрокаЗвонка.client = МассивРеквизитов[2];
					//СтрокаЗвонка.account = МассивРеквизитов[3];
					//СтрокаЗвонка.via = МассивРеквизитов[4];
					//СтрокаЗвонка.start = МассивРеквизитов[5];
					//СтрокаЗвонка.wait = МассивРеквизитов[6];
					//СтрокаЗвонка.duration = МассивРеквизитов[7];
					//СтрокаЗвонка.record = МассивРеквизитов[8];
				
					МассивРеквизитов = СтрРазделить(Стр, ",");

					СтрокаЗвонка.JSON = смартОбщегоНазначения.ЗначениеВJSON(МассивРеквизитов);
					
					СтрокаЗвонка.UID 		  = МассивРеквизитов[0];
					СтрокаЗвонка.DATE 		  = ПрочитатьДатуJSON(МассивРеквизитов[5], ФорматДатыJSON.ISO);
					СтрокаЗвонка.STATUS  	  = Стр.status;
					
					СтрокаЗвонка.RECORD		  = МассивРеквизитов[8];
					СтрокаЗвонка.TYPE 		  = МассивРеквизитов[1];
					СтрокаЗвонка.CLIENT 	  = МассивРеквизитов[2];
					СтрокаЗвонка.USER		  = МассивРеквизитов[4];
					СтрокаЗвонка.USER_NAME	  = МассивРеквизитов[3];
					СтрокаЗвонка.NUMBER 	  = МассивРеквизитов[4];

					Длительность = ?(ТипЗнч(МассивРеквизитов[7]) = Тип("Число"), МассивРеквизитов[7], 0);
					Ожидание 	 = ?(ТипЗнч(МассивРеквизитов[6]) = Тип("Число"), МассивРеквизитов[6], 0);
					
				КонецЕсли;	

				СтрокаЗвонка.DURATION 	  = Длительность;
				СтрокаЗвонка.TO_ANSWER 	  = Ожидание;
				
				Если Длительность > Ожидание Тогда
					СтрокаЗвонка.TO_COMPLETE  = Длительность - Ожидание;
				КонецЕсли;	
				
			Исключение	

				ТекстОшибки = "Не удалось прочитать строку звонка " + СокрЛП(АТС) + ":" + Символы.ПС + ?(ТипЗнч(Стр) = Тип("Структура"), смартОбщегоНазначения.ЗначениеВJSON(Стр), Стр);
					
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Звонок через " + СокрЛП(АТС) + " " + ПараметрыЗвонка.ИмяМетода + "'", ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

			КонецПопытки;

			Если СтруктураПараметров.ВыполнятьВФоне Тогда
				
				Ин = Ин + 1;
				
				ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
				
				ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Формирование массива данных звонков " + СокрЛП(АТС) + ": " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
				
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;	    

КонецПроцедуры	

Функция ПолучитПользователяПоТелефонуВАТС(НомерТелефона)
	
	Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("TELEPHONE", НомерТелефона);
	
	СтрокиСтелефоном = ЭтотОбъект.ПользователиАТС.НайтиСтроки(ПараметрыОтбора);
	
	Если СтрокиСтелефоном.Количество() > 0 Тогда
		
		ПользовательНомера = Справочники.Пользователи.НайтиПоНаименованию(СтрокиСтелефоном[0].NAME);
		Если ПользовательНомера = Справочники.Пользователи.ПустаяСсылка() Тогда
			ПользовательНомера = Справочники.Пользователи.НайтиПоРеквизиту("смартВнутреннийНомерВАТС", СтрокиСтелефоном[0].INT_NUMBER);
		КонецЕсли;
		
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		Если ПользовательНомера = Справочники.Пользователи.ПустаяСсылка() Тогда
			ПользовательНомера = Справочники.Пользователи.НайтиПоРеквизиту("смартВнутреннийНомерВАТСДополнительный", СтрокиСтелефоном[0].INT_NUMBER);
		КонецЕсли;
		//-- #Б-6744 смарт: Фролов 28.05.2026
		
	КонецЕсли;	
	
	Если ПользовательНомера <> Справочники.Пользователи.ПустаяСсылка() Тогда
		Результат = ПользовательНомера;
	Иначе
		Результат = Неопределено;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	                    

Функция смартТелефонияВыполнитьHTTPЗапросМегафонНовыйAPI(Знач ПараметрыЗвонка)
	
	HTTPОтвет = Неопределено;

	HTTPЗапрос = смартТелефонияПодготовитьHTTPЗапрос(ПараметрыЗвонка);
	
	Если HTTPЗапрос = "" Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Попытка

		Соединение = Новый HTTPСоединение(ПараметрыЗвонка.Соединение, , , , , 60, ПараметрыЗвонка.ЗащищенноеСоединение);

		Если ПараметрыЗвонка.ИмяМетода = "history" Тогда
			HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		КонецЕсли;
		
	Исключение	
	КонецПопытки;
	
	Если HTTPОтвет <> Неопределено Тогда
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Запрос ""%1"" не выполнен. Код состояния: %2.'"), ПараметрыЗвонка.ИмяМетода, HTTPОтвет.КодСостояния) + Символы.ПС
				+ HTTPОтвет.ПолучитьТелоКакСтроку();
				
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Звонок через " + ПараметрыЗвонка.ИмяМетода + "'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

			ОбщегоНазначения.СообщитьПользователю("Не удалось выполнить запрос! " + ТекстОшибки);
			
		КонецЕсли;
			
		Возврат HTTPОтвет.ПолучитьТелоКакСтроку();
		
	КонецЕсли;
		
	Возврат Неопределено;
	
КонецФункции

Функция смартТелефонияПодготовитьHTTPЗапрос(ПараметрыЗвонка)
	
	HTTPЗапрос = "";

	Если ПараметрыЗвонка.ИмяМетода = "history" Тогда 
		
		ПараметрыВАТС = смартОбщегоНазначения.смартПолучитьПараметрыВАТС(ПараметрыЗвонка);

		Если Не ПараметрыВАТС = Неопределено Тогда

			ПараметрыЗвонка.Вставить("ЗащищенноеСоединение", Новый ЗащищенноеСоединениеOpenSSL());
			ПараметрыЗвонка.Вставить("HTTPМетод",  			 "GET");
			ПараметрыЗвонка.Вставить("Соединение",  		 ПараметрыВАТС.Соединение);
			ПараметрыЗвонка.Вставить("АдресРесурса",		 "/crmapi/v1/history/json");
			ПараметрыЗвонка.Вставить("Токен",       		 ПараметрыВАТС.Токен); 

			ЗаголовокЗапросаHTTP = Новый Соответствие;
			ЗаголовокЗапросаHTTP.Вставить("Content-Type", 	 "application/json; charset=UTF-8");
			ЗаголовокЗапросаHTTP.Вставить("X-API-KEY",   	 ПараметрыЗвонка.Токен);
			
			ДанныеДляЗапроса = Новый Структура;

			Если ПараметрыЗвонка.Свойство("period") И НЕ ПараметрыЗвонка.period = "" Тогда

				ДанныеДляЗапроса.Вставить("period", 		 ПараметрыЗвонка.period);
				
			ИначеЕсли ПараметрыЗвонка.Свойство("start") и ПараметрыЗвонка.Свойство("end") Тогда
				
				ДанныеДляЗапроса.Вставить("start", 			 ПараметрыЗвонка.start);
				ДанныеДляЗапроса.Вставить("end",   			 ПараметрыЗвонка.end);
				
			КонецЕсли;
			
			ДанныеДляЗапроса.Вставить("type", 				 ПараметрыЗвонка.type);

			Если ДанныеДляЗапроса.Количество() > 0 Тогда

				ПараметрыЗапроса = "?";

				Для Каждого ЭлементДанныеДляЗапроса Из ДанныеДляЗапроса Цикл

					ЗначениеПараметраЗапроса = ЭлементДанныеДляЗапроса.Ключ + "=" + ЭлементДанныеДляЗапроса.Значение;
					
					ПараметрыЗапроса = ПараметрыЗапроса + ЗначениеПараметраЗапроса + "&";
					
				КонецЦикла;	
				
				ПараметрыЗвонка.АдресРесурса = ПараметрыЗвонка.АдресРесурса + Лев(ПараметрыЗапроса, СтрДлина(ПараметрыЗапроса)-1);
				
			КонецЕсли;
			
			HTTPЗапрос = Новый HTTPЗапрос(ПараметрыЗвонка.АдресРесурса, ЗаголовокЗапросаHTTP);
			
		КонецЕсли;
		
	КонецЕсли;				   
	
	Возврат HTTPЗапрос;
	
КонецФункции 

#КонецОбласти

#Область Asterisk

Процедура AsteriskПолучитьИсториюЗаПериодНаСервере(СтруктураПараметров, АТС = Неопределено, ВыполнениеВФоне = Ложь)

	Если ВыполнениеВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, СтрШаблон("Запрос данных из %1", СокрЛП(АТС)));
	КонецЕсли;	
	
    ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ЗащищенноеСоединение", Новый ЗащищенноеСоединениеOpenSSL());
	ПараметрыЗапроса.Вставить("HTTPМетод",  		  "POST");
	ПараметрыЗапроса.Вставить("HTTPСоединение", 	  "sip.smart-t.me");
	ПараметрыЗапроса.Вставить("АдресЗапроса", 		  "/list_call_new.php?");

	ИдентификаторЗвонка  = СокрЛП(СтруктураПараметров.UID);
	ДатаНачалаСтрокой 	 = ?(Не ЗначениеЗаполнено(СтруктураПараметров.ДатаНачала), 	  "", Формат(СтруктураПараметров.ДатаНачала,    "ДФ='yyyy-MM-dd HH:mm:ss'"));
	ДатаОкончанияСтрокой = ?(Не ЗначениеЗаполнено(СтруктураПараметров.ДатаОкончания), "", Формат(СтруктураПараметров.ДатаОкончания, "ДФ='yyyy-MM-dd HH:mm:ss'"));
	
	СтрокаHTTPЗапроса = ПараметрыЗапроса.АдресЗапроса 
		 + ?(ПустаяСтрока(ИдентификаторЗвонка),  "", "UID="   + ИдентификаторЗвонка  + "&")
		 + ?(ПустаяСтрока(ДатаНачалаСтрокой), 	 "", "START=" + ДатаНачалаСтрокой    + "&")
		 + ?(ПустаяСтрока(ДатаОкончанияСтрокой), "", "END="   + ДатаОкончанияСтрокой + "&");						
		 
	СтрокаHTTPЗапроса = Лев(СтрокаHTTPЗапроса, СтрДлина(СтрокаHTTPЗапроса) - 1);
	
	HTTPСоединение = Новый HTTPСоединение(ПараметрыЗапроса.HTTPСоединение,,,,,, ПараметрыЗапроса.ЗащищенноеСоединение); 
	
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json; charset=UTF-8");
 
 	HTTPОтвет = HTTPСоединение.Получить(Новый HTTPЗапрос(СтрокаHTTPЗапроса, ЗаголовокЗапросаHTTP));

	СтрокаОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	Если HTTPОтвет.КодСостояния <> 200 Тогда
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка истории звонков'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, , , "Ошибка загрузки истории звонков из Astrisk: " + Символы.ПС + СтрокаОтвета);
			
		Возврат;	
			
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
	
	СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(СтруктураИзJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	
	
	Ин = 0;
	КоличествоИтераций = СтруктураИзJSON.Количество();
	
	Для Каждого ЭлементСтруктуры Из СтруктураИзJSON Цикл 
		
		//UID 			- идентификатор звонка
		//Transfer_UID 	- идентификатор родительского звонка (откуда перевели вызов)
		//Date 			- дата звонка
		//Type 			- тип звонка: входящий, исходящий (in, out)
		//Number 		- внешний номер, через который проходит звонок
		//Source 		- номер того, кто звонит
		//Destination 	- номер того, кому звонят
		//disposotion 	- результат звонка: принят, не принят, занято
		//to_answer 	- количество секунд до ответа
		//to_complete 	- количество секунд до завершения разговора
		//duration 		- общее количество секунд
		
		СтрокаЗвонка = Звонки.Добавить();

		СтрокаЗвонка.АТС = АТС;
		
		СтрокаЗвонка.JSON = смартОбщегоНазначения.ЗначениеВJSON(ЭлементСтруктуры);

		СтрокаЗвонка.UID 		  = ЭлементСтруктуры.UID;
		СтрокаЗвонка.TRANSFER_UID = ЭлементСтруктуры.TRANSFER_UID;
		СтрокаЗвонка.DATE 		  = ПреобразоватьВДату(ЭлементСтруктуры.DATE);
		СтрокаЗвонка.TYPE 		  = ЭлементСтруктуры.TYPE;
		СтрокаЗвонка.NUMBER 	  = ЭлементСтруктуры.NUMBER;
		СтрокаЗвонка.STATUS  	  = ЭлементСтруктуры.DISPOSITION;
		СтрокаЗвонка.DURATION 	  = ЭлементСтруктуры.DURATION;
		СтрокаЗвонка.TO_ANSWER 	  = ЭлементСтруктуры.TO_ANSWER;
		СтрокаЗвонка.TO_COMPLETE  = ЭлементСтруктуры.TO_COMPLETE;
		
		Если НРег(СтрокаЗвонка.TYPE) = НРег("in") Тогда

			СтрокаЗвонка.CLIENT   = ЭлементСтруктуры.SOURCE;
			СтрокаЗвонка.USER  	  = ЭлементСтруктуры.DESTINATION;
			
		Иначе
			
			СтрокаЗвонка.CLIENT   = ЭлементСтруктуры.DESTINATION;
			СтрокаЗвонка.USER  	  = ЭлементСтруктуры.SOURCE;
			
		КонецЕсли;	
		
		Если ВыполнениеВФоне Тогда
			
			Ин = Ин + 1;
			
			ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
			
			ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Формирование массива данных из " + СокрЛП(АТС) 
																		  + ": " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
																		  
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры    

Процедура СравнитьAsterisk(СтруктураПараметров, ВыполнениеВФоне = Ложь)

	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаНачала) Тогда
		СтруктураПараметров.ДатаНачала = НачалоДня(ТекущаяДата());
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(СтруктураПараметров.ДатаОкончания) Тогда
		СтруктураПараметров.ДатаОкончания = КонецДня(ТекущаяДата());
	КонецЕсли;	

	Звонки.Очистить();

	HTTPЗапрос = "";
    ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ЗащищенноеСоединение", Неопределено);
	ПараметрыЗапроса.Вставить("HTTPМетод",  "POST");
	ПараметрыЗапроса.Вставить("Соединение", "sip.smart-t.me");

	ПараметрыURL = Новый Массив;
	
	ПараметрыURL.Добавить(СтрШаблон("START=%1", Формат(СтруктураПараметров.ДатаНачала,   "ДФ='yyyy-MM-dd HH:mm:ss'")));
	ПараметрыURL.Добавить(СтрШаблон("END=%1",   Формат(СтруктураПараметров.ДатаОкончания,"ДФ='yyyy-MM-dd HH:mm:ss'")));
	
	Если ЗначениеЗаполнено(СтруктураПараметров.UID) Тогда
		ПараметрыURL.Добавить(СтрШаблон("UID=%1", СокрЛП(СтруктураПараметров.UID)));
	КонецЕсли;	
	
	HTTPЗапрос = СтрШаблон("/list_call_new.php?%1", СтрСоединить(ПараметрыURL, "&"));
	
	Соединение = Новый HTTPСоединение(ПараметрыЗапроса.Соединение,80,,,,60,ПараметрыЗапроса.ЗащищенноеСоединение); 
	
	ЗаголовокЗапросаHTTP = Новый Соответствие;
	ЗаголовокЗапросаHTTP.Вставить("Content-Type", "application/json; charset=UTF-8");
 
 	HTTPОтвет = Соединение.Получить(Новый HTTPЗапрос(HTTPЗапрос, ЗаголовокЗапросаHTTP));
	СтрокаОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
	
	СтруктураИзJSON = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(СтруктураИзJSON) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	
	
	Ин = 0;
	КоличествоИтераций = СтруктураИзJSON.Количество();
	
	Для Каждого ЭлементСтруктуры Из СтруктураИзJSON Цикл 
		
		//UID - идентификатор звонка
		//Transfer_UID - идентификатор родительского звонка (откуда перевели вызов)
		//Date - дата звонка
		//Type - тип звонка: входящий, исходящий
		//Number - внешний номер, через который проходит звонок
		//Source - номер того, кто звонит
		//Destination - номер того, кому звонят
		//disposotion - результат звонка: принят, не принят, занято
		//to_answer - количество секунд до ответа
		//to_complete  количество секунд до завершения разговора
		//duration - общее количество секунд
		
		СтрокаЗвонка = Звонки.Добавить();

		СтрокаЗвонка.АТС = СтруктураПараметров.АТС;
		
		СтрокаЗвонка.JSON = смартОбщегоНазначения.ЗначениеВJSON(ЭлементСтруктуры);

		СтрокаЗвонка.UID 		  = ЭлементСтруктуры.UID;
		СтрокаЗвонка.TRANSFER_UID = ЭлементСтруктуры.TRANSFER_UID;
		СтрокаЗвонка.TYPE 		  = ЭлементСтруктуры.TYPE;
		СтрокаЗвонка.DATE 		  = ПреобразоватьВДату(ЭлементСтруктуры.DATE);
		СтрокаЗвонка.CLIENT 	  = ЭлементСтруктуры.SOURCE;
		СтрокаЗвонка.USER  = ЭлементСтруктуры.DESTINATION;
		СтрокаЗвонка.NUMBER 	  = ЭлементСтруктуры.NUMBER;
		СтрокаЗвонка.STATUS  = ЭлементСтруктуры.DISPOSITION;
		СтрокаЗвонка.DURATION 	  = ЭлементСтруктуры.DURATION;
		СтрокаЗвонка.TO_ANSWER 	  = ЭлементСтруктуры.TO_ANSWER;
		СтрокаЗвонка.TO_COMPLETE  = ЭлементСтруктуры.TO_COMPLETE;
		
		Если ВыполнениеВФоне Тогда
			
			Ин = Ин + 1;
			
			ТекущийПроцентВыполнения = Окр(100 * Ин / КоличествоИтераций, 0);
			
			ДлительныеОперации.СообщитьПрогресс(ТекущийПроцентВыполнения, "Формирование массива данных из " + СокрЛП(СтруктураПараметров.АТС) 
																		  + ": " + СокрЛП(Ин) + " из " + СокрЛП(КоличествоИтераций));
																		  
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ВыполнениеВФоне Тогда
		ДлительныеОперации.СообщитьПрогресс(0, СтрШаблон("Обработка данных из %1", СокрЛП(СтруктураПараметров.АТС)));
	КонецЕсли;	
	
	ТЗТелефоныПартнеров = ПолучитьТелефоныПартнеров(СтруктураПараметров.ВыполнятьВФоне);
	
	//Номера секретаря
	ТаблицаЗначенийНомераСекретаря = ТЗТелефоныПартнеров.ВыгрузитьКолонки();
	
	АбонентСекретарь = Справочники.Пользователи.НайтиПоНаименованию("Секретарь");
	
	ЗаполнитьНастройкиОбработки();
	
	Если ЗначениеЗаполнено(АбонентСекретарь) И СЗНомеровСекретаря.Количество() > 0 Тогда
		
		Для Каждого ЭлементСекретарь Из СЗНомеровСекретаря Цикл
		
			НоваяСтрока = ТаблицаЗначенийНомераСекретаря.Добавить();
			
			НоваяСтрока.Абонент 	  = АбонентСекретарь;
			НоваяСтрока.НомерТелефона = ЭлементСекретарь;
			
		КонецЦикла;

	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Звонки.АТС КАК АТС,
