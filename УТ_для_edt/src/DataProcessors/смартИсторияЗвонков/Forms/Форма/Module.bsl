#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбъектОбработка = РеквизитФормыВЗначение("Объект");
	ОбъектОбработка.ЗаполнитьНастройкиОбработки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Объект.ДатаНачала 			  = НачалоДня(ТекущаяДата());
	Объект.ДатаОкончания 		  = КонецДня(ТекущаяДата());
	Объект.ВерсияAPI 			  = "V1";
	Объект.ЗагружатьПринудительно = Истина;
	Объект.ВыполнятьВФоне 		  = Ложь;
	Объект.СоздаватьЗвонки 		  = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	СохранитьНастройкиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Настройки = Справочники.смартПредопределенныеЗначения.Настройки.ПолучитьОбъект();
	Попытка
		Настройки.Заблокировать();
	Исключение
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Настройки.НомераСекретарей.Очистить();
	
	Для каждого стрНомерТелефона Из Объект.СЗНомеровСекретаря Цикл
		
		НоваяСтрока = Настройки.НомераСекретарей.Добавить();
		НоваяСтрока.НомерТелефона = стрНомерТелефона.Значение;
		
	КонецЦикла;
	
    Настройки.Записать(); 
	Настройки.Разблокировать();
	
КонецПроцедуры

&НаКлиенте
Процедура Команда(Команда)

	СтруктураПарамеровЗапуска = ПодготовитьСтруктуруПараметров();
	
	Если Объект.ВыполнятьВФоне Тогда
		КомандаВыполнитьВФоне(СтруктураПарамеровЗапуска);
	Иначе
		КомандаНаСервере(СтруктураПарамеровЗапуска);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьСтруктуруПараметров(АТС = "", Организация = "")
	
	СтруктураПараметров = Новый Структура; 
	
	СтруктураПараметров.Вставить("АТС", 				   АТС);
	СтруктураПараметров.Вставить("Организация", 		   Организация);

	СтруктураПараметров.Вставить("ДатаНачала", 			   Объект.ДатаНачала);
	СтруктураПараметров.Вставить("ДатаОкончания", 		   Объект.ДатаОкончания);
	СтруктураПараметров.Вставить("ВерсияAPI", 			   Объект.ВерсияAPI);
	СтруктураПараметров.Вставить("Пользователь", 		   Объект.Пользователь);
	СтруктураПараметров.Вставить("НомерТелефона", 		   Объект.НомерТелефона);
	СтруктураПараметров.Вставить("UID", 				   Объект.UID);
	СтруктураПараметров.Вставить("ЗагружатьПринудительно", Объект.ЗагружатьПринудительно);
	СтруктураПараметров.Вставить("ВыполнятьВФоне", 		   Объект.ВыполнятьВФоне);
	СтруктураПараметров.Вставить("СоздаватьЗвонки", 	   Объект.СоздаватьЗвонки);
	СтруктураПараметров.Вставить("ТолькоНеСозданные", 	   Объект.ТолькоНеСозданные);

	Возврат СтруктураПараметров;
	
КонецФункции

