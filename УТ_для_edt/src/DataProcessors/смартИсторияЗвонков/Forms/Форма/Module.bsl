&НаКлиенте
Процедура ОпределитьАбонентовВФоне(Команда)

	ИДЗадания =  "";
	Индикатор = 0;
	СтрокаСостояния = "";

	СтруктураПарамеровЗапуска = ПодготовитьСтруктуруПараметров();

	СтруктураПарамеровЗапуска.Вставить("ИмяМетода", "ОпределитьАбонентов");
	
	СтруктураФоновогоЗадания = ВыполнитьФоновоеЗаданиеНаСервере(СтруктураПарамеровЗапуска, УникальныйИдентификатор);
	ИДЗадания =  СтруктураФоновогоЗадания.ИдентификаторЗадания;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ТекстСообщения = "Идет определение абонентов";
	ПараметрыОжидания.Интервал = 1;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
		СтруктураФоновогоЗадания,
		Новый ОписаниеОповещения("ОбработатьДанные", ЭтотОбъект),
		ПараметрыОжидания);
	
	//++Индикатор
	ПодключитьОбработчикОжидания("ОбработчикОжиданияИндикатор", ПараметрыОжидания.Интервал);
 	//--Индикатор
	
КонецПроцедуры


