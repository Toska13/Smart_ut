									   + ?(СтруктураПарамеровЗапуска.АТС = "", "Asterisk и Мегафон", СтруктураПарамеровЗапуска.АТС) 
									   + ?(СтруктураПарамеровЗапуска.Организация = "", "", " " + СтруктураПарамеровЗапуска.Организация);
