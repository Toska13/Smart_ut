&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Об = РеквизитФормыВЗначение("Объект");
	Об.ЗаполнитьТаблицу();
	ЗначениеВРеквизитФормы(Об, "Объект");
	
	Если Объект.ЗапчастиКОтправке.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По номеру отправления " + Объект.НомерОтправления + " не найдено запчастей к отправке");
	КонецЕсли;
	
	РаскраситьЭлементы();
		
КонецПроцедуры

&НаСервере
Процедура РаскраситьЭлементы()
	
	Если Объект.ЗапчастиКОтправке.Итог("Сумма") > СуммаДляВыделенияКрасным Тогда
		Элементы.ЗапчастиКОтправкеСумма.ЦветФонаПодвала = WebЦвета.Красный	
	Иначе
		Элементы.ЗапчастиКОтправкеСумма.ЦветФонаПодвала = Новый Цвет;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте 
Процедура ПересчитатьСумму()
	
	ТекущиеДанные = Элементы.ЗапчастиКОтправке.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦенуВТаблице()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЗ.НомерСтроки КАК НомерСтроки,
	|	ТЗ.Номенклатура КАК Номенклатура,
	|	ТЗ.Количество КАК Количество,
	|	ТЗ.КодТНВЭД КАК КодТНВЭД,
	|	ТЗ.ВесНетто КАК ВесНетто,
	|	ТЗ.Описание КАК Описание,
	|	ТЗ.НомерЗаявки КАК НомерЗаявки
	|ПОМЕСТИТЬ ВТ_ТЗ
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТЗ.НомерСтроки КАК НомерСтроки,
	|	ВТ_ТЗ.Номенклатура КАК Номенклатура,
	|	ВТ_ТЗ.Количество КАК Количество,
	|	ВТ_ТЗ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЗ.ВесНетто КАК ВесНетто,
	|	ВТ_ТЗ.Описание КАК Описание,
	|	ВТ_ТЗ.НомерЗаявки КАК НомерЗаявки,
	|	ЕСТЬNULL(смартОписанияДляПретензий.Цена, 0) КАК Цена,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК Курс,
	|	ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК Кратность,
	|	ЕСТЬNULL(КурсыВалютСрезПоследнихДоллар.Курс, 1) КАК КурсДоллар,
	|	ЕСТЬNULL(КурсыВалютСрезПоследнихДоллар.Кратность, 1) КАК КратностьДоллар
	|ИЗ
	|	ВТ_ТЗ КАК ВТ_ТЗ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартОписанияДляПретензий КАК смартОписанияДляПретензий
	|		ПО ВТ_ТЗ.Номенклатура = смартОписанияДляПретензий.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсыВалютСрезПоследних
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &ВалютаДоллар) КАК КурсыВалютСрезПоследнихДоллар
	|		ПО (ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("ТЗ", Объект.ЗапчастиКОтправке.Выгрузить());
		
	ВалютаДоллар = Справочники.Валюты.НайтиПоКоду("840");
	
	Запрос.УстановитьПараметр("ВалютаДоллар", ВалютаДоллар);
	Запрос.УстановитьПараметр("Валюта", Объект.Валюта);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Объект.ЗапчастиКОтправке.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.ЗапчастиКОтправке.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ПараметрыВалютыДок = Новый Структура("Валюта, Курс, Кратность", Объект.Валюта, Выборка.Курс, Выборка.Кратность);
		ПараметрыВалютыВР  = Новый Структура("Валюта, Курс, Кратность", ВалютаДоллар, Выборка.КурсДоллар,  Выборка.КратностьДоллар);
		
		НоваяСтрока.Цена = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(НоваяСтрока.Цена, ПараметрыВалютыВР, ПараметрыВалютыДок);
		НоваяСтрока.Сумма = НоваяСтрока.Цена * НоваяСтрока.Количество;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

&НаКлиенте
Процедура ПечатьДокументов(КоллекцияПечатныхФорм, Знач ОбъектыПечати = Неопределено, ВладелецФормы = Неопределено, ЗаголовокФормы = "")
	Если ОбъектыПечати = Неопределено Тогда
		ОбъектыПечати = Новый СписокЗначений;
	КонецЕсли;
	
	КлючУникальности = Строка(Новый УникальныйИдентификатор);
	
	ПараметрыОткрытия = Новый Структура("ИмяМенеджераПечати,ИменаМакетов,ПараметрКоманды,ПараметрыПечати");
	ПараметрыОткрытия.ПараметрКоманды = Новый Массив;
	ПараметрыОткрытия.ПараметрыПечати = Новый Структура("ЗаголовокФормы", ЗаголовокФормы);
	ПараметрыОткрытия.Вставить("КоллекцияПечатныхФорм", КоллекцияПечатныхФорм);
	ПараметрыОткрытия.Вставить("ОбъектыПечати", ОбъектыПечати);
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ВладелецФормы, КлючУникальности);
КонецПроцедуры


&НаКлиенте
Процедура ПечатьИнвойсMimaki()
	
	ТабличныйДокумент = СформироватьТабличныйДокументИнвойсMimakiНаСервере();
	
	Если Объект.ЗаменаЧего = "чернила" Тогда
		СинонимМакета = "Инвойс " + Формат(Объект.Дата, "ДФ=yyyy-MM-dd") + "_Ink";
	Иначе
		СинонимМакета = "Инвойс";
	КонецЕсли;
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ИнвойсMimaki");    
    КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
    КоллекцияПечатныхФорм[0].Экземпляров = 5;
    КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;
	КоллекцияПечатныхФорм[0].ИмяФайлаПечатнойФормы = СинонимМакета;
	
	ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма, СинонимМакета);

КонецПроцедуры


