	СуммаДляВыделенияКрасным = 199;
	Объект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.НайтиПоНаименованию("СМАРТ-Т Совкомбанк (РУБ) - 177", Истина);
