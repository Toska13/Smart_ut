//++ смарт:ММ 635 19.10.2021 
&НаСервере
Процедура ЗаменитьНомерОтправленияВЗаявках(НовоеЗначение, ИмяПоля)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.ЗаявкаСсылка КАК ЗаявкаСсылка,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.ЗаявкаСсылка КАК ЗаявкаСсылка,
	|	ВТ_ТЧ.Номенклатура КАК Номенклатура,
	|	ВТ_ТЧ.Количество КАК Количество
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|ИТОГИ ПО
	|	ЗаявкаСсылка";
	
	Запрос.УстановитьПараметр("ТЧ", Объект.ЗапчастиКОтправке.Выгрузить());
	
	ВыборкаЗаявка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ИзмененоЗаписей = 0;

	СтатусДоставленоПоставщику = Неопределено;
	СтатусПоставщикПодтвердилПолучение = Неопределено;
	
	Если ИмяПоля = "ДатаДоставки" Тогда
		СтатусДоставленоПоставщику = Перечисления.смартСтатусыПоГарантии.ДоставленоПоставщику;
	КонецЕсли;
	
	Если ИмяПоля = "ДатаПодтверждения" Тогда
		СтатусПоставщикПодтвердилПолучение = Перечисления.смартСтатусыПоГарантии.ПоставщикПодтвердилПолучение;
	КонецЕсли;
	
	Пока ВыборкаЗаявка.Следующий() Цикл
		
		ЗаявкаОбъект = ВыборкаЗаявка.ЗаявкаСсылка.ПолучитьОбъект();
		БылиИзмененияВЗаявке = Ложь;
				
		Выборка = ВыборкаЗаявка.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Отбор = Новый Структура;
			
			Если ИмяПоля = "НомерОтправления" Тогда
				Отбор.Вставить("НомерОтправления", Объект.НомерОтправления);
			КонецЕсли;
			
			Отбор.Вставить("Номенклатура", Выборка.Номенклатура);
			
			НайденныеСтроки = ЗаявкаОбъект.ЗаполняетсяСпециалистомПоПретензиям.НайтиСтроки(Отбор);
			
			КоличествоКОтправке = Выборка.Количество;
			
			Для Каждого ТекСтрока Из НайденныеСтроки Цикл
				
				Если КоличествоКОтправке >= ТекСтрока.Количество Тогда
					
					КоличествоКОтправке = КоличествоКОтправке - ТекСтрока.Количество;
					
					Если ТекСтрока.НомерОтправления <> НовоеЗначение Тогда
						ТекСтрока[ИмяПоля] = НовоеЗначение;
						ИзмененоЗаписей = ИзмененоЗаписей + 1;
						БылиИзмененияВЗаявке = Истина;
						
						Если ИмяПоля = "ДатаДоставки" Тогда
							// Изменить статусы
							ТекСтрока.Статус = СтатусДоставленоПоставщику;
							
							НоваяСтрокаСтатус = ЗаявкаОбъект.Статусы.Добавить();							
							НоваяСтрокаСтатус.НомерПозиции = ТекСтрока.НомерПозиции;
							НоваяСтрокаСтатус.ДатаИзмененияСтатуса = ТекущаяДата();
							НоваяСтрокаСтатус.Статус = СтатусДоставленоПоставщику;
							
						ИначеЕсли ИмяПоля = "ДатаПодтверждения" Тогда
							// Изменить статусы
							ТекСтрока.Статус = СтатусПоставщикПодтвердилПолучение;
							
							НоваяСтрокаСтатус = ЗаявкаОбъект.Статусы.Добавить();							
							НоваяСтрокаСтатус.НомерПозиции = ТекСтрока.НомерПозиции;
							НоваяСтрокаСтатус.ДатаИзмененияСтатуса = ТекущаяДата();
							НоваяСтрокаСтатус.Статус = СтатусПоставщикПодтвердилПолучение;

						КонецЕсли;						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Если БылиИзмененияВЗаявке Тогда
			Попытка
				ЗаявкаОбъект.ОбменДанными.Загрузка = Истина;
				ЗаявкаОбъект.Записать();
			Исключение
				ТекстСообщения = "Не удалось изменить документ " + ВыборкаЗаявка.ЗаявкаСсылка + ": " + ОписаниеОшибки();
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;			
		КонецЕсли;	
	КонецЦикла;
	
	ОбщегоНазначения.СообщитьПользователю("Изменено строк в документах: " + ИзмененоЗаписей);
	
КонецПроцедуры //-- смарт:ММ 19.10.2021

