	Объект.ЗаменаЧего = "запасные части печатного оборудования"; // или "чернила"
	Объект.Валюта = Справочники.Валюты.НайтиПоКоду("840");
	
	// 27.08.2020
	// ++ 27.11.2002
    //Объект.Оператор = "TNT";
    Объект.Оператор = "DHL";
    
	//++ #Б-3706 смарт: Лопато 07.07.2025 //Печать сопроводительных документов (смарт). Подпись.
	НаименованиеОтвЛица = "Акимов Ф";

	ОтборОтвЛиц = Новый Структура;
	ОтборОтвЛиц.Вставить("Дата", 			  ТекущаяДата());
	ОтборОтвЛиц.Вставить("Организация", 	  Объект.БанковскийСчет.Владелец);
	ОтборОтвЛиц.Вставить("ОтветственноеЛицо", Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);

	ТЗОтветственныхЛиц = ОтветственныеЛицаСервер.ПолучитьТаблицуОтветственныхЛицПоОтбору(ОтборОтвЛиц);	
	ТЗОтветственныхЛиц.Сортировать("Наименование");
	
	Элементы.ЛицоСПравомПодписи.СписокВыбора.ЗагрузитьЗначения(ТЗОтветственныхЛиц.ВыгрузитьКолонку("Ссылка"));
	
	Для Каждого СтрОтвЛицо Из ТЗОтветственныхЛиц Цикл

		Если СтрНайти(СокрЛП(СтрОтвЛицо.Ссылка), НаименованиеОтвЛица) <> 0 Тогда 
			Объект.ЛицоСПравомПодписи = СтрОтвЛицо.Ссылка;
		КонецЕсли;	
			
	КонецЦикла;	
	//-- #Б-3706 смарт: Лопато 07.07.2025
	
КонецПроцедуры

