Функция СформироватьТабличныйДокументБланкПередачиБрака() Экспорт
	
	Макет = ПолучитьМакет("ПФ_MXL_БланкПередачиБрака");
	
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал 		= Макет.ПолучитьОбласть("Подвал");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху 	= 10;
	ТабДок.ПолеСлева 	= 5;
	ТабДок.ПолеСправа 	= 5;
	ТабДок.АвтоМасштаб = Истина;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ТЧ.ЗаявкаСсылка КАК ЗаявкаСсылка,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ТЧ.ВесНетто КАК ВесНетто,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Описание КАК Описание,
	|	ТЧ.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПриобретениеТоваровУслуг.Контрагент КАК Контрагент
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|			ПО смартЗаявкаНаГарантийныйРемонт.ДокументПриобретения = ПриобретениеТоваровУслуг.Ссылка
	|		ПО ВТ_ТЧ.ЗаявкаСсылка = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_ТЧ.Цена КАК Цена,
	|	ВТ_ТЧ.Номенклатура.Артикул КАК Артикул,
	|	ВТ_ТЧ.Номенклатура.Наименование КАК Номенклатура,
	|	ВТ_ТЧ.Номенклатура.НаименованиеАнгл КАК НоменклатураАнгл
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки";
	
	Запрос.УстановитьПараметр("ТЧ",	ЗапчастиКОтправке.Выгрузить());
	
	РезультатЗапроса 	= Запрос.ВыполнитьПакет();
	МассивПолучателей	= РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("Контрагент");
	ВыборкаТовары		= РезультатЗапроса[2].Выбрать();
	
	ДатаФормирования	= ЭтотОбъект.Дата;
	
	ОбластьЗаголовок.Параметры.Поставщик 	= СтрСоединить(МассивПолучателей, ", ");

	ТабДок.Вывести(ОбластьЗаголовок);
	
	ТабДок.Вывести(ОбластьШапка);
		
	СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
	СтрокаСПодвалом.Добавить(ОбластьСтрока); 
	
	НомерПП 			= 1;
	КоличествоСтраниц 	= 1;
		
	Пока ВыборкаТовары.Следующий() Цикл 	
		ОбластьСтрока 						= Макет.ПолучитьОбласть("Строка");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаТовары);
		ОбластьСтрока.Параметры.НомерПП 	= НомерПП;
				
		НомерПП 	= НомерПП + 1;
		
		Если НЕ ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда			
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
			ТабДок.Вывести(ОбластьШапка);
			КоличествоСтраниц = КоличествоСтраниц + 1;
		КонецЕсли; 
		
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.НомерОтправления = НомерОтправления;
	ОбластьПодвал.Параметры.Поставщик = ОбластьЗаголовок.Параметры.Поставщик;
	
	ТабДок.Вывести(ОбластьПодвал);	
	
	Если КоличествоСтраниц > 1 Тогда
		ТабДок.НижнийКолонтитул.Выводить = Истина;
		ТабДок.НижнийКолонтитул.ТекстВЦентре = "-СТР.[&НомерСтраницы]-";
		ТабДок.НижнийКолонтитул.ТекстСправа = "";
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции //-- #Б-5690 смарт: Фролов 06.03.2026

Функция СформироватьТабличныйДокументИнвойс() Экспорт
	
