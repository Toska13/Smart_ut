#Область Печать

Функция СформироватьТабличныйДокументИнвойсMimaki() Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если Оператор = "TNT" Тогда
		ТабДок = СформироватьТабличныйДокументИнвойсMimakiTNT();
	ИначеЕсли Оператор = "DHL" Тогда
		ТабДок = СформироватьТабличныйДокументИнвойсMimakiDHL();
	КонецЕсли;
			
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьТабличныйДокументИнвойсMimakiTNT()
	
	Макет = ПолучитьМакет("ИнвойсMimaki");
		
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИспользуемоеИмяФайла = "Инвойс";
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	Организации.НаименованиеМеждународное КАК НаименованиеМеждународное,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КодПоОКПО КАК ОКПО,
	|	Организации.КПП КАК КПП,
	|	Организации.ОГРН КАК ОГРН,
	|	ЕСТЬNULL(ОрганизацииКонтактнаяИнформацияТелефон.Представление, ""8 (495) 663-91-11"") КАК ТелефонОрганизации,
	|	ЕСТЬNULL(БанковскиеСчетаОрганизаций.НомерСчета, ""40702810300050480177"") КАК НомерСчета,
	|	ЕСТЬNULL(КлассификаторБанков.Код, ""044525360"") КАК БИК,
	|	ЕСТЬNULL(БанковскиеСчетаОрганизаций.КоррСчетБанка, ""30101810445250000360"") КАК КоррСчет,
	|	ЕСТЬNULL(КлассификаторБанков.Наименование, ""Филиал """"Корпоративный"""" ПАО """"Совкомбанк"""""") КАК НаименованиеБанка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторБанков.МеждународноеНаименование, """") = """"
	|			ТОГДА ""SOVCOMBANK, CORPORATE BRANCH""
	|		ИНАЧЕ КлассификаторБанков.МеждународноеНаименование
	|	КОНЕЦ КАК НаименованиеБанкаМеждународное
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформацияТелефон
	|		ПО (ОрганизацииКонтактнаяИнформацияТелефон.Ссылка = Организации.Ссылка)
	|			И (ОрганизацииКонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|			ПО БанковскиеСчетаОрганизаций.Банк = КлассификаторБанков.Ссылка
	|		ПО (БанковскиеСчетаОрганизаций.Владелец = Организации.Ссылка)
	|			И (НЕ БанковскиеСчетаОрганизаций.ПометкаУдаления)
	|			И (БанковскиеСчетаОрганизаций.Ссылка = &БанковскийСчет)
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбластьДокумент = Макет.ПолучитьОбласть("Инвойс");
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьДокумент.Параметры, Выборка);
		ОбластьДокумент.Параметры.ВесБрутто 	= ВесБрутто;
		ОбластьДокумент.Параметры.ВесНетто 		= ЗапчастиКОтправке.Итог("ВесНетто");
		ОбластьДокумент.Параметры.Количество 	= ЗапчастиКОтправке.Итог("Количество");
		ОбластьДокумент.Параметры.Стоимость 	= ЗапчастиКОтправке.Итог("Сумма");

		ОбластьДокумент.Параметры.ДатаТекст = Формат(Дата, "ДФ='dd.MM.yyyy ""г.""'");
		ОбластьДокумент.Параметры.Дата 		= Дата;
		ОбластьДокумент.Параметры.НомерОтправления = НомерОтправления;
		
	КонецЦикла;
       
    ТабДок.Вывести(ОбластьДокумент);
    
    //++ смарт:ПА #843 22.12.2021 18:52:58
    ОбластьПодвал = Макет.ПолучитьОбласть("ПодвалИнвойс");
    Если ЗначениеЗаполнено(ЭтотОбъект.ЛицоСПравомПодписи) Тогда
        ОбластьПодвал.Параметры.Подписант 	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ЭтотОбъект.ЛицоСПравомПодписи.ФизическоеЛицо,ТекущаяДатаСеанса());
        ОбластьПодвал.Параметры.ДоверенностьПодписанта 		= ЭтотОбъект.ЛицоСПравомПодписи.ОснованиеПраваПодписи;
    КонецЕсли;
    ТабДок.Вывести(ОбластьПодвал);
    //-- смарт:ПА #843 22.12.2021 18:52:58
    
    Возврат ТабДок;
	
КонецФункции

Функция СформироватьТабличныйДокументИнвойсMimakiDHL()
	
	Макет = ПолучитьМакет("ИнвойсMimakiDHL");
		
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИспользуемоеИмяФайла = "Инвойс";
	ТабДок.АвтоМасштаб = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ТЧ.ВесНетто КАК ВесНетто,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Описание КАК Описание,
	|	ТЧ.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТЧ.Описание КАК Описание,
	|	ВТ_ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.Сумма КАК Сумма,
	|	ВТ_ТЧ.Цена КАК Цена,
	|	ВТ_ТЧ.ВесНетто КАК ВесНетто,
	|	НоменклатураСпр.Наименование КАК НаименованиеНоменклатуры,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	НоменклатураСпр.СтранаПроисхождения.Наименование КАК СтранаПроисхожденияНаименование,
	|	НоменклатураСпр.СтранаПроисхождения.МеждународноеНаименование КАК СтранаПроисхожденияМеждународноеНаименование
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ВТ_ТЧ.Номенклатура = НоменклатураСпр.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	Организации.НаименованиеМеждународное КАК НаименованиеМеждународное,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КодПоОКПО КАК ОКПО,
	|	Организации.КПП КАК КПП,
	|	Организации.ОГРН КАК ОГРН,
	|	ЕСТЬNULL(ОрганизацииКонтактнаяИнформацияТелефон.Представление, ""8 (495) 663-91-11"") КАК ТелефонОрганизации,
	|	ЕСТЬNULL(БанковскиеСчетаОрганизаций.НомерСчета, ""40702810300050480177"") КАК НомерСчета,
	|	ЕСТЬNULL(КлассификаторБанков.Код, ""044525360"") КАК БИК,
	|	ЕСТЬNULL(БанковскиеСчетаОрганизаций.КоррСчетБанка, ""30101810445250000360"") КАК КоррСчет,
	|	ЕСТЬNULL(КлассификаторБанков.Наименование, ""Филиал """"Корпоративный"""" ПАО """"Совкомбанк"""""") КАК НаименованиеБанка,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КлассификаторБанков.МеждународноеНаименование, """") = """"
	|			ТОГДА ""SOVCOMBANK, CORPORATE BRANCH""
	|		ИНАЧЕ КлассификаторБанков.МеждународноеНаименование
	|	КОНЕЦ КАК НаименованиеБанкаМеждународное
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформацияТелефон
	|		ПО (ОрганизацииКонтактнаяИнформацияТелефон.Ссылка = Организации.Ссылка)
	|			И (ОрганизацииКонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|			ПО БанковскиеСчетаОрганизаций.Банк = КлассификаторБанков.Ссылка
	|		ПО (БанковскиеСчетаОрганизаций.Владелец = Организации.Ссылка)
	|			И (НЕ БанковскиеСчетаОрганизаций.ПометкаУдаления)
	|			И (БанковскиеСчетаОрганизаций.Ссылка = &БанковскийСчет)
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("ТЧ", ЗапчастиКОтправке.Выгрузить());
	Запрос.УстановитьПараметр("БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка = Результат[Результат.Количество() - 1].Выбрать();
	ВыборкаСтроки = Результат[Результат.Количество() - 2].Выбрать();
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	// ++ 10.05.2021
	ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
	ОбластьПодпись = Макет.ПолучитьОбласть("ОбластьПодпись");
	ОбластьПодпись.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");
    
	 //++ смарт:ПА #843 22.12.2021 18:52:58
    Если ЗначениеЗаполнено(ЭтотОбъект.ЛицоСПравомПодписи) Тогда
        ОбластьПодпись.Параметры.Подписант 	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ЭтотОбъект.ЛицоСПравомПодписи.ФизическоеЛицо,ТекущаяДатаСеанса());
        ОбластьПодпись.Параметры.ДоверенностьПодписанта 		= ЭтотОбъект.ЛицоСПравомПодписи.ОснованиеПраваПодписи;
    КонецЕсли;
    //-- смарт:ПА #843 22.12.2021 18:52:58

	//СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
	//СтрокаСПодвалом.Добавить(ОбластьСтрока); 
	//СтрокаСПодвалом.Добавить(ОбластьПодпись); 
	
	ВсегоСтрок = ВыборкаСтроки.Количество();
	КоличествоСтрок = 0;
	// --
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаШапка);
		ОбластьШапка.Параметры.ВесБрутто 	= ВесБрутто;
		ОбластьШапка.Параметры.ВесНетто 	= ЗапчастиКОтправке.Итог("ВесНетто");
		//ОбластьШапка.Параметры.Количество 	= ЗапчастиКОтправке.Итог("Количество");

		ОбластьШапка.Параметры.Дата 		= Формат(Дата, "ДФ=yyyy-MM-dd");
		ОбластьШапка.Параметры.НомерОтправления = НомерОтправления;
			
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьШапка);

	НомерПП = 1;
	
	Пока ВыборкаСтроки.Следующий() Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
		ОбластьСтрока.Параметры.НомерПП 	= НомерПП;
		ОбластьСтрока.Параметры.Количество 	= ВыборкаСтроки.Количество;
		ОбластьСтрока.Параметры.Цена 		= Формат(ВыборкаСтроки.Цена, "ЧДЦ=2; ЧРД=.");	
		ОбластьСтрока.Параметры.Сумма 		= Формат(ВыборкаСтроки.Сумма, "ЧДЦ=2; ЧРД=.");
		ОбластьСтрока.Параметры.Описание 	= "" + ВыборкаСтроки.НомерЗаявки + " " + ВыборкаСтроки.Описание;
		ОбластьСтрока.Параметры.Валюта 		= Валюта;
		
		Если ЗначениеЗаполнено(ВыборкаСтроки.СтранаПроисхожденияМеждународноеНаименование) Тогда
			ОбластьСтрока.Параметры.Страна = ВыборкаСтроки.СтранаПроисхожденияМеждународноеНаименование;
		Иначе
			ОбластьСтрока.Параметры.Страна = ПолучитьСтрануНаАнгл(ВыборкаСтроки.СтранаПроисхожденияНаименование);
		КонецЕсли;
		
		НомерПП = НомерПП + 1;
		
		// ++ 10.05.2021
		КоличествоСтрок = КоличествоСтрок + 1;
		СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
		СтрокаСПодвалом.Добавить(ОбластьСтрока); 
		СтрокаСПодвалом.Добавить(ОбластьПодпись);
		//++ смарт:ММ 635 19.10.2021
		Если КоличествоСтрок = ВсегоСтрок Тогда
			СтрокаСПодвалом.Добавить(ОбластьПодвал);
		КонецЕсли;
		//-- смарт:ММ 19.10.2021
		Если Не ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда
			ТабДок.Вывести(ОбластьПодпись);  
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();  
		КонецЕсли;
			
		// --
		
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	
	//ОбластьПодвал.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");
	ОбластьПодвал.Параметры.Сумма = Формат(ЗапчастиКОтправке.Итог("Сумма"), "ЧДЦ=2; ЧРД=.");
	ОбластьПодвал.Параметры.Валюта = Валюта;
	
	ТабДок.Вывести(ОбластьПодвал);
	
	// ++ 10.05.2021
	ТабДок.Вывести(ОбластьПодпись);
	// --
	
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьСтрануНаАнгл(Наименование)
	
	Результат = Наименование;
	
	НаименованиеВРег = ВРег(Наименование);
	
	Если НаименованиеВРег = "ЯПОНИЯ" Тогда
		Результат = "Japan";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТабличныйДокументПриложениеMimaki() Экспорт
	
	Макет = ПолучитьМакет("Приложение1Mimaki");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху 	= 10;
	ТабДок.ПолеСлева 	= 5;
	ТабДок.ПолеСправа 	= 5;
	//ТабДок.ПолеСнизу 	= 10;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ТЧ.ВесНетто КАК ВесНетто,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Описание КАК Описание,
	|	ТЧ.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТЧ.Описание КАК Описание,
	|	ВТ_ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.Сумма КАК Сумма,
	|	ВТ_ТЧ.ВесНетто КАК ВесНетто,
	|	НоменклатураСпр.Наименование КАК НаименованиеНоменклатуры,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ВТ_ТЧ.Номенклатура = НоменклатураСпр.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки";
	
	Запрос.УстановитьПараметр("ТЧ", ЗапчастиКОтправке.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОбластьШапка 	= Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрока 	= Макет.ПолучитьОбласть("ОбластьСтрока");
	ОбластьПодвал 	= Макет.ПолучитьОбласть("ОбластьПодвал");
	ОбластьПодпись 	= Макет.ПолучитьОбласть("ОбластьПодпись");
	//ОбластьПусто 	= Макет.ПолучитьОбласть("ОбластьПустаяСтрока");
	
	ОбластьШапка.Параметры.Дата = Формат(Дата, "ДФ='dd.MM.yyyy ""г.""'");
	
	ТабДок.Вывести(ОбластьШапка);
	
	НомерПП = 1;
	
	НоваяСтраница = Ложь;
	СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
	СтрокаСПодвалом.Добавить(ОбластьСтрока); 
	СтрокаСПодвалом.Добавить(ОбластьПодпись); 
	//СтрокаСПодвалом.Добавить(ОбластьПусто);
    
    //++ смарт:ПА #843 22.12.2021 18:52:58
    Если ЗначениеЗаполнено(ЭтотОбъект.ЛицоСПравомПодписи) Тогда
        ОбластьПодпись.Параметры.Подписант 	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ЭтотОбъект.ЛицоСПравомПодписи.ФизическоеЛицо,ТекущаяДатаСеанса());
        ОбластьПодпись.Параметры.ДоверенностьПодписанта 		= ЭтотОбъект.ЛицоСПравомПодписи.ОснованиеПраваПодписи;
    КонецЕсли;
    //-- смарт:ПА #843 22.12.2021 18:52:58

	СуммаИтого = 0;
	КоличествоИтого = 0;
	
	КоличествоСтраниц = 1;
		
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
		ОбластьСтрока.Параметры.НомерПП = НомерПП;
		//ОбластьСтрока.Параметры.Описание = "" + Выборка.НомерЗаявки + " " + Выборка.НаименованиеНоменклатуры + " " + Выборка.Описание;
		ОбластьСтрока.Параметры.Описание = "" + Выборка.НомерЗаявки + " " + Выборка.Описание;
		
		СуммаИтого = СуммаИтого + Выборка.Сумма;
		КоличествоИтого = КоличествоИтого + Выборка.Количество;
		
		НомерПП = НомерПП + 1;
		
		Если Не ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда 			
			ТабДок.Вывести(ОбластьПодпись);  
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();  
			КоличествоСтраниц = КоличествоСтраниц + 1;
		КонецЕсли; 
		
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Сумма = СуммаИтого;
	ОбластьПодвал.Параметры.Количество = КоличествоИтого;
	ТабДок.Вывести(ОбластьПодвал);
    
	ТабДок.Вывести(ОбластьПодпись);
	
	Если КоличествоСтраниц > 1 Тогда
		ТабДок.НижнийКолонтитул.Выводить = Истина;
		ТабДок.НижнийКолонтитул.ТекстВЦентре = "-СТР.[&НомерСтраницы]-";
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции

Функция СформироватьТабличныйДокументРекламационныйАктMimaki() Экспорт
	
	Макет = ПолучитьМакет("РекламационныйАктMimaki");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ПолеСверху 	= 10;
	ТабДок.ПолеСлева 	= 5;
	ТабДок.ПолеСправа 	= 5;
	//ТабДок.ПолеСнизу 	= 10;
	ТабДок.АвтоМасштаб = Истина;
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ТЧ.ВесНетто КАК ВесНетто,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Описание КАК Описание,
	|	ТЧ.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТЧ.Описание КАК Описание,
	|	ВТ_ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.Сумма КАК Сумма,
	|	ВТ_ТЧ.ВесНетто КАК ВесНетто,
	|	НоменклатураСпр.Наименование КАК НаименованиеНоменклатуры,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ЕСТЬNULL(ОрганизацииКонтактнаяИнформацияАдрес.Представление, """") КАК ЮрАдрес,
	|	ОрганизацииСпр.НаименованиеСокращенное КАК НаименованиеСокращенное,
	|	ВТ_ТЧ.Цена КАК Цена
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ВТ_ТЧ.Номенклатура = НоменклатураСпр.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОрганизацииСпр
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформацияАдрес
	|			ПО ОрганизацииСпр.Ссылка = ОрганизацииКонтактнаяИнформацияАдрес.Ссылка
	|				И (ОрганизацииКонтактнаяИнформацияАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации))
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ОрганизацииСпр.Ссылка = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки
	|ИТОГИ
	|	МАКСИМУМ(ЮрАдрес),
	|	МАКСИМУМ(НаименованиеСокращенное)
	|ПО
	|	ОрганизацииСпр.Ссылка";
	
	Запрос.УстановитьПараметр("ТЧ", ЗапчастиКОтправке.Выгрузить());
	Запрос.УстановитьПараметр("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение);
	
	ВыборкаОрганизации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОрганизации.Следующий() Цикл
		
		ОбластьЗаголовок= Макет.ПолучитьОбласть("ОбластьЗаголовок");
		ОбластьШапка 	= Макет.ПолучитьОбласть("ОбластьШапка");
		ОбластьСтрока 	= Макет.ПолучитьОбласть("ОбластьСтрока");
		ОбластьПодвал 	= Макет.ПолучитьОбласть("ОбластьПодвал");
		ОбластьПодпись 	= Макет.ПолучитьОбласть("ОбластьПодпись");
		
		ОбластьЗаголовок.Параметры.НаименованиеСокращенное = ВыборкаОрганизации.НаименованиеСокращенное;
		ОбластьЗаголовок.Параметры.ЮрАдрес = ВыборкаОрганизации.ЮрАдрес;
		
		// ++ 22.03.2021		
		ОтправляемогоЧего = "отправляемого оборудования";
		
		Если ЗаменаЧего = "чернила" Тогда
			ОтправляемогоЧего = "отправляемых чернил";
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.ОтправляемогоЧего = ОтправляемогоЧего;
		// --
		
		ОбластьЗаголовок.Параметры.ЗаменаЧего = ЗаменаЧего;		
				
		ТабДок.Вывести(ОбластьЗаголовок);
		ТабДок.Вывести(ОбластьШапка);
		
		НомерПП = 1;
		
		НоваяСтраница = Ложь;
		СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
		СтрокаСПодвалом.Добавить(ОбластьСтрока); 
		СтрокаСПодвалом.Добавить(ОбластьПодпись);
        
        //++ смарт:ПА #843 22.12.2021 18:52:58
        Если ЗначениеЗаполнено(ЭтотОбъект.ЛицоСПравомПодписи) Тогда
            ОбластьПодпись.Параметры.Подписант 	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ЭтотОбъект.ЛицоСПравомПодписи.ФизическоеЛицо,ТекущаяДатаСеанса());
            ОбластьПодпись.Параметры.ДоверенностьПодписанта 		= ЭтотОбъект.ЛицоСПравомПодписи.ОснованиеПраваПодписи;
        КонецЕсли;
        //-- смарт:ПА #843 22.12.2021 18:52:58

		СуммаИтого = 0;
		
		КоличествоСтраниц = 1;
		Выборка = ВыборкаОрганизации.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
			ОбластьСтрока.Параметры.НомерПП = НомерПП;
			//ОбластьСтрока.Параметры.Описание = "" + Выборка.НомерЗаявки + " " + Выборка.НаименованиеНоменклатуры + " " + Выборка.Описание;
			ОбластьСтрока.Параметры.Описание = "" + Выборка.НомерЗаявки + " " + Выборка.Описание;
			
			СуммаИтого = СуммаИтого + Выборка.Сумма;
			
			НомерПП = НомерПП + 1;
			
			Если Не ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда			
				ТабДок.Вывести(ОбластьПодпись);  
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
				ТабДок.Вывести(ОбластьШапка);
				КоличествоСтраниц = КоличествоСтраниц + 1;
			КонецЕсли; 
			
			// ++ 27.11.2020
			Если Оператор = "DHL" Тогда
				ОбластьСтрока.Параметры.Цена = Формат(ОбластьСтрока.Параметры.Цена, "ЧДЦ=2; ЧРД=.");
				ОбластьСтрока.Параметры.Сумма = Формат(ОбластьСтрока.Параметры.Сумма, "ЧДЦ=2; ЧРД=.");
			КонецЕсли;
			// --
			
			ТабДок.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Сумма = СуммаИтого;
		
		// ++ 27.11.2020
		Если Оператор = "DHL" Тогда
			ОбластьПодвал.Параметры.Сумма = Формат(ОбластьПодвал.Параметры.Сумма, "ЧДЦ=2; ЧРД=.");
		КонецЕсли;
		// --
		
		ТабДок.Вывести(ОбластьПодвал);
		
		ТабДок.Вывести(ОбластьПодпись);
				
		Если КоличествоСтраниц > 1 Тогда
			ТабДок.НижнийКолонтитул.Выводить = Истина;
			ТабДок.НижнийКолонтитул.ТекстВЦентре = "-СТР.[&НомерСтраницы]-";
			// ++ 06.05.2021
			ТабДок.НижнийКолонтитул.ТекстСправа = "";
			// --
		КонецЕсли;
	
	КонецЦикла;

	Возврат ТабДок;

КонецФункции

