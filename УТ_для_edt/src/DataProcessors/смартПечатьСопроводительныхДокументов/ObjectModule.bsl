	|		ПО ВТ_ТЧ.ЗаявкаСсылка = ВТ_ОборудованиеЗаявок.ЗаявкаСсылка
	|
	//++ #Б-6296 смарт: Фролов 03.04.2026 //Печать сопроводительных документов. Некорректно выводится Рекламационный акт
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТЧ.КодТНВЭД,
	|	ВТ_ТЧ.НомерЗаявки,
	|	ВТ_ОборудованиеЗаявок.Серия,
	|	ВТ_ТЧ.Сумма,
	|	ВТ_ОборудованиеЗаявок.АртикулОборудования,
	|	ВТ_ТЧ.ВесНетто,
	|	ВТ_ОборудованиеЗаявок.Оборудование,
	|	ВТ_ТЧ.Количество,
	|	ВТ_ТЧ.Цена,
	|	ВТ_ОборудованиеЗаявок.МаркаОборудования,
	|	ВТ_ОборудованиеЗаявок.Серия.Номер,
	|	ПОДСТРОКА(ВТ_ТЧ.Описание, 0, 1024) 
	//-- #Б-6296 смарт: Фролов 03.04.2026
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки";
	
	Запрос.УстановитьПараметр("ТЧ",	ЗапчастиКОтправке.Выгрузить());
	
	РезультатЗапроса 	= Запрос.ВыполнитьПакет();
	МассивПолучателей	= РезультатЗапроса[2].Выгрузить().ВыгрузитьКолонку("Контрагент");
	ГТДОборудования		= РезультатЗапроса[3].Выгрузить();
	ВыборкаТовары		= РезультатЗапроса[4].Выбрать();
	
	ДатаФормирования	= ЭтотОбъект.Дата;
	
	ОбластьЗаголовок.Параметры.НомерАкта 	= Формат(ДатаФормирования, "ДФ='dMMyy'");
	ОбластьЗаголовок.Параметры.ДатаАкта		= Формат(ДатаФормирования, "ДФ='dd.MM.yyyy ""г.""'");

	Организация 		= Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение;
	Сведения 			= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(Организация, ДатаФормирования);

	ОбластьЗаголовок.Параметры.НаименованиеСокращенное 	= Сведения.СокращенноеНаименование;
	ОбластьЗаголовок.Параметры.ЮрАдрес 					= Сведения.ЮридическийАдрес;	
	ОбластьЗаголовок.Параметры.НаименованиеПолучателя 	= СтрСоединить(МассивПолучателей, ", ");
	ОбластьЗаголовок.Параметры.ОтправляемогоЧего 		= ?(ЭтотОбъект.ЗаменаЧего = "чернила", "отправляемых чернил", 
																					"отправляемого оборудования");
	ОбластьЗаголовок.Параметры.ЗаменаЧего 				= ЭтотОбъект.ЗаменаЧего;		
	
	ТабДок.Вывести(ОбластьЗаголовок);
	
	ВалютыИОбозначения 		= ПолучитьСоответствиеОбозначенияВалюты();
	СимволВалюты		 	= ВалютыИОбозначения.Получить(ЭтотОбъект.Валюта);
	ОбластьШапка.Параметры.СимволВалюты = ?(СимволВалюты = Неопределено, ЭтотОбъект.Валюта, СимволВалюты); 
	ТабДок.Вывести(ОбластьШапка);
		
	СтрокаСПодвалом = Новый Массив; // Массив для проверки вывода 
	СтрокаСПодвалом.Добавить(ОбластьСтрока); 
	СтрокаСПодвалом.Добавить(ОбластьПодпись);
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ЛицоСПравомПодписи) Тогда
		ОбластьПодпись.Параметры.Подписант 	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ЭтотОбъект.ЛицоСПравомПодписи.ФизическоеЛицо,
																						ТекущаяДатаСеанса());
		ОбластьПодпись.Параметры.ДоверенностьПодписанта 		= ЭтотОбъект.ЛицоСПравомПодписи.ОснованиеПраваПодписи;
	КонецЕсли;
	
	НомерПП 			= 1;
	СуммаИтого 			= 0;	
	КоличествоСтраниц 	= 1;
		
	Пока ВыборкаТовары.Следующий() Цикл 	
		ОбластьСтрока 						= Макет.ПолучитьОбласть("ОбластьСтрока");
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, ВыборкаТовары);
		ОбластьСтрока.Параметры.НомерПП 	= НомерПП;
		
		НомерГТД 				= ГТДОборудования.Скопировать(Новый Структура("Номенклатура, Серия", 
													ВыборкаТовары.Оборудование, ВыборкаТовары.Серия));
		ДополнительныеОписание 	= СтрШаблон("Была изъята из режущего плоттера т.м. %1, модели %2, С/Н %3, ДТ №%4", 
													ВРег(ВыборкаТовары.МаркаОборудования),
													ВыборкаТовары.АртикулОборудования, 
													ВыборкаТовары.НомерСерии, 
													СокрЛП(СтрСоединить(НомерГТД.ВыгрузитьКолонку("НомерГТД"), ",")));
		
		ОбластьСтрока.Параметры.Описание 	= СтрШаблон("%1 %2
													|%3", 
													ВыборкаТовары.НомерЗаявки,
													ВыборкаТовары.Описание,
													ДополнительныеОписание);
		
		СуммаИтого 	= СуммаИтого + ВыборкаТовары.Сумма;		
		НомерПП 	= НомерПП + 1;
		
		Если НЕ ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда			
			ТабДок.Вывести(ОбластьПодпись);  
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
			ТабДок.Вывести(ОбластьШапка);
			КоличествоСтраниц = КоличествоСтраниц + 1;
		КонецЕсли; 
		
		Если Оператор = "DHL" Тогда
			ОбластьСтрока.Параметры.Цена = Формат(ОбластьСтрока.Параметры.Цена, "ЧДЦ=2; ЧРД=.");
			ОбластьСтрока.Параметры.Сумма = Формат(ОбластьСтрока.Параметры.Сумма, "ЧДЦ=2; ЧРД=.");
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьСтрока);		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Валюта = СтрШаблон("%1 %2", ЭтотОбъект.Валюта.НаименованиеПолное, ЭтотОбъект.Валюта);
	ОбластьПодвал.Параметры.Сумма = СуммаИтого;
	
	Если Оператор = "DHL" Тогда
		ОбластьПодвал.Параметры.Сумма = Формат(ОбластьПодвал.Параметры.Сумма, "ЧДЦ=2; ЧРД=.");
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьПодвал);	
	ТабДок.Вывести(ОбластьПодпись);
	
	Если КоличествоСтраниц > 1 Тогда
		ТабДок.НижнийКолонтитул.Выводить = Истина;
		ТабДок.НижнийКолонтитул.ТекстВЦентре = "-СТР.[&НомерСтраницы]-";
		ТабДок.НижнийКолонтитул.ТекстСправа = "";
	КонецЕсли;
	
	Возврат ТабДок;

КонецФункции

