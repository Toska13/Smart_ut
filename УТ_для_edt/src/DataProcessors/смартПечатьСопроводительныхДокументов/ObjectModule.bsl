		СтрокаСПодвалом.Добавить(ОбластьСтрока); 
		СтрокаСПодвалом.Добавить(ОбластьПодвал);
        		
		НомерПП 			= 1;
		СуммаИтого 			= 0;		
		КоличествоСтраниц 	= 1;
		МаркиОборудования	= Новый Массив;
		
		Выборка = ВыборкаПолучатели.Выбрать();
		
		Пока Выборка.Следующий() Цикл			
			ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Выборка);
			ОбластьСтрока.Параметры.НомерПП = НомерПП;
			ОбластьСтрока.Параметры.Описание = СтрШаблон("%1 %2", Выборка.НомерЗаявки, Выборка.Описание);
			
			Если МаркиОборудования.Найти(Выборка.Марка) = Неопределено Тогда
				МаркиОборудования.Добавить(Выборка.Марка);
			КонецЕсли;
			
			СуммаИтого 	= СуммаИтого + Выборка.Сумма;
			НомерПП 	= НомерПП + 1;
			
			Если Не ТабДок.ПроверитьВывод(СтрокаСПодвалом) Тогда			
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
				ТабДок.Вывести(ОбластьШапка);
				КоличествоСтраниц = КоличествоСтраниц + 1;
			КонецЕсли; 
			
			ТабДок.Вывести(ОбластьСтрока); 		
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Валюта 				= ЭтотОбъект.Валюта;
		ОбластьПодвал.Параметры.СуммаИтого 			= Формат(СуммаИтого, "ЧДЦ=2");
		ОбластьПодвал.Параметры.МаркаОборудования 	= ВРег(СтрСоединить(МаркиОборудования, ","));
		ОбластьПодвал.Параметры.НомерАкта			= Формат(ДатаФормирования, "ДФ='dMMyy'");
		ОбластьПодвал.Параметры.ДатаАкта   			= Формат(ДатаФормирования, "ДФ='dd.MM.yyyy'");
	
		ТабДок.Вывести(ОбластьПодвал);		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
	КонецЦикла;
	
	ТабДок.РазмерКолонтитулаСнизу		= 20;
	ТабДок.НижнийКолонтитул.Выводить 	= Истина;
	ТабДок.НижнийКолонтитул.ТекстСлева 	= СформироватьТекстКолонтитула();

	Возврат ТабДок;
	
КонецФункции

Функция СформироватьТабличныйДокументУпаковочныйЛист() Экспорт
	
	Макет = ПолучитьМакет("ПФ_MXL_УпаковочныйЛист");
	
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ОбластьЗаголовок");
	ОбластьШапка 		= Макет.ПолучитьОбласть("ОбластьШапка");
	ОбластьСтрока 		= Макет.ПолучитьОбласть("ОбластьСтрока");
	ОбластьПодвал 		= Макет.ПолучитьОбласть("ОбластьПодвал");

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИспользуемоеИмяФайла = "Упаковочный лист"; 
	ТабДок.ПолеСверху 	= 7;
	ТабДок.ПолеСлева 	= 0;
	ТабДок.ПолеСправа 	= 0;
	ТабДок.ПолеСнизу 	= 20;
	ТабДок.АвтоМасштаб = Истина;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	#Область ТекстЗапроса
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ТЧ.ЗаявкаСсылка КАК ЗаявкаСсылка,
	|	ТЧ.Номенклатура КАК Номенклатура,
	|	ТЧ.Количество КАК Количество,
	|	ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ТЧ.ВесНетто КАК ВесНетто,
	|	ТЧ.Цена КАК Цена,
	|	ТЧ.Описание КАК Описание,
	|	ТЧ.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТЧ
	|ИЗ
	|	&ТЧ КАК ТЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_ТЧ.Описание КАК Описание,
	|	ВТ_ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.Сумма КАК Сумма,
	|	ВТ_ТЧ.ВесНетто КАК ВесНетто,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_ТЧ.Цена КАК Цена,
	|	ЕСТЬNULL(ПриобретениеТоваровУслуг.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Получатель,
	|	ЕСТЬNULL(НоменклатураОборудования.Марка, """") КАК Марка
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|			ПО смартЗаявкаНаГарантийныйРемонт.ДокументПриобретения = ПриобретениеТоваровУслуг.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураОборудования
	|			ПО смартЗаявкаНаГарантийныйРемонт.Оборудование = НоменклатураОборудования.Ссылка
	|		ПО ВТ_ТЧ.ЗаявкаСсылка = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки
	|ИТОГИ ПО
	|	Получатель";
	#КонецОбласти
	
	Запрос.УстановитьПараметр("ТЧ",	ЗапчастиКОтправке.Выгрузить());
	
	РезультатЗапроса	= Запрос.Выполнить();	
	ВыборкаПолучатели	= РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДатаФормирования	= ЭтотОбъект.Дата;
	
	Пока ВыборкаПолучатели.Следующий() Цикл 
				
		ОбластьЗаголовок.Параметры.Номер 		= Формат(ДатаФормирования, "ДФ='dMMyy'");
		
		Сведения 								= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ВыборкаПолучатели.Получатель, ДатаФормирования);
        ОбластьЗаголовок.Параметры.Получатель 	= ?(ЗначениеЗаполнено(Сведения.ПолноеНаименование), Сведения.ПолноеНаименование, ВыборкаПолучатели.Получатель);
		ОбластьЗаголовок.Параметры.ФактическийАдресПолучателя	= Сведения.ФактическийАдрес; 
		ОбластьЗаголовок.Параметры.ТелефонПолучателя 			= Сведения.Телефоны;
        ОбластьЗаголовок.Параметры.КонтактноеЛицоПолучателя		= ВыборкаПолучатели.Получатель.смартОтветственныйЗаЭДО;
		
		ТабДок.Вывести(ОбластьЗаголовок); 
		ТабДок.Вывести(ОбластьШапка);
		
		СтрокаСПодвалом 	= Новый Массив; // Массив для проверки вывода 
		СтрокаСПодвалом.Добавить(ОбластьСтрока); 
		СтрокаСПодвалом.Добавить(ОбластьПодвал);
        
        МаркиОборудования	= Новый Массив;
		Выборка = ВыборкаПолучатели.Выбрать();
		
		Пока Выборка.Следующий() Цикл			
			Если МаркиОборудования.Найти(Выборка.Марка) = Неопределено Тогда
				МаркиОборудования.Добавить(Выборка.Марка);
			КонецЕсли; 						
		КонецЦикла;
		
		ОбластьСтрока.Параметры.НомерПП 	= 1;
		ОбластьСтрока.Параметры.Описание 	= СтрШаблон("Части режущих плоттеров т.м. %1 / Parts for cutting plotters %1", 
											ВРег(СтрСоединить(МаркиОборудования, ","))); 
		ТабДок.Вывести(ОбластьСтрока);

		ТабДок.Вывести(ОбластьПодвал);		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц(); 
	КонецЦикла;
	
	ТабДок.РазмерКолонтитулаСнизу		= 20;
	ТабДок.НижнийКолонтитул.Выводить 	= Истина;
	ТабДок.НижнийКолонтитул.ТекстСлева 	= СформироватьТекстКолонтитула();

	Возврат ТабДок;
	
КонецФункции

