	|	ВТ_ТЧ.КодТНВЭД КАК КодТНВЭД,
	|	ВТ_ТЧ.Количество КАК Количество,
	|	ВТ_ТЧ.Сумма КАК Сумма,
	|	ВТ_ТЧ.ВесНетто КАК ВесНетто,
	|	ВТ_ТЧ.НомерЗаявки КАК НомерЗаявки,
	|	ВТ_ТЧ.Цена КАК Цена,
	|	ЕСТЬNULL(ПриобретениеТоваровУслуг.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Получатель,
	|	ЕСТЬNULL(НоменклатураОборудования.Марка, """") КАК Марка
	|ИЗ
	|	ВТ_ТЧ КАК ВТ_ТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаГарантийныйРемонт КАК смартЗаявкаНаГарантийныйРемонт
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	|			ПО смартЗаявкаНаГарантийныйРемонт.ДокументПриобретения = ПриобретениеТоваровУслуг.Ссылка
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураОборудования
	|			ПО смартЗаявкаНаГарантийныйРемонт.Оборудование = НоменклатураОборудования.Ссылка
	|		ПО ВТ_ТЧ.ЗаявкаСсылка = смартЗаявкаНаГарантийныйРемонт.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерЗаявки
	|ИТОГИ ПО
	|	Получатель";
	
	Запрос.УстановитьПараметр("ТЧ",	ЗапчастиКОтправке.Выгрузить());
	
	РезультатЗапроса	= Запрос.Выполнить();	
	ВыборкаПолучатели	= РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДатаФормирования	= ЭтотОбъект.Дата;
	
	Пока ВыборкаПолучатели.Следующий() Цикл 
				
		ОбластьЗаголовок.Параметры.Номер 		= Формат(ДатаФормирования, "ДФ='dMMyy'");
		ОбластьЗаголовок.Параметры.Дата 		= Формат(ДатаФормирования, "ДФ='dd.MM.yyyy'");
		
		Сведения 								= ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ВыборкаПолучатели.Получатель, ДатаФормирования);
        ОбластьЗаголовок.Параметры.Получатель 	= ?(ЗначениеЗаполнено(Сведения.ПолноеНаименование), Сведения.ПолноеНаименование, ВыборкаПолучатели.Получатель);
		ОбластьЗаголовок.Параметры.ФактическийАдресПолучателя	= Сведения.ФактическийАдрес; 
		ОбластьЗаголовок.Параметры.ТелефонПолучателя 			= Сведения.Телефоны;
        ОбластьЗаголовок.Параметры.КонтактноеЛицоПолучателя		= ВыборкаПолучатели.Получатель.смартОтветственныйЗаЭДО;
		
		ТабДок.Вывести(ОбластьЗаголовок);
		
