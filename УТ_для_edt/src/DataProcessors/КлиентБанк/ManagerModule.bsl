Функция смартПолучитьПредопределенныеДанные(Имя, Организация=Неопределено) 
	Если Организация<>Неопределено Тогда
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ Объект ИЗ РегистрСведений.ДополнительныеСведения ГДЕ Свойство.Имя=&Имя И Значение=ИСТИНА И Объект.смартОрганизацияВладелец = &Организация");
		Запрос.УстановитьПараметр("Организация",Организация);
	Иначе
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 РАЗРЕШЕННЫЕ Объект ИЗ РегистрСведений.ДополнительныеСведения ГДЕ Свойство.Имя=&Имя И Значение=ИСТИНА И Объект.смартОрганизацияВладелец=Значение(Справочник.Организации.ПустаяСсылка)");
	КонецЕсли;
	Запрос.УстановитьПараметр("Имя",Имя);
	
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.Объект;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции 
