Функция смартПроверитьНаличиеЗаказаКлиенту(СтрокаДокумента,ДокументОбъект)
	СтрокаПлатежа=СокрЛП(НайтиНомераОснованияПлатежаНовая(СтрокаДокумента.НазначениеПлатежа));
	СтрокаПлатежа=СтрЗаменить(СтрокаПлатежа,","," ");
	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПлатежа," ");
	МассивНомеров=Новый Массив;
	Н=0;
	ТекстЗаказ="";
	Для каждого СтрЧасть Из ЧастиИмени Цикл
		СтрокаПроверки = СокрЛП(СтрЧасть);
		Длина = СтрДлина(СтрокаПроверки);
		
		Для а = 1 По Длина Цикл
			НомерВСтроке=СтрНайти("0123456789", Сред(СтрокаПроверки, а, 1));
			Если НомерВСтроке = 0 Тогда
				Продолжить;
			иначе
				СтрЧасть=Прав(СтрЧасть,Длина-а+1);//НомерВСтроке поменял на "а"
				//++ #1452 смарт: Фролов 12.09.2023 //Доработка Банк-клиент / переплата от клиента (продолжение задачи 1021)
				//МассивНомеров.Добавить("%"+СтрЧасть+"%");
				СтрЧасть=СтрЗаменить(СтрЧасть,"""","");
				МассивНомеров.Добавить("%"+СтрЧасть+"%"); 
				//-- #1452 смарт: Фролов 12.09.2023
				Н=Н+1;
				ТекстЗаказ=?(ЗначениеЗаполнено(ТекстЗаказ),ТекстЗаказ+" ИЛИ ЗаказКлиента.Номер ПОДОБНО ""%"+СтрЧасть+"%""","ЗаказКлиента.Номер ПОДОБНО ""%"+СтрЧасть+"%""");
				Прервать;
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла; 
	
	//++ смарт:Демичев №1021 30.05.2022((Заказы могут не соответствовать По Контрагенту Организации, тк условия не в скобках
	ТекстЗаказ=?(ЗначениеЗаполнено(ТекстЗаказ),"(" + ТекстЗаказ + ")",ТекстЗаказ);
	
	СписокЗаказов=Новый СписокЗначений;
	
	Если Н>0 И ЗначениеЗаполнено(ТекстЗаказ) Тогда
		ЗапросЗаказ=Новый Запрос;
		ЗапросЗаказ.Текст="ВЫБРАТЬ Первые НомерВывода
		|	ЗаказКлиента.Ссылка КАК Заказ
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		| ЗаказКлиента.Организация = &Организация И
		| ЗаказКлиента.Контрагент = &Контрагент И
		|УсловиеСписок
		|		
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		ЗапросЗаказ.Текст=СтрЗаменить(ЗапросЗаказ.Текст,"НомерВывода",Н);
		ЗапросЗаказ.Текст=СтрЗаменить(ЗапросЗаказ.Текст,"УсловиеСписок",ТекстЗаказ);
		ЗапросЗаказ.УстановитьПараметр("Организация",ДокументОбъект.Организация);
		//++ #1378 смарт: Фролов 17.07.2023 //Не верная хоз. операция при загрузке из банка  
		//ЗапросЗаказ.УстановитьПараметр("Контрагент",ДокументОбъект.Контрагент); 
		Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
			ЗапросЗаказ.УстановитьПараметр("Контрагент",ДокументОбъект.Контрагент);
		Иначе
			Если ЗначениеЗаполнено(СтрокаДокумента.Контрагент) И (ТипЗнч(СтрокаДокумента.Контрагент)=Тип("СправочникСсылка.Контрагенты") 
				ИЛИ ТипЗнч(СтрокаДокумента.Контрагент)=Тип("СправочникСсылка.Организации")) Тогда
				Контрагент=Справочники.Контрагенты.НайтиПоРеквизиту("ИНН",СтрокаДокумента.Контрагент.ИНН);
				Если ЗначениеЗаполнено(Контрагент) Тогда
