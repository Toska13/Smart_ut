                    Продолжить; 
                    //++ смарт:Минаева #1022 22.06.2022 10:08:17
                ИначеЕсли СтрокаТаблицы.Заказ = Неопределено Тогда 
                    Продолжить;
                    //-- смарт:Минаева #1022 22.06.2022 10:08:17
                ИначеЕсли НачалоДня(СтрокаТаблицы.Заказ.Дата) < смартСервер.ПолучитьПрибавитьКДатеКоличествоРабочихДней(НачалоДня(СтрокаДокумента.ДатаПроведения),-1) Тогда
                    ДокументОбъект.ОшибкиЗагрузки = Символы.ПС+Строка(СтрокаТаблицы.Заказ)+" Дата документа основания меньше даты платежа!"; 
                    //Продолжить;
                КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.Заказ) Тогда
					
					СтрокаРасшифровки = ДокументОбъект.РасшифровкаПлатежа.Добавить();
					
					//СуммаСтроки = Мин(РаспределяемаяСумма, СтрокаТаблицы.Сумма);
