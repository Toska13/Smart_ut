Функция ПолучитьПоследнийОплаченныйЗаказПокупателя(Реквизиты) Экспорт
	
	Запрос = Новый Запрос;                         
	Запрос.УстановитьПараметр("ВалютаДокумента", Реквизиты.Валюта);
	Запрос.УстановитьПараметр("Контрагент", Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДата()));

	Если Не ЗначениеЗаполнено(Реквизиты.Партнер) Тогда
		Запрос.УстановитьПараметр("Партнер", Неопределено);
	Иначе
		Запрос.УстановитьПараметр("Партнер", Реквизиты.Партнер);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПартнерПрочиеОтношения", Реквизиты.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеТаможне);
	
	//ДоступныеОрганизации = ДоступныеОрганизацийДляПодбораОстатков(Реквизиты.Организация, ЕстьРасчетыСПоставщиками, ЕстьРасчетыСКлиентами);
   	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаПоПартнерам.КлючАналитики КАК КлючАналитики,
	|	АналитикаПоПартнерам.Организация КАК Организация,
	|	АналитикаПоПартнерам.Партнер КАК Партнер,
	|	АналитикаПоПартнерам.Контрагент КАК Контрагент,
	|	АналитикаПоПартнерам.Договор КАК Договор
	|ПОМЕСТИТЬ АналитикаУчетаПоПартнерамКлюч
	|ИЗ
	|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПоПартнерам
	|ГДЕ
	|	&Партнер <> НЕОПРЕДЕЛЕНО
	|	И АналитикаПоПартнерам.Организация = &Организация
	|	И АналитикаПоПартнерам.Партнер = &Партнер
	|	И АналитикаПоПартнерам.Контрагент = &Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АналитикаПоПартнерам.КлючАналитики,
	|	АналитикаПоПартнерам.Организация,
	|	АналитикаПоПартнерам.Партнер,
	|	АналитикаПоПартнерам.Контрагент,
	|	АналитикаПоПартнерам.Договор
	|ИЗ
	|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПоПартнерам
	|ГДЕ
	|	&Партнер = НЕОПРЕДЕЛЕНО
	|	И АналитикаПоПартнерам.Организация = &Организация
	|	И АналитикаПоПартнерам.Контрагент = &Контрагент
	|	И (&ПартнерПрочиеОтношения
	|				И АналитикаПоПартнерам.Партнер.ПрочиеОтношения
	|			ИЛИ НЕ &ПартнерПрочиеОтношения)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	РасчетыСКлиентамиОбороты.ЗаказКлиента КАК ЗаказКлиента
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Обороты(, &КонецДня, Регистратор, ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента) КАК РасчетыСКлиентамиОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АналитикаУчетаПоПартнерамКлюч КАК АналитикаУчетаПоПартнерамКлюч
	|		ПО РасчетыСКлиентамиОбороты.АналитикаУчетаПоПартнерам = АналитикаУчетаПоПартнерамКлюч.КлючАналитики
	|ГДЕ
	|	РасчетыСКлиентамиОбороты.КОплатеРасход > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	РасчетыСКлиентамиОбороты.Регистратор.Дата УБЫВ";

	
	Результат = Запрос.Выполнить();   
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		мВыборка = Результат.Выбрать();
		мВыборка.Следующий();
		
		Возврат мВыборка.ЗаказКлиента;
		
	КонецЕсли;	
	
КонецФункции 

Функция ПолучитьЗаказСтруктуройТаблицыОстатков(Реквизиты,ЗаказСписок) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", ЗаказСписок);
	Запрос.УстановитьПараметр("ВалютаДокумента", Реквизиты.Валюта);
	Запрос.УстановитьПараметр("Контрагент", Реквизиты.Контрагент);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(ТекущаяДата()));

	Если Не ЗначениеЗаполнено(Реквизиты.Партнер) Тогда
		Запрос.УстановитьПараметр("Партнер", Неопределено);
	Иначе
		Запрос.УстановитьПараметр("Партнер", Реквизиты.Партнер);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПартнерПрочиеОтношения", Реквизиты.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеречислениеТаможне);
	
	//ДоступныеОрганизации = ДоступныеОрганизацийДляПодбораОстатков(Реквизиты.Организация, ЕстьРасчетыСПоставщиками, ЕстьРасчетыСКлиентами);
   	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	
	СтатьяДвиженияДенежныхСредств =
		Справочники.СтатьиДвиженияДенежныхСредств.СтатьяДвиженияДенежныхСредствПоХозяйственнойОперации(Реквизиты.ХозяйственнаяОперация);
	Запрос.УстановитьПараметр("СтатьяДвиженияДенежныхСредств", СтатьяДвиженияДенежныхСредств);

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаПоПартнерам.КлючАналитики КАК КлючАналитики,
	|	АналитикаПоПартнерам.Организация КАК Организация,
	|	АналитикаПоПартнерам.Партнер КАК Партнер,
	|	АналитикаПоПартнерам.Контрагент КАК Контрагент,
	|	АналитикаПоПартнерам.Договор КАК Договор
	|ПОМЕСТИТЬ АналитикаУчетаПоПартнерамКлюч
	|ИЗ
	|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПоПартнерам
	|ГДЕ
	|	&Партнер <> НЕОПРЕДЕЛЕНО
	|	И АналитикаПоПартнерам.Организация = &Организация
	|	И АналитикаПоПартнерам.Партнер = &Партнер
	|	И АналитикаПоПартнерам.Контрагент = &Контрагент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АналитикаПоПартнерам.КлючАналитики,
	|	АналитикаПоПартнерам.Организация,
	|	АналитикаПоПартнерам.Партнер,
	|	АналитикаПоПартнерам.Контрагент,
	|	АналитикаПоПартнерам.Договор
	|ИЗ
	|	РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПоПартнерам
	|ГДЕ
	|	&Партнер = НЕОПРЕДЕЛЕНО
	|	И АналитикаПоПартнерам.Организация = &Организация
	|	И АналитикаПоПартнерам.Контрагент = &Контрагент
	|	И (&ПартнерПрочиеОтношения
	|				И АналитикаПоПартнерам.Партнер.ПрочиеОтношения
	|			ИЛИ НЕ &ПартнерПрочиеОтношения)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КлючАналитики
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетыСКлиентамиОбороты.ЗаказКлиента КАК ЗаказКлиента,
	|	РасчетыСКлиентамиОбороты.Валюта КАК ВалютаВзаиморасчетов,
	|	РасчетыСКлиентамиОбороты.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам
	|ПОМЕСТИТЬ Вт_Заказ
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентами.Обороты(, , Регистратор, ЗаказКлиента В (&Заказ)) КАК РасчетыСКлиентамиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	РасчетыСКлиентамиОбороты.ЗаказКлиента,
	|	РасчетыСКлиентамиОбороты.Валюта,
	|	РасчетыСКлиентамиОбороты.АналитикаУчетаПоПартнерам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вт_Заказ.ЗаказКлиента КАК ЗаказКлиента,
	|	Вт_Заказ.ВалютаВзаиморасчетов КАК ВалютаВзаиморасчетов,
	|	АналитикаУчетаПоПартнерамКлюч.Организация КАК Организация,
	|	АналитикаУчетаПоПартнерамКлюч.Партнер КАК Партнер,
	|	АналитикаУчетаПоПартнерамКлюч.Контрагент КАК Контрагент,
	|	АналитикаУчетаПоПартнерамКлюч.Договор КАК Договор,
	|	&ВалютаДокумента КАК ВалютаДокумента,
	|	Вт_Заказ.ЗаказКлиента.Дата КАК Дата,
	|	Вт_Заказ.ЗаказКлиента.Номер КАК Номер,
	|	Вт_Заказ.ЗаказКлиента.СуммаДокумента КАК Сумма,
	|	Вт_Заказ.ЗаказКлиента.ИдентификаторПлатежа КАК ИдентификаторПлатежа,
	|	ВЫБОР
	|		КОГДА АналитикаУчетаПоПартнерамКлюч.Договор.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ТОГДА АналитикаУчетаПоПартнерамКлюч.Договор.СтатьяДвиженияДенежныхСредств
	|		КОГДА ТИПЗНАЧЕНИЯ(Вт_Заказ.ЗаказКлиента) <> ТИП(Справочник.ДоговорыКонтрагентов)
	|				И ЕСТЬNULL(ВЫРАЗИТЬ(Вт_Заказ.ЗаказКлиента.Соглашение КАК Справочник.СоглашенияСКлиентами).СтатьяДвиженияДенежныхСредств, ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(Вт_Заказ.ЗаказКлиента.Соглашение КАК Справочник.СоглашенияСКлиентами).СтатьяДвиженияДенежныхСредств
	|		ИНАЧЕ &СтатьяДвиженияДенежныхСредств
	|	КОНЕЦ КАК СтатьяДвиженияДенежныхСредств
	|ИЗ
	|	Вт_Заказ КАК Вт_Заказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АналитикаУчетаПоПартнерамКлюч КАК АналитикаУчетаПоПартнерамКлюч
	|		ПО Вт_Заказ.АналитикаУчетаПоПартнерам = АналитикаУчетаПоПартнерамКлюч.КлючАналитики
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Результат = Запрос.Выполнить();   
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		мВыборка = Результат.Выбрать();		
		Возврат мВыборка;
		
	КонецЕсли;	

	
	
КонецФункции	


