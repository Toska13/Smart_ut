					ЗаполнитьЗначенияСвойств(СтрокаРасшифровки, СтрокаТаблицы,, "Сумма");
					
					СтрокаРасшифровки.ОснованиеПлатежа = СтрокаТаблицы.Заказ;
					СтрокаРасшифровки.Заказ = СтрокаТаблицы.Заказ;
					СтрокаРасшифровки.Сумма = РаспределяемаяСумма;
					РаспределяемаяСумма = 0;
					Прервать;
					
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
	КонецЕсли;
	
	//Если РаспределяемаяСумма > 0 Тогда // В любом случае нам нужно распределить РаспределяемаяСумма. Ищем ближайший ОПЛАЧЕННЫЙ Заказ
