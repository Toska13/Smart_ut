
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОбъектыНазначения") Тогда
		
		Объект.СсылкаНаОбъект = Параметры.ОбъектыНазначения[0];
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.СтараяНоменклатура) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать старую номенклатуру");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.СсылкаНаОбъект) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать новую номенклатуру");
		Возврат;
	КонецЕсли;

	Если Объект.СсылкаНаОбъект = Объект.СтараяНоменклатура Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Новая номенклатура не должна равняться старой");
		Возврат;
	КонецЕсли;
	
	Если Объект.ЗаказыНаСборку.Количество() > 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПередСозданиемДокументовЗавершение", ЭтотОбъект, );
		ТекстВопроса = НСтр("ru = 'Перезаполнить таблицу ""Заказы на сборку""?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
	Иначе	
		ВыполнитьОбработкуСервер();		
	КонецЕсли;

	Если Объект.ЗаказыНаСборку.Количество() > 0 Тогда
		ПечатьСборка(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьСборка(Команда)
	
	Если Объект.ЗаказыНаСборку.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не обнаружены данные для печати");
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = СформироватьТабличныйДокументСборкаСервер();
	
	СинонимМакета = "Сборка товаров";
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("смартСборкаТоваров");    
    КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
    КоллекцияПечатныхФорм[0].Экземпляров = 1;
    КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;
	КоллекцияПечатныхФорм[0].ИмяФайлаПечатнойФормы = СинонимМакета;
	
	ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма, СинонимМакета);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьПриказОбУтверждении(Команда)
	
	Если Объект.ЗаказыНаСборку.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не обнаружены данные для печати");
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = СформироватьТабличныйДокументПриказОбУтвержденииСервер();
	
	СинонимМакета = "Приказ об утверждении новой номенклатуры";
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("смартПриказОбУтвержденииНовойНоменклатуры");    
    КоллекцияПечатныхФорм[0].ТабличныйДокумент = ТабличныйДокумент; 
    КоллекцияПечатныхФорм[0].Экземпляров = 1;
    КоллекцияПечатныхФорм[0].СинонимМакета = СинонимМакета;
	КоллекцияПечатныхФорм[0].ИмяФайлаПечатнойФормы = СинонимМакета;
	
	ПечатьДокументов(КоллекцияПечатныхФорм, Неопределено, ЭтаФорма, СинонимМакета);
	
КонецПроцедуры


&НаКлиенте
Процедура ВопросПередСозданиемДокументовЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ВыполнитьОбработкуСервер();		
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОбработкуСервер()
	
	Объект.ЗаказыНаСборку.Очистить();
	
	Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение;
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	СборкаТоваров 		= Перечисления.ХозяйственныеОперации.СборкаТоваров;
	КВыполнению 		= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	Требуется 			= Перечисления.ВариантыОбеспечения.Требуется;
	ПродажаОблагаетсяНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	РазделенаПоЗаказамИНакладным = Перечисления.ВариантыПриемкиТоваров.РазделенаПоЗаказамИНакладным;
	Отгрузить 			= Перечисления.ВариантыОбеспечения.Отгрузить;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого СтрокаОстаток Из Объект.Остатки Цикл
		
		Количество = СтрокаОстаток.Доступно;
		Если Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументЗаказ = Документы.ЗаказНаСборку.СоздатьДокумент();
		
		ТекДата = ТекущаяДата();
		
		ДокументЗаказ.Дата 				= ТекДата;
		ДокументЗаказ.Организация 		= Организация;
		ДокументЗаказ.Склад 			= СтрокаОстаток.Склад;
		ДокументЗаказ.Ответственный 	= ТекущийПользователь;
		ДокументЗаказ.Статус 					= КВыполнению;
		ДокументЗаказ.ХозяйственнаяОперация 	= СборкаТоваров;
		ДокументЗаказ.Номенклатура 				= Объект.СсылкаНаОбъект;
		ДокументЗаказ.Количество 				= Количество;
		ДокументЗаказ.КоличествоУпаковок		= Количество;
		ДокументЗаказ.НачалоСборкиРазборки 		= ТекДата;
		ДокументЗаказ.ОкончаниеСборкиРазборки 	= ТекДата;
		ДокументЗаказ.ВариантОбеспечения 		= Требуется;
		ДокументЗаказ.СборкаПодДеятельность 	= ПродажаОблагаетсяНДС;
		ДокументЗаказ.ВариантПриемкиТоваров 	= РазделенаПоЗаказамИНакладным;
				
		ДокументЗаказ.Комментарий = "#Создан автоматически";
		
		НоваяСтрока = ДокументЗаказ.Товары.Добавить();
		НоваяСтрока.ВариантОбеспечения = Отгрузить;
		НоваяСтрока.Количество = Количество;
		НоваяСтрока.КоличествоУпаковок = Количество;
		НоваяСтрока.Номенклатура = Объект.СтараяНоменклатура;
		
		Попытка
			НачатьТранзакцию();
			//Сообщить("1 - " + ПривилегированныйРежим());
			ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение);
			НоваяСтрока = Объект.ЗаказыНаСборку.Добавить();
			
			ДокументСборкаТоваров = СоздатьДокументСборкаТоваров(ДокументЗаказ.Ссылка);
			
			Если ТипЗнч(ДокументСборкаТоваров) = Тип("ДокументСсылка.СборкаТоваров") 
				И ДокументСборкаТоваров.Проведен Тогда				
				
				//++ #Б1074 смарт: Шляпников 08.10.2024 / Изменение функционала обработки Комплектация номенклатуры (ИТСМ 1525)
				// Для ордерных складов создать приходный и расходный ордера
				//Если СтрокаОстаток.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке Тогда
				//	ДокументРасходныйОрдер = СоздатьРасходныйОрдерНаТовары(ДокументЗаказ.Ссылка);					
				//КонецЕсли;
				//
				//Если СтрокаОстаток.Склад.ИспользоватьОрдернуюСхемуПриПоступлении Тогда
				//	ДокументПриходныйОрдер = СоздатьПриходныйОрдерНаТовары(ДокументЗаказ.Ссылка);				
				//КонецЕсли;
				//-- #Б1074 смарт: Шляпников 08.10.2024
				
			КонецЕсли;
			
			НоваяСтрока.Документ = ДокументЗаказ.Ссылка;
			НоваяСтрока.СборкаТоваров = ДокументСборкаТоваров;
			//++ #Б1074 смарт: Шляпников 08.10.2024 / Изменение функционала обработки Комплектация номенклатуры (ИТСМ 1525)
			//НоваяСтрока.РасходныйОрдер = ДокументРасходныйОрдер;
			//НоваяСтрока.ПриходныйОрдер = ДокументПриходныйОрдер;
			//-- #Б1074 смарт: Шляпников 08.10.2024
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			//ДокументЗаказ.Записать(РежимЗаписиДокумента.Запись);
			//СинонимДокумента = ДокументЗаказ.Метаданные().Синоним;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось обработать склад """ + СтрокаОстаток.Склад + """ по причине
			|" + ОписаниеОшибки());
			ОтменитьТранзакцию();
		КонецПопытки;

	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаЗаказыНаСборку;
	
КонецПроцедуры

&НаСервере
Функция СоздатьДокументСборкаТоваров(ЗаказНаСборку)
	
	Если НЕ ЗаказНаСборку.Проведен Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументСборка = Документы.СборкаТоваров.СоздатьДокумент();
	
	МассивЗаказов = Новый Массив;
	МассивЗаказов.Добавить(ЗаказНаСборку);

	ДанныеЗаполнения = Новый Структура;
	ПараметрыОткрытия = СозданиеНаОснованииУТВызовСервера.ПараметрыОткрытияФормыНакладнойНаОснованииЗаказа(МассивЗаказов, "СборкаТоваров");
	ДанныеЗаполнения = ПараметрыОткрытия.ПараметрыФормы.Основание;
	
	ДокументСборка.Заполнить(ДанныеЗаполнения);

	ДокументСборка.Дата = ТекущаяДата();
	ДокументСборка.Ответственный = Пользователи.ТекущийПользователь();
	ДокументСборка.Комментарий = ЗаказНаСборку.Комментарий;
	                                  
	Попытка
		//Сообщить("2 - " + ПривилегированныйРежим());
		ДокументСборка.Записать(РежимЗаписиДокумента.Проведение);
		
		//++ #Б1074 смарт: Шляпников 08.10.2024 / Изменение функционала обработки Комплектация номенклатуры (ИТСМ 1525)
		ОтправитьПочтовоеУведомлениеПоЗаказуНаСборку(ЗаказНаСборку);
		//-- #Б1074 смарт: Шляпников 08.10.2024

	Исключение
		СинонимДокумента = ДокументСборка.Метаданные().Синоним;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось провести документ """ + СинонимДокумента + """ по причине
		|" + ОписаниеОшибки());
		
		//ДокументСборка.Записать(РежимЗаписиДокумента.Запись);
		
	КонецПопытки;
	
	Возврат ДокументСборка.Ссылка;
	
КонецФункции

&НаСервере
Функция СоздатьРасходныйОрдерНаТовары(ЗаказНаСборку)
	
	СтруктураПараметровСозданияРасходныхОрдеров = СкладыСервер.ПараметрыПереоформленияРасходныхОрдеров();
	СтруктураПараметровСозданияРасходныхОрдеров.ЗонаОтгрузки = Справочники.СкладскиеЯчейки.ПустаяСсылка();
	СтруктураПараметровСозданияРасходныхОрдеров.Склад = ЗаказНаСборку.Склад;
	СтруктураПараметровСозданияРасходныхОрдеров.ЗаданиеНаПеревозку = Неопределено;
	СтруктураПараметровСозданияРасходныхОрдеров.РаспоряженияНаОтгрузку.Добавить(ЗаказНаСборку);
	СтруктураПараметровСозданияРасходныхОрдеров.Получатель = ЗаказНаСборку.Склад; //ЗаказНаСборку.Подразделение;
	
	//Сообщить("3 - " + ПривилегированныйРежим());

	СтруктураВозврат = СкладыСервер.ПереоформитьРасходныеОрдера(СтруктураПараметровСозданияРасходныхОрдеров);
	
	ОформленныеОрдера = СтруктураВозврат.ОформленныеОрдера;
	Для Каждого СтрОрдер Из ОформленныеОрдера Цикл
		
		Если ТипЗнч(СтрОрдер.РасходныйОрдер) = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			НовыйДокумент = СтрОрдер.РасходныйОрдер.ПолучитьОбъект();
			НовыйДокумент.Комментарий 	= ЗаказНаСборку.Комментарий;
			//Если НЕ ПраваПользователяПовтИсп.ВзятиеРасходногоОрдераВРаботу() Тогда
			//	НовыйДокумент.Статус = Перечисления.СтатусыРасходныхОрдеров.Подготовлено;
			//Иначе
				НовыйДокумент.Статус = Перечисления.СтатусыРасходныхОрдеров.Отгружен;
			//КонецЕсли;
			НовыйДокумент.Дата 			= ЗаказНаСборку.Дата;
			НовыйДокумент.ДатаОтгрузки 	= ЗаказНаСборку.ОкончаниеСборкиРазборки;
			
			НовыйДокумент.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
			НовыйДокумент.ДополнительныеСвойства.Вставить("смартПроверятьНаличиеРолиВзятиеРасходногоОрдераВРаботу", Ложь);
			
			Для Каждого СтрокаОтгрузить Из НовыйДокумент.ОтгружаемыеТовары Цикл
				СтрокаОтгрузить.Действие = Перечисления.ДействияСоСтрокамиОрдеровНаОтгрузку.Отгрузить;
			КонецЦикла;
			
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				
				Возврат НовыйДокумент.Ссылка;
			Исключение
				СинонимДокумента = НовыйДокумент.Метаданные().Синоним;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать документ """ + СинонимДокумента + """ для склада " + ЗаказНаСборку.Склад + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
		
КонецФункции

&НаСервере
Функция СоздатьПриходныйОрдерНаТовары(ЗаказНаСборку)
	
	ЗакрыватьГрафикПоступления = Истина;
	
	Основание = Новый Структура;
	Основание.Вставить("Распоряжение",               ЗаказНаСборку);
	Основание.Вставить("Отправитель",                ЗаказНаСборку.Склад);
	Основание.Вставить("ЗакрыватьГрафикПоступления", ЗакрыватьГрафикПоступления);
	Основание.Вставить("Склад",                      ЗаказНаСборку.Склад);
	Основание.Вставить("СкладскаяОперация", 		 Перечисления.СкладскиеОперации.ПриемкаСобранныхКомплектов);
	Основание.Вставить("ДатаВходящегоДокумента",     ЗаказНаСборку.Дата);
	Основание.Вставить("НомерВходящегоДокумента",    ЗаказНаСборку.Номер);
	Основание.Вставить("ДатаПоступления",            ЗаказНаСборку.ОкончаниеСборкиРазборки);
	Основание.Вставить("ХозяйственнаяОперация",      Перечисления.ХозяйственныеОперации.СборкаТоваров);
	
	ДокументПриходныйОрдер = Документы.ПриходныйОрдерНаТовары.СоздатьДокумент();
	ДокументПриходныйОрдер.Заполнить(Основание);
	
	// Заполнение количества, т.к. типовой алгоритм заполнения не хочет сделать это сам
	Для Каждого СтрокаТовар Из ДокументПриходныйОрдер.Товары Цикл
		
		Если ЗначениеЗаполнено(СтрокаТовар.Количество) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТовар.Количество = ЗаказНаСборку.Количество;
		СтрокаТовар.КоличествоУпаковок = ЗаказНаСборку.КоличествоУпаковок;

	КонецЦикла;
	ДокументПриходныйОрдер.Статус = Перечисления.СтатусыПриходныхОрдеров.Принят;	
	ДокументПриходныйОрдер.Дата = ЗаказНаСборку.Дата;
	ДокументПриходныйОрдер.Комментарий = ЗаказНаСборку.Комментарий;
	ДокументПриходныйОрдер.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	//Сообщить("4 - " + ПривилегированныйРежим());
	ДокументПриходныйОрдер.Записать(РежимЗаписиДокумента.Проведение);

	Возврат ДокументПриходныйОрдер.Ссылка;
	
КонецФункции

//++ #Б1074 смарт: Шляпников 08.10.2024 / Изменение функционала обработки Комплектация номенклатуры (ИТСМ 1525)
&НаСервере
Процедура ОтправитьПочтовоеУведомлениеПоЗаказуНаСборку(ЗаказНаСборку)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.смартРабочаяПочта КАК АдресПочты
	|ИЗ
	|	Справочник.Склады КАК Склады
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Склады.ТекущийОтветственный = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Склады.Ссылка = &Склад
	|	И НЕ Склады.ТекущийОтветственный = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Склад", ЗаказНаСборку.Склад);
	
	АдресЭлектроннойПочтыПолучателя = "";
	
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		АдресЭлектроннойПочтыПолучателя = Выборка.АдресПочты;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресЭлектроннойПочтыПолучателя) Тогда
		АдресЭлектроннойПочтыПолучателя = смартОбщегоНазначенияСКэш.ПолучитьАдресПользователяДляОповещенияОЗаказеНаСборку();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(АдресЭлектроннойПочтыПолучателя) Тогда
		ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, 
			СтрШаблон("Не удалось отправить письмо, о выводе номенклатуры из обращения %1 %2 %1 Для заказа %3 не заполнена почта получателя", Символы.ПС, ОписаниеОшибки(), ЗаказНаСборку));
		Возврат;
	КонецЕсли;
	
	// смарт: почта
	ДанныеДляОтправки = Новый Структура("Кому, Копии, Тема, Тело, ТипТекста, Важность",
										 АдресЭлектроннойПочтыПолучателя, 
										 ,
										 "Внимание! Номенклатуры выводится из обращения.",
										 СтрШаблон("Необходимо сформировать ордера по документу: %1 ссылка: %2", ЗаказНаСборку, ПолучитьНавигационнуюСсылку(ЗаказНаСборку)),
										 ТипТекстаПочтовогоСообщения.ПростойТекст,
										 ВажностьИнтернетПочтовогоСообщения.Высокая);
										 
	Попытка
											 
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), ДанныеДляОтправки); 		
		
	Исключение
		
		ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка,,, 
			"Не удалось отправить письмо, о выводе номенклатуры из обращения "  + Символы.ПС + ОписаниеОшибки());

	КонецПопытки;
	
КонецПроцедуры

#Область Остатки

&НаКлиенте
Процедура ПолучитьОстатки(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.СтараяНоменклатура) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо указать старую номенклатуру");
		Возврат;
	КонецЕсли;
	
	Если Объект.Остатки.Количество() > 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗаполнениемТабличнойЧастиЗавершение", ЭтотОбъект, );
		ТекстВопроса = НСтр("ru = 'Перезаполнить таблицу ""Остатки""?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		
	Иначе	
		ЗаполнитьОстаткиНаСервере();		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗаполнениемТабличнойЧастиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ЗаполнитьОстаткиНаСервере();		
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
		
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("ЕдиницыКоличества", 0);
	Запрос.УстановитьПараметр("П", Объект.СтараяНоменклатура);
	
	УстановитьПривилегированныйРежим(Истина);
	Объект.Остатки.Загрузить(Запрос.Выполнить().Выгрузить());
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

