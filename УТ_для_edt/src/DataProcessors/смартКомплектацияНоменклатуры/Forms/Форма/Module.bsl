	|				КОГДА Набор.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Площадь)
	|						И Набор.Номенклатура.ОбъемИспользовать
	|						И ЕСТЬNULL(Набор.Номенклатура.ЕдиницаИзмерения.Знаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ПлощадьЕдиницаИзмерения.Числитель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ПлощадьЧислитель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ПлощадьЗнаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЗнаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
	|					ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(Набор.Номенклатура.ЕдиницаИзмерения.Числитель / Набор.Номенклатура.ЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(Набор.Номенклатура.ПлощадьЕдиницаИзмерения.Числитель / Набор.Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(Набор.Номенклатура.ПлощадьЧислитель / Набор.Номенклатура.ПлощадьЗнаменатель КАК ЧИСЛО(15, 7))) * (Набор.Номенклатура.ОбъемЧислитель / Набор.Номенклатура.ОбъемЗнаменатель) * (Набор.Номенклатура.ОбъемЕдиницаИзмерения.Числитель / Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
	|				КОГДА Набор.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Длина)
	|						И Набор.Номенклатура.ОбъемИспользовать
	|						И ЕСТЬNULL(Набор.Номенклатура.ЕдиницаИзмерения.Знаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ДлинаЕдиницаИзмерения.Числитель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ДлинаЕдиницаИзмерения.Знаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ДлинаЧислитель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ДлинаЗнаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЗнаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
	|					ТОГДА ВЫРАЗИТЬ((ВЫРАЗИТЬ((ВЫРАЗИТЬ(Набор.Номенклатура.ЕдиницаИзмерения.Числитель / Набор.Номенклатура.ЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(Набор.Номенклатура.ДлинаЕдиницаИзмерения.Числитель / Набор.Номенклатура.ДлинаЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) / (ВЫРАЗИТЬ(Набор.Номенклатура.ДлинаЧислитель / Набор.Номенклатура.ДлинаЗнаменатель КАК ЧИСЛО(15, 7))) * (Набор.Номенклатура.ОбъемЧислитель / Набор.Номенклатура.ОбъемЗнаменатель) * (Набор.Номенклатура.ОбъемЕдиницаИзмерения.Числитель / Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
	|				КОГДА Набор.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Упаковка)
	|						И ЕСТЬNULL(Набор.Номенклатура.ЕдиницаИзмерения.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
	|					ТОГДА ВЫРАЗИТЬ(Набор.Номенклатура.ЕдиницаИзмерения.Объем * Набор.Номенклатура.ЕдиницаИзмерения.ОбъемЕдиницаИзмерения.Числитель / Набор.Номенклатура.ЕдиницаИзмерения.ОбъемЕдиницаИзмерения.Знаменатель КАК ЧИСЛО(15, 7))
	|				КОГДА (Набор.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.КоличествоШтук)
	|						ИЛИ Набор.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.ПустаяСсылка)
	|						ИЛИ ЕСТЬNULL(Набор.Номенклатура.ЕдиницаИзмерения.Ссылка, ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка))
	|						И Набор.Номенклатура.ОбъемИспользовать
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЗнаменатель, 0) <> 0
	|						И ЕСТЬNULL(Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель, 0) <> 0
	|					ТОГДА ВЫРАЗИТЬ(Набор.Номенклатура.ОбъемЧислитель / Набор.Номенклатура.ОбъемЗнаменатель * (Набор.Номенклатура.ОбъемЕдиницаИзмерения.Числитель / Набор.Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель) КАК ЧИСЛО(15, 7))
	|				ИНАЧЕ 0
	|			КОНЕЦ / (ВЫРАЗИТЬ(1 КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7))) КАК Объем,
	|	МАКСИМУМ(Набор.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаХранения,
	|	МАКСИМУМ(Набор.Номенклатура.ЕдиницаДляОтчетов) КАК ЕдиницаДляОтчетов,
	|	МАКСИМУМ(Набор.Номенклатура.КоэффициентЕдиницыДляОтчетов) КАК КоэффициентЕдиницыДляОтчетов,
	|	СУММА(Набор.ВНаличии) КАК ВНаличии,
	|	СУММА(Набор.ПриходОсновной) КАК ПриходОсновной,
	|	СУММА(Набор.РасходОсновной) КАК РасходОсновной,
	|	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) КАК ВРезервеСоСкладаИПодЗаказ,
	|	СУММА(Набор.ВРезервеСоСкладаИПодЗаказ) + СУММА(Набор.ВРезервеГрафика) КАК ВРезерве,
	|	СУММА(Набор.КОтгрузке) КАК Котгрузке,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Набор.Номенклатура) КАК НоменклатураПредставление,
	|	Набор.Номенклатура.Артикул КАК НоменклатураАртикул,
	|	Набор.Номенклатура.ЕдиницаДляОтчетов КАК НоменклатураЕдиницаДляОтчетов,
	|	Набор.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	Набор.Номенклатура.Наименование КАК НоменклатураНаименование,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Набор.Склад) КАК СкладПредставление,
	|	Набор.Склад.Наименование КАК СкладНаименование,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Набор.Характеристика) КАК ХарактеристикаПредставление,
	|	Набор.Характеристика.Наименование КАК ХарактеристикаНаименование
	|ПОМЕСТИТЬ ВТ_Основной
	|ИЗ
	|	(ВЫБРАТЬ
	|		Таблица.Номенклатура КАК Номенклатура,
	|		Таблица.Характеристика КАК Характеристика,
	|		Таблица.Склад КАК Склад,
	|		Таблица.ВНаличии КАК ВНаличии,
	|		0 КАК ПриходОсновной,
	|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада + Таблица.КОтгрузке КАК РасходОсновной,
	|		Таблица.ВРезервеПодЗаказ + Таблица.ВРезервеСоСклада КАК ВРезервеСоСкладаИПодЗаказ,
	|		0 КАК ВРезервеГрафика,
	|		Таблица.КОтгрузке КАК КОтгрузке
	|	ИЗ
	|		ВтСвободныеОстатки КАК Таблица
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Таблица.Номенклатура,
	|		Таблица.Характеристика,
	|		Таблица.Склад,
	|		0,
	|		Таблица.КоличествоИзЗаказовОстаток,
	|		0,
	|		0,
	|		0,
	|		0
	|	ИЗ
	|		РегистрНакопления.ГрафикПоступленияТоваров.Остатки(, Номенклатура В ИЕРАРХИИ (&П)) КАК Таблица
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Таблица.Номенклатура,
	|		Таблица.Характеристика,
	|		Таблица.Склад,
	|		0,
	|		0,
	|		Таблица.КоличествоИзЗаказовОстаток,
	|		0,
	|		0,
	|		0
	|	ИЗ
