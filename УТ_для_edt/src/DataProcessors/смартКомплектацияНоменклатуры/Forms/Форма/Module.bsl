	|		0,
	|		0,
	|		0,
	|		0,
	|		-Таблица.Количество,
	|		0
	|	ИЗ
	|		РегистрСведений.ДоступныеОстаткиПланируемыхПоступлений КАК Таблица
	|	ГДЕ
	|		Таблица.Количество < 0
	|		И Таблица.ДатаДоступности = ДАТАВРЕМЯ(1, 1, 1)
	|		И Таблица.Номенклатура В ИЕРАРХИИ(&П)) КАК Набор
	|
	|СГРУППИРОВАТЬ ПО
	|	Набор.Номенклатура,
	|	Набор.Характеристика,
	|	Набор.Склад,
	|	Набор.Номенклатура.Артикул,
	|	Набор.Номенклатура.ЕдиницаДляОтчетов,
	|	Набор.Номенклатура.ЕдиницаИзмерения,
	|	Набор.Номенклатура.Наименование,
	|	Набор.Склад.Наименование,
	|	Набор.Характеристика.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Основной.Номенклатура КАК Номенклатура,
	|	ВТ_Основной.Склад КАК Склад,
	|	ВТ_Основной.ВНаличии КАК ВНаличии,
	|	ВЫБОР
	|		КОГДА &ЕдиницыКоличества = 0
	|			ТОГДА ВТ_Основной.ВНаличии - ВТ_Основной.ВРезерве - ВТ_Основной.Котгрузке
	|		КОГДА &ЕдиницыКоличества = 1
	|			ТОГДА (ВТ_Основной.ВНаличии - ВТ_Основной.ВРезерве - ВТ_Основной.Котгрузке) / ВТ_Основной.КоэффициентЕдиницыДляОтчетов
	|	КОНЕЦ КАК Доступно,
	|	ВТ_Основной.ВРезерве КАК ВРезерве,
	|	ВТ_Основной.Котгрузке КАК КОтгрузке
	|ИЗ
	|	ВТ_Основной КАК ВТ_Основной
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВЫБОР
	|					КОГДА &ЕдиницыКоличества = 0
	|						ТОГДА ВТ_Основной.ВНаличии - ВТ_Основной.ВРезерве - ВТ_Основной.Котгрузке
	|					КОГДА &ЕдиницыКоличества = 1
	|						ТОГДА (ВТ_Основной.ВНаличии - ВТ_Основной.ВРезерве - ВТ_Основной.Котгрузке) / ВТ_Основной.КоэффициентЕдиницыДляОтчетов
	|				КОНЕЦ <> 0
	|				ТОГДА ИСТИНА
	|			КОГДА ВТ_Основной.ВРезерве <> 0
	|				ТОГДА ИСТИНА
	|			КОГДА ВТ_Основной.Котгрузке <> 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Основной.Склад.Наименование";
	
	Возврат Текст;
	
