КонецФункции

Функция ТолькоЦифры(ВхСтрока)
	
	ВыхСтрока="";

	Для п = 1 По СтрДлина(ВхСтрока) Цикл

		Симв = Сред(ВхСтрока, п, 1);
		Если Симв >= "0" И Симв <= "9" Тогда
			ВыхСтрока = ВыхСтрока+Симв;
		КонецЕсли;

	КонецЦикла;

	Возврат ВыхСтрока;
   
КонецФункции

Функция ПроверитьНаличиеДокумента(НомерЗаявки, ДатаПисем)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	смартЗаявкаНаРемонтныеРаботы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартЗаявкаНаРемонтныеРаботы КАК смартЗаявкаНаРемонтныеРаботы
	|ГДЕ
	|	смартЗаявкаНаРемонтныеРаботы.Номер = &Номер
	|	И НАЧАЛОПЕРИОДА(смартЗаявкаНаРемонтныеРаботы.Дата, ГОД) = &ТекущийГод";
	
	Запрос.УстановитьПараметр("Номер", НомерЗаявки);
	Запрос.УстановитьПараметр("ТекущийГод", НачалоГода(ДатаПисем));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой()

КонецФункции

Функция СоздатьДокументЗаявкаНаРемонтныеРаботы(ПараметрыЗаполнения, ДатаПисем, Организация)
	
	ДатаДокумента = ТекущаяДата();
	
	Если НачалоДня(ДатаДокумента) <> НачалоДня(ДатаПисем) Тогда
		ДатаДокумента = ДатаПисем;
	КонецЕсли;
	
	НовыйДокумент = Документы.смартЗаявкаНаРемонтныеРаботы.СоздатьДокумент();
	НовыйДокумент.Организация 	= Организация;
	НовыйДокумент.Дата 			= ДатаДокумента;
	НовыйДокумент.Номер 		= ПараметрыЗаполнения.Номер;
	НовыйДокумент.Контрагент 	= ПараметрыЗаполнения.Контрагент;
	НовыйДокумент.Партнер 		= НовыйДокумент.Контрагент.Партнер;
	НовыйДокумент.Комментарий 	= "#Загружено из электронной почты";
	НовыйДокумент.Представительство = ПараметрыЗаполнения.Представительство;
	
	//++ #Б-3478 смарт: Фролов 02.06.2025 //Загрузка заявок на ремонтные работы с учетом квалификаций инженеров СЦ,
	//НовыйДокумент.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка;
	Если НовыйДокумент.Представительство = Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение Тогда;
		
		НовыйДокумент.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.НоваяЗаявка;
		
	Иначе
		
		НовыйДокумент.Статус = Перечисления.смартСтатусыЗаявокНаРемонтныеРаботы.ОтправленаВПредставительство;
	
	КонецЕсли;
	//-- #Б-3478 смарт: Фролов 02.06.2025
	
	НовыйДокумент.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	АдресВыездаИзПисьма = ?(ЗначениеЗаполнено(ПараметрыЗаполнения.ГородИзПисьма), ПараметрыЗаполнения.ГородИзПисьма + ", ", "") + ПараметрыЗаполнения.АдресИзПисьма;
	НовыйДокумент.АдресВыезда = АдресВыездаИзПисьма;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.Контрагент) Тогда
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.ИНН) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "ИНН: " + ПараметрыЗаполнения.ИНН;
													
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.КонтрагентИзПисьма) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Наименование контрагента: " + ПараметрыЗаполнения.КонтрагентИзПисьма;
													
		КонецЕсли;

	КонецЕсли;	
	
	// Контактные лица
	Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.КонтактноеЛицо) Тогда
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.КонтактноеЛицоИзПисьма) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Контактное лицо: " + ПараметрыЗаполнения.КонтактноеЛицоИзПисьма;
													
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = НовыйДокумент.КонтактныеЛица.Добавить();
		НоваяСтрока.КонтактноеЛицо = ПараметрыЗаполнения.КонтактноеЛицо;
		
		СтруктураДанныеКонтактногоЛица = НовыйДокумент.ПолучитьДанныеКонтактногоЛица(НоваяСтрока.КонтактноеЛицо);
		НоваяСтрока.АдресЭПКонтактногоЛица = СтруктураДанныеКонтактногоЛица.ЭлПочта;
		НоваяСтрока.ТелефонКонтактногоЛица = СтруктураДанныеКонтактногоЛица.Телефон;
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.АдресЭПКонтактногоЛица) 
			И НоваяСтрока.АдресЭПКонтактногоЛица <> ПараметрыЗаполнения.АдресЭПКонтактногоЛица Тогда
			
			НоваяСтрока.АдресЭПКонтактногоЛица = ПараметрыЗаполнения.АдресЭПКонтактногоЛица;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.ТелефонКонтактногоЛица) 
			И НоваяСтрока.ТелефонКонтактногоЛица <> ПараметрыЗаполнения.ТелефонКонтактногоЛица Тогда
			
			НоваяСтрока.ТелефонКонтактногоЛица = ПараметрыЗаполнения.ТелефонКонтактногоЛица;
			
		КонецЕсли;
		
		Если ПараметрыЗаполнения.КонтактноеЛицо.Наименование <> ПараметрыЗаполнения.КонтактноеЛицоИзПисьма  Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Контактное лицо: " + ПараметрыЗаполнения.КонтактноеЛицоИзПисьма;

		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.АдресЭПКонтактногоЛица) 
		И ЗначениеЗаполнено(ПараметрыЗаполнения.АдресЭПИзПисьма) Тогда
		
		НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
												+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
												+ "E-mail контактного лица: " + ПараметрыЗаполнения.АдресЭПИзПисьма;

	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.ТелефонКонтактногоЛица) 
		И ЗначениеЗаполнено(ПараметрыЗаполнения.ТелефонИзПисьма) Тогда
		
		НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
												+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
												+ "Телефон для связи и получения sms-уведомления контактного лица: " + ПараметрыЗаполнения.ТелефонИзПисьма;
												
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.ОборудованиеКлиентов) Тогда
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения.ОборудованиеКлиентовИзПисьма) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Полное название оборудования: " + ПараметрыЗаполнения.ОборудованиеКлиентовИзПисьма;
													
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = НовыйДокумент.Оборудование.Добавить();
		НоваяСтрока.ОборудованиеКлиентов = ПараметрыЗаполнения.ОборудованиеКлиентов;
		НоваяСтрока.Серия = ПараметрыЗаполнения.Серия;
		
		СтруктураВозврата = НовыйДокумент.ПолучитьДанныеПоСерии(НоваяСтрока.Серия);
		ОсновнаяНоменклатура = ПолучитьНоменклатуруОборудования(ПараметрыЗаполнения.ОборудованиеКлиентов);
		Если ЗначениеЗаполнено(ОсновнаяНоменклатура) Тогда
			 НоваяСтрока.Оборудование = ОсновнаяНоменклатура;
		Иначе
			НоваяСтрока.Оборудование = СтруктураВозврата.Номенклатура;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(НоваяСтрока.Оборудование) Тогда
			НоваяСтрока.Оборудование = Справочники.Номенклатура.НайтиПоНаименованию("Не определена (для заявок на ремонт)", Истина);
		КонецЕсли;
		
		НоваяСтрока.ДатаОтгрузки            = СтруктураВозврата.ДатаОтгрузки;
		НоваяСтрока.ТипЧернилОборудование 				= ПараметрыЗаполнения.ТипЧернил;
		
		НоваяСтрока.РастровыйПроцессор 		= ПараметрыЗаполнения.РастровыйПроцессор;
		НоваяСтрока.КонфигурацияЧернил 		= ПараметрыЗаполнения.КонфигурацияЧернил;
		
		Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.Контрагент) И ЗначениеЗаполнено(СтруктураВозврата.Контрагент) Тогда 
			НовыйДокумент.Контрагент = СтруктураВозврата.Контрагент;
			НовыйДокумент.Партнер    = НовыйДокумент.Контрагент.Партнер;
		КонецЕсли;
			
		Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.Серия)
			И ЗначениеЗаполнено(ПараметрыЗаполнения.СерияИзПисьма) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Серийный номер оборудования: " + ПараметрыЗаполнения.СерияИзПисьма;

		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ПараметрыЗаполнения.ТипЧернил)
			И ЗначениеЗаполнено(ПараметрыЗаполнения.ТипЧернилИзПисьма) Тогда
			
			НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования 
													+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
													+ "Марка используемых чернил: " + ПараметрыЗаполнения.ТипЧернилИзПисьма;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗаполнения.НаличиеГарантии) Тогда
		
		Если ВРег(ПараметрыЗаполнения.НаличиеГарантии) = "ДА" Тогда
			
			НомерЗаявкиПНР = "";
			
			Если СрокГарантииИстек(ПараметрыЗаполнения, НомерЗаявкиПНР) Тогда
				
				НовыйДокумент.ВидГарантии = Перечисления.смартВидыГарантии.Платная;
				НовыйДокумент.ДанныеИзПисьмаОснования = НовыйДокумент.ДанныеИзПисьмаОснования
														+ ?(ЗначениеЗаполнено(НовыйДокумент.ДанныеИзПисьмаОснования), Символы.ПС, "")
														+ "В форме указали, что случай гарантийный, но по данным заявки на ПНР " + НомерЗаявкиПНР + " срок гарантии истек";
				
			Иначе
				НовыйДокумент.ВидГарантии = Перечисления.смартВидыГарантии.Гарантия;
			КонецЕсли;
			
		Иначе
			НовыйДокумент.ВидГарантии = Перечисления.смартВидыГарантии.Платная;
		КонецЕсли;
		
	Иначе	
		НовыйДокумент.ВидГарантии = Перечисления.смартВидыГарантии.Платная;
	КонецЕсли;
	
	НовыйДокумент.ЖелаемаяДатаРемонта = ПараметрыЗаполнения.ЖелаемаяДатаРемонта;
	НовыйДокумент.ОписаниеНеисправности = ПараметрыЗаполнения.ОписаниеНеисправности;
		
	//++ #Б-3570 смарт: Фролов 17.06.2025 //При загрузке ЗРР из почты сделать их проведенными.
	Попытка
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;	
	//-- #Б-3570 смарт: Фролов 17.06.2025
	
	// Присоединить файлы
	Если ПараметрыЗаполнения.Вложения <> "" Тогда
		
		Для Каждого ИнтернетПочтовоеВложение Из ПараметрыЗаполнения.Вложения Цикл
			
			ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.ВладелецФайлов = НовыйДокумент.Ссылка;
			
			РасширениеБезТочки = ОбщегоНазначенияКлиентСервер.ПолучитьРасширениеИмениФайла(ИнтернетПочтовоеВложение.ИмяФайла);
			
			ПараметрыФайла.РасширениеБезТочки = РасширениеБезТочки;
			ПараметрыФайла.ИмяБезРасширения = СтрЗаменить(ИнтернетПочтовоеВложение.ИмяФайла, "." + РасширениеБезТочки, "");			
			
			АдресВХранилище = ПоместитьВоВременноеХранилище(ИнтернетПочтовоеВложение.Данные);
			
			РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХранилище);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НовыйДокумент.Ссылка;
	
КонецФункции

Функция СрокГарантииИстек(ПараметрыЗаполнения, НомерЗаявкиПНР = "")
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	смартЗаявкаНаПускоНаладкуОборудование.ГарантийныйСрокНаОборудование КАК ГарантийныйСрокНаОборудование,
	|	смартЗаявкаНаПускоНаладкуОборудование.ДатаПодписанияАктаНаПНР КАК ДатаПодписанияАктаНаПНР,
	|	ЕСТЬNULL(смартГарантийныеСрокиНаОборудование.КоличествоМесяцев, 0) КАК КоличествоМесяцев,
	|	смартЗаявкаНаПускоНаладкуОборудование.Ссылка.Номер КАК Номер
	|ИЗ
	|	Документ.смартЗаявкаНаПускоНаладку.Оборудование КАК смартЗаявкаНаПускоНаладкуОборудование
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.смартГарантийныеСрокиНаОборудование КАК смартГарантийныеСрокиНаОборудование
	|		ПО смартЗаявкаНаПускоНаладкуОборудование.ГарантийныйСрокНаОборудование = смартГарантийныеСрокиНаОборудование.Ссылка
	|ГДЕ
	|	НЕ смартЗаявкаНаПускоНаладкуОборудование.Ссылка.ПометкаУдаления
	|	И смартЗаявкаНаПускоНаладкуОборудование.ОборудованиеКлиентов = &ОборудованиеКлиентов
	|	И смартЗаявкаНаПускоНаладкуОборудование.Серия = &Серия";
	
	Запрос.УстановитьПараметр("Серия", ПараметрыЗаполнения.Серия);
	Запрос.УстановитьПараметр("ОборудованиеКлиентов", ПараметрыЗаполнения.ОборудованиеКлиентов);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ДобавитьМесяц(Выборка.ДатаПодписанияАктаНаПНР, Выборка.КоличествоМесяцев) < НачалоДня(ТекущаяДата()) Тогда
			Результат = Истина;
			НомерЗаявкиПНР = Выборка.Номер;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиРегион(СтрокаРегион)
	
	БизнесРегион = Справочники.БизнесРегионы.НайтиПоНаименованию(СтрокаРегион);
	Если ЗначениеЗаполнено(БизнесРегион) Тогда
		Возврат БизнесРегион;	
	КонецЕсли;	
	
	Если СтрокаРегион = "Респ Крым" Тогда
		Возврат Справочники.БизнесРегионы.НайтиПоНаименованию("Крым Респ");	
	КонецЕсли;
	
	Если СтрокаРегион = "г Москва" Тогда
		Возврат Справочники.БизнесРегионы.НайтиПоНаименованию("Москва (регион)");	
	КонецЕсли; 
	
	Если СтрокаРегион = "г Санкт-Петербург" Тогда
		Возврат Справочники.БизнесРегионы.НайтиПоНаименованию("Санкт-Петербург (регион)");
	КонецЕсли;
	
	Если СтрокаРегион = "Ленинградская обл" Тогда
		Возврат Справочники.БизнесРегионы.НайтиПоНаименованию("Ленинградская обл");
	КонецЕсли;
	
	СтрокаРегион1 = СтрЗаменить(СтрокаРегион," (Адыгея)", "");
	СтрокаРегион1 = СтрЗаменить(СтрокаРегион,"Край", "");
	СтрокаРегион1 = СтрЗаменить(СтрокаРегион,"Город", "");
	СтрокаРегион1 = СтрЗаменить(СтрокаРегион,"г.", "");
	СтрокаРегион2 = СтрЗаменить(СтрокаРегион1,"Область", "");
	СтрокаРегион3 = СтрЗаменить(СтрокаРегион2,"Республика", "");
	СтрокаРегион3 = СтрЗаменить(СтрокаРегион2,"Респ", "");
  
	МассивПодстрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРегион3, " ");
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	БизнесРегионы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	БизнесРегионы.Наименование ПОДОБНО &Регион
	|	И НЕ БизнесРегионы.ПометкаУдаления");
	
	Для Каждого СтрМассивПодстрок Из МассивПодстрок Цикл
		
		Запрос.УстановитьПараметр("Регион", "%" + СтрМассивПодстрок + "%");
		
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() ТОгда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Справочники.БизнесРегионы.ПустаяСсылка();
	
КонецФункции

Функция НайтиРегионВерхнегоУровня(Регион)
	
	РегионПоиска = Регион;
	
	Пока ЗначениеЗаполнено(РегионПоиска.Родитель) И НЕ ЗначениеЗаполнено(РегионПоиска.смартОбслуживающееПодразделениеСЦ) Цикл
		РегионПоиска = НайтиРегионВерхнегоУровня(РегионПоиска.Родитель);
	КонецЦикла;
	
	Возврат РегионПоиска;
	
КонецФункции

#КонецОбласти