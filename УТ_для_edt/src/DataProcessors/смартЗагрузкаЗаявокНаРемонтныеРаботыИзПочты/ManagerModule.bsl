#Область Интерфейс

Функция ЗагрузитьЗаявкиИзПочты(ДатаПисем = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаПисем) Тогда
		ДатаПисем = НачалоДня(ТекущаяДата());
	КонецЕсли;
	
	ЭлектронныйАдрес = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("АдресПочтыЗагрузкиЗаявокНаРемонт");
	Пароль = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ПарольПочтыЗагрузкиЗаявокНаРемонт");
	
	МассивДокументов = Новый Массив;
	ПочтовыйПрофиль = РаботаСПочтовымиСообщениямиСлужебный.ИнтернетПочтовыйПрофиль(РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), Истина);
	
	ПочтовыйПрофиль.Пароль = Пароль;
	ПочтовыйПрофиль.ПарольSMTP = Пароль;
	ПочтовыйПрофиль.Пользователь = ЭлектронныйАдрес;
	ПочтовыйПрофиль.ПользовательSMTP = ЭлектронныйАдрес;
	ПочтовыйПрофиль.ПользовательIMAP = ЭлектронныйАдрес;
	ПочтовыйПрофиль.ПарольIMAP = Пароль;
	
	ИнтернетПочта = Новый ИнтернетПочта;
	Попытка
		ИнтернетПочта.Подключиться(ПочтовыйПрофиль, ПротоколИнтернетПочты.IMAP);
	Исключение
		
		ТекстОшибки = СтрШаблон("Не удалось подключиться к почте по причине :%1%2 ", Символы.ПС, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
		Возврат МассивДокументов;
		
	КонецПопытки;

	ПараметрыОтбора = Новый Структура;
    ПараметрыОтбора.Вставить("ПослеДатыОтправления", ДатаПисем);
	
	МассивЗаголовков = ИнтернетПочта.ПолучитьЗаголовки(ПараметрыОтбора);
	МассивЗаголовковТекущаяДата = Новый Массив;
	
	// Отборы по дате не сработали, вручную отбор сообщений за текущий день
	Для Каждого ТекущийЗаголовок Из МассивЗаголовков Цикл
		
		Если ТекущийЗаголовок.ДатаОтправления >= ДатаПисем 
			И ТекущийЗаголовок.ДатаОтправления <= КонецДня(ДатаПисем) 
            И СтрНайти(ТекущийЗаголовок.Тема,"заявка")<>0
            Тогда
			
			МассивЗаголовковТекущаяДата.Добавить(ТекущийЗаголовок);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивЗаголовковТекущаяДата.Количество() = 0 Тогда
		
		ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, "На сервере новых сообщений нет");
		ОбщегоНазначения.СообщитьПользователю("На сервере новых сообщений нет.");
		
		Возврат МассивДокументов;
		
	КонецЕсли;	
	
	Сообщения = ИнтернетПочта.Выбрать(Ложь, МассивЗаголовковТекущаяДата, Ложь);
	
	Если Сообщения.Количество() = 0 Тогда
		
		ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, "На сервере новых сообщений нет");
		ОбщегоНазначения.СообщитьПользователю("На сервере новых сообщений нет.");
		
		Возврат МассивДокументов;
		
	Иначе
		
		// 1. Получить номер заявки из текста письма
		// 2. Найти заявку в базе. Если такой нет, то пункты 3, 4						
		// 3. Прочитать все поля из текста письма		
		// 4. Создать новый документ Заявка на ремонтные работы
		
		Организация = Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение;
		
		Для Каждого ТекущееСообщение Из Сообщения Цикл
			
			Если ТекущееСообщение.Тексты.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекстПисьма = "";
			Разделитель = Символы.ПС;
			ИнтернетТекстПочтовогоСообщения = ТекущееСообщение.Тексты[0];
			Если ИнтернетТекстПочтовогоСообщения.ТипТекста = ТипТекстаПочтовогоСообщения.HTML Тогда
				ТекстПисьма = ПолучитьЧистыйТекстИзHTML(ИнтернетТекстПочтовогоСообщения.Текст);
			Иначе
				ТекстПисьма = ИнтернетТекстПочтовогоСообщения.Текст;
			КонецЕсли;
						
			МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПисьма, Разделитель, Истина, Истина);			
			
			НомерЗаявки = "";
			Для Каждого СтрокаСообщения Из МассивСтрок Цикл
				
				Если СтрНайти(СтрокаСообщения, "Номер заявки:") <> 0 Тогда
					
					ДлинаСтроки = СтрДлина(СтрокаСообщения);
					НомерЗаявки = СокрЛП(Прав(СтрокаСообщения, ДлинаСтроки - 13));
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(НомерЗаявки) Тогда
				
				ТекстСообщенияНачало = "E-mail от " + Формат(ТекущееСообщение.ДатаОтправления, "ДФ='dd.MM.yyyy ""г.""'") + " по заявке №" + НомерЗаявки + ": ";
				
				НомерЗаявки = Лев(НомерЗаявки, 10);
				ВБазеЕстьДокументСНомером = ПроверитьНаличиеДокумента(НомерЗаявки, ДатаПисем);
				
				Если НЕ ВБазеЕстьДокументСНомером Тогда
										
					СтруктураДанныеИзПисьма = Новый Структура;
					СтруктураДанныеИзПисьма.Вставить("Номер", НомерЗаявки);
					СтруктураДанныеИзПисьма.Вставить("ИНН", "");
					СтруктураДанныеИзПисьма.Вставить("КонтрагентИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("Контрагент", "");
					СтруктураДанныеИзПисьма.Вставить("КонтактноеЛицо", "");
					СтруктураДанныеИзПисьма.Вставить("КонтактноеЛицоИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("ТелефонКонтактногоЛица", "");
					СтруктураДанныеИзПисьма.Вставить("АдресЭПКонтактногоЛица", "");
					СтруктураДанныеИзПисьма.Вставить("ТелефонИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("АдресЭПИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("ГородИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("Представительство", "");
					СтруктураДанныеИзПисьма.Вставить("АдресИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("ОборудованиеКлиентов", "");
					СтруктураДанныеИзПисьма.Вставить("ОборудованиеКлиентовИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("Серия", "");
					СтруктураДанныеИзПисьма.Вставить("СерияИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("НаличиеГарантии", "");
					СтруктураДанныеИзПисьма.Вставить("ТипЧернил", "");
					СтруктураДанныеИзПисьма.Вставить("ТипЧернилИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("КонфигурацияЧернил", "");
					СтруктураДанныеИзПисьма.Вставить("КонфигурацияЧернилИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("РастровыйПроцессор", "");
					СтруктураДанныеИзПисьма.Вставить("РастровыйПроцессорИзПисьма", "");
					СтруктураДанныеИзПисьма.Вставить("ЖелаемаяДатаРемонта", "");
					СтруктураДанныеИзПисьма.Вставить("ОписаниеНеисправности", "");
					СтруктураДанныеИзПисьма.Вставить("Вложения", "");
					
					ЕстьОшибкиВДанных = Ложь;
					ТекстОшибки = "";
					Контрагент = Неопределено;
					ГрузимОписаниеНеисправности = Ложь;
					
					Если Не СтрНачинаетсяС(МассивСтрок[0],"----- Заявка на вызов сервисного инженера") Тогда 
						Продолжить; 
					КонецЕсли;
					
					Для Каждого СтрокаСообщения Из МассивСтрок Цикл
						 
						// ИНН
						ТекстПоиска = "ИНН вашей компании:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							СтруктураДанныеИзПисьма.ИНН = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							Если НЕ ЗначениеЗаполнено(СтруктураДанныеИзПисьма.ИНН) Тогда
								
								ЕстьОшибкиВДанных = Истина;
								ТекстОшибки = ТекстСообщенияНачало + "не найден ИНН контрагента";
								Контрагент = Справочники.Контрагенты.ПустаяСсылка();
								
							Иначе
								Контрагент = ПолучитьКонтрагентаПоИНН(СтруктураДанныеИзПисьма.ИНН);
							КонецЕсли;
							
							СтруктураДанныеИзПисьма.Контрагент = Контрагент;
							
						КонецЕсли;
						
						// Название компании
						ТекстПоиска = "Название вашей компании:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							СтруктураДанныеИзПисьма.КонтрагентИзПисьма = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);																				
						КонецЕсли;
						
						// Контактное лицо
						ТекстПоиска = "Контактное лицо:";
						КонтактноеЛицоСсылка = Неопределено;
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							НаименованиеКЛ = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.КонтактноеЛицоИзПисьма = НаименованиеКЛ;
							
						КонецЕсли;
						
						// Телефон Контактного лица
						ТекстПоиска = "Телефон для связи и получения sms-уведомления:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							ТелефонСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.ТелефонИзПисьма = ТелефонСтрока;
							
						КонецЕсли;
						
						// Почта Контактного лица
						ТекстПоиска = "E-mail:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							ПочтаСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.АдресЭПИзПисьма = ПочтаСтрока;
							КонтактноеЛицоСсылка = НайтиКонтактноеЛицоПоТелефонуИлиПочте(СтруктураДанныеИзПисьма);
							СтруктураДанныеИзПисьма.КонтактноеЛицо = КонтактноеЛицоСсылка;
							
						КонецЕсли;

						// Город
						ТекстПоиска = "Город:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							СтруктураДанныеИзПисьма.ГородИзПисьма = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
						КонецЕсли;
						
						// Регион
						ТекстПоиска = "Регион:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							СтруктураДанныеИзПисьма.Представительство = Справочники.СтруктураПредприятия.ПустаяСсылка();
							
							РегионИзПисьма = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							
							Если НЕ РегионИзПисьма = "" Тогда
								
								НайденныйРегион = НайтиРегион(РегионИзПисьма);
								
								Если ЗначениеЗаполнено(НайденныйРегион) Тогда
									
									БизнесРегионВерхнегоУровня = НайтиРегионВерхнегоУровня(НайденныйРегион);
									
									Если ЗначениеЗаполнено(БизнесРегионВерхнегоУровня) Тогда
									 
										СтруктураДанныеИзПисьма.Представительство = ?(ЗначениеЗаполнено(БизнесРегионВерхнегоУровня.смартОбслуживающееПодразделениеСЦ), 
											БизнесРегионВерхнегоУровня.смартОбслуживающееПодразделениеСЦ, БизнесРегионВерхнегоУровня.смартОтветственоеПодразделение);
										
									КонецЕсли;	
									
								КонецЕсли;
								
								Если СтруктураДанныеИзПисьма.Представительство = Справочники.СтруктураПредприятия.ПустаяСсылка() Тогда
									
									ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка Заявок на ремонтные работы из почты'", ОбщегоНазначения.КодОсновногоЯзыка()),
										УровеньЖурналаРегистрации.Ошибка, , 
										, "Загрузка Заявок на ремонтные работы из почты. Не удалось определить представительство по региону " + РегионИзПисьма + "!");
										
								КонецЕсли;		
							
							КонецЕсли;
							
						КонецЕсли;
						
						// Адрес
						ТекстПоиска = "Адрес выезда инженера:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							СтруктураДанныеИзПисьма.АдресИзПисьма = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
						КонецЕсли;
						
						// Оборудование
						ТекстПоиска = "Полное название оборудования:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							ОборудованиеСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.ОборудованиеКлиентовИзПисьма = ОборудованиеСтрока;
							
							Если ЗначениеЗаполнено(ОборудованиеСтрока) Тогда

								ОборудованиеСсылка = ПолучитьОборудованиеКлиентов(ОборудованиеСтрока);
																
								Если ЗначениеЗаполнено(ОборудованиеСсылка) Тогда
									
									//++ #Б-3478 смарт: Фролов 02.06.2025 //Загрузка заявок на ремонтные работы с учетом квалификаций инженеров СЦ,
									Если ЗначениеЗаполнено(СтруктураДанныеИзПисьма.Представительство)
										И НЕ СтруктураДанныеИзПисьма.Представительство = Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение Тогда
										
										Запрос = Новый Запрос(
										"ВЫБРАТЬ
										|	Инженер КАК Инженер
										|ИЗ
										|	РегистрСведений.смартВидыКвалификацийИнженеровСЦ
										|ГДЕ
										|	Оборудование = &Оборудование
										|	И Подразделение = &Подразделение
										|	И Ремонт");
										Запрос.УстановитьПараметр("Подразделение", СтруктураДанныеИзПисьма.Представительство);
										Запрос.УстановитьПараметр("Оборудование", ОборудованиеСсылка);
										
										Если Запрос.Выполнить().Пустой() Тогда
											
											СтруктураДанныеИзПисьма.Представительство = Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение;	
											
										КонецЕсли;	
										
									КонецЕсли;
									//-- #Б-3478 смарт: Фролов 02.06.2025
									
									СтруктураДанныеИзПисьма.ОборудованиеКлиентов = ОборудованиеСсылка;
									
								Иначе
									ТекстСообщения = ТекстСообщенияНачало + "не найдено оборудование с наименованием " + ОборудованиеСтрока;
									ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
								
							КонецЕсли;							
						КонецЕсли;

						// Серия
						ТекстПоиска = "Серийный номер оборудования:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							СерияСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.СерияИзПисьма = СерияСтрока;
							
							Если ЗначениеЗаполнено(СерияСтрока) Тогда

								мСерияСтрока = СерияСтрока;
								СерияСсылка = ПолучитьСерию(мСерияСтрока);
								
								Если ЗначениеЗаполнено(СерияСсылка) Тогда
									СтруктураДанныеИзПисьма.Серия = СерияСсылка;									
								Иначе
									ТекстСообщения = ТекстСообщенияНачало + "не найдена серия " + СерияСтрока;
									ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
								
							КонецЕсли;							
						КонецЕсли;

						// Наличие гарантии
						ТекстПоиска = "Наличие гарантии:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							СтруктураДанныеИзПисьма.НаличиеГарантии = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
						КонецЕсли;
						
						// Тип чернил
						ТекстПоиска = "Марка используемых чернил:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							ТипЧернилСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.ТипЧернилИзПисьма = ТипЧернилСтрока;
							
							Если ЗначениеЗаполнено(ТипЧернилСтрока) Тогда

								ТипЧернилСсылка = ПолучитьТипЧернил(ТипЧернилСтрока);
								
								Если ЗначениеЗаполнено(ТипЧернилСсылка) Тогда
									СтруктураДанныеИзПисьма.ТипЧернил = ТипЧернилСсылка;
								Иначе
									ТекстСообщения = ТекстСообщенияНачало + "не найден тип чернил с наименованием " + ТипЧернилСтрока;
									ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						// Конфигурация чернил
						ТекстПоиска = "Конфигурация чернил:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							КонфигурацияЧернилСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.КонфигурацияЧернилИзПисьма = КонфигурацияЧернилСтрока;
							
							Если ЗначениеЗаполнено(КонфигурацияЧернилСтрока) Тогда

								КонфигурацияЧернилСсылка = ПолучитьЭлементПоНаименованию(КонфигурацияЧернилСтрока, "смартКонфигурацииЧернил");
								
								Если ЗначениеЗаполнено(КонфигурацияЧернилСсылка) Тогда
									СтруктураДанныеИзПисьма.КонфигурацияЧернил = КонфигурацияЧернилСсылка;
								Иначе
									ТекстСообщения = ТекстСообщенияНачало + "не найдена конфигурация чернил с наименованием " + КонфигурацияЧернилСтрока;
									ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						// Растровый процессор
						ТекстПоиска = "Растровый процессор:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							
							РастровыйПроцессорСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.РастровыйПроцессорИзПисьма = РастровыйПроцессорСтрока;
							
							Если ЗначениеЗаполнено(РастровыйПроцессорСтрока) Тогда

								РастровыйПроцессорСсылка = ПолучитьЭлементПоНаименованию(РастровыйПроцессорСтрока, "смартРастровыеПроцессоры");
								
								Если ЗначениеЗаполнено(РастровыйПроцессорСсылка) Тогда
									СтруктураДанныеИзПисьма.РастровыйПроцессор = РастровыйПроцессорСсылка;
								Иначе
									ТекстСообщения = ТекстСообщенияНачало + "не найден растровый процессор наименованием " + РастровыйПроцессорСтрока;
									ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						// Желаемая дата ремонта 
						ТекстПоиска = "Укажите дату планируемого выезда инженера:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							ЖелаемаяДатаРемонтаСтрока = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							СтруктураДанныеИзПисьма.ЖелаемаяДатаРемонта = смартОбщегоНазначения.ПолучитьДатуИзСтроки(ЖелаемаяДатаРемонтаСтрока);
						КонецЕсли;
						
						// Описание неисправностей 
						ТекстПоиска = "Описание неисправностей:";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							СтруктураДанныеИзПисьма.ОписаниеНеисправности = ПолучитьЗначениеИзСтроки(СтрокаСообщения, ТекстПоиска);
							ГрузимОписаниеНеисправности = Истина;
							Продолжить;
						КонецЕсли;
						
						//конец сообщения
						ТекстПоиска = "ВНИМАНИЕ: Заказчик обязан обеспечить";
						Если СтрНайти(СтрокаСообщения, ТекстПоиска) <> 0 Тогда
							ГрузимОписаниеНеисправности = Ложь;
						ИначеЕсли ГрузимОписаниеНеисправности Тогда
							СтруктураДанныеИзПисьма.ОписаниеНеисправности = СтруктураДанныеИзПисьма.ОписаниеНеисправности + СокрЛП(СтрокаСообщения);
						КонецЕсли;
						
					КонецЦикла;

					Если ЕстьОшибкиВДанных Тогда
						ЗаписьЖурналаРегистрации(ИмяСобытияДляЖР(), УровеньЖурналаРегистрации.Информация,,, ТекстОшибки);
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);						
					КонецЕсли;
					
					Вложения = ТекущееСообщение.Вложения;
					
					Если Вложения.Количество() > 0 Тогда
						СтруктураДанныеИзПисьма.Вложения = Вложения;
					КонецЕсли;										
					
					Попытка
						СоздатьДокументЗаявкаНаРемонтныеРаботы(СтруктураДанныеИзПисьма, ДатаПисем, Организация);
					Исключение
						ОбщегоНазначения.СообщитьПользователю("Не создан документ по заявке " + Строка(НомерЗаявки));
					КонецПопытки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ИнтернетПочта.Отключиться();
	
	Возврат МассивДокументов
	
КонецФункции

Функция ПолучитьНоменклатуруОборудования(Оборудование) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	смартОборудованиеЧернилаКлиентов.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.смартОборудованиеЧернилаКлиентов КАК смартОборудованиеЧернилаКлиентов
	|ГДЕ
	|	смартОборудованиеЧернилаКлиентов.ОборудованиеКлиентов = &ОборудованиеКлиентов
	|	И смартОборудованиеЧернилаКлиентов.СопоставлениеСТоваром";
	
	Запрос.УстановитьПараметр("ОборудованиеКлиентов", Оборудование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Номенклатура;
	КонецЕсли;
	
	Возврат Справочники.Номенклатура.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#Область Служебные

Функция ИмяСобытияДляЖР() Экспорт
	Возврат "Смарт.ЗагрузкаЗаявокНаРемонтныеРаботыИзПочты";
КонецФункции

Функция ПолучитьЗначениеИзСтроки(знач СтрокаСообщения, НачалоСтроки)
	
	Возврат СокрЛП(СтрЗаменить(СтрокаСообщения, НачалоСтроки, ""));
	
КонецФункции

Функция ПолучитьЧистыйТекстИзHTML(знач ТекстHTML)
	
	Результат = ТекстHTML;
	Результат = СтрЗаменить(Результат, "<br>", Символы.ПС);
	
	Построитель = Новый ПостроительDOM;
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.УстановитьСтроку(Результат);
	ДокументHTML = Построитель.Прочитать(ЧтениеHTML); 
	
	Возврат ДокументHTML.Тело.ТекстовоеСодержимое;
	
КонецФункции

Функция ПолучитьКонтрагентаПоИНН(ИНН)
	
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И НЕ Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();

	Выборка.Следующий();
	
	Возврат	Выборка.Ссылка;
	
КонецФункции

Функция ПолучитьКонтактноеЛицоПоНаименованию(Контрагент, НаименованиеКЛ)
	
	Если НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(НаименованиеКЛ) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
	|ГДЕ
	|	КонтактныеЛицаПартнеров.Наименование = &Наименование
	|	И КонтактныеЛицаПартнеров.Владелец = &Партнер
	|	И НЕ КонтактныеЛицаПартнеров.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеКЛ);
	Запрос.УстановитьПараметр("Партнер", Контрагент.Партнер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция НайтиКонтактноеЛицоПоТелефонуИлиПочте(СтруктураДанныеИзПисьма)
	
	АдресЭПИзПисьма = СтруктураДанныеИзПисьма.АдресЭПИзПисьма;
	ТелефонИзПисьма = СтруктураДанныеИзПисьма.ТелефонИзПисьма;
	Контрагент 		= СтруктураДанныеИзПисьма.Контрагент;
	
	Если НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ (НЕ ЗначениеЗаполнено(АдресЭПИзПисьма) И НЕ ЗначениеЗаполнено(ТелефонИзПисьма)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Ссылка КАК Ссылка,
	|	КонтактнаяИнформация.Тип КАК Тип,
	|	КонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	НЕ КонтактнаяИнформация.Ссылка.ПометкаУдаления
	|	И КонтактнаяИнформация.Тип В(&ТипыКИ)
	|	И КонтактнаяИнформация.Ссылка.Владелец = &Партнер
	|ИТОГИ ПО
	|	Ссылка";
	
	ТипТелефон = Перечисления.ТипыКонтактнойИнформации.Телефон;
	ТипПочта = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	
	ТипыКИ = Новый Массив;
	ТипыКИ.Добавить(ТипТелефон);
	ТипыКИ.Добавить(ТипПочта);
	
	Запрос.УстановитьПараметр("Партнер", Контрагент.Партнер);
	Запрос.УстановитьПараметр("ТипыКИ", ТипыКИ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаКонтактноеЛицо = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НайденноеКонтактноеЛицо = Неопределено;
	МаксимумСовпадений = 0;
	
	Пока ВыборкаКонтактноеЛицо.Следующий() Цикл
		
		КоличествоСовпадений = 0;
		
		АдресЭПКонтактногоЛица = "";
		ТелефонКонтактногоЛица = "";
		
		Выборка = ВыборкаКонтактноеЛицо.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Тип = ТипТелефон Тогда
				
				НайденноеЗначение = НайтиКонтактнуюИнформациюПоСовпадению(Выборка.Ссылка, ТелефонИзПисьма, Выборка.Тип, Выборка.Представление);
				
				ТелефонКонтактногоЛица = НайденноеЗначение;
				
				Если НЕ ЗначениеЗаполнено(НайденноеЗначение) Тогда
					Продолжить;
				КонецЕсли;
											
			ИначеЕсли Выборка.Тип = ТипПочта Тогда
				
				НайденноеЗначение = НайтиКонтактнуюИнформациюПоСовпадению(Выборка.Ссылка, АдресЭПИзПисьма, Выборка.Тип, Выборка.Представление);
				
				АдресЭПКонтактногоЛица = НайденноеЗначение;
				
				Если НЕ ЗначениеЗаполнено(НайденноеЗначение) Тогда
					Продолжить;
				КонецЕсли;				
				
			КонецЕсли;
			
			КоличествоСовпадений = КоличествоСовпадений + 1;	
			
		КонецЦикла;
		
		Если КоличествоСовпадений > МаксимумСовпадений Тогда
			МаксимумСовпадений = КоличествоСовпадений;
			НайденноеКонтактноеЛицо = ВыборкаКонтактноеЛицо.Ссылка;
			СтруктураДанныеИзПисьма.АдресЭПКонтактногоЛица = АдресЭПКонтактногоЛица;
			СтруктураДанныеИзПисьма.ТелефонКонтактногоЛица = ТелефонКонтактногоЛица;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(НайденноеКонтактноеЛицо) Тогда
		
		НовоеКЛ = Справочники.КонтактныеЛицаПартнеров.СоздатьЭлемент();
		НовоеКЛ.Владелец = Контрагент.Партнер;
		НовоеКЛ.Автор = ПараметрыСеанса.ТекущийПользователь;
		НовыйКонтакт = НовоеКЛ.КонтактнаяИнформация.Добавить();
		НовыйКонтакт.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовыйКонтакт.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица;
		НовыйКонтакт.АдресЭП = АдресЭПИзПисьма;
		НовыйКонтакт.Представление = АдресЭПИзПисьма;
		
		Если ЗначениеЗаполнено(СтруктураДанныеИзПисьма.КонтактноеЛицоИзПисьма) Тогда
			НовоеКЛ.Наименование = СтруктураДанныеИзПисьма.КонтактноеЛицоИзПисьма;
		ИначеЕсли ЗначениеЗаполнено(ТелефонИзПисьма) Тогда
			НовоеКЛ.Наименование = ТелефонИзПисьма;
		ИначеЕсли ЗначениеЗаполнено(АдресЭПИзПисьма) Тогда
			НовоеКЛ.Наименование = АдресЭПИзПисьма;
		КонецЕсли;
					
		НовоеКЛ.Комментарий = НСтр("ru = 'Создан автоматически при загрузке заявок на ремонтные работы из почты '") + ТекущаяДата();
		
		Если ЗначениеЗаполнено(АдресЭПИзПисьма) Тогда			
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(НовоеКЛ, АдресЭПИзПисьма, Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица, ТекущаяДата(), Ложь); 			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТелефонИзПисьма) Тогда			
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(НовоеКЛ, ТелефонИзПисьма, Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица, ТекущаяДата(), Ложь); 			
		КонецЕсли;
		
		НовоеКЛ.Записать();
		
		НайденноеКонтактноеЛицо = НовоеКЛ.Ссылка;
		
	КонецЕсли;
	
	Возврат НайденноеКонтактноеЛицо;
										
КонецФункции

Функция НайтиКонтактнуюИнформациюПоСовпадению(КонтактноеЛицо, СтрокаПоиска, ТипПоля, Представление = "")
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо)
		ИЛИ НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат "";
	КонецЕсли;
	
	ТипТелефон = Перечисления.ТипыКонтактнойИнформации.Телефон;
	
	Если ТипПоля = ТипТелефон Тогда		
		СтрокаПоиска = ТолькоЦифры(СтрокаПоиска);
	КонецЕсли;
	
	Для Каждого КИ Из КонтактноеЛицо.КонтактнаяИнформация Цикл
		
		Если КИ.Тип <> ТипПоля Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Представление) 
			И КИ.Представление <> Представление Тогда
			Продолжить;
		КонецЕсли;
		
		Если КИ.Тип = ТипТелефон Тогда
			КИСтрока = ТолькоЦифры(КИ.Представление);
		Иначе
			КИСтрока = КИ.Представление;
		КонецЕсли;
		
		Если КИСтрока = СтрокаПоиска
			ИЛИ (ТипПоля = ТипТелефон И СтрДлина(КИСтрока) = 11 И Прав(КИСтрока, 10) = Прав(СтрокаПоиска, 10))
			ИЛИ СтрНайти(ВРег(КИСтрока), ВРег(СтрокаПоиска)) <> 0 Тогда
			
			Возврат КИ.Представление;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";

КонецФункции

Функция ПолучитьОборудованиеКлиентов(Наименование)
	
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартОборудованиеКлиентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартОборудованиеКлиентов КАК смартОборудованиеКлиентов
	|ГДЕ
	|	смартОборудованиеКлиентов.Наименование = &Наименование
	|	И НЕ смартОборудованиеКлиентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ПолучитьСерию(СерияСтрока)
	
	Если НЕ ЗначениеЗаполнено(СерияСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СерииНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СерииНоменклатуры КАК СерииНоменклатуры
	|ГДЕ
	|	НЕ СерииНоменклатуры.ПометкаУдаления
	|	И СерииНоменклатуры.Номер = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", СерияСтрока);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		СерияБезПробелов = СтрЗаменить(СерияСтрока, " ", "");
		Если СерияБезПробелов = СерияСтрока Тогда
			Возврат Неопределено;
		Иначе
			Возврат ПолучитьСерию(СерияБезПробелов);
		КонецЕсли;
		
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
КонецФункции

