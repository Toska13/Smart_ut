&ИзменениеИКонтроль("СформироватьВременныеТаблицыПоИнформацииОТоварахПакета")
Функция смарт_СформироватьВременныеТаблицыПоИнформацииОТоварахПакета(ПараметрыОбмена, ИдентификаторКаталога, СписокТоваров, СписокСвойств)


	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Узел"	, ПараметрыОбмена.Ссылка);
	Запрос.УстановитьПараметр("ТекДата"	, ТекущаяДатаСеанса());

	Запрос.УстановитьПараметр("СписокТоваров"	, СписокТоваров);
	Запрос.УстановитьПараметр("СписокСвойств"	, СписокСвойств);


	НайданнаяСтрока = ПараметрыОбмена.КэшДанных.Найти(ИдентификаторКаталога, "ИдентификаторКаталога");
	Если НайданнаяСтрока <> Неопределено тогда

		Запрос.УстановитьПараметр("СписокСкладов"	, НайданнаяСтрока.ОбщийСписокСкладов);
		Запрос.УстановитьПараметр("СписокСоглашений", НайданнаяСтрока.ОбщийСписокСоглашений);
		Запрос.УстановитьПараметр("СписокЕдиниц" 	, НайданнаяСтрока.ОбщийСписокЕдиницИзмерений);

	Иначе

		Б_ОбменССайтомСервер.СообщитьПодробно("Произошла ошибка в модуле. Информация по складам и остаткам может быть некорректной.", ПараметрыОбмена, Истина);

		Запрос.УстановитьПараметр("СписокСкладов"	, "");
		Запрос.УстановитьПараметр("СписокСоглашений", "");
		Запрос.УстановитьПараметр("СписокЕдиниц" 	, "");
	КонецЕсли;



	Запрос.УстановитьПараметр("ВыгружатьВсеКартинки"				, ПараметрыОбмена.ПринудительнаяПолноеОбновлениеДанныхТовара ИЛИ ПараметрыОбмена.ВыполнятьПолнуюВыгрузкуПринудительно);
	Запрос.УстановитьПараметр("ВыгружатьВсеХарактеристики"			, НЕ ПараметрыОбмена.ВыгружатьХарактеристикиТолькоСОстатками);
	Запрос.УстановитьПараметр("ВыгружатьОстаткиСУчетомРезерва"		, ПараметрыОбмена.ВыгружатьОстаткиСУчетомРезерва);

	Запрос.УстановитьПараметр("СписокРасширенийКартинок"			, ПараметрыОбмена.РасширенияКартинок);

	Запрос.УстановитьПараметр("ВыгружатьТолькоСЦеной"				, ПараметрыОбмена.ВыгружатьПредложенияТолькоСЦеной);
	Запрос.УстановитьПараметр("ВыгружатьНоменклатуруКакПредложение"	, ПараметрыОбмена.ВыгружатьНоменклатуруКакПредложение);
	Запрос.УстановитьПараметр("ИспользоватьУпаковкиНоменклатуры"	, ПараметрыОбмена.ИспользоватьУпаковкиНоменклатуры);
	Запрос.УстановитьПараметр("ВыгружатьКомплектующие"				, ПараметрыОбмена.ВыгружатьКомплектующие);
	Запрос.УстановитьПараметр("НастройкиСвойств"					, ПараметрыОбмена.НастройкаСвойствТоваровИХарактеристик);

	Запрос.УстановитьПараметр("Справочник_Номенклатура"						, Б_ОбменССайтомСерверПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура"));
	Запрос.УстановитьПараметр("Справочник_Номенклатура_Общие"				, Б_ОбменССайтомСерверПовтИсп.ПолучитьНаборСвойств("Справочник_Номенклатура_Общие"));
	Запрос.УстановитьПараметр("Справочник_ХарактеристикиНоменклатуры"		, Б_ОбменССайтомСерверПовтИсп.ПолучитьНаборСвойств("Справочник_ХарактеристикиНоменклатуры"));
	Запрос.УстановитьПараметр("Справочник_ХарактеристикиНоменклатуры_Общие"	, Б_ОбменССайтомСерверПовтИсп.ПолучитьНаборСвойств("Справочник_ХарактеристикиНоменклатуры_Общие"));

	Запрос.УстановитьПараметр("ИспользуетсяЦенообразование25"		, ПараметрыОбмена.ИспользуетсяЦенообразование25);

	#Вставка
	//++ #1613 смарт: Лопато 25.01.2023 //Рефакторинг узлов обмена. Выгрузка данных.
	////Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 03.09.2020 17:00:26 валюта для подстановки в пустые цены задача 552
	//Запрос.УстановитьПараметр("ВидЦеныЕвро"				, Справочники.смартПредопределенныеЗначения.ВалютаТиповаяЕвроБитрикс.значение);
	//Запрос.УстановитьПараметр("ВидЦеныРуб"				, Справочники.смартПредопределенныеЗначения.ВалютаТиповаяРубБитрикс.значение);
	////Смарт }Подкин Алексей Иванович 03.09.2020 17:00:26

	Запрос.УстановитьПараметр("ВидЦеныРозничнаяEUR", Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяEUR"));// Розничная EUR
	Запрос.УстановитьПараметр("ВидЦеныРозничнаяУЕ",  Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяУЕ")); // Розничная у.е.
	Запрос.УстановитьПараметр("ВидЦеныРозничнаяUSD", Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяUSD"));// Розничная USD

	Запрос.УстановитьПараметр("СегментEUR", 		 Справочники.СегментыНоменклатуры.НайтиПоКоду("ЦБ-00000169")); // ПродажаВВалютеEUR
	//-- #1613 смарт: Лопато 25.01.2023
	#КонецВставки

	#Вставка
	//++ #Б7892 смарт: Шляпников 01.09.2026 / Цены Basic. Обмен с Битрикс
	смартВидыЦенВыгрузкиТЗ = Новый ТаблицаЗначений;
	смартВидыЦенВыгрузкиТЗ.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	смартВидыЦенВыгрузкиТЗ.Колонки.Добавить("ВидЦены", Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));

	смартВидЦеныBasic = Справочники.ВидыЦен.НайтиПоНаименованию("Basic", Истина);

	смартИменаНоменклатуры = Новый Массив;
	смартИменаНоменклатуры.Добавить("Плоттер MIMAKI JV200-160");
	смартИменаНоменклатуры.Добавить("Плоттер MIMAKI JV200-160 (Комплект)");
	смартИменаНоменклатуры.Добавить("Плоттер MIMAKI JV300-160 Plus");
	смартИменаНоменклатуры.Добавить("Плоттер-каттер Mimaki СJV200-160");

	Для Каждого смартИмяНоменклатуры Из смартИменаНоменклатуры Цикл

		смартНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(смартИмяНоменклатуры, Истина);
		Если Не ЗначениеЗаполнено(смартНоменклатура) Или Не ЗначениеЗаполнено(смартВидЦеныBasic) Тогда
			Продолжить;
		КонецЕсли;

		смартСтрокаТЗ = смартВидыЦенВыгрузкиТЗ.Добавить();
		смартСтрокаТЗ.Номенклатура = смартНоменклатура;
		смартСтрокаТЗ.ВидЦены = смартВидЦеныBasic;

	КонецЦикла;

	Запрос.УстановитьПараметр("смартВидыЦенВыгрузкиТЗ", смартВидыЦенВыгрузкиТЗ);
	//-- #Б7892 смарт: Шляпников 01.09.2026
	#КонецВставки

	////////////////////////////////////////////////////////////////////////////////////////////////////////
