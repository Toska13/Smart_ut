
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Склад", Склад);
	Параметры.Свойство("смартЗапчастиГарантийные", смартЗапчастиГарантийные);
	Параметры.Свойство("ДокументВладелец", ДокументВладелец);
	
	Элементы.Сценарий.СписокВыбора.Добавить("Товар, выведенный из оборота");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Товары.Очистить();
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	АдресВХранилище = ПоместитьВыбранныеСтрокиВоВременноеХранилище();
	Если АдресВХранилище = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки для переноса (колонка «Перенести»).'"));
		Возврат;
	КонецЕсли;
	
	Закрыть(АдресВХранилище);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	ЗаполнитьОтметкиПереноса(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)
	
	ЗаполнитьОтметкиПереноса(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОтметкиПереноса(ЗначениеОтметки)
	
	ТаблицаТоваров = Товары.Выгрузить();
	ТаблицаТоваров.ЗаполнитьЗначения(ЗначениеОтметки, "Перенести");
	Товары.Загрузить(ТаблицаТоваров);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	
	Товары.Очистить();
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СвободныеОстатки.Номенклатура КАК Номенклатура,
	|	СвободныеОстатки.Характеристика КАК Характеристика,
	|	СвободныеОстатки.Склад КАК Склад,
	|	ВЫБОР
	|		КОГДА &Гарантийные
	|			ТОГДА СвободныеОстатки.смартВНаличииГарантийныеОстаток
	|				- СвободныеОстатки.смартВРезервеСоСкладаГарантийныеОстаток
	|				- СвободныеОстатки.смартВРезервеПодЗаказГарантийныеОстаток
	|		ИНАЧЕ СвободныеОстатки.ВНаличииОстаток
	|				- СвободныеОстатки.ВРезервеСоСкладаОстаток
	|				- СвободныеОстатки.ВРезервеПодЗаказОстаток
	|	КОНЕЦ КАК ДоступноеКоличество,
	|	СвободныеОстатки.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СвободныеОстатки.Остатки(, Склад = &Склад) КАК СвободныеОстатки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &Гарантийные
	|				ТОГДА СвободныеОстатки.смартВНаличииГарантийныеОстаток
	|						- СвободныеОстатки.смартВРезервеСоСкладаГарантийныеОстаток
	|						- СвободныеОстатки.смартВРезервеПодЗаказГарантийныеОстаток
	|			ИНАЧЕ СвободныеОстатки.ВНаличииОстаток
	|					- СвободныеОстатки.ВРезервеСоСкладаОстаток
	|					- СвободныеОстатки.ВРезервеПодЗаказОстаток
	|		КОНЕЦ > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыДокумента.Номенклатура КАК Номенклатура,
	|	ТоварыДокумента.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Исключения
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ШапкаПеремещения
	|		ПО ТоварыДокумента.Ссылка = ШапкаПеремещения.Ссылка
	|ГДЕ
	|	ШапкаПеремещения.Проведен
	|	И ШапкаПеремещения.Ссылка <> &ДокументВладелец
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыДокумента.Номенклатура,
	|	ТоварыДокумента.Характеристика
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаВнутреннееПотребление КАК ШапкаПотребления
	|		ПО ТоварыДокумента.Ссылка = ШапкаПотребления.Ссылка
	|ГДЕ
	|	ШапкаПотребления.Проведен
	|	И ШапкаПотребления.Ссылка <> &ДокументВладелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.Номенклатура КАК Номенклатура,
	|	ВТ_Остатки.Склад КАК Склад,
	|	ВТ_Остатки.Характеристика КАК Характеристика,
	|	ВТ_Остатки.ДоступноеКоличество КАК ДоступноеКоличество,
	|	ВТ_Остатки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ВТ_Остатки.Номенклатура.Наименование КАК НаименованиеНоменклатуры
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Исключения КАК ВТ_Исключения
	|		ПО ВТ_Остатки.Номенклатура = ВТ_Исключения.Номенклатура
	|			И ВТ_Остатки.Характеристика = ВТ_Исключения.Характеристика
	|ГДЕ
	|	ВТ_Исключения.Номенклатура ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеНоменклатуры";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Гарантийные", смартЗапчастиГарантийные);
	Запрос.УстановитьПараметр("ДокументВладелец", ДокументВладелец);
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ТаблицаОстатков.Колонки.Добавить("Перенести", Новый ОписаниеТипов("Булево"));
	ТаблицаОстатков.ЗаполнитьЗначения(Ложь, "Перенести");
	ТаблицаОстатков.Сортировать("НаименованиеНоменклатуры Возр");
	Товары.Загрузить(ТаблицаОстатков);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВыбранныеСтрокиВоВременноеХранилище()
	
	ТаблицаПереноса = Новый ТаблицаЗначений;
	ТаблицаПереноса.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПереноса.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для Каждого СтрокаТоваров Из Товары Цикл
		
		Если Не СтрокаТоваров.Перенести Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПереноса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваров, "Номенклатура, Характеристика");
		
	КонецЦикла;
	
	Если ТаблицаПереноса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПереноса, УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти
