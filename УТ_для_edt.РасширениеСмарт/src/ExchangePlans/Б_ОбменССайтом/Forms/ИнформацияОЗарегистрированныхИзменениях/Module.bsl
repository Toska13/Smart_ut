
//++#1323 смарт: Лопато 23.03.2023 //Восстановить и переделать механизм индивидуальных скидок
&НаСервере
&После("ОбновитьДеревоИзмененийСервер")
Процедура смарт_ОбновитьДеревоИзмененийСервер()

	СтрокиДерева = ДеревоИзменений.ПолучитьЭлементы();
	
	МассивИзменений = Новый Массив;
	
	ВыборкаСмартСтатусыЗаказовБитрикс = ПланыОбмена.ВыбратьИзменения(УзелОбмена, 0, Метаданные.РегистрыСведений.СмартСтатусыЗаказовБитрикс);

	Пока ВыборкаСмартСтатусыЗаказовБитрикс.Следующий() Цикл
		
		ЗаписьРегистраСмартСтатусыЗаказовБитрикс = ВыборкаСмартСтатусыЗаказовБитрикс.Получить();

		Если ЗаписьРегистраСмартСтатусыЗаказовБитрикс.Количество() > 0 Тогда
			
			СтруктураСмартСтатусыЗаказовБитрикс = Новый Структура("Заказ, СтатусЗаказа");
			СтруктураСмартСтатусыЗаказовБитрикс.Вставить("Заказ", 		 ЗаписьРегистраСмартСтатусыЗаказовБитрикс[0].СсылкаМет);
			СтруктураСмартСтатусыЗаказовБитрикс.Вставить("СтатусЗаказа", ЗаписьРегистраСмартСтатусыЗаказовБитрикс[0].СтатусЗаказа);
			
			МассивИзменений.Добавить(СтруктураСмартСтатусыЗаказовБитрикс);
			
		КонецЕсли;
		
	КонецЦикла;
		
	Если МассивИзменений.Количество() > 0 Тогда
		
		СтрокаДерева = СтрокиДерева.Добавить();
		СтрокаДерева.ВидОбъекта = НСтр("ru = 'Статусы заказов'");
		
		Для Каждого ЭлементМассива Из МассивИзменений Цикл
			СтрокаОбъекта = СтрокаДерева.ПолучитьЭлементы().Добавить();
			СтрокаОбъекта.Объект = СокрЛП(ЭлементМассива.Заказ) + ": " + СокрЛП(ЭлементМассива.СтатусЗаказа);
		КонецЦикла;
		
	КонецЕсли;

	//++#1866 смарт: Лопато 18.06.2024 //При изменении доп. фильтров номенклатуры сайта добавлять их в выгрузку узла по изменениям  
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.СмартФильтрыНоменклатуры.Изменения
		|ГДЕ
		|	Узел = &Узел");
	
	Запрос.УстановитьПараметр("Узел", УзелОбмена);
	
	МассивИзменений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если МассивИзменений.Количество() > 0 Тогда
		
		СтрокаДерева = СтрокиДерева.Добавить();
		СтрокаДерева.ВидОбъекта = НСтр("ru = 'Фильтры номенклатуры (Смарт)'");
	
		Для Каждого ЭлементМассива Из МассивИзменений Цикл
			СтрокаОбъекта = СтрокаДерева.ПолучитьЭлементы().Добавить();
			СтрокаОбъекта.Объект = ЭлементМассива;
		КонецЦикла;
		
	КонецЕсли;   	
	//--#1866 смарт: Лопато 18.06.2024
	
КонецПроцедуры //--#1323 смарт: Лопато 23.03.2023
