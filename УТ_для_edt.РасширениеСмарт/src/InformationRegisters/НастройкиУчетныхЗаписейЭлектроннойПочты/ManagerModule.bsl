// СтандартныеПодсистемы.УправлениеДоступом

// Параметры:
//   Ограничение - см. УправлениеДоступомПереопределяемый.ПриЗаполненииОграниченияДоступа.Ограничение.
//
&ИзменениеИКонтроль("ПриЗаполненииОграниченияДоступа")
Процедура смарт_ПриЗаполненииОграниченияДоступа(Ограничение)
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(УчетнаяЗаписьЭлектроннойПочты)
	|	ИЛИ ЗначениеРазрешено(УчетнаяЗаписьЭлектроннойПочты.ВладелецУчетнойЗаписи, ПустаяСсылка КАК Ложь)";
	
	#Вставка
	
	//++ #1950 смарт: Ермаков 14.08.2024 / Доступ к уч записи почты в 1С
	// Чтение разрешается, если связка "уч.запись + пользователь" заявлены в регистре сведений CRM_УчетныеЗаписиЭлектроннойПочты
	// Запись разрешается, если связка "уч.запись + пользователь + Запись = Истина" заявлены в регистре сведений CRM_УчетныеЗаписиЭлектроннойПочты	
	Ограничение.Текст = "
	|ПрисоединитьДополнительныеТаблицы
	|	ЭтотСписок КАК ЭтотСписок
    |
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписиЧтение 
	|	ПО 
	|		УчетныеЗаписиЧтение.УчетнаяЗапись = ЭтотСписок.УчетнаяЗаписьЭлектроннойПочты
	|
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.CRM_УчетныеЗаписиЭлектроннойПочты КАК УчетныеЗаписиЗапись 
	|	ПО 
	|		УчетныеЗаписиЗапись.УчетнаяЗапись = ЭтотСписок.УчетнаяЗаписьЭлектроннойПочты
	|       И УчетныеЗаписиЗапись.Запись
	|;    
	|РазрешитьЧтение
	|ГДЕ
	|	ЧтениеОбъектаРазрешено(УчетнаяЗаписьЭлектроннойПочты)
	|	ИЛИ ЗначениеРазрешено(УчетнаяЗаписьЭлектроннойПочты.ВладелецУчетнойЗаписи, ПустаяСсылка КАК Ложь)
	|	ИЛИ ЗначениеРазрешено(УчетныеЗаписиЧтение.Пользователь, NULL КАК Ложь)
	|;
	|РазрешитьИзменениеЕслиРазрешеноЧтение
	|ГДЕ
	|	ЗначениеРазрешено(УчетнаяЗаписьЭлектроннойПочты)
	|	ИЛИ ЗначениеРазрешено(УчетнаяЗаписьЭлектроннойПочты.ВладелецУчетнойЗаписи, ПустаяСсылка КАК Ложь)
	|	ИЛИ ЗначениеРазрешено(УчетныеЗаписиЗапись.Пользователь, NULL КАК Ложь)
	|";
	//-- #1950 смарт: Ермаков 14.08.2024
	
	#КонецВставки

КонецПроцедуры

