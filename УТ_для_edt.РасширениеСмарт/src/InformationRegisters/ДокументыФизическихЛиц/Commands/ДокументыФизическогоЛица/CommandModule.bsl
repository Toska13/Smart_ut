
#Область ПеренесеноСДоработкамиСмарт

&НаКлиенте
&ИзменениеИКонтроль("ОбработкаКоманды")
Процедура смарт_ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)

	Отборы = Новый Структура;
	Отборы.Вставить("Физлицо", ПараметрКоманды);

	ПараметрыФормы = Новый Структура("Отбор", Отборы);
	
	#Вставка
	//++ #1644 смарт: Ермаков 19.04.2024 / Изменить доступ к документам физических лиц
	смартОбработатьПараметрыФормы(ПараметрыФормы);
	//-- #1644 смарт: Ермаков 19.04.2024
	#КонецВставки
	
	ОткрытьФорму("РегистрСведений.ДокументыФизическихЛиц.Форма.ДокументыФизическогоЛица", ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно);

КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

&НаСервере
Процедура смартОбработатьПараметрыФормы(Параметры) //++ #1644 смарт: Ермаков 19.04.2024 / Изменить доступ к документам физических лиц
	
	//++ #1644 смарт: Ермаков 19.04.2024 / Изменить доступ к документам физических лиц
	Пользователь = Пользователи.АвторизованныйПользователь();
	ФизическоеЛицо = Параметры.Отбор.Физлицо;
	
	ПросмотрРазрешен = 
		ФизическоеЛицо.смартВидФизическогоЛица = Перечисления.смартВидыФизическихЛиц.ПустаяСсылка()
		Или
		Пользователь.смартДоступныДанныеВнутреннихФизическихЛиц
			И ФизическоеЛицо.смартВидФизическогоЛица = Перечисления.смартВидыФизическихЛиц.Внутренний
		Или
		Пользователь.смартДоступныДанныеВнешнихФизическихЛиц
			И ФизическоеЛицо.смартВидФизическогоЛица = Перечисления.смартВидыФизическихЛиц.Внешний;
			
	Если Не ПросмотрРазрешен Тогда 
		
		Параметры.Отбор.Физлицо = Справочники.ФизическиеЛица.ПустаяСсылка();
		Параметры.Вставить("ТолькоПросмотр", Истина);
		
	КонецЕсли;
	//-- #1644 смарт: Ермаков 19.04.2024
	
КонецПроцедуры //-- #1644 смарт: Ермаков 19.04.2024

#КонецОбласти