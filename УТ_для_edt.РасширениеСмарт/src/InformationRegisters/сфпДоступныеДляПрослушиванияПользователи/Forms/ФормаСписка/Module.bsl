&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ИмяСписка = "КонтролирующиеПользователи";
	ТипыРеквизита = Новый Массив;                             
	ТипыРеквизита.Добавить(Тип("ДинамическийСписок"));
	ОписаниеТиповДляРеквизита = Новый ОписаниеТипов(ТипыРеквизита); 
	ДинамическийСписок = Новый РеквизитФормы(ИмяСписка, ОписаниеТиповДляРеквизита,, "", Ложь); 
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(ДинамическийСписок);        
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);        
	РеквизитДинамическийСписок 						= ЭтаФорма[ИмяСписка]; 
	РеквизитДинамическийСписок.ПроизвольныйЗапрос 	= Истина;
	РеквизитДинамическийСписок.ТекстЗапроса 		= ПолучитьТекстЗапросаКонтролирующихПользователей();
	
	ЭлементОтбора = РеквизитДинамическийСписок.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("КонтролируемыйПользователь");
	ЭлементОтбора.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование    = Истина;
	ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	ЭлементОтбора.ПравоеЗначение   = ЭтаФорма.ПользовательВладелец; 
	
	ЭлементПорядка = РеквизитДинамическийСписок.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("КонтролирующийПользователь.Наименование");
 	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ЭлементПорядка.Использование    = Истина;
	
	ТаблицаФормы = Элементы.Добавить(ИмяСписка, Тип("ТаблицаФормы"), Элементы.ГруппаСписок);
	ТаблицаФормы.ПутьКДанным = ИмяСписка; 
	
	Элементы[ИмяСписка].ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	НоваяКолонкаТаблицы = Элементы.Добавить(ИмяСписка + "КонтролирующийПользователь", Тип("ПолеФормы"), ТаблицаФормы);
	НоваяКолонкаТаблицы.ПутьКДанным = ИмяСписка + ".КонтролирующийПользователь"; 
	НоваяКолонкаТаблицы.Заголовок = "Контролирующий пользователь";
	
КонецПроцедуры

&НаКлиенте
Процедура смарт_ПользователиПриАктивизацииСтрокиПосле(Элемент)
	
	Если НЕ Элементы.ГруппаПользователи.Видимость Тогда
		Возврат;
	КонецЕсли;

	ТекДанные = Элементы.Пользователи.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		  ПользовательВладелец = ТекДанные.Ссылка;
	Иначе ПользовательВладелец = "";
	КонецЕсли;
	
	ТекОтбор = ЭтаФорма["КонтролирующиеПользователи"].Отбор.Элементы[0];
	ТекОтбор.ПравоеЗначение = ПользовательВладелец;
	ТекОтбор.Использование = Истина;

КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаКонтролирующихПользователей()
	Возврат "
	|ВЫБРАТЬ
	|	сфпДоступныеДляПрослушиванияПользователи.Пользователь КАК КонтролирующийПользователь,
	|	сфпДоступныеДляПрослушиванияПользователи.КонтролируемыйПользователь КАК КонтролируемыйПользователь
	|ИЗ
	|	РегистрСведений.сфпДоступныеДляПрослушиванияПользователи КАК сфпДоступныеДляПрослушиванияПользователи
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	СоставыГруппПользователей.ГруппаПользователей,
	|	сфпДоступныеДляПрослушиванияПользователи.Пользователь,
	|	СоставыГруппПользователей.Пользователь
	|ИЗ
	|	РегистрСведений.СоставыГруппПользователей КАК СоставыГруппПользователей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.сфпДоступныеДляПрослушиванияПользователи КАК сфпДоступныеДляПрослушиванияПользователи
	|		ПО (сфпДоступныеДляПрослушиванияПользователи.КонтролируемыйПользователь = СоставыГруппПользователей.ГруппаПользователей)
	|ГДЕ
	|	НЕ СоставыГруппПользователей.ГруппаПользователей = СоставыГруппПользователей.Пользователь";
КонецФункции

