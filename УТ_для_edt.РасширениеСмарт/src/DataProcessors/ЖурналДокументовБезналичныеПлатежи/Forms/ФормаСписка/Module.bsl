//++ смарт:балашов #865 24.05.2023 
&НаСервере
Функция смартПолучитьГруппуПользовательскойНастройки(НастройкиПользователя)
	//ЕстьНастройки = НастройкиПользователя.Количество() > 0; 
	ГруппаОтбора = Неопределено;
	Результат = Новый Соответствие;
	Результат.Вставить("ГруппаОтбора");
	Результат.Вставить("ЭлементНастройки");
	
	Если НастройкиПользователя <> Неопределено Тогда          
		Для Каждого НастройкаП Из НастройкиПользователя Цикл
			Если ТипЗнч(НастройкаП) = Тип("ОтборКомпоновкиДанных") Тогда
				Результат["ЭлементНастройки"] = НастройкаП;
				ПолеДата = Новый ПолеКомпоновкиДанных("Дата"); 
				Для Каждого ЭлементНастройкиП Из НастройкаП.Элементы Цикл
					Если (ТипЗнч(ЭлементНастройкиП) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")) и (ЭлементНастройкиП.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ) Тогда
						ГруппаОтбора = ЭлементНастройкиП;		
						Результат["ГруппаОтбора"] = ГруппаОтбора;
						Прервать;
					КонецЕсли;	
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;                   

	Возврат Результат;
КонецФункции	
//-- смарт:балашов #865 24.05.2023 

//++ смарт:балашов #865 24.05.2023
&НаСервере
Процедура смартДобавлениеОтбораПоДатаДокумента()
	//++проверка на существующий отбор пользоватоеля по дате 19.05.23
	НастройкиПользователя = СписокПлатежей.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы;
	Результат = смартПолучитьГруппуПользовательскойНастройки(НастройкиПользователя);
	ГруппаОтбора = Результат["ГруппаОтбора"];
	НастройкаП   = Результат["ЭлементНастройки"];
	ПолеДата = Новый ПолеКомпоновкиДанных("Дата"); 

	Если ГруппаОтбора = Неопределено Тогда
		//проверим на совпадение отбора по дате             
		ГруппаОтбора = НастройкаП.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		
		ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = НачалоДня(НачалоПериода);
		ЭлементОтбора.Использование = ЗначениеЗаполнено(НачалоПериода);
 
		ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ЭлементОтбора.ПравоеЗначение = КонецДня(КонецПериода);	
		ЭлементОтбора.Использование = ЗначениеЗаполнено(КонецПериода);
	Иначе     
		Для Каждого ЭлГруппыОтбора Из ГруппаОтбора.Элементы Цикл
			Если ЭлГруппыОтбора.ЛевоеЗначение = ПолеДата И ЭлГруппыОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
				ЭлГруппыОтбора.ПравоеЗначение = НачалоДня(НачалоПериода);
				ЭлГруппыОтбора.Использование = ЗначениеЗаполнено(НачалоПериода);
			ИначеЕсли ЭлГруппыОтбора.ЛевоеЗначение = ПолеДата И ЭлГруппыОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
				ЭлГруппыОтбора.ПравоеЗначение = КонецДня(КонецПериода);
				ЭлГруппыОтбора.Использование = ЗначениеЗаполнено(КонецПериода);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры
//-- смарт:балашов #865 24.05.2023
#КонецОбласти                                

