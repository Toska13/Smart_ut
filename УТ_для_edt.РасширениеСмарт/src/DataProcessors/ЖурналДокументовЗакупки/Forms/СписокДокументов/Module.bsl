
#Область ДоработкиСмарт

// Смарт Фролов+ Доп. расходы внесены
&НаКлиенте
Процедура смартДопРасходыВнесены(Команда)
	смартДопРасходыВнесеныСервер(Элементы.СписокДокументыЗакупки.ВыделенныеСтроки);
	Элементы.СписокДокументыЗакупки.Обновить();
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура смартДопРасходыВнесеныСервер(Знач МассивДокументов)
	Ответственный=Пользователи.ТекущийПользователь();
	Для Каждого Док Из МассивДокументов Цикл
		Если ТипЗнч(Док.Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда 
			смартСервер.ИзменитьДополнительноеСвойство(Док.Ссылка, "смартОтветственныйЗаДопРасходы", Ответственный);
			смартСервер.ИзменитьДополнительноеСвойство(Док.Ссылка, "смартДопРасходыВнесены", Истина);
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры
