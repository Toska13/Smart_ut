#Область ПеренесеноСДоработками

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСписокМаркируемойПродукции();

	РедактированиеАвтоматическойОтправкиДанных = ПравоДоступа(
	"Редактирование", Метаданные.Константы.ИспользоватьАвтоматическуюОтправкуПолучениеДанныхИСМП);

	РедактированиеСрокаХранения = ПравоДоступа(
	"Редактирование", Метаданные.Константы.СрокХраненияИспользованныхКодовМаркировки);

	УдалятьКодыМаркировкиИзПула = НаборКонстант.СрокХраненияИспользованныхКодовМаркировки > 0;

	// Обновление состояния элементов
	УстановитьДоступность();

	СобытияФормИСПереопределяемый.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);

	#Вставка
	//++ #Б5130 смарт: Шляпников 27.01.2026 / Маркировка радиоэлектронной продукции. Обновить в 1С УТ раздел Интеграция с ИС МП.
	Структура = Новый Структура;
	Структура.Вставить("ДатаКонтрольПроизводства", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаКонтрольВыводИзОборота", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаЗапретПродажиНемаркированныхОстатков", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаПрослеживаемостьПеремещенияМеждуМОД", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаРозницаУведомительныйРежим", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаРозницаРазрешительныйРежим", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаРозницаЛокальныйРазрешительныйРежим", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаОптКонтрольОСУ", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаОптКонтрольПоштучно", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	Структура.Вставить("ДатаКонтроляРазрешительныхДокументов", смартФормированиеИнтерфейса.ОписаниеТипаДатаВремя("Дата"));
	
	смартФормированиеИнтерфейса.СоздатьРеквизитыТаблицы(ЭтаФорма, "СписокМаркируемаяПродукция", Структура);
	
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаКонтрольПроизводства", "СписокМаркируемаяПродукция", "Производство", 1, "СписокМаркируемаяПродукция.ДатаКонтрольПроизводства");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаКонтрольВыводИзОборота", "СписокМаркируемаяПродукция", "Вывод из оборота", 1, "СписокМаркируемаяПродукция.ДатаКонтрольВыводИзОборота");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаЗапретПродажиНемаркированныхОстатков", "СписокМаркируемаяПродукция", "Запрет продаж без марок", 1, "СписокМаркируемаяПродукция.ДатаЗапретПродажиНемаркированныхОстатков");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаПрослеживаемостьПеремещенияМеждуМОД", "СписокМаркируемаяПродукция", "Перемещение между МОД", 1, "СписокМаркируемаяПродукция.ДатаПрослеживаемостьПеремещенияМеждуМОД");
	
	смартФормированиеИнтерфейса.СздГруппаКолонокТаблицыФормы(ЭтаФорма, "СписокМаркируемаяПродукцияРозница", "СписокМаркируемаяПродукция", 1,, Истина, "Розничная продажа");
	
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаРозницаУведомительныйРежим", "СписокМаркируемаяПродукцияРозница", "УР", 1, "СписокМаркируемаяПродукция.ДатаРозницаУведомительныйРежим");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаОбязательногоВключенияРазрешительногоРежима", "СписокМаркируемаяПродукцияРозница", "РР", 1, "СписокМаркируемаяПродукция.ДатаРозницаРазрешительныйРежим");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаОбязательногоВключенияЛокальнойПроверкиРазрешительногоРежима", "СписокМаркируемаяПродукцияРозница", "ЛМ ЧЗ", 1, "СписокМаркируемаяПродукция.ДатаРозницаЛокальныйРазрешительныйРежим");
	
	смартФормированиеИнтерфейса.СздГруппаКолонокТаблицыФормы(ЭтаФорма, "СписокМаркируемаяПродукцияОпт", "СписокМаркируемаяПродукция", 1,, Истина, "Оптовая продажа");
	
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаОптКонтрольОСУ", "СписокМаркируемаяПродукцияОпт", "УР", 1, "СписокМаркируемаяПродукция.ДатаОптКонтрольОСУ");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаОптКонтрольПоштучно", "СписокМаркируемаяПродукцияОпт", "РР", 1, "СписокМаркируемаяПродукция.ДатаОптКонтрольПоштучно");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "СписокМаркируемаяПродукцияДатаКонтроляРазрешительныхДокументов", "СписокМаркируемаяПродукцияОпт", "ЛМ ЧЗ", 1, "СписокМаркируемаяПродукция.ДатаКонтроляРазрешительныхДокументов");
	
	Элементы.СписокМаркируемаяПродукция.РастягиватьПоГоризонтали = Истина;
	
	смарт_ЗаполнитьСписокМаркируемойПродукции();
	//-- #Б5130 смарт: Шляпников 27.01.2026
	#КонецВставки
	
КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ЗаполнитьСписокМаркируемойПродукции")
Процедура смарт_ЗаполнитьСписокМаркируемойПродукции()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НастройкиУчетаМаркируемойПродукции.ВестиУчетПродукции ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ НастройкиУчетаМаркируемойПродукции.ВестиУчетПродукции
	|	КОНЕЦ КАК ВестиУчетПродукции,
	|	ВидыПродукции.Ссылка КАК ВидПродукции,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ВидыПродукции.Ссылка) КАК ВидПродукцииПредставление,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаОбязательнойМаркировки, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаОбязательнойМаркировки
	#Вставка
	//++ #Б5130 смарт: Шляпников 27.01.2026 / Маркировка радиоэлектронной продукции. Обновить в 1С УТ раздел Интеграция с ИС МП.
	|	,ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаКонтрольПроизводства, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаКонтрольПроизводства,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаКонтрольВыводИзОборота, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаКонтрольВыводИзОборота,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаЗапретПродажиНемаркированныхОстатков, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаЗапретПродажиНемаркированныхОстатков,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаПрослеживаемостьПеремещенияМеждуМОД, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаПрослеживаемостьПеремещенияМеждуМОД,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаРозницаУведомительныйРежим, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаРозницаУведомительныйРежим,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаРозницаРазрешительныйРежим, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаРозницаРазрешительныйРежим,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаРозницаЛокальныйРазрешительныйРежим, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаРозницаЛокальныйРазрешительныйРежим,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаОптКонтрольОСУ, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаОптКонтрольОСУ,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаОптКонтрольПоштучно, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаОптКонтрольПоштучно,
	|	ЕСТЬNULL(НастройкиУчетаМаркируемойПродукции.ДатаКонтроляРазрешительныхДокументов, ДАТАВРЕМЯ(0001, 01, 01)) КАК
	|		ДатаКонтроляРазрешительныхДокументов
	//-- #Б5130 смарт: Шляпников 27.01.2026
	#КонецВставки
	|ИЗ
	|	Перечисление.ВидыПродукцииИС КАК ВидыПродукции
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиУчетаМаркируемойПродукцииИСМП КАК НастройкиУчетаМаркируемойПродукции
	|		ПО ВидыПродукции.Ссылка = НастройкиУчетаМаркируемойПродукции.ВидПродукции,
	|	Константы КАК Константы
	|ГДЕ
	|	ВидыПродукции.Ссылка В (&ВидыПродукцииИСМП)
	|");

	Запрос.УстановитьПараметр("ВидыПродукцииИСМП", ИнтеграцияИСКлиентСервер.ВидыПродукцииИСМП(Истина));

	ДоступныеВидыПродукции = Запрос.Выполнить().Выгрузить();
	ДоступныеВидыПродукции.Сортировать("ВидПродукцииПредставление Возр");

	СписокМаркируемаяПродукция.Загрузить(ДоступныеВидыПродукции);

КонецПроцедуры

#КонецОбласти