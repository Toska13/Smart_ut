	Иначе
		Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение";
	КонецЕсли;
    Элементы.смартОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	//-- #1351 смарт: Фролов 05.05.2023
КонецПроцедуры

&НаКлиенте
Процедура смарт_ТоварыНоменклатураПриИзмененииПосле(Элемент)		
	//++смарт:Демичев #895 26012023
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Товар = ТекущаяСтрока.Номенклатура;
	
	Результат = смартОбщегоНазначения.смартПроверитьНаПрослеживаемостьНаСервере(Товар);	
	ТекущаяСтрока.смартПрослеживаемыйТовар = Результат;
	
	Если Результат Тогда 		
		смартОбщегоНазначенияКлиент.смартВывестиПредупреждениеПользователюОПрослеживаемомТоваре();  		
	КонецЕсли;
	//-- смарт:Демичев #895 26012023
    //++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах  
	Элементы.смартОстаткиПоОрганизациям.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
	ЭтаФорма.смартГруппаОстаткиРазвернута=Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Элементы.смартГруппаОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Если ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
	    Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Развернуть предупреждение. ВНИМАНИЕ! Есть ограничения по товарам организации";
	Иначе
		Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение";
	КонецЕсли;
    Элементы.смартОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	//-- #1351 смарт: Фролов 05.05.2023
	
	//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
	смартУстановитьВСтрокеПроцентИндивидуальнойСкидкиПоНоменклатуре(ТекущаяСтрока);
	//--#1868 смарт: Лопато 19.06.2024
	
	//++ #3946 смарт: Шляпников 31.07.2025 / Настройка правил продаж чернил МАРАБУ (Ковчег)
	ПравильныеДанныеПоОрганизации = смартСервер.ПолучитьПравильнуюОрганизациюИСоглашениеПоЗаказу(Объект);
	Если ПравильныеДанныеПоОрганизации.Организация <> Объект.Организация Тогда
		УстановитьПравильнуюОрганизациюИСоглашение(ПравильныеДанныеПоОрганизации);
	КонецЕсли;
	//-- #3946 смарт: Шляпников 31.07.2025
	
КонецПроцедуры 

&НаКлиенте
Процедура смарт_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)	
	//++смарт:Демичев #895 26012023
	смартОбработкаВыбораПослеНаСервере(ВыбранноеЗначение); 
	//-- смарт:Демичев #895 26012023	
    //++ #1351 смарт: Фролов 15.05.2023 //Разделение остатков по организациям в заказах 
	Если ТипЗнч(ВыбранноеЗначение)=Тип("Структура") И ВыбранноеЗначение.Свойство("Значение") И ТипЗнч(ВыбранноеЗначение.Значение)=Тип("СправочникСсылка.СерииНоменклатуры") ТОгда
		РезультатПроверки=смартПроверитьСериюПоОрганизации(ВыбранноеЗначение.Значение); 
		Если Не РезультатПроверки Тогда
			Сообщить("Серия "+ВыбранноеЗначение.Значение+" не принадлежит организации "+Объект.Организация+"");
			ТекСтрока=Элементы.Товары.ТекущиеДанные;
			ТекСтрока.Серия=Неопределено;	
		КонецЕсли;	
	КонецЕсли; 
	Если ИсточникВыбора.ИмяФормы="Перечисление.ВариантыОбеспечения.Форма.ИсполнениеЗаказа" ТОгда
		Для Каждого Стр Из Элементы.Товары.Выделенныестроки Цикл
			ТекСтрока=Объект.Товары[Стр];
			Если ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить")
				ИЛИ ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада") 
				ИЛИ ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов") Тогда
				РезультатПроверки=смартПроверитьОстаткиПоСтрокеПоОрганизации(ТекСтрока.Номенклатура,ТекСтрока.Характеристика);
				Если ТекСтрока.КоличествоУпаковок>РезультатПроверки Тогда
					Сообщить("Не достаточно товара "+ТекСтрока.Номенклатура+" в организации "+Объект.Организация+" доступно "+РезультатПроверки+"");
					смартИзменитьОбеспечение(ТекСтрока.НомерСтроки-1);
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
	ИначеЕсли ИсточникВыбора.ИмяФормы="Перечисление.ВариантыОбеспечения.Форма.ВыборВариантаОбеспечения" ТОгда
		ТекСтрока=Элементы.Товары.ТекущиеДанные;
		Если ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить")
			ИЛИ ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.СоСклада") 
			ИЛИ ТекСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов") Тогда
			РезультатПроверки=смартПроверитьОстаткиПоСтрокеПоОрганизации(ТекСтрока.Номенклатура,ТекСтрока.Характеристика);
			Если ТекСтрока.КоличествоУпаковок>РезультатПроверки Тогда
				Сообщить("Не достаточно товара "+ТекСтрока.Номенклатура+" в организации "+Объект.Организация+" доступно "+РезультатПроверки+"");
				смартИзменитьОбеспечение(ТекСтрока.НомерСтроки-1);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	Элементы.смартОстаткиПоОрганизациям.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
	ЭтаФорма.смартГруппаОстаткиРазвернута=Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Элементы.смартГруппаОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Если ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
	    Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Развернуть предупреждение. ВНИМАНИЕ! Есть ограничения по товарам организации";
	Иначе
		Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение";
	КонецЕсли;
    Элементы.смартОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	//-- #1351 смарт: Фролов 15.05.2023
КонецПроцедуры

&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	//++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах
	МассивРеквизитов = Новый Массив;
	Реквизит_смартГруппаОстаткиРазвернута = Новый РеквизитФормы("смартГруппаОстаткиРазвернута", Новый ОписаниеТипов("Булево"));
	МассивРеквизитов.Добавить(Реквизит_смартГруппаОстаткиРазвернута);
	
	Реквизит_смартНадписьОстаткиПоОрганизациямПредыдущий = Новый РеквизитФормы("смартНадписьОстаткиПоОрганизациямПредыдущий", Новый ОписаниеТипов("Строка"));
	МассивРеквизитов.Добавить(Реквизит_смартНадписьОстаткиПоОрганизациямПредыдущий);
	
	Реквизит_смартСписокСкладов = Новый РеквизитФормы("смартСписокСкладов", Новый ОписаниеТипов("СписокЗначений"));
	МассивРеквизитов.Добавить(Реквизит_смартСписокСкладов);
	
	ИзменитьРеквизиты(МассивРеквизитов); 
	
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Склады.Ссылка КАК Склад
			|ИЗ
			|	Справочник.Склады КАК Склады
			|ГДЕ
			|	Склады.смартНазначениеСклада В(&Назначения)
			|	И НЕ Склады.ПометкаУдаления");
	МасНазначений=Новый Массив;
	МасНазначений.Добавить(Перечисления.смартНазначенияСкладов.ТорговыйСклад);
	МасНазначений.Добавить(Перечисления.смартНазначенияСкладов.ДемоЗал);
	МасНазначений.Добавить(Перечисления.смартНазначенияСкладов.ПустаяСсылка());
	Запрос.УстановитьПараметр("Назначения",МасНазначений); 
	ЭтаФорма.смартСписокСкладов.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад"));
 	
    ГруппаОстатки = Элементы.Вставить("смартГруппаОстаткиПоОрганизациям", Тип("ГруппаФормы"), Элементы.ГруппаТоварыКорзины,Элементы.Товары);
    ГруппаОстатки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    ГруппаОстатки.ОтображатьЗаголовок = Ложь; 
    ГруппаОстатки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда; 
	
    НовыйЭлемент = Элементы.Добавить("смартСтрелкаВниз", Тип("ДекорацияФормы"),Элементы.смартГруппаОстаткиПоОрганизациям);
    НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
    НовыйЭлемент.Картинка=БиблиотекаКартинок.СтрелкаВнизЗеленая; 
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие","смартСвернутьРазвернутьОстаткиПоОрганизациям");
	
    НовыйЭлемент = Элементы.Добавить("смартНадписьОстаткиПоОрганизациям", Тип("ДекорацияФормы"),Элементы.смартГруппаОстаткиПоОрганизациям);
    НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
    НовыйЭлемент.ЦветТекста=Новый Цвет(255,0,0); 
	НовыйЭлемент.Ширина=150;
	НовыйЭлемент.Шрифт=Новый Шрифт(НовыйЭлемент.Шрифт,,,Истина);
	
	НовыйЭлемент = ЭтаФорма.Элементы.Вставить("смартОстаткиПоОрганизациям", Тип("ДекорацияФормы"),Элементы.ГруппаТоварыКорзины,Элементы.Товары);
    НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
    НовыйЭлемент.ЦветТекста=Новый Цвет(255,0,0);
	НовыйЭлемент.Шрифт=Новый Шрифт(НовыйЭлемент.Шрифт,,,Истина);
	НовыйЭлемент.Ширина=150;
    НовыйЭлемент.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
    НовыйЭлемент.Видимость=НЕ НовыйЭлемент.Заголовок="";
	
	ЭтаФорма.смартГруппаОстаткиРазвернута=ЭтаФорма.смартНадписьОстаткиПоОрганизациямПредыдущий<>Элементы.смартОстаткиПоОрганизациям.Заголовок;
	Элементы.смартГруппаОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Если ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
		Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение";
	Иначе
	    Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Развернуть предупреждение. ВНИМАНИЕ! Есть ограничения по товарам организации";
	КонецЕсли;
	ЭтаФорма.смартНадписьОстаткиПоОрганизациямПредыдущий=Элементы.смартОстаткиПоОрганизациям.Заголовок;
	//-- #1351 смарт: Фролов 05.05.2023
	
	//++#1873 смарт: Лопато 25.06.2024 //Убрать произвольную цену в помощнике продаж и подборе товара (прод 914)
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Новый ПараметрВыбора("ВыводитьПроизвольныйВидЦен",   Ложь));
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ИспользоватьПриПродаже", Истина));
	МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Статус", 				   Перечисления.СтатусыДействияВидовЦен.Действует));
	
	Элементы.ТоварыВидЦены.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	//--#1873 смарт: Лопато 25.06.2024
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "ПартнерБезКЛ");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
КонецПроцедуры 

&НаКлиенте
Процедура смарт_ТоварыХарактеристикаПриИзмененииПосле(Элемент)
    //++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах  
	Элементы.смартОстаткиПоОрганизациям.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
	Элементы.смартГруппаОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Если НЕ ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
    	Элементы.смартОстаткиПоОрганизациям.Видимость=ЭтаФорма.смартНадписьОстаткиПоОрганизациямПредыдущий<>Элементы.смартОстаткиПоОрганизациям.Заголовок;
		ЭтаФорма.смартГруппаОстаткиРазвернута=ЭтаФорма.смартНадписьОстаткиПоОрганизациямПредыдущий<>Элементы.смартОстаткиПоОрганизациям.Заголовок;
		Если ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
			Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение";
		Конецесли;
	КонецЕсли;
	ЭтаФорма.смартНадписьОстаткиПоОрганизациямПредыдущий=Элементы.смартОстаткиПоОрганизациям.Заголовок;
	//-- #1351 смарт: Фролов 05.05.2023
КонецПроцедуры

&НаКлиенте
Процедура смарт_ТоварыСкладПриИзмененииПосле(Элемент)
    //++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах  
	Элементы.смартОстаткиПоОрганизациям.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
