&НаКлиенте
&После("ОбработкаВыбораПодборНаКлиенте")
Процедура смарт_ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение)
	//++#895 смарт: Демичев 28.12.2022((
	смартОбщегоНазначенияКлиент.смартОбработкаВыбораТоваров(ВыбранноеЗначение);
	//--#895 смарт: Демичев 28.12.2022))
    //++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах  
	Элементы.смартОстаткиПоОрганизациям.Заголовок = смартУстановитьЗаголовокОстаткиПоОрганизациям();
	ЭтаФорма.смартГруппаОстаткиРазвернута=Элементы.смартОстаткиПоОрганизациям.Заголовок="";
	Элементы.смартГруппаОстаткиПоОрганизациям.Видимость=НЕ Элементы.смартОстаткиПоОрганизациям.Заголовок="";
