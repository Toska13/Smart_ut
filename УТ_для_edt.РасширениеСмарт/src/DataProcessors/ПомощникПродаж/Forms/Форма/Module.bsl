								ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Номенклатура "+Стр.Номенклатура+" есть на складе "+СтрРезСклад.Склад+", организации "+СтрРезСклад.Организация+" в количестве "+СтрРезСклад.Остаток+" ожидается "+СтрРезСклад.ОжидаемыйПриход+"";
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;	
				Иначе
					СтрокиРез=Рез.НайтиСтроки(Новый Структура("Организация,Номенклатура,Характеристика",Объект.Организация,Стр.Номенклатура,Стр.Характеристика));
					Для Каждого СтрРезСклад Из СтрокиРез Цикл 
