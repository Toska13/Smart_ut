//++ #1351 смарт: Фролов 15.05.2023 //Разделение остатков по организациям в заказах  
&НаСервере
Функция смартПроверитьСериюПоОрганизации(Серия)
	Запрос=Новый Запрос("  ВЫБРАТЬ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия КАК Серия,
			|	ТоварыОрганизацийОбороты.Организация КАК Организация,
			|	СУММА(ТоварыОрганизацийОбороты.КоличествоПриход) КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыОрганизаций.Обороты КАК ТоварыОрганизацийОбороты
			|ГДЕ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия = &Серия
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия,
			|	ТоварыОрганизацийОбороты.Организация");
	Запрос.УстановитьПараметр("Серия",Серия);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда
		Нашли=Ложь;
		Для Каждого Стр Из Рез Цикл
			Если Стр.Организация=Объект.Организация ТОгда
				Нашли=Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли ТОгда
			Возврат Ложь; 
		Иначе	
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;	
КонецФункции //-- #1351 смарт: Фролов 15.05.2023

//++ #1351 смарт: Фролов 25.05.2023 //Разделение остатков по организациям в заказах  
Функция смартПроверитьОстаткиПоСтрокеПоОрганизации(Номенклатура,Характеристика)
	Если Номенклатура.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Услуга 
		ИЛИ Номенклатура.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Работа ТОгда
		Возврат 10000000;
	КонецЕсли;	
		
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Организация КАК Организация,
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.Характеристика КАК Характеристика,
			|	СУММА(ВЫБОР
			|			КОГДА ВложенныйЗапрос.Своб >= ВложенныйЗапрос.Орг
			|				ТОГДА ВложенныйЗапрос.Орг
			|			ИНАЧЕ ВложенныйЗапрос.Своб
			|		КОНЕЦ) КАК Остаток,
			|	СУММА(ВложенныйЗапрос.Своб) КАК СвобОстаток,
			|	СУММА(ВложенныйЗапрос.Орг) КАК ОргОстаток,
			|	СУММА(ВложенныйЗапрос.ОжидаемыйПриход) КАК ОжидаемыйПриход,
			|	СУММА(ВложенныйЗапрос.ОжидаемыйРасход) КАК ОжидаемыйРасход,
			|	СУММА(ВложенныйЗапрос.Резерв) КАК Резерв
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиОрганизаций.Организация КАК Организация,
			|		ОстаткиОрганизаций.Номенклатура КАК Номенклатура,
			|		ОстаткиОрганизаций.Характеристика КАК Характеристика,
			|		СУММА(0) КАК Остаток,
			|		СУММА(ЕСТЬNULL(СвободныеОстатки.Остаток, 0)) КАК Своб,
			|		СУММА(ЕСТЬNULL(ОстаткиОрганизаций.КоличествоОстаток, 0)) КАК Орг,
			|		СУММА(0) КАК ОжидаемыйПриход,
			|		СУММА(0) КАК ОжидаемыйРасход,
			|		СУММА(0) КАК Резерв
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ТоварыОрганизацийОстатки.Организация КАК Организация,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК МестоХранения,
			|			СУММА(ТоварыОрганизацийОстатки.КоличествоОстаток) КАК КоличествоОстаток
			|		ИЗ
			|			РегистрНакопления.ТоварыОрганизаций.Остатки(
			|					,
			|					АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
			|						И АналитикаУчетаНоменклатуры.Характеристика = &Характеристика
			|						И АналитикаУчетаНоменклатуры.МестоХранения В (&СпсСкладов)
			|						И Организация = &Организация) КАК ТоварыОрганизацийОстатки
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ТоварыОрганизацийОстатки.Организация,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения) КАК ОстаткиОрганизаций
			|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
			|				ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
			|				ТоварыНаСкладахОстатки.Склад КАК Склад,
			|				СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Остаток
			|			ИЗ
			|				РегистрНакопления.ТоварыНаСкладах.Остатки(
			|						,
			|						Номенклатура = &Номенклатура
			|							И Характеристика = &Характеристика
			|							И Склад В (&СпсСкладов)) КАК ТоварыНаСкладахОстатки
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ТоварыНаСкладахОстатки.Номенклатура,
			|				ТоварыНаСкладахОстатки.Характеристика,
			|				ТоварыНаСкладахОстатки.Склад) КАК СвободныеОстатки
			|			ПО ОстаткиОрганизаций.Номенклатура = СвободныеОстатки.Номенклатура
			|				И ОстаткиОрганизаций.Характеристика = СвободныеОстатки.Характеристика
			|				И ОстаткиОрганизаций.МестоХранения = СвободныеОстатки.Склад
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ОстаткиОрганизаций.Организация,
			|		ОстаткиОрганизаций.Номенклатура,
			|		ОстаткиОрганизаций.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
			|		ТоварыКПоступлениюОстатки.Номенклатура,
			|		ТоварыКПоступлениюОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ТоварыКПоступлениюОстатки.КОформлениюОрдеровОстаток),
			|		СУММА(0),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ТоварыКПоступлению.Остатки(
			|				,
			|				ДокументПоступления ССЫЛКА Документ.ЗаказПоставщику
			|					И Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И Склад В (&СпсСкладов)
			|					И ДокументПоступления.Организация = &Организация) КАК ТоварыКПоступлениюОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
			|		ТоварыКПоступлениюОстатки.Номенклатура,
			|		ТоварыКПоступлениюОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
			|		ТоварыКОтгрузкеОстатки.Номенклатура,
			|		ТоварыКОтгрузкеОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ТоварыКОтгрузке.Остатки(
			|				,
			|				Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И Склад В (&СпсСкладов)
			|					И ДокументОтгрузки.Организация = &Организация) КАК ТоварыКОтгрузкеОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
			|		ТоварыКОтгрузкеОстатки.Номенклатура,
			|		ТоварыКОтгрузкеОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ЗаказыНаСборкуОстатки.ЗаказНаСборку.Организация,
			|		ЗаказыНаСборкуОстатки.Номенклатура,
			|		ЗаказыНаСборкуОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ЗаказыНаСборкуОстатки.ЗаказаноОстаток),
			|		СУММА(0),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ЗаказыНаСборку.Остатки(
			|				,
			|				Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И ЗаказНаСборку.Склад В (&СпсСкладов)
			|					И ЗаказНаСборку.Организация = &Организация) КАК ЗаказыНаСборкуОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ЗаказыНаСборкуОстатки.ЗаказНаСборку.Организация,
			|		ЗаказыНаСборкуОстатки.Номенклатура,
			|		ЗаказыНаСборкуОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ОстаткиПоЗаказам.ЗаказКлиента.Организация,
			|		ОстаткиПоЗаказам.Номенклатура,
			|		ОстаткиПоЗаказам.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ВЫБОР
			|				КОГДА ОстаткиПоЗаказам.ЗаказаноОстаток > Заказы.КоличествоУпаковок
			|					ТОГДА Заказы.КоличествоУпаковок
			|				ИНАЧЕ ОстаткиПоЗаказам.ЗаказаноОстаток
			|			КОНЕЦ)
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ЗаказыКлиентовОстатки.ЗаказКлиента КАК ЗаказКлиента,
			|			ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
			|			ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
			|			ЗаказыКлиентовОстатки.ЗаказКлиента.Организация КАК ЗаказКлиентаОрганизация,
			|			СУММА(ЗаказыКлиентовОстатки.ЗаказаноОстаток) КАК ЗаказаноОстаток,
			|			ЗаказыКлиентовОстатки.Склад КАК Склад
			|		ИЗ
			|			РегистрНакопления.ЗаказыКлиентов.Остатки(
			|					,
			|					Номенклатура = &Номенклатура
			|						И Характеристика = &Характеристика
			|						И Склад В (&СпсСкладов)
			|						И ЗаказКлиента.Организация = &Организация) КАК ЗаказыКлиентовОстатки
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ЗаказыКлиентовОстатки.ЗаказКлиента,
			|			ЗаказыКлиентовОстатки.Номенклатура,
			|			ЗаказыКлиентовОстатки.Характеристика,
			|			ЗаказыКлиентовОстатки.ЗаказКлиента.Организация,
			|			ЗаказыКлиентовОстатки.Склад) КАК ОстаткиПоЗаказам
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
			|				ЗаказКлиентаТовары.Характеристика КАК Характеристика,
			|				ЗаказКлиентаТовары.Ссылка КАК Ссылка,
			|				СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоУпаковок,
			|				ЗаказКлиентаТовары.Склад КАК Склад
			|			ИЗ
			|				Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|			ГДЕ
			|				ЗаказКлиентаТовары.ВариантОбеспечения В(&ВариантыОбеспечения)
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ЗаказКлиентаТовары.Номенклатура,
			|				ЗаказКлиентаТовары.Характеристика,
			|				ЗаказКлиентаТовары.Ссылка,
			|				ЗаказКлиентаТовары.Склад) КАК Заказы
			|			ПО ОстаткиПоЗаказам.Номенклатура = Заказы.Номенклатура
			|				И ОстаткиПоЗаказам.Характеристика = Заказы.Характеристика
			|				И ОстаткиПоЗаказам.ЗаказКлиента = Заказы.Ссылка
			|				И ОстаткиПоЗаказам.Склад = Заказы.Склад
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ОстаткиПоЗаказам.ЗаказКлиента.Организация,
			|		ОстаткиПоЗаказам.Номенклатура,
			|		ОстаткиПоЗаказам.Характеристика) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Организация,
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.Характеристика
			|
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура,
			|	Организация
			|");
	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("СпсСкладов",ЭтаФорма.смартСписокСкладов);
	МасВаиантовОбеспечения=Новый Массив;
	МасВаиантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.СоСклада);
	МасВаиантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);
	Запрос.УстановитьПараметр("ВариантыОбеспечения",МасВаиантовОбеспечения);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() ТОгда
		Возврат Выборка.Остаток+Выборка.ОжидаемыйПриход-Выборка.Резерв;
	Иначе	
		Возврат 0;
	КонецЕсли;	
КонецФункции	//-- #1351 смарт: Фролов 25.05.2023

//++ #1351 смарт: Фролов 29.05.2023 //Разделение остатков по организациям в заказах  
&НаСервере
Процедура смартИзменитьОбеспечение(ИндексСтроки)
    
    МассивСтрокИндексы = Новый Массив;  
    МассивСтрокИндексы.Добавить(ИндексСтроки);
    ВО=Новый Массив;
	ВО.Добавить(Перечисления.ВариантыОбеспечения.НеТребуется);  //Не обеспечивать
	ВыбранноеЗначение=Новый Структура("ЗаполнятьЦелымиУпаковками,ПереченьВариантов",Ложь,ВО);
    
    ПараметрыЗаполнения = Новый Структура("ПереченьВариантов, ИзменятьОбособление, ЗаполнятьЦелымиУпаковками", Неопределено, Истина, Ложь);
    ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, ВыбранноеЗначение);
    ПутиКДанным = Новый Соответствие; //Описание особенностей формы
    ПутиКДанным.Вставить("ДатаОтгрузкиРабот", "ДатаОтгрузки"); // дату отгрузки работ необходимо брать из поля "Дата отгрузки".
    ПараметрыДокумента = Новый Структура;
    ПараметрыДокумента.Вставить("ГруппаСкладов", Объект.Склад);
    ПараметрыДокумента.Вставить("МенеджерРегистра", РегистрыНакопления.ЗаказыКлиентов);
    ПараметрыДокумента.Вставить("ПутиКДанным", ПутиКДанным);
    ПараметрыДокумента.Вставить("ИмяТабличнойЧасти","Товары");
    
    Таблица = ОбеспечениеСервер.ТаблицаЗаполнениеОбеспеченияДокумента(Объект,ВО,ПараметрыДокумента,МассивСтрокИндексы);
    ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект,
																									Обработки.ПомощникПродаж));
    Текст=Обработки.ПомощникПродаж.ЗаполнитьВариантОбеспечения(Объект, ЭтаФорма, "ИндексыСтрок", Таблица, ПараметрыУказанияСерий, ЗависимыеРеквизиты());  
	
КонецПроцедуры //-- #1351 смарт: Фролов 29.05.2023

//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
&НаКлиенте
Процедура смартПроверитьОтменитьСкидкуНаТоварКлиент(Объект, Стр = Неопределено, КэшированныеЗначения = Неопределено)

	СегментОтменаСкидкиНаТовар = ПолучитьСегментПоИдентификатору("ОтменаСкидкиНаТовар");

	Если Стр = Неопределено Тогда
	
		Для Каждого Стр Из Объект.Товары Цикл
		
			смартПроверитьОтменитьСкидкуНаТоварСерверОбработкаСтрокиКлиент(Объект, Стр, СегментОтменаСкидкиНаТовар, КэшированныеЗначения);
		
		КонецЦикла;
		
	Иначе
		
		смартПроверитьОтменитьСкидкуНаТоварСерверОбработкаСтрокиКлиент(Объект, Стр, СегментОтменаСкидкиНаТовар, КэшированныеЗначения);
		
	КонецЕсли;

КонецПроцедуры //--#1868 смарт: Лопато 19.06.2024

//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
&НаКлиенте
Процедура смартПроверитьОтменитьСкидкуНаТоварСерверОбработкаСтрокиКлиент(Объект, Стр, СегментОтменаСкидкиНаТовар, КэшированныеЗначения)
	
	Если Стр.ПроцентРучнойСкидки > 0 
		ИЛИ Стр.СуммаРучнойСкидки > 0 
		ИЛИ Стр.ПроцентАвтоматическойСкидки > 0 
		ИЛИ Стр.СуммаАвтоматическойСкидки > 0 Тогда
	
		Если НЕ смартДоступностьРоли("смартИсключениеОграниченияУстанавливатьРучныеСкидкиНаТоварыИзСегмента,ПолныеПрава")
			И ПроверитьВхождениеВСегмент(Стр.Номенклатура, СегментОтменаСкидкиНаТовар) Тогда
			
			//Обнуляем автоматические и ручные скидки
			СтруктураДействий = смартСтруктураДействийПересчетаСуммПослеИзмененияСкидок(Объект, Истина, Истина);
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Стр, СтруктураДействий, КэшированныеЗначения);
			
		Иначе
			
			Если (Стр.ПроцентАвтоматическойСкидки > 0 И Стр.ПроцентРучнойСкидки > 0) 
				ИЛИ (Стр.СуммаАвтоматическойСкидки > 0 И Стр.СуммаРучнойСкидки > 0) Тогда

				//Обнуляем положительную автоматическую скидку при положительной ручной
				СтруктураДействий = смартСтруктураДействийПересчетаСуммПослеИзмененияСкидок(Объект, Истина, Ложь);
				ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Стр, СтруктураДействий, КэшированныеЗначения);

			КонецЕсли;
				
		КонецЕсли;

	КонецЕсли;
		
КонецПроцедуры //--#1868 смарт: Лопато 19.06.2024

//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
