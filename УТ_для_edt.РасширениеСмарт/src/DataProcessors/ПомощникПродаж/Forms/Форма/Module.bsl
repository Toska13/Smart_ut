						Нашли=Истина;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Нашли Тогда
					//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";	
				КонецЕсли;	
			Иначе	
				//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";
			КонецЕсли;	
