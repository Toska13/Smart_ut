#Область ОбработчикиСобытийФормы

&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавляемыеРеквизиты	= Новый Массив;
	
	ОписаниеТиповЧисло1 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0));
	ОписаниеТиповЧисло10 = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(10, 0));
	ОписаниеТиповПериодичность = Новый ОписаниеТипов("ПеречислениеСсылка.Периодичность");
	
	смартПереключательНаСрокПоСтатистике = Новый РеквизитФормы("смартПереключательНаСрокПоСтатистике", ОписаниеТиповЧисло1, , "");
	ДобавляемыеРеквизиты.Добавить(смартПереключательНаСрокПоСтатистике);
	
	смартПереключательНаГлубинуАнализа = Новый РеквизитФормы("смартПереключательНаГлубинуАнализа", ОписаниеТиповЧисло1, , "");
	ДобавляемыеРеквизиты.Добавить(смартПереключательНаГлубинуАнализа);

	смартКоличествоПериодовРасчета = Новый РеквизитФормы("смартКоличествоПериодовРасчетаАнализаПродаж", ОписаниеТиповЧисло10, , "");
	ДобавляемыеРеквизиты.Добавить(смартКоличествоПериодовРасчета);
	
	смартПериодРасчета = Новый РеквизитФормы("смартПериодРасчетаАнализаПродаж", ОписаниеТиповПериодичность, , "");
	ДобавляемыеРеквизиты.Добавить(смартПериодРасчета); 
	
	смартПереключательНаСтраховойЗапас = Новый РеквизитФормы("смартПереключательНаСтраховойЗапас", ОписаниеТиповЧисло1, , "");
	ДобавляемыеРеквизиты.Добавить(смартПереключательНаСтраховойЗапас);
	
	смартКоличествоПериодовРасчета = Новый РеквизитФормы("смартКоличествоПериодовРасчетаСтраховогоЗапаса", ОписаниеТиповЧисло10, , "");
	ДобавляемыеРеквизиты.Добавить(смартКоличествоПериодовРасчета);
	
	смартПериодРасчета = Новый РеквизитФормы("смартПериодРасчетаСтраховогоЗапаса", ОписаниеТиповПериодичность, , "");
	ДобавляемыеРеквизиты.Добавить(смартПериодРасчета);
	
	смартКоличествоПериодовРасчетаКонстанта = Новый РеквизитФормы("смартКоличествоПериодовРасчетаКонстанта", ОписаниеТиповЧисло10, , "");
	ДобавляемыеРеквизиты.Добавить(смартКоличествоПериодовРасчетаКонстанта);
	
	смартПериодРасчетаКонстанта = Новый РеквизитФормы("смартПериодРасчетаКонстанта", ОписаниеТиповПериодичность, , "");
	ДобавляемыеРеквизиты.Добавить(смартПериодРасчетаКонстанта);

	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Если Параметры.РежимОткрытия = "Полный" ИЛИ Параметры.РежимОткрытия = "ТолькоПараметры" Тогда
		// Получение записи регистра Товарные ограничения.
		ЗначениеНастройки = РегистрыСведений.ТоварныеОграничения.ПараметрыПоддержанияЗапасаТовараНаСкладе(Параметры.КлючПотребности);
		ЭтаФорма["смартКоличествоПериодовРасчетаАнализаПродаж"] = ЗначениеНастройки.смартКоличествоПериодовРасчетаАнализаПродаж;
		ЭтаФорма["смартПериодРасчетаАнализаПродаж"] = ЗначениеНастройки.смартПериодРасчетаАнализаПродаж;
		ЭтаФорма["смартКоличествоПериодовРасчетаСтраховогоЗапаса"] = ЗначениеНастройки.смартКоличествоПериодовРасчетаСтраховогоЗапаса;
		ЭтаФорма["смартПериодРасчетаСтраховогоЗапаса"] = ЗначениеНастройки.смартПериодРасчетаСтраховогоЗапаса;
		ЭтаФорма["смартКоличествоПериодовРасчетаКонстанта"] = Константы.КоличествоПериодовРасчетаТоварныхОграничений.Получить();
        ЭтаФорма["смартПериодРасчетаКонстанта"] = Константы.ПериодРасчетаТоварныхОграничений.Получить(); 
		
		ЭтаФорма["смартПереключательНаГлубинуАнализа"] = ?(ЗначениеЗаполнено(ЭтаФорма["смартКоличествоПериодовРасчетаАнализаПродаж"]), 1, 0);
		ЭтаФорма["смартПереключательНаСтраховойЗапас"] = ?(ЗначениеЗаполнено(ЭтаФорма["смартКоличествоПериодовРасчетаСтраховогоЗапаса"]), 1, 0);		
	КонецЕсли;
	
	НовыйЭлемент = Элементы.Вставить("смартПереключательНаСрокПоСтатистике", Тип("ПолеФормы"), Элементы.ГруппаМетодОбеспечения);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя;
	НовыйЭлемент.ПутьКДанным = "смартПереключательНаСрокПоСтатистике";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.КоличествоКолонок = 1;
	НовыйЭлемент.СписокВыбора.Добавить(1, "Расчет по статистике (смарт)");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартПереключательНаСрокПоСтатистикеПриИзменении");
	НовыйЭлемент.Доступность = ОпределитьДоступностьНастройки(Параметры.КлючПотребности);
	
	Элементы.Переместить(Элементы.смартПереключательНаСрокПоСтатистике, Элементы.ГруппаМетодОбеспечения, Элементы.ГруппаПараметрыМетодаОтступ); 
	
	НовыйЭлемент = Элементы.Вставить("смартПодсказкаНаСрокПоСтатистике", Тип("ДекорацияФормы"), Элементы.ГруппаМетодОбеспечения);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "При снижении запаса на выбранной группе складов на срок исполнения заказа заказывается количество на обеспечиваемый период.
							|Расчет расхода товара производится по статистике потребления(продажам по всем складам).";
	НовыйЭлемент.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	Элементы.Переместить(Элементы.смартПодсказкаНаСрокПоСтатистике, Элементы.ГруппаМетодОбеспечения, Элементы.ГруппаПараметрыМетодаОтступ);
	
	//Глубина анализа
	НовыйЭлемент = Элементы.Вставить("смартГруппаГлубинаАнализа", Тип("ГруппаФормы"), Элементы.ГруппаПараметрыМетодаОтступ);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "Глубина анализа для расчета среднедневного потребления";
	НовыйЭлемент.ОтображатьЗаголовок = Истина; 
	НовыйЭлемент.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	
	НовыйЭлемент = Элементы.Вставить("смартПереключательНаГлубинуАнализа", Тип("ПолеФормы"), Элементы.смартГруппаГлубинаАнализа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя; 
	НовыйЭлемент.ПутьКДанным = "смартПереключательНаГлубинуАнализа";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.КоличествоКолонок = 1;
	НовыйЭлемент.СписокВыбора.Добавить(0, "Общие");
	НовыйЭлемент.СписокВыбора.Добавить(1, "Индивидуальные");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартПереключательНаГлубинуАнализаПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиГлубиныАнализа", Тип("ГруппаФормы"), Элементы.смартГруппаГлубинаАнализа);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь; 
	
	НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиГлубиныАнализаОбщие", Тип("ГруппаФормы"), Элементы.смартГруппаПоказателиГлубиныАнализа);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Доступность = Ложь;
	
	НовыйЭлемент = Элементы.Вставить("смартПериодРасчетаКонстантаЗаголовок", Тип("ДекорацияФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаОбщие);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Период:";
	
	НовыйЭлемент = Элементы.Добавить("смартПериодРасчетаКонстанта", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаОбщие);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартПериодРасчетаКонстанта";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
	НовыйЭлемент = Элементы.Вставить("смартКоличествоПериодовРасчетаКонстантаЗаголовок", Тип("ДекорацияФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаОбщие);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Количество периодов:";

	НовыйЭлемент = Элементы.Добавить("смартКоличествоПериодовРасчетаКонстанта", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаОбщие);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартКоличествоПериодовРасчетаКонстанта";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;

    НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиГлубиныАнализаИндивидуальные", Тип("ГруппаФормы"), Элементы.смартГруппаПоказателиГлубиныАнализа);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Доступность = ЭтаФорма.смартПереключательНаГлубинуАнализа = 1;

	НовыйЭлемент = Элементы.Вставить("смартПериодРасчетаЗаголовок", Тип("ДекорацияФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаИндивидуальные);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Период:";
	
	НовыйЭлемент = Элементы.Добавить("смартПериодРасчетаАнализаПродаж", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаИндивидуальные);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартПериодРасчетаАнализаПродаж";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
	НовыйЭлемент = Элементы.Вставить("смартКоличествоПериодовРасчетаЗаголовок", Тип("ДекорацияФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаИндивидуальные);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Количество периодов:";

	НовыйЭлемент = Элементы.Добавить("смартКоличествоПериодовРасчетаАнализаПродаж", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиГлубиныАнализаИндивидуальные);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартКоличествоПериодовРасчетаАнализаПродаж";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;

	//Страховой запас
	НовыйЭлемент = Элементы.Вставить("смартГруппаСтраховойЗапас", Тип("ГруппаФормы"), Элементы.ГруппаПараметрыМетодаОтступ);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "Страховой запас";
	НовыйЭлемент.ОтображатьЗаголовок = Истина; 
	НовыйЭлемент.ВертикальноеПоложениеПодчиненных = ВертикальноеПоложениеЭлемента.Центр;
	
	НовыйЭлемент = Элементы.Вставить("смартПереключательНаСтраховойЗапас", Тип("ПолеФормы"), Элементы.смартГруппаСтраховойЗапас);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя; 
	НовыйЭлемент.ПутьКДанным = "смартПереключательНаСтраховойЗапас";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.КоличествоКолонок = 1;
	НовыйЭлемент.СписокВыбора.Добавить(0, "В единицах хранения:");
	НовыйЭлемент.СписокВыбора.Добавить(1, "На период:");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартПереключательНаСтраховойЗапасПриИзменении");
	
	НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиСтраховогоЗапаса", Тип("ГруппаФормы"), Элементы.смартГруппаСтраховойЗапас);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь; 
	
	НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиСтраховогоЗапасаВЕдиницах", Тип("ГруппаФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапаса);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
		
	НовыйЭлемент = Элементы.Добавить("смартСтраховойЗапас", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапасаВЕдиницах);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "СтраховойЗапас";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Доступность = ЭтаФорма.смартПереключательНаСтраховойЗапас = 0;
    
	НовыйЭлемент = Элементы.Вставить("смартГруппаПоказателиСтраховогоЗапасаНаПериод", Тип("ГруппаФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапаса);
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Заголовок   = "";
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	НовыйЭлемент.Доступность = ЭтаФорма.смартПереключательНаСтраховойЗапас = 1;

	НовыйЭлемент = Элементы.Добавить("смартПериодСтраховогоЗапасаРасчета", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапасаНаПериод);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартПериодРасчетаСтраховогоЗапаса";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
	НовыйЭлемент = Элементы.Вставить("смартКоличествоПериодовРасчетаСтраховогоЗапасаЗаголовок", Тип("ДекорацияФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапасаНаПериод);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Количество периодов:";

	НовыйЭлемент = Элементы.Добавить("смартКоличествоПериодовРасчетаСтраховогоЗапаса", Тип("ПолеФормы"), Элементы.смартГруппаПоказателиСтраховогоЗапасаНаПериод);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "смартКоличествоПериодовРасчетаСтраховогоЗапаса";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура смартПереключательНаСрокПоСтатистикеПриИзменении(Элемент)
	МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.смартПоддержаниеЗапасаНаСрокПоСтатистике");
	ПриПереключенииМетодаОбеспечения();
	РассчитатьЗапасы();
КонецПроцедуры

&НаКлиенте
Процедура смартПереключательНаГлубинуАнализаПриИзменении(Элемент)
	Элементы.смартГруппаПоказателиГлубиныАнализаИндивидуальные.Доступность = ЭтаФорма.смартПереключательНаГлубинуАнализа = 1;
КонецПроцедуры 

&НаКлиенте
Процедура смартПереключательНаСтраховойЗапасПриИзменении(Элемент)
	Элементы.смартГруппаПоказателиСтраховогоЗапасаВЕдиницах.Доступность = ЭтаФорма.смартПереключательНаСтраховойЗапас = 0; 
	Элементы.смартГруппаПоказателиСтраховогоЗапасаНаПериод.Доступность = ЭтаФорма.смартПереключательНаСтраховойЗапас = 1;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ОпределитьДоступностьНастройки(КлючПотребности)
	Если ТипЗнч(КлючПотребности) = Тип("Структура")
		И КлючПотребности.Свойство("Склад") 
		И КлючПотребности.Склад = Справочники.смартПредопределенныеЗначения.Настройки.ГлавныйРаспределительныйЦентр Тогда
		Возврат Истина;		
	КонецЕсли;
	
	Если ТипЗнч(КлючПотребности) = Тип("Структура")
		И КлючПотребности.Свойство("Группировка") 
		И ЗначениеЗаполнено(КлючПотребности.Группировка) Тогда
		Возврат Истина;		
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("ПриПереключенииМетодаОбеспечения")
Процедура смарт_ПриПереключенииМетодаОбеспечения()

	Если Параметры.РежимОткрытия = "ТолькоСпособ" Тогда
		Возврат;
	КонецЕсли;

	ПереключательЗаказПодЗаказ      = 0;
	ПереключательМинМакс            = 0;
	ПереключательНаСрокПоНорме      = 0;
	ПереключательНаСрокПоСтатистике = 0;
	#Вставка
	смартПереключательНаСрокПоСтатистике = 0;
	#КонецВставки

	Если МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ЗаказПодЗаказ") Тогда
		ПереключательЗаказПодЗаказ = 1;
	ИначеЕсли МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс") Тогда
		ПереключательМинМакс = 1;
	ИначеЕсли МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоНорме") Тогда
		ПереключательНаСрокПоНорме = 1;
	#Вставка
	ИначеЕсли МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.смартПоддержаниеЗапасаНаСрокПоСтатистике") Тогда
		смартПереключательНаСрокПоСтатистике = 1;
	#КонецВставки
	Иначе
		// Отрабатываем Метод обеспечения = "ПоддержаниеЗапасаНаСрокПоСтатистике".
		ПереключательНаСрокПоСтатистике = 1;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбеспечениеЗаказовПриПоддержанииЗапаса) Тогда
		ОбеспечениеЗаказовПриПоддержанииЗапаса = ПредопределенноеЗначение("Перечисление.ОбеспечениеЗаказовПриПоддержанииЗапаса.ЗаСчетЗапасов");
	КонецЕсли;
	
	#Вставка
	Элементы.СтраницыУчетЗаказов.Доступность = Истина;
	Элементы.ГруппаСтраховойЗапас.Видимость = смартПереключательНаСрокПоСтатистике = 0;
	Элементы.смартГруппаГлубинаАнализа.Видимость = смартПереключательНаСрокПоСтатистике = 1; 
	Элементы.смартГруппаСтраховойЗапас.Видимость = смартПереключательНаСрокПоСтатистике = 1;
	#КонецВставки
	
	// Настраиваем видимость параметров поддержания запаса.
	Если МетодОбеспечения
		= ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ЗаказПодЗаказ") Тогда

		Элементы.СтраницыНормаСреднедневноеЗаголовок.ТекущаяСтраница = Элементы.СтраницаНормаПотребленияЗаголовок;
		Элементы.СтраницыНормаЗначения.ТекущаяСтраница      = Элементы.СтраницаНормаНеИспользуется;
		Элементы.СтраницыМинЗапасЗначения.ТекущаяСтраница   = Элементы.СтраницаМинЗапасНеИспользуется;
		Элементы.СтраницыМаксЗапасЗначения.ТекущаяСтраница  = Элементы.СтраницаМаксЗапасНеИспользуется;
		Элементы.СтраницыСтрахЗапасЗначения.ТекущаяСтраница = Элементы.СтраницаСтрахЗапасНеИспользуется;
		Элементы.СтраницыУчетЗаказов.ТекущаяСтраница        = Элементы.СтраницаУчетЗаказовНеИспользуется;

	ИначеЕсли МетодОбеспечения
		= ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс") Тогда

		Элементы.СтраницыНормаСреднедневноеЗаголовок.ТекущаяСтраница = Элементы.СтраницаНормаПотребленияЗаголовок;
		Элементы.СтраницыНормаЗначения.ТекущаяСтраница      = Элементы.СтраницаНормаНеИспользуется;
		Элементы.СтраницыМинЗапасЗначения.ТекущаяСтраница   = Элементы.СтраницаМинЗапас;
		Элементы.СтраницыМаксЗапасЗначения.ТекущаяСтраница  = Элементы.СтраницаМаксЗапас;
		Элементы.СтраницыСтрахЗапасЗначения.ТекущаяСтраница = Элементы.СтраницаСтрахЗапасНеИспользуется;
		Элементы.СтраницыУчетЗаказов.ТекущаяСтраница        = Элементы.СтраницаУчетЗаказов;

	ИначеЕсли МетодОбеспечения
		= ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоНорме") Тогда

		Элементы.СтраницыНормаСреднедневноеЗаголовок.ТекущаяСтраница = Элементы.СтраницаНормаПотребленияЗаголовок;
		Элементы.СтраницыНормаЗначения.ТекущаяСтраница      = Элементы.СтраницаНорма;
		Элементы.СтраницыМинЗапасЗначения.ТекущаяСтраница   = Элементы.СтраницаМинЗапасСтрокой;
		Элементы.СтраницыМаксЗапасЗначения.ТекущаяСтраница  = Элементы.СтраницаМаксЗапасСтрокой;
		Элементы.СтраницыСтрахЗапасЗначения.ТекущаяСтраница = Элементы.СтраницаСтрахЗапас;
		Элементы.СтраницыУчетЗаказов.ТекущаяСтраница        = Элементы.СтраницаУчетЗаказов;

	ИначеЕсли МетодОбеспечения
		= ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоСтатистике") Тогда

		Элементы.СтраницыНормаСреднедневноеЗаголовок.ТекущаяСтраница = Элементы.СтраницаСреднедневноеПотреблениеЗаголовок;
		Элементы.СтраницыНормаЗначения.ТекущаяСтраница      = Элементы.СтраницаСреднедневноеПотреблениеСтрокой;
		Элементы.СтраницыМинЗапасЗначения.ТекущаяСтраница   = Элементы.СтраницаМинЗапасСтрокой;
		Элементы.СтраницыМаксЗапасЗначения.ТекущаяСтраница  = Элементы.СтраницаМаксЗапасСтрокой;
		Элементы.СтраницыСтрахЗапасЗначения.ТекущаяСтраница = Элементы.СтраницаСтрахЗапас;
		Элементы.СтраницыУчетЗаказов.ТекущаяСтраница        = Элементы.СтраницаУчетЗаказов;
		
	#Вставка
	ИначеЕсли МетодОбеспечения
		= ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.смартПоддержаниеЗапасаНаСрокПоСтатистике") Тогда

		Элементы.СтраницыНормаСреднедневноеЗаголовок.ТекущаяСтраница = Элементы.СтраницаСреднедневноеПотреблениеЗаголовок;
		Элементы.СтраницыНормаЗначения.ТекущаяСтраница      = Элементы.СтраницаСреднедневноеПотреблениеСтрокой;
		Элементы.СтраницыМинЗапасЗначения.ТекущаяСтраница   = Элементы.СтраницаМинЗапасСтрокой;
		Элементы.СтраницыМаксЗапасЗначения.ТекущаяСтраница  = Элементы.СтраницаМаксЗапасСтрокой;
		Элементы.СтраницыСтрахЗапасЗначения.ТекущаяСтраница = Элементы.СтраницаСтрахЗапас;
		Элементы.СтраницыУчетЗаказов.ТекущаяСтраница        = Элементы.СтраницаУчетЗаказов; 
		
		Элементы.СтраницыУчетЗаказов.Доступность = Ложь;
		Элементы.ГруппаСтраховойЗапас.Видимость = Ложь;
    #КонецВставки
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Элементы.СтраницыУпаковкаЗначения.ТекущаяСтраница = Элементы.СтраницаУпаковкаСтрокой;
	Иначе
		Элементы.СтраницыУпаковкаЗначения.ТекущаяСтраница = Элементы.СтраницаУпаковка;
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
&ИзменениеИКонтроль("ФормаЗаполненаВерно")
Функция смарт_ФормаЗаполненаВерно()

	Если ПереключательСпособа = 1 И Не ЗначениеЗаполнено(СпособИндивидуальный) Тогда
		ОчиститьСообщения();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите способ обеспечения'"),,, "СпособИндивидуальный",);
		Возврат Ложь;
	Иначе
		#Вставка 
		Если ЭтаФорма.смартПереключательНаГлубинуАнализа = 1 Тогда
			Если Не ЗначениеЗаполнено(ЭтаФорма.смартКоличествоПериодовРасчетаАнализаПродаж) Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите количество периодов глубины анализа продаж'"),,, "смартКоличествоПериодовРасчетаАнализаПродаж",);	
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ЭтаФорма.смартПериодРасчетаАнализаПродаж) Тогда
				ОчиститьСообщения();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Укажите период глубины анализа продаж'"),,, "смартПериодРасчетаАнализаПродаж",);	
			КонецЕсли;
		КонецЕсли;
	    #КонецВставки
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаСервере
&ИзменениеИКонтроль("ЗаписатьНаСервере")
Процедура смарт_ЗаписатьНаСервере()

	ПраваДоступа = ОбеспечениеСервер.ПраваДоступаНаЗаписьСпособаИлиМетода();
	Если Параметры.РежимОткрытия <> "ТолькоПараметры"
		И (СпособУказанияНастройки = "ДЛЯ_ХАРАКТЕРИСТИК_ТОВАРА" Или СпособУказанияНастройки = "ДЛЯ_ГРУППЫ_ТОВАРОВ") Тогда
		ПраваДоступа.ТоварныеОграничения = Ложь;
	КонецЕсли;

	НачатьТранзакцию();

	Попытка

		Если ПраваДоступа.ТоварныеОграничения Тогда
			// Запись товарного ограничения.
			Если Параметры.КлючПотребности.Свойство("Группировка") И 
				ЗначениеЗаполнено(Параметры.КлючПотребности.Группировка) Тогда
				КлючЗаписи = РегистрыСведений.ТоварныеОграничения.КлючЗаписиГруппировки();
			ИначеЕсли ЗначениеЗаполнено(Параметры.КлючПотребности.Характеристика) Тогда
				КлючЗаписи = РегистрыСведений.ТоварныеОграничения.КлючЗаписиХарактеристики();
			Иначе
				КлючЗаписи = РегистрыСведений.ТоварныеОграничения.КлючЗаписиНоменклатуры();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(КлючЗаписи, Параметры.КлючПотребности);
			Если Параметры.РежимОткрытия = "Полный" Тогда
				Если МетодОбеспечения = Перечисления.МетодыОбеспеченияПотребностей.ЗаказПодЗаказ Тогда
					РегистрыСведений.ТоварныеОграничения.УдалитьПоддержаниеЗапаса(КлючЗаписи);
				КонецЕсли;
				РегистрыСведений.ТоварныеОграничения.ЗадатьУпаковкуТовара(Параметры.КлючПотребности.Номенклатура,
				Параметры.КлючПотребности.Характеристика, Параметры.КлючПотребности.Склад, УпаковкаЗаказа);
			КонецЕсли;
			Если МетодОбеспечения = Перечисления.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаМинМакс Тогда
				ПараметрыЗаписи = РегистрыСведений.ТоварныеОграничения.ПараметрыМинМакс();
				ПараметрыЗаписи.МинимальноеКоличествоЗапаса				= МинимальныйЗапас;
				ПараметрыЗаписи.МаксимальноеКоличествоЗапаса			= МаксимальныйЗапас;
				ПараметрыЗаписи.ОбеспечениеЗаказовПриПоддержанииЗапаса	= ОбеспечениеЗаказовПриПоддержанииЗапаса;
				РегистрыСведений.ТоварныеОграничения.ДобавитьПоддержаниеЗапасаМинМакс(КлючЗаписи, ПараметрыЗаписи);
			ИначеЕсли МетодОбеспечения = Перечисления.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоНорме Тогда
				ПараметрыЗаписи = РегистрыСведений.ТоварныеОграничения.ПараметрыРасчетПоНорме();
				ПараметрыЗаписи.НормаПотребления						= НормаПотребления;
				ПараметрыЗаписи.СтраховоеКоличествоЗапаса				= СтраховойЗапас;
				ПараметрыЗаписи.ОбеспечениеЗаказовПриПоддержанииЗапаса	= ОбеспечениеЗаказовПриПоддержанииЗапаса;
				РегистрыСведений.ТоварныеОграничения.ДобавитьПоддержаниеЗапасаРасчетПоНорме(КлючЗаписи, ПараметрыЗаписи);
			ИначеЕсли МетодОбеспечения = Перечисления.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоСтатистике Тогда
				ПараметрыЗаписи = РегистрыСведений.ТоварныеОграничения.ПараметрыРасчетПоСтатистике();
				ПараметрыЗаписи.СтраховоеКоличествоЗапаса				= СтраховойЗапас;
				ПараметрыЗаписи.ОбеспечениеЗаказовПриПоддержанииЗапаса	= ОбеспечениеЗаказовПриПоддержанииЗапаса;
				РегистрыСведений.ТоварныеОграничения.ДобавитьПоддержаниеЗапасаРасчетПоСтатистике(КлючЗаписи, ПараметрыЗаписи);
			#Вставка
			ИначеЕсли МетодОбеспечения = Перечисления.МетодыОбеспеченияПотребностей.смартПоддержаниеЗапасаНаСрокПоСтатистике Тогда 
				Если ЭтаФорма.смартПереключательНаГлубинуАнализа = 0 Тогда
					ЭтаФорма.смартКоличествоПериодовРасчетаАнализаПродаж = 0;
					ЭтаФорма.смартПериодРасчетаАнализаПродаж = Перечисления.Периодичность.ПустаяСсылка();
				КонецЕсли;
				
				Если ЭтаФорма.смартПереключательНаСтраховойЗапас = 0 Тогда
					ЭтаФорма.смартКоличествоПериодовРасчетаСтраховогоЗапаса = 0;
					ЭтаФорма.смартПериодРасчетаСтраховогоЗапаса = Перечисления.Периодичность.ПустаяСсылка();
				Иначе
					ЭтаФорма.СтраховойЗапас = 0;
				КонецЕсли; 			
			
				ПараметрыЗаписи = Новый Структура("ОбеспечениеЗаказовПриПоддержанииЗапаса,смартКоличествоПериодовРасчетаАнализаПродаж,смартПериодРасчетаАнализаПродаж,
				|смартКоличествоПериодовРасчетаСтраховогоЗапаса,смартПериодРасчетаСтраховогоЗапаса");
				ЗаполнитьЗначенияСвойств(ПараметрыЗаписи, ЭтаФорма);
				ПараметрыЗаписи.Вставить("СтраховоеКоличествоЗапаса", СтраховойЗапас);
				ПараметрыЗаписи.Вставить("ИмяПараметраЗаполнения", Неопределено);
				РегистрыСведений.ТоварныеОграничения.смартДобавитьПоддержаниеЗапасаРасчетПоСтатистике(КлючЗаписи, ПараметрыЗаписи);
			#КонецВставки
			КонецЕсли;

		КонецЕсли;

		Если ПраваДоступа.ВариантыОбеспечения И Параметры.РежимОткрытия <> "ТолькоПараметры" Тогда

			НаборЗаписей = ?(Параметры.КлючПотребности.ЭтоРабота,
			РегистрыСведений.ВариантыОбеспеченияРаботами.СоздатьНаборЗаписей(),
			РегистрыСведений.ВариантыОбеспеченияТоварами.СоздатьНаборЗаписей());
			НаборЗаписей.Отбор.Номенклатура.Значение = Параметры.КлючПотребности.Номенклатура;
			НаборЗаписей.Отбор.Номенклатура.Использование = Истина;
			НаборЗаписей.Отбор.Характеристика.Значение = Параметры.КлючПотребности.Характеристика;
			НаборЗаписей.Отбор.Характеристика.Использование = Истина;
			Если Не Параметры.КлючПотребности.ЭтоРабота Тогда
				НаборЗаписей.Отбор.Склад.Значение          = Параметры.КлючПотребности.Склад;
				НаборЗаписей.Отбор.Склад.Использование = Истина;
			КонецЕсли;
			НаборЗаписей.ДополнительныеСвойства.Вставить("ОбновлятьРеквизитДопУпорядочивания", Ложь);
			НаборЗаписей.Отбор.СпособОбеспеченияПотребностей.Использование = Истина;

			// Удаление действовавшего ранее индивидуального способа обеспечения.
			Если ЗначениеЗаполнено(СпособИндивидуальныйСтарый) Тогда

				НаборЗаписей.Отбор.СпособОбеспеченияПотребностей.Значение = СпособИндивидуальныйСтарый;
				НаборЗаписей.Прочитать();
				НаборЗаписей[0].РеквизитДопУпорядочивания = 2;
				НаборЗаписей.Записать(Истина);

			КонецЕсли;

			// Чтение и запись нового индивидуального способа в качестве основного способа.
			Если ПереключательСпособа = 1 И ЗначениеЗаполнено(СпособИндивидуальный) Тогда

				НаборЗаписей.Отбор.СпособОбеспеченияПотребностей.Значение = СпособИндивидуальный;
				НаборЗаписей.Прочитать();

				Если НаборЗаписей.Количество() > 0 Тогда
					Запись = НаборЗаписей[0];
				Иначе
					Запись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Параметры.КлючПотребности);
					Запись.СпособОбеспеченияПотребностей = СпособИндивидуальный;
				КонецЕсли;

				Запись.РеквизитДопУпорядочивания = 1;
				НаборЗаписей.Записать(Истина);
				СпособИндивидуальныйСтарый = СпособИндивидуальный;

			КонецЕсли;

		КонецЕсли;

		Модифицированность = Ложь;
		ДанныеЗаписаны = Истина;
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("РассчитатьЗапасы")
Процедура смарт_РассчитатьЗапасы1()
	
	РассчитываетсяИндивидуально = НСтр("ru = 'индивидуальный расчет для номенклатуры'");
	ОшибкаРасчетаЦиклПоставки   = НСтр("ru = 'ошибка расчета (нет данных графика поставок)'");
	
	Если Параметры.РежимОткрытия = "ТолькоМетод" ИЛИ Параметры.РежимОткрытия = "ТолькоПараметры" Тогда
		МинимальныйЗапасСтрокой = РассчитываетсяИндивидуально;
		МаксимальныйЗапасСтрокой = РассчитываетсяИндивидуально;
		СреднедневноеПотреблениеСтрокой = РассчитываетсяИндивидуально;
		Элементы.МинимальныйЗапасСтрокой.ЦветТекста = ЦветПоясняющейНадписи;
		Элементы.МаксимальныйЗапасСтрокой.ЦветТекста = ЦветПоясняющейНадписи;
		Элементы.СреднедневноеПотреблениеСтрокой.ЦветТекста = ЦветПоясняющейНадписи;
		
		Возврат;
	КонецЕсли;
	
	Сроки = ПараметрыЦиклаПоставкиОсновногоСпособаОбеспечения();
	ЕстьОшибкиЦиклаПоставки = ЕстьОшибкиЦиклаПоставки(Сроки);
	
	Если МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоНорме") Тогда
		
		Если Не ЕстьОшибкиЦиклаПоставки Тогда
			МинимальныйЗапасРасчетный  = Сроки.СрокИсполненияЗаказа * НормаПотребления;
			МаксимальныйЗапасРасчетный = Сроки.ОбеспечиваемыйПериод * НормаПотребления;
		Иначе
			МинимальныйЗапасРасчетный  = 0;
			МаксимальныйЗапасРасчетный = 0;
		КонецЕсли;
		
		МинимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(НормаПотребления = 0,
				НСтр("ru = 'задайте норму потребления'"),
			
			?(Сроки.СрокИсполненияЗаказа = 0, СтрШаблон(
				НСтр("ru = '0.000 %1 (на 0 дн)'"),
				ЕдиницаИзмерения),
					
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МинимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.СрокИсполненияЗаказа))));
		
		МаксимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
		
			?(НормаПотребления = 0,
				НСтр("ru = 'задайте норму потребления'"),
				
			?(Сроки.ОбеспечиваемыйПериод = 0,
				НСтр("ru = 'задайте обеспечиваемый период'"),
					
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МаксимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.ОбеспечиваемыйПериод))));
		
		Элементы.МинимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или НормаПотребления = 0,
			ЦветОшибки, ЦветИзСтиля);
			
		Элементы.МаксимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или НормаПотребления = 0
			Или Сроки.ОбеспечиваемыйПериод = 0,
			ЦветОшибки, ЦветИзСтиля);
		
	ИначеЕсли МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.ПоддержаниеЗапасаНаСрокПоСтатистике") Тогда
		
		Если Не ЕстьОшибкиЦиклаПоставки Тогда
			МинимальныйЗапасРасчетный  = Сроки.СрокИсполненияЗаказа    * СреднедневноеПотребление;
			МаксимальныйЗапасРасчетный = Сроки.ОбеспечиваемыйПериод    * СреднедневноеПотребление;
		Иначе
			МинимальныйЗапасРасчетный  = 0;
			МаксимальныйЗапасРасчетный = 0;
		КонецЕсли;
		
		МинимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0,
				НСтр("ru = 'нет потребления по статистике'"),
			
			?(Сроки.СрокИсполненияЗаказа = 0, СтрШаблон(
				НСтр("ru = '0.000 %1 (на 0 дн)'"),
				ЕдиницаИзмерения),
				
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МинимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.СрокИсполненияЗаказа))));
		
		МаксимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0,
				НСтр("ru = 'нет потребления по статистике'"),
				
			?(Сроки.ОбеспечиваемыйПериод = 0,
				НСтр("ru = 'задайте обеспечиваемый период'"),
				
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МаксимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.ОбеспечиваемыйПериод))));
		
		СреднедневноеПотреблениеСтрокой =
			?(ЗначениеЗаполнено(ДлительнаяОперация), НСтр("ru = 'статистика рассчитывается...'"),
			
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0, СтрШаблон(
				НСтр("ru = 'нет статистики за %1 - %2'"),
				Формат(ДанныеЗаПериод.ДатаНачала,    "ДЛФ=D"),
				Формат(ДанныеЗаПериод.ДатаОкончания, "ДЛФ=D")),
				
			СтрШаблон(
				НСтр("ru = '%1 (+/- %2) %3 (статистика за %4 - %5)'"),
				Формат(СреднедневноеПотребление, "ЧДЦ=3"),
				Формат(СреднееОтклонение, "ЧДЦ=3; ЧН=0.000"),
				ЕдиницаИзмерения,
				Формат(ДанныеЗаПериод.ДатаНачала,    "ДЛФ=D"),
				Формат(ДанныеЗаПериод.ДатаОкончания, "ДЛФ=D")))));
		
		Элементы.МинимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или СреднедневноеПотребление = 0,
			ЦветОшибки, ЦветИзСтиля);
			
		Элементы.МаксимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или СреднедневноеПотребление = 0
			Или Сроки.ОбеспечиваемыйПериод = 0,
			ЦветОшибки, ЦветИзСтиля);
			
		Элементы.СреднедневноеПотреблениеСтрокой.ЦветТекста = ?(СреднедневноеПотребление = 0,
			ЦветОшибки, ЦветИзСтиля);
		
	#Вставка
	ИначеЕсли МетодОбеспечения = ПредопределенноеЗначение("Перечисление.МетодыОбеспеченияПотребностей.смартПоддержаниеЗапасаНаСрокПоСтатистике") Тогда
		
		Если Не ЕстьОшибкиЦиклаПоставки Тогда
			МинимальныйЗапасРасчетный  = Сроки.СрокИсполненияЗаказа    * СреднедневноеПотребление;
			МаксимальныйЗапасРасчетный = Сроки.ОбеспечиваемыйПериод    * СреднедневноеПотребление;
		Иначе
			МинимальныйЗапасРасчетный  = 0;
			МаксимальныйЗапасРасчетный = 0;
		КонецЕсли;
		
		МинимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0,
				НСтр("ru = 'нет потребления по статистике'"),
			
			?(Сроки.СрокИсполненияЗаказа = 0, СтрШаблон(
				НСтр("ru = '0.000 %1 (на 0 дн)'"),
				ЕдиницаИзмерения),
				
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МинимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.СрокИсполненияЗаказа))));
		
		МаксимальныйЗапасСтрокой =
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0,
				НСтр("ru = 'нет потребления по статистике'"),
				
			?(Сроки.ОбеспечиваемыйПериод = 0,
				НСтр("ru = 'задайте обеспечиваемый период'"),
				
			СтрШаблон(
				НСтр("ru = '%1 %2 (на %3 дн)'"),
				Формат(МаксимальныйЗапасРасчетный, "ЧДЦ=3"),
				ЕдиницаИзмерения,
				Сроки.ОбеспечиваемыйПериод))));
		
		СреднедневноеПотреблениеСтрокой =
			?(ЗначениеЗаполнено(ДлительнаяОперация), НСтр("ru = 'статистика рассчитывается...'"),
			
			?(ЕстьОшибкиЦиклаПоставки, ОшибкаРасчетаЦиклПоставки,
			
			?(СреднедневноеПотребление = 0, СтрШаблон(
				НСтр("ru = 'нет статистики за %1 - %2'"),
				Формат(ДанныеЗаПериод.ДатаНачала,    "ДЛФ=D"),
				Формат(ДанныеЗаПериод.ДатаОкончания, "ДЛФ=D")),
				
			СтрШаблон(
				НСтр("ru = '%1 %3 (статистика за %4 - %5)'"),
				Формат(СреднедневноеПотребление, "ЧДЦ=3"),
				Формат(СреднееОтклонение, "ЧДЦ=3; ЧН=0.000"),
				ЕдиницаИзмерения,
				Формат(ДанныеЗаПериод.ДатаНачала,    "ДЛФ=D"),
				Формат(ДанныеЗаПериод.ДатаОкончания, "ДЛФ=D")))));

			//СтрШаблон(
			//	НСтр("ru = '%1 (+/- %2) %3 (статистика за %4 - %5)'"),
			//	Формат(СреднедневноеПотребление, "ЧДЦ=3"),
			//	Формат(СреднееОтклонение, "ЧДЦ=3; ЧН=0.000"),
			//	ЕдиницаИзмерения,
			//	Формат(ДанныеЗаПериод.ДатаНачала,    "ДЛФ=D"),
			//	Формат(ДанныеЗаПериод.ДатаОкончания, "ДЛФ=D")))));
		
		Элементы.МинимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или СреднедневноеПотребление = 0,
			ЦветОшибки, ЦветИзСтиля);
			
		Элементы.МаксимальныйЗапасСтрокой.ЦветТекста = ?(ЕстьОшибкиЦиклаПоставки Или СреднедневноеПотребление = 0
			Или Сроки.ОбеспечиваемыйПериод = 0,
			ЦветОшибки, ЦветИзСтиля);
			
		Элементы.СреднедневноеПотреблениеСтрокой.ЦветТекста = ?(СреднедневноеПотребление = 0,
			ЦветОшибки, ЦветИзСтиля);
		
	#КонецВставки	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

