	|	ЕСТЬNULL(XYZКлассификация.Класс, ЗНАЧЕНИЕ(Перечисление.XYZКлассификация.НеКлассифицирован)) КАК смартXYZКласс
	//-- #5196 смарт: Тимофеева 16.12.2025
