//++ #5196 смарт: Тимофеева 16.12.2025 / Автозаказ. Дополнительные требования.
//X/(Y/3) -1×100 с округлением до целого числа, где
//X - продажи за последние 30 кд;
//Y - продажи за последние 90 кд.
Функция ТекстЗапросаДинамикаПродаж()
	Возврат 
	"////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент
	|ПОМЕСТИТЬ КонтрагентыДляИсключенияПродаж
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО Контрагенты.ИНН = Организации.ИНН
	|ГДЕ
	|	НЕ Контрагенты.ИНН = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиX.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	СУММА(ПродажиX.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПродажиX
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			&ПериодДляДинамикиXДатаНачала,
	|			&ПериодДляДинамикиXДатаОкончания,
	|			Авто,
	|			АналитикаУчетаПоПартнерам.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|				И НЕ АналитикаУчетаПоПартнерам.Контрагент В
	|						(ВЫБРАТЬ
	|							ВТ.Контрагент КАК Контрагент
	|						ИЗ
	|							КонтрагентыДляИсключенияПродаж КАК ВТ)
	|				И АналитикаУчетаНоменклатуры.Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура КАК Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК Товары)) КАК ПродажиX
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиX.АналитикаУчетаНоменклатуры.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПродажиY.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	СУММА(ПродажиY.КоличествоОборот) КАК Количество
	|ПОМЕСТИТЬ ВТ_ПродажиY
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			&ПериодДляДинамикиYДатаНачала,
	|			&ПериодДляДинамикиYДатаОкончания,
	|			Авто,
	|			АналитикаУчетаПоПартнерам.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|				И НЕ АналитикаУчетаПоПартнерам.Контрагент В
	|						(ВЫБРАТЬ
	|							ВТ.Контрагент КАК Контрагент
	|						ИЗ
	|							КонтрагентыДляИсключенияПродаж КАК ВТ)
	|				И АналитикаУчетаНоменклатуры.Номенклатура В
	|					(ВЫБРАТЬ
	|						Товары.Номенклатура КАК Номенклатура
	|					ИЗ
	|						ВТ_Товары КАК Товары)) КАК ПродажиY
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиY.АналитикаУчетаНоменклатуры.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПродажиY.Номенклатура КАК Номенклатура,
	|	ВТ_ПродажиX.Количество КАК X,
	|	ВТ_ПродажиY.Количество КАК Y,
	|	ВЫБОР
	|		КОГДА ВТ_ПродажиY.Количество > 0
	|			ТОГДА (ВТ_ПродажиX.Количество / (ВТ_ПродажиY.Количество / 3) - 1) * 100
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК смартДинамикаПродаж
	|ПОМЕСТИТЬ ВТ_ДинамикаПродаж
	|ИЗ
	|	ВТ_ПродажиX КАК ВТ_ПродажиX
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПродажиY КАК ВТ_ПродажиY
	|		ПО ВТ_ПродажиX.Номенклатура = ВТ_ПродажиY.Номенклатура";
КонецФункции

