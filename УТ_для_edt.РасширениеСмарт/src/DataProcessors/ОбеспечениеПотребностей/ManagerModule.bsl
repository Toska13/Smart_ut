Функция ПолучитьДокументПредзаказПоставщику(ДанныеЗаполнения)
	
	ДокументОбъект = Документы.смартПредзаказПоставщику.СоздатьДокумент();
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ДокументОбъект, ДанныеЗаполнения);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполнения, "Партнер, Комментарий"); 
	ДокументОбъект.Дата 		= ТекущаяДатаСеанса();
	ДокументОбъект.Организация	= ?(ЗначениеЗаполнено(ДанныеЗаполнения.Организация), ДанныеЗаполнения.Организация, ДокументОбъект.Организация);
	ДокументОбъект.Склады 		= ДанныеЗаполнения.Склад;
	ДокументОбъект.Менеджер		= Пользователи.ТекущийПользователь();
	ДокументОбъект.Автор		= Пользователи.ТекущийПользователь();
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Соглашение) Тогда
		УсловияЗакупок = ЗакупкиСервер.ПолучитьУсловияЗакупок(ДанныеЗаполнения.Соглашение, Истина);
		ДокументОбъект.Валюта 			= УсловияЗакупок.Валюта;
		ДокументОбъект.Организация 		= ?(ЗначениеЗаполнено(УсловияЗакупок.Организация), УсловияЗакупок.Организация, ДокументОбъект.Организация);
		ДокументОбъект.ЦенаВключаетНДС  = УсловияЗакупок.ЦенаВключаетНДС;
		
		Если НЕ УсловияЗакупок.ИспользуютсяДоговорыКонтрагентов = Неопределено И УсловияЗакупок.ИспользуютсяДоговорыКонтрагентов Тогда			
			СтруктураПоискаДоговора = Новый Структура;
			СтруктураПоискаДоговора.Вставить("Партнер", ДанныеЗаполнения.Партнер);
			СтруктураПоискаДоговора.Вставить("Контрагент", УсловияЗакупок.Контрагент);
			СтруктураПоискаДоговора.Вставить("Организация", УсловияЗакупок.Организация);  
			СтруктураПоискаДоговора.Вставить("Договор", Справочники.ДоговорыКонтрагентов.ПустаяСсылка());
			
			ХозяйственнаяОперацияДоговора = ?(УсловияЗакупок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщикаРеглУчет
												Или УсловияЗакупок.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаЧерезПодотчетноеЛицо,
												Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика,
												УсловияЗакупок.ХозяйственнаяОперация);
			
			ДопПараметры = ЗакупкиСервер.ДополнительныеПараметрыОтбораДоговоров();
			ДопПараметры.ВалютаВзаиморасчетов = УсловияЗакупок.Валюта;
			Договор = ЗакупкиСервер.ПолучитьДоговорПоУмолчанию(СтруктураПоискаДоговора, ХозяйственнаяОперацияДоговора, ДопПараметры);
		Иначе
			Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();	
		КонецЕсли;  
		
		ПараметрыЗаполнения = ПараметрыЗаполненияНалогообложенияНДСЗакупки(УсловияЗакупок.Контрагент, Договор, УсловияЗакупок.ХозяйственнаяОперация);
		УчетНДСУП.ЗаполнитьНалогообложениеНДСЗакупки(ДокументОбъект.НалогообложениеНДС, ПараметрыЗаполнения);

	Иначе
		ДокументОбъект.Валюта 				= ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета();
		ДокументОбъект.ЦенаВключаетНДС 		= Ложь;
		ДокументОбъект.НалогообложениеНДС 	= Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	КонецЕсли;
	
	//++ #4556 смарт: Тимофеева 09.10.2025 / Автозаказ. Объединять товары с характеристиками
	КэшированныеЗначения = Неопределено;
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокументОбъект);
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСумму", "КоличествоУпаковок");
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	//-- #4556 смарт: Тимофеева 09.10.2025 	

	Для Каждого Строка Из ДанныеЗаполнения.Товары Цикл 
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		//++ #4556 смарт: Тимофеева 09.10.2025 / Автозаказ. Объединять товары с характеристиками
		//ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,КоличествоУпаковок,Количество,СтавкаНДС,Назначение,ВидЦеныПоставщика,ДатаПоступления");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка, "Номенклатура,Характеристика,КоличествоУпаковок,Количество,Цена,СтавкаНДС,Назначение,ВидЦеныПоставщика,ДатаПоступления");
		Если ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС Тогда
			НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		КонецЕсли;
		
		Если СтруктураДействий <> Неопределено Тогда
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		КонецЕсли;
		//-- #4556 смарт: Тимофеева 09.10.2025 	
	КонецЦикла;
	
	//++ #4556 смарт: Тимофеева 09.10.2025 / Автозаказ. Объединять товары с характеристиками 
	//ЗаполнитьЦеныПоВидамЦен(ДокументОбъект, ДанныеЗаполнения.Соглашение);
	//-- #4556 смарт: Тимофеева 09.10.2025
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("СуммаСНДС");
	
	Возврат ДокументОбъект;
	
КонецФункции

Функция ПараметрыЗаполненияНалогообложенияНДСЗакупки(Контрагент, Договор, ХозяйственнаяОперация)

	ПараметрыЗаполнения = УчетНДСУПКлиентСервер.ПараметрыЗаполненияНалогообложенияНДСЗакупки();
	
	ПараметрыЗаполнения.Контрагент = Контрагент;
	ПараметрыЗаполнения.Договор = Договор;

	ХозОперацииЗакупкаУПоставщика = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(
		Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика);
	
	ХозОперацииЗакупкаВСтранахЕАЭС = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(
		Перечисления.ХозяйственныеОперации.ЗакупкаВСтранахЕАЭС);
	
	ХозОперацииЗакупкаПоИмпорту = ЗакупкиСервер.ХозяйственныеОперацииПоОсновной(
		Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту);
		
	Если ХозОперацииЗакупкаУПоставщика.Найти(ХозяйственнаяОперация) <> Неопределено Тогда
		
		ПараметрыЗаполнения.ПриобретениеТоваров = Истина;
		ПараметрыЗаполнения.ПриобретениеРабот = Истина;
		ПараметрыЗаполнения.ПриобретениеНаСтатьи = Истина;
		
	ИначеЕсли ХозОперацииЗакупкаВСтранахЕАЭС.Найти(ХозяйственнаяОперация) <> Неопределено Тогда
		
		ПараметрыЗаполнения.ВвозТоваровИзТаможенногоСоюза = Истина;
		
	ИначеЕсли ХозОперацииЗакупкаПоИмпорту.Найти(ХозяйственнаяОперация) <> Неопределено Тогда
		
		ПараметрыЗаполнения.ИмпортТоваров = Истина;
		
	ИначеЕсли  ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаХранениеСПравомПродажи  Тогда
		
		ПараметрыЗаполнения.ПриобретениеТоваров = Истина;
		
	ИначеЕсли ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПриемНаКомиссию Тогда
		
		ПараметрыЗаполнения.ПриемНаКомиссию = Истина;
		
	КонецЕсли;
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

//Процедура ЗаполнитьЦеныПоВидамЦен(ДокументОбъект, Соглашение)

