Функция СкорректироватьОстаткиТаблицы(ТаблицаРезультат)
	
	ТекстыЗапросов = Новый Массив();
	ТекстыЗапросов.Добавить(ТекстЗапросаКТаблице());
	ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
	ТекстыЗапросов.Добавить(ТекстЗапросаОстатки());
	ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
	//++ #5196 смарт: Тимофеева 16.12.2025 / Автозаказ. Дополнительные требования.
	ТекстыЗапросов.Добавить(ТекстЗапросаДинамикаПродаж());
	ТекстыЗапросов.Добавить(ОбщегоНазначенияУТ.РазделительЗапросовВПакете());
 	//-- #5196 смарт: Тимофеева 16.12.2025
	ТекстыЗапросов.Добавить(ТекстЗапросаИтоги());
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов);

	Запрос.УстановитьПараметр("ТаблицаРезультат", ТаблицаРезультат);
	Запрос.УстановитьПараметр("РаспределительныйЦентр", Справочники.смартПредопределенныеЗначения.Настройки.ГлавныйРаспределительныйЦентр);
	Запрос.УстановитьПараметр("СписокСкладов", Справочники.смартПредопределенныеЗначения.Настройки.ОбеспечиваемыеСклады.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	//++ #5196 смарт: Тимофеева 16.12.2025 / Автозаказ. Дополнительные требования.	
	КоличествоПериодовДляРасчетаДинамикиПродаж = Справочники.смартПредопределенныеЗначения.КоличествоПериодовДляРасчетаДинамикиПродаж;
	КоличествоПериодовДляРасчетаДинамикиПродаж = ?(ЗначениеЗаполнено(КоличествоПериодовДляРасчетаДинамикиПродаж) И ТипЗнч(КоличествоПериодовДляРасчетаДинамикиПродаж) = Тип("Число"),
												КоличествоПериодовДляРасчетаДинамикиПродаж, 3);
	Запрос.УстановитьПараметр("ПериодДляДинамикиXДатаНачала", 	 НачалоДня(ТекущаяДатаСеанса()) - 30 *(86400));
	Запрос.УстановитьПараметр("ПериодДляДинамикиXДатаОкончания", НачалоДня(ТекущаяДатаСеанса()) - 1);
	Запрос.УстановитьПараметр("ПериодДляДинамикиYДатаНачала", 	 НачалоДня(ТекущаяДатаСеанса()) - (КоличествоПериодовДляРасчетаДинамикиПродаж + 1) * 30 * (86400));
	Запрос.УстановитьПараметр("ПериодДляДинамикиYДатаОкончания", НачалоДня(ТекущаяДатаСеанса()) - 1 - 30 *(86400));
	//-- #5196 смарт: Тимофеева 16.12.2025
	
	УстановитьПривилегированныйРежим(Истина);	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

