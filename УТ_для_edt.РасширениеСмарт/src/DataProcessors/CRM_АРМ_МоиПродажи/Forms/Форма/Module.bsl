//++ #1820 смарт: Фролов 20.05.2024 //Доработка обработки "Мои продажи" - 
Процедура смартТаблицаПоказателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОтборыУстановлены = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Партнер) Тогда
		
		ЭтаФорма.смартКвалификация.Очистить();
		ПоискКлиент = ТекущиеДанные.Партнер;
		ЭтаФорма.смартСтарые = Ложь;
		ЭтаФорма.смартНовые = Ложь;
		ПоискТипУслуги = Неопределено;
		ОтборыУстановлены = Истина;
		
	ИначеЕсли ТекущиеДанные.Показатель = "ПАРТНЕР НЕ ЗАПОЛНЕН" Тогда
		
		ЭтаФорма.смартКвалификация.Очистить();
		ПоискКлиент = ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка");
		ЭтаФорма.смартСтарые = Ложь;
		ЭтаФорма.смартНовые = Ложь;
		ПоискТипУслуги = Неопределено;
		ОтборыУстановлены = Истина;
		
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ТипУслуги) Тогда
		
		ЭтаФорма.смартКвалификация.Очистить();
		ЭтаФорма.смартСтарые = Ложь;
		ЭтаФорма.смартНовые = Ложь;
		ПоискКлиент = Неопределено;
		ПоискТипУслуги = ТекущиеДанные.ТипУслуги;
		ОтборыУстановлены = Истина;

	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Квалификация) Тогда
		
		ЭтаФорма.смартКвалификация.Добавить(ТекущиеДанные.Квалификация);
		ЭтаФорма.смартСтарые = Ложь;
		ЭтаФорма.смартНовые = Ложь;
		ПоискКлиент = Неопределено;
		ПоискТипУслуги = Неопределено; 
		ОтборыУстановлены = Истина;

	ИначеЕсли ТекущиеДанные.Показатель = "Старые" Тогда
		
		ЭтаФорма.смартКвалификация.Очистить();
		ЭтаФорма.смартСтарые = Истина;
		ЭтаФорма.смартНовые = Ложь;
		ПоискКлиент = Неопределено;
		ПоискТипУслуги = Неопределено;
		ОтборыУстановлены = Истина;
		
	ИначеЕсли ТекущиеДанные.Показатель = "Новые" Тогда		
		
		ЭтаФорма.смартКвалификация.Очистить();
		ЭтаФорма.смартСтарые = Ложь;
		ЭтаФорма.смартНовые = Истина;
		ПоискКлиент = Неопределено;
		ПоискТипУслуги = Неопределено;
		ОтборыУстановлены = Истина;
		
	КонецЕсли;
	
	Если ОтборыУстановлены Тогда
		extCRM_ОбновитьОтборыНаСервере("Все", Неопределено);
	КонецЕсли;	
	
КонецПроцедуры //-- #1820 смарт: Фролов 20.05.2024

#КонецОбласти

//++ #1820 смарт: Фролов 20.05.2024 //Доработка обработки "Мои продажи" - 
Процедура смартОбновитьТаблицуПоказателей()
	
	Схема = Элементы.ТаблицаСписок.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.ТаблицаСписок.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	ПолеКД = Новый ПолеКомпоновкиДанных("ИнтересСсылка");
	ВыбранноеПолеКД = Настройки.Структура[0].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКД.Поле = ПолеКД;
	
	ПолеКД = Новый ПолеКомпоновкиДанных("Просрочено");
	ВыбранноеПолеКД = Настройки.Структура[0].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПолеКД.Поле = ПолеКД;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема,Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ИтогПросроченные = 0;
	Для Каждого СтрРезультат Из Результат Цикл
		
		Если СтрРезультат.Просрочено = 1 Тогда
			ИтогПросроченные = ИтогПросроченные + 1;
		КонецЕсли;
		
	КонецЦикла;	
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таб.ИнтересСсылка КАК Интерес,
	|	Таб.Партнер КАК Партнер
	|ПОМЕСТИТЬ ВТДанные
	|ИЗ
	|	&Данные КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Партнер КАК Партнер,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Интерес) КАК Количество
	|ИЗ
	|	ВТДанные 
	|
	|СГРУППИРОВАТЬ ПО
	|	Партнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	Партнер.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА Интерес.смартВоронкаНовые
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ), 0) КАК Новые,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА Интерес.смартВоронкаСтарые
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ), 0) КАК Старые
	|ИЗ
	|	ВТДанные 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Интерес) КАК Количество
	|ИЗ
	|	ВТДанные
	|ГДЕ
	|	Интерес.Дата < &ДатаПросрочки
	|	И Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.Первое)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Интерес.ТипУслуги КАК ТипУслуги,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Интерес) КАК Количество
	|ИЗ
	|	ВТДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	Интерес.ТипУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР КОГДА Интерес.смартИтоговаяКвалификация = ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.ПустаяСсылка) 
	|	ТОГДА Интерес.смартПредварительнаяКвалификация ИНАЧЕ Интерес.смартИтоговаяКвалификация КОНЕЦ КАК Квалификация,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Интерес) КАК Количество
	|ИЗ
	|	ВТДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР КОГДА Интерес.смартИтоговаяКвалификация = ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.ПустаяСсылка) 
	|	ТОГДА Интерес.смартПредварительнаяКвалификация ИНАЧЕ Интерес.смартИтоговаяКвалификация КОНЕЦ");
	
	Запрос.УстановитьПараметр("ДатаПросрочки", ТекущаяДата() - 3600 * 4);	
	Запрос.УстановитьПараметр("Данные", Результат);
	МасРезультат = Запрос.ВыполнитьПакет();
	
	Попытка
		ЭтаФорма.ТаблицаПоказателей.Очистить();
	Исключение
		Возврат;
	КонецПопытки;	
	
	ТабПросроченные = МасРезультат[3].Выгрузить();
	Для Каждого СтрТабПросроченные Из ТабПросроченные Цикл
		
		Если СтрТабПросроченные.Количество > 0 Тогда
			
			СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			СтрТабПоказателей.Показатель = "Просроченные";
			СтрТабПоказателей.Количество = СтрТабПросроченные.Количество;
			СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	ТабТипыУслуг = МасРезультат[4].Выгрузить();
	Для Каждого СтрТабТипыУслуг Из ТабТипыУслуг Цикл
		
		СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		СтрТабПоказателей.Показатель = СтрТабТипыУслуг.ТипУслуги;
		СтрТабПоказателей.Количество = СтрТабТипыУслуг.Количество;
		СтрТабПоказателей.ТипУслуги = СтрТабТипыУслуг.ТипУслуги;
		
	КонецЦикла;
	
	СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
	
	ТабСтарыеНовые = МасРезультат[2].Выгрузить();
	Для Каждого СтрТабСтарыеНовые Из ТабСтарыеНовые Цикл
		
		Если СтрТабСтарыеНовые.Новые > 0 Тогда
			СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			СтрТабПоказателей.Показатель = "Новые";
			СтрТабПоказателей.Количество = СтрТабСтарыеНовые.Новые;
		КонецЕсли;
		
		Если СтрТабСтарыеНовые.Старые > 0 Тогда
			СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			СтрТабПоказателей.Показатель = "Старые";
			СтрТабПоказателей.Количество = СтрТабСтарыеНовые.Старые;
		КонецЕсли;
		
	КонецЦикла;
	
	СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
	
	ТабКвалификации = МасРезультат[5].Выгрузить();
	Для Каждого СтрТабКвалификации Из ТабКвалификации Цикл
		
		СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		СтрТабПоказателей.Показатель = СтрТабКвалификации.Квалификация;
		СтрТабПоказателей.Количество = СтрТабКвалификации.Количество;
		СтрТабПоказателей.Квалификация = СтрТабКвалификации.Квалификация;
		
	КонецЦикла;
	
	СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
	
	ТабПартнеры = МасРезультат[1].Выгрузить();
	Для Каждого СтрТабПартнеры Из ТабПартнеры Цикл
		
		СтрТабПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		Если ЗначениеЗаполнено(СтрТабПартнеры.Партнер) Тогда
			СтрТабПоказателей.Показатель = СтрТабПартнеры.Партнер;
		Иначе
			СтрТабПоказателей.Показатель = "ПАРТНЕР НЕ ЗАПОЛНЕН";
		КонецЕсли;	
		СтрТабПоказателей.Количество = СтрТабПартнеры.Количество;
		СтрТабПоказателей.Партнер = СтрТабПартнеры.Партнер;
		
	КонецЦикла;
	
	Элементы.смартТаблицаПоказателейКоличество.Заголовок = Результат.Количество();
	
КонецПроцедуры //-- #1820 смарт: Фролов 20.05.2024	

#КонецОбласти