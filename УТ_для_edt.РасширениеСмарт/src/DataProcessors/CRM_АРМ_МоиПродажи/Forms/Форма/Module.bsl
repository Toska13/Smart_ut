				ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(ЭтотОбъект[ИмяТаблицы.Представление],, "смартКвалификацияГруппаИли");
				
				Если ЭтаФорма.смартКвалификация.Количество() Тогда
					
					смартКвалификацияГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
													ЭтотОбъект[ИмяТаблицы.Представление].Отбор,
													"смартКвалификацияГруппаИли",
													ТипГруппыЭлементовОтбораКомпоновкиДанных .ГруппаИли);
													
					смартКвалификацияГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
													смартКвалификацияГруппаИли,
													"смартКвалификацияГруппаИ",
													ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
					
					ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
						смартКвалификацияГруппаИ,
						"Объект.смартИтоговаяКвалификация",
						Неопределено,
						ВидСравненияКомпоновкиДанных.НеЗаполнено, 
						"смартИтоговаяКвалификация_НеЗаполнено",
						Истина,
						РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
						
					ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
						смартКвалификацияГруппаИ,
						"Объект.смартПредварительнаяКвалификация",
						ЭтаФорма.смартКвалификация,
						ВидСравненияКомпоновкиДанных.ВСписке, 
						,
						Истина,
						РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);						
						
					ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
						смартКвалификацияГруппаИли,
						"Объект.смартИтоговаяКвалификация",
						ВидСравненияКомпоновкиДанных.ВСписке, 
						ЭтаФорма.смартКвалификация,
						"смартИтоговаяКвалификация_ВСписке",
						Истина,
						РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);								
						
					// Структура группы фильтра
					// Группа ИЛИ
					//  - Группа И
					//  - - смартИтоговаяКвалификация Не Заполнено
					//  - - смартПредварительнаяКвалификация В Списке
					//	- смартИтоговаяКвалификация В Списке
					
				КонецЕсли;
				
				ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
					ЭтотОбъект[ИмяТаблицы.Представление],
					"Объект.смартВоронкаНовые");
					
				ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
					ЭтотОбъект[ИмяТаблицы.Представление],
					"Объект.смартВоронкаСтарые");

				Если Не (ЭтаФорма.смартНовые И ЭтаФорма.смартСтарые)
					И (ЭтаФорма.смартНовые Или ЭтаФорма.смартСтарые) Тогда
					
					ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
						ЭтотОбъект[ИмяТаблицы.Представление],
						"Объект.смартВоронкаНовые",
						ЭтаФорма.смартНовые,
						ВидСравненияКомпоновкиДанных.Равно, 
						,
						ЭтаФорма.смартНовые,
						РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
						
					ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
						ЭтотОбъект[ИмяТаблицы.Представление],
						"Объект.смартВоронкаСтарые",
						ЭтаФорма.смартСтарые,
						ВидСравненияКомпоновкиДанных.Равно, 
						,
						ЭтаФорма.смартСтарые,
						РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

				КонецЕсли;
				//-- #1808 смарт: Ермаков 06.05.2024
				
				#КонецВставки
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ТекущийПользователь <> Пользователи.ТекущийПользователь() Тогда
		ОтборыУстановлены = Истина;
		КоличествоФильтров = КоличествоФильтров + 1;
	КонецЕсли;
	
	Элементы.ОткрытьФильтр.Заголовок = ?(ОтборыУстановлены, НСтр("ru='Фильтр: ';en='Filter: '")
		+КоличествоФильтров,
		 НСтр("ru='Фильтр';en='Filter'"));
	Элементы.ОткрытьФильтр.Картинка = ?(ОтборыУстановлены, БиблиотекаКартинок.CRM_ФильтрАктивный,
		 БиблиотекаКартинок.CRM_ФильтрНеАктивный);
	Элементы.ОткрытьФильтр.ЦветТекста = ?(ОтборыУстановлены, ЦветаСтиля.CRM_ОсновнойГолубой, Новый Цвет(77, 77, 77));
	
	СтруктураОбновленияКолонок = ДанныеКолонокКанбан();
	
	#Вставка //++ #1820 смарт: Фролов 20.05.2024 //Доработка обработки "Мои продажи" - 
	смартОбновитьТаблицуПоказателей();
	#КонецВставки
	
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
