					"Объект",
					СсылкиНаОбъектыСтегами,
					ВидСравненияКомпоновкиДанных.ВСписке, ,
					ОтборВключен,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
					ЭтотОбъект[ИмяТаблицы.Представление],
					"Партнер",
					ПоискКлиент,
					ВидСравненияКомпоновкиДанных.Равно, ,
					ЗначениеЗаполнено(ПоискКлиент),
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
					ЭтотОбъект[ИмяТаблицы.Представление],
					"ТипУслуги",
					ПоискТипУслуги,
					ВидСравненияКомпоновкиДанных.Равно, ,
					ЗначениеЗаполнено(ПоискТипУслуги),
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
					ЭтотОбъект[ИмяТаблицы.Представление],
					"ИсточникПервичногоИнтереса",
					ПоискЗначениеИсточникаПривлечения,
					ВидСравненияКомпоновкиДанных.Равно, ,
					ЗначениеЗаполнено(ПоискЗначениеИсточникаПривлечения),
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
