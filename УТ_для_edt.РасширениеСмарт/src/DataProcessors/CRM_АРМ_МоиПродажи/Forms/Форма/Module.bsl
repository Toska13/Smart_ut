		ИмяРеквизитаСумма = "Декорация_"+ИмяРеквизита+"_Сумма";
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаСумма) Тогда
