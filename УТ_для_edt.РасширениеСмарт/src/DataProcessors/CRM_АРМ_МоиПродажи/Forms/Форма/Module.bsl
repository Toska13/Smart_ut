
//++#1558 смарт: Лопато 14.11.2023 //Доработка фильтров АРМ Мои продажи  
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВремяНачалаЗамера = ОценкаПроизводительности.НачатьЗамерВремени();
	
	#Вставка //++ #1820 смарт: Фролов 20.05.2024 //Доработка обработки "Мои продажи" -
	смартГруппаОтборы = Этаформа.Элементы.Вставить("смартГруппаОтборы", Тип("ГруппаФормы"), Элементы.ГруппаАРМ, Элементы.ГруппаВоронка);
	смартГруппаОтборы.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаОтборы.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	смартГруппаОтборы.ОтображатьЗаголовок = Ложь;
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТаблицаПоказателей", Новый ОписаниеТипов("ТаблицаЗначений")));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Показатель", Новый ОписаниеТипов("Строка"), "ТаблицаПоказателей" , "Показатель"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3)), "ТаблицаПоказателей" , "Количество"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Партнер", Новый ОписаниеТипов("СправочникСсылка.Партнеры"), "ТаблицаПоказателей", "Партнер"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("ТипУслуги", Новый ОписаниеТипов("СправочникСсылка.CRM_ТипУслуги"), "ТаблицаПоказателей", "ТипУслуги"));
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Квалификация", Новый ОписаниеТипов("СправочникСсылка.смартКвалификацииМенеджеров"), "ТаблицаПоказателей", "Квалификация"));
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	ПолеТаблицаПоказателей = Элементы.Вставить("смартТаблицаПоказателей", Тип("ТаблицаФормы"), Элементы.смартГруппаОтборы, Неопределено);
	ПолеТаблицаПоказателей.ПутьКДанным = "ТаблицаПоказателей";
	ПолеТаблицаПоказателей.Отображение = ОтображениеТаблицы.Список;
	ПолеТаблицаПоказателей.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ПолеТаблицаПоказателей.ТолькоПросмотр = Истина;
	ПолеТаблицаПоказателей.ЦветФона = Новый Цвет(255, 255, 255);
	ПолеТаблицаПоказателей.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеТаблицаПоказателей.Шапка = Ложь;
	ПолеТаблицаПоказателей.ЧередованиеЦветовСтрок = Ложь;
	ПолеТаблицаПоказателей.Ширина = 28;
	ПолеТаблицаПоказателей.АвтоМаксимальнаяШирина = Ложь;
	ПолеТаблицаПоказателей.ГоризонтальныеЛинии = Ложь;
	ПолеТаблицаПоказателей.РастягиватьПоГоризонтали = Ложь;
	ПолеТаблицаПоказателей.ЦветРамки = Новый Цвет(250, 250, 250);
	ПолеТаблицаПоказателей.ЦветФона = Новый Цвет(240, 240, 240);
	ПолеТаблицаПоказателей.УстановитьДействие("Выбор", "смартТаблицаПоказателейВыбор");
	
	НоваяКолонка = Элементы.Добавить("ТаблицаПоказателейПоказатель", Тип("ПолеФормы"), Элементы.смартТаблицаПоказателей);
	НоваяКолонка.Заголовок = "Показатель";
	НоваяКолонка.ПутьКДанным = "ТаблицаПоказателей.Показатель";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.Ширина = 25;
	НоваяКолонка.Шрифт = Новый Шрифт(НоваяКолонка.Шрифт, "Arial", 10, Истина, , Истина);
	НоваяКолонка.ЦветТекста = Новый Цвет(28, 85, 174);
	НоваяКолонка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
	НоваяКолонка = Элементы.Добавить("ТаблицаПоказателейКоличество", Тип("ПолеФормы"), Элементы.смартТаблицаПоказателей);
	НоваяКолонка.Заголовок = "Количество";
	НоваяКолонка.ПутьКДанным = "ТаблицаПоказателей.Количество";
	НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;
	НоваяКолонка.Ширина = 3;
	НоваяКолонка.Шрифт = Новый Шрифт(НоваяКолонка.Шрифт, "Arial", 10, Истина, , Истина);
	НоваяКолонка.ЦветТекста = Новый Цвет(28, 85, 174);
	НоваяКолонка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("смартТаблицаПоказателейЗаголовок", Тип("ДекорацияФормы"), смартГруппаОтборы, Элементы.смартТаблицаПоказателей);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Быстрые отборы";
	НовыйЭлемент.Шрифт = Новый Шрифт(НоваяКолонка.Шрифт, "Arial", 12, Истина,,Ложь);
	НовыйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("смартТаблицаПоказателейКоличество", Тип("ДекорацияФормы"), смартГруппаОтборы, Элементы.смартТаблицаПоказателей);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Шрифт = Новый Шрифт(НоваяКолонка.Шрифт, "Arial", 12, Истина,,Ложь);
	НовыйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	ГруппаЭлементовОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаЭлементовОтбора.Использование = Истина;
	
	ЭлементОтбора = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаПоказателей.Показатель"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;  
	ЭлементОтбора.ПравоеЗначение = "Просроченные";  
	ЭлементОтбора.Использование = Истина;
	
	ЭлементОтбора = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаПоказателей.Количество"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;  
	ЭлементОтбора.ПравоеЗначение = 0;     
	ЭлементОтбора.Использование = Истина;
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();      
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("смартТаблицаПоказателей");
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	ПолеОформления.Использование = Истина; 
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	ГруппаЭлементовОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	ГруппаЭлементовОтбора.Использование = Истина;
	
	ЭлементОтбора = ГруппаЭлементовОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаПоказателей.Количество"); 
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;  
	ЭлементОтбора.ПравоеЗначение = 0;     
	ЭлементОтбора.Использование = Истина;
	
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();      
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("смартТаблицаПоказателей");
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Белый);
	ПолеОформления.Использование = Истина;
	
	
	#КонецВставки
	
	Если НЕ CRM_ЛицензированиеЭкспортныеМетоды.ПодсистемаCRMИспользуется() Тогда
		
		// +Рарус alexpr
		//CRM_ЛицензированиеЭкспортныеМетоды.ВывестиУведомлениеОНедоступности(НСтр("ru = 'АРМ ""Мои продажи""'"));
		ТекстСообщения = НСтр("ru = 'Невозможно открыть АРМ ""Мои продажи"".
                               |Подсистема 1С:CRM не используется! (отключено в Персональных настройках)'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		// +Рарус alexpr
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	CRM_ЛицензированиеЭкспортныеМетоды.ПолучитьЗащищеннуюОбработку().ПриСозданииНаСервере(ЭтотОбъект,
		 Отказ,
		 СтандартнаяОбработка);
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ТекущаяРоль = Справочники.РолиИсполнителей.ПустаяСсылка();
	ОтборПоРолиУстановлен = Истина;
	ВидАРМ = "Канбан";
	
	ИнициализироватьДанныеВоронкиПродаж();
	
	CRM_Теги.ОбновитьЗначенияОтбораПериодов(ЭтотОбъект, Истина);
	
	ТекущаяДата = ТекущаяДатаСеанса();
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.ТаблицаСписок,
		 "ПериодПросроченных", НачалоДня(ТекущаяДата),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.ТаблицаСписок,
		 "ПериодТекущих", КонецДня(ТекущаяДата),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.ТаблицаСписок,
		 "ПустаяДата", Дата('00010101'),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.НеРазобрано,
		 "ПериодПросроченных", НачалоДня(ТекущаяДата),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.НеРазобрано,
		 "ПериодТекущих", КонецДня(ТекущаяДата),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.НеРазобрано,
		 "ПустаяДата", Дата('00010101'),
		 Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.НеРазобрано,
		 "ТекстФайл", НСтр("ru = 'Файл...'; en = 'File...'"),
		 Истина);
	CRM_СмещениеДатыТекущегоСеанса = СмещениеСтандартногоВремени(ЧасовойПоясСеанса());
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЭтотОбъект.НеРазобрано,
		 "CRM_СмещениеДатыТекущегоСеанса",
		 CRM_СмещениеДатыТекущегоСеанса);
	
	// +Рабочий стол
	CRM_СобытияФорм.ПриСозданииНаСервере(ЭтотОбъект, Отказ, СтандартнаяОбработка);
	// -Рабочий стол
	
	// +Виджеты
	Если ПолучитьФункциональнуюОпцию("CRM_ИспользоватьПоказатели") Тогда
		ВидимостьВиджетов = ХранилищеОбщихНастроек.Загрузить(ЭтотОбъект.ИмяФормы, "ПоказыватьПанельВиджетов");
		ПоказыватьВиджетыПриОткрытии = ?(ВидимостьВиджетов <> Неопределено, ВидимостьВиджетов, Ложь);
		Элементы.ГруппаВиджеты.Видимость = ПоказыватьВиджетыПриОткрытии;
		Элементы.СкрытьОтобразитьВиджеты.Пометка = ПоказыватьВиджетыПриОткрытии;
		Элементы.СкрытьОтобразитьВиджеты.Видимость = Истина;
	Иначе
		ВидимостьВиджетов = Ложь;
		ПоказыватьВиджетыПриОткрытии = Ложь;
		Элементы.СкрытьОтобразитьВиджеты.Видимость = Ложь;
		Элементы.ГруппаВиджеты.Видимость = Ложь;
	КонецЕсли;
	Если ПоказыватьВиджетыПриОткрытии Тогда
		ОбновитьВиджетыФормы();
	КонецЕсли;
	// -Виджеты
	
	СписокПериодов.Добавить("ПроизвольныйПериод", НСтр("ru='Произвольный период';en='Custom Period'"));
	СписокПериодов.Добавить("Сегодня", НСтр("ru='Сегодня';en='Today'"));
	СписокПериодов.Добавить("3 дня", НСтр("ru='3 дня';en='3 days'"));
	СписокПериодов.Добавить("Неделя", НСтр("ru='Неделя';en='Week'"));
	СписокПериодов.Добавить("Месяц", НСтр("ru='Месяц';en='Month'"));
	
	КлючОбъекта = "Обработка.CRM_АРМ_МоиПродажи.Форма.Форма/ТекущиеДанные";
	Настройки = ОбщегоНазначения.ХранилищеСистемныхНастроекЗагрузить(КлючОбъекта, "", Новый Соответствие);
	НастройкиСтруктура = Новый Структура;
	Для Каждого КлючИЗначение Из Настройки Цикл
		Если ТипЗнч(КлючИЗначение.Ключ) = Тип("Строка") Тогда
			НастройкиСтруктура.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, НастройкиСтруктура);
	КонецЦикла;
	
	Если Настройки.Количество() > 0 Тогда
		
		ПоискКлиент = Настройки.Получить("ПоискКлиент");
		ПоискИсточникПривлечения = Настройки.Получить("ПоискИсточникПривлечения");
		ПоискЗначениеИсточникаПривлечения = Настройки.Получить("ПоискЗначениеИсточникаПривлечения");
		ПоискТипУслуги = Настройки.Получить("ПоискТипУслуги");
		ВоронкаПродаж = Настройки.Получить("ВоронкаПродаж");
		ВариантПериода = Настройки.Получить("ВариантПериода");
		ПериодОтбора =  Настройки.Получить("ПериодОтбора");
		//ОтборСозданы[0].Значение = ПериодОтбора;
		
		ОтборВключатьПросроченные = Настройки.Получить("ОтборВключатьПросроченные");
		Если Не ЗначениеЗаполнено(ОтборВключатьПросроченные) Тогда
			ОтборВключатьПросроченные = 2;
		КонецЕсли;
	КонецЕсли;
	
	Если ВоронкаПродаж.Пустая() ИЛИ ВоронкаПродаж.ПометкаУдаления Тогда
		ВоронкаПродаж = Справочники.CRM_ВоронкиПродаж.Интересы;
		Настройки.Вставить("ВоронкаПродаж", ВоронкаПродаж);
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъекта, "", Настройки);
	КонецЕсли;
	Элементы.ВыборСценария.Заголовок = ВоронкаПродаж;
	
	Если Не ЗначениеЗаполнено(ВариантПериода) Тогда
		#Удаление
		ВариантПериода = "Неделя";
		ПериодОтбора = Новый СтандартныйПериод(ВариантСтандартногоПериода.Следующие7Дней);
		#КонецУдаления
		#Вставка
		ВариантПериода = "ПроизвольныйПериод";
		ПериодОтбора = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПроизвольныйПериод);
		#КонецВставки
		//ОтборСозданы[0].Значение = ПериодОтбора;
	КонецЕсли;
	
	Если ВариантПериода = "ПроизвольныйПериод" Тогда
		НомерПериода = 0;
	ИначеЕсли ВариантПериода = "Сегодня" Тогда
		НомерПериода = 1;
	ИначеЕсли ВариантПериода = "3 дня" Тогда
		НомерПериода = 2;
	ИначеЕсли ВариантПериода = "Неделя" Тогда
		НомерПериода = 3;
	ИначеЕсли ВариантПериода = "Месяц" Тогда
		НомерПериода = 4;
	КонецЕсли;
	
	Период = ОтборСозданы[НомерПериода];
	ПериодОтбора = ОтборСозданы[НомерПериода].Значение;
	
	Если НомерПериода = 0 Тогда
		Если ЗначениеЗаполнено(Период.Значение.ДатаНачала) Или ЗначениеЗаполнено(Период.Значение.ДатаОкончания) Тогда
			Период.Пометка = Истина;
		Иначе
			Период.Пометка = Ложь;
		КонецЕсли;
	Иначе
		Период.Пометка = Не Период.Пометка;
	КонецЕсли;
	
	// Вариант периода может быть выбран только один.
	Для Индекс = 0 По ОтборСозданы.Количество()-1 Цикл
		ЭлементСпискаПериодов = ОтборСозданы[Индекс];
		Если ЭлементСпискаПериодов <> Период Тогда
			ЭлементСпискаПериодов.Пометка = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеПериода = СписокПериодов.НайтиПоЗначению(ВариантПериода);
	Если ЗначениеПериода<>Неопределено Тогда
		ПредставлениеПериода = ЗначениеПериода.Представление;
	КонецЕсли;
	
	Календарь = Константы.ОсновнойКалендарьПредприятия.Получить();
	
	ВоронкаПродажПриИзмененииНаСервере();
	
	Элементы.ГруппаНеРазобрано.Видимость = НЕ СкрытьКолонкуОбращения;
	НеРазобраноСводныеДанные_Видимость();
	Если НеРазобраноСводныеДанные_ПериодОбновления = 0 Тогда
		НеРазобраноСводныеДанные_ПериодОбновления = 1;
	КонецЕсли;
	
	ОбновитьОтборыНаСервере();
	
	СоздатьКнопиОтборПросроченные();
	СоздатьКнопкиВидАРМ();
	ПокраситьКнопкиПросроченныеНаСервере();
	
	УстановитьШиринуЭлементовКоманднойПанели();
	
	// +Рарус alexpr
	//// РаспознаваниеРечи
	//РаспознаваниеРечи_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка);
	//// Конец РаспознаваниеРечи
	// -Рарус alexpr
	
	CRM_ОбщегоНазначенияСервер.ЗакончитьЗамерВремениСозданияФормы(ЭтотОбъект, ВремяНачалаЗамера);
	
	// +Рарус alexpr
	Элементы.ОткрытьПутьКлиента.Видимость = Ложь;
	// -Рарус alexpr
	
КонецПроцедуры //--#1558 смарт: Лопато 14.11.2023

