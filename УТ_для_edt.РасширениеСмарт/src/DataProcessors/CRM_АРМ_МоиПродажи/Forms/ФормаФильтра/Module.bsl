&Перед("ПриСозданииНаСервере")
Процедура extCRM_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)
//--#1558 смарт: Лопато 15.11.2023
	
	//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
	МассивДобавляемыхРеквизитов = Новый Массив;                   
	МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("extCRM_ПоискАвтор", Новый ОписаниеТипов("СправочникСсылка.Пользователи"), ""));
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);       
	
	НовыйЭлемент = Элементы.Вставить("extCRM_ПоискАвтор", Тип("ПолеФормы"), Элементы.Группа, Элементы.ПоискИсточникПривлечения);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "extCRM_ПоискАвтор";
	НовыйЭлемент.Заголовок = "Автор";
	НовыйЭлемент.ШрифтЗаголовка = Новый Шрифт(НовыйЭлемент.Шрифт, , 13);
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "extCRM_ПоискАвторПриИзменении");
	НовыйЭлемент.УстановитьДействие("Очистка", "extCRM_ПоискАвторОчистка");
	
	Элементы.ТекущийПользователь.КнопкаОчистки = Истина;
	Элементы.ТекущийПользователь.УстановитьДействие("Очистка", "extCRM_ТекущийПользовательОчистка");
	
	ПараметрыВыбораПользователь = Новый Массив;
	ПараметрыВыбораПользователь.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", ПараметрыСеанса.CRM_ДоступныеПользователи));
	Элементы.extCRM_ПоискАвтор.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораПользователь);
	//--#1542 смарт: Лопато 03.11.2023
	
КонецПроцедуры

