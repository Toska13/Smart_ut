&НаКлиенте
Процедура extCRM_ПоискАвторОчистка(Элемент, СтандартнаяОбработка)

	ЭтотОбъект.extCRM_ПоискАвтор = Неопределено;
	
	extCRM_ПоискАвторПриИзмененииНаСервере();
	
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
&НаКлиенте
Процедура extCRM_ПоискАвторПриИзменении(Элемент)
	
	extCRM_ПоискАвторПриИзмененииНаСервере();
	
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
&НаСервере
Процедура extCRM_ПоискАвторПриИзмененииНаСервере()
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект.extCRM_ПоискАвтор) И Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
		ТекущийПользователь = ТекущийПользовательСтарый;	
		ЭтотОбъект.ОтборТеги.Очистить();
		Подразделение = ТекущийПользователь.Подразделение;
		СписокВышестоящихПодразделений.ЗагрузитьЗначения(CRM_МетодыМодулейМенеджеровСправочников.ПолучитьВсеПодразделенияРодители(Подразделение, Истина));
	КонецЕсли;
	
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
&НаКлиенте
Процедура extCRM_ТекущийПользовательОчистка(Элемент, СтандартнаяОбработка)
	
	ЭтотОбъект.ТекущийПользователь = Неопределено;
	
	extCRM_ТекущийПользовательПриИзмененииНаСервере();
	
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
&НаСервере
&ИзменениеИКонтроль("ТекущийПользовательПриИзмененииНаСервере")
Процедура extCRM_ТекущийПользовательПриИзмененииНаСервере()
	Если ТекущийПользовательСтарый <> ТекущийПользователь Тогда
		Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
			ЭтотОбъект.ОтборТеги.Очистить();
			Подразделение = ТекущийПользователь.Подразделение;
			СписокВышестоящихПодразделений.ЗагрузитьЗначения(CRM_МетодыМодулейМенеджеровСправочников.ПолучитьВсеПодразделенияРодители(Подразделение, Истина));
		#Удаление
		Иначе
		#КонецУдаления
		#Вставка
		ИначеЕсли Не ЗначениеЗаполнено(ЭтотОбъект.extCRM_ПоискАвтор) Тогда
		#КонецВставки
			ТекущийПользователь = ТекущийПользовательСтарый;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023

//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
&НаСервере
&ИзменениеИКонтроль("ПолучитьСтруктуруФильтра")
Функция extCRM_ПолучитьСтруктуруФильтра()
	СтруктураФильтра = Новый Структура;
	СтруктураФильтра.Вставить("СкрытьПропущенныеТелефонныеЗвонки", СкрытьПропущенныеТелефонныеЗвонки);
	СтруктураФильтра.Вставить("СкрытьОтвеченныеТелефонныеЗвонки", СкрытьОтвеченныеТелефонныеЗвонки);
	СтруктураФильтра.Вставить("СкрытьЗаявки", СкрытьЗаявки);
	СтруктураФильтра.Вставить("СкрытьСообщения", СкрытьСообщения);
	СтруктураФильтра.Вставить("ОтборВключен", ОтборВключен);
	СтруктураФильтра.Вставить("ОтборТеги", ОтборТеги);
    СтруктураФильтра.Вставить("ОтображатьПисьма", ОтображатьПисьма);
	СтруктураФильтра.Вставить("СкрытьКолонкуОбращения", СкрытьКолонкуОбращения);
	СтруктураФильтра.Вставить("СкрытьПовторныеОбращения", СкрытьПовторныеОбращения);
	СтруктураФильтра.Вставить("ВариантПериода", ВариантПериода);
	СтруктураФильтра.Вставить("ПоискКлиент", ПоискКлиент);
	СтруктураФильтра.Вставить("ПоискТипУслуги", ПоискТипУслуги);
	СтруктураФильтра.Вставить("ПоискПроект", ПоискПроект);
	СтруктураФильтра.Вставить("ТекущийПользователь", ТекущийПользователь);
	СтруктураФильтра.Вставить("ПоискИсточникПривлечения", ПоискИсточникПривлечения);
	СтруктураФильтра.Вставить("ПоискЗначениеИсточникаПривлечения", ПоискЗначениеИсточникаПривлечения);
	#Вставка
	СтруктураФильтра.Вставить("extCRM_ПоискАвтор", ЭтотОбъект.extCRM_ПоискАвтор);
	#КонецВставки
	
	Возврат СтруктураФильтра;
КонецФункции //--#1542 смарт: Лопато 03.11.2023
