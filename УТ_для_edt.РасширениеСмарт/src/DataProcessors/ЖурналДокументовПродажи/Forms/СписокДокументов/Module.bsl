#Область ДоработкиСмарт

&НаКлиенте
Процедура СкопироватьВБуферОбмена(Текст)
	DOM=Элементы.смартБФ.Документ.DefaultView.document;
	textArea=DOM.createElement("textarea");
	textArea.value=Текст;
	DOM.body.appendChild(textArea);
	textArea.focus();
	textArea.select();
	DOM.execCommand("copy");
	DOM.body.removeChild(textArea);
КонецПроцедуры

&НаКлиенте
Процедура смартПодписать(Команда)
	ТекущиеДанные=Элементы.СписокДокументыПродажи.ТекущиеДанные;
	Ссылка=ТекущиеДанные.Ссылка;
	Если Не (ТипЗнч(Ссылка)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Или ТипЗнч(Ссылка)=Тип("ДокументСсылка.АктВыполненныхРабот")) Тогда 
		Состояние("По выбранной строке не устанавливается свойство 'Документ подписан'",,"Установка 'Документ подписан' 
		|только для Реализации товаров услуг
		|и Актов выполненных работ.");
		Возврат;
	КонецЕсли;
	Результат=РезультатПодписиДокумента(Ссылка);
	Если Результат.Подписан Тогда
		СкопироватьВБуферОбмена(Результат.ИмяФайла);
		Элементы.СписокДокументыПродажи.Обновить();
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция РезультатПодписиДокумента(Ссылка)
	Результат=Новый Структура("Подписан,ИмяФайла",Ложь);
	СчетФактура=УчетНДСРФВызовСервера.СчетФактураВыданныйПоОснованию(Ссылка,Ссылка.Организация);
	Результат.ИмяФайла=смартСервер.ПолучитьИмяФайлаДляБуфераОбмена(Ссылка.ЗаказКлиента,СчетФактура);
	
	ДанныеПроверки=смартСервер.ЕстьВозможностьПодписатьДокумент(Ссылка,Ссылка.ЗаказКлиента,СчетФактура);
	Результат.Подписан=ДанныеПроверки.Результат;
	Если Не ДанныеПроверки.Результат Тогда
		Для Каждого Ошибка Из ДанныеПроверки.Ошибки Цикл 
			ОбщегоНазначения.СообщитьПользователю(Ошибка);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура смартСнятьПодпись(Команда)
	ТекущиеДанные=Элементы.СписокДокументыПродажи.ТекущиеДанные;
	Ссылка=ТекущиеДанные.Ссылка;
	Если Не (ТипЗнч(Ссылка)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Или ТипЗнч(Ссылка)=Тип("ДокументСсылка.АктВыполненныхРабот"))
		И Не ТекущиеДанные.Подписан Тогда
		Возврат;
	КонецЕсли;
	СнятьПодписьСДокумента(Ссылка);
	Элементы.СписокДокументыПродажи.Обновить();
КонецПроцедуры

&НаСервере
Процедура СнятьПодписьСДокумента(Ссылка)
	смартСервер.УстановитьДокументПодписан(Ссылка,Ссылка.ЗаказКлиента,Ложь);
КонецПроцедуры	

&НаКлиенте
Процедура смартСкопировать(Команда)
	ТекущиеДанные=Элементы.СписокДокументыПродажи.ТекущиеДанные;
	Ссылка=ТекущиеДанные.Ссылка;
	Если Не (ТипЗнч(Ссылка)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Или ТипЗнч(Ссылка)=Тип("ДокументСсылка.АктВыполненныхРабот")) Тогда 
		Состояние("По выбранной строке не устанавливается свойство 'Документ подписан'",,"Установка 'Документ подписан' 
		|только для Реализации товаров услуг
		|и Актов выполненных работ.");
		Возврат;
	КонецЕсли;
	ТекстДляБуфераОбмена=ПолучитьТекстДляБуфераОбмена(Ссылка);	
	СкопироватьВБуферОбмена(ТекстДляБуфераОбмена);
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстДляБуфераОбмена(Ссылка)
	СчетФактура=УчетНДСРФВызовСервера.СчетФактураВыданныйПоОснованию(Ссылка,Ссылка.Организация);
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Сообщить("По выбранному документу не введена счет фактура.");
		Возврат Неопределено;
	КонецЕсли;
	Возврат смартСервер.ПолучитьИмяФайлаДляБуфераОбмена(Ссылка.ЗаказКлиента,СчетФактура);
КонецФункции	

&НаКлиенте
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)
Процедура смартСформироватьПакетДокументов(Команда)
	
	ВыделенныеСтроки = Элементы.СписокДокументыПродажи.ВыделенныеСтроки;
	
	МассивИД = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		МассивИД.Добавить(ВыделеннаяСтрока);
	КонецЦикла;
	
	Для Каждого ИД Из МассивИД Цикл		
		ДанныеСтроки = Элементы.СписокДокументыПродажи.ДанныеСтроки(ИД);
		ДокСсылка = ДанныеСтроки.Ссылка;
		Если ТипЗнч(ДокСсылка)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			смартСформироватьПакетДокументовДалее(ДокСсылка);		 
		КонецЕсли;
	КонецЦикла;	
	
	Элементы.СписокДокументыПродажи.Обновить();
	
КонецПроцедуры  //-- #1353 смарт: Фролов 04.09.2023

&НаКлиенте
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
Процедура смартСформироватьПакетДокументовДалее(ДокСсылка) Экспорт
	
	// 1. Создание подкаталога
	// 2. Формирование ПФ УПД, Счета, заявки на машину, заявки на отгрузку
	// 3. Запись в РС
	// 4. Отправка документов на эл. почту
	
	Успех = Истина;
		
	Склад = Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(ДокСсылка, "Склад"); 
	
	//++ #1932 смарт: Мосолов 17.07.2024 //Ошибка формирования пакета документов на Адмирал  
	//Если НЕ Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Склад, "смартАвтоматическиФормироватьДокументы") Тогда 
	//++ #Б-2540 смарт: Лопато 27.02.2025 //Ошибка при формировании пакета документов на Адмирал Ковчег по ООО Ковчег  
	Если Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Склад, "ЭтоГруппа") 
		ИЛИ НЕ Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Склад, "смартАвтоматическиФормироватьДокументы") Тогда  
	//-- #Б-2540 смарт: Лопато 27.02.2025
	//-- #1932 смарт: Мосолов 17.07.2024   
	
		ОбщегоНазначенияКлиент.СообщитьПользователю("Пакет документов формируется только для склада Адмирал, для реализации "+ДокСсылка+" пакет не может быть сформирован");
		Возврат;
	КонецЕсли;
	
	Если Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Склад, "смартФормироватьДокументыУТБП") = ПредопределенноеЗначение("Перечисление.смартФормироватьДокументыУТБП.БП") Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Пакет документов для реализации "+ДокСсылка+" формируется в базе Бухгалтерии");
		Возврат;
	КонецЕсли;	
	ЗаказКлиента=Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(ДокСсылка, "ЗаказКлиента"); 
	Если НЕ ЗначениеЗаполнено(ЗаказКлиента) Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для корректного формирования пакета для реализации "+ДокСсылка+" должен быть указан Заказ клиента");
		Возврат;
	КонецЕсли;
	
	Если НЕ Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(ЗаказКлиента, "СпособДоставки") = ПредопределенноеЗначение("Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал") Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю("Пакет документов для реализации "+ДокСсылка+" не сформирован, потому что способ доставки в документе не ""Самовывоз со склада Адмирал""");
		Возврат;
	КонецЕсли;
	
	КаталогСохраненияФайлов = смартОбщегоНазначенияКлиент.СоздатьКаталогПФРеализацияТиУ(ДокСсылка,,Склад);
	
	Если НЕ ЗначениеЗаполнено(КаталогСохраненияФайлов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен каталог для сохранения файлов. ПФ не сформированы.");
		Возврат;
	КонецЕсли;
	
	// 2.3 Формирование заявки на машину
	// 2.4 Формирование заявки на отгрузку

	// Подключение к УТ для получения данных из Заказа клиента
	
	ТабДокументыПоДаннымИзУТ = смартСформироватьТабличныеДокументыДляПакета(ДокСсылка);
		
	СпособОтгрузкиСоСкладаАдмирал = Ложь;
	ВЗаказеСкладАдмирал = Ложь;
	НазваниеАвто = "";
	НомерАвто = "";
	
	ИмяФайлаЗаявкаНаМашину = "";
	ТабДокЗаявкаНаМашину = ТабДокументыПоДаннымИзУТ.ТабДокЗаявкаНаМашину;
	ИмяФайлаЗаявкаНаМашину = ТабДокументыПоДаннымИзУТ.ИмяФайлаЗаявкаНаМашину;

	ПолноеИмяФайлаЗаявкаНаМашину = КаталогСохраненияФайлов + "\" + ИмяФайлаЗаявкаНаМашину;
	
		
	ИмяФайлаЗаявкаНаОтгрузку = "";
	ТабДокЗаявкаНаОтгрузку = ТабДокументыПоДаннымИзУТ.ТабДокЗаявкаНаОтгрузку;
	ИмяФайлаЗаявкаНаОтгрузку = ТабДокументыПоДаннымИзУТ.ИмяФайлаЗаявкаНаОтгрузку;

	ПолноеИмяФайлаЗаявкаНаОтгрузку = КаталогСохраненияФайлов + "\" + ИмяФайлаЗаявкаНаОтгрузку;
	
	НазваниеАвто = ТабДокументыПоДаннымИзУТ.НазваниеАвто;
	НомерАвто = ТабДокументыПоДаннымИзУТ.НомерАвто;
	СпособОтгрузкиСоСкладаАдмирал = ТабДокументыПоДаннымИзУТ.СпособОтгрузкиСоСкладаАдмирал;
	ВЗаказеСкладАдмирал = ТабДокументыПоДаннымИзУТ.ВЗаказеСкладАдмирал;
	
	Если НЕ ВЗаказеСкладАдмирал Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("В заказе клиента в УТ не указан склад Адмирал");
		Возврат;		
	КонецЕсли;
	
	// 2.7 Формирование XML
	
	ДокСсылкаНомер = Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(ДокСсылка, "Номер");
	ДокСсылкаДата = Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(ДокСсылка, "Дата");
	
	
	ИмяФайлаXMLПоЗаявкамНаОтгрузку = "ПакетДанныхПоЗаявкамНаОтгрузку " 
										+ ДокСсылкаНомер + " " + Формат(ДокСсылкаДата, "ДЛФ=Д") + " " + СокрЛП(Строка(Склад)) + ".XML";
	ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку = КаталогСохраненияФайлов + "\" + ИмяФайлаXMLПоЗаявкамНаОтгрузку;
	
	
	ДвоичныеДанныеXML = ТабДокументыПоДаннымИзУТ.ДвоичныеДанныеXML;
	
	УспехЗаписиXML = Ложь;
	
	ОтправлятьПисьмо = Истина;
	
	Если НЕ СпособОтгрузкиСоСкладаАдмирал Тогда
		ОтправлятьПисьмо = Ложь;
		ТабДокЗаявкаНаМашину = Неопределено;
	КонецЕсли;
	
	// 2.1 Формирование УПД
	
	ИмяФайлаУПД = "";
	//Если смартОбщегоНазначения.ЭтоУниверсальныйДокумент(ДокСсылка) Тогда 
		ТабДокУПД = смартСформироватьТабличныйДокументУПД(ДокСсылка, ИмяФайлаУПД);
	//Иначе
	//	ТабДокУПД = смартОбщегоНазначения.СформироватьТабличныйДокументТОРГ12(ДокСсылка, ИмяФайлаУПД);
	//КонецЕсли;

	Если ТабДокУПД = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ УПД. Возможно, для документа " + ДокСсылка + " не введен счет-фактура");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаУПД) Тогда
		ИмяФайлаУПД = "УПД";		
	КонецЕсли;
	
	ПолноеИмяФайлаУПД = КаталогСохраненияФайлов + "\" + ИмяФайлаУПД;
	
	// 2.2 Формирование Счета

	ИмяФайлаСчет = "";
	ТабДокСчет = смартСформироватьТабличныйДокументСчет(ДокСсылка, ИмяФайлаСчет);	
	Если ТабДокСчет = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ счета на оплату. Возможно, для документа " + ДокСсылка + " не введен счет");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИмяФайлаСчет) Тогда
		ИмяФайлаСчет = "Счет";
	КонецЕсли;
	
	ПолноеИмяФайлаСчет = КаталогСохраненияФайлов + "\" + ИмяФайлаСчет;
	Если СпособОтгрузкиСоСкладаАдмирал Тогда
		
		// 2.5 Формирование Транспортной накладной
		
		ИмяФайлаТН = "";
		ТабДокТН = смартСформироватьТабличныйДокументТранспортнаяНакладная(ДокСсылка, ИмяФайлаТН, НазваниеАвто, НомерАвто);	
		Если ТабДокТН = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ транспортной накладной.");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяФайлаТН) Тогда
			ИмяФайлаТН = "ТранспортнаяНакладная";
		КонецЕсли;
		
		ПолноеИмяФайлаТН = КаталогСохраненияФайлов + "\" + ИмяФайлаТН;
		
	Иначе
		ТабДокТН = Неопределено;
	КонецЕсли;
			
	// Сохранение файлов
	
	Попытка
		ТабДокУПД.Записать(ПолноеИмяФайлаУПД, ТипФайлаТабличногоДокумента.PDF);
		ТабДокСчет.Записать(ПолноеИмяФайлаСчет, ТипФайлаТабличногоДокумента.PDF);
		
		Если ТабДокЗаявкаНаМашину <> Неопределено Тогда
			ТабДокЗаявкаНаМашину.Записать(ПолноеИмяФайлаЗаявкаНаМашину, ТипФайлаТабличногоДокумента.XLSX);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаЗаявкаНаМашину);
		КонецЕсли;
		
		Если ТабДокЗаявкаНаОтгрузку <> Неопределено Тогда
			ТабДокЗаявкаНаОтгрузку.Записать(ПолноеИмяФайлаЗаявкаНаОтгрузку, ТипФайлаТабличногоДокумента.XLSX);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаЗаявкаНаОтгрузку);
		КонецЕсли;
		
		Если ТабДокТН <> Неопределено Тогда
			ТабДокТН.Записать(ПолноеИмяФайлаТН, ТипФайлаТабличногоДокумента.PDF);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаТН);
		КонецЕсли;
		
		Если ТипЗнч(ДвоичныеДанныеXML) = Тип("ДвоичныеДанные") Тогда
			ДвоичныеДанныеXML.Записать(ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку);
			УспехЗаписиXML = Истина;
			ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку);
		КонецЕсли;
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаУПД);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаСчет);
				
	Исключение
		Успех = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось сохранить печатные формы:" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
		
	
	Если Успех Тогда    
		
		//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке  
		Если ТипЗнч(ДокСсылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			смартЗаписатьИнформациюОЗаписиПакета(ДокСсылка, КаталогСохраненияФайлов);
			
		КонецЕсли;
		//-- #1766 смарт: Мосолов 09.04.2024 
		
		// 4. Отправка документов на эл. почту
		
		Если ОтправлятьПисьмо Тогда
			
		АдресХранилищаУПД = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаУПД), Новый УникальныйИдентификатор);
		АдресХранилищаСчет = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаСчет), Новый УникальныйИдентификатор);
		АдресХранилищаЗаявкаНаМашину = "";
		
		Если ТабДокЗаявкаНаМашину <> Неопределено Тогда			
			АдресХранилищаЗаявкаНаМашину = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаЗаявкаНаМашину), Новый УникальныйИдентификатор);
		КонецЕсли;
		
		Если ТабДокЗаявкаНаОтгрузку <> Неопределено Тогда
			АдресХранилищаЗаявкаНаОтгрузку = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаЗаявкаНаОтгрузку), Новый УникальныйИдентификатор);
		КонецЕсли;
		
		Если ТабДокТН <> Неопределено Тогда
			АдресХранилищаТН = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаТН), Новый УникальныйИдентификатор);
		КонецЕсли;
		
		МассивСтруктур = Новый Массив;
		
		ТекСтруктура = Новый Структура;
		ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаУПД);
		ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаУПД);
		МассивСтруктур.Добавить(ТекСтруктура);
		
		ТекСтруктура = Новый Структура;
		ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаСчет);
		ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаСчет);
		МассивСтруктур.Добавить(ТекСтруктура);
						
		Если ТабДокЗаявкаНаМашину <> Неопределено Тогда 
			ТекСтруктура = Новый Структура;
			ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаЗаявкаНаМашину);
			ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаЗаявкаНаМашину);
			МассивСтруктур.Добавить(ТекСтруктура);
		КонецЕсли;
		
		Если ТабДокЗаявкаНаОтгрузку <> Неопределено Тогда
			ТекСтруктура = Новый Структура;
			ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаЗаявкаНаОтгрузку);
			ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаЗаявкаНаОтгрузку);
			МассивСтруктур.Добавить(ТекСтруктура);
		КонецЕсли;
		
		Если ТабДокТН <> Неопределено Тогда
			ТекСтруктура = Новый Структура;
			ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаТН);
			ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаТН);
			МассивСтруктур.Добавить(ТекСтруктура);		
		КонецЕсли;
		
		Если УспехЗаписиXML Тогда
			АдресХранилищаXMLЗаявкаНаМашину = ПоместитьВоВременноеХранилище(ДвоичныеДанныеXML, Новый УникальныйИдентификатор);
			
			ТекСтруктура = Новый Структура;
			ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаXMLПоЗаявкамНаОтгрузку);
			ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаXMLЗаявкаНаМашину);
			МассивСтруктур.Добавить(ТекСтруктура);
		КонецЕсли;

		смартОбщегоНазначения.ОтправитьПакетДокументовНаПочту(МассивСтруктур, ДокСсылка,,Склад,Истина);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  //-- #1353 смарт: Фролов 04.09.2023  

//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке  
&НаСервере
Процедура смартЗаписатьИнформациюОЗаписиПакета(ДокументРеализации, КаталогСохраненияФайлов)   
	
	УстановитьПривилегированныйРежим(Истина);
	
	НоваяЗапись = РегистрыСведений.смартСформированныеПакетыПФ.СоздатьМенеджерЗаписи();
	НоваяЗапись.Документ = ДокументРеализации;
	НоваяЗапись.ПакетСформирован = Истина; 
	НоваяЗапись.КаталогСохраненияФайлов = КаталогСохраненияФайлов; 
	НоваяЗапись.Записать(Истина);
	
	УстановитьПривилегированныйРежим(Ложь);  
	
КонецПроцедуры 	//-- #1766 смарт: Мосолов 09.04.2024   

&НаКлиенте
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
Функция смартСформироватьТабличныеДокументыДляПакета(ДокСсылка) Экспорт
	
	СтруктураВозврат = Новый Структура;
	
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаМашину", 	Неопределено);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаМашину", "");
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаОтгрузку", Неопределено);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаОтгрузку", "");
	СтруктураВозврат.Вставить("НазваниеАвто", "");
	СтруктураВозврат.Вставить("НомерАвто", "");
	
	СпособОтгрузкиСоСкладаАдмирал = Ложь;
	ВЗаказеСкладАдмирал = Ложь;
	НазваниеАвто = "";
	НомерАвто = "";
	смартПроверитьЗаказКлиента(ДокСсылка, СпособОтгрузкиСоСкладаАдмирал, ВЗаказеСкладАдмирал, НазваниеАвто, НомерАвто);
	
	СтруктураВозврат.Вставить("СпособОтгрузкиСоСкладаАдмирал", СпособОтгрузкиСоСкладаАдмирал);
	СтруктураВозврат.Вставить("ВЗаказеСкладАдмирал", ВЗаказеСкладАдмирал);
	СтруктураВозврат.Вставить("НазваниеАвто", НазваниеАвто);
	СтруктураВозврат.Вставить("НомерАвто", НомерАвто);

	СтруктураВозврат.Вставить("ДвоичныеДанныеXML", Неопределено);
	
	Если НЕ ВЗаказеСкладАдмирал Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Если СпособОтгрузкиСоСкладаАдмирал Тогда
	
	ИмяФайлаЗаявкаНаМашину = "";
	ТабДокЗаявкаНаМашину = смартСформироватьТабличныйДокументЗаявкаНаМашину(ДокСсылка, ИмяФайлаЗаявкаНаМашину, "xlsx");
	
	Иначе
		ИмяФайлаЗаявкаНаМашину = "";
		ТабДокЗаявкаНаМашину = Неопределено;
	КонецЕсли;

	ИмяФайлаЗаявкаНаОтгрузку = "";
	ТабДокЗаявкаНаОтгрузку = смартСформироватьТабличныйДокументЗаявкаНаОтгрузку(ДокСсылка, ИмяФайлаЗаявкаНаОтгрузку, "xlsx");
	
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаМашину", 	ТабДокЗаявкаНаМашину);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаМашину", ИмяФайлаЗаявкаНаМашину);
	СтруктураВозврат.Вставить("ТабДокЗаявкаНаОтгрузку", ТабДокЗаявкаНаОтгрузку);
	СтруктураВозврат.Вставить("ИмяФайлаЗаявкаНаОтгрузку", ИмяФайлаЗаявкаНаОтгрузку);
	
	ДвоичныеДанныеXML = смартСформироватьXMLПоЗаявкаНаОтгрузку(ДокСсылка, "ПакетДанныхПоЗаявкамНаОтгрузку.XML");
	СтруктураВозврат.Вставить("ДвоичныеДанныеXML", ДвоичныеДанныеXML);
	
	Возврат СтруктураВозврат;
	
КонецФункции //-- #1353 смарт: Фролов 04.09.2023 

&НаСервере
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
Процедура смартПроверитьЗаказКлиента(ДокСсылка, СпособОтгрузкиСоСкладаАдмирал, ВЗаказеСкладАдмирал, НазваниеАвто, НомерАвто)
	
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Номер", ДокСсылка.Номер);
	Запрос.УстановитьПараметр("Дата", ДокСсылка.Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Номер = &Номер
	|	И РеализацияТоваровУслуг.Дата = &Дата
	|;
	|
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК СпособОтгрузкиСоСкладаАдмирал,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаказКлиента.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПУстаяСсылка)
	|					И ЗаказКлиента.Склад.смартАвтоматическиФормироватьДокументы
	|				ТОГДА ИСТИНА
	|			КОГДА ЗаказКлиентаТовары.Склад.смартАвтоматическиФормироватьДокументы
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ВЗаказеСкладАдмирал,
	|	МАКСИМУМ(ЗаказКлиента.смартВидТранспорта) КАК смартВидТранспорта,
	|	МАКСИМУМ(ЗаказКлиента.смартНомерМашины) КАК НомерМашины,
	|	МАКСИМУМ(ЗаказКлиента.смартНомерПрицепа) КАК смартНомерПрицепа
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ПО ЗаказКлиента.Ссылка = ЗаказКлиентаТовары.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказ КАК ВТ_Заказ
	|		ПО ЗаказКлиента.Ссылка = ВТ_Заказ.Заказ";
	
	ТЗ_УТ1 = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтрока Из ТЗ_УТ1 Цикл
		СпособОтгрузкиСоСкладаАдмирал = ТекСтрока.СпособОтгрузкиСоСкладаАдмирал;
		ВЗаказеСкладАдмирал = ТекСтрока.ВЗаказеСкладАдмирал;
		НазваниеАвто = ТекСтрока.смартВидТранспорта;
		НомерАвто = СокрЛП(ТекСтрока.НомерМашины + " " + ТекСтрока.смартНомерПрицепа); 
	КонецЦикла;
	
КонецПроцедуры  //-- #1353 смарт: Фролов 04.09.2023

&НаСервере
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП) 
Функция смартСформироватьТабличныйДокументЗаявкаНаМашину(ДокСсылка, ИмяФайла = "", РасширениеФайла = "xlsx") Экспорт
	
	РезультатТабДок = Неопределено;
	
	Макет = ПолучитьОбщийМакет("смартЗаявкаНаМашину");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Номер", ДокСсылка.Номер);
	Запрос.УстановитьПараметр("Дата", ДокСсылка.Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Номер = &Номер
	|	И РеализацияТоваровУслуг.Дата = &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиента.Номер КАК Номер,
	|	ЗаказКлиента.Контрагент.Наименование КАК Контрагент,
	|	ЗаказКлиента.Организация.Наименование КАК Организация,
	|	ЗаказКлиента.смартВидТранспорта КАК ВидТранспорта,
	|	ЗаказКлиента.смартНомерМашины КАК НомерМашины,
	|	ЗаказКлиента.смартНомерПрицепа КАК смартНомерПрицепа,
	|	ЗаказКлиента.смартФИОВодителя КАК ФИОВодителя,
	|	ЗаказКлиента.смартНомерСерияПаспортВодителя КАК смартНомерСерияПаспортВодителя,
	|	ЗаказКлиента.смартДатаВыдачиПаспортаВодителя КАК смартДатаВыдачиПаспортаВодителя, 
	|	ЗаказКлиента.смартФИОВторогоВодителя КАК смартФИОВторогоВодителя,
	|	ЗаказКлиента.смартНомерСерияПаспортВторогоВодителя КАК смартНомерСерияПаспортВторогоВодителя,
	|	ЗаказКлиента.смартДатаВыдачиПаспортаВторогоВодителя КАК смартДатаВыдачиПаспортаВторогоВодителя, 
	//++#1631 смарт: Лопато 14.02.2024 //Формирование пакета документов самовывоз со склада Адмирал  
	//|	ЗаказКлиента.ЖелаемаяДатаОтгрузки КАК ЖелаемаяДатаОтгрузки,
	|	ЗаказКлиента.смартЖелаемаяДатаОтгрузкиАдмирал КАК ЖелаемаяДатаОтгрузки,
	//--#1631 смарт: Лопато 14.02.2024
	|	ЗаказКлиента.смартЖелаемоеВремяОтгрузки КАК смартЖелаемоеВремяОтгрузки,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказКлиента.СпособДоставки) КАК СпособДоставки
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Заказ КАК ВТ_Заказ
	|		ПО (ЗаказКлиента.Ссылка = ВТ_Заказ.Заказ)
	|ГДЕ
	|	ВЫБОР 
	|		КОГДА ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал)
	|      		ТОГДА ИСТИНА
	|       ИНАЧЕ ЛОЖЬ
	|   КОНЕЦ";
	     	
	ТЗ_УТ1 = Запрос.Выполнить().Выгрузить();
		
	ЕстьДанные = Ложь;
	ДатаДокумента = ДокСсылка.Дата;
	ЭтоПервый=Истина;
	
	Для Каждого Выборка Из ТЗ_УТ1 Цикл
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
				
		//++#1631 смарт: Лопато 14.02.2024 //Формирование пакета документов самовывоз со склада Адмирал  
		//ДатаВремя = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		Если ЗначениеЗаполнено(Выборка.ЖелаемаяДатаОтгрузки) Тогда
			ДатаВремя = Формат(Выборка.ЖелаемаяДатаОтгрузки, "ДФ=dd.MM.yyyy");
		Иначе
			ДатаВремя = Формат(ДатаДокумента, "ДФ=dd.MM.yyyy");
		КонецЕсли;	
		//--#1631 смарт: Лопато 14.02.2024
		смартЖелаемоеВремяОтгрузки = Выборка.смартЖелаемоеВремяОтгрузки;
		
		Если ЗначениеЗаполнено(смартЖелаемоеВремяОтгрузки) Тогда
			ДатаВремя = ДатаВремя + " " + Формат(смартЖелаемоеВремяОтгрузки, "ДФ=HH:mm");	
		КонецЕсли;
		Если ЭтоПервый Тогда

			ОбластьШапка.Параметры.ДатаОтгрузки = Формат(ДатаВремя, "ДФ=dd.MM.yyyy");
			ОбластьШапка.Параметры.ДеньНедели 	= ВРег(Сред(формат(ДатаВремя,"ДФ=дддд"),1,1)) + Сред(формат(ДатаВремя,"ДФ=дддд"),2,СтрДлина(формат(ДатаВремя,"ДФ=дддд"))+1);
			ОбластьШапка.Параметры.АдресСклада = ФормированиеПечатныхФорм.ПолучитьАдресИзКонтактнойИнформации(ДокСсылка.Склад, "", ДатаВремя);
			ТабДок.Вывести(ОбластьШапка);
		
		КонецЕсли;
		
		ЭтоПервый = Ложь;  
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьСтрока.Параметры.ДатаВремя 	= ДатаВремя;
		ОбластьСтрока.Параметры.Контрагент 	= Выборка.Контрагент;
		ОбластьСтрока.Параметры.НомерЗаказа 	= Выборка.Номер;
		ОбластьСтрока.Параметры.ВидТранспорта = Выборка.ВидТранспорта;
		ОбластьСтрока.Параметры.НомерМашины 	= Выборка.НомерМашины;
		ОбластьСтрока.Параметры.ФИОВодителя 	= Выборка.ФИОВодителя;
		
		Если ЗначениеЗаполнено(Выборка.смартДатаВыдачиПаспортаВодителя) Тогда
			ОбластьСтрока.Параметры.Паспорт = Выборка.смартНомерСерияПаспортВодителя + " выдан: " + Формат(Выборка.смартДатаВыдачиПаспортаВодителя, "ДФ=dd.MM.yyyy");
		Иначе
			ОбластьСтрока.Параметры.Паспорт = Выборка.смартНомерСерияПаспортВодителя;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Выборка.смартФИОВторогоВодителя) Тогда
			ОбластьСтрока.Параметры.ФИОВодителя=ОбластьСтрока.Параметры.ФИОВодителя+Символы.ПС+Выборка.смартФИОВторогоВодителя;	
		КонецЕсли;	                                                                                                         
		Если ЗначениеЗаполнено(Выборка.смартДатаВыдачиПаспортаВторогоВодителя) ТОгда
			ОбластьСтрока.Параметры.Паспорт=ОбластьСтрока.Параметры.Паспорт+Символы.ПС+Выборка.смартНомерСерияПаспортВторогоВодителя + " выдан: " + Формат(Выборка.смартДатаВыдачиПаспортаВторогоВодителя, "ДФ=dd.MM.yyyy");		
		Иначе
			ОбластьСтрока.Параметры.Паспорт=ОбластьСтрока.Параметры.Паспорт+Символы.ПС+Выборка.смартНомерСерияПаспортВторогоВодителя;
		КонецЕсли;	
		ОбластьСтрока.Параметры.КолПаллет = 1;
		
		ТабДок.Вывести(ОбластьСтрока);

		ЕстьДанные = Истина;
	КонецЦикла;	
			
	Если ЕстьДанные Тогда
		ИмяФайла = "Заявка на машину по заказу клиента №" + Выборка.Номер + "." + РасширениеФайла;
		Возврат ТабДок;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции //-- #1353 смарт: Фролов 04.09.2023

&НаСервере
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП) 
Функция смартСформироватьТабличныйДокументЗаявкаНаОтгрузку(ДокСсылка, ИмяФайла = "", РасширениеФайла = "xlsx") Экспорт
	
	РезультатТабДок = Новый ТабличныйДокумент;
		
	Макет = ПолучитьОбщийМакет("смартЗаявкаНаОтгрузку");
		
	НазваниеДокумента = НСтр("ru = 'Заявка на отгрузку'");
	
	ОбластьЗаголовка = Макет.ПолучитьОбласть("ЗаголовокПеремещение");	
	ОбластьЗаголовка.Параметры.ТекстЗаголовка = НазваниеДокумента; 

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА Организации.НаименованиеСокращенное <> """"
	|			ТОГДА Организации.НаименованиеСокращенное
	|		ИНАЧЕ Организации.Наименование
	|	КОНЕЦ КАК ОрганизацияНаименование,
	|	ПРЕДСТАВЛЕНИЕ(РеализацияТоваровУслуг.Склад) КАК Склад,
	|	Контрагенты.Наименование КАК Контрагент,
	|	РеализацияТоваровУслуг.Грузоотправитель КАК Грузоотправитель,
	|	РеализацияТоваровУслуг.Грузополучатель КАК Грузополучатель
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО РеализацияТоваровУслуг.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО РеализацияТоваровУслуг.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	РеализацияТоваровУслуг.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокСсылка);
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать();

	ВыборкаШапка.Следующий();
	
	ОрганизацияНаименование = ВыборкаШапка.ОрганизацияНаименование;
	СкладОтправитель = ВыборкаШапка.Склад;
	СкладПолучатель = ВыборкаШапка.Контрагент;
	
	ОбластьЗаголовка.Параметры.ОрганизацияПредставление = СокрЛП(ОрганизацияНаименование);
	ОбластьЗаголовка.Параметры.ОтправительПредставление = СокрЛП(СкладОтправитель);
	ОбластьЗаголовка.Параметры.ПолучательПредставление = СокрЛП(СкладПолучатель);
	
	РезультатТабДок.Вывести(ОбластьЗаголовка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Номер = &Номер
	|	И РеализацияТоваровУслуг.Дата = &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК Документ.ЗаказКлиента).Номер КАК Номер, 
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК Документ.ЗаказКлиента).Дата КАК Дата,
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК Документ.ЗаказКлиента).Контрагент.Наименование КАК Контрагент,
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК Документ.ЗаказКлиента).Организация.Наименование КАК Организация,
	|	ТоварыКОтгрузкеОстатки.Номенклатура.Наименование КАК Наименование,
	|	ТоварыКОтгрузкеОстатки.Номенклатура.Артикул КАК Артикул,
	|	ТоварыКОтгрузкеОстатки.Номенклатура.Код КАК Код,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыКОтгрузкеОстатки.Серия) КАК Серия,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыКОтгрузкеОстатки.Характеристика) КАК Характеристика,
	|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток КАК КоличествоУпаковок,
	|	ПРЕДСТАВЛЕНИЕ(ТоварыКОтгрузкеОстатки.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(, Склад.смартАвтоматическиФормироватьДокументы И ДокументОтгрузки В (ВЫБРАТЬ ВТ.Заказ ИЗ ВТ_Заказ КАК ВТ)) КАК ТоварыКОтгрузкеОстатки";
	
	Запрос.УстановитьПараметр("Номер", ДокСсылка.Номер);
	Запрос.УстановитьПараметр("Дата", ДокСсылка.Дата);
	ТЗ_УТ = Запрос.Выполнить().Выгрузить();
		
	ЕстьДанные = Ложь;
	
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	РезультатТабДок.Вывести(ОбластьШапкаТаблицы);
	
	НомерЗаказа = "";
	ДатаЗаказа = "";
	НомерСтроки = 0;
    
    ИтогУпаковок=0;

	Для Каждого ВыборкаТЧ Из ТЗ_УТ Цикл
								
		НомерЗаказа = ВыборкаТЧ.Номер;
		ДатаЗаказа = ВыборкаТЧ.Дата;
		
		Серия = ВыборкаТЧ.Серия;
		Если ЗначениеЗаполнено(Серия) Тогда
			Если Найти(Серия, "до") > 0 Тогда
				Серия = Сред(Серия, 1, Найти(Серия, "до") - 1);
			КонецЕсли;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаТЧ.Характеристика) Тогда
			Серия =  Строка(Серия) + " " + Строка(ВыборкаТЧ.Характеристика)
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтрока.Параметры.Товар 		= ВыборкаТЧ.Наименование;
		ОбластьСтрока.Параметры.Код 		= ПрефиксацияОбъектовКлиентСервер.УдалитьПрефиксыИзНомераОбъекта(ВыборкаТЧ.Код, Истина, Истина);
		Артикул = СтрЗаменить(ВыборкаТЧ.Артикул, " ", "");
		ОбластьСтрока.Параметры.Артикул 	= Артикул;
        ОбластьСтрока.Параметры.АртикулEN 	= СтроковыеФункции.СтрокаЛатиницей(Артикул);
		ОбластьСтрока.Параметры.Серия 		= Серия;
		
		ОбластьСтрока.Параметры.КоличествоУпаковок = ВыборкаТЧ.КоличествоУпаковок;
        ИтогУпаковок=ИтогУпаковок+ВыборкаТЧ.КоличествоУпаковок;
		ОбластьСтрока.Параметры.ПредставлениеЕдининицыИзмеренияУпаковки = ВыборкаТЧ.ЕдиницаИзмерения;
		
		ОбластьСтрока.Параметры.ПредставлениеБазовойЕдиницыИзмерения = "паллет";
		
		РезультатТабДок.Вывести(ОбластьСтрока);

		ЕстьДанные = Истина;

	КонецЦикла;
	ИмяФайла = "Заявка на отгрузку по заказу клиента №" + НомерЗаказа + "." + РасширениеФайла;

	ПредставлениеЗаказаКлиента = "Заказ клиента " + НомерЗаказа + " от " + ДатаЗаказа;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
    Если ИтогУпаковок>0 Тогда
        ОбластьПодвал.Параметры.ИтогУпаковок 		= ИтогУпаковок;
    КонецЕсли; 
	РезультатТабДок.Вывести(ОбластьПодвал);

	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	ОбластьПодписи.Параметры.ФИОМенеджер = "Нечипоренко В.В.";
	РезультатТабДок.Вывести(ОбластьПодписи);
	
	ОбластьКомментарий = Макет.ПолучитьОбласть("Комментарий");
	ОбластьКомментарий.Параметры.Документы = ПредставлениеЗаказаКлиента;
	РезультатТабДок.Вывести(ОбластьКомментарий);
	
	РезультатТабДок.ОтображатьСетку = Ложь;
	РезультатТабДок.АвтоМасштаб = Истина;
	
	Если ЕстьДанные Тогда		
		Возврат РезультатТабДок;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции  //-- #1353 смарт: Фролов 04.09.2023

&НаСервере
//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП) 
Функция смартСформироватьXMLПоЗаявкаНаОтгрузку(ДокСсылка, ИмяФайла)
	
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Номер", ДокСсылка.Номер);
	Запрос.УстановитьПараметр("Дата", ДокСсылка.Дата);
	Запрос.УстановитьПараметр("ВидНоменклатурыНаименование", "ТоварРулоныХарактеристики");
	

	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ
	|ПОМЕСТИТЬ ВТ_Заказ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Номер = &Номер
	|	И РеализацияТоваровУслуг.Дата = &Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК ДокументОтгрузки,
	|	НоменклатураСпр.Наименование КАК НоменклатураНаименование,
	|	НоменклатураСпр.Код КАК НоменклатураКод,
	|	НоменклатураСпр.Артикул КАК НоменклатураАртикул,
	|	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыКОтгрузкеОстатки.Серия КАК Серия,
	|	ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика,
	|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток КАК КоличествоУпаковок,
	|	НоменклатураСпр.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	|	НоменклатураСпр.Описание КАК НоменклатураОписание,
	|	НоменклатураСпр.ВидНоменклатуры.Наименование КАК ВидНоменклатурыНаименование
	|ПОМЕСТИТЬ ВТ_ЗаказКлиентаОстатки
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
	|	,Склад.смартАвтоматическиФормироватьДокументы
	|			И ДокументОтгрузки В
	|				(ВЫБРАТЬ
	|					ВТ.Заказ
	|				ИЗ
	|					ВТ_Заказ КАК ВТ)) КАК ТоварыКОтгрузкеОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
	|		ПО ТоварыКОтгрузкеОстатки.Номенклатура = НоменклатураСпр.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаСсылка.Номер КАК Номер,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказКлиентаСсылка.Контрагент) КАК Контрагент,
