//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)
Функция смартСформироватьТабличныйДокументТранспортнаяНакладная(ДокСсылка, ИмяФайлаТН, НазваниеАвто, НомерАвто) 
	Номер = ДокСсылка.Номер;
	Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Номер); 
	Если ЗначениеЗаполнено(ДокСсылка.ЗаказКлиента) ТОгда
		ЗаказКлиентаНомер=ДокСсылка.ЗаказКлиента.Номер; 
	Иначе
		ЗаказКлиентаНомер="";
	КонецЕсли;	
   	ИмяФайлаТН = "Транспортная накладная № " + Номер + " от " + Формат(ДокСсылка.Дата, "ДФ='dd MMMM yyyy ""г""'") +?(ЗаказКлиентаНомер = "",""," (по сч. "+ЗаказКлиентаНомер+")")+ ".pdf";  
    Возврат Документы.РеализацияТоваровУслуг.смартСформироватьТабличныйДокументТранспортнаяНакладная(ДокСсылка, ИмяФайлаТН, НазваниеАвто, НомерАвто);
