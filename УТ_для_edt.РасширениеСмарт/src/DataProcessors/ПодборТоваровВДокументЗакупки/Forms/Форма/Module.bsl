#Область ДоработкиСмарт

//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
&НаКлиенте
Процедура смарт_ПриОткрытииПосле(Отказ)
	
	Попытка
		смартЗапчастиГарантийныеИзДокумента = ВладелецФормы.Объект.смартЗапчастиГарантийные;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НЕ смартЗапчастиГарантийныеИзДокумента = ЭтаФорма.смартЗапчастиГарантийные Тогда
		ЭтаФорма.смартЗапчастиГарантийные = смартЗапчастиГарантийныеИзДокумента;
		смартСкорректироватьЗапросПоОстаткамСУчетомФалагаГарантийныхЗапчастей();
	КонецЕсли;
	
КонецПроцедуры

//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
&НаСервере
Процедура смартСкорректироватьЗапросПоОстаткамСУчетомФалагаГарантийныхЗапчастей()
	
	ПодборТоваровСервер.ПерейтиКСпискуНоменклатуры(ЭтаФорма);
	ПодборТоваровСервер.УстановитьТекстыЗапросовСписковФормыПодбора(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ТекущаяДатаСеанса = ТекущаяДатаСеанса();

	Если Параметры.Документ = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Предусмотрено открытие обработки только из документов.'");
	КонецЕсли;

	КодФормы = "Обработка_ПодборТоваровВДокументЗакупки_Форма";

	ПодборТоваровСервер.ПриСозданииФормыПодбораНаСервере(ЭтаФорма);
	ПодборТоваровКлиентСервер.УстановитьЗаголовокФормыПодбора(ЭтаФорма);
	УстановитьУсловноеОформление();
	
	#Вставка
	//++ #Б4036 смарт: Шляпников 14.08.2025 / Оприходование з/ч без документов основания в 1С УТ РФ
	Если Параметры.Свойство("БлокироватьСменуСегмента") И Параметры.БлокироватьСменуСегмента Тогда
		
		Параметры.Свойство("СегментНоменклатуры", СегментНоменклатуры);
		Элементы.СегментНоменклатуры.Доступность = Ложь;
		СегментНоменклатурыПриИзмененииНаСервере();
		
	КонецЕсли;
	//-- #Б4036 смарт: Шляпников 14.08.2025
	
	//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
	Команда = Команды.Добавить("смартПоказатьАналоги");
	Команда.Действие = "смартПоказатьАналогиКлиент";
	Команда.Заголовок = "Подобрать аналог";
	
	Кнопка = Элементы.Добавить("смартПоказатьАналоги", Тип("КнопкаФормы"), Элементы.РасширенныйПоискНоменклатура);
	Кнопка.ИмяКоманды = "смартПоказатьАналоги";
	
	Кнопка = Элементы.Добавить("смартПоказатьАналоги1", Тип("КнопкаФормы"), Элементы.СписокСтандартныйПоискНоменклатураКоманднаяПанель);
	Кнопка.ИмяКоманды = "смартПоказатьАналоги";
	Кнопка.ПоложениеВКоманднойПанели = ПоложениеКнопкиВКоманднойПанели.ВКоманднойПанелиИВДополнительномПодменю;
	
	Элемент = Элементы.Добавить("смартКоличествоАналогов", Тип("ПолеФормы"), Элементы.СписокРасширенныйПоискНоменклатура);
	Элемент.ПутьКДанным = "СписокНоменклатура.КоличествоАналогов";
	Элемент.Заголовок = "Аналог";
	
	Элемент = Элементы.Добавить("смартКоличествоАналогов1", Тип("ПолеФормы"), Элементы.СписокСтандартныйПоискНоменклатура);
	Элемент.ПутьКДанным = "СписокНоменклатура.КоличествоАналогов";
	Элемент.Заголовок = "Аналог";
	//-- #Б3742 смарт: Шляпников 20.08.2025
	
	//++ #Б4670 смарт: Шляпников 21.10.2025 / Маркировка радиоэлектронной продукции. Доработка справочника "Номенклатура".
	смартМаркировка.МодифицироватьФормуСпискаНоменклатуры(ЭтаФорма);
	//-- #Б4670 смарт: Шляпников 21.10.2025
	#КонецВставки

КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытияЭлементов

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
&НаКлиенте
Процедура смартПоказатьАналогиКлиент(Команда)
	
	Если Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура Тогда
		ТекущаяСтрока = Элементы.СписокРасширенныйПоискНоменклатура.ТекущаяСтрока;
	ИначеЕсли Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаСтандартныйПоискНоменклатура Тогда
		ТекущаяСтрока = Элементы.СписокСтандартныйПоискНоменклатура.ТекущаяСтрока;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", ТекущаяСтрока);
	
	Оповещение = Новый ОписаниеОповещения("смартПоказатьАналогиЗавершениеКлиент", ЭтаФорма);
	
	ОткрытьФорму("РегистрСведений.смартАналогиНоменклатуры.Форма.ФормаВыбораАналога", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
&НаКлиенте
Процедура смартПоказатьАналогиЗавершениеКлиент(Значение, ДопПараметры) Экспорт
	
	Если НЕ Значение = Неопределено Тогда
		
		//смена иерархии
		Элементы.ИерархияНоменклатуры.ТекущаяСтрока = ПолучитьРодителяНоменклатуры(Значение);
		
		Если ИспользоватьФильтры И (ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоИерархии")) Тогда
			ПодборТоваровКлиент.ОбработчикАктивизацииСтрокиИерархииНоменклатуры(ЭтаФорма);
		КонецЕсли;
		
		//смена вида номенклатуры
		Элементы.ВидыНоменклатуры.ТекущаяСтрока = ПолучитьВидНоменклатуры(Значение);
		
		Если ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоСвойствам")
			Или ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоВидамИСвойствам")
			Или ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоВидам") Тогда
			
			ТекущиеДанные = Элементы.ВидыНоменклатуры.ТекущиеДанные;
		
			Если НЕ ТекущиеДанные = Неопределено И ИспользоватьФильтры Тогда
				
				ВидНоменклатуры = ТекущиеДанные.Ссылка;
				ВидНоменклатурыПриИзмененииНаСервере();
			
			КонецЕсли;
			
		КонецЕсли;
		
		Если Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура Тогда
			
			Элементы.СписокРасширенныйПоискНоменклатура.ТекущаяСтрока = Значение;
			Элементы.СписокРасширенныйПоискНоменклатура.Обновить();
			
		ИначеЕсли Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаСтандартныйПоискНоменклатура Тогда
			
			Элементы.СписокСтандартныйПоискНоменклатура.ТекущаяСтрока = Значение;
			Элементы.СписокСтандартныйПоискНоменклатура.Обновить();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ПодборТаблицаНоменклатураПриАктивизацииСтроки")
Процедура смарт_ПодборТаблицаНоменклатураПриАктивизацииСтроки(Элемент)

	ПодборТоваровКлиент.ПриАктивизацииСтрокиТаблицыНоменклатуры(ЭтаФорма, Элемент);
	
	#Вставка
	//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
	Если Элемент.ТекущиеДанные <> Неопределено И Элемент.ТекущиеДанные.КоличествоАналогов > 0 Тогда
		
		Элементы.смартПоказатьАналоги.Доступность = Истина;
		Элементы.смартПоказатьАналоги1.Доступность = Истина;
		Элементы.смартПоказатьАналоги1.ЦветФона = Новый Цвет(192, 220, 192);
		Элементы.смартПоказатьАналоги.ЦветФона = Новый Цвет(192, 220, 192);
		
	Иначе
		
		Элементы.смартПоказатьАналоги.Доступность = Ложь;
		Элементы.смартПоказатьАналоги1.Доступность = Ложь;
		Элементы.смартПоказатьАналоги1.ЦветФона = ПолучитьЦветФонаКнопкиПоУмолчанию();
		Элементы.смартПоказатьАналоги.ЦветФона = ПолучитьЦветФонаКнопкиПоУмолчанию();
		
	КонецЕсли;
	//-- #Б3742 смарт: Шляпников 20.08.2025
	#КонецВставки

КонецПроцедуры

#КонецОбласти

#Область Служебные

//++ #Б4210 смарт: Шляпников 29.08.2025 / Доработка механизма Аналогов. 
&НаСервереБезКонтекста
Функция ПолучитьЦветФонаКнопкиПоУмолчанию()
	Возврат ЦветаСтиля.ЦветФонаКнопки;
КонецФункции

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
Функция ПолучитьРодителяНоменклатуры(Номенклатура)
	Возврат Номенклатура.Родитель;
КонецФункции

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
Функция ПолучитьВидНоменклатуры(Номенклатура)
	Возврат Номенклатура.ВидНоменклатуры;
КонецФункции

#КонецОбласти