
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Склад", Склад);
	Параметры.Свойство("смартЗапчастиГарантийные", смартЗапчастиГарантийные);
	Параметры.Свойство("ДокументВладелец", ДокументВладелец);
	
	Элементы.Сценарий.СписокВыбора.Добавить("Товар, выведенный из оборота");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СценарийПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Сценарий) Тогда
		Товары.Очистить();
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОстаткиНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	АдресВХранилище = ПоместитьВыбранныеСтрокиВоВременноеХранилище();
	Если АдресВХранилище = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте строки для переноса (колонка «Перенести»).'"));
		Возврат;
	КонецЕсли;
	
	Закрыть(АдресВХранилище);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	
	Товары.Очистить();
	
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиНаСкладах.Номенклатура КАК Номенклатура,
	|	ОстаткиНаСкладах.Характеристика КАК Характеристика,
	|	ОстаткиНаСкладах.Назначение КАК Назначение,
	|	ОстаткиНаСкладах.Склад КАК Склад,
	|	СУММА(ОстаткиНаСкладах.ВНаличииОстаток) КАК ВНаличииОстаток
	|ПОМЕСТИТЬ ВТ_Наличие
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК ОстаткиНаСкладах
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиНаСкладах.Номенклатура,
	|	ОстаткиНаСкладах.Характеристика,
	|	ОстаткиНаСкладах.Назначение,
	|	ОстаткиНаСкладах.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыКОтгрузке.Номенклатура КАК Номенклатура,
	|	ТоварыКОтгрузке.Характеристика КАК Характеристика,
	|	ТоварыКОтгрузке.Назначение КАК Назначение,
	|	ТоварыКОтгрузке.Склад КАК Склад,
	|	СУММА(ВЫБОР
	|			КОГДА &Гарантийные
	|				ТОГДА ТоварыКОтгрузке.смартКОтгрузкеГарантийныеОстаток + ТоварыКОтгрузке.смартВРезервеГарантийныеОстаток
	|			ИНАЧЕ ТоварыКОтгрузке.КОтгрузкеОстаток + ТоварыКОтгрузке.ВРезервеОстаток
	|		КОНЕЦ) КАК КВычету
	|ПОМЕСТИТЬ ВТ_КОтгрузке
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(, Склад = &Склад) КАК ТоварыКОтгрузке
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОтгрузке.Номенклатура,
	|	ТоварыКОтгрузке.Характеристика,
	|	ТоварыКОтгрузке.Назначение,
	|	ТоварыКОтгрузке.Склад
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыДокумента.Номенклатура КАК Номенклатура,
	|	ТоварыДокумента.Назначение КАК Назначение,
	|	ТоварыДокумента.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Исключения
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПеремещение КАК ШапкаПеремещения
	|		ПО ТоварыДокумента.Ссылка = ШапкаПеремещения.Ссылка
	|ГДЕ
	|	ШапкаПеремещения.Проведен
	|	И ШапкаПеремещения.Ссылка <> &ДокументВладелец
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыДокумента.Номенклатура,
	|	ТоварыДокумента.Назначение,
	|	ТоварыДокумента.Характеристика
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаВнутреннееПотребление КАК ШапкаПотребления
	|		ПО ТоварыДокумента.Ссылка = ШапкаПотребления.Ссылка
	|ГДЕ
	|	ШапкаПотребления.Проведен
	|	И ШапкаПотребления.Ссылка <> &ДокументВладелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Наличие.Номенклатура КАК Номенклатура,
	|	ВТ_Наличие.Назначение КАК Назначение,
	|	ВТ_Наличие.Склад КАК Склад,
	|	ВТ_Наличие.Характеристика КАК Характеристика,
	|	ВТ_Наличие.ВНаличииОстаток - ЕСТЬNULL(ВТ_КОтгрузке.КВычету, 0) КАК ДоступноеКоличество,
	|	ВТ_Наличие.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	ВТ_Наличие КАК ВТ_Наличие
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КОтгрузке КАК ВТ_КОтгрузке
	|		ПО ВТ_Наличие.Номенклатура = ВТ_КОтгрузке.Номенклатура
	|			И ВТ_Наличие.Характеристика = ВТ_КОтгрузке.Характеристика
	|			И ВТ_Наличие.Назначение = ВТ_КОтгрузке.Назначение
	|			И ВТ_Наличие.Склад = ВТ_КОтгрузке.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Исключения КАК ВТ_Исключения
	|		ПО ВТ_Наличие.Номенклатура = ВТ_Исключения.Номенклатура
	|			И ВТ_Наличие.Назначение = ВТ_Исключения.Назначение
	|			И ВТ_Наличие.Характеристика = ВТ_Исключения.Характеристика
	|ГДЕ
	|	ВТ_Наличие.ВНаличииОстаток - ЕСТЬNULL(ВТ_КОтгрузке.КВычету, 0) > 0
	|	И ВТ_Исключения.Номенклатура ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Наличие.Номенклатура.Наименование,
	|	ВТ_Наличие.Назначение.Наименование";
	
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Гарантийные", смартЗапчастиГарантийные);
	Запрос.УстановитьПараметр("ДокументВладелец", ДокументВладелец);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Перенести = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВыбранныеСтрокиВоВременноеХранилище()
	
	ТаблицаПереноса = Новый ТаблицаЗначений;
	ТаблицаПереноса.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПереноса.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	ТаблицаПереноса.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для Каждого СтрокаТоваров Из Товары Цикл
		
		Если Не СтрокаТоваров.Перенести Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПереноса.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваров, "Номенклатура, Назначение, Характеристика");
		
	КонецЦикла;
	
	Если ТаблицаПереноса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаПереноса, УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти
