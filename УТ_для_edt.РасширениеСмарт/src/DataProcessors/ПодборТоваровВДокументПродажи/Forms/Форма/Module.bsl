            ТекстБыло1 = " КАК Цена,";
            ТекстСтало1= " КАК Цена,
            |
            |ВЫРАЗИТЬ(ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) * ВЫБОР
            | 	КОГДА &Валюта <> ЦеныНоменклатуры.Валюта
            | 		ТОГДА ВЫБОР
            | 				КОГДА ЕСТЬNULL(КурсыСрезПоследнихВалютаЦены2.Кратность, 0) > 0
            | 						И ЕСТЬNULL(КурсыСрезПоследнихВалютаЦены2.Курс, 0) > 0
