        смартПоказыватьЦеныВТаблице(СтрокаТаблицыНоменклатуры);
        //-- Смарт:  Демичев №860 13.01.2022 
        
        //++ смарт:Подкин #1099 17.07.2022 20:27:18 
        Если ЗначениеЗаполнено(СтрокаТаблицыНоменклатуры.Резерв) Тогда  
            Элементы.смартРасшифровкаЗаказов.Доступность=Истина; 
        Иначе
            Элементы.смартРасшифровкаЗаказов.Доступность=Ложь;
        КонецЕсли;
        //-- смарт:Подкин #1099 17.07.2022 20:27:18	  
        
	КонецЕсли;
	
	//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
	Если Элемент.ТекущиеДанные <> Неопределено И Элемент.ТекущиеДанные.КоличествоАналогов > 0 Тогда
		
		Элементы.смартПоказатьАналоги.Доступность = Истина;
		Элементы.смартПоказатьАналоги1.Доступность = Истина;
		Элементы.смартПоказатьАналоги1.ЦветФона = Новый Цвет(192, 220, 192);
		Элементы.смартПоказатьАналоги.ЦветФона = Новый Цвет(192, 220, 192);
		
	Иначе
		
		Элементы.смартПоказатьАналоги.Доступность = Ложь;
		Элементы.смартПоказатьАналоги1.Доступность = Ложь;
		Элементы.смартПоказатьАналоги1.ЦветФона = ПолучитьЦветФонаКнопкиПоУмолчанию();
		Элементы.смартПоказатьАналоги.ЦветФона = ПолучитьЦветФонаКнопкиПоУмолчанию();
		
	КонецЕсли;
	//-- #Б3742 смарт: Шляпников 20.08.2025
	
	//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию. 
	ПодключитьОбработчикОжидания("смартЗаполнитьИнформациюОбАкцяхПоСтроке", 0.1, Истина);
	//-- #Б4818 смарт: Шляпников 17.11.2025
    
КонецПроцедуры //-- смарт:ММ 04.01.2021

