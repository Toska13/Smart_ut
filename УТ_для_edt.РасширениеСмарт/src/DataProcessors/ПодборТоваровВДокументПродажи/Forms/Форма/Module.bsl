&НаКлиенте
Процедура смарт_КорзинаХарактеристикаПриИзмененииПосле(Элемент)
	// Каратеев+
	ТекущаяСтрока = Элементы.Корзина.ТекущиеДанные;
	Товар = ТекущаяСтрока.Номенклатура;  
	Если НоменклатураВРулонахПоХарактеристикам(Товар)  Тогда
		
		ТекущаяСтрока.КоличествоУпаковок = 0;
		ТекущаяСтрока.Количество = 0;
		
	КонецЕсли;
	// Каратеев-
КонецПроцедуры

&НаКлиенте
Процедура смарт_КорзинаКоличествоУпаковокПриИзмененииПеред(Элемент)
	// Фролов+
	ТекущаяСтрока = Элементы.Корзина.ТекущиеДанные;
	Если НоменклатураВРулонахПоХарактеристикам(ТекущаяСтрока.Номенклатура) 
		И Не КоличествоВыбраноВерно(ТекущаяСтрока.КоличествоУпаковок,ТекущаяСтрока.Характеристика) Тогда 
		
		ТекущаяСтрока.КоличествоУпаковок = 0;
		ТекущаяСтрока.Количество = 0;
		Текст="Количество погонных метров должно быть кратно намотке рулона!
			|Укажите другое количество погонных метров.";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,,,"Объект.Корзина["+ТекущаяСтрока.ПолучитьИдентификатор()+"].КоличествоУпаковок");
	КонецЕсли;
	// Фролов-
КонецПроцедуры

