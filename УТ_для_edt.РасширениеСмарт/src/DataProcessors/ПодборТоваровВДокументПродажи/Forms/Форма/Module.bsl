	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		АдресКартинки = РаботаСФайлами.ДанныеФайла(СсылкаНаСправочник.ФайлКартинки, ИД).СсылкаНаДвоичныеДанныеФайла;
	Исключение
