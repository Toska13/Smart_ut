&НаКлиенте
Процедура смарт_ОстаткиТоваровПриАктивизацииСтрокиПосле(Элемент)
    СтрокаТаблицыНоменклатуры = Элементы.СписокСтандартныйПоискНоменклатура.ТекущиеДанные;
    СтрокаДереваОстаткиТоваров=Элементы.ОстаткиТоваров.ТекущиеДанные;  
    Если СтрокаДереваОстаткиТоваров <> Неопределено Тогда
        Элементы.смартРасшифровкаОплаченныхЗаказов.Доступность=Истина; 
        Элементы.смартРасшифровкаНеОплаченныхЗаказов.Доступность=Истина;
        Элементы.смартРасшифровкаЗаказов.Доступность=Истина;
    ИначеЕсли НЕ СтрокаТаблицыНоменклатуры=Неопределено И НЕ СтрокаТаблицыНоменклатуры.Резерв=0 И СтрокаТаблицыНоменклатуры.Доступно=0 Тогда   
        Элементы.смартРасшифровкаОплаченныхЗаказов.Доступность=Ложь;
        Элементы.смартРасшифровкаНеОплаченныхЗаказов.Доступность=Ложь;
        Элементы.смартРасшифровкаЗаказов.Доступность=Истина;
    Иначе
        Элементы.смартРасшифровкаОплаченныхЗаказов.Доступность=Ложь;
        Элементы.смартРасшифровкаНеОплаченныхЗаказов.Доступность=Ложь;
        Элементы.смартРасшифровкаЗаказов.Доступность=Ложь; 
    КонецЕсли;
КонецПроцедуры//-- смарт:Подкин #1099 19.07.2022 11:46:11

//++ #1351 смарт: Фролов 15.05.2023 //Разделение остатков по организациям в заказах  
&НаКлиенте
Процедура смарт_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)
	Если НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда
		ТекущиеДанные = Элементы.Корзина.ТекущиеДанные;
		Попытка
			РезультатПроверки=смартПроверитьСериюПоОрганизации(ИсточникВыбора.ВладелецФормы.Организация,ВыбранноеЗначение.Значение); 
			Если РезультатПроверки ТОгда
				ТекущиеДанные.Серия = ВыбранноеЗначение.Значение;
			Иначе
				Сообщить("Серия "+ВыбранноеЗначение.Значение+" не принадлежит организации "+ИсточникВыбора.ВладелецФормы.Организация+"");
				ТекущиеДанные.Серия = Неопределено;
			КонецЕсли;	
		Исключение
			
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры //-- #1351 смарт: Фролов 15.05.2023

//++ #1351 смарт: Фролов 15.05.2023 //Разделение остатков по организациям в заказах  
&НаСервере
Функция смартПроверитьСериюПоОрганизации(Организация,Серия)
	Запрос=Новый Запрос("  ВЫБРАТЬ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия КАК Серия,
			|	ТоварыОрганизацийОбороты.Организация КАК Организация,
			|	СУММА(ТоварыОрганизацийОбороты.КоличествоПриход) КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыОрганизаций.Обороты КАК ТоварыОрганизацийОбороты
			|ГДЕ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия = &Серия
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия,
			|	ТоварыОрганизацийОбороты.Организация");
	Запрос.УстановитьПараметр("Серия",Серия);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда
		Нашли=Ложь;
		Для Каждого Стр Из Рез Цикл
			Если Стр.Организация=Организация ТОгда
				Нашли=Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли ТОгда
			Возврат Ложь; 
		Иначе	
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;	
КонецФункции //-- #1351 смарт: Фролов 15.05.2023

//++ #Б1480 смарт: Шляпников 03.12.2024 / Раздельный учет товаров. Гарантийные запчасти. Доработка вывода оперативных остатков
&НаКлиенте
Процедура смарт_ПриОткрытииПосле(Отказ)
	
	Попытка
		смартЗапчастиГарантийныеИзДокумента = ВладелецФормы.Объект.смартЗапчастиГарантийные;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НЕ смартЗапчастиГарантийныеИзДокумента = ЭтаФорма.смартЗапчастиГарантийные Тогда
		ЭтаФорма.смартЗапчастиГарантийные = смартЗапчастиГарантийныеИзДокумента;
		смартСкорректироватьЗапросПоОстаткамСУчетомФалагаГарантийныхЗапчастей();
	КонецЕсли;
	
КонецПроцедуры

