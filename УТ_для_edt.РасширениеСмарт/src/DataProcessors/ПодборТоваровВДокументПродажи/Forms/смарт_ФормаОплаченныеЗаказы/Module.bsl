&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Склад=Неопределено;
    Номенклатура=Неопределено; 
    Сейчас=Неопределено;      
    
    Если Параметры.Свойство("Фон") Тогда
        Элементы.ТЗЗаказы.ЦветФона = Новый Цвет(248, 255, 255);	
    КонецЕсли;
    
    Если Параметры.Свойство("Склад",Склад) И Параметры.Свойство("Номенклатура",Номенклатура) Тогда  
        
        Если Параметры.Оплаченные=Неопределено Тогда 
            ЭтаФорма.Заголовок = "Расшифровка по складу- "+Склад;  
        ИначеЕсли Параметры.Оплаченные Тогда
            ЭтаФорма.Заголовок = "Расшифровка оплаты по складу- "+Склад;   
        Иначе 
            ЭтаФорма.Заголовок = "Расшифровка не оплаченных по складу- "+Склад; 
        КонецЕсли;    
        
        Запрос = Новый Запрос; 
        Если Параметры.Свойство("Сейчас",Сейчас) И Сейчас="Сейчас" Тогда
            Запрос.Текст = 
            "ВЫБРАТЬ
            |   2 КАК Действие,
            |   Таблица.Номенклатура КАК Номенклатура,
            |   Таблица.Склад КАК Склад,
            |   ВЫБОР
            |       КОГДА Таблица.Назначение.Заказ = НЕОПРЕДЕЛЕНО
            |           ТОГДА Таблица.Назначение
            |       ИНАЧЕ Таблица.Назначение.Заказ
            |   КОНЕЦ КАК ДокументОснование,
            |   ВЫБОР
            |       КОГДА Таблица.Назначение.Заказ = НЕОПРЕДЕЛЕНО
            |           ТОГДА ДАТАВРЕМЯ(1, 1, 1)
            |       ИНАЧЕ Таблица.Назначение.Заказ.Дата
            |   КОНЕЦ КАК ДатаДокумента,
            |   0 КАК НачальныйОстаток,
            |   0 КАК Приход,
            |   Таблица.НаличиеПодЗаказОстаток КАК Расход
            |ПОМЕСТИТЬ ВременнаяТаблица
            |ИЗ
            |   РегистрНакопления.ОбеспечениеЗаказов.Остатки(
            |           ,
            |           Номенклатура = &Номенклатура
            |               И Склад = &Склад) КАК Таблица
            |
            |ОБЪЕДИНИТЬ ВСЕ
            |
            |ВЫБРАТЬ 
            |   3 КАК Действие,
            |   Таблица.Номенклатура,
            |   Таблица.Склад,
            |   Таблица.ДокументОтгрузки,
            |   ЕСТЬNULL(РеквизитыРаспоряжения.ДатаДокументаИБ, ДАТАВРЕМЯ(1, 1, 1)),
            |   0,
            |   0,
            |   Таблица.ВРезервеОстаток
            |ИЗ
            |   РегистрНакопления.ТоварыКОтгрузке.Остатки(
            |           ,
            |           Номенклатура = &Номенклатура
            |               И Склад = &Склад) КАК Таблица
            |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеестрДокументов КАК РеквизитыРаспоряжения
            |       ПО Таблица.ДокументОтгрузки = РеквизитыРаспоряжения.Ссылка
            |           И (НЕ РеквизитыРаспоряжения.ДополнительнаяЗапись)
            |;
            |
            |////////////////////////////////////////////////////////////////////////////////
            |ВЫБРАТЬ
            | ВЫБОР КОГДА  Действие = 2 ТОГДА ""Резерв (обособленный)"" КОГДА Действие = 3 ТОГДА ""Резерв"" КОГДА Действие = 5 ТОГДА ""Резерв к дате отгрузки"" ИНАЧЕ """" КОНЕЦ КАК Действие,
            |   ВременнаяТаблица.ДокументОснование КАК ОбъектРасчетов,
            |   Выразить(ВременнаяТаблица.ДокументОснование КАК Документ.ЗаказКлиента).Контрагент КАК Контрагент,
            |   Выразить(ВременнаяТаблица.ДокументОснование КАК Документ.ЗаказКлиента).Менеджер КАК Менеджер,
            |   СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
            |   СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты,
            |   ВременнаяТаблица.Расход КАК КолРезерв
            |ИЗ
            |   ВременнаяТаблица КАК ВременнаяТаблица
            |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
            |       ПО ВременнаяТаблица.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
            |    ГДЕ
            |    Выбор когда &Оплаченные=НЕОПРЕДЕЛЕНО тогда
            |                Истина
            |          Когда &Оплаченные тогда
            |               СостоянияЗаказовКлиентов.СуммаОплаты > 0
            |    Иначе  СостоянияЗаказовКлиентов.СуммаОплаты <= 0 Конец 
            | 
            |    УПОРЯДОЧИТЬ ПО
            |	  ОбъектРасчетов
            |    АВТОУПОРЯДОЧИВАНИЕ"; 
            
            Если Не ЗначениеЗаполнено(Склад) Тогда
                Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Склад = &Склад","");
            ИначеЕсли Склад.ЭтоГруппа Тогда
                Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Склад = &Склад"," И Склад в иерархии (&Склад) ");
            КонецЕсли;
        Иначе          
            
            Запрос.Текст = 
            "ВЫБРАТЬ
            |   5 КАК Действие,
            |   Таблица.Номенклатура КАК Номенклатура,
            |   Таблица.Склад КАК Склад,
            |   Таблица.Регистратор КАК ДокументОснование,
            |   МАКСИМУМ(Таблица.Регистратор.Дата) КАК ДатаДокумента,
            |   СУММА(Таблица.КоличествоИзЗаказов) КАК Расход,
	        |     Таблица.ДатаОтгрузки КАК ДатаОтгрузки
 
            |ПОМЕСТИТЬ ВременнаяТаблица
            |ИЗ
            |   РегистрНакопления.ГрафикОтгрузкиТоваров КАК Таблица
            |ГДЕ
            |   Таблица.КоличествоИзЗаказов <> 0
            |   И Таблица.Номенклатура = &Номенклатура
            |   И Таблица.Склад = &Склад
            |
            |СГРУППИРОВАТЬ ПО
            |   Таблица.Номенклатура,
            |   Таблица.Характеристика,
            |   Таблица.Склад,
            |   ВЫБОР
            |       КОГДА Таблица.ДатаОтгрузки < &НачалоТекущегоДня
            |           ТОГДА &НачалоТекущегоДня
            |       ИНАЧЕ Таблица.ДатаОтгрузки
            |   КОНЕЦ,
            |   Таблица.Регистратор,
            |   Таблица.ДатаОтгрузки
            |;
            |
            |////////////////////////////////////////////////////////////////////////////////
            |ВЫБРАТЬ
            | ВЫБОР КОГДА  Действие = 2 ТОГДА ""Резерв (обособленный)"" КОГДА Действие = 3 ТОГДА ""Резерв"" КОГДА Действие = 5 ТОГДА ""Резерв к дате отгрузки"" ИНАЧЕ """" КОНЕЦ КАК Действие,
            |   ВременнаяТаблица.ДокументОснование КАК ОбъектРасчетов,
            |   Выразить(ВременнаяТаблица.ДокументОснование КАК Документ.ЗаказКлиента).Контрагент КАК Контрагент,
            |   Выразить(ВременнаяТаблица.ДокументОснование КАК Документ.ЗаказКлиента).Менеджер КАК Менеджер,
            |   СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
            |   СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты,
            |   ВременнаяТаблица.Расход КАК КолРезерв,
	        |   ВременнаяТаблица.ДатаОтгрузки КАК ДатаОтгрузки
            |ИЗ
            |   ВременнаяТаблица КАК ВременнаяТаблица
            |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
            |       ПО ВременнаяТаблица.ДокументОснование = СостоянияЗаказовКлиентов.Заказ
            |    ГДЕ
            |    Выбор когда &Оплаченные=НЕОПРЕДЕЛЕНО тогда
            |                Истина
            |          Когда &Оплаченные тогда
            |               СостоянияЗаказовКлиентов.СуммаОплаты > 0
            |    Иначе  СостоянияЗаказовКлиентов.СуммаОплаты <= 0 Конец             
            | 
            |    УПОРЯДОЧИТЬ ПО
            |	  ОбъектРасчетов
            |    АВТОУПОРЯДОЧИВАНИЕ";

            
            Элементы.ТЗЗаказыДатаОтгрузки.Видимость=Истина;

        КонецЕсли;
        
        Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
        Запрос.УстановитьПараметр("Склад", Склад);              
        Запрос.УстановитьПараметр("НачалоТекущегоДня", ТекущаяДатаСеанса()); 
        Запрос.УстановитьПараметр("Оплаченные", Параметры.Оплаченные);
        
        ТЗ=Запрос.Выполнить().Выгрузить();
        ТЗ.Колонки.Добавить("ДатыОплаты",ОбщегоНазначения.ОписаниеТипаСтрока(100));
        Для каждого Стр_Оплаты Из ТЗ Цикл
            Попытка
                МассивСсылок = КритерииОтбора.СвязанныеДокументы.Найти(Стр_Оплаты.ОбъектРасчетов); 
            Исключение 
                МассивСсылок = Новый Массив;
            КонецПопытки;
            ДатаПоступления = "";
            Для каждого Стр Из МассивСсылок Цикл
                Если (ТипЗНЧ(Стр.Ссылка) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") ИЛИ ТипЗНЧ(Стр.Ссылка) = Тип("ДокументСсылка.ВзаимозачетЗадолженности")
                    ИЛИ ТипЗНЧ(Стр.Ссылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")) И НЕ Стр.Ссылка.ПометкаУдаления Тогда
                    ДатаПоступления = ?(ЗначениеЗаполнено(ДатаПоступления), ДатаПоступления+", "+Строка(Формат(Стр.Ссылка.Дата,"ДФ=dd.MM.yyyy")),Строка(Формат(Стр.Ссылка.Дата,"ДФ=dd.MM.yyyy")));	
                КонецЕсли;  
            КонецЦикла; 
            Стр_Оплаты.ДатыОплаты = ДатаПоступления;
        КонецЦикла;
        ТЗЗаказы.Загрузить(ТЗ);
    КонецЕсли; 
    
КонецПроцедуры //-- смарт:Подкин #1099 17.07.2022 19:21:05

&НаКлиенте
Процедура ТЗЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)   
    
    СтандартнаяОбработка=Ложь;            
    ТекСтрока=Элементы.ТЗЗаказы.ТекущиеДанные;
    ПараметрыФормы = Новый Структура("Ключ",ТекСтрока.ОбъектРасчетов); 
    Если ТипЗнч(ТекСтрока.ОбъектРасчетов)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
        ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",ПараметрыФормы);
    ИначеЕсли ТипЗнч(ТекСтрока.ОбъектРасчетов)=Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
        ОткрытьФорму("Документ.ЗаказНаПеремещение.Форма.ФормаДокумента",ПараметрыФормы); 
    ИначеЕсли ТипЗнч(ТекСтрока.ОбъектРасчетов)=Тип("ДокументСсылка.ЗаказНаСборку") Тогда
        ОткрытьФорму("Документ.ЗаказНаСборку.Форма.ФормаДокумента",ПараметрыФормы);
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
   Элементы.ТЗЗаказыКолРезерв.ТекстПодвала=Формат(ТЗЗаказы.Итог("КолРезерв"),"ЧДЦ=3");
КонецПроцедуры
