//++ #Б-1498 смарт: Фролов 13.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
Процедура смарт_СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Элементы.Список.РежимВыбора Тогда
		Возврат;
	КонецЕсли;
	

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;

	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	#Вставка
	//++ #Б-1498 смарт: Фролов 13.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
	Если Поле.Имя = "смартНазначениеФайла" Тогда
		
		СписокВыбора = Новый СписокЗначений;
		//++ #Б-3804 смарт: Лопато 16.07.2025 //Заявка на гарантийный ремонт. Назначение файлов.  
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.Акт"));
		//-- #Б-3804 смарт: Лопато 16.07.2025
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.ФотоШильдаОборудования"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.ФотоШильдаДетали"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.ФотоКодаОшибки"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.ФотоПовреждений"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.ФотоДефектныхДеталей"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.СкриншотПереписки"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.СкриншотЗапросаГарантии"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.СкриншотПодтвержденияИлиОтказаОтГарантии"));
		СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.смартНазначенияФайлов.СканТестаПечати"));
		
		ПараметрыДляВыбора = Новый Структура;
		ПараметрыДляВыбора.Вставить("ТекущиеДанные", ТекущиеДанные);
		
		Описание = Новый ОписаниеОповещения("смартВыборНазначенияФайлаЗавершение",ЭтаФорма, ПараметрыДляВыбора);
		
		ПоказатьВыборИзМеню(Описание, СписокВыбора, Элемент);
		
		Возврат;
		
	КонецЕсли;
	//-- #Б-1498 смарт: Фролов 13.12.2024
	#КонецВставки

	Если ТекущиеДанные.ЭтоГруппа Тогда
		ПоказатьЗначение(, ВыбраннаяСтрока);
		Возврат;
	КонецЕсли;

	КакОткрывать = РаботаСФайламиСлужебныйКлиент.ПерсональныеНастройкиРаботыСФайлами().ДействиеПоДвойномуЩелчкуМыши;

	Если КакОткрывать = "ОткрыватьКарточку" Тогда
		ПоказатьЗначение(, ВыбраннаяСтрока);
		Возврат;
	КонецЕсли;

	ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(ВыбраннаяСтрока,
	Неопределено, УникальныйИдентификатор, Неопределено, ПредыдущийАдресФайла);

	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("ДанныеФайла", ДанныеФайла);
	Обработчик = Новый ОписаниеОповещения("СписокВыборПослеВыбораРежимаРедактирования", ЭтотОбъект, ПараметрыОбработчика);

	РаботаСФайламиСлужебныйКлиент.ВыбратьРежимИРедактироватьФайл(Обработчик, ДанныеФайла, Не ДанныеФайла.Служебный);

КонецПроцедуры //-- #Б-1498 смарт: Фролов 13.12.2024

