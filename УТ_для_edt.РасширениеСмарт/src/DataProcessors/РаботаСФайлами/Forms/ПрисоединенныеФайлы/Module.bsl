		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Список.НазначениеФайла";
		НовыйЭлемент.Заголовок = "Назначение файла (смарт)";
		НовыйЭлемент.Видимость = Истина;
		
	КонецЕсли;
	//-- #Б-1498 смарт: Фролов 12.12.2024 
	
