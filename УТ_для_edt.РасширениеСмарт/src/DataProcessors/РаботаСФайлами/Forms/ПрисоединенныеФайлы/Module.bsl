		КнопкаОИД.Заголовок = "Сделать основным (смарт)";
		КнопкаОИД.ИмяКоманды = "смартСделатьОсновным"; 
		
		Элемент = Элементы.Добавить("СписокОсновной", Тип("ПолеФормы"), Элементы.Список);
		Элемент.ПутьКДанным = "Список.Основной";
		Элемент.Заголовок = "Основной (смарт)";
		Элемент.Видимость = Ложь;
		
		Элемент3 = УсловноеОформление.Элементы.Добавить();
		ПолеЭлемента3 = Элемент3.Поля.Элементы.Добавить();
		ПолеЭлемента3.Поле = Новый ПолеКомпоновкиДанных(Элементы.Список.Имя);
		ОтборЭлемента3 = Элемент3.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента3.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Основной");
		ОтборЭлемента3.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента3.ПравоеЗначение = Истина;
		Элемент3.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина, Истина, , )); 
	КонецЕсли;
	//-- #1260 смарт: Фролов 05.12.2022
	
	//++ #Б-1498 смарт: Фролов 12.12.2024 //Доработка документа Заявка на гарантийный ремонт (смарт)
	Если ТипЗнч(ВладелецФайла) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт") Тогда
		
