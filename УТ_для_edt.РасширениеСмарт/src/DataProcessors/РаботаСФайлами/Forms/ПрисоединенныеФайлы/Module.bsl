//++ #1260 смарт: Фролов 05.12.2022 //Прикрепить фото к сериям оборудования  
&НаСервере
Процедура смартСделатьОсновнымНаСервере()
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	СерииНоменклатурыПрисоединенныеФайлы.Ссылка КАК Ссылка
	                    |ИЗ
	                    |	Справочник.СерииНоменклатурыПрисоединенныеФайлы КАК СерииНоменклатурыПрисоединенныеФайлы
	                    |ГДЕ
	                    |	СерииНоменклатурыПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
	                    |	И СерииНоменклатурыПрисоединенныеФайлы.Основной");  
	Запрос.УстановитьПараметр("ВладелецФайла",ЭтаФорма.ВладелецФайла);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() ТОгда
		Об=Выборка.Ссылка.ПолучитьОбъект();	
		Об.Основной=Ложь;
		Об.ОбменДанными.Загрузка=Истина;
		Об.Записать();
	КонецЕсли;	
	Об=ЭтаФорма.Элементы.Список.ТекущаяСтрока.Ссылка.ПолучитьОбъект();	
	Об.Основной=Истина;
	Об.ОбменДанными.Загрузка=Истина;
	Об.Записать();
	Элементы.Список.Обновить();
КонецПроцедуры //-- #1260 смарт: Фролов 05.12.2022	

