&НаСервере
Функция ПолучитьРаспоряжения()
    ТЗ=ЭтотОбъект.Распоряжения.Выгрузить(,"Распоряжение,ПолучательОтправитель"); 
    Возврат ТаблицуЗначенийВМассив(ТЗ);
КонецФункции //-- смарт:Подкин #947 12.05.2022 15:29:18

  //++ смарт:Подкин #947 12.05.2022 15:29:32
&НаСервереБезКонтекста
Функция ТаблицуЗначенийВМассив(ТаблЗнач)
	Результат=Новый Массив;
	Для Каждого ТекСтр Из ТаблЗнач Цикл
		СтруктураСтроки=Новый Структура;
		Для Каждого ТекКол Из ТаблЗнач.Колонки Цикл
			СтруктураСтроки.Вставить(ТекКол.Имя,ТекСтр[ТекКол.Имя])
		КонецЦикла;
		Результат.Добавить(СтруктураСтроки)
	КонецЦикла;
	Возврат Результат
КонецФункции  //-- смарт:Подкин #947 12.05.2022 15:29:32

//++ #Б4398 смарт: Шляпников 02.10.2025 / Задания на перевозку. Заполнение поля "Вес". Разработка. 
&НаСервере
Функция ЗаполнитьДеревоТоварыКДоставке(Распоряжение = Неопределено, Склад = Неопределено)
	
	Если Распоряжение = Неопределено Тогда
		ТЗТовары = ТоварыКДоставке.Выгрузить();
	Иначе
		ТЗТовары = ТоварыКДоставке.Выгрузить(Новый Структура("Распоряжение,Склад", Распоряжение, Склад));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТноменклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Высота, 0) КАК Высота,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Ширина, 0) КАК Ширина,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Глубина, 0) КАК Длина,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0) КАК ВесБрутто,
	|	ВЫБОР
	|		КОГДА ВТноменклатура.Ссылка.ВесЗнаменатель = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВТноменклатура.Ссылка.ВесЧислитель / ВТноменклатура.Ссылка.ВесЗнаменатель
	|	КОНЕЦ КАК ВесНетто,
	|	НЕ УпаковкиЕдиницыИзмерения.Ссылка ЕСТЬ NULL КАК ЕстьДанные
	|ИЗ
	|	Справочник.Номенклатура КАК ВТноменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО ВТноменклатура.Ссылка = УпаковкиЕдиницыИзмерения.Владелец
	|			И ВТноменклатура.Ссылка.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения
	|ГДЕ
	|	ВТноменклатура.Ссылка В(&Номенклатура)";
	
	Запрос.УстановитьПараметр("Номенклатура", ТЗТовары.ВыгрузитьКолонку("Номенклатура"));
	
	ДанныеНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	Дерево = РеквизитФормыВЗначение("смартТоварыКДоставке");
	Дерево.Строки.Очистить();
	
	Для каждого стр Из ТЗТовары Цикл
		
		НоваяСтрока = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, стр);
		
		Если ЗначениеЗаполнено(стр.Серия) Тогда
			
			Для каждого стрУпаковка Из стр.Серия.смартДанныеУпаковочногоЛиста Цикл
				
				стрГабариты = НоваяСтрока.Строки.Добавить();
				стрГабариты.Длина = стрУпаковка.Длина;
				стрГабариты.Ширина = стрУпаковка.Ширина;
				стрГабариты.Высота = стрУпаковка.Высота;
				стрГабариты.Вес = стрУпаковка.Вес;
				стрГабариты.ВесБрутто = стрУпаковка.Вес;
				стрГабариты.Объем = стрУпаковка.Объем;
				стрГабариты.ТипУпаковки = стрУпаковка.ТипУпаковки;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НоваяСтрока.Строки.Количество() = 0 Тогда
			
			НайденныеСтроки = ДанныеНоменклатуры.НайтиСтроки(Новый Структура("Номенклатура", стр.Номенклатура));
			Если НайденныеСтроки.Количество() <> 0  И НайденныеСтроки[0].ЕстьДанные Тогда
				
				стрГабариты = НоваяСтрока.Строки.Добавить();
				стрГабариты.Длина = НайденныеСтроки[0].Длина;
				стрГабариты.Ширина = НайденныеСтроки[0].Ширина;
				стрГабариты.Высота = НайденныеСтроки[0].Высота;
				стрГабариты.Вес = НайденныеСтроки[0].ВесНетто;
				стрГабариты.ВесБрутто = НайденныеСтроки[0].ВесБрутто;
				стрГабариты.Объем = НайденныеСтроки[0].Длина * НайденныеСтроки[0].Ширина * НайденныеСтроки[0].Высота;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НоваяСтрока.Строки.Количество() = 0 Тогда
			
			стрГабариты = НоваяСтрока.Строки.Добавить();
			стрГабариты.Длина = "<нет данных>";
			стрГабариты.Ширина = "<нет данных>";
			стрГабариты.Высота = "<нет данных>";
			стрГабариты.Вес = "<нет данных>";
			стрГабариты.ВесБрутто = "<нет данных>";
			стрГабариты.Объем = "<нет данных>";
			
		Иначе
			
			НоваяСтрока.Длина = НоваяСтрока.Строки.Итог("Длина");
			НоваяСтрока.Ширина = НоваяСтрока.Строки.Итог("Ширина") * НоваяСтрока.Количество;
			НоваяСтрока.Высота = НоваяСтрока.Строки.Итог("Высота");
			НоваяСтрока.Вес = НоваяСтрока.Строки.Итог("Вес") * НоваяСтрока.Количество;
			НоваяСтрока.ВесБрутто = НоваяСтрока.Строки.Итог("ВесБрутто") * НоваяСтрока.Количество;
			НоваяСтрока.Объем = НоваяСтрока.Строки.Итог("Объем") * НоваяСтрока.Количество;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Распоряжение = Неопределено Тогда
		
		Для каждого стрРаспоряжение Из Распоряжения Цикл
			
			НайденныеСтроки = Дерево.Строки.НайтиСтроки(Новый Структура("Распоряжение,Склад", стрРаспоряжение.Распоряжение, стрРаспоряжение.Склад));
			
			стрРаспоряжение.Вес = 0;
			стрРаспоряжение.Объем = 0;
			стрРаспоряжение.ВесБрутто = 0;
			
			Для каждого стрНайденныеСтроки Из НайденныеСтроки Цикл
				
				стрРаспоряжение.Вес = стрРаспоряжение.Вес + смартОбщегоНазначения.Строка2Число(стрНайденныеСтроки.Вес);
				стрРаспоряжение.Объем = стрРаспоряжение.Объем + смартОбщегоНазначения.Строка2Число(стрНайденныеСтроки.Объем);
				стрРаспоряжение.ВесБрутто = стрРаспоряжение.ВесБрутто + смартОбщегоНазначения.Строка2Число(стрНайденныеСтроки.ВесБрутто);
				
			КонецЦикла;
			
		КонецЦикла;
		
	ИначеЕсли Элементы.Распоряжения.ТекущаяСтрока <> Неопределено Тогда
		
		стрРаспоряжения = Распоряжения.НайтиПоИдентификатору(Элементы.Распоряжения.ТекущаяСтрока);
		
		стрРаспоряжения.ВесБрутто = Дерево.Строки.Итог("ВесБрутто", Ложь);
		стрРаспоряжения.Вес = Дерево.Строки.Итог("Вес", Ложь);
		стрРаспоряжения.Объем = Дерево.Строки.Итог("Объем", Ложь);
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Дерево, "смартТоварыКДоставке");
	МассивИдентификаторов = Новый Массив;
	
	МассивСтрок = ЭтаФорма.смартТоварыКДоставке.ПолучитьЭлементы();
	Для каждого стр Из МассивСтрок Цикл
		МассивИдентификаторов.Добавить(стр.ПолучитьИдентификатор());
	КонецЦикла;
	
	Возврат МассивИдентификаторов;
	
КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("РаспоряженияПриАктивизацииСтрокиОбработчикОжидания")
