&НаКлиенте
Процедура смартВыборТоварыКДоставке(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "смартТоварыКДоставкеНоменклатура" 
		ИЛИ Поле.Имя = "смартТоварыКДоставкеХарактеристика"
		ИЛИ Поле.Имя = "смартТоварыКДоставкеНазначение"
		ИЛИ Поле.Имя = "смартТоварыКДоставкеСерия" Тогда
		
		ПоказатьЗначение(Неопределено, Элементы.смартТоварыКДоставке.ТекущиеДанные.Номенклатура);
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

