&После("УстановитьВидимостьСкладов")
Процедура смарт_УстановитьВидимостьСкладов()
	
	   //++ смарт:Демичев №1115 06.09.2022 
	   Элементы.СписокСкладов.Видимость = смартФлажокСписокСкладов;  
	   Элементы.Склад.Видимость = Не смартФлажокСписокСкладов;
	   
	   Элементы.СкладДляЗаданий.Видимость = смартФлажокСписокСкладов;
		 
	   Если смартФлажокСписокСкладов Тогда
		   ЭтотОбъект.Склад = Неопределено;
	   КонецЕсли;           
	   
	   Если смартФлажокСписокСкладов Тогда
		   
		   ФлагВидимости = Истина;
		   
	   ИначеЕсли Не смартФлажокСписокСкладов Тогда
		   
		   ФлагВидимости = Склад.Пустая() ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад,"ЭтоГруппа");
		   		   
	   КонецЕсли;

	   // ФлагВидимости = Склад.Пустая() ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад,"ЭтоГруппа");
	   Элементы.РаспоряженияНаДоставкуСклад.Видимость			 = ФлагВидимости;
	   Элементы.ЗаданияНаПеревозкуВРаботеСклад.Видимость		 = ФлагВидимости;
	   Элементы.ДокументыДляПеревозчиковСклад.Видимость		 = ФлагВидимости;
	
	   //-- смарт:Демичев №1115 06.09.2022	     
		
КонецПроцедуры

