&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)  
    //НовыйЭлемент = Элементы.Добавить("смартАдмирал", Тип("ДекорацияФормы"), Элементы.Шапка); 
    НовыйЭлемент = Элементы.Вставить("смартАдмирал", Тип("ДекорацияФормы"), Элементы.Шапка,Элементы.ГруппаКоманднаяПанель);
    НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
    НовыйЭлемент.Заголовок = "Для склада Адмирал заказ попадет в доставку, только после проведения реализации товаров!";
    НовыйЭлемент.ЦветТекста = WebЦвета.ОранжевоКрасный;
    НовыйЭлемент.Шрифт = Новый Шрифт(НовыйЭлемент.Шрифт,,,); 
    НовыйЭлемент.Видимость=Ложь; 
    //++ #1353 смарт: Фролов 17.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
	//++ смарт:Подкин #1121 04.08.2022 11:01:35
	//Если ЭтотОбъект.Склад=Справочники.смартПредопределенныеЗначения.СкладАдмирал.Значение 
	//    ИЛИ ЭтотОбъект.Склад=Справочники.смартПредопределенныеЗначения.СкладАдмиралКовчег.Значение Тогда        
    //-- смарт:Подкин #1121 04.08.2022 11:01:35
	Если ЗначениеЗаполнено(ЭтотОбъект.Склад) И НЕ ЭтотОбъект.Склад.ЭтоГруппа И ЭтотОбъект.Склад.смартАвтоматическиФормироватьДокументы Тогда
    //-- #1353 смарт: Фролов 17.05.2023
        НовыйЭлемент.Видимость=Истина;
    КонецЕсли; 
    
    //++ смарт:Подкин #1121 31.08.2022 8:49:31  
    Если ЗначениеЗаполнено(Склад) Тогда 
        смартСписокСкладов.Очистить();
        смартСписокСкладов.Добавить(Склад);
    КонецЕсли;
    //-- смарт:Подкин #1121 31.08.2022 8:49:31
	
КонецПроцедуры //-- смарт:ПА #881 03.02.2022 13:29:08

