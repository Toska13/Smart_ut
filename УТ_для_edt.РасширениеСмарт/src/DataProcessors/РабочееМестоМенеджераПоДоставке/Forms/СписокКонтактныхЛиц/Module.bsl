#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.ЗакрыватьПриВыборе = Истина;
	ЗагрузитьСписок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	Результат = Новый Массив;
	
	Для Каждого ДанныеСтроки Из Таблица Цикл
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.Представление) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Идентификатор", ДанныеСтроки.Идентификатор);
		СтруктураДанных.Вставить("Представление", ДанныеСтроки.Представление);
		
		Результат.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСписок()
	
	Для каждого ДанныеСтроки Из Параметры.Список Цикл
		
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), ДанныеСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти