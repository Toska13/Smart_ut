&НаКлиенте
Процедура ЗагрузитьСправочникИзОбъекта(ОписаниеСправочника)
	
	// Данные таблицы справочника для хранения на клиенте с сервера
	// приходят в виде массива структур. Перегружаем их в соответствие -
	// общее хранилище данных "клиентских" справочников
	
	ИмяТаблицыИсточника = ОписаниеСправочника.Источник.Таблица;
	
	Если ДанныеКлиентскогоКонтекста.Справочники.Свойство(ИмяТаблицыИсточника) Тогда
		
		ТаблицаПриемник     = СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
		ТаблицаИсточник     = ДанныеКлиентскогоКонтекста.Справочники[ИмяТаблицыИсточника];
		
		Для Каждого ДанныеИсточника Из ТаблицаИсточник Цикл
			
			ТаблицаПриемник.Вставить(ДанныеИсточника.Идентификатор, ДанныеИсточника);
			
		КонецЦикла;
		
		ДанныеКлиентскогоКонтекста.Справочники.Удалить(ИмяТаблицыИсточника); // Удаляем массив с данными справочника из данных реквизита формы
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаДанныхЗагрузитьНовыеСправочники(ПараметрыЗадания, ДополнительныеПараметры) Экспорт
	
	// Если источником данных справочника выступает api - загружаем все такие справочники на клиенте
	// Если источником выступает "Объект" - загружаем здесь только справочники, хранящиеся на клиенте
	// Остальные виды справочников - должны быть уже загружены в обработчике "ПриСозданииНаСервере"
	
	ОписаниеСправочников = КоллекцияМетаданные.Справочники;
	
	Для Каждого ДанныеСправочника Из ОписаниеСправочников Цикл
		
		ОписаниеСправочника = ДанныеСправочника.Значение;		
		Источник            = ОписаниеСправочника.Источник;
		Хранилище           = ОписаниеСправочника.Хранилище;
		
		Если Источник.Тип = "api" Тогда
			
			ЗагрузитьСправочникAPI(ОписаниеСправочника);
			
		ИначеЕсли Источник.Тип = "Объект" И Хранилище.Расположение = "Клиент" Тогда
			
			ЗагрузитьСправочникИзОбъекта(ОписаниеСправочника);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ВыполнитьСледующееЗаданиеОчередиЗагрузкиДанных("ЗагрузкаЛичногоКабинета");
	
КонецПроцедуры

