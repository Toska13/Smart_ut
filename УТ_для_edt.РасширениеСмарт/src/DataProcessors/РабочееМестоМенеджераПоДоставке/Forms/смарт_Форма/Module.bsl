&НаКлиенте
Функция НоваяОчередьЗаданий(ИмяОчереди, Индикатор = "", Информация = "")
	
	Если ОчередиЗаданий = Неопределено Тогда
		
		ОчередиЗаданий = Новый Структура;
		
	КонецЕсли;
	
	НоваяОчередь = Новый Массив;
	
	СтруктураОчереди = Новый Структура;
	СтруктураОчереди.Вставить("Очередь",    НоваяОчередь);
	СтруктураОчереди.Вставить("Индикатор",  Индикатор);
	СтруктураОчереди.Вставить("Информация", Информация);
	
	ОчередиЗаданий.Вставить(ИмяОчереди, СтруктураОчереди);
	
	ДобавитьЗаданиеВОчередьЗагрузкиДанных(НоваяОчередь, "", "Инициализациия");
	
	Возврат НоваяОчередь;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьСледующееЗаданиеОчередиЗагрузкиДанных(Очередь, Отказ = Ложь, РезультатТекущегоЗадания = Неопределено)
	
	ДанныеОчереди  = ОчередиЗаданий[Очередь];
	ТекущаяОчередь = ДанныеОчереди.Очередь;
	
	Если Отказ Тогда
		
		Если Очередь = "ЗагрузкаЛичногоКабинета" Тогда
			
			Если РезультатТекущегоЗадания = "ОбластиФормыАвторизация" Тогда
				
				Элементы.ОбластиФормы.ТекущаяСтраница = Элементы.ОбластиФормыАвторизация;
				
			Иначе 
				
				// при любой ошибке - выкидываем пользователя в первоначальные настройки
				ВывестиСообщениеПользователю("При загрузке данных произошла ошибка - проверьте настройки");
				Элементы.ОбластиФормы.ТекущаяСтраница = Элементы.ОбластиФормыПервоначальныеНастройки;
				
			КонецЕсли;
			
		КонецЕсли; 
		
	Иначе
		
		ТекущаяОчередь.Удалить(0);                          // удаляем из очереди текущее задание
		ВсегоЗаданийЗагрузки = ТекущаяОчередь.Количество(); // получаем количество оставшихся в очереди заданий
		
		Если ВсегоЗаданийЗагрузки Тогда
			
			ТекущееЗадание = ТекущаяОчередь[0];
			
			ПараметрыТекущегоЗадания = Новый Структура;
			ПараметрыТекущегоЗадания.Вставить("РезультатПредыдущегоЗадания", РезультатТекущегоЗадания);
			
			Если ЗначениеЗаполнено(ДанныеОчереди.Информация) Тогда
				
				УстановитьЗначениеРеквизитаФормы(ДанныеОчереди.Информация, ТекущееЗадание.Комментарий + "...");
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ДанныеОчереди.Индикатор) Тогда
				
				УстановитьЗначениеРеквизитаФормы(ДанныеОчереди.Индикатор, ЭтаФорма[ДанныеОчереди.Индикатор] + (100 - ЭтаФорма[ДанныеОчереди.Индикатор]) / (ВсегоЗаданийЗагрузки + 1));
				
			КонецЕсли; 
			
			ОбновитьОтображениеДанных();
			
			ВыполнитьОбработкуОповещения(ТекущееЗадание.Оповещение, ПараметрыТекущегоЗадания);
			
		Иначе
			
			ОчередиЗаданий.Удалить(Очередь);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаданиеВОчередьЗагрузкиДанных(Очередь, ИмяПроцедуры, Комментарий, Результат = Неопределено, ДополнительныеПараметры = Неопределено)
	
	СтруктураДанных = Новый Структура;
	Оповещение      = ?(ЗначениеЗаполнено(ИмяПроцедуры), Новый ОписаниеОповещения(ИмяПроцедуры, ЭтаФорма, ДополнительныеПараметры), Неопределено);
	
	СтруктураДанных.Вставить("Оповещение",  Оповещение);
	СтруктураДанных.Вставить("Комментарий", Комментарий);
	СтруктураДанных.Вставить("Результат",   Результат);
	
	Очередь.Добавить(СтруктураДанных);
	
КонецПроцедуры

