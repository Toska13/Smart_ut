#Область ОбщегоНазначения

&НаКлиентеНаСервереБезКонтекста
Функция ПривестиЗначениеКТипу(ИсходноеЗначение, ОписаниеТипа)
	
	Если ОписаниеТипа = "Булево" Тогда
		
		Значение = ЗначениеЗаполнено(ИсходноеЗначение) И ИсходноеЗначение <> "0";
		
	Иначе
		
		Значение = ИсходноеЗначение;
		
	КонецЕсли; 
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Функция ЗагрузитьФайлДанныхСправочника(ОписаниеСправочника, Данные, ИмяФайла)
	
	ФайлЗагружен = Ложь;
	СсылкаНаФайл = ПолучитьЗначениеПоля(Данные, "url"); // Получаем ссылку для скачивания файла
	
	Если ЗначениеЗаполнено(СсылкаНаФайл) Тогда
		
		ИмяФайла     = СкопироватьФайлПоСсылке(СсылкаНаФайл);
		ФайлЗагружен = ЗначениеЗаполнено(ИмяФайла);
		
	Иначе
		
		ТекстСообщения = "Не удалось загрузить данные справочника """ + ОписаниеСправочника.Синоним + """";
		ВывестиСообщениеПользователю(ТекстСообщения);
		ДобавитьСообщениеВЖурнал(ТекстСообщения + ": " + СериализоватьСтруктуруЗапроса(Данные));
		
	КонецЕсли;
	
	Возврат ФайлЗагружен;
	
КонецФункции

#КонецОбласти

#Область ФорматCSV

&НаКлиентеНаСервереБезКонтекста
Процедура ПрочитатьФайлСправочникаВФорматеCSV(Приемник, ОписаниеМетода, ИмяФайла)
	
	ЧтениеФайла      = Новый ЧтениеТекста(ИмяФайла, "UTF-8");
	СтрокаЗаголовков = СтрЗаменить(ЧтениеФайла.ПрочитатьСтроку(), """", ""); // Первой строкой в файле должны идти заголовки полей
	СтрокаДанных     = ЧтениеФайла.ПрочитатьСтроку();                        // Читаем первую строку данных файла
	
	Пока СтрокаДанных <> Неопределено Цикл
		
		СтруктураДанных = Вычислить("Новый Структура(СтрокаЗаголовков, " + СтрокаДанных + ")");
		СтруктураСтроки = Новый Структура;
		
		Для Каждого ТекущееПоле Из ОписаниеМетода.Поля Цикл
			
			// Создаем структуру строки записи таблицы справочника.
			// Соответствие полей файла и реквизитов справочника берем из описания метода
			
			ТипЗначения = ?(ТекущееПоле.Свойство("Тип"), ТекущееПоле.Тип, "Строка");
			Значение    = ПривестиЗначениеКТипу(СтруктураДанных[ТекущееПоле.Поле], ТипЗначения);
			
			СтруктураСтроки.Вставить(ТекущееПоле.Реквизит, Значение);
			
		КонецЦикла;
		
		#Если Клиент Тогда
		
		// На клиенте основной таблицей справочника является соответствие.
		// В качестве ключа используем поле идентификатор таблицы справочника
		
		Приемник.Вставить(СтруктураСтроки.Идентификатор, СтруктураСтроки);
		
		#Иначе
		
		// При расположении основной таблицей справочника на сервере, 
		// используем таблицу значений
		
		СтруктураСтроки.Вставить("НомерСтроки", СтрЗаменить(Новый УникальныйИдентификатор(), "-", ""));  // <TODO Автор="Марусов" Дата="2017-10-16" Тип="Критичный">Отказаться от необходимости использовать номер строки</TODO> 
		ЗаполнитьЗначенияСвойств(Приемник.Добавить(), СтруктураСтроки);
		
		#КонецЕсли
		
		СтрокаДанных = ЧтениеФайла.ПрочитатьСтроку();
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникВФорматеCSVНаКлиенте(ОписаниеСправочника, ОписаниеМетода, ИмяФайла)
	
	ТаблицаСправочника   = СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
	ПрочитатьФайлСправочникаВФорматеCSV(ТаблицаСправочника, ОписаниеМетода, ИмяФайла);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗагрузитьСправочникВФорматеCSVНаСервере(ОписаниеСправочника, ОписаниеМетода, АдресДанных)
	
	ИмяФайла           = ПолучитьИмяВременногоФайла();
	ТаблицаСправочника = ПолучитьИзВременногоХранилища(ОписаниеСправочника.Хранилище.Адрес);
	ТаблицаСправочника.Очистить();
	
	ПолучитьИзВременногоХранилища(АдресДанных).Записать(ИмяФайла); // <TODO Автор="Марусов" Дата="2017-10-12" Тип="Оптимизация">Подумать как обойтись без дисковых операций</TODO> 
	УдалитьИзВременногоХранилища(АдресДанных);
	
	ПрочитатьФайлСправочникаВФорматеCSV(ТаблицаСправочника, ОписаниеМетода, ИмяФайла);
	УдалитьВременныйФайлНаСервере(ИмяФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникВФорматеCSV(ОписаниеСправочника, Данные)
	
	ИмяФайла = "";
	
	Если ЗагрузитьФайлДанныхСправочника(ОписаниеСправочника, Данные, ИмяФайла) Тогда
		
		РасположениеХранилища = ОписаниеСправочника.Хранилище.Расположение;
		ОписаниеМетода        = КоллекцияМетодов[ОписаниеСправочника.Источник.Метод];
		
		Если РасположениеХранилища = "Клиент" Тогда
			
			ЗагрузитьСправочникВФорматеCSVНаКлиенте(ОписаниеСправочника, ОписаниеМетода, ИмяФайла);
			
		Иначе
			
			АдресДанныхНаСервере = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
			ЗагрузитьСправочникВФорматеCSVНаСервере(ОписаниеСправочника, ОписаниеМетода, АдресДанныхНаСервере);
			
		КонецЕсли;
		
		ОбработчикУдалениеФайлов(ИмяФайла);
		
	Иначе
		
		Если ОписаниеСправочника.Хранилище.Расположение = "Клиент" Тогда
			
			СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ФорматXML

&НаКлиенте
Процедура ЗагрузитьСправочникСтатусыЗаказов(ОписаниеСправочника, Данные)
	
	ИмяФайла = "";
	
	Если ЗагрузитьФайлДанныхСправочника(ОписаниеСправочника, Данные, ИмяФайла) Тогда
		
		ТаблицаСправочника = СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
		
		ЧтениеТекста    = Новый ЧтениеТекста(ИмяФайла, "UTF-8");
		ТекстОтвета     = ЧтениеТекста.Прочитать();
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(ТекстОтвета);
		
		СписокСтатусов = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "statuses");
		
		Для Каждого ДанныеСтатуса Из СписокСтатусов Цикл
			
			Для Каждого ДанныеСтатусаИдентификатор Из ДанныеСтатуса Цикл
				
				ТекущиеДанные = Новый Структура;
				ТекущиеДанные.Вставить("Идентификатор", ДанныеСтатусаИдентификатор.Ключ);
				ТекущиеДанные.Вставить("Наименование",  ПолучитьЗначениеПоля(ДанныеСтатусаИдентификатор.Значение, "name", "???"));
				
				ТаблицаСправочника.Вставить(ТекущиеДанные.Идентификатор, ТекущиеДанные);
				
				Прервать;
				
			КонецЦикла;
			
		КонецЦикла;		
		
		ОбработчикУдалениеФайлов(ИмяФайла);
		
	Иначе
		
		СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникТерминалы(ОписаниеСправочника, Данные)
	
	ТаблицаСправочника = СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
	ДанныеГородов      = ПрочитатьЗначениеПоляКакМассив(Данные, "city");
	
	Для Каждого ТекущийГород Из ДанныеГородов Цикл
		
		КонтейнерТерминалов = ПолучитьЗначениеПоля(ТекущийГород, "terminals", Новый Структура);
		ДанныеТерминалов    = ПрочитатьЗначениеПоляКакМассив(КонтейнерТерминалов, "terminal");
		
		Для Каждого ТекущийТерминал Из ДанныеТерминалов Цикл
			
			КонтейнерИнформации = ПолучитьЗначениеПоля(ТекущийТерминал,               "worktables");
			СписокИнформации    = ПрочитатьЗначениеПоляКакМассив(КонтейнерИнформации, "worktable"); 
			Информация          = "";
			
			Для Каждого ТекущаяИнформация Из СписокИнформации Цикл
				
				ИнформацияДепартамент = ПолучитьЗначениеПоля(ТекущаяИнформация, "department", "");
				ИнформацияВремяРаботы = ПолучитьЗначениеПоля(ТекущаяИнформация, "timetable");
				Информация            = Информация + Символы.ПС + ИнформацияДепартамент + ": " + ИнформацияВремяРаботы;
				
			КонецЦикла;
			
			НоваяЗапись = Новый Структура;
			
			НоваяЗапись.Вставить("Идентификатор",      ПолучитьЗначениеПоля(ТекущийТерминал, "id"));
			НоваяЗапись.Вставить("ГородИдентификатор", ПолучитьЗначениеПоля(ТекущийГород,    "cityID"));
			НоваяЗапись.Вставить("Наименование",       ПолучитьЗначениеПоля(ТекущийТерминал, "name"));
			НоваяЗапись.Вставить("Адрес",              ПолучитьЗначениеПоля(ТекущийТерминал, "fullAddress"));
			НоваяЗапись.Вставить("Информация",         СокрЛП(Информация));
			
			ТаблицаСправочника.Вставить(НоваяЗапись.Идентификатор, НоваяЗапись);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСправочникКонтрагенты(ОписаниеСправочника, Данные)
	
	ПолныйДоступККонтрагентам = Ложь; // Сбросим флаг наличия полного доступа учетной записи 
	ТаблицаСправочника        = СоздатьХранилищеТаблицыСправочника(ОписаниеСправочника);
	Данные                    = ПрочитатьЗначениеПоляКакМассив(Данные, "counteragents");
	
	Для Каждого ТекЭлемент Из Данные Цикл
		
		Идентификатор = ПолучитьЗначениеПоля(ТекЭлемент, "uid");
		
		Если Не ЗначениеЗаполнено(Идентификатор) Тогда
			
			Продолжить;
		
		КонецЕсли; 
		
		ДополнительнаяИнформация = ПолучитьЗначениеПоля(ТекЭлемент, "info"); // Дополнительная (полная) информация о контрагенте
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Идентификатор",        Идентификатор);
		СтруктураДанных.Вставить("Наименование",         ПолучитьЗначениеПоля(ТекЭлемент, "name"));
		СтруктураДанных.Вставить("ЭтоТекущийКонтрагент", ПолучитьЗначениеПоля(ТекЭлемент, "name", Ложь, "Булево"));
		СтруктураДанных.Вставить("УровеньДоступа",       ПолучитьЗначениеПоля(ДополнительнаяИнформация, "access_level"));
		
		ТаблицаСправочника.Вставить(СтруктураДанных.Идентификатор, СтруктураДанных);
		
		Если СтруктураДанных.УровеньДоступа = "2" Тогда
			
			// "2" - Полный доступ
			
			ПолныйДоступККонтрагентам = Истина;
			
		КонецЕсли;  
		
	КонецЦикла;
	
КонецПроцедуры

