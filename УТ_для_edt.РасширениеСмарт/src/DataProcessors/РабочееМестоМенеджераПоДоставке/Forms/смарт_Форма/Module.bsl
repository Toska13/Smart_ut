&НаКлиенте
Процедура УстановитьЗначениеРеквизитаФормы(Реквизит, Значение, Представление = Неопределено)
	
	Если ТипЗнч(Реквизит) = Тип("Строка") Тогда
		
		СтруктураЗначения = Новый Структура(Реквизит, Значение);
		Приемник          = ЭтаФорма;
		
	ИначеЕсли Реквизит.Свойство("ИмяЭлементаРодителя") И ЗначениеЗаполнено(Реквизит.ИмяЭлементаРодителя) Тогда 
		
		// считаем что нам передали схему данных, в случае подчиненного элемента (например, элемент ячейки таблицы формы)
		
		ЭлементРодитель   = Элементы[Реквизит.ИмяЭлементаРодителя];
		Приемник          = ЭлементРодитель.ТекущиеДанные;
		СтруктураЗначения = Новый Структура(Реквизит.Значение, Значение);
		
		Если Представление <> Неопределено Тогда
			
			СтруктураЗначения.Вставить(Реквизит.Представление, Представление);
			
		КонецЕсли; 
		
	Иначе
		
		СтруктураЗначения = Новый Структура(Реквизит.Значение, Значение);
		Приемник          = ЭтаФорма;
		
		Если Представление <> Неопределено Тогда
			
			СтруктураЗначения.Вставить(Реквизит.Представление, Представление);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Приемник, СтруктураЗначения);
	
КонецПроцедуры

