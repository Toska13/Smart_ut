    //	ОбщийЗапрос.Вставить("maxWidth",    Формат(ПараметрыГруза.МаксимальнаяШирина * КоэффициентЕдиницыИзмерения(ПараметрыГруза.МаксимальнаяШиринаЕдиница), "ЧДЦ=3; ЧРД=.; ЧГ="));
    //	ОбщийЗапрос.Вставить("maxWeight",   Формат(ПараметрыГруза.МаксимальныйВес, "ЧДЦ=3; ЧРД=.; ЧГ="));
    //	ОбщийЗапрос.Вставить("quantity", 	Формат(ПараметрыГруза.КоличествоМест, "ЧГ="));
    //	ОбщийЗапрос.Вставить("totalWeight", Формат(ПараметрыГруза.ОбщийВес, "ЧДЦ=3; ЧРД=.; ЧГ="));
    //	ОбщийЗапрос.Вставить("totalVolume", Формат(ПараметрыГруза.ОбщийОбъем, "ЧДЦ=3; ЧРД=.; ЧГ="));
    //	ОбщийЗапрос.Вставить("statedValue", Формат(ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаСтоимость"), "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ="));
    //	
    //Иначе
    //	
    // packed
    ОбщийЗапрос.Вставить("packed", 		ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаТипУпаковки"));
    ОбщийЗапрос.Вставить("paymentType", НайтиПоИдентификатору("ФормыОплаты", СтрокаДанных.ФормаОплатыИдентификатор, "Порядок"));
    ОбщийЗапрос.Вставить("deliveryType", СтрокаДанных.ВидПеревозки);
    ОбщийЗапрос.Вставить("inOrder", 	?(МультиотправкаОтТерминала, 1, 0));		
    
    // Распределим габариты груза
    
    ОбщийЗапрос.Вставить("maxLength", 	Формат(ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаМаксимальнаяДлина"),  "ЧДЦ=3; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("maxHeight", 	Формат(ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаМаксимальнаяВысота"), "ЧДЦ=3; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("maxWidth",  	Формат(ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаМаксимальнаяШирина"), "ЧДЦ=3; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("maxWeight", 	Формат(ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаМаксимальныйВес"), "ЧДЦ=3; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("quantity",	Формат(СтрокаДанных.КоличествоМест, "ЧГ="));
    
    Если ЗначениеРеквизитаФормы(Контейнер + "ОбщиеПараметрыГруза") Тогда
        ВесОтправки   = Окр(СтрокаДанных.КоличествоМест * ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаОбщийВес") / ЗначениеРеквизитаФормы(Контейнер + "Заказы").Итог("КоличествоМест"), 2);
        ОбъемОтправки = Окр(СтрокаДанных.КоличествоМест * ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаОбщийОбъем") / ЗначениеРеквизитаФормы(Контейнер + "Заказы").Итог("КоличествоМест"), 2);
    Иначе
        ВесОтправки   = СтрокаДанных.ОбщийВес;
        ОбъемОтправки = СтрокаДанных.ОбщийОбъем;
    КонецЕсли; 
    
    ОбщийЗапрос.Вставить("totalWeight", Формат(ВесОтправки, "ЧДЦ=2; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("totalVolume", Формат(ОбъемОтправки, "ЧДЦ=2; ЧРД=.; ЧГ="));
    ОбщийЗапрос.Вставить("statedValue", Формат(СтрокаДанных.ОбъявленнаяСтоимость, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ="));
    
    //КонецЕсли;
    
    ОбщийЗапрос.Вставить("primaryPayer", 	ОсновнойПлательщик);
	ОбщийЗапрос.Вставить("name", 			ЗначениеРеквизитаФормы(Контейнер + "ПараметрыГрузаХарактер"));
	ОбщийЗапрос.Вставить("document", 		"document");
	
	Если Не ПолныйДоступККонтрагентам Тогда
		Если Не РежимМультиотправки Тогда
			ЛокальныйКонтейнер = Контейнер + "ПараметрыПеревозки";	
		Иначе
			ЛокальныйКонтейнер = Контейнер;	
		КонецЕсли;
		РольЗаказчика = Мин(НайтиПоИдентификатору("РолиВПеревозке", 
													ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "РольЗаказчикаВПеревозкеИдентификатор"),
													"Порядок"), 3);
		ОбщийЗапрос.Вставить("requester", РольЗаказчика);	
	КонецЕсли; 	
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.ЗаказНаДоставкуОтАдреса, ОбщийЗапрос);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		ДанныеОтвета               = ПолучитьЗначениеПоля(СтруктураОтвета, "answer");
		ТекущийИдентификаторЗаказа = ПолучитьЗначениеПоля(ДанныеОтвета, "requestID");
		
		Если Не ЗначениеЗаполнено(ТекущийИдентификаторЗаказа) Тогда
			ВывестиСообщениеПользователю("Не удалось создать заказа на доставку от адреса");
			ВывестиСообщениеПользователю(Результат.Данные);
        ИначеЕсли РежимМультиотправки Тогда 
            смартЗаписьВРегистрПредзакза(СтрокаДанных.Распоряжение,ДанныеОтвета);
			СтрокаДанных.ЗаказИдентификатор = ТекущийИдентификаторЗаказа; 
		КонецЕсли; 
		
	Иначе
		ОбработатьОшибкиЗапроса(Результат);
		ВывестиСообщениеПользователю("Не удалось создать заказа на доставку от адреса");
	КонецЕсли; 
	
	Возврат ТекущийИдентификаторЗаказа;
	
КонецФункции

&НаСервере
Процедура смартЗаписьВРегистрПредзакза(Заказ,ДанныеОтвета)
    
    МенеджерЗаписи = РегистрыСведений.смартСозданиеПредзаказовВ_ТК.СоздатьМенеджерЗаписи(); 
    МенеджерЗаписи.Заказ = Заказ; 
    МенеджерЗаписи.requestID = ДанныеОтвета.requestID; 
    МенеджерЗаписи.barcode = ДанныеОтвета.barcode; 
    МенеджерЗаписи.Записать();
    
КонецПроцедуры

