#Область Телефоны

&НаКлиенте
Процедура ПодключаемыйОбработчикТелефоныНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СхемаДанных          = СхемаСвязейДанных[Элемент.Имя];
	Таблица              = ЗначениеРеквизитаФормы(СхемаДанных, Новый Массив);
	СписокТелефонов      = Новый Массив;
	
	Для Каждого ДанныеСтроки Из Таблица Цикл
		
		СтруктураДанных = Новый Структура("Идентификатор, Основной, Добавочный");
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ДанныеСтроки);
		СписокТелефонов.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Список",    СписокТелефонов);
	
	ОткрытьФорму(КоллекцияФорм.СписокТелефонов.Путь, ПараметрыФормы, Элемент, УникальныйИдентификатор);  
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикТелефоныОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СхемаДанных = СхемаСвязейДанных[Элемент.Имя];
	Таблица     = ЗначениеРеквизитаФормы(СхемаДанных, Новый Массив);
	
	Таблица.Очистить();
	
	Для Каждого ДанныеСтроки Из ВыбранноеЗначение Цикл
		
		Основной   = ПолучитьТолькоЦифры(ДанныеСтроки.Основной);
		Добавочный = ПолучитьТолькоЦифры(ДанныеСтроки.Добавочный);
		
		Если ЗначениеЗаполнено(Основной) Тогда
			
			НовыйТелефон = Таблица.Добавить();
			НовыйТелефон.Идентификатор = ДанныеСтроки.Идентификатор;
			НовыйТелефон.Основной      = Основной;
			НовыйТелефон.Добавочный    = Добавочный;
			НовыйТелефон.Представление = ПредставлениеТелефонаПоМаске(НовыйТелефон);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ВыбранноеЗначение = ПредставлениеТаблицы(Таблица);
	
КонецПроцедуры

#КонецОбласти

#Область КонтактныеЛица

&НаКлиенте
Процедура ПодключаемыйОбработчикКонтактныеЛицаНачалоВыбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СхемаДанных          = СхемаСвязейДанных[Элемент.Имя];
	Таблица              = ЗначениеРеквизитаФормы(СхемаДанных, Новый Массив);
	Список               = Новый Массив;
	
	Для Каждого ДанныеСтроки Из Таблица Цикл
		
		СтруктураДанных = Новый Структура("Идентификатор, Представление");
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ДанныеСтроки);
		Список.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Список",    Список);
	
	ОткрытьФорму(КоллекцияФорм.СписокКонтактныхЛиц.Путь, ПараметрыФормы, Элемент, УникальныйИдентификатор);  
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикКонтактныеЛицаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СхемаДанных = СхемаСвязейДанных[Элемент.Имя];
	Таблица     = ЗначениеРеквизитаФормы(СхемаДанных, Новый Массив);
	
	Таблица.Очистить();
	
	Для Каждого ДанныеСтроки Из ВыбранноеЗначение Цикл
		
		Если ЗначениеЗаполнено(ДанныеСтроки.Представление) Тогда
			
			НовыйТелефон = Таблица.Добавить();
			НовыйТелефон.Идентификатор = ДанныеСтроки.Идентификатор;
			НовыйТелефон.Представление = ДанныеСтроки.Представление;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ВыбранноеЗначение = ПредставлениеТаблицы(Таблица);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПодключаемыйОбработчикПриОчисткеКонтактнойИнформации(Элемент, СтандартнаяОбработка)
	
	СхемаДанных = СхемаСвязейДанных[Элемент.Имя];
	Таблица     = ЗначениеРеквизитаФормы(СхемаДанных, Новый Массив);
	
	Если Таблица.Количество() <= 1 Тогда
		
		Таблица.Очистить();
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		СписокВыбора         = Новый СписокЗначений;
		
		Для Каждого ТекущаяЗапись Из Таблица Цикл
			
			СписокВыбора.Добавить(Таблица.Индекс(ТекущаяЗапись), ТекущаяЗапись.Представление);
			
		КонецЦикла;
		
		Оповещение = Новый ОписаниеОповещения("ПодключаемыйОбработчикПриОчисткеКонтактнойИнформацииЗавершение", ЭтаФорма, СхемаДанных);
		ПоказатьВыборИзСписка(Оповещение, СписокВыбора, Элемент);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикПриОчисткеКонтактнойИнформацииЗавершение(ВыбранныйЭлемент, СхемаДанных) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		Таблица = ЗначениеРеквизитаФормы(СхемаДанных);
		Таблица.Удалить(ВыбранныйЭлемент.Значение);
		
		Если ЗначениеЗаполнено(СхемаДанных.ИмяЭлементаРодителя) Тогда
			
			ДанныеСтроки = Элементы[СхемаДанных.ИмяЭлементаРодителя].ТекущиеДанные;
			ДанныеСтроки[СхемаДанных.Представление] = ПредставлениеТаблицы(Таблица);
			
		Иначе
			
			ЭтаФорма[СхемаДанных.Представление] = ПредставлениеТаблицы(Таблица);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПриИзмененииДанныхЭлемента(Элемент)
	
	ДанныеЭлемента = Неопределено;
	
	Если СтруктураПроверкиЗаполнения.ОбработчикИзмененияЭлементов.Свойство(Элемент.Имя, ДанныеЭлемента) Тогда
		
		ТекущийОбработчик = ДанныеЭлемента.Обработчик;
		
		Если ЗначениеЗаполнено(ТекущийОбработчик) Тогда
			
			Выполнить(ТекущийОбработчик + "(Элемент)");
			
		КонецЕсли;
		
		/// обработка действий
		
		Если ЗначениеЗаполнено(ДанныеЭлемента.Действия) Тогда
			
			Для Каждого ТекущееДействие Из ДанныеЭлемента.Действия Цикл
				
				Если ТекущееДействие.Действие = "Установить" Тогда
					
					УстановитьЗначениеРеквизитаФормы(ТекущееДействие.Параметры.Имя, ТекущееДействие.Параметры.Значение);
					
				ИначеЕсли ТекущееДействие.Действие = "Обработчик" Тогда 
					
					Выполнить(ТекущееДействие.Параметры + "()");
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииДанныхРеквизита(Реквизит)
	
	ДанныеЭлемента = Неопределено;
	
	Если СтруктураПроверкиЗаполнения.ОбработчикИзмененияРеквизитов.Свойство(Реквизит, ДанныеЭлемента) Тогда
		
		Если ЗначениеЗаполнено(ДанныеЭлемента.Действия) Тогда
			
			Для Каждого ТекущееДействие Из ДанныеЭлемента.Действия Цикл
				
				Если ТекущееДействие.Действие = "Установить" Тогда
					
					УстановитьЗначениеРеквизитаФормы(ТекущееДействие.Параметры.Имя, ТекущееДействие.Параметры.Значение);
					
				ИначеЕсли ТекущееДействие.Действие = "Обработчик" Тогда 
					
					Выполнить(ТекущееДействие.Параметры + "()");
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ИнициализацияСправочников

&НаСервере
Функция СоздатьТаблицуСправочникаПоОписанию(ОписаниеСправочника)
	
	Таблица = Новый ТаблицаЗначений;
	
	// Добавляем "стандартные" реквизиты справочника
	
	Таблица.Колонки.Добавить("НомерСтроки");
	Таблица.Колонки.Добавить("Идентификатор");
	Таблица.Колонки.Добавить("Наименование");
	
	// И реквизиты из описания метаданных
	
	Для Каждого ДанныеРеквизита Из ОписаниеСправочника.Реквизиты Цикл
		
		Таблица.Колонки.Добавить(ДанныеРеквизита.Ключ, Новый ОписаниеТипов(ДанныеРеквизита.Значение.Тип));
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

&НаСервере
Функция ПолучитьТаблицуСправочникаИзДанныхОбъекта(ОписаниеСправочника)
	
	// В обработчике события формы "ПриСозданииНаСервере" были предварительно
	// получены все необходимые данные, десериализованы и сложены в соответствующее хранилище.
	// При передаче управления на клиент это "хранилище" будет уничтожено, но проинициализированные
	// таблицы останутся во временном хранилище
	
	Таблица = ДанныеСерверногоКонтекста.Справочники[ОписаниеСправочника.Источник.Таблица];
	
	Возврат Таблица;
	
КонецФункции

&НаСервере
Функция ИнициализироватьТаблицуСправочникаНаСервере(ОписаниеСправочника)
	
	Если ОписаниеСправочника.Источник.Тип = "Объект" Тогда
		
		// Если для справочника указан тип источника "Объект", значит
		// таблица справочника уже зашита в нашу обработку (сериализованные данные в макете)
		
		Таблица = ПолучитьТаблицуСправочникаИзДанныхОбъекта(ОписаниеСправочника);
		
	Иначе
		
		// Если источником таблицы является api - просто создаем пустую таблицу
		// с колонками, соответствующие реквизитам справочника из описания
		
		Таблица = СоздатьТаблицуСправочникаПоОписанию(ОписаниеСправочника);
		
	КонецЕсли; 
	
	Возврат ПоместитьВоВременноеХранилище(Таблица, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ИнициализироватьХранилищеСправочника(ОписаниеСправочника)
	
	// Для справочников, располагающихся на сервере, храним их таблицы
	// во временном хранилище. Адрес временного хранилища прописываем
	// в описание справочника (секция Хранилище)
	//
	// Ограничения: предполагается, что справочники с "виртуальным" источником
	//  не могут располагаться (и быть доступны) на сервере
	
	ХранилищеСправочника = ОписаниеСправочника.Хранилище;
	
	Если ХранилищеСправочника.Расположение = "Сервер" Тогда
		
		ХранилищеСправочника.Вставить("Адрес", ИнициализироватьТаблицуСправочникаНаСервере(ОписаниеСправочника));
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКоллекциюСправочниковНаСервере()
	
	Для Каждого ОписаниеСправочника Из КоллекцияМетаданные.Справочники Цикл
		
		ИмяСправочника       = ОписаниеСправочника.Ключ;
		ДанныеСправочника    = ОписаниеСправочника.Значение;
		
		ДанныеСправочника.Вставить("Имя", ИмяСправочника);
		ИнициализироватьХранилищеСправочника(ДанныеСправочника);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

