#Область СлужебныйПрограммныйИнтерфейс

// Определяет корректность телефонного номера (Основной + добавочный)
// согласно заданным маскам номеров:
// Основной номер
//  Номер начинается с "7" - длина номера равна 11 символов
//  Номер начинается с "375" - длина номера равна 12 символов
//  Номер начинается с любой другой комбинации - длина номера от 10 до 18 символов включительно
// Добавочный номер
//  Номер содержит только цифры - максимальная длина 5 знаков
//
// Параметры:
//  Основной    - Строка - значение основного номера телефона
//  Добавочный  - Строка - значение добавочного номера телефона
//
// Возвращаемое значение:
//   Булево   - Истина - номер корректный, Ложь - номер содержит ошибки
//
&НаКлиенте
Функция ЭтоКорректныйНомерТелефона(Основной, Добавочный = "") Экспорт
	
	Результат = Ложь;
	
	ДлинаРоссийскогоНомера             = 11; // код +7
	ДлинаБелорусскогоНомера            = 12; // код +375
	ДлинаПрочихНомеровМинимальная      = 10; // все другие коды
	ДлинаПрочихНомеровМаксимальная     = 18;
	ДлинаДобавочногоНомераМаксимальная = 5;
	
	// Проверяем сначала основной номер
	
	НомерТолькоЦифры = ПолучитьТолькоЦифры(Основной);
	ДлинаНомера      = СтрДлина(НомерТолькоЦифры);
	
	Если Найти("78", Лев(НомерТолькоЦифры, 1)) > 0 Тогда
		
		Результат = ДлинаНомера = ДлинаРоссийскогоНомера;
		
	ИначеЕсли Лев(НомерТолькоЦифры, 3) = "375" Тогда
		
		Результат = ДлинаНомера = ДлинаБелорусскогоНомера;
		
	Иначе
		
		Результат = ДлинаНомера >= ДлинаПрочихНомеровМинимальная И ДлинаНомера <= ДлинаПрочихНомеровМаксимальная;
		
	КонецЕсли;
	
	// дополнительный номер проверяем только если основной номер корректный
	
	Если Результат И ЗначениеЗаполнено(Добавочный) Тогда
		
		НомерТолькоЦифры = ПолучитьТолькоЦифры(Добавочный);
		ДлинаНомера      = СтрДлина(НомерТолькоЦифры);
		
		Результат = НомерТолькоЦифры = СокрЛП(Добавочный) И ДлинаНомера <= ДлинаДобавочногоНомераМаксимальная;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ЭтоКорректныйНомерТелефона()

// Экспортный метод для вывода сообщений пользователю (используется в "подчиненных" формах обработки)
//
// Параметры:
//  Текст         - Строка       - Текст сообщения
//  Поле          - Строка       - Путь к реквизиту связанный с элементом формы для привязки сообщения
//  Интерактивно  - Булево       - Истина: выводить сообщение, Ложь: не выводить
//  ПараметрОтказ - Произвольный - Данный параметр принимает значение "Истина" в результате вызова метода
//
&НаКлиенте
Процедура ПоказатьСообщениеПользователю(Текст, Поле = Неопределено, Интерактивно = Истина, ПараметрОтказ = Неопределено) Экспорт
	
	ВывестиСообщениеПользователю(Текст, Поле, Интерактивно, ПараметрОтказ);
	
КонецПроцедуры

