&НаКлиенте
Процедура МультиотправкаБлокировкаСпособаОтправителя(Принудительно = Ложь, Доступность = Ложь)
	
	Если Принудительно Тогда
			
	    Элементы.МультиотправкаПараметрыГруза.Доступность 		= Доступность;
		Элементы.МультиотправкаОтправитель.Доступность 			= Доступность;
		Элементы.МультиотравкаПараметрыПеревозки.Доступность 	= Доступность;
		
	Иначе
	
		СписокОшибок = МультиотправкаЗаказы.НайтиСтроки(Новый Структура("ЗаказИдентификатор", ""));
		Если СписокОшибок.Количество() > 0
			И СписокОшибок.Количество() <> МультиотправкаЗаказы.Количество() Тогда

		    Элементы.МультиотправкаПараметрыГруза.Доступность 		= Ложь;
			Элементы.МультиотправкаОтправитель.Доступность 			= Ложь;
			Элементы.МультиотравкаПараметрыПеревозки.Доступность 	= Ложь;
			
		Иначе
			
			Элементы.МультиотправкаПараметрыГруза.Доступность 		= Истина;
			Элементы.МультиотправкаОтправитель.Доступность 			= Истина;
			Элементы.МультиотравкаПараметрыПеревозки.Доступность 	= Истина;

		КонецЕсли;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСохраненныеМультиотправкиНаСервере()
	
	КлючНастройки     = КлючиХранилищаНастроек().Мультиотправка;
	ДанныеНастройки   = РеквизитФормыВЗначение("СохраненныеМультиотправки");
	СообщениеОбОшибке = "Не достаточно прав для сохранения списка мультиотправок";
	
	СохранитьНастройкуСПроверкой(КлючНастройки, ДанныеНастройки, СообщениеОбОшибке);
	
КонецПроцедуры

