#Область СтроковыеФункции

&НаКлиенте
Функция СтрокаПоШаблону(Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено)
	
	// <TODO Автор="Марусов" Дата="2017-07-26" Тип="Критичный">Отказаться от функции в пользу платформенного метода</TODO> 
	
	Результат = Шаблон;
	
	Результат = СтрЗаменить(Результат, "%1", Параметр1);
	Результат = СтрЗаменить(Результат, "%2", Параметр2);
	Результат = СтрЗаменить(Результат, "%3", Параметр3);
	Результат = СтрЗаменить(Результат, "%4", Параметр4);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДополнитьСтрокуПоШаблону(Приемник, Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено)
	
	Приемник = Приемник + СтрокаПоШаблону(Шаблон, Параметр1, Параметр2, Параметр3, Параметр4);
	
	Возврат Приемник;
	
КонецФункции

&НаКлиенте
Функция ДополнитьСтрокуПоШаблонуСУсловием(Условие, Приемник, Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено)
	
	Если Условие Тогда
		
		ДополнитьСтрокуПоШаблону(Приемник, Шаблон, Параметр1, Параметр2, Параметр3, Параметр4);
		
	КонецЕсли; 
	
	Возврат Приемник;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТолькоЦифры(Текст)
	
	НаборСимволов = "0123456789";
	ДлинаТекста   = СтрДлина(Текст);
	Результат     = "";
	
	Для НомерСимвола = 1 По ДлинаТекста Цикл
		
		ТекущийСимвол = Сред(Текст, НомерСимвола, 1);
		
		Если СтрНайти(НаборСимволов, ТекущийСимвол) Тогда
			
			Результат = Результат + ТекущийСимвол;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

