&НаКлиенте
Процедура СохранитьМультиотправку(ДополнительныеПараметры = Неопределено)
	
	Если ДополнительныеПараметры = Неопределено Тогда 
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	// Проверим есть ли уже с таким ключем мультиотправка в сохраненных
	
	СписокСохраненных = СохраненныеМультиотправки.НайтиСтроки(Новый Структура("Ключ", МультиотправкаКлюч));
	
	Если СписокСохраненных.Количество() Тогда
		
		СписокСохраненных[0].Данные = СобратьСтруктуруДанныхМультиотправка();
		ЗаписатьСохраненныеМультиотправкиНаСервере();
		Если ДополнительныеПараметры.Свойство("КомандаПриЗавершении") Тогда
			Выполнить(ДополнительныеПараметры.КомандаПриЗавершении);
		КонецЕсли;
		
	Иначе
		
		ТекущееНаименование	= "Новая мультиотправка";
		Оповещение = Новый ОписаниеОповещения("МультиотправкаСохранитьЗавершение", ЭтаФорма, ДополнительныеПараметры);
		ПоказатьВводСтроки(Оповещение, ТекущееНаименование, "Сохранить как...");
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаСохранитьЗавершение(НовоеНаименование, ДополнительныеПараметры) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НовоеНаименование) Тогда
		
		НовоеНаименование = "Новая мультиотправка " + ТекущаяДата();
		
	КонецЕсли;
	
	СписокСохраненных = СохраненныеМультиотправки.НайтиСтроки(Новый Структура("Ключ", МультиотправкаКлюч));
	
	Если СписокСохраненных.Количество() Тогда
		
		НоваяЗапись = СписокСохраненных[0];
		
	Иначе
		
		НоваяЗапись	= СохраненныеМультиотправки.Добавить();
		
	КонецЕсли;
	
	НоваяЗапись.Ключ = МультиотправкаКлюч;
	НоваяЗапись.Наименование = НовоеНаименование;
	НоваяЗапись.Данные = СобратьСтруктуруДанныхМультиотправка();
	
	ЗаписатьСохраненныеМультиотправкиНаСервере();
	
	Если ДополнительныеПараметры.Свойство("КомандаПриЗавершении") Тогда
		Выполнить(ДополнительныеПараметры.КомандаПриЗавершении);
	КонецЕсли;
	
КонецПроцедуры

