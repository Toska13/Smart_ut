&НаКлиенте
Процедура УстановитьДоступностьПараметровКонтрагента(СхемаДанных, Признак = Истина)
	
	Если СхемаДанных.Свойство("ИмяЭлементаРодителя") И ЗначениеЗаполнено(СхемаДанных.ИмяЭлементаРодителя) Тогда
		
		ИмяЭлемента = СхемаДанных.ИмяЭлементаРодителя;
		
	Иначе
		
		ИмяЭлемента = СхемаДанных.Контейнер;
		
	КонецЕсли;
	
	Элемент = Элементы[ИмяЭлемента];
	
	Для Каждого ТекЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(ТекЭлемент) <> Тип("ГруппаФормы") Тогда
			
			ТекЭлемент.Доступность = Признак;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если Элементы.Найти(ИмяЭлемента + "ДанныеКонтрагента") <> Неопределено Тогда
		
		Элемент = Элементы[ИмяЭлемента + "ДанныеКонтрагента"];
		
		Для Каждого ТекЭлемент Из Элемент.ПодчиненныеЭлементы Цикл
			
			Если ТипЗнч(ТекЭлемент) <> Тип("ГруппаФормы") Тогда
				
				ТекЭлемент.Доступность = Признак;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьБлокировкуЭлементовФормы(Элемент, ПризнакДоступности = Ложь)
	
	Элемент.Доступность = ПризнакДоступности;
	
	СписокСвязанныхЭлементов = СвязанныеЭлементыФормы[Элемент.Имя];
	
	Если ЗначениеЗаполнено(СписокСвязанныхЭлементов) Тогда
		
		Для Каждого ИмяЭлемента Из СписокСвязанныхЭлементов Цикл
			
			Элементы[ИмяЭлемента].Доступность = ПризнакДоступности;
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры                

&НаКлиенте
Процедура ПередОткрытиемСтраницыМультиотправкаГабариты(ИмяСтраницы, Элемент, ПараметрыСтраницы)
	
	УстановитьМодифицированностьСтраницы(ИмяСтраницы);
	Элемент.Доступность = Ложь;
	
	МультиотправкаГабаритыДлина = МультиотправкаПараметрыГрузаМаксимальнаяДлина;
	МультиотправкаГабаритыШирина = МультиотправкаПараметрыГрузаМаксимальнаяШирина;
	МультиотправкаГабаритыВысота = МультиотправкаПараметрыГрузаМаксимальнаяВысота;
	МультиотправкаГабаритыВес = МультиотправкаПараметрыГрузаМаксимальныйВес;
	
	ЗаписатьПараметрыТекущейСтраницы(ИмяСтраницы, Элемент, ПараметрыСтраницы);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьПараметрыТекущейСтраницы(ИмяСтраницы, Элемент, ПараметрыСтраницы, ОбработчикВыбора = Неопределено)
	
	Если ПараметрыДополнительнойПанели = Неопределено Тогда
		
		ПараметрыДополнительнойПанели = Новый Структура;	
		
	КонецЕсли; 
	
	ПараметрыДополнительнойПанели.Вставить(ИмяСтраницы, Новый Структура("Элемент, Параметры, ОбработчикВыбора", Элемент, ПараметрыСтраницы, ОбработчикВыбора));
	
КонецПроцедуры

#Область ДополнительнаяПанель

&НаКлиенте
Процедура ДополнительнаяПанельДействийПрименитьПараметры(Команда)
	
	ЭлементПанель   = Элементы.ДополнительнаяПанельСтраницы;
	ТекущаяСтраница = ЭлементПанель.ТекущаяСтраница;
	Результат       = ПроверитьДанныеСтраницыДополнительнойПанели(ТекущаяСтраница.Имя);
	
	ОбработатьДанныеСтраницыДополнительнойПанели(ТекущаяСтраница.Имя, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяПанельОтменитьИзменения(Команда)
	
	ЭлементПанель   = Элементы.ДополнительнаяПанельСтраницы;
	ТекущаяСтраница = ЭлементПанель.ТекущаяСтраница;
	
	УстановитьМодифицированностьСтраницы(ТекущаяСтраница.Имя, Ложь);
	ПередЗакрытиемСтраницыДополнительнойПанели(ТекущаяСтраница.Имя);
	
	ЭлементПанель.ТекущаяСтраница = Элементы.Заглушка;
	ЭлементПанель.Видимость = Ложь;
	
	СохранитьИВыбратьКонтрагента = Ложь;
	
КонецПроцедуры

&НаКлиенте
Функция МультиотправкаСформироватьПредставлениеДополнительныхУслуг(Источник)
	
	Представление = "";
	
	Если ЗначениеЗаполнено(Источник.ОбъявленнаяСтоимость) Тогда
		
		Представление = "Объявленная стоимость (руб): " + Формат(Источник.ОбъявленнаяСтоимость, "ЧЦ=15; ЧДЦ=2; ЧН=");
		
	КонецЕсли;
	
	Если Источник.ДополнительныеУслугиСписок.Количество() Тогда
		
		Представление = Представление + Символы.ПС + ПредставлениеТаблицы(Источник.ДополнительныеУслугиСписок);
		
	КонецЕсли;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

