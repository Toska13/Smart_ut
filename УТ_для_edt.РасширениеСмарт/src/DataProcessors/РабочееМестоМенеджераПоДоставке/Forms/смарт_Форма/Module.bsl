    //ЖурналЛогирования.ДобавитьСтроку("Версия платформы: " + СисИнфо.ВерсияПриложения);
    //ЖурналЛогирования.ДобавитьСтроку("Режим совместимости: " + Метаданные.РежимСовместимости);
    //ЖурналЛогирования.ДобавитьСтроку("Режим совместимости интерфейса: " + Метаданные.РежимСовместимостиИнтерфейса);
	
