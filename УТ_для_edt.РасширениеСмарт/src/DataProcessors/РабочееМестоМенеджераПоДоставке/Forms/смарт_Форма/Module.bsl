&НаКлиенте
Процедура ПодключаемыйОбработчикПриОкончанииВводаТекста(Элемент, Текст, Значение, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	СхемаСправочника     = СхемаСвязейДанных[Элемент.Имя];
	ТекущийСправочник    = КоллекцияМетаданные.Справочники[СхемаСправочника.ИмяСправочника];
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Текст) Тогда
		
		Если ТекущийСправочник.Имя = КоллекцияМетаданные.Справочники.НаселенныеПункты.Имя Тогда
			
			Значение = СписокНаселенныхПунктовПоСтроке(Текст);
			
		Иначе
			
			Если СхемаСправочника.Свойство("ИмяЭлементаРодителя") Тогда
				
				СхемаДанныхГорода = СхемаСвязейДанных[СтрЗаменить(Элемент.Имя, "Улица", "Город")];
				
			Иначе
				
				СхемаДанныхГорода = СтрЗаменить(СхемаСправочника.Значение, "Улица", "Город");
				
			КонецЕсли;
			
			ИдентификаторГорода = ЗначениеРеквизитаФормы(СхемаДанныхГорода, "");
			Значение            = СписокУлицПоСтроке(Текст, ИдентификаторГорода)
			
		КонецЕсли; 
		
	Иначе
		
		Значение = Новый СписокЗначений;
		Значение.Добавить("");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если Найти(ВыбранноеЗначение, "<ПРОДОЛЖИТЬПОИСК>") = 0  Тогда
			
			СхемаСправочника = СхемаСвязейДанных[Элемент.Имя];
			
			Представление = НайтиПоИдентификатору(СхемаСправочника.ИмяСправочника, ВыбранноеЗначение, "Наименование");
			УстановитьЗначениеРеквизитаФормы(СхемаСправочника, ВыбранноеЗначение);
			ВыбранноеЗначение = Представление;
			
		Иначе
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		СхемаСправочника = СхемаСвязейДанных[Элемент.Имя];
		
		Представление = "";
		УстановитьЗначениеРеквизитаФормы(СхемаСправочника, ВыбранноеЗначение);
		ВыбранноеЗначение = Представление;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикАдреснаяКнигаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьСтраницуДополнительнойПанели("АдреснаяКнигаСписокВыбора", Элемент, "ВыборКонтрагента");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемыйОбработчикКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    
    //ОткрытьСтраницуДополнительнойПанели("КарточкаКонтрагента", Элемент, "ВыборКонтрагента");  	
    ОткрытьСтраницуДополнительнойПанели("АдреснаяКнигаСписокВыбора", Элемент, "ВыборКонтрагента");
    
КонецПроцедуры

