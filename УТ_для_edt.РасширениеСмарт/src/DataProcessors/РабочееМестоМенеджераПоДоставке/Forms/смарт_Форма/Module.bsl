&НаКлиенте
Функция ПроверкаЗаполненияСписокТелефонов(Источник, Интерактивно = Ложь, ПроверятьВсе = Ложь)
	
	Результат   = Истина;
	
	Если Источник.Количество() Тогда
		
		НомерСтроки = 0;
		
		Для Каждого ТекущийНомер Из Источник Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если Не ЭтоКорректныйНомерТелефона(ТекущийНомер.Основной, ТекущийНомер.Добавочный) Тогда
				
				Результат = Ложь;
				ВывестиСообщениеПользователю("Некорректно указан номер телефона в строке " + НомерСтроки, , Интерактивно);
				
				Если Не ПроверятьВсе Тогда
					
					Прервать;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Результат = Ложь;
		ВывестиСообщениеПользователю("Не указаны номера телефонов", , Интерактивно);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПроверкаЗаполненияСписокТелефонов()

