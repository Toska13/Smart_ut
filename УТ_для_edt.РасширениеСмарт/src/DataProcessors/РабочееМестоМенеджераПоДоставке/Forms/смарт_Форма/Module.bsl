&НаКлиенте
Функция СобратьСтруктуруДанныхМультиотправка()
	
	СтруктураДанных = Новый Структура;
	
	СтруктураДанных.Вставить("МультиотправкаПараметрыПеревозкиДатаВремя", МультиотправкаПараметрыПеревозкиДатаВремя);
	СтруктураДанных.Вставить("МультиотправкаПараметрыПеревозкиДатаВремяПредставление", МультиотправкаПараметрыПеревозкиДатаВремяПредставление);
	СтруктураДанных.Вставить("МультиотправкаИдентификатор", МультиотправкаИдентификатор); 
	СтруктураДанных.Вставить("МультиотправкаКлюч", МультиотправкаКлюч);
	СтруктураДанных.Вставить("МультиотправкаОбщиеПараметрыГруза", МультиотправкаОбщиеПараметрыГруза);
	СтруктураДанных.Вставить("МультиотправкаОтправительГородИдентификатор", МультиотправкаОтправительГородИдентификатор);
	СтруктураДанных.Вставить("МультиотправкаОтправительГородПредставление", МультиотправкаОтправительГородПредставление);
	СтруктураДанных.Вставить("МультиотправкаОтправительКорпус", МультиотправкаОтправительКорпус); 
	СтруктураДанных.Вставить("МультиотправкаОтправительДом", МультиотправкаОтправительДом);
	СтруктураДанных.Вставить("МультиотправкаОтправительКвартира", МультиотправкаОтправительКвартира);
	СтруктураДанных.Вставить("МультиотправкаОтправительКонтактныеЛицаПредставление", МультиотправкаОтправительКонтактныеЛицаПредставление);
	СтруктураДанных.Вставить("МультиотправкаОтправительКонтрагентИдентификатор", МультиотправкаОтправительКонтрагентИдентификатор); 
	СтруктураДанных.Вставить("МультиотправкаОтправительКонтрагентПредставление", МультиотправкаОтправительКонтрагентПредставление);
	СтруктураДанных.Вставить("МультиотправкаОтправительСтроение", МультиотправкаОтправительСтроение); // = "";
	СтруктураДанных.Вставить("МультиотправкаОтправительТелефоныПредставление", МультиотправкаОтправительТелефоныПредставление); 
	СтруктураДанных.Вставить("МультиотправкаОтправительУлицаИдентификатор", МультиотправкаОтправительУлицаИдентификатор); 
	СтруктураДанных.Вставить("МультиотправкаОтправительУлицаПредставление", МультиотправкаОтправительУлицаПредставление);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаГабаритыПредставление", МультиотправкаПараметрыГрузаГабаритыПредставление);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаМаксимальнаяВысота", МультиотправкаПараметрыГрузаМаксимальнаяВысота); 
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаМаксимальнаяДлина", МультиотправкаПараметрыГрузаМаксимальнаяДлина); 
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаМаксимальнаяШирина", МультиотправкаПараметрыГрузаМаксимальнаяШирина);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаМаксимальныйВес", МультиотправкаПараметрыГрузаМаксимальныйВес); 
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаОбщийВес", МультиотправкаПараметрыГрузаОбщийВес); 
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаОбщийОбъем", МультиотправкаПараметрыГрузаОбщийОбъем);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаТипУпаковки", МультиотправкаПараметрыГрузаТипУпаковки);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаХарактер", МультиотправкаПараметрыГрузаХарактер);
	СтруктураДанных.Вставить("МультиотправкаЗаказы", Новый СписокЗначений);
	СтруктураДанных.Вставить("МультиотправкаПараметрыГрузаОбщееКоличествоМест", МультиотправкаПараметрыГрузаОбщееКоличествоМест);
	
	СтруктураДанных.Вставить("МультиотправкаЗаказчикИдентификатор",  МультиотправкаЗаказчикИдентификатор);
