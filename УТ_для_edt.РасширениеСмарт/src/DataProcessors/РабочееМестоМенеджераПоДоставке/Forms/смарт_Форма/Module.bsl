&НаКлиенте
Функция ЗагрузитьАдреснуюКнигу()
	
	МетодВыполнен = Ложь;
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.АдреснаяКнига, СтруктураЗапросаПоСессии());
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		АдреснаяКнига.Очистить();
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		СписокЗаписей   = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "counteragent");
		
		Для Каждого ТекущаяЗапись Из СписокЗаписей Цикл
			
			НоваяЗапись = АдреснаяКнига.Добавить();
			
			НоваяЗапись.Идентификатор       = ПолучитьЗначениеПоля(ТекущаяЗапись, "id");
			НоваяЗапись.ОПФНаименование     = ПолучитьЗначениеПоля(ТекущаяЗапись, "form");
			НоваяЗапись.ОПФИдентификатор    = ПолучитьЗначениеПоля(ТекущаяЗапись, "formUID");
			НоваяЗапись.Наименование        = ПолучитьЗначениеПоля(ТекущаяЗапись, "name");
			НоваяЗапись.СтранаИдентификатор = ПолучитьЗначениеПоля(ТекущаяЗапись, "country_uid");
			НоваяЗапись.Тип                 = ПолучитьЗначениеПоля(ТекущаяЗапись, "type");
			
			Если НоваяЗапись.Тип = "juridical" Тогда
				
				НоваяЗапись.ИНН = ПолучитьЗначениеПоля(ТекущаяЗапись, "inn");
				НоваяЗапись.ДокументПредставление = "ИНН: " + НоваяЗапись.ИНН;
				
			Иначе
				
				ДанныеДокумента = ПолучитьЗначениеПоля(ТекущаяЗапись, "document");
				
				НоваяЗапись.ДокументТип        = ПолучитьЗначениеПоля(ДанныеДокумента, "type");
				НоваяЗапись.ДокументСерия      = ПолучитьЗначениеПоля(ДанныеДокумента, "serial");
				НоваяЗапись.ДокументНомер      = ПолучитьЗначениеПоля(ДанныеДокумента, "number");
				НоваяЗапись.ДокументДатаВыдачи = ПолучитьЗначениеПоля(ДанныеДокумента, "date", '00010101', "Дата");
				
				ДокументТипПредставление = НайтиПоИдентификатору("ТипыУдостоверяющихДокументов", НоваяЗапись.ДокументТип, "Наименование");
				НоваяЗапись.ДокументПредставление = ?(ЗначениеЗаполнено(ДокументТипПредставление), ДокументТипПредставление, "н/д")  + ": " + НоваяЗапись.ДокументСерия + " " + НоваяЗапись.ДокументНомер;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		МетодВыполнен = Истина;
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Возврат МетодВыполнен;
	
КонецФункции

&НаКлиенте
Функция СоздатьАдресКонтрагента(ИдентификаторКонтрагента, Адрес, Телефоны = Неопределено, КонтактныеЛица = Неопределено)
	
	СтруктураДанных      = Новый Структура("Идентификатор");
	СтруктураЗапроса     = СтруктураЗапросаПоСессии();
	ЭтоТерминальныйАдрес = НРег(Адрес.Способ) <> "адрес" И Адрес.Свойство("ТерминалИдентификатор") И ЗначениеЗаполнено(Адрес.ТерминалИдентификатор);
	
	СтруктураЗапроса.Вставить("counteragentID", ИдентификаторКонтрагента);
	
	Если ЭтоТерминальныйАдрес Тогда
		
		СтруктураЗапроса.Вставить("terminal_id", Адрес.ТерминалИдентификатор);
		
	Иначе
		
		Если ЗначениеЗаполнено(Адрес.УлицаИдентификатор) Тогда
			
			СтруктураЗапроса.Вставить("street", Адрес.УлицаИдентификатор);
			
		Иначе
			
			СтруктураЗапроса.Вставить("customStreet", Новый Структура);
			
			СтруктураЗапроса.customStreet.Вставить("code",   НайтиПоИдентификатору("НаселенныеПункты", Адрес.ГородИдентификатор, "КодКЛАДР"));
			СтруктураЗапроса.customStreet.Вставить("street", Адрес.УлицаПредставление);
			
		КонецЕсли;
		
		СтруктураЗапроса.Вставить("house",     Адрес.Дом);
		СтруктураЗапроса.Вставить("building",  Адрес.Корпус);
		СтруктураЗапроса.Вставить("structure", Адрес.Строение);
		СтруктураЗапроса.Вставить("flat",      Адрес.Квартира);
		
	КонецЕсли;	
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеАдреса, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		
		Если СтруктураОтвета.Свойство("success") Тогда
			
			СтруктураДанных.Идентификатор = ПолучитьЗначениеПоля(СтруктураОтвета.success, "addressid");
			
		Иначе
			
			// <TODO Автор="Марусов" Дата="2017-07-27" Тип="Критичный">Отписать ответ в лог ошибок</TODO> 
			
		КонецЕсли; 
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(СтруктураДанных.Идентификатор) Тогда
		
		Если ЗначениеЗаполнено(Телефоны) Тогда
			
			СтруктураДанных.Вставить("Телефоны", СоздатьТелефоныАдреса(СтруктураДанных.Идентификатор, Телефоны));
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КонтактныеЛица) Тогда
			
			СтруктураДанных.Вставить("КонтактныеЛица", СоздатьКонтактныеЛицаАдреса(СтруктураДанных.Идентификатор, КонтактныеЛица));
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Функция СоздатьТелефоныАдреса(ИдентификаторАдреса, Телефоны)
	
	СписокТелефонов = Новый Массив;
	
	Для Каждого ТекТелефон Из Телефоны Цикл
		
		ОсновнойТелефон = ПолучитьТолькоЦифры(ТекТелефон.Основной);
		ДобавочныйНомер = ПолучитьТолькоЦифры(ТекТелефон.Добавочный);
		
		СтруктураЗапроса = СтруктураЗапросаПоСессии();
		СтруктураЗапроса.Вставить("addressid", 	 ИдентификаторАдреса);
		СтруктураЗапроса.Вставить("phonenumber", ОсновнойТелефон);
		СтруктураЗапроса.Вставить("addnumber",   ДобавочныйНомер);
		
		Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеТелефонаАдреса, СтруктураЗапроса);
		
		Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
			
			СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
			
			Если СтруктураОтвета.Свойство("success") Тогда
				
				СтруктураДанных = СтруктураКонтактнойИнформации(ИдентификаторАдреса, ПолучитьЗначениеПоля(СтруктураОтвета.success, "phoneid"), ТекТелефон.Представление);
				СписокТелефонов.Добавить(СтруктураДанных);
				
			Иначе
				
				СписокТелефонов.Добавить(СтруктураКонтактнойИнформации(ИдентификаторАдреса, "", ТекТелефон.Представление));
				
			КонецЕсли; 
			
		Иначе
			
			СписокТелефонов.Добавить(СтруктураКонтактнойИнформации(ИдентификаторАдреса, "", ТекТелефон.Представление));
			ОбработатьОшибкиЗапроса(Результат);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат СписокТелефонов;
	
КонецФункции

&НаКлиенте
Функция СоздатьКонтактныеЛицаАдреса(ИдентификаторАдреса, КонтактныеЛица)
	
	// <TODO Автор="Марусов" Дата="2017-07-27" Тип="Критичный">Запись об ошибке в журнал</TODO> 
	
	СписокКонтактныхЛиц = Новый Массив;
	
	Для Каждого ТекКонтакт Из КонтактныеЛица Цикл
		
		СтруктураЗапроса = СтруктураЗапросаПоСессии();
		СтруктураЗапроса.Вставить("addressid", ИдентификаторАдреса);
		СтруктураЗапроса.Вставить("contact",   ТекКонтакт.Представление);
		
		Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеКонтактногоЛица, СтруктураЗапроса);
		
		Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
			
			СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
			
			Если СтруктураОтвета.Свойство("success") Тогда
				
				СтруктураДанных = СтруктураКонтактнойИнформации(ИдентификаторАдреса, ПолучитьЗначениеПоля(СтруктураОтвета.success, "personid"), ТекКонтакт.Представление);
				СписокКонтактныхЛиц.Добавить(СтруктураДанных);
				
			Иначе
				
				СписокКонтактныхЛиц.Добавить(СтруктураКонтактнойИнформации(ИдентификаторАдреса, "", ТекКонтакт.Представление));
				
			КонецЕсли; 
			
		Иначе
			
			СписокКонтактныхЛиц.Добавить(СтруктураКонтактнойИнформации(ИдентификаторАдреса, "", ТекКонтакт.Представление));
			ОбработатьОшибкиЗапроса(Результат);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокКонтактныхЛиц;
	
КонецФункции

&НаКлиенте
Функция ПолучитьКонтактнуюИнформацию(Идентификатор)
	
	СтруктураДанных = Неопределено;
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("addressid", Идентификатор);
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.КонтактнаяИнформация, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Телефоны",       Новый Структура("Представление, Список", "", Новый Массив));
		СтруктураДанных.Вставить("КонтактныеЛица", Новый Структура("Представление, Список", "", Новый Массив));
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		СписокТелефонов = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "phones");
		СписокКонтактов = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "contacts");
		
		ЗаполнитьКонтактныеДанныеТелефоны(СписокТелефонов, СтруктураДанных.Телефоны);
		ЗаполнитьКонтактныеДанные(СписокКонтактов, СтруктураДанных.КонтактныеЛица, "contact");
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Функция ПолучитьАдресаКонтрагента(Идентификатор, ВключатьЮридическийАдрес = Ложь, Приемник = Неопределено)
	
	ПриемникМассив = Ложь;
	
	Если Приемник = Неопределено Тогда
		
		Приемник = Новый Массив;
		ПриемникМассив = Истина;
		
	КонецЕсли; 
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("counteragentid", Идентификатор);
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.АдресаКонтрагента, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		СписокЗаписей   = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "address");
		
		Для Каждого ТекущаяЗапись Из СписокЗаписей Цикл
			
			ТипАдреса = ПолучитьЗначениеПоля(ТекущаяЗапись, "type");
			
			Если Не ВключатьЮридическийАдрес И ТипАдреса = "juridical" Тогда
				
				Продолжить;
				
			КонецЕсли; 
			
			ЭтоТерминал           = ПолучитьЗначениеПоля(ТекущаяЗапись, "is_terminal", Ложь, "Булево");
			ТерминалИдентификатор = ПолучитьЗначениеПоля(ТекущаяЗапись, "terminal_id");
			
			Если ЭтоТерминал Тогда
				
				АдресПредставление = НайтиПоИдентификатору("Терминалы", ТерминалИдентификатор, "Адрес");
				
			Иначе
				
				АдресПредставление = ПолучитьЗначениеПоля(ТекущаяЗапись, "address");
			
			КонецЕсли; 
			
			СтруктураДанных                                       = Новый Структура;
			СтруктураДанных.Вставить("Тип",                         ТипАдреса);
			СтруктураДанных.Вставить("Идентификатор",               ПолучитьЗначениеПоля(ТекущаяЗапись, "id"));
			СтруктураДанных.Вставить("КонтрагентИдентификатор",     Идентификатор);
			СтруктураДанных.Вставить("Представление",               АдресПредставление);
			СтруктураДанных.Вставить("ГородИдентификатор",          ПолучитьЗначениеПоля(ТекущаяЗапись, "cityID"));
			СтруктураДанных.Вставить("УлицаИдентификатор",          ПолучитьЗначениеПоля(ТекущаяЗапись, "code"));
			СтруктураДанных.Вставить("УлицаПредставление",          ПолучитьЗначениеПоля(ТекущаяЗапись, "street"));
			СтруктураДанных.Вставить("Дом",                         ПолучитьЗначениеПоля(ТекущаяЗапись, "house"));
			СтруктураДанных.Вставить("Корпус",                      ПолучитьЗначениеПоля(ТекущаяЗапись, "building"));
			СтруктураДанных.Вставить("Строение",                    ПолучитьЗначениеПоля(ТекущаяЗапись, "structure"));
			СтруктураДанных.Вставить("Квартира",                    ПолучитьЗначениеПоля(ТекущаяЗапись, "flat"));
			СтруктураДанных.Вставить("ЭтоТерминал",                 ЭтоТерминал);
			СтруктураДанных.Вставить("ТерминалИдентификатор",       ТерминалИдентификатор);
			СтруктураДанных.Вставить("ТелефоныПредставление",       "");
			СтруктураДанных.Вставить("КонтактныеЛицаПредставление", "");
			СтруктураДанных.Вставить("Телефоны",                    Новый Массив);
			СтруктураДанных.Вставить("КонтактныеЛица",              Новый Массив);
			
			ЕстьТелефоны = ЗначениеЗаполнено(ПолучитьЗначениеПоля(ТекущаяЗапись, "phones"));
			ЕстьКонтакты = ЗначениеЗаполнено(ПолучитьЗначениеПоля(ТекущаяЗапись, "contacts"));
			
			Если ЕстьТелефоны ИЛИ ЕстьКонтакты Тогда
				
				СтруктураКонтактнаяИнформация = ПолучитьКонтактнуюИнформацию(СтруктураДанных.Идентификатор);
				
				Если СтруктураКонтактнаяИнформация = Неопределено Тогда
					
					ВывестиСообщениеПользователю("Не удалось получить контактную информацию (контактные лица, телефоны) для адреса " + СтруктураДанных.Представление);
					
				Иначе
					
					СтруктураДанных.КонтактныеЛицаПредставление = СтруктураКонтактнаяИнформация.КонтактныеЛица.Представление;
					СтруктураДанных.КонтактныеЛица              = СтруктураКонтактнаяИнформация.КонтактныеЛица.Список;
					
					СтруктураДанных.ТелефоныПредставление = СтруктураКонтактнаяИнформация.Телефоны.Представление;
					СтруктураДанных.Телефоны              = СтруктураКонтактнаяИнформация.Телефоны.Список;				
					
				КонецЕсли; 
				
			КонецЕсли; 
			
			Если ПриемникМассив Тогда
				
				Приемник.Добавить(СтруктураДанных);
				
			Иначе
				
				НоваяЗапись = Приемник.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураДанных, , "Телефоны, КонтактныеЛица");
				
				Для Каждого ТекКонтакт Из СтруктураДанных.Телефоны Цикл
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись.Телефоны.Добавить(), ТекКонтакт);
					
				КонецЦикла;
				
				Для Каждого ТекКонтакт Из СтруктураДанных.КонтактныеЛица Цикл
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись.КонтактныеЛица.Добавить(), ТекКонтакт);
					
				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Возврат Приемник;
	
КонецФункции

&НаКлиенте
Функция УдалитьКонтрагента(Идентификатор)
	
	Возврат УдалитьИнформациюАдреснойКниги(Идентификатор, "counteragents");
	
КонецФункции

&НаКлиенте
Функция УдалитьИнформациюАдреснойКниги(СписокИдентификаторов, ИмяСвойства)
	
	МетодВыполнен = Ложь;
	
	МетодВыполнен    = Ложь;
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	
	Если ТипЗнч(СписокИдентификаторов) = Тип("Массив") Тогда
		
		СтруктураЗапроса.Вставить(ИмяСвойства, Новый Структура("id", Новый Массив));
		
		Для Каждого ТекущийИдентификатор Из СписокИдентификаторов Цикл
			
			СтруктураЗапроса[ИмяСвойства].id.Добавить(ТекущийИдентификатор);
			
		КонецЦикла;
		
	Иначе
		
		СтруктураЗапроса.Вставить(ИмяСвойства, Новый Структура("id", СписокИдентификаторов));
		
	КонецЕсли; 
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.УдалениеИнформации, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		Контейнер       = ПолучитьЗначениеПоля(СтруктураОтвета, "deleted", Новый Структура);
		Объекты         = ПрочитатьЗначениеПоляКакМассив(Контейнер, ИмяСвойства);
		
		КонтрольныйИдентификатор = ?(ТипЗнч(СписокИдентификаторов) = Тип("Массив"), СписокИдентификаторов[0], СписокИдентификаторов);
		
		Если Объекты.Найти(КонтрольныйИдентификатор) <> Неопределено Тогда
			
			МетодВыполнен = Истина;
			
		КонецЕсли;
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Возврат МетодВыполнен;	
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьВесОбъемМультиотправки()
	
	Если Не МультиотправкаОбщиеПараметрыГруза Тогда
		
		МультиотправкаПараметрыГрузаОбщийВес   = МультиотправкаЗаказы.Итог("ОбщийВес");
		МультиотправкаПараметрыГрузаОбщийОбъем = МультиотправкаЗаказы.Итог("ОбщийОбъем");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТолькоПросмотрВесОбъемМультиотправки(Признак)
	
	Элементы.МультиотправкаПараметрыГрузаОбщийВес.ТолькоПросмотр   = Признак;
	Элементы.МультиотправкаПараметрыГрузаОбщийОбъем.ТолькоПросмотр = Признак;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНазначенияАдреса(Значение, Панель)
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		
		Значение = "Терминал";
		
	КонецЕсли; 
	
	Панель.ТекущаяСтраница = Панель.ПодчиненныеЭлементы[Панель.Имя + Значение];
	
КонецПроцедуры

