&НаКлиенте
Процедура МультиотправкаЗаказыДоТерминалаПриИзменении(Элемент)
	
	ДанныеСтроки = Элементы.МультиотправкаЗаказы.ТекущиеДанные;
	
	Если ДанныеСтроки <> Неопределено Тогда
		
		ДанныеСтроки.Дом                          = "";
		ДанныеСтроки.Корпус                       = "";
		ДанныеСтроки.Строение                     = "";
		ДанныеСтроки.Квартира                     = "";
		ДанныеСтроки.УлицаИдентификатор           = "";
		ДанныеСтроки.УлицаПредставление           = "";
		ДанныеСтроки.ТерминалИдентификатор        = "";
		ДанныеСтроки.ТерминалПредставление        = "";
		ДанныеСтроки.ПараметрыОплатыПредставление = "";
		
		ДанныеСтроки.ПараметрыОплатыСписок.Очистить();
	//	МультиотправкаПриИзмененииОплатыОтТретьегоЛица();		
		
		Если ДанныеСтроки.ДоТерминала Тогда
			
			УдалитьСтрокиТаблицы(ДанныеСтроки.ДополнительныеУслугиСписок, Новый Структура("Справочник", "УслугиПРР")); 
			УдалитьСтрокиТаблицы(ДанныеСтроки.ДополнительныеУслугиСписок, Новый Структура("Справочник", "ТребованияКТС"));
						
			ДанныеСтроки.ДополнительныеУслугиПредставление = МультиотправкаСформироватьПредставлениеДополнительныхУслуг(ДанныеСтроки);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаЗаказыТерминалПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные        = Элементы.МультиотправкаЗаказы.ТекущиеДанные;
	ДанныеВыбора         = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ГородИдентификатор) Тогда
		
		СписокТерминалов     = ДоступныеТерминалы(ТекущиеДанные.ГородИдентификатор, "Получатель");
		
		Если ЗначениеЗаполнено(СписокТерминалов) Тогда
			
			Для каждого ТекТерминал Из СписокТерминалов Цикл
			
				ДанныеВыбора.Добавить(ТекТерминал.Идентификатор, ТекТерминал.Адрес);
			
			КонецЦикла; 
		
		КонецЕсли; 
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаЗаказыТерминалПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.МультиотправкаЗаказы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		ТекущиеДанные.ТерминалИдентификатор = ВыбранноеЗначение;
		ВыбранноеЗначение = НайтиПоИдентификатору("Терминалы", ВыбранноеЗначение, "Адрес");
		
	Иначе
		
		ТекущиеДанные.ТерминалИдентификатор = "";
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаЗаказыТерминалПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.МультиотправкаЗаказы.ТекущиеДанные.ТерминалИдентификатор = "";
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаПараметрыПеревозкиДатаВремяПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	Если НЕ ЗначениеЗаполнено(МультиОтправкаПараметрыПеревозкиДатаВремя) Тогда
		
		МультиОтправкаПараметрыПеревозкиДатаВремя = Новый Структура;
		МультиОтправкаПараметрыПеревозкиДатаВремя.Вставить("Дата",                 '00010101');
		МультиОтправкаПараметрыПеревозкиДатаВремя.Вставить("РежимРаботыНачало",    '00010101');
		МультиОтправкаПараметрыПеревозкиДатаВремя.Вставить("РежимРаботыОкончание", '00010101');
		МультиОтправкаПараметрыПеревозкиДатаВремя.Вставить("ПерерывНачало",        '00010101');
		МультиОтправкаПараметрыПеревозкиДатаВремя.Вставить("ПерерывОкончание",     '00010101');
		
	КонецЕсли; 
	
	ОткрытьСтраницуДополнительнойПанели("ДатаИВремя", Элемент, МультиОтправкаПараметрыПеревозкиДатаВремя);

КонецПроцедуры

