&НаКлиенте
Функция ПолучитьПредставлениеГабаритовТС(Данные)
	
	ШаблонПредставления = "%1x%2x%3 | %4 | %5";
	ФорматЗначений      = "ЧРД=.; ЧН=-; ЧГ=";
	
	ЗначениеДлины  = Формат(Данные.Длина,  ФорматЗначений);
	ЗначениеШирины = Формат(Данные.Ширина, ФорматЗначений);
	ЗначениеВысоты = Формат(Данные.Высота, ФорматЗначений);
	ЗначениеОбъема = Формат(Данные.Объем,  ФорматЗначений);
	ЗначениеГрузоподъемности = Формат(Окр(Данные.Грузоподъемность / 1000, 3), ФорматЗначений);
	
	Возврат СтрШаблон(ШаблонПредставления, ЗначениеДлины, ЗначениеШирины, ЗначениеВысоты, ЗначениеГрузоподъемности, ЗначениеОбъема);
	
КонецФункции

&НаКлиенте
Функция ПолучитьПредставлениеУслугПочасовойАренды(Данные)
	
	Представление = "";
	
	Если Данные.ДоступенМанипулятор Тогда
		
		Представление = Символы.ПС + "Манипулятор - " + Формат(Данные.СтоимостьМанипулятор, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=");
		
	КонецЕсли; 
	
	Если Данные.ДоступнаРастентовка Тогда
		
		Представление = Символы.ПС + "Растентовка - " + Формат(Данные.СтоимостьРастентовка, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧН=");
		
	КонецЕсли;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

&НаКлиенте
Функция ПолучитьПредставлениеПараметровГруза(СтруктураДанных, ВключатьХарактер = Истина, ВключатьГабариты = Ложь)
	
	Если СтруктураДанных.Свойство("ГрузДанныеДоступны") И СтруктураДанных.ГрузДанныеДоступны = Ложь Тогда
		
		Представление = "";
		
	Иначе
		
		Представление = "";
		
		Если ЗначениеЗаполнено(СтруктураДанных.ГрузВес) Тогда
			
			Представление = Строка(СтруктураДанных.ГрузВес) + " кг";
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ГрузОбъем) Тогда
			
			Представление = Представление + Символы.ПС + Строка(СтруктураДанных.ГрузОбъем) + " м3";
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ГрузКоличествоМест) Тогда
			
			Представление = Представление + Символы.ПС + КоличествоМестПрописью(СтруктураДанных.ГрузКоличествоМест);
			
		КонецЕсли;
		
		Если ВключатьХарактер И ЗначениеЗаполнено(СтруктураДанных.ГрузХарактер) Тогда
			
			Представление = Представление + Символы.ПС + СтруктураДанных.ГрузХарактер;
			
		КонецЕсли;
		
		Если ВключатьГабариты И СтруктураДанных.ГрузДлина + СтруктураДанных.ГрузШирина + СтруктураДанных.ГрузВысота <> 0 Тогда
			
			Представление = Представление + Символы.ПС + СтруктураДанных.ГрузДлина + " x " + СтруктураДанных.ГрузШирина  + " x " + СтруктураДанных.ГрузВысота;
			
		КонецЕсли; 
		
		Представление = СтрЗаменить(СокрЛП(Представление), Символы.ПС, " | ");
		
	КонецЕсли; 
	
	Возврат Представление;
	
КонецФункции

&НаКлиенте
Функция ПредставлениеРаздельнойОплаты(Таблица)
	
	МассивПлательщиков = Новый Массив;
	
	Для Каждого ТекЗапись Из Таблица Цикл
		
		ПредставлениеПлательщика = НайтиПоИдентификатору("ВидыПлательщиков", ТекЗапись.ПлательщикИдентификатор, "Наименование");
		
		Если МассивПлательщиков.Найти(ПредставлениеПлательщика) = Неопределено Тогда
			
			МассивПлательщиков.Добавить(ПредставлениеПлательщика);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивПлательщиков, " + ");
	
КонецФункции

&НаКлиенте
Функция ПредставлениеСтруктурыВремени(Источник)
	
	Представление = "";
	
	Если Источник.Свойство("Дата") Тогда
		
		Представление = Формат(Источник.Дата, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.РежимРаботыНачало) ИЛИ ЗначениеЗаполнено(Источник.РежимРаботыОкончание) Тогда
		
		ПредставлениеНачало = Формат(Источник.РежимРаботыНачало,    "ДФ=ЧЧ:мм; ДП=?");
		ПредставлениеКонец  = Формат(Источник.РежимРаботыОкончание, "ДФ=ЧЧ:мм; ДП=?");
		
		Представление = Представление + " [" + ПредставлениеНачало + " - " + ПредставлениеКонец + "]";
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.ПерерывНачало) ИЛИ ЗначениеЗаполнено(Источник.ПерерывОкончание) Тогда
		
		ПредставлениеНачало = Формат(Источник.ПерерывНачало,    "ДФ=ЧЧ:мм; ДП=?");
		ПредставлениеКонец  = Формат(Источник.ПерерывОкончание, "ДФ=ЧЧ:мм; ДП=?");
		
		Представление = Представление + " [Перерыв: " + ПредставлениеНачало + " - " + ПредставлениеКонец + "]";
		
	КонецЕсли;
	
	Если Источник.Свойство("ФиксированноеВремя") И Источник.ФиксированноеВремя Тогда
		
		Представление = Представление + " [фикс]";
		
	КонецЕсли;
	
	Возврат СокрЛП(Представление);
	
КонецФункции

&НаКлиенте
Функция ПредставлениеДополнительныхПараметровПеревозки(СтруктураДанных)
	
	Представление = "";
	
	Если СтруктураДанных.Свойство("ДополнительныеПараметрыПропускДляВъезда") И СтруктураДанных.ДополнительныеПараметрыПропускДляВъезда = Истина Тогда
		
		Представление = Представление + ", " + "Пропуск для въезда";
		
		Если СтруктураДанных.Свойство("ДополнительныеПараметрыСрокЗаказаПропуска") И ЗначениеЗаполнено(СтруктураДанных.ДополнительныеПараметрыСрокЗаказаПропуска) Тогда
			
			Представление = Представление + " [" + СтруктураДанных.ДополнительныеПараметрыСрокЗаказаПропуска + "]";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ДополнительныеПараметрыЗаписьНаОтгурзку") И СтруктураДанных.ДополнительныеПараметрыЗаписьНаОтгурзку = Истина Тогда
		
		Представление = Представление + ", " + "Запись на отгрузку";
		
	КонецЕсли; 
	
	Если СтруктураДанных.Свойство("ДополнительныеПараметрыПлатныйВъезд") И СтруктураДанных.ДополнительныеПараметрыПлатныйВъезд = Истина Тогда
		
		Представление = Представление + ", " + "Платный въезд";
		
		Если СтруктураДанных.Свойство("ДополнительныеПараметрыСуммаВъезда") И ЗначениеЗаполнено(СтруктураДанных.ДополнительныеПараметрыСуммаВъезда) Тогда
			
			Представление = Представление + " [ Сумма: " + СтруктураДанных.ДополнительныеПараметрыСуммаВъезда + "]";
			
		КонецЕсли;
		
		Если СтруктураДанных.Свойство("ДополнительныеПараметрыСпособВозмещения") И ЗначениеЗаполнено(СтруктураДанных.ДополнительныеПараметрыСпособВозмещения) Тогда
			
			Представление = Представление + " [ Возмещение: " + СтруктураДанных.ДополнительныеПараметрыСпособВозмещения + "]";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ДополнительныеПараметрыТребуетсяНомерОтгрузки") И СтруктураДанных.ДополнительныеПараметрыТребуетсяНомерОтгрузки = Истина Тогда
		
		Представление = Представление + ", " + "Номер отгрузки";
		
		Если СтруктураДанных.Свойство("ДополнительныеПараметрыНомерОтгрузки") И ЗначениеЗаполнено(СтруктураДанных.ДополнительныеПараметрыНомерОтгрузки) Тогда
			
			Представление = Представление + " [" + СтруктураДанных.ДополнительныеПараметрыНомерОтгрузки + "]";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Сред(Представление, 3);
	
КонецФункции

