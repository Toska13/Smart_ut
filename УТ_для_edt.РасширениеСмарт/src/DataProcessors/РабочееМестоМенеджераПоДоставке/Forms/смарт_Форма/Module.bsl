#Область ФункцииПризнаки  
&НаКлиенте
Функция ЭтоНегабаритныйГруз(Источник, Префикс = "")
	
	МаксимальныйРазмерГабарита = 3;   // Максимальный размер любого из габаритов не должен превышать 3-х метров
	МаксимальныйВесГрузоместа  = 100; // Максимальный вес грузоместа не должен превышать 100 кг
	
	Результат = ЗначениеГабаритаБазовое(Источник, Префикс + "МаксимальнаяДлина") >= МаксимальныйРазмерГабарита
	ИЛИ ЗначениеГабаритаБазовое(Источник, Префикс + "МаксимальнаяШирина") >= МаксимальныйРазмерГабарита
	ИЛИ ЗначениеГабаритаБазовое(Источник, Префикс + "МаксимальнаяВысота") >= МаксимальныйРазмерГабарита
	ИЛИ Источник[Префикс + "МаксимальныйВес"] >= МаксимальныйВесГрузоместа;
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Функция РазрешенаРаздельнаяОплатаДляВидаПеревозки(ВидПеревозки)
	
	Если РазделениеОплатыРазрешенныеВидыПеревозки = Неопределено Тогда
		
		РазделениеОплатыРазрешенныеВидыПеревозки = Новый Массив;
		РазделениеОплатыРазрешенныеВидыПеревозки.Добавить("1"); // Авто
		РазделениеОплатыРазрешенныеВидыПеревозки.Добавить("4"); // Экспресс
		
	КонецЕсли;
	
	Возврат РазделениеОплатыРазрешенныеВидыПеревозки.Найти(ВидПеревозки) <> Неопределено;
	
КонецФункции
