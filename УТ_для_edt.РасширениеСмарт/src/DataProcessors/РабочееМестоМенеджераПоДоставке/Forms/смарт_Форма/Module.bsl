                    Поиск = Новый Структура("Идентификатор", ТекущийИдентификаторКонтрагента);
                    Строки = АдреснаяКнига.НайтиСтроки(Поиск);
                    Если Строки.Количество() > 0 Тогда
                        ЗаполнитьЗначенияСвойств(Строки[0], ДанныеКонтрагента);
                    КонецЕсли;
                КонецЕсли;			
                
            КонецЕсли;		
            
            //-- смарт:Подкин # 16.06.2022 11:13:54
        КонецЕсли;    
        
    КонецЦикла;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруРеквизитовКонтрагента(Распоряжение)
    
    Если ЗначениеЗаполнено(Распоряжение.Контрагент) Тогда 
        КарточкаКонтрагентаФормаИдентификатор=""; 
        КарточкаКонтрагентаСтранаИдентификатор="";
        КарточкаКонтрагентаНаименование=""; 
        КарточкаКонтрагентаИНН="";     
        КарточкаКонтрагентаПравоваяФормаИдентификатор="";
        КарточкаКонтрагентаПравоваяФормаПредставление="";
        КарточкаКонтрагентаЮридическийАдресГородИдентификатор="";
        КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор="";
        КарточкаКонтрагентаЮридическийАдресДом="";
        
        Если ЗначениеЗаполнено(Распоряжение.Контрагент.ЮрФизЛицо) Тогда
            Если НЕ Распоряжение.Контрагент.ЮрФизЛицо=Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
                КарточкаКонтрагентаФормаИдентификатор="juridical";
            Иначе
                КарточкаКонтрагентаФормаИдентификатор="private";
            КонецЕсли;
        КонецЕсли; 
        КарточкаКонтрагентаСтранаИдентификатор="0x8f51001438c4d49511dbd774581edb7a";  //Распоряжение.Контрагент.СтранаРегистрации
        КарточкаКонтрагентаНаименование=Распоряжение.Контрагент.Наименование;
        КарточкаКонтрагентаИНН=Распоряжение.Контрагент.ИНН;    
        Если СтрДлина(КарточкаКонтрагентаИНН)=12 Тогда
            КарточкаКонтрагентаПравоваяФормаИдентификатор="0xaa9042fea4fa169d4d021c6941f2090f";
            КарточкаКонтрагентаПравоваяФормаПредставление="ИП";
        иначе
            КарточкаКонтрагентаПравоваяФормаИдентификатор="0x92ee03691f25a9fe4be9910cd87ca9ca";
            КарточкаКонтрагентаПравоваяФормаПредставление="ООО";
        КонецЕсли;
        КонтИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Распоряжение.Контрагент,Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,ТекущаяДата(),Ложь);
        СтруктураАдреса = УправлениеКонтактнойИнформациейСлужебный.СтрокуJSONВСтруктуру(КонтИнформация[0].Значение);    
        
        Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураАдреса,"city") Тогда 
            КарточкаКонтрагентаЮридическийАдресГородИдентификатор=СтруктураАдреса.city;    
        ИначеЕсли  ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураАдреса,"area") Тогда
            КарточкаКонтрагентаЮридическийАдресГородИдентификатор=СтруктураАдреса.area;
        Иначе
            Возврат Неопределено;
        КонецЕсли;
        
        Если СтруктураАдреса.Свойство("street") И ЗначениеЗаполнено(СтруктураАдреса.street) Тогда
            КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор=СтруктураАдреса.street;
        КонецЕсли;    
        Если СтруктураАдреса.Свойство("houseNumber") И ЗначениеЗаполнено(СтруктураАдреса.houseNumber) Тогда
            КарточкаКонтрагентаЮридическийАдресДом=СтруктураАдреса.houseNumber;
        КонецЕсли;
    КонецЕсли; 
    
    Результат=Новый Структура("КарточкаКонтрагентаФормаИдентификатор,КарточкаКонтрагентаСтранаИдентификатор,
    |КарточкаКонтрагентаНаименование,КарточкаКонтрагентаИНН,КарточкаКонтрагентаПравоваяФормаПредставление,КарточкаКонтрагентаПравоваяФормаИдентификатор,
    |КарточкаКонтрагентаЮридическийАдресГородИдентификатор,КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор,КарточкаКонтрагентаЮридическийАдресДом"); 
    Результат.КарточкаКонтрагентаФормаИдентификатор=КарточкаКонтрагентаФормаИдентификатор; 
    Результат.КарточкаКонтрагентаСтранаИдентификатор=КарточкаКонтрагентаСтранаИдентификатор;
    Результат.КарточкаКонтрагентаНаименование=КарточкаКонтрагентаНаименование; 
    Результат.КарточкаКонтрагентаИНН=КарточкаКонтрагентаИНН; 
    Результат.КарточкаКонтрагентаПравоваяФормаПредставление=КарточкаКонтрагентаПравоваяФормаПредставление; 
    Результат.КарточкаКонтрагентаПравоваяФормаИдентификатор=КарточкаКонтрагентаПравоваяФормаИдентификатор;
    Результат.КарточкаКонтрагентаЮридическийАдресГородИдентификатор=КарточкаКонтрагентаЮридическийАдресГородИдентификатор;
    Результат.КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор=КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор;
    Результат.КарточкаКонтрагентаЮридическийАдресДом=КарточкаКонтрагентаЮридическийАдресДом;        
    
    Возврат Результат; 
    
КонецФункции

