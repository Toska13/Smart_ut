Функция СкопироватьФайлПоСсылке(Ссылка, ИмяФайла = "")
	
	СтруктураАдреса = СтруктураИнтернетАдреса(Ссылка);
	Путь            = "";
	
	Попытка
		
        //Если ПараметрыПодключения.СоединениеНаСервере Тогда
        //	
        //	Результат = ВыполнитьGetЗапросНаСервере(СтруктураАдреса.Хост, СтруктураАдреса.Порт, СтруктураАдреса.АдресРесурса, ПараметрыПодключения.ПроксиСервер);
        //	Путь      = ?(ЗначениеЗаполнено(ИмяФайла), ИмяФайла, ПолучитьИмяВременногоФайла());
        //	
        //	ПолучитьФайл(Результат.Тело, Путь, Ложь);
        //	
        //Иначе
			
			Результат = ВыполнитьGetЗапросНаКлиенте(СтруктураАдреса.Хост, СтруктураАдреса.Порт, СтруктураАдреса.АдресРесурса, "", ИмяФайла);
			Путь      = Результат.Тело;
			
        //КонецЕсли;
		
	Исключение
		
		ТекстСообщения = "Не удалось скопировать файл по ссылке: """ + Ссылка + """";
		ВывестиСообщениеПользователю(ТекстСообщения);
		ДобавитьСообщениеВЖурнал(ТекстСообщения + " по причине: " + ОписаниеОшибки());
		Путь = "";
		
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Путь) И Результат.КодСтатуса <> УспешныйКодСтатуса() Тогда
		
		ТекстСообщения = "Не удалось скопировать файл по ссылке: """ + Ссылка + """ Код статуса: " + Результат.КодСтатуса;
