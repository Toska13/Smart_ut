&НаКлиенте
Функция ЗначениеРеквизитаФормы(Реквизит, ЗначениеПоУмолчанию = Неопределено)
	
	Если ТипЗнч(Реквизит) = Тип("Строка") Тогда
		
		ИмяРеквизита = Реквизит;
		Источник     = ЭтаФорма;
		
	ИначеЕсли Реквизит.Свойство("ИмяЭлементаРодителя") И ЗначениеЗаполнено(Реквизит.ИмяЭлементаРодителя) Тогда 
		
		// считаем что нам передали схему данных, в случае подчиненного элемента (например, элемент ячейки таблицы формы)
		
		ЭлементРодитель = Элементы[Реквизит.ИмяЭлементаРодителя];
		Источник        = ЭлементРодитель.ТекущиеДанные;
		ИмяРеквизита    = Реквизит.Значение;
		
	Иначе
		
		Источник     = ЭтаФорма;
		ИмяРеквизита = Реквизит.Значение;
		
	КонецЕсли;
	
	СтруктураРеквизита = Новый Структура(ИмяРеквизита, ЗначениеПоУмолчанию);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизита, Источник);
	
	Возврат СтруктураРеквизита[ИмяРеквизита];	
	
КонецФункции
  
&НаКлиенте
Функция ПолучитьКэшДанныхИсточника(Источник)
	
	Если Не КэшДанных.Свойство(Источник) Тогда
		
		// Данные требуемого источника еще не запрашивались.
		// Создадим для источника структуру описывающую его данные:
		// ключ "Параметры" - будет содержать различные данные для работы кэша (например, список реквизитов справочника)
		// ключ "Данные" - будет содержать соответствие идентификатора справочника и его данных
		
		ОписаниеСправочника = КоллекцияМетаданные.Справочники[Источник];
		ПараметрыКэша       = Новый Структура;
		
		ПараметрыКэша.Вставить("КэшироватьДанные", ТребуетсяКэшированиеДанныхСправочника(ОписаниеСправочника));
		ПараметрыКэша.Вставить("Поля",             ПолучитьСписокРеквизитовСправочника(ОписаниеСправочника));
		
		// Если для справочника требуется кэширование - создаем новое соответствие для хранения кэша
		// Если не требуется - значит справочник хранится на клиенте и мы просто используем ссылку на
		// соответствующее соответствие в ХранилищеДанныеКлиент (хранилище таблиц справочников на клиенте)
		
		ДанныеКэша = ?(ПараметрыКэша.КэшироватьДанные, Новый Соответствие, ХранилищеДанныхКлиент[Источник].Таблица);   
		
		СтруктураКэша = Новый Структура;
		СтруктураКэша.Вставить("Параметры", ПараметрыКэша);
		СтруктураКэша.Вставить("Данные",    ДанныеКэша);
		
		КэшДанных.Вставить(Источник, СтруктураКэша); // Добавляем описание структуры кэша источника в общую коллекцию
		
	КонецЕсли; 
	
	Возврат КэшДанных[Источник];
	
КонецФункции

