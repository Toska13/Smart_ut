&НаКлиенте
Процедура ИнициализироватьТерминалыГорода(ГородИдентификатор, РеквизитТерминалИдентификатор, ТерминалЭлемент, РеквизитТерминалИнформация = Неопределено, Фильтр = Неопределено, ТолькоПолучениеСписка = Ложь)
	
	ТерминалЭлемент.СписокВыбора.Очистить();
	ЗначТерминалИдентификатор = "";
	ЗначТерминалИнформация    = "";
	
	Если ЗначениеЗаполнено(ГородИдентификатор) Тогда
		
		Если ТипЗнч(Фильтр) = Тип("Структура") Тогда
			
			ИспользоватьТерминалыОтправления = Фильтр.Свойство("ВозможнаОтправкаГруза") И Фильтр.ВозможнаОтправкаГруза   = Истина;
			ИспользоватьТерминалыПолучения   = Фильтр.Свойство("ВозможноПолучениеГруза") И Фильтр.ВозможноПолучениеГруза = Истина;
			
			Если ИспользоватьТерминалыОтправления И ИспользоватьТерминалыПолучения Тогда
				
				ВыбранноеНаправление = "";
				
			ИначеЕсли ИспользоватьТерминалыОтправления Тогда
				
				ВыбранноеНаправление = "Отправитель";
				
			ИначеЕсли ИспользоватьТерминалыПолучения Тогда
				
				ВыбранноеНаправление = "Получатель";
				
			КонецЕсли;
			
		Иначе
			
			ВыбранноеНаправление = "";
			
		КонецЕсли; 
		
		СписокТерминалов = ДоступныеТерминалы(ГородИдентификатор, ВыбранноеНаправление);
		
		Если ЗначениеЗаполнено(СписокТерминалов) Тогда
			
			Для Каждого ТекТерминал Из СписокТерминалов Цикл
				
				ТерминалЭлемент.СписокВыбора.Добавить(ТекТерминал.Идентификатор, ТекТерминал.Адрес);				
				
			КонецЦикла;
			
			ВыбТерминал               = СписокТерминалов[0];
			ЗначТерминалИдентификатор = ВыбТерминал.Идентификатор;
			ЗначТерминалИнформация    = НайтиПоИдентификатору("Терминалы", ЗначТерминалИдентификатор, "Информация"); 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если НЕ ТолькоПолучениеСписка Тогда
		
		Если ЗначениеЗаполнено(РеквизитТерминалИдентификатор) Тогда
			
			УстановитьЗначениеРеквизитаФормы(РеквизитТерминалИдентификатор, ЗначТерминалИдентификатор);
			
		КонецЕсли;
		
        Если ЗначениеЗаполнено(РеквизитТерминалИнформация) Тогда
            
            УстановитьЗначениеРеквизитаФормы(РеквизитТерминалИнформация, ЗначТерминалИнформация);
            //++ смарт:Подкин # 16.06.2022 12:16:04
            Если РеквизитТерминалИнформация="МультиотправкаОтправительИнформацияТерминала" Тогда
                Элементы.МультиотправкаОтправительИнформацияТерминала.Заголовок = ЗначТерминалИнформация;
            КонецЕсли;
            //-- смарт:Подкин # 16.06.2022 12:16:04	
        КонецЕсли; 
        
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция ДоступныеТерминалы(ИдентификаторГорода, Направление = "", ТолькоОсновной = Ложь)
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("cityid", ИдентификаторГорода);
	СписокТерминалов = Новый Массив;
	ДанныеОсновногоТерминала = Неопределено;
	
	Если ЗначениеЗаполнено(Направление) Тогда
		
		СтруктураЗапроса.Вставить("direction", ?(Направление = "Отправитель", "derival", "arrival"));
		
	КонецЕсли;
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.ДоступныеТерминалы, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		
		Если СтруктураОтвета.Свойство("terminals") Тогда
			
			Список = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "terminals");
			
			Для Каждого ТекущийТерминал Из Список Цикл
				
				ЭтоОсновнойТерминал = ПолучитьЗначениеПоля(ТекущийТерминал, "default", Ложь, "Булево");
				
				ТекущаяСтруктураТерминала = Новый Структура;
				ТекущаяСтруктураТерминала.Вставить("Идентификатор", ПолучитьЗначениеПоля(ТекущийТерминал, "id"));
				ТекущаяСтруктураТерминала.Вставить("Наименование",  ПолучитьЗначениеПоля(ТекущийТерминал, "name"));
				ТекущаяСтруктураТерминала.Вставить("Адрес",         ПолучитьЗначениеПоля(ТекущийТерминал, "address"));
				ТекущаяСтруктураТерминала.Вставить("Основной",      ЭтоОсновнойТерминал);
				ТекущаяСтруктураТерминала.Вставить("Экспресс",      ПолучитьЗначениеПоля(ТекущийТерминал, "express", Ложь, "Булево"));
				
				СписокТерминалов.Добавить(ТекущаяСтруктураТерминала);
				
				Если ЭтоОсновнойТерминал И НРег(ИдентификаторГорода) = НРег(ТекущаяСтруктураТерминала.Идентификатор) Тогда
					
					ДанныеОсновногоТерминала = ТекущаяСтруктураТерминала;					
				
				КонецЕсли; 
				
			КонецЦикла;
			
		Иначе
			
			ВывестиСообщениеПользователю("Не удалось получить список доступных терминалов");
			ВывестиСообщениеПользователю(Результат.Данные);
			
		КонецЕсли;
		
	Иначе
		
		ВывестиСообщениеПользователю("Не удалось загрузить справочник терминалов");
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Если СписокТерминалов.Количество() И ТолькоОсновной Тогда
		
		СписокТерминалов = ДанныеОсновногоТерминала;
		
	КонецЕсли;
	
	Возврат СписокТерминалов;	
	
КонецФункции

&НаКлиенте
Функция ДоступныеУпаковки(ОтравительИдентификатор, ПолучательИдентификатор, Длина, Ширина, Высота, Вес, КоличествоМест = 1)
	
	СтруктураЗапроса = СтруктураЗапросаПоСессии();
	СтруктураЗапроса.Вставить("derivalPoint", НайтиПоИдентификатору("НаселенныеПункты", ОтравительИдентификатор, "КодКЛАДР"));
	СтруктураЗапроса.Вставить("arrivalpoint", НайтиПоИдентификатору("НаселенныеПункты", ПолучательИдентификатор, "КодКЛАДР"));
	СтруктураЗапроса.Вставить("length", Формат(Окр(Длина, 2), "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="));
	СтруктураЗапроса.Вставить("width", Формат(Окр(Ширина, 2), "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="));
	СтруктураЗапроса.Вставить("height", Формат(Окр(Высота, 2), "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="));
	СтруктураЗапроса.Вставить("weight", Формат(Окр(Вес, 2), "ЧДЦ=2; ЧРД=.; ЧН=; ЧГ="));
	СтруктураЗапроса.Вставить("quantity", Формат(КоличествоМест, "ЧН=; ЧГ="));
	
	Результат      = ВыполнитьЗапросДанных(КоллекцияМетодов.ДоступныеУпаковки, СтруктураЗапроса);
	СписокУпаковок = Неопределено;
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		
		Если СтруктураОтвета.Свойство("packages") Тогда
			
			Список = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "packages");
			СписокУпаковок = Новый Массив;
			
			Для Каждого ДанныеСтроки Из Список Цикл
				
				ТекущаяУпаковка = Новый Структура;
				ТекущаяУпаковка.Вставить("Идентификатор", ПолучитьЗначениеПоля(ДанныеСтроки, "uid"));
				ТекущаяУпаковка.Вставить("Несовместимые", ПрочитатьЗначениеПоляКакМассив(ДанныеСтроки, "incompatible_uids"));
				
				СписокУпаковок.Добавить(ТекущаяУпаковка);
				
			КонецЦикла;
			
		Иначе
			
			ВывестиСообщениеПользователю("Не удалось получить список доступных упаковок");
			ВывестиСообщениеПользователю(Результат.Данные);
			
		КонецЕсли;
		
	Иначе
		
		ВывестиСообщениеПользователю("Не удалось получить список доступных упаковок");
		ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли;
	
	Возврат СписокУпаковок;
	
КонецФункции

&НаКлиенте
Функция ОткрытьСтраницуДополнительнойПанели(ИмяСтраницы, Элемент = Неопределено, ПараметрыСтраницы = Неопределено, ОбработчикВыбора = Неопределено)
	
	
	ЭлементПанель   = Элементы.ДополнительнаяПанельСтраницы;
	ТекущаяСтраница = ЭлементПанель.ТекущаяСтраница;
	ОткрытьСтраницу = Истина;
	                                            
	Если ЭлементПанель.Видимость Тогда
		
		ИмяТекущейСтраницы = ТекущаяСтраница.Имя;
		
		Если ЗначениеЗаполнено(МодифицированностьДанныхДополнительнойПанели) И МодифицированностьДанныхДополнительнойПанели.Свойство(ИмяТекущейСтраницы) Тогда
			
			Результат = МодифицированностьДанныхДополнительнойПанели[ИмяТекущейСтраницы];
			
			Если Результат Тогда
				
				ОткрытьСтраницу      = Ложь;
				ДополнительныеДанные = Новый Структура("ИмяСтраницы, Элемент, ПараметрыСтраницы, ИмяТекущейСтраницы, ОбработчикВыбора", ИмяСтраницы, Элемент, ПараметрыСтраницы, ИмяТекущейСтраницы, ОбработчикВыбора);
				Оповещение           = Новый ОписаниеОповещения("ВопросЗакрытьСтраницуЗавершение", ЭтаФорма, ДополнительныеДанные);
				
				ПоказатьВопрос(Оповещение, "Закрыть текущую страницу """ + ТекущаяСтраница.Заголовок + """ без сохранения?", РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Нет); 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ОткрытьСтраницу Тогда
		
		ОткрытьСтраницуДополнительнойПанелиЗавершение(ИмяСтраницы, Элемент, ПараметрыСтраницы, ОбработчикВыбора);		
		
	КонецЕсли; 
	
	Возврат ОткрытьСтраницу;
	
КонецФункции

&НаКлиенте
Процедура ВопросЗакрытьСтраницуЗавершение(РезультатВопроса, ДополнительныеДанные) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		УстановитьМодифицированностьСтраницы(ДополнительныеДанные.ИмяТекущейСтраницы, Ложь);
		ПередЗакрытиемСтраницыДополнительнойПанели(ДополнительныеДанные.ИмяТекущейСтраницы);
		
		ОткрытьСтраницуДополнительнойПанелиЗавершение(ДополнительныеДанные.ИмяСтраницы, ДополнительныеДанные.Элемент, ДополнительныеДанные.ПараметрыСтраницы, ДополнительныеДанные.ОбработчикВыбора);		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуДополнительнойПанелиЗавершение(ИмяСтраницы, Элемент, ПараметрыСтраницы, ОбработчикВыбора)
	
	ЭлементПанель   = Элементы.ДополнительнаяПанельСтраницы;
	ПередОткрытиемСтраницыДополнительнойПанели(ИмяСтраницы, Элемент, ПараметрыСтраницы, ОбработчикВыбора);
	ЭлементПанель.ТекущаяСтраница = ЭлементПанель.ПодчиненныеЭлементы[ИмяСтраницы];
	
	Если НЕ ЭлементПанель.Видимость Тогда
		
		ЭлементПанель.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМодифицированностьСтраницы(ИмяСтраницы, Признак = Истина)
	
	Если МодифицированностьДанныхДополнительнойПанели = Неопределено Тогда
		
		МодифицированностьДанныхДополнительнойПанели = Новый Структура;
		
	КонецЕсли;
	
	МодифицированностьДанныхДополнительнойПанели.Вставить(ИмяСтраницы, Признак);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемСтраницыДополнительнойПанели(ИмяСтраницы, Принудительно = Ложь)
	
	Если ИмяСтраницы = "АдреснаяКнигаСписокВыбора" Тогда
		
		ПараметрыСтраницы = ПараметрыДополнительнойПанели[ИмяСтраницы];
		СхемаДанных =  СхемаСвязейДанных[ПараметрыСтраницы.Элемент.Имя];
		УстановитьДоступностьПараметровКонтрагента(СхемаДанных);
		
	ИначеЕсли ИмяСтраницы = "ТребованияКТС" Тогда
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "УправлениеПРР" Тогда 
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "УслугиНаТерминале" Тогда 
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		УстановитьБлокировкуЭлементовФормы(Элемент, Истина);
		
	ИначеЕсли ИмяСтраницы = "ДополнительныеПараметрыПеревозки" Тогда
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "ДатаИВремя" Тогда 
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "ПараметрыПочасовойАрендыСписок" Тогда 
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "МультиотправкаДополнительныеУслуги" Тогда 
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "МультиотправкаГабариты" Тогда
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		Элемент.Доступность = Истина;
		
	ИначеЕсли ИмяСтраницы = "РаздельнаяОплата" Тогда
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		СхемаДанных         = СхемаСвязейДанных[Элемент.Имя];
		
		Если СхемаДанных.Свойство("ИмяЭлементаРодителя") И ЗначениеЗаполнено(СхемаДанных.ИмяЭлементаРодителя) Тогда
			
			Элементы[СхемаДанных.ИмяЭлементаРодителя].Доступность = Истина;
			
		Иначе
			
			Элемент.Доступность = Истина;
			
		КонецЕсли; 
		
	ИначеЕсли ИмяСтраницы = "ПараметрыГруза" Тогда
		
		ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Элемент             = ПараметрыСтраницы.Элемент;
		УстановитьБлокировкуЭлементовФормы(Элемент, Истина);
		
	ИначеЕсли ИмяСтраницы = "Аккаунт" Тогда
		
		СписокКонтрагентов.Очистить();
		
		
	ИначеЕсли ИмяСтраницы = "КарточкаКонтрагента" И СохранитьИВыбратьКонтрагента Тогда
		// карточку контрагента могли открыть из боковой панели, значит разблокируем то, что было заблокировно при вызове панели
		
		Родитель = ПараметрыДополнительнойПанели[ИмяСтраницы].Элемент.Имя;
		ПараметрыСтраницы = ПараметрыДополнительнойПанели[Родитель];
		СхемаДанных =  СхемаСвязейДанных[ПараметрыСтраницы.Элемент.Имя];
		УстановитьДоступностьПараметровКонтрагента(СхемаДанных);

	ИначеЕсли ИмяСтраницы = "РезультатРасчетаПеревозки" Тогда
		
		ПараметрыСтраницы = ПараметрыДополнительнойПанели[ИмяСтраницы];
		Если ПараметрыСтраницы.Свойство("Параметры") 
			И ПараметрыСтраницы.Параметры.Свойство("Элемент") Тогда
			ПараметрыСтраницы.Параметры.Элемент.Доступность = Истина;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

