&НаКлиенте
Функция СтруктураКонтактнойИнформации(АдресИдентификатор, Идентификатор, Представление)
	
	СтруктураДанных = Новый Структура;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("АдресИдентификатор", АдресИдентификатор);
	СтруктураДанных.Вставить("Идентификатор",      Идентификатор);
	СтруктураДанных.Вставить("Представление",      Представление);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Процедура СтруктураЗапросаДобавитьУслугиНаТерминале(Приемник, Источник, Плательщик, Упаковка)
	
	Для Каждого ТекущаяУслуга Из Источник Цикл

		КодУслуги = НайтиПоИдентификатору("УслугиНаТерминале", ТекущаяУслуга.Идентификатор, "КодУслуги");	
		Приемник.Добавить(Новый Структура("service, payer", КодУслуги, Плательщик));
		
		Если ЗначениеЗаполнено(ТекущаяУслуга.Значение) И КодУслуги = "8" Тогда
			// мешки
			Упаковка.Мешки = ТекущаяУслуга.Значение;
		ИначеЕсли ЗначениеЗаполнено(ТекущаяУслуга.Значение) И КодУслуги = "18" Тогда
			// коробки
			Упаковка.Коробки = ТекущаяУслуга.Значение;
		КонецЕсли;

	КонецЦикла

КонецПроцедуры

&НаКлиенте
Процедура СтруктураЗапросаДобавитьТребованияКТС(Приемник, ИмяРеквизита, ИмяПоля = "requirementService")
	
	Если ТипЗнч(ИмяРеквизита) = Тип("Строка") Тогда
		
		ТекущаяТаблица = ЗначениеРеквизитаФормы(ИмяРеквизита);
		
	Иначе
		
		ТекущаяТаблица = ИмяРеквизита;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекущаяТаблица) Тогда
		
		Приемник.Вставить(ИмяПоля, Новый Массив);
		
		Для Каждого ТекЗапись Из ТекущаяТаблица Цикл
			
			Приемник[ИмяПоля].Добавить(ТекЗапись.Идентификатор);
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураЗапросаДобавитьУслугиПРР(Приемник, ИмяРеквизита, ИмяПоля)
	
	ТекущийСписок = ЗначениеРеквизитаФормы(ИмяРеквизита);
	
	Если ЗначениеЗаполнено(ТекущийСписок) Тогда
		
		СписокУслуг = Новый Массив;
		Приемник.Вставить(ИмяПоля, СписокУслуг);
		
		Для Каждого ТекущаяУслуга Из ТекущийСписок Цикл
			
			СтруктураДанных = Новый Структура("uid", ТекущаяУслуга.Идентификатор);
			
			Если ЗначениеЗаполнено(ТекущаяУслуга.Значение) Тогда
				
				СтруктураДанных.Вставить("value", Формат(ТекущаяУслуга.Значение, "ЧРД=.; ЧН=; ЧГ="));
				
			КонецЕсли; 
			
			СписокУслуг.Добавить(СтруктураДанных);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция МассивИдентификаторовКонтактнойИнформации(Источник, СообщениеОбОшибках = "", ПредставлениеОбъекта = "")
	
	Список = Новый Массив;
	
	Для Каждого КонтактнаяИнформация Из Источник Цикл
		
		Если ЗначениеЗаполнено(КонтактнаяИнформация.Идентификатор) Тогда
			
			Список.Добавить(КонтактнаяИнформация.Идентификатор);
			
		Иначе
			
			ТекстСообщения     = СтрШаблон("Не удалось получить идентификатор для %1 ""%2""", ПредставлениеОбъекта, КонтактнаяИнформация.Представление);
			СообщениеОбОшибках = СообщениеОбОшибках + Символы.ПС + ТекстСообщения;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Список; 	
	
КонецФункции

