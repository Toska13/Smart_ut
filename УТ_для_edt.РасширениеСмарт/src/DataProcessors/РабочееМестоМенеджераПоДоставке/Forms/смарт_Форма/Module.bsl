// Переносит данные "встроенных" справочников из текстового макета
// в соответствующие реквизиты формы: ДанныеКлиентскогоКонтекста
// и ДанныеСерверногоКонтекста
//
// Параметры:
//  ТекущийОбъект - ОбработкаОбъект, ВнешняяОбработкаОбъекта - Ссылка на текущий объект обработки
//
&НаСервере
Процедура ЗагрузитьВстроенныеСправочники(ТекущийОбъект)
	
	ВстроенныеСправочники = ПолучитьОбъектИзТекстовогоМакета(ТекущийОбъект, "ВстроенныеСправочники");
	
	ДанныеКлиентскогоКонтекста.Вставить("Справочники", Новый Структура);
	ДанныеСерверногоКонтекста.Вставить("Справочники",  Новый Структура);
	
	Для Каждого ДанныеСправочника Из ВстроенныеСправочники Цикл
		
		ИмяСправочника     = ДанныеСправочника.Ключ;
		ТаблицаСправочника = ДанныеСправочника.Значение.Таблица;
		ТребуемыйКонтекст  = ЗначениеЭлементаСтруктуры(ДанныеСправочника.Значение, "Контекст");
		ДанныеКонтекста    = ?(ТребуемыйКонтекст = "Сервер", ДанныеСерверногоКонтекста, ДанныеКлиентскогоКонтекста).Справочники;

		ДанныеКонтекста.Вставить(ИмяСправочника, ТаблицаСправочника);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ВынестиКоллекциюИзДанныхФормы(ИмяКоллекции)
	
	// Функция возвращает ссылку на коллекцию, хранящуюся в 
	// реквизитах формы и удаляет ссылку на коллекцию из данных формы
	// Т.е. переносим хранение коллекции из реквизитов формы в клиентскую
	// переменную модуля формы, чтобы снизить объем сериализуемых данных
	// при контекстных серверных вызовах
	
	Коллекция = ДанныеКлиентскогоКонтекста[ИмяКоллекции];
	ДанныеКлиентскогоКонтекста.Удалить(ИмяКоллекции);
	
	Возврат Коллекция;
	
КонецФункции
  
