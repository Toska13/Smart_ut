&НаКлиенте
Процедура УдалитьЭлементСпискаПоЗначению(Список, Значение)
	
	ЭлементСписка = Список.НайтиПоЗначению(Значение);
	
	Если ЭлементСписка <> Неопределено Тогда
		
		Список.Удалить(ЭлементСписка);
		
	КонецЕсли; 
	
