&НаКлиенте
Функция ПроверкаЗаполненияЗаказыМультиотправки(Интерактивно = Ложь)
	
	ЕстьОшибки = Ложь;
	
	МаксимальныйВес   = 20000;
	МаксимальныйОбъем = 80;
	
	Для Каждого ДанныеСтроки Из МультиотправкаЗаказы Цикл
		
		ТекущийИндекс = МультиотправкаЗаказы.Индекс(ДанныеСтроки);
		ТекущаяСтрока = ТекущийИндекс + 1;
		ПутьКСтроке   = "МультиотправкаЗаказы[" + Формат(ТекущийИндекс, "ЧЦ=; ЧН=; ЧГ=") + "].";
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ЗаказИдентификатор) Тогда
			
			Продолжить; // Заказ уже был создан ранее и дополнительная проверка не требуется
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.ПолучательИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не указан получатель в заказе " + ТекущаяСтрока, ПутьКСтроке + "ПолучательПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.ГородИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не указан город получателя в заказе " + ТекущаяСтрока, ПутьКСтроке + "ГородПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли ДанныеСтроки.ДоТерминала И Не ЗначениеЗаполнено(ДанныеСтроки.ТерминалИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не удалось определить терминал города в заказе" + ТекущаяСтрока, ПутьКСтроке + "ТерминалПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ДанныеСтроки.ДоТерминала И Не ЗначениеЗаполнено(ДанныеСтроки.УлицаПредставление) Тогда
			
			ВывестиСообщениеПользователю("Не указан адрес получателя в заказе " + ТекущаяСтрока, ПутьКСтроке + "УлицаПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ДанныеСтроки.ДоТерминала И Не ЗначениеЗаполнено(ДанныеСтроки.Дом) Тогда
			
			ВывестиСообщениеПользователю("Не указан адрес получателя в заказе " + ТекущаяСтрока, ПутьКСтроке + "Дом", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ПроверкаЗаполненияСписокТелефонов(ДанныеСтроки.ТелефоныСписок) Тогда
			
			ВывестиСообщениеПользователю("Некорректно указаны телефоны получателя в заказе " + ТекущаяСтрока, ПутьКСтроке + "ТелефоныПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ПроверкаЗаполненияСписокКонтактов(ДанныеСтроки.КонтактныеЛицаСписок) Тогда
			
			ВывестиСообщениеПользователю("Некорректно указаны контактные лица получателя в заказе " + ТекущаяСтрока, ПутьКСтроке + "КонтактныеЛицаПредставление", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.ВидПеревозки) Тогда
			
			ВывестиСообщениеПользователю("Не указан вид перевозки в заказе " + ТекущаяСтрока, ПутьКСтроке + "ВидПеревозки", Интерактивно, ЕстьОшибки); 
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.КоличествоМест) Тогда
			
			ВывестиСообщениеПользователю("Не указано количество мест в заказе " + ТекущаяСтрока, ПутьКСтроке + "КоличествоМест", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не МультиотправкаОбщиеПараметрыГруза И Не ЗначениеЗаполнено(ДанныеСтроки.ОбщийВес) Тогда
			
			ВывестиСообщениеПользователю("Не указан общий вес в заказе " + ТекущаяСтрока, ПутьКСтроке + "ОбщийВес", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не МультиотправкаОбщиеПараметрыГруза И ДанныеСтроки.ОбщийВес > МаксимальныйВес Тогда
			
			ВывестиСообщениеПользователю("Общий вес в заказе " + ТекущаяСтрока + " превышает допустимый: 20 т", ПутьКСтроке + "ОбщийВес", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не МультиотправкаОбщиеПараметрыГруза И Не ЗначениеЗаполнено(ДанныеСтроки.ОбщийОбъем) Тогда
			
			ВывестиСообщениеПользователю("Не указан общий объем в заказе " + ТекущаяСтрока, ПутьКСтроке + "ОбщийОбъем", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не МультиотправкаОбщиеПараметрыГруза И ДанныеСтроки.ОбщийОбъем > МаксимальныйОбъем Тогда
			
			ВывестиСообщениеПользователю("Общий объем в заказе " + ТекущаяСтрока + " превышает допустимый: 80 м³", ПутьКСтроке + "ОбщийОбъем", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.ПараметрыОплатыСписок) Тогда
			
			ВывестиСообщениеПользователю("Не указан плательщик в заказе " + ТекущаяСтрока, ПутьКСтроке + "ПараметрыОплатыПредставление", Интерактивно, ЕстьОшибки);
			
		ИначеЕсли Не ЗначениеЗаполнено(ДанныеСтроки.ФормаОплатыИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не указана форма оплаты в заказе " + ТекущаяСтрока, ПутьКСтроке + "ФормаОплатыПредставление", Интерактивно, ЕстьОшибки);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

