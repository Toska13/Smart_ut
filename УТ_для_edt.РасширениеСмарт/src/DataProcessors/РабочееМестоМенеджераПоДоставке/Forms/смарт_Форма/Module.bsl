&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
    Распоряжения=ПреобразоватьМассивВТаблицуЗначений(Параметры.Распоряжение); 
    Распоряжения=смартИдентификаторПредзаказа(Распоряжения);
    смартДополнитьДанныеТЗ(Распоряжения); 
    
    МультиотправкаГабаритыДлина=Распоряжения.Итог("Глубина");  
    МультиотправкаГабаритыВысота=Распоряжения.Итог("Высота");
    МультиотправкаГабаритыШирина=Распоряжения.Итог("Ширина");  
    МультиотправкаГабаритыВес=Распоряжения.Итог("ОбщийВес")/1000;  
    МультиотправкаПараметрыГрузаОбщийВес=Распоряжения.Итог("ОбщийВес")/1000;
    МультиотправкаПараметрыГрузаОбщийОбъем=Распоряжения.Итог("ОбщийОбъем");  
    МультиотправкаПараметрыГрузаМаксимальнаяДлина  = МультиотправкаГабаритыДлина;
    МультиотправкаПараметрыГрузаМаксимальнаяШирина = МультиотправкаГабаритыШирина;
    МультиотправкаПараметрыГрузаМаксимальнаяВысота = МультиотправкаГабаритыВысота;
    МультиотправкаПараметрыГрузаМаксимальныйВес    = МультиотправкаГабаритыВес; 
    
    //======================================================================================================================
    
    МаксимальнаяДлина  = 13.6;
	МаксимальнаяШирина = 2.4;
	МаксимальнаяВысота = 2.4;
	МаксимальныйВес    = 20000;
    МаксимальныйОбъем  = 80;
    
    //МультиотправкаПараметрыГрузаМаксимальнаяДлина  = МаксимальнаяДлина;
    //МультиотправкаПараметрыГрузаМаксимальнаяШирина = МаксимальнаяШирина;
    //МультиотправкаПараметрыГрузаМаксимальнаяВысота = МаксимальнаяВысота;
    //МультиотправкаПараметрыГрузаМаксимальныйВес    = МаксимальныйВес; 

    НекорректныеМаксимальныеГабариты = МультиотправкаПараметрыГрузаМаксимальнаяДлина > МаксимальнаяДлина
    ИЛИ МультиотправкаПараметрыГрузаМаксимальнаяШирина > МаксимальнаяШирина
    ИЛИ МультиотправкаПараметрыГрузаМаксимальнаяВысота > МаксимальнаяВысота
    ИЛИ МультиотправкаПараметрыГрузаМаксимальныйВес > МаксимальныйВес;
    
    Если НекорректныеМаксимальныеГабариты Тогда
        
        МультиотправкаПараметрыГрузаМаксимальнаяДлина  = МаксимальнаяДлина;
        МультиотправкаПараметрыГрузаМаксимальнаяШирина = МаксимальнаяШирина;
        МультиотправкаПараметрыГрузаМаксимальнаяВысота = МаксимальнаяВысота;
        МультиотправкаПараметрыГрузаМаксимальныйВес    = МаксимальныйВес;
        МультиотправкаГабаритыДлина=МаксимальнаяДлина;  
        МультиотправкаГабаритыВысота=МаксимальнаяВысота;
        МультиотправкаГабаритыШирина=МаксимальнаяШирина;  
        МультиотправкаГабаритыВес=МаксимальныйВес; 
        МультиотправкаПараметрыГрузаГабаритыПредставление="13.6 x 2.4 x 2.4 | 20";      
        ТекстСообщенияГабаритыТекущие = "Текущие габариты:"+Распоряжения.Итог("Глубина")+" м x "+Распоряжения.Итог("Ширина")+" м x "+Распоряжения.Итог("Ширина")+" м |"+Распоряжения.Итог("ОбщийВес")/1000+" т";
        ВывестиСообщениеПользователю(ТекстСообщенияГабаритыТекущие, );
        ТекстСообщения = "Максимальные весогабаритные характеристики места превышают допустимые: 13.6 м x 2.4 м x 2.4 м | 20 т";
        ВывестиСообщениеПользователю(ТекстСообщения, "МультиотправкаПараметрыГрузаГабаритыПредставление");
        
    КонецЕсли; 
    //======================================================================================================================

    ШаблонПредставления = "%1 х %2 х%3 | %4";
	МультиотправкаПараметрыГрузаГабаритыПредставление = СтрШаблон(ШаблонПредставления, МультиотправкаГабаритыДлина, МультиотправкаГабаритыШирина, МультиотправкаГабаритыВысота, МультиотправкаГабаритыВес);  
    
    ДатаИВремяДата=НачалоДня(ТекущаяДата());
    ДатаИВремяПерерывНачало=Дата("00010101")+9*3600;
    ДатаИВремяРежимРаботыОкончание=Дата("00010101")+18*3600; 
    
    //Телефоны и контакты из заказов
    ТзМультиотправкаЗаказы=РеквизитФормыВЗначение("МультиотправкаЗаказы"); 
    Для каждого Стр Из Распоряжения Цикл
        Нстрока=ТзМультиотправкаЗаказы.Добавить();
        ЗаполнитьЗначенияСвойств(Нстрока,Стр);
    КонецЦикла;
    ЗначениеВРеквизитФормы(ТзМультиотправкаЗаказы,"МультиотправкаЗаказы"); 
    
    ПрочитатьДаннныеОбъекта(); 
    ПрочитатьПараметрыОкружения();
    ИнициализироватьКоллекциюСправочниковНаСервере();
    ЭтаФорма.Заголовок = "Предзаказ ""Деловые линии"" v1";
    Элементы.ДополнительнаяПанельСтраницы.Видимость=Ложь;//ТекущаяСтраница = Элементы.Заглушка;	
    
    Элементы.ОбластиФормы.ТекущаяСтраница = Элементы.ОбластиФормыЗаставка;
    ИндикаторЗагрузки = 0;
    ИнформацияЗагрузкиДанных = "Инициализация..."; 
    ПараметрыПодключения_Сервер = "https://api.dellin.ru";
    ПараметрыПодключения_Логин  = "evgenya@smart-t.ru";
    ПараметрыПодключения_Пароль = "LogistSmart2022";
    ПараметрыПодключения_КлючПриложения="C97C6014-B82C-4A21-A9A3-9B9E3661BA4B";
    
    МультиотправкаКлюч = Новый УникальныйИдентификатор();
    МультиотправкаОтправительСпособ = "Терминал";   
    МультиотправкаПараметрыГрузаХарактер="Оборудование печатное";
    МультиотправкаПараметрыГрузаТипУпаковки="Коробка";
    МультиотправкаРольЗаказчикаВПеревозкеПредставление="Отправитель"; 
    ОсновнаяОрганизация=Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение;
    Если ЗначениеЗаполнено(ОсновнаяОрганизация) Тогда
        МультиотправкаЗаказчикПредставление=ОсновнаяОрганизация.НаименованиеСокращенное;
        Для каждого Стр Из ОсновнаяОрганизация.КонтактнаяИнформация Цикл 
            Если ЗначениеЗаполнено(Стр.НомерТелефона) Тогда
                МультиотправкаОтправительТелефоныПредставление=Стр.НомерТелефона;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли; 
       
КонецПроцедуры

&НаСервере
Функция смартИдентификаторПредзаказа(Распоряжения)  
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
          "ВЫБРАТЬ
        |   Распоряжения.Распоряжение КАК Заказ,
        |   Распоряжения.ПолучательОтправитель КАК ПолучательОтправитель
        |ПОМЕСТИТЬ РаспоряженияЗаказ
        |ИЗ
        |   &Распоряжения КАК Распоряжения
        |;
        |
        |////////////////////////////////////////////////////////////////////////////////
        |ВЫБРАТЬ
        |   РаспоряженияЗаказ.Заказ КАК Распоряжение,
        |   РаспоряженияЗаказ.ПолучательОтправитель КАК ПолучательОтправитель,
        |   смартСозданиеПредзаказовВ_ТК.requestID КАК ЗаказИдентификатор
        |ИЗ
        |   РаспоряженияЗаказ КАК РаспоряженияЗаказ
        |       ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСозданиеПредзаказовВ_ТК КАК смартСозданиеПредзаказовВ_ТК
        |       ПО РаспоряженияЗаказ.Заказ = смартСозданиеПредзаказовВ_ТК.Заказ";
    Запрос.УстановитьПараметр("Распоряжения",Распоряжения);
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

&НаСервере
Процедура смартДополнитьДанныеТЗ(Распоряжения) 
    
    Распоряжения.Колонки.Добавить("ВидПеревозки");
    Распоряжения.Колонки.Добавить("АдресДоставки");
    Распоряжения.Колонки.Добавить("ПараметрыОплатыПредставление");
    Распоряжения.Колонки.Добавить("ФормаОплатыПредставление"); 
    Распоряжения.Колонки.Добавить("ФормаОплатыИдентификатор");
    Распоряжения.Колонки.Добавить("КонтактныеЛицаПредставление");
    Распоряжения.Колонки.Добавить("ТелефоныПредставление");
    Распоряжения.Колонки.Добавить("ПолучательПредставление");   
    Распоряжения.Колонки.Добавить("КоличествоМест");
    Распоряжения.Колонки.Добавить("ОбщийВес");
    Распоряжения.Колонки.Добавить("ОбщийОбъем");
    Распоряжения.Колонки.Добавить("Глубина");
    Распоряжения.Колонки.Добавить("Ширина");
    Распоряжения.Колонки.Добавить("Высота");
    
    Массив = Новый Массив;
    Массив.Добавить(Тип("ТаблицаЗначений"));
    ОписаниеТиповТЗ = Новый ОписаниеТипов(Массив,,);
    Распоряжения.Колонки.Добавить("ТелефоныСписок",ОписаниеТиповТЗ);   
    Распоряжения.Колонки.Добавить("КонтактныеЛицаСписок",ОписаниеТиповТЗ);
    Для каждого Стр Из Распоряжения Цикл
        
        Стр.ФормаОплатыПредставление="Безналичная оплата";
        Стр.ФормаОплатыИдентификатор="non_cash"; 
        Стр.КоличествоМест=1; 
        Стр.АдресДоставки=Стр.Распоряжение.АдресДоставки;
        Если ТипЗнч(Стр.Распоряжение)=Тип("ДокументСсылка.ЗаказКлиента") ИЛИ ТипЗнч(Стр.Распоряжение)=Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
            
            Если ТипЗнч(Стр.Распоряжение)=Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда 
                Стр.ВидПеревозки="1"; 
                Стр.ПараметрыОплатыПредставление="Получатель";
            Иначе  
                
                Если ЗначениеЗаполнено(Стр.Распоряжение.Контрагент) Тогда
                    Стр.ПолучательПредставление = Стр.Распоряжение.Контрагент;
                КонецЕсли;
                
                Если ЗначениеЗаполнено(Стр.Распоряжение.СпособДоставкиТовара) Тогда
                    Стр.ВидПеревозки="1";//Стр.Распоряжение.СпособДоставкиТовара;	
                КонецЕсли; 
                
                Если ЗначениеЗаполнено(Стр.Распоряжение.ПлатильщикЗаДоставкуГруза) Тогда
                    Стр.ПараметрыОплатыПредставление=Стр.Распоряжение.ПлатильщикЗаДоставкуГруза;	
                КонецЕсли;
                
                Если ЗначениеЗаполнено(Стр.Распоряжение.КонтактноеЛицо) Тогда 
                    ТзКл=Новый ТаблицаЗначений;
                    ТзКл.Колонки.Добавить("Идентификатор",ОбщегоНазначения.ОписаниеТипаСтрока(100)); 
                    ТзКл.Колонки.Добавить("Представление",ОбщегоНазначения.ОписаниеТипаСтрока(100));
                    НСтрокаКл=ТзКл.Добавить();
                    НСтрокаКл.Представление=Стр.Распоряжение.КонтактноеЛицо.Наименование; 
                    НСтрокаКл.Идентификатор=""; 
                    
                    Стр.КонтактныеЛицаПредставление=Стр.Распоряжение.КонтактноеЛицо.Наименование;
                    Стр.КонтактныеЛицаСписок=ТзКл;
                КонецЕсли; 
                
                Если ЗначениеЗаполнено(Стр.Распоряжение.смартТелефонКонтактногоЛица) Тогда 
                    Тз=Новый ТаблицаЗначений;
                    Тз.Колонки.Добавить("Идентификатор",ОбщегоНазначения.ОписаниеТипаСтрока(100)); 
                    Тз.Колонки.Добавить("Основной",ОбщегоНазначения.ОписаниеТипаСтрока(100));
                    Тз.Колонки.Добавить("Добавочный",ОбщегоНазначения.ОписаниеТипаСтрока(100));
                    Тз.Колонки.Добавить("Представление",ОбщегоНазначения.ОписаниеТипаСтрока(100));
                    НСтрока=Тз.Добавить();
                    НСтрока.Основной=Стр.Распоряжение.смартТелефонКонтактногоЛица;
                    НСтрока.Представление=Стр.Распоряжение.смартТелефонКонтактногоЛица; 
                    НСтрока.Идентификатор="";
                    НСтрока.Добавочный="";
                    
                    Стр.ТелефоныПредставление=Стр.Распоряжение.смартТелефонКонтактногоЛица;  
                    Стр.ТелефоныСписок=Тз;
                КонецЕсли; 
            КонецЕсли;            
            
            //Наличие упаковок у товара    
            ОбщВес=0;
            ОбщОбъём=0;
            ОбщГлубина=0;
            ОбщШирина=0;
            ОбщВысота=0;
            Для каждого СтрНом Из Стр.Распоряжение.Товары Цикл
                Если СтрНом.Номенклатура.ИспользоватьУпаковки Тогда
                    Выборка=Справочники.УпаковкиЕдиницыИзмерения.Выбрать(,СтрНом.Номенклатура,,); 
                    Пока Выборка.Следующий() Цикл
                        Если Выборка.Ссылка.ЕдиницаИзмерения=СтрНом.Номенклатура.ЕдиницаИзмерения Тогда
                        ОбщОбъём=ОбщОбъём+Выборка.Объем*СтрНом.КоличествоУпаковок;
                        ОбщВес=ОбщВес+Выборка.Вес*СтрНом.КоличествоУпаковок;
                        ОбщГлубина=ОбщГлубина+Выборка.Глубина*СтрНом.КоличествоУпаковок;
                        ОбщШирина=ОбщШирина+Выборка.Ширина*СтрНом.КоличествоУпаковок;
                        ОбщВысота=ОбщВысота+Выборка.Высота*СтрНом.КоличествоУпаковок;
                        КонецЕсли;	
                    КонецЦикла;   
                Иначе
                    ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Данные распоряжений не полные т.к. не заполнена упаковка - "+СтрНом.Номенклатура+" в: "+Стр.Распоряжение,СтрНом.Номенклатура);  
                КонецЕсли;  
            КонецЦикла;
            Стр.ОбщийОбъем=ОбщОбъём;   
            Стр.ОбщийВес=ОбщВес;
            
            Стр.Глубина=ОбщГлубина;   
            Стр.Ширина=ОбщШирина;
            Стр.Высота=ОбщВысота;
        КонецЕсли;
    КонецЦикла; 
    
КонецПроцедуры                       

&НаСервереБезКонтекста
Функция ПреобразоватьМассивВТаблицуЗначений(мсДанные) 
    
    тзДанные = Новый ТаблицаЗначений;  
    
    Массив = Новый Массив;
    Массив.Добавить(Тип("ДокументСсылка.ЗаказКлиента")); 
    Массив.Добавить(Тип("ДокументСсылка.ЗаказНаПеремещение"));
    ОписаниеТиповРаспоряжения = Новый ОписаниеТипов(Массив, , );

    Для Каждого ЭлементМассива Из мсДанные Цикл
		
		Если тзДанные.Колонки.Количество() = 0 Тогда
            Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
                тзДанные.Колонки.Добавить(ЗначениеСтруктуры.Ключ,?(ЗначениеСтруктуры.Ключ="Распоряжение",ОписаниеТиповРаспоряжения,Новый ОписаниеТипов("Строка")));
            КонецЦикла;
        КонецЕсли;
        
        НоваяСтрока = тзДанные.Добавить();
        Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
            НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
        КонецЦикла;
    КонецЦикла;
    
    Возврат тзДанные;
    
КонецФункции

// Считывает и инициализирует различные данные объекта,
// хранящиеся, например, в макетах обработки, инициализирует
// служебные реквизиты формы (структуры метаданных и т.п.)
//
&НаСервере
Процедура ПрочитатьДаннныеОбъекта()
	
	ТекущийОбъект              = РеквизитФормыВЗначение("Объект");
	ДанныеКлиентскогоКонтекста = Новый Структура;
	ДанныеСерверногоКонтекста  = Новый Структура;
	
	КоллекцияМетаданные   = ПолучитьОбъектИзТекстовогоМакета(ТекущийОбъект, "ОписаниеМетаданных");
		
	ДанныеКлиентскогоКонтекста.Вставить("КоллекцияМетодов", ПолучитьОбъектИзТекстовогоМакета(ТекущийОбъект, "МетодыAPI"));
	//ДанныеКлиентскогоКонтекста.Вставить("КоллекцияОтчетов", ПолучитьОбъектИзТекстовогоМакета(ТекущийОбъект, "СхемыОтчетов"));
	ДанныеКлиентскогоКонтекста.Вставить("КоллекцияФорм",    ПолучитьКоллекциюФорм(ТекущийОбъект));
	ДанныеКлиентскогоКонтекста.Вставить("ПараметрыОкружения", Новый Структура);
	
	ЗагрузитьВстроенныеСправочники(ТекущийОбъект);
	
КонецПроцедуры
    
// Возвращает объект, десериализованный из текстового макета обработки
//
// Параметры:
//  ТекущийОбъект - ОбработкаОбъект, ВнешняяОбработкаОбъекта - Ссылка на текущий объект обработки
//  ИмяМакета     - Строка - Имя текстового макета, содержащего сериализованные данные объекта
//
// Возвращаемое значение:
//  Произвольный - Объект, десериализованный из текстового представления
//
&НаСервере
Функция ПолучитьОбъектИзТекстовогоМакета(ТекущийОбъект, ИмяМакета)
	
	Макет  = ТекущийОбъект.ПолучитьМакет(ИмяМакета);
	Данные = ДесериализоватьСтроку(Макет.ПолучитьТекст());

	Возврат Данные;

КонецФункции

&НаСервере
Функция ПолучитьКоллекциюФорм(ТекущийОбъект)
	
	МетаОбъект          = ТекущийОбъект.Метаданные();
	ЭтоВнешняяОбработка = НЕ Метаданные.Обработки.Содержит(МетаОбъект);
	ИмяКоллекции        = ?(ЭтоВнешняяОбработка, "ВнешняяОбработка", "Обработка");
	ПутьКФормам         = ИмяКоллекции + "." + МетаОбъект.Имя + ".Форма.";
	
	КоллекцияФорм = Новый Структура;
	КоллекцияФорм.Вставить("СписокТелефонов",     Новый Структура("Путь", ПутьКФормам + "СписокТелефонов"));
	КоллекцияФорм.Вставить("СписокКонтактныхЛиц", Новый Структура("Путь", ПутьКФормам + "СписокКонтактныхЛиц"));
	
	Возврат КоллекцияФорм;
	
КонецФункции

