Функция ВыполнитьGetЗапрос(Хост, Порт, Адрес, Прокси, ИмяФайла = "")
	
	Соединение = Новый HTTPСоединение(Хост, Порт, ,, НовыйИнтернетПрокси(Прокси));
	Запрос     = Новый HTTPЗапрос(Адрес);
	
	#Если Клиент Тогда
	
	Путь       = ?(ЗначениеЗаполнено(ИмяФайла), ИмяФайла, ПолучитьИмяВременногоФайла());
	Ответ      = Соединение.Получить(Запрос, Путь);
	
	#Иначе
	
	Ответ      = Соединение.Получить(Запрос);
	Путь       = ПоместитьВоВременноеХранилище(Ответ.ПолучитьТелоКакДвоичныеДанные());
	
	#КонецЕсли
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КодСтатуса", Ответ.КодСостояния);
	СтруктураДанных.Вставить("Тело",       Путь);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьGetЗапросНаСервере(Хост, Порт, Адрес, Прокси)
	
	Возврат ВыполнитьGetЗапрос(Хост, Порт, Адрес, Прокси);
	
КонецФункции

&НаКлиенте
Функция ВыполнитьGetЗапросНаКлиенте(Хост, Порт, Адрес, Прокси, ИмяФайла = "")
	
	Возврат ВыполнитьGetЗапрос(Хост, Порт, Адрес, Прокси, ИмяФайла);
	
КонецФункции

#КонецОбласти

#Область POST

&НаКлиентеНаСервереБезКонтекста
Функция ВыполнитьPOSTЗапрос(Хост, Порт, Адрес, Таймаут, Прокси,  Тело)
	
	Соединение = Новый HTTPСоединение(Хост, Порт, ,,, Таймаут);
	Заголовки  = Новый Соответствие;
	Заголовки.Вставить("Content-type", "text/xml");
	
	Запрос = Новый HTTPЗапрос(Адрес, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело, "UTF-8");
	
	Ответ  = Соединение.ОтправитьДляОбработки(Запрос);
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("КодСтатуса", Ответ.КодСостояния);
	СтруктураДанных.Вставить("Тело",       Ответ.ПолучитьТелоКакСтроку());
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьPOSTЗапросНаКлиенте(Хост, Порт, Адрес, Таймаут, Прокси, Тело)
	
	Возврат ВыполнитьPOSTЗапрос(Хост, Порт, Адрес, Таймаут, Прокси, Тело);	
	
КонецФункции

