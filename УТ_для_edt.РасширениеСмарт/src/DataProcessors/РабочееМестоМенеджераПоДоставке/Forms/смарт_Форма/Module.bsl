&НаКлиенте
Процедура МультиотправкаЗаказыПараметрыОплатыПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДанныеВыбора = СписокВыбораСправочника("ВидыПлательщиков");
	
	Если МультиотправкаДоступнаРаздельнаяОплата() Тогда
		
		ДанныеВыбора.Добавить("раздельная", "Раздельная оплата"); 
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;	
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаЗаказыПараметрыОплатыПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДанныеСтроки = Элементы.МультиотправкаЗаказы.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если ВыбранноеЗначение = "раздельная" Тогда
			
			СтандартнаяОбработка = Ложь;
			
			ДоступныеГруппы = Новый СписокЗначений;
			
			
			ДоступныеГруппы.Добавить("УслугиОтАдреса", "Забор от адреса");
			
			
			ДоступныеГруппы.Добавить("УслугиМежтерминальные", "Межтерминальная перевозка");
			
			
			Если НЕ ДанныеСтроки.ДоТерминала Тогда
				
				ДоступныеГруппы.Добавить("УслугиДоАдреса", "Доставка до адреса");
				
			КонецЕсли; 
			
			
			ПараметрыОбработчикаРазделенияОплаты = Новый Структура("Элемент, ДоступныеГруппы", Элемент, ДоступныеГруппы);
			ПодключитьОбработчикОжидания("ОбработчикОжиданияРаздельнаяОплата", 0.1, Истина);
			
		Иначе
			
			Представление = НайтиПоИдентификатору("ВидыПлательщиков", ВыбранноеЗначение, "Наименование");
			ДанныеСтроки.ПараметрыОплатыСписок.Очистить();
			
			НоваяЗапись = ДанныеСтроки.ПараметрыОплатыСписок.Добавить();
			НоваяЗапись.ПлательщикИдентификатор = ВыбранноеЗначение;
			ВыбранноеЗначение = Представление;
			
		КонецЕсли;
		
	Иначе
		
		ДанныеСтроки.ПараметрыОплатыСписок.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

