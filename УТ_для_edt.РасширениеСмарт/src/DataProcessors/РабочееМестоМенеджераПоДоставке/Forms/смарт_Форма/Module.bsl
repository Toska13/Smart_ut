&НаКлиенте
Функция СтруктураОтветаНаЗапросДанных(Метод = Неопределено, КодСтатуса = 0, ОписаниеСтатуса = "")
	
	Ответ = Новый Структура;
	
	Ответ.Вставить("Метод",           Метод);
	Ответ.Вставить("КодСтатуса",      КодСтатуса);
	Ответ.Вставить("ОписаниеСтатуса", ОписаниеСтатуса);
	Ответ.Вставить("Данные",          Неопределено);
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросДанныхHTTPСоединение(Адрес, Тело, ОтключитьЛогирование = Ложь)
	
	СтруктураАдреса = СтруктураИнтернетАдреса(Адрес);
	Таймаут         = 60;//?(ПараметрыПодключения.Таймаут > 0, ПараметрыПодключения.Таймаут, КоллекцияКонстант.ТаймаутHTTPСоединенияПоУмолчанию);
	СтруктураОтвета = СтруктураОтветаНаЗапросДанных();
	
	ДобавитьСообщениеВЖурнал("Выполнение запроса (HTTPСоединение)" + Адрес + Символы.ПС + Тело, ОтключитьЛогирование);
	
    //Если ПараметрыПодключения.СоединениеНаСервере Тогда
    //	
    //	Ответ = ВыполнитьPOSTЗапросНаСервере(СтруктураАдреса.Хост, СтруктураАдреса.Порт, СтруктураАдреса.АдресРесурса, Таймаут, ПараметрыПодключения.ПроксиСервер, Тело);
    //	
    //Иначе
		
		Ответ = ВыполнитьPOSTЗапросНаКлиенте(СтруктураАдреса.Хост, СтруктураАдреса.Порт, СтруктураАдреса.АдресРесурса, Таймаут, "" , Тело);
		
    //КонецЕсли; 
	
	Статус = Ответ.КодСтатуса;
	Тело   = Ответ.Тело;
	
	ДобавитьСообщениеВЖурнал("Получен ответ: " + Статус + Символы.ПС + Тело, ОтключитьЛогирование);
	
	СтруктураОтвета.КодСтатуса = Статус;
	СтруктураОтвета.Данные     = Тело;
	
	Возврат СтруктураОтвета;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьЗапросДанных(Метод, СтруктураЗапроса)
	
	СтруктураЗапроса.Вставить("productInfo", СтруктураПараметровОкружения);

	Адрес     = СтрЗаменить(ПараметрыПодключения_Сервер + Метод.Ресурс, "/" + Метод.Ресурс, Метод.Ресурс); 
    Тело      = СериализоватьСтруктуруЗапроса(СтруктураЗапроса);
	ОтключитьЛогирование = Метод = КоллекцияМетодов.ПодборГородовПоСтроке ИЛИ Метод = КоллекцияМетодов.ПодборУлицПоСтроке; 
    
	Попытка
		
		Ответ = ВыполнитьЗапросДанныхHTTPСоединение(Адрес, Тело, ОтключитьЛогирование);
		Ответ.Вставить("Метод", Метод); // дополним ответ данными об используемом методе api
		
	Исключение
		
		ДобавитьСообщениеВЖурнал("Ошибка при выполнении запроса метода """ + Метод.Имя + """: " + ОписаниеОшибки(), ОтключитьЛогирование);
		
		Ответ = СтруктураОтветаНаЗапросДанных(Метод);
		Ответ.КодСтатуса      = -1;
		Ответ.ОписаниеСтатуса = "Ошибка времени исполнения";
		
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьОшибкиЗапроса(Результат)
	
	Если Результат.КодСтатуса = -1 Тогда
		
		ВывестиСообщениеПользователю("Во время выполнения операции произошла непредвиденная ошибка: " + Результат.ОписаниеСтатуса);
		
	Иначе
		
		ВывестиСообщениеПользователю("Не удалось получить данные: " + Результат.КодСтатуса + " (" + Результат.ОписаниеСтатуса + ")");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Данные) Тогда
		
		ВывестиСообщениеПользователю(Результат.Данные);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Функция УдалитьНевалидируемыеСимволы(Знач Текст)
	
	// Решение частной проблемы возможности указать невалидные (xml) символы
	// в исходных данных. Функция удаляет из текста ответа такие символы
	
	Для КодСимвола = 29 По 31 Цикл
		
		Текст = СтрЗаменить(Текст, Символ(КодСимвола), "");
		
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Функция ДесериализоватьСтруктуруЗапроса(ТелоЗапроса, ВключатьКорневойЭлемент = Ложь)
	
	СтруктураЗапроса = Новый Структура;
	ТекущиеДанные    = Неопределено;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(УдалитьНевалидируемыеСимволы(ТелоЗапроса));
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ТекущиеДанные = Новый Структура("Имя, Родитель, Значение", ЧтениеXML.Имя, ТекущиеДанные, Новый Структура);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ТекущиеДанные.Значение = ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если ТекущиеДанные.Родитель = Неопределено Тогда
				
				Если ВключатьКорневойЭлемент Тогда
					
					СтруктураЗапроса.Вставить(ТекущиеДанные.Имя, ТекущиеДанные.Значение);
					
				Иначе
					
					СтруктураЗапроса = ТекущиеДанные.Значение;
					
				КонецЕсли; 
				
			Иначе
				
				ЗначениеРодителя = ТекущиеДанные.Родитель.Значение;
				
				Если ЗначениеРодителя = Неопределено Тогда
					
					ЗначениеРодителя = Новый Структура;
					ТекущиеДанные.Родитель.Значение = ЗначениеРодителя;
					
				КонецЕсли;
				
				Если ЗначениеРодителя.Свойство(ТекущиеДанные.Имя) Тогда
					
					// значит родитель содержит список элементов с имененм текущего элемента
					
					СписокЭлементов = ЗначениеРодителя [ТекущиеДанные.Имя];
					
					Если ТипЗнч(СписокЭлементов) <> Тип("Массив") Тогда
						
						СписокЭлементов = Новый Массив;
						СписокЭлементов.Добавить(ЗначениеРодителя [ТекущиеДанные.Имя]);
						
						ЗначениеРодителя [ТекущиеДанные.Имя] = СписокЭлементов;
						
					КонецЕсли;
					
					СписокЭлементов.Добавить(ТекущиеДанные.Значение);
					
				Иначе
					
					ЗначениеРодителя.Вставить(ТекущиеДанные.Имя, ТекущиеДанные.Значение);
					
				КонецЕсли; 
				
				ТекущиеДанные = ТекущиеДанные.Родитель;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат СтруктураЗапроса;
	
КонецФункции

&НаКлиенте
Функция ПолучитьЗначениеПоля(Источник, Поле, ЗначениеПоУмолчанию = Неопределено, ПриводитьКТипу = Неопределено)
	
	Значение = ЗначениеПоУмолчанию;
	
	Если ЗначениеЗаполнено(Источник) И Источник.Свойство(Поле) Тогда
		
		ИсходноеЗначение = Источник [Поле];
		
		Если ВРег(ИсходноеЗначение) = "NONE" Тогда
			
			Значение = ЗначениеПоУмолчанию;
			
		ИначеЕсли ТипЗнч(ИсходноеЗначение) = Тип("Структура") И Не ЗначениеЗаполнено(ИсходноеЗначение) Тогда
			
			Значение = ЗначениеПоУмолчанию;
			
		ИначеЕсли ПриводитьКТипу = Неопределено Тогда
			
			Значение = ИсходноеЗначение;
			
		Иначе
			
			Если ПриводитьКТипу = "Дата" Тогда
				
				ИсходноеЗначение = СтрЗаменить(ИсходноеЗначение, "-", "");
				ИсходноеЗначение = СтрЗаменить(ИсходноеЗначение, "T", "");
				ИсходноеЗначение = СтрЗаменить(ИсходноеЗначение, ":", "");
				ИсходноеЗначение = СтрЗаменить(ИсходноеЗначение, " ", "");
				
			КонецЕсли;
			
			ТребуемыйТип = Новый ОписаниеТипов(ПриводитьКТипу);
			Значение     = ТребуемыйТип.ПривестиЗначение(ИсходноеЗначение);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Значение; 	
	
КонецФункции

&НаКлиенте
Функция ДобавитьЗначениеПоля(Приемник, ИмяСвойства, Источник, Поле, ЗначениеПоУмолчанию = Неопределено, ПриводитьКТипу = Неопределено)
	
	ПолеДобавлено = Ложь;
	Значение      = ПолучитьЗначениеПоля(Источник, Поле, ЗначениеПоУмолчанию, ПриводитьКТипу);
	
	Если Значение <> Неопределено Тогда
		
		Приемник.Вставить(ИмяСвойства, Значение);
		ПолеДобавлено = Истина;
		
	КонецЕсли; 
	
	Возврат ПолеДобавлено;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьЗначениеПоляКакМассив(Источник, Поле, ПриОтсутствииВозвращатьПустойМассив = Истина)
	
	МассивДанных = Неопределено;
	
	Если Источник.Свойство(Поле) Тогда
		
		Если ТипЗнч(Источник [Поле]) = Тип("Массив") Тогда
			
			МассивДанных = Источник [Поле];
			
		Иначе 
			
			МассивДанных = Новый Массив;
			
			Если ТипЗнч(Источник[Поле]) <> Тип("Структура") ИЛИ ЗначениеЗаполнено(Источник[Поле]) Тогда
				
				МассивДанных.Добавить(Источник[Поле]);
				
			КонецЕсли; 
			
		КонецЕсли;
		
	ИначеЕсли ПриОтсутствииВозвращатьПустойМассив Тогда
		
		МассивДанных = Новый Массив;
		
	КонецЕсли; 
	
	Возврат МассивДанных;
	
КонецФункции

