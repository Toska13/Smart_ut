#Область АдреснаяКнига

&НаКлиенте
Процедура ЗаполнитьКонтактныеДанные(Источник, Приемник, ИмяПоля)
	
	Для Каждого ТекущиеДанные Из Источник Цикл
		
		ТекЗначение      = ПолучитьЗначениеПоля(ТекущиеДанные, ИмяПоля);
		ТекИдентификатор = ПолучитьЗначениеПоля(ТекущиеДанные, "id");
		
		Приемник.Представление = Приемник.Представление + Символы.ПС + ТекЗначение;
		Приемник.Список.Добавить(Новый Структура("Идентификатор, Представление", ТекИдентификатор, ТекЗначение));
		
	КонецЦикла;
	
	Приемник.Представление = СокрЛП(Приемник.Представление);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКонтактныеДанныеТелефоны(Источник, Приемник)
	
	Для Каждого ТекущиеДанные Из Источник Цикл
		
		ТекИдентификатор = ПолучитьЗначениеПоля(ТекущиеДанные, "id");
		ОсновнойНомер    = ПолучитьЗначениеПоля(ТекущиеДанные, "phone");
		ДобавочныйНомер  = ПолучитьЗначениеПоля(ТекущиеДанные, "addNumber");
		
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Идентификатор", ТекИдентификатор);
		СтруктураДанных.Вставить("Основной",      ПолучитьТолькоЦифры(ОсновнойНомер));
		СтруктураДанных.Вставить("Добавочный",    ПолучитьТолькоЦифры(ДобавочныйНомер));
		СтруктураДанных.Вставить("Представление", ПредставлениеТелефонаПоМаске(СтруктураДанных));
		
		Приемник.Представление = Приемник.Представление + Символы.ПС + СтруктураДанных.Представление;
		Приемник.Список.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	Приемник.Представление = СокрЛП(Приемник.Представление);
	
КонецПроцедуры

#КонецОбласти

