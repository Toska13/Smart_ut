&НаКлиенте
Процедура ПриОткрытии(Отказ)    
    
    ИнициализироватьПараметрыНаКлиенте();
    
    Если НЕ ОсновныеНастройкиЗаполнены() Тогда
		
    ИначеЕсли ВыполнитьАвторизацию() Тогда
               
        ЗагрузитьДанныеЛичногоКабинета();  
   		
	КонецЕсли;
    
    МультиотправкаОтправительГородИдентификатор="200555";
    МультиотправкаОтправительГородПредставление="г. Москва";      
    
    ДатаИВремяДата=НачалоДня(ТекущаяДата());
    ДатаИВремяПерерывНачало=Дата("00010101")+9*3600;
    ДатаИВремяРежимРаботыОкончание=Дата("00010101")+18*3600; 
    МультиотправкаПараметрыПеревозкиДатаВремя=Новый Структура;
    МультиотправкаПараметрыПеревозкиДатаВремя.Вставить("Дата",ДатаИВремяДата);          
    МультиотправкаПараметрыПеревозкиДатаВремя.Вставить("ПерерывНачало",Дата("00010101"));  
    МультиотправкаПараметрыПеревозкиДатаВремя.Вставить("ПерерывОкончание",Дата("00010101")); 
    МультиотправкаПараметрыПеревозкиДатаВремя.Вставить("РежимРаботыНачало",ДатаИВремяПерерывНачало); 
    МультиотправкаПараметрыПеревозкиДатаВремя.Вставить("РежимРаботыОкончание",ДатаИВремяРежимРаботыОкончание);
    МультиотправкаПараметрыПеревозкиДатаВремяПредставление=ПредставлениеСтруктурыВремени(МультиотправкаПараметрыПеревозкиДатаВремя);
    
КонецПроцедуры

&НаКлиенте
Функция ОсновныеНастройкиЗаполнены()
	
	Результат = ЗначениеЗаполнено(ПараметрыПодключения_КлючПриложения)
	И ЗначениеЗаполнено(ПараметрыПодключения_Сервер);	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ВыполнитьАвторизацию()
	
	Результат =
	ЗначениеЗаполнено(ПараметрыПодключения_Логин)  И
	ЗначениеЗаполнено(ПараметрыПодключения_Пароль) И
	Авторизация();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция Авторизация(ЧерезОкноАвторизации = Ложь)
	
	АвторизацияВыполнена = Ложь;
    
    СтруктураЗапроса = СтруктураЗапросаПоКлючуПриложения();
    СтруктураЗапроса.Вставить("login",    ПараметрыПодключения_Логин);
    СтруктураЗапроса.Вставить("password", ПараметрыПодключения_Пароль);
    
    СтрокаЖсон=Вjson(СтруктураЗапроса);
    
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Результат = PostЗапросAPI("https://api.dellin.ru/v3/auth/login.json",
    СтрокаЖсон, 
    Заголовки);
 
    
	Если Результат.КодСостояния = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета     = ИЗjson(Результат.Тело); 
		
		 ДанныеОтвета = СтруктураОтвета.Получить("data");  
        
        Если НЕ ДанныеОтвета = Неопределено И НЕ ДанныеОтвета.Получить("sessionID") = Неопределено Тогда
            
			АвторизацияВыполнена        = Истина;
			ПараметрыПодключения_Сессия = ДанныеОтвета.Получить("sessionID");			
		Иначе
            
		КонецЕсли; 
		
	Иначе
		
		//ОбработатьОшибкиЗапроса(Результат);
		
	КонецЕсли; 
	
	Возврат АвторизацияВыполнена;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьСправочникAPI(ОписаниеСправочника)
	
	Метод      = КоллекцияМетодов[ОписаниеСправочника.Источник.Метод];        // Из метаданных справочника получаем имя метода API
	Результат  = ВыполнитьЗапросДанных(Метод, ЗаголовокЗапросаМетода(Метод)); // Основные параметры запроса получаем из описания метода
	
	Если ЗапросВыполненУспешно(Результат) Тогда
		
		Если ПустаяСтрока(Метод.Обработчик) Тогда
			
			// Если для справочника не указан специальный обработчик, используем
			// обработчик по умолчанию - загрузка справочника из файла в формате csv
			
			ЗагрузитьСправочникВФорматеCSV(ОписаниеСправочника, Результат.Данные);
			
		ИначеЕсли Метод.Обработчик = "СтатусыЗаказов" Тогда
			
			ЗагрузитьСправочникСтатусыЗаказов(ОписаниеСправочника, Результат.Данные);
			
		ИначеЕсли Метод.Обработчик = "Терминалы" Тогда
			
			ЗагрузитьСправочникТерминалы(ОписаниеСправочника, Результат.Данные);
			
		ИначеЕсли Метод.Обработчик = "Контрагенты" Тогда
			
			ЗагрузитьСправочникКонтрагенты(ОписаниеСправочника, Результат.Данные);
			
		Иначе
			
			ВызватьИсключение("Неизвестный обработчик загрузки справочной информации: " + Метод.Обработчик);
			
		КонецЕсли; 
		
	КонецЕсли; 	
	
КонецПроцедуры

