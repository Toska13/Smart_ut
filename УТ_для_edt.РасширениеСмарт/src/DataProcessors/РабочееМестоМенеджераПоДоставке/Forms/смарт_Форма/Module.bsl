&НаКлиенте
Процедура ПрименитьДанныеСтраницыМультиотправкаГабариты(ИмяСтраницы)
	
	ПараметрыСтраницы   = ПараметрыДополнительнойПанели[ИмяСтраницы];
	ШаблонПредставления = "%1 х %2 х%3 | %4";
	
	УстановитьБлокировкуЭлементовФормы(ПараметрыСтраницы.Элемент, Истина);
	
	МультиотправкаПараметрыГрузаМаксимальнаяДлина  = МультиотправкаГабаритыДлина;
	МультиотправкаПараметрыГрузаМаксимальнаяШирина = МультиотправкаГабаритыШирина;
	МультиотправкаПараметрыГрузаМаксимальнаяВысота = МультиотправкаГабаритыВысота;
	МультиотправкаПараметрыГрузаМаксимальныйВес    = МультиотправкаГабаритыВес;
	
	МультиотправкаПараметрыГрузаГабаритыПредставление = СтрШаблон(ШаблонПредставления, МультиотправкаГабаритыДлина, МультиотправкаГабаритыШирина, МультиотправкаГабаритыВысота, МультиотправкаГабаритыВес);  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьТекущуюСтраницуДополнительнойПанели(Принудительно = Ложь)
	
	ИмяТекущейСтраницы = Элементы.ДополнительнаяПанельСтраницы.ТекущаяСтраница.Имя;
	
	УстановитьМодифицированностьСтраницы(ИмяТекущейСтраницы, Ложь);
	ПередЗакрытиемСтраницыДополнительнойПанели(ИмяТекущейСтраницы, Принудительно);
	
	Элементы.ДополнительнаяПанельСтраницы.ТекущаяСтраница = Элементы.Заглушка;
	Элементы.ДополнительнаяПанельСтраницы.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполненияДополнительнаяСтраницаПараметрыГруза()
	
	ДанныеКорректны  = Ложь;
	ГрузНегабаритный = ЭтоНегабаритныйГруз(ЭтаФорма, "ПараметрыГруза");
	НесколькоМест    = ПараметрыГрузаКоличествоМест > 1;
	
	Если Не ЗначениеЗаполнено(ПараметрыГрузаКоличествоМест) Тогда
		
		ВывестиСообщениеПользователю("Не указано количество мест", "ПараметрыГрузаКоличествоМест");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяДлина) Тогда
		
		ВывестиСообщениеПользователю("Не указана максимальная длина места", "ПараметрыГрузаМаксимальнаяДлина");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяДлинаЕдиница) Тогда
		
		ВывестиСообщениеПользователю("Не указана единица длины", "ПараметрыГрузаМаксимальнаяДлинаЕдиница");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяВысота) Тогда
		
		ВывестиСообщениеПользователю("Не указана максимальная высота места", "ПараметрыГрузаМаксимальнаяВысота");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяВысотаЕдиница) Тогда
		
		ВывестиСообщениеПользователю("Не указана единица высоты", "ПараметрыГрузаМаксимальнаяВысотаЕдиница");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяШирина) Тогда
		
		ВывестиСообщениеПользователю("Не указана максимальная ширина места", "ПараметрыГрузаМаксимальнаяШирина");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальнаяШиринаЕдиница) Тогда
		
		ВывестиСообщениеПользователю("Не указана единица ширины", "ПараметрыГрузаМаксимальнаяШиринаЕдиница");
		
	ИначеЕсли ПараметрыГрузаКоличествоМест > 1 И Не ЗначениеЗаполнено(ПараметрыГрузаМаксимальныйВес) Тогда
		
		ВывестиСообщениеПользователю("Не указан максимальный вес места", "ПараметрыГрузаМаксимальныйВес");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаОбщийВес) Тогда
		
		ВывестиСообщениеПользователю("Не указан общий вес груза", "ПараметрыГрузаОбщийВес");
		
	ИначеЕсли Не ЗначениеЗаполнено(ПараметрыГрузаОбщийОбъем) Тогда
		
		ВывестиСообщениеПользователю("Не указан общий объем груза", "ПараметрыГрузаОбщийОбъем");
		
	ИначеЕсли ГрузНегабаритный И НесколькоМест И Не ЗначениеЗаполнено(ПараметрыГрузаНегабаритныйВес) Тогда
		
		ВывестиСообщениеПользователю("Не указан вес негабаритной части груза", "ПараметрыГрузаНегабаритныйВес");
		
	ИначеЕсли ГрузНегабаритный И НесколькоМест И Не ЗначениеЗаполнено(ПараметрыГрузаНегабаритныйОбъем) Тогда
		
		ВывестиСообщениеПользователю("Не указан объем негабаритной части груза", "ПараметрыГрузаНегабаритныйОбъем");
		
	Иначе
		
		ДанныеКорректны = Истина;
		
	КонецЕсли; 
	
	Возврат ДанныеКорректны;
	
КонецФункции

