&НаКлиенте
Функция ЗапросВыполненУспешно(Результат)
	
	МаксимальныйКодУспешногоСтатуса = 299; // максимальный код успешного статуса HTTP ответа
	ЗапросВыполнен = Результат.КодСтатуса <= МаксимальныйКодУспешногоСтатуса; 
	
	Если НЕ ЗапросВыполнен Тогда
		
		ОбработатьОшибкиЗапроса(Результат);
		
	Иначе
		
		Результат.Данные = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		
	КонецЕсли; 
	
	Возврат ЗапросВыполнен;	
	
КонецФункции

&НаКлиенте
Функция ЗаголовокЗапросаМетода(Метод)
	
	МетодПубличный   = Метод.Свойство("Публичный") И Метод.Публичный;
	СтруктураЗапроса = ?(МетодПубличный, СтруктураЗапросаПоКлючуПриложения(), СтруктураЗапросаПоСессии());
	
	Если Метод.Свойство("Параметры") И ЗначениеЗаполнено(Метод.Параметры) Тогда
		
		Для Каждого ТекущийПараметр Из Метод.Параметры Цикл
			
			СтруктураЗапроса.Вставить(ТекущийПараметр.Ключ, ТекущийПараметр.Значение);
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Возврат СтруктураЗапроса;	
	
КонецФункции

