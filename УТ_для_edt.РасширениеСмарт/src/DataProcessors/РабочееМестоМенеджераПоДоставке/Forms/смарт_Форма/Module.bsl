#Область РаботаСТаблицами

&НаКлиенте
Функция НайтиСтрокуТаблицы(Таблица, Отбор)
	
	НайденнаяСтрока = Неопределено;
	СписокСтрок     = Таблица.НайтиСтроки(Отбор);
	
	Если СписокСтрок.Количество() Тогда
		
		НайденнаяСтрока = СписокСтрок[0];
		
	КонецЕсли; 
	
	Возврат НайденнаяСтрока;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуТаблицы(Таблица, Отбор)
	
	НайденнаяСтрока = НайтиСтрокуТаблицы(Таблица, Отбор);
	
	Если НайденнаяСтрока = Неопределено Тогда
		
		НайденнаяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НайденнаяСтрока, Отбор);
		
	КонецЕсли; 
	
	Возврат НайденнаяСтрока;	
	
КонецФункции

&НаКлиенте
Функция ПредставлениеТаблицы(Таблица, ИмяКолонки = "Представление", Разделитель = ", ")
	
	Представление = "";
	
	Для Каждого ТекущаяЗапись Из Таблица Цикл
		
		Представление = Представление + Разделитель + СокрЛП(ТекущаяЗапись[ИмяКолонки]);
		
	КонецЦикла;
	
	Возврат Сред(Представление, СтрДлина(Разделитель) + 1);
	
КонецФункции

&НаКлиенте
Процедура УдалитьСтрокиТаблицы(Таблица, Отбор)
	
	Для каждого Строка Из Таблица.НайтиСтроки(Отбор) Цикл
		
		Таблица.Удалить(Строка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ТаблицаВСписокСтруктур(Таблица, Колонки)
	
	СписокТаблицы    = Новый СписокЗначений;
	
	Для Каждого ДанныеСтроки Из Таблица Цикл
		
		СтруктураКолонок = Новый Структура(Колонки);
		ЗаполнитьЗначенияСвойств(СтруктураКолонок, ДанныеСтроки);
		СписокТаблицы.Добавить(СтруктураКолонок);
		
	КонецЦикла;
	
	Возврат СписокТаблицы;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруКолонокТаблицы(Таблица)
	
	СтруктураКолонок = Новый Структура;
	
	Для Каждого ТекущаяКолонка Из Таблица.Колонки Цикл
		
		СтруктураКолонок.Вставить(ТекущаяКолонка.Имя);
		
	КонецЦикла;
	
	Возврат СтруктураКолонок;

КонецФункции

