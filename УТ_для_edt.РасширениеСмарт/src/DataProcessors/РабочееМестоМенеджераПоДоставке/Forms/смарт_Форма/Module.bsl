&НаКлиентеНаСервереБезКонтекста
Функция АдресФайла(Каталог, Имя)
	
	Путь = СокрЛП(Каталог);
	ПоследнийСимвол = Прав(Путь, 1);
	
	Если ПоследнийСимвол = "/" ИЛИ ПоследнийСимвол = "\" Тогда
		
		Путь = Путь + Имя;
		
	Иначе
		
		Путь = Путь + ПолучитьРазделительПути() + Имя;
		
	КонецЕсли;
	
	Возврат Путь;
	
КонецФункции

&НаКлиенте
Процедура УстановитьМаркерУточненияПоиска(Приемник, Источник, Текст, МинимальноеКоличество = 10, МаксимальноеКоличество = 50)
	
	МаркерПродолжения   = "<ПРОДОЛЖИТЬПОИСК>";
	КоличествоЭлементов = Источник.Количество();
	
	Если КоличествоЭлементов > МинимальноеКоличество Тогда
		
		ТекстПредупреждения = "УТОЧНИТЬ СТРОКУ ПОИСКА";
		
		Если КоличествоЭлементов > МаксимальноеКоличество Тогда
			
			ТекстПредупреждения = ТекстПредупреждения + ": ОТОБРАЖЕНЫ ПЕРВЫЕ " + МаксимальноеКоличество;
			
		КонецЕсли;
		
		Приемник.Добавить(МаркерПродолжения + Текст, ТекстПредупреждения, , БиблиотекаКартинок.Найти);
		
	КонецЕсли;	
	
КонецПроцедуры

