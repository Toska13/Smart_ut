&НаСервере
Процедура ДобавитьСсылкуВСхемуСвязейДанных(Элемент, ОписаниеСправочника = Неопределено, Обработчики = Неопределено, Контейнер = Неопределено, ПараметрыВыбора = Неопределено, ИдентификаторИПредставлениеСовпадают = Ложь, ИмяЭлементаРодителя = Неопределено)
	
	Имя = Элемент.Имя;
	СтруктураДанных = Новый Структура;
	
	Если ИмяЭлементаРодителя = Неопределено Тогда
		
		ПутьКДанным = Элемент.ПутьКДанным;
		
	Иначе
		
		СтруктураДанных.Вставить("ИмяЭлементаРодителя", ИмяЭлементаРодителя);
		
		ПутьКДанным = СтрРазделить(Элемент.ПутьКДанным, ".");
		ДлинаПути   = ПутьКДанным.ВГраница();
		ПутьКДанным = ПутьКДанным[ДлинаПути];
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеСправочника) Тогда
		
		СтруктураДанных.Вставить("ИмяСправочника", ОписаниеСправочника.Имя);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контейнер) Тогда
		
		СтруктураДанных.Вставить("Контейнер", Контейнер);
		
	КонецЕсли; 
	
	Если ИдентификаторИПредставлениеСовпадают Тогда
		
		СтруктураДанных.Вставить("Значение",       ПутьКДанным);
		СтруктураДанных.Вставить("Представление",  ПутьКДанным);
		
	Иначе
		
		СтруктураДанных.Вставить("Значение",       СтрЗаменить(ПутьКДанным, "Представление", "Идентификатор"));
		СтруктураДанных.Вставить("Представление",  ПутьКДанным);
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПараметрыВыбора) Тогда
		
		СтруктураДанных.Вставить("ПараметрыВыбора", ПараметрыВыбора);
		
	КонецЕсли; 
	
	СхемаСвязейДанных.Вставить(Имя, СтруктураДанных);
	
	Если ЗначениеЗаполнено(Обработчики) Тогда
		
		Для Каждого ТекущийОбработчик Из Обработчики Цикл
			
			Элемент.УстановитьДействие(ТекущийОбработчик.Ключ, ТекущийОбработчик.Значение);
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСписокТелефоновВСхемуСвязейДанных(Элемент, ДобавитьРеквизитСписка = Истина, ИмяЭлементаРодителя = "")
	
	Если ЗначениеЗаполнено(ИмяЭлементаРодителя)  Тогда
		
		ПутьКДанным = СтрРазделить(Элемент.ПутьКДанным, ".");
		ДлинаПути   = ПутьКДанным.ВГраница();
		
		ПутьКДанным       = ПутьКДанным[ДлинаПути];
		ПутьКДаннымСписка = СтрЗаменить(ПутьКДанным, "Представление", "Список");
		
	Иначе 
		
		ПутьКДанным       = Элемент.ПутьКДанным;
		ПутьКДаннымСписка = СтрЗаменить(ПутьКДанным, "Представление", "Список");
		
		Если ДобавитьРеквизитСписка Тогда
			
			МассивРеквизитов = Новый Массив;
			МассивРеквизитов.Добавить(НовыйРеквизитФормы(ПутьКДаннымСписка, Новый ОписаниеТипов("ТаблицаЗначений")));
			МассивРеквизитов.Добавить(НовыйРеквизитФормы("Идентификатор",   Новый ОписаниеТипов("Строка"), ПутьКДаннымСписка));
			МассивРеквизитов.Добавить(НовыйРеквизитФормы("Основной",        Новый ОписаниеТипов("Строка"), ПутьКДаннымСписка));
			МассивРеквизитов.Добавить(НовыйРеквизитФормы("Добавочный",      Новый ОписаниеТипов("Строка"), ПутьКДаннымСписка));
			МассивРеквизитов.Добавить(НовыйРеквизитФормы("Представление",   Новый ОписаниеТипов("Строка"), ПутьКДаннымСписка));
			
			ИзменитьРеквизиты(МассивРеквизитов);
			
        КонецЕсли;
        //++ смарт:Подкин # 18.05.2022 15:44:04   
        Если ЗначениеЗаполнено(ЭтаФорма.МультиотправкаОтправительТелефоныПредставление) И
            НЕ ЭтаФорма.МультиотправкаОтправительТелефоныСписок.Количество() Тогда
            НСтрока=ЭтаФорма.МультиотправкаОтправительТелефоныСписок.Добавить();
            НСтрока.Идентификатор="";
            НСтрока.Основной=ЭтаФорма.МультиотправкаОтправительТелефоныПредставление;              
            НСтрока.Добавочный="";
            НСтрока.Представление=ЭтаФорма.МультиотправкаОтправительТелефоныПредставление;
        КонецЕсли;
