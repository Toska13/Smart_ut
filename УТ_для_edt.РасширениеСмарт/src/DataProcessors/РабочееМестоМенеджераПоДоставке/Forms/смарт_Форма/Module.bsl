// Функция формирует структуру данных заказа по данным формы, отправляет запрос на сервис и получает ИД созданного заказа.
//
// Параметры:
//	Контейнер - Строка - обобщенное имя, с которого начинаются имена необходимых реквизитов формы.
//	РежимМультиотправки - Булево - частный случай, когда часть данных заказа располагается в строке табличной части.
//	СтрокаДанных - ДанныеФормыЭлементКоллекции - строка, содержащая данные заказа при режиме мультиотправки.
//	МультиотправкаОтТерминала - Булево - признак того, что заказы буду формироваться как черновики (поле inOrder пакета).
//
// Возвращаемое значение:
//	Строка - идентификатор созданного заказа, в случае ошибки - пустая строка
//
&НаКлиенте
Функция СоздатьЗаказНаДоставкуОтАдреса(Контейнер, РежимМультиотправки = Ложь, СтрокаДанных = Неопределено, МультиотправкаОтТерминала = Ложь)
	
	ОбщийЗапрос = СтруктураЗапросаПоСессии();
	ОбщийЗапрос.Вставить("whoIsPayer", Новый Массив);
	СписокУслуг = Новый Массив;
	
	ПлательщикУслугиОтАдреса = "";
	ПлательщикУслугиДоАдреса = "";
	ОсновнойПлательщик       = "";
		
	Если Не РежимМультиОтправки Тогда
		ТекущаяТаблица = ЗначениеРеквизитаФормы(Контейнер + "ПараметрыОплатыПлательщикиСписок");
	Иначе
		ТекущаяТаблица = СтрокаДанных.ПараметрыОплатыСписок;
	КонецЕсли;

	Для Каждого ТекПлательщик Из ТекущаяТаблица Цикл
		
		ИдентификаторПлательщика = НайтиПоИдентификатору("ВидыПлательщиков", ТекПлательщик.ПлательщикИдентификатор, "Порядок");
		
		Если ОбщийЗапрос.whoIsPayer.Найти(ИдентификаторПлательщика) = Неопределено Тогда
			ОбщийЗапрос.whoIsPayer.Добавить(ИдентификаторПлательщика);
		КонецЕсли;
		
		Если ТекПлательщик.ГруппаИдентификатор = "УслугиМежтерминальные" ИЛИ ТекПлательщик.ГруппаИдентификатор = "" Тогда
			ОсновнойПлательщик = ИдентификаторПлательщика;
		КонецЕсли;
		
		Если ТекПлательщик.ГруппаИдентификатор = "УслугиОтАдреса" Тогда
			ПлательщикУслугиОтАдреса = ИдентификаторПлательщика;
		КонецЕсли;
		
		Если ТекПлательщик.ГруппаИдентификатор = "УслугиДоАдреса" Тогда
			ПлательщикУслугиДоАдреса = ИдентификаторПлательщика;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ПлательщикУслугиОтАдреса) Тогда
		ПлательщикУслугиОтАдреса = ОсновнойПлательщик;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПлательщикУслугиДоАдреса) Тогда
		ПлательщикУслугиДоАдреса = ОсновнойПлательщик;
	КонецЕсли;
	
	ПараметрыПеревозки 	= ЗначениеРеквизитаФормы(Контейнер + "ПараметрыПеревозкиДатаВремя");
	
	Если Не РежимМультиОтправки Тогда
		ВремяДоставки		= ЗначениеРеквизитаФормы(Контейнер + "ВремяДоставки");
	Иначе
		ВремяДоставки 		= Новый Структура("РежимРаботыНачало, РежимРаботыОкончание, ПерерывНачало, ПерерывОкончание", 
											Дата('00010101000100'), Дата('00010101235900'), Дата('00010101000100'), Дата('00010101000100'));
	КонецЕсли;
	
	// Отправитель
	
	ЛокальныйКонтейнер       = Контейнер + "Отправитель";
	СтруктураОтправителя     = Новый Структура;
	Контрагент               = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "КонтрагентИдентификатор");
	СтруктураАдреса          = СтруктураАдресаИзКонтейнера(ЛокальныйКонтейнер);
	СписокТелефонов          = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "ТелефоныСписок");
	СписокКонтактов          = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "КонтактныеЛицаСписок");
	СтруктураИдентификаторов = СоздатьАдресКонтрагента(Контрагент, СтруктураАдреса, СписокТелефонов, СписокКонтактов);
	СпособОтправитель 		 = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "Способ"); 
	СообщениеОбОшибках       = "";
	
	Если ЗначениеЗаполнено(СтруктураИдентификаторов.Идентификатор) Тогда
		
		СтруктураОтправителя.Вставить("counteragentID", Контрагент);
		СтруктураОтправителя.Вставить("addressID",      СтруктураИдентификаторов.Идентификатор);
		СтруктураОтправителя.Вставить("phones",         МассивИдентификаторовКонтактнойИнформации(СтруктураИдентификаторов.Телефоны, СообщениеОбОшибках, "телефона"));
		СтруктураОтправителя.Вставить("contacts",       МассивИдентификаторовКонтактнойИнформации(СтруктураИдентификаторов.КонтактныеЛица, СообщениеОбОшибках, "контактного лица"));
		СтруктураОтправителя.Вставить("worktimeStart",  Формат(ПараметрыПеревозки.РежимРаботыНачало, "ДФ=ЧЧ:мм"));
		СтруктураОтправителя.Вставить("worktimeEnd",    Формат(ПараметрыПеревозки.РежимРаботыОкончание, "ДФ=ЧЧ:мм"));
		СтруктураОтправителя.Вставить("breakStart",     Формат(ПараметрыПеревозки.ПерерывНачало, "ДФ=ЧЧ:мм"));
		СтруктураОтправителя.Вставить("breakEnd",       Формат(ПараметрыПеревозки.ПерерывОкончание, "ДФ=ЧЧ:мм"));
	
	Иначе
		СообщениеОбОшибках = СообщениеОбОшибках + Символы.ПС + "Не удалось получить идентификатор адреса контрагента """ + ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "КонтрагентПредставление") + """";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеОбОшибках) Тогда
		ВывестиСообщениеПользователю(СообщениеОбОшибках);
		Возврат "";
	КонецЕсли; 	
	
	// УслугиПРР Отправитель
	Если СпособОтправитель <> "Терминал" Тогда
	
		СписокУслугПРР = Новый Массив;
		Если Не РежимМультиОтправки Тогда
			ТекущаяТаблица = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "УслугиПРРСписок");
			
			Для Каждого ТекУслуга Из ТекущаяТаблица Цикл
				
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("uid", ТекУслуга.Идентификатор);
				Если ЗначениеЗаполнено(ТекУслуга.Значение) Тогда
					СтруктураДанных.Вставить("value", ФОрмат(ТекУслуга.Значение, "ЧРД=.; ЧГ="));
				КонецЕсли; 
				СписокУслугПРР.Добавить(СтруктураДанных);
				
			КонецЦикла;
			Если СписокУслугПРР.Количество() Тогда
				СтруктураОтправителя.Вставить("loadUnload", СписокУслугПРР);
				СписокУслуг.Добавить(Новый Структура("service, payer", "3", ПлательщикУслугиДоАдреса));
			КонецЕсли;
			
		КонецЕсли;
			
		// ТребованияКТС Отправитель
		
		Если Не РежимМультиОтправки Тогда
			ТекущаяТаблица = ЛокальныйКонтейнер + "ТребованияКТССписок";
		Иначе
			ТекущаяТаблица = Контейнер + "ТребованияКТССписок";
		КонецЕсли;
		СтруктураЗапросаДобавитьТребованияКТС(СтруктураОтправителя, ТекущаяТаблица);

	КонецЕсли;
	
	ОбщийЗапрос.Вставить("sender", СтруктураОтправителя);
	
	// Получатель
	
	ЛокальныйКонтейнер       = Контейнер + "Получатель";
	СтруктураПолучателя      = Новый Структура;
	Если Не РежимМультиотправки Тогда
		Контрагент               = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "КонтрагентИдентификатор");
		КонтрагентПредставление	 = ЗначениеРеквизитаФормы(ЛокальныйКонтейнер + "КонтрагентПредставление");
		СтруктураАдреса          = СтруктураАдресаИзКонтейнера(ЛокальныйКонтейнер);
