&НаКлиентеНаСервереБезКонтекста
Процедура РазложитьСтрокуПоРазделителю(Знач ИсходнаяСтрока, Разделитель, ЗаполнятьБезРазделителя = "", ПервоеПоле, ВтороеПоле)
	
	СмещениеВПраво     = СтрДлина(Разделитель);
	ПозицияРазделителя = СтрНайти(ИсходнаяСтрока, Разделитель);
	
	Если ПозицияРазделителя > 0 Тогда
		
		ПервоеПоле = Лев(ИсходнаяСтрока,  ПозицияРазделителя - 1);
		ВтороеПоле = Сред(ИсходнаяСтрока, ПозицияРазделителя + СмещениеВПраво);
		
	ИначеЕсли ЗаполнятьБезРазделителя = "Первое" Тогда
		
		ПервоеПоле = ИсходнаяСтрока;
		
	ИначеЕсли ЗаполнятьБезРазделителя = "Второе" Тогда
		
		ВтороеПоле = ИсходнаяСтрока;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СтруктураИнтернетАдреса(Знач ИнтернетАдрес)
	
	ИнтернетАдрес        = СокрЛП(ИнтернетАдрес);
	ПараметрыАвторизации = "";
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Протокол",     "");
	СтруктураДанных.Вставить("ИмяСервера",   "");
	СтруктураДанных.Вставить("Хост",         "");
	СтруктураДанных.Вставить("Порт", 	     "");
	СтруктураДанных.Вставить("Логин",        "");
	СтруктураДанных.Вставить("Пароль",       "");
	СтруктураДанных.Вставить("АдресРесурса", "");
	
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "://", "Второе", СтруктураДанных.Протокол, ИнтернетАдрес);                // выделяем протокол из адреса
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "/",   "Первое", ИнтернетАдрес, СтруктураДанных.АдресРесурса);            // выделяем адрес ресурса на сервере
	РазложитьСтрокуПоРазделителю(ИнтернетАдрес, "@",   "Второе", ПараметрыАвторизации, СтруктураДанных.ИмяСервера);       // выделяем имя сервера и параметры авторизации
	РазложитьСтрокуПоРазделителю(ПараметрыАвторизации, ":", "Первое",  СтруктураДанных.Логин, СтруктураДанных.Пароль);    // раскладываем параметры авторизации на поля
	РазложитьСтрокуПоРазделителю(СтруктураДанных.ИмяСервера, ":", "Первое", СтруктураДанных.Хост, СтруктураДанных.Порт);  // раскладываем имя сервера на поля
	
	Если ЗначениеЗаполнено(СтруктураДанных.Порт) Тогда
		
		СтруктураДанных.Порт = Число(СтруктураДанных.Порт);
		
	Иначе
		
		СтруктураДанных.Порт = Неопределено;
		
	КонецЕсли; 
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйИнтернетПрокси(ПараметрыПроксиСервера)
	
	Прокси = Новый ИнтернетПрокси;
	
	Если ЗначениеЗаполнено(ПараметрыПроксиСервера) Тогда
		
		СтруктураПараметров = СтруктураИнтернетАдреса(ПараметрыПроксиСервера);
		
		Прокси.Установить("https", СтруктураПараметров.Хост, СтруктураПараметров.Порт, СтруктураПараметров.Логин, СтруктураПараметров.Пароль);
		Прокси.Установить("http", СтруктураПараметров.Хост, СтруктураПараметров.Порт, СтруктураПараметров.Логин, СтруктураПараметров.Пароль);
		
		
	КонецЕсли;
	
	Возврат Прокси;
	
КонецФункции

