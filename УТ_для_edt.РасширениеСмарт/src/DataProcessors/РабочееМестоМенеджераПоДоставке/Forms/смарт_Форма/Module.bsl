&НаКлиенте
Функция НайтиНаселенныйПунктПоИдентификатору(Идентификатор)
	
	СтруктураДанных = Неопределено;
	
	СтруктураЗапроса = СтруктураЗапросаПоКлючуПриложения();
	СтруктураЗапроса.Вставить("cityID", Идентификатор);
	СтруктураЗапроса.Вставить("limit",  1);
	
	Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.ПодборГородовПоСтроке, СтруктураЗапроса);
	
	Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
		
		СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
		СписокГородов   = ПрочитатьЗначениеПоляКакМассив(СтруктураОтвета, "cities");
		
		Если СписокГородов.Количество() Тогда
			
			ДанныеТекущегоГорода = СписокГородов[0];
			
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("Идентификатор", ПолучитьЗначениеПоля(ДанныеТекущегоГорода, "cityID"));
			СтруктураДанных.Вставить("Наименование",  ПолучитьЗначениеПоля(ДанныеТекущегоГорода, "aString"));
			СтруктураДанных.Вставить("КодКЛАДР",      ПолучитьЗначениеПоля(ДанныеТекущегоГорода, "code"));
			
		КонецЕсли; 
		
	Иначе
		
		ОбработатьОшибкиЗапроса(Результат);
		ВывестиСообщениеПользователю(Результат.Данные);
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

