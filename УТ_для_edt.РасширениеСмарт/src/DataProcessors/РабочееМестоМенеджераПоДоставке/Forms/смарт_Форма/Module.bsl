&НаКлиенте
Функция ПолучитьДанныеМеста(Данные)
	
	СтруктураДанных = Новый Структура;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		
		СтруктураДанных.Вставить("Город",                 ПолучитьЗначениеПоля(Данные, "city",           	""));
		СтруктураДанных.Вставить("Адрес",                 ПолучитьЗначениеПоля(Данные, "address",        	""));
		СтруктураДанных.Вставить("КЛАДРГород",            ПолучитьЗначениеПоля(Данные, "city_code",       	""));
		СтруктураДанных.Вставить("КЛАДРУлица",            ПолучитьЗначениеПоля(Данные, "address_code",    	""));
		СтруктураДанных.Вставить("Терминал",              ПолучитьЗначениеПоля(Данные, "terminal_name",   	""));
		СтруктураДанных.Вставить("ТерминалАдрес",         ПолучитьЗначениеПоля(Данные, "terminal_address",	""));
		СтруктураДанных.Вставить("ТерминалИдентификатор", ПолучитьЗначениеПоля(Данные, "terminal_id",     	""));
		
	Иначе
		
		СтруктураДанных.Вставить("Город",                 "");
		СтруктураДанных.Вставить("Адрес",                 "");
		СтруктураДанных.Вставить("КЛАДРГород",            "");
		СтруктураДанных.Вставить("КЛАДРУлица",            "");
		СтруктураДанных.Вставить("Терминал",              "");
		СтруктураДанных.Вставить("ТерминалАдрес",         "");
		СтруктураДанных.Вставить("ТерминалИдентификатор", "");
		
	КонецЕсли;
	
	Возврат СтруктураДанных;
	
КонецФункции

