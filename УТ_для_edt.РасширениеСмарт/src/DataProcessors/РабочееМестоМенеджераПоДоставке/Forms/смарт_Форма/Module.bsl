&НаКлиенте
Функция ЗаписьНеСоответствуетПараметрамВыбора(Запись, ПараметрыВыбора, Текст = Неопределено, Поле = "Наименование")
	
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(ПараметрыВыбора) Тогда
		
		Для Каждого ТекущийПараметр Из ПараметрыВыбора Цикл
			
			Если Запись[ТекущийПараметр.Ключ] <> ТекущийПараметр.Значение Тогда
				
				Результат = Истина;
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не Результат И ЗначениеЗаполнено(Текст) Тогда
		
		Результат = СтрНайти(НРег(Запись[Поле]), НРег(Текст)) = 0;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПараметрыВыбораЭлемента(Элемент)
	
	СхемаДанных     = СхемаДанныхЭлемента(Элемент);
	ПараметрыВыбора = Неопределено;
	
	Если СхемаДанных.Свойство("ПараметрыВыбора") И ЗначениеЗаполнено(СхемаДанных.ПараметрыВыбора) Тогда
		
		ПараметрыВыбора = Новый Структура;
		
		Для Каждого ТекущийПараметр Из СхемаДанных.ПараметрыВыбора Цикл
			
			// Ограничение:
			// Считаем, что если в качестве значения параметра указана строка - это имя реквизита формы,
			// иначе - это уже конечное значение
			
			Значение = ?(ТипЗнч(ТекущийПараметр.Значение) = Тип("Строка"), ЗначениеРеквизитаФормы(ТекущийПараметр.Значение), ТекущийПараметр.Значение); 
			ПараметрыВыбора.Вставить(ТекущийПараметр.Ключ, Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ПараметрыВыбора;
	
КонецФункции

&НаКлиенте
Функция СписокВыбораСправочника(ОписаниеСправочника, ПараметрыВыбора = Неопределено, Текст = Неопределено, Поле = "Наименование")
	
	ИмяСправочника  = ?(ТипЗнч(ОписаниеСправочника) = Тип("Структура"), ОписаниеСправочника.Имя, ОписаниеСправочника);
	СписокВыбора    = Новый СписокЗначений;
	Таблица         = ХранилищеДанныхКлиент[ИмяСправочника].Таблица;
	
	Для Каждого ЗаписьТаблицы Из Таблица Цикл
		
		ДанныеТаблицы = ЗаписьТаблицы.Значение;
		
		Если ЗаписьНеСоответствуетПараметрамВыбора(ДанныеТаблицы, ПараметрыВыбора, Текст, Поле) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		СписокВыбора.Добавить(ЗаписьТаблицы.Ключ, ДанныеТаблицы.Наименование);
		
	КонецЦикла;
	
	СписокВыбора.СортироватьПоПредставлению();
	
	Возврат СписокВыбора;	
	
КонецФункции

&НаКлиенте
Функция ТребуетсяКэшированиеДанныхСправочника(ОписаниеСправочника)
	
	// Кэширование данных требуется только для справочников,
	// храняшихся на сервере или виртуальных (т.е. справочников таблицы,
	// которых не хранятся постоянно в памяти)
	
	Источник             = ОписаниеСправочника.Источник;
	Хранилище            = ОписаниеСправочника.Хранилище;
	ТребуетсяКэширование = Хранилище.Расположение = "Сервер" или Источник.Тип = "Виртуальный";
	
	Возврат ТребуетсяКэширование;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокРеквизитовСправочника(ОписаниеСправочника)
	
	// Каждый справочник имеет стандартные реквизиты: Идентификатор, Наименование
	// Остальные реквизиты получим из описания справочника
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("Идентификатор");
	Реквизиты.Добавить("Наименование");
	
	Для Каждого ОписаниеРеквизита Из ОписаниеСправочника.Реквизиты Цикл
		
		Реквизиты.Добавить(ОписаниеРеквизита.Ключ);
		
	КонецЦикла;
	
	Возврат СтрСоединить(Реквизиты, ",");
	
КонецФункции

&НаКлиенте
Функция НайтиПоИдентификатору(Источник, Идентификатор, Поля, ВсегдаВозвращатьСтруктуру = Ложь)
	
	КэшДанныхИсточника   = ПолучитьКэшДанныхИсточника(Источник);
	ТребуетсяКэширование = КэшДанныхИсточника.Параметры.КэшироватьДанные;
	СписокРеквизитов     = КэшДанныхИсточника.Параметры.Поля;                 
	Данные               = КэшДанныхИсточника.Данные[Идентификатор];
	
	Если Данные = Неопределено Тогда
		
		// Если данных в кэше нет и при этом кэширование не требуется (т.е. кэш ссылается на саму таблицу справочника) -
		// значит мы не смогли найти данные по идентификатору и нужно вернуть битую ссылку (или пустую если передан пустой id).
		// Если кэширование требуется - необходимо выполнить попытку получения данных по id
		
		Если Не ТребуетсяКэширование Тогда
			
			// тут ничего делать не требуется
			
		ИначеЕсли Источник = "НаселенныеПункты" Тогда
			
			Данные = НайтиНаселенныйПунктПоИдентификатору(Идентификатор); 
			
		ИначеЕсли Источник = "Улицы" Тогда
			
			Данные = НайтиУлицуПоИдентификатору(Идентификатор);
			
		Иначе 
			
			// если это не виртуальные справочники - значит данных хранятся на сервере - получим их 
			Данные = НайтиДанныеПоИдентификаторуНаСервере(КоллекцияМетаданные.Справочники[Источник].Хранилище.Адрес, Идентификатор, КэшДанныхИсточника.Параметры.Поля, Истина);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Данные) Тогда
			
			Если ТребуетсяКэширование Тогда
				
				КэшДанныхИсточника.Данные.Вставить(Идентификатор, Данные);
				
			КонецЕсли; 
			
		ИначеЕсли ЗначениеЗаполнено(Идентификатор) Тогда
			
			Данные = Новый Структура(СписокРеквизитов);
			Данные.Наименование = "<Объект не найден (id: " + Идентификатор + ")>";
			
		Иначе
			
			Данные = Новый Структура(СписокРеквизитов);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура(Поля);
	ЗаполнитьЗначенияСвойств(Результат, Данные);
	
	Если НЕ ВсегдаВозвращатьСтруктуру И Результат.Количество() = 1 Тогда
		
		Результат = Результат[Поля];
		
	КонецЕсли; 
	
	Возврат Результат;	
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиПоРеквизитуНаСервере(Адрес, ИмяРеквизита, Значение)

	Таблица   = ПолучитьИзВременногоХранилища(Адрес);
	Результат = ПолучитьСтруктуруКолонокТаблицы(Таблица);
	
	НайденнаяСтрока = Таблица.Найти(Значение, ИмяРеквизита);
	
	Если НайденнаяСтрока <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, НайденнаяСтрока);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция НайтиПоРеквизиту(Источник, ИмяРеквизита, Значение)

	ОписаниеСправочника = КоллекцияМетаданные.Справочники[Источник];
	Расположение        = ОписаниеСправочника.Хранилище.Расположение;
	Результат           = Неопределено;
	
	Если Расположение = "Клиент" Тогда
		
		Таблица    = ХранилищеДанныхКлиент[Источник].Таблица;
		Результат  = Новый Структура(ПолучитьСписокРеквизитовСправочника(ОписаниеСправочника));
		Количество = 0;
		
		Для Каждого Запись Из Таблица Цикл
			
			Если ЗначениеЭлементаСтруктуры(Запись.Значение, ИмяРеквизита) = Значение Тогда
				
				ЗаполнитьЗначенияСвойств(Результат, Запись.Значение);
				Прервать;

			КонецЕсли;

		КонецЦикла;
		
	Иначе

		Результат = НайтиПоРеквизитуНаСервере(ОписаниеСправочника.Хранилище.Адрес, ИмяРеквизита, Значение);

	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция НайтиДанныеПоИдентификаторуНаСервере(Источник, Идентификатор, Поля, ВсегдаВозвращатьСтруктуру = Ложь)
	
	Таблица   = ПолучитьИзВременногоХранилища(Источник);
	Результат = Новый Структура(Поля);
	
	НайденнаяЗапись = Таблица.Найти(Идентификатор, "Идентификатор");
	
	Если НайденнаяЗапись <> Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(Результат, НайденнаяЗапись);
		
	КонецЕсли; 
	
	Если НЕ ВсегдаВозвращатьСтруктуру И Результат.Количество() = 1 Тогда
		
		Результат = Результат[Поля];
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПредопределенныйЭлемент(Знач ИмяПредопределенногоЭлемента)
	
	// Ограничение: Считаем, что предопределенные элементы
	// могут быть только у справочников, хранящихся на клиенте
	
	ИмяПредопределенногоЭлемента           = НРег(ИмяПредопределенногоЭлемента);
	ИдентификаторПредопределенногоЭлемента = КэшПредопределенныхЭлементов[ИмяПредопределенногоЭлемента];
	
	Если ИдентификаторПредопределенногоЭлемента = Неопределено Тогда
		
		СоставИмени = СтрРазделить(ИмяПредопределенногоЭлемента, ".");
		ИмяОбъекта  = СоставИмени[1];
		ИмяЭлемента = СоставИмени[2];
		
		Если ИмяОбъекта = "статусызаказов" Тогда
			
			КэшПредопределенныхЭлементов.Вставить("справочник.статусызаказов.завершен", "finished");
			КэшПредопределенныхЭлементов.Вставить("справочник.статусызаказов.отклонен", "declined");
			
			ИдентификаторПредопределенногоЭлемента = КэшПредопределенныхЭлементов[ИмяПредопределенногоЭлемента];
			
		Иначе
			
			Таблица     = ХранилищеДанныхКлиент[ИмяОбъекта].Таблица;
			
			Для Каждого ДанныеСтроки Из Таблица Цикл
				
				Если ИмяЭлемента = НРег(ДанныеСтроки.Значение.ИмяПредопределенного) Тогда
					
					ИдентификаторПредопределенногоЭлемента = ДанныеСтроки.Ключ;
					КэшПредопределенныхЭлементов.Вставить(ИмяПредопределенногоЭлемента, ИдентификаторПредопределенногоЭлемента);
					Прервать;
					
				КонецЕсли; 
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ИдентификаторПредопределенногоЭлемента = Неопределено Тогда
		
		ВызватьИсключение("Не удалось найти предопределенный элемент """ + ИмяПредопределенногоЭлемента + """");
		
	КонецЕсли;
	
	Возврат ИдентификаторПредопределенногоЭлемента;
	
КонецФункции

&НаКлиенте
Функция КоэффициентЕдиницыИзмерения(Единица)
	
	ДанныеЕдиницыИзмерения = НайтиПоИдентификатору("ЕдиницыИзмерения", Единица, "Идентификатор, Коэффициент");
	
	Если ЗначениеЗаполнено(ДанныеЕдиницыИзмерения) Тогда
		
		Единица     = ДанныеЕдиницыИзмерения.Идентификатор;
		Коэффициент = ДанныеЕдиницыИзмерения.Коэффициент;
		
	Иначе
		
		Единица     = "м";
		Коэффициент = 1;
		
	КонецЕсли; 
	
	Возврат Коэффициент;
	
КонецФункции

