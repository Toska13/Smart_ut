	Коэффициент        = КоэффициентЕдиницыИзмерения(Источник[ИмяЕдиницыГабарита]);
	Значение           = Окр(Источник[ИмяГабарита] * Коэффициент, 2); // точность базовый единицы 2 знака после запятой
	
	Возврат Значение;
	
