#Область ДатаИВремя

&НаКлиенте
Процедура ПередОткрытиемСтраницыДатаИВремя(ИмяСтраницы, Элемент, ПараметрыСтраницы)
	
	УстановитьМодифицированностьСтраницы(ИмяСтраницы);
	Элемент.Доступность = Ложь;
	СтруктураДанных    = Новый Структура("ДатаИВремяДата, ДатаИВремяРежимРаботыНачало, ДатаИВремяРежимРаботыОкончание, ДатаИВремяПерерывНачало, ДатаИВремяПерерывОкончание, ДатаИВремяФиксированноеВремя");
	СтруктураИсточника = СкопироватьСтруктуруСПрефиксом(ПараметрыСтраницы, "ДатаИВремя");
	
	ЗаполнитьЗначенияСвойств(СтруктураДанных, СтруктураИсточника);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураДанных);
	
	// определяем видимость полей в зависимости от наличия соответствующих свойств в параметрах страницы
	
	Элементы.ДатаИВремяДата.Видимость               = СтруктураИсточника.Свойство("ДатаИВремяДата");
	Элементы.ДатаИВремяФиксированноеВремя.Видимость = СтруктураИсточника.Свойство("ДатаИВремяФиксированноеВремя");
	
	ДатаИВремяОбновитьФиксированноеВремя();	
	ЗаписатьПараметрыТекущейСтраницы(ИмяСтраницы, Элемент, ПараметрыСтраницы);
	
КонецПроцедуры // ПередОткрытиемСтраницы

&НаКлиенте
Процедура ДатаИВремяОбновитьФиксированноеВремя()
	
	Элементы.ДатаИВремяПерерывНачало.Доступность        = Не ДатаИВремяФиксированноеВремя;
	Элементы.ДатаИВремяПерерывОкончание.Доступность     = Не ДатаИВремяФиксированноеВремя;
	Элементы.ДатаИВремяРежимРаботыОкончание.Доступность = Не ДатаИВремяФиксированноеВремя;
	
	Если ДатаИВремяФиксированноеВремя Тогда
		
		ДатаИВремяПерерывНачало        = '00010101'; // очистим значения интервала перерыва,
		ДатаИВремяПерерывОкончание     = '00010101'; // так как режим работы будет ограничен по времени
		ИнтервалРежимаРаботы           = 1800;       // интервал режима работы должен составлять 30 минут (1800 сек)
		
		ДатаИВремяРежимРаботыОкончание = ДатаИВремяРежимРаботыНачало + ИнтервалРежимаРаботы; 
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Функция СкопироватьСтруктуруСПрефиксом(Источник, Префикс, УдалятьПрефикс = Ложь)
	
	Приемник     = Новый Структура;
	ПозицияИмени = СтрДлина(Префикс) + 1;
	
	Для Каждого Элемент из Источник Цикл
		
		ТекущийКлюч = Элемент.Ключ;
		НовыйКлюч   = ?(УдалятьПрефикс, Сред(ТекущийКлюч, ПозицияИмени), Префикс + ТекущийКлюч);
		
		Приемник.Вставить(НовыйКлюч, Элемент.Значение);
		
	КонецЦикла;
	
	Возврат Приемник;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеСтраницаДатаИВремя(ИмяСтраницы, ДанныеПроверки)
	
	ПараметрыСтраницы  = ПараметрыДополнительнойПанели[ИмяСтраницы];
	Элемент            = ПараметрыСтраницы.Элемент;
	СтруктураПриемника = Новый Структура;
	СтруктураПриемника.Вставить("Дата",                 ДатаИВремяДата);
	СтруктураПриемника.Вставить("РежимРаботыНачало",    ДатаИВремяРежимРаботыНачало);
	СтруктураПриемника.Вставить("РежимРаботыОкончание", ДатаИВремяРежимРаботыОкончание);
	СтруктураПриемника.Вставить("ПерерывНачало",        ДатаИВремяПерерывНачало);
	СтруктураПриемника.Вставить("ПерерывОкончание",     ДатаИВремяПерерывОкончание);
	СтруктураПриемника.Вставить("ФиксированноеВремя",   ДатаИВремяФиксированноеВремя);
	
	ЗаполнитьЗначенияСвойств(ПараметрыСтраницы.Параметры, СтруктураПриемника);
	УстановитьЗначениеРеквизитаФормы(Элемент.Имя, ПредставлениеСтруктурыВремени(ПараметрыСтраницы.Параметры));
	Элемент.Доступность = Истина;
	ПриИзмененииДанныхЭлемента(Элемент);
	
КонецПроцедуры // ОбработатьДанныеСтраницы    

&НаКлиенте
Функция ПроверкаЗаполненияДополнительнаяСтраницаДатаВремя()
	
	Результат        = Ложь;
	ПроверятьДату    = Элементы.ДатаИВремяДата.Видимость;
	ПроверятьПерерыв = ЗначениеЗаполнено(ДатаИВремяПерерывНачало) ИЛИ ЗначениеЗаполнено(ДатаИВремяПерерывОкончание);
	
	Если ПроверятьДату И Не ЗначениеЗаполнено(ДатаИВремяДата) Тогда
		
		ВывестиСообщениеПользователю("Не указана дата", "ДатаИВремяДата", Истина);
		
	ИначеЕсли Не ЗначениеЗаполнено(ДатаИВремяРежимРаботыНачало) Тогда
		
		ВывестиСообщениеПользователю("Не указано время начала работы", "ДатаИВремяРежимРаботыНачало", Истина);
		
	ИначеЕсли Не ЗначениеЗаполнено(ДатаИВремяРежимРаботыОкончание) Тогда
		
		ВывестиСообщениеПользователю("Не указано время окончания работы", "ДатаИВремяРежимРаботыОкончание", Истина);
		
	ИначеЕсли ПроверятьПерерыв И Не ЗначениеЗаполнено(ДатаИВремяПерерывНачало) Тогда
		
		ВывестиСообщениеПользователю("Не указано время начала перерыва", "ДатаИВремяПерерывНачало", Истина);
		
	ИначеЕсли ПроверятьПерерыв И Не ЗначениеЗаполнено(ДатаИВремяПерерывОкончание) Тогда
		
		ВывестиСообщениеПользователю("Не указано время окончания перерыва", "ДатаИВремяПерерывОкончание", Истина);
		
	Иначе
		
		Результат = Истина;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#Область ОбработчикиСобытийЭлементовТаблицыФормыАдреснаяКнигаКонтрагентыСписокВыбора

&НаКлиенте
Процедура АдреснаяКнигаКонтрагентыСписокВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПараметрыСтраницы = ПараметрыДополнительнойПанели["АдреснаяКнигаСписокВыбора"];
	РежимСтраницы     = ПараметрыСтраницы.Параметры;
	
	Если РежимСтраницы = "ВыборКонтрагента" Тогда
		
		ПриВыбореКонтрагентаВСпискеВыбораАдреснойКниги(ПараметрыСтраницы.Элемент, ВыбраннаяСтрока);
		
	ИначеЕсли РежимСтраницы = "ВыборАдреса" Тогда
		
		АдресаКонтрагента.Очистить();
		
		Если ВыбраннаяСтрока = Неопределено Тогда
			
			ВывестиСообщениеПользователю("Выберите контрагента");
			
		Иначе
			
			ДанныеСтроки = АдреснаяКнига.НайтиПоИдентификатору(ВыбраннаяСтрока);
			
			Если ДанныеСтроки = Неопределено Тогда
				
				ВывестиСообщениеПользователю("Выберите контрагента");
				
			Иначе
				
				ПолучитьАдресаКонтрагента(ДанныеСтроки.Идентификатор, , АдресаКонтрагента);
				
				Если Не Элементы.АдреснаяКнигаСписокВыбораАдреса.Видимость Тогда
					
					Элементы.АдреснаяКнигаСписокВыбораАдреса.Видимость = Истина;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореКонтрагентаВСпискеВыбораАдреснойКниги(Элемент, ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		
		ВывестиСообщениеПользователю("Выберите контрагента");
		
	Иначе
		
		ДанныеСтроки = АдреснаяКнига.НайтиПоИдентификатору(ВыбраннаяСтрока);
		
		Если ДанныеСтроки = Неопределено Тогда
			
			ВывестиСообщениеПользователю("Выберите контрагента");
			
		Иначе
			
			СхемаДанных = СхемаСвязейДанных[Элемент.Имя];
			УстановитьЗначениеРеквизитаФормы(СхемаДанных, ДанныеСтроки.Идентификатор, ДанныеСтроки.Наименование);
			ЗакрытьТекущуюСтраницуДополнительнойПанели();
			ПриИзмененииДанныхЭлемента(Элемент);				
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура АдреснаяКнигаСписокВыбораДобавить(Команда)
	
	СохранитьИВыбратьКонтрагента = Истина;
	
	Если МодифицированностьДанныхДополнительнойПанели.Свойство("АдреснаяКнигаСписокВыбора") Тогда
		
		МодифицированностьДанныхДополнительнойПанели["АдреснаяКнигаСписокВыбора"] = Ложь;
		
	КонецЕсли;
		
	ПередДобавлениемАдреснаяКнига(Элементы.АдреснаяКнигаСписокВыбора, Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыАдреснаяКнига_Общие
	
&НаКлиенте
Процедура ПередДобавлениемАдреснаяКнига(Элемент, Отказ)

	Отказ = Истина;
	
	КарточкаКонтрагентаИдентификатор                      = "";
	КарточкаКонтрагентаНаименование                       = "";
	КарточкаКонтрагентаФормаИдентификатор                 = ПредопределенныйЭлемент("Справочник.ВидыКонтрагентов.ЮридическоеЛицо");
	КарточкаКонтрагентаФормаПредставление                 = НайтиПоИдентификатору("ВидыКонтрагентов", КарточкаКонтрагентаФормаИдентификатор, "Наименование");
	КарточкаКонтрагентаСтранаИдентификатор                = "";
	КарточкаКонтрагентаСтранаПредставление                = "";
	КарточкаКонтрагентаИНН                                = "";
	КарточкаКонтрагентаДокументВидИдентификатор           = "";
	КарточкаКонтрагентаДокументВидПредставление           = "";
	КарточкаКонтрагентаДокументСерия                      = "";
	КарточкаКонтрагентаДокументНомер                      = "";
	КарточкаКонтрагентаОПФИдентификатор                   = "";
	КарточкаКонтрагентаПравоваяФормаПредставление         = "";
	КарточкаКонтрагентаПравоваяФормаИдентификатор         = "";
	КарточкаКонтрагентаДокументДатаВыдачи                 = '00010101';
	КарточкаКонтрагентаЮридическийАдресГородИдентификатор = "";
	КарточкаКонтрагентаЮридическийАдресГородПредставление = "";
	КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор = "";
	КарточкаКонтрагентаЮридическийАдресУлицаПредставление = "";
	КарточкаКонтрагентаЮридическийАдресДом                = "";
	КарточкаКонтрагентаЮридическийАдресКорпус             = "";
	КарточкаКонтрагентаЮридическийАдресСтроение           = "";
	КарточкаКонтрагентаЮридическийАдресКвартира           = "";
	
	АдресаКонтрагента.Очистить();
	КарточкаКонтрагентаМодифицированность = Истина;
	АдресаКонтрагентаУдалить.Очистить();
	
	Элементы.КарточкаКонтрагентаПанельФормы.ТекущаяСтраница = Элементы.КарточкаКонтрагентаПанельФормыЮридическоеЛицо;	
	
	ОткрытьСтраницуДополнительнойПанели("КарточкаКонтрагента", Элемент, "Новый");
	
КонецПроцедуры

#КонецОбласти

#Область КарточкаКонтрагента

&НаКлиенте
Процедура КарточкаКонтрагентаСохранитьИзменения(Команда)
	
	Если НЕ ПроверкаЗаполненияКарточкаКонтрагента(Истина) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураЗапроса                = СтруктураЗапросаПоСессии();
	ТекущийИдентификаторКонтрагента = КарточкаКонтрагентаИдентификатор;
	
	ЭтоНовыйКонтрагент = ?(ЗначениеЗаполнено(КарточкаКонтрагентаИдентификатор), Ложь, Истина);
	ДанныеКонтрагента = Новый Структура;
	ДанныеКонтрагента.Вставить("Идентификатор", 		КарточкаКонтрагентаИдентификатор);
	ДанныеКонтрагента.Вставить("Наименование", 			КарточкаКонтрагентаНаименование);
	ДанныеКонтрагента.Вставить("ОПФИдентификатор", 		КарточкаКонтрагентаПравоваяФормаИдентификатор);
	ДанныеКонтрагента.Вставить("СтранаИдентификатор", 	КарточкаКонтрагентаСтранаИдентификатор);
	ДанныеКонтрагента.Вставить("Тип", 					КарточкаКонтрагентаФормаИдентификатор);
	ДанныеКонтрагента.Вставить("ИНН", 					КарточкаКонтрагентаИНН);
	ДанныеКонтрагента.Вставить("ДокументТип", 			КарточкаКонтрагентаДокументВидИдентификатор);
	ДанныеКонтрагента.Вставить("ДокументСерия", 		КарточкаКонтрагентаДокументСерия);
	ДанныеКонтрагента.Вставить("ДокументНомер", 		КарточкаКонтрагентаДокументНомер);
	ДанныеКонтрагента.Вставить("ДокументДатаВыдачи", 	КарточкаКонтрагентаДокументДатаВыдачи);
	Если ДанныеКонтрагента.Тип = "juridical" Тогда
		ДанныеКонтрагента.Вставить("ДокументПредставление", "ИНН: " + ДанныеКонтрагента.ИНН);
		ДанныеКонтрагента.Вставить("ОПФНаименование", 		КарточкаКонтрагентаПравоваяФормаПредставление);
	Иначе
		ДокументТипПредставление = НайтиПоИдентификатору("ТипыУдостоверяющихДокументов", ДанныеКонтрагента.ДокументТип, "Наименование");
		ДанныеКонтрагента.Вставить("ДокументПредставление", ?(ЗначениеЗаполнено(ДокументТипПредставление), ДокументТипПредставление, "н/д")  + ": " + ДанныеКонтрагента.ДокументСерия + " " + ДанныеКонтрагента.ДокументНомер);
		ДанныеКонтрагента.Вставить("ОПФНаименование", 	"Ч/Л");
	КонецЕсли; 
	
	Если КарточкаКонтрагентаМодифицированность Тогда
		
		// нужно изменить саму карточку контрагента
		
		Если ЗначениеЗаполнено(КарточкаКонтрагентаИдентификатор) Тогда
			
			СтруктураЗапроса.Вставить("counteragentid", КарточкаКонтрагентаИдентификатор);
			
		КонецЕсли;
		
		СтруктураЗапроса.Вставить("name", КарточкаКонтрагентаНаименование);
		
		Если КарточкаКонтрагентаФормаИдентификатор = ПредопределенныйЭлемент("Справочник.ВидыКонтрагентов.ЮридическоеЛицо") Тогда
			
			// Организационно правовая форма
			
			Если ЗначениеЗаполнено(КарточкаКонтрагентаПравоваяФормаИдентификатор) Тогда
				
				СтруктураЗапроса.Вставить("form", КарточкаКонтрагентаПравоваяФормаИдентификатор);
				
			Иначе
				
				ДанныеОПФ = Новый Структура;
				
				ДанныеОПФ.Вставить("formName",   КарточкаКонтрагентаПравоваяФормаПредставление);
				ДанныеОПФ.Вставить("countryUID", КарточкаКонтрагентаСтранаИдентификатор);
				ДанныеОПФ.Вставить("juridical",  Истина);
				
				СтруктураЗапроса.Вставить("customForm", ДанныеОПФ);
				
			КонецЕсли; 
			
			СтруктураЗапроса.Вставить("inn",  КарточкаКонтрагентаИНН);
			
			// Юридический адрес
			
			ДанныеАдреса = Новый Структура;
			
			Если ЗначениеЗаполнено(КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор) Тогда
				
				ДанныеАдреса.Вставить("street", КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор);
				
			Иначе
				
				ДанныеАдреса.Вставить("customStreet", Новый Структура);
				
				ДанныеАдреса.customStreet.Вставить("code",   КарточкаКонтрагентаЮридическийАдресГородИдентификатор);
				ДанныеАдреса.customStreet.Вставить("street", КарточкаКонтрагентаЮридическийАдресУлицаПредставление);
				
			КонецЕсли;
			
			ДанныеАдреса.Вставить("house",     КарточкаКонтрагентаЮридическийАдресДом);
			ДанныеАдреса.Вставить("building",  КарточкаКонтрагентаЮридическийАдресКорпус);
			ДанныеАдреса.Вставить("structure", КарточкаКонтрагентаЮридическийАдресСтроение);
			ДанныеАдреса.Вставить("flat",      КарточкаКонтрагентаЮридическийАдресКвартира);
			
			СтруктураЗапроса.Вставить("juridicalAddress", ДанныеАдреса);
			
		Иначе
			
			// Физическое лицо
			СтруктураЗапроса.Вставить("form", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");
			
			ДанныеДокумента = Новый Структура;
			ДанныеДокумента.Вставить("type",   КарточкаКонтрагентаДокументВидИдентификатор);
			ДанныеДокумента.Вставить("serial", КарточкаКонтрагентаДокументСерия);
			ДанныеДокумента.Вставить("number", КарточкаКонтрагентаДокументНомер);
			ДанныеДокумента.Вставить("date",   Формат(КарточкаКонтрагентаДокументДатаВыдачи, "ДФ=гггг-ММ-дд"));
			
			СтруктураЗапроса.Вставить("document", ДанныеДокумента);
			
		КонецЕсли; 
		
		Результат       = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеКонтрагента, СтруктураЗапроса);
		
		Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
			
			СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
			
			Если СтруктураОтвета.Свойство("success") Тогда
				
				ТекущийИдентификаторКонтрагента = ПолучитьЗначениеПоля(СтруктураОтвета.success, "counteragentid");
				
			Иначе
				
				ТекущийИдентификатор = "";
				ВывестиСообщениеПользователю("Не удалось обновить карточку контрагента");
				
			КонецЕсли;
			
		Иначе
			
			ТекущийИдентификатор = "";
			ОбработатьОшибкиЗапроса(Результат);
			ВывестиСообщениеПользователю("Не удалось обновить карточку контрагента");
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущийИдентификаторКонтрагента) Тогда
		
		// Значит либо не меняли существующего - либо корректно изменили его данные
		// скорректируем адреса контрагента
		
		// для начала удалим всю ненужную информацию
		
		УдалитьДанные         = Новый Структура;
		УдалитьАдреса         = Новый Массив;
		УдалитьТелефоны       = Новый Массив;
		УдалитьКонтактныеЛица = Новый Массив;
		
		Для Каждого ТекАдрес Из АдресаКонтрагентаУдалить Цикл
			
			УдалитьАдреса.Добавить(ТекАдрес.Значение);
			
		КонецЦикла;
		
		Для Каждого ТекАдрес Из АдресаКонтрагента Цикл
			
			ВыбСтроки = ТекАдрес.Телефоны.НайтиСтроки(Новый Структура("Удалить", Истина));
			
			Для Каждого ТекСтрока Из ВыбСтроки Цикл
				
				УдалитьТелефоны.Добавить(ТекСтрока.Идентификатор);
				
			КонецЦикла;
			
			ВыбСтроки = ТекАдрес.КонтактныеЛица.НайтиСтроки(Новый Структура("Удалить", Истина));
			
			Для Каждого ТекСтрока Из ВыбСтроки Цикл
				
				УдалитьКонтактныеЛица.Добавить(ТекСтрока.Идентификатор);
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если УдалитьАдреса.Количество() Тогда
			
			УдалитьДанные.Вставить("addresses", Новый Структура("id", УдалитьАдреса));				
			
		КонецЕсли;
		
		Если УдалитьТелефоны.Количество() Тогда
			
			УдалитьДанные.Вставить("phones", Новый Структура("id", УдалитьТелефоны));				
			
		КонецЕсли;
		
		Если УдалитьКонтактныеЛица.Количество() Тогда
			
			УдалитьДанные.Вставить("contacts", Новый Структура("id", УдалитьКонтактныеЛица));				
			
		КонецЕсли;
		
		Если УдалитьДанные.Количество() Тогда
			
			СтруктураЗапроса = СтруктураЗапросаПоСессии();
			
			Для Каждого ТекСвойство Из УдалитьДанные Цикл
				
				СтруктураЗапроса.Вставить(ТекСвойство.Ключ, ТекСвойство.Значение);
				
			КонецЦикла;
			
			Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.УдалениеИнформации, СтруктураЗапроса); // <TODO Автор="Марусов" Дата="2017-07-19" Тип="Критичный">отработка ошибки или другие оповещения</TODO> 
			
		КонецЕсли; 
		
		// Изменяем адреса
		
		ДобавитьТелефоны       = Новый Массив;
		ДобавитьКонтактныеЛица = Новый Массив;
		
		ВыбСтроки = АдресаКонтрагента.НайтиСтроки(Новый Структура("Модифицированность", Истина));
		
		Для Каждого ТекСтрока Из ВыбСтроки Цикл
			
			СтруктураЗапроса = СтруктураЗапросаПоСессии();
			
			Если ЗначениеЗаполнено(ТекСтрока.Идентификатор) Тогда
				
				СтруктураЗапроса.Вставить("addressID", ТекСтрока.Идентификатор);
				
			Иначе
				
				СтруктураЗапроса.Вставить("counteragentID", ТекущийИдентификаторКонтрагента);
				
			КонецЕсли;
			
			Если ТекСтрока.ЭтоТерминал Тогда
				
				СтруктураЗапроса.Вставить("terminal_id", ТекСтрока.ТерминалИдентификатор);
				
			Иначе
				
				Если ЗначениеЗаполнено(ТекСтрока.УлицаИдентификатор) Тогда
					
					СтруктураЗапроса.Вставить("street", ТекСтрока.УлицаИдентификатор);
					
				Иначе
					
					СтруктураЗапроса.Вставить("customStreet", Новый Структура);
					
					СтруктураЗапроса.customStreet.Вставить("code", ТекСтрока.ГородИдентификатор);
					СтруктураЗапроса.customStreet.Вставить("street", ТекСтрока.УлицаПредставление);
					
				КонецЕсли;
				
				СтруктураЗапроса.Вставить("house", ТекСтрока.Дом);
				СтруктураЗапроса.Вставить("building", ТекСтрока.Корпус);
				СтруктураЗапроса.Вставить("structure", ТекСтрока.Строение);
				СтруктураЗапроса.Вставить("flat", ТекСтрока.Квартира);
				
			КонецЕсли; 
			
			Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеАдреса, СтруктураЗапроса);
			
			Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
				
				СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
				
				Если СтруктураОтвета.Свойство("success") Тогда
					
					ТекущийИдентификаторАдреса = ПолучитьЗначениеПоля(СтруктураОтвета.success, "addressid");
					
				Иначе
					
					ТекущийИдентификаторАдреса = "";
					ВывестиСообщениеПользователю("Произошла ошибка при попытке обновления данных адреса");
					
				КонецЕсли; 
				
			Иначе
				
				ТекущийИдентификаторАдреса = "";
				ОбработатьОшибкиЗапроса(Результат);
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(ТекущийИдентификаторАдреса) Тогда
				
				ВыбТелефоны = ТекСтрока.Телефоны.НайтиСтроки(Новый Структура("Удалить", Ложь));
				
				Для Каждого ТекТелефон Из ВыбТелефоны Цикл
					
					ДобавитьТелефоны.Добавить(Новый Структура("ИдентификаторАдреса, Представление, Основной, Добавочный, Идентификатор", ТекущийИдентификаторАдреса, ТекТелефон.Представление, ТекТелефон.Основной, ТекТелефон.Добавочный, ТекТелефон.Идентификатор)); 
					
				КонецЦикла;
				
				ВыбКонтактныеЛица = ТекСтрока.КонтактныеЛица.НайтиСтроки(Новый Структура("Удалить", Ложь));
				
				Для Каждого ТекКонтактноеЛицо Из ВыбКонтактныеЛица Цикл
					
					ДобавитьКонтактныеЛица.Добавить(Новый Структура("ИдентификаторАдреса, Представление, Идентификатор", ТекущийИдентификаторАдреса, ТекКонтактноеЛицо.Представление, ТекКонтактноеЛицо.Идентификатор)); 
					
				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		// скорректируем телефоны
		
		Для Каждого ТекТелефон Из ДобавитьТелефоны Цикл
			
			ОсновнойТелефон = ПолучитьТолькоЦифры(ТекТелефон.Основной);
			ДобавочныйНомер = ПолучитьТолькоЦифры(ТекТелефон.Добавочный);
			
			СтруктураЗапроса = СтруктураЗапросаПоСессии();
			
			Если ЗначениеЗаполнено(ТекТелефон.Идентификатор) Тогда
				                                            
				СтруктураЗапроса.Вставить("phoneid", ТекТелефон.Идентификатор);
				
			Иначе
				
				СтруктураЗапроса.Вставить("addressid", ТекТелефон.ИдентификаторАдреса);
				
			КонецЕсли;
			
			СтруктураЗапроса.Вставить("phonenumber", ОсновнойТелефон);
			СтруктураЗапроса.Вставить("addnumber",   ДобавочныйНомер);
			
			Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеТелефонаАдреса, СтруктураЗапроса);
			
			Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
				
				СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
				
				Если Не СтруктураОтвета.Свойство("success") Тогда
					
					ВывестиСообщениеПользователю("Не удалось обновить данные телефона");
					
				КонецЕсли; 
				
			Иначе
				
				ВывестиСообщениеПользователю("Не удалось обновить данные телефона");
				ОбработатьОшибкиЗапроса(Результат);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого ТекКонтакт Из ДобавитьКонтактныеЛица Цикл
			
			СтруктураЗапроса = СтруктураЗапросаПоСессии();
			
			Если ЗначениеЗаполнено(ТекКонтакт.Идентификатор) Тогда
				
				СтруктураЗапроса.Вставить("personid", ТекКонтакт.Идентификатор);
				
			Иначе
				
				СтруктураЗапроса.Вставить("addressid", ТекКонтакт.ИдентификаторАдреса);
				
			КонецЕсли;
			
			СтруктураЗапроса.Вставить("contact",   ТекКонтакт.Представление);
			
			Результат = ВыполнитьЗапросДанных(КоллекцияМетодов.РедактированиеКонтактногоЛица, СтруктураЗапроса);
			
			Если Результат.КодСтатуса = УспешныйКодСтатуса() Тогда
				
				СтруктураОтвета = ДесериализоватьСтруктуруЗапроса(Результат.Данные);
				
				Если Не СтруктураОтвета.Свойство("success") Тогда
					
					ВывестиСообщениеПользователю("Не удалось обновить данные контактного лица");
					
				КонецЕсли; 
				
			Иначе
				
				ВывестиСообщениеПользователю("Не удалось обновить данные контактного лица");
				ОбработатьОшибкиЗапроса(Результат);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	// Все сделали - обновим адресную книгу
	Если ЗначениеЗаполнено(ТекущийИдентификаторКонтрагента) Тогда
		ДанныеКонтрагента.Идентификатор = ТекущийИдентификаторКонтрагента;
		
		Если ЭтоНовыйКонтрагент Тогда
			СтрокаАдреснойКниги = АдреснаяКнига.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаАдреснойКниги, ДанныеКонтрагента);
		Иначе
			Поиск = Новый Структура("Идентификатор", ТекущийИдентификаторКонтрагента);
			Строки = АдреснаяКнига.НайтиСтроки(Поиск);
			Если Строки.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(Строки[0], ДанныеКонтрагента);
			КонецЕсли;
		КонецЕсли;			
		
	КонецЕсли;		
	
	ЗакрытьТекущуюСтраницуДополнительнойПанели();
	
	Если СохранитьИВыбратьКонтрагента И ЗначениеЗаполнено(ТекущийИдентификаторКонтрагента) Тогда
		// открыли сохранение из адресной книги боковой панели
		
		ПараметрыСтраницы = ПараметрыДополнительнойПанели["АдреснаяКнигаСписокВыбора"];
		Элемент = ПараметрыСтраницы.Элемент;
		ПараметрыПанели = ПараметрыСтраницы.Параметры;
		ОбработчикВыбора = ПараметрыСтраницы.ОбработчикВыбора;
		ОткрытьСтраницуДополнительнойПанели("АдреснаяКнигаСписокВыбора", Элемент, ПараметрыПанели, ОбработчикВыбора);
		
		ПараметрыОбработчиковОжидания.Вставить("СфокусироватьсяНаСозданномКонтрагенте", 
												Новый Структура("Идентификатор, Список", ТекущийИдентификаторКонтрагента, Элементы.АдреснаяКнигаКонтрагентыСписокВыбора));
		ПодключитьОбработчикОжидания("СфокусироватьсяНаСозданномКонтрагенте", 0.2, Истина);
		
	Иначе		 
		// открыли сохранение из адресной книги
		
		ПараметрыОбработчиковОжидания.Вставить("СфокусироватьсяНаСозданномКонтрагенте", 
												Новый Структура("Идентификатор, Список", ТекущийИдентификаторКонтрагента, Элементы.АдреснаяКнига));
		ПодключитьОбработчикОжидания("СфокусироватьсяНаСозданномКонтрагенте", 0.2, Истина);
		
	КонецЕсли;
	СохранитьИВыбратьКонтрагента = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СфокусироватьсяНаСозданномКонтрагенте()
	
	Если ПараметрыОбработчиковОжидания.Свойство("СфокусироватьсяНаСозданномКонтрагенте") Тогда
		ПараметрыИсполнения = ПараметрыОбработчиковОжидания.СфокусироватьсяНаСозданномКонтрагенте;	
	Иначе
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Идентификатор", ПараметрыИсполнения.Идентификатор);
	Строки = АдреснаяКнига.НайтиСтроки(поиск);
	Если Строки.Количество() > 0 Тогда
		ПараметрыИсполнения.Список.ТекущаяСтрока = Строки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаРедактируемыйАдресОтменитьИзменения(Команда)
	
	Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактирования.ТекущаяСтраница = Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактирования.ПодчиненныеЭлементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияСписок;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаРедактируемыйАдресСохранитьИзменения(Команда)
	
	Если НЕ ПроверкаЗаполненияКарточкаКонтрагентаРедактируемыйАдрес(Истина) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если КарточкаКонтрагентаРедактируемыйАдресТекущаяСтрока = Неопределено Тогда
		
		// это новый адрес
		ТекущиеДанные = АдресаКонтрагента.Добавить();
		
	Иначе
		
		ТекущиеДанные = АдресаКонтрагента.НайтиПоИдентификатору(КарточкаКонтрагентаРедактируемыйАдресТекущаяСтрока);
		
		Если ТекущиеДанные = Неопределено Тогда
			
			ТекущиеДанные = АдресаКонтрагента.Добавить();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ТекущиеДанные.Тип = "delivery"; // <TODO Автор="Марусов" Дата="2017-07-19" Тип="Критичный">Привязать корректный тип</TODO>
	ТекущиеДанные.ГородИдентификатор = КарточкаКонтрагентаРедактируемыйАдресГородИдентификатор;
	ТекущиеДанные.УлицаИдентификатор = КарточкаКонтрагентаРедактируемыйАдресУлицаИдентификатор;
	ТекущиеДанные.УлицаПредставление = КарточкаКонтрагентаРедактируемыйАдресУлицаПредставление;
	ТекущиеДанные.Дом = КарточкаКонтрагентаРедактируемыйАдресДом;
	ТекущиеДанные.Корпус = КарточкаКонтрагентаРедактируемыйАдресКорпус;
	ТекущиеДанные.Строение = КарточкаКонтрагентаРедактируемыйАдресСтроение;
	ТекущиеДанные.Квартира = КарточкаКонтрагентаРедактируемыйАдресКвартира;
	ТекущиеДанные.ЭтоТерминал = КарточкаКонтрагентаРедактируемыйАдресНазначение = "Терминал";
	ТекущиеДанные.ТерминалИдентификатор = КарточкаКонтрагентаРедактируемыйАдресТерминалИдентификатор;
	
	Если ТекущиеДанные.ЭтоТерминал Тогда
		
		ТекущиеДанные.Представление = НайтиПоИдентификатору("Терминалы", КарточкаКонтрагентаРедактируемыйАдресТерминалИдентификатор, "Адрес");
		
	Иначе
		
		ТекущиеДанные.Представление = КарточкаКонтрагентаРедактируемыйАдресГородПредставление + ", " + КарточкаКонтрагентаРедактируемыйАдресУлицаПредставление +
		?(ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресДом), ", д. " + КарточкаКонтрагентаРедактируемыйАдресДом, "") + 
		?(ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресКорпус), ", корп. " + КарточкаКонтрагентаРедактируемыйАдресКорпус, "") + 
		?(ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресСтроение), ", стр. " + КарточкаКонтрагентаРедактируемыйАдресСтроение, "") +
		?(ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресКвартира), ", кв/оф. " + КарточкаКонтрагентаРедактируемыйАдресКвартира, ""); 
		
	КонецЕсли; 
	
	ТелефоныПредставление = "";
	ТекущиеДанные.Телефоны.Очистить();
	
	Для Каждого ТекЗапись Из КарточкаКонтрагентаРедактируемыйАдресТелефоны Цикл
		
		Если Не ТекЗапись.Удалить Тогда
			
			ТекЗапись.Представление = ПредставлениеТелефонаПоМаске(ТекЗапись); 
			ТелефоныПредставление = ТелефоныПредставление + Символы.ПС + ТекЗапись.Представление;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные.Телефоны.Добавить(), ТекЗапись);
		
	КонецЦикла;
	
	ТекущиеДанные.ТелефоныПредставление = СокрЛП(ТелефоныПредставление);
	
	КонтактныеЛицаПредставление = "";
	ТекущиеДанные.КонтактныеЛица.Очистить();
	
	Для Каждого ТекЗапись Из КарточкаКонтрагентаРедактируемыйАдресКонтактныеЛица Цикл
		
		Если Не ТекЗапись.Удалить Тогда
			
			КонтактныеЛицаПредставление = КонтактныеЛицаПредставление + Символы.ПС + ТекЗапись.Представление;
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные.КонтактныеЛица.Добавить(), ТекЗапись);
		
	КонецЦикла;
	
	ТекущиеДанные.КонтактныеЛицаПредставление = СокрЛП(КонтактныеЛицаПредставление);
	
	ТекущиеДанные.Модифицированность = Истина;
	
	Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактирования.ТекущаяСтраница = Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактирования.ПодчиненныеЭлементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияСписок;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаРедактируемыйАдресИзменить(Команда)
	
	Элементы.КарточкаКонтрагентаРедактируемыйАдресЭлементы.ТолькоПросмотр = Ложь;
	Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияАдресПанельДействий.ТекущаяСтраница = Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияАдресПанельДействийИзменение;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаРедактируемыйАдресЗакрыть(Команда)
	
	Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактирования.ТекущаяСтраница = Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияСписок;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаИзменить(Команда)
	
	Элементы.КарточкаКонтрагентаЭлемент.ТолькоПросмотр = Ложь;
	Элементы.КарточкаКонтрагентаПанельДействий.ТекущаяСтраница = Элементы.КарточкаКонтрагентаПанельДействий.ПодчиненныеЭлементы.КарточкаКонтрагентаПанельДействийИзменение;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаКонтрагентаНачатьРедактирование(Команда)
	
	Элементы.КарточкаКонтрагентаПанельДействий.ТекущаяСтраница = Элементы.КарточкаКонтрагентаПанельДействийИзменение;
	Элементы.КарточкаКонтрагентаЭлемент.ТолькоПросмотр = Ложь;
	
КонецПроцедуры

#КонецОбласти   

#Область КарточкаКонтрагента

&НаКлиенте
Функция ПроверкаЗаполненияАдресаКонтрагента(Интерактивно = Ложь)
	
	Отказ = Ложь;
	
	Для Каждого ДанныеСтроки Из АдресаКонтрагента Цикл
		
		ТекущийИндекс  = АдресаКонтрагента.Индекс(ДанныеСтроки);
		ТекущаяСтрока  = Строка(ТекущийИндекс + 1);
		ПутьКСтроке    = "АдресаКонтрагента[" + Формат(ТекущийИндекс, "ЧН=; ЧГ=") + "].";
		
		СписокТелефонов = ПолучитьАктивнуюКонтактнуюИнформацию(ДанныеСтроки.Телефоны);
		СписокКонтактов = ПолучитьАктивнуюКонтактнуюИнформацию(ДанныеСтроки.КонтактныеЛица);
		
		Если Не ЗначениеЗаполнено(ДанныеСтроки.ГородИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не указан город адреса в строке " + ТекущаяСтрока, ПутьКСтроке + "Представление", Интерактивно, Отказ);
			
		ИначеЕсли ДанныеСтроки.ЭтоТерминал И Не ЗначениеЗаполнено(ДанныеСтроки.ТерминалИдентификатор) Тогда
			
			ВывестиСообщениеПользователю("Не указан терминал в строке " + ТекущаяСтрока, ПутьКСтроке + "Представление", Интерактивно, Отказ);
			
		ИначеЕсли НЕ ДанныеСтроки.ЭтоТерминал И Не ЗначениеЗаполнено(ДанныеСтроки.УлицаПредставление) Тогда
			
			ВывестиСообщениеПользователю("Не указана улица адреса в строке " + ТекущаяСтрока, ПутьКСтроке + "Представление", Интерактивно, Отказ);
			
		ИначеЕсли НЕ ДанныеСтроки.ЭтоТерминал И Не ЗначениеЗаполнено(ДанныеСтроки.Дом) Тогда			
			
			ВывестиСообщениеПользователю("Не указан дом адреса в строке " + ТекущаяСтрока, ПутьКСтроке + "Представление", Интерактивно, Отказ);
			
		ИначеЕсли Не ПроверкаЗаполненияСписокТелефонов(СписокТелефонов) Тогда
			
			ВывестиСообщениеПользователю("Некорректно указаны телефоны адреса в строке " + ТекущаяСтрока, ПутьКСтроке + "ТелефоныПредставление", Интерактивно, Отказ);
			
		ИначеЕсли Не ПроверкаЗаполненияСписокКонтактов(СписокКонтактов) Тогда
			
			ВывестиСообщениеПользователю("Некорректно указаны контактные лица адреса в строке " + ТекущаяСтрока, ПутьКСтроке + "КонтактныеЛицаПредставление", Интерактивно, Отказ);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполненияКарточкаКонтрагентаРедактируемыйАдрес(Интерактивно = Ложь)
	
	КарточкаЗаполнена = Ложь;
	
	ЭтоАдрес    = КарточкаКонтрагентаРедактируемыйАдресНазначение = "Адрес";
	ЭтоТерминал = КарточкаКонтрагентаРедактируемыйАдресНазначение = "Терминал";
	
	СписокТелефонов = ПолучитьАктивнуюКонтактнуюИнформацию(КарточкаКонтрагентаРедактируемыйАдресТелефоны);
	СписокКонтактов = ПолучитьАктивнуюКонтактнуюИнформацию(КарточкаКонтрагентаРедактируемыйАдресКонтактныеЛица);
	
	Если Не ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресГородИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указан город адреса", "КарточкаКонтрагентаРедактируемыйАдресГородПредставление", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресНазначение) Тогда
		
		ВывестиСообщениеПользователю("Не указано назначение адреса", "КарточкаКонтрагентаРедактируемыйАдресНазначение", Интерактивно);
		
	ИначеЕсли ЭтоТерминал И Не ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресТерминалИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указан терминал", "КарточкаКонтрагентаРедактируемыйАдресАдресТерминала", Интерактивно);
		
	ИначеЕсли ЭтоАдрес И Не ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресУлицаПредставление) Тогда
		
		ВывестиСообщениеПользователю("Не указана улица адреса", "КарточкаКонтрагентаРедактируемыйАдресУлицаПредставление", Интерактивно);
		
	ИначеЕсли ЭтоАдрес И Не ЗначениеЗаполнено(КарточкаКонтрагентаРедактируемыйАдресДом) Тогда
		
		ВывестиСообщениеПользователю("Не указан дом адреса", "КарточкаКонтрагентаРедактируемыйАдресДом", Интерактивно);
		
	ИначеЕсли Не ПроверкаЗаполненияСписокТелефонов(СписокТелефонов, Интерактивно, Истина) Тогда
		
		// Дополнительный вывод сообщений не требуется
		
	ИначеЕсли Не ПроверкаЗаполненияСписокКонтактов(СписокКонтактов, Интерактивно, Истина) Тогда
		
		// Дополнительный вывод сообщений не требуется
		
	Иначе
		
		КарточкаЗаполнена = Истина;
		
	КонецЕсли;
	
	Возврат КарточкаЗаполнена;
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполненияКарточкаКонтрагентаДокументПаспорт(Интерактивно = Ложь)
	
	Результат  = Ложь;
	ЭтоПаспорт = КарточкаКонтрагентаДокументВидИдентификатор = ПредопределенныйЭлемент("Справочник.ТипыУдостоверяющихДокументов.Паспорт");
	
	СерияТолькоЦифры = ПолучитьТолькоЦифры(КарточкаКонтрагентаДокументСерия);
	НомерТолькоЦифры = ПолучитьТолькоЦифры(КарточкаКонтрагентаДокументНомер);
	
	Если Не ЭтоПаспорт Тогда
		
		Результат = Истина; // Проверка выполняется только для вида документа "Паспорт"
		
	ИначеЕсли СерияТолькоЦифры <> СокрЛП(КарточкаКонтрагентаДокументСерия) Тогда
		
		ВывестиСообщениеПользователю("Серия паспорта может содержать только цифры", КарточкаКонтрагентаДокументСерия, Интерактивно);
		
	ИначеЕсли НомерТолькоЦифры <> СокрЛП(КарточкаКонтрагентаДокументНомер) Тогда
		
		ВывестиСообщениеПользователю("Номер паспорта может содержать только цифры", КарточкаКонтрагентаДокументНомер, Интерактивно);
		
	ИначеЕсли СтрДлина(СерияТолькоЦифры) <> 4  Тогда
		
		ВывестиСообщениеПользователю("Серия паспорта должна состоять из 4 цифр", КарточкаКонтрагентаДокументСерия, Интерактивно);
		
	ИначеЕсли СтрДлина(НомерТолькоЦифры) <> 6  Тогда
		
		ВывестиСообщениеПользователю("Номер паспорта должен состоять из 6 цифр", КарточкаКонтрагентаДокументНомер, Интерактивно);
		
	Иначе
		
		Результат = Истина;
	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполненияКарточкаКонтрагентаУдостоверяющийДокумент(Интерактивно = Ложь)
	
	Результат         = Ложь;
	ЭтоФизическоеЛицо = КарточкаКонтрагентаФормаИдентификатор = ПредопределенныйЭлемент("Справочник.ВидыКонтрагентов.ФизическоеЛицо");
	
	Если Не ЭтоФизическоеЛицо Тогда
		
		Результат = Истина; // Проверка документа имеет смысл только для физ. лиц
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаДокументВидИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указан вид документа", "КарточкаКонтрагентаДокументВид", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаДокументСерия) Тогда
		
		ВывестиСообщениеПользователю("Не указана серия документа", "КарточкаКонтрагентаДокументСерия", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаДокументНомер) Тогда
		
		ВывестиСообщениеПользователю("Не указан номер документа", "КарточкаКонтрагентаДокументНомер", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаДокументДатаВыдачи) Тогда
		
		ВывестиСообщениеПользователю("Не указана дата выдачи документа", "КарточкаКонтрагентаДокументДатаВыдачи", Интерактивно);
		
	ИначеЕсли Не ПроверкаЗаполненияКарточкаКонтрагентаДокументПаспорт(Интерактивно) Тогда
		
		ВывестиСообщениеПользователю("Некорректно указаны данные паспорта",, Интерактивно);
		
	Иначе
		
		Результат = Истина;
	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПроверкаЗаполненияКарточкаКонтрагента(Интерактивно = Ложь)
	
	КарточкаЗаполнена = Ложь;
	
	ЭтоЮридическоеЛицо = КарточкаКонтрагентаФормаИдентификатор = ПредопределенныйЭлемент("Справочник.ВидыКонтрагентов.ЮридическоеЛицо");
	ЭтоФизическоеЛицо  = КарточкаКонтрагентаФормаИдентификатор = ПредопределенныйЭлемент("Справочник.ВидыКонтрагентов.ФизическоеЛицо");
	ЕстьАдреса         = АдресаКонтрагента.Количество();
	
	Если НЕ ЗначениеЗаполнено(КарточкаКонтрагентаФормаИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указана ответственность контрагента", "КарточкаКонтрагентаФормаПредставление", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаСтранаИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указана страна контрагента", "КарточкаКонтрагентаСтранаПредставление", Интерактивно);
		
	ИначеЕсли Не ЗначениеЗаполнено(КарточкаКонтрагентаНаименование) Тогда
		
		ВывестиСообщениеПользователю("Не указано наименование контрагента", "КарточкаКонтрагентаНаименование", Интерактивно);
		
	ИначеЕсли ЭтоЮридическоеЛицо И Не ЗначениеЗаполнено(КарточкаКонтрагентаИНН) Тогда
		
		ВывестиСообщениеПользователю("Не указан ИНН контрагента", "КарточкаКонтрагентаИНН", Интерактивно);
		
	ИначеЕсли ЭтоЮридическоеЛицо И Не ЗначениеЗаполнено(КарточкаКонтрагентаПравоваяФормаПредставление) Тогда
		
		ВывестиСообщениеПользователю("Не указана правовая форма контрагента", "КарточкаКонтрагентаПравоваяФормаПредставление", Интерактивно);
		
	ИначеЕсли ЭтоЮридическоеЛицо И Не ЗначениеЗаполнено(КарточкаКонтрагентаЮридическийАдресГородИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указан юридический адрес "+КарточкаКонтрагентаНаименование+". Контрагент в ТК создан не будет!", "КарточкаКонтрагентаЮридическийАдресГородПредставление", Интерактивно);
		
	ИначеЕсли ЭтоЮридическоеЛицо И Не ЗначениеЗаполнено(КарточкаКонтрагентаЮридическийАдресУлицаИдентификатор) Тогда
		
		ВывестиСообщениеПользователю("Не указан юридический адрес "+КарточкаКонтрагентаНаименование+". Контрагент в ТК создан не будет!", "КарточкаКонтрагентаЮридическийАдресУлицаПредставление", Интерактивно);
		
	ИначеЕсли ЭтоЮридическоеЛицо И Не ЗначениеЗаполнено(КарточкаКонтрагентаЮридическийАдресДом) Тогда
		
		ВывестиСообщениеПользователю("Не указан юридический адрес "+КарточкаКонтрагентаНаименование+". Контрагент в ТК создан не будет!", "КарточкаКонтрагентаЮридическийАдресДом", Интерактивно);
		
    //ИначеЕсли Не ПроверкаЗаполненияКарточкаКонтрагентаУдостоверяющийДокумент(Интерактивно) Тогда
    //	
    //	ВывестиСообщениеПользователю("Некорректно указан удостоверяющий документ", , Интерактивно);
		
	ИначеЕсли ЕстьАдреса И НЕ ПроверкаЗаполненияАдресаКонтрагента(Интерактивно) Тогда
		
		ВывестиСообщениеПользователю("Скорректируйте список адресов контрагента", , Интерактивно);
		
	Иначе
		
		КарточкаЗаполнена = Истина;
		
	КонецЕсли;
	
	Возврат КарточкаЗаполнена;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииДанныхКонтрагента()
	
	Если Элементы.КарточкаКонтрагентаПанельДействий.ТекущаяСтраница = Элементы.КарточкаКонтрагентаПанельДействий.ПодчиненныеЭлементы.КарточкаКонтрагентаПанельДействийИзменение Тогда
		
		Элементы.КарточкаКонтрагентаСохранитьИзменения.Доступность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРедактируемогоАдреса()
	
	Если Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияАдресПанельДействий.ТекущаяСтраница = Элементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияАдресПанельДействий.ПодчиненныеЭлементы.КарточкаКонтрагентаАдресаДоставкиПанельРедактированияАдресПанельДействийИзменение Тогда
		
		Элементы.КарточкаКонтрагентаРедактируемыйАдресСохранитьИзменения.Доступность = Истина;
		
	КонецЕсли; 
	
	
КонецПроцедуры

#КонецОбласти

#Область СтруктураАдреса

&НаКлиенте
Функция ОписаниеСтруктурыАдреса()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Способ",                "");
	СтруктураДанных.Вставить("Идентификатор",         "");
	СтруктураДанных.Вставить("ГородИдентификатор",    "");
	СтруктураДанных.Вставить("ТерминалИдентификатор", "");
	СтруктураДанных.Вставить("УлицаИдентификатор",    "");
	СтруктураДанных.Вставить("УлицаПредставление",    "");
	СтруктураДанных.Вставить("Дом",                   "");
	СтруктураДанных.Вставить("Корпус",                "");
	СтруктураДанных.Вставить("Строение",              "");
	СтруктураДанных.Вставить("Квартира",              "");
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Функция СтруктураАдресаИзСтрокиТаблицы(Источник)
	
	СтруктураДанных = ОписаниеСтруктурыАдреса();
	ЗаполнитьЗначенияСвойств(СтруктураДанных, Источник); 
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Функция СтруктураАдресаИзКонтейнера(Контейнер)
	
	СтруктураДанных = ОписаниеСтруктурыАдреса();
	
	Для Каждого ТекущееСвойство ИЗ СтруктураДанных Цикл
		
		СтруктураДанных[ТекущееСвойство.Ключ] = ЗначениеРеквизитаФормы(Контейнер + ТекущееСвойство.Ключ, ""); 
		
	КонецЦикла;
	
	Возврат СтруктураДанных;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСохраненныеМультиотправки

&НаКлиенте
Процедура СохраненныеМультиотправкиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеМультиотправкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("СохраненныеМультиотправкиВыборЗавершение", ЭтаФорма, ВыбраннаяСтрока);
	ПоказатьВопрос(Оповещение, "Загрузить данные мультиотправки? Текущие несохраненные данные будут потеряны.", РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеМультиотправкиВыборЗавершение(РезультатВопроса, ВыбраннаяСтрока) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ДанныеСтроки = СохраненныеМультиотправки.НайтиПоИдентификатору(ВыбраннаяСтрока);
		МультиотправкаВосстановить(ДанныеСтроки);
		ЗакрытьТекущуюСтраницуДополнительнойПанели();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СохраненныеМультиотправкиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ПередУдалениемМультиотправкиЗавершение", ЭтаФорма, Элемент.ТекущиеДанные);
	ПоказатьВопрос(Оповещение, "Удалить сохраненные данные незавершенной мультиотправки?", РежимДиалогаВопрос.ДаНет, 15, КодВозвратаДиалога.Нет, "Внимание");
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередУдалениемМультиотправкиЗавершение(КодВозврата, ДанныеСтроки) Экспорт
	
	Если КодВозврата = КодВозвратаДиалога.Да Тогда
		
		СохраненныеМультиотправки.Удалить(ДанныеСтроки);
		ЗаписатьСохраненныеМультиотправкиНаСервере();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура МультиотправкаВосстановить(ДанныеСтроки)
	
	СтруктураДанных = ДанныеСтроки.Данные;
	
	ВосстановитьДанныеИзСтруктуры(СтруктураДанных);	
	УстановитьТолькоПросмотрВесОбъемМультиотправки(Не МультиотправкаОбщиеПараметрыГруза);
	//МультиотправкаПриИзмененииОплатыОтТретьегоЛица();
	МультиотправкаОтправительСпособПриИзменении(Неопределено);
	
	Фильтр = Новый Структура("ВозможнаОтправкаГруза", Истина);
	ИнициализироватьТерминалыГорода(МультиотправкаОтправительГородИдентификатор, 
										"МультиотправкаОтправительТерминалИдентификатор", 
										Элементы.МультиотправкаОтправительАдресТерминала, 
										"МультиотправкаОтправительИнформацияТерминала", 
										Фильтр,
										Истина);
										
	//МультиотправкаБлокировкаСпособаОтправителя();

КонецПроцедуры

 &НаКлиенте
Процедура ВосстановитьДанныеИзСтруктуры(СтруктураДанных)
	
	Для Каждого ТекПоле Из СтруктураДанных Цикл
		
		ИмяРеквизита      = ТекПоле.Ключ;
		ЗначениеРеквизита = ТекПоле.Значение;
		
		Если ТипЗнч(ЗначениеРеквизита) = Тип("СписокЗначений") Тогда
			
            Таблица = ЗначениеРеквизитаФормы(ИмяРеквизита); 
            
            Попытка
                Таблица.Очистить();	
            Исключение
                //ОписаниеОшибки()
            КонецПопытки;
			
			Для Каждого СтрокиТаблицы Из ЗначениеРеквизита Цикл
				
				НоваяЗапись = Таблица.Добавить();
				
				Для Каждого ПолеТаблицы Из СтрокиТаблицы.Значение Цикл
					
					
					Если ТипЗнч(ПолеТаблицы.Значение) = Тип("СписокЗначений") Тогда
						
						Для Каждого СтрокиВложеннойТаблицы Из ПолеТаблицы.Значение Цикл
							
							ЗаполнитьЗначенияСвойств(НоваяЗапись[ПолеТаблицы.Ключ].Добавить(), СтрокиВложеннойТаблицы.Значение);
							
						КонецЦикла;
						
					Иначе
						
						НоваяЗапись[ПолеТаблицы.Ключ] = ПолеТаблицы.Значение;
						
					КонецЕсли; 
					
				КонецЦикла;
				
			КонецЦикла;
			
		Иначе
			
			УстановитьЗначениеРеквизитаФормы(ИмяРеквизита, ЗначениеРеквизита);
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

