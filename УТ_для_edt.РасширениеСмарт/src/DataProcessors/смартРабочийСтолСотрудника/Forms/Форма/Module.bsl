	|	ДанныеОбъектов.Дата,
	|	ДанныеОбъектов.Номер,
	|	НАЧАЛОПЕРИОДА(ДанныеОбъектов.Дата, ДЕНЬ),
	|	ГОД(ДанныеОбъектов.Дата),
	|	ДанныеОбъектов.Входящий,
	|	ДанныеОбъектов.Отправитель,
	|	ДанныеОбъектов.Получатель,
	|	ДанныеОбъектов.Состояние,
	|	ДанныеОбъектов.Длительность,
	|	ВЫБОР
	|		КОГДА ДанныеОбъектов.Ссылка ССЫЛКА Документ.CRM_Взаимодействие
	|			ТОГДА ДанныеОбъектов.Результат
	|		ИНАЧЕ ДанныеОбъектов.Тема
	|	КОНЕЦ,
	|	ДанныеОбъектов.Ссылка,
	|	ДанныеОбъектов.УчетнаяЗапись,
	|	ДанныеОбъектов.Сумма,
	|	ДанныеОбъектов.Валюта,
	|	ДанныеОбъектов.Результат,
	|	ДанныеОбъектов.Вид,
	|	ДанныеОбъектов.ТемаИнтереса,
	|	ДанныеОбъектов.ТипОбращенияИнтереса,
	|	ДанныеОбъектов.Интерес
	|ИЗ
	|	ДанныеОбъектовИсторииСортировка КАК ДанныеОбъектов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеДанные.Отправитель КАК Ответственный,
	|	МАКСИМУМ(ВсеДанные.Дата) КАК Дата
	|ИЗ
	|	ВсеДанные КАК ВсеДанные
	|ГДЕ
	|	(ВсеДанные.Ссылка ССЫЛКА Документ.CRM_Взаимодействие
	|			ИЛИ ВсеДанные.Ссылка ССЫЛКА Справочник.Заметки)
	|	И ВсеДанные.Ссылка.СтатусВзаимодействия = ЗНАЧЕНИЕ(справочник.CRM_СостоянияСобытий.Завершено)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеДанные.Отправитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеДанные.Раздел КАК Раздел,
	|	ВсеДанные.ЕстьКоманды КАК ЕстьКоманды,
	|	ВсеДанные.ЕстьФайлы КАК ЕстьФайлы,
	|	ВсеДанные.Группировка КАК Группировка,
	|	ВсеДанные.Тип КАК Тип,
	|	ВсеДанные.Дата КАК Дата,
	|	ВсеДанные.Номер КАК Номер,
	|	ВсеДанные.ДатаБезВремени КАК ДатаБезВремени,
	|	ВсеДанные.Год КАК Год,
	|	ВсеДанные.Входящий КАК Входящий,
	|	ВсеДанные.Отправитель КАК Отправитель,
	|	ВсеДанные.Получатель КАК Получатель,
	|	ВсеДанные.Состояние КАК Состояние,
	|	ВсеДанные.Длительность КАК Длительность,
	|	ВсеДанные.Тема КАК Тема,
	|	ВсеДанные.Ссылка КАК Ссылка,
	|	ВсеДанные.УчетнаяЗапись КАК УчетнаяЗапись,
	|	ВсеДанные.Сумма КАК Сумма,
	|	ВсеДанные.Валюта КАК Валюта,
	|	ВсеДанные.Результат КАК Результат,
	|	ВсеДанные.Вид КАК Вид,
	|	ВсеДанные.ТемаИнтереса КАК ТемаИнтереса,
	|	ВсеДанные.ТипОбращенияИнтереса КАК ТипОбращенияИнтереса,
	|	ВсеДанные.Интерес КАК Интерес
	|ИЗ
	|	ВсеДанные КАК ВсеДанные";	
КонецФункции	

&НаСервере
Функция ТипыОбъектовЛентыПоОтбору(Знач ОтборЛенты)
	
	ТипыОбъектов = Новый Массив;
	
	Для Каждого НастройкаОтбора Из ОтборЛенты Цикл
		
		Если Не НастройкаОтбора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = НастройкаОтбора.Значение;
		Если ИмяОтбора = "Задачи" Тогда
			ТипыОбъектов.Добавить(Тип("ЗадачаСсылка.ЗадачаИсполнителя"));
		ИначеЕсли ИмяОтбора = "ВзаимодействияВстречи" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "ВходящиеЗвонки" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.ТелефонныйЗвонок"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "ИсходящиеЗвонки" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.ТелефонныйЗвонок"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "ВходящиеПисьма" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "ИсходящиеПисьма" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.ЭлектронноеПисьмоИсходящее"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "ВзаимодействияПрочие" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Взаимодействие"));
		ИначеЕсли ИмяОтбора = "Чаты" Тогда
			// +Рарус alexpr
			//ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_СообщениеМессенджера"));
			ТипыОбъектов.Добавить(Тип("СправочникСсылка.CRM_Диалоги"));
			// -Рарус alexpr
		ИначеЕсли ИмяОтбора = "SMS" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.СообщениеSMS"));
		ИначеЕсли ИмяОтбора = "Примечания" Тогда
			ТипыОбъектов.Добавить(Тип("СправочникСсылка.Заметки"));
		ИначеЕсли ИмяОтбора = "Документы" Тогда
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Интерес"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Заявка"));
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.КоммерческоеПредложениеКлиенту")); 
			ТипыОбъектов.Добавить(Тип("ДокументСсылка.CRM_Телемаркетинг"));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТипыОбъектов);
	
КонецФункции

&НаСервере
Функция ТипыОбращенийЛентыПоОтбору(Знач ОтборЛенты)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТипыОбращений = Новый Массив;
	
	Для Каждого НастройкаОтбора Из ОтборЛенты Цикл
		
		Если Не НастройкаОтбора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = НастройкаОтбора.Значение;
		Если ИмяОтбора = "Интересы" Тогда
			
			ТипыОбращений.Добавить( Справочники.CRM_ТипыОбращений.Интерес );
			
		ИначеЕсли ИмяОтбора = "ИнтересыКакПоддержка" Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТипыОбращений.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.CRM_ТипыОбращений КАК ТипыОбращений";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ТипыОбращений.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТипыОбращений;
	
КонецФункции

&НаСервере
Функция ВидыВзаимодействийЛентыПоОтбору(Знач ОтборЛенты)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВидыВзаимодействий.Ссылка КАК Ссылка,
	|	ВидыВзаимодействий.ВидСобытия КАК Тип,
	|	ВидыВзаимодействий.Направление КАК Направление
	|ИЗ
	|	Справочник.CRM_ВидыВзаимодействий КАК ВидыВзаимодействий");
	
	ВсеВидыВзаимодействий = Запрос.Выполнить().Выгрузить();
	
	ВидыВзаимодействий = Новый Массив;
	
	Для Каждого НастройкаОтбора Из ОтборЛенты Цикл
		
		Если Не НастройкаОтбора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = НастройкаОтбора.Значение;
		Если ИмяОтбора = "ВзаимодействияВстречи" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ЛичнаяВстреча Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ИмяОтбора = "ВходящиеЗвонки" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ТелефонныйЗвонок
					И Строка.Направление = Перечисления.CRM_ВходящееИсходящееСобытие.Входящее Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ИмяОтбора = "ИсходящиеЗвонки" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ТелефонныйЗвонок
					И Строка.Направление = Перечисления.CRM_ВходящееИсходящееСобытие.Исходящее Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ИмяОтбора = "ВходящиеПисьма" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ЭлектронноеПисьмо
					И Строка.Направление = Перечисления.CRM_ВходящееИсходящееСобытие.Входящее Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ИмяОтбора = "ИсходящиеПисьма" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ЭлектронноеПисьмо
					И Строка.Направление = Перечисления.CRM_ВходящееИсходящееСобытие.Исходящее Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ИмяОтбора = "ВзаимодействияПрочие" Тогда
			Для Каждого Строка Из ВсеВидыВзаимодействий Цикл
				Если Строка.Тип = Перечисления.CRM_ВидыСобытий.ПочтовоеПисьмо
					Или Строка.Тип = Перечисления.CRM_ВидыСобытий.Прочее Тогда
					ВидыВзаимодействий.Добавить(Строка.Ссылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВидыВзаимодействий;
	
КонецФункции

&НаСервере
Функция НаправленияЗвонковПоОтбору(Знач ОтборЛенты)
	
	Направления = Новый Массив;
	
	Для Каждого НастройкаОтбора Из ОтборЛенты Цикл
		
		Если Не НастройкаОтбора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = НастройкаОтбора.Значение;
		Если ИмяОтбора = "ВходящиеЗвонки" Тогда
			Направления.Добавить(Истина);
		ИначеЕсли ИмяОтбора = "ИсходящиеЗвонки" Тогда
			Направления.Добавить(Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Направления;
	
КонецФункции

&НаСервере
Функция НаправленияЧатовПоОтбору(Знач ОтборЛенты)
	
	Направления = Новый Массив;
	
	Для Каждого НастройкаОтбора Из ОтборЛенты Цикл
		
		Если Не НастройкаОтбора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяОтбора = НастройкаОтбора.Значение;
		Если ИмяОтбора = "ВходящиеЧаты" Тогда
			Направления.Добавить(Перечисления.CRM_ВидыСообщенияМессенджера.Входящее);
		ИначеЕсли ИмяОтбора = "ИсходящиеЧаты" Тогда
			Направления.Добавить(Перечисления.CRM_ВидыСообщенияМессенджера.Исходящее);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Направления;
	
КонецФункции

&НаСервере
Функция ВключенаНастройкаОтбораЛенты(Знач ОтборЛенты, Знач ИмяНастройки)
	
	ВключенаНастройка = Ложь;
	
	НастройкаВсеСобытия = ОтборЛенты.Получить(0);
	ПометкаВсеСобытия = НастройкаВсеСобытия.Пометка;
	Если ПометкаВсеСобытия Тогда
		ВключенаНастройка = Истина;
	Иначе
		НайденнаяНастройка = ОтборЛенты.НайтиПоЗначению(ИмяНастройки);
		Если НайденнаяНастройка = Неопределено Тогда
			ВключенаНастройка = Ложь;
		Иначе
			ВключенаНастройка = НайденнаяНастройка.Пометка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ВключенаНастройка;
	
КонецФункции

&НаСервере
Функция ИзменитьНаименованиеТипа(ТипОбъекта)
	
	Если ТипОбъекта = "ВзаимодействиеПланов" Тогда
		Возврат "Запланироно взаимодействие";	
	ИначеЕсли ТипОбъекта = "ЗадачаПланов" Тогда
		Возврат "Запланирована задача";
	ИначеЕсли ТипОбъекта = "Примечание" Тогда
		Возврат "Заметка";
	ИначеЕсли ТипОбъекта = "Лид" Тогда
		Возврат "Лид";
	ИначеЕсли ТипОбъекта = "ВзаимодействиеИстории" Тогда
		Возврат "Завершенно взаимодействие";
	ИначеЕсли ТипОбъекта = "ЗадачаИстории" Тогда
		Возврат "Завершенна задача";
	ИначеЕсли ТипОбъекта = "ТелефонныйЗвонок" Тогда
		Возврат "Телефонный звонок";
	ИначеЕсли ТипОбъекта = "ЭлектронноеПисьмо" Тогда
		Возврат "Эл. письмо";
	ИначеЕсли ТипОбъекта = "Диалог" Тогда
		Возврат "Диалог";		
	ИначеЕсли ТипОбъекта = "СообщениеSMS" Тогда
		Возврат "SMS";
	ИначеЕсли ТипОбъекта = "Заявка" Тогда
		Возврат "Заявка";
	ИначеЕсли ТипОбъекта = "Интерес" Тогда
		Возврат "Интерес";
	ИначеЕсли ТипОбъекта = "КоммерческоеПредложение" Тогда
		Возврат "Коммерческое предложение";
	ИначеЕсли ТипОбъекта = "ПрочийДокумент" Тогда
		Возврат "Прочий документ";
	ИначеЕсли ТипОбъекта = "СозданиеОбъекта" Тогда
		Возврат "Создан интерес";
	ИначеЕсли ТипОбъекта = "ЗавершениеИнтереса" Тогда
		Возврат "Завершен интерес";
	ИначеЕсли ТипОбъекта = "ЗаписьИстории" Тогда
		Возврат "Запись истории";
	ИначеЕсли ТипОбъекта = "Файл" Тогда
		Возврат "Файл";
	Иначе	
		Возврат ТипОбъекта;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура НоваяКомпанияПриИзменении(Элемент)
	Элементы.Компания.Видимость = НЕ НоваяКомпания;
	Элементы.КомпанияТекст.Видимость = НоваяКомпания;
	Элементы.КонтактноеЛицо.Видимость = НЕ НоваяКомпания;
	Элементы.КонтактноеЛицоТекст.Видимость = НоваяКомпания;
КонецПроцедуры

&НаКлиенте
Процедура НовоеКонтактноеЛицоПриИзменении(Элемент)
	Элементы.КонтактноеЛицо.Видимость = НЕ НовоеКонтактноеЛицо;
	Элементы.КонтактноеЛицоТекст.Видимость = НовоеКонтактноеЛицо;
КонецПроцедуры

&НаСервере
Процедура ДокументПриИзмененииНаСервере()
	
	Если ТипЗнч(ЭтаФорма.ДокументСЦ) = Тип("ДокументСсылка.смартЗаявкаНаГарантийныйРемонт") Тогда
		
		ЭтаФорма.Компания = ЭтаФорма.ДокументСЦ.Клиент;
		ЭтаФорма.КомпанияТекст = "";
		ЭтаФорма.НоваяКомпания = Ложь;
		Элементы.Компания.ТолькоПросмотр = Истина;
		Элементы.НоваяКомпания.ТолькоПросмотр = Истина;
		ЭтаФорма.БизнесРегион = ЭтаФорма.ДокументСЦ.Клиент.БизнесРегион;
		
	ИначеЕсли ТипЗнч(ЭтаФорма.ДокументСЦ) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку")
		ИЛИ ТипЗнч(ЭтаФорма.ДокументСЦ) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		ЭтаФорма.Компания = ЭтаФорма.ДокументСЦ.Партнер;
		ЭтаФорма.БизнесРегион = ЭтаФорма.ДокументСЦ.Партнер.БизнесРегион;
		ЭтаФорма.КомпанияТекст = "";
		ЭтаФорма.НоваяКомпания = Ложь;
		Элементы.Компания.ТолькоПросмотр = Истина;
		Элементы.НоваяКомпания.ТолькоПросмотр = Истина;
		Если ЭтаФорма.ДокументСЦ.КонтактныеЛица.Количество() > 0 Тогда
			ЭтаФорма.КонтактноеЛицо = ЭтаФорма.ДокументСЦ.КонтактныеЛица[0].КонтактноеЛицо;
			ЭтаФорма.КонтактноеЛицоТекст = "";
			ЭтаФорма.НовоеКонтактноеЛицо = Ложь;
			ЭтаФорма.Телефон = ЭтаФорма.ДокументСЦ.КонтактныеЛица[0].ТелефонКонтактногоЛица;
		КонецЕсли;	
		
	Иначе
		
		ЭтаФорма.Компания = Неопределено;
		ЭтаФорма.НоваяКомпания = Ложь;
		Элементы.Компания.ТолькоПросмотр = Ложь;
		Элементы.НоваяКомпания.ТолькоПросмотр = Ложь;
		
		ЭтаФорма.КонтактноеЛицо = Неопределено;
		ЭтаФорма.НовоеКонтактноеЛицо = Ложь;
		Элементы.КонтактноеЛицо.ТолькоПросмотр = Ложь;
		Элементы.НовоеКонтактноеЛицо.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

