		Если ЭтаФорма.СостояниеИнтерес = "Завершен" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "CRM_Интерес.Завершен");
			
		КонецЕсли;
		
		
		Результат = Запрос.Выполнить().Выгрузить();
		
