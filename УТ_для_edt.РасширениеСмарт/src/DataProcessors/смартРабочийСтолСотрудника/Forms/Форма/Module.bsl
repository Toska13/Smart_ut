	|			КОГДА &КонецПериода <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА сфпИсторияЗвонков.Звонок.Дата <= &КонецПериода
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И сфпИсторияЗвонков.Звонок.Ответственный = &Ответственный
	|	И сфпИсторияЗвонков.Звонок.сфпСостояниеЗвонка = ЗНАЧЕНИЕ(Перечисление.сфпСостоянияЗвонков.Отвеченный)
	|	И сфпИсторияЗвонков.Звонок.сфпДлительностьЗвонка >= &ДлительностьЗвонка
	|
	|СГРУППИРОВАТЬ ПО
	|	сфпИсторияЗвонков.Звонок,
	|	сфпИсторияЗвонков.Входящий
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Звонок
	|;
