&НаКлиенте
Процедура ВидимостьАвторовИсполнителей()
	
	Если ВидимостьАвторовИсполнителей Тогда
		Элементы.ГруппаАвторы.ЦветФона = Новый Цвет(255,255,255);
		Элементы.ГруппаИсполнители.ЦветФона = Новый Цвет(215,240,199);
		Элементы.ТаблицаАвтор.Видимость = Истина;
		Элементы.ТаблицаИсполнитель.Видимость = Ложь;    
		Элементы.ДекорацияАвторы.Шрифт = Новый Шрифт("Arial",9 ,Истина,,Ложь); 
		Элементы.ДекорацияИсполнители.Шрифт = Новый Шрифт("Arial",9 ,Ложь,,Истина);
	Иначе
		Элементы.ГруппаАвторы.ЦветФона = Новый Цвет(215,240,199);
		Элементы.ГруппаИсполнители.ЦветФона = Новый Цвет(255,255,255);
		Элементы.ТаблицаАвтор.Видимость = Ложь;
		Элементы.ТаблицаИсполнитель.Видимость = Истина; 
		Элементы.ДекорацияАвторы.Шрифт = Новый Шрифт("Arial",9 ,Ложь,,Истина);
		Элементы.ДекорацияИсполнители.Шрифт = Новый Шрифт("Arial",9 ,Истина,,Ложь);
	КонецЕсли;
	
КонецПроцедуры

