	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаЗавтра", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Вид", , , , Ложь);
	
	ВыбранныйВид = "";
	
	Если не Автор.Пустая() Тогда		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Автор", Автор, ВидСравненияКомпоновкиДанных.Равно, , Истина);	
