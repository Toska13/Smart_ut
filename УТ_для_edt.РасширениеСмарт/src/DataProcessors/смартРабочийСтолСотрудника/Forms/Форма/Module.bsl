&НаСервере
Функция ВернутьМассивИнтересов(ИмяДинамическогоСписка)
	
	Схема = Элементы[ИмяДинамическогоСписка].ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы[ИмяДинамическогоСписка].ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема,Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат Результат.ВыгрузитьКолонку("Интерес");
	
КонецФункции	

&НаКлиенте
Процедура ТаблицаЧастноеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;    
	ВидСтроки = Элемент.ТекущиеДанные.ВидСтроки;
	Показатель = Элемент.ТекущиеДанные.Показатель;
	НеОбновлятьДС = Ложь;
	
	Если ВидСтроки <> 2 Тогда
		
		ВыбранныйВид = Элемент.ТекущиеДанные.Показатель;
		
		Если ТекущаяСтраница = "МоиДела" Тогда  
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Ложь, Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Ложь, Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаЗавтра", Ложь, Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
			
