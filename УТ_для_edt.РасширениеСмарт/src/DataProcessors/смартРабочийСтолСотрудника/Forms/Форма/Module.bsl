&НаКлиенте
Процедура ДЗМоиЗвонкиПриАктивизацииСтроки(Элемент)
	
	ДанныеСтроки = Элементы.ДЗМоиЗвонки.ТекущиеДанные; 
	
	Если ДанныеСтроки <> Неопределено И ТипЗнч(ДанныеСтроки.Партнер) = Тип("СправочникСсылка.Партнеры")  Тогда
		ЗаполнитьЗвонкиПоПартнеру(ДанныеСтроки.ДатаЗвонка, ДанныеСтроки.Партнер);
	Иначе
		ТЗЗвонкиПоПартнеру.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьЗвонкиПоПартнеру(ДатаЗвонка,ПартнерЗвонка)
	
	ТЗЗвонкиПоПартнеру.Очистить();
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТелефонныйЗвонок.Ссылка КАК ДокументЗвонка,
	|	ТелефонныйЗвонок.Дата КАК ДатаЗвонка,
	|	ТелефонныйЗвонок.сфпДлительностьЗвонка КАК ДлительностьЗвонка,
	|	ТелефонныйЗвонок.смартДлительностьЗвонка КАК смартДлительностьЗвонка,
	|	ТелефонныйЗвонок.сфпСостояниеЗвонка КАК Состояние
	|ИЗ
	|	Документ.ТелефонныйЗвонок КАК ТелефонныйЗвонок
	|ГДЕ
	|	ТелефонныйЗвонок.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И ТелефонныйЗвонок.АбонентКонтакт = &ПартнерЗвонка
	|	И ТелефонныйЗвонок.сфпДлительностьЗвонка > 30
	|	И ТелефонныйЗвонок.Ответственный = &Ответственный";
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаЗвонка));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаЗвонка));
	Запрос.УстановитьПараметр("ПартнерЗвонка", ПартнерЗвонка);
	Запрос.УстановитьПараметр("Ответственный", Исполнитель);
	
	ТЗЗвонкиПоПартнеру.Загрузить( Запрос.Выполнить().Выгрузить());
	
	
КонецПроцедуры

