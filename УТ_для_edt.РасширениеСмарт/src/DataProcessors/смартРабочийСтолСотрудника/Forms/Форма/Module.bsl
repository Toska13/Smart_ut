	ТЗЭтапыОбработкиИнтересов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЕстьЗамечания = 0;
	ВПроцессеКвалификации = 0;
	НеКвалифицированБолее1Дня = 0;
	НеКвалифицированБолее5Дней = 0;
	НеОтправленоКПБолее1Дня = 0;
	ВПроцессеСогласованияКП = 0;
	КПОтправленоБолее1Дня = 0;
	КПОтправленоБолее5Дней = 0;
	КПСогласованоБолее3Дней = 0;
	ВПроцессеОплаты = 0;
	СчетОтправленБолее5Дней = 0;
