	Для Каждого СтрТЗЭтапыОбработкиИнтересов Из ТЗЭтапыОбработкиИнтересов Цикл
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа <= 4 Тогда
			
			ВПроцессеКвалификации = ВПроцессеКвалификации +1;
			СтрТЗЭтапыОбработкиИнтересов.ВПроцессеКвалификации = Истина;
			
			Если НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаИнтереса) + 86400 * 5 < НачалоДня(ТекущаяДата()) Тогда
				
				НеКвалифицированБолее5Дней = НеКвалифицированБолее5Дней + 1;
				СтрТЗЭтапыОбработкиИнтересов.НеКвалифицированБолее5Дней = Истина;
				
				СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
				
			КонецЕсли; 
			
			Если НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаИнтереса) + 86400 < НачалоДня(ТекущаяДата()) Тогда 
				
				НеКвалифицированБолее1Дня = НеКвалифицированБолее1Дня + 1;
				СтрТЗЭтапыОбработкиИнтересов.НеКвалифицированБолее1Дня = Истина;
				СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа = 8 
			И НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаНачалаТекЭтап) + 86400 < НачалоДня(ТекущаяДата()) Тогда
			
			НеОтправленоКПБолее1Дня = НеОтправленоКПБолее1Дня + 1;
			СтрТЗЭтапыОбработкиИнтересов.НеОтправленоКПБолее1Дня = Истина;
			СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
			
		КонецЕсли; 
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа >= 10 И СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа <= 12 Тогда
			
			ВПроцессеСогласованияКП = ВПроцессеСогласованияКП +1;
			СтрТЗЭтапыОбработкиИнтересов.ВПроцессеСогласованияКП = Истина;
			
			Если НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаНачалаТекЭтап) + 86400 * 5 < НачалоДня(ТекущаяДата()) Тогда
				
				КПОтправленоБолее5Дней = КПОтправленоБолее5Дней + 1;
				СтрТЗЭтапыОбработкиИнтересов.КПОтправленоБолее5Дней = Истина;
				СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
				
			КонецЕсли; 
			
			Если НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаНачалаТекЭтап) + 86400 < НачалоДня(ТекущаяДата()) Тогда 
				
				КПОтправленоБолее1Дня = КПОтправленоБолее1Дня + 1;
				СтрТЗЭтапыОбработкиИнтересов.КПОтправленоБолее1Дня = Истина;
				СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа = 13 
			И НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаНачалаТекЭтап) + 86400 * 3 < НачалоДня(ТекущаяДата()) Тогда
			
			КПСогласованоБолее3Дней = КПСогласованоБолее3Дней + 1;
			СтрТЗЭтапыОбработкиИнтересов.КПСогласованоБолее3Дней = Истина;
			СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания = Истина;
			
		КонецЕсли;
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа >= 14 
			И СтрТЗЭтапыОбработкиИнтересов.ПроцентОплаты < 100 Тогда
			
			ВПроцессеОплаты = ВПроцессеОплаты + 1;
			СтрТЗЭтапыОбработкиИнтересов.ВПроцессеОплаты = Истина;
			
		КонецЕсли;
		
		Если СтрТЗЭтапыОбработкиИнтересов.ПорядокЭтапа = 14
			И НачалоДня(СтрТЗЭтапыОбработкиИнтересов.ДатаНачалаТекЭтап) + 86400 * 5 < НачалоДня(ТекущаяДата())
			И СтрТЗЭтапыОбработкиИнтересов.ПроцентОплаты < 100 Тогда
			
