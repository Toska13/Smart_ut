&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БезДублей = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаЗавтра", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ТекущаяДата", ТекущаяДата(), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСКонтактнаяИнформация, "Партнер", Справочники.Партнеры.ПустаяСсылка(), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСОборудованиеЧернила, "Партнер", Справочники.Партнеры.ПустаяСсылка(), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСЧернилаОборудование, "Партнер", Справочники.Партнеры.ПустаяСсылка(), Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСЗаметкиПартнерыИнтересы, "Предмет", Ложь, Истина);
	УстановитьПараметрыСпискаНоменклатуры(ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	
	
	Исполнитель = Пользователи.ТекущийПользователь();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Исполнитель", Исполнитель, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	ОтветственныйИнтерес = Пользователи.ТекущийПользователь();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДСИнтересы, "Ответственный", ОтветственныйИнтерес, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	ОтветственныйПартнеры = Пользователи.ТекущийПользователь();
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДСПартнеры, "ОсновнойМенеджер", ОтветственныйПартнеры, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	ОтветственныйПартнерыЗапчасти = Пользователи.ТекущийПользователь();
