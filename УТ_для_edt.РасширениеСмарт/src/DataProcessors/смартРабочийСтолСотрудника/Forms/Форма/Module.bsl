&НаСервере
Функция ПолучитьПраваВсеДела()
	
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат "Администратор";
	ИначеЕсли  РольДоступна("смартРуководительCRM") Тогда
		Возврат "Руководители";
	Иначе		
		Запрос = новый Запрос();	
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыПользователейСостав.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА ГруппыПользователейСостав.Ссылка.Наименование ПОДОБНО ""%Менеджеры%""
		|			ТОГДА ""Менеджеры""
		|		КОГДА ГруппыПользователейСостав.Ссылка.Наименование ПОДОБНО ""%Руководство техцентра%""
		|			ТОГДА ""Руководители""
		|		КОГДА ГруппыПользователейСостав.Ссылка.Наименование ПОДОБНО ""%Комм. отдел техцентр%""
		|			ТОГДА ""Инженеры""
		|		КОГДА ГруппыПользователейСостав.Ссылка.Наименование ПОДОБНО ""%Руководители Комм отдела%""
		|			ТОГДА ""Руководители""
		|		ИНАЧЕ ""НеОпределено""
		|	КОНЕЦ КАК Получили
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Пользователь = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
		
		РезЗапрос = Запрос.Выполнить().Выбрать();
		
		Если РезЗапрос.Следующий() Тогда
			Возврат РезЗапрос.Получили; 
		Конецесли;		
	КонецЕсли;
	
КонецФункции


&НаКлиенте
Процедура ПроставитьДоступыКРазделам()
	
	Получили = ПолучитьПраваВсеДела();	
	
	Если Получили = "Администратор" Тогда
		ДоступАкции=Истина;
		ДоступИнтересы=Истина;
		ДоступМоиРекомендации=Истина;
		ДоступНастройки=Истина;
		ДоступПартнеры=Истина; 	
	ИначеЕсли Получили = "Менеджеры" Тогда
		ДоступАкции=Истина;
		ДоступИнтересы=Истина;
		ДоступМоиРекомендации=Ложь;
		ДоступНастройки=Ложь;
		ДоступПартнеры=Истина; 
		ЗапретЗакрытия = Истина;
	ИначеЕсли Получили = "Инженеры" Тогда	 
		ДоступАкции=Истина;
		ДоступИнтересы=Истина;
		ДоступМоиРекомендации=Истина;
		ДоступНастройки=Ложь;
		ДоступПартнеры=Истина;
		ЗапретЗакрытия = Истина;
	ИначеЕсли  Получили = "Руководители" Тогда	
		ДоступАкции=Истина;
		ДоступИнтересы=Истина;
		ДоступМоиРекомендации=Ложь;
		ДоступНастройки=Ложь;
		ДоступПартнеры=Истина; 	
	Конецесли;
	
	ОбновитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	
	Элементы.ГруппаТопПартнеры.Видимость = ДоступПартнеры;
	Элементы.ГруппаТопИнтересы.Видимость = ДоступИнтересы;
	Элементы.ГруппаТопРекомендации.Видимость = ДоступМоиРекомендации;
	Элементы.ГруппаТопАкции.Видимость = ДоступАкции;
	Элементы.ГруппаТопНастройки.Видимость = ДоступНастройки;
	
КонецПроцедуры


