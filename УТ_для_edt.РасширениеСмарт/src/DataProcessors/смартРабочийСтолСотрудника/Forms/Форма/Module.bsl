	|	СУММА(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(ЗвонкиМенеджеров.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|							ТОГДА НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|						ИНАЧЕ ЗвонкиМенеджеров.Период
	|					КОНЕЦ = &ЭтотМесяц
	|					И ЕСТЬNULL(ЗвонкиМенеджеров.ДлительностьЗвонка, 0) <> 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭтотМесяцЗвонки,
	|	СУММА(ВЫБОР
	|			КОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ЗвонкиМенеджеров.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|					ИНАЧЕ ЗвонкиМенеджеров.Период
	|				КОНЕЦ = &ЭтотМесяцМинус1
	|				ТОГДА ЗвонкиМенеджеров.ДлительностьЗвонка
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭтотМесяцМинус1Минуты,
	|	СУММА(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(ЗвонкиМенеджеров.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|							ТОГДА НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|						ИНАЧЕ ЗвонкиМенеджеров.Период
	|					КОНЕЦ = &ЭтотМесяцМинус1
	|					И ЕСТЬNULL(ЗвонкиМенеджеров.ДлительностьЗвонка, 0) <> 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭтотМесяцМинус1Звонки,
	|	СУММА(ВЫБОР
	|			КОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ЗвонкиМенеджеров.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|						ТОГДА НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|					ИНАЧЕ ЗвонкиМенеджеров.Период
	|				КОНЕЦ = &ЭтотМесяцМинус2
	|				ТОГДА ЗвонкиМенеджеров.ДлительностьЗвонка
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭтотМесяцМинус2Минуты,
	|	СУММА(ВЫБОР
	|			КОГДА ВЫБОР
	|						КОГДА ЕСТЬNULL(ЗвонкиМенеджеров.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|							ТОГДА НАЧАЛОПЕРИОДА(&ДатаНачала, МЕСЯЦ)
	|						ИНАЧЕ ЗвонкиМенеджеров.Период
	|					КОНЕЦ = &ЭтотМесяцМинус2
	|					И ЕСТЬNULL(ЗвонкиМенеджеров.ДлительностьЗвонка, 0) <> 0
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭтотМесяцМинус2Звонки
	|ИЗ
	|	ПартнерыСМаенеджерами КАК ПартнерыСМаенеджерами
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗвонкиМенеджеров КАК ЗвонкиМенеджеров
	|		ПО ПартнерыСМаенеджерами.Партнер = ЗвонкиМенеджеров.Абонент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСостояниеПартнеров КАК смартСостояниеПартнеров
	|		ПО ПартнерыСМаенеджерами.Партнер = смартСостояниеПартнеров.Партнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоследнийЗвонок КАК ПоследнийЗвонок
	|		ПО ПартнерыСМаенеджерами.Партнер = ПоследнийЗвонок.Абонент
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗакрепленныеКлиенты КАК ЗакрепленныеКлиенты
	|		ПО ПартнерыСМаенеджерами.Партнер = ЗакрепленныеКлиенты.Партнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланируемыеВзаимодействия КАК ПланируемыеВзаимодействия
	|		ПО ПартнерыСМаенеджерами.Партнер = ПланируемыеВзаимодействия.Партнер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПродажиПартнеров КАК ПродажиПартнеров
	|		ПО ПартнерыСМаенеджерами.Партнер = ПродажиПартнеров.Партнер
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартнерыСМаенеджерами.Партнер.ОсновнойМенеджер.Подразделение,
	|	ПартнерыСМаенеджерами.Партнер.ОсновнойМенеджер,
	|	смартСостояниеПартнеров.Статус,
	|	ПартнерыСМаенеджерами.Партнер,
	|	ПартнерыСМаенеджерами.Партнер.ДатаРегистрации,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПартнерыСМаенеджерами.Партнер.ОсновнойМенеджер, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) = ЕСТЬNULL(ЗакрепленныеКлиенты.Менеджер, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПартнерыСМаенеджерами.Партнер.ОсновнойМенеджер, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) = ЕСТЬNULL(ЗакрепленныеКлиенты.Менеджер, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка))
	|			ТОГДА ЗакрепленныеКлиенты.Период
	|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ПоследнийЗвонок.Период, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА 0
	|		ИНАЧЕ РАЗНОСТЬДАТ(ЕСТЬNULL(ПоследнийЗвонок.Период, ДАТАВРЕМЯ(1, 1, 1)), &ТекущаяДата, ДЕНЬ)
	|	КОНЕЦ,
	|	ПланируемыеВзаимодействия.ПлановаяДата,
	|	ПродажиПартнеров.КоличествоПродажОборудования,
	|	ПродажиПартнеров.СуммаПродажОборудования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Статус УБЫВ
	|ИТОГИ ПО
	|	Ответственный,
	|	Статус";
	
	
	//ТекМесМинус3 = ДобавитьМесяц(ТекущаяДата(), -3);
	ТекМесМинус2 = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -2));
	ТекМесМинус1 = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
	
	Элементы.ДЗЗакрепленныеПартнерыГруппаМесяц.Заголовок = Формат(ТекущаяДата(),"ДФ=MMMM.yyyy"); 
	Элементы.ДЗЗакрепленныеПартнерыГруппаМесяц2.Заголовок = Формат(ТекМесМинус1,"ДФ=MMMM.yyyy"); 
	Элементы.ДЗЗакрепленныеПартнерыГруппаМесяц3.Заголовок = Формат(ТекМесМинус2,"ДФ=MMMM.yyyy"); 
	
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ТекМесМинус2));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДата()));  
	Запрос.УстановитьПараметр("ДлительностьЗвонка", 30);  	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());  	
	Запрос.УстановитьПараметр("ТолькоЗакрепленные", Истина);
	Запрос.УстановитьПараметр("ЭтотМесяц", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЭтотМесяцМинус1", ТекМесМинус1);
	Запрос.УстановитьПараметр("ЭтотМесяцМинус2", ТекМесМинус2); 	
	Запрос.УстановитьПараметр("Ответственный", Исполнитель);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КоллекцияЭлементовДерева = ДЗЗакрепленныеПартнеры.ПолучитьЭлементы();
	КоллекцияЭлементовДерева.Очистить();
	ОбщегоНазначения.ЗаполнитьКоллекциюЭлементовДереваДанныхФормы(КоллекцияЭлементовДерева, РезультатЗапроса);
	
	
КонецПроцедуры

