&НаКлиенте
// Процедура - обработчик команды формы "ПрослушатьЗаписьРазговора".
//
Процедура ПрослушатьЗаписьРазговора(ОбъектЗвонка)
	
	НужныеДанные = ПолучитьНужныеДанныеДляЗвонка(ОбъектЗвонка);
	
	ПараметрыЗвонка = Новый Структура("ИдентификаторЗвонка, ИдентификаторЗаписи, Ответственный, Входящий, НомерТелефона, ВнутреннийНомер, ДатаНачала, ДатаОкончания, Звонок",
	НужныеДанные.сфпИдентификаторЗвонка, НужныеДанные.сфпИдентификаторЗаписи, НужныеДанные.Ответственный, НужныеДанные.Входящий, НужныеДанные.АбонентКакСвязаться, НужныеДанные.сфпВнутреннийНомер, НужныеДанные.сфпДатаНачала, НужныеДанные.сфпДатаОкончания, НужныеДанные.Ссылка);
	сфпСофтФонПроКлиент.НачатьПрослушиваниеЗаписиРазговора(ПараметрыЗвонка, ЭтаФорма, Элементы.ТЗЗвонкиПоПартнеру);
	
КонецПроцедуры // ПрослушатьЗаписьРазговора()

Функция ПолучитьНужныеДанныеДляЗвонка(ОбъектЗвонка)
	
	Если НЕ ОбъектЗвонка.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	сфпИсторияЗвонков.ВнутреннийНомер КАК ВнутреннийНомер,
		|	сфпИсторияЗвонков.ДатаНачала КАК ДатаНачала,
		|	сфпИсторияЗвонков.ДатаОтвета КАК ДатаОтвета,
		|	сфпИсторияЗвонков.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.сфпИсторияЗвонков КАК сфпИсторияЗвонков
		|ГДЕ
		|	сфпИсторияЗвонков.Звонок = &Звонок
		|	И сфпИсторияЗвонков.ИдентификаторЗвонка = &ИдентификаторЗвонка");
		Запрос.УстановитьПараметр("Звонок", ОбъектЗвонка.Ссылка);
		Запрос.УстановитьПараметр("ИдентификаторЗвонка", ОбъектЗвонка.сфпИдентификаторЗвонка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда   			
			СтруктураНужныхДанных = Новый Структура();
			СтруктураНужныхДанных.Вставить("сфпВнутреннийНомер", Выборка.ВнутреннийНомер); 
			СтруктураНужныхДанных.Вставить("сфпДатаНачала", Выборка.ДатаНачала); 
			СтруктураНужныхДанных.Вставить("сфпДатаОтвета", Выборка.ДатаОтвета); 
			СтруктураНужныхДанных.Вставить("сфпДатаОкончания", Выборка.ДатаОкончания); 
			СтруктураНужныхДанных.Вставить("сфпИдентификаторЗвонка", ОбъектЗвонка.сфпИдентификаторЗвонка);
			СтруктураНужныхДанных.Вставить("сфпИдентификаторЗаписи", ОбъектЗвонка.сфпИдентификаторЗаписи);
			СтруктураНужныхДанных.Вставить("Ответственный", ОбъектЗвонка.Ответственный);
			СтруктураНужныхДанных.Вставить("Входящий", ОбъектЗвонка.Входящий);
			СтруктураНужныхДанных.Вставить("АбонентКакСвязаться", ОбъектЗвонка.АбонентКакСвязаться);
			СтруктураНужныхДанных.Вставить("Ссылка", ОбъектЗвонка.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураНужныхДанных;
	
КонецФункции

