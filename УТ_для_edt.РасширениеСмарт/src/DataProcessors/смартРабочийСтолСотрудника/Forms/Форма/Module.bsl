&НаКлиенте
Процедура ДекорацияТопНажатие(Элемент)
	
	СтараяСтраница = ?(ТекущаяСтраница = "", "МоиДела", ТекущаяСтраница);
	ТекущаяСтраница = СтрЗаменить(Элемент.Имя, "ДекорацияТоп", "");
	ВидимостьОсновныхСтраниц(СтараяСтраница);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьОсновныхСтраниц(СтараяСтраница)
	
	Если ТекущаяСтраница <> "" Тогда
		
		Если Элементы["ГруппаСтраница" + ТекущаяСтраница].Имя = "ГруппаСтраницаПартнеры" Тогда
			ТекущаяСтраницаВременная = Элементы["ГруппаПартнерыИИнтересы"];
		ИначеЕсли Элементы["ГруппаСтраница" + ТекущаяСтраница].Имя = "ГруппаСтраницаИнтересы" Тогда	
			ТекущаяСтраницаВременная = Элементы["ГруппаПартнерыИИнтересы"];
		Иначе
			ТекущаяСтраницаВременная = Элементы["ГруппаСтраница" + ТекущаяСтраница];
		КонецЕсли;	
		
		Элементы.СтраницыЦентральные.ТекущаяСтраница = ТекущаяСтраницаВременная; 
		
		Элементы["ДекорацияТоп" + СтараяСтраница].ЦветФона = Новый Цвет(215,240,199);
		Элементы["ДекорацияТоп" + СтараяСтраница].Шрифт = Новый Шрифт("Arial",9,,,Ложь);
		Элементы["ДекорацияТоп" + СтараяСтраница].Гиперссылка = Истина; 
		
		Элементы["ГруппаТоп" + СтараяСтраница].ЦветФона = Новый Цвет(215,240,199);
		Элементы["ГруппаТоп" + СтараяСтраница].ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Низ;		
		
		Элементы["ДекорацияТоп" + ТекущаяСтраница].ЦветФона = Новый Цвет(255,255,255);
		Элементы["ДекорацияТоп" + ТекущаяСтраница].Шрифт = Новый Шрифт("Arial",11,Истина,,Ложь);
		Элементы["ДекорацияТоп" + ТекущаяСтраница].Гиперссылка = Ложь; 
		
		Элементы["ГруппаТоп" + ТекущаяСтраница].ЦветФона = Новый Цвет(198, 221, 183);
		
		Если ТекущаяСтраница = "Интересы" Тогда
			
			Элементы.ГруппаСтраницаИнтересы.Видимость = Истина;
			Элементы.ГруппаСтраницаПартнеры.Видимость = Ложь;
			
			Если ТекущаяСтраницаИнтересы = "ИнтересыВОбработке" Тогда  
				Если не Ответственный.Пустая() Тогда
					ПоказатьЭтапыОбработкиИнтересовНаСервере(); 
				Иначе   
					ТаблицаЧастное.Очистить();
				КонецЕсли;
			Иначе 
				ОбновитьТаблицуПоказателейИнтерес();
			КонецЕсли;
			
			Элементы.ГруппаАвторИсполнитель.Видимость = Ложь;
			
		ИначеЕсли ТекущаяСтраница = "Партнеры" Тогда
			
			Элементы.ГруппаСтраницаИнтересы.Видимость = Ложь;
			Элементы.ГруппаСтраницаПартнеры.Видимость = Истина;
			
			Если ТекущаяСтраницаПартнеры = "ГруппаОсновнойМенеджер" Тогда
				
				ОбновитьТаблицуПоказателейПартнеры();
				
			ИначеЕсли ТекущаяСтраницаПартнеры = "ГруппаМенеджерСЦ" Тогда
				
				ОбновитьТаблицуПоказателейПартнерыСЦ();
				
			ИначеЕсли ТекущаяСтраницаПартнеры = "ГруппаМенеджерПоРМ" Тогда 
				
				ОбновитьТаблицуПоказателейПартнерыРМ();
				
			КонецЕсли;	
			
			Элементы.ГруппаАвторИсполнитель.Видимость = Ложь;
			
		ИначеЕсли ТекущаяСтраница = "Рекомендации" Тогда
			
			ТаблицаЧастное.Очистить();
			Элементы.ГруппаАвторИсполнитель.Видимость = Ложь;
			
		Иначе	
			
			ОбновитьТаблицуПоказателей();
			Элементы.ГруппаАвторИсполнитель.Видимость = Истина;
			
		КонецЕсли;
		
	Конецесли;
	
КонецПроцедуры

