			СтрТЗЭтапыОбработкиИнтересов.ПоследнийКонтактБолее10Дней = Истина;
			
		КонецЕсли;
		
		Если СтрТЗЭтапыОбработкиИнтересов.ЕстьЗамечания Тогда
			
			ЕстьЗамечания = ЕстьЗамечания + 1;
			
		КонецЕсли; 
		
	КонецЦикла;	
	ТаблицаЧастное.Очистить();
	
	СтрТаблицаПоказателей = ТаблицаЧастное.Добавить();
	СтрТаблицаПоказателей.Показатель = " ";
	СтрТаблицаПоказателей.ВидСтроки = 2;
	
	СтрТаблицаПоказателей = ТаблицаЧастное.Добавить();
	СтрТаблицаПоказателей.Показатель = "ИНТЕРЕСЫ В ОБРАБОТКЕ";
	СтрТаблицаПоказателей.ВидСтроки = 2;
	
	//СтрТаблицаПоказателей = ТаблицаЧастное.Добавить();
	//СтрТаблицаПоказателей.Показатель = " ";
	//СтрТаблицаПоказателей.ВидСтроки = 2;
	
