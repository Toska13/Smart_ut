&НаКлиенте
Процедура ТаблицаПоказателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбранныйПоказатель = Элемент.ТекущиеДанные.Показатель;
	
	Если ВыбранныйПоказатель = "Просрочено" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Истина, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
		
	ИначеЕсли ВыбранныйПоказатель = "Всего" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
		
	ИначеЕсли ВыбранныйПоказатель = "На сегодня" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Истина, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Ложь, Истина);
		
	ИначеЕсли ВыбранныйПоказатель = "Завершено сегодня" Тогда	
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Просрочка", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаСегодня", Ложь, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗавершеноСегодня", Истина, Истина);
		
