&НаСервере
Процедура УстановитьСтатусНаСервере()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Статус КАК Статус,
	|	До КАК До,
	|	ДатаОтсрочкиПоОтпуску КАК ДатаОтсрочкиПоОтпуску
	|ИЗ
	|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(, Пользователь = &Пользователь)");
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Статус = Справочники.смартСтатусыСотрудников.ВОтпуске Тогда
			
			ДатаОтсрочкиПоОтпуску = Выборка.ДатаОтсрочкиПоОтпуску;
			
		ИначеЕсли ТекущийСтатусСотрудника = Справочники.смартСтатусыСотрудников.ВОтпуске Тогда
			
			ДатаОтсрочкиПоОтпуску = ТекущаяДата() + 3600 * 24 * 2 * ((НачалоДня(ДатаСтатуса) - НачалоДня(ТекущаяДата())) / (60 * 60 * 24));
			
		Иначе	
			
			ДатаОтсрочкиПоОтпуску = "";
			
		КонецЕсли;	
		
	Иначе
		
		Если ТекущийСтатусСотрудника = Справочники.смартСтатусыСотрудников.ВОтпуске Тогда
			
			ДатаОтсрочкиПоОтпуску = ТекущаяДата() + 3600 * 24 * 2 * ((НачалоДня(ДатаСтатуса) - НачалоДня(ТекущаяДата())) / (60 * 60 * 24));
			
		Иначе
			
			ДатаОтсрочкиПоОтпуску = "";
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ЗаписьРегистра = РегистрыСведений.смартИсторияСтатусовСотрудников.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Период = ТекущаяДата();
	ЗаписьРегистра.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	ЗаписьРегистра.Статус = ТекущийСтатусСотрудника;
	ЗаписьРегистра.До = ДатаСтатуса;
	ЗаписьРегистра.ДатаОтсрочкиПоОтпуску = ДатаОтсрочкиПоОтпуску;
	ЗаписьРегистра.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтсутствие(Команда)
	
	УстановитьСтатусНаСервере();
	Элементы.ГруппаОтсутствия.Скрыть();
	УстановитьЗаголовокДекорацииСтатусаСотрудника();
	
КонецПроцедуры

Процедура УстановитьЗаголовокДекорацииСтатусаСотрудника()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Статус КАК Статус,
	|	До КАК До
	|ИЗ
	|	РегистрСведений.смартИсторияСтатусовСотрудников.СрезПоследних(&ТекущаяДата, Пользователь = &Пользователь)");
	Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Статус = Справочники.смартСтатусыСотрудников.НаРабочемМесте Тогда
			
			Элементы.ДекорацияОтсутствия.Заголовок = "На рабочем месте";
			Элементы.ДекорацияОтсутствия.ЦветТекста = Новый Цвет(0, 128, 0);
			Элементы.Группа68.ЦветФона = Новый Цвет(240, 255, 240);
			Элементы.Группа67.ЦветФона = Новый Цвет(153, 204, 0);
			
		Иначе
			
			Элементы.ДекорацияОтсутствия.Заголовок = "" + Выборка.Статус + "";
			//Элементы.ДекорацияОтсутствия.Заголовок = "" + Выборка.Статус + ?(ЗначениеЗаполнено(Выборка.До), 
			//	", до " + Выборка.До, "");
