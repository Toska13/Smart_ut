&НаСервере
Процедура СоздатьРекомендациюНаСервере()
	
	ТекстОшибки = "Не заполнены следующие, обязательные реквизиты: " + Символы.пс;
	Отказ = Ложь;
	
	Если ТемаРекомендации = "" Тогда
		ТекстОшибки = ТекстОшибки + "Тема рекомендации" + Символы.пс;
		Отказ = Истина;
	КонецЕсли;
	
	Если ОписаниеРекомендации = "" Тогда
		ТекстОшибки = ТекстОшибки + "Описание рекомендации" + Символы.пс;
		Отказ = Истина;
	КонецЕсли;
	
	Если Квалификация.Пустая()  Тогда
		ТекстОшибки = ТекстОшибки + "Квалификация" + Символы.пс;	    
		Отказ = Истина;
	КонецЕсли;
	
	Если БизнесРегион.Пустая()  Тогда
		ТекстОшибки = ТекстОшибки + "Бизнес-регион" + Символы.пс;	    
		Отказ = Истина;
	КонецЕсли;
	
	Если Телефон = "" Тогда
		ТекстОшибки = ТекстОшибки + "Телефон" + Символы.пс;	    
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) И КонтактноеЛицоТекст = "" Тогда
		ТекстОшибки = ТекстОшибки + "Контактное лицо" + Символы.пс;	    
		Отказ = Истина;
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		ОбЛид = Документы.смартЛид.СоздатьДокумент();
		ОбЛид.СостояниеЛида = Перечисления.смартСостоянияЛидов.Новый;
		НужныйРегион = НайтиРегионВерхнегоУровня(БизнесРегион);
		ОбЛид.БизнесРегион = НужныйРегион;
		ОбЛид.Квалификация = Квалификация;
		ОбЛид.Дата = ТекущаяДата();
		ОбЛид.БизнесРегионТекст = НужныйРегион;
		ОбЛид.Имя = КонтактноеЛицоТекст;
		ОбЛид.КонтактноеЛицо = КонтактноеЛицо;
		ОбЛид.Партнер = Компания;
		ОбЛид.Тема = ТемаРекомендации;
		ОбЛид.Телефон = Телефон;
		ОбЛид.ТекстИсточника = ОписаниеРекомендации;
		ОбЛид.Распределил = ПараметрыСеанса.ТекущийПользователь;
		ОбЛид.ИсточникПолученияЛида = Справочники.CRM_ИсточникиПолученияЛидов.НайтиПоНаименованию("Рекомендация сотрудника");
		ОбЛид.Записать(РежимЗаписиДокумента.Запись);
		
		Элементы.ГруппаВсплывающаяРекомендации.Скрыть();
		
	Иначе	
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиРегионВерхнегоУровня(Регион)
	
	УстановитьПривилегированныйРежим(Истина);
	
	РегионПоиска=Регион;
	
	Пока ЗначениеЗаполнено(РегионПоиска.Родитель) Цикл
		РегионПоиска=НайтиРегионВерхнегоУровня(РегионПоиска.Родитель);
	КонецЦикла;
	
	Возврат РегионПоиска;
	
КонецФункции

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗапретЗакрытия Тогда 
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура АкцииДопГарантияПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.АкцииДопГарантия.ТекущиеДанные;
	
