
&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		Если ТипЗнч(ТекущиеДанные.Объект) = Тип("ДокументСсылка.CRM_Взаимодействие") Тогда
			Если ТипЗнч(ТекущиеДанные.Предмет) = Тип("СправочникСсылка.Партнеры") Тогда
				ПараметрыОткрытия = Новый Структура("Ключ, ПозиционироватьНаВзаимодействие", ТекущиеДанные.Предмет, ТекущиеДанные.Объект);
				ОткрытьФорму("Справочник.Партнеры.ФормаОбъекта", ПараметрыОткрытия);
				//++ #Б-3640 смарт: Фролов 27.06.2025 //Добавление функционала работы с взаимодействиями в заявки СЦ.	
			ИначеЕсли ТипЗнч(ТекущиеДанные.Предмет) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда
				ПараметрыОткрытия = Новый Структура("Ключ, ПозиционироватьНаВзаимодействие", ТекущиеДанные.Предмет, ТекущиеДанные.Объект);
				ОткрытьФорму("Документ.смартЗаявкаНаПускоНаладку.Форма.ФормаДокумента", ПараметрыОткрытия);
			ИначеЕсли ТипЗнч(ТекущиеДанные.Предмет) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
				ПараметрыОткрытия = Новый Структура("Ключ, ПозиционироватьНаВзаимодействие", ТекущиеДанные.Предмет, ТекущиеДанные.Объект);
				ОткрытьФорму("Документ.смартЗаявкаНаРемонтныеРаботы.Форма.ФормаДокумента", ПараметрыОткрытия);
				//-- #Б-3640 смарт: Фролов 27.06.2025
			Иначе
				ОткрытьФорму("Документ.CRM_Взаимодействие.Форма.ФормаДокумента", Новый Структура("Ключ", ТекущиеДанные.Объект));
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекущиеДанные.Объект) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда	
			Если ТипЗнч(ТекущиеДанные.Предмет) = Тип("ДокументСсылка.CRM_Интерес") Тогда
				ПараметрыОткрытия = Новый Структура("Ключ, ПозиционироватьНаВзаимодействие", ТекущиеДанные.Предмет, ТекущиеДанные.Объект);
				ОткрытьФорму("Документ.CRM_Интерес.ФормаОбъекта", ПараметрыОткрытия);
			ИначеЕсли ТипЗнч(ТекущиеДанные.Предмет) = Тип("СправочникСсылка.Партнеры") Тогда
				ПараметрыОткрытия = Новый Структура("Ключ, ПозиционироватьНаВзаимодействие", ТекущиеДанные.Предмет, ТекущиеДанные.Объект);
				ОткрытьФорму("Справочник.Партнеры.ФормаОбъекта", ПараметрыОткрытия);
			ИначеЕсли ТипЗнч(ТекущиеДанные.ПредметСостояниеИнтереса) = Тип("СправочникСсылка.CRM_ТочкиМаршрутов") Тогда
				ОткрытьФорму("Документ.CRM_Взаимодействие.Форма.ФормаДокумента", Новый Структура("Ключ", ТекущиеДанные.Предмет));
			Иначе	
				ОткрытьФорму("Задача.ЗадачаИсполнителя.Форма.CRM_ФормаЛичнойЗадачи", Новый Структура("Ключ", ТекущиеДанные.Объект));
			КонецЕсли;	
		Иначе	
			ОткрытьФорму("Документ.CRM_Интерес.Форма.ФормаДокументаНовая", Новый Структура("Ключ", ТекущиеДанные.Предмет));
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуПоказателей()
	
	ТаблицаАвтор.Очистить();
	ТаблицаИсполнитель.Очистить();
	ТаблицаПоказателей.Очистить();
	//Взаимодействия_.Очистить();
	//Задачи_.Очистить();
	
	// Sma   
	ТаблицаОбщая.Очистить();
	
	ВзаимодействияТЗ = Новый ТаблицаЗначений();
	ВзаимодействияТЗ.Колонки.Добавить("Показатель");
	ВзаимодействияТЗ.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
	ВзаимодействияТЗ.Колонки.Добавить("КоличествоСегодня", Новый ОписаниеТипов("Число"));
	ВзаимодействияТЗ.Колонки.Добавить("КоличествоПросрочено", Новый ОписаниеТипов("Число"));
	ВзаимодействияТЗ.Колонки.Добавить("КоличествоЗавтра", Новый ОписаниеТипов("Число"));
	
	ЗадачиТЗ = Новый ТаблицаЗначений();
	ЗадачиТЗ.Колонки.Добавить("Показатель");
	ЗадачиТЗ.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
	ЗадачиТЗ.Колонки.Добавить("КоличествоСегодня", Новый ОписаниеТипов("Число"));
	ЗадачиТЗ.Колонки.Добавить("КоличествоПросрочено", Новый ОписаниеТипов("Число"));
	ЗадачиТЗ.Колонки.Добавить("КоличествоЗавтра", Новый ОписаниеТипов("Число"));
	
	Всего = 0;
	НаСегодня = 0;
	Просрочено = 0;
	ЗавершеноСегодня = 0;
	НаЗавтра = 0;
	
	Если ЭтаФорма.ОтображатьПоказателиСУчетомОтборов Тогда
		
		Схема = Элементы.Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема,Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		
		Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
	Иначе
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	смартЖурналЗадачИВзаимодействий.Объект КАК Объект,
		|	смартЖурналЗадачИВзаимодействий.Дата КАК Дата,
		|	смартЖурналЗадачИВзаимодействий.Время КАК Время,
		|	смартЖурналЗадачИВзаимодействий.Предмет КАК Предмет,
		|	смартЖурналЗадачИВзаимодействий.Партнер КАК Партнер,
		|	смартЖурналЗадачИВзаимодействий.Контакт КАК Контакт,
		|	смартЖурналЗадачИВзаимодействий.Исполнитель КАК Исполнитель,
		|	смартЖурналЗадачИВзаимодействий.Автор КАК Автор,
		|	смартЖурналЗадачИВзаимодействий.Состояние КАК Состояние,
		|	смартЖурналЗадачИВзаимодействий.Вид КАК Вид,
		|	смартЖурналЗадачИВзаимодействий.Тип КАК Тип,
		|	смартЖурналЗадачИВзаимодействий.РучноеДобавление КАК РучноеДобавление,
		|	смартЖурналЗадачИВзаимодействий.ДатаЗавершения КАК ДатаЗавершения
		|ИЗ
		|	РегистрСведений.смартЖурналЗадачИВзаимодействий КАК смартЖурналЗадачИВзаимодействий
		|ГДЕ
		|	1 = 1
		|	И 2 = 2");
		
		Если ЗначениеЗаполнено(ЭтаФорма.Исполнитель) Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "смартЖурналЗадачИВзаимодействий.Исполнитель = &Исполнитель");
			Запрос.УстановитьПараметр("Исполнитель", ЭтаФорма.Исполнитель);
			
		КонецЕсли;
		
		Если ЭтаФорма.Состояние = "ВРаботе" Тогда
			
			СпсСостояний = Новый СписокЗначений;
			СпсСостояний.Добавить(Справочники.CRM_СостоянияСобытий.ВРаботе);
			СпсСостояний.Добавить(Справочники.CRM_СостоянияСобытий.Запланировано);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "смартЖурналЗадачИВзаимодействий.Состояние В (&СпсСостояний)");
			Запрос.УстановитьПараметр("СпсСостояний", СпсСостояний);
			
		КонецЕсли;
		Если ЭтаФорма.Состояние = "Завершено" Тогда
			
			СпсСостояний = Новый СписокЗначений;
			СпсСостояний.Добавить(Справочники.CRM_СостоянияСобытий.Завершено);
			СпсСостояний.Добавить(Справочники.CRM_СостоянияСобытий.Отменено);
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "2 = 2", "смартЖурналЗадачИВзаимодействий.Состояние В (&СпсСостояний)");
			Запрос.УстановитьПараметр("СпсСостояний", СпсСостояний);
			
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	//ПартнерЗадачи.Очистить();
	//ПартнерЗадачи.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Партнер"));
	//ПартнерЗадачи.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	//ПартнерЗадачи.ЗаполнитьПометки(Ложь);
	
	Для Каждого СтрРезультат Из Результат Цикл
		
		Всего = Всего + 1;
		Если СтрРезультат.Тип = Перечисления.смартТипыДелСотрудников.Задача Тогда
			
			СтрокиЗадачи = ЗадачиТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
			Если СтрокиЗадачи.Количество() > 0 Тогда
				СтрокиЗадачи[0].КоличествоВсего = СтрокиЗадачи[0].КоличествоВсего + 1;
			Иначе	
				СтрЗадачи = ЗадачиТЗ.Добавить();
				СтрЗадачи.Показатель = СтрРезультат.Вид;
				СтрЗадачи.КоличествоВсего = 1;
			КонецЕсли;
			
		Иначе
			
			СтрокиВзаимодействия = ВзаимодействияТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
			Если СтрокиВзаимодействия.Количество() > 0 Тогда
				СтрокиВзаимодействия[0].КоличествоВсего = СтрокиВзаимодействия[0].КоличествоВсего + 1;
			Иначе	
				СтрВзаимодействия = ВзаимодействияТЗ.Добавить();
				СтрВзаимодействия.Показатель = СтрРезультат.Вид;
				СтрВзаимодействия.КоличествоВсего = 1;
			КонецЕсли;
			
		КонецЕсли;
		
		Если НачалоДня(СтрРезультат.Время) = НачалоДня(ТекущаяДата()) Тогда
			
			НаСегодня = НаСегодня + 1;
			
			Если СтрРезультат.Тип = Перечисления.смартТипыДелСотрудников.Задача Тогда
				
				СтрокиЗадачи = ЗадачиТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиЗадачи.Количество() > 0 Тогда
					СтрокиЗадачи[0].КоличествоСегодня = СтрокиЗадачи[0].КоличествоСегодня + 1;
				Иначе	
					СтрЗадачи = ЗадачиТЗ.Добавить();
					СтрЗадачи.Показатель = СтрРезультат.Вид;
					СтрЗадачи.КоличествоСегодня = 1;
				КонецЕсли;
				
			Иначе
				
				СтрокиВзаимодействия = ВзаимодействияТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиВзаимодействия.Количество() > 0 Тогда
					СтрокиВзаимодействия[0].КоличествоСегодня = СтрокиВзаимодействия[0].КоличествоСегодня + 1;
				Иначе	
					СтрВзаимодействия = ВзаимодействияТЗ.Добавить();
					СтрВзаимодействия.Показатель = СтрРезультат.Вид;
					СтрВзаимодействия.КоличествоСегодня = 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НачалоДня(СтрРезультат.Время) = НачалоДня(ТекущаяДата() + 86400) Тогда
			
			НаЗавтра = НаЗавтра + 1;
			
			Если СтрРезультат.Тип = Перечисления.смартТипыДелСотрудников.Задача Тогда
				
				СтрокиЗадачи = ЗадачиТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиЗадачи.Количество() > 0 Тогда
					СтрокиЗадачи[0].КоличествоЗавтра = СтрокиЗадачи[0].КоличествоЗавтра + 1;
				Иначе	
					СтрЗадачи = ЗадачиТЗ.Добавить();
					СтрЗадачи.Показатель = СтрРезультат.Вид;
					СтрЗадачи.КоличествоЗавтра = 1;
				КонецЕсли;
				
			Иначе
				
				СтрокиВзаимодействия = ВзаимодействияТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиВзаимодействия.Количество() > 0 Тогда
					СтрокиВзаимодействия[0].КоличествоЗавтра = СтрокиВзаимодействия[0].КоличествоЗавтра + 1;
				Иначе	
					СтрВзаимодействия = ВзаимодействияТЗ.Добавить();
					СтрВзаимодействия.Показатель = СтрРезультат.Вид;
					СтрВзаимодействия.КоличествоЗавтра = 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрРезультат.ДатаЗавершения) И СтрРезультат.Время < ТекущаяДата() Тогда
			
			Просрочено = Просрочено + 1;
			
			Если СтрРезультат.Тип = Перечисления.смартТипыДелСотрудников.Задача Тогда
				
				СтрокиЗадачи = ЗадачиТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиЗадачи.Количество() > 0 Тогда
					СтрокиЗадачи[0].КоличествоПросрочено = СтрокиЗадачи[0].КоличествоПросрочено + 1;
				Иначе	
					СтрЗадачи = ЗадачиТЗ.Добавить();
					СтрЗадачи.Показатель = СтрРезультат.Вид;
					СтрЗадачи.КоличествоПросрочено = 1;
				КонецЕсли;
				
			Иначе
				
				СтрокиВзаимодействия = ВзаимодействияТЗ.НайтиСтроки(Новый Структура("Показатель", СтрРезультат.Вид));
				Если СтрокиВзаимодействия.Количество() > 0 Тогда
					СтрокиВзаимодействия[0].КоличествоПросрочено = СтрокиВзаимодействия[0].КоличествоПросрочено + 1;
				Иначе	
					СтрВзаимодействия = ВзаимодействияТЗ.Добавить();
					СтрВзаимодействия.Показатель = СтрРезультат.Вид;
					СтрВзаимодействия.КоличествоПросрочено = 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НачалоДня(СтрРезультат.ДатаЗавершения) >= НачалоДня(ТекущаяДата()) 
			И КонецДня(СтрРезультат.ДатаЗавершения) <= КонецДня(ТекущаяДата()) Тогда
			ЗавершеноСегодня = ЗавершеноСегодня + 1;	
		КонецЕсли;
		
		Если НЕ ЭтаФорма.ОтображатьПоказателиСУчетомОтборов Тогда
			
			СтрокиТаблицаАвтор = ТаблицаАвтор.НайтиСтроки(Новый Структура("Автор", СтрРезультат.Автор));
			Если СтрокиТаблицаАвтор.Количество() > 0 Тогда
				СтрокиТаблицаАвтор[0].Количество = СтрокиТаблицаАвтор[0].Количество + 1;
			Иначе	
				СтрТаблицаАвтор = ТаблицаАвтор.Добавить();
				СтрТаблицаАвтор.Автор = СтрРезультат.Автор;
				СтрТаблицаАвтор.Количество = 1;
			КонецЕсли;
			
			СтрокиТаблицаИсполнитель = ТаблицаИсполнитель.НайтиСтроки(Новый Структура("Исполнитель", СтрРезультат.Исполнитель));
			Если СтрокиТаблицаИсполнитель.Количество() > 0 Тогда
				СтрокиТаблицаИсполнитель[0].Количество = СтрокиТаблицаИсполнитель[0].Количество + 1;
			Иначе	
				СтрТаблицаИсполнитель = ТаблицаИсполнитель.Добавить();
				СтрТаблицаИсполнитель.Исполнитель = СтрРезультат.Исполнитель;
				СтрТаблицаИсполнитель.Количество = 1;
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартЖурналЗадачИВзаимодействий.Объект КАК Объект,
	|	смартЖурналЗадачИВзаимодействий.ДатаЗавершения КАК ДатаЗавершения
	|ИЗ
	|	РегистрСведений.смартЖурналЗадачИВзаимодействий КАК смартЖурналЗадачИВзаимодействий
	|ГДЕ
	|	1 = 1
