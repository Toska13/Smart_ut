&НаКлиенте
Процедура ДСИнтересыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ДСИнтересы.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено И ЗначениеЗаполнено(ТекДанные.Партнер) Тогда
		
		СформироватьЗаметкиВзаимодействияПартнера(ТекДанные.Партнер);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСКонтактнаяИнформация, "Партнер", ТекДанные.Партнер, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСОборудованиеЧернила, "Партнер", ТекДанные.Партнер, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСЧернилаОборудование, "Партнер", ТекДанные.Партнер, Истина);
		CRM_СформироватьСтрокуРезультатаПоиска(ТекДанные.Партнер);
		
		ТекПартнер = ТекДанные.Партнер;
		
	Иначе
		
		ТекПартнер = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура СформироватьЗаметкиВзаимодействияПартнера(Партнер)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CRM_Взаимодействие.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)
	|			ТОГДА CRM_Взаимодействие.ДатаЗавершенияВзаимодействия
	|		ИНАЧЕ CRM_Взаимодействие.ПлановаяДата
	|	КОНЕЦ КАК Дата,
	|	CRM_Взаимодействие.СтатусВзаимодействия КАК СтатусВзаимодействия,
	|	ВЫБОР
	|		КОГДА CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)
	|			ТОГДА CRM_Взаимодействие.Результат
	|		ИНАЧЕ CRM_Взаимодействие.Тема + "" "" + (ВЫРАЗИТЬ(CRM_Взаимодействие.Содержание КАК СТРОКА(300)))
	|	КОНЕЦ КАК Описание,
	|	CRM_Взаимодействие.Ответственный КАК Ответственный,
	|	""Взаимодействие"" КАК Вид,
	|	CRM_Взаимодействие.Партнер КАК Партнер
	|ПОМЕСТИТЬ ЗаметкиВзаимодействия
	|ИЗ
	|	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
	|ГДЕ
	|	CRM_Взаимодействие.Партнер = &Партнер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Заметки.Ссылка,
	|	Заметки.ДатаЗаметки,
	|	""Завершено"",
	|	Заметки.ТекстСодержания,
	|	Заметки.Автор,
	|	""Заметка"",
	|	Заметки.Предмет
	|ИЗ
	|	Справочник.Заметки КАК Заметки
	|ГДЕ
	|	(Заметки.Предмет = &Партнер
	|			ИЛИ Заметки.смартПартнер = &Партнер)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаметкиВзаимодействия.Ссылка КАК Ссылка,
	|	ЗаметкиВзаимодействия.Дата КАК Дата,
	|	ЗаметкиВзаимодействия.СтатусВзаимодействия КАК Статус,
	|	ЗаметкиВзаимодействия.Описание КАК Описание,
	|	ЗаметкиВзаимодействия.Ответственный КАК Отправитель,
	|	ЗаметкиВзаимодействия.Вид КАК Вид,
	|	ЗаметкиВзаимодействия.Партнер КАК Партнер
	|ИЗ
	|	ЗаметкиВзаимодействия КАК ЗаметкиВзаимодействия
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	CRM_Интерес.Ссылка,
	|	CRM_Интерес.Дата,
	|	CRM_Интерес.СостояниеИнтереса,
	|	CRM_Интерес.Описание,
	|	CRM_Интерес.Ответственный,
	|	""Интерес"",
	|	CRM_Интерес.Партнер
	|ИЗ
	|	Документ.CRM_Интерес КАК CRM_Интерес
	|ГДЕ
	|	CRM_Интерес.Партнер = &Партнер
	|	И НЕ CRM_Интерес.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаметкиВзаимодействия.Ответственный КАК Ответственный,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЗаметкиВзаимодействия.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Запланировано)
	|				ТОГДА ЗаметкиВзаимодействия.Дата
	|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|		КОНЕЦ) КАК ДатаЗапланировано,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(ЗаметкиВзаимодействия.СтатусВзаимодействия, ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)) <> ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Запланировано)
	|				ТОГДА ЗаметкиВзаимодействия.Дата
	|			ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|		КОНЕЦ) КАК ДатаЗавершено,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.ОсновнойМенеджер = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.ОсновнойМенеджер = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Оборудование,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.смартОсновнойМенеджерСервисЦентра = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.смартОсновнойМенеджерСервисЦентра = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СЦ,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.смартМенеджерПоРасходнымМатериалам = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.смартМенеджерПоРасходнымМатериалам = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Расходка,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ЗаметкиВзаимодействия.СтатусВзаимодействия, ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)) <> ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Запланировано)
	|						ТОГДА ЗаметкиВзаимодействия.Дата
	|					ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|				КОНЕЦ <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА РАЗНОСТЬДАТ(ВЫБОР
	|							КОГДА ЕСТЬNULL(ЗаметкиВзаимодействия.СтатусВзаимодействия, ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Завершено)) <> ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Запланировано)
	|								ТОГДА ЗаметкиВзаимодействия.Дата
	|							ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	|						КОНЕЦ, &ТекДата, ДЕНЬ)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ДатаДней
	|ИЗ
	|	ЗаметкиВзаимодействия КАК ЗаметкиВзаимодействия
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЗаметкиВзаимодействия.Вид = ""Взаимодействие""
	|				ТОГДА ЗаметкиВзаимодействия.СтатусВзаимодействия = &СтатусВзаимодействия
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА ЗаметкиВзаимодействия.Вид <> ""Взаимодействие""
	|				ТОГДА ЗаметкиВзаимодействия.Дата < ДАТАВРЕМЯ(2024, 12, 16)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаметкиВзаимодействия.Ответственный,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.ОсновнойМенеджер = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.ОсновнойМенеджер = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.смартОсновнойМенеджерСервисЦентра = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.смартОсновнойМенеджерСервисЦентра = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ЗаметкиВзаимодействия.Партнер.смартМенеджерПоРасходнымМатериалам = ЗаметкиВзаимодействия.Ответственный
	|				ИЛИ ЗаметкиВзаимодействия.Партнер.Партнер.смартМенеджерПоРасходнымМатериалам = ЗаметкиВзаимодействия.Ответственный
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Оборудование УБЫВ,
	|	СЦ УБЫВ,
	|	Расходка УБЫВ,
	|	ДатаЗавершено УБЫВ";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("СтатусВзаимодействия", Справочники.CRM_СостоянияСобытий.Завершено);
	
	Пакет = Запрос.ВыполнитьПакет();
	ТабЛента.Загрузить(Пакет[1].Выгрузить());
	ТабЛентаПартнерыОтветственные.Загрузить(Пакет[2].Выгрузить());
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьЛентуИнтересаПартнера(ТекДанные)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	
	ВключенныеТипыОбъектов = ТипыОбъектовЛентыПоОтбору(ЛентаОтбор);
	ВключеныДокументы = ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "Документы");
	//Если ВключеныДокументы Тогда
	//	ПрочиеТипыОбъектов = CRM_ЛентаСобытийПовтИсп.ТипыОбъектовОтбораДокументов();
	//Иначе
	ПрочиеТипыОбъектов = Новый Массив;
	//КонецЕсли;
	ВключенныеТипыОбращений = ТипыОбращенийЛентыПоОтбору(ЛентаОтбор);
	
	ВключенныеВидыВзаимодействий = ВидыВзаимодействийЛентыПоОтбору(ЛентаОтбор); // Включают в себя направления.
	ВключенныеНаправленияЗвонков = НаправленияЗвонковПоОтбору(ЛентаОтбор);
	ВключенныеНаправленияЧатов = НаправленияЧатовПоОтбору(ЛентаОтбор);
	
	ВыведеноОбъектовИстории = 0;
	ВсегоОбъектовИстории = 0;
	
	ПараметрыЗапросаЛенты = Новый Структура;
	ПараметрыЗапросаЛенты.Вставить("Режим",					"ЛентаИнтереса");
	ПараметрыЗапросаЛенты.Вставить("ВключенаИстория",		ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "История"));
	ПараметрыЗапросаЛенты.Вставить("ВключеныПримечания",	ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "Примечания"));
	ПараметрыЗапросаЛенты.Вставить("ВключеныФайлы",			ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "Файлы"));
	ПараметрыЗапросаЛенты.Вставить("ВключеноИзменениеСостояния",	ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "ИзменениеСостояния"));
	ПараметрыЗапросаЛенты.Вставить("ВключеноИзменениеОтветственного",	ВключенаНастройкаОтбораЛенты(ЛентаОтбор, "ИзменениеОтветственного"));
	ПараметрыЗапросаЛенты.Вставить("ОбъектовИстории",		50);
	
	Запрос.Параметры.Вставить("ТекущаяДата",				ТекущаяДатаСеанса());
	Запрос.Параметры.Вставить("Объект",						ТекДанные.Ссылка);
	Запрос.Параметры.Вставить("ВключенныеТипыОбъектов",		ВключенныеТипыОбъектов);
	Запрос.Параметры.Вставить("ПрочиеТипыОбъектов",			ПрочиеТипыОбъектов);
	Запрос.Параметры.Вставить("ПустыеЗначенияКонтактов",	CRM_ЛентаСобытийПовтИсп.ПустыеЗначенияКонтактовВзаимодействий());
	Запрос.Параметры.Вставить("ТипИнтерес",					Тип("ДокументСсылка.CRM_Интерес"));
	Запрос.Параметры.Вставить("ВключенныеТипыОбращений",	ВключенныеТипыОбращений);
	Запрос.Параметры.Вставить("ВключенныеВидыВзаимодействий",	ВключенныеВидыВзаимодействий);
	Запрос.Параметры.Вставить("ВключенныеНаправленияЗвонков",	ВключенныеНаправленияЗвонков);
	Запрос.Параметры.Вставить("ВключенныеНаправленияЧатов",	ВключенныеНаправленияЧатов);
	
	ТекущийОбъект = ТекДанные.Ссылка;	
	
	МассивПредметов = Новый Массив;
	
	Если ТипЗнч(ТекущийОбъект) = Тип("ДокументСсылка.CRM_Интерес") Тогда
		
		Запрос.Текст = ВернутьТекстЗапроса();
		
		МассивПредметов.Добавить(ТекущийОбъект);
		Если ЗначениеЗаполнено(ТекущийОбъект.Партнер) Тогда
			МассивПредметов.Добавить(ТекущийОбъект.Партнер);
		КонецЕсли;
		
		ТелефонАбонента = "ХХХХХХХХХХ";
		
		
		ДокументОснование = ТекущийОбъект.ДокументОснование;
		
		Если ЗначениеЗаполнено(ДокументОснование) 
			И (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.CRM_Заявка")
			ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.смартЛид")) Тогда
			
			Если НЕ ДокументОснование.Телефон = "" Тогда
				
				ТелефонАбонента = ДокументОснование.Телефон;	
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Запрос.Параметры.Вставить("ТелефонАбонента", ТелефонАбонента);
		Запрос.УстановитьПараметр("МассивПредметов", МассивПредметов);
		Запрос.УстановитьПараметр("ДатаИнтереса", ТекущийОбъект.Дата);
		
	Иначе	
		
		Запрос.Текст = ВернутьТекстЗапросаПартнер();
		
		МассивПредметов.Добавить(ТекущийОбъект);
		Запрос.Параметры.Вставить("МассивПредметов", МассивПредметов);
		
		ЗапросКонтакты = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контакты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК Контакты
		|ГДЕ
		|	Контакты.Владелец = &Объект");
		ЗапросКонтакты.Параметры.Вставить("Объект", ТекущийОбъект);
		ДоступныеКонтакты = ЗапросКонтакты.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		ДоступныеКонтакты.Добавить(Справочники.КонтактныеЛицаПартнеров.ПустаяСсылка());
		Запрос.Параметры.Вставить("ДоступныеКонтакты", ДоступныеКонтакты);
		
	КонецЕсли;
	
	//ТабЛента.Загрузить(Запрос.Выполнить().Выгрузить());
	Пакет = Запрос.ВыполнитьПакет();
	ТабЛента.Загрузить(Пакет[12].Выгрузить());
	ТабЛентаПартнерыОтветственные.Загрузить(Пакет[11].Выгрузить());
	
	
	
	Для Каждого СтрТабЛента Из ТабЛента Цикл
		СтрТабЛента.Тип = ИзменитьНаименованиеТипа(СтрТабЛента.Тип);	
	КонецЦикла;		
	
	
	
	//ТЗПредварительнаяОтветственные = Новый ТаблицаЗначений();
	//ТЗПредварительнаяОтветственные.Колонки.Добавить("Ответственный");
	//ТЗПредварительнаяОтветственные.Колонки.Добавить("ДатаВзаимодействия");
	//
	//Для Каждого СтрТабЛента Из ТабЛента Цикл
	//	Если СтрТабЛента.Тип = "Заметка" или СтрТабЛента.Тип = "Завершенно взаимодействие" Тогда  
	//		ТЗПредварительнаяОтветственные.Добавить();
	//		ТЗПредварительнаяОтветственные.Ответственный = СтрТабЛента.Отправитель;
	//        ТЗПредварительнаяОтветственные.ДатаВзаимодействия = СтрТабЛента.Дата;
	//	Конецесли;
	//КонецЦикла;	
	
	//ТЗПредварительнаяОтветственные.Свернуть("Ответственный", 
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПродажиРасходники(ТекДанные)
	Запрос = Новый Запрос(
	//"ВЫБРАТЬ
	//|	РеализацияТоваровУслугТовары.Ссылка.ЗаказКлиента КАК ЗаказКлиента,
	//|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	//|	РеализацияТоваровУслугТовары.Количество КАК Количество,
	//|	РеализацияТоваровУслугТовары.СуммаСНДС КАК Сумма
	//|ИЗ
	//|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	//|ГДЕ
	//|	РеализацияТоваровУслугТовары.Ссылка.Проведен
	//|	И РеализацияТоваровУслугТовары.Ссылка.Партнер = &Партнер
	//|	И 1 = 1
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	РеализацияТоваровУслугТовары.Ссылка.Дата УБЫВ
	//|ИТОГИ
	//|	СУММА(СуммаСНДС)
	//|ПО
	//|	ЗаказКлиента");
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК ЗаказКлиента,
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот КАК Количество,
	|	ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиРеглОборот КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			АналитикаУчетаПоПартнерам.Партнер = &Партнер
	|				И АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры = &Запчасти) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.Дата УБЫВ
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента КАК ЗаказКлиента,
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВыручкаИСебестоимостьПродажОбороты.КоличествоОборот КАК Количество,
	|	ВыручкаИСебестоимостьПродажОбороты.СуммаВыручкиРеглОборот КАК Сумма
	|ИЗ
	|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
	|			,
	|			,
	|			,
	|			АналитикаУчетаПоПартнерам.Партнер = &Партнер
	|				И АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&Расходка)) КАК ВыручкаИСебестоимостьПродажОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.Дата УБЫВ
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	ЗаказКлиента");
	Запрос.УстановитьПараметр("Партнер", ТекДанные.Ссылка);
	Запрос.УстановитьПараметр("Запчасти", Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Запчасти сервисного центра"));
	Запрос.УстановитьПараметр("Расходка", Справочники.Номенклатура.НайтиПоКоду("ЦБ-00007802"));
	
	Пакет = Запрос.ВыполнитьПакет();
	РезультатЗапчасти = Пакет[0].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЗначениеВРеквизитФормы(РезультатЗапчасти, "ДЗПродажиЗапчасти");
	РезультатДляКоличества = Пакет[0].Выгрузить();
	РезультатДляКоличества.Свернуть("ЗаказКлиента", "Количество");
	Элементы.ГруппаПродажиСЦ.Заголовок = "Продажи СЦ - " + РезультатДляКоличества.Количество();
	
	РезультатРасходка = Пакет[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ЗначениеВРеквизитФормы(РезультатРасходка, "ДЗПродажиРасходников");
	РезультатДляКоличества = Пакет[1].Выгрузить();
	РезультатДляКоличества.Свернуть("ЗаказКлиента", "Количество");
	Элементы.ГруппаПродажиРасходников.Заголовок = "Продажи расходников - " + РезультатДляКоличества.Количество();
	
КонецПроцедуры	

&НаКлиенте
Процедура ДСПартнерыПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ДСПартнеры.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда
		СформироватьЗаметкиВзаимодействияПартнера(ТекДанные.Ссылка);
		//СформироватьПродажиРасходники(ТекДанные);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСКонтактнаяИнформация, "Партнер", ТекДанные.Ссылка, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСОборудованиеЧернила, "Партнер", ТекДанные.Ссылка, Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСЧернилаОборудование, "Партнер", ТекДанные.Ссылка, Истина);
		CRM_СформироватьСтрокуРезультатаПоиска(ТекДанные.Ссылка);
		ТекПартнер = ТекДанные.Ссылка;
	Иначе
		ТекПартнер = Неопределено;	
	КонецЕсли;
	
КонецПроцедуры

#Область ЛентаИнтереса

&НаСервере
Функция ВернутьТекстЗапроса()
	Возврат "ВЫБРАТЬ
	|	ЖурналДокументов.Объект КАК Ссылка,
	|	ТИПЗНАЧЕНИЯ(ЖурналДокументов.Объект) КАК ТипОбъекта,
	|	ЖурналДокументов.Дата КАК Дата,
	|	ЖурналДокументов.Номер КАК Номер,
	|	ЖурналДокументов.Сумма КАК Сумма,
	|	ЖурналДокументов.Валюта КАК Валюта,
	|	ЖурналДокументов.Автор КАК Автор,
	|	ЖурналДокументов.Проведен КАК Проведен,
	|	"""" КАК ТемаИнтереса,
	|	НЕОПРЕДЕЛЕНО КАК ТипОбращенияИнтереса,
	|	НЕОПРЕДЕЛЕНО КАК Интерес,
	|	ИСТИНА КАК ОсновнойИнтерес,
	|	ПРЕДСТАВЛЕНИЕ(ЖурналДокументов.ТипОбъекта) КАК Вид
	|ПОМЕСТИТЬ ОбъектыЖурналаОтбор
	|ИЗ
	|	РегистрСведений.CRM_ЖурналДокументов КАК ЖурналДокументов
	|ГДЕ
	|	ЖурналДокументов.CRM_Интерес = &Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыЖурнала.Ссылка КАК Ссылка,
	|	ОбъектыЖурнала.ТипОбъекта КАК ТипОбъекта,
	|	ОбъектыЖурнала.Дата КАК Дата,
	|	ОбъектыЖурнала.Номер КАК Номер,
	|	ОбъектыЖурнала.Сумма КАК Сумма,
	|	ОбъектыЖурнала.Валюта КАК Валюта,
	|	ОбъектыЖурнала.Автор КАК Автор,
	|	ОбъектыЖурнала.Проведен КАК Проведен,
	|	ОбъектыЖурнала.Вид КАК Вид
	|ПОМЕСТИТЬ УникальныеОбъектыЖурнала
	|ИЗ
	|	ОбъектыЖурналаОтбор КАК ОбъектыЖурнала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОбъектыЖурнала.Ссылка КАК Ссылка,
	|	ОбъектыЖурнала.ТемаИнтереса КАК ТемаИнтереса,
	|	ОбъектыЖурнала.ТипОбращенияИнтереса КАК ТипОбращенияИнтереса,
	|	ОбъектыЖурнала.Интерес КАК Интерес
	|ПОМЕСТИТЬ ИнтересыПоОбъектам
	|ИЗ
	|	ОбъектыЖурналаОтбор КАК ОбъектыЖурнала
	|ГДЕ
	|	ОбъектыЖурнала.ОсновнойИнтерес
	|;
