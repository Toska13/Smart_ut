//++ #Б-6510 смарт: Фролов 20.04.2026 //Добавить в Рабочий стол сотрудника раздел "Полезная информация"
Функция ПоместитьФайлИзСправочникаВоВременноеХранилище(СсылкаНаСправочник)
	
	ОбъектСправочника = СсылкаНаСправочник.ПолучитьОбъект();
	
	Если ОбъектСправочника = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ОбъектСправочника.ФайлХранилище = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ДвоичныеДанные = ОбъектСправочника.ФайлХранилище.Получить();
	
	АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
	
	Возврат АдресВременногоХранилища;

КонецФункции //-- #Б-6510 смарт: Фролов 20.04.2026

