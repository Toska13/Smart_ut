Процедура ОбновитьТаблицуПоказателейПартнерыСЦ()
	
	ТаблицаЧастное.Очистить();
	
	Закрепленные = 0;
	НеЗакрепленные = 0;
	ВзаимодействияЗапланированы = 0;
	ВзаимодействияНеЗапланированы = 0;
	ВзаимодействияЗапланированыНеЗакрепленные = 0;
	ВзаимодействияНеЗапланированыНеЗакрепленные = 0;
	ПросроченныеВзаимодействия = 0;
	ПросроченныеВзаимодействияНеЗакрепленные = 0;
	СтанутСвободнымиЧерез10Дн = 0;
	ЕстьАктивныйИнтерес = 0;
	Закрепленные = 0;
	НеЗакрепленные = 0;
	ВзаимодействияЗапланированыСИнтересом = 0;
	ВзаимодействияНеЗапланированыСИнтересом = 0;
	ПросроченныеВзаимодействияСИнтересом = 0;
	
	Если ЭтаФорма.ОтображатьПоказателиСУчетомОтборов Тогда
		
		Схема = Элементы.ДСПартнерыСЦ.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		Настройки = Элементы.ДСПартнерыСЦ.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
		
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема,Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		
		Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
	Иначе
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЗаказКлиента.Партнер КАК Партнер,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаказов
		|ПОМЕСТИТЬ Заказы
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	НЕ ЗаказКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
		|	И ЗаказКлиента.Проведен
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиента.Партнер
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер КАК Партнер,
		|	МАКСИМУМ(смартИсторияЗакрепленияПартнеровСрезПоследних.Период) КАК Период,
		|	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер КАК Менеджер
		|ПОМЕСТИТЬ Закрепления
		|ИЗ
		|	РегистрСведений.смартИсторияЗакрепленияПартнеров.СрезПоследних(, ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)) КАК смартИсторияЗакрепленияПартнеровСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер,
		|	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	CRM_Интерес.Партнер КАК Партнер,
		|	МАКСИМУМ(CRM_Интерес.ДатаЗакрытия) КАК Дата
		|ПОМЕСТИТЬ Интересы
		|ИЗ
		|	Документ.CRM_Интерес КАК CRM_Интерес
		|ГДЕ
		|	НЕ CRM_Интерес.ПометкаУдаления
		|	И (CRM_Интерес.СостояниеИнтереса.ВидСостояния <> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
		|			ИЛИ CRM_Интерес.СостояниеИнтереса.ВидСостояния <> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение))
		|	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартОсновнойМенеджерСервисЦентра
		|
		|СГРУППИРОВАТЬ ПО
		|	CRM_Интерес.Партнер
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	CRM_Интерес.Партнер КАК Партнер,
		|	МАКСИМУМ(CRM_Интерес.Дата) КАК Дата
		|ПОМЕСТИТЬ НЕЗакрытыеИнтересы
		|ИЗ
		|	Документ.CRM_Интерес КАК CRM_Интерес
		|ГДЕ
		|	НЕ CRM_Интерес.ПометкаУдаления
		|	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
		|	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение)
		|	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартОсновнойМенеджерСервисЦентра
		|
		|СГРУППИРОВАТЬ ПО
		|	CRM_Интерес.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
