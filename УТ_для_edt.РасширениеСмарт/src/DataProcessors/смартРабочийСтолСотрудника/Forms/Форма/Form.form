  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ИсполнителиЗадач.Исполнитель КАК Исполнитель,
	ИсполнителиЗадач.ГруппаИсполнителейЗадач КАК ГруппаИсполнителейЗадач
ПОМЕСТИТЬ ГруппыИсполнителейЗадач
ИЗ
	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗадачаИсполнителя.Ссылка КАК Ссылка,
	ГруппыИсполнителейЗадач.Исполнитель КАК Исполнитель
ПОМЕСТИТЬ ИсполнителиПоЗадачам
ИЗ
	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыИсполнителейЗадач КАК ГруппыИсполнителейЗадач
		ПО ЗадачаИсполнителя.ГруппаИсполнителейЗадач = ГруппыИсполнителейЗадач.ГруппаИсполнителейЗадач
ГДЕ
	ЗадачаИсполнителя.БизнесПроцесс ССЫЛКА БизнесПроцесс.CRM_БизнесПроцесс
	И НЕ ЗадачаИсполнителя.Выполнена
	И НЕ ЗадачаИсполнителя.ПометкаУдаления
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА смартЖурналЗадачИВзаимодействий.Тип = ЗНАЧЕНИЕ(Перечисление.смартТипыДелСотрудников.Автозадача)
			ТОГДА смартЖурналЗадачИВзаимодействий.Содержание
		ИНАЧЕ смартЖурналЗадачИВзаимодействий.Объект
	КОНЕЦ КАК Объект,
	смартЖурналЗадачИВзаимодействий.Дата КАК Дата,
	ВЫБОР
		КОГДА ЕСТЬNULL(ИсполнителиПоЗадачам.Исполнитель, 0) = 0
			ТОГДА смартЖурналЗадачИВзаимодействий.Время
		ИНАЧЕ &amp;ТекущаяДата
	КОНЕЦ КАК Время,
	смартЖурналЗадачИВзаимодействий.Предмет КАК Предмет,
	смартЖурналЗадачИВзаимодействий.Партнер КАК Партнер,
	смартЖурналЗадачИВзаимодействий.Контакт КАК Контакт,
	ВЫБОР
		КОГДА ЕСТЬNULL(ИсполнителиПоЗадачам.Исполнитель, 0) = 0
			ТОГДА смартЖурналЗадачИВзаимодействий.Исполнитель
		ИНАЧЕ ИсполнителиПоЗадачам.Исполнитель
	КОНЕЦ КАК Исполнитель,
	смартЖурналЗадачИВзаимодействий.Автор КАК Автор,
	смартЖурналЗадачИВзаимодействий.Состояние КАК Состояние,
	смартЖурналЗадачИВзаимодействий.Вид КАК Вид,
	смартЖурналЗадачИВзаимодействий.Тип КАК Тип,
	смартЖурналЗадачИВзаимодействий.РучноеДобавление КАК РучноеДобавление,
	смартЖурналЗадачИВзаимодействий.ДатаЗавершения КАК ДатаЗавершения,
	ВЫБОР
		КОГДА НЕ смартЖурналЗадачИВзаимодействий.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА 0
		КОГДА смартЖурналЗадачИВзаимодействий.Время = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА 0
		ИНАЧЕ РАЗНОСТЬДАТ(&amp;ТекущаяДата, смартЖурналЗадачИВзаимодействий.Время, ДЕНЬ)
	КОНЕЦ КАК ОсталосьДней,
	&quot;&quot; КАК р,
	ВЫБОР
		КОГДА ЕСТЬNULL(ИсполнителиПоЗадачам.Исполнитель, 0) = 0
			ТОГДА смартЖурналЗадачИВзаимодействий.Предмет.СостояниеИнтереса
		ИНАЧЕ ИсполнителиПоЗадачам.Ссылка.CRM_ТочкаМаршрута
	КОНЕЦ КАК ПредметСостояниеИнтереса,
	смартЖурналЗадачИВзаимодействий.Предмет.Избранный КАК Избранный,
	смартЖурналЗадачИВзаимодействий.Объект.Тема КАК Тема
ИЗ
	РегистрСведений.смартЖурналЗадачИВзаимодействий КАК смартЖурналЗадачИВзаимодействий
		ЛЕВОЕ СОЕДИНЕНИЕ ИсполнителиПоЗадачам КАК ИсполнителиПоЗадачам
		ПО смартЖурналЗадачИВзаимодействий.Объект = ИсполнителиПоЗадачам.Ссылка
ГДЕ
	ВЫБОР
			КОГДА &amp;Просрочка
				ТОГДА ВЫБОР
						КОГДА смартЖурналЗадачИВзаимодействий.ДатаЗавершения = ДАТАВРЕМЯ(1, 1, 1)
								И смартЖурналЗадачИВзаимодействий.Время &lt; &amp;ТекущаяДата
							ТОГДА ИСТИНА
						ИНАЧЕ ЛОЖЬ
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ЗавершеноСегодня
				ТОГДА ВЫБОР
						КОГДА НАЧАЛОПЕРИОДА(смартЖурналЗадачИВзаимодействий.ДатаЗавершения, ДЕНЬ) = НАЧАЛОПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ)
							ТОГДА ИСТИНА
						ИНАЧЕ ЛОЖЬ
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;НаСегодня
				ТОГДА ВЫБОР
						КОГДА НАЧАЛОПЕРИОДА(смартЖурналЗадачИВзаимодействий.Время, ДЕНЬ) = НАЧАЛОПЕРИОДА(&amp;ТекущаяДата, ДЕНЬ)
							ТОГДА ИСТИНА
						ИНАЧЕ ЛОЖЬ
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;НаЗавтра
				ТОГДА ВЫБОР
						КОГДА НАЧАЛОПЕРИОДА(смартЖурналЗадачИВзаимодействий.Время, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&amp;ТекущаяДата, ДЕНЬ, 1), ДЕНЬ)
							ТОГДА ИСТИНА
						ИНАЧЕ ЛОЖЬ
					КОНЕЦ
			ИНАЧЕ ИСТИНА
		КОНЕЦ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
