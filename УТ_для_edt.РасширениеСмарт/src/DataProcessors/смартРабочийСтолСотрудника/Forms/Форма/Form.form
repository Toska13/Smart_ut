      <name>КоличествоВсего</name>
      <title>
        <key>ru</key>
        <value>Количество всего</value>
      </title>
      <id>2</id>
      <valueType>
        <types>Number</types>
        <numberQualifiers>
          <precision>10</precision>
        </numberQualifiers>
      </valueType>
      <view>
