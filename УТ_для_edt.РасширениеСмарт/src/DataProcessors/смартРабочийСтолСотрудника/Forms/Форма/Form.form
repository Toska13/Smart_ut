  <attributes>
    <name>ДСПартнерыСЦ</name>
    <title>
      <key>ru</key>
      <value>ДСПартнеры</value>
    </title>
    <id>91</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказКлиента.Партнер КАК Партнер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаказов
ПОМЕСТИТЬ Заказы
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	НЕ ЗаказКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	И ЗаказКлиента.Проведен

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Партнер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ПартнерыCRM_ТипыОтношений.Ссылка КАК Ссылка
ПОМЕСТИТЬ Покупатели
ИЗ
	Справочник.Партнеры.CRM_ТипыОтношений КАК ПартнерыCRM_ТипыОтношений
ГДЕ
	ПартнерыCRM_ТипыОтношений.ТипОтношений = ЗНАЧЕНИЕ(Справочник.CRM_ТипыОтношений.Покупатель)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер КАК Партнер,
	МАКСИМУМ(смартИсторияЗакрепленияПартнеровСрезПоследних.Период) КАК Период,
	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер КАК Менеджер
ПОМЕСТИТЬ Закрепления
ИЗ
	РегистрСведений.смартИсторияЗакрепленияПартнеров.СрезПоследних(, ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)) КАК смартИсторияЗакрепленияПартнеровСрезПоследних

СГРУППИРОВАТЬ ПО
	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер,
	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	МАКСИМУМ(CRM_Интерес.ДатаЗакрытия) КАК Дата
ПОМЕСТИТЬ Интересы
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
ГДЕ
	НЕ CRM_Интерес.ПометкаУдаления
	И (CRM_Интерес.СостояниеИнтереса.ВидСостояния &lt;> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
			ИЛИ CRM_Интерес.СостояниеИнтереса.ВидСостояния &lt;> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение))
	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартОсновнойМенеджерСервисЦентра

СГРУППИРОВАТЬ ПО
	CRM_Интерес.Партнер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	МАКСИМУМ(CRM_Интерес.Дата) КАК Дата
ПОМЕСТИТЬ НЕЗакрытыеИнтересы
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
ГДЕ
	НЕ CRM_Интерес.ПометкаУдаления
	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение)
	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартОсновнойМенеджерСервисЦентра

СГРУППИРОВАТЬ ПО
	CRM_Интерес.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	CRM_Интерес.Дата КАК Дата,
	CRM_Интерес.СостояниеИнтереса КАК СостояниеИнтереса
ПОМЕСТИТЬ ПоследнийИнтересДанные
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НЕЗакрытыеИнтересы КАК НЕЗакрытыеИнтересы
		ПО CRM_Интерес.Партнер = НЕЗакрытыеИнтересы.Партнер
			И CRM_Интерес.Дата = НЕЗакрытыеИнтересы.Дата

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Партнеры.Ссылка КАК Партнер,
	Партнеры.ДатаРегистрации КАК ДатаРегистрации,
	Закрепления.Период КАК ПериодЗакрепления,
	Партнеры.БизнесРегион КАК БизнесРегион,
	Партнеры.ОсновнойМенеджер КАК ОсновнойМенеджер,
	ВЫБОР
		КОГДА ЕСТЬNULL(Заказы.КоличествоЗаказов, 0) > 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК АктивныйЗаказ,
	смартСостояниеПартнеров.ДатаЗапланированногоВзаимодействияСЦ КАК ДатаЗапланированногоВзаимодействия,
	ВЫБОР
		КОГДА ЕСТЬNULL(Закрепления.Период, ЛОЖЬ) = ЛОЖЬ
			ТОГДА ЛОЖЬ
		ИНАЧЕ ВЫБОР
				КОГДА Закрепления.Менеджер = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
					ТОГДА ЛОЖЬ
				ИНАЧЕ ИСТИНА
			КОНЕЦ
	КОНЕЦ КАК Закреплен,
	ПоследнийИнтересДанные.Дата КАК ДатаАктивныйИнтерес,
	&quot;&quot; КАК Р,
	ПоследнийИнтересДанные.СостояниеИнтереса КАК СостояниеИнтереса,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПоследнийИнтересДанные.Дата, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК АнализироватьВК,
	ВЫБОР
		КОГДА Закрепления.Период > ЕСТЬNULL(смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияСЦ, ДАТАВРЕМЯ(1, 1, 1))
			ТОГДА Закрепления.Период
		ИНАЧЕ смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияСЦ
	КОНЕЦ КАК ДатаКасания,
	ВЫБОР
		КОГДА Закрепления.Период > ЕСТЬNULL(Интересы.Дата, ДАТАВРЕМЯ(1, 1, 1))
			ТОГДА Закрепления.Период
		ИНАЧЕ Интересы.Дата
	КОНЕЦ КАК ДатаЗакреплениеИлиИнтерес,
	Интересы.Дата КАК ИнтересыДата,
	Партнеры.смартМенеджерПоРасходнымМатериалам КАК МенеджерПоРасходнымМатериалам,
	Партнеры.смартОсновнойМенеджерСервисЦентра КАК МенеджерСервисЦентра,
	смартСостояниеПартнеров.СостояниеСЦ КАК Состояние,
	смартСостояниеПартнеров.КоличествоПродажОборудования КАК КоличествоПродажОборудования,
	смартСостояниеПартнеров.СуммаПродажОборудования КАК СуммаПродажОборудования,
	смартСостояниеПартнеров.СуммаПродажЗапчастей КАК СуммаПродажЗапчастей,
	смартСостояниеПартнеров.СуммаПродажРасходников КАК СуммаПродажРасходников,
	смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияСЦ КАК ДатаПоследнегоВзаимодействия,
	смартСостояниеПартнеров.ДатаПоследнегоЗвонкаСЦ КАК ДатаПоследнегоЗвонка,
	Партнеры.Код КАК Код,
	смартСостояниеПартнеров.СтанетСвободнымЧерезСЦ КАК СтанетСвободнымЧерез
ПОМЕСТИТЬ ИтоговаяТаблица
ИЗ
	Справочник.Партнеры КАК Партнеры
		ЛЕВОЕ СОЕДИНЕНИЕ Заказы КАК Заказы
		ПО Партнеры.Ссылка = Заказы.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ Закрепления КАК Закрепления
		ПО Партнеры.Ссылка = Закрепления.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ ПоследнийИнтересДанные КАК ПоследнийИнтересДанные
		ПО Партнеры.Ссылка = ПоследнийИнтересДанные.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ Интересы КАК Интересы
		ПО Партнеры.Ссылка = Интересы.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСостояниеПартнеров КАК смартСостояниеПартнеров
		ПО Партнеры.Ссылка = смартСостояниеПартнеров.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Взаимодействие.Партнер КАК Партнер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CRM_Взаимодействие.Ссылка) КАК КоличествоЗавершенных
ПОМЕСТИТЬ ЗавершенныеВзаимодействия
ИЗ
	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
ГДЕ
	НЕ CRM_Взаимодействие.ДатаЗавершенияВзаимодействия = ДАТАВРЕМЯ(1, 1, 1)
	И НЕ CRM_Взаимодействие.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	CRM_Взаимодействие.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИтоговаяТаблица.Партнер КАК Ссылка,
	ИтоговаяТаблица.ДатаРегистрации КАК ДатаРегистрации,
	ВЫБОР
		КОГДА ИтоговаяТаблица.Закреплен
			ТОГДА ИтоговаяТаблица.ПериодЗакрепления
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ КАК ПериодЗакрепления,
	ИтоговаяТаблица.БизнесРегион КАК БизнесРегион,
	ИтоговаяТаблица.ОсновнойМенеджер КАК ОсновнойМенеджер,
	ИтоговаяТаблица.АктивныйЗаказ КАК АктивныйЗаказ,
	ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия КАК ДатаЗапланированногоВзаимодействия,
	ИтоговаяТаблица.Закреплен КАК Закреплен,
	ИтоговаяТаблица.ДатаАктивныйИнтерес КАК ДатаАктивныйИнтерес,
	ИтоговаяТаблица.Р КАК Р,
	ИтоговаяТаблица.СостояниеИнтереса КАК СостояниеИнтереса,
	ИтоговаяТаблица.АнализироватьВК КАК АнализироватьВК,
	ИтоговаяТаблица.ДатаКасания КАК ДатаКасания,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 90)
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВзаимодействияЗапланированы,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 90)
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СтанутСвободнымиЧерез10Дн,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
					И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
				ИЛИ ЕСТЬNULL(ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВзаимодействияНеЗапланированы,
	ЗавершенныеВзаимодействия.КоличествоЗавершенных КАК КоличествоКасаний,
	ИтоговаяТаблица.ДатаЗакреплениеИлиИнтерес КАК ДатаЗакреплениеИлиИнтерес,
	ИтоговаяТаблица.ИнтересыДата КАК ИнтересыДата,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; &amp;ТекущаяДата
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПросроченноеВзаимодействие,
	ИтоговаяТаблица.МенеджерПоРасходнымМатериалам КАК МенеджерПоРасходнымМатериалам,
	ИтоговаяТаблица.МенеджерСервисЦентра КАК МенеджерСервисЦентра,
	ИтоговаяТаблица.Состояние КАК Состояние,
	ИтоговаяТаблица.КоличествоПродажОборудования КАК КоличествоПродажОборудования,
	ИтоговаяТаблица.СуммаПродажОборудования КАК СуммаПродажОборудования,
	ИтоговаяТаблица.СуммаПродажЗапчастей КАК СуммаПродажЗапчастей,
	ИтоговаяТаблица.СуммаПродажРасходников КАК СуммаПродажРасходников,
	НАЧАЛОПЕРИОДА(ИтоговаяТаблица.ДатаПоследнегоВзаимодействия, ДЕНЬ) КАК ДатаПоследнегоВзаимодействия,
	ИтоговаяТаблица.СтанетСвободнымЧерез КАК СтанетСвободным,
	ИтоговаяТаблица.СтанетСвободнымЧерез КАК СтанетСвободнымДней,
	ВЫБОР
		КОГДА ИтоговаяТаблица.Партнер.ПометкаУдаления
			ТОГДА 3
		ИНАЧЕ 2
	КОНЕЦ КАК СтандартнаяКартинка1,
	НАЧАЛОПЕРИОДА(ИтоговаяТаблица.ДатаПоследнегоЗвонка, ДЕНЬ) КАК ДатаПоследнегоЗвонка,
	ИтоговаяТаблица.Код КАК Код
ИЗ
	ИтоговаяТаблица КАК ИтоговаяТаблица
		ЛЕВОЕ СОЕДИНЕНИЕ ЗавершенныеВзаимодействия КАК ЗавершенныеВзаимодействия
		ПО ИтоговаяТаблица.Партнер = ЗавершенныеВзаимодействия.Партнер
ГДЕ
	ИтоговаяТаблица.Партнер.Ссылка В
			(ВЫБРАТЬ
				Покупатели.Ссылка
			ИЗ
				Покупатели)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>ДСПартнерыРМ</name>
    <title>
      <key>ru</key>
      <value>ДСПартнеры</value>
    </title>
    <id>92</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаказКлиента.Партнер КАК Партнер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиента.Ссылка) КАК КоличествоЗаказов
ПОМЕСТИТЬ Заказы
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	НЕ ЗаказКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	И ЗаказКлиента.Проведен

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Партнер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ПартнерыCRM_ТипыОтношений.Ссылка КАК Ссылка
ПОМЕСТИТЬ Покупатели
ИЗ
	Справочник.Партнеры.CRM_ТипыОтношений КАК ПартнерыCRM_ТипыОтношений
ГДЕ
	ПартнерыCRM_ТипыОтношений.ТипОтношений = ЗНАЧЕНИЕ(Справочник.CRM_ТипыОтношений.Покупатель)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер КАК Партнер,
	МАКСИМУМ(смартИсторияЗакрепленияПартнеровСрезПоследних.Период) КАК Период,
	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер КАК Менеджер
ПОМЕСТИТЬ Закрепления
ИЗ
	РегистрСведений.смартИсторияЗакрепленияПартнеров.СрезПоследних(, ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаРасходныеМатериалы)) КАК смартИсторияЗакрепленияПартнеровСрезПоследних

СГРУППИРОВАТЬ ПО
	смартИсторияЗакрепленияПартнеровСрезПоследних.Партнер,
	смартИсторияЗакрепленияПартнеровСрезПоследних.Менеджер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	МАКСИМУМ(CRM_Интерес.ДатаЗакрытия) КАК Дата
ПОМЕСТИТЬ Интересы
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
ГДЕ
	НЕ CRM_Интерес.ПометкаУдаления
	И (CRM_Интерес.СостояниеИнтереса.ВидСостояния &lt;> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
			ИЛИ CRM_Интерес.СостояниеИнтереса.ВидСостояния &lt;> ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение))
	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартМенеджерПоРасходнымМатериалам

СГРУППИРОВАТЬ ПО
	CRM_Интерес.Партнер

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	МАКСИМУМ(CRM_Интерес.Дата) КАК Дата
ПОМЕСТИТЬ НЕЗакрытыеИнтересы
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
ГДЕ
	НЕ CRM_Интерес.ПометкаУдаления
	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
	И НЕ CRM_Интерес.СостояниеИнтереса.ВидСостояния = ЗНАЧЕНИЕ(перечисление.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение)
	И CRM_Интерес.Ответственный = CRM_Интерес.Партнер.смартМенеджерПоРасходнымМатериалам

СГРУППИРОВАТЬ ПО
	CRM_Интерес.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Интерес.Партнер КАК Партнер,
	CRM_Интерес.Дата КАК Дата,
	CRM_Интерес.СостояниеИнтереса КАК СостояниеИнтереса
ПОМЕСТИТЬ ПоследнийИнтересДанные
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НЕЗакрытыеИнтересы КАК НЕЗакрытыеИнтересы
		ПО CRM_Интерес.Партнер = НЕЗакрытыеИнтересы.Партнер
			И CRM_Интерес.Дата = НЕЗакрытыеИнтересы.Дата

ИНДЕКСИРОВАТЬ ПО
	Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Партнеры.Ссылка КАК Партнер,
	Партнеры.ДатаРегистрации КАК ДатаРегистрации,
	Закрепления.Период КАК ПериодЗакрепления,
	Партнеры.БизнесРегион КАК БизнесРегион,
	Партнеры.ОсновнойМенеджер КАК ОсновнойМенеджер,
	ВЫБОР
		КОГДА ЕСТЬNULL(Заказы.КоличествоЗаказов, 0) > 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК АктивныйЗаказ,
	смартСостояниеПартнеров.ДатаЗапланированногоВзаимодействияРМ КАК ДатаЗапланированногоВзаимодействия,
	ВЫБОР
		КОГДА ЕСТЬNULL(Закрепления.Период, ЛОЖЬ) = ЛОЖЬ
			ТОГДА ЛОЖЬ
		ИНАЧЕ ВЫБОР
				КОГДА Закрепления.Менеджер = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
					ТОГДА ЛОЖЬ
				ИНАЧЕ ИСТИНА
			КОНЕЦ
	КОНЕЦ КАК Закреплен,
	ПоследнийИнтересДанные.Дата КАК ДатаАктивныйИнтерес,
	&quot;&quot; КАК Р,
	ПоследнийИнтересДанные.СостояниеИнтереса КАК СостояниеИнтереса,
	ВЫБОР
		КОГДА ЕСТЬNULL(ПоследнийИнтересДанные.Дата, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК АнализироватьВК,
	ВЫБОР
		КОГДА Закрепления.Период > ЕСТЬNULL(смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияРМ, ДАТАВРЕМЯ(1, 1, 1))
			ТОГДА Закрепления.Период
		ИНАЧЕ смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияРМ
	КОНЕЦ КАК ДатаКасания,
	ВЫБОР
		КОГДА Закрепления.Период > ЕСТЬNULL(Интересы.Дата, ДАТАВРЕМЯ(1, 1, 1))
			ТОГДА Закрепления.Период
		ИНАЧЕ Интересы.Дата
	КОНЕЦ КАК ДатаЗакреплениеИлиИнтерес,
	Интересы.Дата КАК ИнтересыДата,
	Партнеры.смартМенеджерПоРасходнымМатериалам КАК МенеджерПоРасходнымМатериалам,
	Партнеры.смартОсновнойМенеджерСервисЦентра КАК МенеджерСервисЦентра,
	смартСостояниеПартнеров.СостояниеРМ КАК Состояние,
	смартСостояниеПартнеров.КоличествоПродажОборудования КАК КоличествоПродажОборудования,
	смартСостояниеПартнеров.СуммаПродажОборудования КАК СуммаПродажОборудования,
	смартСостояниеПартнеров.СуммаПродажЗапчастей КАК СуммаПродажЗапчастей,
	смартСостояниеПартнеров.СуммаПродажРасходников КАК СуммаПродажРасходников,
	смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияРМ КАК ДатаПоследнегоВзаимодействия,
	смартСостояниеПартнеров.ДатаПоследнегоЗвонкаРМ КАК ДатаПоследнегоЗвонка,
	Партнеры.Код КАК Код,
	смартСостояниеПартнеров.СтанетСвободнымЧерезРМ КАК СтанетСвободнымЧерез
ПОМЕСТИТЬ ИтоговаяТаблица
ИЗ
	Справочник.Партнеры КАК Партнеры
		ЛЕВОЕ СОЕДИНЕНИЕ Заказы КАК Заказы
		ПО Партнеры.Ссылка = Заказы.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ Закрепления КАК Закрепления
		ПО Партнеры.Ссылка = Закрепления.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ ПоследнийИнтересДанные КАК ПоследнийИнтересДанные
		ПО Партнеры.Ссылка = ПоследнийИнтересДанные.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ Интересы КАК Интересы
		ПО Партнеры.Ссылка = Интересы.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСостояниеПартнеров КАК смартСостояниеПартнеров
		ПО Партнеры.Ссылка = смартСостояниеПартнеров.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CRM_Взаимодействие.Партнер КАК Партнер,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ CRM_Взаимодействие.Ссылка) КАК КоличествоЗавершенных
ПОМЕСТИТЬ ЗавершенныеВзаимодействия
ИЗ
	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
ГДЕ
	НЕ CRM_Взаимодействие.ДатаЗавершенияВзаимодействия = ДАТАВРЕМЯ(1, 1, 1)
	И НЕ CRM_Взаимодействие.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	CRM_Взаимодействие.Партнер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИтоговаяТаблица.Партнер КАК Ссылка,
	ИтоговаяТаблица.ДатаРегистрации КАК ДатаРегистрации,
	ВЫБОР
		КОГДА ИтоговаяТаблица.Закреплен
			ТОГДА ИтоговаяТаблица.ПериодЗакрепления
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	КОНЕЦ КАК ПериодЗакрепления,
	ИтоговаяТаблица.БизнесРегион КАК БизнесРегион,
	ИтоговаяТаблица.ОсновнойМенеджер КАК ОсновнойМенеджер,
	ИтоговаяТаблица.АктивныйЗаказ КАК АктивныйЗаказ,
	ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия КАК ДатаЗапланированногоВзаимодействия,
	ИтоговаяТаблица.Закреплен КАК Закреплен,
	ИтоговаяТаблица.ДатаАктивныйИнтерес КАК ДатаАктивныйИнтерес,
	ИтоговаяТаблица.Р КАК Р,
	ИтоговаяТаблица.СостояниеИнтереса КАК СостояниеИнтереса,
	ИтоговаяТаблица.АнализироватьВК КАК АнализироватьВК,
	ИтоговаяТаблица.ДатаКасания КАК ДатаКасания,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 90)
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВзаимодействияЗапланированы,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 90)
				И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СтанутСвободнымиЧерез10Дн,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ИтоговаяТаблица.ДатаКасания
					И ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия > ДОБАВИТЬКДАТЕ(ИтоговаяТаблица.ДатаКасания, ДЕНЬ, 100)
				ИЛИ ЕСТЬNULL(ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВзаимодействияНеЗапланированы,
	ЗавершенныеВзаимодействия.КоличествоЗавершенных КАК КоличествоКасаний,
	ИтоговаяТаблица.ДатаЗакреплениеИлиИнтерес КАК ДатаЗакреплениеИлиИнтерес,
	ИтоговаяТаблица.ИнтересыДата КАК ИнтересыДата,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ДатаЗапланированногоВзаимодействия &lt; &amp;ТекущаяДата
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПросроченноеВзаимодействие,
	ИтоговаяТаблица.МенеджерПоРасходнымМатериалам КАК МенеджерПоРасходнымМатериалам,
	ИтоговаяТаблица.МенеджерСервисЦентра КАК МенеджерСервисЦентра,
	ИтоговаяТаблица.Состояние КАК Состояние,
	ИтоговаяТаблица.КоличествоПродажОборудования КАК КоличествоПродажОборудования,
	ИтоговаяТаблица.СуммаПродажОборудования КАК СуммаПродажОборудования,
	ИтоговаяТаблица.СуммаПродажЗапчастей КАК СуммаПродажЗапчастей,
	ИтоговаяТаблица.СуммаПродажРасходников КАК СуммаПродажРасходников,
	НАЧАЛОПЕРИОДА(ИтоговаяТаблица.ДатаПоследнегоВзаимодействия, ДЕНЬ) КАК ДатаПоследнегоВзаимодействия,
	ИтоговаяТаблица.СтанетСвободнымЧерез КАК СтанетСвободным,
	ИтоговаяТаблица.СтанетСвободнымЧерез КАК СтанетСвободнымДней,
	ВЫБОР
		КОГДА ИтоговаяТаблица.Партнер.ПометкаУдаления
			ТОГДА 3
		ИНАЧЕ 2
	КОНЕЦ КАК СтандартнаяКартинка1,
	НАЧАЛОПЕРИОДА(ИтоговаяТаблица.ДатаПоследнегоЗвонка, ДЕНЬ) КАК ДатаПоследнегоЗвонка,
	ИтоговаяТаблица.Код КАК Код
ИЗ
	ИтоговаяТаблица КАК ИтоговаяТаблица
		ЛЕВОЕ СОЕДИНЕНИЕ ЗавершенныеВзаимодействия КАК ЗавершенныеВзаимодействия
		ПО ИтоговаяТаблица.Партнер = ЗавершенныеВзаимодействия.Партнер
ГДЕ
	ИтоговаяТаблица.Партнер.Ссылка В
			(ВЫБРАТЬ
				Покупатели.Ссылка
			ИЗ
				Покупатели)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
