    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	CRM_Интерес.Ссылка КАК Ссылка,
	CRM_Интерес.ВерсияДанных КАК ВерсияДанных,
	CRM_Интерес.ПометкаУдаления КАК ПометкаУдаления,
	CRM_Интерес.Номер КАК Номер,
	CRM_Интерес.Дата КАК Дата,
	CRM_Интерес.Проведен КАК Проведен,
	CRM_Интерес.Автор КАК Автор,
	CRM_Интерес.Валюта КАК Валюта,
	CRM_Интерес.ВероятностьСделки КАК ВероятностьСделки,
	CRM_Интерес.ДатаЗакрытия КАК ДатаЗакрытия,
	CRM_Интерес.ДокументОснование КАК ДокументОснование,
	CRM_Интерес.Завершен КАК Завершен,
	CRM_Интерес.Избранный КАК Избранный,
	CRM_Интерес.КонтактноеЛицо КАК КонтактноеЛицо,
	CRM_Интерес.ОжидаемаяВыручка КАК ОжидаемаяВыручка,
	CRM_Интерес.Описание КАК Описание,
	CRM_Интерес.Организация КАК Организация,
	CRM_Интерес.Ответственный КАК Ответственный,
	CRM_Интерес.Офис КАК Офис,
	CRM_Интерес.Партнер КАК Партнер,
	CRM_Интерес.СделкаСКлиентом КАК СделкаСКлиентом,
	CRM_Интерес.Соглашение КАК Соглашение,
	CRM_Интерес.Подразделение КАК Подразделение,
	CRM_Интерес.ПотенциальныйКлиент КАК ПотенциальныйКлиент,
	CRM_Интерес.ПричинаОтказа КАК ПричинаОтказа,
	CRM_Интерес.Проект КАК Проект,
	CRM_Интерес.СостояниеИнтереса КАК СостояниеИнтереса,
	CRM_Интерес.Тема КАК Тема,
	CRM_Интерес.ТипУслуги КАК ТипУслуги,
	CRM_Интерес.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	CRM_Интерес.НалогообложениеНДС КАК НалогообложениеНДС,
	CRM_Интерес.СкидкиРассчитаны КАК СкидкиРассчитаны,
	CRM_Интерес.ТипОбращения КАК ТипОбращения,
	CRM_Интерес.УровеньПоддержки КАК УровеньПоддержки,
	CRM_Интерес.СрокРеакции КАК СрокРеакции,
	CRM_Интерес.СрокРешения КАК СрокРешения,
	CRM_Интерес.ПричинаОтказаКомментарий КАК ПричинаОтказаКомментарий,
	CRM_Интерес.Склад КАК Склад,
	CRM_Интерес.Контрагент КАК Контрагент,
	CRM_Интерес.ОжидаемаяДатаПродажи КАК ОжидаемаяДатаПродажи,
	CRM_Интерес.РучнойВводДатыПродажи КАК РучнойВводДатыПродажи,
	CRM_Интерес.Договор КАК Договор,
	CRM_Интерес.СостояниеИнтересаДатаНачала КАК СостояниеИнтересаДатаНачала,
	CRM_Интерес.СостояниеИнтересаДнейСНачалаГода КАК СостояниеИнтересаДнейСНачалаГода,
	CRM_Интерес.СостояниеИнтересаДнейДоКонцаГода КАК СостояниеИнтересаДнейДоКонцаГода,
	CRM_Интерес.смартПредыдущийОтветственный КАК смартПредыдущийОтветственный,
	ВЫБОР
		КОГДА CRM_Интерес.смартИтоговаяКвалификация = ЗНАЧЕНИЕ(Справочник.смартКвалификацииМенеджеров.ПустаяСсылка)
			ТОГДА CRM_Интерес.смартПредварительнаяКвалификация
		ИНАЧЕ CRM_Интерес.смартИтоговаяКвалификация
	КОНЕЦ КАК Квалификация,
	CRM_Интерес.смартИнтересКанал КАК смартИнтересКанал,
	CRM_Интерес.смартИнтересИсточник КАК смартИнтересИсточник,
	CRM_Интерес.смартВоронкаНовые КАК смартВоронкаНовые,
	CRM_Интерес.смартВоронкаСтарые КАК смартВоронкаСтарые,
	CRM_Интерес.смартОжидаемаяВыручкаВВалютеДокумента КАК смартОжидаемаяВыручкаВВалютеДокумента,
	ВЫБОР
		КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)
			ТОГДА смартСостояниеПартнеров.ДатаПоследнегоЗвонкаСЦ
		ИНАЧЕ ВЫБОР
				КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаРасходныеМатериалы)
					ТОГДА смартСостояниеПартнеров.ДатаПоследнегоЗвонкаРМ
				ИНАЧЕ смартСостояниеПартнеров.ДатаПоследнегоЗвонка
			КОНЕЦ
	КОНЕЦ КАК ДатаПоследнегоЗвонка,
	ВЫБОР
		КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)
			ТОГДА смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияСЦ
		ИНАЧЕ ВЫБОР
				КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаРасходныеМатериалы)
					ТОГДА смартСостояниеПартнеров.ДатаПоследнегоВзаимодействияРМ
				ИНАЧЕ смартСостояниеПартнеров.ДатаПоследнегоВзаимодействия
			КОНЕЦ
	КОНЕЦ КАК ДатаПоследнегоВзаимодействия,
	ВЫБОР
		КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаЗапасныеЧасти)
			ТОГДА смартСостояниеПартнеров.ДатаЗапланированногоВзаимодействияСЦ
		ИНАЧЕ ВЫБОР
				КОГДА CRM_Интерес.ТипУслуги = ЗНАЧЕНИЕ(Справочник.CRM_ТипУслуги.ПоставкаРасходныеМатериалы)
					ТОГДА смартСостояниеПартнеров.ДатаЗапланированногоВзаимодействияРМ
				ИНАЧЕ смартСостояниеПартнеров.ДатаЗапланированногоВзаимодействия
			КОНЕЦ
	КОНЕЦ КАК ДатаЗапланированногоВзаимодействия
ИЗ
	Документ.CRM_Интерес КАК CRM_Интерес
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.смартСостояниеПартнеров КАК смартСостояниеПартнеров
		ПО CRM_Интерес.Партнер = смартСостояниеПартнеров.Партнер
ГДЕ
	НЕ CRM_Интерес.ПометкаУдаления</queryText>
      <mainTable>Document.CRM_Интерес</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
