&НаСервереБезКонтекста
Функция ПолучитьСсылкуЗаказаКлиентаПоШтрихкоду(Штрихкод)
	Менеджеры=Новый Массив();
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ЗаказКлиента.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.РеализацияТоваровУслуг.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ПеремещениеТоваров.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ЗаказНаПеремещение.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ВнутреннееПотреблениеТоваров.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.СписаниеНедостачТоваров.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ЗаявкаНаВозвратТоваровОтКлиента.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ЗаказНаСборку.ПустаяСсылка"));
	Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ВозвратТоваровПоставщику.ПустаяСсылка"));
	
	МассивСсылок=ШтрихкодированиеПечатныхФорм.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Штрихкод, Менеджеры);
	Если МассивСсылок.Количество()>0 Тогда 
		Возврат МассивСсылок[0];
	КонецЕсли;
	Возврат Неопределено;
КонецФункции	

&НаКлиенте
Процедура смарт_смартСоздатьОрдерВместо(Команда)
	ПоВсемРаспоряжениям=1;
	СоздатьОрдераСервер();
	смартРаспоряжениеНайдено=Ложь;
	МассивОрдеров=смартМассивОрдеров.ВыгрузитьЗначения();
	Если МассивОрдеров.Количество()>0 Тогда 
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Документ.РасходныйОрдерНаТовары","РасходныйОрдерНаТовары",МассивОрдеров,ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивСкладовПоРаспоряжению(Расположение,СкладИсключение)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжение",Расположение);
	Запрос.УстановитьПараметр("Склад",СкладИсключение);
	Запрос.Текст="ВЫБРАТЬ
	             |	ТоварыКОтгрузкеОбороты.Склад.Наименование КАК Склад
	             |ИЗ
	             |	РегистрНакопления.ТоварыКОтгрузке.Обороты(
	             |			,
	             |			,
	             |			,
	             |			ДокументОтгрузки = &Распоряжение
	             |				И НЕ Склад = &Склад) КАК ТоварыКОтгрузкеОбороты";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
КонецФункции	
