//++ смарт:ММ #017 173 08.02.2020 Этикетка доставки
&НаКлиенте
Процедура смартНапечататьЭтикеткуДоставки(Команда)
			
	ВыделенныеСтроки = Элементы.ОрдераВРаботе.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыНазначения = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		Если ТипЗнч(ВыделеннаяСтрока) <> Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектыНазначения.Добавить(ВыделеннаяСтрока);
		
	КонецЦикла;
	
	Если ОбъектыНазначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
    ВыполняемаяОбработка = смартНайтиВПФ("смартЭтикеткаДоставки");
	
	Если ВыполняемаяОбработка.Пустая() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В справочнике ""Дополнительные отчеты и обработки"" не найдена печатная форма с именем ""смартЭтикеткаДоставки""");
        Возврат;
	КонецЕсли;
	
	ПараметрыОбработки = Новый Структура("ИдентификаторКоманды, ДополнительнаяОбработкаСсылка, ИмяФормы, КлючСессии");
	ПараметрыОбработки.ИдентификаторКоманды          = "смартЭтикеткаДоставки";
	ПараметрыОбработки.ДополнительнаяОбработкаСсылка = ВыполняемаяОбработка;
	ПараметрыОбработки.КлючСессии = ВыполняемаяОбработка.УникальныйИдентификатор();
	ПараметрыОбработки.ИмяФормы = ЭтаФорма.ИмяФормы;
	ПараметрыОбработки.Вставить("ОбъектыНазначения", ОбъектыНазначения);
	
	ИмяОбработки = ДополнительныеОтчетыИОбработкиВызовСервера.ПодключитьВнешнююОбработку(ВыполняемаяОбработка);
	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма", ПараметрыОбработки, ЭтаФорма);

КонецПроцедуры //-- смарт:ММ 08.02.2020

