//++ смарт:ММ 572 21.07.2021
&НаКлиенте
Процедура смартРеестрОтгрузокНажатие(Команда)
	
	ТабДок = смартСформироватьРеестрОтгрузок();
	//ТабДок.Показать();
	
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Макет");
	ПечатнаяФорма = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "Макет");
	ПечатнаяФорма.ТабличныйДокумент = ТабДок;
	КлючУникальности = Строка(Новый УникальныйИдентификатор);
	ПараметрыОткрытия = Новый Структура("ИмяМенеджераПечати,ИменаМакетов,ПараметрКоманды,ПараметрыПечати");
	ПараметрыОткрытия.ПараметрКоманды = Новый Массив;
	ПараметрыОткрытия.ПараметрыПечати = Новый Структура;
	ПараметрыОткрытия.Вставить("КоллекцияПечатныхФорм", КоллекцияПечатныхФорм);
	
	ОткрытьФорму("ОбщаяФорма.ПечатьДокументов", ПараметрыОткрытия, ВладелецФормы, КлючУникальности);
	
КонецПроцедуры //-- смарт:ММ 21.07.2021

//++ смарт:ММ 572 21.07.2021
&НаСервере
Функция смартСформироватьРеестрОтгрузок()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("смарт_РеестрОтгрузок");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ДатаОтгрузки = Формат(ДатаОтгрузки, "ДФ='dd.MM.yyyy ""г.""'");
	ОбластьШапка.Параметры.Склад = Склад;
	
	ТабДок.Вывести(ОбластьШапка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасходныйОрдерНаТовары.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_РасходныеОрдера
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
	|ГДЕ
	|	РасходныйОрдерНаТовары.Склад = &Склад
	|	И РасходныйОрдерНаТовары.Проведен
	|	И НАЧАЛОПЕРИОДА(РасходныйОрдерНаТовары.ДатаОтгрузки, ДЕНЬ) = &ДатаОтгрузки
	|	И РасходныйОрдерНаТовары.Статус = &СтатусОтгружен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ВТ_ЗаказыКлиентов
	|ИЗ
	|	Документ.РасходныйОрдерНаТовары.ТоварыПоРаспоряжениям КАК РасходныйОрдерНаТоварыТоварыПоРаспоряжениям
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РасходныеОрдера КАК ВТ_РасходныеОрдера
	|		ПО РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Ссылка = ВТ_РасходныеОрдера.Ссылка
	|ГДЕ
	|	РасходныйОрдерНаТоварыТоварыПоРаспоряжениям.Распоряжение ССЫЛКА Документ.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка,
	|	ВТ_ЗаказыКлиентов.Распоряжение КАК Распоряжение
	|ПОМЕСТИТЬ ВТ_РеализацииПоЗаказам
	|ИЗ
	|	ВТ_ЗаказыКлиентов КАК ВТ_ЗаказыКлиентов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|		ПО ВТ_ЗаказыКлиентов.Распоряжение = РеализацияТоваровУслуг.ЗаказКлиента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВТ_РеализацииПоЗаказам.Распоряжение КАК ЗаказКлиента,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.Номер КАК НомерСчета,
	|	ЗаказКлиента.Дата КАК ДатаСчета,
	|	ЕСТЬNULL(СчетФактураВыданный.Номер, """") КАК НомерСФ,
	|	ЕСТЬNULL(СчетФактураВыданный.Дата, """") КАК ДатаСФ
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	// ++ 10.08.2021
	//|		ПРАВОЕ СОЕДИНЕНИЕ ВТ_РеализацииПоЗаказам КАК ВТ_РеализацииПоЗаказам
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_РеализацииПоЗаказам КАК ВТ_РеализацииПоЗаказам
	// --
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента
	|			ПО (ВТ_РеализацииПоЗаказам.Распоряжение = ЗаказКлиента.Ссылка)
	|		ПО (ВТ_РеализацииПоЗаказам.Ссылка = СчетФактураВыданный.ДокументОснование)
	// ++ 10.08.2021
	|			И СчетФактураВыданный.Проведен
	// --
	|";
	
	Запрос.УстановитьПараметр("ДатаОтгрузки", ДатаОтгрузки);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("СтатусОтгружен", Перечисления.СтатусыРасходныхОрдеров.Отгружен);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл

		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьСтрока.Параметры.Строка = "СФ №" + Выборка.НомерСФ + " " + Формат(Выборка.ДатаСФ, "ДФ=dd.MM.yyyy") 
		+ " (Счет №" + Выборка.НомерСчета + " " + Формат(Выборка.ДатаСчета, "ДФ=dd.MM.yyyy") + ") " + СокрЛП(Выборка.Контрагент);
		
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;	
	
	ТабДок.ОтображатьСетку = Ложь;
	
	Возврат ТабДок;
	
КонецФункции //-- смарт:ММ 21.07.2021

