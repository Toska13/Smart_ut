
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	ЭтоБазовая = ПолучитьФункциональнуюОпцию("БазоваяВерсия");	

	ВосстановитьНастройки(Параметры);

	ОбновитьСписокДоступныхТиповДокументов();

	Если Не ТипыДокументов = Неопределено Тогда
		ВыполнитьПослеЗакрытияСпискаВыбора(ТипыДокументов);
	КонецЕсли;

	СформироватьГруппуКнопокСоздать();

	УстановитьВидимостьЭлементов();

	УстановитьДоступностьКоманд(ЭтотОбъект);

	#Вставка
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиентаНаФормеСписка(ЭтаФорма,
																		 "ЖурналДокументовРеестрТорговыхДокументов", 
																		 "ЖурналДокументов.РеестрТорговыхДокументов КАК ЖурналДокументовРеестрТорговыхДокументов", 
																		 "*",
																		 "Список",
																		 ,
																		 Истина,
																		 "ГруппаИнформация");
	//-- #Б3960 смарт: Шляпников 16.09.2025
	#КонецВставки
	
КонецПроцедуры
