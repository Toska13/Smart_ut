&НаКлиенте
&После("ПриОткрытии")
Процедура смарт_ПриОткрытии(Отказ)
	
	КодСтраныКонтактногоЛица = "+7";
	КодСтраны = "+7";
	
	//Телефон партнёра подсказки
	Элементы.КодСтраны.Подсказка = "Код страны";
	Элементы.КодГорода.Подсказка = "Код города";
	Элементы.Телефон.Подсказка	 = "Телефон";
	
	//Телефон контакта подсказки
	Элементы.КодСтраныКонтактногоЛица.Подсказка = "Код страны";
	Элементы.КодГородаКонтактногоЛица.Подсказка = "Код города";
	Элементы.ТелефонКонтактногоЛица.Подсказка	= "Телефон";
	
КонецПроцедуры

&НаКлиенте
Процедура смартПриИзмененииТелефона(Элемент) // можно вводить только цифры
		
	Строка = СокрЛП(Элемент.ТекстРедактирования);
	
	ЭтотОбъект[Элемент.Имя] = смартНайтиЧислаВСтроке(Строка);  

	//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
	ОкончаниеРеквизита = СтрЗаменить(Элемент.Имя, "Телефон", "");
	
	СтрокаТелефон = СокрЛП(ЭтотОбъект["КодСтраны" + ОкончаниеРеквизита])
				  + СокрЛП(ЭтотОбъект["КодГорода" + ОкончаниеРеквизита])
				  + СокрЛП(ЭтотОбъект["Телефон"   + ОкончаниеРеквизита]);
	
	СтруктураПроверки = Новый Структура;
	
	СтруктураПроверки.Вставить("Значение", 		"");
	СтруктураПроверки.Вставить("Представление", СтрокаТелефон);
	СтруктураПроверки.Вставить("Владелец", 		Неопределено);

	Если Элемент.Имя = "Телефон" Тогда
		СтруктураПроверки.Вставить("Ссылка", ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"));
	Иначе	
		СтруктураПроверки.Вставить("Ссылка", ПредопределенноеЗначение("Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка"));
	КонецЕсли;	
	
	ИтогПроверки = смартОбщегоНазначения.ПроверитьТелефон(СтруктураПроверки); 
	
	Если ИтогПроверки.КодОшибки <> 0 Тогда

		ОчиститьСообщения();

		Если ИтогПроверки.КодОшибки = 12 И ИтогПроверки.Свойство("МассивДублей") Тогда
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ИтогПроверки.СообщениеОшибки, , Элемент.Имя);
			
			Для Каждого ЭлементДубль Из ИтогПроверки.МассивДублей Цикл
				ОбщегоНазначенияКлиент.СообщитьПользователю(ЭлементДубль.ТекстСообщения, ЭлементДубль.Ключ);
			КонецЦикла;
			
		Иначе	

			ОбщегоНазначенияКлиент.СообщитьПользователю(ИтогПроверки.СообщениеОшибки, , Элемент.Имя);
			
		КонецЕсли;

		ЭтотОбъект["КодСтраны" + ОкончаниеРеквизита] = "";
		ЭтотОбъект["КодГорода" + ОкончаниеРеквизита] = "";
		ЭтотОбъект["Телефон"   + ОкончаниеРеквизита] = "";
		
	КонецЕсли;
	//-- #1152 смарт: Лопато 18.10.2024
	
КонецПроцедуры

&НаСервере
Функция смартНайтиЧислаВСтроке(Строка) 
	
	СтрокаЧисел = "";
	
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		
		Символ = Сред(Строка, Индекс, 1); // Перебираем все символы из нашей строки
		
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
			СтрокаЧисел = СтрокаЧисел + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрокаЧисел
	
КонецФункции

