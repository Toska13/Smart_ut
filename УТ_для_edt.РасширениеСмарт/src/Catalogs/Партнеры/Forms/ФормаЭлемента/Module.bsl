//--------------Оборудование клиента------------------------
//Процедуры и функции для реализации функционала управления оборудованием клиента
&НаКлиенте
Процедура РасшСмарт_смартДобавитьОборудованиеКлиента(Команда)
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, "Добавить оборудование");
	Кнопки.Добавить(КодВозвратаДиалога.Нет, "Вернуться назад");

	ТекстВопроса = НСтр("ru = 'Перед выбором убедитесь что оборудования, которое вы хотите добавить, нет в списке'");

	Оповещение = Новый ОписаниеОповещения("РасшСмарт_ПослеОтветаНаВопросДобавитьОборудование", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 0,, "Добавление оборудования клиента");
	
КонецПроцедуры

&НаКлиенте
Процедура РасшСмарт_ПослеОтветаНаВопросДобавитьОборудование(Результат, Параметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		РасшСмарт_ОткрытьФормуВыбораОборудования();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшСмарт_ОткрытьФормуВыбораОборудования()
	
	ПараметрЗаголовок = НСтр("ru = 'Добавление оборудования для %Справочник%'");
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Справочник%", Объект.Ссылка);
	Иначе
		ПараметрЗаголовок = СтрЗаменить(ПараметрЗаголовок, "%Справочник%", НСтр("ru='(новый клиент)'"));
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДатаДобавления", 	Дата(ТекущаяДата()));
	ПараметрыФормы.Вставить("Партнер", 			Объект.Ссылка);
	
	//++ смарт:ММ #045 243 23.04.2020 - добавление команд для ТЧ Чернила клиента  
	ПараметрыФормы.Вставить("смартТипОборудованияКлиента", ПредопределенноеЗначение("Перечисление.смартТипыОборудованияКлиента.Оборудование"));
	//-- смарт:ММ 23.04.2020
	
	ПараметрыТовара = РасшСмарт_ПараметрыТаблицыОборудование();
	
	ОткрытьФорму("Справочник.Партнеры.Форма.РасшСмарт_ФормаДобавленияОборудования", 
				ПараметрыФормы, 
				ЭтаФорма, 
				УникальныйИдентификатор,
				,
				,
				Новый ОписаниеОповещения("РасшСмарт_ДобавитьОборудованиеКлиентаПослеВыбора", ЭтотОбъект, ПараметрыТовара),
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);			
	Возврат;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшСмарт_ДобавитьОборудованиеКлиентаПослеВыбора(ПодобранноеОборудование, ДополнительныеПараметры) Экспорт 
	
	Если ПодобранноеОборудование = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасшСмарт_ДобавитьОборудованиеКлиентаЗавершение(ДополнительныеПараметры, ПодобранноеОборудование);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшСмарт_ДобавитьОборудованиеКлиентаЗавершение(ПараметрыОборудования, НовыеСтроки)

	//ТекстОповещения = РасшСмарт_ДобавитьОборудованиеВСписокНаКлиенте(ПараметрыОборудования, НовыеСтроки);
	
	Отбор = Новый Структура("смартОборудованиеКлиента");
	
	Для каждого НоваяСтрока Из НовыеСтроки Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, НоваяСтрока);
		                  
		РезультатПоиска = Объект.смартОборудованиеКлиентов.НайтиСтроки(Отбор);
		
		Если РезультатПоиска.Количество() = 0 Тогда
			
			ТекущаяСтрока = Объект.смартОборудованиеКлиентов.Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Отбор);
			ТекущаяСтрока.смартДатаДобавления = Дата(ТекущаяДата());
			ТекущаяСтрока.смартКомментарий = НоваяСтрока.смартКомментарий; 
			
			Если НовыеСтроки.Количество() > 0 Тогда
				Элементы.смартОборудованиеКлиентов.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		Иначе
			Сообщить("Это оборудование уже добавлено");
		КонецЕсли;
			
		//Если Не РасшСмарт_АдминистраторСервисЦентра() Тогда			
		//	ТекстОповещения = НСтр("ru = 'Добавлено новое оборудование клиенту'");	
		//КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

