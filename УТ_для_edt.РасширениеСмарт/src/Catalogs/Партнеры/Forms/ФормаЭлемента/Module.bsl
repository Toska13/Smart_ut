&НаСервере
Процедура ЗаполнитьСпискиАдресовДоставки(Партнер,ИмяРеквизита)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Партнер);
	Запрос.Текст="ВЫБРАТЬ
	             |	ПартнерыКонтактнаяИнформация.Представление КАК Адрес
	             |ИЗ
	             |	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	             |ГДЕ
	             |	ПартнерыКонтактнаяИнформация.Ссылка = &Ссылка
	             |	И ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)";
	
	Элементы[ИмяРеквизита].СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Адрес"));
	Если Элементы[ИмяРеквизита].СписокВыбора.Количество()=1 И Не ЗначениеЗаполнено(Объект[ИмяРеквизита]) Тогда 
		Объект[ИмяРеквизита]=Элементы[ИмяРеквизита].СписокВыбора[0].Значение;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТелефоновКонтактногоЛица(КонтактноеЛицо)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",КонтактноеЛицо);
	Запрос.Текст="ВЫБРАТЬ
	             |	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК Телефон
	             |ИЗ
	             |	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	             |ГДЕ
	             |	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка = &Ссылка
	             |	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	Элементы.смартПартнерТелефонКонтактногоЛица.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Телефон"));
	Если Элементы.смартПартнерТелефонКонтактногоЛица.СписокВыбора.Количество()=1 Тогда 
		Объект.смартПартнерТелефонКонтактногоЛица=Элементы.смартПартнерТелефонКонтактногоЛица.СписокВыбора[0].Значение;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
