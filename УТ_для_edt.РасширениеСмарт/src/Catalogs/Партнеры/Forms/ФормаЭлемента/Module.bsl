&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	// Фролов+
	Элементы.Дилер.Доступность = Пользователи.РолиДоступны("ПолныеПрава,смартИзменениеПризнакаДилер");
	Элементы.смартДилерСервисЦентра.Доступность = Пользователи.РолиДоступны("ПолныеПрава,смартИзменениеПризнакаДилерСЦ");
	Элементы.смартПартнерОсобыеУсловияПеревозкиОписание.Видимость=Объект.смартПартнерОсобыеУсловияПеревозки;
	Объект.смартПартнерСпособДоставки=?(ЗначениеЗаполнено(Объект.смартПартнерСпособДоставки),Объект.смартПартнерСпособДоставки,Перечисления.СпособыДоставки.Самовывоз);
	
	ЗаполнитьСпискиАдресовДоставки(Объект.Ссылка,Элементы.смартПартнерАдресДоставки.Имя);
	Если ЗначениеЗаполнено(Объект.смартПартнерАдресДоставкиПеревозчика) Тогда 
		ЗаполнитьСпискиАдресовДоставки(Объект.смартПартнерАдресДоставкиПеревозчика,Элементы.смартПартнерАдресДоставкиПеревозчика.Имя);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.смартПартнерКонтактноеЛицо) Тогда 
		ЗаполнитьСписокТелефоновКонтактногоЛица(Объект.смартПартнерКонтактноеЛицо);
	КонецЕсли;
	ЗаполнитьЗонуДоставки();
	// Фролов-
	
	//++ смарт:ММ #082 397 28.02.2021 Заявка на ремонтные работы
	ДобавитьЭлементыПрограммно();
	//-- смарт:ММ 28.02.2021
	
	// ++ смарт Белоусова #469 11.06.2021 доработка
	Элементы.смартКлючевойКлиентПоРасходнымМатериалам.Доступность = Ложь;
	// -- смарт Белоусова #469 11.06.2021
	
	// ++ смарт Белоусова #469 12.03.2021
	Если РольДоступна("ПолныеПрава") или РольДоступна("смартРедактированиеКлючевыхКлиентов") Тогда
		Элементы.смартКлючевойКлиентПоРасходнымМатериалам.Доступность = Истина;
	КонецЕсли;	
	// -- смарт Белоусова #469 12.03.2021

		
КонецПроцедуры

