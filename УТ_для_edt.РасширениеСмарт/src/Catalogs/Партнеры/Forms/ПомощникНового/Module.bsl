	Если Не ЗначениеЗаполнено(ОсновнойМенеджер) Тогда
		
		ВывестиСообщениеПользователю(НСтр("ru = 'Необходимо указать основного менеджера партнера'"), "ОсновнойМенеджер");
		Отказ = Истина;
		
	КонецЕсли;
	
	//++#1615 смарт: Лопато 08.02.2024 //Заполнение и передача на сайт менеджеров по расходым материалам  
	//Если Не ЗначениеЗаполнено(смартМенеджерПоРасходнымМатериалам) Тогда
	//	
	//	ВывестиСообщениеПользователю(НСтр("ru = 'Необходимо указать менеджера по расходным материалам'"), "смартМенеджерПоРасходнымМатериалам");
	//	Отказ = Истина;
	//	
	//КонецЕсли;
	//--#1615 смарт: Лопато 08.02.2024
	
