// Процедура управляет доступностью кнопки "Далее" и выводит декорацию с ошибкой.
&НаСервере
Процедура смартУстановитьДоступностьКнопкиДалее()
	
	Если Пользователи.РолиДоступны("ПолныеПрава,смартРедактированиеКонтрагентовСДвижениями") Тогда
		//{[+](фрагмент ДОБАВЛЕН), Подкин Алексей 19.11.2019 10:38:22
		Элементы.Далее.Доступность=Истина;
		//}Подкин Алексей 19.11.2019 10:38:22
		Возврат;
	КонецЕсли;	
	Если УказыватьЮридическиеРеквизиты И ПустаяСтрока(ПолноеЮридическоеНаименование) Тогда 
		Элементы.Далее.Доступность=Ложь;
		Эл=Элементы.Добавить("смартИнфОшибка",Тип("ДекорацияФормы"),Элементы.СтраницаПервичнаяИнформация);
		Эл.Вид=ВидДекорацииФормы.Надпись;
		Эл.ЦветТекста=WebЦвета.Красный;
		Эл.Заголовок="По контрагенту нет данных в ФНС";
	Иначе
		Элементы.Далее.Доступность=Истина;
		Если Не Элементы.Найти("смартИнфОшибка")=Неопределено Тогда 
			Элементы.Удалить(Элементы.смартИнфОшибка);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

// Фролов-

//++#1012 смарт: Холопов 04.05.2022 // Добавление подсказок для программно добавленных элементов и телефонов в КИ 
&НаКлиенте
&После("ОбработкаСобытияЭлементаКИТелефон")
Процедура смарт_ОбработкаСобытияЭлементаКИТелефон(Элемент, ВидКонтактнойИнформации, ИмяРеквизитаПредставление, ИмяРеквизитаЗначенияПолей, Событие)
	
	Если Событие = "ПриИзменении" Тогда
		
		СтруктураТелефона = сфпСофтФонПроСервер.сфпЗаполнитьСтруктуруПолейПоПредставлениюТелефон(Элемент.ТекстРедактирования);
		
		Представление = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(СтруктураТелефона.КодСтраны, СтруктураТелефона.КодГорода, СтруктураТелефона.НомерТелефона, СтруктураТелефона.Добавочный, "");
		
		ЭтаФорма[ИмяРеквизитаПредставление] = Представление;
		
		ЗначенияПолей = Новый Структура;
		
		ЗначенияПолей.Вставить("countryCode", СтруктураТелефона.КодСтраны);
		ЗначенияПолей.Вставить("areaCode", СтруктураТелефона.КодГорода);
		ЗначенияПолей.Вставить("number", СтруктураТелефона.НомерТелефона);
		ЗначенияПолей.Вставить("extNumber", СтруктураТелефона.Добавочный);
		ЗначенияПолей.Вставить("value", Представление);
		
		Значение = CRM_ОбщегоНазначенияСервер.СтруктураВСтрокуJSON(ЗначенияПолей);
		
		ЭтаФорма[ИмяРеквизитаЗначенияПолей] = Значение;
		
		СтруктураДанныхСтроки = Новый Структура();
		
		СтруктураДанныхСтроки.Вставить("Значение",Значение);
		СтруктураДанныхСтроки.Вставить("Представление",Представление);

		//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
		СтруктураДанныхСтроки.Вставить("Ссылка", ПредопределенноеЗначение("Справочник.Партнеры.ПустаяСсылка"));
		СтруктураДанныхСтроки.Вставить("Владелец", Неопределено);
		//-- #1152 смарт: Лопато 18.10.2024
		
		ИтогПроверки = смартОбщегоНазначения.ПроверитьТелефон(СтруктураДанныхСтроки); 
		
		Если ИтогПроверки.КодОшибки <> 0 Тогда

			//++ #1152 смарт: Лопато 18.10.2024 //Партнеры. Не контролируется уникальность КИ при изменении.  
			ОчиститьСообщения();

			Если ИтогПроверки.КодОшибки = 12 И ИтогПроверки.Свойство("МассивДублей") Тогда
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(ИтогПроверки.СообщениеОшибки, , Элемент.Имя);
				
				Для Каждого ЭлементДубль Из ИтогПроверки.МассивДублей Цикл
					ОбщегоНазначенияКлиент.СообщитьПользователю(ЭлементДубль.ТекстСообщения, ЭлементДубль.Ключ);
				КонецЦикла;
				
			Иначе	

				СообщениеОбщееПояснение = "Если номер имеет другой формат (например, это заграничный номер), нажмите на кнопку выбора или F4 и введите номер";		
				СообщениеДляВывода = ИтогПроверки.СообщениеОшибки + Символы.ПС + СообщениеОбщееПояснение; 
				ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеДляВывода, , Элемент.Имя);
				
			КонецЕсли;

			ЭтаФорма[ИмяРеквизитаПредставление] = "";
			//-- #1152 смарт: Лопато 18.10.2024
	
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры  

