//++ #1537 смарт: Корбутов 02.11.2023 исправить бизнес-регионы
//Функция возвращает уровень справочника Бизнес-Регионы, или выозвращает -1 для полноправного пользователя
//Сделано так для того, что бы не делать отдельную функцию проверки роли
&НаСервере
Функция ПолучитьУровеньРегиона(ЭлементСправочникаРегионы)
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат -1;
	КонецЕсли;
	РодительРегиона = ЭлементСправочникаРегионы.Родитель;
	Если ЗначениеЗаполнено(РодительРегиона) Тогда
		РодительРодителя = РодительРегиона.Родитель;
		Если ЗначениеЗаполнено(РодительРодителя) Тогда
			Возврат 2;
		Иначе 
			возврат 1;
		КонецЕсли;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции
//-- #1537 смарт: Корбутов 02.11.2023

//++ #1537 смарт: Мосолов 09.01.2024 //Запрет создания элементов справочника Бизнес-регионы 
