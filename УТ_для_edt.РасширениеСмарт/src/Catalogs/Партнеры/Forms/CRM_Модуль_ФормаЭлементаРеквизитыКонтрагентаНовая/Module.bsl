//++ смарт:ММ #045 243 23.04.2020 - добавление команд для ТЧ Чернила клиента  
&НаКлиенте
Процедура РасшСмарт_ДобавитьЧернилаКлиентаЗавершение(ПараметрыОборудования, НовыеСтроки)
	
	Отбор = Новый Структура("смартЧернилаКлиента");
	
	Для Каждого НоваяСтрока Из НовыеСтроки Цикл
		
		Отбор.смартЧернилаКлиента = НоваяСтрока.смартОборудованиеКлиента;
		                  
		РезультатПоиска = Объект.смартЧернилаКлиента.НайтиСтроки(Отбор);
		
		Если РезультатПоиска.Количество() = 0 Тогда
			
			ТекущаяСтрока = Объект.смартЧернилаКлиента.Добавить();
			ТекущаяСтрока.смартЧернилаКлиента = НоваяСтрока.смартОборудованиеКлиента;
			ТекущаяСтрока.смартДатаДобавления = Дата(ТекущаяДата());
			ТекущаяСтрока.смартКомментарий = НоваяСтрока.смартКомментарий; 
			
			Если НовыеСтроки.Количество() > 0 Тогда
				Элементы.смартЧернилаКлиента.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		Иначе
			Сообщить("Эти чернила уже добавлены");
		КонецЕсли;
					
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 23.04.2020

