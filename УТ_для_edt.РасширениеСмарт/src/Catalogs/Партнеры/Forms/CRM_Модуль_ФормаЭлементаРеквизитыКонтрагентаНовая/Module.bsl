&НаСервере
//++ #Б-5762 смарт: Фролов 18.02.2026 //Добавить механизм Инцидентов в справочник Партнеры.
Процедура смартОтреагироватьНаИнцидентНаСервере()
	
	Если СокрЛП(ЭтаФорма.смартИнцидентПринятоеРешение) = "" Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не заполнено Принятое решение!");
		Возврат;	
		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартИнцидент.Ссылка КАК Ссылка,
	|	смартИнцидент.Задача КАК Задача
	|ИЗ
	|	Документ.смартИнцидент КАК смартИнцидент
	|ГДЕ
	|	смартИнцидент.ОбъектИнцидента = &ОбъектИнцидента
	|	И НЕ смартИнцидент.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартВидыРеакцийНаИнцидент.Ссылка КАК Ссылка,
	|	смартВидыРеакцийНаИнцидент.Наименование КАК Наименование,
	|	смартВидыРеакцийНаИнцидент.Код КАК Код
	|ИЗ
	|	Справочник.смартВидыРеакцийНаИнцидент КАК смартВидыРеакцийНаИнцидент
	|ГДЕ
	|	смартВидыРеакцийНаИнцидент.Использовать
	|	И смартВидыРеакцийНаИнцидент.Ссылка В ИЕРАРХИИ(ЗНАЧЕНИЕ(Справочник.смартВидыРеакцийНаИнцидент.ДляПартнеров))
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартВидыРеакцийНаИнцидент.Порядок");
	Запрос.УстановитьПараметр("ОбъектИнцидента", Объект.Ссылка);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаДокумент = МассивРезультатов[0].Выбрать();
	
	Если ВыборкаДокумент.Следующий() Тогда
	
		ДокументИнцидент = ВыборкаДокумент.Ссылка.ПолучитьОбъект();
		ДокументИнцидент.Решение = ЭтаФорма.смартИнцидентПринятоеРешение;
		//++ #Б-5928 смарт: Фролов 05.03.2026 //Доработка механизма Инциденты.
		//ДокументИнцидент.Оценка = ЭтаФорма.смартИнцидентОценкаРаботыОКК;
		//ДокументИнцидент.КомментарийКОценке = ЭтаФорма.смартИнцидентКомментарийКОценке;
		//-- #Б-5928 смарт: Фролов 05.03.2026
		ДокументИнцидент.ДатаРеакции = ТекущаяДата();
		ДокументИнцидент.ЕстьРеакция = Истина;
		ДокументИнцидент.КтоОтреагировал = Пользователи.ТекущийПользователь(); 
		
		ТекстПисьма = "Партнер: " + Объект.Наименование + Символы.ПС + Символы.ПС;
		ТекстПисьма = ТекстПисьма + ЭтаФорма.смартИнцидентПринятоеРешение + Символы.ПС + Символы.ПС;
		
		Выборка = МассивРезультатов[1].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВидИнцидента = Элементы.Найти("смартВидРеакции" + Выборка.Код);
			
			Если НЕ ВидИнцидента = Неопределено Тогда
				
				Если ЭтаФорма["смартВидРеакции" + Выборка.Код] Тогда
					
					СтрВидыРеакцииНаИнцидент = ДокументИнцидент.ВидыРеакцииНаИнцидент.Добавить();
					СтрВидыРеакцииНаИнцидент.ВидРеакцииНаИнцидент = Выборка.Ссылка;	
					
					ТекстПисьма = ТекстПисьма + Выборка.Наименование + Символы.ПС;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		ДокументИнцидент.Записать(РежимЗаписиДокумента.Запись);
		
		//++ #Б-7740 смарт: Фролов 05.08.2026 //Задачи от ком отдела от 04.08
		//ОбъектЗадача = ВыборкаДокумент.Задача.ПолучитьОбъект();
		//ОбъектЗадача.Выполнена = Истина;
		//ОбъектЗадача.ДатаИсполнения = ТекущаяДата();
		//ОбъектЗадача.РезультатВыполнения = ЭтаФорма.смартИнцидентПринятоеРешение;
		//ОбъектЗадача.Записать();
		//-- #Б-7740 смарт: Фролов 05.08.2026
		
		ЭтаФорма.смартИнцидентДатаРеакции = ТекущаяДата();
		ЭтаФорма.смартИнцидентКтоОтреагировал = Пользователи.ТекущийПользователь();
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(ЭтаФорма.смартИнцидентКтоОповестил, АдресаДляОтправкиСтрокой);

		НавСсылка = ПолучитьНавигационнуюСсылку(Объект.Ссылка); 
		
		ТекстПисьма = ТекстПисьма + Символы.ПС + "Автор " + Пользователи.ТекущийПользователь() + Символы.ПС;
		ТекстПисьма = ТекстПисьма + "Оценка работы " 
			+ Лев(ЭтаФорма.смартИнцидентОценкаРаботыОКК, СтрНайти(Строка(ЭтаФорма.смартИнцидентОценкаРаботыОКК), " ") - 1) + Символы.ПС;
		ТекстПисьма = ТекстПисьма + Символы.ПС + "Ссылка на объект инцидента: " + НавСсылка;
		
		ТемаПисьма = "Реакция на инцидент";
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			ДанныеОтправки = Новый Структура("Тема, Заголовок", ТемаПисьма, ТекстПисьма);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, , ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Исключение
				ТекстСообщения = "Не удалось отправить письмо ответственному " + ЭтаФорма.смартИнцидентКтоОповестил 
					+ " по инциденту " + ДокументИнцидент.Ссылка + Символы.ПС + ОписаниеОшибки(); 
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;
		
		Элементы.смартГруппаРеакцияНаИнцидентВертикальная.ТолькоПросмотр = Истина;
		Элементы.смартКнопкаОтреагироватьНаИнцидент.Доступность = Ложь;
	
	КонецЕсли;
	
КонецПроцедуры //-- #Б-5762 смарт: Фролов 18.02.2026

