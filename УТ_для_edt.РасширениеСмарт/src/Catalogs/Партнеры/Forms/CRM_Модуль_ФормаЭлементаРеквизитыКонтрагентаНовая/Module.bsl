//++ #1920 смарт: Фролов 12.07.2024 //Механизм закрепления Партнеров ответственными менеджерами.
Процедура смартЗакрепленОтветственныйПриИзменении(Элемент)
	
	Если ЭтаФорма.смартЗакрепленОтветственный Тогда
		
		ДополнительныеПараметры = Новый Структура("ТипУслуги, НаименованиеРеквизитаБулево, НаименованиеРеквизита, ТипДействия", 
			"ПоставкаТоварыУслуги", "смартЗакрепленОтветственный", "ОсновнойМенеджер", Истина);
		ОписаниеОповещения = Новый ОписаниеОповещения("смартУстановкаСнятиеЗакрепленияОтветственного", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, "Вы хотите закрепить за Менеджером " + Объект.ОсновнойМенеджер + 
			" партнера " + Объект.Наименование + ", Продолжить ?",РежимДиалогаВопрос.ДаНет, 60);
		
	Иначе
		
		ДополнительныеПараметры = Новый Структура("ТипУслуги, НаименованиеРеквизитаБулево, НаименованиеРеквизита, ТипДействия", 
			"ПоставкаТоварыУслуги", "смартЗакрепленОтветственный", "ОсновнойМенеджер", Ложь);
		ОписаниеОповещения = Новый ОписаниеОповещения("смартУстановкаСнятиеЗакрепленияОтветственного", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения, "Вы хотите снять закрепление партнера " + Объект.Наименование + 
			" за " + Объект.ОсновнойМенеджер +", Продолжить ?",РежимДиалогаВопрос.ДаНет, 60);
		
	КонецЕсли;	
	
КонецПроцедуры //-- #1920 смарт: Фролов 12.07.2024

