Процедура смартОткрытьРедактированиеИндивидуальнойСкидки(Элемент)

	ПравоРедактированияИндивидуальныхСкидокПартнера = смартОбщегоНазначения.смартПравоРедактированияИндивидуальныхСкидокПартнера(Объект.Ссылка);
	
	Если ПравоРедактированияИндивидуальныхСкидокПартнера Тогда
		ТекДанные = Элементы.смартИндивидуальныеСкидкиКлиентов.ТекущиеДанные;	
		ПоказатьЗначение(, ТекДанные.Регистратор);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("У Вас нет права редактирования индивидуальных скидок данного клиента!");
	КонецЕсли;	
	
КонецПроцедуры //--#1323 смарт: Лопато 25.09.2023	

