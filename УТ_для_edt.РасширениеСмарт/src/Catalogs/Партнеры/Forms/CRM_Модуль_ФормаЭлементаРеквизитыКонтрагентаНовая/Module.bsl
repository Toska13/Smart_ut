//++#1323 смарт: Лопато 25.09.2023 //Восстановить и переделать механизм индивидуальных скидок
&НаСервере
Процедура смартУстановитьДоступностьРедактированияИндивидуальныхСкидок()
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		ПравоРедактированияИндивидуальныхСкидокПартнера = смартОбщегоНазначения.смартПравоРедактированияИндивидуальныхСкидокПартнера(Объект.Ссылка);
	Иначе	
		ПравоРедактированияИндивидуальныхСкидокПартнера = Ложь;
	КонецЕсли;
	
	Элементы.БыстрыйВвод_СтраницаСкидки.ТолькоПросмотр 					   = НЕ ПравоРедактированияИндивидуальныхСкидокПартнера;
	Элементы.смартКоманднаяПанельСкидки.Доступность 					   = ПравоРедактированияИндивидуальныхСкидокПартнера;

	Элементы.смартИндивидуальныеСкидкиКлиентов.ТолькоПросмотр 			   = НЕ ПравоРедактированияИндивидуальныхСкидокПартнера;
	
КонецПроцедуры //--#1323 смарт: Лопато 25.09.2023	

//++#1323 смарт: Лопато 25.09.2023 //Восстановить и переделать механизм индивидуальных скидок
