	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин 27.11.2019 17:55:37
	смартВызовКоманды(Объект.Ссылка);
	//Смарт }Подкин 27.11.2019 17:55:37
КонецПроцедуры

