Процедура смартВыгрузитьПартнераВУТКовчег(Команда)
	//проверка на ошибки
	ЕстьОшибка = Ложь;
	
	Если Параметры.Ключ.Пустая() тогда
		ПоказатьПредупреждение(, "Для выгрузки партнера его необходимо сначала записать!");
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если Модифицированность тогда
		ПоказатьПредупреждение(, "Партнер изменен! Перед выгрузкой необходимо записать элемент справочника.");
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если смарт_ОбменКонтрагентамиУТКовчегСервер.ЕстьКонтрагентыПоПартнеру(Объект.Ссылка) = Ложь тогда
		ПоказатьПредупреждение(, "Для выгрузки партнера и контрагентов для партнера должен быть создан хотя-бы один контрагент!");
		ЕстьОшибка = Истина;
	КонецЕсли;
	
	Если НЕ ЕстьОшибка тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("смарт_смартВыгрузитьПартнераВУТКовчегЗавершение", ЭтаФорма), "Выгрузить партнера """ + Строка(Объект.Ссылка) + """ и связанные с ним данные?", РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

