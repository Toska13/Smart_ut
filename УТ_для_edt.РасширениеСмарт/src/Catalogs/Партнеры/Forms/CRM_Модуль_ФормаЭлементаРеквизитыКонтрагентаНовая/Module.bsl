Процедура РасшСмарт_ОткрытьФормуВыбораЧернил()
	
	ПараметрЗаголовок = НСтр("ru = 'Добавление чернил для %Справочник%'");
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
