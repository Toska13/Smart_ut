			ОткрытьФорму("Документ.смартУстановкаИндивидуальныхСкидокКлиентов.ФормаОбъекта", 
						 Новый Структура("Клиент", Объект.Ссылка), ЭтаФорма, , , , 
						 Новый ОписаниеОповещения("смартОповещениеОВводеНовойСкидки", ЭтаФорма));
		КонецЕсли;		
	КонецЕсли;	

