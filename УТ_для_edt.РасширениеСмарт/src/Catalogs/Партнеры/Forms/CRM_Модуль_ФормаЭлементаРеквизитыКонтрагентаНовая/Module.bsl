&НаСервере 
//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Процедура смартВывестиТабличныйДокументРасщифровкаРазговора(Данные)
	
	ТабДок = ЭтаФорма.смартРасшифровкаРазговораDEERAY;
	
	ТабДок.Очистить();
	
	Макет = Документы.CRM_Интерес.ПолучитьМакет("смартРасшифровкаРазговора");
		
	Если НЕ Данные = Неопределено Тогда
		
		РазделДанные = Данные.Получить("data")[0];
		
		Сообщения = РазделДанные.Получить("messages");
		
		ПредыдущийАвтор = "";
		
		Для Каждого СтрСообщения Из Сообщения Цикл
			
			АвторСообщения = СтрСообщения.Получить("author");
			АвторСообщенияИмя = АвторСообщения.Получить("name");
			МассивСообщений = СтрСообщения.Получить("sentences");
			УчастникЗвонка = СтрСообщения.Получить("originator");
			
			Если УчастникЗвонка = "customer" Тогда
				ОбластьНиз = Макет.ПолучитьОбласть("НизОператор");
			Иначе
				ОбластьНиз = Макет.ПолучитьОбласть("НизКлиент");
			КонецЕсли;	
			
			Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
				
				Если НЕ ПредыдущийАвтор = "" Тогда
					ТабДок.Вывести(ОбластьНиз);
				КонецЕсли;	
				
				ОбластьРазделитель = Макет.ПолучитьОбласть("РазделительБлоков");
				ТабДок.Вывести(ОбластьРазделитель);
				
			КонецЕсли;
			
			Если УчастникЗвонка = "customer" Тогда
				
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаКлиент");
				ОбластьШапка.Параметры.Клиент = АвторСообщенияИмя;
				Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
					ТабДок.Вывести(ОбластьШапка);
				КонецЕсли;	
				ОбластьСтрока = Макет.ПолучитьОбласть("ТекстКлиент");
	
			Иначе
				
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаОператор");
				ОбластьШапка.Параметры.Оператор = АвторСообщенияИмя;
				Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
					ТабДок.Вывести(ОбластьШапка);
				КонецЕсли;	
				ОбластьСтрока = Макет.ПолучитьОбласть("ТекстОператор");
				
			КонецЕсли;	
				
			ДанныеВремени = СтрСообщения.Получить("time");
			Начало = ДанныеВремени.Получить("from");
			
			Если НЕ МассивСообщений = Неопределено Тогда
				
				Для Каждого СтрМассивСообщений Из МассивСообщений Цикл
					
					ОбластьСтрока.Параметры.Текст = СтрМассивСообщений.Получить("body"); 
					ОбластьСтрока.Параметры.Начало = Начало;
					
					ТабДок.Вывести(ОбластьСтрока);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ПредыдущийАвтор = АвторСообщенияИмя;
			
		КонецЦикла;	
		
	КонецЕсли;

	Если УчастникЗвонка = "customer" Тогда
		ОбластьНиз = Макет.ПолучитьОбласть("НизКлиент");
	Иначе
		ОбластьНиз = Макет.ПолучитьОбласть("НизОператор");
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьНиз);
	
КонецПроцедуры //-- #Б-6082 смарт: Фролов 16.03.2026

&НаКлиенте
//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Процедура смартПрослушатьРазговорНажатие(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок) Тогда
	
		ДанныеЗвонка = смартПолучитьДанныеДляЗвонка(ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок);
		
		Если НЕ ДанныеЗвонка = Неопределено Тогда
			
			ПараметрыЗвонка = Новый Структура("ИдентификаторЗвонка, ИдентификаторЗаписи, Ответственный, Входящий, НомерТелефона, ВнутреннийНомер, ДатаНачала, ДатаОкончания, Звонок",
				ДанныеЗвонка.сфпИдентификаторЗвонка, ДанныеЗвонка.сфпИдентификаторЗаписи, ДанныеЗвонка.Ответственный, 
				ДанныеЗвонка.Входящий, ДанныеЗвонка.АбонентКакСвязаться, ДанныеЗвонка.сфпВнутреннийНомер, ДанныеЗвонка.сфпДатаНачала, 
				ДанныеЗвонка.сфпДатаОкончания, ДанныеЗвонка.Ссылка);
			
			сфпСофтФонПроКлиент.НачатьПрослушиваниеЗаписиРазговора(ПараметрыЗвонка, ЭтаФорма, Элементы.смартПрослушатьРазговорDEERAY);
			
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры //-- #Б-6082 смарт: Фролов 16.03.2026

&НаСервере
//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Функция смартПолучитьДанныеДляЗвонка(ОбъектЗвонка)
	
	Если НЕ ОбъектЗвонка.Ссылка.Пустая() Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	сфпИсторияЗвонков.ВнутреннийНомер КАК ВнутреннийНомер,
		|	сфпИсторияЗвонков.ДатаНачала КАК ДатаНачала,
		|	сфпИсторияЗвонков.ДатаОтвета КАК ДатаОтвета,
		|	сфпИсторияЗвонков.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.сфпИсторияЗвонков КАК сфпИсторияЗвонков
		|ГДЕ
		|	сфпИсторияЗвонков.Звонок = &Звонок
		|	И сфпИсторияЗвонков.ИдентификаторЗвонка = &ИдентификаторЗвонка");
		Запрос.УстановитьПараметр("Звонок", ОбъектЗвонка.Ссылка);
		Запрос.УстановитьПараметр("ИдентификаторЗвонка", ОбъектЗвонка.сфпИдентификаторЗвонка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда   			
			
			СтруктураНужныхДанных = Новый Структура();
			СтруктураНужныхДанных.Вставить("сфпВнутреннийНомер", Выборка.ВнутреннийНомер); 
			СтруктураНужныхДанных.Вставить("сфпДатаНачала", Выборка.ДатаНачала); 
			СтруктураНужныхДанных.Вставить("сфпДатаОтвета", Выборка.ДатаОтвета); 
			СтруктураНужныхДанных.Вставить("сфпДатаОкончания", Выборка.ДатаОкончания); 
			СтруктураНужныхДанных.Вставить("сфпИдентификаторЗвонка", ОбъектЗвонка.сфпИдентификаторЗвонка);
			СтруктураНужныхДанных.Вставить("сфпИдентификаторЗаписи", ОбъектЗвонка.сфпИдентификаторЗаписи);
			СтруктураНужныхДанных.Вставить("Ответственный", ОбъектЗвонка.Ответственный);
			СтруктураНужныхДанных.Вставить("Входящий", ОбъектЗвонка.Входящий);
			СтруктураНужныхДанных.Вставить("АбонентКакСвязаться", ОбъектЗвонка.АбонентКакСвязаться);
			СтруктураНужныхДанных.Вставить("Ссылка", ОбъектЗвонка.Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураНужныхДанных;
	
КонецФункции //-- #Б-6082 смарт: Фролов 16.03.2026

//++ #4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
&НаСервере
Функция ПолучитьТекстИнформацииОКонтролеТехническойОтсрочки()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.смартНеКонтролироватьТехническуюОтсрочку) Тогда
		Возврат "Нет информации";
	Иначе
		
		ДанныеОРазрешении = РегистрыСведений.смартИсторияИзмененияРазрешений.ПолучитьИнформациюПоРазрешению(Объект.Ссылка, Объект.смартИДНеКонтролироватьТехническуюОтсрочку, "НеКонтролироватьТехническуюОтсрочку");
		
		Если ДанныеОРазрешении <> Неопределено Тогда
			Возврат СтрШаблон("%1 пользователем %2 %3", ?(ДанныеОРазрешении.Разрешено, "Установлено", "Снято"), ДанныеОРазрешении.Ответственный, ДанныеОРазрешении.ДатаИзменения);
		КонецЕсли;
		
		Возврат "Нет информации";
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура смартОткрытьСтопЛистТехническойОтсрочки(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Партнер", Объект.Ссылка);
	ОткрытьФорму("РегистрСведений.смартСтопЛистТехническойОтсрочки.Форма.ФормаСтопЛист", 
				ПараметрыОткрытияФормы, 
				ЭтаФорма, 
				УникальныйИдентификатор,
				,
				,
				,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаСервере
Процедура смартОбновитьСостояниеСтопЛистаТехническойОтсрочки()
	
	Если НЕ Элементы.Найти("ГруппаСтопЛистТехническойОтсрочки") = Неопределено Тогда
		Если Объект.Клиент Тогда 
			Элементы.ГруппаСтопЛистТехническойОтсрочки.Видимость = Истина;
			ОтгрузкаЗапрещена = РегистрыСведений.смартСтопЛистТехническойОтсрочки.КлиентуЗапрещенаТехническаяОтсрочка(Объект.Ссылка);
			Элементы.смартОткрытьСтопЛистТехническойОтсрочки.Видимость = ОтгрузкаЗапрещена;
			Элементы.смартОткрытьСтопЛистТехническойОтсрочки1.Видимость = НЕ ОтгрузкаЗапрещена;
		Иначе
			Элементы.ГруппаСтопЛистТехническойОтсрочки.Видимость = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура смартОбновитьСостояниеБлокировокПоДоговорам()
	
	Если НЕ Элементы.Найти("ГруппаБлокировкиПоДоговорам") = Неопределено Тогда
		Элементы.ГруппаБлокировкиПоДоговорам.Видимость = Объект.Клиент
														И смартКонтрольДебиторскойЗадолженности.ЕстьАктивныеБлокировкиПоДоговорамПартнера(Объект.Ссылка);
	КонецЕсли;   
	
КонецПроцедуры
