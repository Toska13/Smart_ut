//++ #Б-2852 смарт: Фролов 09.04.2025 //Реализовать возможность присваивать Архивное "Состояние СЦ" Менеджерами СЦ
Функция смартВернутьПараметрыФормыАрхивированияРазархивированияКлиента()

	Если Элементы.смартСостояниеОтветственногоСЦ.Заголовок = "Архивный" Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Исполнитель КАК Исполнитель
		|ИЗ
		|	РегистрСведений.ИсполнителиЗадач
		|ГДЕ
		|	РольИсполнителя = ЗНАЧЕНИЕ(Справочник.РолиИсполнителей.смартОтветственныйЗаСогласованиеСтатусаПартнера)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СостояниеСЦ КАК СостояниеСЦ,
		|	ДатаПереводаВАрхив КАК ДатаПереводаВАрхив,
		|	ПричинаПереводаКлиентовВАрхив КАК ПричинаПереводаКлиентовВАрхив,
		|	ОтветственныйЗаПереводВАрхив КАК ОтветственныйЗаПереводВАрхив,
		|	СогласованоПомещениеВАрхив КАК СогласованоПомещениеВАрхив
		|ИЗ
		|	РегистрСведений.смартСостояниеПартнеров
		|ГДЕ
		|	Партнер = &Партнер");
		Запрос.УстановитьПараметр("Партнер", Объект.Ссылка);
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		Выборка = МассивРезультатов[1].Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Если Выборка.СостояниеСЦ = Перечисления.смартСостоянияПартнеров.Архивный Тогда
				
					МассивСогласователей = МассивРезультатов[0].Выгрузить().ВыгрузитьКолонку("Исполнитель");
					
					Если НЕ МассивСогласователей.Найти(ПараметрыСеанса.ТекущийПользователь) = Неопределено 
						И НЕ Выборка.СогласованоПомещениеВАрхив Тогда
					
						Возврат Новый Структура("Дата, Ответственный, ИмяФормы, Причина", Выборка.ДатаПереводаВАрхив, Выборка.ОтветственныйЗаПереводВАрхив, 
										"Справочник.Партнеры.Форма.смарт_ФормаПереводаВАрхив", Выборка.ПричинаПереводаКлиентовВАрхив);	
						
					Иначе
						
						Возврат Новый Структура("Дата, Ответственный, ИмяФормы, Причина", Выборка.ДатаПереводаВАрхив, Выборка.ОтветственныйЗаПереводВАрхив, 
										"Справочник.Партнеры.Форма.смарт_ФормаВозвращенияИзАрхива", Выборка.ПричинаПереводаКлиентовВАрхив);
					
					КонецЕсли;
			
			Иначе
				
				Возврат Новый Структура("Дата, Ответственный, ИмяФормы, Причина", ТекущаяДата(), ПараметрыСеанса.ТекущийПользователь, 
						"Справочник.Партнеры.Форма.смарт_ФормаПереводаВАрхив", Выборка.ПричинаПереводаКлиентовВАрхив);	
			
			КонецЕсли;
		
		Иначе
			
			Возврат Новый Структура("Дата, Ответственный, ИмяФормы, Причина", ТекущаяДата(), ПараметрыСеанса.ТекущийПользователь, 
						"Справочник.Партнеры.Форма.смарт_ФормаПереводаВАрхив", "");
			
		КонецЕсли;

	Иначе
			
		Возврат Новый Структура("Дата, Ответственный, ИмяФормы, Причина", ТекущаяДата(), ПараметрыСеанса.ТекущийПользователь, 
						"Справочник.Партнеры.Форма.смарт_ФормаПереводаВАрхив", "");
		
	КонецЕсли;	
	
КонецФункции //-- #Б-2852 смарт: Фролов 09.04.2025	

&НаКлиенте
//++ #Б-5258 смарт: Фролов 16.12.2025 //Создание механизма сегментации партнеров.
Процедура смартЗакрытаФормаРедактированияВидовДеятельности(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		Объект.смартВидыДеятельности.Очистить();
		
		Для Каждого Стр Из Результат.МассивВидовДеятельности Цикл
			
			СтрокасмартВидыДеятельности = Объект.смартВидыДеятельности.Добавить();
			//++ #Б-7322 смарт: Фролов 06.07.2026 //Справочник "Партнеры". Таблица "Виды деятельности". Добавить реквизиты.
			ЗаполнитьЗначенияСвойств(СтрокасмартВидыДеятельности, Стр);
			//СтрокасмартВидыДеятельности.ВидДеятельности = Стр;
			//-- #Б-7322 смарт: Фролов 06.07.2026
			
		КонецЦикла; 
		
		Объект.смартТипичноеОборудование.Очистить();
		
		Для Каждого Стр Из Результат.МассивТипичноеОборудование Цикл
			
			СтрокасмартТипичноеОборудование = Объект.смартТипичноеОборудование.Добавить();
			СтрокасмартТипичноеОборудование.ТипичноеОборудование = Стр;
			
			Если НЕ Результат.МассивНаших.Найти(Стр) = Неопределено Тогда
				
				СтрокасмартТипичноеОборудование.КупленоВСМАРТ = Истина;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		//++ #6764 смарт: Тимофеева 15.05.2026 / Внести изменения в "Форму редактирования видов деятельности" в карточке партнера 
		Если Результат.Свойство("ВидДеятельностиДругоеРасшифровка") Тогда
			НайденныеСтроки = Объект.смартВидыДеятельности.НайтиСтроки(Новый Структура("ВидДеятельности", Результат.ВидДеятельностиДругоеРасшифровка.ВидДеятельности));
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].ДругоеРасшифровка = Результат.ВидДеятельностиДругоеРасшифровка.ДругоеРасшифровка;		
			КонецЕсли;
		КонецЕсли;   
		Если Результат.Свойство("ТипичноеОборудованиеДругоеРасшифровка") Тогда
			НайденныеСтроки = Объект.смартТипичноеОборудование.НайтиСтроки(Новый Структура("ТипичноеОборудование", Результат.ТипичноеОборудованиеДругоеРасшифровка.ТипичноеОборудование));
			Если НайденныеСтроки.Количество() > 0 Тогда
				НайденныеСтроки[0].ДругоеРасшифровка = Результат.ТипичноеОборудованиеДругоеРасшифровка.ДругоеРасшифровка;		
			КонецЕсли;
		КонецЕсли;
		//-- #6764 смарт: Тимофеева 15.05.2026 

		ЭтаФорма.Модифицированность = Истина;
		
		Элементы.смартВидыДеятельности.Обновить();	
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-5258 смарт: Фролов 16.12.2025

