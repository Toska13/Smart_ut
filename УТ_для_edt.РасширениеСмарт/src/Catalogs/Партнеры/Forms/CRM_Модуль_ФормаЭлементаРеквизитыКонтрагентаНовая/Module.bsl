&НаКлиенте
Процедура смартПартнерАдресНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ВидКонтактнойИнформации", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПартнера"));
	ПараметрыОткрытия.Вставить("Представление", Объект[Элемент.Имя]);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Объект", Объект);
	ДопПараметры.Вставить("ИмяРеквизитаАдреса", Элемент.Имя);
	ДопПараметры.Вставить("Элемент", Элемент);
	
	//++ #Б4248 смарт: Шляпников 16.09.2025 / Доставка товаров по заказу клиента, корректность заполнения, печать Этикетки доставки
	Если Элемент.Имя = "смартПартнерАдресДоставки" Тогда
		ПараметрыОткрытия.Вставить("ЗначенияПолей", ДоставкаТоваровКлиентСервер.ПреобразоватьСтрокуВСписокПолей(Объект.смартПартнерАдресДоставкиЗначенияПолей));
		ПараметрыОткрытия.Вставить("Значение", Объект.смартПартнерАдресДоставкиЗначение);
	КонецЕсли;
	//-- #Б4248 смарт: Шляпников 16.09.2025
	
	Оповещение=Новый ОписаниеОповещения("смартПартнерАдресНачалоВыбораЗавершение" ,ЭтотОбъект,ДопПараметры);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыОткрытия,, Оповещение);
	
КонецПроцедуры

