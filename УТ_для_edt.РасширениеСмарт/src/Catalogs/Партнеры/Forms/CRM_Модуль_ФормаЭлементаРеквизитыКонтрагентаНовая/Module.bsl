&НаСервере 
//++ #Б-5762 смарт: Фролов 18.02.2026 //Добавить механизм Инцидентов в справочник Партнеры.
Процедура смартОповеститьОбИнцидентеНаСервере()
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.смартИнцидентКтоБудетОповещен) Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не заполнено поле Кто будет оповещен!");
		Возврат;	
		
	КонецЕсли;
	
	Если СокрЛП(ЭтаФорма.смартИнцидентУточнение) = "" Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Не заполнено уточнение!");
		Возврат;	
		
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартИнцидент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартИнцидент КАК смартИнцидент
	|ГДЕ
	|	смартИнцидент.ОбъектИнцидента = &ОбъектИнцидента
	|	И НЕ смартИнцидент.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартВидыИнцидентов.Ссылка КАК Ссылка,
	|	смартВидыИнцидентов.Наименование КАК Наименование,
	|	смартВидыИнцидентов.Код КАК Код
	|ИЗ
	|	Справочник.смартВидыИнцидентов КАК смартВидыИнцидентов
	|ГДЕ
	|	смартВидыИнцидентов.Использовать
	|	И смартВидыИнцидентов.Ссылка В ИЕРАРХИИ(ЗНАЧЕНИЕ(Справочник.смартВидыИнцидентов.ДляПартнеров))
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартВидыИнцидентов.Порядок");
	Запрос.УстановитьПараметр("ОбъектИнцидента", Объект.Ссылка);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Если МассивРезультатов[0].Пустой() Тогда
		
		ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
		ЗадачаОбъект.Дата = ТекущаяДата();
		ЗадачаОбъект.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
		ЗадачаОбъект.Исполнитель = ЭтаФорма.смартИнцидентКтоБудетОповещен;
		ЗадачаОбъект.Предмет = Объект.Ссылка;
		ЗадачаОбъект.ПредметСтрокой = Строка(Объект.Ссылка);
		ЗадачаОбъект.CRM_Личная = Истина;
		ЗадачаОбъект.CRM_Партнер = Объект.Ссылка;
		ЗадачаОбъект.Автор = Пользователи.ТекущийПользователь();
		ЗадачаОбъект.ДатаНачала = ТекущаяДата() + 300;
		ЗадачаОбъект.ПринятаКИсполнению = Истина;
		ЗадачаОбъект.СостояниеБизнесПроцесса = Перечисления.СостоянияБизнесПроцессов.Активен;
 		ЗадачаОбъект.СрокИсполнения = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ТекущаяДата(), 1, "Вперед");
		
		ЗадачаОбъект.смартВидЗадачи = Справочники.смартВидыЗадач.РазобратьсяСИнцидентом;
		
		ЗадачаОбъект.Описание = ЭтаФорма.смартИнцидентУточнение;
		ЗадачаОбъект.Наименование = "Необходимо разобраться с инцидентом";
		ЗадачаОбъект.Записать();
		
		ДокументИнцидент = Документы.смартИнцидент.СоздатьДокумент();
		ДокументИнцидент.ОбъектИнцидента = Объект.Ссылка;
		ДокументИнцидент.Задача = ЗадачаОбъект.Ссылка;
		ДокументИнцидент.Ответственный = Пользователи.ТекущийПользователь();
		ДокументИнцидент.Описание = ЭтаФорма.смартИнцидентУточнение;
		ДокументИнцидент.Адресат = ЭтаФорма.смартИнцидентКтоБудетОповещен;
		ДокументИнцидент.Дата = ТекущаяДата();
		
		ТекстПисьма = "Партнер: " + Объект.Наименование + Символы.ПС + Символы.ПС;
		ТекстПисьма = ТекстПисьма + ЭтаФорма.смартИнцидентУточнение + Символы.ПС + Символы.ПС;
		
		Выборка = МассивРезультатов[1].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВидИнцидента = Элементы.Найти("смартВидИнцидента" + Выборка.Код);
			
			Если НЕ ВидИнцидента = Неопределено Тогда
				
				Если ЭтаФорма["смартВидИнцидента" + Выборка.Код] Тогда
					
					СтрВидыИнцидентов = ДокументИнцидент.ВидыИнцидентов.Добавить();
					СтрВидыИнцидентов.ВидИнцидента = Выборка.Ссылка;
					
					ТекстПисьма = ТекстПисьма + Выборка.Наименование + Символы.ПС;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		ДокументИнцидент.Записать(РежимЗаписиДокумента.Запись);
		
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(ЭтаФорма.смартИнцидентКтоБудетОповещен, АдресаДляОтправкиСтрокой);
		
		//++ #Б-6630 смарт: Фролов 13.05.2026 //Сделать механизм оповещений о новых Инцидентах.
		МассивПользователей = смартОбщегоНазначения.ПолучитьПользователейПоНастройкамОбОповещениях("Инциденты", "Все подразделения", Неопределено);
		
		Если НЕ МассивПользователей = Неопределено Тогда
			
			Для Каждого Пользователь Из МассивПользователей Цикл
				
				МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
				АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
				
			КонецЦикла;
		
		КонецЕсли;
		//-- #Б-6630 смарт: Фролов 13.05.2026

		НавСсылка = ПолучитьНавигационнуюСсылку(Объект.Ссылка);
		ТекстПисьма = ТекстПисьма + Символы.ПС + "Ссылка на объект инцидента: " + НавСсылка;
		
		ТемаПисьма = "Новый инцидент, требует вашего внимания!";
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			ДанныеОтправки = Новый Структура("Тема, Заголовок", ТемаПисьма, ТекстПисьма);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, , ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Исключение
				ТекстСообщения = "Не удалось отправить письмо ответственному " + ЭтаФорма.смартИнцидентКтоБудетОповещен 
					+ " по инциденту " + ДокументИнцидент.Ссылка + Символы.ПС + ОписаниеОшибки(); 
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;
		
		Элементы.смартГруппаОповеститьОбИнцидентеВертикальная.ТолькоПросмотр = Истина;
		Элементы.смартКнопкаОповеститьОбИнциденте.Доступность = Ложь;
	
	КонецЕсли;

КонецПроцедуры //-- #Б-5762 смарт: Фролов 18.02.2026

