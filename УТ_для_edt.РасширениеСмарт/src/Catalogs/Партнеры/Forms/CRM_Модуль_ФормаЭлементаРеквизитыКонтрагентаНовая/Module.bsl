//++ смарт:ММ #108 550 15.06.2021 Объединение с CRM
&НаСервере
Процедура ДобавитьЭлементыПрограммно()
	
	// Команда Заметки
	
	ЗаметкиКоманда = ЭтаФорма.Команды.Добавить("Заметки");
	ЗаметкиКоманда.Действие = "смарт_ЗаметкиПосле";
	ЗаметкиКоманда.Отображение = ОтображениеКнопки.Текст;
	
	Заметки = Элементы.Вставить("Заметки", Тип("КнопкаФормы"), Элементы.ГруппаШапка, Элементы.ДекорацияРазделительКоманднойПанели1);
    Заметки.ИмяКоманды = "Заметки";
	Заметки.Заголовок = "Заметки (смарт)";
	
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 23.09.2021 15:55:18
	//Напоминания
	ЗаметкиКоманда = ЭтаФорма.Команды.Добавить("Напоминания");
	ЗаметкиКоманда.Действие = "смарт_НапоминанияПосле";
	ЗаметкиКоманда.Отображение = ОтображениеКнопки.Текст;
	
	Заметки = Элементы.Вставить("Напоминания", Тип("КнопкаФормы"), Элементы.ГруппаШапка, Элементы.ДекорацияРазделительКоманднойПанели1);
	Заметки.ИмяКоманды = "Напоминания";
	Заметки.Заголовок = "Напоминания (смарт)";
	//Смарт }Подкин Алексей Иванович 23.09.2021 15:55:18

