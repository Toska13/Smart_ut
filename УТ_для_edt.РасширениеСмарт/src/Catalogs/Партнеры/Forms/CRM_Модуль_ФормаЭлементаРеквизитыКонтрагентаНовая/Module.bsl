//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Процедура смартВывестиДанныеРасшифровкиРазговора(смартидентификаторDeeray)
	
	ИмяФайла = "" + Справочники.смартПредопределенныеЗначения.Настройки.РасположениеПапкиФайловDEERAY + смартидентификаторDeeray + ".json";
	
	Данные = смартИнтеграцияDeeray.ПолучитьДанныеJSON(ИмяФайла);
	
	Если НЕ Данные = Неопределено Тогда
		
		смартВывестиТабличныйДокументРасщифровкаРазговора(Данные);
		
	КонецЕсли;
			
