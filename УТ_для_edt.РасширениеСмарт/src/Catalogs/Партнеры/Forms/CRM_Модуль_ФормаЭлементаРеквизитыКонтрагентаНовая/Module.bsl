&НаКлиенте
Процедура смартУстановитьНадписьОсталосьДнейСрокПроверкиКлючевойКлиент()
//++#1283 смарт: Лопато 23.12.2022 //Автоматическое заполнение у партнера признака «Ключевые клиенты по расходным материалам»  

	ТекстОсталосьДней = "";
	
	Если ЗначениеЗаполнено(Объект.смартСрокПроверкиКлючевойКлиент) Тогда
		Если НачалоДня(Объект.смартСрокПроверкиКлючевойКлиент) > НачалоДня(ТекущаяДата()) Тогда
			ТекстОсталосьДней = "Через " + ИнтеграцияС1СДокументооборотКлиентСервер.РазностьДатВДнях(НачалоДня(Объект.смартСрокПроверкиКлючевойКлиент), НачалоДня(ТекущаяДата()), Ложь);
			Элементы.смартСрокПроверкиОсталосьДней.ЦветТекста = Новый Цвет(0, 128, 0);
		Иначе
			ТекстОсталосьДней = "Срок проверки истек";
			Элементы.смартСрокПроверкиОсталосьДней.ЦветТекста = Новый Цвет(200, 0, 0);
		КонецЕсли;	
	КонецЕсли;
	
	Элементы.смартСрокПроверкиОсталосьДней.Заголовок = ТекстОсталосьДней;
	
КонецПроцедуры //--#1283 смарт: Лопато 23.12.2022

//++#1323 смарт: Лопато 25.09.2023 //Восстановить и переделать механизм индивидуальных скидок
