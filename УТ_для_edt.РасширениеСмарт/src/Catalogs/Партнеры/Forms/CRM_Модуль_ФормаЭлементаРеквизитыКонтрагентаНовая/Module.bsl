//++ #Б-5928 смарт: Фролов 05.03.2026 //Доработка механизма Инциденты.
Процедура смартЗаписатьИтоговыйРезультатНаСервере()

	УстановитьПривилегированныйРежим(Истина); 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	смартИнцидент.Ссылка КАК Ссылка,
	|	смартИнцидент.Задача КАК Задача
	|ИЗ
	|	Документ.смартИнцидент КАК смартИнцидент
	|ГДЕ
	|	смартИнцидент.ОбъектИнцидента = &ОбъектИнцидента
	|	И НЕ смартИнцидент.ПометкаУдаления
	//++ #Б-6288 смарт: Фролов 02.04.2026 //Доработка Инцидентов.
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартВидыИтоговыхРезультатовИнцидентов.Ссылка КАК Ссылка,
	|	смартВидыИтоговыхРезультатовИнцидентов.Наименование КАК Наименование,
	|	смартВидыИтоговыхРезультатовИнцидентов.Код КАК Код
	|ИЗ
	|	Справочник.смартВидыИтоговыхРезультатовИнцидентов КАК смартВидыИтоговыхРезультатовИнцидентов
	|ГДЕ
	|	смартВидыИтоговыхРезультатовИнцидентов.Использовать
	|	И смартВидыИтоговыхРезультатовИнцидентов.Ссылка В ИЕРАРХИИ(ЗНАЧЕНИЕ(Справочник.смартВидыИтоговыхРезультатовИнцидентов.ДляПартнеров))
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартВидыИтоговыхРезультатовИнцидентов.Порядок");
	Запрос.УстановитьПараметр("ОбъектИнцидента", Объект.Ссылка);
	
	//ВыборкаДокумент = Запрос.Выполнить().Выбрать();
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаДокумент = МассивРезультатов[0].Выбрать();
	//-- #Б-6288 смарт: Фролов 02.04.2026
	
	Если ВыборкаДокумент.Следующий() Тогда
	
		ДокументИнцидент = ВыборкаДокумент.Ссылка.ПолучитьОбъект();
		ДокументИнцидент.ИтоговыйРезультат = ЭтаФорма.смартИнцидентИтоговыйРезультат;
		ДокументИнцидент.Оценка = ЭтаФорма.смартИнцидентОценкаРаботыОКК;
		ДокументИнцидент.КомментарийКОценке = ЭтаФорма.смартИнцидентКомментарийКОценке; 
		ДокументИнцидент.ДатаРезультата = ТекущаяДата();
		
		//++ #Б-6288 смарт: Фролов 02.04.2026 //Доработка Инцидентов.
		Выборка = МассивРезультатов[1].Выбрать();
		
		ДокументИнцидент.ВидыРезультатов.Очистить();
		
		Пока Выборка.Следующий() Цикл
			
			ВидРезультата = Элементы.Найти("смартВидРезультата" + Выборка.Код);
			
			Если НЕ ВидРезультата = Неопределено Тогда
				
				Если ЭтаФорма["смартВидРезультата" + Выборка.Код] Тогда
					
					СтрВидыРеакцииНаИнцидент = ДокументИнцидент.ВидыРезультатов.Добавить();
					СтрВидыРеакцииНаИнцидент.ВидРезультата = Выборка.Ссылка;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		//-- #Б-6288 смарт: Фролов 02.04.2026
		
		ДокументИнцидент.Записать(РежимЗаписиДокумента.Запись);
		
		//++ #Б-7740 смарт: Фролов 05.08.2026 //Задачи от ком отдела от 04.08
		ОбъектЗадача = ВыборкаДокумент.Задача.ПолучитьОбъект();
		ОбъектЗадача.Выполнена = Истина;
		ОбъектЗадача.ДатаИсполнения = ТекущаяДата();
		ОбъектЗадача.РезультатВыполнения = ЭтаФорма.смартИнцидентПринятоеРешение;
		ОбъектЗадача.Записать();
		//-- #Б-7740 смарт: Фролов 05.08.2026
		
		ЭтаФорма.смартИнцидентДатаРезультата = ТекущаяДата();
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-5928 смарт: Фролов 05.03.2026

