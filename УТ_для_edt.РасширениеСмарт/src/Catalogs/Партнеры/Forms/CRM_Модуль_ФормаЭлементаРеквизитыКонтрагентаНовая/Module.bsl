
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
		
	//++ смарт:ММ #108 550 15.06.2021 Объединение с CRM
	ДобавитьЭлементыПрограммно();
	//-- смарт:ММ 15.06.2021

	// Фролов+
	Элементы.Дилер.Доступность = Пользователи.РолиДоступны("ПолныеПрава,смартИзменениеПризнакаДилер");
	Элементы.смартДилерСервисЦентра.Доступность = Пользователи.РолиДоступны("ПолныеПрава,смартИзменениеПризнакаДилерСЦ");
	Элементы.смартПартнерОсобыеУсловияПеревозкиОписание.Видимость=Объект.смартПартнерОсобыеУсловияПеревозки;
	Объект.смартПартнерСпособДоставки=?(ЗначениеЗаполнено(Объект.смартПартнерСпособДоставки),Объект.смартПартнерСпособДоставки,Перечисления.СпособыДоставки.Самовывоз);
	
	ЗаполнитьСпискиАдресовДоставки(Объект.Ссылка,Элементы.смартПартнерАдресДоставки.Имя);
	Если ЗначениеЗаполнено(Объект.смартПартнерАдресДоставкиПеревозчика) Тогда 
		ЗаполнитьСпискиАдресовДоставки(Объект.смартПартнерАдресДоставкиПеревозчика,Элементы.смартПартнерАдресДоставкиПеревозчика.Имя);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.смартПартнерКонтактноеЛицо) Тогда 
		ЗаполнитьСписокТелефоновКонтактногоЛица(Объект.смартПартнерКонтактноеЛицо);
	КонецЕсли;
	ЗаполнитьЗонуДоставки();
	// Фролов-

	//++#1283 смарт: Лопато 01.02.2023 //Автоматическое заполнение у партнера признака «Ключевые клиенты по расходным материалам»  
	//// ++ смарт Белоусова #469 11.06.2021 доработка
	//элементы.смартКлючевойКлиентПоРасходнымМатериалам.Доступность = Ложь;
	//// -- смарт Белоусова #469 11.06.2021
	//
	//// ++ смарт Белоусова #469 12.03.2021
	//если РольДоступна("ПолныеПрава") или РольДоступна("смартРедактированиеКлючевыхКлиентов") тогда
	//	элементы.смартКлючевойКлиентПоРасходнымМатериалам.Доступность = Истина;
	//КонецЕсли;	
	// -- смарт Белоусова #469 12.03.2021
	Элементы.смартГруппаКлючевойКлиентПоРасходнымМатериалам.Доступность = (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("смартРедактированиеКлючевыхКлиентов"));
	//--#1283 смарт: Лопато 01.02.2023
	
	//++ смарт:КМД 810 14.12.2021
	смартДобавитьЭлементыПрограммноОбменСУТКовчег();
	//-- смарт:КМД 810 14.12.2021
	
	//++#1012 смарт: Холопов 04.05.2022 // Добавление подсказок для телефонов в КИ 
	смартОбщегоНазначения.ДобавитьПодсказкиКонтактнаяИнформация(ЭтотОбъект);	
	//--#1012 смарт: Холопов 04.05.2022 
	
	//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
	// Изменение ответственного доступно его руководителю
	Если Элементы.ОсновнойМенеджер.ТолькоПросмотр Тогда
		Если ЗначениеЗаполнено(Объект.ОсновнойМенеджер) И ТекущийПользователь.ФизическоеЛицо = Объект.ОсновнойМенеджер.Подразделение.ТекущийРуководитель Тогда
			Элементы.ОсновнойМенеджер.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЕсли;
	//--#1542 смарт: Лопато 03.11.2023
	
	//++#1615 смарт: Лопато 23.01.2024 //Заполнение и передача на сайт менеджеров по расходым материалам  
	Элементы.ОсновнойМенеджер.АвтоОтметкаНезаполненного 				  = Истина;
	//Элементы.смартМенеджерПоРасходнымМатериалам.АвтоОтметкаНезаполненного = Истина;
	Элементы.БизнесРегион.АвтоОтметкаНезаполненного 					  = Истина;
	//--#1615 смарт: Лопато 23.01.2024
	
	//++ #1920 смарт: Фролов 17.07.2024 //Механизм закрепления Партнеров ответственными менеджерами.
	смартУстановитьЗначенияЗакрепленияМенеджеров(Справочники.CRM_ТипУслуги.ПоставкаТоварыУслуги);
	смартУстановитьЗначенияЗакрепленияМенеджеров(Справочники.CRM_ТипУслуги.ПоставкаРасходныеМатериалы);
	смартУстановитьЗначенияЗакрепленияМенеджеров(Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти);

	//++ #Б1174 смарт: Шляпников 21.10.2024 / При открытии карточки партнера или интереса, проверять по телефонам контактов наличие дублей
	Если НЕ Параметры.Ключ.Пустая() Тогда
		
		ДобавляемыеРеквизиты = Новый Массив; //Определяем массив добавляемых реквизитов
		НовыйРеквизит = Новый РеквизитФормы("АдресВременногоХранилища", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("ИдентификаторЗаданияПроверкиПартнера", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		ЭтаФорма.АдресВременногоХранилища = ПоместитьВоВременноеХранилище("", УникальныйИдентификатор);
		
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Параметры.Ключ);
		ПараметрыФункции.Добавить(ЭтаФорма.АдресВременногоХранилища);
		
		ЭтаФорма.ИдентификаторЗаданияПроверкиПартнера = ФоновыеЗадания.Выполнить("смартПроверкаПартнеров.НайтиДублиПартнераПоТелефонуИПочте",
																					ПараметрыФункции).УникальныйИдентификатор;
		
	КонецЕсли;
	//-- #Б1174 смарт: Шляпников 21.10.2024
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Наименование");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Ссылка);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
	//++ #4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
	ПараметрыЭлемента = Новый Структура("ОтображениеПодсказки, Подсказка", ОтображениеПодсказки.ОтображатьСправа, ПолучитьТекстИнформацииОКонтролеТехническойОтсрочки());
	ПараметрыЭлемента.Вставить("Доступность", Пользователи.РолиДоступны("смартМенеджерБэкОфис"));
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "смартНеКонтролироватьТехническуюОтсрочку", "ГруппаДополнительно",, 2, "Объект.смартНеКонтролироватьТехническуюОтсрочку", ПараметрыЭлемента);
	
	смартФормированиеИнтерфейса.СоздатьКоманду(ЭтаФорма, "смартОткрытьСтопЛистТехническойОтсрочки", "Стоп-лист технической отсрочки", "смартОткрытьСтопЛистТехническойОтсрочки");
	
	ГруппаСтопЛистТехническойОтсрочки = смартФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "ГруппаСтопЛистТехническойОтсрочки", Элементы.ГруппаСписокЗапретовОтгрузки, 3,,,,);
	 
	СвойстваКнопки = Новый Структура;
	СвойстваКнопки.Вставить("Отображение", ОтображениеКнопки.КартинкаИТекст);
	СвойстваКнопки.Вставить("Картинка", БиблиотекаКартинок.ОтгрузкаЗапрещена);
	СвойстваКнопки.Вставить("ЦветТекста", WebЦвета.Кирпичный);
	смартФормированиеИнтерфейса.СздКнопка(ЭтаФорма, "смартОткрытьСтопЛистТехническойОтсрочки", "ГруппаСтопЛистТехническойОтсрочки", "Клиенту запрещена техническая отсрочка", "смартОткрытьСтопЛистТехническойОтсрочки", 2, СвойстваКнопки);
	
	СвойстваКнопки = Новый Структура;
	СвойстваКнопки.Вставить("Отображение", ОтображениеКнопки.КартинкаИТекст);
	СвойстваКнопки.Вставить("Картинка", БиблиотекаКартинок.ОтгрузкаРазрешена);
	
	смартФормированиеИнтерфейса.СздКнопка(ЭтаФорма, "смартОткрытьСтопЛистТехническойОтсрочки1", "ГруппаСтопЛистТехническойОтсрочки", "Клиенту разрешена техническая отсрочка", "смартОткрытьСтопЛистТехническойОтсрочки", 2, СвойстваКнопки);

	смартОбновитьСостояниеСтопЛистаТехническойОтсрочки(); 
	
	ГруппаБлокировкиПоДоговорам = смартФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "ГруппаБлокировкиПоДоговорам", Элементы.ГруппаСписокЗапретовОтгрузки, 3,,,,);
	смартФормированиеИнтерфейса.СздДекорацияНадпись(ЭтаФорма, "БлокировкиПоДоговорам", ГруппаБлокировкиПоДоговорам, "Внимание! Имеются активные блокировки по договорам с отсрочкой");
	ЭтаФорма.Элементы["БлокировкиПоДоговорам"].ЦветТекста = ЦветаСтиля.ЦветТекстаОтрицательногоЗначения;
	смартОбновитьСостояниеБлокировокПоДоговорам();

	//-- #4792 смарт: Тимофеева 17.03.26
	
	//++ #Б-7140 смарт: Фролов 10.08.2026 //Исключения для руководителей ОП по смене закрепленного партнера в рамках своего ОП
	Если РольДоступна("смартРуководительCRM") Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пользователи.Подразделение КАК Подразделение
		|ПОМЕСТИТЬ Руководитель
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|		ПО Пользователи.ФизическоеЛицо = ФизическиеЛица.Ссылка
		|ГДЕ
		|	Пользователи.Ссылка = &Пользователь
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Пользователи.Подразделение
		|ИЗ
		|	РегистрСведений.ИсполнителиЗадач КАК ИсполнителиЗадач
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО ИсполнителиЗадач.РольИсполнителя = Пользователи.Подразделение.смартИсполнительОтПодразделения
		|ГДЕ
		|	Пользователи.Ссылка = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Руководитель КАК Руководитель
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО Руководитель.Подразделение = Пользователи.Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	Пользователи.Наименование");
		Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
		
		МассивПользователейРуководителя = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		СтруктураНовогоСостояния = смартОбщегоНазначения.ПолучитьНовоеСостояниеПартнера(Объект.Ссылка);
	
		Если НЕ СтруктураНовогоСостояния.Состояние = Перечисления.смартСостоянияПартнеров.Свободен Тогда
			
			Если ЗначениеЗаполнено(Объект.ОсновнойМенеджер) И МассивПользователейРуководителя.Найти(Объект.ОсновнойМенеджер) = Неопределено Тогда
				Элементы.ОсновнойМенеджер.ТолькоПросмотр = Истина;	
			Иначе
				Элементы.ОсновнойМенеджер.ТолькоПросмотр = Ложь;
				Элементы.ОсновнойМенеджер.РежимВыбораИзСписка = Истина;
				Элементы.ОсновнойМенеджер.СписокВыбора.ЗагрузитьЗначения(МассивПользователейРуководителя);
			КонецЕсли;
		
		КонецЕсли;
		
		СтруктураНовогоСостояния = смартОбщегоНазначения.ПолучитьНовоеСостояниеПартнера(Объект.Ссылка, "РМ");
		
		Если НЕ СтруктураНовогоСостояния.Состояние = Перечисления.смартСостоянияПартнеров.Свободен Тогда
		
			Если ЗначениеЗаполнено(Объект.смартМенеджерПоРасходнымМатериалам) И МассивПользователейРуководителя.Найти(Объект.смартМенеджерПоРасходнымМатериалам) = Неопределено Тогда
				Элементы.смартМенеджерПоРасходнымМатериалам.ТолькоПросмотр = Истина;	
			Иначе
				Элементы.смартМенеджерПоРасходнымМатериалам.ТолькоПросмотр = Ложь;
				Элементы.смартМенеджерПоРасходнымМатериалам.РежимВыбораИзСписка = Истина;
				Элементы.смартМенеджерПоРасходнымМатериалам.СписокВыбора.ЗагрузитьЗначения(МассивПользователейРуководителя);
			КонецЕсли;
		
		КонецЕсли;
		
		СтруктураНовогоСостояния = смартОбщегоНазначения.ПолучитьНовоеСостояниеПартнера(Объект.Ссылка, "СЦ");
		
		Если НЕ СтруктураНовогоСостояния.Состояние = Перечисления.смартСостоянияПартнеров.Свободен Тогда
		
			Если ЗначениеЗаполнено(Объект.смартОсновнойМенеджерСервисЦентра) И МассивПользователейРуководителя.Найти(Объект.смартОсновнойМенеджерСервисЦентра) = Неопределено Тогда
				Элементы.смартОсновнойМенеджерСервисЦентра.ТолькоПросмотр = Истина;	
			Иначе
				Элементы.смартОсновнойМенеджерСервисЦентра.ТолькоПросмотр = Ложь;
				Элементы.смартОсновнойМенеджерСервисЦентра.РежимВыбораИзСписка = Истина;
				Элементы.смартОсновнойМенеджерСервисЦентра.СписокВыбора.ЗагрузитьЗначения(МассивПользователейРуководителя);
			КонецЕсли;
			
		КонецЕсли;	
	
	ИначеЕсли Пользователи.ЭтоПолноправныйПользователь() Тогда
		Элементы.ОсновнойМенеджер.ТолькоПросмотр = Ложь;
		Элементы.смартМенеджерПоРасходнымМатериалам.ТолькоПросмотр = Ложь;
		Элементы.смартОсновнойМенеджерСервисЦентра.ТолькоПросмотр = Ложь;
	КонецЕсли;
	//-- #Б-7140 смарт: Фролов 10.08.2026
	
КонецПроцедуры

&НаКлиенте
