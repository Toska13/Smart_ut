		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'В поле <b>Срок проверки</b> указывается дата, до которой не производится автоматическая проверка и снятие признака <b>Ключевой клиент по расходным материалам</b>.'")
			  + Символы.ПС
			  + Символы.ПС
		  + НСтр("ru = 'Срок проверки автоматически рассчитывается при установке признака <b>Ключевой клиент по расходным материалам</b> регламентным заданием'")
			);

	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;

КонецПроцедуры //--#1283 смарт: Лопато 23.12.2022

