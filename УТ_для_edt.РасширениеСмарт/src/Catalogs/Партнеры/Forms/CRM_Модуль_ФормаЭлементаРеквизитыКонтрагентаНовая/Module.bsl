//++ #1920 смарт: Фролов 17.07.2024 //Механизм закрепления Партнеров ответственными менеджерами.
Процедура смартУстановитьЗначенияЗакрепленияМенеджеров(ТипУслуги);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Менеджер КАК Менеджер,
	|	Период КАК Период
	|ИЗ
	|	РегистрСведений.смартИсторияЗакрепленияПартнеров.СрезПоследних(
	|			,
	|			ТипУслуги = &ТипУслуги
	|				И Партнер = &Партнер)");
	Запрос.УстановитьПараметр("ТипУслуги", ТипУслуги);
	Запрос.УстановитьПараметр("Партнер", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаТоварыУслуги Тогда
			
			ЭтаФорма.смартЗакрепленОтветственный = ЗначениеЗаполнено(Выборка.Менеджер);
			ЭтаФорма.смартЗакрепленОтветственныйДата = ?(ЗначениеЗаполнено(Выборка.Менеджер), Выборка.Период, "");
			Элементы.ОсновнойМенеджер.ТолькоПросмотр = ЭтаФорма.смартЗакрепленОтветственный;
			
		ИначеЕсли ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаРасходныеМатериалы Тогда

			ЭтаФорма.смартЗакрепленОтветственныйПоРасхМатериалам = ЗначениеЗаполнено(Выборка.Менеджер);
			ЭтаФорма.смартЗакрепленОтветственныйРМДата = ?(ЗначениеЗаполнено(Выборка.Менеджер), Выборка.Период, "");
			//++ #Б-7658 смарт: Фролов 03.08.2026 //Проверить какая роль запрещает менять ответственного РМ и СЦ
			//Элементы.смартМенеджерПоРасходнымМатериалам.ТолькоПросмотр = ЭтаФорма.смартЗакрепленОтветственныйПоРасхМатериалам;
			Элементы.смартМенеджерПоРасходнымМатериалам.ТолькоПросмотр = НЕ Пользователи.РолиДоступны("CRM_ПередачаДелОтветственному");
			//-- #Б-7658 смарт: Фролов 04.08.2026
			
		ИначеЕсли ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти Тогда

			ЭтаФорма.смартЗакрепленОтветственныйСервЦентра = ЗначениеЗаполнено(Выборка.Менеджер);
			ЭтаФорма.смартЗакрепленОтветственныйСЦДата = ?(ЗначениеЗаполнено(Выборка.Менеджер), Выборка.Период, "");
			//++ #Б-7658 смарт: Фролов 03.08.2026 //Проверить какая роль запрещает менять ответственного РМ и СЦ
			//Элементы.смартОсновнойМенеджерСервисЦентра.ТолькоПросмотр = ЭтаФорма.смартЗакрепленОтветственныйСервЦентра;
			Элементы.смартОсновнойМенеджерСервисЦентра.ТолькоПросмотр = НЕ Пользователи.РолиДоступны("CRM_ПередачаДелОтветственному");
			//-- #Б-7658 смарт: Фролов 04.08.2026
			
		КонецЕсли;	
		
	Иначе
		
		Если ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаТоварыУслуги Тогда
			
			ЭтаФорма.смартЗакрепленОтветственный = Ложь;
			ЭтаФорма.смартЗакрепленОтветственныйДата = "";
			
		ИначеЕсли ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаРасходныеМатериалы Тогда

			ЭтаФорма.смартЗакрепленОтветственныйПоРасхМатериалам = Ложь;
			ЭтаФорма.смартЗакрепленОтветственныйРМДата = "";
			
		ИначеЕсли ТипУслуги = Справочники.CRM_ТипУслуги.ПоставкаЗапасныеЧасти Тогда

			ЭтаФорма.смартЗакрепленОтветственныйСервЦентра = Ложь;
			ЭтаФорма.смартЗакрепленОтветственныйСЦДата = "";
			
		КонецЕсли;	
		
	КонецЕсли;	

КонецПроцедуры //-- #1920 смарт: Фролов 17.07.2024

