//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Процедура смартТаблицаDEERAYПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	смартОчиститьТабличныйДокументРасщифровкаРазговора();
	ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок = Неопределено;
	Элементы.смартПрослушатьРазговорDEERAY.Заголовок = "Прослушать разговор";
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		смартидентификаторDeeray = CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Элемент.ТекущиеДанные.смартЗвонкиDEERAYСсылка, "смартидентификаторDeeray");
			ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок = Элемент.ТекущиеДанные.смартЗвонкиDEERAYСсылка;
		
		смартВывестиДанныеРасшифровкиРазговора(смартидентификаторDeeray);
		
		ТекстРезюме = Элемент.ТекущиеДанные.смартРезюмеDEERAY;
		ТекстРезюме = СтрЗаменить(ТекстРезюме, """", "");
		ТекстРезюме = СтрЗаменить(ТекстРезюме, Символы.ПС, "<br>");
		ТекстРезюме = СтрЗаменить(ТекстРезюме, "¶", "<br>");
		
		смартРезюмеHTMLDEERAY = СтрЗаменить(СтрЗаменить(ЭтаФорма.смартРезюмеHTMLПредварительныйDEERAY, "ТекстРезюмеHTMLDEERAY", ТекстРезюме), "|", "");
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-6082 смарт: Фролов 16.03.2026

&НаКлиенте
//++ #Б-6082 смарт: Фролов 16.03.2026 //Добавить раздел DEERAY в партнеры.
Процедура смартТаблицаДанныеСценариевDEERAYПриАктивизацииПоля(Элемент)
	
	ИмяКолонки = Элемент.ТекущийЭлемент.Имя;
	ИдентификаторКолонки = СтрЗаменить(ИмяКолонки, "Звонок_", "");
	
	смартРезюмеHTMLDEERAY = СтрЗаменить(СтрЗаменить(ЭтаФорма.смартРезюмеHTMLПредварительныйDEERAY, "ТекстРезюмеHTMLDEERAY", ""), "|", "");
	смартОчиститьТабличныйДокументРасщифровкаРазговора();
	ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок = Неопределено;
	Элементы.смартПрослушатьРазговорDEERAY.Заголовок = "Прослушать разговор";
	
	Если НЕ ИмяКолонки = ИдентификаторКолонки Тогда
		
		СтрокисмартИдентификаторыЗвонковDEERAY = ЭтаФорма.смартИдентификаторыЗвонковDEERAY.НайтиСтроки(Новый Структура("смартСценарииDEERAYИдентификатор", ИдентификаторКолонки));
		
		Если СтрокисмартИдентификаторыЗвонковDEERAY.Количество() > 0 Тогда
			
			СтрокисмартДанныеСценариевDEERAYДляОбработки = ЭтаФорма.смартДанныеСценариевDEERAYДляОбработки.НайтиСтроки(Новый Структура("смартДанныеСценариевDEERAYДляОбработкиТелефонныйЗвонок", 
				СтрокисмартИдентификаторыЗвонковDEERAY[0].смартСценарииDEERAYЗвонок));
				
			ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок = СтрокисмартИдентификаторыЗвонковDEERAY[0].смартСценарииDEERAYЗвонок;
			
			смартидентификаторDeeray = CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(СтрокисмартИдентификаторыЗвонковDEERAY[0].смартСценарииDEERAYЗвонок, "смартидентификаторDeeray"); 
			
			смартВывестиДанныеРасшифровкиРазговора(смартидентификаторDeeray);
						
			Если СтрокисмартДанныеСценариевDEERAYДляОбработки.Количество() > 0 Тогда
				
				ТекстРезюме = СтрокисмартДанныеСценариевDEERAYДляОбработки[0].смартДанныеСценариевDEERAYДляОбработкиРезюме;
				ТекстРезюме = СтрЗаменить(ТекстРезюме, """", "");
				ТекстРезюме = СтрЗаменить(ТекстРезюме, Символы.ПС, "<br>");
				ТекстРезюме = СтрЗаменить(ТекстРезюме, "¶", "<br>");
				
				смартРезюмеHTMLDEERAY = СтрЗаменить(СтрЗаменить(ЭтаФорма.смартРезюмеHTMLПредварительныйDEERAY, "ТекстРезюмеHTMLDEERAY", ТекстРезюме), "|", "");
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры //-- #Б-6082 смарт: Фролов 16.03.2026

