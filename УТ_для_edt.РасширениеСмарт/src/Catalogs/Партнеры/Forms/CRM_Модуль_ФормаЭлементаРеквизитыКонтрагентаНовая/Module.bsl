//++ #Б-3552 смарт: Фролов 26.06.2025 //Заполнение раздела Доставка в заказе клиента на регулярной основе. 
Процедура смартПартнерСпособДоставкиПриИзменении(Элемент) 
	
	//++ #4286 смарт: Тимофеева 08.09.2025 / Форма справочника Партнеры. Доставка по умолчанию. Доработка.
	//Элементы.смартДоставкаАдмирал.Видимость = Объект.смартПартнерСпособДоставки 
	//	= ПредопределенноеЗначение("Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал");
	//Элементы.смартДоставка.Видимость = НЕ Объект.смартПартнерСпособДоставки 
	//	= ПредопределенноеЗначение("Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал");	
	
	ЭтоСамовывоз							= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз");
	ЭтоДоКлиента 							= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.ДоКлиента");
	ЭтоСиламиПеревозчикаПоАдресу 			= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.СиламиПеревозчикаПоАдресу");
	ЭтоСиламиПеревозчика 					= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.СиламиПеревозчика");
	ЭтоКПолучателюОпределяетСлужбаДоставки 	= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.КПолучателюОпределяетСлужбаДоставки");
	ЭтосмартСамовывозСоСкладаАдмирал		= Объект.смартПартнерСпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал");
	
	Элементы.смартПартнерАдресДоставки.Видимость     = НЕ ЭтосмартСамовывозСоСкладаАдмирал И НЕ ЭтоСамовывоз;
	Элементы.смартПартнерАдресДоставки.Заголовок	= ?(ЭтоСиламиПеревозчикаПоАдресу ИЛИ ЭтоСиламиПеревозчика, "Адрес доставки до клиента", "Адрес доставки");
	Элементы.смартПартнерАдресДоставки.ПоложениеЗаголовка = ?(ЭтоСиламиПеревозчикаПоАдресу ИЛИ ЭтоСиламиПеревозчика, ПоложениеЗаголовкаЭлементаФормы.Верх,
																ПоложениеЗаголовкаЭлементаФормы.Авто);

	Элементы.смартПартнерПеревозчикПартнер.Видимость = ЭтоСиламиПеревозчикаПоАдресу ИЛИ ЭтоСиламиПеревозчика; 
	
	Элементы.смартДоставка.Видимость	= ЭтоДоКлиента;
	Элементы.смартГруппаСиламиПеревозчикаПоАдресу.Видимость = ЭтоСиламиПеревозчикаПоАдресу;
	Элементы.смартГруппаСиламиПеревозчика.Видимость = ЭтоСиламиПеревозчика;
    Элементы.смартДоставкаАдмирал.Видимость = ЭтосмартСамовывозСоСкладаАдмирал;
	Элементы.смартГруппаДополнительныеРеквизитыДоставки.Видимость = НЕ ЭтосмартСамовывозСоСкладаАдмирал;
	
	//-- #4286 смарт: Тимофеева 08.09.2025

КонецПроцедуры //-- #Б-3552 смарт: Фролов 26.06.2025	

