//++ #Б-5258 смарт: Фролов 16.12.2025 //Создание механизма сегментации партнеров.
Процедура смартРедактироватьВидыДеятельности(Элемент) 
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Партнер", Объект.Ссылка); 
	
	МассивВидовДеятельности = Новый Массив;
	
	Для Каждого СтрВидыДеятельности Из Объект.смартВидыДеятельности Цикл
		
		//++ #Б-7322 смарт: Фролов 06.07.2026 //Справочник "Партнеры". Таблица "Виды деятельности". Добавить реквизиты.
		СтруктураВидаДеятельность = Новый Структура("ВидДеятельности, УстановленМенеджером, УстановленИИ, ОбоснованиеВыбораИИ",
			СтрВидыДеятельности.ВидДеятельности, СтрВидыДеятельности.УстановленМенеджером, СтрВидыДеятельности.УстановленИИ, СтрВидыДеятельности.ОбоснованиеВыбораИИ);
			
		МассивВидовДеятельности.Добавить(СтруктураВидаДеятельность);	
		//МассивВидовДеятельности.Добавить(СтрВидыДеятельности.ВидДеятельности);
		//-- #Б-7322 смарт: Фролов 06.07.2026
		
	КонецЦикла;
	
	МассивТипичноеОборудование = Новый Массив;
	МассивНаших = Новый Массив;
	
	Для Каждого СтрТипичноеОборудование Из Объект.смартТипичноеОборудование Цикл
		
		МассивТипичноеОборудование.Добавить(СтрТипичноеОборудование.ТипичноеОборудование);
		
		Если СтрТипичноеОборудование.КупленоВСМАРТ Тогда
			
			МассивНаших.Добавить(СтрТипичноеОборудование.ТипичноеОборудование);	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ПараметрыОткрытия.Вставить("МассивВидовДеятельности", МассивВидовДеятельности);
	ПараметрыОткрытия.Вставить("МассивТипичноеОборудование", МассивТипичноеОборудование);
	ПараметрыОткрытия.Вставить("МассивНаших", МассивНаших);
	
	//++ #6764 смарт: Тимофеева 15.05.2026 / Внести изменения в "Форму редактирования видов деятельности" в карточке партнера
	ВидДеятельностиДругое = ВидДеятельностиДругое();
	ВидДеятельностиДругоеРасшифровка = Новый Структура("ВидДеятельности, ДругоеРасшифровка", ВидДеятельностиДругое, "");
	НайденныеСтроки = Объект.смартВидыДеятельности.НайтиСтроки(Новый Структура("ВидДеятельности", ВидДеятельностиДругое));
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ВидДеятельностиДругоеРасшифровка, НайденныеСтроки[0]);
	КонецЕсли;
	
	ТипичноеОборудованиеДругое = ТипичноеОборудованиеДругое();
	ТипичноеОборудованиеДругоеРасшифровка = Новый Структура("ТипичноеОборудование, ДругоеРасшифровка", ТипичноеОборудованиеДругое, "");
	НайденныеСтроки = Объект.смартТипичноеОборудование.НайтиСтроки(Новый Структура("ТипичноеОборудование", ТипичноеОборудованиеДругое));
	Если НайденныеСтроки.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ТипичноеОборудованиеДругоеРасшифровка, НайденныеСтроки[0]);
	КонецЕсли;
	
	ПараметрыОткрытия.Вставить("ВидДеятельностиДругоеРасшифровка", ВидДеятельностиДругоеРасшифровка);
	ПараметрыОткрытия.Вставить("ТипичноеОборудованиеДругоеРасшифровка", ТипичноеОборудованиеДругоеРасшифровка);
	//-- #6764 смарт: Тимофеева 15.05.2026 
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("смартЗакрытаФормаРедактированияВидовДеятельности", ЭтаФорма);
	
	ОткрытьФорму("Справочник.Партнеры.Форма.смарт_ФормаРедактированияВидовДеятельности", ПараметрыОткрытия, ЭтаФорма, , , , 
		ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры //-- #Б-5258 смарт: Фролов 16.12.2025

