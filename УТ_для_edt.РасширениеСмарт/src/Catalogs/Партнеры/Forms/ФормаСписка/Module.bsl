//++ смарт:ММ #036 176 14.03.2020 - создание партнеров от дилеров
&НаКлиенте
Функция ПрочитатьФайл(ИмяФайла)
	
	СтруктураДанныеИзФайла = Новый Структура;
	СтруктураДанныеИзФайла.Вставить("Наименование", "");
	СтруктураДанныеИзФайла.Вставить("КонтактноеЛицоФИО", "");
	СтруктураДанныеИзФайла.Вставить("КонтактноеЛицоЭлПочта", "");
	СтруктураДанныеИзФайла.Вставить("КонтактноеЛицоТелефон", "");
	СтруктураДанныеИзФайла.Вставить("ИНН", "");
	СтруктураДанныеИзФайла.Вставить("КПП", "");
	СтруктураДанныеИзФайла.Вставить("ПартнерЭлПочта", "");
	СтруктураДанныеИзФайла.Вставить("БизнесРегион", "");
	
	Отказ = Ложь;
	АдресФайла = ПереместитьФайлНаСервер(ИмяФайла, Отказ);
	Если Отказ Тогда
		Возврат СтруктураДанныеИзФайла;
	КонецЕсли;
	
	ПрочитатьФайлНаСервере(АдресФайла, СтруктураДанныеИзФайла);
		
	Возврат СтруктураДанныеИзФайла;
		
КонецФункции //-- смарт:ММ 14.03.2020

//++ смарт:ММ #036 176 16.03.2020 - создание партнеров от дилеров
&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресФайла, СтруктураДанныеИзФайла)
	
	ТЗ = ЗагрузитьМетодом_1C836(АдресФайла);              // Считать весь файл.	
	Попытка
		
		Если ТЗ.Количество() >= 10 Тогда
			СтруктураДанныеИзФайла.Наименование = СокрЛП(ТЗ[2].Н2);
			СтруктураДанныеИзФайла.КонтактноеЛицоФИО = СокрЛП(ТЗ[3].Н2);
			СтруктураДанныеИзФайла.КонтактноеЛицоЭлПочта = СокрЛП(ТЗ[4].Н2);
			СтруктураДанныеИзФайла.КонтактноеЛицоТелефон = Формат(ТЗ[5].Н2, "ЧГ=");
			СтруктураДанныеИзФайла.ИНН = Формат(ТЗ[6].Н2, "ЧГ=");
			СтруктураДанныеИзФайла.КПП = Формат(ТЗ[7].Н2, "ЧГ=");
			СтруктураДанныеИзФайла.ПартнерЭлПочта = СокрЛП(ТЗ[8].Н2);
			СтруктураДанныеИзФайла.БизнесРегион = СокрЛП(ТЗ[9].Н2);
		КонецЕсли;
		
	Исключение

	КонецПопытки;
	
КонецПроцедуры //-- смарт:ММ 16.03.2020

