//++ смарт:ММ #036 176 14.03.2020 - создание партнеров от дилеров
&НаКлиенте
Процедура смартЗагрузитьПартнераИзФайлаНажатие(Команда)
	
	ПараметрыОбработчика = Неопределено;
	ФоновоеЗаданиеИдентификатор = Неопределено;
	
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытияФайла.Заголовок = "Выбор файла для загрузки";
	ДиалогОткрытияФайла.ПроверятьСуществованиеФайла = Ложь;
	ДиалогОткрытияФайла.Фильтр = "Табличный документ(*.xls; *.xlsx)|*.xls;*.xlsx";
	ДиалогОткрытияФайла.МножественныйВыбор = Ложь;
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";

	Если ДиалогОткрытияФайла.Выбрать() Тогда
		
		МассивФайлов = ДиалогОткрытияФайла.ВыбранныеФайлы;
		
		Для Каждого ИмяФайла Из МассивФайлов Цикл
			
			// Переменные, которые понядобятся, если необходимо будет открыть форму помощника
			
			УказыватьЮридическиеРеквизиты = Ложь;
			УказатьДанныеКонтактногоЛица = Истина;
			ИспользуютсяТолькоПартнеры = Ложь;
			ВидКомпании = 0;
			ЭтоКомпания = 0;
			КПП = "";
						
			ДанныеИзФайла = ПрочитатьФайл(ИмяФайла);
			
			ДанныеДляЗаполнения = Новый Структура;
			ДанныеДляЗаполнения.Вставить("ДанныеИзФайла", ДанныеИзФайла);
			БизнесРегион = "";
			Если ЗначениеЗаполнено(ДанныеИзФайла.БизнесРегион) Тогда
				БизнесРегион = НайтиБизнесРегион(ДанныеИзФайла.БизнесРегион);
			КонецЕсли;
			
			ДанныеДляЗаполнения.Вставить("БизнесРегион", БизнесРегион);
			ДанныеДляЗаполнения.Вставить("Клиент", Истина);
			ДанныеДляЗаполнения.Вставить("ПолноеНаименование", ДанныеИзФайла.Наименование);
			ДанныеДляЗаполнения.Вставить("ПолноеЮридическоеНаименование", ДанныеИзФайла.Наименование);
			ДанныеДляЗаполнения.Вставить("АдресЭППартнера", ДанныеИзФайла.ПартнерЭлПочта);
			ДанныеДляЗаполнения.Вставить("ТелефонПартнера", "");
			ДанныеДляЗаполнения.Вставить("ТелефонПартнераЗначенияПолей", "");
			ДанныеДляЗаполнения.Вставить("Название", ДанныеИзФайла.Наименование);
			ДанныеДляЗаполнения.Вставить("ГруппаДоступа", "");
			ДанныеДляЗаполнения.Вставить("ФактическийАдрес", "");
			ДанныеДляЗаполнения.Вставить("ФактическийАдресЗначенияПолей", "");
			ДанныеДляЗаполнения.Вставить("ЮридическийАдрес", "");
			ДанныеДляЗаполнения.Вставить("ЮридическийАдресЗначенияПолей", "");
			ДанныеДляЗаполнения.Вставить("КодПоОКПО", "");
			ДанныеДляЗаполнения.Вставить("РегистрационныйНомер", "");
			ДанныеДляЗаполнения.Вставить("СтранаРегистрации", "");
			ДанныеДляЗаполнения.Вставить("НалоговыйНомер", "");
			ДанныеДляЗаполнения.Вставить("ИННПартнерФизЛицо", "");
			ДанныеДляЗаполнения.Вставить("ВидДокумента", "");
			ДанныеДляЗаполнения.Вставить("СерияДокумента", "");
			ДанныеДляЗаполнения.Вставить("НомерДокумента", "");
			ДанныеДляЗаполнения.Вставить("ИспользуютсяТолькоПартнеры", ИспользуютсяТолькоПартнеры);
			ДанныеДляЗаполнения.Вставить("ТелефонКонтрагента", "");
			ДанныеДляЗаполнения.Вставить("ТелефонКонтрагентаЗначенияПолей", "");
			ДанныеДляЗаполнения.Вставить("ИННИсточникДанныхЗаполнения", "");
			ДанныеДляЗаполнения.Вставить("НаименованиеКонтрагента", ДанныеИзФайла.Наименование);
			ДанныеДляЗаполнения.Вставить("КПП", "");
			ДанныеДляЗаполнения.Вставить("ИНН", ДанныеИзФайла.ИНН);
			ДанныеДляЗаполнения.Вставить("УказатьДанныеКонтактногоЛица", УказатьДанныеКонтактногоЛица);
			ДанныеДляЗаполнения.Вставить("УказыватьЮридическиеРеквизиты", УказыватьЮридическиеРеквизиты);
			ДанныеДляЗаполнения.Вставить("ИмяПартнера", "");
			ДанныеДляЗаполнения.Вставить("ФамилияПартнера", "");
			ДанныеДляЗаполнения.Вставить("ОтчествоПартнера", "");
			ДанныеДляЗаполнения.Вставить("КодОКВЭД", "");
			ДанныеДляЗаполнения.Вставить("ПолПартнера", "");
			ДанныеДляЗаполнения.Вставить("РегистрацияВНалоговомОргане", "");
			ДанныеДляЗаполнения.Вставить("РегистрацияВПенсионномФонде", "");
			ДанныеДляЗаполнения.Вставить("ТелефонКЛ", ДанныеИзФайла.КонтактноеЛицоТелефон);
		
			Если ЗначениеЗаполнено(ДанныеИзФайла.ИНН) Тогда				
				ИНН = ДанныеИзФайла.ИНН;
				Если СтрДлина(ИНН) = 12 Тогда
					ВидКомпании = 2;
					ЭтоКомпания = 0;
				КонецЕсли;
				УказыватьЮридическиеРеквизиты = Истина;
				ДанныеДляЗаполнения.Вставить("УказыватьЮридическиеРеквизиты", УказыватьЮридическиеРеквизиты);
				ДанныеДляЗаполнения.Вставить("ИНН", ИНН);
				ДанныеДляЗаполнения.Вставить("ЭтоКомпания", ЭтоКомпания);
				ДанныеДляЗаполнения.Вставить("ВидКомпании", ВидКомпании);
				
				ЮрФизЛицо = смартПроверкаПартнеров.ТипЮрФизЛицаКонтрагента(ЭтоКомпания, ВидКомпании);
				
				Если ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда					
					ЭтоКомпания = 1;
				ИначеЕсли ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель") Тогда					
					ЭтоКомпания = 0;
					ВидКомпании = 2;
				ИначеЕсли ЮрФизЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент") Тогда					
					ЭтоКомпания = 0;
					ВидКомпании = 1;
				Иначе				
					ЭтоКомпания = 0;
					//ВидКомпании = ?(ОбособленноеПодразделение, 3, 0);
					ВидКомпании = 0;
				КонецЕсли;

		
				ЭтоЮридическоеЛицо = ОбщегоНазначенияУТКлиентСервер.ЭтоЮрЛицо(ЮрФизЛицо);
				
				РеквизитыПоИННСервер(ЭтоЮридическоеЛицо, ИНН);

				РезультатФормирования = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресДанныеДляЗаполнения);
				
				Если ТипЗнч(РезультатФормирования) = Тип("Структура") Тогда
					Если ЗначениеЗаполнено(РезультатФормирования.ОписаниеОшибки) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатФормирования.ОписаниеОшибки + Символы.ПС + "Попробуйте повторно");
						
					Иначе
						ВыполнитьЗаполнениеРеквизитовПоИНН(РезультатФормирования, ДанныеДляЗаполнения);
					КонецЕсли;
				КонецЕсли;
				
				ПродолжитьЗаполнение(ДанныеДляЗаполнения, РезультатФормирования);
				
			КонецЕсли;
									
		КонецЦикла;
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Файл не выбран!'; en = 'File is not selected!'"));
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 14.03.2020

//++ смарт:ММ #036 217 24.03.2020
&НаСервереБезКонтекста
Функция НайтиБизнесРегион(БизнесРегион)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	БизнесРегионы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	БизнесРегионы.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", СокрЛП(БизнесРегион));
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции //-- смарт:ММ 24.03.2020

//++ смарт:ММ #036 217 23.03.2020 - создание партнеров от дилеров
&НаСервере
Процедура РеквизитыПоИННСервер(ЭтоЮридическоеЛицо, ИНН)
	
	Если ЭтоЮридическоеЛицо Тогда
		мРезультатФормирования = РаботаСКонтрагентами.РеквизитыЮридическогоЛицаПоИНН(ИНН);
	Иначе
		мРезультатФормирования = РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(ИНН);
	КонецЕсли;

	ПартнерыИКонтрагентыВызовСервера.ИсторияРеквизитовВСтруктуру(мРезультатФормирования);
	
	ЭтаФорма.АдресДанныеДляЗаполнения = ПоместитьВоВременноеХранилище(мРезультатФормирования);
	
КонецПроцедуры //-- смарт:ММ 23.03.2020

//++ смарт:ММ #036 217 23.03.2020 - создание партнеров от дилеров
&НаКлиенте
Процедура ПродолжитьЗаполнение(ДанныеДляЗаполнения, РезультатФормирования)
	
	ДанныеИзФайла = ДанныеДляЗаполнения.ДанныеИзФайла;
	
	Если ЗначениеЗаполнено(ДанныеИзФайла.КПП) И НЕ ЗначениеЗаполнено(ДанныеДляЗаполнения.КПП) Тогда
		ДанныеДляЗаполнения.Вставить("УказыватьЮридическиеРеквизиты", Истина);
		ДанныеДляЗаполнения.Вставить("КПП", ДанныеИзФайла.КПП);
	КонецЕсли;
	
	
	ВсеПоляЗаполнены = Истина;
	СтруктураНезаполненныеРеквизиты = Новый Структура;
	
	ФИОКЛМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ДанныеИзФайла.КонтактноеЛицоФИО);
	ФамилияКЛ 	= "";
	ИмяКЛ 		= ДанныеИзФайла.КонтактноеЛицоФИО;
	ОтчествоКЛ 	= "";
	Если ФИОКЛМассив.Количество() > 2 Тогда
		ФамилияКЛ = ФИОКЛМассив[0];
		ИмяКЛ = ФИОКЛМассив[1];
		ОтчествоКЛ = ФИОКЛМассив[2];
	ИначеЕсли ФИОКЛМассив.Количество() > 1 Тогда
		ФамилияКЛ = ФИОКЛМассив[0];
		ИмяКЛ = ФИОКЛМассив[1];
	КонецЕсли;		
	
	ДанныеДляЗаполнения.Вставить("ФамилияКЛ", ФамилияКЛ);
	ДанныеДляЗаполнения.Вставить("ИмяКЛ", ИмяКЛ);
	ДанныеДляЗаполнения.Вставить("ОтчествоКЛ", ОтчествоКЛ);
	
	ДанныеДляЗаполнения.Вставить("АдресЭПКЛ", ДанныеИзФайла.КонтактноеЛицоЭлПочта);
	ДанныеДляЗаполнения.Вставить("МобильныйТелефонКЛ", "");
	
	ДанныеДляЗаполнения.Вставить("АдресЭППартнераФизЛицо", "");
	ДанныеДляЗаполнения.Вставить("ТелефонПартнераФизЛицо", "");
	
	
	ДанныеДляЗаполнения.Вставить("ТелефонПартнераЗначенияПолей", смартПроверкаПартнеров.ПолучитьЗначенияПолейТелефон(ДанныеДляЗаполнения.ТелефонПартнера));
	ДанныеДляЗаполнения.Вставить("ТелефонКЛЗначенияПолей", смартПроверкаПартнеров.ПолучитьЗначенияПолейТелефон(ДанныеДляЗаполнения.ТелефонКЛ));
	ДанныеДляЗаполнения.Вставить("МобильныйТелефонКЛЗначенияПолей", смартПроверкаПартнеров.ПолучитьЗначенияПолейТелефон(ДанныеДляЗаполнения.МобильныйТелефонКЛ));
	ДанныеДляЗаполнения.Вставить("ТелефонПартнераФизЛицоЗначенияПолей", смартПроверкаПартнеров.ПолучитьЗначенияПолейТелефон(ДанныеДляЗаполнения.ТелефонПартнераФизЛицо));
		
	ОбязательныеПоляКонтактнойИнформации = смартПроверкаПартнеров.ОпределитьОбязательностьКонтактнойИнформации();
	
	смартОбщегоНазначенияКлиент.ПроверкаПервичнойИнформацииПартнер(ДанныеДляЗаполнения, СтруктураНезаполненныеРеквизиты, ВсеПоляЗаполнены, ОбязательныеПоляКонтактнойИнформации);
	
	Если НЕ ВсеПоляЗаполнены Тогда	
		
		смартОбщегоНазначенияКлиент.ОткрытьФормуПомощникаСозданияПартнера(ДанныеДляЗаполнения, ЭтаФорма, "СтраницаПервичнаяИнформация");
		
		Для Каждого Элемент Из СтруктураНезаполненныеРеквизиты Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Элемент.Значение);
		КонецЦикла;
	Иначе
		
		ЕстьСовпадения = Ложь;
		СтруктураАдреса = ВыполнитьПоискПоПервичнойИнформацииСервер(ДанныеДляЗаполнения, ЕстьСовпадения);
		Если ЕстьСовпадения Тогда
			смартОбщегоНазначенияКлиент.ОткрытьФормуПомощникаСозданияПартнера(ДанныеДляЗаполнения, ЭтаФорма, "СтраницаНайдено", СтруктураАдреса);
		Иначе
			СозданныйПартнер = Неопределено;
			СозданныйКонтрагент = Неопределено;
			ЗаписатьПартнераИСвязанныеДанные(ДанныеДляЗаполнения, СозданныйПартнер, СозданныйКонтрагент, РезультатФормирования);
			Если ЗначениеЗаполнено(СозданныйПартнер) Тогда
				ПоказатьЗначение(, СозданныйПартнер);
				Элементы.Список.ТекущаяСтрока = СозданныйПартнер;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 23.03.2020

//++ смарт:ММ #036 176 17.03.2020 - создание партнеров от дилеров
Процедура ВыполнитьЗаполнениеРеквизитовПоИНН(РеквизитыКонтрагента, ДанныеДляЗаполнения)
	
	ИспользуютсяТолькоПартнеры = ДанныеДляЗаполнения.ИспользуютсяТолькоПартнеры;
	ИНН = ДанныеДляЗаполнения.ИНН;
	
	ДанныеДляЗаполнения.Вставить("ПолноеНаименование", РеквизитыКонтрагента.Наименование);
	Если РеквизитыКонтрагента.Свойство("КПП") Тогда
		КПП = РеквизитыКонтрагента.КПП;
		ДанныеДляЗаполнения.Вставить("КПП", КПП);
	КонецЕсли;
	ПолноеЮридическоеНаименование = РеквизитыКонтрагента.НаименованиеСокращенное;
	ДанныеДляЗаполнения.Вставить("ПолноеЮридическоеНаименование", ПолноеЮридическоеНаименование);
	ДанныеДляЗаполнения.Вставить("НаименованиеКонтрагента", ПолноеЮридическоеНаименование);
	
	Если РеквизитыКонтрагента.Свойство("Телефон") И РеквизитыКонтрагента.Телефон <> Неопределено Тогда
		ТелефонПартнера              = РеквизитыКонтрагента.Телефон.Представление;
		ТелефонПартнераЗначенияПолей = РеквизитыКонтрагента.Телефон.КонтактнаяИнформация;
		ДанныеДляЗаполнения.Вставить("ТелефонПартнера", ТелефонПартнера);
		ДанныеДляЗаполнения.Вставить("ТелефонПартнераЗначенияПолей", ТелефонПартнераЗначенияПолей);
		Если Не ИспользуютсяТолькоПартнеры Тогда
			ТелефонКонтрагента              = ТелефонПартнера;
			ТелефонКонтрагентаЗначенияПолей = ТелефонПартнераЗначенияПолей;
			ИННИсточникДанныхЗаполнения     = ИНН;
			ДанныеДляЗаполнения.Вставить("ТелефонКонтрагента", ТелефонКонтрагента);
			ДанныеДляЗаполнения.Вставить("ТелефонКонтрагентаЗначенияПолей", ТелефонКонтрагентаЗначенияПолей);
			ДанныеДляЗаполнения.Вставить("ИННИсточникДанныхЗаполнения", ИННИсточникДанныхЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("ЮридическийАдрес") И РеквизитыКонтрагента.ЮридическийАдрес <> Неопределено Тогда
		ЮридическийАдрес              = РеквизитыКонтрагента.ЮридическийАдрес.Представление;
		ЮридическийАдресЗначенияПолей = РеквизитыКонтрагента.ЮридическийАдрес.КонтактнаяИнформация;
		//ПартнерыИКонтрагентыКлиент.ЗаполнитьИсториюАдресовВФорме(ЭтотОбъект, РеквизитыКонтрагента);
		ДанныеДляЗаполнения.Вставить("ЮридическийАдрес", ЮридическийАдрес);
		ДанныеДляЗаполнения.Вставить("ЮридическийАдресЗначенияПолей", ЮридическийАдресЗначенияПолей);
		
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("Фамилия") И РеквизитыКонтрагента.Фамилия <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("ФамилияПартнера", РеквизитыКонтрагента.Фамилия);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("Имя") И РеквизитыКонтрагента.Имя <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("ИмяПартнера", РеквизитыКонтрагента.Имя);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("Отчество") И РеквизитыКонтрагента.Отчество <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("ОтчествоПартнера", РеквизитыКонтрагента.Отчество);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("КодОКВЭД") И РеквизитыКонтрагента.КодОКВЭД <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("КодОКВЭД", РеквизитыКонтрагента.КодОКВЭД);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("Пол") И РеквизитыКонтрагента.Пол <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("ПолПартнера", РеквизитыКонтрагента.Пол);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("РегистрационныйНомер") И РеквизитыКонтрагента.РегистрационныйНомер <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("РегистрационныйНомер", РеквизитыКонтрагента.РегистрационныйНомер);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("РегистрацияВНалоговомОргане") И РеквизитыКонтрагента.РегистрацияВНалоговомОргане <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("РегистрацияВНалоговомОргане", РеквизитыКонтрагента.РегистрацияВНалоговомОргане);
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("РегистрацияВПенсионномФонде") И РеквизитыКонтрагента.РегистрацияВПенсионномФонде <> Неопределено Тогда		
		ДанныеДляЗаполнения.Вставить("РегистрацияВПенсионномФонде", РеквизитыКонтрагента.РегистрацияВПенсионномФонде);
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 17.03.2020

//++ смарт:ММ #036 176 17.03.2020 - создание партнеров от дилеров
&НаСервере
Функция ВыполнитьПоискПоПервичнойИнформацииСервер(ДанныеДляЗаполнения, ЕстьСовпадения)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("АдресТаблицаНайдено", "");
	СтруктураВозврата.Вставить("АдресДеревоДанных", "");

	ЕстьСовпадения = Ложь;
	
	ТаблицаНайдено = Новый ТаблицаЗначений;
	ТаблицаНайдено.Колонки.Добавить("Партнер", Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТаблицаНайдено.Колонки.Добавить("КоличествоНайденныхАналогов", Новый ОписаниеТипов("Число"));
	ТаблицаНайдено.Колонки.Добавить("ПредставлениеПартнер", Новый ОписаниеТипов("Строка"));
	ТаблицаНайдено.Колонки.Добавить("ОсновнойМенеджер", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаНайдено.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаНайдено.Колонки.Добавить("ИдентификаторДереваДанных", Новый ОписаниеТипов("Число"));
	ТаблицаНайдено.Колонки.Добавить("ДубльИННКПП", Новый ОписаниеТипов("Булево"));
	ТаблицаНайдено.Колонки.Добавить("Различие", Новый ОписаниеТипов("Булево"));

	ДеревоЗначений = смартПроверкаПартнеров.ВыполнитьПоискПоПервичнойИнформации(ДанныеДляЗаполнения,,, ТаблицаНайдено);
	
	Если ТаблицаНайдено.Количество() > 0 Тогда	
		АдресТаблицаНайдено = ПоместитьВоВременноеХранилище(ТаблицаНайдено);
		АдресДеревоДанных = ПоместитьВоВременноеХранилище(ДеревоЗначений);
		
		СтруктураВозврата.Вставить("АдресТаблицаНайдено", АдресТаблицаНайдено);
		СтруктураВозврата.Вставить("АдресДеревоДанных", АдресДеревоДанных);

		ЕстьСовпадения = Истина;
	КонецЕсли;	
		
	Возврат СтруктураВозврата;
	
КонецФункции //-- смарт:ММ 17.03.2020
			
//++ смарт:ММ #036 176 15.03.2020 - создание партнеров от дилеров
Процедура ЗаписатьПартнераИСвязанныеДанные(ДанныеДляЗаполнения, СозданныйПартнер, СозданныйКонтрагент, РезультатФормирования)
	
	НачатьТранзакцию();
	
	Название 						= ДанныеДляЗаполнения.Название;
	Клиент 							= ДанныеДляЗаполнения.Клиент;
	ФактическийАдрес 				= ДанныеДляЗаполнения.ФактическийАдрес;
	ФактическийАдресЗначенияПолей 	= ДанныеДляЗаполнения.ФактическийАдресЗначенияПолей;
	ЮридическийАдрес 				= ДанныеДляЗаполнения.ЮридическийАдрес;
	ЮридическийАдресЗначенияПолей 	= ДанныеДляЗаполнения.ЮридическийАдресЗначенияПолей;

	ЭтоКомпания 					= ДанныеДляЗаполнения.ЭтоКомпания;
	ВидКомпании                    	= ДанныеДляЗаполнения.ВидКомпании;
	ФамилияКЛ 						= ДанныеДляЗаполнения.ФамилияКЛ;
	ИмяКЛ 							= ДанныеДляЗаполнения.ИмяКЛ;
	ОтчествоКЛ 						= ДанныеДляЗаполнения.ОтчествоКЛ;
	АдресЭПКЛ 						= ДанныеДляЗаполнения.АдресЭПКЛ;
	ТелефонКЛЗначенияПолей 			= ДанныеДляЗаполнения.ТелефонКЛЗначенияПолей;
	ТелефонКЛ 						= ДанныеДляЗаполнения.ТелефонКЛ;
	МобильныйТелефонКЛЗначенияПолей = ДанныеДляЗаполнения.МобильныйТелефонКЛЗначенияПолей;
	МобильныйТелефонКЛ 				= ДанныеДляЗаполнения.МобильныйТелефонКЛ;
	ИспользуютсяТолькоПартнеры 		= ДанныеДляЗаполнения.ИспользуютсяТолькоПартнеры;
	ИННПартнерФизЛицо 				= ДанныеДляЗаполнения.ИННПартнерФизЛицо;
	ИНН 							= ДанныеДляЗаполнения.ИНН;
	КПП 							= ДанныеДляЗаполнения.КПП;
	КодПоОКПО 						= ДанныеДляЗаполнения.КодПоОКПО;
	СтранаРегистрации 				= ДанныеДляЗаполнения.СтранаРегистрации;
	РегистрационныйНомер			= ДанныеДляЗаполнения.РегистрационныйНомер;
	НалоговыйНомер 					= ДанныеДляЗаполнения.НалоговыйНомер;
	ТелефонКонтрагентаЗначенияПолей = ДанныеДляЗаполнения.ТелефонКонтрагентаЗначенияПолей;
	ТелефонКонтрагента 				= ДанныеДляЗаполнения.ТелефонКонтрагента;
	ТелефонПартнераФизЛицоЗначенияПолей = ДанныеДляЗаполнения.ТелефонПартнераФизЛицоЗначенияПолей;
	ТелефонПартнераФизЛицо 			= ДанныеДляЗаполнения.ТелефонПартнераФизЛицо;
	УказатьДанныеКонтактногоЛица 	= ДанныеДляЗаполнения.УказатьДанныеКонтактногоЛица;
	УказыватьЮридическиеРеквизиты 	= ДанныеДляЗаполнения.УказыватьЮридическиеРеквизиты;
	ТелефонПартнера 				= ДанныеДляЗаполнения.ТелефонПартнера;
	ПолноеЮридическоеНаименование 	= ДанныеДляЗаполнения.ПолноеЮридическоеНаименование;
	ФамилияПартнера 				= ДанныеДляЗаполнения.ФамилияПартнера;
	ИмяПартнера 					= ДанныеДляЗаполнения.ИмяПартнера;
	ОтчествоПартнера 				= ДанныеДляЗаполнения.ОтчествоПартнера;
	ИННИсточникДанныхЗаполнения 	= ДанныеДляЗаполнения.ИННИсточникДанныхЗаполнения;
	БизнесРегион 					= ДанныеДляЗаполнения.БизнесРегион;
	//Если ДействиеПоРезультатамНайдено <> 0 Тогда
	//	
		//Партнер
		ОбъектПартнер = Справочники.Партнеры.СоздатьЭлемент();
		ОбъектПартнер.Наименование                          = Название;
	//	ОбъектПартнер.Родитель                              = Родитель;
		ОбъектПартнер.БизнесРегион                          = БизнесРегион;
	//	ОбъектПартнер.ГруппаДоступа                         = ГруппаДоступа;
		ОбъектПартнер.ДатаРегистрации                       = ТекущаяДатаСеанса();
		ОбъектПартнер.Клиент                                = Клиент;
	//	ОбъектПартнер.Конкурент                             = Конкурент;
	//	ОбъектПартнер.Поставщик                             = Поставщик;
	//	ОбъектПартнер.ОбслуживаетсяТорговымиПредставителями = ОбслуживаетсяТорговымиПредставителями;
	//	ОбъектПартнер.ПрочиеОтношения                       = ПрочиеОтношения;
		ОбъектПартнер.ОсновнойМенеджер                      = ПараметрыСеанса.ТекущийПользователь;
		ОбъектПартнер.НаименованиеПолное                    = смартПроверкаПартнеров.НаименованиеПартнера(ДанныеДляЗаполнения);
		ОбъектПартнер.ЮрФизЛицо                             = смартПроверкаПартнеров.ТипЮрФизЛицаПартнера(ДанныеДляЗаполнения.ЭтоКомпания);
	//	ОбъектПартнер.Пол                                   = Пол;
	//	ОбъектПартнер.ДатаРождения                          = ДатаРождения;
	//	ОбъектПартнер.Перевозчик                            = Перевозчик;
	//	ОбъектПартнер.ВариантОтправкиЭлектронногоЧека       = ВариантОтправкиЭлектронногоЧека;
	//	
		// контактная информация партнера
		Если НЕ ПустаяСтрока(ФактическийАдрес) Тогда
			НоваяСтрокаКИ = ОбъектПартнер.КонтактнаяИнформация.Добавить();
