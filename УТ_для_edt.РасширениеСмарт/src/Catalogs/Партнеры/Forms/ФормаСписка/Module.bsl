//++ смарт:ММ #021 195 15.02.2020 - доработка справочника Проекты
&НаСервере
Процедура ДобавитьИзменитьЭлементыФормы()
	
	// Добавление команды открытия формы списка Проектов
	
	ИмяКоманды = "смартОткрытьПроекты";
	КомандаФормы = ЭтаФорма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие = "смартОткрытьПроектыНажатие";
	КомандаФормы.Заголовок = "Проекты";
	КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
	
	НовыйЭлемент = ЭтаФорма.Элементы.Вставить("смартОткрытьПроекты", Тип("КнопкаФормы"), Элементы.ГруппаСписок, Элементы.СтраницыКонтекстныеОтчеты);
	НовыйЭлемент.Вид = ВидКнопкиФормы.Гиперссылка;
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	
	//++ смарт:ММ #036 176 14.03.2020 - создание партнеров от дилеров
	
	// Команда загрузки данных по партнеру из файла
	
	ИмяКоманды = "смартЗагрузитьПартнераИзФайла";
	КомандаФормы = ЭтаФорма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие 	= "смартЗагрузитьПартнераИзФайлаНажатие";
	КомандаФормы.Заголовок 	= "Загрузить из файла";
	КомандаФормы.Подсказка 	= "Загрузить из Excel от дилера";
	
	НовыйЭлемент = Элементы.Вставить("смартЗагрузитьПартнераИзФайла", Тип("КнопкаФормы"), Элементы.СписокГруппаКомандыФормы, Элементы.ФормаНайти);
	НовыйЭлемент.Вид 			= ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды 	= ИмяКоманды;
	НовыйЭлемент.Картинка 		= БиблиотекаКартинок.ЗагрузкаИзВнешнегоИсточника;
	НовыйЭлемент.Отображение 	= ОтображениеКнопки.Картинка;
	
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ФоновоеЗаданиеИдентификатор", Новый ОписаниеТипов()));
	Реквизиты.Добавить(Новый РеквизитФормы("ФоновоеЗаданиеАдресХранилища", Новый ОписаниеТипов("Строка")));
	Реквизиты.Добавить(Новый РеквизитФормы("АдресДанныеДляЗаполнения", Новый ОписаниеТипов("Строка")));
	ИзменитьРеквизиты(Реквизиты);
	
	// Команда отправки файла-шаблона клиенту
	
	ИмяКоманды = "смартОтправитьШаблонДилеру";
	КомандаФормы = ЭтаФорма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие 	= "смартОтправитьШаблонДилеруНажатие";
	КомандаФормы.Заголовок 	= "Отправить шаблон дилеру для передачи партнера";
	КомандаФормы.Подсказка 	= "Отправить шаблон дилеру для передачи партнера";
	
	НовыйЭлемент = Элементы.Вставить("смартОтправитьШаблонДилеру", Тип("КнопкаФормы"), Элементы.ФормаВзаимодействия);//, Элементы.ФормаЖурналДокументовВзаимодействияНаписатьЭлектронноеПисьмоПоКонтакту);
	НовыйЭлемент.Вид 			= ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды 	= ИмяКоманды;
	НовыйЭлемент.Картинка 		= БиблиотекаКартинок.ОтправитьЭлектронноеПисьмо;
	НовыйЭлемент.Отображение 	= ОтображениеКнопки.КартинкаИТекст;
	
	//-- смарт:ММ 14.03.2020
	
КонецПроцедуры //-- смарт:ММ 15.02.2020

