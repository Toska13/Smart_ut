&НаКлиенте
Функция ПереместитьФайлНаСервер(ИмяФайлаДанных, Отказ)

	АдресФайлаВоВременномХранилище = "";
	
	Отказ = Ложь;
	Попытка
		Уникальный_Идентификатор = Новый УникальныйИдентификатор;
		ДвоичДанные = Новый ДвоичныеДанные(ИмяФайлаДанных);
		АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичДанные, Уникальный_Идентификатор); 
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось открыть файл. Проверьте, что он не занят в приложении Excel.'"),,,,Отказ);
		Отказ = Истина;
	КонецПопытки;
	
	Возврат АдресФайлаВоВременномХранилище;
	
