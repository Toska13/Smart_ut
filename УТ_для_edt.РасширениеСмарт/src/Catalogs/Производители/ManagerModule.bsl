#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//++ #1596 смарт: Мосолов 17.01.2024 //Доработка гарантийного блока / автозаполнение полей документ Заявка на гарантийный ремонт  
// Возвращает префикс, определенный по производителю и партнеру
//
// Параметры:
//	Производитель - СправочникСсылка.Производители
//	Партнер - СправочникСсылка.Партнеры
//
// Возвращаемое значение:
//	Строка - префикс по производителю и партнеру, если определен, в противном случае префикс производителя
//
Функция смартПолучитьПрефиксПроизводителя(Производитель, Партнер) Экспорт

	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Производитель", Производитель);
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроизводителисмартПоставщики.Префикс КАК Префикс
	|ИЗ
	|	Справочник.Производители.смартПоставщики КАК ПроизводителисмартПоставщики
	|ГДЕ
	|	ПроизводителисмартПоставщики.Ссылка = &Производитель
	|	И ПроизводителисмартПоставщики.Поставщик = &Партнер";
	
	Выборка = запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		Возврат Выборка.Префикс;
	Иначе
		Возврат Производитель.смартПрефиксПроизводителя;
	КонецЕсли;
	
КонецФункции 	//-- #1596 смарт: Мосолов 17.01.2024   

#КонецЕсли
