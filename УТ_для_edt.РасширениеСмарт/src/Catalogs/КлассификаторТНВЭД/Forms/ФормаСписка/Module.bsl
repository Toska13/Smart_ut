// ОБРАБОТЧИКИ КОМАНД

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьПовышенныйТаможенныйСбор(Команда)
	МассивКодов = ПолучитьМассивКодов(); 
	ЗагрузитьПовышенныйТаможенныйСборНаСервере(МассивКодов);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьБазовуюСтавку(Команда)
	КодыТНВЭД = ПолучитьКодыТНВЭД();
	Для Каждого СтруктураКода Из КодыТНВЭД Цикл
		БазоваяСтавка = ПолучитьБазовуюСтавку(СтруктураКода.Код);
		Если НЕ БазоваяСтавка = СтруктураКода.БазоваяСтавка Тогда
			УстановитьРеквизит(СтруктураКода.Ссылка, "смартБазоваяСтавка", БазоваяСтавка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры  

#КонецОбласти

