
#Область ПеренесеноСДоработками

//++ смарт:ММ #060 319 03.08.2020 - доработка спр. Конрагенты
&После("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ)
	
	//++ смарт:ММ #081 396 08.11.2020 - Проверка при записи спр. Контрагенты
	Если Не ЭтотОбъект.смартНеОбновлятьКППВноситБухгалтерия Тогда
		смартПроверитьИННЮрЛица(Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//-- смарт:ММ 08.11.2020

	Если Ссылка.смартСтатусКонтактныхДанныхКонтрагента <> смартСтатусКонтактныхДанныхКонтрагента Тогда
		Если смартСтатусКонтактныхДанныхКонтрагента = Перечисления.смартСтатусыКонтактныхДанныхКонтрагентов.ОтсутствуютИлиНеактуальны
			ИЛИ смартСтатусКонтактныхДанныхКонтрагента = Перечисления.смартСтатусыКонтактныхДанныхКонтрагентов.НеУдалосьСвязатьсяСКонтрагентом
			Тогда
			
			ДополнительныеСвойства.Вставить("смартОтпарвлятьУведомлениеОСтатусеКонтактныхДанных", Истина);
			
		КонецЕсли;
	КонецЕсли;
	
	//++ #4802 смарт: Тимофеева 09.12.2025 / Не фиксируются изменения в юридическом адресе Контрагента при заполнении данных по кнопке, по данным ЕГРЮЛ.
	//ИСКЛЮЧЕНИЯ для контрагента с ИНН 9109004874: нет адреса "298033, Республика Крым, г Судак, с Морское, ул Калинина, дом 67"
	Если ЭтотОбъект.ИНН	= "9109004874" Тогда
		Отбор = Новый Структура("Вид, ДействуетС, Представление", 
									Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,
									Дата("30.11.2015 0:00:00"),
									"298033, Республика Крым, г Судак, с Морское, ул Калинина, дом 67");
		НайденныеСтроки = ЭтотОбъект.КонтактнаяИнформация.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЭтотОбъект.КонтактнаяИнформация.Удалить(НайденныеСтроки[0]);		
		КонецЕсли;
	КонецЕсли;
	//#4802 смарт: Тимофеева 09.12.2025
КонецПроцедуры //-- смарт:ММ 03.08.2020

//++ смарт:ММ #060 319 04.08.2020 - доработка спр. Конрагенты
&После("ПриЗаписи")
Процедура смарт_ПриЗаписи(Отказ)
	
	Если ДополнительныеСвойства.Свойство("смартОтпарвлятьУведомлениеОСтатусеКонтактныхДанных")
		И ДополнительныеСвойства.смартОтпарвлятьУведомлениеОСтатусеКонтактныхДанных = Истина Тогда
		смартОтправитьУведомлениеОСтатусеКонтактныхДанных();
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 04.08.2020

&После("ПриКопировании")
Процедура смарт_ПриКопированииПосле(ОбъектКопирования)
	
	//++#1459 смарт: Лопато 13.09.2023 //При копировании контрагента не очищается история наименования
	смартОбщегоНазначения.ОчиститьРеквизитыОбъекта(ЭтотОбъект, , , "Партнер");
	//--#1459 смарт: Лопато 13.09.2023
	
КонецПроцедуры

#КонецОбласти

