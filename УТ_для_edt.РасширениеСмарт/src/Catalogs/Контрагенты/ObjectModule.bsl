//++ смарт:ММ #060 319 04.08.2020 - доработка спр. Конрагенты
Функция смартПолучитьАдресаПолучателейУведомлений(МассивАдресовСтрокой = "")
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПартнерыСпр.смартОсновнойМенеджерСервисЦентра КАК Пользователь
	|ПОМЕСТИТЬ ВТ_СписокПользователей
	|ИЗ
	|	Справочник.Партнеры КАК ПартнерыСпр
	|ГДЕ
	|	ПартнерыСпр.Ссылка = &Партнер
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПартнерыСпр.ОсновнойМенеджер
	|ИЗ
	|	Справочник.Партнеры КАК ПартнерыСпр
	|ГДЕ
	|	ПартнерыСпр.Ссылка = &Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПользователиСпр.смартРабочаяПочта КАК смартРабочаяПочта
	|ИЗ
	|	ВТ_СписокПользователей КАК ВТ_СписокПользователей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
	|		ПО ВТ_СписокПользователей.Пользователь = ПользователиСпр.Ссылка
	|ГДЕ 
	|	ЕСТЬNULL(ПользователиСпр.смартРабочаяПочта, """") <> """"";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.смартРабочаяПочта);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресовСтрокой = МассивАдресовСтрокой + ?(ЗначениеЗаполнено(МассивАдресовСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции //-- смарт:ММ 04.08.2020

//++ смарт:ММ #081 396 08.11.2020 - Проверка при записи спр. Контрагенты
Процедура смартПроверитьИННЮрЛица(Отказ)
	
	// Проверка на наличие контрагентов с таким ИНН
	
	ПеречислениеЮрЛицо = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
	
	Если ЮрФизЛицо = ПеречислениеЮрЛицо 
		И ОбособленноеПодразделение = Ложь 
		И ЗначениеЗаполнено(ИНН) Тогда
		
		// Поиск в спровочнике элемента по трем реквизитам
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ЮрФизЛицо = &ЮрФизЛицо
		|	И НЕ Контрагенты.ОбособленноеПодразделение
		|	И Контрагенты.ИНН = &ИНН
		|	И Контрагенты.Ссылка <> &Ссылка
		|	И НЕ Контрагенты.смартНеОбновлятьКППВноситБухгалтерия";
		
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("ЮрФизЛицо", ПеречислениеЮрЛицо);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В базе уже есть юр. лицо с таким ИНН. Возможно, вы пытаетесь задвоить контрагента. Пожалуйста, воспользуйтесь поиском.");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;

