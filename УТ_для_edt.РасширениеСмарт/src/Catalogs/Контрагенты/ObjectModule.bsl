//++ смарт:ММ #012 152 13.12.2019
Функция смартЗаполнитьФактическийАдресПоЮридическому() Экспорт
	
	БылиИзменения = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	// 15.07.2020
	//ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление КАК Представление,
	|	КонтактнаяИнформация.Вид КАК Вид,
	|	КонтактнаяИнформация.Тип КАК Тип,
	|	КонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
	|	КонтактнаяИнформация.Страна КАК Страна,
	|	КонтактнаяИнформация.Регион КАК Регион,
	|	КонтактнаяИнформация.Город КАК Город,
	|	КонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	КонтактнаяИнформация.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	КонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
	|	КонтактнаяИнформация.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	КонтактнаяИнформация.ВидДляСписка КАК ВидДляСписка,
	|	КонтактнаяИнформация.ДействуетС КАК ДействуетС,
	|	КонтактнаяИнформация.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_КИ
	|ИЗ
	|	&КонтактнаяИнформация КАК КонтактнаяИнформация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_КИ.ДействуетС) КАК ДействуетС,
	|	ВТ_КИ.Вид КАК Вид,
	|	ВТ_КИ.Тип КАК Тип
	|ПОМЕСТИТЬ ВТ_АктуальнаяДатаЮридическогоАдреса
	|ИЗ
	|	ВТ_КИ КАК ВТ_КИ
	|ГДЕ
	|	ВТ_КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И ВТ_КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КИ.Вид,
	|	ВТ_КИ.Тип
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ФактАдрес.Представление КАК Представление
	|ИЗ
	|	ВТ_КИ КАК ФактАдрес
	|ГДЕ
	|	ФактАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|	И ФактАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента)
	|	И ФактАдрес.Представление <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЮрАдрес.Представление КАК Представление,
	|	ЮрАдрес.Вид КАК Вид,
	|	ЮрАдрес.Тип КАК Тип,
	|	ЮрАдрес.ЗначенияПолей КАК ЗначенияПолей,
	|	ЮрАдрес.Страна КАК Страна,
	|	ЮрАдрес.Регион КАК Регион,
	|	ЮрАдрес.Город КАК Город,
	|	ЮрАдрес.АдресЭП КАК АдресЭП,
	|	ЮрАдрес.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	ЮрАдрес.НомерТелефона КАК НомерТелефона,
	|	ЮрАдрес.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	ЮрАдрес.ВидДляСписка КАК ВидДляСписка,
	|	ЮрАдрес.ДействуетС КАК ДействуетС,
	|	ЮрАдрес.Значение КАК Значение
	|ИЗ
	|	ВТ_АктуальнаяДатаЮридическогоАдреса КАК ВТ_АктуальнаяДатаЮридическогоАдреса
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_КИ КАК ЮрАдрес
	|		ПО ВТ_АктуальнаяДатаЮридическогоАдреса.Вид = ЮрАдрес.Вид
	|			И ВТ_АктуальнаяДатаЮридическогоАдреса.Тип = ЮрАдрес.Тип
	|			И ВТ_АктуальнаяДатаЮридическогоАдреса.ДействуетС = ЮрАдрес.ДействуетС
	|ГДЕ
	|	ЮрАдрес.Представление <> """"";
	
	Запрос.УстановитьПараметр("КонтактнаяИнформация", КонтактнаяИнформация.Выгрузить());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаФактическийАдрес = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать();
	
	//++ #3870 смарт: Тимофеева 12.08.2025 / Проверка данных контрагента при проведении реализации
	//разрешено, и главным бухгалтером согласовано, что для ИП фактический адрес может не равняться юридическому

	  //  //++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
	  //  // Фактический адрес ВСЕГДА приравнивается к юридическому (кроме обособленных подразделений)
	  //  //Если НЕ ВыборкаФактическийАдрес.Следующий() Тогда
	  //Если (ОбособленноеПодразделение И НЕ ВыборкаФактическийАдрес.Следующий())
	  //	ИЛИ НЕ ОбособленноеПодразделение Тогда
	  //  //-- смарт:ММ 08.10.2020
	  
	Если (ОбособленноеПодразделение И НЕ ВыборкаФактическийАдрес.Следующий())
		  ИЛИ (ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель И НЕ ВыборкаФактическийАдрес.Следующий())
	  	  ИЛИ (НЕ ОбособленноеПодразделение И НЕ ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель) Тогда
  
	//-- #3870 смарт: Тимофеева 12.08.2025
	
		// Фактический адрес не заполнен. Проверка, заполнен ли юридический адрес		
		ВыборкаЮридическийАдрес = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
		
		Если ВыборкаЮридическийАдрес.Следующий() Тогда
			
			// Проверка, есть ли строка с фактическим адресом (истина, если строка есть, но она не заполнена)
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
			ПараметрыОтбора.Вставить("Вид", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"));

			НайденныеСтроки = КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаФактАдрес = КонтактнаяИнформация.Добавить();
			Иначе 
				СтрокаФактАдрес = НайденныеСтроки[0];
				
				//++ смарт:ММ #076 373 27.10.2020 - Доработка справочника Контрагенты - факт. адрес
				// Сохранение прежнего фактического адреса в новый вид, если юр. адрес не менялся, а просто хочет перезаписаться фактический адрес
				
				ПараметрыОтбораЮрАдрес = Новый Структура;
				ПараметрыОтбораЮрАдрес.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
				ПараметрыОтбораЮрАдрес.Вставить("Вид", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента"));
				
				НайденныеСтрокиЮр = Ссылка.КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбораЮрАдрес);
				
				Если НайденныеСтрокиЮр.Количество() > 0 Тогда
					СтрокаЮрАдресВБазе = НайденныеСтрокиЮр[0];
					
					Если СтрокаФактАдрес.Представление <> ВыборкаЮридическийАдрес.Представление // Факт адрес не совпадает с текущим юр. адресом
						И СтрокаЮрАдресВБазе.Представление = ВыборкаЮридическийАдрес.Представление Тогда  // текущий юр. адрес не менялся
						смартСкопироватьФактическийАдрес(СтрокаФактАдрес);
					КонецЕсли;	
				КонецЕсли;
				//-- смарт:ММ 27.10.2020
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаФактАдрес, ВыборкаЮридическийАдрес, , "Вид, ВидДляСписка");
			СтрокаФактАдрес.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
			СтрокаФактАдрес.ВидДляСписка = СтрокаФактАдрес.Вид;
			
			БылиИзменения = Истина;
		КонецЕсли;
	КонецЕсли;

	//БылиИзменения = Ложь;
	
	Возврат БылиИзменения;
	
КонецФункции //-- смарт:ММ 13.12.2019

//++ смарт:ММ #076 373 27.10.2020 - Доработка справочника Контрагенты - факт. адрес
Процедура смартСкопироватьФактическийАдрес(СтрокаПрежнийФактическийАдрес)
	
	ВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию("Факт. адрес (смарт)", Истина);
	
	Если НЕ ЗначениеЗаполнено(ВидКИ) Тогда
		
		ФактАдресКонтрагента = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента;
		
		ВидКИОбъект = ФактАдресКонтрагента.Скопировать();	
		ВидКИОбъект.Наименование = "Факт. адрес (смарт)";
		ВидКИОбъект.Используется = Истина;
		ВидКИОбъект.Записать();
		ВидКИ = ВидКИОбъект.Ссылка;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидКИ) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	ПараметрыОтбора.Вставить("Вид", ВидКИ);
	
	НайденныеСтроки = КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаФактАдрес = КонтактнаяИнформация.Добавить();
	Иначе 
		СтрокаФактАдрес = НайденныеСтроки[0];
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаФактАдрес, СтрокаПрежнийФактическийАдрес);
	СтрокаФактАдрес.Вид = ВидКИ;
	СтрокаФактАдрес.ВидДляСписка = СтрокаФактАдрес.Вид;
	
КонецПроцедуры //-- смарт:ММ 27.10.2020

//++ смарт:ММ #012 152 14.12.2019
Функция смартЗаполнитьЕmailТелефонИзПартнера(ЗаполнитьEmail = Истина, ЗаполнитьТелефон = Истина) Экспорт
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ТелефонЗаполнен", 	Ложь);
	СтруктураВозврата.Вставить("EmailЗаполнен", 	Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформацияПартнера.Представление КАК Представление,
	|	КонтактнаяИнформацияПартнера.Вид КАК Вид,
	|	КонтактнаяИнформацияПартнера.Тип КАК Тип,
	|	КонтактнаяИнформацияПартнера.ЗначенияПолей КАК ЗначенияПолей,
	|	КонтактнаяИнформацияПартнера.Страна КАК Страна,
	|	КонтактнаяИнформацияПартнера.Регион КАК Регион,
	|	КонтактнаяИнформацияПартнера.Город КАК Город,
	|	КонтактнаяИнформацияПартнера.АдресЭП КАК АдресЭП,
	|	КонтактнаяИнформацияПартнера.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	КонтактнаяИнформацияПартнера.НомерТелефона КАК НомерТелефона,
	|	КонтактнаяИнформацияПартнера.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	КонтактнаяИнформацияПартнера.ВидДляСписка КАК ВидДляСписка,
	|	КонтактнаяИнформацияПартнера.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_КИ
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК КонтактнаяИнформацияПартнера
	|ГДЕ
	|	КонтактнаяИнформацияПартнера.Ссылка = &Партнер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Телефон.Представление КАК Представление,
	|	Телефон.Вид КАК Вид,
	|	Телефон.Тип КАК Тип,
	|	Телефон.ЗначенияПолей КАК ЗначенияПолей,
	|	Телефон.Страна КАК Страна,
	|	Телефон.Регион КАК Регион,
	|	Телефон.Город КАК Город,
	|	Телефон.АдресЭП КАК АдресЭП,
	|	Телефон.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	Телефон.НомерТелефона КАК НомерТелефона,
	|	Телефон.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	Телефон.ВидДляСписка КАК ВидДляСписка,
	|	Телефон.Значение КАК Значение
	|ИЗ
	|	ВТ_КИ КАК Телефон
	|ГДЕ
	|	Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПартнера)
	|	И Телефон.Представление <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Email.Представление КАК Представление,
	|	Email.Вид КАК Вид,
	|	Email.Тип КАК Тип,
	|	Email.ЗначенияПолей КАК ЗначенияПолей,
	|	Email.Страна КАК Страна,
	|	Email.Регион КАК Регион,
	|	Email.Город КАК Город,
	|	Email.АдресЭП КАК АдресЭП,
	|	Email.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	Email.НомерТелефона КАК НомерТелефона,
	|	Email.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	Email.ВидДляСписка КАК ВидДляСписка,
	|	Email.Значение КАК Значение
	|ИЗ
	|	ВТ_КИ КАК Email
	|ГДЕ
	|	Email.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И Email.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПартнера)
	|	И Email.Представление <> """"";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	// Телефон
	
	Если ЗаполнитьТелефон Тогда
		ВыборкаТелефон = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать();
		
		Если ВыборкаТелефон.Следующий() Тогда
			
			// Проверка, есть ли строка с телефоном у контрагента (истина, если строка есть, но она не заполнена)
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон"));
			ПараметрыОтбора.Вставить("Вид", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента"));
			
			НайденныеСтроки = КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаТелефон = КонтактнаяИнформация.Добавить();
			Иначе 
				СтрокаТелефон = НайденныеСтроки[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаТелефон, ВыборкаТелефон, , "Вид, ВидДляСписка");
			СтрокаТелефон.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			СтрокаТелефон.ВидДляСписка = СтрокаТелефон.Вид;
			
			СтруктураВозврата.ТелефонЗаполнен = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// e-mail
	
	Если ЗаполнитьEmail Тогда
		ВыборкаEmail = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
		
		Если ВыборкаEmail.Следующий() Тогда
			
			// Проверка, есть ли строка с e-mail у контрагента (истина, если строка есть, но она не заполнена)
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"));
			ПараметрыОтбора.Вставить("Вид", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailКонтрагента"));
			
			НайденныеСтроки = КонтактнаяИнформация.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаEmail = КонтактнаяИнформация.Добавить();
			Иначе 
				СтрокаEmail = НайденныеСтроки[0];
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаEmail, ВыборкаEmail, , "Вид, ВидДляСписка");
			СтрокаEmail.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагента;
			СтрокаEmail.ВидДляСписка = СтрокаEmail.Вид;
			
			СтруктураВозврата.EmailЗаполнен = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции //-- смарт:ММ 14.12.2019

//++ смарт:ММ #012 152 14.12.2019
Функция смартПроверитьЗаполнениеEmailИТелефона(ПроверятьТелефон = Истина, ПроверятьEmail = Истина, ХотяБыОдноЗаполнено = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление КАК Представление,
	|	КонтактнаяИнформация.Вид КАК Вид,
	|	КонтактнаяИнформация.Тип КАК Тип,
	|	КонтактнаяИнформация.ЗначенияПолей КАК ЗначенияПолей,
	|	КонтактнаяИнформация.Страна КАК Страна,
	|	КонтактнаяИнформация.Регион КАК Регион,
	|	КонтактнаяИнформация.Город КАК Город,
	|	КонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	КонтактнаяИнформация.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	КонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
	|	КонтактнаяИнформация.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	КонтактнаяИнформация.ВидДляСписка КАК ВидДляСписка,
	|	КонтактнаяИнформация.ДействуетС КАК ДействуетС,
	|	КонтактнаяИнформация.Значение КАК Значение
	|ПОМЕСТИТЬ ВТ_КИ
	|ИЗ
	|	&КонтактнаяИнформация КАК КонтактнаяИнформация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Телефон.Представление КАК Представление
	|ИЗ
	|	ВТ_КИ КАК Телефон
	|ГДЕ
	|	Телефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|	И Телефон.Представление <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЭлПочта.Представление КАК Представление
	|ИЗ
	|	ВТ_КИ КАК ЭлПочта
	|ГДЕ
	|	ЭлПочта.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И ЭлПочта.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтрагента)
	|	И ЭлПочта.Представление <> """"
	|;
	|
	//++ #Б2158 смарт: Шляпников 10.03.2025 / Контактная информация у ликвидированных контрагентов
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СостоянияКонтрагентов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.СостоянияКонтрагентов КАК СостоянияКонтрагентов
	|ГДЕ
	|	СостоянияКонтрагентов.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("КонтактнаяИнформация", КонтактнаяИнформация.Выгрузить());
	Запрос.УстановитьПараметр("Контрагент", Ссылка);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ПропуститьПроверку = Ложь;
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		Если РезультатЗапроса[РезультатЗапроса.Количество() - 1].Пустой() Тогда
			ПропуститьПроверку = Истина;
		Иначе
			
			Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
			Выборка.Следующий();
			
			Если Выборка.Состояние = Перечисления.СостоянияСуществованияКонтрагента.НеДействуетИлиИзмененКПП
				ИЛИ Выборка.Состояние = Перечисления.СостоянияСуществованияКонтрагента.КонтрагентОтсутствуетВБазеФНС Тогда
				
				ПропуститьПроверку = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	ТелефонЗаполнен = Истина;
	EmailЗаполнен 	= Истина;
	
	Если ПроверятьТелефон И НЕ ПропуститьПроверку Тогда	
		Если РезультатЗапроса[РезультатЗапроса.Количество() - 3].Пустой() Тогда
			ТелефонЗаполнен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьEmail И НЕ ПропуститьПроверку Тогда		
		Если РезультатЗапроса[РезультатЗапроса.Количество() - 2].Пустой() Тогда
			EmailЗаполнен = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьТелефон И ПроверятьEmail И НЕ ПропуститьПроверку Тогда
		Если ХотяБыОдноЗаполнено Тогда
			Возврат ТелефонЗаполнен ИЛИ EmailЗаполнен;
		Иначе			
			Возврат ТелефонЗаполнен И EmailЗаполнен;
		КонецЕсли;
	КонецЕсли;
	
	Если ПроверятьТелефон И НЕ ПропуститьПроверку Тогда
		Возврат ТелефонЗаполнен;
	КонецЕсли;
	
	Если ПроверятьEmail И НЕ ПропуститьПроверку Тогда
		Возврат EmailЗаполнен;
	КонецЕсли;
	
	//-- #Б2158 смарт: Шляпников 10.03.2025
	
	Возврат Истина;
	
КонецФункции //-- смарт:ММ 14.12.2019

