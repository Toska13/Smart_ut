//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
Процедура смартОбойтиПодчиненныеЭлементыРекурсивно(ТекЭлемент)
	
	Если ТипЗнч(ТекЭлемент) = Тип("ПолеФормы") Тогда
		ТекЭлемент.ТолькоПросмотр = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекЭлемент) = Тип("КнопкаФормы") Тогда
		ТекЭлемент.Доступность = Ложь;
		Возврат;
	КонецЕсли;
		
	Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
		Если ТекЭлемент.ПодчиненныеЭлементы.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого Элемент Из ТекЭлемент.ПодчиненныеЭлементы Цикл
			смартОбойтиПодчиненныеЭлементыРекурсивно(Элемент);
		КонецЦикла;
	КонецЕсли;
	
	Возврат;
	
КонецПроцедуры //-- смарт:ММ 08.10.2020

