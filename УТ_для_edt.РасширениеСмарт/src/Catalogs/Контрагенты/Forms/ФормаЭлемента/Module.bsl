&НаКлиенте
Процедура смарт_смартНеПроверятьРискиПриИзмененииВместо(Элемент)
	Объект.смартОтветсвтенныйЗаРиски=?(Объект.смартНеПроверятьРиски,ПользователиКлиентСервер.ТекущийПользователь(),Неопределено);
КонецПроцедуры

// Смарт Фролов+
// Блокируем реквизиты, что бы пользователь нажал кнопку заполнить по ИНН
&НаСервереБезКонтекста
Процедура смартЗакрытьРеквизитыДляРедактирования(знач ВидКонтрагента, знач Элементы,КонтрагентУжеЕсть=Ложь,ИсторияРеквизитов)
	
	//смартКаратеев +- // Изменил под новые требования
	Если Пользователи.РолиДоступны("ПолныеПрава,смартРедактированиеКонтрагентовСДвижениями") Тогда
		Возврат;
	КонецЕсли;	
	
	Если ИсторияРеквизитов.Количество() > 0 Тогда 
		ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,ИсторияРеквизитов.ВыгрузитьЗначения(),"ТолькоПросмотр",Ложь,Истина);
	КонецЕсли;	
	
	МассивРеквизитов=Новый Массив;
	Если Не КонтрагентУжеЕсть И (ВидКонтрагента="ЮрЛицо" Или ВидКонтрагента="ИндивидуальныйПредприниматель") Тогда 
		МассивРеквизитов.Добавить("НДСПоСтавкам4и2");
		МассивРеквизитов.Добавить("КПП");
		//МассивРеквизитов.Добавить("КодПоОКПО"); //Каратеев +- // По заявке от бух. открыл редактирование реквизита
		МассивРеквизитов.Добавить("ГруппаНаименованиеЛево");
		//Каратеев ++ //По заявке от бух. открыл все кроме юр.адреса
		//МассивРеквизитов.Добавить("ГруппаКонтактнаяИнформация");
		Для Каждого Эл Из Элементы.ГруппаКонтактнаяИнформация.ПодчиненныеЭлементы Цикл
			Если Эл.Заголовок = "Юридический адрес" И ВидКонтрагента = "ЮрЛицо" Тогда
				МассивРеквизитов.Добавить(Эл.Имя);
			КонецЕсли;;	
		КонецЦикла;
		//Каратеев --
		МассивРеквизитов.Добавить("ГруппаДополнительныеРеквизиты");
	ИначеЕсли Не КонтрагентУжеЕсть И ВидКонтрагента="ФизЛицо" Тогда
		МассивРеквизитов.Добавить("ИНН");
	ИначеЕсли Не КонтрагентУжеЕсть И ВидКонтрагента="ЮрЛицоНеРезидент" Тогда
		// Пока ничего не делаем
	ИначеЕсли Не КонтрагентУжеЕсть И ВидКонтрагента="ОбособленноеПодразделение" Тогда	
		МассивРеквизитов.Добавить("ИНН");
	ИначеЕсли КонтрагентУжеЕсть Тогда 
		//++ смарт:ММ #012 155 15.12.2019
		//МассивРеквизитов.Добавить("ГруппаЮрЛицоНДС");
		//МассивРеквизитов.Добавить("ГруппаИННКППОКПО");
		
		//МассивРеквизитов.Добавить("ГруппаСтраницаИностраннойРегистрации");
		//МассивРеквизитов.Добавить("ГруппаНаименования");
		Если ЗначениеЗаполнено(Элементы.смартДокументыДоговоры.Заголовок) Тогда
			МассивРеквизитов.Добавить("Партнер");
		КонецЕсли;	
		//-- смарт:ММ 15.12.2019
		
		Для Каждого Эл Из Элементы.ГруппаКонтактнаяИнформация.ПодчиненныеЭлементы Цикл
			Если Эл.Заголовок="Юридический адрес" И Не ВидКонтрагента="ИндивидуальныйПредприниматель" И Не ВидКонтрагента = "ЮрЛицоНеРезидент" Тогда 
				МассивРеквизитов.Добавить(Эл.Имя);
			КонецЕсли;;	
		КонецЦикла;					
	КонецЕсли;
	
	//++ смарт:ММ #012 155 14.12.2019
	// проблемы (юр.лицо и ИП): доступен Партнер, должен быть не доступен для изменения, если по контрагенту есть движения; недоступен ОКПО - должен быть доступен
	// ММ: поскольку не сказано, для нового документа или для существующего, то сделано для всех
	//Если ВидКонтрагента = "ЮрЛицо" 
	//	ИЛИ ВидКонтрагента = "ИндивидуальныйПредприниматель"
	//	ИЛИ ВидКонтрагента = "ЮрЛицоНеРезидент" Тогда
	//	
	//	МассивРеквизитов.Добавить("Партнер");
	//	
	//	Если ВидКонтрагента <> "ЮрЛицоНеРезидент" Тогда
	//		Элементы.КодПоОКПО.ТолькоПросмотр = Ложь;
	//	КонецЕсли;
	//	
	//КонецЕсли;
	//-- смарт:ММ 14.12.2019
		
	ИсторияРеквизитов.ЗагрузитьЗначения(МассивРеквизитов);
	
	ОбщегоНазначенияУТКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,МассивРеквизитов,"ТолькоПросмотр",Истина,Истина);
	
КонецПроцедуры

// Смарт
// Здесь выполним проверку есть ли Контрагент в базе ФНС	
&НаСервере
Процедура смарт_ПриЗаписиНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если РольДоступна("ПолныеПрава") Тогда 
		Возврат;
	КонецЕсли;	

	Если Объект.ЮрФизЛицо=ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Или Объект.ЮрФизЛицо=ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель") Тогда 
		//Смарт {[+](фрагмент ДОБАВЛЕН), Администратор 26.11.2019 16:26:09
		// ЗначениеЗаполнено(РеквизитыПроверкиКонтрагентов.СостояниеКонтрагента)
		Если ЗначениеЗаполнено(РеквизитыПроверкиКонтрагентов.СостояниеКонтрагента) И РеквизитыПроверкиКонтрагентов.СостояниеКонтрагента<>ПредопределенноеЗначение("Перечисление.СостоянияСуществованияКонтрагента.КонтрагентЕстьВБазеФНС") Тогда 
			//Смарт }Администратор 26.11.2019 16:26:09
			
			//++ #Б2664 смарт: Шляпников 17.03.2025 / Ошибка при сохранении ликвидированных контрагентов
			Если ТекущийОбъект.ДополнительныеСвойства.РеквизитыМенялись Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Контрагента c ИНН " + Объект.ИНН + " нет в базе ФНС!",, "Объект.ИНН",, Отказ);
			КонецЕсли;
			//-- #Б2664 смарт: Шляпников 17.03.2025
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

