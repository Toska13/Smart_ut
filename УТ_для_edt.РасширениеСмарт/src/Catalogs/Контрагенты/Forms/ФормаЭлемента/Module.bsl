	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "E-mail";
	НовыйЭлемент.ПутьКДанным = "смартОтветственныйЗаЭДОПочта";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Добавить("смартОтветственныйЗаЭДОТелефон", Тип("ПолеФормы"), ГруппаОтветственныйЗаЭДО);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Телефон";
	НовыйЭлемент.ПутьКДанным = "смартОтветственныйЗаЭДОТелефон";
	НовыйЭлемент.ТолькоПросмотр = Истина;

	// Статус контактных данных контрагента
	
	НовыйЭлемент = Элементы.Вставить("смартСтатусКонтактныхДанныхКонтрагента", Тип("ПолеФормы"), Элементы.СтраницаОсновное, Элементы.смартГруппаГенДир);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Статус контактных данных контрагента (смарт)";
	НовыйЭлемент.ПутьКДанным = "Объект.смартСтатусКонтактныхДанныхКонтрагента"; 
	
	Если НЕ УправлениеДоступом.ЕстьРоль("смартУстановкаПодтвержденияЗаказаФинОтдел") Тогда
		НовыйЭлемент.ТолькоПросмотр = Истина;	
	КонецЕсли; 
	
	//++ #1334 смарт: Фролов 17.04.2023 //Заявка на формирование и подписание договора из 1С  
	НовыйЭлемент = Элементы.Добавить("смартЛизинговаяКомпания", Тип("ПолеФормы"), Элементы.ГруппаИННКППОКПО);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Заголовок = "Лизинговая компания (смарт)";
	НовыйЭлемент.ПутьКДанным = "Объект.смартЛизинговаяКомпания";
	НовыйЭлемент.ТолькоПросмотр=Ложь;
	//-- #1334 смарт: Фролов 17.04.2023 
	
	смартЗаполнитьКонтактнуюИнформациюЛиц();
	//-- смарт:ММ 03.08.2020

	//++#1500 смарт: Лопато 13.10.2023 //Ошибка при изменении вида контрагента  
	Эл = Элементы.Вставить("ИнфОбособка", Тип("ДекорацияФормы"), Элементы.ГруппаСтраницаРоссийскогоКонтрагента, Элементы.ГруппаРезультатПроверкиКонтрагентов);
	Эл.Вид = ВидДекорацииФормы.Надпись;
	Эл.ЦветТекста = WebЦвета.Красный;
	Эл.Ширина = 80;
	Эл.Заголовок = "ИНН не вводится! Выберите 'Головного контрагента' (если требуется создайте).";
	
	УстановитьВидимостьИнфОбособка();
	//--#1500 смарт: Лопато 13.10.2023
	
	//++ #4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
	смартФормированиеИнтерфейса.СоздатьКоманду(ЭтаФорма, "смартОткрытьСтопЛистТехническойОтсрочки", "Стоп-лист технической отсрочки", "смартОткрытьСтопЛистТехническойОтсрочки");
	
	ГруппаСтопЛистТехническойОтсрочки = смартФормированиеИнтерфейса.СздГруппаОбычнаяБезОтображения(ЭтаФорма, "ГруппаСтопЛистТехническойОтсрочки", Элементы.ГруппаПартнер, 3,,,,);
	 
	СвойстваКнопки = Новый Структура;
	СвойстваКнопки.Вставить("Отображение", ОтображениеКнопки.КартинкаИТекст);
