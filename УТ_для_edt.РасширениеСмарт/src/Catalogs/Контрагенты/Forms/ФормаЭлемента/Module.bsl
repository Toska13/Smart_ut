&НаСервере
Процедура смартДобавитьЭлементыПрограммно()
	
	//++ смарт:ММ #076 373 08.10.2020 - Доработка справочника Контрагенты - факт. адрес 
	
	// ++ 03.11.2020
	//НовыйЭлемент = Элементы.Добавить("смартДатаОбновленияПоДаннымФНС", Тип("ПолеФормы"), Элементы.ГруппаРезультатПроверкиКонтрагентов);
	НоваяГруппа = Элементы.Добавить("смартГруппаОбновлениеПоДаннымФНС", ТИп("ГруппаФормы"), Элементы.ГруппаСтраницаРоссийскогоКонтрагента);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент = Элементы.Добавить("смартДатаОбновленияПоДаннымФНС", Тип("ПолеФормы"), НоваяГруппа);
	// --
	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.ПутьКДанным = "Объект.смартДатаОбновленияПоДаннымФНС";
	
	Элементы.РезультатПроверкиКонтрагента.Ширина = 20; // Было 75
	Элементы.РезультатПроверкиКонтрагента.РастягиватьПоГоризонтали = Истина; // Была Ложь
	//-- смарт:ММ 08.10.2020

	//++ смарт:ММ #076 373 04.11.2020 - Доработка справочника Контрагенты
	НовыйЭлемент = Элементы.Добавить("смартНеОбновлятьКППВноситБухгалтерия", Тип("ПолеФормы"), НоваяГруппа);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Объект.смартНеОбновлятьКППВноситБухгалтерия";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	
	Если НЕ Пользователи.РолиДоступны("смартУстановкаПодтвержденияЗаказаФинОтдел,ПолныеПрава") Тогда
		НовыйЭлемент.ТолькоПросмотр = Истина;	
	КонецЕсли;
	//-- смарт:ММ 04.11.2020

	НовыйЭлемент = Элементы.Добавить("смартЭДОКонтрагента", Тип("ДекорацияФормы"), Элементы.ГруппаСтраницаРоссийскогоКонтрагента);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = СформироватьТекстЗаголовкаЭДО(); 
	
				
	//++ смарт:ММ #060 319 03.08.2020 - доработка спр. Конрагенты
	
	нРеквизиты = Новый Массив;
	Реквизит = Новый РеквизитФормы("смартГенДирПочта", Новый ОписаниеТипов("Строка"), , "e-mail", Истина);
	нРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("смартГенДирТелефон", Новый ОписаниеТипов("Строка"), , "телефон", Истина);
	нРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("смартБухгалтерПочта", Новый ОписаниеТипов("Строка"), , "e-mail", Истина);
	нРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("смартБухгалтерТелефон", Новый ОписаниеТипов("Строка"), , "телефон", Истина);
	нРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("смартОтветственныйЗаЭДОПочта", Новый ОписаниеТипов("Строка"), , "e-mail", Истина);
	нРеквизиты.Добавить(Реквизит);
	Реквизит = Новый РеквизитФормы("смартОтветственныйЗаЭДОТелефон", Новый ОписаниеТипов("Строка"), , "телефон", Истина);
	нРеквизиты.Добавить(Реквизит); 
	
	ИзменитьРеквизиты(нРеквизиты);
	
	// Генеральный директор
	
	ГруппаГенДин = Элементы.Вставить("смартГруппаГенДир", Тип("ГруппаФормы"), Элементы.СтраницаОсновное, Элементы.ДополнительнаяИнформация);
	ГруппаГенДин.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаГенДин.ОтображатьЗаголовок = Ложь;
	ГруппаГенДин.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаГенДин.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	
	НовыйЭлемент = Элементы.Добавить("смартГенеральныйДиректор", Тип("ПолеФормы"), ГруппаГенДин);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = ?(Объект.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель, "Руководитель","Ген. директор"); //++rnp 351 01.10.2020 добавлено условие
	НовыйЭлемент.ПутьКДанным = "Объект.смартГенеральныйДиректор";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартГенеральныйДиректорПриИзменении");
	
	НовыйЭлемент = Элементы.Добавить("смартГенДирПочта", Тип("ПолеФормы"), ГруппаГенДин);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "E-mail";
	НовыйЭлемент.ПутьКДанным = "смартГенДирПочта";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Добавить("смартГенДирТелефон", Тип("ПолеФормы"), ГруппаГенДин);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Телефон";
	НовыйЭлемент.ПутьКДанным = "смартГенДирТелефон";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	// Бухгалтер
	
	ГруппаБух = Элементы.Вставить("смартГруппаБух", Тип("ГруппаФормы"), Элементы.СтраницаОсновное, Элементы.ДополнительнаяИнформация);
	ГруппаБух.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаБух.ОтображатьЗаголовок = Ложь;
	ГруппаБух.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаБух.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;

	НовыйЭлемент = Элементы.Добавить("смартБухгалтер", Тип("ПолеФормы"), ГруппаБух);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Бухгалтер";
	НовыйЭлемент.ПутьКДанным = "Объект.смартБухгалтер";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартБухгалтерПриИзменении");
	
	НовыйЭлемент = Элементы.Добавить("смартБухгалтерПочта", Тип("ПолеФормы"), ГруппаБух);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "E-mail";
	НовыйЭлемент.ПутьКДанным = "смартБухгалтерПочта";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Добавить("смартБухгалтерТелефон", Тип("ПолеФормы"), ГруппаБух);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Телефон";
	НовыйЭлемент.ПутьКДанным = "смартБухгалтерТелефон";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	// Ответственный за ЭДО
	
	ГруппаОтветственныйЗаЭДО = Элементы.Вставить("смартГруппаОтветственныйЗаЭДО", Тип("ГруппаФормы"), Элементы.СтраницаОсновное, Элементы.ДополнительнаяИнформация);
	ГруппаОтветственныйЗаЭДО.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОтветственныйЗаЭДО.ОтображатьЗаголовок = Ложь;
	ГруппаОтветственныйЗаЭДО.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаОтветственныйЗаЭДО.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;

	НовыйЭлемент = Элементы.Добавить("смартОтветственныйЗаЭДО", Тип("ПолеФормы"), ГруппаОтветственныйЗаЭДО);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок = "Ответственный за ЭДО";
	НовыйЭлемент.ПутьКДанным = "Объект.смартОтветственныйЗаЭДО";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартОтветственныйЗаЭДОПриИзменении");
	
