//++ смарт:ММ #060 319 06.08.2020 - доработка спр. Конрагенты
&НаСервере
Функция смартЗаполнитьКонтактнуюИнформациюЛиц(Директор = Истина, Бухгалтер = Истина, ОтвЭДО = Истина)
	
	Если Директор Тогда
		СтруктураКонтактнаяИнформация = смартПолучитьКонтактнуюИнформацию(Объект.смартГенеральныйДиректор);
		ЭтаФорма.смартГенДирПочта = СтруктураКонтактнаяИнформация.Почта;
		ЭтаФорма.смартГенДирТелефон = СтруктураКонтактнаяИнформация.Телефон;
	КонецЕсли;
	
	Если Бухгалтер Тогда
		СтруктураКонтактнаяИнформация = смартПолучитьКонтактнуюИнформацию(Объект.смартБухгалтер);
		ЭтаФорма.смартБухгалтерПочта = СтруктураКонтактнаяИнформация.Почта;
		ЭтаФорма.смартБухгалтерТелефон = СтруктураКонтактнаяИнформация.Телефон;
	КонецЕсли;
	
	Если ОтвЭДО Тогда
		СтруктураКонтактнаяИнформация = смартПолучитьКонтактнуюИнформацию(Объект.смартОтветственныйЗаЭДО);
		ЭтаФорма.смартОтветственныйЗаЭДОПочта = СтруктураКонтактнаяИнформация.Почта;
		ЭтаФорма.смартОтветственныйЗаЭДОТелефон = СтруктураКонтактнаяИнформация.Телефон;
	КонецЕсли;
	
КонецФункции //-- смарт:ММ 06.08.2020

//++ смарт:ММ 06.08.2020
&НаСервереБезКонтекста
Функция смартПолучитьКонтактнуюИнформацию(КонтактноеЛицо)
	
	СтруктураВозврат = Новый Структура;
	СтруктураВозврат.Вставить("Почта", "");
	СтруктураВозврат.Вставить("Телефон", "");
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК Значение,
	|	""Почта"" КАК Тип
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтактногоЛица)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление,
	|	""Телефон""
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Вид В (ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица), ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица))";
	
	Запрос.УстановитьПараметр("Ссылка", КонтактноеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат СтруктураВозврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Телефон = "";
	Почта = "";

	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Тип = "Почта" Тогда
			Почта = Почта + ?(ЗначениеЗаполнено(Почта), ", ", "") + Выборка.Значение;
		Иначе
			Телефон = Телефон + ?(ЗначениеЗаполнено(Телефон), ", ", "") + Выборка.Значение;
		КонецЕсли;
		
	КонецЦикла;	

	СтруктураВозврат.Вставить("Телефон", Телефон);
	СтруктураВозврат.Вставить("Почта", Почта);

	Возврат СтруктураВозврат;
	
КонецФункции //-- смарт:ММ 06.08.2020

//++ смарт:ММ #054 301 24.07.2020 - Контрагенты с ЭДО 
Функция СформироватьТекстЗаголовкаЭДО()
	
	// Надпись о подключении контрагента к ЭДО (1С, Диадок, СБИС)
	
	ТекстЗаголовкаЭДО = "Контрагент не работает через ЭДО";
	ЦветЗаголовка = ЦветаСтиля.ЦветТекстаФормы;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		// 23.07.2020
		СоответствиеЭДОКонтрагентов = смартОбщегоНазначения.ПолучитьЭДОКонтрагентов(Объект.Ссылка);
		МассивЭДОКонтрагента = СоответствиеЭДОКонтрагентов.Получить(Объект.Ссылка);

		
		Если СоответствиеЭДОКонтрагентов.Количество() = 0 
			ИЛИ (ТипЗнч(МассивЭДОКонтрагента) = Тип("Массив") И МассивЭДОКонтрагента.Количество() = 0) Тогда
			
			СоответствиеОператоровЭДО = смартОбщегоНазначения.ПолучитьОператоровЭДОКонтрагентов(Объект.Ссылка);
			Операторы = СоответствиеОператоровЭДО.Получить(Объект.Ссылка);
			
			Если Операторы <> Неопределено И Операторы.Количество() > 0 Тогда
				
				ТекстВсеЭДО = "";
				
				Для Каждого Оператор Из Операторы Цикл
					ТекстВсеЭДО = ТекстВсеЭДО + ?(ЗначениеЗаполнено(ТекстВсеЭДО), ", ", "") + Оператор;
				КонецЦикла;
				
				ТекстЗаголовкаЭДО = "Контрагент работает через ЭДО (" + ТекстВсеЭДО + ")";
				ЦветЗаголовка = Новый Цвет(255, 140, 0); // оранжевый
				
			КонецЕсли;
		Иначе
			
			ТекстВсеЭДО = "";
			
			Если ЗначениеЗаполнено(МассивЭДОКонтрагента) И ТипЗнч(МассивЭДОКонтрагента) = Тип("Массив") Тогда
				Для Каждого ВидЭДО Из МассивЭДОКонтрагента Цикл
					ТекстВсеЭДО = ТекстВсеЭДО + ?(ЗначениеЗаполнено(ТекстВсеЭДО), ", ", "") + ВидЭДО;
				КонецЦикла;
				
				ТекстЗаголовкаЭДО = "Контрагент подключен к ЭДО (" + ТекстВсеЭДО + ")";
				
				ЦветЗаголовка = Новый Цвет(100, 176, 16); // салатовый
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Элементы["смартЭДОКонтрагента"].ЦветТекста = ЦветЗаголовка;
	
	Возврат ТекстЗаголовкаЭДО;
	
КонецФункции //-- смарт:ММ 24.07.2020

