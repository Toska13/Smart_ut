//++ #Б2664 смарт: Шляпников 17.03.2025 / Ошибка при сохранении ликвидированных контрагентов
&НаСервере
Функция ЕстьИзмененияРеквизитовОбъекта(ТекущийОбъект)
	
	Если ТекущийОбъект.Ссылка.Пустая() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для каждого стрРеквизит Из Метаданные.Справочники.Контрагенты.СтандартныеРеквизиты Цикл
		Если ТекущийОбъект.Ссылка[стрРеквизит.Имя] <> ТекущийОбъект[стрРеквизит.Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Для каждого стрРеквизит Из Метаданные.Справочники.Контрагенты.Реквизиты Цикл
		Если ТекущийОбъект.Ссылка[стрРеквизит.Имя] <> ТекущийОбъект[стрРеквизит.Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции 

//++ #4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
&НаКлиенте
Процедура смартОткрытьСтопЛистТехническойОтсрочки(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("Партнер", Объект.Партнер);
	ОткрытьФорму("РегистрСведений.смартСтопЛистТехническойОтсрочки.Форма.ФормаСтопЛист", 
				ПараметрыОткрытияФормы, 
				ЭтаФорма, 
				УникальныйИдентификатор,
				,
				,
				,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
КонецПроцедуры

&НаСервере
Процедура смартОбновитьСостояниеСтопЛистаТехническойОтсрочки()
	
	Если НЕ Элементы.Найти("ГруппаСтопЛистТехническойОтсрочки") = Неопределено Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Партнер, "Клиент") = Истина Тогда 
			Элементы.ГруппаСтопЛистТехническойОтсрочки.Видимость = Истина;
			ОтгрузкаЗапрещена = РегистрыСведений.смартСтопЛистТехническойОтсрочки.КлиентуЗапрещенаТехническаяОтсрочка(Объект.Партнер);
			Элементы.смартОткрытьСтопЛистТехническойОтсрочки.Видимость = ОтгрузкаЗапрещена;
			Элементы.смартОткрытьСтопЛистТехническойОтсрочки1.Видимость = НЕ ОтгрузкаЗапрещена;
		Иначе
			Элементы.ГруппаСтопЛистТехническойОтсрочки.Видимость = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура смартОбновитьСостояниеБлокировокПоДоговорам()
	
	Если НЕ Элементы.Найти("ГруппаБлокировкиПоДоговорам") = Неопределено Тогда
		Элементы.ГруппаБлокировкиПоДоговорам.Видимость = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Партнер, "Клиент") = Истина
														И смартКонтрольДебиторскойЗадолженности.ЕстьАктивныеБлокировкиПоДоговорамПартнера(Объект.Партнер);
	КонецЕсли;   
	
КонецПроцедуры

