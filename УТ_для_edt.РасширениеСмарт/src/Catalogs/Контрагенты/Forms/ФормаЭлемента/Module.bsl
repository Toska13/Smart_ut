&НаКлиенте
Процедура смарт_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	
	//++ смарт:ММ #012 152 13.12.2019
	Если Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	// Если это не добавить, то в табличной части КонтактнаяИнформация еще нет данных (они лежат в реквизите формы КонтактнаяИнформацияОписаниеДополнительныхРеквизитов)	
	смарт_ПередЗаписьюПередНаСервере();
		
	// Заполнение фактического адреса по юридическому
	смартЗаполнитьФактическийАдресПоЮридическомуНаСервере();
		
	ТелефонИEmailЗаполнены = смартПроверитьЗаполнениеEmailИТелефонаНаСервере();
	
	Если НЕ ТелефонИEmailЗаполнены Тогда	
		Успех = смартЗаполнитьЕmailТелефонИзПартнераНаСервере();
		
		Если НЕ Успех Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполен e-mail! Контрагент не записан.");
		КонецЕсли;
		
	КонецЕсли;
	//-- смарт:ММ 13.12.2019
	
КонецПроцедуры

//++ смарт:ММ #012 152 13.12.2019
&НаСервере
Функция смартЗаполнитьЕmailТелефонИзПартнераНаСервере()
	
	Успех = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		Возврат Успех;
	КонецЕсли;
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	СтруктураВозврата = ДокОбъект.смартЗаполнитьЕmailТелефонИзПартнера(Истина, Истина);
	
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
	
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, Объект, "ГруппаКонтактнаяИнформация");

	Успех = Истина;
		
	//++ смарт:ММ #012 152 04.01.2020 - телефон теперь не обязателен для заполнения
	//Если НЕ СтруктураВозврата.ТелефонЗаполнен И НЕ СтруктураВозврата.EmailЗаполнен Тогда
	Если НЕ СтруктураВозврата.EmailЗаполнен Тогда
	//-- смарт:ММ 04.01.2020
		Успех = Ложь;
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции //-- смарт:ММ 13.12.2019

//++ смарт:ММ #012 152 14.12.2019
&НаСервере
Функция смартПроверитьЗаполнениеEmailИТелефонаНаСервере()
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ДокОбъект.смартПроверитьЗаполнениеEmailИТелефона(Истина, Истина, Истина); 	
	
КонецФункции //-- смарт:ММ 14.12.2019

&НаСервере
//++ смарт:ММ #012 152 14.12.2019
Процедура смартЗаполнитьФактическийАдресПоЮридическомуНаСервере()
	
	//++ #Б-2622 смарт: Лопато 10.03.2025 //Редактирование поля фактический адрес в карточке контрагента  
	Если Пользователи.РолиДоступны("ПолныеПрава") Тогда
		Возврат;
	КонецЕсли;	
	//-- #Б-2622 смарт: Лопато 10.03.2025
	
	//++ #1972 смарт: Лопато 04.10.2024 //Изменение фактического адреса в карточке контрагента  
	Если ВидКонтрагента = "ИндивидуальныйПредприниматель" 
		 И Пользователи.РолиДоступны("смартРазрешитьИзменениеФактическогоАдресаКонтрагента") Тогда
			 
		Возврат;
		
	КонецЕсли;	
	//-- #1972 смарт: Лопато 04.10.2024
	
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	БылиИзменения = ДокОбъект.смартЗаполнитьФактическийАдресПоЮридическому();
	
	Если БылиИзменения Тогда
		ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
		
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, Объект, "ГруппаКонтактнаяИнформация");
		// 28.10.2020
		смартНастроитьВидимостьДоступность();
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 14.12.2019

&НаКлиенте
&Перед("ЗаполнитьРеквизитыКонтрагентаПоПолученнымДанным")
Процедура смарт_ЗаполнитьРеквизитыКонтрагентаПоПолученнымДанным(РеквизитыКонтрагента)
	
	//++ смарт:ММ #012 153 14.12.2019
	// Заполнение фактического адреса по юридическому
	
	Если РеквизитыКонтрагента.Свойство("ЮридическийАдрес") Тогда
		
		ПартнерыИКонтрагентыКлиент.ЗаполнитьЭлементКонтактнойИнформации(ЭтотОбъект,
		                                                                ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ФактАдресКонтрагента"),
		                                                                РеквизитыКонтрагента.ЮридическийАдрес);
		
	КонецЕсли;

	//-- смарт:ММ 14.12.2019
		
КонецПроцедуры

&НаКлиенте  
//++ смарт: #1438 Корбутов 04.09.2023  добавление выбора основного ЭДО контрагента 
Процедура смартДействиеПоказатьИнформацию(Команда)
	
	Если СтрНайти(Команда.Имя, "смартИнформация_смартВыборОсновногоЭДО") <> 0 Тогда
		ИнформацияЗаголовок = "Выбор предпочтительного оператора ЭДО контрагента";
		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = '  Выберите пожалуйста оператора ЭДО, которым предпочитает пользоваться клиент.'")
			+ Символы.ПС
			+НСтр("ru = '  Указание предпочитаемого оператора ЭДО поможет не тратить время на выяснение, каким оператором пользуется клиент'")
			+ Символы.ПС
			+НСтр("ru = '  Эта информация будет полезна как менеджерам, так и бухгалтерам, юристам и т.д.'")
			);
	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;

КонецПроцедуры //--смарт: #1438 Корбутов 04.09.2023

&НаКлиенте
&После("ЗаполнитьРеквизитыКонтрагентаПоПолученнымДанным")
Процедура смарт_ЗаполнитьРеквизитыКонтрагентаПоПолученнымДаннымПосле(РеквизитыКонтрагента)
	
	//++ смарт:РН 
	// Заполнение фактического адреса по юридическому
	
	Если РеквизитыКонтрагента.Свойство("Наименование") И ВидКонтрагента="ИндивидуальныйПредприниматель" Тогда
		
		Объект.Наименование = РеквизитыКонтрагента.Наименование + " ИП";
		
	КонецЕсли;

	//-- смарт:ММ 14.12.2019
		
КонецПроцедуры

