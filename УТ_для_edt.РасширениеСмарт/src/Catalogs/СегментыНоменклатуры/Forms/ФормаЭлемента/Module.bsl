	СтандартнаяОбработка = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Для выбора необходимо записать сегмент номенклатуры!");
		Возврат;
	КонецЕсли;	
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыОткрытия.Вставить("МассивНоменклатуры", смартПолучитьНоменклатуруСегмента());
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.смартФормаВыбораДляПланирования", ПараметрыОткрытия, 
		ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
