&НаКлиенте
Процедура смартДействиеПоказатьИнформацию(Команда)
	
	Если СтрНайти(Команда.Имя, "смартИдентификаторДляФормул") <> 0 Тогда

		ИнформацияЗаголовок = "Идентификатор для формул";

		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'В поле <b>Идентификатор для формул</b> указывается имя сегмента для использования в программном коде.'")
			+ Символы.ПС
			+ Символы.ПС
			+ НСтр("ru = '<b>Изменять не рекомендуется!'")
			+ Символы.ПС
			+ НСтр("ru = '<b>Перед изменением идентификтатора необходимо убедиться, что он не используется!</b>'")
			);

	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;

КонецПроцедуры //--#1311 смарт: Лопато 15.02.2023

