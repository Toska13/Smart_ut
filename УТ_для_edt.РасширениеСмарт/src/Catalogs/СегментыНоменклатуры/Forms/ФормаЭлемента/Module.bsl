//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 09.08.2021 19:07:54 задача 552
&НаКлиенте
Процедура смарт_ПереносФильтра()
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Предварительно необходимо записать сегмент!");
		Возврат;
	КонецЕсли;
	
	МассивЭлементов=ЭлементыСегмента(Объект.Ссылка);
	
	ТекСтрока=Элементы.ФильтрыБитрикс.ТекущиеДанные;
	
	Если ТекСтрока=Неопределено Тогда
		Сообщить("Нет активного фильтра в ТЧ!");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.смартСегментПереноса) Тогда
		Отбор = Новый Структура("ВидСвойств, НаборСвойств, Сегмент", ТекСтрока.Фильтр,МассивЭлементов,Объект.смартСегментПереноса);    
	Иначе	
		Отбор = Новый Структура("ВидСвойств, НаборСвойств", ТекСтрока.Фильтр,МассивЭлементов);    
	КонецЕсли; 
	
	ОткрытьФорму("РегистрСведений.СмартЗначенияСвойствФильтров.ФормаСписка", Новый Структура("Отбор, РежимВыбора", Отбор,Истина),ЭтаФорма,,,,Новый ОписаниеОповещения("смартПослеЗакрытияФормы",ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

