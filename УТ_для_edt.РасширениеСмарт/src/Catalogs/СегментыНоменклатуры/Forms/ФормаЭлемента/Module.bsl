//++ #Б-1436 смарт: Фролов 28.11.2024 //План продаж по сегментам. Доработка справочников и документов.
Функция смартПроверитьПересечениеСДругимиСегментами(МассивНоменклатуры)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Сегмент КАК Сегмент,
	|	Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента
	|ГДЕ
	|	Номенклатура В(&МассивНоменклатуры)
	|	И Сегмент.смартИспользуетсяВПланированииПродаж
	|	И Сегмент <> &ЭтотСегмент");
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	Запрос.УстановитьПараметр("ЭтотСегмент", Объект.Ссылка);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ОбщегоНазначения.СообщитьПользователю("Номенклатура " + Выборка.Номенклатура + " уже присутствует в сегменте " + 
			Выборка.Сегмент + ", запись не возможна");	
		КонецЦикла;	
		
		Возврат Истина;
		
	КонецЕсли;	
	
КонецФункции //-- #Б-1436 смарт: Фролов 28.11.2024	

&НаСервере
//++ #Б-1436 смарт: Фролов 28.11.2024 //План продаж по сегментам. Доработка справочников и документов.
Функция смартПолучитьМассивНоменклатурыСКД(СКД, Настройки)

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		СКД, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
