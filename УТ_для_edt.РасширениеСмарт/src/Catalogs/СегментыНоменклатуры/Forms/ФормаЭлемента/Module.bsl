//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 09.08.2021 19:07:54 задача 552
&НаСервереБезКонтекста
Функция ПроверитьВозможностьУдаления(Фильтр,Сегмент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СмартЗначенияСвойствФильтров.НаборСвойств КАК НаборСвойств,
		|	СмартЗначенияСвойствФильтров.ВидСвойств КАК ВидСвойств,
		|	СмартЗначенияСвойствФильтров.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.СмартЗначенияСвойствФильтров КАК СмартЗначенияСвойствФильтров
		|ГДЕ
		|	СмартЗначенияСвойствФильтров.ВидСвойств = &Фильтр
		|	И СмартЗначенияСвойствФильтров.Сегмент = &Сегмент";
	
	Запрос.УстановитьПараметр("Фильтр", Фильтр);
	Запрос.УстановитьПараметр("Сегмент",Сегмент);
	
	РезультатЗапроса = Запрос.Выполнить();

	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

