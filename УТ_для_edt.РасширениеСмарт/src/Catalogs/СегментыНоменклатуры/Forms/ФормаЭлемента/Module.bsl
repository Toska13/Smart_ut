Процедура смарт_ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ВыбраныНоменклатураИЦена" Тогда
		
		Объект.смартТоварСегмента = Параметр.Номенклатура;
