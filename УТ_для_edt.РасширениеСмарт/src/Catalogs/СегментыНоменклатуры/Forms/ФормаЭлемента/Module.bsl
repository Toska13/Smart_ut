//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 09.08.2021 19:07:54 задача 552
&НаСервере
Процедура смартПереносСементаРегистра(ПараметрЗакрытия)
	
	 СтрНом="";
	 Для каждого Стр Из ПараметрЗакрытия Цикл
		СтрНом=СтрНом+Стр.НаборСвойств+";";

		НаборДанных=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
		НаборДанных.Отбор.ВидСвойств.Установить(Стр.ВидСвойств);
		НаборДанных.Отбор.Сегмент.Установить(Стр.Сегмент);
		НаборДанных.Отбор.НаборСвойств.Установить(Стр.НаборСвойств);
		НаборДанных.Прочитать(); 
		ТЗнабора=НаборДанных.Выгрузить();
		НаборДанных.Очистить();
		НаборДанных.Записать();
		Если ТЗнабора.Количество()>0 Тогда
			Для каждого СтрокаПредЗапись Из ТЗнабора Цикл
				СтрокаПредЗапись.Сегмент=Объект.Ссылка;
			КонецЦикла; 
			НаборДанных2=РегистрыСведений.СмартЗначенияСвойствФильтров.СоздатьНаборЗаписей();
			НаборДанных2.Отбор.ВидСвойств.Установить(Стр.ВидСвойств);
			НаборДанных2.Отбор.Сегмент.Установить(Объект.Ссылка);
			НаборДанных2.Отбор.НаборСвойств.Установить(Стр.НаборСвойств);
			НаборДанных2.Загрузить(ТЗнабора);
			НаборДанных2.Записать();
		КонецЕсли;
	КонецЦикла; 
	
	ОбщегоНазначения.СообщитьПользователю("Перенос фильтров завершен!"+Символы.ПС+" "+СтрНом);
	Объект.смартСегментПереноса=Справочники.СегментыНоменклатуры.ПустаяСсылка();
	
КонецПроцедуры

