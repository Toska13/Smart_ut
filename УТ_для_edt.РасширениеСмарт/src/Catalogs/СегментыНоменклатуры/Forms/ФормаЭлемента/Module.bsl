Функция смартПолучитьНоменклатуруСегмента()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрСведений.НоменклатураСегмента
	|ГДЕ
	|	Сегмент = &Сегмент");
	Запрос.УстановитьПараметр("Сегмент", Объект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
