//++ #3900 смарт: Тимофеева 06.08.2025 / Создать печатную форму документа Претензия
Функция смартСформироватьПечатнуюФормуДляПодписи(МассивОбъектов, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ДанныеДляПечати = смартПолучитьДанныеДляПечатнойФормыПретензияДляПодписи(МассивОбъектов);	
	смартЗаполнитьТабличныйДокументПретензияКлиентаДляПодписи(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати);
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура смартЗаполнитьТабличныйДокументПретензияКлиентаДляПодписи(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати) Экспорт
	
	РезультатПоШапке			= ДанныеДляПечати.РезультатПоШапке;
	РезультатПоТабличнойЧасти 	= ДанныеДляПечати.РезультатПоТабличнойЧасти;
	РезультатПоРеализациям	 	= ДанныеДляПечати.РезультатПоРеализациям;
		
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ПретензииКлиентов.ПФ_MXL_ПретензияКлиентаДляПодписи");
    ОбластьЗаголовок 		= Макет.ПолучитьОбласть("Заголовок");
	ОбластьЗаголовокУПД		= Макет.ПолучитьОбласть("ЗаголовокУПД");
	ОбластьСтрокаТаблицы 	= Макет.ПолучитьОбласть("Детали");
	ОбластьПодвал 			= Макет.ПолучитьОбласть("Подвал");
	
	ДанныеПечати = РезультатПоШапке.Выбрать();
	ДанныеПечати.Следующий();
	
	Если ЗначениеЗаполнено(ДанныеПечати.Контрагент) Тогда	
		Сведения = ФормированиеПечатныхФорм.СведенияОЮрФизЛице(ДанныеПечати.Контрагент, ДанныеПечати.Дата);
		ОбластьЗаголовок.Параметры.НаименованиеКонтрагента 		= Сведения.ПолноеНаименование; 
		ОбластьЗаголовок.Параметры.ИННКонтрагента 				= Сведения.ИНН;
		ОбластьЗаголовок.Параметры.КППКонтрагента 				= Сведения.КПП;
		ОбластьЗаголовок.Параметры.ЭлектронныйАдресТелефонКонтрагента 	= Сведения.ЭлектроннаяПочта 
																	+ ?(ЗначениеЗаполнено(Сведения.ЭлектроннаяПочта) И ЗначениеЗаполнено(Сведения.Телефоны), "/ ", "") 
																	+ Сведения.Телефоны; 
																	
		МассивПодстрокЮрАдреса = смартРазбитьСтрокуНаПодстроки(Сведения.ЮридическийАдрес, 60);	
		Для Индекс = 0 По Мин(МассивПодстрокЮрАдреса.Количество() - 1,2) Цикл
			ОбластьЗаголовок.Параметры["ЮридическийАдресКонтрагентаПодстрока" + Индекс]	= МассивПодстрокЮрАдреса[Индекс];
			Если Индекс < МассивПодстрокЮрАдреса.Количество() - 1 Тогда
				ОбластьЗаголовок.Параметры["ЮридическийАдресКонтрагентаПодстрока" + Индекс] = ОбластьЗаголовок.Параметры["ЮридическийАдресКонтрагентаПодстрока" + Индекс] + ",";	
			КонецЕсли;			
		КонецЦикла;
																	
		ОбластьПодвал.Параметры.НаименованиеКонтрагента 		= Сведения.ПолноеНаименование;
		Если ДанныеПечати.КонтрагентЮридическоеФизическоеЛицо = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			ПолноеНаименование                      = ?(Лев(Сведения.ПолноеНаименование, 3) = "ИП ", Сред(Сведения.ПолноеНаименование, 4), Сведения.ПолноеНаименование); 
			ФИОФизическогоЛица 						= ФизическиеЛицаКлиентСервер.ЧастиИмени(СокрЛП(ПолноеНаименование));		
			ФамилияИнициалы 						= ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ФИОФизическогоЛица); 
			ОбластьПодвал.Параметры.ФИОРуководителя = ФамилияИнициалы;
        КонецЕсли;
	КонецЕсли;
	
	ОбластьЗаголовок.Параметры.ДатаРегистрации = Формат(ДанныеПечати.ДатаРегистрации, "ДФ='dd.MM.yyyy ""г.""'"); 
	
	ОбластьЗаголовок.Параметры.Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДанныеПечати.Номер);
	ОбластьЗаголовок.Параметры.Дата	 = Формат(ДанныеПечати.Дата, "ДФ='dd.MM.yyyy ""г.""'"); 
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	ПредставлениеУПД = "№ ________ от ___.___.20__ г.";
	ОснованияНаРеализацию = РезультатПоРеализациям.Выгрузить().ВыгрузитьКолонку("РеализацияТоваровУслугСсылка");
	РезультатАнализа = Документы.СчетФактураВыданный.ПолучитьСчетаФактурыНаПечать(ОснованияНаРеализацию);
	Если РезультатАнализа.СчетаФактурыНаПечать.Количество() > 0 Тогда
		ПредставленияУПД = Новый Массив;
		Для Каждого СчетФактураВыданныйСсылка Из РезультатАнализа.СчетаФактурыНаПечать Цикл 
			ПредставленияУПД.Добавить(СтрШаблон("№%1 от %2 г.", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(СчетФактураВыданныйСсылка.Номер),
																Формат(СчетФактураВыданныйСсылка.Дата, "ДФ='dd.MM.yyyy'")));
		КонецЦикла;
		ПредставлениеУПД = СтрСоединить(ПредставленияУПД, ",");
	КонецЕсли;
	ОбластьЗаголовокУПД.Параметры.ПредставлениеУПД = ПредставлениеУПД;
	ТабличныйДокумент.Вывести(ОбластьЗаголовокУПД);
	
	ДанныеПечатиТовары = РезультатПоТабличнойЧасти.Выбрать();	
	Пока ДанныеПечатиТовары.Следующий() Цикл 
		Шаблон = "%1.   наименование %2, артикул %3, количество %4, стоимость %5 %6 в т.ч. НДС %7";
		ПредставлениеТовара = СтрШаблон(Шаблон,
										ДанныеПечатиТовары.НомерСтроки,
										ДанныеПечатиТовары.Номенклатура, 
										ДанныеПечатиТовары.Артикул, 
										ДанныеПечатиТовары.Количество,
										ДанныеПечатиТовары.Стоимость,
										ДанныеПечатиТовары.Валюта,
										ДанныеПечатиТовары.СтавкаНДС);
		ОбластьСтрокаТаблицы.Параметры.СтрокаТовара = ПредставлениеТовара;
		ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ДанныеПечатиТовары);
		ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);		
	КонецЦикла;	
	
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Функция смартПолучитьДанныеДляПечатнойФормыПретензияДляПодписи(МассивОбъектов)
			
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПретензииКлиентов.Ссылка КАК Ссылка,
	|	ПретензииКлиентов.Основание КАК Основание,
	|	ПретензииКлиентов.ДатаРегистрации КАК ДатаРегистрации
	|ПОМЕСТИТЬ ВТ_Претензии
	|ИЗ
	|	Справочник.ПретензииКлиентов КАК ПретензииКлиентов
	|ГДЕ
	|	ПретензииКлиентов.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПретензииКлиентовсмартТовары.Ссылка КАК Ссылка,
	|	ПретензииКлиентовсмартТовары.НомерСтроки КАК НомерСтроки,
	|	ПретензииКлиентовсмартТовары.Номенклатура КАК Номенклатура,
	|	ПретензииКлиентовсмартТовары.Характеристика КАК Характеристика,
	|	ПретензииКлиентовсмартТовары.Количество КАК Количество,
	|	ПретензииКлиентовсмартТовары.Серия КАК Серия,
	|	ПретензииКлиентовсмартТовары.Ссылка.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_ТоварыПретензии
	|ИЗ
	|	Справочник.ПретензииКлиентов.смартТовары КАК ПретензииКлиентовсмартТовары
	|ГДЕ
	|	ПретензииКлиентовсмартТовары.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Претензии.ДатаРегистрации КАК ДатаРегистрации,
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Номер КАК Номер,
	|	Документы.Дата КАК Дата,
	|	Документы.Валюта КАК Валюта,
	|	Документы.Организация КАК Организация,
	|	Документы.Контрагент КАК Контрагент,
	|	Документы.Контрагент.ЮридическоеФизическоеЛицо КАК КонтрагентЮридическоеФизическоеЛицо
	|ИЗ
	|	ВТ_Претензии КАК ВТ_Претензии
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК Документы
	|		ПО ВТ_Претензии.Основание = Документы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	|	ЗаказКлиентаТовары.Серия КАК Серия,
	|	МАКСИМУМ(ЗаказКлиентаТовары.СуммаСНДС / ЗаказКлиентаТовары.КоличествоУпаковок) КАК ЦенаСНДССоСкидкой,
	|	ЗаказКлиентаТовары.СтавкаНДС КАК СтавкаНДС,
	|	ЗаказКлиентаТовары.Ссылка.Валюта КАК Валюта
	|ПОМЕСТИТЬ ВТ_ТоварыЗаказа
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ.Основание
	|			ИЗ
	|				ВТ_Претензии КАК ВТ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Ссылка,
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ЗаказКлиентаТовары.Характеристика,
	|	ЗаказКлиентаТовары.Серия,
	|	ЗаказКлиентаТовары.СтавкаНДС,
	|	ЗаказКлиентаТовары.Ссылка.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТоварыПретензии.НомерСтроки КАК НомерСтроки,
	|	ВТ_ТоварыЗаказа.Номенклатура.Наименование КАК Номенклатура,
	|	ВТ_ТоварыЗаказа.Номенклатура.Артикул КАК Артикул,
	|	ВТ_ТоварыПретензии.Количество КАК Количество,
	|	ВТ_ТоварыПретензии.Количество * ЕСТЬNULL(ВТ_ТоварыЗаказа.ЦенаСНДССоСкидкой, 0) КАК Стоимость,
	|	ЕСТЬNULL(ВТ_ТоварыЗаказа.СтавкаНДС, """") КАК СтавкаНДС,
	|	ЕСТЬNULL(ВТ_ТоварыЗаказа.Валюта, """") КАК Валюта
	|ИЗ
	|	ВТ_ТоварыПретензии КАК ВТ_ТоварыПретензии
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТоварыЗаказа КАК ВТ_ТоварыЗаказа
	|		ПО ВТ_ТоварыПретензии.Номенклатура = ВТ_ТоварыЗаказа.Номенклатура
	|			И ВТ_ТоварыПретензии.Характеристика = ВТ_ТоварыЗаказа.Характеристика
	|			И ВТ_ТоварыПретензии.Серия = ВТ_ТоварыЗаказа.Серия
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Ссылка КАК РеализацияТоваровУслугСсылка
	|ИЗ
	|	ВТ_ТоварыПретензии КАК ВТ_ТоварыПретензии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ПО ВТ_ТоварыПретензии.Основание = РеализацияТоваровУслугТовары.ЗаказКлиента
	|			И ВТ_ТоварыПретензии.Номенклатура = РеализацияТоваровУслугТовары.Номенклатура
	|			И ВТ_ТоварыПретензии.Характеристика = РеализацияТоваровУслугТовары.Характеристика
	|			И ВТ_ТоварыПретензии.Серия = РеализацияТоваровУслугТовары.Серия";
	
	Если ТипЗнч(МассивОбъектов) = Тип("Массив") Тогда 
		Запрос.УстановитьПараметр("Ссылка", МассивОбъектов[МассивОбъектов.Количество() - 1]); 
	Иначе
		Запрос.УстановитьПараметр("Ссылка", МассивОбъектов.Основание);
	КонецЕсли;	
		
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанныхДляПечати = Новый Структура;
	СтруктураДанныхДляПечати.Вставить("РезультатПоШапке", ПакетРезультатовЗапроса[2]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоТабличнойЧасти", ПакетРезультатовЗапроса[ПакетРезультатовЗапроса.Количество() - 2]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоРеализациям", ПакетРезультатовЗапроса[ПакетРезультатовЗапроса.Количество() - 1]);
	
	Возврат СтруктураДанныхДляПечати;
	
КонецФункции

Функция смартРазбитьСтрокуНаПодстроки(ТекстСтроки, МаксимальнаяДлинаСтрок)
	
	Результат 			= Новый Массив;
	МассивПодстрок 		= СтрРазделить(ТекстСтроки, ",");	
	ПодстрокаВРезультат = ""; 
	Для Каждого Подстрока Из МассивПодстрок Цикл
		Если СтрДлина(ПодстрокаВРезультат + ", " + Подстрока) <= МаксимальнаяДлинаСтрок Тогда
			ПодстрокаВРезультат = ПодстрокаВРезультат + ?(ЗначениеЗаполнено(ПодстрокаВРезультат), ", ", "") + СокрЛП(Подстрока);
		Иначе
			Результат.Добавить(ПодстрокаВРезультат);
			ПодстрокаВРезультат = Подстрока;
		КонецЕсли;		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПодстрокаВРезультат) Тогда
		Результат.Добавить(ПодстрокаВРезультат);
	КонецЕсли;	
	
    Возврат Результат;

КонецФункции // РазбитьСтрокуНаПодстроки

