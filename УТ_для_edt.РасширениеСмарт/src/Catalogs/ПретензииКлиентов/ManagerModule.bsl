	//-- #3900 смарт: Тимофеева 06.08.2025 
	#КонецВставки

КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024 

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&ИзменениеИКонтроль("Печать")
Процедура смарт_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПретензияКлиента") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"ПретензияКлиента",
		НСтр("ru = 'Претензия клиента'"),
		СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати));

		ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
	КонецЕсли;
	
	#Вставка
	//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПретензияКлиентаСНоменклатурой") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПретензияКлиентаСНоменклатурой",
			НСтр("ru = 'Претензия клиента с номенклатурой'"),
			смартСформироватьПечатнуюФормуСНоменклатурой(МассивОбъектов, ОбъектыПечати));

		ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
		
	КонецЕсли;
	//-- #1844 смарт: Мосолов 10.06.2024 
	#КонецВставки 
	
	#Вставка
	//++ #3900 смарт: Тимофеева 06.08.2025 / Создать печатную форму документа Претензия
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПретензияКлиентаДляПодписи") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПретензияКлиентаДляПодписи",
			НСтр("ru = 'Претензия клиента, для подписи'"),
			смартСформироватьПечатнуюФормуДляПодписи(МассивОбъектов, ОбъектыПечати));

		ФормированиеПечатныхФорм.ЗаполнитьПараметрыОтправки(ПараметрыВывода.ПараметрыОтправки, МассивОбъектов, КоллекцияПечатныхФорм);
		
	КонецЕсли;
	//-- #3900 смарт: Тимофеева 06.08.2025 
	#КонецВставки  
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
Функция смартСформироватьПечатнуюФормуСНоменклатурой(ПретензияКлиента, ОбъектыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПретензииКлиентов.Ссылка КАК Ссылка,
	|	ПретензииКлиентов.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА ПретензииКлиентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПретензийКлиентов.Зарегистрирована)
	|				ИЛИ ПретензииКлиентов.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПретензийКлиентов.Обрабатывается)
	|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПретензииКлиентов.Статус)
	|		ИНАЧЕ &Рассмотрена
	|	КОНЕЦ КАК ПредставлениеСтатус,
	|	ПретензииКлиентов.Статус КАК Статус,
	|	ПретензииКлиентов.ОписаниеПретензии КАК ОписаниеПретензии,
	|	ПретензииКлиентов.РезультатыОтработки КАК РезультатыОтработки,
	|	ПретензииКлиентов.ДатаРегистрации КАК ДатаРегистрации,
	|	ПретензииКлиентов.ДатаОкончания КАК ДатаОкончания,
	|	ПретензииКлиентов.Ответственный КАК Ответственный
	|ИЗ
	|	Справочник.ПретензииКлиентов КАК ПретензииКлиентов
	|ГДЕ
	|	ПретензииКлиентов.Ссылка = &ПретензияКлиента";
	
	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст =
	"ВЫБРАТЬ
	|	ПретензииКлиентовсмартТовары.Номенклатура.Артикул КАК Артикул,
	|	ПретензииКлиентовсмартТовары.Номенклатура КАК Номенклатура,
	|	ПретензииКлиентовсмартТовары.Серия КАК Серия,
	|	ПретензииКлиентовсмартТовары.Количество КАК Количество,
	|	ПретензииКлиентовсмартТовары.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.ПретензииКлиентов.смартТовары КАК ПретензииКлиентовсмартТовары
	|ГДЕ
	|	ПретензииКлиентовсмартТовары.Ссылка = &ПретензияКлиента";
	
	Если ТипЗнч(ПретензияКлиента) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("ПретензияКлиента", ПретензияКлиента[ПретензияКлиента.Количество() - 1]);
		ЗапросТовары.УстановитьПараметр("ПретензияКлиента", ПретензияКлиента[ПретензияКлиента.Количество() - 1]);
	Иначе
		Запрос.УстановитьПараметр("ПретензияКлиента", ПретензияКлиента);
		ЗапросТовары.УстановитьПараметр("ПретензияКлиента", ПретензияКлиента);
	КонецЕсли;
	Запрос.УстановитьПараметр("Рассмотрена", НСтр("ru = 'Рассмотрена'"));
	
	смартЗаполнитьТабличныйДокументПретензияКлиентаСНоменклатурой(ТабличныйДокумент, Запрос, ЗапросТовары, ОбъектыПечати);
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //-- #1844 смарт: Мосолов 10.06.2024

 
//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
Процедура смартЗаполнитьТабличныйДокументПретензияКлиентаСНоменклатурой(ТабличныйДокумент, Запрос, ЗапросТовары, ОбъектыПечати) Экспорт
	
	ДанныеПечати = Запрос.Выполнить().Выбрать();
	ДанныеПечати.Следующий();
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ПретензииКлиентов.ПФ_MXL_ПретензияКлиентаСНоменклатурой");

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");

	ОбластьЗаголовок.Параметры.ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ДанныеПечати.Наименование + " %1 " + Формат(ДанныеПечати.ДатаРегистрации,"ДЛФ=DD"),НСтр("ru='от'"));
	
	ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьЗаголовок, ДанныеПечати.Ссылка);
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ДанныеПечати);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Если ДанныеПечати.Статус = Перечисления.СтатусыПретензийКлиентов.Удовлетворена 
		ИЛИ ДанныеПечати.Статус = Перечисления.СтатусыПретензийКлиентов.НеУдовлетворена Тогда
	
		ОбластьРассмотрение = Макет.ПолучитьОбласть("Рассмотрение");
		ЗаполнитьЗначенияСвойств(ОбластьРассмотрение.Параметры, ДанныеПечати);
		ТабличныйДокумент.Вывести(ОбластьРассмотрение);
	
	КонецЕсли;  
	
	ДанныеПечатиТовары = ЗапросТовары.Выполнить().Выбрать();
	
	Если ДанныеПечатиТовары.Количество() Тогда
		
		ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
		ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы); 
		
		Пока ДанныеПечатиТовары.Следующий() Цикл 
			
			ОбластьСтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы");
			ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ДанныеПечатиТовары);
			ТабличныйДокумент.Вывести(ОбластьСтрокаТаблицы);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024

