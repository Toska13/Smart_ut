&НаСервереБезКонтекста
Функция смартПолучитьНоменклатуруЗаказаКлиента(Заказ)  
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Заказ", Заказ);
	//++ #Б2802 смарт: Шляпников 15.04.2025 / Изменение справочника "Претензия клиента"
	//старый код закомментил
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ";
	//Запрос.Текст = 
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	Товары.Номенклатура КАК Номенклатура
	//|ИЗ
	//|	РегистрНакопления.ТоварыКОтгрузке.Обороты(, , , ДокументОтгрузки = &Заказ) КАК Товары
	//|ГДЕ
	//|	Товары.КОтгрузкеРасход <> 0";
	//-- #Б2802 смарт: Шляпников 15.04.2025
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	
КонецФункции

&НаСервереБезКонтекста
Функция смартПолучитьСериюНоменклатурыЗаказаКлиента(Заказ, Номенклатура)  
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	//++ #Б2802 смарт: Шляпников 15.04.2025 / Изменение справочника "Претензия клиента"
	//старый код закомментил
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Серия КАК Серия
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.Номенклатура = &Номенклатура";
	//Запрос.Текст = 
	//"ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	Товары.Серия КАК Серия
	//|ИЗ
	//|	РегистрНакопления.ТоварыКОтгрузке.Обороты(
	//|			,
	//|			,
	//|			,
	//|			ДокументОтгрузки = &Заказ
	//|				И Номенклатура = &Номенклатура) КАК Товары
	//|ГДЕ
	//|	Товары.КОтгрузкеРасход <> 0";
	//-- #Б2802 смарт: Шляпников 15.04.2025
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Серия");
	
КонецФункции

//++ #Б2802 смарт: Шляпников 15.04.2025 / Изменение справочника "Претензия клиента"
&НаСервереБезКонтекста
Функция смартПолучитьХарактеристикуНоменклатурыЗаказаКлиента(Заказ, Номенклатура)  
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаТовары.Характеристика КАК Характеристика
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.Номенклатура = &Номенклатура";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Характеристика");
	
КонецФункции

