		ТекущаяСтрока.Номенклатура = РезультатЗакрытия;
		ТекущаяСтрока.Серия = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");
		
	КонецЕсли;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыСерияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.смартТовары.ТекущиеДанные;

	СписокСерий = смартПолучитьСериюНоменклатурыЗаказаКлиента(Объект.Основание, ТекущаяСтрока.Номенклатура);
	
	Если СписокСерий.Найти(ТекущаяСтрока.Серия) = Неопределено Тогда
		
		ТекущаяСтрока.Серия = ПредопределенноеЗначение("Справочник.Серия.ПустаяСсылка");
		
		ПоказатьПредупреждение(Неопределено, "Серия не найдена в списке отгруженных!");
		
	КонецЕсли; 
	
	ТекущаяСтрока.Количество = 0;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024 

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыСерияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.смартТовары.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		
		ПоказатьПредупреждение(Неопределено, "Перед выбором серии необходимо выбрать номенклатуру!");
		Возврат;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокСерий = смартПолучитьСериюНоменклатурыЗаказаКлиента(Объект.Основание, ТекущаяСтрока.Номенклатура);
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", СписокСерий);
		
		ПараметрыФормыВыбораСерии = Новый Структура;
		ПараметрыФормыВыбораСерии.Вставить("Отбор", Отбор);
		ПараметрыФормыВыбораСерии.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы); 
		ПараметрыФормыВыбораСерии.Вставить("ВидНоменклатуры", 
				ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.Номенклатура, "ВидНоменклатуры")); 
		
		Оповещение = Новый ОписаниеОповещения("смартТоварыСерияПослеВыбора", ЭтотОбъект);
		ОткрытьФорму("Справочник.СерииНоменклатуры.ФормаВыбора", ПараметрыФормыВыбораСерии, Элемент, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024 

