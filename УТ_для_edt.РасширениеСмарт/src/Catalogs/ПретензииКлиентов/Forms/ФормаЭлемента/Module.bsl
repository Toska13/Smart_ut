//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыКоличествоПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.смартТовары.ТекущиеДанные;

	МаксимальноеКоличество = смартПолучитКоличествоЗаказаКлиента(Объект.Основание, ТекущаяСтрока.Номенклатура, ТекущаяСтрока.Характеристика, ТекущаяСтрока.Серия);
	
	//++ #Б4372 смарт: Шляпников 07.10.2025 / Ошибка ЖР. Справочник Претензии клиентов
	Если МаксимальноеКоличество <> NULL И МаксимальноеКоличество <> Неопределено Тогда
		
		Если ТекущаяСтрока.Количество > МаксимальноеКоличество Тогда
			ТекущаяСтрока.Количество = МаксимальноеКоличество;
		КонецЕсли;
		
	Иначе
		ТекущаяСтрока.Количество = 0;
	КонецЕсли;
	//-- #Б4372 смарт: Шляпников 07.10.2025
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024 

//++ #Б2802 смарт: Шляпников 15.04.2025 / Изменение справочника "Претензия клиента"
&НаКлиенте
Процедура смарт_ОбработкаВыбораПосле(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ПретензииКлиентов.Форма.смартФормаПодбораТоваровИЗЗаказа" Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
			
			Если Объект.смартТовары.НайтиСтроки(ВыбранноеЗначение).Количество() = 0 Тогда
				
				НоваяСтрока = Объект.смартТовары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыбранноеЗначение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

