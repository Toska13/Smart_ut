//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.смартТовары.ТекущиеДанные;

	СписокНоменклатуры = смартПолучитьНоменклатуруЗаказаКлиента(Объект.Основание);
	
	Если СписокНоменклатуры.Найти(ТекущаяСтрока.Номенклатура) = Неопределено Тогда
		
		ТекущаяСтрока.Номенклатура = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
		
		ПоказатьПредупреждение(Неопределено, "Номенклатура не найдена в списке отгруженных!");
		
	КонецЕсли; 
	
	ТекущаяСтрока.Серия = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");
	ТекущаяСтрока.Количество = 0;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024 

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если ЗначениеЗаполнено(Объект.Основание) И ТипЗнч(Объект.Основание) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		СтандартнаяОбработка = Ложь;
			
		СписокНоменклатуры = смартПолучитьНоменклатуруЗаказаКлиента(Объект.Основание);
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", СписокНоменклатуры);
		
		ПараметрыФормыВыбораНоменклатуры = Новый Структура;
		ПараметрыФормыВыбораНоменклатуры.Вставить("Отбор", Отбор);
		ПараметрыФормыВыбораНоменклатуры.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
		
		Оповещение = Новый ОписаниеОповещения("смартТоварыНоменклатураПослеВыбора", ЭтотОбъект);
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормыВыбораНоменклатуры, Элемент, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры //-- #1844 смарт: Мосолов 10.06.2024  

//++ #1844 смарт: Мосолов 10.06.2024 //Доработка Претензии клиента
&НаКлиенте
Процедура смартТоварыНоменклатураПослеВыбора(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	ТекущаяСтрока = Элементы.смартТовары.ТекущиеДанные;
	
