
#Область ПеренесеноСДоработкамиСмарт

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекПроверяемыеРеквизитыИнтереса = Неопределено;
	Если Параметры.Свойство("Настройки") Тогда
		ЗаполнитьЗначенияСвойств(Объект, Параметры.Настройки);
		ЭтоНовыйОбъект = Ложь;
		Если Параметры.Настройки.Свойство("ЭтоНовыйОбъект", ЭтоНовыйОбъект) И ЭтоНовыйОбъект И Не ЗначениеЗаполнено(Объект.ОбязательноеПланированиеАктивности) Тогда
			Объект.ОбязательноеПланированиеАктивности = Перечисления.CRM_ПланируемыеТипыАктивности.Взаимодействие;
		КонецЕсли;
		Если Параметры.Настройки.Свойство("ПроверяемыеРеквизитыИнтереса") Тогда
			ТекПроверяемыеРеквизитыИнтереса = Параметры.Настройки.ПроверяемыеРеквизитыИнтереса;
		КонецЕсли;
		Если Параметры.Настройки.Свойство("БлокируемыеРеквизитыИнтереса") Тогда
			ТекБлокируемыеРеквизитыИнтереса = Параметры.Настройки.БлокируемыеРеквизитыИнтереса;
		КонецЕсли;
	ИначеЕсли Параметры.Свойство("Ссылка") Тогда
		ТекПроверяемыеРеквизитыИнтереса = Параметры.Ссылка.ПроверяемыеРеквизитыИнтереса.Получить();
		ТекБлокируемыеРеквизитыИнтереса = Параметры.Ссылка.БлокируемыеРеквизитыИнтереса.Получить();
		ЗначениеВРеквизитФормы(Параметры.Ссылка.ПолучитьОбъект(), "Объект");
		ЗаписыватьОбъект = Истина;
	КонецЕсли;
	
	ЭтоПоддержка = (Объект.Родитель.ЭтоПоддержка);
	Элементы.КатегорияСостояния.Видимость = ЭтоПоддержка;
	Элементы.ГруппаВеротяность.Видимость = Не ЭтоПоддержка;
	Элементы.ОжидаемыйСрокНаЭтапе.Видимость = Не ЭтоПоддержка И Не Объект.Завершено;
	Если ЭтоПоддержка Тогда
		Элементы.ИнтерактивноеПланированиеАктивностей.Заголовок =
			НСтр("ru = 'Планировать дела при изменении состояния обращения в АРМ ""Поддержка""'");
	КонецЕсли;
	
	Элементы.НеСоздаватьЗадачу.Видимость = (Объект.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.Первое);
	
	Заголовок = НСтр("ru='Настройка состояния';en='Stage Settings'")+": "+Объект.Наименование;
	
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	
	Если Объект.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение 
	 Или Объект.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение Тогда
		Элементы.ГруппаОбязательноеПланирование.Видимость = Ложь; 	 
	КонецЕсли;
	
	ЗаполнитьПроверяемыеРеквизитыИнтереса(ЭтоПоддержка, ТекПроверяемыеРеквизитыИнтереса, ТекБлокируемыеРеквизитыИнтереса);

	#Вставка
	//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
	Если Параметры.Свойство("Настройки") Тогда
		МассивТипыУслуг = Параметры.Настройки.МассивТипыУслуг;
	ИначеЕсли Параметры.Свойство("Ссылка") Тогда
		МассивТипыУслуг = Параметры.Ссылка.смартТипыУслуг.ВыгрузитьКолонку("ТипУслуги");
	КонецЕсли;	

	смартДобавитьНаФормуТипыУслуг(МассивТипыУслуг);
	//-- #1945 смарт: Лопато 06.08.2024
	#КонецВставки
	
КонецПроцедуры

&НаСервере
&Перед("ЗаполнитьПроверяемыеРеквизитыИнтереса")
//++ #1785 смарт: Фролов 22.04.2024 //Доработка помошника создания Интереса.
Процедура смарт_ЗаполнитьПроверяемыеРеквизитыИнтереса(ЭтоПоддержка, ТекПроверяемыеРеквизитыИнтереса, ТекБлокируемыеРеквизитыИнтереса)
	
	РеквизитМД = Метаданные.Документы.CRM_Интерес.Реквизиты.Найти("смартИтоговаяКвалификация");
	Если РеквизитМД <> Неопределено Тогда
		НовСтр = ПроверяемыеРеквизитыИнтереса.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Новый Структура("Реквизит, Синоним", "смартИтоговаяКвалификация", РеквизитМД.Синоним));
	КонецЕсли;
	
	//++ #Б-3860 смарт: Фролов 15.08.2025 //CRM. Продажа оборудования. Дополнительные условия на этапе
	РеквизитМД = Метаданные.Документы.CRM_Интерес.Реквизиты.Найти("смартДатаОтправкиДоговора");
	Если РеквизитМД <> Неопределено Тогда
		НовСтр = ПроверяемыеРеквизитыИнтереса.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Новый Структура("Реквизит, Синоним", "смартДатаОтправкиДоговора", РеквизитМД.Синоним));
	КонецЕсли;
	//-- #Б-3860 смарт: Фролов 15.08.2025
	
	//++ #Б-1020 смарт: Фролов 01.10.2024 //Запретить перевод с этапа квалифицирован далее без указания товаров в тч товары
	РеквизитМД = Метаданные.Документы.CRM_Интерес.ТабличныеЧасти.Найти("Товары");
	Если РеквизитМД <> Неопределено Тогда
		НовСтр = ПроверяемыеРеквизитыИнтереса.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Новый Структура("Реквизит, Синоним", "Товары", "Обязательное наличие товаров"));
	КонецЕсли;
    //-- #Б-1020 смарт: Фролов 01.10.2024
	
	//++ #Б2454 смарт: Шляпников 07.03.2025 / Заблокировать область в документе Интерес
	РеквизитМД = Метаданные.Документы.CRM_Интерес.Реквизиты.Найти("смартСтатусРегистрацияПользователяНаСайте");
	Если РеквизитМД <> Неопределено Тогда
		НовСтр = ПроверяемыеРеквизитыИнтереса.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Новый Структура("Реквизит, Синоним", "смартСтатусРегистрацияПользователяНаСайте", РеквизитМД.Синоним));
	КонецЕсли;
	//-- #Б2454 смарт: Шляпников 07.03.2025
	
КонецПроцедуры //-- #1785 смарт: Фролов 22.04.2024

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаКлиенте
&ИзменениеИКонтроль("Готово")
Процедура смарт_Готово(Команда)

	Если ЭтоПоддержка И Объект.КатегорияСостояния.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.ПутьКДанным = "КатегорияСостояния";
		Сообщение.Текст = НСтр("ru='Не заполнена категория !'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	МассивПроверяемыхРеквизитовТемп = Новый Массив;
	МассивБлокируемыхРеквизитовТемп = Новый Массив;
	Для каждого Строка из ПроверяемыеРеквизитыИнтереса Цикл
		Если Строка.ПроверкаЗаполнения Тогда
			МассивПроверяемыхРеквизитовТемп.Добавить(Строка.Реквизит);
		КонецЕсли;
		Если Строка.ТолькоПросмотр Тогда
			МассивБлокируемыхРеквизитовТемп.Добавить(Строка.Реквизит);
		КонецЕсли;
	КонецЦикла;
	МассивПроверяемыхРеквизитов = Новый ФиксированныйМассив(МассивПроверяемыхРеквизитовТемп);
	МассивБлокируемыхРеквизитов = Новый ФиксированныйМассив(МассивБлокируемыхРеквизитовТемп);
	
	Если ЗаписыватьОбъект Тогда
		Записать();
	КонецЕсли;
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПроверяемыеРеквизитыИнтереса", МассивПроверяемыхРеквизитов);
	Настройки.Вставить("БлокируемыеРеквизитыИнтереса", МассивБлокируемыхРеквизитов);
	Настройки.Вставить("ОбязательноеПланированиеАктивности", Объект.ОбязательноеПланированиеАктивности);
	Настройки.Вставить("ИнтерактивноеПланированиеАктивностей", Объект.ИнтерактивноеПланированиеАктивностей);
	Настройки.Вставить("ЗавершатьЗапланированныеАктивности", Объект.ЗавершатьЗапланированныеАктивности);
	Настройки.Вставить("ОтборЗавершаемыхАктивностей", Объект.ОтборЗавершаемыхАктивностей);
	Настройки.Вставить("УказыватьДостигнутыйРезультат", Объект.УказыватьДостигнутыйРезультат);
	Настройки.Вставить("РазрешитьРолевуюАдресацию", Объект.РазрешитьРолевуюАдресацию);
	Настройки.Вставить("ДобавитьВероятностьВПредставлениеСостояния", Объект.ДобавитьВероятностьВПредставлениеСостояния);
	Настройки.Вставить("ВероятностьСделки", Объект.ВероятностьСделки);
	Настройки.Вставить("ИндексЦвета", Объект.ИндексЦвета);

	#Вставка
	//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
	Настройки.Вставить("МассивТипыУслуг", ПолучитьМассивТиповУслугНеПоказывать());
	//-- #1945 смарт: Лопато 06.08.2024
	#КонецВставки
	
	Закрыть(Настройки);
	
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаСервере
Процедура смартДобавитьНаФормуТипыУслуг(МассивТипыУслуг)
	
	МассивРеквизитов = Новый Массив; 

	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартТипыУслуг", 
		Новый ОписаниеТипов("ТаблицаЗначений"), "", "Типы услуг"));
		
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартТипыУслугТипУслуги", 
		Новый ОписаниеТипов("СправочникСсылка.CRM_ТипУслуги"), "смартТипыУслуг", "Тип услуги"));
		
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартТипыУслугНеПоказывать", 
		Новый ОписаниеТипов("Булево"), "смартТипыУслуг", "Не показывать"));

	ИзменитьРеквизиты(МассивРеквизитов);
	
	//Формирование таблицы значений
	ТЗсмартТипыУслуг = РеквизитФормыВЗначение("смартТипыУслуг"); 
	
	МассивВсеТипыУслуг = Справочники.CRM_ТипУслуги.МассивТиповУслуг();
	
	Для Каждого ТипУслуги Из МассивВсеТипыУслуг Цикл

		НоваяСтрокаТаблицы = ТЗсмартТипыУслуг.Добавить();
		
		НоваяСтрокаТаблицы.смартТипыУслугТипУслуги 	  = ТипУслуги;
		НоваяСтрокаТаблицы.смартТипыУслугНеПоказывать = МассивТипыУслуг.Найти(ТипУслуги) <> Неопределено; 
		
	КонецЦикла;	

	ЗначениеВРеквизитФормы(ТЗсмартТипыУслуг, "смартТипыУслуг");

	// Отрисовка таблицы формы
	НоваяГруппа = Элементы.Вставить("смартГруппаТипыУслуг", Тип("ГруппаФормы"), , Элементы.ГруппаКнопки);
	НоваяГруппа.Вид 				= ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Истина;
	НоваяГруппа.Заголовок 			= "Типы услуг";
	
	Для Каждого ЭлементМассива Из МассивРеквизитов Цикл
	
		Если ЭлементМассива.ТипЗначения = Новый ОписаниеТипов("ТаблицаЗначений") Тогда
			
			НовыйЭлемент = Элементы.Добавить(ЭлементМассива.Имя, Тип("ТаблицаФормы"), Элементы.смартГруппаТипыУслуг);
			НовыйЭлемент.ПутьКДанным 			  = ЭлементМассива.Имя;
			НовыйЭлемент.Доступность 			  = Истина;
			НовыйЭлемент.Отображение 			  = ОтображениеТаблицы.Список;
			НовыйЭлемент.ПоложениеЗаголовка 	  = ПоложениеЗаголовкаЭлементаФормы.Нет;
			НовыйЭлемент.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
			НовыйЭлемент.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ПоСодержимому;
			
		Иначе
			
			НовыйЭлемент = Элементы.Добавить(ЭлементМассива.Имя, Тип("ПолеФормы"), Элементы.смартТипыУслуг);
			НовыйЭлемент.Вид 		 = ВидПоляФормы.ПолеФлажка;	
			НовыйЭлемент.ПутьКДанным = Элементы.смартТипыУслуг.Имя + "." + ЭлементМассива.Имя;							
			
		КонецЕсли;
		
	КонецЦикла;	
		
КонецПроцедуры //-- #1945 смарт: Лопато 06.08.2024

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаСервере
Функция ПолучитьМассивТиповУслугНеПоказывать()
	
	МассивТипыУслуг = Новый Массив;
	
	ТЗсмартТипыУслуг = РеквизитФормыВЗначение("смартТипыУслуг"); 
	
	Для Каждого СтрТипУслуги Из ТЗсмартТипыУслуг Цикл
		
		Если СтрТипУслуги.смартТипыУслугНеПоказывать Тогда
			МассивТипыУслуг.Добавить(СтрТипУслуги.смартТипыУслугТипУслуги);
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат МассивТипыУслуг;
	
КонецФункции //-- #1945 смарт: Лопато 06.08.2024

#КонецОбласти
