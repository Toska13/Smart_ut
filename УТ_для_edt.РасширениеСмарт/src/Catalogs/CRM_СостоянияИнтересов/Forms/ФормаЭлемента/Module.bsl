
#Область ПеренесеноСДоработкамиСмарт

&НаСервере
//++ #1656 смарт: Фролов 28.02.2024 //Создание механизма отображения необходимых действий менеджером, на каждом этапе обработки Интереса.
Процедура смарт_ПриЧтенииНаСервереПосле(ТекущийОбъект)
	
	ЭтаФорма.смартОписаниеЭтапаПоле = ТекущийОбъект.смартОписаниеЭтапа.Получить();
	
КонецПроцедуры //-- #1656 смарт: Фролов 28.02.2024

&НаСервере
//++ #1656 смарт: Фролов 28.02.2024 //Создание механизма отображения необходимых действий менеджером, на каждом этапе обработки Интереса.
Процедура смарт_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.смартОписаниеЭтапа = Новый ХранилищеЗначения(ЭтаФорма.смартОписаниеЭтапаПоле);
	
КонецПроцедуры //-- #1656 смарт: Фролов 28.02.2024

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаКлиенте
&ИзменениеИКонтроль("ДекорацияНастройкиНажатие")
Процедура смарт_ДекорацияНастройкиНажатие(Элемент)
	Настройки = Новый  Структура;
	Настройки.Вставить("ПроверяемыеРеквизитыИнтереса", ПроверяемыеРеквизитыИнтереса);
	Настройки.Вставить("БлокируемыеРеквизитыИнтереса", БлокируемыеРеквизитыИнтереса);
	Настройки.Вставить("ОбязательноеПланированиеАктивности", Объект.ОбязательноеПланированиеАктивности);
	Настройки.Вставить("ИнтерактивноеПланированиеАктивностей", Объект.ИнтерактивноеПланированиеАктивностей);
	Настройки.Вставить("ЗавершатьЗапланированныеАктивности", Объект.ЗавершатьЗапланированныеАктивности);
	Настройки.Вставить("ОтборЗавершаемыхАктивностей", Объект.ОтборЗавершаемыхАктивностей);
	Настройки.Вставить("УказыватьДостигнутыйРезультат", Объект.УказыватьДостигнутыйРезультат);
	Настройки.Вставить("РазрешитьРолевуюАдресацию", Объект.РазрешитьРолевуюАдресацию);
	Настройки.Вставить("ВидСостояния", Объект.ВидСостояния);
	Настройки.Вставить("ДобавитьВероятностьВПредставлениеСостояния", Объект.ДобавитьВероятностьВПредставлениеСостояния);
	Настройки.Вставить("ВероятностьСделки", Объект.ВероятностьСделки);
	Настройки.Вставить("ИндексЦвета", Объект.ИндексЦвета);
	Настройки.Вставить("ЭтоНовыйОбъект", Объект.Ссылка.Пустая());
	Настройки.Вставить("Родитель", Объект.Родитель);

	#Вставка
	//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
	МассивТипыУслуг = Новый Массив;
	
	Для Каждого СтрТипУслуги Из Объект.смартТипыУслуг Цикл
		МассивТипыУслуг.Добавить(СтрТипУслуги.ТипУслуги);
	КонецЦикла;	
	
	Настройки.Вставить("МассивТипыУслуг", МассивТипыУслуг);
	//-- #1945 смарт: Лопато 06.08.2024
	#КонецВставки
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеРедактированияНастроек", ЭтотОбъект);
	ПараметрыОткрытия = Новый Структура("Настройки", Настройки);
	ОткрытьФорму("Справочник.CRM_СостоянияИнтересов.Форма.ФормаНастройкиСостояния", ПараметрыОткрытия, ЭтотОбъект,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаКлиенте
&ИзменениеИКонтроль("ЗавершениеРедактированияНастроек")
Процедура смарт_ЗавершениеРедактированияНастроек(Настройки, ДопПараметры)
	
	Если Настройки<>Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Объект, Настройки);
		ПроверяемыеРеквизитыИнтереса = Настройки.ПроверяемыеРеквизитыИнтереса;
		БлокируемыеРеквизитыИнтереса = Настройки.БлокируемыеРеквизитыИнтереса;
		
		#Вставка
		//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
		Объект.смартТипыУслуг.Очистить();
		
		Для Каждого ТипУслуги Из Настройки.МассивТипыУслуг Цикл

			НоваяСтрокаТипУслуги = Объект.смартТипыУслуг.Добавить();
			НоваяСтрокаТипУслуги.ТипУслуги = ТипУслуги;
			
		КонецЦикла;	
		//-- #1945 смарт: Лопато 06.08.2024
		#КонецВставки
		
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти