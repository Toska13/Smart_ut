#Область РаботаСБизнесРегионами

//++ #1537 смарт: Мосолов 09.01.2024 //Запрет создания элементов справочника Бизнес-регионы 
Функция смартПолучитьДанныеВыбораБизнесРегиона(ТекстПоиска) Экспорт

	СписокДанныхВыбора = Новый СписокЗначений;
	
	Запрос = Новый Запрос;   
	Запрос.УстановитьПараметр("ТекстПоиска", ТекстПоиска + "%"); 
	
	Запрос.УстановитьПараметр("МассивСокращенийРайонов", смартПолучитьМассивИсключенийСокращенийАдресныхОбъектов());  
	Запрос.УстановитьПараметр("МассивИсключенийРегионов", смартПолучитьМассивИсключенийРегионовАдресныхОбъектов());  
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БизнесРегионы.Ссылка КАК Ссылка,
	|	БизнесРегионы.СмартКодСубъектаРФ КАК Код,
	|	БизнесРегионы.Наименование КАК Наименование,
	|	БизнесРегионы.Родитель КАК Родитель
	|ПОМЕСТИТЬ БизнесРегионыСубьекты
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	БизнесРегионы.СмартКодСубъектаРФ <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 15
	|	АдресныеОбъекты.КодКЛАДР КАК КодКЛАДР,
	|	АдресныеОбъекты.Наименование + "", "" + АдресныеОбъекты.Сокращение КАК НаселенныйПункт,
	|	ВЫБОР
	|		КОГДА БизнесРегионыСправочник.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВСправочнике,
	|	АдресныеОбъекты.Идентификатор КАК Идентификатор,
	|	АдресныеОбъектыРодитель.Наименование КАК Район,
	|	ВЫБОР
	|		КОГДА БизнесРегионыСубьекты.Ссылка ЕСТЬ NULL
	|			ТОГДА АдресныеОбъектыРодитель.Наименование
	|		ИНАЧЕ БизнесРегионыСубьекты.Родитель.Наименование + "" - "" + БизнесРегионыСубьекты.Наименование
	|	КОНЕЦ КАК Регион,
	|	ЕСТЬNULL(БизнесРегионыСправочник.Ссылка, ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)) КАК БизнесРегион,
	|	АдресныеОбъекты.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА БизнесРегионыСубьекты.Ссылка ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
	|		ИНАЧЕ БизнесРегионыСубьекты.Ссылка
	|	КОНЕЦ КАК РегионСправочник
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БизнесРегионы КАК БизнесРегионыСправочник
	|		ПО АдресныеОбъекты.Идентификатор = БизнесРегионыСправочник.СмартИдентификаторФНС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АдресныеОбъекты КАК АдресныеОбъектыРодитель
	|		ПО АдресныеОбъекты.РодительскийИдентификатор = АдресныеОбъектыРодитель.Идентификатор
	|		ЛЕВОЕ СОЕДИНЕНИЕ БизнесРегионыСубьекты КАК БизнесРегионыСубьекты
	|		ПО АдресныеОбъекты.КодСубъектаРФ = БизнесРегионыСубьекты.Код
	|ГДЕ
	|	ВЫБОР
	|		КОГДА АдресныеОбъекты.КодСубъектаРФ В (&МассивИсключенийРегионов)
	|			ТОГДА АдресныеОбъекты.Уровень МЕЖДУ 1 И 6
	|		ИНАЧЕ АдресныеОбъекты.Уровень МЕЖДУ 2 И 6
	|	КОНЕЦ
	|	И НЕ АдресныеОбъекты.Сокращение В (&МассивСокращенийРайонов)
	|	И АдресныеОбъекты.Наименование ПОДОБНО &ТекстПоиска
	|	И АдресныеОбъекты.КодСубъектаРФ В
	|			(ВЫБРАТЬ
	|				БизнесРегионыСубьекты.Код
	|			ИЗ
	|				БизнесРегионыСубьекты КАК БизнесРегионыСубьекты)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	БизнесРегионы.Наименование,
	|	ИСТИНА,
	|	"""",
	|	"""",
	|	ВЫБОР
	|		КОГДА БизнесРегионы.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
	|			ТОГДА БизнесРегионы.Родитель.Наименование
	|		ИНАЧЕ БизнесРегионы.Родитель.Родитель.Наименование + "" - "" + БизнесРегионы.Родитель.Наименование
	|	КОНЕЦ,
	|	БизнесРегионы.Ссылка,
	|	БизнесРегионы.Наименование,
	|	БизнесРегионы.Родитель
	|ИЗ
	|	Справочник.БизнесРегионы КАК БизнесРегионы
	|ГДЕ
	|	БизнесРегионы.Наименование ПОДОБНО &ТекстПоиска
	|	И БизнесРегионы.Родитель <> ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
	|	И ВЫБОР
	|		КОГДА БизнесРегионы.Родитель.Родитель = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)
	|			ТОГДА БизнесРегионы.СмартКодСубъектаРФ = 0
	|		ИНАЧЕ БизнесРегионы.Родитель.СмартКодСубъектаРФ = 0
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьВСправочнике УБЫВ,
	|	Наименование"; 
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		Представление = Выборка.Регион + ?(Выборка.Район = "", "", "; " + Выборка.Район) + "; " + Выборка.НаселенныйПункт;
		
		Если Выборка.ЕстьВСправочнике Тогда
			СписокДанныхВыбора.Добавить(Выборка.БизнесРегион, Представление);
		Иначе
			СтруктураДанныхВыбора = Новый Структура;
			СтруктураДанныхВыбора.Вставить("РегионСправочник", Выборка.РегионСправочник);
			СтруктураДанныхВыбора.Вставить("Наименование", Выборка.Наименование);
			СтруктураДанныхВыбора.Вставить("КодКЛАДР", Выборка.КодКЛАДР);
			СтруктураДанныхВыбора.Вставить("Идентификатор", Выборка.Идентификатор);  
			
			СписокДанныхВыбора.Добавить(СтруктураДанныхВыбора, Представление);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокДанныхВыбора;
	
КонецФункции //-- #1537 смарт: Мосолов 09.01.2024   

//++ #1537 смарт: Мосолов 09.01.2024 //Запрет создания элементов справочника Бизнес-регионы   
&НаСервере
Функция смартСоздатьБизнесРегион(ДанныеЗаполнения) Экспорт 
	
	БизнесРегион = Справочники.БизнесРегионы.СоздатьЭлемент();
	БизнесРегион.Наименование = ДанныеЗаполнения.Наименование;  
	БизнесРегион.CRM_КодКЛАДР = ДанныеЗаполнения.КодКЛАДР;
	БизнесРегион.СмартИдентификаторФНС = ДанныеЗаполнения.Идентификатор; 
	БизнесРегион.Родитель = ДанныеЗаполнения.РегионСправочник;
	БизнесРегион.Записать();
	
	Возврат БизнесРегион.Ссылка;
	
КонецФункции //-- #1537 смарт: Мосолов 09.01.2024

//++ #1537 смарт: Мосолов 09.01.2024 //Запрет создания элементов справочника Бизнес-регионы   
&НаСервере
Функция смартПолучитьМассивИсключенийСокращенийАдресныхОбъектов() Экспорт 
	
	МассивСокращенийРайонов = Новый Массив;
	МассивСокращенийРайонов.Добавить("р-н");
	
	Возврат МассивСокращенийРайонов;
	
КонецФункции //-- #1537 смарт: Мосолов 09.01.2024

//++ #1537 смарт: Мосолов 22.01.2024 //Запрет создания элементов справочника Бизнес-регионы   
&НаСервере
Функция смартПолучитьМассивИсключенийРегионовАдресныхОбъектов() Экспорт 
	
	МассивИсключенийРегионов = Новый Массив;
	МассивИсключенийРегионов.Добавить(77); //г. Москва
	МассивИсключенийРегионов.Добавить(78); //г. Санкт-Петербург
	МассивИсключенийРегионов.Добавить(92); //г. Севастополь
	МассивИсключенийРегионов.Добавить(99); //г. Байконур
	
	Возврат МассивИсключенийРегионов;
	
КонецФункции //-- #1537 смарт: Мосолов 22.01.2024

#КонецОбласти

