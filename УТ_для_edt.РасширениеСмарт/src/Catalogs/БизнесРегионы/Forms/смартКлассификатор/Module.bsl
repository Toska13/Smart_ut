
//++ #1537 смарт: Мосолов 26.12.2023 //Запрет создания элементов справочника Бизнес-регионы   
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ТекущийРегион", ТекущийРегион);
	
	Элементы.НадписьПоискПоРегиону.Заголовок = "в " + Параметры.ПоискПоРегиону.Наименование;
	
	Список.Параметры.УстановитьЗначениеПараметра("СписокРегионов", Параметры.СписокРегионов);   
	Список.Параметры.УстановитьЗначениеПараметра("ФО", Параметры.ФО.Наименование); 
	
	Список.Параметры.УстановитьЗначениеПараметра("МассивСокращенийРайонов", Справочники.БизнесРегионы.смартПолучитьМассивИсключенийСокращенийАдресныхОбъектов());   
	
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

//++ #1537 смарт: Мосолов 26.12.2023 //Запрет создания элементов справочника Бизнес-регионы   
&НаКлиенте
Процедура смартУстановитьОтбор(ИмяЭлемента, Значение)
   
   ПолеСКД = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
   
   ЭлементОтбора = Неопределено;
   
   Для Каждого Элемент Из Список.Отбор.Элементы Цикл
       Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
           Если Элемент.ЛевоеЗначение = ПолеСКД Тогда
               ЭлементОтбора = Элемент;
               Прервать;
           КонецЕсли;
       КонецЕсли;
   КонецЦикла;
   
   Если ЭлементОтбора = Неопределено Тогда
       ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
       ЭлементОтбора.ЛевоеЗначение = ПолеСКД;
   КонецЕсли;
   
   ЭлементОтбора.Использование = НЕ ПустаяСтрока(СокрЛП(Значение));
   
   Если НЕ ЭлементОтбора.Использование Тогда
       Возврат;
   КонецЕсли; 
   
   ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит;
   ЭлементОтбора.ПравоеЗначение = СокрЛП(Значение);
   
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

//++ #1537 смарт: Мосолов 26.12.2023 //Запрет создания элементов справочника Бизнес-регионы   
&НаКлиенте
Процедура смартСтрокаПоискаПриИзменении(Элемент)
	
	смартУстановитьОтбор("НаселенныйПункт", СтрокаПоиска);
	
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

&НаКлиенте
Процедура смартВыбрать(Команда)
	
	ТекСтрока = Элементы.Список.ТекущаяСтрока;
	
	Если ТекСтрока = Неопределено Тогда
		ПоказатьПредупреждение(Неопределено, "Не выбрана строка с населенным пунктом!");
		Возврат;
	КонецЕсли;  
	
	смартСоздатьНаселенныйПунктОповеститьОВыборе(ТекСтрока);
	
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

//++ #1537 смарт: Мосолов 26.12.2023 //Запрет создания элементов справочника Бизнес-регионы   
&НаКлиенте
Процедура смартСписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	смартСоздатьНаселенныйПунктОповеститьОВыборе(ВыбраннаяСтрока); 
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

//++ #1537 смарт: Мосолов 26.12.2023 //Запрет создания элементов справочника Бизнес-регионы   
&НаКлиенте
Процедура смартСоздатьНаселенныйПунктОповеститьОВыборе(ТекСтрока)
	
	ТекДанные = Элементы.Список.ДанныеСтроки(ТекСтрока);
	
	Если Не ЗначениеЗаполнено(ТекДанные.БизнесРегион) Тогда
		БизнесРегион = смартСоздатьБизнесРегион(ТекДанные);
	Иначе
		БизнесРегион = ТекДанные.БизнесРегион;
	КонецЕсли;  
	
	ОповеститьОВыборе(БизнесРегион);  
	
КонецПроцедуры //-- #1537 смарт: Мосолов 26.12.2023

