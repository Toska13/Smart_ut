	НоваяКолонка.Вид = ВидПоляФормы.ПолеФлажка;
	//-- #Б-3858 смарт: Фролов 18.07.2025
	
	//++ #Б-7838 смарт: Фролов 12.08.2026 //Уведомления для Беловой Т.
	ПолесмартКонтролируемыеМенеджеры = Элементы.Добавить("смартКонтролируемыеМенеджеры", Тип("ТаблицаФормы"),
