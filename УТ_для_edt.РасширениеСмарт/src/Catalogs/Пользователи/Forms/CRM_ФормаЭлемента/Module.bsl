&НаКлиенте
Процедура смарт_НедействителенПриИзмененииПосле(Элемент)

	//++#1352 смарт: Лопато 10.05.2023 //Звонки из 1С (через городской стационарный телефон)  
	Если НЕ Параметры.Ключ.Пустая() И НЕ Объект.Недействителен И смартПроверитьПользовательБылНедействителен() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Очищены внутренние номера телефонов: Внутр.: " + СокрЛП(Объект.смартРабочийТелефон) 
												+ ", ВАТС: " + СокрЛП(Объект.смартВнутреннийНомерВАТС),
												//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
												+ ", ВАТС дополнительный: " + СокрЛП(Объект.смартВнутреннийНомерВАТСДополнительный),
												//-- #Б-6744 смарт: Фролов 28.05.2026
			Объект.Ссылка,
			"Объект.смартРабочийТелефон");

		Объект.смартРабочийТелефон 	 	= Неопределено;
		Объект.смартВнутреннийНомерВАТС = Неопределено;
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		Объект.смартВнутреннийНомерВАТСДополнительный = Неопределено;
		//-- #Б-6744 смарт: Фролов 28.05.2026
	КонецЕсли;	
	//--#1352 смарт: Лопато 10.05.2023

КонецПроцедуры

