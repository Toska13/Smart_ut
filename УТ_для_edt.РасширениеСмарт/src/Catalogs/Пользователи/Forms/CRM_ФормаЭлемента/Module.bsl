//++#1352 смарт: Лопато 10.05.2023 //Звонки из 1С (через городской стационарный телефон)  
&НаСервере
Функция смартПроверитьПользовательБылНедействителен()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Пользователи.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка = &ТекущийПользовательСсылка
		|	И Пользователи.Недействителен";
	
	Запрос.УстановитьПараметр("ТекущийПользовательСсылка", Объект.Ссылка);

	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции //--#1352 смарт: Лопато 10.05.2023

//++#1352 смарт: Лопато 10.05.2023 //Звонки из 1С (через городской стационарный телефон)  
&НаСервере
Процедура смартПроверитьДублиНомеров(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Пользователи.Ссылка КАК Ссылка,
		|	Пользователи.смартРабочийТелефон,
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		|	Пользователи.смартВнутреннийНомерВАТСДополнительный,
		//-- #Б-6744 смарт: Фролов 28.05.2026
		|	Пользователи.смартВнутреннийНомерВАТС
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка <> &ТекущийПользовательСсылка
		|	И НЕ Пользователи.Недействителен
		|	И ((Пользователи.смартРабочийТелефон <> """" И Пользователи.смартРабочийТелефон = &смартРабочийТелефон)
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		//|	   ИЛИ (Пользователи.смартВнутреннийНомерВАТС <> """" И Пользователи.смартВнутреннийНомерВАТС = &смартВнутреннийНомерВАТС))";
		|	   ИЛИ (Пользователи.смартВнутреннийНомерВАТС <> """" И Пользователи.смартВнутреннийНомерВАТС = &смартВнутреннийНомерВАТС)
		|	   ИЛИ (Пользователи.смартВнутреннийНомерВАТСДополнительный <> """" И Пользователи.смартВнутреннийНомерВАТСДополнительный = &смартВнутреннийНомерВАТСДополнительный))";
		
	Запрос.УстановитьПараметр("смартВнутреннийНомерВАТСДополнительный", Объект.смартВнутреннийНомерВАТСДополнительный);
	//-- #Б-6744 смарт: Фролов 28.05.2026
	Запрос.УстановитьПараметр("смартРабочийТелефон", Объект.смартРабочийТелефон);
	Запрос.УстановитьПараметр("смартВнутреннийНомерВАТС", Объект.смартВнутреннийНомерВАТС);
	Запрос.УстановитьПараметр("ТекущийПользовательСсылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Объект.смартРабочийТелефон) И Объект.смартРабочийТелефон = РезультатЗапроса.смартРабочийТелефон Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Пользователю """ + СокрЛП(РезультатЗапроса.Ссылка) + """ уже назначен номер телефона: внутр.: " + СокрЛП(Объект.смартРабочийТелефон),
				Объект.Ссылка,
				"Объект.смартРабочийТелефон",
				,
				Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.смартВнутреннийНомерВАТС) И Объект.смартВнутреннийНомерВАТС = РезультатЗапроса.смартВнутреннийНомерВАТС Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Пользователю """ + СокрЛП(РезультатЗапроса.Ссылка) + """ уже назначен номер телефона: ВАТС: " + СокрЛП(Объект.смартВнутреннийНомерВАТС),
				Объект.Ссылка,
				"Объект.смартВнутреннийНомерВАТС",
				,
				Отказ);
		КонецЕсли;
		
		//++ #Б-6744 смарт: Фролов 28.05.2026 //Перехват заявок. Загрузка звонков в 1С с нескольких мобильных менеджеров
		Если ЗначениеЗаполнено(Объект.смартВнутреннийНомерВАТСДополнительный) И Объект.смартВнутреннийНомерВАТСДополнительный = РезультатЗапроса.смартВнутреннийНомерВАТСДополнительный Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Пользователю """ + СокрЛП(РезультатЗапроса.Ссылка) + """ уже назначен номер телефона: ВАТС дополнительный: " + СокрЛП(Объект.смартВнутреннийНомерВАТСДополнительный),
				Объект.Ссылка,
				"Объект.смартВнутреннийНомерВАТСДополнительный",
				,
				Отказ);
		КонецЕсли;
		//-- #Б-6744 смарт: Фролов 28.05.2026	
			
	КонецЦикла;	
	
КонецПроцедуры //--#1352 смарт: Лопато 10.05.2023

