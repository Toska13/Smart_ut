&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("смартОтображаемыеПользователи") 
		И ТипЗнч(Параметры.смартОтображаемыеПользователи) = Тип("СписокЗначений") Тогда
		
		ВидСравненияКД = ВидСравненияКомпоновкиДанных.ВСписке;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			ПользователиСписок,
			"Ссылка",
			Параметры.смартОтображаемыеПользователи,
			ВидСравненияКД);
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 28.02.2021
