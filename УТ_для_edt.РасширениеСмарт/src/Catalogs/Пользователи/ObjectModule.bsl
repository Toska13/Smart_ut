	//++#1352 смарт: Лопато 04.05.2023 //Звонки из 1С (через городской стационарный телефон)  
	смартРабочаяПочта 		 = Неопределено;
	смартРабочийТелефон 	 = Неопределено;
	смартВнутреннийНомерВАТС = Неопределено;
	//--#1352 смарт: Лопато 04.05.2023
	
