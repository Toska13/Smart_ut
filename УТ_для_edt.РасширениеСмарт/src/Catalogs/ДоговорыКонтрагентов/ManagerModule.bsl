// Смарт Фролов+
// Функция проверяет есть ли движения по Договору
// Входной парареметр Договор Тип("СсылкаСпраовочник.ДоговорыКонтрагентов")
// Возвращаемое заначение Тип("Булево")
Функция ПоДоговоруЕстьДвижения(Договор) Экспорт 
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Договор",Договор);
	//++ смарт:Каратеев 1496 11.10.2023 //Исправить определения движений по договору (блокировка)
	//Условия отбора соответствуют бизнес - процессам:
	// - можно править договор, когда по договору есть только Заказ клиента
	// - договор должен разблокироваться, если все документы помечены на удаление/распроведены
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РеестрДокументов.Договор КАК Договор,
	|	РеестрДокументов.ТипСсылки КАК ТипСсылки,
	|	РеестрДокументов.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.РеестрДокументов КАК РеестрДокументов
	|ГДЕ
	|	РеестрДокументов.Договор = &Договор
	|	И НЕ ТИПЗНАЧЕНИЯ(РеестрДокументов.Ссылка) = ТИП(Документ.ЗаказКлиента)
	|	И РеестрДокументов.Проведен";
	//-- смарт:Каратеев 1496 11.10.2023 //
	УстановитьПривилегированныйРежим(Истина);
	Рез=Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Не Рез.Пустой() Тогда 
		Возврат Истина;
	КонецЕсли;	
	
	Возврат Ложь;
КонецФункции
