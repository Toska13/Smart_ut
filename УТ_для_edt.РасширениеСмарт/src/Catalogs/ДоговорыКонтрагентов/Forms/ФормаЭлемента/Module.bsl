	Элементы.Наименование.СписокВыбора.Очистить();
	если ЗначениеЗаполнено(объект.номер) и ЗначениеЗаполнено(объект.Дата) тогда
		Элементы.Наименование.СписокВыбора.Добавить(Объект.номер + " от " + формат(объект.Дата,"ДФ=dd.MM.yyyy"));
	КонецЕсли;;
	
	если ЗначениеЗаполнено(объект.номер) и не ЗначениеЗаполнено(объект.Дата) тогда
		Элементы.Наименование.СписокВыбора.Добавить(Объект.номер);
	КонецЕсли;

	если не ЗначениеЗаполнено(объект.номер) и не ЗначениеЗаполнено(объект.Дата) тогда
		Элементы.Наименование.СписокВыбора.Очистить();
	КонецЕсли;	
