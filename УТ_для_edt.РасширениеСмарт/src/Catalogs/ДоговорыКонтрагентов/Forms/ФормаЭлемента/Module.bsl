//++ #3940 смарт: Ермаков 04.08.2025 / Договор клиента. Дополнения.
&НаКлиенте
Процедура смарт_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//++ #Б-6270 смарт: Фролов 01.04.2026 //Заявка на ремонтные работы. Добавить реквизит для ДС. Обновить доработку по сервисным договорам РТО.
	Если Объект.смартДополнительноеСоглашение И Не ЗначениеЗаполнено(Объект.смартДополнительноеСоглашениеДата) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена дата дополнительного соглашения!", , "Объект.смартДополнительноеСоглашениеДата", , Отказ);
		
	КонецЕсли;
	//-- #Б-6270 смарт: Фролов 01.04.2026
	
	//++ #3940 смарт: Ермаков 04.08.2025 / Договор клиента. Дополнения.
	Если Не Отказ Тогда
		
		// Если сумма процентов по строкам не равна 100
		Если Объект.смартПравилаОплаты.Количество() > 0 Тогда
			
			Если Не Объект.смартПравилаОплаты.Итог("ПроцентПлатежа") = 100 Тогда
				
				ТекстОшибки = НСтр("ru='Проценты оплат разнесены некорректно.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ТекстОшибки,
					Объект.Ссылка,
					"Объект.смартПравилаОплаты",,
					Отказ);
				
			КонецЕсли;
				
		КонецЕсли;
			
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		// Если даты по строкам не последовательны
		Для Каждого СтрокаТаблицы Из Объект.смартПравилаОплаты Цикл
			
			Если Объект.смартПравилаОплаты.Индекс(СтрокаТаблицы) = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ПредыдущаяСтрока = 
				Объект.смартПравилаОплаты[Объект.смартПравилаОплаты.Индекс(СтрокаТаблицы) - 1];
				
			Если СтрокаТаблицы.ДатаПлатежа <= ПредыдущаяСтрока.ДатаПлатежа Тогда
					
				ТекстОшибки = НСтр("ru='Некорректная последовательность дат платежей.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(
					ТекстОшибки,
					Объект.Ссылка,
					"Объект.смартПравилаОплаты",,
					Отказ);									
					
				Прервать;
					
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		Если ЭтаФорма["смартТаблицаПравилаОплатыИзменена"] 
			И Объект.смартПравилаОплаты.Количество() > 0 Тогда
			
			Отказ = Истина;
			ЭтаФорма["смартТаблицаПравилаОплатыИзменена"] = Ложь;
			
			ПоказатьПредупреждение(
				Новый ОписаниеОповещения("смартПослеВыводаПредупрежденияОбИзмененииТаблицыПравилаОплаты", ЭтаФорма),
				"Внимание! Измененные реквизиты оплат необходимо актуализировать в связанном Заказе клиента.",
				120,
				"Информация об изменениях"
			);
				
		КонецЕсли;
		
	КонецЕсли;
	//-- #3940 смарт: Ермаков 04.08.2025
	
КонецПроцедуры

