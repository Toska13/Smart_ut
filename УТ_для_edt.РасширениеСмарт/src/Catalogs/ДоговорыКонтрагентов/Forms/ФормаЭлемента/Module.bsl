		ИЛИ Объект.ТипДоговора = Перечисления.ТипыДоговоров.Импорт Тогда
		
		Если Объект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным
		 ИЛИ Объект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.ПоДоговорамПослеНакладных	 
		 Тогда

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В договоре на поставку в поле ""Оформление поступления доступно"" не должно быть установлено значение ""После оформления накладной""'"), , "ОформлениеОрдера");

			Отказ = Не Пользователи.ЭтоПолноправныйПользователь();		
			
		КонецЕсли;
		
	КонецЕсли;
	//--#1575 смарт: Лопато 18.12.2023
	
	//++ #Б-2064 смарт: Фролов 31.01.2025 //Создание пользователя ИМ на основании договора поставки. Регистрация клиента на сайте.
	ЭтаФорма.смартДоговорПодписанКонтроль = Объект.Ссылка.смартДоговорПодписан;
