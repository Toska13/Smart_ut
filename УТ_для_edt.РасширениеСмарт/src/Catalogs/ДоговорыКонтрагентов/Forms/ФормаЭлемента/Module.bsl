&НаСервере
Процедура смартЗаполнитьСписокВыбораАдресаОбслуживания()
//смарт+ Вахов Владимир /398 / 17.03.2021   
	СписокВыбора = Новый СписокЗначений;

	// Адреса из Контрагента и Партнера
	АдресаИзКонтактнойИнформации = смартАдресаИзКонтактнойИнформации(Объект.Партнер, Объект.Контрагент);
	
	Для Каждого Стр Из АдресаИзКонтактнойИнформации Цикл
		
		НайденныйЭлемент = ДоставкаТоваровКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
		
		Если НайденныйЭлемент = Неопределено Тогда
			СтруктураВыбора = смартСтруктураВыбора();
			ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
			СписокВыбора.Добавить(СтруктураВыбора, Стр.Вид + ": " + Стр.АдресДоставки);
		Иначе
			смартДозаполнитьПустыеСвойства(НайденныйЭлемент.Значение, Стр);
		КонецЕсли;
		
	КонецЦикла;
	
	смартСкопироватьСписокЗначений(Элементы.смартАдресОбслуживания.СписокВыбора, СписокВыбора);
	//++ #1368 смарт: Фролов 07.06.2023 //Договор на перемывку чернил  
	смартСкопироватьСписокЗначений(Элементы.смартАдресОбслуживания1.СписокВыбора, СписокВыбора);
	//-- #1368 смарт: Фролов 07.06.2023
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция смартАдресаИзКонтактнойИнформации(Партнер, Контрагент)
//смарт+ Вахов Владимир /398 / 17.03.2021   
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК АдресДоставки,
		|	КонтактнаяИнформация.Вид.Представление КАК Вид,
		|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Партнер
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтактнаяИнформация.Представление КАК АдресДоставки,
		|	КонтактнаяИнформация.Вид.Представление КАК Вид,
		|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей
		|ИЗ
		|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Контрагент
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)");
		
	Запрос.УстановитьПараметр("Партнер", 	Партнер);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция смартСтруктураВыбора()
//смарт+ Вахов Владимир /398 / 17.03.2021   
	
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("АдресДоставки", "");
	СтруктураВыбора.Вставить("АдресДоставкиЗначенияПолей", "");
	СтруктураВыбора.Вставить("ЗонаДоставки", Справочники.ЗоныДоставки.ПустаяСсылка());
	СтруктураВыбора.Вставить("ВремяДоставкиС", Дата(1,1,1));
	СтруктураВыбора.Вставить("ВремяДоставкиПо", Дата(1,1,1));
	СтруктураВыбора.Вставить("ДополнительнаяИнформацияПоДоставке", "");
	
	Возврат СтруктураВыбора;
	
КонецФункции

&НаСервереБезКонтекста
Процедура смартДозаполнитьПустыеСвойства(СтруктураПриемник, Источник)
//смарт+ Вахов Владимир /398 / 17.03.2021   
	
	СтруктураЗаполнения = Новый Структура;
	Для Каждого Элемент Из СтруктураПриемник Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтруктураЗаполнения.Вставить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Источник);
	ЗаполнитьЗначенияСвойств(СтруктураПриемник, СтруктураЗаполнения);
	
КонецПроцедуры

