//++ #Б-2064 смарт: Фролов 11.02.2025 //Создание пользователя ИМ на основании договора поставки. Регистрация клиента на сайте.
Процедура смартПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.Настройки.ДатаНачалаКонтроляПользователяИМВДоговоре)
		И ТекущийОбъект.Дата >= Справочники.смартПредопределенныеЗначения.Настройки.ДатаНачалаКонтроляПользователяИМВДоговоре Тогда
		
		Если НЕ ЭтаФорма.смартДоговорПодписанКонтроль И ТекущийОбъект.смартДоговорПодписан 
			И ЗначениеЗаполнено(ТекущийОбъект.смартКонтактноеЛицоДляЛК) 
			И НЕ ЗначениеЗаполнено(ТекущийОбъект.смартКонтактноеЛицоДляЛК.смартЛогинНаСайте) Тогда
			
			Результат = смартИнтернетМагазин.ЗарегистрироватьПользователяНаСайте(Объект.смартКонтактноеЛицоДляЛК, Объект.смартТелефонДляЛК, Объект.смартЭлектроннаяПочтаДляЛК);	
			
			Если НЕ Результат = Истина Тогда
				ОбщегоНазначения.СообщитьПользователю("Не удаллось зарегистрировать пользователя личного кабинета по причине:"
				+ Символы.ПС + Результат + Символы.ПС + "Запись не возможна!");
				Отказ = Истина;
			КонецЕсли;	
				
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры //-- #Б-2064 смарт: Фролов 11.02.2025	

//++ #Б2762 смарт: Шляпников 08.04.2025 / Автоматические уведомления для Партнёров
&НаСервере
Функция ДоступностьОтправкиУведомленияОГотовностиКПередаче()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("ПроцентОплаты", 30);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Серия КАК Серия
	|ПОМЕСТИТЬ ВТДанныеЗаказа
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ПО ЗаказКлиентаТовары.Ссылка = СостоянияЗаказовКлиентов.Заказ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
	|		ПО ЗаказКлиентаТовары.Номенклатура = НоменклатураСегмента.Номенклатура
	|			И (НоменклатураСегмента.Сегмент.смартИдентификаторДляФормул = ""СегментАппаратноеОбеспечение"")
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка.Договор = &Ссылка
	|	И СостоянияЗаказовКлиентов.ПроцентОплаты >= &ПроцентОплаты
	|	И ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВТДанныеЗаказа.Ссылка.Договор КАК Договор,
	|	ВТДанныеЗаказа.Ссылка.Договор.Номер КАК ДоговорНомер,
	|	ВТДанныеЗаказа.Ссылка.Договор.Дата КАК ДоговорДата,
	|	ВТДанныеЗаказа.Ссылка.Менеджер КАК Менеджер,
	|	ВТДанныеЗаказа.Ссылка.Договор.смартУполномоченноеЛицоЗаПодписаниеДоговораФИО КАК КонтактКлиента,
	|	ВТДанныеЗаказа.Ссылка.Договор.смартЭлектроннаяПочтаДляДоговора КАК ЭлектроннаяПочтаДляДоговора,
	|	ВТДанныеЗаказа.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДанныеЗаказа КАК ВТДанныеЗаказа
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	|				,
	|				(Номенклатура, Серия) В
	|					(ВЫБРАТЬ
	|						Т.Номенклатура,
	|						Т.Серия
	|					ИЗ
	|						ВТДанныеЗаказа КАК Т)) КАК ТоварыНаСкладахОстатки
	|		ПО ВТДанныеЗаказа.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
	|			И ВТДанныеЗаказа.Серия = ТоварыНаСкладахОстатки.Серия";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

//++ #Б2762 смарт: Шляпников 08.04.2025 / Автоматические уведомления для Партнёров
&НаСервере
Функция ПолучитьДанныеДляЗаполненияПисьмаДляОтправкиУведомленияОГотовностиКпередаче()
	
	Результат = Новый Структура;
	
	Тема = СтрШаблон("Уведомление о готовности к передаче по Договору поставки № %1 от %2",
							Объект.Номер,
							Формат(Объект.Дата, "ДФ=dd.MM.yyyy"));
	Результат.Вставить("Тема", Тема);
	
	Тело = СтрШаблон("Уважаемый(ая), %1!
							|
							|Просим ознакомиться с уведомлением.
				            |
							|С уважением,
							|%2
							|ООО ""СМАРТ-Т""", Объект.смартУполномоченноеЛицоЗаПодписаниеДоговораФИО);
	Результат.Вставить("Текст", Тело);
	
	//Получатель = Новый Структура("Адрес,Представление", Объект.смартЭлектроннаяПочтаДляДоговора, Объект.смартУполномоченноеЛицоЗаПодписаниеДоговораФИО);
	//Результат.Вставить("СписокАдресов", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Получатель));
	Результат.Вставить("Кому", Объект.смартЭлектроннаяПочтаДляДоговора);
	
	Вложение = Новый Структура("АдресВоВременномХранилище,Представление");
	Вложение.АдресВоВременномХранилище = Справочники.ДоговорыКонтрагентов.ПолучитьФайлУведомленияОГотовностиКПередаче(Объект.Ссылка);
	Вложение.Представление = СтрШаблон("%1.pdf", Тема);
	Результат.Вставить("Вложения", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Вложение));
	
	Возврат Результат;
							
КонецФункции

//++ #Б2762 смарт: Шляпников 08.04.2025 / Автоматические уведомления для Партнёров
