Процедура смартГрузополучательПриИзменении(Элемент)

	смартУстановитьНадписьАдресГрузополучателя(Объект.смартГрузополучатель);
	
КонецПроцедуры //--#1138 смарт: Лопато 26.09.2022

//++#1138 смарт: Лопато 26.09.2022 //Добавление поля Грузополучатель в договоре для подстановки в Реализацию товаров и услуг.
&НаСервере
Процедура смартУстановитьНадписьАдресГрузополучателя(Грузополучатель)
	
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		Элементы.смартАдресГрузополучателя.Заголовок = смартПолучитьАдресГрузополучателя(Грузополучатель);
		Элементы.смартАдресГрузополучателя.ЦветТекста = Новый Цвет(0, 0, 255);
	Иначе	
		Элементы.смартАдресГрузополучателя.Заголовок = "Грузополучатель не заполнен";
		Элементы.смартАдресГрузополучателя.ЦветТекста = Новый Цвет(255, 0, 0);
	КонецЕсли;
		
КонецПроцедуры //--#1138 смарт: Лопато 26.09.2022

//++#1138 смарт: Лопато 26.09.2022 //Добавление поля Грузополучатель в договоре для подстановки в Реализацию товаров и услуг.
&НаСервереБезКонтекста
Функция смартПолучитьАдресГрузополучателя(Грузополучатель)
	
	Если ЗначениеЗаполнено(Грузополучатель) Тогда
		АдресГрузополучателя = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Грузополучатель,
			Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,
			ТекущаяДатаСеанса());
	Иначе
		АдресГрузополучателя = " ";
	КонецЕсли;	
	
	Возврат АдресГрузополучателя;
	
КонецФункции //--#1138 смарт: Лопато 26.09.2022

//++#1138 смарт: Лопато 26.09.2022 //Добавление поля Грузополучатель в договоре для подстановки в Реализацию товаров и услуг.
&НаСервере
Процедура смартУстановитьСписокВыбораГрузополучателя(КонтрагентДоговора)

	Элементы.смартГрузополучатель.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(КонтрагентДоговора) Тогда
		Элементы.смартГрузополучатель.СписокВыбора.Добавить(КонтрагентДоговора, "Он же");
	КонецЕсли;	
	
КонецПроцедуры //--#1138 смарт: Лопато 26.09.2022

//++#1138 смарт: Лопато 26.09.2022 //Добавление поля Грузополучатель в договоре для подстановки в Реализацию товаров и услуг.
&НаСервере
Процедура смартУстановитьВидимостьДанныеПолейГрузополучателя()
	
	ЭтоДоговорПродажи = Перечисления.ТипыДоговоров.ЭтоДоговорПродажи(Объект.ТипДоговора);

	Элементы.смартГрузополучатель.Видимость = ЭтоДоговорПродажи;
	Элементы.смартАдресГрузополучателя.Видимость = ЭтоДоговорПродажи;
	
	Если ЭтоДоговорПродажи Тогда
		
		смартУстановитьСписокВыбораГрузополучателя(Объект.Контрагент);
		смартУстановитьНадписьАдресГрузополучателя(Объект.смартГрузополучатель);
		
	КонецЕсли;
		
КонецПроцедуры //--#1138 смарт: Лопато 26.09.2022 

