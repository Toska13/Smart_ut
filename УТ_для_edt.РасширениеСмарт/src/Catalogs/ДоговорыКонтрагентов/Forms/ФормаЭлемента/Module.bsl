Процедура смарт_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
//-- #1334 смарт: Фролов 18.04.2023	
	//++#1138 смарт: Лопато 17.10.2022 //Добавление поля Грузополучатель в договоре для подстановки в Реализацию товаров и услуг.
	Если Перечисления.ТипыДоговоров.ЭтоДоговорПродажи(Объект.ТипДоговора) Тогда	
		Если НЕ ЗначениеЗаполнено(Объект.смартГрузополучатель) Тогда	
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен грузополучатель!'"), , "смартГрузополучатель", "Объект.смартГрузополучатель");	
			Если Не УправлениеДоступом.ЕстьРоль("ПолныеПрава") Тогда
				Отказ = Истина;
			КонецЕсли;		
		КонецЕсли;		
	Иначе				
		Если ЗначениеЗаполнено(Объект.смартГрузополучатель) Тогда
			Объект.смартГрузополучатель = Неопределено;
		КонецЕсли;		
	КонецЕсли;	
	//--#1138 смарт: Лопато 17.10.2022
	
	//++#1575 смарт: Лопато 18.12.2023 //В договорах разрешить вариант приемки товаров только "После оформления заказа"  
	Если Объект.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком
