	ПараметрыОткрытия=Новый Структура;
	ПараметрыОткрытия.Вставить("Ключ",Объект.смартЗаказКлиента);
	ОткрытьФорму("Документ.ЗаказКлиента.Форма.ФормаДокумента",ПараметрыОткрытия);
