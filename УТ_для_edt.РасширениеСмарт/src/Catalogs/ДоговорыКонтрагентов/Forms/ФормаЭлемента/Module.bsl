//++ #5440 смарт: Тимофеева 20.01.26 / Новая ставка НДС22. Доработки. Справочник Договоры Контрагентов.
&НаСервере
Функция ЭтоОрганизацияГруппыКомпанийРФ(Организация)	
	Результат 				= Ложь;
	ЮридическийАдрес		= "";
	ЮридическийАдресТаблица	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
															ТекущаяДатаСеанса(), 
															Ложь);
	Если ЮридическийАдресТаблица.Количество() > 0 Тогда 	
		Если ЗначениеЗаполнено(ЮридическийАдресТаблица[0].Значение) Тогда			
			ЮридическийАдрес = ЮридическийАдресТаблица[0].Значение;
		Иначе
			ЮридическийАдрес = ЮридическийАдресТаблица[0].ЗначенияПолей;
		КонецЕсли; 	
		ДанныеСтраны 	= УправлениеКонтактнойИнформацией.СтранаАдресаКонтактнойИнформации(ЮридическийАдрес);		
		Результат 		= ДанныеСтраны.Ссылка = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
	КонецЕсли;
	Возврат Результат;							
КонецФункции          

&НаСервере
&ИзменениеИКонтроль("НалогообложениеНДСПриИзмененииСервер")
Процедура смарт_НалогообложениеНДСПриИзмененииСервер()
	
	#Вставка
	//++ #5440 смарт: Тимофеева 20.01.26 / Новая ставка НДС22. Доработки. Справочник Договоры Контрагентов.
    Если ЭтоОрганизацияГруппыКомпанийРФ(Объект.Организация)
		И Объект.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем 
		И НЕ ЗначениеЗаполнено(Объект.СтавкаНДС) Тогда
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
	КонецЕсли;
	//-- #5440 смарт: Тимофеева 20.01.26
	#КонецВставки
	
	Если Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС
		ИЛИ Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяЕНВД
		ИЛИ Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ОблагаетсяНДСУПокупателя
		ИЛИ Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.РеализацияРаботУслугНаЭкспорт
		ИЛИ Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НалоговыйАгентПоНДС
		//++ Локализация
		ИЛИ Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаПоПатенту
		//-- Локализация
		Тогда 
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;

	Если Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНаЭкспорт Тогда 
		Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС0;
	КонецЕсли;

	Если Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.НалоговыйАгентПоНДС  Тогда 
		Объект.УчетАгентскогоНДС = Истина;
	Иначе
		Объект.УчетАгентскогоНДС = Ложь;
		Объект.ВидАгентскогоДоговора = Перечисления.ВидыАгентскихДоговоров.ПустаяСсылка();
	КонецЕсли;

	УстановитьСвойстваЭлементовНалогообложенияИРаздельногоУчетаНДС();

КонецПроцедуры
