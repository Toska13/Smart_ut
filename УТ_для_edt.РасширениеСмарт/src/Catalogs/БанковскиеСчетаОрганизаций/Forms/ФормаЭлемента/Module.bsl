&НаСервере
Процедура ИспользоватьПоУмолчаниюПриИзмененииНаСервере()
	
	Организация = Объект.Владелец; 
    
    //++ смарт:Подкин #815 24.12.2021 10:46:58
     ВалютаБС= Объект.ВалютаДенежныхСредств;
    //-- смарт:Подкин #815 24.12.2021 10:46:58
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |   БанковскиеСчетаОрганизаций.Ссылка КАК БанковскийСчетОрганизации, 
        //++ смарт:Подкин #1037 26.05.2022 17:06:38
        |   БанковскиеСчетаОрганизаций.смартИспользоватьПоУмолчаниюДляВалюты КАК смартИспользоватьПоУмолчаниюДляВалюты 
        //-- смарт:Подкин #1037 26.05.2022 17:06:38
        |ИЗ
        |   Справочник.БанковскиеСчетаОрганизаций КАК БанковскиеСчетаОрганизаций
        |ГДЕ
        |   НЕ БанковскиеСчетаОрганизаций.ПометкаУдаления
        |   И (БанковскиеСчетаОрганизаций.Владелец = &Организация
        |           ИЛИ &Организация = НЕОПРЕДЕЛЕНО) 
        
        |   И БанковскиеСчетаОрганизаций.ВалютаДенежныхСредств = &ВалютаБС";    
	
	Запрос.УстановитьПараметр("Организация", Организация);
    
    //++ смарт:Подкин #815 24.12.2021 10:46:40
	Запрос.УстановитьПараметр("ВалютаБС", ВалютаБС);
    //-- смарт:Подкин #815 24.12.2021 10:46:40
    
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
    Пока Выборка.Следующий() Цикл 
        //++ смарт:Подкин #1037 26.05.2022 17:09:03
        Если Не Выборка.БанковскийСчетОрганизации.Ссылка = Объект.Ссылка И Выборка.смартИспользоватьПоУмолчаниюДляВалюты Тогда 
            //-- смарт:Подкин #1037 26.05.2022 17:09:03
            
            БанковскийСчет = Выборка.БанковскийСчетОрганизации.ПолучитьОбъект();
            БанковскийСчет.смартИспользоватьПоУмолчаниюДляВалюты = Ложь;
            БанковскийСчет.Записать();
            Сообщить("Со счета "+Выборка.БанковскийСчетОрганизации.Ссылка+" снята пометка Использовать по умолчанию для валюты: "+Объект.ВалютаДенежныхСредств.Наименование);
        КонецЕсли;
    КонецЦикла;
    
	Сообщить("Счет "+Объект.Ссылка+" установлен по умолчанию");
	
КонецПроцедуры
