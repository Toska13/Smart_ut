        Оповещение = Новый ОписаниеОповещения("УстановитьИспользоватьПоУмолчаниюДляВалюты",ЭтотОбъект); 
        ПоказатьВопрос(Оповещение, "Установить данный банковский счет по умолчанию для валюты: "+Объект.ВалютаДенежныхСредств,РежимДиалогаВопрос.ДаНет,0,КодВозвратаДиалога.Да,"Внимание вопрос:");
    КонецЕсли;
КонецПроцедуры //-- смарт:Подкин #815 24.12.2021 11:02:40

