// Смарт Фролов+ Задача № 84
// Процедура после закрытия формы Вопроса
&НаКлиенте
Процедура смартПослеЗакрытияФормыВопроса(Результат,ДопПараметры) Экспорт
	Если Результат=КодВозвратаДиалога.ОК Тогда
		Объект.Статус=ПредопределенноеЗначение("Перечисление.СтатусыСоглашенийСКлиентами.НеСогласовано");
		Объект.Согласован=Ложь;
		ЭтаФорма.Записать();
		Закрывать=Неопределено;
		Если ТипЗнч(смартДопПараметры)=Тип("Структура") И смартДопПараметры.Свойство("ЗакрыватьФорму",Закрывать) И Закрывать Тогда
			ЭтаФорма.Закрыть();
		КонецЕсли;
	Иначе
		смартДопПараметры=Неопределено;
	КонецЕсли;
КонецПроцедуры

// Смарт Задача № 84
// Функция возвращает разрешено ли пользователю записывать Соглашение с произвольными ценами
&НаСервереБезКонтекста
Функция смартРазрешениеПоРолям()
	Возврат РольДоступна("ПолныеПрава") Или РольДоступна("ДобавлениеИзменениеПравилВеденияСделок");
КонецФункции	
