// Смарт Фролов+ Задача № 84
// Событие формы "Перед записью"
&НаКлиенте
Процедура смарт_ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	Если Не смартДопПараметры=Неопределено Тогда // Ошибки уже были, больше о них не сообщаем.
		Возврат;
	КонецЕсли;	
	МассивСтрок=Объект.Товары.НайтиСтроки(Новый Структура("ВидЦены",ПредопределенноеЗначение("Справочник.ВидыЦен.ПустаяСсылка")));
	Если МассивСтрок.Количество() И Не смартРазрешениеПоРолям() Тогда
		// Переходим к первому полю с ошибкой
		Элементы.ГруппаСтраницы.ТекущаяСтраница=Элементы.СтраницаУточнениеПоТоварам;
		Элементы.Товары.ТекущаяСтрока=МассивСтрок[0].ПолучитьИдентификатор();
		Элементы.Товары.ТекущийЭлемент=Элементы.ТоварыВидЦены;
		
		смартДопПараметры=Новый Структура("ЗакрыватьФорму",Ложь);
		
		Оповещение=Новый ОписаниеОповещения("смартПослеЗакрытияФормыВопроса",ЭтаФорма);
		ТекстВопроса="Соглашение не будет действовать (есть 'произвольные' цены).
					|Для согласования 'произвольной цены' обратитесь к руководителю.";
		ПоказатьВопрос(Оповещение,ТекстВопроса,РежимДиалогаВопрос.ОКОтмена,30,,"Записать со статусом 'Не согласовано'?");
	КонецЕсли;
КонецПроцедуры

// Смарт Фролов+ Задача № 84
// Событие формы "Перед закрытием"
&НаКлиенте
Процедура смарт_ПередЗакрытиемПеред(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Перем Закрывать;
	Если ТипЗнч(смартДопПараметры)=Тип("Структура") И смартДопПараметры.Свойство("ЗакрыватьФорму",Закрывать) И Не Закрывать Тогда 
		Отказ=Не Закрывать;
		смартДопПараметры.ЗакрыватьФорму=Истина;
	КонецЕсли;
КонецПроцедуры

