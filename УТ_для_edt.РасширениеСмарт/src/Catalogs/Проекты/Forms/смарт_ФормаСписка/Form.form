    <name>ФормаКоманднаяПанель</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>ПриСозданииНаСервере</name>
  </handlers>
  <saveWindowSettings>true</saveWindowSettings>
  <autoTitle>true</autoTitle>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ПроектыПартнерыИКонтактныеЛица.Ссылка КАК Проект,
	ПроектыПартнерыИКонтактныеЛица.Партнер КАК Партнер,
	ПроектыПартнерыИКонтактныеЛица.КонтактноеЛицо КАК КонтактноеЛицоИзПроекта,
	Партнеры.БизнесРегион КАК БизнесРегион,
	МИНИМУМ(КонтактныеЛицаПартнеров.Ссылка) КАК КонтактноеЛицоПартнера,
	Партнеры.ОсновнойМенеджер КАК ОсновнойМенеджер
ПОМЕСТИТЬ ВТ_Партнеры
ИЗ
	Справочник.Партнеры КАК Партнеры
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Проекты.ПартнерыИКонтактныеЛица КАК ПроектыПартнерыИКонтактныеЛица
		ПО (ПроектыПартнерыИКонтактныеЛица.Партнер = Партнеры.Ссылка)
			И (ПроектыПартнерыИКонтактныеЛица.НомерСтроки = 1)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		ПО (Партнеры.Ссылка = КонтактныеЛицаПартнеров.Владелец)

СГРУППИРОВАТЬ ПО
	ПроектыПартнерыИКонтактныеЛица.Ссылка,
	ПроектыПартнерыИКонтактныеЛица.Партнер,
	ПроектыПартнерыИКонтактныеЛица.КонтактноеЛицо,
	Партнеры.БизнесРегион,
	Партнеры.ОсновнойМенеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Партнеры.Проект КАК Проект,
	ВТ_Партнеры.Партнер КАК Партнер,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_Партнеры.КонтактноеЛицоИзПроекта, ЗНАЧЕНИЕ(Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка)) &lt;> ЗНАЧЕНИЕ(Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка)
			ТОГДА ВТ_Партнеры.КонтактноеЛицоИзПроекта
		ИНАЧЕ ВТ_Партнеры.КонтактноеЛицоПартнера
	КОНЕЦ КАК КонтактноеЛицо,
	ВТ_Партнеры.БизнесРегион КАК БизнесРегион,
	ВТ_Партнеры.ОсновнойМенеджер КАК ОсновнойМенеджер
ПОМЕСТИТЬ ВТ_КонтактныеЛицаПоПроектам
ИЗ
	ВТ_Партнеры КАК ВТ_Партнеры
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВТ_КонтактныеЛицаПартнеров.Проект КАК Проект,
	ВТ_КонтактныеЛицаПартнеров.Партнер КАК Партнер,
	ВТ_КонтактныеЛицаПартнеров.КонтактноеЛицо КАК КонтактноеЛицо,
	ВТ_КонтактныеЛицаПартнеров.БизнесРегион КАК БизнесРегион,
	МАКСИМУМ(КонтактныеЛицаПартнеровКонтактнаяИнформацияТелефон.Представление) КАК ТелефонКонтактногоЛица,
	МАКСИМУМ(ПартнерыКонтактнаяИнформацияТелефон.Представление) КАК ТелефонПартнера,
	МАКСИМУМ(КонтактныеЛицаПартнеровКонтактнаяИнформацияМобильныйТелефон.Представление) КАК МобильныйТелефонКонтактногоЛица,
	МАКСИМУМ(КонтактныеЛицаПартнеровКонтактнаяИнформацияЭлПочта.Представление) КАК ЭлПочтаКонтактногоЛица,
	МАКСИМУМ(ПартнерыКонтактнаяИнформацияЭлПочта.Представление) КАК ЭлПочтаПартнера,
	ВТ_КонтактныеЛицаПартнеров.ОсновнойМенеджер КАК ОсновнойМенеджер
ПОМЕСТИТЬ ВТ_КонтактнаяИнформация
ИЗ
	ВТ_КонтактныеЛицаПоПроектам КАК ВТ_КонтактныеЛицаПартнеров
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформацияТелефон
		ПО (ВТ_КонтактныеЛицаПартнеров.КонтактноеЛицо = КонтактныеЛицаПартнеровКонтактнаяИнформацияТелефон.Ссылка)
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформацияЭлПочта
		ПО (ВТ_КонтактныеЛицаПартнеров.КонтактноеЛицо = КонтактныеЛицаПартнеровКонтактнаяИнформацияЭлПочта.Ссылка)
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияЭлПочта.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияЭлПочта.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailКонтактногоЛица))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформацияТелефон
		ПО (ВТ_КонтактныеЛицаПартнеров.Партнер = ПартнерыКонтактнаяИнформацияТелефон.Ссылка)
			И (ПартнерыКонтактнаяИнформацияТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (ПартнерыКонтактнаяИнформацияТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПартнера))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформацияЭлПочта
		ПО (ВТ_КонтактныеЛицаПартнеров.Партнер = ПартнерыКонтактнаяИнформацияЭлПочта.Ссылка)
			И (ПартнерыКонтактнаяИнформацияЭлПочта.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			И (ПартнерыКонтактнаяИнформацияЭлПочта.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПартнера))
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформацияМобильныйТелефон
		ПО (ВТ_КонтактныеЛицаПартнеров.КонтактноеЛицо = КонтактныеЛицаПартнеровКонтактнаяИнформацияМобильныйТелефон.Ссылка)
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияМобильныйТелефон.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			И (КонтактныеЛицаПартнеровКонтактнаяИнформацияМобильныйТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица))

СГРУППИРОВАТЬ ПО
	ВТ_КонтактныеЛицаПартнеров.Проект,
	ВТ_КонтактныеЛицаПартнеров.Партнер,
	ВТ_КонтактныеЛицаПартнеров.КонтактноеЛицо,
	ВТ_КонтактныеЛицаПартнеров.БизнесРегион,
	ВТ_КонтактныеЛицаПартнеров.ОсновнойМенеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_КонтактнаяИнформация.Проект КАК Проект,
	ВТ_КонтактнаяИнформация.Партнер КАК Партнер,
	ВТ_КонтактнаяИнформация.КонтактноеЛицо КАК КонтактноеЛицо,
	ВТ_КонтактнаяИнформация.БизнесРегион КАК БизнесРегион,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.ТелефонКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.ТелефонКонтактногоЛица
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.МобильныйТелефонКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.МобильныйТелефонКонтактногоЛица
		ИНАЧЕ ВТ_КонтактнаяИнформация.ТелефонПартнера
	КОНЕЦ КАК Телефон,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.ЭлПочтаКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.ЭлПочтаКонтактногоЛица
		ИНАЧЕ ВТ_КонтактнаяИнформация.ЭлПочтаПартнера
	КОНЕЦ КАК ЭлПочта,
	МАКСИМУМ(Контрагенты.ИНН) КАК ИНН,
	ВТ_КонтактнаяИнформация.ОсновнойМенеджер КАК ОсновнойМенеджер
ПОМЕСТИТЬ ВТ_КонтактнаяИнформацияИтог
ИЗ
	ВТ_КонтактнаяИнформация КАК ВТ_КонтактнаяИнформация
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		ПО (ВТ_КонтактнаяИнформация.Партнер = Контрагенты.Партнер)

СГРУППИРОВАТЬ ПО
	ВТ_КонтактнаяИнформация.Проект,
	ВТ_КонтактнаяИнформация.Партнер,
	ВТ_КонтактнаяИнформация.КонтактноеЛицо,
	ВТ_КонтактнаяИнформация.БизнесРегион,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.ТелефонКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.ТелефонКонтактногоЛица
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.МобильныйТелефонКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.МобильныйТелефонКонтактногоЛица
		ИНАЧЕ ВТ_КонтактнаяИнформация.ТелефонПартнера
	КОНЕЦ,
	ВЫБОР
		КОГДА ЕСТЬNULL(ВТ_КонтактнаяИнформация.ЭлПочтаКонтактногоЛица, &quot;&quot;) &lt;> &quot;&quot;
			ТОГДА ВТ_КонтактнаяИнформация.ЭлПочтаКонтактногоЛица
		ИНАЧЕ ВТ_КонтактнаяИнформация.ЭлПочтаПартнера
	КОНЕЦ,
	ВТ_КонтактнаяИнформация.ОсновнойМенеджер
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СправочникПроекты.Ссылка КАК Ссылка,
	СправочникПроекты.ПометкаУдаления КАК ПометкаУдаления,
	СправочникПроекты.Родитель КАК Направление,
	СправочникПроекты.ЭтоГруппа КАК ЭтоГруппа,
	СправочникПроекты.Код КАК Код,
	СправочникПроекты.Наименование КАК Наименование,
	СправочникПроекты.Ответственный КАК Ответственный,
	СправочникПроекты.Предопределенный КАК Предопределенный,
	СправочникПроекты.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	СправочникПроекты.Завершен КАК Завершен,
	СправочникПроекты.Комментарий КАК Комментарий,
	СправочникПроекты.ДатаНачала КАК ДатаНачала,
	СправочникПроекты.ДатаОкончания КАК ДатаОкончания,
	ЕСТЬNULL(ВТ_КонтактнаяИнформацияИтог.Партнер, ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)) КАК Партнер,
	ЕСТЬNULL(ВТ_КонтактнаяИнформацияИтог.КонтактноеЛицо, ЗНАЧЕНИЕ(Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка)) КАК КонтактноеЛицо,
	ЕСТЬNULL(ВТ_КонтактнаяИнформацияИтог.БизнесРегион, ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка)) КАК БизнесРегион,
	ЕСТЬNULL(ВТ_КонтактнаяИнформацияИтог.Телефон, &quot;&quot;) КАК Телефон,
	ЕСТЬNULL(ВТ_КонтактнаяИнформацияИтог.ЭлПочта, &quot;&quot;) КАК ЭлПочта,
	ВЫРАЗИТЬ(ВТ_КонтактнаяИнформацияИтог.ИНН КАК СТРОКА(150)) КАК ИНН,
	ВТ_КонтактнаяИнформацияИтог.ОсновнойМенеджер КАК ОсновнойМенеджер
ИЗ
	Справочник.Проекты КАК СправочникПроекты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтактнаяИнформацияИтог КАК ВТ_КонтактнаяИнформацияИтог
		ПО (СправочникПроекты.Ссылка = ВТ_КонтактнаяИнформацияИтог.Проект)
</queryText>
      <mainTable>Catalog.Проекты</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>Заметки</name>
    <title>
      <key>ru</key>
      <value>Заметки</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникЗаметки.Ссылка КАК Ссылка,
	СправочникЗаметки.Наименование КАК Наименование,
	СправочникЗаметки.Автор КАК Автор,
	СправочникЗаметки.Предмет КАК Предмет,
	СправочникЗаметки.Содержание КАК Содержание,
	СправочникЗаметки.ТекстСодержания КАК ТекстСодержания,
	СправочникЗаметки.ДатаЗаметки КАК ДатаЗаметки
ИЗ
	Справочник.Заметки КАК СправочникЗаметки
ГДЕ
	СправочникЗаметки.Предмет ССЫЛКА Справочник.Партнеры
	И СправочникЗаметки.Предмет = &amp;Предмет
	И НЕ СправочникЗаметки.ЭтоГруппа</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <formCommands>
    <name>СоздатьЗаметку</name>
    <title>
      <key>ru</key>
      <value>Создать заметку</value>
    </title>
    <id>1</id>
    <toolTip>
      <key>ru</key>
      <value>Создать заметку</value>
    </toolTip>
    <use>
      <common>true</common>
    </use>
    <action xsi:type="form:FormCommandHandlerContainer">
      <handler>
        <name>СоздатьЗаметку</name>
      </handler>
    </action>
    <currentRowUse>Auto</currentRowUse>
  </formCommands>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:DynamicListFormExtInfo"/>
</form:Form>
