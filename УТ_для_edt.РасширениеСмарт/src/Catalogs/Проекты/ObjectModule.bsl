&Вместо("ПриЗаписи")
Процедура смарт_ПриЗаписи(Отказ)
	
	Если ЭтоГруппа Тогда 
		// Была ошибка при вызове кода Взаимодействия.УстановитьПризнакАктивен(Ссылка, (НЕ Завершен) И (Не ПометкаУдаления));
		Возврат;
	Иначе
		ПродолжитьВызов(Отказ);
КонецЕсли;

КонецПроцедуры //-- смарт:ММ 15.02.2020
