// Богус++
&НаКлиенте
Процедура ДляПоступленияГрузовПриИзменении(Элемент)
	
	Если Не Объект.ДляПоступленияГрузов Тогда
		Возврат;
	КонецЕсли;	
		
	ДляПоступленияГрузовПриИзмененииСервер();
	
КонецПроцедуры

&НаСервере
Процедура ДляПоступленияГрузовПриИзмененииСервер()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Склады.Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Ссылка <> &Склад
		|	И Склады.ДляПоступленияГрузов";

	Запрос.УстановитьПараметр("Склад", Объект.Ссылка);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		 Объект.ДляПоступленияГрузов = Ложь;
		 Сообщить("Склад для поступления грузов уже существует.");
	КонецЕсли;	 
	
КонецПроцедуры
