&НаКлиенте
Процедура смартДействиеПоказатьИнформацию(Команда)
//++#1221 смарт: Лопато 25.10.2022 //Изменить приоритет склада отгрузки  
	
	Если СтрНайти(Команда.Имя, "смартПриоритетДляСпособаДоставки") <> 0 Тогда

		ИнформацияЗаголовок = "Приоритет для способа доставки";

		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'В поле <b>Приоритет для способа доставки</b> указывается способ доставки, при выборе которого '")
			+ НСтр("ru = 'в документе отгрузки функция заполнения обеспечения будет считать данный склад приоритетным (при прочих равных условиях по доступности товара).'")
			+ Символы.ПС
			+ Символы.ПС
			+ НСтр("ru = 'Если один и тот же способ доставки будет указан в нескольких складах, то более высокий приоритет будет установлен по наименованию склада по принципу сортировки по алфавиту.'")
			);
	//++ #1351 смарт: Фролов 11.05.2023 //Разделение остатков по организациям в заказах  
	ИначеЕсли СтрНайти(Команда.Имя, "смартНазначениеСклада") <> 0 Тогда 
		ИнформацияЗаголовок = "Назначение склада";

		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'В поле <b>Назначение склада</b> указывается вид склада '")
			+ Символы.ПС
			+ НСтр("ru = 'В зависимости от выбранного назначения склада, система будет по разному обрабатывать данные.'")
			+ Символы.ПС
			+ НСтр("ru = 'В частности, получение свободных остатков, для продажи, имеет смысл только для видов <b>Торговый склад</b> и <b>Демо зал</b>.'")
			);
	//-- #1351 смарт: Фролов 11.05.2023
	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;

//--#1221 смарт: Лопато 25.10.2022
КонецПроцедуры	

#КонецОбласти