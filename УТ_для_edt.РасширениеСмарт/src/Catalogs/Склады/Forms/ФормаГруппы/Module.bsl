#Область ПеренесеноСДоработками

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	// подсистема запрета редактирования ключевых реквизитов объектов	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);

	Элементы.ВыборГруппы.СписокВыбора.Очистить();
	Элементы.ВыборГруппы.СписокВыбора.Добавить(Перечисления.ВыборГруппыСкладов.Запретить);

	Если (Не ПолучитьФункциональнуюОпцию("ИспользоватьЗаказыКлиентов")
		И Не ПолучитьФункциональнуюОпцию("ИспользоватьЗаказыПоставщикам")) Тогда

		Элементы.ВыборГруппы.СписокВыбора.Добавить(Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказахИНакладных, НСтр("ru='Разрешить в накладных'"));

	Иначе

		Элементы.ВыборГруппы.СписокВыбора.Добавить(Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказах);
		Элементы.ВыборГруппы.СписокВыбора.Добавить(Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказахИНакладных);

	КонецЕсли;

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	#Вставка
	//++ #Б5778 смарт: Шляпников 24.02.2026 / Проект smart-t.ru. Доработать выгрузку складов
	Группа = смартФормированиеИнтерфейса.СздГруппаОбычная(ЭтаФорма, "смартГруппаВыгрузкаНаСайт", ЭтаФорма, "Параметры выгрузки на сайт", 1);
	
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "смартВыгружатьНаСайт", Группа,, 2, "Объект.смартВыгружатьНаСайт");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "смартНаименованиеНаСайте", Группа,, 1, "Объект.смартНаименованиеНаСайте");
	смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "смартАдресНаСайте", Группа,, 1, "Объект.смартАдресНаСайте");
	
	Структура = Новый Структура("Склад", "Склад");
	смартФормированиеИнтерфейса.СздТаблицаФормы(ЭтаФорма, "смартСкладыОстатковДляСайта", Группа, "Объект.смартСкладыОстатковДляСайта", Структура);
	
	ЭтаФорма.УстановитьДействие("ПередЗаписьюНаСервере", "смарт_ПередЗаписьюНаСервере");
	//-- #Б5778 смарт: Шляпников 24.02.2026
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

&НаСервере
Процедура смарт_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкладысмартСкладыОстатковДляСайта.Ссылка КАК Ссылка,
	|	СкладысмартСкладыОстатковДляСайта.Склад КАК Склад
	|ИЗ
	|	Справочник.Склады.смартСкладыОстатковДляСайта КАК СкладысмартСкладыОстатковДляСайта
	|ГДЕ
	|	СкладысмартСкладыОстатковДляСайта.Склад В(&Склад)
	|	И СкладысмартСкладыОстатковДляСайта.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Склад", Объект.смартСкладыОстатковДляСайта.Выгрузить(, "Склад").ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Склад %1 уже включен в группу складов %2. Запись невозможна !", Выборка.Склад, Выборка.Ссылка),,,, Отказ);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти