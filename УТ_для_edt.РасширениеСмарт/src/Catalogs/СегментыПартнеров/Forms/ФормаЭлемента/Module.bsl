
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	//++ смарт:Демичев №921 22.03.2022     
	НоваяГруппа = Элементы.Вставить("смартГруппаУсловия", Тип("ГруппаФормы"),, Элементы.ГруппаШапкаНиз);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.ОтображатьЗаголовок = Ложь;
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;

	НовыйЭлемент = Элементы.Добавить("смартВычислятьПериод", Тип("ПолеФормы"),Элементы.смартГруппаУсловия);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Объект.смарт_ВычислятьПериод";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ПриИзменненииФлагВычислитьПериод");
		
	НовыйЭлемент = Элементы.Вставить("смарт_ВычисляемыйКодПериод", Тип("ПолеФормы"), Элементы.смартГруппаУсловия);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смарт_ВычисляемыйКодПериод";  
	НовыйЭлемент.Заголовок = "Вычисляемый период(мДатаНачала/мДатаКонец)";
	НовыйЭлемент.Ширина = 30;
	НовыйЭлемент.Высота = 10;
	
	мСпрСегментВип = Справочники.смартПредопределенныеЗначения.СегментВИППартнеров.Значение;
	Если мСпрСегментВип = Объект.Ссылка Тогда
		
		НоваяКоманда = Команды.Добавить("смартВывестиВОтчетСегмент");
		НоваяКоманда.Действие = "смартВывестиВОтчетСегмент";
		НоваяКоманда.Заголовок = "Вывод в отчет (VIP)";
				
		НовыйЭлемент = Элементы.Добавить("ЭлементВыводВипСегмента", Тип("КнопкаФормы"),ЭтаФорма.КоманднаяПанель);
		НовыйЭлемент.ИмяКоманды = "смартВывестиВОтчетСегмент";
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

		
	КонецЕсли;
	
		
	Если Объект.СпособФормирования = Перечисления.СпособыФормированияСегментов.ПериодическиОбновлять Тогда
		
		   ОбновитьЭлементыНаФормеСмарт();
		
	КонецЕсли;		
	//-- смарт:Демичев №921 22.03.2022
	  
КонецПроцедуры

&НаСервере
Процедура ВывестиСоставСегмментаВИП(ТабДокумент)
	
	мДатаНачала = ТекущаяДата();
	мДатаКонец = КонецДня(мДатаНачала);
	
	ПВХИД = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул","ВИПКлиент");
	
	РеквизитыСКДСегмента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
	Объект.Ссылка,
	"СхемаКомпоновкиДанных,ХранилищеНастроекКомпоновкиДанных,ИмяШаблонаСКД");
	
	НастройкиСегмента = РеквизитыСКДСегмента.ХранилищеНастроекКомпоновкиДанных.Получить();	
	
	Если Объект.смарт_ВычислятьПериод и Не ПустаяСтрока(Объект.смарт_ВычисляемыйКодПериод) Тогда
		
		мТекПараметрыДат = НастройкиСегмента.ПараметрыДанных.Элементы.Найти("Период");	
		Если мТекПараметрыДат <> Неопределено Тогда
			
			
			Выполнить(Объект.смарт_ВычисляемыйКодПериод); 
			
		Иначе
			
			мТекПараметрыДатНачало = НастройкиСегмента.ПараметрыДанных.Элементы.Найти("НачалоПериода");	
			мТекПараметрыДатКонец = НастройкиСегмента.ПараметрыДанных.Элементы.Найти("ОкончаниеПериода");	
			
			Если мТекПараметрыДат <> Неопределено и мТекПараметрыДатКонец <> Неопределено Тогда
				
				мДатаНачала = мТекПараметрыДатНачало.Значение;
				мДатаКонец  = мТекПараметрыДатКонец.Значение;
				
			КонецЕсли; 
			
		КонецЕсли;
	КонецЕсли; 
	
	мСпрНоменклатура = Справочники.Номенклатура.ПустаяСсылка();	
	ПолеНоменклатура = Новый ПолеКомпоновкиДанных("Номенклатура");
	
	Для Каждого Элемент Из НастройкиСегмента.Отбор.Элементы Цикл
		Если Элемент.ЛевоеЗначение = ПолеНоменклатура Тогда
			
			мСпрНоменклатура = Элемент.ПравоеЗначение;
			
		КонецЕсли;
	КонецЦикла;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеСведения.Объект КАК Объект,
		|	ДополнительныеСведения.Свойство КАК Свойство,
		|	ДополнительныеСведения.Значение КАК Значение
		|ПОМЕСТИТЬ ВТ_ДопСведение
		|{ВЫБРАТЬ
		|	Объект.*,
		|	Свойство.*,
		|	Значение.*}
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Свойство = &СвойствоВип
		|	И ДополнительныеСведения.Значение = ИСТИНА
		|	И ДополнительныеСведения.Объект ССЫЛКА Справочник.Партнеры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПартнерыСегмента.Партнер КАК Партнер
		|ПОМЕСТИТЬ СоставСегмента
		|{ВЫБРАТЬ
		|	Партнер.*}
		|ИЗ
		|	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
		|ГДЕ
		|	НЕ ПартнерыСегмента.Партнер В
		|				(ВЫБРАТЬ
		|					ВТ_ДопСведение.Объект КАК Объект
		|				ИЗ
		|					ВТ_ДопСведение КАК ВТ_ДопСведение)
		|	И ПартнерыСегмента.Сегмент = &Сегмент
		|{ГДЕ
		|	ПартнерыСегмента.Сегмент}
		|
		|СГРУППИРОВАТЬ ПО
		|	ПартнерыСегмента.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Выручка КАК Выручка,
		|	ВложенныйЗапрос.Себестоимость КАК Себестоимость,
		|	ВложенныйЗапрос.ВаловаяПрибыль КАК ВаловаяПрибыль,
		|	ВложенныйЗапрос.ДопРасходы КАК ДопРасходы,
		|	ВложенныйЗапрос.Партнер КАК Партнер
		|ПОМЕСТИТЬ ВТ_ТЗПоОтбору
		|{ВЫБРАТЬ
		|	Выручка КАК ВыручкаОборот,
		|	Себестоимость КАК СебестоимостьОборот,
		|	ВаловаяПрибыль КАК ВаловаяПрибыльОборот,
		|	ДопРасходы КАК ДопРасходыОборот,
		|	Партнер.* КАК ПартнерСегмента}
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(ВыручкаИСебестоимость.СуммаВыручкиОборот) КАК Выручка,
		|		СУММА(ВыручкаИСебестоимость.СтоимостьОборот) КАК Себестоимость,
		|		СУММА(ВЫРАЗИТЬ(ВыручкаИСебестоимость.СуммаВыручкиОборот - ВыручкаИСебестоимость.ДопРасходыОборот - ВыручкаИСебестоимость.СтоимостьОборот КАК ЧИСЛО(15, 2))) КАК ВаловаяПрибыль,
		|		СУММА(ВыручкаИСебестоимость.ДопРасходыОборот) КАК ДопРасходы,
		|		СоставСегмента.Партнер КАК Партнер
		|	{ВЫБРАТЬ
		|		Выручка,
		|		Себестоимость,
		|		ВаловаяПрибыль,
		|		ДопРасходы,
		|		Партнер.*}
		|	ИЗ
		|		СоставСегмента КАК СоставСегмента
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоПериода {(&НачалоПериода)}, &КонецПериода {(&ОкончаниеПериода)}, Период, АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&СписокНоменклатуры) {(АналитикаУчетаПоПартнерам.Контрагент).* КАК Контрагент, (АналитикаУчетаПоПартнерам.Организация).* КАК Организация, (АналитикаУчетаНоменклатуры.Номенклатура).* КАК Номенклатура}) КАК ВыручкаИСебестоимость
		|			ПО СоставСегмента.Партнер = ВыручкаИСебестоимость.АналитикаУчетаПоПартнерам.Партнер
		|	{ГДЕ
		|		ВыручкаИСебестоимость.АналитикаУчетаНоменклатуры.Номенклатура.* КАК Номенклатура}
		|	
		|	СГРУППИРОВАТЬ ПО
		|		СоставСегмента.Партнер) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПартнерыСегмента.Партнер КАК Партнер
		|ПОМЕСТИТЬ ВТ_СегментСДопСведением
		|{ВЫБРАТЬ
		|	Партнер.*}
		|ИЗ
		|	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
		|ГДЕ
		|	ПартнерыСегмента.Партнер В
		|			(ВЫБРАТЬ
		|				ВТ_ДопСведение.Объект КАК Объект
		|			ИЗ
		|				ВТ_ДопСведение КАК ВТ_ДопСведение)
		|	И ПартнерыСегмента.Сегмент = &Сегмент
		|{ГДЕ
		|	ПартнерыСегмента.Сегмент.*}
		|
		|СГРУППИРОВАТЬ ПО
		|	ПартнерыСегмента.Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.Себестоимость КАК Себестоимость,
		|	ВложенныйЗапрос.ВаловаяПрибыль КАК ВаловаяПрибыль,
		|	ВложенныйЗапрос.ДопРасходы КАК ДопРасходы,
		|	ВложенныйЗапрос.Партнер КАК Партнер,
		|	ВложенныйЗапрос.Выручка КАК Выручка
		|ПОМЕСТИТЬ ВТ_ТЗПоОтборуСДоп
		|{ВЫБРАТЬ
		|	Себестоимость КАК СебестоимостьОборот,
		|	ВаловаяПрибыль КАК ВаловаяПрибыльОборот,
		|	ДопРасходы КАК ДопРасходыОборот,
		|	Партнер.* КАК ПартнерСегмента}
		|ИЗ
		|	(ВЫБРАТЬ
		|		СУММА(ЕСТЬNULL(ВыручкаИСебестоимость.СуммаВыручкиОборот, 0)) КАК Выручка,
		|		СУММА(ЕСТЬNULL(ВыручкаИСебестоимость.СтоимостьОборот, 0)) КАК Себестоимость,
		|		СУММА(ЕСТЬNULL(ВЫРАЗИТЬ(ВыручкаИСебестоимость.СуммаВыручкиОборот - ВыручкаИСебестоимость.ДопРасходыОборот - ВыручкаИСебестоимость.СтоимостьОборот КАК ЧИСЛО(15, 2)), 0)) КАК ВаловаяПрибыль,
		|		СУММА(ЕСТЬNULL(ВыручкаИСебестоимость.ДопРасходыОборот, 0)) КАК ДопРасходы,
		|		ВТ_СегментСДопСведением.Партнер КАК Партнер
		|	{ВЫБРАТЬ
		|		Себестоимость,
		|		ВаловаяПрибыль,
		|		ДопРасходы,
		|		Партнер.*,
		|		Выручка}
		|	ИЗ
		|		ВТ_СегментСДопСведением КАК ВТ_СегментСДопСведением
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачалоПериода {(&НачалоПериода)}, &КонецПериода {(&ОкончаниеПериода)}, Период, АналитикаУчетаНоменклатуры.Номенклатура В ИЕРАРХИИ (&СписокНоменклатуры)) КАК ВыручкаИСебестоимость
		|			ПО ВТ_СегментСДопСведением.Партнер = ВыручкаИСебестоимость.АналитикаУчетаПоПартнерам.Партнер
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВТ_СегментСДопСведением.Партнер) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Партнер КАК Партнер,
		|	ВложенныйЗапрос.Выручка КАК Выручка,
		|	ВложенныйЗапрос.ВаловаяПрибыль КАК ВаловаяПрибыль,
		|	ВложенныйЗапрос.Себестоимость КАК Себестоимость,
		|	ВложенныйЗапрос.ДопРасходы КАК ДопРасходы
		|{ВЫБРАТЬ
		|	Себестоимость,
		|	ВаловаяПрибыль,
		|	ДопРасходы,
		|	Партнер.* КАК ПартнерСегмента}
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВТ_ТЗПоОтбору.Выручка КАК Выручка,
		|		ВТ_ТЗПоОтбору.Себестоимость КАК Себестоимость,
		|		ВТ_ТЗПоОтбору.ВаловаяПрибыль КАК ВаловаяПрибыль,
		|		ВТ_ТЗПоОтбору.ДопРасходы КАК ДопРасходы,
		|		ВТ_ТЗПоОтбору.Партнер КАК Партнер
		|	{ВЫБРАТЬ
		|		Выручка,
		|		Себестоимость,
		|		ВаловаяПрибыль,
		|		ДопРасходы,
		|		Партнер.*}
		|	ИЗ
		|		ВТ_ТЗПоОтбору КАК ВТ_ТЗПоОтбору
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВТ_ТЗПоОтборуСДоп.Выручка,
		|		ВТ_ТЗПоОтборуСДоп.Себестоимость,
		|		ВТ_ТЗПоОтборуСДоп.ВаловаяПрибыль,
		|		ВТ_ТЗПоОтборуСДоп.ДопРасходы,
		|		ВТ_ТЗПоОтборуСДоп.Партнер
		|	ИЗ
		|		ВТ_ТЗПоОтборуСДоп КАК ВТ_ТЗПоОтборуСДоп) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Выручка УБЫВ";

	
	Запрос.УстановитьПараметр("КонецПериода", мДатаКонец);
	Запрос.УстановитьПараметр("НачалоПериода", мДатаНачала);
	Запрос.УстановитьПараметр("СвойствоВип", ПВХИД);
	Запрос.УстановитьПараметр("Сегмент", Объект.Ссылка);
    Запрос.УстановитьПараметр("СписокНоменклатуры", мСпрНоменклатура);

	РезЗапроса = Запрос.Выполнить().Выгрузить();
		
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(РезЗапроса);       
	Построитель.Вывести(ТабДокумент);    
	
КонецПроцедуры	

&НаКлиенте
Процедура смартВывестиВОтчетСегмент(Команда)
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ТабДокумент = Новый ТабличныйДокумент;

		ВывестиСоставСегмментаВИП(ТабДокумент); 
		
		ТабДокумент.АвтоМасштаб = Истина;
		ТабДокумент.ОтображатьСетку = Ложь;
		ТабДокумент.Показать("VIP Сегмент");   
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыНаФормеСмарт()
	
	//++ смарт:Демичев №921 22.03.2022     
	Элементы.смарт_ВычисляемыйКодПериод.Доступность = Объект.смарт_ВычислятьПериод;
    //-- смарт:Демичев №921 22.03.2022

	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзменненииФлагВычислитьПериод(Элемент)
	
	ОбновитьЭлементыНаФормеСмарт();

	
КонецПроцедуры	

&НаКлиенте
&После("УправлениеДоступностью")
Процедура смарт_УправлениеДоступностью()
	
	  //++ смарт:Демичев №921 22.03.2022    
	  ОбновитьЭлементыНаФормеСмарт();
	  //-- смарт:Демичев №921 22.03.2022

КонецПроцедуры
