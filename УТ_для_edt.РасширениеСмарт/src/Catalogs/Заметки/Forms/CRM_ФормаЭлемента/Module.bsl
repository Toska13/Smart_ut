
#Область ПеренесеноСДоработкамиСмарт

//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 06.09.2021 14:21:22
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() И (ТипЗнч(Объект.Предмет)= Тип("СправочникСсылка.Партнеры") 
		ИЛИ ТипЗнч(Объект.Предмет)= Тип("СправочникСсылка.КонтактныеЛицаПартнеров")
		ИЛИ ТипЗнч(Объект.Предмет)= Тип("ДокументСсылка.CRM_Интерес")) Тогда
		Объект.ДляРабочегоСтола = Истина;
		Объект.CRM_ЗаметкаЛенты=Истина;
		Объект.Пометка=Перечисления.ЦветаЗаметок.Желтый;
	КонецЕсли;
	
	//++ #1835 смарт: Фролов 28.05.2024 //Доработка рабочего места секретаря
	Если Объект.Ссылка.Пустая() И Параметры.Свойство("смартИсточник") Тогда
		Объект.смартИсточник = Параметры.смартИсточник;	
	КонецЕсли;
	//-- #1835 смарт: Фролов 28.05.2024
	
	//++ #1830 смарт: Фролов 24.05.2024 //Приведение механизма Заметок в Интересе и Партнере к общему виду.
	ЭтаФорма.Заголовок = "Заметка";
	//-- #1830 смарт: Фролов 24.05.2024
	
КонецПроцедуры

#КонецОбласти