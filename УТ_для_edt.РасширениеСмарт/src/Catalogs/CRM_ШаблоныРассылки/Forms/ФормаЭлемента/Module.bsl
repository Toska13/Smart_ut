&НаКлиенте
&ИзменениеИКонтроль("ФайлШаблонаПослеПомещенияФайла")
Процедура extCRM_ФайлШаблонаПослеПомещенияФайла(Результат, Адрес, ПомещаемыйФайл, ДополнительныеПараметры)

	Если НЕ Результат Тогда Возврат; КонецЕсли;

	ПолучитьИменаФайловНаКлиенте(Адрес, ПомещаемыйФайл);
	Пропустить = Истина;
	ПомещаемыеФайлы = Новый Массив;

	Для Каждого СтрокаКартинки Из СоответствиеФайлов Цикл
		Если Пропустить Тогда
			// Пропустить первую строку
			Пропустить = Ложь;
			Продолжить;
		КонецЕсли;
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(КаталогФайла + СтрокаКартинки.ИмяНаКлиенте, "");
		ПомещаемыеФайлы.Добавить(ОписаниеФайла);
	КонецЦикла;

	Если ПомещаемыеФайлы.Количество() = 0 Тогда
	#Удаление
		ФайлыКартинокПослеПомещения(Неопределено, Новый Структура);
	Иначе
	#КонецУдаления
	#Вставка
		ТекстHTML = ПропарситьHTML();
		Возврат;
	КонецЕсли; 
	#КонецВставки
		ОписаниеОповещения = Новый ОписаниеОповещения("ФайлыКартинокПослеПомещения", ЭтотОбъект);
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы, Ложь, УникальныйИдентификатор);
	#Удаление
	КонецЕсли;
	#КонецУдаления

КонецПроцедуры //--#1542 смарт: Лопато 03.11.2023
