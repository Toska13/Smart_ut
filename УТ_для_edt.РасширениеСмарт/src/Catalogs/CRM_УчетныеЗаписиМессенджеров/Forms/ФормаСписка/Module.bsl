
#Область ПеренесеноСДоработкамиСмарт

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
//++ #Б-3538 смарт: Фролов 10.06.2025 //Иерархия учетных записей мессенджеров и социальных сетей 
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолучитьЛоготипыМессенджеров();

	// Проверка наличия учетных записей
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	CRM_УчетныеЗаписиМессенджеров.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.CRM_УчетныеЗаписиМессенджеров КАК CRM_УчетныеЗаписиМессенджеров
	|ГДЕ
	|	НЕ CRM_УчетныеЗаписиМессенджеров.ПометкаУдаления
	|	И CRM_УчетныеЗаписиМессенджеров.Предопределенный = ЛОЖЬ";

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		НетУчетныхЗаписей = Истина;
	Иначе
		НетУчетныхЗаписей = Ложь;
	КонецЕсли;

	Если Параметры.Свойство("ОткрытьВыборКаналаДиалогов") Тогда
		ОткрытьВыборКаналаДиалогов = Истина;
	КонецЕсли; 
	
	#Вставка 
	//++ #Б-3538 смарт: Фролов 10.06.2025 //Иерархия учетных записей мессенджеров и социальных сетей 
	Список.ТекстЗапроса = "ВЫБРАТЬ
	|	Ссылка КАК Ссылка,
	|	ПометкаУдаления КАК ПометкаУдаления,
	|	Код КАК Код,
	|	Наименование КАК Наименование,
	|	ТипМессенджера КАК ТипМессенджера,
	|	Ответственный КАК Ответственный,
	|	РазрешитьПросмотрСообщенийВсемПользователям КАК РазрешитьПросмотрСообщенийВсемПользователям,
	|	CRM_ИсточникЛидов КАК CRM_ИсточникЛидов,
	|	CRM_УказыватьПричинуОтклонения КАК CRM_УказыватьПричинуОтклонения,
	|	CRM_РольОтветственного КАК CRM_РольОтветственного,
	|	ВЫБОР
	|		КОГДА ТипМессенджера = ""ВКонтакте""
	|			ТОГДА 1
	|		КОГДА ТипМессенджера = ""InstagramDirect""
	|			ТОГДА 2
	|		КОГДА ТипМессенджера = ""Telegram""
	|			ТОГДА 3
	|		КОГДА ТипМессенджера = ""WhatsApp""
	|			ТОГДА 4
	|		КОГДА ТипМессенджера = ""Facebook""
	|			ТОГДА 5
	|		КОГДА ТипМессенджера = ""Viber""
	|			ТОГДА 6
	|		КОГДА ТипМессенджера = ""Instagram""
	|			ТОГДА 7
	|		КОГДА ТипМессенджера = ""ВКонтактеКомментарии""
	|			ТОГДА 8
	|		КОГДА ТипМессенджера = ""СистемаВзаимодействия""
	|			ТОГДА 9
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Иконка,
	|	Включена КАК Включена,
	|	смартГруппаПользователя КАК смартГруппаПользователя,
	|	смартПодразделениеПользователя КАК смартПодразделениеПользователя
	|ИЗ
	|	Справочник.CRM_УчетныеЗаписиМессенджеров";
	
	НовыйЭлемент = Элементы.Добавить("смартГруппаПользователя", Тип("ПолеФормы"), Элементы.Список);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.смартГруппаПользователя";
	
	НовыйЭлемент = Элементы.Добавить("смартПодразделениеПользователя", Тип("ПолеФормы"), Элементы.Список);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Список.смартПодразделениеПользователя";
	//-- #Б-3538 смарт: Фролов 10.06.2025
	#КонецВставки

КонецПроцедуры //-- #Б-3538 смарт: Фролов 10.06.2025

#КонецОбласти
