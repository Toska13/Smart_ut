#Область ДоработкиСмарт

&После("ОбработкаПолученияДанныхВыбора")
Процедура смарт_ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПричиныВозникновенияПретензий.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПричиныВозникновенияПретензий КАК ПричиныВозникновенияПретензий
	|ГДЕ
	|	ПричиныВозникновенияПретензий.смартАктивна
	|	И НЕ ПричиныВозникновенияПретензий.ПометкаУдаления
	|	И ПричиныВозникновенияПретензий.Наименование ПОДОБНО &Наименование";
	
	Если ЗначениеЗаполнено(Параметры.СтрокаПоиска) Тогда
		Запрос.УстановитьПараметр("Наименование", "%" + Параметры.СтрокаПоиска + "%");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ПричиныВозникновенияПретензий.Наименование ПОДОБНО &Наименование", "");
	КонецЕсли;
	
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

#КонецОбласти