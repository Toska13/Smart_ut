//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 11.03.2021 15:55:55- задача 552
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
		
	Элемент = Элементы.Добавить("смартЭлектроннаяПочтаНаСайте", Тип("ПолеФормы"),Элементы.ГруппаДополнительно);
	Элемент.Вид = ВидПоляФормы.ПолеВвода;
	Элемент.МаксимальнаяШирина=30;
	Элемент.АвтоМаксимальнаяШирина=Ложь;
	Элемент.ПутьКДанным = "Объект.смартЭлектроннаяПочтаНаСайте";
	
	Элемент1 = Элементы.Добавить("смартЛогинНаСайте", Тип("ПолеФормы"),Элементы.ГруппаДополнительно);
	Элемент1.Вид = ВидПоляФормы.ПолеВвода;
	Элемент1.МаксимальнаяШирина=30;
	Элемент1.АвтоМаксимальнаяШирина=Ложь;
	Элемент1.ПутьКДанным = "Объект.смартЛогинНаСайте";
	
	Элемент2 = Элементы.Добавить("смартТелефонНаСайте", Тип("ПолеФормы"),Элементы.ГруппаДополнительно);
	Элемент2.Вид = ВидПоляФормы.ПолеВвода;
	Элемент2.Заголовок="Телефон на сайте";
	Элемент2.МаксимальнаяШирина=20;
	Элемент2.АвтоМаксимальнаяШирина=Ложь;
	Элемент2.ПутьКДанным = "Объект.смартТелефонНаСайте";

	Если НЕ РольДоступна("ПолныеПрава") Тогда
		Элемент.ТолькоПросмотр = Истина;
		Элемент1.ТолькоПросмотр = Истина;
		Элемент2.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка)  И РольДоступна("ПолныеПрава") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст ="ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	смартИдентификаторыСоответствияБитрикс.ИДсайта КАК ИДсайта
		|ИЗ
		|	РегистрСведений.смартИдентификаторыСоответствияБитрикс КАК смартИдентификаторыСоответствияБитрикс
		|ГДЕ
		|	смартИдентификаторыСоответствияБитрикс.СсылкаМет = &СсылкаМет";
		
		
		Запрос.УстановитьПараметр("СсылкаМет", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НовыйЭлемент = ЭтаФорма.Элементы.Добавить("смартИдКонтактного", Тип("ДекорацияФормы"),Элементы.ГруппаДополнительно);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
			НовыйЭлемент.ЦветТекста=Новый Цвет(0,194,0);
			НовыйЭлемент.Заголовок = ВыборкаДетальныеЗаписи.ИДсайта;
		КонецЕсли;
		
	КонецЕсли; 
	
	//++#1012 смарт: Холопов 04.05.2022 // Добавление подсказок для программно добавленных элементов и телефонов в КИ 
	Элемент2.ПодсказкаВвода = "+7 ХХХ ХХХ ХХ ХХ БЕЗ ПРОБЕЛОВ";
	Элемент2.Подсказка = "Если номер имеет заграничный формат, нажмите на кнопку выбора или F4 и введите номер";
	Элемент2.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;   
	
	Элемент.УстановитьДействие("ПриИзменении", "смартЭлектроннаяПочтаНаСайтеПриИзменении");
	//Поля КИ создаются только при создании на сервере нового объекта. У существующего объекта поля создаются по кнопке "Изменить"
	смартОбщегоНазначения.ДобавитьПодсказкиКонтактнаяИнформация(ЭтотОбъект);
	//--#1012 смарт: Холопов 04.05.2022
	
	//++ #1813 смарт: Фролов 08.05.2024 //Доработки для удобства использования WhatsApp
	Элементы.БыстрыйВвод_Чат.Заголовок = "WhatsApp";
	НовыйЭлемент = Элементы.Добавить("смартДекорацияНетПолучателейЧата", Тип("ДекорацияФормы"), Элементы.БыстрыйВвод_СтраницаЧат);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Шрифт = Новый Шрифт(НовыйЭлемент.Шрифт, , , Истина);
	НовыйЭлемент.Заголовок = "   Нет возможности отправить сообщение WhatsApp!" + Символы.ПС
		+ "Нет Контактных лиц партнера с указанным мобильным телефом!";
	НовыйЭлемент.ЦветТекста = Новый Цвет(255,0,0);
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
	НовыйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Центр;
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр;
	//-- #1813 смарт: Фролов 08.05.2024
	
	//++ #Б3686 смарт: Шляпников 03.07.2025 / Проект smart-t.ru. API. Выгрузка "Личный кабинет" 
	НовыйЭлемент = Элементы.Добавить("смартИдентификаторБитрикс", Тип("ПолеФормы"), Элементы.ГруппаДополнительно);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартИдентификаторБитрикс";
	
	НовыйЭлемент = Элементы.Добавить("смартАктивностьНаСайте", Тип("ПолеФормы"), Элементы.ГруппаДополнительно);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Объект.смартАктивностьНаСайте";
	//-- #Б3686 смарт: Шляпников 03.07.202
	
	//++ #1830 смарт: Фролов 23.05.2024 //Приведение механизма Заметок в Интересе и Партнере к общему виду.
	Элементы.БыстрыйВвод_Примечание.Заголовок = "Заметки";
	//-- #1830 смарт: Фролов 23.05.2024
	
	//++ #1929 смарт: Фролов 23.07.2024 //Создание рабочего места сотрудника с Задачами/Взаимодействиями/Поручениями
	МассивРеквизитов = Новый Массив;
	
	МассивРеквизитов.Добавить(Новый РеквизитФормы("БыстрыйВвод_ЗадачаСмартВидЗадачи", 
	Новый ОписаниеТипов("СправочникСсылка.смартВидыЗадач"), , "Вид задачи"));
	
	ИзменитьРеквизиты(МассивРеквизитов);
	//-- #1929 смарт: Фролов 23.07.2024	

	//++ #Б-1998 смарт: Лопато 27.01.2025 //Создание пользователя ИМ на основании договора поставки. Доработать метод отправки регистрации на сайт  
	Если Пользователи.ЭтоПолноправныйПользователь() 
		 И Константы.смартКонтактныеЛицаНаСайтБитрикс.Получить() Тогда
	
		НоваяКоманда = Команды.Добавить("смартЗарегистрироватьПользователяНаСайте");
		НоваяКоманда.Действие = "смартЗарегистрироватьПользователяНаСайте";
		НоваяКоманда.Отображение = ОтображениеКнопки.Текст;
		НоваяКоманда.Заголовок = "Зарегистрировать на сайте";
		
		НоваяКнопка = Элементы.Добавить("смартЗарегистрироватьПользователяНаСайте", Тип("КнопкаФормы"), Элементы.ГруппаДополнительно);
		НоваяКнопка.ИмяКоманды = "смартЗарегистрироватьПользователяНаСайте";
		
	КонецЕсли;	
	//-- #Б-1998 смарт: Лопато 27.01.2025
	
КонецПроцедуры

//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 28.09.2021 12:51:16- задача 552
&НаСервере
