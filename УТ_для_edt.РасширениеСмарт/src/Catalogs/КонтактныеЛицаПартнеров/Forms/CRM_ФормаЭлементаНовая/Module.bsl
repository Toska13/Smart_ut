&После("Подключаемый_КонтактнаяИнформацияНажатие")
Процедура смарт_Подключаемый_КонтактнаяИнформацияНажатие(Команда)
	
	Если СтрНайти(Команда.Имя, "КомандаИзменитьКИ") > 0 Тогда
		ЭлементСпискаКИ = Элементы.Найти(СтрЗаменить(Команда.Имя, "КомандаИзменитьКИ", "ГруппаЗаголовокКИ"));
		Если ЭлементСпискаКИ <> Неопределено Тогда
			
			Для каждого Стр Из ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
				
				Если Стр.Тип = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Телефон") Тогда
					
					ЭлемНомерТелефона = ЭтотОбъект.Элементы.Найти(Стр.ИмяРеквизита);
					Если ЭлемНомерТелефона <> Неопределено Тогда
						
						ЭлемНомерТелефона.ПодсказкаВвода = "+7 ХХХ ХХХ ХХ ХХ или 8 ХХХ ХХХ ХХ ХХ БЕЗ ПРОБЕЛОВ";
						ЭлемНомерТелефона.Подсказка = "Если номер имеет заграничный формат, нажмите на кнопку выбора или F4 и введите номер";
						ЭлемНомерТелефона.ОтображениеПодсказки = ОтображениеПодсказки.Всплывающая;
						
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура смартЭлектроннаяПочтаНаСайтеПриИзменении(Элемент)

	Адрес = Элемент.ТекстРедактирования;
	
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат;		
	КонецЕсли;
	
	Результат = смартПроверитьНаУникальностьСредиКЛНаСервере(Адрес);
	
	Если Результат = Истина Тогда
		Объект.смартЭлектроннаяПочтаНаСайте = "";
		Возврат;
	КонецЕсли;
	
	Результат = смартПроверитьНаУникальностьВАдресахКЛНаСервере(Адрес,Объект.Ссылка);
	
	Если Результат = Истина Тогда
		Объект.смартЭлектроннаяПочтаНаСайте = "";
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция смартПроверитьНаУникальностьВАдресахКЛНаСервере(Адрес,Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка КАК Ссылка,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК ЭлАдрес,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Представление КАК СсылкаПредставление,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец КАК Владелец,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец.Код КАК ВладелецКод
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
		|ГДЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление = &Представление
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("смартЭлектроннаяПочтаНаСайте", Адрес);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Представление", Адрес);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Текст = "Адрес """ + Адрес + """ уже используется! Найдено совпадений:" + Символы.ПС + Символы.ПС; 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Нумерация = 1;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СтрокаСовпадение = "" + 
			Нумерация + ") " + "Клиент: " + ВыборкаДетальныеЗаписи.Владелец + " (" + ВыборкаДетальныеЗаписи.ВладелецКод + ")" + Символы.ПС + 
			"Контактное лицо:" + ВыборкаДетальныеЗаписи.СсылкаПредставление + Символы.ПС;
			
			Текст = Текст + СтрокаСовпадение;
			
			Нумерация = Нумерация + 1;	
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();		
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции                                              

&НаСервереБезКонтекста
Функция смартПроверитьНаУникальностьСредиКЛНаСервере(Адрес)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка,
		|	КонтактныеЛицаПартнеров.смартЭлектроннаяПочтаНаСайте КАК смартЭлектроннаяПочтаНаСайте,
		|	КонтактныеЛицаПартнеров.Представление КАК Представление
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	КонтактныеЛицаПартнеров.ПометкаУдаления = ЛОЖЬ
		|	И КонтактныеЛицаПартнеров.смартЭлектроннаяПочтаНаСайте = &смартЭлектроннаяПочтаНаСайте";
	
	Запрос.УстановитьПараметр("смартЭлектроннаяПочтаНаСайте", Адрес);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		Текст = "Адрес """ + Адрес + """ уже используется контактными лицами:" + Символы.ПС; 
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Текст = Текст + ВыборкаДетальныеЗаписи.Представление + Символы.ПС;
			
		КонецЦикла;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();		
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции

