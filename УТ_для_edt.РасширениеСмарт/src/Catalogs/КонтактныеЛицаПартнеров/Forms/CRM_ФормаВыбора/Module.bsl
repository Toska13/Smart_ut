
#Область ДоработкиСмарт 

//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
&НаКлиенте
Процедура смартДобавлятьКонтактыДругогоКлиентаПриИзменении(Элемент)  
	
	Элементы.смартКлиентНеПоДокументу.Видимость = ЭтаФорма.смартДобавлятьКонтактыДругогоКлиента;
	
	смартУстановитьОтбор();
	
КонецПроцедуры 	//-- #1692 смарт: Мосолов 21.03.2024 

//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
&НаКлиенте
Процедура смартКлиентНеПоДокументуПриИзменении(Элемент)  
	
	смартУстановитьОтбор();
	
КонецПроцедуры //-- #1692 смарт: Мосолов 21.03.2024 

//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
&НаКлиенте
&ИзменениеИКонтроль("ПартнерПриИзменении")
Процедура смарт_ПартнерПриИзменении(Элемент)  
	
	#Удаление
	Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец") Тогда
			ЭлементОтбора.ПравоеЗначение = Партнер;
			ЭлементОтбора.Использование = ЗначениеЗаполнено(Партнер);
		КонецЕсли;
	КонецЦикла; 
	#КонецУдаления 
	
	#Вставка 
	//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
	смартУстановитьОтбор();
	//-- #1692 смарт: Мосолов 21.03.2024 
	#КонецВставки
	
КонецПроцедуры //-- #1692 смарт: Мосолов 21.03.2024

//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
&НаКлиенте
Процедура смартУстановитьОтбор() 
	
	Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл 
		
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец") Тогда 
			
			СписокПартнеров = Новый СписокЗначений;
			
			Если ЗначениеЗаполнено(Партнер) Тогда
				
				СписокПартнеров.Добавить(Партнер);
				
			КонецЕсли;
			
			Если ЭтаФорма.смартДобавлятьКонтактыДругогоКлиента И ЗначениеЗаполнено(ЭтаФорма.смартКлиентНеПоДокументу) Тогда
				
				СписокПартнеров.Добавить(ЭтаФорма.смартКлиентНеПоДокументу);
				
			КонецЕсли;
			
			ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.ПравоеЗначение = СписокПартнеров;
			ЭлементОтбора.Использование = СписокПартнеров.Количество();
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры //-- #1692 смарт: Мосолов 21.03.2024

//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	МодульУправлениеДоступом = CRM_ОбщегоНазначенияСервер.ОбщийМодуль("CRM_УправлениеДоступом");  
	
	Если МодульУправлениеДоступом <> Неопределено Тогда 
		
		МодульУправлениеДоступом.ОграничитьВыводКлиентскойБазы(ЭтотОбъект, "Список"); 
		
	КонецЕсли;

	Если Параметры.Свойство("ПрограммноеОткрытие") И Параметры.ПрограммноеОткрытие Тогда   
		
		Элементы.СписокВыбратьПрограммно.Видимость	= Истина;	
		
	Иначе 
		
		Элементы.СписокВыбратьПрограммно.Видимость	= Ложь;
		Элементы.СписокВыбрать.Видимость			= Истина;  
		
	КонецЕсли;     
	
	Элементы.Партнер.Видимость = (Параметры.Свойство("ПодборСОтключениемФильтраВладельца") 
	И Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец", Партнер));
	
	#Вставка  
	//++ #1692 смарт: Мосолов 21.03.2024 // Добавить возможность выбирать контактное лицо другого клиента в Заказе
	
	Если Параметры.Свойство("Отбор") Тогда 
		
		Параметры.Отбор.Свойство("Владелец", Партнер); 
		
	КонецЕсли;
	
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка); 
	
	//-- #1692 смарт: Мосолов 21.03.2024
	#КонецВставки
	
КонецПроцедуры //-- #1692 смарт: Мосолов 21.03.2024
	
#КонецОбласти