Функция ПолучитьДанныеБрутто(Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Наименование, Номенклатура.ЕдиницаИзмерения.Наименование) КАК Единица,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Высота, 0) КАК ВысотаБрутто,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Ширина, 0) КАК ШиринаБрутто,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Глубина, 0) КАК ДлинаБрутто,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Объем, 0) КАК ОбъемБрутто,
	|	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0) КАК ВесБрутто
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	|		ПО Номенклатура.Ссылка = УпаковкиЕдиницыИзмерения.Владелец
	|			И Номенклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения
	|ГДЕ
	|	Номенклатура.Ссылка = &Ссылка
	|	И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И Номенклатура.ИспользоватьУпаковки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СебестоимостьТоваровОбороты.АналитикаУчетаНоменклатуры.Серия КАК Серия
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Обороты(
	|			,
	|			,
	|			Запись,
	|			АналитикаУчетаНоменклатуры.Номенклатура = &Ссылка
	|				И НЕ АналитикаУчетаНоменклатуры.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК СебестоимостьТоваровОбороты
	|ГДЕ
	|	СебестоимостьТоваровОбороты.КоличествоПриход > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	СебестоимостьТоваровОбороты.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура.Ссылка);
	
	Пакет = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура("ВесБрутто,ОбъемБрутто,ДлинаБрутто,ПлощадьБрутто,ШиринаБрутто,ВысотаБрутто,КоличествоЯщиков");
	
	Выборка = Пакет[0].Выбрать();
	Если Выборка.Следующий() Тогда
		
		
		Результат.ПлощадьБрутто = СтрШаблон("%1 м2", Выборка.ШиринаБрутто * Выборка.ДлинаБрутто);
		Результат.ВесБрутто = СтрШаблон("%1 кг", Выборка.ВесБрутто);
		Результат.ВысотаБрутто = СтрШаблон("%1 м", Выборка.ВысотаБрутто);
		Результат.ШиринаБрутто = СтрШаблон("%1 м", Выборка.ШиринаБрутто);
		Результат.ДлинаБрутто = СтрШаблон("%1 м", Выборка.ДлинаБрутто);
		Результат.ОбъемБрутто = СтрШаблон("%1 м3", Выборка.ОбъемБрутто);
		
	Иначе
		
		Результат.ПлощадьБрутто = "<нет данных>";
		Результат.ВесБрутто = "<нет данных>";
		Результат.ВысотаБрутто = "<нет данных>";
		Результат.ШиринаБрутто = "<нет данных>";
		Результат.ДлинаБрутто = "<нет данных>";
		Результат.ОбъемБрутто = "<нет данных>";
		
	КонецЕсли;
	
	Выборка = Пакет[1].Выбрать();
	Если Выборка.Следующий() И Выборка.Серия <> NULL Тогда
		Результат.КоличествоЯщиков = СтрШаблон("%1 шт", Выборка.Серия.смартДанныеУпаковочногоЛиста.Количество());
	Иначе
		Результат.КоличествоЯщиков = "<нет данных>";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&ИзменениеИКонтроль("ВывестиРазделСУчетомРазмераЗначений")
Процедура смарт_ВывестиРазделСУчетомРазмераЗначений(ТабличныйДокумент, Макет, ИмяРаздела, ТекстЗначенияРеквизита, ТекстЗаголовкаРеквизита, НовоеИмяРаздела)

	ОбластьСтрока = Макет.ПолучитьОбласть(ИмяРаздела + "Строка");

	Если ТекстЗаголовкаРеквизита <> Неопределено Тогда 
		ОбластьСтрока.Параметры[ИмяРаздела + "Реквизит"] = Строка(ТекстЗаголовкаРеквизита) + ":";
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекстЗначенияРеквизита) Тогда 
		ОбластьСтрока.Параметры[ИмяРаздела] = ТекстЗначенияРеквизита;
	Иначе
		ОбластьСтрока.Параметры[ИмяРаздела] = ТекстЗначенияНеЗаполнен(ИмяРаздела);
	КонецЕсли;

	Если НовоеИмяРаздела = Неопределено Тогда 
		ОбластьСтрока.Параметры.Расшифровка = ИмяРаздела;
	Иначе
		ОбластьСтрока.Параметры.Расшифровка = НовоеИмяРаздела;
	КонецЕсли;

	ТабличныйДокумент.Вывести(ОбластьСтрока);
	
	КоличествоДополнительныхСтрок = 0;

	КоличествоДополнительныхСтрок = КоличествоДополнительныхСтрок(ТабличныйДокумент, ИмяРаздела, ТекстЗначенияРеквизита, ТекстЗаголовкаРеквизита);

	Счетчик = КоличествоДополнительныхСтрок;

	ОбластьДопСтрока = Макет.ПолучитьОбласть(ПолучитьИмяОбластиДопСтрокиПоИмениРаздела(ИмяРаздела));

	Пока Счетчик > 0 Цикл
		Счетчик = Счетчик - 1;
		ТабличныйДокумент.Вывести(ОбластьДопСтрока);
	КонецЦикла;

	ОбъединитьРазделСоСтрокамиНиже(ТабличныйДокумент, ИмяРаздела + "Строка", КоличествоДополнительныхСтрок);
	
КонецПроцедуры

