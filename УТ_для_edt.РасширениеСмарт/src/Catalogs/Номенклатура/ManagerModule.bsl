Функция ЭтоАрхивныйТовар(ТекущаяГруппаНоменклатуры) Экспорт
	ГруппаАрхив = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор("5c3ca33d-020b-11e6-bccb-00155d000500"));		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В ИЕРАРХИИ(&ГруппаАрхив)
	|	И Номенклатура.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("ГруппаАрхив", ГруппаАрхив);
	Запрос.УстановитьПараметр("Ссылка", ТекущаяГруппаНоменклатуры);
	Возврат НЕ Запрос.Выполнить().Пустой();	
