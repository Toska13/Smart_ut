//++ смарт:ММ #052 300 09.06.2020 - Групповое заполнение совместно продаваемой номенклатуры  
&НаСервере
Процедура смартДобавитьЭлементыПрограммно()
	
	Команда = ЭтаФорма.Команды.Добавить("смартСоздатьНесколько");
    Команда.Действие = "смартСоздатьНесколькоНажатие";

	Если Элементы.Найти("смартСоздатьНесколько") = Неопределено Тогда 		
		Кнопка = Элементы.Добавить("смартСоздатьНесколько", Тип("КнопкаФормы"), Элементы.НоменклатураПродаваемаяСовместноСДанной.КоманднаяПанель);
		Кнопка.Заголовок	= "Создать несколько (смарт)";
		Кнопка.ИмяКоманды	= "смартСоздатьНесколько";
	КонецЕсли;
	
	//++ смарт:ММ #103 495 18.04.2021 
	Команда = ЭтаФорма.Команды.Добавить("смартСоздатьНесколько2");
    Команда.Действие = "смартСоздатьНесколькоНажатие2";

	Если Элементы.Найти("смартСоздатьНесколько2") = Неопределено Тогда 		
		Кнопка = Элементы.Добавить("смартСоздатьНесколько2", Тип("КнопкаФормы"), Элементы.НоменклатураСКоторойПродаетсяСовместноДанная.КоманднаяПанель);
		Кнопка.Заголовок	= "Создать несколько (смарт)";
		Кнопка.ИмяКоманды	= "смартСоздатьНесколько2";
	КонецЕсли;
	
	Команда = ЭтаФорма.Команды.Добавить("смартСкопироватьДругим");
    Команда.Действие = "смартСкопироватьДругимНажатие";

	Если Элементы.Найти("смартСкопироватьДругим") = Неопределено Тогда 		
		Кнопка = Элементы.Добавить("смартСкопироватьДругим", Тип("КнопкаФормы"), Элементы.НоменклатураПродаваемаяСовместноСДанной.КоманднаяПанель);
		Кнопка.Заголовок	= "Скопировать другим (смарт)";
		Кнопка.ИмяКоманды	= "смартСкопироватьДругим";
	КонецЕсли;

	Команда = ЭтаФорма.Команды.Добавить("смартСкопироватьДругим2");
    Команда.Действие = "смартСкопироватьДругимНажатие";

	Если Элементы.Найти("смартСкопироватьДругим2") = Неопределено Тогда 		
		Кнопка = Элементы.Добавить("смартСкопироватьДругим2", Тип("КнопкаФормы"), Элементы.НоменклатураСКоторойПродаетсяСовместноДанная.КоманднаяПанель);
		Кнопка.Заголовок	= "Скопировать другим (смарт)";
		Кнопка.ИмяКоманды	= "смартСкопироватьДругим2";
	КонецЕсли;

	//-- смарт:ММ 18.04.2021
	
КонецПроцедуры //-- смарт:ММ 09.06.2020

//++ смарт:ММ #052 300 09.06.2020 - Групповое заполнение совместно продаваемой номенклатуры  
&НаКлиенте
Процедура смартСоздатьНесколькоНажатие(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ОтборНоменклатура", ОтборНоменклатура);
	//++ смарт:ММ #103 495 18.04.2021 
	ПараметрыОткрытия.Вставить("Режим", 1);
	//-- смарт:ММ 18.04.2021
	ОткрытьФорму("Справочник.Номенклатура.Форма.смарт_ЗаполнениеСовместныхПродаж", ПараметрыОткрытия, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
   
КонецПроцедуры //-- смарт:ММ 09.06.2020

//++ смарт:ММ #052 300 10.06.2020 - Групповое заполнение совместно продаваемой номенклатуры  
&НаКлиенте
Процедура смарт_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "смартИзмененРегистрНоменклатураПродаваемаяСовместно" Тогда
		Элементы.НоменклатураПродаваемаяСовместноСДанной.Обновить();
	//++ смарт:ММ #103 495 18.04.2021 
		Элементы.НоменклатураСКоторойПродаетсяСовместноДанная.Обновить();	
	//-- смарт:ММ 18.04.2021
	КонецЕсли;
		
КонецПроцедуры //-- смарт:ММ 10.06.2020

