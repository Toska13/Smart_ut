&НаКлиенте
Процедура смартПослеЗакрытияСкопироватьДругим(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("Массив") Тогда
		смартСкопироватьДругимСервер(РезультатЗакрытия);
		Оповестить("смартИзмененРегистрНоменклатураПродаваемаяСовместно");
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 18.04.2021

//++ смарт:ММ #103 495 18.04.2021 
&НаСервере
Процедура смартСкопироватьДругимСервер(МассивНоменклатуры)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка,
	|	НоменклатураПродаваемаяСовместно.ХарактеристикаПредпосылка,
	|	НоменклатураПродаваемаяСовместно.НоменклатураСледствие,
	|	НоменклатураПродаваемаяСовместно.ХарактеристикаСледствие,
	|	НоменклатураПродаваемаяСовместно.ВариантАнализа,
	|	НоменклатураПродаваемаяСовместно.ДобавленоАвтоматически,
	|	НоменклатураПродаваемаяСовместно.ПроцентСлучаев,
	|	НоменклатураПродаваемаяСовместно.КоличествоСлучаев
	|ИЗ
	|	РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
	|ГДЕ 
	|   НоменклатураПродаваемаяСовместно.НоменклатураСледствие = &Номенклатура
	|";

	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНоменклатураПродаваемаяСовместноСДанной Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НоменклатураПродаваемаяСовместно.НоменклатураСледствие = &Номенклатура", "НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка = &Номенклатура");
		Режим = 1;
	Иначе
		Режим = 2;
	КонецЕсли;
		
	Запрос.УстановитьПараметр("Номенклатура", ЭтаФорма.ОтборНоменклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Для Каждого ЭлементМассива Из МассивНоменклатуры Цикл
			
			МенеджерЗаписи = РегистрыСведений.НоменклатураПродаваемаяСовместно.СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
			
			Если Режим = 1 Тогда
				МенеджерЗаписи.НоменклатураПредпосылка 		= ЭлементМассива;
				МенеджерЗаписи.ХарактеристикаПредпосылка 	= Неопределено;			
			Иначе
				МенеджерЗаписи.НоменклатураСледствие 		= ЭлементМассива;
				МенеджерЗаписи.ХарактеристикаСледствие 		= Неопределено;			
			КонецЕсли;
			
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 18.04.2021

