&НаСервере
Функция ПроверитьСуществующуюНоменклатуруСервер(НомерСтроки, Номенклатура, Характеристика, ХарактеристикаПредпосылка)
	
	УжеЕстьЗапись = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НоменклатураСледствие", Номенклатура);
	Отбор.Вставить("ХарактеристикаСледствие", Характеристика);
	Отбор.Вставить("ХарактеристикаПредпосылка", ХарактеристикаПредпосылка);
	
	НайденныеСтроки = НоменклатураПродаваемаяСовместноСДанной.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 1 Тогда
		ТекстСообщения = "В таблице уже есть строка для полей Строка " + НомерСтроки + ", " + ОтборНоменклатура 
			+ ?(ЗначениеЗаполнено(ХарактеристикаПредпосылка), " (" + ХарактеристикаПредпосылка + ")", "") 
			+ " - " + Номенклатура + " " + Характеристика;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		УжеЕстьЗапись = Истина;
	КонецЕсли;                               
	
	Если НЕ УжеЕстьЗапись Тогда
		МенеджерЗаписи = РегистрыСведений.НоменклатураПродаваемаяСовместно.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВариантАнализа 				= ВариантАнализа;
		//++ смарт:ММ #103 495 18.04.2021 
		Если Режим = 1 Тогда
		//-- смарт:ММ 18.04.2021
		МенеджерЗаписи.НоменклатураПредпосылка 		= ОтборНоменклатура;
		МенеджерЗаписи.ХарактеристикаПредпосылка 	= ХарактеристикаПредпосылка;
		МенеджерЗаписи.НоменклатураСледствие 		= Номенклатура;
		МенеджерЗаписи.ХарактеристикаСледствие 		= Характеристика;
		
		//++ смарт:ММ #103 495 18.04.2021 
		Иначе
			МенеджерЗаписи.НоменклатураПредпосылка 		= Номенклатура;
			МенеджерЗаписи.ХарактеристикаПредпосылка 	= Характеристика;
			МенеджерЗаписи.НоменклатураСледствие 		= ОтборНоменклатура;
			МенеджерЗаписи.ХарактеристикаСледствие 		= ХарактеристикаПредпосылка;
		КонецЕсли;
		//-- смарт:ММ 18.04.2021
		
		//МенеджерЗаписи.ДобавленоАвтоматически 		= Ложь;
		
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			ТекстСообщения = "В регистре уже имеется запись для полей Строка " + НомерСтроки + ", " + ВариантАнализа + ": " + ОтборНоменклатура 
			+ ?(ЗначениеЗаполнено(ХарактеристикаПредпосылка), " (" + ХарактеристикаПредпосылка + ")", "") 
			+ " - " + Номенклатура + " " + Характеристика;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			УжеЕстьЗапись = Истина;
		КонецЕсли;
	КонецЕсли;
		
	Возврат УжеЕстьЗапись;
	
КонецФункции

&НаСервере
Процедура ПроставитьНомераСтрок()
	
	НомерСтроки = 1;
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		Строка.НомерСтроки = НомерСтроки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивУжеЗаписаннойВРегистрНоменклатуры()
	
	Запрос = Новый Запрос;
	//++ смарт:ММ #103 495 04.05.2021 
	Запрос.УстановитьПараметр("ВариантАнализа", ВариантАнализа);
	
	Если Режим = 1 Тогда 
	//-- смарт:ММ 04.05.2021
		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	НоменклатураПродаваемаяСовместно.НоменклатураСледствие КАК НоменклатураСледствие
	|ИЗ
	|	РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
	|ГДЕ
	//++ смарт:ММ #103 495 04.05.2021 
	|	НоменклатураПродаваемаяСовместно.ВариантАнализа = &ВариантАнализа
	|	И
	//-- смарт:ММ 04.05.2021
	|	НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка = &НоменклатураПредпосылка";
	
	Запрос.УстановитьПараметр("НоменклатураПредпосылка", ОтборНоменклатура);
	
	МассивУжеИспользованнойНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("НоменклатураСледствие");
	
	//++ смарт:ММ #103 495 04.05.2021 
	ИначеЕсли Режим = 2 Тогда 
	
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка КАК Номенклатура
		|ИЗ
		|	РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
		|ГДЕ
		|	НоменклатураПродаваемаяСовместно.ВариантАнализа = &ВариантАнализа
		|	И
		|	НоменклатураПродаваемаяСовместно.НоменклатураСледствие = &ОтборНоменклатура";
		
		Запрос.УстановитьПараметр("ОтборНоменклатура", ОтборНоменклатура);
		
		МассивУжеИспользованнойНоменклатуры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	КонецЕсли;	
	//-- смарт:ММ 04.05.2021
		
	// Дополнить номенклатурой из текущей табличной части
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		Если МассивУжеИспользованнойНоменклатуры.Найти(Строка.НоменклатураСледствие) = Неопределено Тогда
			МассивУжеИспользованнойНоменклатуры.Добавить(Строка.НоменклатураСледствие);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивУжеИспользованнойНоменклатуры;
		
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодборНаСервере(ВыбранноеЗначение)
	
	ТаблицаТоваров = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТоваровВХранилище);
	
	Сч = 1;
	ИДСтроки = 0;
	
	Для Каждого СтрокаТовара Из ТаблицаТоваров Цикл	
		Если Сч = 1 И НоменклатураПродаваемаяСовместноСДанной.Количество() <> 0 Тогда
			ИДСтроки = ПолучитьСледующийНомерСтроки();
		Иначе
			ИДСтроки = ИДСтроки + 1;
		КонецЕсли;
		
		ТекущаяСтрока = НоменклатураПродаваемаяСовместноСДанной.Добавить();
		ТекущаяСтрока.НоменклатураСледствие = СтрокаТовара.Номенклатура;		
		ТекущаяСтрока.НомерСтроки = ИДСтроки;	
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСледующийНомерСтроки()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НоменклатураПродаваемаяСовместноСДанной.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ТЗ КАК НоменклатураПродаваемаяСовместноСДанной
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ВТ.НомерСтроки), 0) КАК НомерСтроки
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("ТЗ", НоменклатураПродаваемаяСовместноСДанной.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.НомерСтроки + 1;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

