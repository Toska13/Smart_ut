
#Область СобытияФормыЭлементов

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОтборНоменклатура") Тогда
		ОтборНоменклатура = Параметры.ОтборНоменклатура;
	КонецЕсли;
	
	//++ смарт:ММ #103 495 18.04.2021 
	Если Параметры.Свойство("Режим") Тогда
		
		Режим = Параметры.Режим;
		
		Если Режим = 2 Тогда
			Элементы.НоменклатураПродаваемаяСовместноСДаннойХарактеристикаПредпосылка.Заголовок = "Характеристика (следствие)";
			Элементы.НоменклатураПродаваемаяСовместноСДаннойНоменклатураСледствие.Заголовок = "Номенклатура (предпосылка)";
			Элементы.НоменклатураПродаваемаяСовместноСДаннойХарактеристикаСледствие.Заголовок = "Характеристика (предпосылка)";
		КонецЕсли;
	КонецЕсли;
	//-- смарт:ММ 18.04.2021
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьДоступностьКолонок();
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВариантАнализаПриИзменении(Элемент)
	
	УстановитьДоступностьКомандыСоздатьЗаписи();
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		ПроверитьСуществующуюНоменклатуруСервер(Строка.НомерСтроки, Строка.НоменклатураСледствие, Строка.ХарактеристикаСледствие, Строка.ХарактеристикаПредпосылка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборНоменклатураПриИзменении(Элемент)
	
	УстановитьДоступностьКомандыСоздатьЗаписи();
	НастроитьДоступностьКолонок();
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		ПроверитьСуществующуюНоменклатуруСервер(Строка.НомерСтроки, Строка.НоменклатураСледствие, Строка.ХарактеристикаСледствие, Строка.ХарактеристикаПредпосылка);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаписи(Команда)
	
	СоздатьЗаписиНаСервере();
	Оповестить("смартИзмененРегистрНоменклатураПродаваемаяСовместно");
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаписиНаСервере()
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		
		МенеджерЗаписи = РегистрыСведений.НоменклатураПродаваемаяСовместно.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ВариантАнализа 				= ВариантАнализа;
		//++ смарт:ММ #103 495 18.04.2021 
		Если Режим = 1 Тогда
			МенеджерЗаписи.НоменклатураПредпосылка 		= ОтборНоменклатура;
			МенеджерЗаписи.ХарактеристикаПредпосылка 	= Строка.ХарактеристикаПредпосылка;			
			МенеджерЗаписи.НоменклатураСледствие 		= Строка.НоменклатураСледствие;
			МенеджерЗаписи.ХарактеристикаСледствие 		= Строка.ХарактеристикаСледствие;			
		Иначе
			МенеджерЗаписи.НоменклатураПредпосылка 		= Строка.НоменклатураСледствие;
			МенеджерЗаписи.ХарактеристикаПредпосылка 	= Строка.ХарактеристикаСледствие;			
			МенеджерЗаписи.НоменклатураСледствие 		= ОтборНоменклатура;
			МенеджерЗаписи.ХарактеристикаСледствие 		= Строка.ХарактеристикаПредпосылка;			
		КонецЕсли;
		//-- смарт:ММ 18.04.2021
		МенеджерЗаписи.ДобавленоАвтоматически 		= Ложь;
		МенеджерЗаписи.ПроцентСлучаев 				= ПроцентСлучаев;
		МенеджерЗаписи.КоличествоСлучаев 			= КоличествоСлучаев;
		
		МенеджерЗаписи.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	//++ смарт:ММ #103 495 04.05.2021 
	Если Не ЗначениеЗаполнено(ВариантАнализа) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Необходимо указать вариант анализа");
		Возврат;
	КонецЕсли;
	//-- смарт:ММ 04.05.2021
	
	МассивНедоступнойНоменклатуры = ПолучитьМассивУжеЗаписаннойВРегистрНоменклатуры();
	
	ПараметрыПодбора = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор, РежимВыбора", Истина, Истина, Истина);
	ФормаПодбора = ПолучитьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыПодбора, ЭтаФорма.Элементы.НоменклатураПродаваемаяСовместноСДанной);
	
	Если МассивНедоступнойНоменклатуры.Количество() > 0 Тогда
		
		//Элемент = ФормаПодбора.СписокНоменклатура.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент = ФормаПодбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение 		= Новый ПолеКомпоновкиДанных("Ссылка");
		Элемент.ВидСравнения 		= ВидСравненияКомпоновкиДанных.НеВСписке;
		Элемент.РежимОтображения 	= РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		Элемент.Использование 		= Истина;
		Элемент.ПравоеЗначение 		= МассивНедоступнойНоменклатуры;
		
		Элемент.ИдентификаторПользовательскойНастройки = "ОтборСсылка";
		
	КонецЕсли;
	
	ФормаПодбора.Открыть();
	
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Номенклатура") Тогда
		
		НоваяСтрока = НоменклатураПродаваемаяСовместноСДанной.Добавить();
		НоваяСтрока.НоменклатураСледствие = ВыбранноеЗначение;
		НоваяСтрока.НомерСтроки = ПолучитьСледующийНомерСтроки();
		
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Для Каждого ВидРасчета Из ВыбранноеЗначение Цикл
			
			НоваяСтрока = НоменклатураПродаваемаяСовместноСДанной.Добавить();
			НоваяСтрока.НоменклатураСледствие = ВидРасчета;
			НоваяСтрока.НомерСтроки = ПолучитьСледующийНомерСтроки();
			
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьДоступностьКомандыСоздатьЗаписи();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекСтрока = Элемент.ТекущиеДанные; 
		ТекСтрока.НомерСтроки = ПолучитьСледующийНомерСтроки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	УстановитьДоступностьКомандыСоздатьЗаписи();
	
	Для Каждого Строка Из НоменклатураПродаваемаяСовместноСДанной Цикл
		ПроверитьСуществующуюНоменклатуруСервер(Строка.НомерСтроки, Строка.НоменклатураСледствие, Строка.ХарактеристикаСледствие, Строка.ХарактеристикаПредпосылка);
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойПослеУдаления(Элемент)
	
	УстановитьДоступностьКомандыСоздатьЗаписи();
	ПроставитьНомераСтрок();	
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойПриАктивизацииСтроки(Элемент)
	
	НастроитьДоступностьКолонок();
		
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойНоменклатураСледствиеПриИзменении(Элемент)
	
	НастроитьДоступностьКолонок();
	//ПроверитьСуществующуюНоменклатуруКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПродаваемаяСовместноСДаннойХарактеристикаСледствиеПриИзменении(Элемент)
	//ПроверитьСуществующуюНоменклатуруКлиент();
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыФункции

&НаКлиенте
Процедура НастроитьДоступностьКолонок()
	
	ПредпосылкаХарактеристикиИспользуются = ХарактеристикиИспользуются(ОтборНоменклатура); 
	Элементы.НоменклатураПродаваемаяСовместноСДаннойХарактеристикаПредпосылка.ТолькоПросмотр = НЕ ПредпосылкаХарактеристикиИспользуются;

	ТекущиеДанные = Элементы.НоменклатураПродаваемаяСовместноСДанной.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		СледствиеХарактеристикиИспользуются = ХарактеристикиИспользуются(ТекущиеДанные.НоменклатураСледствие);
		Элементы.НоменклатураПродаваемаяСовместноСДаннойХарактеристикаСледствие.ТолькоПросмотр = НЕ СледствиеХарактеристикиИспользуются;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ХарактеристикиИспользуются(Номенклатура)
	
	Возврат Справочники.Номенклатура.ХарактеристикиИспользуются(Номенклатура);
	
КонецФункции

&НаСервере
Процедура УстановитьДоступностьКомандыСоздатьЗаписи()
	
	ДоступностьКнопки = Истина;
	
	Если НЕ ЗначениеЗаполнено(ВариантАнализа) Тогда
		ДоступностьКнопки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборНоменклатура) Тогда
		ДоступностьКнопки = Ложь;
	КонецЕсли;

	Если НоменклатураПродаваемаяСовместноСДанной.Количество() = 0 Тогда
		ДоступностьКнопки = Ложь;
	КонецЕсли;
	
	Если ДоступностьКнопки Тогда
		
		Запрос = Новый Запрос;
		//++ смарт:ММ #103 495 04.05.2021 
		Если Режим = 1 Тогда
		//-- смарт:ММ 04.05.2021
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПродаваемаяСовместно.ХарактеристикаПредпосылка КАК ХарактеристикаПредпосылка,
		|	НоменклатураПродаваемаяСовместно.НоменклатураСледствие КАК НоменклатураСледствие,
		|	НоменклатураПродаваемаяСовместно.ХарактеристикаСледствие КАК ХарактеристикаСледствие
		|ПОМЕСТИТЬ ВТ_ТЧ
		|ИЗ
		|	&НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&НоменклатураПредпосылка КАК НоменклатураПредпосылка,
		|	ВТ_ТЧ.ХарактеристикаПредпосылка КАК ХарактеристикаПредпосылка,
		|	ВТ_ТЧ.НоменклатураСледствие КАК НоменклатураСледствие,
		|	ВТ_ТЧ.ХарактеристикаСледствие КАК ХарактеристикаСледствие,
		|	&ВариантАнализа КАК ВариантАнализа
		|ПОМЕСТИТЬ ВТ_ПроверяемыеЗаписи
		|ИЗ
		|	ВТ_ТЧ КАК ВТ_ТЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ПроверяемыеЗаписи.НоменклатураПредпосылка КАК НоменклатураПредпосылка,
		|	ВТ_ПроверяемыеЗаписи.ХарактеристикаПредпосылка КАК ХарактеристикаПредпосылка,
		|	ВТ_ПроверяемыеЗаписи.НоменклатураСледствие КАК НоменклатураСледствие,
		|	ВТ_ПроверяемыеЗаписи.ХарактеристикаСледствие КАК ХарактеристикаСледствие
		|ИЗ
		|	ВТ_ПроверяемыеЗаписи КАК ВТ_ПроверяемыеЗаписи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
		|		ПО ВТ_ПроверяемыеЗаписи.НоменклатураПредпосылка = НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка
		|			И ВТ_ПроверяемыеЗаписи.ХарактеристикаПредпосылка = НоменклатураПродаваемаяСовместно.ХарактеристикаПредпосылка
		|			И ВТ_ПроверяемыеЗаписи.НоменклатураСледствие = НоменклатураПродаваемаяСовместно.НоменклатураСледствие
		|			И ВТ_ПроверяемыеЗаписи.ХарактеристикаСледствие = НоменклатураПродаваемаяСовместно.ХарактеристикаСледствие
		|			И ВТ_ПроверяемыеЗаписи.ВариантАнализа = НоменклатураПродаваемаяСовместно.ВариантАнализа";
		
		Запрос.УстановитьПараметр("НоменклатураПродаваемаяСовместно", НоменклатураПродаваемаяСовместноСДанной.Выгрузить());
		Запрос.УстановитьПараметр("ВариантАнализа", ВариантАнализа);
		Запрос.УстановитьПараметр("НоменклатураПредпосылка", ОтборНоменклатура);
		
		//++ смарт:ММ #103 495 04.05.2021 
		ИначеЕсли Режим = 2 Тогда
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	НоменклатураПродаваемаяСовместно.ХарактеристикаПредпосылка КАК ХарактеристикаСледствие,
			|	НоменклатураПродаваемаяСовместно.НоменклатураСледствие КАК НоменклатураПредпосылка,
			|	НоменклатураПродаваемаяСовместно.ХарактеристикаСледствие КАК ХарактеристикаПредпосылка
			|ПОМЕСТИТЬ ВТ_ТЧ
			|ИЗ
			|	&НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	&НоменклатураСледствие КАК НоменклатураСледствие,
			|	ВТ_ТЧ.ХарактеристикаПредпосылка КАК ХарактеристикаПредпосылка,
			|	ВТ_ТЧ.НоменклатураПредпосылка КАК НоменклатураПредпосылка,
			|	ВТ_ТЧ.ХарактеристикаСледствие КАК ХарактеристикаСледствие,
			|	&ВариантАнализа КАК ВариантАнализа
			|ПОМЕСТИТЬ ВТ_ПроверяемыеЗаписи
			|ИЗ
			|	ВТ_ТЧ КАК ВТ_ТЧ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВТ_ПроверяемыеЗаписи.НоменклатураПредпосылка КАК НоменклатураПредпосылка,
			|	ВТ_ПроверяемыеЗаписи.ХарактеристикаПредпосылка КАК ХарактеристикаПредпосылка,
			|	ВТ_ПроверяемыеЗаписи.НоменклатураСледствие КАК НоменклатураСледствие,
			|	ВТ_ПроверяемыеЗаписи.ХарактеристикаСледствие КАК ХарактеристикаСледствие
			|ИЗ
			|	ВТ_ПроверяемыеЗаписи КАК ВТ_ПроверяемыеЗаписи
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураПродаваемаяСовместно КАК НоменклатураПродаваемаяСовместно
			|		ПО ВТ_ПроверяемыеЗаписи.НоменклатураПредпосылка = НоменклатураПродаваемаяСовместно.НоменклатураПредпосылка
			|			И ВТ_ПроверяемыеЗаписи.ХарактеристикаПредпосылка = НоменклатураПродаваемаяСовместно.ХарактеристикаПредпосылка
			|			И ВТ_ПроверяемыеЗаписи.НоменклатураСледствие = НоменклатураПродаваемаяСовместно.НоменклатураСледствие
			|			И ВТ_ПроверяемыеЗаписи.ХарактеристикаСледствие = НоменклатураПродаваемаяСовместно.ХарактеристикаСледствие
			|			И ВТ_ПроверяемыеЗаписи.ВариантАнализа = НоменклатураПродаваемаяСовместно.ВариантАнализа";
			
			Запрос.УстановитьПараметр("НоменклатураПродаваемаяСовместно", НоменклатураПродаваемаяСовместноСДанной.Выгрузить());
			Запрос.УстановитьПараметр("ВариантАнализа", ВариантАнализа);
			Запрос.УстановитьПараметр("НоменклатураСледствие", ОтборНоменклатура);

		КонецЕсли;
		//-- смарт:ММ 04.05.2021
		РезультатЗапроса = Запрос.Выполнить();
