#Область КомандыИСобытияЭлементов

&НаКлиенте
Процедура смарт_КомандаСинхронизироватьНоменклатуру(Команда)
	
	ВыбранныеСтроки = ПолучитьВыделенныеСтроки();
	Если ВыбранныеСтроки = Неопределено Тогда
		ПоказатьПредупреждение(, "Необходимо выбрать номеклатуру к регистрации!",, "Ошибка");
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("смарт_ЗарегистрироватьКОбменуЗавершение", ЭтаФорма,ВыбранныеСтроки), "Зарегистрировать номенклатуру к обмену?", РежимДиалогаВопрос.ДаНет);
		
КонецПроцедуры  

&НаКлиенте
Процедура смарт_ЗарегистрироватьКОбменуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да тогда
		смарт_ЗарегистрироватьНаУзлахОбменаОткрытьФормуРегистрации(ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры  

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
&НаКлиенте
Процедура смартПоказатьАналогиКлиент(Команда)
	
	Если Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура Тогда
		ТекущаяСтрока = Элементы.СписокРасширенныйПоискНоменклатура.ТекущаяСтрока;
	ИначеЕсли Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаСтандартныйПоискНоменклатура Тогда
		ТекущаяСтрока = Элементы.СписокСтандартныйПоискНоменклатура.ТекущаяСтрока;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Номенклатура", ТекущаяСтрока);
	
	Оповещение = Новый ОписаниеОповещения("смартПоказатьАналогиЗавершениеКлиент", ЭтаФорма);
	
	ОткрытьФорму("РегистрСведений.смартАналогиНоменклатуры.Форма.ФормаВыбораАналога", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
&НаКлиенте
Процедура смартПоказатьАналогиЗавершениеКлиент(Значение, ДопПараметры) Экспорт
	
	Если НЕ Значение = Неопределено Тогда
		
		//смена иерархии
		Элементы.ИерархияНоменклатуры.ТекущаяСтрока = ПолучитьРодителяНоменклатуры(Значение);
		
		Если ИспользоватьФильтры И (ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоИерархии")) Тогда
			ПодборТоваровКлиент.ОбработчикАктивизацииСтрокиИерархииНоменклатуры(ЭтаФорма);
		КонецЕсли;
		
		//смена вида номенклатуры
		Элементы.ВидыНоменклатуры.ТекущаяСтрока = ПолучитьВидНоменклатуры(Значение);
		
		Если ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоСвойствам")
			Или ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоВидамИСвойствам")
			Или ВариантНавигации = ПредопределенноеЗначение("Перечисление.ВариантыНавигацииВФормахНоменклатуры.ПоВидам") Тогда
			
			ТекущиеДанные = Элементы.ВидыНоменклатуры.ТекущиеДанные;
		
			Если НЕ ТекущиеДанные = Неопределено И ИспользоватьФильтры Тогда
				
				ВидНоменклатуры = ТекущиеДанные.Ссылка;
				ВидНоменклатурыПриИзмененииНаСервере();
			
			КонецЕсли;
			
		КонецЕсли;
		
		Если Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаРасширенныйПоискНоменклатура Тогда
			
			Элементы.СписокРасширенныйПоискНоменклатура.ТекущаяСтрока = Значение;
			Элементы.СписокРасширенныйПоискНоменклатура.Обновить();
			
		ИначеЕсли Элементы.СтраницыСписков.ТекущаяСтраница = Элементы.СтраницаСтандартныйПоискНоменклатура Тогда
			
			Элементы.СписокСтандартныйПоискНоменклатура.ТекущаяСтрока = Значение;
			Элементы.СписокСтандартныйПоискНоменклатура.Обновить();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б3742 смарт: Шляпников 20.08.2025 / Подбор аналогов при выборе товара
