//++ Смарт:  Демичев №875 17.02.2022 (( 
&НаСервере
Функция ПолучитьВыделенныеСтроки()
	
	ПЭНоменклаутраТаблица = Элементы.ГруппаСписокНоменклатуры.ПодчиненныеЭлементы;
	мВыделенныеСтроки = ПЭНоменклаутраТаблица.СписокРасширенныйПоискНоменклатура.ВыделенныеСтроки;
	
	Если мВыделенныеСтроки = Неопределено или мВыделенныеСтроки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат мВыделенныеСтроки; 
	//СписокНоменклатура
	
КонецФункции

&НаКлиенте
Процедура смарт_ЗарегистрироватьНаУзлахОбменаОткрытьФормуРегистрации(МассивНоменклатуры) 
	
	Если МассивНоменклатуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	смПараметры = Новый Структура;
	смПараметры.Вставить("МассивНоменклатуры",МассивНоменклатуры);
	
	ПараметрыВыбораУзла = Новый Структура;
	ПараметрыВыбораУзла.Вставить("РежимВыбора",Истина);
	ПараметрыВыбораУзла.Вставить("СтруктураНоменклатурыМассив",смПараметры);
		
	ОткрытьФорму("Справочник.Номенклатура.Форма.смарт_ФормаСинхронизацииНоменклатуры",ПараметрыВыбораУзла,
	ЭтаФорма);
	
 
КонецПроцедуры  

