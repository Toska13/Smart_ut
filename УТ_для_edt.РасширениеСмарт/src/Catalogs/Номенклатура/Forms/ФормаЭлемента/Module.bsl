//++ смарт:КМД #3_2 501 13.06.2021
&НаСервере
Процедура смарт_ВключитьНоменклатуруВНеликвидыСервер(НастройкаСегмент)
	СтруктураНастройки = смартАвтоматизированныйРасчетНеликвидовСервер.ПолучитьСтруктуруНастройки();
	
	Если НастройкаСегмент = "ВключитьВS" тогда
		ВключенВНеликвидыS = Истина;
		ВключенВНеликвидыSПлюс = Ложь;
		Сегмент = СтруктураНастройки.СегментSОборачиваемость;
	Иначе
		ВключенВНеликвидыS = Ложь;
		ВключенВНеликвидыSПлюс = Истина;
		Сегмент = СтруктураНастройки.СегментSПлюсОборачиваемость;
	КонецЕсли;
	
	//запишем данные в регистр смартИсторияАвтоматизированногоРасчетаНеликвидов
	//++ #1305 смарт: Фролов 15.02.2023 //Отчет Стоимость использования оборудования  
	//смартАвтоматизированныйРасчетНеликвидовСервер.ДобавитьЗаписьВРегистр_смартИсторияАвтоматизированногоРасчетаНеликвидов(ТекущаяДатаСеанса(),
	//	Объект.Ссылка, Объект["смартСоответствиеСОбрудованиемИЧерниламиКлиентов"], 0, 0, 0, ВключенВНеликвидыS,
	//	ВключенВНеликвидыSПлюс, Истина);
	смартАвтоматизированныйРасчетНеликвидовСервер.ДобавитьЗаписьВРегистр_смартИсторияАвтоматизированногоРасчетаНеликвидов(ТекущаяДатаСеанса(),
		Объект.Ссылка, смарт_ПолучитьОборудованиеКлиента(Объект.Ссылка), 0, 0, 0, ВключенВНеликвидыS,
		ВключенВНеликвидыSПлюс, Истина);
	//-- #1305 смарт: Фролов 15.02.2023
	
	//включим в сегмент неликвидов
	смартАвтоматизированныйРасчетНеликвидовСервер.ВключитьНоменклатуруВСегментНеликвидов(Сегмент, Объект.Ссылка);
	
	смарт_ЗаполнитьИнформациюОНеликвидах();	
КонецПроцедуры


