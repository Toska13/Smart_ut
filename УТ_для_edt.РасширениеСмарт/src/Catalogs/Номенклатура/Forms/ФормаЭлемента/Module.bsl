//++ #6416 смарт: Тимофеева 08.04.2026 / Справочник Номенклатура. Ввод таможенного описания.
&НаКлиенте
Процедура НачалоВыбораТаможенногоОписания(Элемент, ДанныеВыбора, СтандартнаяОбработка)	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ Объект.смартТаможенноеОписание = Элемент.ТекстРедактирования Тогда
		Объект.смартТаможенноеОписание = Элемент.ТекстРедактирования;
		Модифицированность = Истина;
	КонецЕсли;
	
	МассивТаможенныхОписаний = ПолучитьВозможныеТаможенныеОписания(Объект.Ссылка);
	Если МассивТаможенныхОписаний.Количество() > 0 Тогда
		СписокВариантов = Новый СписокЗначений;
		СписокВариантов.ЗагрузитьЗначения(МассивТаможенныхОписаний);
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеВыбораТаможенногоОписания", ЭтотОбъект);
			
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("ЗначенияДляВыбора", СписокВариантов);
		ПараметрыОткрытия.Вставить("Заголовок", НСтр("ru = 'Выбор описания из предварительных таможенных деклараций'"));
			
		ОткрытьФорму(
				"ОбщаяФорма.ВыборЗначенияИзСписка",
				ПараметрыОткрытия,
				ЭтаФорма,
				Новый УникальныйИдентификатор(),
				,
				,
				ОписаниеОповещенияОЗакрытии,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе  
		ОбщегоНазначенияКлиент.СообщитьПользователю("Выбор описания из предварительных таможенных деклараций: Нет данных для выбора!");			
	КонецЕсли;	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьВозможныеТаможенныеОписания(Номенклатура)
   	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.ОписаниеПоДекларации КАК ОписаниеПоДекларации
	|ИЗ
	|	Документ.смартПредварительнаяТаможеннаяДекларацияИмпорт.Товары КАК смартПредварительнаяТаможеннаяДекларацияИмпортТовары
	|ГДЕ
	|	смартПредварительнаяТаможеннаяДекларацияИмпортТовары.Номенклатура = &Номенклатура"; 
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОписаниеПоДекларации");
КонецФункции

&НаКлиенте
Процедура ПослеВыбораТаможенногоОписания(ТаможенноеОписание, ДополнительныеПараметры) Экспорт 
	Если НЕ ТаможенноеОписание = Неопределено 
		И НЕ Объект.смартТаможенноеОписание = ТаможенноеОписание Тогда
		Объект.смартТаможенноеОписание = ТаможенноеОписание;
		Модифицированность = Истина;
	КонецЕсли;	
КонецПроцедуры
