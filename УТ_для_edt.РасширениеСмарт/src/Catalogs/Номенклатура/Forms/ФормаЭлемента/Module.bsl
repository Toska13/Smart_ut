&НаКлиенте
Процедура смарт_ИсключитьИзНеликвидов(Команда)
	
	Если Параметры.Ключ.Пустая() тогда
		ПоказатьПредупреждение(, "Нельзя включать и исключать из неликвидов незаписанную номенклатуру!",, "Ошибка");
		Возврат;
	КонецЕсли;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("смарт_ИсключитьИзНеликвидовЗавершение", ЭтаФорма), "Вы уверены что хотите исключить номенклатуру из неликвидов?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

//++ смарт:КМД #3_2 501 13.06.2021
&НаКлиенте
Процедура смарт_ВключитьВНеликвиды(Команда)
	
	Если Параметры.Ключ.Пустая() тогда
		ПоказатьПредупреждение(, "Нельзя включать и исключать из неликвидов незаписанную номенклатуру!",, "Ошибка");
		Возврат;
	КонецЕсли;
	
	Если Объект["смартОбязательноеНаличие"] = Истина тогда
		ПоказатьПредупреждение(, "Номенклатуру с признаком ""Обязательное наличие"" нельзя включать в неликвиды!",, "Ошибка");
		Возврат;
	КонецЕсли;  
	
	СписокКнопок = Новый СписокЗначений;
	СписокКнопок.Добавить("ВключитьВS", "Включить в сегмент S");
	СписокКнопок.Добавить("ВключитьВSПлюс", "Включить в сегмент S+");
	СписокКнопок.Добавить("Отмена", "Отмена");
	
	ПоказатьВопрос(Новый ОписаниеОповещения("смарт_ВключитьВНеликвидыЗавершение", ЭтаФорма), "В какой сегемент неликвидов включить номенклатуру?", СписокКнопок);
	
КонецПроцедуры

