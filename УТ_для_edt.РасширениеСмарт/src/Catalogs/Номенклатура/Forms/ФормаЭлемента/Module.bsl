//++ #Б2736 смарт: Шляпников 21.03.2025 / Конструктор КП. - Привязка справочника "Номенклатура" к справочнику "Конструктор оборудования".
Функция ПолучитьКонструкторОборудованияСвязанныйСТекущейНоменклатурой()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.смартКонструкторОборудования
	|ГДЕ
	|	Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

//++ #Б4670 смарт: Шляпников 21.10.2025 / Маркировка радиоэлектронной продукции. Доработка справочника "Номенклатура".
&НаСервере
Процедура УстановитьВидимостьПолейМаркировки()
	
	Если смартМаркировка.КонтроллироватьОтгрузкуМаркированнойПродукции(ТекущаяДата()) Тогда
		
		Элементы.смартПризнакМаркировкаЭксперимент.Видимость = смартМаркировка.НоменклатураПодлежитЭксперементальнойМаркировке(Объект);
		Элементы.смартПризнакМаркировкаОбязательно.Видимость = смартМаркировка.НоменклатураПодлежитОбязательнойМаркировке(Объект);
		
	Иначе
		
		Элементы.смартПризнакМаркировкаЭксперимент.Видимость = Ложь;
		Элементы.смартПризнакМаркировкаОбязательно.Видимость = Ложь;
		
	КонецЕсли;
	
	Элементы.смартДатаНачалаОбязательнойМаркировки.ТолькоПросмотр = НЕ Объект.смартОбязательнаяМаркировка;
	Элементы.смартОбязательнаяМаркировка.ТолькоПросмотр = Объект.смартПроверкаПроведенаМаркировкаНеТребуется;
	Элементы.смартПроверкаПроведенаМаркировкаНеТребуется.ТолькоПросмотр = Объект.смартОбязательнаяМаркировка;
	
КонецПроцедуры

