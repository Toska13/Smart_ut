//++ смарт:КМД #3_2 501 13.06.2021
&НаСервере
Процедура смарт_ИсключитьНоменклатуруИзНеликвидовСервер()
	СтруктураНастройки = смартАвтоматизированныйРасчетНеликвидовСервер.ПолучитьСтруктуруНастройки();
	
	НоменклатураИсключенаИзНеликвидов = смартАвтоматизированныйРасчетНеликвидовСервер.ИсключитьНоменклатуруИзСегментовНеликвидов(Объект.Ссылка, СтруктураНастройки.СегментSОборачиваемость, СтруктураНастройки.СегментSПлюсОборачиваемость);
	
	Если НоменклатураИсключенаИзНеликвидов = Истина тогда
		//запишем данные в регистр смартИсторияАвтоматизированногоРасчетаНеликвидов
		//++ #1305 смарт: Фролов 16.02.2023 //Отчет Стоимость использования оборудования  
		//смартАвтоматизированныйРасчетНеликвидовСервер.ДобавитьЗаписьВРегистр_смартИсторияАвтоматизированногоРасчетаНеликвидов(ТекущаяДатаСеанса(),
		//	Объект.Ссылка, Объект["смартСоответствиеСОбрудованиемИЧерниламиКлиентов"], 0, 0, 0, Ложь,
		//	Ложь, Истина);
		смартАвтоматизированныйРасчетНеликвидовСервер.ДобавитьЗаписьВРегистр_смартИсторияАвтоматизированногоРасчетаНеликвидов(ТекущаяДатаСеанса(),
			Объект.Ссылка, смарт_ПолучитьОборудованиеКлиента(Объект.Ссылка), 0, 0, 0, Ложь,
			Ложь, Истина);
		//-- #1305 смарт: Фролов 16.02.2023
	КонецЕсли;
		
	смарт_ЗаполнитьИнформациюОНеликвидах();	
КонецПроцедуры

//++ смарт:КМД #3_2 501 13.06.2021
&НаСервере
Процедура смарт_ЗаполнитьИнформациюОНеликвидах()
	СтруктураИнформация = смартАвтоматизированныйРасчетНеликвидовСервер.ПолучитьАктуальнуюИнформациюОНеликвидах(Объект.Ссылка);
	
	ЭтаФорма["НеликвидS"] = СтруктураИнформация.ВключенВНеликвидыS;
	ЭтаФорма["НеликвидSПлюс"] = СтруктураИнформация.ВключенВНеликвидыSПлюс;
	ЭтаФорма["ИзмененоВручную"] = СтруктураИнформация.ИзмененоВручную;
	
	//оформление
	Элементы["НеликвидS"].ШрифтЗаголовка = Новый Шрифт(Элементы["НеликвидS"].ШрифтЗаголовка,,, ЭтаФорма["НеликвидS"]);
	Элементы["НеликвидSПлюс"].ШрифтЗаголовка = Новый Шрифт(Элементы["НеликвидSПлюс"].ШрифтЗаголовка,,, ЭтаФорма["НеликвидSПлюс"]);
	Элементы["ИзмененоВручную"].ШрифтЗаголовка = Новый Шрифт(Элементы["ИзмененоВручную"].ШрифтЗаголовка,,, ЭтаФорма["ИзмененоВручную"]);
	
	//видимость кнопок
	Если ЭтаФорма["НеликвидS"] = Истина ИЛИ ЭтаФорма["НеликвидSПлюс"] = Истина тогда
		Элементы["смартВключитьВНеликвиды"].Видимость = Ложь;
		Элементы["смартИсключитьИзНеликвидов"].Видимость = Истина;
	Иначе
		Элементы["смартВключитьВНеликвиды"].Видимость = Истина;
		Элементы["смартИсключитьИзНеликвидов"].Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура смарт_ЗарегистрироватьКОбменуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да тогда
		смарт_ЗарегистрироватьНаУзлахОбменаОткрытьФормуРегистрации();
	КонецЕсли;

КонецПроцедуры  

&НаКлиенте
Процедура смарт_ЗарегистрироватьНаУзлахОбменаОткрытьФормуРегистрации() 
	
	мМассивТоваров = Новый Массив;
	мМассивТоваров.Добавить(Объект.Ссылка);
	
	смПараметры = Новый Структура;
	смПараметры.Вставить("МассивНоменклатуры",мМассивТоваров);
	
	ПараметрыВыбораУзла = Новый Структура;
	ПараметрыВыбораУзла.Вставить("РежимВыбора",Истина);
	ПараметрыВыбораУзла.Вставить("СтруктураНоменклатурыМассив",смПараметры);
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.смарт_ФормаСинхронизацииНоменклатуры",ПараметрыВыбораУзла,
	ЭтаФорма);
	
КонецПроцедуры   
				
