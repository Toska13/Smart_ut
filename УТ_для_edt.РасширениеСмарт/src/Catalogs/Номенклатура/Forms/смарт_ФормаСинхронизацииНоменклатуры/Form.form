      <items xsi:type="form:FormField">
        <name>ПрефиксИБ</name>
        <id>31</id>
        <title>
          <key>ru</key>
          <value>Префикс этой информационной базы</value>
        </title>
        <visible>true</visible>
        <enabled>true</enabled>
        <userVisible>
          <common>true</common>
        </userVisible>
        <dataPath xsi:type="form:DataPath">
          <segments>ПрефиксИБ</segments>
        </dataPath>
