//++ #Б-2064 смарт: Фролов 31.01.2025 //Создание пользователя ИМ на основании договора поставки. Регистрация клиента на сайте.
Процедура смартДействиеПоказатьИнформацию(Команда)
	
	ИнформацияЗаголовок = "Дата начала регистрации пользователя ИМ по договору поставки";
	ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			НСтр("ru = 'Пустая дата = функционал не активен. Если дата установлена, при создании Заказа клиента, 
			|где требуется договор, в заявку на договор будут включены дополнительные поля (обязательные для заполнения), 
			|а в шаблон договора добавляются пункты согласия на регистрацию пользователя в ИМ.
			|После подписания договора (установки признака Договор подписан), автоматически создается пользователь в ИМ.'"));
			
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;
			
КонецПроцедуры	//-- #Б-2064 смарт: Фролов 31.01.2025		

