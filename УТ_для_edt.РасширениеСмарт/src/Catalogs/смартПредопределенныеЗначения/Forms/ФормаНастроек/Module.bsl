//++ #Б-1534 смарт: Лопато 05.12.2024 //Интеграция с ROIStat. Узел обмена, очередь выгрузки, регистрация данных
Процедура ИнициализироватьRoistatНастройкиОтбораИнтересов();

	RoistatСхемаОтбораИнтересов = Справочники.смартПредопределенныеЗначения.ПолучитьМакет("RoistatСхемаОтбораИнтересов");
	
	RoistatНастройкиОтбораИнтересов = Справочники.смартПредопределенныеЗначения.Настройки.RoistatНастройкиОтбораИнтересов.Получить();
	
	Если ТипЗнч(RoistatНастройкиОтбораИнтересов) = Тип("НастройкиКомпоновкиДанных") Тогда
		НастройкиКомпоновкиОтбораИнтересов = RoistatНастройкиОтбораИнтересов;
	Иначе
		НастройкиКомпоновкиОтбораИнтересов = RoistatСхемаОтбораИнтересов.НастройкиПоУмолчанию;
	КонецЕсли;

	УстановитьНастройкиОтбораИнтересовRoistat(НастройкиКомпоновкиОтбораИнтересов);
	
КонецПроцедуры //-- #Б-1534 смарт: Лопато 05.12.2024

//++ #Б-1534 смарт: Лопато 05.12.2024 //Интеграция с ROIStat. Узел обмена, очередь выгрузки, регистрация данных
Процедура УстановитьНастройкиОтбораИнтересовRoistat(НастройкиКомпоновки)
	
	RoistatСхемаОтбораИнтересов = Справочники.смартПредопределенныеЗначения.ПолучитьМакет("RoistatСхемаОтбораИнтересов");
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(
								 ПоместитьВоВременноеХранилище(RoistatСхемаОтбораИнтересов, Новый УникальныйИдентификатор()));

	ЭтотОбъект.КомпоновщикНастроекОтбораИнтересов.Инициализировать(ИсточникНастроек);
	ЭтотОбъект.КомпоновщикНастроекОтбораИнтересов.ЗагрузитьНастройки(НастройкиКомпоновки);
	
КонецПроцедуры //-- #Б-1534 смарт: Лопато 05.12.2024

