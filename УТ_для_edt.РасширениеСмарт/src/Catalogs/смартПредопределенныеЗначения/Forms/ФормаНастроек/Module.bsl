	НастройкиАвтоматическогоЗакрытия = Новый Структура;
	НастройкиАвтоматическогоЗакрытия.Вставить("АвтоматическиЗакрыватьЗаказыКлиентов", АвтоматическиЗакрыватьЗаказыКлиентов);
	НастройкиАвтоматическогоЗакрытия.Вставить("АвтоматическиЗакрыватьЗаказыНаПеремещение", АвтоматическиЗакрыватьЗаказыНаПеремещение);
	НастройкиАвтоматическогоЗакрытия.Вставить("АвтоматическиЗакрыватьЗаказыНаСборку", АвтоматическиЗакрыватьЗаказыНаСборку);
	//++ #5634 смарт: Тимофеева 13.02.26 / Автоматическое закрытие заказов. Дополнение. Заказ на внутреннее потребление
	//смартОбеспечение.ЗаписатьНастройкиНастройкиАвтоматическогоЗакрытияЗаказов(ТекущийОбъект, КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовКлиентов, КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовНаПеремещение, КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовНаСборку, НастройкиАвтоматическогоЗакрытия);
    НастройкиАвтоматическогоЗакрытия.Вставить("АвтоматическиЗакрыватьЗаказыНаВнутреннееПотребление", АвтоматическиЗакрыватьЗаказыНаВнутреннееПотребление);
	смартОбеспечение.ЗаписатьНастройкиНастройкиАвтоматическогоЗакрытияЗаказов(ТекущийОбъект, 
																			КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовКлиентов, 
																			КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовНаПеремещение, 
																			КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовНаСборку,
																			КомпоновщикНастроекАвтоматическогоЗакрытияЗаказовНаВнутреннееПотребление,
																			НастройкиАвтоматическогоЗакрытия);

	//-- #5634 смарт: Тимофеева 13.02.26
	
		
	//++ #Б-1534 смарт: Лопато 05.12.2024 //Интеграция с ROIStat. Узел обмена, очередь выгрузки, регистрация данных
	ТекущийОбъект.RoistatНастройкиОтбораИнтересов = 
		Новый ХранилищеЗначения(ЭтаФорма.КомпоновщикНастроекОтбораИнтересов.ПолучитьНастройки(), Новый СжатиеДанных(9));
	//-- #Б-1534 смарт: Лопато 05.12.2024

КонецПроцедуры

