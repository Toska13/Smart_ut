//++#1678 смарт: Лопато 25.03.2024 //Регистрация номенклатуры на узле обмена товарами при добавлении/удалении в дереве каталогов  
&ИзменениеИКонтроль("ДобавитьТоварВРазделСервер")
Процедура смарт_ДобавитьТоварВРазделСервер(Раздел, ВыделенныеТовары)

	РазделОбъект = Раздел.ПолучитьОбъект();

	#Вставка
	//++#1678 смарт: Лопато 25.03.2024 //Регистрация номенклатуры на узле обмена товарами при добавлении/удалении в дереве каталогов
	МассивУзловТовары = Б_ОбменССайтомСервер.смартПолучитьМассивУзловДляРегистрации(Истина);
	//--#1678 смарт: Лопато 25.03.2024
	#КонецВставки
	
	Для Каждого ТекНоменклатура Из ВыделенныеТовары Цикл
	
		Если НЕ ЗначениеЗаполнено(ТекНоменклатура) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НоменклатураОтбор.Количество() > 0 Тогда
			Если НоменклатураОтбор.НайтиПоЗначению(ТекНоменклатура) = НеОпределено Тогда
				Сообщить("Номенклатура """ + ТекНоменклатура + """ не соответствует отбору.");
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		
		Если НЕ РазделОбъект.Товары.Найти(ТекНоменклатура) = НеОпределено Тогда
			Продолжить;
		КонецЕсли;
		
		РазделОбъект.Товары.Добавить().Номенклатура = ТекНоменклатура;
		
		#Вставка
		//++#1678 смарт: Лопато 25.03.2024 //Регистрация номенклатуры на узле обмена товарами при добавлении/удалении в дереве каталогов
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, ТекНоменклатура);
		//--#1678 смарт: Лопато 25.03.2024
		#КонецВставки
		
	КонецЦикла;

	РазделОбъект.Записать();
	
КонецПроцедуры //--#1678 смарт: Лопато 25.03.2024

//++#1678 смарт: Лопато 25.03.2024 //Регистрация номенклатуры на узле обмена товарами при добавлении/удалении в дереве каталогов  
&ИзменениеИКонтроль("УдалитьТоварИзРазделаСервер")
Процедура смарт_УдалитьТоварИзРазделаСервер(Раздел, пТовар)

	РазделОбъект = Раздел.ПолучитьОбъект();
	
	НайденнаяСтрока = РазделОбъект.Товары.Найти(пТовар);
	
	Если НайденнаяСтрока <> Неопределено Тогда
		
		РазделОбъект.Товары.Удалить(РазделОбъект.Товары.Индекс(НайденнаяСтрока));

		#Вставка
		//++#1678 смарт: Лопато 25.03.2024 //Регистрация номенклатуры на узле обмена товарами при добавлении/удалении в дереве каталогов
		МассивУзловТовары = Б_ОбменССайтомСервер.смартПолучитьМассивУзловДляРегистрации(Истина);
		
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловТовары, пТовар);
		//--#1678 смарт: Лопато 25.03.2024
		#КонецВставки
		
	КонецЕсли;
	
	РазделОбъект.Записать();
	
КонецПроцедуры //--#1678 смарт: Лопато 25.03.2024

#КонецОбласти
