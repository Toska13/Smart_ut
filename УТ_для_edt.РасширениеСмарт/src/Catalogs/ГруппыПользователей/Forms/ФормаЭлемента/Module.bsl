
#Область ПеренесеноСДоработкамиСмарт

//++ #1543 смарт: Фролов 22.11.2023 //Автоматическое распределение лидов на менеджеров
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	НовыйЭлемент = Этаформа.Элементы.Вставить("смартСтраницаБизнесРегионы",Тип("ГруппаФормы"),ЭтаФорма.Элементы.СтраницыУчастникиГруппыКомментарий,ЭтаФорма.Элементы.ГруппаКомментарий);
	НовыйЭлемент.Вид = ВидГруппыФормы.Страница;
	НовыйЭлемент.Заголовок = "Бизнес-регионы (смарт)";
	НовыйЭлемент.Подсказка = "Бизнес-регионы (смарт)";
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("смартБизнесРегионы",Тип("ТаблицаФормы"),ЭтаФорма.Элементы.смартСтраницаБизнесРегионы,Неопределено);
	НовыйЭлемент.ПутьКДанным = "Объект.смартБизнесРегионы";
	НовыйЭлемент.АвтоВводНовойСтроки = Истина;
	НовыйЭлемент.Отображение = ОтображениеТаблицы.Список;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.РежимВыделения = РежимВыделенияТаблицы.Множественный;
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("смартБизнесРегион",Тип("ПолеФормы"),ЭтаФорма.Элементы.смартБизнесРегионы,Неопределено);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартБизнесРегионы.БизнесРегион";
	НовыйЭлемент.КнопкаВыбора = Истина;
	НовыйЭлемент.КнопкаОчистки = Истина;
	НовыйЭлемент.УстановитьДействие("НачалоВыбора","смартБизнесРегионНачалоВыбора");
КонецПроцедуры //-- #1543 смарт: Фролов 22.11.2023

#КонецОбласти

#Область ДоработкиСмарт

//++ #1543 смарт: Фролов 22.11.2023 //Автоматическое распределение лидов на менеджеров
&НаКлиенте
Процедура смартБизнесРегионНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	ОткрытьФорму("Справочник.БизнесРегионы.Форма.смарт_ФормаВыбора",Новый Структура("ЗакрыватьПриВыборе,РежимВыбора", Истина,Истина),ЭтаФорма,,,,Новый ОписаниеОповещения("смартПослеЗакрытияФормыВыбораБизнесРегиона",ЭтаФорма),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры //-- #1543 смарт: Фролов 22.11.2023

//++ #1543 смарт: Фролов 22.11.2023 //Автоматическое распределение лидов на менеджеров
&НаКлиенте
Процедура смартПослеЗакрытияФормыВыбораБизнесРегиона(ПараметрЗакрытия, ДополнительныеПараметры) Экспорт
	ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.БизнесРегион=ПараметрЗакрытия;
КонецПроцедуры //-- #1543 смарт: Фролов 22.11.2023	

#КонецОбласти