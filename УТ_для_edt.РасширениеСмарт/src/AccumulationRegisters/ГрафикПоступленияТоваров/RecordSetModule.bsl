#Область ПеренесеноСДоработками

&ИзменениеИКонтроль("ПоместитьВременнуюТаблицуИсходныхДвижений")
Процедура смарт_ПоместитьВременнуюТаблицуИсходныхДвижений(Ссылка, МенеджерВременныхТаблиц)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Т.Номенклатура   КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Склад          КАК Склад,
	|
	|	Т.ДатаСобытия         КАК ДатаПоступления,
	|	Т.КоличествоИзЗаказов КАК КоличествоПередЗаписью
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|	, Т.смартКоличествоИзЗаказовГарантийные КАК смартКоличествоГарантийныеПередЗаписью
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки
	|
	|ПОМЕСТИТЬ ВТГрафикПоступленияТоваровПередЗаписью
	|ИЗ
	|	РегистрНакопления.ГрафикПоступленияТоваров КАК Т
	|ГДЕ
	|	Т.Регистратор = &Регистратор
	#Удаление //++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|	И Т.КоличествоИзЗаказов <> 0");
	#КонецУдаления
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|	И ( Т.КоличествоИзЗаказов <> 0
	|	ИЛИ Т.смартКоличествоИзЗаказовГарантийные <> 0 )");
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки

	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Выполнить();

КонецПроцедуры

&ИзменениеИКонтроль("ПоместитьВременнуюТаблицуИзмененийДвижений")
Функция смарт_ПоместитьВременнуюТаблицуИзмененийДвижений(Ссылка, МенеджерВременныхТаблиц)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Набор.Номенклатура   КАК Номенклатура,
	|	Набор.Характеристика КАК Характеристика,
	|	Набор.Склад          КАК Склад
	|
	|ПОМЕСТИТЬ ВтТовары
	|ИЗ(
	|	ВЫБРАТЬ
	|		ПередЗаписью.Номенклатура           КАК Номенклатура,
	|		ПередЗаписью.Характеристика         КАК Характеристика,
	|		ПередЗаписью.Склад                  КАК Склад,
	|
	|		ПередЗаписью.ДатаПоступления        КАК ДатаПоступления,
	|		-ПередЗаписью.КоличествоПередЗаписью КАК КоличествоИзменение
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|		, -ПередЗаписью.смартКоличествоГарантийныеПередЗаписью КАК смартКоличествоГарантийныеИзменение
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки
	|	ИЗ
	|		ВТГрафикПоступленияТоваровПередЗаписью КАК ПередЗаписью
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПриЗаписи.Номенклатура           КАК Номенклатура,
	|		ПриЗаписи.Характеристика         КАК Характеристика,
	|		ПриЗаписи.Склад                  КАК Склад,
	|
	|		ПриЗаписи.ДатаСобытия            КАК ДатаПоступления,
	|		ПриЗаписи.КоличествоИзЗаказов    КАК КоличествоИзменение
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|		, ПриЗаписи.смартКоличествоИзЗаказовГарантийные КАК смартКоличествоИзЗаказовГарантийныеИзменение
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки
	|	ИЗ
	|		РегистрНакопления.ГрафикПоступленияТоваров КАК ПриЗаписи
	|	ГДЕ
	|		ПриЗаписи.Регистратор = &Регистратор
	#Удаление //++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|		И ПриЗаписи.КоличествоИзЗаказов <> 0) КАК Набор
	#КонецУдаления
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|		И ( ПриЗаписи.КоличествоИзЗаказов <> 0
	|		ИЛИ ПриЗаписи.смартКоличествоИзЗаказовГарантийные <> 0 )) КАК Набор
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки
	|
	|СГРУППИРОВАТЬ ПО
	|	Набор.Номенклатура, Набор.Характеристика, Набор.Склад,
	|	Набор.ДатаПоступления
	|
	|ИМЕЮЩИЕ
	#Удаление //++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|	СУММА(Набор.КоличествоИзменение) <> 0");
	#КонецУдаления
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	|	СУММА(Набор.КоличествоИзменение) <> 0
	|	ИЛИ СУММА(Набор.смартКоличествоГарантийныеИзменение) <> 0");
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки

	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Регистратор", Отбор.Регистратор.Значение);
	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();

КонецФункции

#КонецОбласти