//Возвращает дерево значений
Функция ПолучитьДеревоРезультатаЗапроса(ТекстЗапроса, ПараметрыЗапроса)
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		СтруктураПараметров = Сериализатор.ПрочитатьXDTO(ПараметрыЗапроса);
		Для каждого ЭлементСтруктуры Из СтруктураПараметров Цикл
			Запрос.УстановитьПараметр(ЭлементСтруктуры.Ключ, СтруктураПараметров[ЭлементСтруктуры.Ключ]);	
		КонецЦикла;
		РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		оРезультатЗапроса = Сериализатор.ЗаписатьXDTO(РезультатЗапроса);
	Исключение
		ДеревоРезультата = Новый ДеревоЗначений;
		ДеревоРезультата.Колонки.Добавить("Ошибки");
		НоваяСтрока  = ДеревоРезультата.Строки.Добавить();
		НоваяСтрока.Ошибки = ОписаниеОшибки();
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		оРезультатЗапроса = Сериализатор.ЗаписатьXDTO(ДеревоРезультата);
	КонецПопытки;
	
	Возврат оРезультатЗапроса;
	
КонецФункции

//Возвращает таблицу значение
Функция ПолучитьТаблицуРезультатаЗапроса(ТекстЗапроса, ПараметрыЗапроса)
	
	Попытка
		Запрос = Новый Запрос;
