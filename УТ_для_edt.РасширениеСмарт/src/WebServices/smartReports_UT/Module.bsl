		Для каждого ЭлементСтруктуры Из СтруктураПараметров Цикл
			Запрос.УстановитьПараметр(ЭлементСтруктуры.Ключ, СтруктураПараметров[ЭлементСтруктуры.Ключ]);	
		КонецЦикла;
		РезультатВВидеТаблицы = Запрос.Выполнить().Выгрузить();
		оРезультатЗапроса = Сериализатор.ЗаписатьXDTO(РезультатВВидеТаблицы);
	Исключение
		ТаблицаРезультата = Новый ТаблицаЗначений;
		ТаблицаРезультата.Колонки.Добавить("Ошибки");
		НоваяСтрока  = ТаблицаРезультата.Строки.Добавить();
		НоваяСтрока.Ошибки = ОписаниеОшибки();
		Сериализатор = Новый СериализаторXDTO(ФабрикаXDTO);
		оРезультатЗапроса = Сериализатор.ЗаписатьXDTO(ТаблицаРезультата);
	КонецПопытки;
	
	Возврат оРезультатЗапроса;
	
КонецФункции
