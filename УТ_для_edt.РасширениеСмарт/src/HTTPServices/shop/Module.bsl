Функция ПолучитьОстаткиНоменклатурыПоСкладам(ДанныеЗапроса)
	УстановитьПривилегированныйРежим(Истина);
	Запрос=Новый Запрос;
	
	Данные=СтрокуJSONВДанные(ДанныеЗапроса);
	
	Склады=Неопределено;
	Если Не (Данные.Свойство("stores",Склады) И ТипЗнч(Склады)=Тип("Массив")) Тогда 
		Склады=Новый Массив;
	КонецЕсли;
	
	Товары1=Неопределено;
	Если Не (Данные.Свойство("products",Товары1) И ТипЗнч(Товары1)=Тип("Массив")) Тогда  
		Товары1=Новый Массив;
	КонецЕсли;		
    
    Характеристики=Неопределено;
    Товары=Неопределено;
    Если Товары1.Количество() Тогда 
        Характеристики=Новый ТаблицаЗначений;
        Характеристики.Колонки.Добавить("Товар");
        Характеристики.Колонки.Добавить("Характеристика");
        Товары=Новый Массив;
        Для каждого Стр Из Товары1 Цикл 
            МассивРазделительНХ=СтрРазделить(Стр,"#",Ложь); 
            Если МассивРазделительНХ.Количество()>1 Тогда 
                Товары.Добавить(МассивРазделительНХ[0]); 
                НСтрока=Характеристики.Добавить();
                НСтрока.Товар=МассивРазделительНХ[0];
                НСтрока.Характеристика=МассивРазделительНХ[1];
            ИначеЕсли МассивРазделительНХ.Количество()=1 Тогда
                Товары.Добавить(МассивРазделительНХ[0]); 
            КонецЕсли;
        КонецЦикла;  	
    КонецЕсли;              
    
    Запрос.УстановитьПараметр("ОтборПоНоменклатуре",Товары.Количество()>0);
    Запрос.УстановитьПараметр("ОтборПоСкладу",Склады.Количество()>0);  
    //Запрос.УстановитьПараметр("ОтборПоХарактеристикам",Характеристики.Количество()>0);  
    Запрос.УстановитьПараметр("Номенклатура",Товары);
    Запрос.УстановитьПараметр("Склады",Склады);   
    //Запрос.УстановитьПараметр("Характеристики",Характеристики);  
    Запрос.УстановитьПараметр("ТекДата",НачалоДня(ТекущаяДата()));
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 13.09.2020 23:00:32
    //Запрос.Текст="ВЫБРАТЬ
    //|	смартИдентификаторыСоответствияБитрикс.ГУИД КАК ГУИД,
    //|	смартИдентификаторыСоответствияБитрикс.СсылкаМет КАК Номенклатура
    //|ПОМЕСТИТЬ Товары
    //|ИЗ
    //|	РегистрСведений.смартИдентификаторыСоответствияБитрикс КАК смартИдентификаторыСоответствияБитрикс
    //|ГДЕ
    //|	смартИдентификаторыСоответствияБитрикс.СсылкаМет ССЫЛКА Справочник.Номенклатура
    //|	И ВЫБОР
    //|			КОГДА &ОтборПоНоменклатуре
    //|				ТОГДА смартИдентификаторыСоответствияБитрикс.ГУИД В (&Номенклатура)
    //|			ИНАЧЕ ИСТИНА
    //|		КОНЕЦ
    //|;
    //|
    //|////////////////////////////////////////////////////////////////////////////////
    //|ВЫБРАТЬ
    //|	смартИдентификаторыСоответствияБитрикс.ГУИД КАК ГУИД,
    //|	смартИдентификаторыСоответствияБитрикс.СсылкаМет КАК Склад
    //|ПОМЕСТИТЬ Склады
    //|ИЗ
    //|	РегистрСведений.смартИдентификаторыСоответствияБитрикс КАК смартИдентификаторыСоответствияБитрикс
    //|ГДЕ
    //|	смартИдентификаторыСоответствияБитрикс.СсылкаМет ССЫЛКА Справочник.Склады
    //|	И ВЫБОР
    //|			КОГДА &ОтборПоСкладу
    //|				ТОГДА смартИдентификаторыСоответствияБитрикс.ГУИД В (&Склады)
    //|			ИНАЧЕ ИСТИНА
    //|		КОНЕЦ
    //|;
    //|
    //|////////////////////////////////////////////////////////////////////////////////
    //|ВЫБРАТЬ
    //|	ВложенныйЗапрос.Склад КАК Склад,
    //|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
    //|	МИНИМУМ(ВложенныйЗапрос.ДатаСобытия) КАК ДатаСобытия,
    //|	СУММА(ВложенныйЗапрос.Остаток) КАК Остаток
    //|ПОМЕСТИТЬ ПланируемыеОстатки
    //|ИЗ
    //|	(ВЫБРАТЬ
    //|	ГрафикПоступленияТоваровОстатки.Склад КАК Склад,
    //|	ГрафикПоступленияТоваровОстатки.Номенклатура КАК Номенклатура,
    //|	ВЫБОР
    //|		КОГДА ГрафикПоступленияТоваровОстатки.ДатаСобытия < &ТекДата
    //|			ТОГДА &ТекДата
    //|		ИНАЧЕ ГрафикПоступленияТоваровОстатки.ДатаСобытия
    //|	КОНЕЦ КАК ДатаСобытия,
    //|	ГрафикПоступленияТоваровОстатки.КоличествоИзЗаказовОстаток КАК Остаток
    //|ИЗ
    //|	РегистрНакопления.ГрафикПоступленияТоваров.Остатки(
    //|			,
