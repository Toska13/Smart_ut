//++ #Б-1368 смарт: Лопато 19.11.2024 //Печать счета по форме 1С из ИМ. Подготовить API для выгрузки файла Счета-оферты в PDF.  
Функция invoicePOST(Запрос)

	Ответ = Новый HTTPСервисОтвет(200);
	
	ДанныеЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Попытка
   		Данные = СтрокуJSONВДанные(ДанныеЗапроса);
	Исключение
        Данные = Неопределено;
	КонецПопытки;	
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		
		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "Данные не получены");
		
		Возврат Ответ;
		
	КонецЕсли;
	
	ДокЗаказ = Неопределено;

	Если Данные.Свойство("order") 
		И ЗначениеЗаполнено(Данные.order) Тогда
		
		Попытка

			ДокЗаказ = Документы.ЗаказКлиента.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.order));
			
		Исключение
			
			УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "GUID заказа не корректен");
			
			Возврат Ответ;
			
		КонецПопытки;	
		
	Иначе
		
		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "GUID заказа не заполнен");

		Возврат Ответ;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокЗаказ) Тогда

		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "Заказ клиента " + Данные.order + " не найден");
		
	Иначе		
		
		ТабДокСчетНаОплату = смартИнтернетМагазин.СформироватьПечатнуюФормуСчетаНаОплату(ДокЗаказ);
		
		Если ТипЗнч(ТабДокСчетНаОплату) = Тип("ТабличныйДокумент") Тогда
			
			СчетНаОплатуПоток = Новый ПотокВПамяти();
			
			ТабДокСчетНаОплату.Записать(СчетНаОплатуПоток, ТипФайлаТабличногоДокумента.PDF);
			
			СчетНаОплатуДвоичныеДанные = СчетНаОплатуПоток.ЗакрытьИПолучитьДвоичныеДанные();
			
			Ответ.УстановитьТелоИзДвоичныхДанных(СчетНаОплатуДвоичныеДанные);
			
		Иначе

			УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "Ошибка формирования счета на оплату " + СокрЛП(ДокЗаказ));
			
		КонецЕсли;	

	КонецЕсли;	

	Возврат Ответ;
	
КонецФункции //-- #Б-1368 смарт: Лопато 19.11.2024

//++ #Б-1652 смарт: Лопато 18.12.2024 //Добавить раздел "Мое оборудование". Создать ветку API, подготовить структуру ответа  
Функция GetSalesInfo(Запрос)

	Ответ = Новый HTTPСервисОтвет(200);
	
	ДанныеЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Попытка
   		Данные = СтрокуJSONВДанные(ДанныеЗапроса);
	Исключение
        Данные = Неопределено;
	КонецПопытки;	
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		
		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "Данные не получены");
		
		Возврат Ответ;
		
	КонецЕсли;
	
	Партнер = Неопределено;

	Если Данные.Свойство("PARTNER_XML_ID") 
		И ЗначениеЗаполнено(Данные.PARTNER_XML_ID) Тогда
		
		Попытка

			Партнер = Справочники.Партнеры.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.PARTNER_XML_ID));
			
		Исключение
			
			УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "GUID партнера не корректен");
			
			Возврат Ответ;
			
		КонецПопытки;	
		
	Иначе
		
		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "GUID партнера не заполнен");

		Возврат Ответ;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Партнер) Тогда

		УстановитьВОтветСообщениеОбОшибке(Ответ, 207, "Партнер " + Данные.PARTNER_XML_ID + " не найден");
		
	Иначе		
		
		Данные = ПолучитьДанныеПоОборудованиюПартнера(Партнер);
		
		Ответ.УстановитьТелоИзСтроки(Данные, КодировкаТекста.UTF8);
		
	КонецЕсли;	

	Возврат Ответ;
	
КонецФункции //-- #Б-1652 смарт: Лопато 18.12.2024

