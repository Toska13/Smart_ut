Функция ДанныеВСтрокуJSON(Данные)
	Запись=Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись,Данные);
	Возврат Запись.Закрыть();
КонецФункции	

Функция СтрокуJSONВДанные(Стр)
	Чтение=Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Данные=ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции	

Функция ПолучитьСсылкиПоГУИД(МассивГуидов,Имя,Тип="Справочник")
	МассивСсылок=Новый Массив;
	Для Каждого Эл Из МассивГуидов Цикл
		Если Тип="Справочник" Тогда 
			МассивСсылок.Добавить(Справочники[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Эл)));
		ИначеЕсли Тип="Документ" Тогда 
			МассивСсылок.Добавить(Документы[Имя].ПолучитьСсылку(Новый УникальныйИдентификатор(Эл)));
		КонецЕсли;	
	КонецЦикла;
	Возврат МассивСсылок;
КонецФункции

Процедура ТестПолученияЗапросаНаПолучениеНовыхДанных(Данные,Тема)
	УчетнаяЗапись=РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ДанныеДляОтправки=Новый Структура;
	ДанныеДляОтправки.Вставить("Кому","debugging1c@smart-t.ru"); //+-#1207 смарт: Каратеев 06.10.2022 //Замена получателя рассылки.
	ДанныеДляОтправки.Вставить("Тема",Тема+" "+СтрокаСоединенияИнформационнойБазы()); //+-#1207 смарт: Каратеев 18.10.2022 //Добавление инфо из базы рассылки.
	ДанныеДляОтправки.Вставить("Тело",ДанныеВСтрокуJSON(Данные));
	ДанныеДляОтправки.Вставить("ТипТекста",ТипТекстаПочтовогоСообщения.ПростойТекст);
	ДанныеДляОтправки.Вставить("Важность",ВажностьИнтернетПочтовогоСообщения.Высокая);
	
	РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись,ДанныеДляОтправки);
КонецПроцедуры	

