    //|					(ВЫБРАТЬ
    //|						Склады.Склад
    //|					ИЗ
    //|						Склады)) КАК ГрафикПоступленияТоваровОстатки
    //|
    //|ОБЪЕДИНИТЬ ВСЕ
    //|
    //|ВЫБРАТЬ
    //|	ГрафикОтгрузкиТоваровОстатки.Склад,
    //|	ГрафикОтгрузкиТоваровОстатки.Номенклатура,
    //|	ВЫБОР
    //|		КОГДА ГрафикОтгрузкиТоваровОстатки.ДатаОтгрузки <= &ТекДата
    //|			ТОГДА &ТекДата
    //|		ИНАЧЕ """"
    //|	КОНЕЦ,
    //|	-ГрафикОтгрузкиТоваровОстатки.КоличествоИзЗаказовОстаток
    //|ИЗ
    //|	РегистрНакопления.ГрафикОтгрузкиТоваров.Остатки(
    //|			,
    //|			Номенклатура В
    //|					(ВЫБРАТЬ
    //|						Товары.Номенклатура
    //|					ИЗ
    //|						Товары)
    //|				И Склад В ИЕРАРХИИ
    //|					(ВЫБРАТЬ
    //|						Склады.Склад
    //|					ИЗ
    //|						Склады)) КАК ГрафикОтгрузкиТоваровОстатки) КАК ВложенныйЗапрос

    //|
    //|СГРУППИРОВАТЬ ПО
    //|	ВложенныйЗапрос.Склад,
    //|	ВложенныйЗапрос.Номенклатура
    //|
    //|ИМЕЮЩИЕ
    //|	СУММА(ВложенныйЗапрос.Остаток) > 0
    //|;
    //|
