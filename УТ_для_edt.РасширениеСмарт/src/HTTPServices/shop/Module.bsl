		Если ЗначениеЗаполнено(ЗаказСсылка) Тогда
			
			ТекстОферта = смартОбщегоНазначения.смартСформироватьТекстОферты(ЗаказСсылка);
			ТекстОфертаСайт = Б_ОбменССайтомСерверВыгрузкаДанных.смартДополнитьТекстТегами(ТекстОферта);
			
			Данные = Новый Структура("OFERTA", XMLСтрока(ТекстОфертаСайт));  
			
			Результат.Добавить(Данные);

		КонецЕсли;	

	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ДанныеВСтрокуJSON(Результат);
	
КонецФункции //--#1311 смарт: Лопато 03.04.2023

//++ #Б-1368 смарт: Лопато 19.11.2024 //Печать счета по форме 1С из ИМ. Подготовить API для выгрузки файла Счета-оферты в PDF.  
Процедура УстановитьВОтветСообщениеОбОшибке(Ответ, КодСостояния, Сообщение)

	Ответ.КодСостояния = КодСостояния;
	Ответ.Заголовки.Вставить("Content-Type", "text/html;charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Сообщение, КодировкаТекста.UTF8);
    Ответ.Причина = Сообщение;
	
