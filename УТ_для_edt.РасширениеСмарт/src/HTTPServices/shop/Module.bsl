//++ #Б-1652 смарт: Лопато 18.12.2024 //Добавить раздел "Мое оборудование". Создать ветку API, подготовить структуру ответа  
Функция ПолучитьДанныеПоОборудованиюПартнера(Партнер) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Период КАК ДатаПродажи,
		|	АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
		|	АналитикаУчетаНоменклатуры.Серия КАК Серия
		|ПОМЕСТИТЬ ОборудованиеКлиентов
		|ИЗ
		|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(
		|		,
		|		,
		|		ДЕНЬ,
		|		АналитикаУчетаПоПартнерам.Партнер = &Партнер
		|		И АналитикаУчетаНоменклатуры.Номенклатура.ВидНоменклатуры = &ВидНоменклатуры)
		|;
		|
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДатаПродажи КАК ДатаПродажи,
		|	Номенклатура КАК Номенклатура,
		|	Серия КАК Серия,
		|	Серия.Номер КАК НомерСерии
		|ИЗ 
		|	ОборудованиеКлиентов
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПродажи,
		|	Номенклатура,
		|	Серия,
		|	НомерСерии
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		//++ #Б3006 смарт: Шляпников 17.04.2025 / Не корректно подставляется номенклатура по оборудованию клиента в Заявке на ремонт
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТехОбслуживание.ДатаТОУКлиента КАК ДатаТОУКлиента,
		|	Чернила.Номенклатура КАК Номенлатура,
		|	ТехОбслуживание.Серия КАК Серия,
		|	ТехОбслуживание.Запчасть КАК Запчасть
		|ИЗ
		|	РегистрСведений.смартТехническоеОбслуживаниеОборудованияПоКлиентам КАК ТехОбслуживание
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартОборудованиеЧернилаКлиентов КАК Чернила
		|		ПО ТехОбслуживание.Оборудование = Чернила.ОборудованиеКлиентов
		|		И Чернила.СопоставлениеСТоваром
		|ГДЕ
		|	(ТехОбслуживание.Клиент, Чернила.Номенклатура, ТехОбслуживание.Серия) 
		|		В (ВЫБРАТЬ Клиент, Номенклатура, Серия ИЗ ОборудованиеКлиентов)
		|
		//-- #Б3006 смарт: Шляпников 17.04.2025
		|УПОРЯДОЧИТЬ ПО
		|	ДатаТОУКлиента,
		|	Номенлатура,
		|	Серия,
		|	Запчасть
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("ВидНоменклатуры", 
		Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();

	ТаблицаПоОборудованию = РезультатЗапроса[1].Выгрузить();
	ТаблицаПоОбслуживанию = РезультатЗапроса[2].Выгрузить();
	
	Для Каждого СтрОборудование Из ТаблицаПоОборудованию Цикл 

		//Оборудование
		СтруктураОборудование = Новый Структура("ID, Name, Serial, DateOfSale, Maintenance");
		
		СтруктураОборудование.ID 		 = XMLСтрока(СтрОборудование.Номенклатура);
		СтруктураОборудование.Name 		 = СокрЛП(СтрОборудование.Номенклатура);
		СтруктураОборудование.Serial 	 = СокрЛП(СтрОборудование.НомерСерии);
		СтруктураОборудование.DateOfSale = Формат(СтрОборудование.ДатаПродажи, "ДФ=yyyy-MM-dd");
		
		//Обслуживание
		МассивОбслуживание = Новый Массив;	

		ОтборОбслуживание = Новый Структура;
		ОтборОбслуживание.Вставить("Номенлатура", СтрОборудование.Номенклатура);
		ОтборОбслуживание.Вставить("Серия", 	  СтрОборудование.Серия);
		
		СтрокиОбслуживание = ТаблицаПоОбслуживанию.НайтиСтроки(ОтборОбслуживание);

		Для Каждого СтрокаОбслуживание Из СтрокиОбслуживание Цикл
		
			СтруктураОбслуживание = Новый Структура("DateOFMaintenance, NameOfSparePart");

			СтруктураОбслуживание.DateOFMaintenance = Формат(СтрокаОбслуживание.ДатаТОУКлиента, "ДФ=yyyy-MM-dd");
			СтруктураОбслуживание.NameOfSparePart	= СокрЛП(СтрокаОбслуживание.Запчасть);
			
			МассивОбслуживание.Добавить(СтруктураОбслуживание);
			
		КонецЦикла;

		СтруктураОборудование.Вставить("Maintenance", МассивОбслуживание);
		
		Результат.Добавить(СтруктураОборудование);
		
	КонецЦикла;	
	
	Возврат ДанныеВСтрокуJSON(Результат);
	
КонецФункции //-- #Б-1652 смарт: Лопато 18.12.2024	
	
#КонецОбласти


