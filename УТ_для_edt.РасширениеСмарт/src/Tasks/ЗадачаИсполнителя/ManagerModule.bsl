//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
&ИзменениеИКонтроль("ДобавитьКомандыСозданияНаОсновании")
Процедура смарт_ДобавитьКомандыСозданияНаОсновании(КомандыСозданияНаОсновании, Параметры)

	БизнесПроцессы.Задание.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);

	#Вставка
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ
	Документы.CRM_Интерес.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.ЗаказНаПеремещение.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.ЗаказНаСборку.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.смартЗаявкаНаРемонтныеРаботы.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	Документы.смартЗаявкаНаРазборкуОборудования.ДобавитьКомандуСоздатьНаОсновании(КомандыСозданияНаОсновании);
	//-- #1989 смарт: Лопато 15.08.2024
	#КонецВставки

КонецПроцедуры

//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
&ИзменениеИКонтроль("ОбработкаПолученияПредставления")
Процедура смарт_ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Наименование = ?(ПустаяСтрока(Данные.Наименование), НСтр("ru = 'Без описания'"), Данные.Наименование);
	Дата = Формат(Данные.Дата, ?(ПолучитьФункциональнуюОпцию("ИспользоватьДатуИВремяВСрокахЗадач"), "ДЛФ=DT", "ДЛФ=D"));
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 от %2'"), Наименование, Дата);
	СтандартнаяОбработка = Ложь;

	#Вставка
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ
	Представление = "Задача " + Представление;
	//-- #1989 смарт: Лопато 15.08.2024
	#КонецВставки
	
КонецПроцедуры

//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
&ИзменениеИКонтроль("ОбработкаПолученияФормы")
Процедура смарт_ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)

	// +CRM
	УстановитьПривилегированныйРежим(Истина);
	// -CRM
	
	Если ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Ключ") Тогда
		ПараметрыФормы = БизнесПроцессыИЗадачиВызовСервера.ФормаВыполненияЗадачи(Параметры.Ключ);
		ИмяФормыЗадачи = "";
		Результат = ПараметрыФормы.Свойство("ИмяФормы", ИмяФормыЗадачи);
		Если Результат Тогда
			ВыбраннаяФорма = ИмяФормыЗадачи;
			СтандартнаяОбработка = Ложь;
			ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(Параметры, ПараметрыФормы.ПараметрыФормы, Ложь);
		КонецЕсли; 
	КонецЕсли;

	#Вставка
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ
	Если ВидФормы = "ФормаОбъекта" И Параметры.Свойство("Основание") Тогда
		ВыбраннаяФорма = "CRM_ФормаЛичнойЗадачи";
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	//-- #1989 смарт: Лопато 15.08.2024
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли