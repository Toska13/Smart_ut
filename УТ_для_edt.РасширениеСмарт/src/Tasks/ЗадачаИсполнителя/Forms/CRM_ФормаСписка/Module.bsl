#Область ДоработкиСмарт

&НаКлиенте
//++ #1914 смарт: Фролов 10.07.2024 //Доработка формы Мои задачи для коммерческого отдела.
Процедура смартТаблицаПоказателейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанные.ЭтоИсполнитель Тогда
		
		ЭтаФорма.ОтборИсполнитель = ТекущиеДанные.Пользователь;
		
		Список.Параметры.УстановитьЗначениеПараметра("Исполнитель", ТекущиеДанные.Пользователь);
		
	Иначе
		
		ЭтаФорма.смартОтборАвтор = ТекущиеДанные.Пользователь;
		
		Если ЗначениеЗаполнено(ЭтаФорма.смартОтборАвтор) Тогда
			CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Автор", ЭтаФорма.смартОтборАвтор, Истина);
		Иначе	
			CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Автор");
		КонецЕсли;
		
	КонецЕсли;
	
	смартОбновитьТаблицуПоказателей();
	
КонецПроцедуры //-- #1914 смарт: Фролов 10.07.2024

//++ #1914 смарт: Фролов 10.07.2024 //Доработка формы Мои задачи для коммерческого отдела.
&НаСервере
Процедура смартОбновитьТаблицуПоказателей()
	
	Схема = Элементы.Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема,Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;

	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ТаблицаАвторов = Новый ТаблицаЗначений;
	ТаблицаАвторов.Колонки.Добавить("Пользователь");
	ТаблицаАвторов.Колонки.Добавить("Количество");

	ТаблицаИсполнителей = Новый ТаблицаЗначений;
	ТаблицаИсполнителей.Колонки.Добавить("Пользователь");
	ТаблицаИсполнителей.Колонки.Добавить("Количество");
	
	Для Каждого СтрРезультат Из Результат Цикл
		
		СтрАвтор = ТаблицаАвторов.Найти(СтрРезультат.Автор, "Пользователь");
		
		Если СтрАвтор = Неопределено Тогда
			СтрАвтор = ТаблицаАвторов.Добавить();
			СтрАвтор.Пользователь = СтрРезультат.Автор;
			СтрАвтор.Количество = 1;	
		Иначе	
			СтрАвтор.Количество = СтрАвтор.Количество + 1;
		КонецЕсли;

		СтрИсполнитель = ТаблицаИсполнителей.Найти(СтрРезультат.ИсполнительРоль, "Пользователь");
		
		Если СтрИсполнитель = Неопределено Тогда
			СтрИсполнитель = ТаблицаИсполнителей.Добавить();
			СтрИсполнитель.Пользователь = СтрРезультат.ИсполнительРоль;
			СтрИсполнитель.Количество = 1;	
		Иначе	
			СтрИсполнитель.Количество = СтрИсполнитель.Количество + 1;
		КонецЕсли;
		
	КонецЦикла;	
		
	Попытка
		ЭтаФорма.ТаблицаПоказателей.Очистить();
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ТаблицаАвторов.Количество() > 0 Тогда
		
		СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		СтрТаблицаПоказателей.Показатель = "Автор задачи:";
		СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		
		Для Каждого СтрТаблицаАвторов Из ТаблицаАвторов Цикл
			
			СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			СтрТаблицаПоказателей.Показатель = СтрТаблицаАвторов.Пользователь;
			СтрТаблицаПоказателей.Пользователь = СтрТаблицаАвторов.Пользователь;
			СтрТаблицаПоказателей.Количество = СтрТаблицаАвторов.Количество;
			
		КонецЦикла;	
	
	КонецЕсли;
	
	Если ТаблицаИсполнителей.Количество() > 0 Тогда
		
		СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		СтрТаблицаПоказателей.Показатель = "Исполнитель:";
		СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
		
		Для Каждого СтрТаблицаИсполнителей Из ТаблицаИсполнителей Цикл
			
			СтрТаблицаПоказателей = ЭтаФорма.ТаблицаПоказателей.Добавить();
			СтрТаблицаПоказателей.Показатель = СтрТаблицаИсполнителей.Пользователь;
			СтрТаблицаПоказателей.Пользователь = СтрТаблицаИсполнителей.Пользователь;
			СтрТаблицаПоказателей.Количество = СтрТаблицаИсполнителей.Количество;
			СтрТаблицаПоказателей.ЭтоИсполнитель = Истина;
			
		КонецЦикла;	
	
	КонецЕсли;
	
КонецПроцедуры //-- #1914 смарт: Фролов 10.07.2024	

