Процедура смарт_ЗаписатьНаборСвойствВРегистр(Знач Ссылка, Знач ЗначенияСвойств)  ////++ смарт:Демичев №921 22.03.2022 Проверяем на Интерактивную запись свойство

	УстановитьПривилегированныйРежим(Истина);

	//++ смарт:Демичев №921 22.03.2022
	ПВХИД = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул","ВИПКлиент");
	//-- смарт:Демичев №921 22.03.2022 	
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
