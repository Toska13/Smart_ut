
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Параметры.Свойство("Информация") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры формы.'");
	КонецЕсли;

	Если Параметры.Свойство("Заголовок") Тогда
		ЭтотОбъект.Заголовок = НСтр("ru = '" + Параметры.Заголовок + "'");
	КонецЕсли;	
	
	Если Параметры.Свойство("Информация") Тогда
		Элементы.ДекорацияИнформация.Заголовок = Параметры.Информация;
	КонецЕсли;	
	
КонецПроцедуры

