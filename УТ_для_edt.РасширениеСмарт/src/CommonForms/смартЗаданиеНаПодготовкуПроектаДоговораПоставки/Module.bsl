&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Владелец=ЭтаФорма.ВладелецФормы.Объект;
	ВладелецФорма=ЭтаФорма.ВладелецФормы; 
	ЭтаФорма.Контрагент=Владелец.Контрагент;
	ЭтаФорма.Партнер=Владелец.Партнер; 
	ЭтаФорма.Организация=Владелец.Организация;
	ЭтаФорма.СпособДоставки=Владелец.СпособДоставки;
	ЭтаФорма.АдресДоставки=Владелец.АдресДоставки;  
	ЭтаФорма.АдресДоставкиЗначение=Владелец.АдресДоставкиЗначение; 
