&НаСервере
Процедура ПриОткрытииНаСервере(Владелец) 
	Если ЗначениеЗаполнено(Владелец.Договор) Тогда
		ЭтаФорма.ОтветственноеЛицоОрганизации=Владелец.Договор.смартОтветственноеЛицоОрганизации;
		ЭтаФорма.ДатаДоговора=Владелец.Договор.Дата; 
	КонецЕсли;
	ЭтаФорма.СкладСамовывоза=?(Владелец.Склад.ЭтоГруппа,Владелец.Товары[0].Склад,Владелец.Склад);
		
	//++ #5432 смарт: Тимофеева 28.01.26 / Задание на подготовку проекта договора поставки. Скорректировать поля доставки. 
	Если ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз 
		И ЭтоСкладОтветственногоХраненияАдмиралАтлант(ЭтаФорма.СкладСамовывоза) Тогда
		ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал;
	КонецЕсли;
    //-- #5432 смарт: Тимофеева 28.01.26

	СтруктураАдреса=ПолучитьАдресСкладаНаСервере();
	ЭтаФорма.Элементы.ДекорацияАдресСклада.Заголовок=СтруктураАдреса.АдресСклада;
	Если ЭтаФорма.АдресДоставки="" Тогда
		ЭтаФорма.АдресДоставки=ЭтаФорма.Элементы.ДекорацияАдресСклада.Заголовок;	
	КонецЕсли;
	СпособДоставкиПриИзмененииНаСервере();
	//++ #Б-3312 смарт: Лопато 16.06.2025 //Задание на подготовку проекта договора поставки. Доработка Условий оплаты. Этап 1.  
	// Закомментировал код
	//ЭтаФорма.ЭтапыГрафикаОплаты.Загрузить(Владелец.ЭтапыГрафикаОплаты.Выгрузить());
	//-- #Б-3312 смарт: Лопато 16.06.2025
	
	//++ #Б-1790 смарт: Фролов 10.02.2025 //Шаблон договора. Исключить сумму дополнительной гарантии из суммы договора.
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СУММА(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаСНДС
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Номенклатура = &ДопГарантия
	|	И ЗаказКлиентаТовары.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("ДопГарантия", Справочники.смартПредопределенныеЗначения.НоменклатураДополнительнойГарантии.Значение);
	Запрос.УстановитьПараметр("Ссылка", Владелец.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЭтаФорма.СуммаДополнительнойГарантии = Выборка.СуммаСНДС;	
		
	КонецЕсли;	
	//-- #Б-1790 смарт: Фролов 10.02.2025
	
	ЭтаФорма.СуммаДокумента=Владелец.Товары.Итог("СуммаСНДС");  
	УстановитьСписокВыбораГрузополучателя(ЭтаФорма.Контрагент);
	Если Владелец.Партнер.Дилер ИЛИ Владелец.Партнер.смартДилерБывший Тогда
		Элементы.ДекорацияДилер.Видимость=Истина;	
	Иначе
		Элементы.ДекорацияДилер.Видимость=Ложь;		
	КонецЕсли;	
КонецПроцедуры

&НаСервере	
Функция ПолучитьДанныеДляСпискаВыбора()

	МассивОтветственныхЛиц = Новый Массив;
	Отбор = Новый Структура("Дата, Организация", ?(ЗначениеЗаполнено(ЭтаФорма.ДатаДоговора),ЭтаФорма.ДатаДоговора,ТекущаяДата()), ЭтаФорма.Организация);	
	ТЗОЛ =  ОтветственныеЛицаСервер.ПолучитьТаблицуОтветственныхЛицПоОтбору(Отбор);
	ТЗОЛ.Сортировать("Наименование Возр");
	МассивОтветственныхЛиц = ТЗОЛ.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивОтветственныхЛиц;			
	
КонецФункции

&НаКлиенте
Процедура НадписьЭтапыОплатыНажатиеЗавершение(ПараметрыОплаты, ДополнительныеПараметры) Экспорт
	Владелец=ЭтаФорма.ВладелецФормы.Объект;
	ВладелецФорма=ЭтаФорма.ВладелецФормы;
	Если ПараметрыОплаты <> Неопределено Тогда
		
		ОтразитьИзмененияЭтаповОплаты(ПараметрыОплаты,Владелец);
		
	КонецЕсли;
	
	НадписьЭтапыОплаты = НадписьЭтапыОплаты(ВладелецФорма, Истина, ЭтаФорма.ЭтапыГрафикаОплаты.Итог("СуммаПлатежа"));

КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуДопустимогоОтклоненияПредоплатыПоДокументу(Владелец)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.СуммаСНДС    КАК СуммаСНДС
	|ПОМЕСТИТЬ ВТТоварыЗаказа
	|ИЗ &ТоварыЗаказа КАК Товары
	|;
	|///////////////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	СУММА(ВЫРАЗИТЬ(Товары.СуммаСНДС * &ДопустимоеОтклонениеМерныхТоваров/100 КАК ЧИСЛО(31,2))) КАК Сумма
	|ИЗ ВТТоварыЗаказа КАК Товары
	|ГДЕ Товары.Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины В (&МерныеТипыЕдиницИзмерений)";
	
	Запрос.УстановитьПараметр("ДопустимоеОтклонениеМерныхТоваров",
		Константы.ДопустимоеОтклонениеОтгрузкиПриемкиМерныхТоваров.Получить());
	Запрос.УстановитьПараметр("ТоварыЗаказа",Владелец.Товары.Выгрузить());
	Запрос.УстановитьПараметр("МерныеТипыЕдиницИзмерений",
		Справочники.УпаковкиЕдиницыИзмерения.МерныеТипыЕдиницИзмерений());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

