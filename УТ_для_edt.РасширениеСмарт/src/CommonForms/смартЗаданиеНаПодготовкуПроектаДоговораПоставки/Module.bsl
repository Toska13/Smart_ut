&НаКлиенте
Процедура ОтветственноеЛицоОрганизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	//СтандартнаяОбработка = Ложь;
	//++ #1579 смарт: Фролов 18.12.2023 //Доработать Поиск в "Задание на подготовку проекта договора поставки (смарт)"
	//Перенес кусок кода в процедуру ПриОткрытии
КонецПроцедуры 

&НаКлиенте
Процедура НадписьЭтапыОплатыНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Владелец=ЭтаФорма.ВладелецФормы.Объект;
	ВладелецФорма=ЭтаФорма.ВладелецФормы;
	Попытка
		ЗаблокироватьДанныеФормыДляРедактирования();
	Исключение
		ПоказатьПредупреждение(Неопределено, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТолькоПросмотр",             ТолькоПросмотр 
	                                                      Или Не РедактированиеРеквизитовEDIКлиентСервер.РеквизитДоступенДляРедактирования(ВладелецФорма, "ЭтапыГрафикаОплаты"));
	ПараметрыФормы.Вставить("СуммаОплатыПоДокументу",     ВладелецФорма.СуммаЗаказано);
	ПараметрыФормы.Вставить("СуммаЗалогаПоДокументу",     ВладелецФорма.СуммаЗалогаЗаТару);
	ПараметрыФормы.Вставить("СуммаОтклоненияПоДокументу", Владелец.ЭтапыГрафикаОплаты.Итог("СуммаОтклоненияМерныхТоваров"));
	ПараметрыФормы.Вставить("СуммаДопустимогоОтклоненияПоДокументу",
		ПолучитьСуммуДопустимогоОтклоненияПредоплатыПоДокументу(Владелец));
	ПараметрыФормы.Вставить("ТребуетсяЗалогЗаТару",       Владелец.ВернутьМногооборотнуюТару И Владелец.ТребуетсяЗалогЗаТару);
	ПараметрыФормы.Вставить("ГрафикОплаты",               Владелец.ГрафикОплаты);
	Если ПроверитьПравоНаЧтениеСоглашения() Тогда
		ПараметрыФормы.Вставить("Соглашение",             Владелец.Соглашение);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЖелаемаяДатаОтгрузки",       ?(ЗначениеЗаполнено(Владелец.ЖелаемаяДатаОтгрузки), Владелец.ЖелаемаяДатаОтгрузки, Владелец.ДатаОтгрузки));
	ПараметрыФормы.Вставить("Дата",                       Владелец.Дата);
	ПараметрыФормы.Вставить("Валюта",                     Владелец.Валюта);
	ПараметрыФормы.Вставить("УникальныйИдентификатор",    УникальныйИдентификатор);
