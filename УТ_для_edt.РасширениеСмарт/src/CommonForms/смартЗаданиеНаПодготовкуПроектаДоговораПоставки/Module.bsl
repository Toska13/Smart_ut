&НаСервере
//++ #Б-1728 смарт: Фролов 28.01.2025 //Создание пользователя ИМ на основании договора поставки. Подготовка переменных текста
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	//++ #3938 смарт: Тимофеева 10.11.2025 / Задание на подготовку проекта договора поставки. Печать договора из Заказа клиента и Договор контрагента. Доработка Условий оплаты.
	Если ПроизвольнаяОплата Тогда
		ДатаОтсчета 		= ТекущаяДата();
		ПредыдущаяДата 		= Неопределено;
		Для Каждого СтрокаПравилаОплаты Из ЭтаФорма.ПравилаОплаты Цикл		
			Если НЕ ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не заполнена дата платежа в строке %1", СтрокаПравилаОплаты.НомерСтроки),,,, Отказ);
			ИначеЕсли НачалоДня(СтрокаПравилаОплаты.ДатаПлатежа) < НачалоДня(ДатаОтсчета) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Дата платежа меньше текущей даты в строке %1", СтрокаПравилаОплаты.НомерСтроки),,,, Отказ);
			КонецЕсли;
			
			Если НЕ СтрокаПравилаОплаты.НомерСтроки = 1 
				И ЗначениеЗаполнено(ПредыдущаяДата) 
				И ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) 
				И ПредыдущаяДата >= СтрокаПравилаОплаты.ДатаПлатежа Тогда 
				
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Дата платежа меньше/равна предыдущей дате платежа в строке %1", СтрокаПравилаОплаты.НомерСтроки),,,, Отказ);
							
			КонецЕсли;     	
			ПредыдущаяДата = СтрокаПравилаОплаты.ДатаПлатежа;
		КонецЦикла; 
	КонецЕсли;
    //-- #3938 смарт: Тимофеева 10.11.2025
	
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.Настройки.ДатаНачалаКонтроляПользователяИМВДоговоре)
		И ТекущаяДата() > Справочники.смартПредопределенныеЗначения.Настройки.ДатаНачалаКонтроляПользователяИМВДоговоре Тогда
		ПроверяемыеРеквизиты.Добавить("КонтактноеЛицоДляЛК");
		//++ #Б-2748 смарт: Фролов 20.03.2025 //Доработка формы создания договора
		ПроверяемыеРеквизиты.Добавить("ТелефонДляЛК");
		ПроверяемыеРеквизиты.Добавить("ЭлектроннаяПочтаДляЛК");
		//-- #Б-2748 смарт: Фролов 20.03.2025
	КонецЕсли;
	
	//++ #Б-3582 смарт: Лопато 25.06.2025 //Задание на подготовку проекта договора поставки. Доработка. 
	Если ОбщегоНазначенияУТКлиентСервер.ЭтоЮрЛицо(ЭтаФорма.Контрагент.ЮрФизЛицо) Тогда
		ПроверяемыеРеквизиты.Добавить("ДолжностьУполномеченногоЛицаОтКонтрагента");
	КонецЕсли;
	//-- #Б-3582 смарт: Лопато 25.06.2025
	
КонецПроцедуры //-- #Б-1728 смарт: Фролов 28.01.2025

#КонецОбласти

