&НаСервере
Процедура ЗаполнитьДатыДниПравилОплатыНаСервере()

	ДатаОтсчета = ТекущаяДата();
	
	ПредыдущаяДата = Неопределено;
	СуммаПроцентПлатежа = 0;
	
	Для Каждого СтрокаПравилаОплаты Из ЭтаФорма.ПравилаОплаты Цикл
		
		//++ #3938 смарт: Тимофеева 10.11.2025 / Задание на подготовку проекта договора поставки. Печать договора из Заказа клиента и Договор контрагента. Доработка Условий оплаты.
		Если ПроизвольнаяОплата И ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) И НачалоДня(СтрокаПравилаОплаты.ДатаПлатежа) < НачалоДня(ДатаОтсчета) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Дата платежа в строке %1 меньше текущей даты", СтрокаПравилаОплаты.НомерСтроки));
		КонецЕсли;
		//-- #3938 смарт: Тимофеева 10.11.2025 
		
		
		Если СтрокаПравилаОплаты.НомерСтроки = 1 Тогда
			
			//++ #5416 смарт: Тимофеева 28.01.26 / Задание на подготовку проекта договора поставки. Проверка расчета дат платежа.
			Если НЕ ПроизвольнаяОплата И ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) И НачалоДня(СтрокаПравилаОплаты.ДатаПлатежа) < НачалоДня(ДатаОтсчета) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Дата платежа в строке %1 не может быть меньше текущей даты", СтрокаПравилаОплаты.НомерСтроки));
				СтрокаПравилаОплаты.ДатаПлатежа = ДатаОтсчета;
			КонецЕсли;
			//-- #5416 смарт: Тимофеева 28.01.26 
			
			Если ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) Тогда
				
				СтрокаПравилаОплаты.Дни = КалендарныеГрафики.РазностьДатПоКалендарю(КалендарныеГРафики.ОсновнойПроизводственныйКалендарь(), 
																					ДатаОтсчета, СтрокаПравилаОплаты.ДатаПлатежа);
				
			КонецЕсли;
			
		Иначе

			//++ #3938 смарт: Тимофеева 10.11.2025 / Задание на подготовку проекта договора поставки. Печать договора из Заказа клиента и Договор контрагента. Доработка Условий оплаты.
			//СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПредыдущаяДата, ЭтаФорма.СрокПоставки);
			//СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(СтрокаПравилаОплаты.ДатаПлатежа, СтрокаПравилаОплаты.Дни);
			
			Если НЕ ПроизвольнаяОплата Тогда
				
				//++ #5416 смарт: Тимофеева 28.01.26 / Задание на подготовку проекта договора поставки. Проверка расчета дат платежа.
				//СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПредыдущаяДата, ЭтаФорма.СрокПоставки);
				//СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(СтрокаПравилаОплаты.ДатаПлатежа, СтрокаПравилаОплаты.Дни);
				Если СтрокаПравилаОплаты.НомерСтроки = 2 Тогда
					СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПредыдущаяДата, ЭтаФорма.СрокПоставки);
					СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(СтрокаПравилаОплаты.ДатаПлатежа, СтрокаПравилаОплаты.Дни);
				Иначе
					СтрокаПравилаОплаты.ДатаПлатежа = смартОбщегоНазначения.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ПредыдущаяДата, СтрокаПравилаОплаты.Дни);					
				КонецЕсли;
				//-- #5416 смарт: Тимофеева 28.01.26
			Иначе
				
				Если ЗначениеЗаполнено(ПредыдущаяДата) И ЗначениеЗаполнено(СтрокаПравилаОплаты.ДатаПлатежа) Тогда 
					
					Если ПредыдущаяДата >= СтрокаПравилаОплаты.ДатаПлатежа Тогда 
						ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Дата платежа меньше/равна предыдущей дате платежа в строке %1", СтрокаПравилаОплаты.НомерСтроки));
					КонецЕсли;
					
					СтрокаПравилаОплаты.Дни = КалендарныеГрафики.РазностьДатПоКалендарю(КалендарныеГРафики.ОсновнойПроизводственныйКалендарь(), 
																						ПредыдущаяДата, СтрокаПравилаОплаты.ДатаПлатежа);
				Иначе
					СтрокаПравилаОплаты.Дни = 0; 
				КонецЕсли; 
				
			КонецЕсли;																	
			//-- #3938 смарт: Тимофеева 10.11.2025
	
		КонецЕсли;

		Если СтрокаПравилаОплаты.НомерСтроки = ЭтаФорма.КоличествоЭтаповОплаты Тогда
			
			СтрокаПравилаОплаты.ПроцентПлатежа = 100 - СуммаПроцентПлатежа;
			
		КонецЕсли;	
		
		ПредыдущаяДата = СтрокаПравилаОплаты.ДатаПлатежа;
		СуммаПроцентПлатежа = СуммаПроцентПлатежа + СтрокаПравилаОплаты.ПроцентПлатежа;
		
	КонецЦикла;
	
КонецПроцедуры

