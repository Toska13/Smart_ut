&НаСервере
Процедура смартСформироватьНомерДоговора(НовыйДоговор)
	Префикс = "";
	
	Если НовыйДоговор.смартВидДоговора = Перечисления.смартВидыДоговоров.Оборудование 
		И НовыйДоговор.Организация = Справочники.Организации.НайтиПоНаименованию("СМАРТ-Т ООО", Истина) Тогда
		Префикс = "О";
	ИначеЕсли НовыйДоговор.смартВидДоговора = Перечисления.смартВидыДоговоров.Оборудование 
		И НовыйДоговор.Организация = Справочники.Организации.НайтиПоНаименованию("СМАРТ-Т ТЕКСТИЛЬ ООО", Истина) Тогда	
		Префикс = "ОТ";
	Иначе
		Префикс = "Р"
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Номер КАК Номер
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.Ссылка <> &Ссылка
	|	И ДоговорыКонтрагентов.Номер ПОДОБНО &Номер
	|	И ДоговорыКонтрагентов.Организация = &Организация";
	
	ГодДвеЦифры = Формат(ТекущаяДата(),"ДФ=гг");
	ШаблонНомера = Префикс + "-____/" + ГодДвеЦифры;
	Запрос.УстановитьПараметр("Номер", ШаблонНомера);
	Запрос.УстановитьПараметр("Ссылка", НовыйДоговор.Ссылка);
	Запрос.УстановитьПараметр("Организация", НовыйДоговор.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивНомеровДоговора = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ПозицияНомера = СтрНайти(ВыборкаДетальныеЗаписи.Номер, "-");
		
		Если ПозицияНомера <> 0 Тогда 
			
			СтрНомерДоговора = Сред(ВыборкаДетальныеЗаписи.Номер, ПозицияНомера+1, 4);
			
			ЧислоНомерДоговора = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(СтрНомерДоговора);
			
			Если ЧислоНомерДоговора <> Неопределено Тогда
				МассивНомеровДоговора.Добавить(ЧислоНомерДоговора);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивНомеровДоговора.Количество() = 0 Тогда
		ПорядковыйНомерДоговора = 1;
	Иначе
		ПорядковыйНомерДоговора = МассивНомеровДоговора[МассивНомеровДоговора.ВГраница()] + 1;
	КонецЕсли;	
	
	СтрПорядковыйНомерДоговора = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтрЗаменить(Строка(ПорядковыйНомерДоговора), Символы.НПП, ""), 4);
	НовыйДоговор.Номер = СтрШаблон("%1-%2/%3", Префикс, СтрПорядковыйНомерДоговора, ГодДвеЦифры);
	
КонецПроцедуры   

//++ #Б-3312 смарт: Лопато 16.06.2025 //Задание на подготовку проекта договора поставки. Доработка Условий оплаты. Этап 1.  
&НаСервере
