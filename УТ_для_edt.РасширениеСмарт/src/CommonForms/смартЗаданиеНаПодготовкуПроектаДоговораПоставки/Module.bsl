Процедура КонтактноеЛицоДляЛКПриИзменении(Элемент)
	
	//++ #Б-2380 смарт: Фролов 20.02.2025 //Доработать выбор КЛ Клиента в договоре, если КЛ уже зарегистрирован в ИМ
	РезультатПроверки = КонтактноеЛицоЗарегистрированоНаСайте();
	
	Если НЕ РезультатПроверки Тогда
		
		РезультатПроверки = КонтактноеЛицоДляЛКПриИзмененииНаСервере();
		
		Если НЕ РезультатПроверки.НашлиОшибки Тогда
			
			Если РезультатПроверки.НайденныеТелефоны.Количество() > 1 ИЛИ РезультатПроверки.НайденнаяЭП.Количество() > 1 Тогда
				
				ПараметрыОткрытия = Новый Структура;
				ПараметрыОткрытия.Вставить("НайденныеТелефоны", РезультатПроверки.НайденныеТелефоны);
				ПараметрыОткрытия.Вставить("НайденнаяЭП", РезультатПроверки.НайденнаяЭП);
				
				ОткрытьФорму("Справочник.ДоговорыКонтрагентов.Форма.смарт_ФормаВыбораКонтактнойИнформации", 
				ПараметрыОткрытия, ЭтаФорма, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
			Иначе
				
				ТелефонДляЛК = РезультатПроверки.НайденныеТелефоны[0];
				ЭлектроннаяПочтаДляЛК = РезультатПроверки.НайденнаяЭП[0];
				
			КонецЕсли;	
			
		КонецЕсли;
		
	Иначе
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Контактное лицо уже зарегистрировано в ИМ. Изменение Телефона и Email не доступно.");	
		
	КонецЕсли;
	//-- #Б-2380 смарт: Фролов 20.02.2025
	
КонецПроцедуры //-- #Б-1728 смарт: Фролов 27.01.2025

