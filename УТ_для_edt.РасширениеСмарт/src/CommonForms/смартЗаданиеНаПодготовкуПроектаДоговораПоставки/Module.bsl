//++ #Б-1728 смарт: Фролов 27.01.2025 //Создание пользователя ИМ на основании договора поставки. Подготовка переменных текста
Функция КонтактноеЛицоДляЛКПриИзмененииНаСервере()
	
	НайденныеТелефоны = Новый Массив;
	НайденнаяЭП = Новый Массив;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Представление КАК Телефон
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация
	|ГДЕ
	|	Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Представление КАК Почта
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация
	|ГДЕ
	|	Ссылка = &Ссылка
	|	И Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)");
	Запрос.УстановитьПараметр("Ссылка", КонтактноеЛицоДляЛК);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ПроверкаТелефон = МассивРезультатов[0].Выбрать(); 
	ПроверкаПочта = МассивРезультатов[1].Выбрать();
	
	НашлиОшибки = Ложь;
	
	Если ПроверкаТелефон.Количество() = 0 Тогда
		
		Сообщить("У выбранного контактного лица не заполнен телефон!");
		НашлиОшибки = Истина;
		
	Иначе	
		
		Пока ПроверкаТелефон.Следующий() Цикл
			НайденныеТелефоны.Добавить(ПроверкаТелефон.Телефон);		
		КонецЦикла;	
		
	КонецЕсли;
	
	Если ПроверкаПочта.Количество() = 0 Тогда
		
		Сообщить("У выбранного контактного лица не заполнена электронная почта!");
		НашлиОшибки = Истина;
		
	Иначе	
		
		Пока ПроверкаПочта.Следующий() Цикл
			НайденнаяЭП.Добавить(ПроверкаПочта.Почта);	
		КонецЦикла;	
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицоДляЛК.CRM_Фамилия) Тогда
		Сообщить("У выбранного контактного лица не заполнена фамилия!");
		НашлиОшибки = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицоДляЛК.CRM_Имя) Тогда
		Сообщить("У выбранного контактного лица не заполнено имя!");
		НашлиОшибки = Истина;
	КонецЕсли;
	
	Если НашлиОшибки Тогда
		
		КонтактноеЛицоДляЛК = Неопределено;
		
	КонецЕсли;
	
	Возврат Новый Структура("НашлиОшибки, НайденныеТелефоны, НайденнаяЭП", НашлиОшибки, НайденныеТелефоны, НайденнаяЭП);
	
