Функция ПолучитьСтрокуШаблоновБрэнда(ЗаказСсылка)
	
	Результат = "";
	
	МассивШаблоновБрэнда = Новый Массив;
	
	Для Каждого СтрТовары Из ЗаказСсылка.Товары Цикл
		
		ШаблонБрэнда = смартШаблоныПечатныхФормСервер.ПолучитьШаблонБрэндаНоменклатуры(СтрТовары.Номенклатура);
		
		Если ЗначениеЗаполнено(ШаблонБрэнда) Тогда
			МассивШаблоновБрэнда.Добавить(ШаблонБрэнда);
		КонецЕсли;	
			
	КонецЦикла;	

	МассивШаблоновБрэндаИтог = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивШаблоновБрэнда);		
	
	Для Каждого ЭлементШаблон Из МассивШаблоновБрэндаИтог Цикл
		Результат = Результат + ЭлементШаблон + "; ";
	КонецЦикла;
	
	Возврат Лев(Результат, СтрДлина(Результат) - 2);
	
