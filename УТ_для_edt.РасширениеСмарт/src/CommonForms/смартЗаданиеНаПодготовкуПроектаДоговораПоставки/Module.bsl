&НаСервере
Функция ПолучитьАдресСкладаНаСервере()
	Склад=ЭтаФорма.СкладСамовывоза;
	Если Склад.ЭтоГруппа Тогда
		Возврат Новый Структура("АдресСклада,СкладГруппа","Выбранный склад является группой, выбериту другой склад.",Истина);
	Иначе	
		АдресСклада = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(Склад,
		Справочники.ВидыКонтактнойИнформации.АдресСклада,,, Новый Структура("ТолькоПервая, БезПробелов", Истина, Истина,));
		Возврат Новый Структура("АдресСклада,СкладГруппа","Адрес склада самовывоза: "+АдресСклада+".",Ложь);
	КонецЕсли;
КонецФункции	

&НаСервере
Процедура СпособДоставкиПриИзмененииНаСервере()
	Если ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз Или ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
		Если ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
			ЭтаФорма.СкладСамовывоза=Справочники.смартПредопределенныеЗначения.СкладАдмирал.Значение;
			СтруктураАдреса=ПолучитьАдресСкладаНаСервере();
			ЭтаФорма.Элементы.ДекорацияАдресСклада.Заголовок=СтруктураАдреса.АдресСклада;  
		КонецЕсли;	
		Элементы.СкладСамовывоза.Видимость=Истина; 
		Элементы.ДекорацияАдресСклада.Видимость=Истина;
		Если ЭтаФорма.АдресДоставки="" Тогда
			ЭтаФорма.АдресДоставки=ЭтаФорма.Элементы.ДекорацияАдресСклада.Заголовок;	
		КонецЕсли;
	Иначе
		Элементы.СкладСамовывоза.Видимость=Ложь; 
		Элементы.ДекорацияАдресСклада.Видимость=Ложь;
	КонецЕсли;
	Если ЭтаФорма.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента Тогда
		Элементы.АдресДоставки.Видимость=Истина;
	Иначе
		Элементы.АдресДоставки.Видимость=Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораГрузополучателя(КонтрагентДоговора)

	Элементы.Грузополучатель.СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(КонтрагентДоговора) Тогда
		Элементы.Грузополучатель.СписокВыбора.Добавить(КонтрагентДоговора, "Он же");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеПроверитьНаКлиенте()
	
	Попытка
		РезультатВыполнения = ПартнерыИКонтрагентыВызовСервера.ФоновоеЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор, ФоновоеЗаданиеАдресХранилища);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Сервис временно не доступен, заполните контрагента вручную или попробуйте воспользоваться автозаполнением еще раз");
		Возврат;
	КонецПопытки;
	
	Если РезультатВыполнения.ЗаданиеВыполнено Тогда 
		Попытка
			ЭтаФорма.ДолжностьУполномеченногоЛицаОтКонтрагента=РезультатВыполнения.РеквизитыКонтрагента.Руководитель.Должность; 
			ЭтаФорма.УполномоченноеЛицоНаПодписаниеДоговораОтКонтрагента=РезультатВыполнения.РеквизитыКонтрагента.Руководитель.Представление;
			ЭтаФорма.ОснованиеПодписи="Устав";
		Исключение
		КонецПопытки;
	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеПроверитьНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ДобавитьОборудованиеИШаблоны(Стр=Неопределено,Суфикс,ЭлементПривязки=Неопределено)
	ДобавляемыеРеквизиты = Новый Массив;
	
	ТипРеквизита = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	РеквизитФормы = Новый РеквизитФормы("Оборудование"+Суфикс,ТипРеквизита,"","Оборудование "+Суфикс);
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);     
	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ТипРеквизита = Новый ОписаниеТипов(Массив, , КС);
	РеквизитФормы = Новый РеквизитФормы("ШаблонБренда"+Суфикс,ТипРеквизита,"","Шаблон бренда "+Суфикс);
	ДобавляемыеРеквизиты.Добавить(РеквизитФормы);                                                                                     
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	ЭтаФорма["Оборудование"+Суфикс] = Стр;
	
	НовыйЭлемент = Этаформа.Элементы.Вставить("ГруппаОборудование"+Суфикс, Тип("ГруппаФормы"), Элементы.ГруппаОборудованиеИШаблоны,?(ЭлементПривязки=Неопределено,Неопределено,Элементы["КнопкаДобавитьОборудование"]));
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НовыйЭлемент.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Одинарный;
	НовыйЭлемент.ОтображатьЗаголовок = Ложь;
	
	ПолеВвода = Элементы.Добавить("ФормаОборудование"+Суфикс, Тип("ПолеФормы"), Элементы["ГруппаОборудование"+Суфикс]);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПоложениеЗаголовка=ПоложениеЗаголовкаЭлементаФормы.Верх;
	ПолеВвода.ПутьКДанным = "Оборудование"+Суфикс;
	
	ПолеВвода = Элементы.Добавить("ФормаШаблонБренда"+Суфикс, Тип("ПолеФормы"), Элементы["ГруппаОборудование"+Суфикс]);
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.Ширина=15;
	ПолеВвода.ПоложениеЗаголовка=ПоложениеЗаголовкаЭлементаФормы.Верх;
	ПолеВвода.ПутьКДанным = "ШаблонБренда"+Суфикс;
	Элементы["ФормаШаблонБренда"+Суфикс].КнопкаВыпадающегоСписка = Истина;
	Для Каждого ЭлементСписка Из СписВыб Цикл
		Элементы["ФормаШаблонБренда"+Суфикс].СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла; 
	
	КомандаУдалитьОборудование = ЭтаФорма.Команды.Добавить("УдалитьОборудование"+Суфикс);
	КомандаУдалитьОборудование.Картинка = БиблиотекаКартинок.УдалитьЭлементСписка;
	КомандаУдалитьОборудование.Действие = "УдалитьТекущееОборудование";
	НовыйЭлемент = Элементы.Добавить("КнопкаУдалитьОборудование"+Суфикс, Тип("КнопкаФормы"),Элементы["ГруппаОборудование"+Суфикс]);
	НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	НовыйЭлемент.Заголовок = "Удалить оборудование";
	НовыйЭлемент.ИмяКоманды = "УдалитьОборудование"+Суфикс;
	НовыйЭлемент.Отображение = ОтображениеКнопки.Картинка;
	НовыйЭлемент.Видимость = Истина;
	НовыйЭлемент.Доступность = Истина;
КонецПроцедуры                                       
												   

&НаКлиенте
Процедура УдалитьТекущееОборудование()
	Суфикс=СтрЗаменить(ЭтаФорма.ТекущийЭлемент.ИмяКоманды,"УдалитьОборудование",""); 
	УдалитьТекущееОборудованиеНаСервере(Суфикс);
КонецПроцедуры	

&НаСервере
Процедура УдалитьТекущееОборудованиеНаСервере(Суфикс)
	РеквизитыФормы = ЭтаФорма.ПолучитьРеквизиты(); 
	МассивУдаляемых = Новый Массив;                                          
	Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
	    ИмяРеквизита = РеквизитФормы.Имя; 
		Если СтрНайти(ИмяРеквизита, "Оборудование"+Суфикс) ИЛИ СтрНайти(ИмяРеквизита, "ШаблонБренда"+Суфикс)
			ИЛИ СтрНайти(ИмяРеквизита, "КнопкаУдалитьОборудование"+Суфикс) ИЛИ СтрНайти(ИмяРеквизита, "ГруппаОборудование"+Суфикс)  Тогда 
	        МассивУдаляемых.Добавить(ИмяРеквизита);
	    КонецЕсли;
	КонецЦикла; 
	Элементы["КнопкаУдалитьОборудование"+Суфикс].Видимость=Ложь;
	ИзменитьРеквизиты( , МассивУдаляемых); 
	НайденныйЭлемент = СписокСуфиксов.НайтиПоЗначению(Суфикс);
	Если НайденныйЭлемент <> Неопределено Тогда
    	СписокСуфиксов.Удалить(НайденныйЭлемент); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНовоеОборудование() 
	КоличествоОборудования=КоличествоОборудования+1;
	ДобавитьОборудованиеИШаблоны(,"N"+КоличествоОборудования,Истина);
	СписокСуфиксов.Добавить("N"+КоличествоОборудования);
КонецПроцедуры	


