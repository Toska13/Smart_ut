
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СегментОборудование = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул","СегментАппаратноеОбеспечение"); 
	Если ЗначениеЗаполнено(СегментОборудование) Тогда		
		Для Каждого Оборудование Из ЭтаФорма.Параметры.ОборудованиеДляДоговора Цикл
			Если ЗначениеЗаполнено(Оборудование) И СегментыСервер.ВходитВСегмент(Оборудование, СегментОборудование, , Ложь) Тогда
				НоваяСтрока 			 = ТаблицаОборудования.Добавить(); 
				НоваяСтрока.НомерСтроки	 = ТаблицаОборудования.Количество();
				НоваяСтрока.Оборудование = Оборудование;
				НоваяСтрока.ШаблонБренда = смартШаблоныПечатныхФормСервер.ПолучитьШаблонБрэндаНоменклатуры(Оборудование);
				НоваяСтрока.НетШаблона 	 = НЕ ЗначениеЗаполнено(НоваяСтрока.ШаблонБренда);
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры // ПриСозданииНаСервере

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДоговор(Команда)  
	
	Отказ = Ложь;
	
	Если ТаблицаОборудования.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать договор лизинга: Таблица оборудования не заполнена",,,,Отказ);
	КонецЕсли;  
	
	//++ #5942 смарт: Тимофеева 05.03.26 / Задание на подготовку проекта договора поставки. Договор Лизинга.
	//Для Каждого СтрокаОборудования Из ТаблицаОборудования Цикл
	//	Если СтрокаОборудования.НетШаблона Тогда
	//		ТекстСообщения = СтрШаблон("Не удалось записать договор лизинга: Для оборудования %1 не найден шаблон", СтрокаОборудования.Оборудование);
	//		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	//	КонецЕсли;
	//КонецЦикла; 
	//-- #5942 смарт: Тимофеева 05.03.26
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Владелец 	 = ЭтаФорма.ВладелецФормы.Объект;
	ЗаказКлиента = Владелец.Ссылка;
		
	НовыйДоговор = СоздатьДоговорНаСервере(ЗаказКлиента);
	
	Если НЕ НовыйДоговор = Неопределено Тогда
		Владелец.Договор = НовыйДоговор;
		
		МассивСообщений = Новый Массив;
		ОтправитьУведомление(МассивСообщений, ЗаказКлиента, НовыйДоговор);
		
		СтруктураДляВладельца = Новый Структура;
		СтруктураДляВладельца.Вставить("НовыйДоговор",		НовыйДоговор); 
		СтруктураДляВладельца.Вставить("МассивСообщений",	МассивСообщений);
		
		Оповестить("СозданДоговорЛизинга", СтруктураДляВладельца, ЭтаФорма);
		ЭтаФорма.Закрыть(); 	
	КонецЕсли;	            
	
КонецПроцедуры // СоздатьДоговор

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СоздатьДоговорНаСервере(ЗаказКлиента)
    Результат 	 = Неопределено;
	Запрос 		 = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&Ссылка КАК смартЗаказКлиента,
	|	""ЛИЗИНГ"" КАК Номер,
	|	""Договор лизинга"" КАК Наименование,
	|   ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем) КАК ТипДоговора,
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(СоглашенияСКлиентами.ВалютаВзаиморасчетов, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			ТОГДА СоглашенияСКлиентами.ВалютаВзаиморасчетов
	|		ИНАЧЕ ЕСТЬNULL(СоглашенияСКлиентами.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
	|	КОНЕЦ КАК ВалютаВзаиморасчетов,
	|	ЕСТЬNULL(СоглашенияСКлиентами.ГруппаФинансовогоУчета, ЗНАЧЕНИЕ(Справочник.ГруппыФинансовогоУчетаРасчетов.ПустаяСсылка)) КАК ГруппаФинансовогоУчета,
	|	ЗаказКлиента.Контрагент КАК Контрагент,
	|	ЗаказКлиента.Организация КАК Организация,
	|	ЗаказКлиента.БанковскийСчет КАК БанковскийСчет,
	|	ЗаказКлиента.Партнер КАК Партнер,
	|	ЗаказКлиента.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует) КАК Статус,
	|	ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РеализацияКлиенту) КАК ХозяйственнаяОперация,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС) КАК НалогообложениеНДС,
	//++ #5468 смарт: Тимофеева 26.01.26 / Задание на подготовку проекта договора поставки. Скорректировать установку ставки НДС.
	//|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22) КАК СтавкаНДС,
	//-- #5468 смарт: Тимофеева 26.01.26
	|	ЗНАЧЕНИЕ(Перечисление.смартВидыДоговоров.Оборудование) КАК смартВидДоговора,
	|	ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента) КАК СтатьяДвиженияДенежныхСредств,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокРасчетов.ПоЗаказамНакладным) КАК ПорядокРасчетов,
	|	ЗаказКлиента.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
	|		ПО ЗаказКлиента.Соглашение = СоглашенияСКлиентами.Ссылка
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЗаказКлиента);
	РезультатЗапроса = Запрос.Выполнить();
	
	ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();	
	//++ #5942 смарт: Тимофеева 05.03.26 / Задание на подготовку проекта договора поставки. Договор Лизинга.
	//ДоговорОбъект.смартШаблонБренда = ТаблицаОборудования[0].ШаблонБренда;
	//-- #5942 смарт: Тимофеева 05.03.26
		
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПараметрыСозданияСтрокой = "ВалютаВзаиморасчетов, ГруппаФинансовогоУчета, ХозяйственнаяОперация, Организация, Контрагент, Партнер, БанковскийСчет, НалогообложениеНДС";
		ПараметрыСоздания		 = Новый Структура(ПараметрыСозданияСтрокой);
		ЗаполнитьЗначенияСвойств(ПараметрыСоздания, ВыборкаДетальныеЗаписи);
		ДоговорОбъект.Заполнить(ПараметрыСоздания);
		ЗаполнитьЗначенияСвойств(ДоговорОбъект, ВыборкаДетальныеЗаписи,, ПараметрыСозданияСтрокой);
		ДоговорОбъект.смартТекстЗаданияНаПодготовку = СформироватьТекстЗаданияНаПодготовку(ВыборкаДетальныеЗаписи, ТаблицаОборудования.Выгрузить());
	КонецЕсли;	
		
	Попытка
		ДоговорОбъект.Записать();
		Результат = ДоговорОбъект.Ссылка;
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("Не удалось записать договор лизинга по %1", ЗаказКлиента));
	КонецПопытки;
	
	Возврат Результат;
КонецФункции // СоздатьДоговорНаСервере 

