&НаСервере
Функция ПолучитьТекстНоменклатурыИШаблонов(ТаблицаОборудованияШаблонов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаОборудования.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОборудования.Оборудование КАК Номенклатура,
	|	ТаблицаОборудования.ШаблонБренда КАК Шаблон
	|ПОМЕСТИТЬ ВТ_Оборудование
	|ИЗ
	|	&ТаблицаОборудования КАК ТаблицаОборудования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Оборудование.Шаблон КАК Шаблон,
	|	МИНИМУМ(ВТ_Оборудование.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	ВТ_Оборудование КАК ВТ_Оборудование
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Оборудование.Шаблон
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Оборудование.Номенклатура.НаименованиеПолное КАК Номенклатура,
	|	МИНИМУМ(ВТ_Оборудование.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	ВТ_Оборудование КАК ВТ_Оборудование
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Оборудование.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("ТаблицаОборудования", ТаблицаОборудованияШаблонов);
	РезультатЗапроса 	= Запрос.ВыполнитьПакет();
	МассивНоменклатуры	= РезультатЗапроса[2].Выгрузить().ВыгрузитьКолонку("Номенклатура");
	МассивШаблонов		= РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("Шаблон"); 	
	Возврат Новый Структура("Номенклатура, Шаблон", СтрСоединить(МассивНоменклатуры, "; "), СтрСоединить(МассивШаблонов, "; "));	
КонецФункции // ПолучитьТекстНоменклатурыИШаблонов

