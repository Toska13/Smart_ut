	КорректировкаРеализацииЛокализация.ДополнитьТекстыЗапросовПроведения(Запрос, ТекстыЗапроса, Регистры);
	ПроведениеСерверУТ.ИнициализироватьТаблицыДляДвижений(Запрос, ТекстыЗапроса, ДополнительныеСвойства.ТаблицыДляДвижений, Истина);
	
	#Вставка
	//++ #1713 смарт: Мосолов 08.07.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. КорректировкаРеализации
	//++ смарт:rnp  #64 316 28.09.2020 для документов Корректировка реализации  будем использовать алгоритм как в Реализации товаров,
	//процедура ИнициализироватьДанныеДокумента()

	Если ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаСуммыДокументовВВалютеРегл") Тогда
		Если ДополнительныеСвойства.Свойство("смартЭтоОбновлениеДвиженийДокумента") И ДополнительныеСвойства.смартЭтоОбновлениеДвиженийДокумента Тогда
			//после расчета в регистре сведений СуммыДокументовВВалютеРегл не пересчитываем
		иначе

			Коэффициенты = РаботаСКурсамивалютУТ.ПолучитьКоэффициентыПересчетаВалюты(Запрос.Параметры.Валюта,
			Запрос.Параметры.ВалютаВзаиморасчетов,
			Запрос.Параметры.Период);

			ИтогСуммаРуб = ?(ДокументСсылка.Кратность = 0, 0,
			Окр(ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл.Итог("СуммаВзаиморасчетов") * Коэффициенты.КоэффициентПересчетаВВалютуРегл / ДокументСсылка.Кратность, 2));
			//1. распределим сумму документа без учета авансов пропорционально по строкам документа
			МассивСтарыхСумм = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл.ВыгрузитьКолонку("СуммаВзаиморасчетов");			
			МассивНовыхСумм = смартОбщегоНазначения.смартРаспределитьПропорционально(ИтогСуммаРуб, МассивСтарыхСумм);
			Если МассивНовыхСумм <> Неопределено Тогда
				ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл.ЗагрузитьКолонку(МассивНовыхСумм, "БазаНДСРегл");

				//2. рассчитаем по каждой строке документа сумму НДС по ставке и сумму без НДС
				Для Каждого СтрокаТаблицы Из ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл Цикл
					ПроцентНДС = УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(СтрокаТаблицы.СтавкаНДС);
					СтрокаТаблицы.СуммаНДСРегл = Окр(СтрокаТаблицы.БазаНДСРегл * ПроцентНДС / (100 + ПроцентНДС), 2);
					СтрокаТаблицы.СуммаБезНДСРегл = СтрокаТаблицы.БазаНДСРегл - СтрокаТаблицы.СуммаНДСРегл;
				КонецЦикла;
				//приравняем колонки
				МассивСуммБезНДС = ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл.ВыгрузитьКолонку("СуммаБезНДСРегл");
				ДополнительныеСвойства.ТаблицыДляДвижений.ТаблицаСуммыДокументовВВалютеРегл.ЗагрузитьКолонку(МассивСуммБезНДС, "БазаНДСРегл");
				//3. вызовем в процедуре ОбработкаПроведения  пересчет сумм как если бы печатали УПД, иначе при печати УПД выполняется пересчет
				////валюты можно взять также из параметров запроса Запрос.Параметры.ВалютаРегламентированногоУчета, проверить, как быстрее отрабатывать будет
				//Если ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов") И ДокументСсылка.Валюта <> Константы.ВалютаРегламентированногоУчета.Получить()  Тогда
				//	МассивДокументов = Новый Массив;
