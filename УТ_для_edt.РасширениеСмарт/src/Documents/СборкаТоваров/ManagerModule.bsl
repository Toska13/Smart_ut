//++ #1901 смарт: Ермаков 21.08.2024 / Создание документа Заявка на разборку оборудования
Функция смартТекстЗапросаТаблицаЗаявкиНаРазборкуОборудования(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "смартЗаявкиНаРазборкуОборудования";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	&ЗаявкаНаРазборкуОборудования КАК Заявка,
	|	&Номенклатура КАК Номенклатура,
	|	&Серия КАК Серия,
	|	1 КАК КРазборке,
	|	0 КАК КПолучению
	|
	|ГДЕ 
	|	&ЭтоРазборкаОборудования
	|	И &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РазборкаТоваров)		
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Период 						КАК Период,
	|	&ЗаявкаНаРазборкуОборудования	КАК Заявка,
	|	ДокументТовары.Номенклатура 	КАК Номенклатура,
	|	&Серия 							КАК Серия, 
	|	0 								КАК КРазборке,
	|	ДокументТовары.Количество 		КАК КПолучению
	|ИЗ
	|	Документ.СборкаТоваров.Товары КАК ДокументТовары
	|ГДЕ
	|	&ЭтоРазборкаОборудования
	|	И ДокументТовары.Ссылка = &Ссылка
	|	И &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.РазборкаТоваров)
	|";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

