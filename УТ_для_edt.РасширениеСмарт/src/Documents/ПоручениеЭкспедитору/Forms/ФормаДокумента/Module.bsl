
//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;

	// Обработчик механизма "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПриЧтенииСозданииНаСервере();
		Объект.ДатаВыполнения = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	#Вставка
	//смарт+ Вахов Владимир /467 / 22.03.2021 
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ПоручениеЭкспедиторуСоСклада Тогда

		ДобавляемыеРеквизиты	= Новый Массив;

		Реквизит_смартОбразцы = Новый РеквизитФормы("смартОбразцы",	Новый ОписаниеТипов("Булево"));
		Реквизит_смартКонтрагент = Новый РеквизитФормы("смартКонтрагент",	Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		Реквизит_смартОрганизация = Новый РеквизитФормы("смартОрганизация",	Новый ОписаниеТипов("СправочникСсылка.Организации"));

		ДобавляемыеРеквизиты.Добавить(Реквизит_смартОбразцы);
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);  

		НовыйЭлементОбразцы = Элементы.Добавить("смартОбразцы", Тип("ПолеФормы"));
		НовыйЭлементОбразцы.ПутьКДанным                  = "Объект.смартОбразцы";
		НовыйЭлементОбразцы.Вид                          = ВидПоляФормы.ПолеФлажка;
		НовыйЭлементОбразцы.УстановитьДействие("ПриИзменении", "Подключаемый_смартОбразцыПриИзменении");

		НовыйЭлементКонтрагент = Элементы.Добавить("смартКонтрагент", Тип("ПолеФормы"), Элементы.ГруппаПунктЗона);
		НовыйЭлементКонтрагент.ПутьКДанным                  = "Объект.смартКонтрагент";
		НовыйЭлементКонтрагент.Вид                          = ВидПоляФормы.ПолеВвода;
		НовыйЭлементКонтрагент.Видимость = Объект.смартОбразцы;
		НовыйЭлементКонтрагент.АвтоОтметкаНезаполненного = Истина;
		НовыйЭлементКонтрагент.УстановитьДействие("ПриИзменении", "Подключаемый_смартКонтрагентПриИзменении");

		НовыйЭлементОрганизация = Элементы.Добавить("смартОрганизация", Тип("ПолеФормы"), Элементы.ГруппаСклад);
		НовыйЭлементОрганизация.ПутьКДанным                  = "Объект.смартОрганизация";
		НовыйЭлементОрганизация.Вид                          = ВидПоляФормы.ПолеВвода;
		НовыйЭлементОрганизация.Видимость = Объект.смартОбразцы;
		НовыйЭлементОрганизация.АвтоОтметкаНезаполненного = Истина;

		Элементы.Переместить(НовыйЭлементОбразцы, ЭтаФорма, Элементы.ЗаголовокОткуда);

		ДобавитьАдресаКонтрагента();

	КонецЕсли;
	//смарт- Вахов Владимир /467 / 22.03.2021
    #КонецВставки

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ИнтеграцияС1СДокументооборотом

КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
&НаСервере
&ИзменениеИКонтроль("ПунктПриИзмененииНаСервере")
Процедура смарт_ПунктПриИзмененииНаСервере()

	Элементы.АдресПункта.СписокВыбора.Очистить();
	ПустыеРеквизиты = ДоставкаТоваровКлиентСервер.ПолучитьПустуюСтруктуруРеквизитовДоставки(Объект);
	ЗаполнитьЗначенияСвойств(Объект, ПустыеРеквизиты,,"СпособДоставки,ДополнительнаяИнформацияПоДоставке");

	Если ЗначениеЗаполнено(Объект.Пункт) Тогда

		ДоставкаТоваров.ЗаполнитьСпискиВыбораАдресовПолучателяОтправителя(Элементы, Объект);
		Если Элементы.АдресПункта.СписокВыбора.Количество() > 0 Тогда
			ПерваяСтруктураВСписке = Элементы.АдресПункта.СписокВыбора[0].Значение;

			Если ДоставкаТоваровКлиентСервер.ДопИнфоИзмененоПользователем(Элементы, Объект) Тогда
				ЗаполнитьЗначенияСвойств(Объект, ПерваяСтруктураВСписке,
				"АдресДоставки, АдресДоставкиЗначенияПолей, ЗонаДоставки, ВремяДоставкиС, ВремяДоставкиПо");
			Иначе
				ЗаполнитьЗначенияСвойств(Объект, ПерваяСтруктураВСписке);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ПроверитьЗаполнитьКонтактноеЛицо();

	УстановитьДоступностьЭлементов();
	
	#Вставка
	//смарт+ Вахов Владимир /467 / 24.03.2021   
	Объект.смартКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	//смарт- Вахов Владимир /467 / 24.03.2021	
    #КонецВставки
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024


//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
&НаСервере
&ИзменениеИКонтроль("СпособДоставкиПриИзмененииНаСервере")
Процедура смарт_СпособДоставкиПриИзмененииНаСервере()

	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ПоручениеЭкспедиторуСоСклада Тогда
		Элементы.ЗаголовокОткуда.Видимость = Истина;
		Элементы.ОтступОткуда.Видимость    = Истина;
		Элементы.Склад.Видимость           = Истина;
		Элементы.ЗаголовокСклад.Видимость  = Истина;
		Элементы.ЗаголовокОткуда.Заголовок = НСтр("ru = 'Откуда'");
		Элементы.ЗаголовокКуда.Заголовок   = НСтр("ru = 'Куда'");
	ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.ПоручениеЭкспедиторуНаСклад Тогда
		Элементы.ЗаголовокОткуда.Видимость = Истина;
		Элементы.ОтступОткуда.Видимость    = Истина;
		Элементы.Склад.Видимость           = Истина;
		Элементы.ЗаголовокСклад.Видимость  = Истина;
		Элементы.ЗаголовокОткуда.Заголовок = НСтр("ru = 'Куда'");
		Элементы.ЗаголовокКуда.Заголовок   = НСтр("ru = 'Откуда'");
	Иначе
		Элементы.ЗаголовокОткуда.Видимость = Ложь;
		Элементы.ОтступОткуда.Видимость    = Ложь;
		Элементы.Склад.Видимость           = Ложь;
		Элементы.ЗаголовокСклад.Видимость  = Ложь;
		Элементы.ЗаголовокКуда.Заголовок   = НСтр("ru = 'Где'");
	КонецЕсли;

	#вставка
	//смарт+ Вахов Владимир /467 / 24.03.2021   
	ОтображениеРеквизитовОбразец();
	//смарт- Вахов Владимир /467 / 24.03.2021
    #КонецВставки
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021   
&НаКлиенте
Процедура Подключаемый_смартОбразцыПриИзменении(Элемент)
	
	ЭлементКонтрагент = Элементы.Найти("смартКонтрагент");
	
	Если ЭлементКонтрагент <> Неопределено Тогда
		ЭлементКонтрагент.Видимость = Объект.смартОбразцы;		
	КонецЕсли;	
	
	ЭлементОрганизация = Элементы.Найти("смартОрганизация");
	
	Если ЭлементОрганизация <> Неопределено Тогда
		ЭлементОрганизация.Видимость = Объект.смартОбразцы;		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаКлиенте
Процедура Подключаемый_смартКонтрагентПриИзменении(Элемент)
	
	ДобавитьАдресаКонтрагента();
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаСервере
Процедура ДобавитьАдресаКонтрагента()
	
	АдресаИзКонтактнойИнформации = АдресаИзКонтактнойИнформации(Объект.смартКонтрагент);
	
	Для Каждого Стр Из АдресаИзКонтактнойИнформации Цикл
		
		НайденныйЭлемент = ДоставкаТоваровКлиентСервер.НайтиВСпискеСтруктур(Элементы.АдресПункта.СписокВыбора,"АдресДоставки",Стр.АдресДоставки);
		
		Если НайденныйЭлемент = Неопределено Тогда
			СтруктураВыбора = СтруктураВыбора();
			ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
			Элементы.АдресПункта.СписокВыбора.Добавить(СтруктураВыбора, Стр.Вид + ": " + Стр.АдресДоставки);
		Иначе
			ДозаполнитьПустыеСвойства(НайденныйЭлемент.Значение, Стр);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаСервереБезКонтекста
Функция СтруктураВыбора()
	
	СтруктураВыбора = Новый Структура;
	СтруктураВыбора.Вставить("АдресДоставки", "");
	СтруктураВыбора.Вставить("АдресДоставкиЗначенияПолей", "");
	СтруктураВыбора.Вставить("ЗонаДоставки", Справочники.ЗоныДоставки.ПустаяСсылка());
	СтруктураВыбора.Вставить("ВремяДоставкиС", Дата(1,1,1));
	СтруктураВыбора.Вставить("ВремяДоставкиПо", Дата(1,1,1));
	СтруктураВыбора.Вставить("ДополнительнаяИнформацияПоДоставке", "");
	
	Возврат СтруктураВыбора;
	
КонецФункции //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаСервереБезКонтекста
Функция АдресаИзКонтактнойИнформации(ПолучательОтправитель)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление КАК АдресДоставки,
	|	КонтактнаяИнформация.Вид.Представление КАК Вид,
	|	КонтактнаяИнформация.ЗначенияПолей КАК АдресДоставкиЗначенияПолей
	|ИЗ
	|	Справочник." + ПолучательОтправитель.Метаданные().Имя + ".КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &ПолучательОтправитель
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)");
	
	Запрос.УстановитьПараметр("ПолучательОтправитель", ПолучательОтправитель);
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаСервереБезКонтекста
Процедура ДозаполнитьПустыеСвойства(СтруктураПриемник, Источник)
	
	СтруктураЗаполнения = Новый Структура;
	Для Каждого Элемент Из СтруктураПриемник Цикл
		Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
			СтруктураЗаполнения.Вставить(Элемент.Ключ);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(СтруктураЗаполнения, Источник);
	ЗаполнитьЗначенияСвойств(СтруктураПриемник, СтруктураЗаполнения);
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024

//++ #Б-982 смарт: Мосолов 02.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоручениеЭкспедитору
//смарт+ Вахов Владимир /467 / 22.03.2021
&НаСервере
Процедура ОтображениеРеквизитовОбразец()
	
	ЭлементОбразцы = Элементы.Найти("смартОбразцы");
	ЭлементКонтрагент = Элементы.Найти("смартКонтрагент");
	ЭлементОрганизация = Элементы.Найти("смартОрганизация");
	
	Если ЭлементОбразцы <> Неопределено
		И ЭлементКонтрагент <> Неопределено
		И ЭлементОрганизация <> Неопределено Тогда
		
		Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ПоручениеЭкспедиторуСоСклада Тогда
			
			ЭлементОбразцы.Видимость = Истина;
			ЭлементКонтрагент.Видимость = Истина;
			ЭлементОрганизация.Видимость = Истина;
			
		ИначеЕсли Объект.СпособДоставки = Перечисления.СпособыДоставки.ПоручениеЭкспедиторуНаСклад Тогда
			
			ЭлементОбразцы.Видимость = Ложь;
			ЭлементКонтрагент.Видимость = Ложь;
			ЭлементОрганизация.Видимость = Ложь;
			
		Иначе
			
			ЭлементОбразцы.Видимость = Ложь;
			ЭлементКонтрагент.Видимость = Ложь;
			ЭлементОрганизация.Видимость = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- #Б-982 смарт: Мосолов 02.10.2024	

