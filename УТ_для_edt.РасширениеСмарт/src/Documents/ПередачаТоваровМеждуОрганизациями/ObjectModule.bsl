
#Область ПеренесеноСДоработками

&Перед("ОбработкаЗаполнения")
Процедура смарт_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//Каратеев + 
	// Установил значения, чтобы экономить время при оформлении документов передачи товаров между организациями
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") тогда 
		Если ДанныеЗаполнения.Свойство("ЦенаВключаетНДС") тогда
			ДанныеЗаполнения.Вставить("ЦенаВключаетНДС", Истина); 
		КонецЕсли;   
		
		Если ДанныеЗаполнения.Свойство("Валюта") тогда
			ДанныеЗаполнения.Вставить("Валюта", Справочники.Валюты.НайтиПоКоду("978"));
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ВалютаВзаиморасчетов") тогда
			ДанныеЗаполнения.Вставить("ВалютаВзаиморасчетов", Справочники.Валюты.НайтиПоКоду("978"));
		КонецЕсли;  
		
		Если ДанныеЗаполнения.Свойство("ВариантОформленияПродажи") тогда
			ДанныеЗаполнения.Вставить("ВариантОформленияПродажи", Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг);
		КонецЕсли;
	КонецЕсли;
	//Каратеев -
КонецПроцедуры

&После("ИнициализироватьДокумент")
Процедура смарт_ИнициализироватьДокумент(ДанныеЗаполнения)
	//Каратеев +                                
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") тогда
		Если ДанныеЗаполнения.Свойство("Валюта") тогда
			Валюта 						= ДанныеЗаполнения.Валюта;
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ВалютаВзаиморасчетов") тогда
			ВалютаВзаиморасчетов 		= ДанныеЗаполнения.ВалютаВзаиморасчетов;
		КонецЕсли;
		
		Если ДанныеЗаполнения.Свойство("ВариантОформленияПродажи") тогда
			ВариантОформленияПродажи 	= ДанныеЗаполнения.ВариантОформленияПродажи;  
		КонецЕсли;
	КонецЕсли;
	//Каратеев -
КонецПроцедуры

#КонецОбласти