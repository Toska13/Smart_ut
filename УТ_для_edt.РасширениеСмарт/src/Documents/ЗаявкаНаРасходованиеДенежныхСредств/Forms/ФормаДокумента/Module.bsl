            Стр.Сумма = Объект.СуммаДокумента;
            Стр.ДатаПлатежа = Объект.ЖелательнаяДатаПлатежа;
            
        КонецЦикла;   
        
    Иначе
        
        НоваяСтрока=Объект.РаспределениеПоСчетам.Добавить();  
        НоваяСтрока.БанковскийСчетКасса = Объект.БанковскийСчет;
