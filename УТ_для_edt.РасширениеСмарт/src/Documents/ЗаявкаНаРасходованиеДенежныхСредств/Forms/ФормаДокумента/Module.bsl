//++ #6790 смарт: Тимофеева 29.05.2026 / Заявки на расходование денежных средств в валюте. Курс.
&НаСервере
Функция РассчитатьСуммыВВалютеДокумента()
	Результат = Новый Структура("СуммаВВалютеДокумента, СуммыРасшифровки", 0, Новый Соответствие);
	
	КурсИКратностьРегл = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаРеглУчета, ТекущаяДатаСеанса());
	ПараметрыВалютыРегл = Новый Структура("Курс, Кратность, Валюта", КурсИКратностьРегл.Курс, КурсИКратностьРегл.Кратность, ВалютаРеглУчета);
	
	Для Каждого ТекущаяСтрока Из Объект.РасшифровкаПлатежа Цикл 
		Если ЗначениеЗаполнено(ТекущаяСтрока.ВалютаВзаиморасчетов) 
			И НЕ ТекущаяСтрока.ВалютаВзаиморасчетов = ВалютаРеглУчета Тогда
			КурсИКратностьТек = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ТекущаяСтрока.ВалютаВзаиморасчетов, ТекущаяДатаСеанса());
			ПараметрыТекВалюты = Новый Структура("Курс, Кратность, Валюта", КурсИКратностьТек.Курс, КурсИКратностьТек.Кратность, ТекущаяСтрока.ВалютаВзаиморасчетов);
			ТекущаяСтрокаСумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(ТекущаяСтрока.СуммаВзаиморасчетов, ПараметрыТекВалюты, ПараметрыВалютыРегл);
			
			Результат.СуммаВВалютеДокумента = Результат.СуммаВВалютеДокумента + ТекущаяСтрокаСумма;
			Результат.СуммыРасшифровки.Вставить(ТекущаяСтрока.НомерСтроки, ТекущаяСтрокаСумма); 
		Иначе
			Результат.СуммаВВалютеДокумента = Результат.СуммаВВалютеДокумента + ТекущаяСтрока.СуммаВзаиморасчетов;
			Результат.СуммыРасшифровки.Вставить(ТекущаяСтрока.НомерСтроки, ТекущаяСтрока.СуммаВзаиморасчетов);
		КонецЕсли;		
	КонецЦикла; 
	Результат.СуммаВВалютеДокумента = Окр(Результат.СуммаВВалютеДокумента, 2);
	Возврат Результат;	
КонецФункции          

