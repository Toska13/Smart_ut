Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
    
    Если Объект.Статус=Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Отклонена И ПараметрыСеанса.ТекущийПользователь=Объект.КтоЗаявил Тогда
        
        НоваяКоманда = ЭтаФорма.Команды.Добавить("Ошибки");
        НоваяКоманда.Действие = "ОткрытьОкноСОшибками";//Имя процедуры
        НоваяКоманда.Заголовок = "Ошибки заполнения";
        //Создаем Кнопку в конце Родителя (формы)
        НоваяКнопка = ЭтаФорма.Элементы.Вставить("ОткрытьОкноСОшибками", Тип("КнопкаФормы"), Элементы.ГруппаСтатусПриоритет, Элементы.Приоритет);// 
        НоваяКнопка.ИмяКоманды = "Ошибки";
        НоваяКнопка.Вид = ВидКнопкиФормы.Гиперссылка;
        НоваяКнопка.ЦветТекста = WebЦвета.ОранжевоКрасный;
        
        НовыйЭлемент = ЭтаФорма.Элементы.Вставить("смартКтоРешил", Тип("ДекорацияФормы"),Элементы.ГруппаСтатусПриоритет, );//, Элементы.Приоритет
        НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
        НовыйЭлемент.Заголовок = "Отклонил(а): "+ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(Объект.КтоРешил.ФизическоеЛицо);
        НовыйЭлемент.ЦветТекста = WebЦвета.ОранжевоКрасный;
        
        Если Объект.смартОшибкиВРеквизитах.Количество() Тогда
            Для каждого Эл Из Объект.смартОшибкиВРеквизитах Цикл
                //Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств.Синоним
                Если ЗначениеЗаполнено(Эл.ОписаниеОшибки) Тогда
                    Для каждого ЭлФормы Из Элементы Цикл
                        Если ЭлФормы.Имя = Эл.СинонимРеквизита Тогда
                            Если Элементы[ЭлФормы.Имя].Вид=ВидГруппыФормы.Страница Тогда
                                Элементы[ЭлФормы.Имя].Картинка=БиблиотекаКартинок.ВниманиеКрасный;
                                
                                Продолжить;
                            КонецЕсли; 
                            Элементы[ЭлФормы.Имя].ЦветТекстаЗаголовка=WebЦвета.ОранжевоКрасный;
                            Элементы[ЭлФормы.Имя].Подсказка="ОписаниеОшибки: " +Эл.ОписаниеОшибки;
                        КонецЕсли; 
                    КонецЦикла; 
                КонецЕсли; 
            КонецЦикла; 
        КонецЕсли;      
    КонецЕсли; 

КонецПроцедуры //-- смарт:ПА #815 11.12.2021 19:30:37

