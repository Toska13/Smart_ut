	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		//++ #7252 смарт: Тимофеева 01.07.2026 / Дополнение при изменении суммы оплаты в Заявке на расход ДС 
		СуммаДокументаДоИзменения = Объект.СуммаДокумента;
		СуммаНДСДоИзменения 	  = Объект.РасшифровкаПлатежа.Итог("СуммаНДС");
		//++ #7252 смарт: Тимофеева 01.07.2026
		
		Объект.СуммаДокумента = ДополнительныеПараметры.СуммаВВалютеДокумента;		
		Для Каждого ТекущаяСтрока Из Объект.РасшифровкаПлатежа Цикл 
	    	ТекущаяСтрока.Сумма = ДополнительныеПараметры.СуммыРасшифровки.Получить(ТекущаяСтрока.НомерСтроки); 
		КонецЦикла;
		СуммаДокументаПриИзмененииСервер();
		
		Объект.РаспределениеПоСчетам.Очистить();
		СтрРаспределениеПоСчетам 						= Объект.РаспределениеПоСчетам.Добавить();
		СтрРаспределениеПоСчетам.БанковскийСчетКасса 	= Объект.БанковскийСчет;
		СтрРаспределениеПоСчетам.ДатаПлатежа 			= Объект.ДатаПлатежа;
		СтрРаспределениеПоСчетам.Сумма 					= Объект.СуммаДокумента; 
		
		//++ #7252 смарт: Тимофеева 01.07.2026 / Дополнение при изменении суммы оплаты в Заявке на расход ДС 
		Модифицированность = Истина; 
		
		Если ЗначениеЗаполнено(Объект.НазначениеПлатежа) Тогда 
			ФорматнаяСтрока = "ЧДЦ=2; ЧРД=-; ЧН=0-00; ЧГ=";
			СуммаДокументаДоИзмененияСтрокой = Формат(СуммаДокументаДоИзменения, ФорматнаяСтрока);
			Если СтрНайти(Объект.НазначениеПлатежа, СуммаДокументаДоИзмененияСтрокой) > 0 Тогда  
				Объект.НазначениеПлатежа = СтрЗаменить(Объект.НазначениеПлатежа, СуммаДокументаДоИзмененияСтрокой, Формат(Объект.СуммаДокумента, ФорматнаяСтрока));	
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Не удалось скорректировать назначение платежа. Не найдена сумма до изменения ""%1""", СуммаДокументаДоИзмененияСтрокой));
			КонецЕсли;  
			
			СуммаНДСДоИзмененияСтрокой = Формат(СуммаНДСДоИзменения, ФорматнаяСтрока);
			Если СтрНайти(Объект.НазначениеПлатежа, СуммаНДСДоИзмененияСтрокой) > 0 Тогда  
				Объект.НазначениеПлатежа = СтрЗаменить(Объект.НазначениеПлатежа, СуммаНДСДоИзмененияСтрокой, Формат(Объект.РасшифровкаПлатежа.Итог("СуммаНДС"), ФорматнаяСтрока));	
			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Не удалось скорректировать назначение платежа. Не найдена сумма НДС до изменения ""%1""", СуммаНДСДоИзмененияСтрокой));
			КонецЕсли;
		КонецЕсли; 	
		//++ #7252 смарт: Тимофеева 01.07.2026
	КонецЕсли;	
КонецПроцедуры
