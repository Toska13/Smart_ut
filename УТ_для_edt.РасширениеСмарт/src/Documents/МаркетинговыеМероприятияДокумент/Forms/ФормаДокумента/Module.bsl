&НаСервере
Процедура ПерезаполнитьНаименованиеДокумента()
	
	//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
	ТочноеВремяПроведения = Объект.ТипМероприятия.Наименование;
	
	Если ЗначениеЗаполнено(Объект.смартДатаНачала) Тогда
		
		ТочноеВремяПроведения = ТочноеВремяПроведения + " на " + Формат(Объект.смартДатаНачала, "ДЛФ=DD");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.смартДатаНачала)
		И Объект.смартДатаНачала <> НачалоДня(Объект.смартДатаНачала) Тогда
		
		ТочноеВремяПроведения = ТочноеВремяПроведения + " в " + Формат(Объект.смартДатаНачала, "ДЛФ=T");
		
	КонецЕсли;
	
	//-- #Б-1982 смарт: Лопато 13.02.2025
	ВремяПроведенияОтложено = Объект.ТипМероприятия.Наименование + " требует уточнения";
	ВремяПроведения 		= ?(Объект.ОтсроченнаяЗаявка = Ложь, ТочноеВремяПроведения, ВремяПроведенияОтложено);
	
	Объект.НаименованиеМероприятия = ?(Объект.ТипМероприятия.Пустая() , Строка(""), ВремяПроведения);
	
КонецПроцедуры

