Процедура УстановитьОтсрочкаНаНеопределенныйСрок()
	
	Если Объект.ОтсроченнаяЗаявка = Истина Тогда
		Элементы.ДекорацияОтложенноНаНеопределенныйСрок.Заголовок = "Установить точную дату демонстрации";
		Элементы.ДатаНачалаПлан.Доступность = Ложь;
		Элементы.ВремяНачалаПлан.Доступность = Ложь;
		ПерезаполнитьНаименованиеДокумента();
	Иначе
		Элементы.ДекорацияОтложенноНаНеопределенныйСрок.Заголовок = "Отложить на неопределенный срок";
		Элементы.ДатаНачалаПлан.Доступность = Истина;
