&НаСервере
Процедура смарт_ОбрабататьВидыРабот(ТекущиеДанные)
		Если ТекущиеДанные.Отметка = Истина Тогда
			нашел = ложь;
			Для каждого Стр ИЗ Объект.ВидыРабот Цикл
				Если ТекущиеДанные.ВидРаботы = Стр.ВидРаботы И (ТекущиеДанные.смартИсполнитель = Стр.смартИсполнитель ИЛИ Стр.смартИсполнитель = Справочники.ФизическиеЛица.ПустаяСсылка()) Тогда
					ЗаполнитьЗначенияСвойств(Стр,ТекущиеДанные);
					нашел=истина;
				КонецЕсли
			КонецЦикла;
			Если нашел = ложь Тогда
				аа = Объект.ВидыРабот.Добавить();
				ЗаполнитьЗначенияСвойств(аа,ТекущиеДанные);
			КонецЕсли;
		Иначе
			Для каждого Стр ИЗ Объект.ВидыРабот Цикл
				Если ТекущиеДанные.ВидРаботы = Стр.ВидРаботы И (ТекущиеДанные.смартИсполнитель = Стр.смартИсполнитель ИЛИ Стр.смартИсполнитель = Справочники.ФизическиеЛица.ПустаяСсылка()) Тогда
					Объект.ВидыРабот.Удалить(Стр);
				КонецЕсли
			КонецЦикла;
		КонецЕсли;
КонецПроцедуры

//Смарт {{ 677 Корнющенко 18.10.21
&НаКлиенте
Процедура смарт_ВидыРаботПриИзмененииПосле(Элемент)
	ТекущиеДанные = Элементы.ВидыРабот.ТекущиеДанные;
	ТекущиеДанные2 = Элементы.ИсполнителиДемоЗал.ТекущиеДанные;

	Если ТекущиеДанные <> Неопределено Тогда
		Структура = новый Структура;
		Структура.Вставить("Отметка",ТекущиеДанные.Отметка);
		Структура.Вставить("ВидРаботы",ТекущиеДанные.ВидРаботы);
		Структура.Вставить("смартИсполнитель",ТекущиеДанные.смартИсполнитель);
		Структура.Вставить("смартСверхурочноеВремя",ТекущиеДанные.смартСверхурочноеВремя);
		Структура.Вставить("смартЗатраченноеВремя",ТекущиеДанные.смартЗатраченноеВремя);
		смарт_ОбрабататьВидыРабот(Структура);
		Если ТекущиеДанные2 <> Неопределено Тогда
			ТекущиеДанные2.ЗатраченноеВремя = ВидыРаботРеквизитФормы.Итог("смартЗатраченноеВремя");
			ТекущиеДанные2.СверхурочноеВремя = ВидыРаботРеквизитФормы.Итог("смартСверхурочноеВремя");
		КонецЕсли;
	КонецЕсли;
	Элементы.ВидыРаботЗатраченноеВремя.ТекстПодвала = ВидыРаботРеквизитФормы.Итог("смартЗатраченноеВремя");
	Элементы.ВидыРаботСверхурочноеВремя.ТекстПодвала = ВидыРаботРеквизитФормы.Итог("смартСверхурочноеВремя");
КонецПроцедуры 

//Смарт {{ 677 Корнющенко 18.10.21
&НаСервере
Процедура ЗаполнитьОборудование(Исполнитель);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Оборудование КАК Оборудование,
	| 	ВЫБОР КОГДА ТЗ.смартИсполнитель = &ПустойИсполнитель ТОГДА &Исполнитель ИНАЧЕ ТЗ.смартИсполнитель КОНЕЦ КАК смартИсполнитель
	| ПОМЕСТИТЬ ВР_ТЗ
	|ИЗ
	|  &ТЗ КАК ТЗ
	|ГДЕ
	|	ТЗ.смартИсполнитель=&Исполнитель ИЛИ ТЗ.смартИсполнитель=&ПустойИсполнитель
	|;
	|ВЫБРАТЬ
	|	ТЗ2.Оборудование КАК Оборудование,
	| 	ТЗ2.смартИсполнитель КАК смартИсполнитель
	|ИЗ
	|  ВР_ТЗ КАК ТЗ2";
		
	Запрос.УстановитьПараметр("ТЗ", Объект.ОборудованиеДляДемонстрацииИнженер.Выгрузить());
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("ПустойИсполнитель", Справочники.ФизическиеЛица.ПустаяСсылка());
	
	ОборудованиеРеквизитФормы.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

