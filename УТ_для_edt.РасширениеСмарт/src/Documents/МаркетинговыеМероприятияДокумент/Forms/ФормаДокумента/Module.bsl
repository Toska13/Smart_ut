	 |ИЗ ВТ_ТЗ КАК ТЗ
	 |ГДЕ
	 |  НЕ ТЗ.смартИсполнитель = &Исполнитель";
	 Запрос.УстановитьПараметр("Исполнитель",Исполнитель);
	 Запрос.УстановитьПараметр("ТЗ",Объект.ОборудованиеДляДемонстрацииИнженер.Выгрузить());
	 Объект.ОборудованиеДляДемонстрацииИнженер.Загрузить(Запрос.Выполнить().Выгрузить());
