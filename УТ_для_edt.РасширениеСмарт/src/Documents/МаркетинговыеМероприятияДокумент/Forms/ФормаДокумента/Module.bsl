Процедура СоздатьНапоминаниеПользователю()	

	//++ #Б-2562 смарт: Лопато 04.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
	УстановитьПривилегированныйРежим(Истина);
	//-- #Б-2562 смарт: Лопато 04.03.2025
	
	НовоеНапоминание = РегистрыСведений.НапоминанияПользователя.СоздатьМенеджерЗаписи();
	НовоеНапоминание.Регистратор = Объект.Ссылка;
	НовоеНапоминание.Описание = Строка("Необходимо поставить ОЦЕНКУ " + Объект.Ссылка);
	НовоеНапоминание.Пользователь = Объект.Менеджер;
	НовоеНапоминание.Источник = Объект.Ссылка;
	НовоеНапоминание.СпособУстановкиВремениНапоминания = Перечисления.СпособыУстановкиВремениНапоминания.Периодически;
	НовоеНапоминание.ВремяСобытия = Дата(ТекущаяДата());
	НовоеНапоминание.СрокНапоминания = Дата(ТекущаяДата());
	НовоеНапоминание.ИнтервалВремениНапоминания = 300;
	НовоеНапоминание.Записать(Ложь);
	
