	РегНапоминание = РегистрыСведений.НапоминанияПользователя.СоздатьНаборЗаписей();
	РегНапоминание.Отбор.Источник.Установить(Объект.Ссылка);
	
	//++ #Б-2744 смарт: Лопато 21.03.2025 //Установка оценки в закрытом ММ  
	УстановитьПривилегированныйРежим(Истина);

	РегНапоминание.Прочитать();
	
	Для Каждого ЗаписьНапоминание Из РегНапоминание Цикл
		
		Если СтрНайти(ЗаписьНапоминание.Описание, "Необходимо поставить ОЦЕНКУ") > 0 Тогда
			РегНапоминание.Удалить(ЗаписьНапоминание);
		КонецЕсли;	
		
	КонецЦикла;	
	//-- #Б-2744 смарт: Лопато 21.03.2025
	
	РегНапоминание.Записать();
	
