//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаСервере
Функция ПолучитьТелефонКонтактногоЛица(КонтактноеЛицо)
	
	Результат = "";
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(КонтактноеЛицо);

	МассивВидов = Новый Массив;
	МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица);
	МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица);
	 
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Перечисления.ТипыКонтактнойИнформации.Телефон);

	КонтактнаяИнформацияТелефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
									   МассивСсылок, МассивТипов, МассивВидов, ТекущаяДата());
							   
	Для Каждого СтрТелефон Из КонтактнаяИнформацияТелефоны Цикл
		
		Если ЗначениеЗаполнено(СтрТелефон.Представление) Тогда
			Возврат СтрТелефон.Представление;
		КонецЕсли;
		
	КонецЦикла;							   
		
	Возврат Результат;	
		
КонецФункции //-- #Б-1982 смарт: Лопато 13.02.2025

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаКлиенте
Процедура смарт_табПредставительКлиентаКонтактныеЛицаПриИзмененииПосле(Элемент)
	
	ТекущиеДанные = Элементы.табПредставительКлиента.ТекущиеДанные;
	
	ТекущиеДанные.Телефон = ПолучитьТелефонКонтактногоЛица(ТекущиеДанные.КонтактныеЛица);
	
КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаСервере
Процедура УстановитьДоступностьДатыОкончания()

	Если НЕ ЭтоАдминистраторИлиИнженерДемоЗала() 
		 И Объект.ТипМероприятия = ПредопределенноеЗначение("Справочник.демоТипыМероприятия.Демонстрация") Тогда
		 
		Элементы.смартДатаОкончания.Доступность = Ложь;
		
	Иначе
		
		Элементы.смартДатаОкончания.Доступность = Истина;

	КонецЕсли;	

КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаСервере
Процедура УстановитьДоступностьСтатуса()
	
	Если РольДоступна("ПолныеПрава") Тогда
		
		Элементы.Статус.ТолькоПросмотр = Ложь;
		
	Иначе
		
		Если Объект.Проведен
 	   		 И (Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта")
	   	  		ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Отмена")) Тогда
				
			Элементы.Статус.ТолькоПросмотр = Истина;
				
		Иначе
			
			Элементы.Статус.ТолькоПросмотр = НЕ ЭтоАдминистраторИлиИнженерДемоЗала();
			
		КонецЕсли;	
			
	КонецЕсли;					  

КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаКлиенте
Процедура УстановитьДатуОкончания()

	Если НЕ ЭтоАдминистраторИлиИнженерДемоЗала()
		И Объект.ТипМероприятия = ПредопределенноеЗначение("Справочник.демоТипыМероприятия.Демонстрация") Тогда
		
		Объект.смартДатаОкончания = Объект.смартДатаНачала + (2 * 3600); //+2 часа от начала
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаСервере
Процедура ОбновитьТелефоныКЛ()

	Для Каждого СтрКЛ Из Объект.табПредставительКлиента Цикл
		
		СтрКл.Телефон = ПолучитьТелефонКонтактногоЛица(СтрКЛ.КонтактныеЛица);
		
	КонецЦикла;

КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

