	//|	Наименование");
	//Элементы.ТипМероприятия.РежимВыбораИзСписка = Истина;
	//Элементы.ТипМероприятия.СписокВыбора.ЗагрузитьЗначения(
	//	Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	////-- #Б-1474 смарт: Фролов 03.12.2024
	//-- #Б-1984 смарт: Лопато 14.02.2025
	
	//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
	//++ #4898 смарт: Тимофеева 17.11.2025 / Создание механизма для учета квалификаций инженеров и менеджеров.
	//Если Объект.Ссылка.Пустая() Тогда  
	Если Объект.Ссылка.Пустая() И Параметры.Основание = Неопределено Тогда
	//-- #4898 смарт: Тимофеева 17.11.2025
				
		Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.ПустаяСсылка");
		
