	ИзменитьРеквизиты(МессивРеквизитов);
	
	НовыйЭлемент = Элементы.Вставить("смартРазрешитьРедактирование", Тип("ПолеФормы"), Элементы.ГруппаСтатус); 
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.Заголовок = "Разрешить редактирование";
	НовыйЭлемент.ПутьКданным = "смартРазрешитьРедактирование";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Видимость = Пользователи.РолиДоступны("смартРазрешеноРедактироватьМаркетинговоеМероприятие");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартРазрешитьРедактированиеПриИзменении");
	//-- #Б-6882 смарт: Фролов 25.05.2026
	
	//++ #Б7290 смарт: Шляпников 09.07.2026 / Документ "Маркетинговое мероприятие". Связь к Интересу "один ко многим".
	Если НЕ ЕстьИнтересСММ() Тогда
		
		Элементы.ГруппаСтатус.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		
		События = Новый Структура("ПриИзменении", "смартИнтересПриИзменении");
		Элемент = смартФормированиеИнтерфейса.СздПоле(ЭтаФорма, "смартИнтерес", "ГруппаСтатус",, 1, "Объект.смартИнтерес",, События);
		
		ПараметрыВыбораИнтереса = Новый Массив;
		ПараметрыВыбораИнтереса.Добавить(Новый ПараметрВыбора("Отбор.смартМаркетинговоеМероприятие", Документы.МаркетинговыеМероприятияДокумент.ПустаяСсылка()));
		Элемент.ПараметрыВыбора =	Новый ФиксированныйМассив(ПараметрыВыбораИнтереса);
		
	КонецЕсли;
	//-- #Б7290 смарт: Шляпников 09.07.2026
	
КонецПроцедуры
 
//++ смарт:ММ #026 181 01.03.2020 
&НаСервере
Процедура ЗаполнитьВидыРабот(Исполнитель)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.НомерСтроки КАК НомерСтроки,
	| 	ТЗ.ВидРаботы КАК ВидРаботы,
	//Смарт {{ 677 Корнющенко 18.10.21
	|	ТЗ.смартЗатраченноеВремя КАК смартЗатраченноеВремя,
	|	ТЗ.смартСверхурочноеВремя КАК смартСверхурочноеВремя,
	|	ВЫБОР КОГДА ТЗ.смартИсполнитель = &ПустойИсполнитель ТОГДА &Исполнитель ИНАЧЕ ТЗ.смартИсполнитель КОНЕЦ КАК смартИсполнитель
	//Смарт }} 677 Корнющенко 18.10.21
	|ПОМЕСТИТЬ ВТ_ТЗ
	|ИЗ
	|  &ТЗ КАК ТЗ
	|;
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ТЗ.НомерСтроки, 9999) КАК Порядок,
	|	ЕСТЬNULL(ПредопределенныеЗначения.Значение, ТЗ.ВидРаботы) КАК ВидРаботы,
	|   ВЫБОР 
	|      КОГДА ТЗ.ВидРаботы ЕСТЬ NULL
	|        ТОГДА ЛОЖЬ
	|     ИНАЧЕ ИСТИНА
	|   КОНЕЦ КАК Отметка,
	//Смарт {{ 677 Корнющенко 18.10.21
	|	ЕСТЬNULL(ТЗ.смартЗатраченноеВремя,0) КАК смартЗатраченноеВремя,
	|	ЕСТЬNULL(ТЗ.смартСверхурочноеВремя,0) КАК смартСверхурочноеВремя,
	|	ЕСТЬNULL(ТЗ.смартИсполнитель,&Исполнитель) КАК смартИсполнитель

	//Смарт }} 677 Корнющенко 18.10.21
	|ИЗ
	| 	Справочник.смартПредопределенныеЗначения.Значения КАК ПредопределенныеЗначения
	|  		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_ТЗ КАК ТЗ
	|  		ПО ПредопределенныеЗначения.Значение = ТЗ.ВидРаботы
	|		И (ТЗ.смартИсполнитель = &Исполнитель ИЛИ ТЗ.смартИсполнитель = &ПустойИсполнитель)
	|ГДЕ
	|	ПредопределенныеЗначения.Ссылка = &НастройкаВидыРабот
	
	|УПОРЯДОЧИТЬ ПО 
	|	ЕСТЬNULL(ТЗ.НомерСтроки, 9999),
	|	ЕСТЬNULL(ПредопределенныеЗначения.Значение, ТЗ.ВидРаботы)";
		
	Запрос.УстановитьПараметр("НастройкаВидыРабот", Справочники.смартПредопределенныеЗначения.ВидыРаботДляМаркетинговыхМероприятий);
	Запрос.УстановитьПараметр("ТЗ", Объект.ВидыРабот.Выгрузить());
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("ПустойИсполнитель", Справочники.ФизическиеЛица.ПустаяСсылка());

	
	ВидыРаботРеквизитФормы.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры //-- смарт:ММ 01.03.2020

//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	ЭлементыКП = ЭтаФорма.КоманднаяПанель.ПодчиненныеЭлементы;

	Для Каждого ЭлементКП Из ЭлементыКП Цикл 
		
		Если ЭлементКП.Имя = "ФормаПровестиИЗакрыть" И ЭлементКП <> ЭлементыКП.Получить(0) Тогда
			Элементы.Переместить(ЭлементКП, ЭтаФорма.КоманднаяПанель, ЭлементыКП.Получить(0));
		ИначеЕсли ЭлементКП.Имя = "ФормаПровести" И ЭлементКП <> ЭлементыКП.Получить(1) Тогда
			Элементы.Переместить(ЭлементКП, ЭтаФорма.КоманднаяПанель, ЭлементыКП.Получить(1));
		ИначеЕсли ЭлементКП.Имя = "ФормаЗаписать" И ЭлементКП <> ЭлементыКП.Получить(2) Тогда
			Элементы.Переместить(ЭлементКП, ЭтаФорма.КоманднаяПанель, ЭлементыКП.Получить(2));
		ИначеЕсли ЭлементКП.Имя = "ФормаПоказатьВСписке" И ЭлементКП <> ЭлементыКП.Получить(3) Тогда
			Элементы.Переместить(ЭлементКП, ЭтаФорма.КоманднаяПанель, ЭлементыКП.Получить(3));
		КонецЕсли;
		
	КонецЦикла;	
	
	УстановитьДоступностьДатыОкончания();
	
КонецПроцедуры //-- #Б-1982 смарт: Лопато 13.02.2025

#КонецОбласти

&НаСервере 
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
	
	ПерезаполнитьНаименованиеДокумента();
	
	УстановитьДосупностьНаСервере();
	
	Если Объект.Оценка <> 0 Тогда
		УдалитьНапоминание();
	КонецЕсли;
	
	// Первый в таблице будет отображаться в форме списка
	Если ТекущийОбъект.ИсполнителиДемоЗал.Количество() > 0 Тогда
		ТекущийОбъект.ИсполнительДемоЗал = ТекущийОбъект.ИсполнителиДемоЗал[0].Исполнитель;
	Иначе
		ТекущийОбъект.ИсполнительДемоЗал = Неопределено;
	КонецЕсли;
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		 ИЛИ (Объект.Проведен И НЕ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения) Тогда
		 
		Если НЕ ЗначениеЗаполнено(Объект.КомментарийИнженера)
			//++ #Б-2562 смарт: Лопато 04.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
			И НЕ РольДоступна("ПолныеПрава")
			//-- #Б-2562 смарт: Лопато 04.03.2025
			И Объект.Статус <> Объект.Ссылка.Статус
			И Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Отмена") Тогда
					 
			ОбщегоНазначения.СообщитьПользователю("Не заполнен ""Комментарий инженера""!", , "КомментарийИнженера", Объект.КомментарийИнженера, Отказ);
				
		КонецЕсли;
	
		Если НЕ ЗначениеЗаполнено(Объект.Комментарий) Тогда

			ОбщегоНазначения.СообщитьПользователю("Не заполнен ""Комментарий""!", , "Комментарий", Объект.Комментарий, Отказ);
			
		КонецЕсли;
			
	КонецЕсли;

	//++ #Б-2970 смарт: Лопато 07.04.2025 //Заявка на маркетинговое мероприятие. Установка оценки.  
	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта") Тогда
	
		Если Объект.смартДатаНачала > Объект.смартДатаОкончания Тогда
			
			ОбщегоНазначения.СообщитьПользователю("Установите дату окончания не ранее даты начала!", , 
												  "смартДатаОкончания", Объект.смартДатаОкончания, Отказ);
				
		КонецЕсли;
		
		Если НЕ ЭтоАдминистраторИлиИнженерДемоЗала() Тогда
			
			Если Объект.смартДатаНачала - НачалоДня(Объект.смартДатаНачала) < (9 * 3600) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Установите время начала не ранее 09:00:00", , 
													  "смартДатаНачала", Объект.смартДатаНачала, Отказ);
				
			КонецЕсли;
			
			Если Объект.смартДатаОкончания - НачалоДня(Объект.смартДатаОкончания) > (18 * 3600) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Установите время окончания не позже 18:00:00", , 
													  "смартДатаОкончания", Объект.смартДатаОкончания, Отказ);
				
			КонецЕсли;
			
		КонецЕсли;	

	КонецЕсли;	
	//-- #Б-2970 смарт: Лопато 07.04.2025
		
	Если НЕ смартПользователи.РольДоступнаПользователю("ПолныеПрава")
		И Объект.Статус = ПредопределенноеЗначение("Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта") Тогда
		
		Если Объект.ИсполнителиДемоЗал.Количество() = 0 Тогда

			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить ответственных за мероприятие", , 
															  "ИсполнителиДемоЗал", Объект.ИсполнителиДемоЗал, Отказ);
			
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.КомуПередано) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить ответственных за мероприятие", , 
