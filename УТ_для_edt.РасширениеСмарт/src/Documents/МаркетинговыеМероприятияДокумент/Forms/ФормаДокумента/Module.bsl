//++ #4174 смарт: Тимофеева 15.09.2025 / Заявка на маркетинговое мероприятие. Дополнения. Склады ДемоЗала.
&НаСервере
Функция ПолучитьДемоЗалПоПользователю(Пользователь)
	Результат = Справочники.Склады.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(Склады.Ссылка, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)) КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Склады КАК Склады
	|		ПО Пользователи.Подразделение = Склады.Подразделение
	|			И (Склады.Родитель = &Родитель)
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	//++ #Б-7056 смарт: Фролов 08.06.2026 //Основной ДемоЗал в ММ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";
	//-- #Б-7056 смарт: Фролов 08.06.2026
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Родитель", Справочники.Склады.НайтиПоНаименованию("ДемоЗалы", Истина));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	Возврат Результат;
КонецФункции	
 
&НаСервере
Функция ПолучитьСкладыДемоЗала()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Родитель = &Родитель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";	
	Запрос.УстановитьПараметр("Родитель", Справочники.Склады.НайтиПоНаименованию("ДемоЗалы", Истина));	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции
