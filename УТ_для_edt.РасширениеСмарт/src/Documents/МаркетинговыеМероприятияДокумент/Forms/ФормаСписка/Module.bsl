// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Процедура ПечататьДокументНаСервере(ТабличныйДокумент, ПараметрКоманды)
	Документы.МаркетинговыеМероприятияДокумент.ПечатьЧерезОбщуюФорму(ТабличныйДокумент, ПараметрКоманды);
КонецПроцедуры

&НаКлиенте
Процедура ПечататьДокумент(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ЭтотИмяФормы = ЭтотОбъект.ИмяФормы;
	ТабДокумент = Новый ТабличныйДокумент;
	ПечататьДокументНаСервере(ТабДокумент, ПараметрКоманды);
	КоллекцияПечатныхФорм = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("МакетЗаявкаНаДемонстрацию");
	ПечатнаяФорма = УправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "МакетЗаявкаНаДемонстрацию");
	ПечатнаяФорма.СинонимМакета = "МакетЗаявкаНаДемонстрацию";
	ПечатнаяФорма.ТабличныйДокумент = ТабДокумент;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = "Макет";
	
	ОбластиОбъектов = Новый СписокЗначений;
	УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
	//ТабДокумент.показать();
КонецПроцедуры

