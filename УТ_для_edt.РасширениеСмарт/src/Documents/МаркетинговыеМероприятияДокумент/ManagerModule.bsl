//Тест печать через общую форму
Функция ПечатьЧерезОбщуюФорму(ТабДок, ОбъектСсылка) Экспорт
	
    Макет = Документы.МаркетинговыеМероприятияДокумент.ПолучитьМакет("МакетЗаявкаНаДемонстрацию");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МаркетинговыеМероприятияДокумент.ВремяНачалаПлан,
	|	МаркетинговыеМероприятияДокумент.ВремяПроведенияДо,
	|	МаркетинговыеМероприятияДокумент.ВремяПроведенияОт,
	|	МаркетинговыеМероприятияДокумент.Дата,
	|	МаркетинговыеМероприятияДокумент.ДатаЗакрытияЗаявки,
	|	МаркетинговыеМероприятияДокумент.ДатаНачалаПлан,
	|	МаркетинговыеМероприятияДокумент.ДатаНачалаФакт,
	|	МаркетинговыеМероприятияДокумент.ДатаОценки,
	|	МаркетинговыеМероприятияДокумент.ЗаявкаЗакрыта,
	|	МаркетинговыеМероприятияДокумент.ИсполнительДемоЗал,
	|	МаркетинговыеМероприятияДокумент.КлиентПартнер,
	|	МаркетинговыеМероприятияДокумент.Комментарий,
	|	МаркетинговыеМероприятияДокумент.Менеджер,
	|	МаркетинговыеМероприятияДокумент.НаименованиеМероприятия,
	|	МаркетинговыеМероприятияДокумент.Номер,
	|	МаркетинговыеМероприятияДокумент.ОтсроченнаяЗаявка,
	|	МаркетинговыеМероприятияДокумент.Оценка,
	|	МаркетинговыеМероприятияДокумент.ПользовательПоставилОценку,
	|	МаркетинговыеМероприятияДокумент.ТипМероприятия,
	//++ смарт:ММ #026 181 01.03.2020 
	|	МаркетинговыеМероприятияДокумент.КомуПередано,
	|	МаркетинговыеМероприятияДокумент.ИсполнителиДемоЗал.(
	|		НомерСтроки,
	|		Исполнитель,
	|		ЗатраченноеВремя,
	|		СверхурочноеВремя,
	|		смартКомментарийИнженера
	|	),
	|	МаркетинговыеМероприятияДокумент.ВидыРабот.(
	|		НомерСтроки,
	|		ВидРаботы,
	|		смартЗатраченноеВремя,
	|		смартСверхурочноеВремя,
	|		смартИсполнитель
	|	),
	|	МаркетинговыеМероприятияДокумент.ОборудованиеДляДемонстрацииИнженер.(
	|		НомерСтроки,
	|		Оборудование,
	|		смартИсполнитель
	|	),
	//-- смарт:ММ 01.03.2020
