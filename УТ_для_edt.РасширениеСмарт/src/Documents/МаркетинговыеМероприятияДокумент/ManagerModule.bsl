Процедура ОбновитьОценкуДемонстрации(ОбъектСсылка) Экспорт
	
	Если ОбъектСсылка.Оценка = 1 Тогда
		ОбъектСсылка.Оценка1 = Истина;
		ОбъектСсылка.Оценка2 = Ложь;
		ОбъектСсылка.Оценка3 = Ложь;
		ОбъектСсылка.Оценка4 = Ложь;
		ОбъектСсылка.Оценка5 = Ложь;
	ИначеЕсли ОбъектСсылка.Оценка = 2 Тогда
		ОбъектСсылка.Оценка1 = Ложь;
		ОбъектСсылка.Оценка2 = Истина;
		ОбъектСсылка.Оценка3 = Ложь;
		ОбъектСсылка.Оценка4 = Ложь;
		ОбъектСсылка.Оценка5 = Ложь;	
	ИначеЕсли ОбъектСсылка.Оценка = 3 Тогда
		ОбъектСсылка.Оценка1 = Ложь;
		ОбъектСсылка.Оценка2 = Ложь;
		ОбъектСсылка.Оценка3 = Истина;
		ОбъектСсылка.Оценка4 = Ложь;
		ОбъектСсылка.Оценка5 = Ложь;
	ИначеЕсли ОбъектСсылка.Оценка = 4 Тогда
		ОбъектСсылка.Оценка1 = Ложь;
		ОбъектСсылка.Оценка2 = Ложь;
		ОбъектСсылка.Оценка3 = Ложь;
		ОбъектСсылка.Оценка4 = Истина;
		ОбъектСсылка.Оценка5 = Ложь;
	ИначеЕсли ОбъектСсылка.Оценка = 5 Тогда
		ОбъектСсылка.Оценка1 = Ложь;
		ОбъектСсылка.Оценка2 = Ложь;
		ОбъектСсылка.Оценка3 = Ложь;
		ОбъектСсылка.Оценка4 = Ложь;
		ОбъектСсылка.Оценка5 = Истина;
	Иначе
		ОбъектСсылка.Оценка1 = Ложь;
		ОбъектСсылка.Оценка2 = Ложь;
		ОбъектСсылка.Оценка3 = Ложь;
		ОбъектСсылка.Оценка4 = Ложь;
		ОбъектСсылка.Оценка5 = Ложь;
	КонецЕсли;
	
	Если ОбъектСсылка.Оценка > 5 Тогда
		ОбъектСсылка.Оценка = 0;
	КонецЕсли;
	
КонецПроцедуры

Функция ПроверитьДоступностьДатыМероприятия(Знач ОбъектСсылка)Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Результат=Новый Структура("ДатаСвободна,Ошибки",Истина,Новый Массив);
	
	ПроверяемаяДата=?(ЗначениеЗаполнено(ОбъектСсылка.ДатаНачалаФакт),ОбъектСсылка.ДатаНачалаФакт,ОбъектСсылка.ДатаНачалаПлан);
	Если Не ЗначениеЗаполнено(ПроверяемаяДата) Тогда Возврат Результат; КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("МассивОборудования",ОбъектСсылка.табОборудованиеДляДемонстрации.Выгрузить().ВыгрузитьКолонку("Оборудование"));
	Запрос.УстановитьПараметр("ВыбираемаяДатаМероприятия",ПроверяемаяДата);
	Запрос.УстановитьПараметр("Ссылка",ОбъектСсылка.Ссылка);
	
	Запрос.Текст="ВЫБРАТЬ
	|демоДемонстрацияОборудования.Регистратор КАК Мероприятие,
	|демоДемонстрацияОборудования.Номенклатура КАК Оборудование,
	|ВЫБОР
	|	КОГДА демоДемонстрацияОборудования.ДатаНачалаФакт = ДАТАВРЕМЯ(1, 1, 1)
	|		ТОГДА демоДемонстрацияОборудования.ДатаНачалаПлан
	|	ИНАЧЕ демоДемонстрацияОборудования.ДатаНачалаФакт
	|КОНЕЦ КАК ДатаМероприятия
	|ИЗ
	|РегистрНакопления.демоДемонстрацияОборудования КАК демоДемонстрацияОборудования
	|ГДЕ
	|демоДемонстрацияОборудования.Регистратор ССЫЛКА Документ.МаркетинговыеМероприятияДокумент
	|И демоДемонстрацияОборудования.Номенклатура В(&МассивОборудования)
	|И (демоДемонстрацияОборудования.ДатаНачалаФакт = &ВыбираемаяДатаМероприятия
	|		ИЛИ демоДемонстрацияОборудования.ДатаНачалаФакт = ДАТАВРЕМЯ(1, 1, 1)
	|			И демоДемонстрацияОборудования.ДатаНачалаПлан = &ВыбираемаяДатаМероприятия)
	|";
	Если ЗначениеЗаполнено(ОбъектСсылка.Ссылка) Тогда 
		Запрос.Текст=Запрос.Текст+"И НЕ демоДемонстрацияОборудования.Регистратор = &Ссылка";
	КонецЕсли;	
	Рез=Запрос.Выполнить().Выбрать();
	Пока Рез.Следующий() Цикл
		Результат.ДатаСвободна=Ложь;
		Результат.Ошибки.Добавить(Новый Структура("Мероприятие,Оборудование,ДатаМероприятия",Рез.Мероприятие,Рез.Оборудование,Рез.ДатаМероприятия));
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции	

