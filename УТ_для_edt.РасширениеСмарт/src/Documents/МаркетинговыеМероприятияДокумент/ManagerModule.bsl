#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ДоработкиСмарт
#Область Печать

Функция  Печать(ТабДок, ПараметрКоманды) Экспорт	
	
	Макет = Документы.МаркетинговыеМероприятияДокумент.ПолучитьМакет("МакетЗаявкаНаДемонстрацию");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МаркетинговыеМероприятияДокумент.ВремяНачалаПлан,
	|	МаркетинговыеМероприятияДокумент.ВремяПроведенияДо,
	|	МаркетинговыеМероприятияДокумент.ВремяПроведенияОт,
	|	МаркетинговыеМероприятияДокумент.Дата,
	|	МаркетинговыеМероприятияДокумент.ДатаЗакрытияЗаявки,
	|	МаркетинговыеМероприятияДокумент.ДатаНачалаПлан,
	|	МаркетинговыеМероприятияДокумент.ДатаНачалаФакт,
	|	МаркетинговыеМероприятияДокумент.ДатаОценки,
	|	МаркетинговыеМероприятияДокумент.ЗаявкаЗакрыта,
	|	МаркетинговыеМероприятияДокумент.ИсполнительДемоЗал,
	|	МаркетинговыеМероприятияДокумент.КлиентПартнер,
	|	МаркетинговыеМероприятияДокумент.Комментарий,
	|	МаркетинговыеМероприятияДокумент.Менеджер,
	|	МаркетинговыеМероприятияДокумент.НаименованиеМероприятия,
	|	МаркетинговыеМероприятияДокумент.Номер,
	|	МаркетинговыеМероприятияДокумент.ОтсроченнаяЗаявка,
	|	МаркетинговыеМероприятияДокумент.Оценка,
	|	МаркетинговыеМероприятияДокумент.ПользовательПоставилОценку,
	|	МаркетинговыеМероприятияДокумент.ТипМероприятия,
	//++ смарт:ММ #026 181 01.03.2020 
	|	МаркетинговыеМероприятияДокумент.КомуПередано,
	|	МаркетинговыеМероприятияДокумент.ИсполнителиДемоЗал.(
	|		НомерСтроки,
	|		Исполнитель,
	|		ЗатраченноеВремя,
	|		СверхурочноеВремя,
	|		смартКомментарийИнженера
	|	),
	|	МаркетинговыеМероприятияДокумент.ВидыРабот.(
	|		НомерСтроки,
	|		ВидРаботы,
	|		смартЗатраченноеВремя,
	|		смартСверхурочноеВремя,
	|		смартИсполнитель
	|	),
	|	МаркетинговыеМероприятияДокумент.ОборудованиеДляДемонстрацииИнженер.(
	|		НомерСтроки,
	|		Оборудование,
	|		смартИсполнитель
	|	),
	//-- смарт:ММ 01.03.2020
	|	МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации.(
	|		НомерСтроки,
	|		Оборудование
	|	),
	|	МаркетинговыеМероприятияДокумент.табМатериалыДляДемонстрации.(
	|		НомерСтроки,
	|		Материалы
	|	),
	|	МаркетинговыеМероприятияДокумент.табПредставительКлиента.(
	|		НомерСтроки,
	|		КонтактныеЛица
	|	),
	|	МаркетинговыеМероприятияДокумент.ИсторияИзмененияОценки.(
	|		НомерСтроки,
	|		Пользователь,
	|		Оценка,
	|		ДатаИзменения
	|	)
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент КАК МаркетинговыеМероприятияДокумент
	|ГДЕ
	|	МаркетинговыеМероприятияДокумент.Ссылка В(&МассивОбъектов)";
	Запрос.Параметры.Вставить("МассивОбъектов", ПараметрКоманды);
	Выборка = Запрос.Выполнить().Выбрать();

	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьтабОборудованиеДляДемонстрацииШапка = Макет.ПолучитьОбласть("табОборудованиеДляДемонстрацииШапка");
	ОбластьтабОборудованиеДляДемонстрации = Макет.ПолучитьОбласть("табОборудованиеДляДемонстрации");
	ОбластьтабМатериалыДляДемонстрацииШапка = Макет.ПолучитьОбласть("табМатериалыДляДемонстрацииШапка");
	ОбластьтабМатериалыДляДемонстрации = Макет.ПолучитьОбласть("табМатериалыДляДемонстрации");
	ОбластьтабПредставительКлиентаШапка = Макет.ПолучитьОбласть("табПредставительКлиентаШапка");
	ОбластьтабПредставительКлиента = Макет.ПолучитьОбласть("табПредставительКлиента");
	//ОбластьИсторияИзмененияОценкиШапка = Макет.ПолучитьОбласть("ИсторияИзмененияОценкиШапка");
	//ОбластьИсторияИзмененияОценки = Макет.ПолучитьОбласть("ИсторияИзмененияОценки");
	//Смарт {{ 677 Корнющенко 18.10.21
	ОбластьтабОборудованиеДляДемонстрацииИнженерШапка = Макет.ПолучитьОбласть("ОборудованиеДляДемонстрацииИнженерШапка");
	ОбластьтабОборудованиеДляДемонстрацииИнженер = Макет.ПолучитьОбласть("ОборудованиеДляДемонстрацииИнженер");
	ОбластьВидыРаботШапка = Макет.ПолучитьОбласть("ВидыРаботШапка");
	ОбластьВидыРабот = Макет.ПолучитьОбласть("ВидыРабот");

	//Смарт }} 677 Корнющенко 18.10.21
	Подвал = Макет.ПолучитьОбласть("Подвал");

	ТабДок.Очистить();

	ВставлятьРазделительСтраниц = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ВставлятьРазделительСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(ОбластьЗаголовок, Выборка.Уровень());

		Шапка.Параметры.Заполнить(Выборка);
		
		//++ смарт:ММ #026 181 01.03.2020 
		// Исполнители
		ИсполнителиТекстШапка = "";
		ИсполнителиТекст = "";
		КоличествоИсполнителей = 0;
		
		ВыборкаИсполнителиДемоЗал = Выборка.ИсполнителиДемоЗал.Выбрать();
		Пока ВыборкаИсполнителиДемоЗал.Следующий() Цикл
			КоличествоИсполнителей = КоличествоИсполнителей + 1;
			ИсполнителиТекстШапка = ИсполнителиТекстШапка + ?(ЗначениеЗаполнено(ИсполнителиТекстШапка), "; ", "") + ВыборкаИсполнителиДемоЗал.Исполнитель;
			
			СверхурочноеВремя = "";
			Если ЗначениеЗаполнено(ВыборкаИсполнителиДемоЗал.СверхурочноеВремя) Тогда
				СверхурочноеВремя = "сверхурочное время: " + ВыборкаИсполнителиДемоЗал.СверхурочноеВремя + " ч." + Символы.ПС + "Комментарий:" + ВыборкаИсполнителиДемоЗал.смартКомментарийИнженера;
			КонецЕсли;
			
			ТекстТекущийИсполнитель = "" + ВыборкаИсполнителиДемоЗал.Исполнитель + ". Затраченное время: " 
				+ ВыборкаИсполнителиДемоЗал.ЗатраченноеВремя + " ч." 
				+ ?(ЗначениеЗаполнено(СверхурочноеВремя), ", " + СверхурочноеВремя, "");
				
			ИсполнителиТекст = ИсполнителиТекст + ?(ЗначениеЗаполнено(ИсполнителиТекст), Символы.ПС, "") + ТекстТекущийИсполнитель;
			
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(ИсполнителиТекстШапка) И ЗначениеЗаполнено(Выборка.ИсполнительДемоЗал) Тогда
			КоличествоИсполнителей = 1;
			ИсполнителиТекстШапка = Выборка.ИсполнительДемоЗал;
		КонецЕсли;	
		Шапка.Параметры.ИсполнительДемоЗал = ИсполнителиТекстШапка;
		//-- смарт:ММ 01.03.2020
		
		ТабДок.Вывести(Шапка, Выборка.Уровень());
		
		//Таблица Представитель клиента
		ТабДок.Вывести(ОбластьтабПредставительКлиентаШапка);
		ВыборкатабПредставительКлиента = Выборка.табПредставительКлиента.Выбрать();
		Пока ВыборкатабПредставительКлиента.Следующий() Цикл
			ОбластьтабПредставительКлиента.Параметры.Заполнить(ВыборкатабПредставительКлиента);
			ТабДок.Вывести(ОбластьтабПредставительКлиента, ВыборкатабПредставительКлиента.Уровень());
		КонецЦикла;
		
		//Таблица Оборудование
		ТабДок.Вывести(ОбластьтабОборудованиеДляДемонстрацииШапка);
		ВыборкатабОборудованиеДляДемонстрации = Выборка.табОборудованиеДляДемонстрации.Выбрать();
		Пока ВыборкатабОборудованиеДляДемонстрации.Следующий() Цикл
			ОбластьтабОборудованиеДляДемонстрации.Параметры.Заполнить(ВыборкатабОборудованиеДляДемонстрации);
			ТабДок.Вывести(ОбластьтабОборудованиеДляДемонстрации, ВыборкатабОборудованиеДляДемонстрации.Уровень());
		КонецЦикла;
		
		//Смарт {{ 677 Корнющенко 18.10.21
		//Таблица Оборудование Инженер
		ТабДок.Вывести(ОбластьтабОборудованиеДляДемонстрацииИнженерШапка);
		ВыборкаОборудованиеДляДемонстрацииИнженер = Выборка.ОборудованиеДляДемонстрацииИнженер.Выбрать();
		Пока ВыборкаОборудованиеДляДемонстрацииИнженер.Следующий() Цикл
			ОбластьтабОборудованиеДляДемонстрацииИнженер.Параметры.Заполнить(ВыборкаОборудованиеДляДемонстрацииИнженер);
			ТабДок.Вывести(ОбластьтабОборудованиеДляДемонстрацииИнженер, ВыборкаОборудованиеДляДемонстрацииИнженер.Уровень());
		КонецЦикла;
		
		//Таблица Виды работ Инженеров
		ТабДок.Вывести(ОбластьВидыРаботШапка);
		ВыборкаВидыРабот = Выборка.ВидыРабот.Выбрать();
		Пока ВыборкаВидыРабот.Следующий() Цикл
			ОбластьВидыРабот.Параметры.Заполнить(ВыборкаВидыРабот);
			ТабДок.Вывести(ОбластьВидыРабот, ВыборкаВидыРабот.Уровень());
		КонецЦикла;

		//Смарт }} 677 Корнющенко 18.10.21


		//Таблица Материалы
		ТабДок.Вывести(ОбластьтабМатериалыДляДемонстрацииШапка);
		ВыборкатабМатериалыДляДемонстрации = Выборка.табМатериалыДляДемонстрации.Выбрать();
		Пока ВыборкатабМатериалыДляДемонстрации.Следующий() Цикл
			ОбластьтабМатериалыДляДемонстрации.Параметры.Заполнить(ВыборкатабМатериалыДляДемонстрации);
			ТабДок.Вывести(ОбластьтабМатериалыДляДемонстрации, ВыборкатабМатериалыДляДемонстрации.Уровень());
		КонецЦикла;
		
		//ТабДок.Вывести(ОбластьИсторияИзмененияОценкиШапка);
		//ВыборкаИсторияИзмененияОценки = Выборка.ИсторияИзмененияОценки.Выбрать();
		//Пока ВыборкаИсторияИзмененияОценки.Следующий() Цикл
		//	ОбластьИсторияИзмененияОценки.Параметры.Заполнить(ВыборкаИсторияИзмененияОценки);
		//	ТабДок.Вывести(ОбластьИсторияИзмененияОценки, ВыборкаИсторияИзмененияОценки.Уровень());
		//КонецЦикла;

		Подвал.Параметры.Заполнить(Выборка);
		
		//++ смарт:ММ #026 181 01.03.2020 
		// Заполнение комментария инженера

		// Кому передано
		КомментарийИнженера = "";
		Если ЗначениеЗаполнено(Выборка.КомуПередано) Тогда
			КомментарийИнженера = КомментарийИнженера + "Кому передано: " + Выборка.КомуПередано;
		КонецЕсли;
				
		// Виды работ
		//ВидыРаботТекст = "";
		//
		//ВыборкаВидыРабот = Выборка.ВидыРабот.Выбрать();
		//Пока ВыборкаВидыРабот.Следующий() Цикл
		//	ВидыРаботТекст = ВидыРаботТекст + ?(ЗначениеЗаполнено(ВидыРаботТекст), "; ", "") + ВыборкаВидыРабот.ВидРаботы;
		//КонецЦикла;
		//
		//Если ЗначениеЗаполнено(ВидыРаботТекст) Тогда
		//	Если ЗначениеЗаполнено(КомментарийИнженера) Тогда
		//		КомментарийИнженера = КомментарийИнженера + Символы.ПС;
		//	КонецЕсли;
		//	КомментарийИнженера = КомментарийИнженера + "Виды работ: " + ВидыРаботТекст;
		//КонецЕсли;
		//
		//// Оборудование инженер
		//ОборудованиеИнженерТекст = "";
		//
		//ВыборкаОборудованиеДляДемонстрацииИнженер = Выборка.ОборудованиеДляДемонстрацииИнженер.Выбрать();
		//Пока ВыборкаОборудованиеДляДемонстрацииИнженер.Следующий() Цикл
		//	ОборудованиеИнженерТекст = ОборудованиеИнженерТекст 
		//			+ ?(ЗначениеЗаполнено(ОборудованиеИнженерТекст), "; ", "") 
		//			+ ВыборкаОборудованиеДляДемонстрацииИнженер.Оборудование;
		//КонецЦикла;
		//
		//Если ЗначениеЗаполнено(ОборудованиеИнженерТекст) Тогда
		//	Если ЗначениеЗаполнено(КомментарийИнженера) Тогда
		//		КомментарийИнженера = КомментарийИнженера + Символы.ПС;
		//	КонецЕсли;
		//	КомментарийИнженера = КомментарийИнженера + "Оборудование: " + ОборудованиеИнженерТекст;
		//КонецЕсли;
		
		// Исполнители		
		Если ЗначениеЗаполнено(ИсполнителиТекст) Тогда
			Если ЗначениеЗаполнено(КомментарийИнженера) Тогда
				КомментарийИнженера = КомментарийИнженера + Символы.ПС;
			КонецЕсли;
			КомментарийИнженера = КомментарийИнженера + ?(КоличествоИсполнителей = 1, "Исполнитель: ", "Исполнители:" + Символы.ПС) + ИсполнителиТекст;
		КонецЕсли;
		
		
		Подвал.Параметры.КомментарийИнженера = КомментарийИнженера;	
		//-- смарт:ММ 01.03.2020
		
		ТабДок.Вывести(Подвал);

		ВставлятьРазделительСтраниц = Истина;
	КонецЦикла;

КонецФункции

//Функция ПолучитьДанныеДляПечати(Объект)
