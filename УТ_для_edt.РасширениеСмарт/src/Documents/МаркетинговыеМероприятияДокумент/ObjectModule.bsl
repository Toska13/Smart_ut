//++ смарт:ММ #011 154 13.12.2019
Функция смартПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Пользователь
	|ПОМЕСТИТЬ ВТ_СписокПользователей
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначения.СписокЗначений = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПользователиСпр.смартРабочаяПочта КАК смартРабочаяПочта
	|ИЗ
	|	ВТ_СписокПользователей КАК ВТ_СписокПользователей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
	|		ПО ВТ_СписокПользователей.Пользователь = ПользователиСпр.Ссылка
	|ГДЕ 
	|	ЕСТЬNULL(ПользователиСпр.смартРабочаяПочта, """") <> """"";
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.смартПредопределенныеЗначения.ПользовательДляУведомленийОСозданииМаркетинговогоМероприятия);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.смартРабочаяПочта);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции //-- смарт:ММ 13.12.2019

//++ смарт:ММ #011 154 13.12.2019
Функция ПолучитьФорматированныйТекст(ДанныеОтправки)
	
	Док = Новый ФорматированныйДокумент;
	
	Заголовок = Док.Добавить("Уведомление.", ТипЭлементаФорматированногоДокумента.Текст);
	Заголовок.Шрифт = Новый Шрифт("Arial", 16, Истина);
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	
	Абзац = Док.Добавить(ДанныеОтправки.Заголовок, ТипЭлементаФорматированногоДокумента.Текст);
	Абзац.Шрифт = Новый Шрифт("Arial", 12);
	
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	Док.Добавить("", ТипЭлементаФорматированногоДокумента.ПереводСтроки);
	
	Подпись = Док.Добавить("Письмо создано роботом и не требует ответа.", ТипЭлементаФорматированногоДокумента.Текст);
	Подпись.Шрифт = Новый Шрифт("Arial", 8);
	
	Возврат Док;
	
КонецФункции //-- смарт:ММ 13.12.2019

//++ #Б7900 смарт: Шляпников 24.08.2026 / Документ "Маркетинговое мероприятие". Форма списка документов. Отбор по полиграфическому оборудованию.
Функция смартДокументИмеетПолиграфическоеОборудование()
	
	ГруппаПолиграфии = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки(
		"ГруппаПолиграфическогоОборудованияДемозала");
	
	Если Не ЗначениеЗаполнено(ГруппаПолиграфии) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОборудованиеДокумента = Новый Массив;
	Для Каждого СтрокаОборудования Из табОборудованиеДляДемонстрации Цикл
		
		Если ЗначениеЗаполнено(СтрокаОборудования.Оборудование) Тогда
			ОборудованиеДокумента.Добавить(СтрокаОборудования.Оборудование);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОборудованиеДокумента.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДемоОборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.демоОборудованиеДляДемонстрации КАК ДемоОборудование
	|ГДЕ
	|	ДемоОборудование.Ссылка В (&Оборудование)
	|	И ДемоОборудование.Ссылка В ИЕРАРХИИ (&Группа)";
	
	Запрос.УстановитьПараметр("Оборудование", ОборудованиеДокумента);
	Запрос.УстановитьПараметр("Группа", ГруппаПолиграфии);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

