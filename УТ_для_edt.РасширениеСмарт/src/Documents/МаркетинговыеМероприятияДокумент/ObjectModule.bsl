	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	МаркетинговыеМероприятияДокумент.Дата КАК Период,
	             |	МаркетинговыеМероприятияДокумент.КлиентПартнер КАК Партнер,
	             |	МаркетинговыеМероприятияДокумент.Менеджер КАК Менеджер,
	             |	МаркетинговыеМероприятияДокумент.ИсполнительДемоЗал КАК ОтветственныйЗаДемонстрацию,
	             |	МаркетинговыеМероприятияДокумент.Ссылка КАК Распоряжение,
	             |	NULL КАК Номенклатура,
	             |	0 КАК КоличествоДемонстрация,
	             |	МаркетинговыеМероприятияДокумент.ДатаНачалаПлан КАК ДатаНачалаПлан,
	             |	МаркетинговыеМероприятияДокумент.ДатаНачалаФакт КАК ДатаНачалаФакт
	             |ПОМЕСТИТЬ ВТ_Таб
	             |ИЗ
	             |	Документ.МаркетинговыеМероприятияДокумент КАК МаркетинговыеМероприятияДокумент
	             |ГДЕ
	             |	МаркетинговыеМероприятияДокумент.Ссылка = &Ссылка
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	ТабОборудование.Ссылка.Дата,
	             |	ТабОборудование.Ссылка.КлиентПартнер,
	             |	ТабОборудование.Ссылка.Менеджер,
	             |	ТабОборудование.Ссылка.ИсполнительДемоЗал,
	             |	ТабОборудование.Ссылка.Ссылка,
	             |	ТабОборудование.Оборудование,
	             |	1,
	             |	ТабОборудование.Ссылка.ДатаНачалаПлан,
	             |	ТабОборудование.Ссылка.ДатаНачалаФакт
	             |ИЗ
	             |	Документ.МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации КАК ТабОборудование
	             |ГДЕ
	             |	ТабОборудование.Ссылка = &Ссылка
	             |
	             |ОБЪЕДИНИТЬ ВСЕ
	             |
	             |ВЫБРАТЬ
	             |	Матириалы.Ссылка.Дата,
	             |	Матириалы.Ссылка.КлиентПартнер,
	             |	Матириалы.Ссылка.Менеджер,
	             |	Матириалы.Ссылка.ИсполнительДемоЗал,
	             |	Матириалы.Ссылка.Ссылка,
	             |	Матириалы.Материалы,
	             |	1,
	             |	Матириалы.Ссылка.ДатаНачалаПлан,
	             |	Матириалы.Ссылка.ДатаНачалаФакт
	             |ИЗ
	             |	Документ.МаркетинговыеМероприятияДокумент.табМатериалыДляДемонстрации КАК Матириалы
	             |ГДЕ
	             |	Матириалы.Ссылка = &Ссылка
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	СУММА(ВТ_Таб.КоличествоДемонстрация) КАК Кол
	             |ПОМЕСТИТЬ ВТ_Кол
	             |ИЗ
	             |	ВТ_Таб КАК ВТ_Таб
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	ВТ_Таб.Период КАК Период,
	             |	ВТ_Таб.Партнер КАК Партнер,
	             |	ВТ_Таб.Менеджер КАК Менеджер,
	             |	ВТ_Таб.ОтветственныйЗаДемонстрацию КАК ОтветственныйЗаДемонстрацию,
	             |	ВТ_Таб.Распоряжение КАК Распоряжение,
	             |	ВТ_Таб.Номенклатура КАК Номенклатура,
	             |	ВТ_Таб.КоличествоДемонстрация КАК КоличествоДемонстрация,
	             |	ВТ_Таб.ДатаНачалаПлан КАК ДатаНачалаПлан,
	             |	ВТ_Таб.ДатаНачалаФакт КАК ДатаНачалаФакт
	             |ИЗ
	             |	ВТ_Таб КАК ВТ_Таб,
	             |	ВТ_Кол КАК ВТ_Кол
	             |ГДЕ
	             |	(ВТ_Кол.Кол = 0
	             |			ИЛИ НЕ ВТ_Таб.Номенклатура ЕСТЬ NULL)";
	НаборДвиженией=Движения.демоДемонстрацияОборудования;
	НаборДвиженией.Записывать=Истина;
	НаборДвиженией.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

&Вместо("ОбработкаУдаленияПроведения")
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	НаборЗаписей = РегистрыНакопления.демоДемонстрацияОборудования.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	НаборЗаписей.Записать();
	
КонецПроцедуры

&Вместо("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Фролов+
	Если ОбменДанными.Загрузка Тогда 
		Возврат;
	КонецЕсли;	
	
	//++ #Б7900 смарт: Шляпников 24.08.2026 / Документ "Маркетинговое мероприятие". Форма списка документов. Отбор по полиграфическому оборудованию.
	смартИмеетПолиграфическоеОборудование = смартДокументИмеетПолиграфическоеОборудование();
	//-- #Б7900 смарт: Шляпников 24.08.2026
	
	//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
		И НЕ Пользователи.РолиДоступны("АдминистраторДемоЗала") Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Отмена проведения доступна только администратору демо-зала!", , , , Отказ);
		
	КонецЕсли;	
	
	Если НЕ Отказ 
		И (РежимЗаписи = РежимЗаписиДокумента.Проведение
		   ИЛИ (ЭтотОбъект.Проведен
		   		И НЕ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения)) Тогда

		Если ЭтоНовый() 
			 ИЛИ НЕ ЗначениеЗаполнено(Статус) Тогда
			 
			Статус = Перечисления.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Новая;
			
		КонецЕсли;

		//++ #Б-2562 смарт: Лопато 04.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
		ЗаявкаЗакрыта = Статус = Перечисления.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта;

		Если Статус = Перечисления.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта Тогда
			ДатаЗакрытияЗаявки = ТекущаяДатаСеанса();	
		КонецЕсли;	
		//-- #Б-2562 смарт: Лопато 04.03.2025
		
	ИначеЕсли (ЭтотОбъект.Проведен
		   	   	   И РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения)
			  ИЛИ (НЕ ЭтотОбъект.Проведен
			  	 	   И РежимЗаписи = РежимЗаписиДокумента.Запись) Тогда
			  
		Статус = Неопределено;	  
		
	КонецЕсли;	
	
	ДополнительныеСвойства.Вставить("РежимЗаписи", 		РежимЗаписи);
	ДополнительныеСвойства.Вставить("ПредыдущийСтатус", Ссылка.Статус);
	//-- #Б-1982 смарт: Лопато 13.02.2025
	
	//++ смарт:ММ #011 154 13.12.2019
	ДополнительныеСвойства.Вставить("смартЭтоНовый", ЭтоНовый());
	//-- смарт:ММ 13.12.2019
	
	//++ #Б-1988 смарт: Лопато 21.02.2025 //Заявка на маркетинговое мероприятие. Резерв оборудования. Дополнение. Этап 4.  
	УстановитьПривилегированныйРежим(Истина);

	МассивОписанийДляНапоминаний = Новый Массив;
	
	//++ #Б-1474 смарт: Фролов 05.12.2024 //Доработка функционала Маркетингового мероприятия
	Если НЕ РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		И НЕ (Статус = Перечисления.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Отмена
			  ИЛИ Статус = Перечисления.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта) Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Ссылка КАК Ссылка,
		|	Ссылка.Менеджер КАК Менеджер,
		//++ #Б-2596 смарт: Лопато 10.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
		|	Ссылка.ТипМероприятия КАК ТипМероприятия,
		//-- #Б-2596 смарт: Лопато 10.03.2025
		|	Ссылка.ТипМероприятия.смартРезервироватьОборудование КАК смартРезервироватьОборудование,
		|	Ссылка.смартДатаНачала КАК смартДатаНачала,
		|	Ссылка.смартДатаОкончания КАК смартДатаОкончания,
		|	Оборудование КАК Оборудование
		|ИЗ
		|	Документ.МаркетинговыеМероприятияДокумент.табОборудованиеДляДемонстрации
		|ГДЕ
		|	Оборудование В(&МассивОборудоваания)
		|	И НЕ Ссылка.ПометкаУдаления
		|	И 1 = 1
		|	И Ссылка.Проведен
		|	И НЕ Ссылка.Статус В (ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Закрыта),
		|		  				  ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Отмена))
		|	И ВЫБОР
		|		КОГДА 
		|			ВЫБОР 
		|				КОГДА 
		|					Ссылка.смартДатаНачала = &ДатаНачала И Ссылка.смартДатаОкончания = &ДатаОкончания
		|				ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|			ИЛИ 
		|			ВЫБОР 
		|				КОГДА 
		|					Ссылка.смартДатаНачала < &ДатаНачала И &ДатаНачала < Ссылка.смартДатаОкончания
		|				ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|			ИЛИ 
		|			ВЫБОР
		|				КОГДА Ссылка.смартДатаНачала < &ДатаОкончания И &ДатаОкончания < Ссылка.смартДатаОкончания
		|				ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|			ИЛИ ВЫБОР
		|				КОГДА &ДатаНачала < Ссылка.смартДатаНачала И Ссылка.смартДатаНачала < &ДатаОкончания
		|				ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|			ИЛИ ВЫБОР
		|				КОГДА &ДатаНачала < Ссылка.смартДатаОкончания И Ссылка.смартДатаОкончания < &ДатаОкончания
		|				ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|		ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		//++ #Б-1780 смарт: Фролов 25.12.2024 //Маркетинговое мероприятие с бронью времени не проводится
		|	И Ссылка <> &Ссылка");
		//-- #Б-1781 смарт: Фролов 25.12.2024
		
		МассивОборудоваания = Новый Массив;
		Для Каждого СтртабОборудованиеДляДемонстрации Из табОборудованиеДляДемонстрации Цикл
			
			МассивОборудоваания.Добавить(СтртабОборудованиеДляДемонстрации.Оборудование);	
			
		КонецЦикла;
		
		Если МассивОборудоваания.Количество() > 0 Тогда
			
			Запрос.УстановитьПараметр("МассивОборудоваания", МассивОборудоваания);
			//++ #Б-1780 смарт: Фролов 25.12.2024 //Маркетинговое мероприятие с бронью времени не проводится
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			//-- #Б-1780 смарт: Фролов 25.12.2024
			
			Если НЕ ЗначениеЗаполнено(смартДатаНачала)
				ИЛИ НЕ ЗначениеЗаполнено(смартДатаОкончания) Тогда
					
				ОбщегоНазначения.СообщитьПользователю("Заполните дату начала и дату окончания мероприятия!", , , , Отказ);
				
				Возврат;
				
			КонецЕсли;

			Запрос.УстановитьПараметр("ДатаНачала",    смартДатаНачала);
			Запрос.УстановитьПараметр("ДатаОкончания", смартДатаОкончания);

			Если ТипМероприятия.смартРезервироватьОборудование Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "НЕ Ссылка.ТипМероприятия.смартРезервироватьОборудование");
			КонецЕсли;

			//++ #Б-2596 смарт: Лопато 10.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
			МассивТипыМероприятийБезПроверкиПериодов 
				= Справочники.смартПредопределенныеЗначения.Настройки.ТипыМаркетинговыхМероприятийБезПроверкиПересеченийПериодов.ВыгрузитьКолонку("ТипМероприятия");
				
			ЭтоТипМероприятияБезПроверкиПериодов = ЗначениеЗаполнено(ТипМероприятия) 
					  							   И МассивТипыМероприятийБезПроверкиПериодов.Найти(ТипМероприятия) <> Неопределено;
			//-- #Б-2596 смарт: Лопато 10.03.2025
			
			Результат = Запрос.Выполнить();
		
			Если НЕ Результат.Пустой() Тогда
				
				Выборка = Результат.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					//++ #Б-2596 смарт: Лопато 10.03.2025 //Заявка на маркетинговое мероприятие. Дополнения.  
					НаименованиеОборудования = СокрЛП(Выборка.Оборудование);
					СтрокаОборудования = Лев(НаименованиеОборудования, СтрНайти(НаименованиеОборудования, " / ") - 1);
					
					ПредставлениеЗаявки = СокрЛП(Выборка.Ссылка);
					СтрокаЗаявки = Лев(ПредставлениеЗаявки, СтрДлина(ПредставлениеЗаявки) - 9);
					
					СтрокаОшибки = "На оборудование """ + СтрокаОборудования + """" + Символы.ПС 
								   + "создана заявка " + СтрокаЗаявки 
								   + " на период с " + СокрЛП(Выборка.смартДатаНачала) 
								   + " по " + СокрЛП(Выборка.смартДатаОкончания)
								   + " с типом """ + СокрЛП(Выборка.ТипМероприятия) + """";

					Если ЭтоТипМероприятияБезПроверкиПериодов Тогда
						
						ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
						
						Продолжить;
						
					КонецЕсли;	
					
					//++ #Б-2732 смарт: Лопато 21.03.2025 //Заявка на маркетинговое мероприятие. Дополнения к 2596.  
					ДокументПересеченияБезПроверкиПериодов = ЗначениеЗаполнено(Выборка.ТипМероприятия) 
							  							     И МассивТипыМероприятийБезПроверкиПериодов.Найти(Выборка.ТипМероприятия) <> Неопределено;
															 
					Если ДокументПересеченияБезПроверкиПериодов Тогда
						
						ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
						
						Продолжить;
						
					КонецЕсли;	
					//-- #Б-2732 смарт: Лопато 21.03.2025
					
					Если НЕ ТипМероприятия.смартРезервироватьОборудование Тогда
						
						СтрокаОшибки = СтрокаОшибки + Символы.ПС + "Укажите другую дату мероприятия!";

						ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки, , , , Отказ);	

					//-- #Б-2596 смарт: Лопато 10.03.2025
					Иначе
						
						Если Выборка.смартРезервироватьОборудование Тогда
						
							ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
							
						КонецЕсли;
						
						Описание = "В связи с созданием более важной Заявки на маркетинговое мероприятие необходимо перенести дату Вашего мероприятия"
								   + Символы.ПС + СокрЛП(Выборка.Ссылка) + "." + Символы.ПС  
								   + "В ближайшее время она будет отменена Администратором демозала.";

						МассивОписанийДляНапоминаний.Добавить(Новый Структура("Менеджер, Описание", Выборка.Менеджер, Описание));
						
					КонецЕсли;	
					
				КонецЦикла;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	//-- #Б-1474 смарт: Фролов 05.12.2024
	
	ДополнительныеСвойства.Вставить("МассивОписанийДляНапоминаний", МассивОписанийДляНапоминаний);
	//-- #Б-1988 смарт: Лопато 21.02.2025
	
КонецПроцедуры

