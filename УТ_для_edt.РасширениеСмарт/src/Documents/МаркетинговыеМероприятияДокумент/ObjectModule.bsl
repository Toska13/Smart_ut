&Вместо("ПриКопировании")
Процедура ПриКопировании(ОбъектКопирования)
	
	ТекОбъект = ЭтотОбъект;
	
	ТекОбъект.ДатаНачалаПлан		= Дата(1,1,1,0,0,0);
	ТекОбъект.ВремяНачалаПлан		= Дата(1,1,1,0,0,0);
	ТекОбъект.ЗаявкаЗакрыта			= Ложь;
	ТекОбъект.ДатаЗакрытияЗаявки 	= Дата(1,1,1,0,0,0);
	ТекОбъект.ДатаНачалаФакт 		= Дата(1,1,1,0,0,0);
	ТекОбъект.ВремяПроведенияОт 	= Дата(1,1,1,0,0,0);
	ТекОбъект.ВремяПроведенияДо 	= Дата(1,1,1,0,0,0);
	ТекОбъект.ИсполнительДемоЗал 	= Справочники.Пользователи.ПустаяСсылка();
	ТекОбъект.Оценка 				= 0;
	
	//++ #Б-1982 смарт: Лопато 13.02.2025 //Заявка на маркетинговое мероприятие. Доработка функционала. Этап 1.  
	ТекОбъект.смартДатаНачала 		= Дата(1, 1, 1); 
	ТекОбъект.смартДатаОкончания 	= Дата(1, 1, 1); 
	ТекОбъект.Статус 				= Неопределено;
	ТекОбъект.Комментарий 			= "";
	ТекОбъект.КомментарийИнженера 	= "";
	ТекОбъект.КомуПередано 			= "";
	ТекОбъект.ДатаОценки			= Дата(1, 1, 1);
	ТекОбъект.ПользовательПоставилОценку = Неопределено;
	ТекОбъект.ИсполнителиДемоЗал.Очистить();
	ТекОбъект.ВидыРабот.Очистить();
	ТекОбъект.ОборудованиеДляДемонстрацииИнженер.Очистить();
	ТекОбъект.ИсторияИзмененияОценки.Очистить();
	//-- #Б-1982 смарт: Лопато 13.02.2025
	
КонецПроцедуры

&Вместо("ОбработкаЗаполнения")
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	//++ #4898 смарт: Тимофеева 17.11.2025 / Создание механизма для учета квалификаций инженеров и менеджеров. 	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартОбучениеСотрудников") Тогда 	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	смартОбучениеСотрудников.Ссылка КАК ДокументОснование,
		|	смартОбучениеСотрудников.ДатаНачала КАК смартДатаНачала,
		|	смартОбучениеСотрудников.ДатаОкончания КАК смартДатаОкончания,
		|	смартОбучениеСотрудников.Партнер КАК КлиентПартнер,
		|	&ТипМероприятия КАК ТипМероприятия,
		|	ЗНАЧЕНИЕ(Перечисление.смартСтатусыЗаявокНаМаркетинговоеМероприятие.Новая) КАК Статус,
		|	смартОбучениеСотрудников.МестоПроведения КАК ДемоЗал,
		|	смартОбучениеСотрудников.ОписаниеПрограммы КАК ОписаниеПрограммы
		|ИЗ
		|	Документ.смартОбучениеСотрудников КАК смартОбучениеСотрудников
		|ГДЕ
		|	смартОбучениеСотрудников.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартОбучениеСотрудниковБронируемоеОборудование.Оборудование КАК Оборудование
		|ИЗ
		|	Документ.смартОбучениеСотрудников.БронируемоеОборудование КАК смартОбучениеСотрудниковБронируемоеОборудование
		|ГДЕ
		|	смартОбучениеСотрудниковБронируемоеОборудование.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартОбучениеСотрудниковПредставителиКлиента.КонтактноеЛицо КАК КонтактныеЛица,
		|	смартОбучениеСотрудниковПредставителиКлиента.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.смартОбучениеСотрудников.ПредставителиКлиента КАК смартОбучениеСотрудниковПредставителиКлиента
		|ГДЕ
		|	смартОбучениеСотрудниковПредставителиКлиента.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартОбучениеСотрудниковСотрудники.Сотрудник КАК Сотрудник
		|ИЗ
		|	Документ.смартОбучениеСотрудников.Сотрудники КАК смартОбучениеСотрудниковСотрудники
		|ГДЕ
		|	смартОбучениеСотрудниковСотрудники.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	смартОбучениеСотрудниковПреподаватели.Преподаватель КАК Преподаватель,
		|	ЕСТЬNULL(ФизическиеЛицаПользователей.Ссылка, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК Исполнитель
		|ИЗ
		|	Документ.смартОбучениеСотрудников.Преподаватели КАК смартОбучениеСотрудниковПреподаватели
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛицаПользователей
		|		ПО смартОбучениеСотрудниковПреподаватели.Преподаватель.ФизическоеЛицо = ФизическиеЛицаПользователей.Ссылка
		|ГДЕ
		|	смартОбучениеСотрудниковПреподаватели.Ссылка = &Ссылка"; 
		
		Запрос.УстановитьПараметр("Ссылка", ДанныеЗаполнения);
		Запрос.УстановитьПараметр("ТипМероприятия", Справочники.демоТипыМероприятия.НайтиПоНаименованию("(к) Обучение в демозале", Истина));
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();		
		
		ЭтотОбъект.табОборудованиеДляДемонстрации.Загрузить(РезультатЗапроса[1].Выгрузить());
		ЭтотОбъект.табПредставительКлиента.Загрузить(РезультатЗапроса[2].Выгрузить());
		
		МассивСотрудников	 = РезультатЗапроса[3].Выгрузить().ВыгрузитьКолонку("Сотрудник");
		МассивПреподавателей = РезультатЗапроса[4].Выгрузить().ВыгрузитьКолонку("Преподаватель");
		ЭтотОбъект.ИсполнителиДемоЗал.Загрузить(РезультатЗапроса[4].Выгрузить());
		//ЭтотОбъект.ИсполнителиДемоЗал.ЗагрузитьКолонку(РезультатЗапроса[4].Выгрузить().ВыгрузитьКолонку("Исполнитель"), "Исполнитель");
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса[0].Выбрать(); 	
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЗаполнитьЗначениясвойств(ЭтотОбъект, ВыборкаДетальныеЗаписи);
			ЭтотОбъект.Менеджер 	= Пользователи.АвторизованныйПользователь();
			ЭтотОбъект.Комментарий 	= СтрШаблон("Преподаватели:
												|%1
												|
												|
												|%2
												|
												|
												|Сотрудники проходящие обучение:
												|%3",
												СтрСоединить(МассивПреподавателей, Символы.ПС),
												ВыборкаДетальныеЗаписи.ОписаниеПрограммы,
												СтрСоединить(МассивСотрудников, Символы.ПС));
		КонецЕсли;				
		
	КонецЕсли;
	//-- #4898 смарт: Тимофеева 17.11.2025 
	
КонецПроцедуры

