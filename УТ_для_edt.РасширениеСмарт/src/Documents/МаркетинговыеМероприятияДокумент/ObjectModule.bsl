	//		Движение.Номенклатура = ТекСтрокатабОборудованиеДляДемонстрации.Оборудование.Номенклатура;
	//		Движение.КодСтроки = ТекСтрокатабОборудованиеДляДемонстрации.НомерСтроки;
	//		Движение.Распоряжение = Ссылка;
