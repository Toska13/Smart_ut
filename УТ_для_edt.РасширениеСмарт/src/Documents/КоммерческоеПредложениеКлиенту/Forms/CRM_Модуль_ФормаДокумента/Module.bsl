&НаСервереБезКонтекста
&ИзменениеИКонтроль("КоммерческоеПредложениеКлиентуОбработкаРезультатаПодбораНоменклатуры")
Процедура смарт_КоммерческоеПредложениеКлиентуОбработкаРезультатаПодбораНоменклатуры(Форма, ВыбранноеЗначение, ДополнительныеПараметры, РезультатОбработки)

	ТипОперации = "ПодборНоменклатуры";

	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда

		Если ВыбранноеЗначение.Свойство("РедактированиеНабора") Тогда

			ТипОперации = "РедактированиеНабора";

		ИначеЕсли ВыбранноеЗначение.Свойство("РедактироватьНабор") Тогда 

			ТипОперации = "РедактироватьНабор";

