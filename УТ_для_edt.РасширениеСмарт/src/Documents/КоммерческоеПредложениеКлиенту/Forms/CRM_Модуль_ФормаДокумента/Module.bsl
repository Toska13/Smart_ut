	#Удаление
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	#КонецУдаления
	#Вставка
	//++ #Б2734 смарт: Шляпников 25.03.2025 / Конструктор КП. - Документ "Коммерческое предложение".
