#Область ШаблоныСообщений

// Вызывается при подготовке шаблонов сообщений и позволяет переопределить список реквизитов и вложений.
//
// Параметры:
//  Реквизиты               - ДеревоЗначений - список реквизитов шаблона.
//         ** Имя            - Строка - Уникальное имя общего реквизита.
//         ** Представление  - Строка - Представление общего реквизита.
//         ** Тип            - Тип    - Тип реквизита. По умолчанию строка.
//         ** Формат         - Строка - Формат вывода значения для чисел, дат, строк и булевых значений.
//  Вложения                - ТаблицаЗначений - печатные формы и вложения
//         ** Имя            - Строка - Уникальное имя вложения.
//         ** Представление  - Строка - Представление варианта.
//         ** ТипФайла       - Строка - Тип вложения, который соответствует расширению файла: "pdf", "png", "jpg", mxl"
//                                      и др.
//  ДополнительныеПараметры - Структура - дополнительные сведения о шаблоне сообщений.
//
Процедура ПриПодготовкеШаблонаСообщения(Реквизиты, Вложения, ДополнительныеПараметры) Экспорт
	
	//++ #Б7250 смарт: реквизиты строк ТЧ Товары для шаблона ({Повтор.Товары} / [Товары.*])
	ДобавитьРеквизитыСтрокТоваровВШаблонСообщения(Реквизиты);
	//-- #Б7250
	
КонецПроцедуры

// Добавляет в дерево параметров шаблона узел "Товары" с полями строк ТЧ.
// Листья именуются "Товары.Цена" и т.п. — как в тексте шаблона.
// Узел кладётся в коллекцию реквизитов документа: БСП дописывает префикс
// только прямым детям, поэтому имена листьев "Товары.*" не меняются.
//
Процедура ДобавитьРеквизитыСтрокТоваровВШаблонСообщения(Реквизиты) Экспорт
	
	УзелТовары = Реквизиты.Найти("Товары", "Имя", Ложь);
	Если УзелТовары = Неопределено Тогда
		УзелТовары = Реквизиты.Найти("УстановкаЦенНоменклатуры.Товары", "Имя", Ложь);
	КонецЕсли;
	
	Если УзелТовары = Неопределено Тогда
		
		УзелТовары = Реквизиты.Добавить();
		УзелТовары.Имя = "Товары";
		УзелТовары.Представление = НСтр("ru = 'Товары'");
		УзелТовары.ПолноеПредставление = НСтр("ru = 'Товары'");
		
	КонецЕсли;
	
	ОписаниеЧисло = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(15, 2));
	ОписаниеБулево = Новый ОписаниеТипов("Булево");
	ОписаниеДата = Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя));
	
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "НомерСтроки",
		НСтр("ru = 'Номер строки'"), Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Номенклатура",
		НСтр("ru = 'Номенклатура'"), Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Характеристика",
		НСтр("ru = 'Характеристика'"),
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Упаковка",
		НСтр("ru = 'Упаковка'"), Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "ВидЦены",
		НСтр("ru = 'Вид цены'"), Новый ОписаниеТипов("СправочникСсылка.ВидыЦен"));
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Цена",
		НСтр("ru = 'Цена'"), ОписаниеЧисло);
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "СтараяЦена",
		НСтр("ru = 'Старая цена'"), ОписаниеЧисло);
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "ЦенаИзмененаВручную",
		НСтр("ru = 'Цена изменена вручную'"), ОписаниеБулево);
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Дата",
		НСтр("ru = 'Дата'"), ОписаниеДата);
	ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, "Период",
		НСтр("ru = 'Период'"), ОписаниеДата);
	
КонецПроцедуры

Процедура ДобавитьРеквизитСтрокиТоваровШаблона(УзелТовары, ИмяПоля, Представление, ТипЗначения)
	
	ПолноеИмя = "Товары." + ИмяПоля;
	
	Если УзелТовары.Строки.Найти(ПолноеИмя, "Имя", Ложь) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = УзелТовары.Строки.Добавить();
	НоваяСтрока.Имя = ПолноеИмя;
	НоваяСтрока.Представление = Представление;
	НоваяСтрока.ПолноеПредставление = НСтр("ru = 'Товары'") + "." + Представление;
	НоваяСтрока.Тип = ТипЗначения;
	
КонецПроцедуры

// Вызывается в момент создания сообщений по шаблону для заполнения значений реквизитов и вложений.
//
