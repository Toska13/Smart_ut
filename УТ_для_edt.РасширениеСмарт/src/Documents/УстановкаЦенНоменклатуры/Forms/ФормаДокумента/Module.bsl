#Область ОбработчикиСобытийФормы

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	УстановитьУсловноеОформление();

	ФлагОткрытияФормы = Истина;
	КодФормы = "УстановкаЦенНоменклатуры";

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НомерВПределахДня = Объект.Дата - НачалоДня(Объект.Дата) + 1;
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Дата) Тогда
		НомерВПределахДня = УстановкаЦенВызовСервера.РассчитатьНомерВПределахДня(ТекущаяДатаСеанса(), Объект.Ссылка);
		Объект.Дата = УстановкаЦенКлиентСервер.РассчитатьДатуДокумента(ТекущаяДатаСеанса(), НомерВПределахДня);
	Иначе
		НомерВПределахДня = УстановкаЦенВызовСервера.РассчитатьНомерВПределахДня(Объект.Дата, Объект.Ссылка);
		Объект.Дата = УстановкаЦенКлиентСервер.РассчитатьДатуДокумента(Объект.Дата, НомерВПределахДня);
	КонецЕсли;
	ТекущаяДата = ТекущаяДатаСеанса();

	Элементы.НомерВПределахДня.Видимость = НомерВПределахДня <> 1;

	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);


	ИспользоватьЦеновыеГруппы              = ПолучитьФункциональнуюОпцию("ИспользоватьЦеновыеГруппы");
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ИспользоватьУпаковкиНоменклатуры       = Истина;
	ИспользоватьНесколькоВидовЦен          = ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоВидовЦен");

	ОбщегоНазначенияУТ.НастроитьПодключаемоеОборудование(ЭтаФорма);
	ПравоРегистрацииШтрихкодовНоменклатурыДоступно = ШтрихкодированиеНоменклатурыСервер.ПравоРегистрацииШтрихкодовНоменклатурыДоступно();

	УстановкаЦенСервер.ИнициализироватьВыбранныеЦены(ЭтаФорма);

	ОтображатьВлияющиеЦены = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("УстановкаЦенНоменклатуры","УстановкаЦенНоменклатурыОтображатьВлияющиеЦены");

	ДанныеДляРасчетаВычисляемыхЦенНаКлиенте = ЗаполнитьДокумент();
	Если ДанныеДляРасчетаВычисляемыхЦенНаКлиенте <> Неопределено Тогда
		АдресХранилищаДанныхДляРасчетаВычисляемыхЦенНаКлиенте = ПоместитьВоВременноеХранилище(
		ДанныеДляРасчетаВычисляемыхЦенНаКлиенте,
		УникальныйИдентификатор);
	КонецЕсли;

	УстановитьРассчитыватьАвтоматически(Истина);
	УстановитьЗаполнятьАвтоматическиЦеныХарактеристикПоНоменклатуре(Истина);
	УстановитьАвтоматическиДобавлятьХарактеристики(Истина);
	ЗафиксироватьКолонкуНоменклатура(Истина);

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		УстановитьДоступностьЭлементовПоСтатусуСервер();
	КонецЕсли;

	СохраненныеНастройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Документ.УстановкаЦенНоменклатуры", "Документ.УстановкаЦенНоменклатуры");
	Если СохраненныеНастройки <> Неопределено Тогда
		ПоказыватьПроцентНаценки   = СохраненныеНастройки.ПоказыватьПроцентНаценки;
		ПоказыватьИзменениеЦены    = СохраненныеНастройки.ПоказыватьИзменениеЦены;
		ПоказыватьДействующиеЦены  = СохраненныеНастройки.ПоказыватьДействующиеЦены;
	КонецЕсли;

	УстановитьВидимостьКолонокРедактирования(ЭтотОбъект, Истина);

	УстановитьСостояние();

	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Элементы.Основание.Видимость = Ложь;
	КонецЕсли;

	Если ВыбранныеЦены.Количество() = 1 Тогда
		Элементы.ВидыЦенКомандаДалее.Видимость = Ложь;
		Элементы.ВидыЦенКомандаНазад.Видимость = Ложь;
		Элементы.ГруппаВидыЦен.Видимость       = Ложь;
	КонецЕсли;

	ИмяДополнительнойКолонки = ФормированиеПечатныхФорм.ИмяДополнительнойКолонки();
	УстановитьДоступностьКомандБуфераОбмена();

	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ИнтеграцияС1СДокументооборотом

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	Элементы.ДеревоЦенИзменитьЦены.Видимость = ПравоДоступа("Изменение",Метаданные.Документы.УстановкаЦенНоменклатуры);

	#Вставка
	//++ #Б7250 смарт: Шляпников 06.07.2026 / Цены и акции. Уведомления об изменении.
	смартФормированиеИнтерфейса.СоздатьКоманду(ЭтаФорма, "смартРедактироватьШаблон", "Редактировать шаблон сообщения", "смартРедактироватьШаблон");
	смартФормированиеИнтерфейса.СоздатьКоманду(ЭтаФорма, "смартСформироватьУведомление", "Сформировать уведомление", "смартСформироватьУведомление");
	
	Свойства = Новый Структура("Вид,Заголовок", ВидГруппыФормы.Подменю, "Уведомления");
	смартФормированиеИнтерфейса.СздГруппа(ЭтаФорма, "смартПодменюУведомления", "ФормаКоманднаяПанель", Свойства);
	
	смартФормированиеИнтерфейса.СздКнопка(ЭтаФорма, "смартРедактироватьШаблон", "смартПодменюУведомления",, "смартРедактироватьШаблон", 2);
	смартФормированиеИнтерфейса.СздКнопка(ЭтаФорма, "смартСформироватьУведомление", "смартПодменюУведомления",, "смартСформироватьУведомление", 2);
	//-- #Б7250 смарт: Шляпников 06.07.2026
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормыИКоманды

&НаКлиенте
Процедура смартРедактироватьШаблон(Команда)
	
	ПараметрыШаблона = ПолучитьПараметрыШаблона();
	
	Если НЕ ПараметрыШаблона = Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(ПараметрыШаблона.Шаблон) Тогда
			
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("Основание", ПараметрыШаблона);
			ПараметрыФормы.Вставить("ПолноеИмяТипаОснования", "Документ.УстановкаЦенНоменклатуры");

			ОткрытьФорму("Справочник.ШаблоныСообщений.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, Новый ОписаниеОповещения("смартРедактироватьШаблонЗавершение", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		Иначе
			ПоказатьЗначение(, ПараметрыШаблона.Шаблон);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура смартРедактироватьШаблонЗавершение(Значение, ДопПараметры) Экспорт
	
КонецПроцедуры

&НаКлиенте
Процедура смартСформироватьУведомление(Команда)
	
	// Находим шаблон программно (можно жестко задать имя или искать)
	ШаблонСсылка = ПолучитьШаблонДляПисьма();
	
	Если ШаблонСсылка = Неопределено Тогда
		Сообщить(НСтр("ru = 'Шаблон ""Шаблон для заказа клиента"" не найден.'"));
		Возврат;
	КонецЕсли;
	
	// Формируем структуру параметров письма на сервере
	ПараметрыФормы = ПодготовитьПараметрыПисьмаПоШаблонуНаСервере(
		ШаблонСсылка, 
		Объект.Ссылка);
	
	// Открываем форму письма без записи в базу
	// Последний параметр Истина - создать новый объект, не записывать
	ОткрытьФорму(
		"Документ.ЭлектронноеПисьмоИсходящее.ФормаОбъекта", 
		ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция ПолучитьПараметрыШаблона()
	
	// Получаем описание структуры параметров шаблона
	ПараметрыШаблона = ШаблоныСообщений.ОписаниеПараметровШаблона();
	
	ПараметрыШаблона.Вставить("Шаблон", ПолучитьШаблонДляПисьма());
	
	// Заполняем параметры шаблона
	ПараметрыШаблона.Вставить("Наименование", "Шаблон для УстановкаЦенНоменклатуры");
	ПараметрыШаблона.Вставить("ПолноеИмяТипаНазначения", "Документ.УстановкаЦенНоменклатуры");
	ПараметрыШаблона.Вставить("Назначение", "Установка цен номенклатуры");
	ПараметрыШаблона.Вставить("ТипШаблона", "Письмо");
	ПараметрыШаблона.Вставить("Тема", "Изменение цены %Номер% от %Дата%");
	ПараметрыШаблона.Вставить("Текст", "Внимание, с %Дата% снижена/увеличена цена ");
	ПараметрыШаблона.Вставить("ФорматПисьма", Перечисления.СпособыРедактированияЭлектронныхПисем.HTML);
	ПараметрыШаблона.Вставить("ПредназначенДляВводаНаОсновании", Истина);
	ПараметрыШаблона.Вставить("ПредназначенДляЭлектронныхПисем", Истина);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыШаблона.Шаблон) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		НастройкиОбъект = Справочники.смартПредопределенныеЗначения.Настройки.ПолучитьОбъект();
		Попытка
			НастройкиОбъект.Заблокировать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю("Не удалось заблокировать настройки !", Объект.Ссылка);
			Возврат Неопределено;
		КонецПопытки;
		
		ШаблонСсылка = ШаблоныСообщений.СоздатьШаблон("Шаблон для УстановкаЦенНоменклатуры", ПараметрыШаблона);
		ПараметрыШаблона.Вставить("Шаблон", ШаблонСсылка);
		
		НастройкиОбъект.ШаблонСообщенияУстановкаЦенНоменклатуры = ШаблонСсылка;
		НастройкиОбъект.Записать();
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецЕсли;

	Возврат ПараметрыШаблона;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьШаблонДляПисьма()
	
	Возврат смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("ШаблонСообщенияУстановкаЦенНоменклатуры");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПодготовитьПараметрыПисьмаПоШаблонуНаСервере(ШаблонСсылка, Предмет) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Основание", Предмет);
	
	// Формируем сообщение по шаблону
	Сообщение = ШаблоныСообщений.СформироватьСообщение(
		ШаблонСсылка, 
		Предмет, 
		Новый УникальныйИдентификатор);
	
	// Заполняем параметры формы из сообщения
	Если Сообщение.Свойство("Тема") И ЗначениеЗаполнено(Сообщение.Тема) Тогда
		ПараметрыФормы.Вставить("Тема", Сообщение.Тема);
	КонецЕсли;
	
	// Обработка текста (может быть структурой или строкой)
	Если Сообщение.Свойство("Текст") И ЗначениеЗаполнено(Сообщение.Текст) Тогда
		ПараметрыФормы.Вставить("Текст", Сообщение.Текст);
	КонецЕсли;
	
	Если Сообщение.Свойство("Получатель") И ЗначениеЗаполнено(Сообщение.Получатель) Тогда
		ПараметрыФормы.Вставить("Получатель", Сообщение.Получатель);
	КонецЕсли;
	
	// Обработка вложений через временное хранилище
	Если Сообщение.Свойство("Вложения") И ТипЗнч(Сообщение.Вложения) = Тип("ТаблицаЗначений") И Сообщение.Вложения.Количество() > 0 Тогда
		АдресВХ = ПоместитьВоВременноеХранилище(Сообщение.Вложения, Новый УникальныйИдентификатор);
		ПараметрыФормы.Вставить("АдресВложений", АдресВХ);
	КонецЕсли;
	
	// Передаем параметры для заполнения письма
	ПараметрыФормы.Вставить("ЗаполнениеПоШаблону", Истина);
	ПараметрыФормы.Вставить("ШаблонСообщения", ШаблонСсылка);
	
	Возврат ПараметрыФормы;
	
КонецФункции

#КонецОбласти