			ДатаВремя = ДатаВремя + " " + Формат(смартЖелаемоеВремяОтгрузки, "ДФ=HH:mm");	
		КонецЕсли;
		
		//++ смарт:ММ 572 18.08.2021
		Если ЭтоПервый Тогда
		//-- смарт:ММ 18.08.2021

		ОбластьШапка.Параметры.ДатаОтгрузки = Формат(Выборка.ЖелаемаяДатаОтгрузки, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.ДеньНедели 	= ВРег(Сред(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"),1,1)) + Сред(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"),2,СтрДлина(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"))+1);
