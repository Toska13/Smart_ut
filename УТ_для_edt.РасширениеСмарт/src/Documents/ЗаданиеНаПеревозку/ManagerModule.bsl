Функция смартСформироватьТабличныйДокументТранспортнаяНакладная(ЗаказКлиента, ЗаданиеНаПеревозку, Реализация) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ТРАНСПОРТНАЯ_НАКЛАДНАЯ";
	
	Если ТипЗнч(Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда //++rnp 20.08.2021
		ДанныеДляПечати = смартПолучитьДанныеДляПечатнойФормыТранспортнаяНакладная(ЗаказКлиента, ЗаданиеНаПеревозку, Реализация);
	//++rnp 20.08.2021	
	ИначеЕсли ТипЗнч(Реализация) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ДанныеДляПечати = смартПолучитьДанныеДляПечатнойФормыТранспортнаяНакладнаяПоЗаказуНаПеремещение(ЗаказКлиента, ЗаданиеНаПеревозку, Реализация);
	КонецЕсли;
	//--rnp 20.08.2021
	ОбъектыПечати = Новый СписокЗначений;
	КомплектыПечати = Неопределено;
	
	Обработки.ПечатьТранспортнойНакладной.ЗаполнитьТабличныйДокументТН(
			ТабДок,
			ДанныеДляПечати,
			ОбъектыПечати,
			КомплектыПечати, Истина);
	
	Возврат ТабДок;
	
КонецФункции //-- смарт:ММ 07.08.2021

//++ смарт:ММ 572 07.08.2021
Функция смартПолучитьДанныеДляПечатнойФормыТранспортнаяНакладная(ЗаказКлиента, ЗаданиеНаПеревозку, Реализация)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказКлиентаСсылка.Ссылка КАК Ссылка,
	//++ смарт:ММ 572 26.08.2021
	|	ЗаказКлиентаСсылка.Номер КАК ЗаказКлиентаНомер,
	|	ЗаказКлиентаСсылка.Дата КАК ЗаказКлиентаДата,
	//-- смарт:ММ 26.08.2021
	|	Реализация.Номер КАК Номер,
	// ++ 11.08.2021
	//|	Реализация.Дата КАК Дата,
	|	ЗаданиеНаПеревозкуСсылка.ДатаВремяРейсаПланС КАК Дата,
	// --
	|	ЗаказКлиентаСсылка.Организация КАК Организация,
	|	ВЫБОР 
	|		КОГДА ЗаказКлиентаСсылка.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) 
	|			ТОГДА ЗаказКлиентаСсылка.Грузополучатель
	|       ИНАЧЕ ЗаказКлиентаСсылка.Контрагент 
	|   КОНЕЦ КАК Грузополучатель,
	|	ВЫБОР 
	|		КОГДА ЗаказКлиентаСсылка.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) 
	|			ТОГДА ЗаказКлиентаСсылка.Грузоотправитель
	|       ИНАЧЕ ЗаказКлиентаСсылка.Организация
	|   КОНЕЦ КАК Грузоотправитель,	
	|	ЗаказКлиентаСсылка.Контрагент КАК ЗаказчикПеревозки,
	|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя КАК БанковскийСчетЗаказчикаПеревозки,
	|	"""" КАК Кладовщик,
	|	"""" КАК ДолжностьКладовщика,
	|	ЗаказКлиентаСсылка.Контрагент КАК Плательщик,
	|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя КАК БанковскийСчетПлательщика,
	// ++ 11.08.2021
	//|	ЗаданиеНаПеревозкуСсылка.Перевозчик КАК Перевозчик,
	|	"""" КАК Перевозчик,
	// --
	|	ЗаданиеНаПеревозкуСсылка.Водитель КАК Водитель,
	|	ЗаданиеНаПеревозкуСсылка.ВидПеревозки КАК ВидПеревозки,
	|	ЗаданиеНаПеревозкуСсылка.АвтомобильМарка КАК МаркаАвтомобиля,
	|	ЗаданиеНаПеревозкуСсылка.АвтомобильГосударственныйНомер КАК ГосНомерАвтомобиля,
	|	ЕСТЬNULL(СкладыКонтактнаяОтправитель.Представление, """") КАК ПунктПогрузки,
	|	ЗаказКлиентаСсылка.АдресДоставки КАК ПунктРазгрузки,
	|	неопределено КАК СрокДоставки,	
	|	ЗаданиеНаПеревозкуСсылка.АвтомобильГрузоподъемностьВТоннах КАК ГрузоподъемностьВТоннахАвтомобиля,
	|	ЗаданиеНаПеревозкуСсылка.АвтомобильВместимостьВКубическихМетрах КАК ВместимостьВКубическихМетрахАвтомобиля,
	|	ЗаданиеНаПеревозкуСсылка.АвтомобильТип КАК ТипАвтомобиля,
	|	0 КАК МассаБрутто,
	|	1 КАК ПорядковыйНомер,
	|	ложь КАК ЕстьНепроведенныеДокументыОснования
	//++ смарт:ММ 698 03.11.2021
	|	, НЕОПРЕДЕЛЕНО КАК СкладПолучатель,
	|	ЗаданиеНаПеревозкуРаспоряжения.Склад КАК СкладОтправитель
	//-- смарт:ММ 03.11.2021
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиентаСсылка
	|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаПеревозку КАК ЗаданиеНаПеревозкуСсылка
	|        	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаПеревозку.Маршрут КАК ЗаданиеНаПеревозкуМаршрут
	|        		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
	|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Склады.КонтактнаяИнформация КАК СкладыКонтактнаяОтправитель
	|					ПО ЗаданиеНаПеревозкуРаспоряжения.Склад = СкладыКонтактнаяОтправитель.Ссылка
	|					И (СкладыКонтактнаяОтправитель.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.АдресСклада))
	|				ПО ЗаданиеНаПеревозкуРаспоряжения.Ссылка = ЗаданиеНаПеревозкуМаршрут.Ссылка
	|				И ЗаданиеНаПеревозкуРаспоряжения.КлючСвязи = ЗаданиеНаПеревозкуМаршрут.КлючСвязи
	|				И ЗаданиеНаПеревозкуРаспоряжения.Распоряжение = &ЗаказКлиента
	|			ПО ЗаданиеНаПеревозкуСсылка.Ссылка = ЗаданиеНаПеревозкуМаршрут.Ссылка
	|		ПО ИСТИНА
	|		ПОЛНОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализация
	|		ПО ИСТИНА
	|ГДЕ
	|	ЗаказКлиентаСсылка.Ссылка = &ЗаказКлиента
	|   И ЗаданиеНаПеревозкуСсылка.Ссылка = &ЗаданиеНаПеревозку
	|   И Реализация.Ссылка = &Реализация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&ЗаказКлиента КАК Ссылка,
	|	1 КАК ПорядковыйНомер,
	|	&НаименованиеДляПечатиВидовНоменклатуры КАК НаименованиеВидаНоменклатуры";
	
	Запрос.УстановитьПараметр("Реализация", 	Реализация);
	Запрос.УстановитьПараметр("ЗаказКлиента", 	ЗаказКлиента);
	Запрос.УстановитьПараметр("ЗаданиеНаПеревозку", ЗаданиеНаПеревозку);
	Запрос.УстановитьПараметр("НаименованиеДляПечатиВидовНоменклатуры", Константы.НаименованиеДляПечатиВидовНоменклатуры.Получить());

	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ТаблицаРезультата", РезультатЗапроса[0].Выгрузить());
	СтруктураРезультата.Вставить("РезультатИменаТоваров", РезультатЗапроса[1]);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураРезультата

КонецФункции //-- смарт:ММ 07.08.2021

