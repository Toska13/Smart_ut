&НаСервере
Процедура ЗаполнитьРаспоряжения() 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задание", Задание);
	
	Запрос.УстановитьПараметр("НаименованиеСклада", СтрШаблон("%%%1%%", ВидСкладаПриФормированииПакета));
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Задания.Распоряжение КАК Распоряжение,
	|	Задания.Склад КАК Склад,
	|	ЛОЖЬ КАК РТиУ,
	|	ЛОЖЬ КАК БП
	|ИЗ
	|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК Задания
	|ГДЕ
	|	Задания.Ссылка = &Задание
	|	И Задания.Склад В (&Склады)";
	
	Если ВидСкладаПриФормированииПакета = "Адмирал" Тогда
		Запрос.УстановитьПараметр("Склады", ПолучитьСкладыАдмирал());
	Иначе
		Запрос.УстановитьПараметр("Склады", ПолучитьСкладыАтлант());
	КонецЕсли;
	
	Распоряжения.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере  
Процедура ПолучитьРезультатФормированияПакетаПФИзБП()  
	
	ТаблицаДляБП = ДанныеДляБП.Выгрузить();
	ТаблицаДляБП.Свернуть("Организация, Номер, Дата");
	
	ТаблицаОрганизаций = ТаблицаДляБП.Скопировать();
	ТаблицаОрганизаций.Свернуть("Организация");
	
	Для Каждого СтрокаОрганизаций Из ТаблицаОрганизаций Цикл 
		
		ВходящиеДанные = Новый ТаблицаЗначений;
		ВходящиеДанные.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(11)));
		ВходящиеДанные.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата",,,,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));  
		
		Для Каждого СтрокаДанных Из ТаблицаДляБП Цикл
		
			Если СтрокаОрганизаций.Организация = СтрокаДанных.Организация Тогда
				
				СтрокаТаблицы = ВходящиеДанные.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаДанных);  
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Организация", СтрокаОрганизаций.Организация);
		СтруктураПараметров.Вставить("ВходящиеДанные", ВходящиеДанные);
		
		Результат = смартОбщегоНазначения.СостоянияСохраненияПечатныхФормРеализацийВБП(СтруктураПараметров);
		
		Если ТипЗнч(Результат) = Тип("Строка") Тогда
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Результат;
			Сообщение.Сообщить();
			
		Иначе
			
			Для Каждого СтрокаРезультата Из Результат Цикл
				
				СтрокаТаблицы = РезультатАнализа.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаРезультата);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСкладыАдмирал()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	Склады.Наименование ПОДОБНО ""%Адмирал%""";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

&НаСервере
Функция ПолучитьСкладыАтлант()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.смартНастройкаОбменомСАтлант = ЗНАЧЕНИЕ(ПланОбмена.смартОбменСоСкладомАтлант.ПустаяСсылка)";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции



#КонецОбласти
