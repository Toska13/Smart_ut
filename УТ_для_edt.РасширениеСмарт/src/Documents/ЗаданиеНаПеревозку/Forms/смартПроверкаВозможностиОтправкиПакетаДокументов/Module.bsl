#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	Элементы.КартинкаХорошо.Видимость = Ложь;
	Элементы.КартинкаПлохо.Видимость = Ложь;
	ТекстРезультатаПроверки = "Не проверено";
	
	Если Параметры.Свойство("ВидСкладаПриФормированииПакета") Тогда
		ВидСкладаПриФормированииПакета = Параметры.ВидСкладаПриФормированииПакета;
	КонецЕсли;
		
	Если Параметры.Свойство("Задание") Тогда
		
		Задание = Параметры.Задание;
		
		ЗаполнитьРаспоряжения();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыИСобытия

&НаКлиенте
Процедура ПроверитьГотовностьДокументов(Команда) 
	
	ПроверитьГотовностьДокументовНаСервере(); 
	
КонецПроцедуры  

&НаКлиенте
Процедура СформироватьдокументыУТИОтправить(Команда) 
	
	Закрыть(Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура РаспоряженияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Распоряжения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Распоряжение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Процедура ПроверитьГотовностьДокументовНаСервере()
	
	ДанныеДляБП.Очистить(); 
	ДанныеДляУТ.Очистить(); 
	РезультатАнализа.Очистить();
	
	ЕстьОтклонения = Ложь;
	
	Для Каждого СтрокаРаспоряжений Из Распоряжения Цикл  
		
		СтрокаРаспоряжений.СписокРеализаций.Очистить();
		
		Если НЕ ТипЗнч(СтрокаРаспоряжений.Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРаспоряжений.РТиУ = ЕстьРеализация(СтрокаРаспоряжений); 
		
	КонецЦикла;
	
	ПолучитьРезультатФормированияПакетаПФИзБП();  
	ПолучитьРезультатФормированияПакетаПФИзУТ();  
		
	Для Каждого СтрокаРаспоряжений Из Распоряжения Цикл 
		
		Если НЕ ТипЗнч(СтрокаРаспоряжений.Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ СтрокаРаспоряжений.РТиУ Тогда
			СтрокаРаспоряжений.БП = Ложь; 
		Иначе
			СтрокаРаспоряжений.БП = ЕстьКаталог(СтрокаРаспоряжений); 
		КонецЕсли;
		
		Если НЕ СтрокаРаспоряжений.РТиУ ИЛИ НЕ СтрокаРаспоряжений.БП Тогда
			ЕстьОтклонения = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьОтклонения Тогда
		
		ТекстРезультатаПроверки = "Бухгалтерия не оформила полный комплект документов!";
		Элементы.КартинкаХорошо.Видимость = Ложь;
		Элементы.КартинкаПлохо.Видимость = Истина;
		
	Иначе  
		
		ТекстРезультатаПроверки = "Задание готово к формированию пакета";  
		Элементы.КартинкаХорошо.Видимость = Истина;
		Элементы.КартинкаПлохо.Видимость = Ложь;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьРеализация(ДанныеСтроки)   
	
	Склад = ДанныеСтроки.Склад;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("ЗаказКлиента", ДанныеСтроки.Распоряжение);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Реализация.Ссылка КАК Документ,
	|	Реализация.Организация КАК Организация,
	|	Реализация.Номер КАК Номер,
	|	Реализация.Дата КАК Дата
	|ИЗ
	|	РегистрНакопления.ЗаказыКлиентов.Обороты(, , Регистратор, ЗаказКлиента = &ЗаказКлиента) КАК Заказы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализация
	|		ПО Заказы.Регистратор = Реализация.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТовары
	|		ПО Заказы.Регистратор = РеализацияТовары.Ссылка
	|ГДЕ
	|	(Реализация.Склад = &Склад
	|			ИЛИ РеализацияТовары.Склад = &Склад)";
	
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Если Выборка.Количество() = 0 Тогда                        
		
		Возврат Ложь;
		
	Иначе   
		
		Если ЗначениеЗаполнено(Склад) И Склад.смартАвтоматическиФормироватьДокументы Тогда
			
			Пока Выборка.Следующий() Цикл  
				
				ДанныеСтроки.СписокРеализаций.Добавить(Выборка.Документ); 
				
				Если Склад.смартФормироватьДокументыУТБП = Перечисления.смартФормироватьДокументыУТБП.БП Тогда  
					
					СтрокаТаблицы = ДанныеДляБП.Добавить(); 
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
					
				ИначеЕсли Склад.смартФормироватьДокументыУТБП = Перечисления.смартФормироватьДокументыУТБП.УТ Тогда  
					
					СтрокаТаблицы = ДанныеДляУТ.Добавить(); 
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЕстьКаталог(ДанныеСтроки)  
	
	Для Каждого Реализация Из ДанныеСтроки.СписокРеализаций Цикл
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Номер", Реализация.Значение.Номер);
		СтруктураПоиска.Вставить("Дата", Реализация.Значение.Дата);
		
		НайденныеСтроки = РезультатАнализа.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат Ложь;  
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

