//-- #1353 смарт: Фролов 17.05.2023
	
    МассДокументов=Новый СписокЗначений;    
    
    //++ смарт:Подкин #1136 24.08.2022 12:25:32
    Соответств=Новый Соответствие;
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	ТоварыКОтгрузкеОстаткиИОбороты.Склад КАК Склад,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Получатель КАК Получатель,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Регистратор.Дата КАК РегистраторДата,
    |	ТоварыКОтгрузкеОстаткиИОбороты.ДокументОтгрузки КАК ДокументОтгрузки,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Номенклатура КАК Номенклатура,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Характеристика КАК Характеристика,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Серия КАК Серия,
    |	ТоварыКОтгрузкеОстаткиИОбороты.Регистратор КАК Регистратор,
    |	ТоварыКОтгрузкеОстаткиИОбороты.КОтгрузкеРасход КАК Расход,
    |	ТоварыКОтгрузкеОстаткиИОбороты.КОформлениюРасход КАК Приход
    |ИЗ
    |	РегистрНакопления.ТоварыКОтгрузке.ОстаткиИОбороты(
    |			,
