&НаКлиенте
Процедура СформироватьПакетДалееАтлант(МассивЗаказовКлиентов, СписокДокументовРеализации = Неопределено, СкладАтлант)
	
	МассивСтруктур = Новый Массив; // Для вложений в письмо (уведомления и все файлы из подпапок, в т.ч. те, которые были сформированы ранее из БП)
	РеквизитыСклада = ЗначенияРеквизитовОбъекта(СкладАтлант, "смартАвтоматическиФормироватьДокументы,смартКаталогСклада,смартАвтоматическиФормироватьДокументы,смартФормироватьДокументыУТБП");
	МассивДокументов = Новый Массив;
	Для каждого стрЗаказ Из МассивЗаказовКлиентов Цикл
		Если ТипЗнч(стрЗаказ) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
			МассивДокументов.Добавить(стрЗаказ);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого стрРеализация Из СписокДокументовРеализации Цикл
		МассивДокументов.Добавить(стрРеализация.Значение);
	КонецЦикла;
	
	Успех = Истина;
	
	Для каждого Документ Из МассивДокументов Цикл
		
		ИмяФайлаУведомления = "";
		ТабДокУведомление = смартСформироватьУведомлениеОбОтгрузкеАтлант(Документ
																			,
																			Объект.Ссылка,
																			ИмяФайлаУведомления,
																			"xls",
																			СкладАтлант);
																				
		Если РеквизитыСклада.смартАвтоматическиФормироватьДокументы Тогда
		    КаталогСкладаАтлант = РеквизитыСклада.смартКаталогСклада;
		КонецЕсли;
	    
		ПолноеИмяФайлаУведомления = КаталогСкладаАтлант + "\Заявки на отгрузку по доставкам\" + ИмяФайлаУведомления;
	
		Попытка
		
			ТабДокУведомление.Записать(ПолноеИмяФайлаУведомления, ТипФайлаТабличногоДокумента.XLS);
			ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаУведомления);
			
			АдресХранилищаУведомления = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаУведомления), Новый УникальныйИдентификатор);
		
			ТекСтруктура = Новый Структура;
			ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаУведомления);
			ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаУведомления);
			МассивСтруктур.Добавить(ТекСтруктура);
			
			ИмяФайлаXML = "ПакетДанныхПоЗаявкамНаОтгрузку " + Объект.АвтомобильМарка + " " + Объект.АвтомобильГосударственныйНомер + " " + Формат(Объект.Дата, "ДЛФ=Д") + ".XML"; 
			КаталогXMLПоЗаявкамНаОтгрузку = КаталогСкладаАтлант + "\Заявки на отгрузку по доставкам\";
			
			УспехЗаписи = СформироватьXMLПоЗаявкаНаОтгрузкуАтлант(Документ, Объект.Ссылка, КаталогXMLПоЗаявкамНаОтгрузку, ИмяФайлаXML);
			ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку = КаталогXMLПоЗаявкамНаОтгрузку + ИмяФайлаXML;
			Если УспехЗаписи Тогда
				АдресХранилищаXMLЗаявкаНаМашину = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку), Новый УникальныйИдентификатор);
					
				ТекСтруктура = Новый Структура;
				ТекСтруктура.Вставить("ИмяФайла", ИмяФайлаXML);
				ТекСтруктура.Вставить("АдресХранилища", АдресХранилищаXMLЗаявкаНаМашину);
				МассивСтруктур.Добавить(ТекСтруктура);
				ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаXMLПоЗаявкамНаОтгрузку);
				
				ОтправитьЗаявкуВАтлантСервер(Документ, СкладАтлант, ИмяФайлаXML, АдресХранилищаXMLЗаявкаНаМашину);

			Иначе
				ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон("Не удалось сформировать Пакет XML по документу %1", Документ));
			КонецЕсли;
			
		Исключение
			
			Успех = Ложь;
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось сохранить Уведомление об отгрузке:" + Символы.ПС + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
	Если НЕ Успех Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ЗаказКлиента Из МассивЗаказовКлиентов Цикл 
		
        Реализации = Новый Массив;
        Реализации = смартПолучитьПеремещенияПоЗаказуКлиента(ЗаказКлиента);
        Для каждого Стр Из СписокДокументовРеализации Цикл
            ЕстьЗаказ = ПроверитьЗаказНаСервере(ЗаказКлиента, Стр.Значение);
            Если ЕстьЗаказ Тогда
                Реализации.Добавить(Стр.Значение);
            КонецЕсли; 
        КонецЦикла; 
        
        Для каждого Реализация Из Реализации Цикл
            
			КаталогСохраненияФайлов = смартОбщегоНазначенияКлиент.СоздатьКаталогПФРеализацияТиУ(Реализация,, СкладАтлант);
			
            Если НЕ ЗначениеЗаполнено(КаталогСохраненияФайлов) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен каталог для сохранения файлов по заказу клиента " + ЗаказКлиента + ". ПФ не сформированы.");
				Продолжить;
			КонецЕсли;
			
			// Транспортная накладная
			ИмяФайлаТН = "";

			ТабДокТН = смартСформироватьТабличныйДокументТранспортнаяНакладная(ЗаказКлиента, Объект.Ссылка, Реализация, ИмяФайлаТН);	
			Если ТабДокТН = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ транспортной накладной по клиенту " + Реализация.Контрагент);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИмяФайлаТН) Тогда
				ИмяФайлаТН = "ТранспортнаяНакладная.pdf";
			КонецЕсли;
			
			ПолноеИмяФайлаТН = КаталогСохраненияФайлов + "\" + ИмяФайлаТН;
			
			// Этикетка
			ИмяФайлаЭтикетка = "";
			ТабДокЭтикетка = смартСформироватьТабличныйДокументЭтикетка(Реализация, ИмяФайлаЭтикетка, СкладАтлант);
			
			Если ТабДокЭтикетка = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ этикетки доставки по документу " + Реализация);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИмяФайлаЭтикетка) Тогда
				ИмяФайлаЭтикетка = "ЭтикеткаДоставки.pdf";
			КонецЕсли;
			
			ПолноеИмяФайлаЭтикетка = КаталогСохраненияФайлов + "\" + ИмяФайлаЭтикетка;
			
            Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
                НомерЗадания=Объект.Номер;            
            КонецЕсли; 
			
            ИмяФайлаУПД = "";
            ИмяФайлаСчетНаОплату = ""; 
            ТабДокУПД = Неопределено;
            ТабДокСчетНаОплату = Неопределено;
             
			Если ТипЗнч(Реализация) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
				
				Если РеквизитыСклада.смартАвтоматическиФормироватьДокументы И РеквизитыСклада.смартФормироватьДокументыУТБП = ПредопределенноеЗначение("Перечисление.смартФормироватьДокументыУТБП.УТ") Тогда
                
                    //УПД
                    ТабДокУПД = смартСформироватьУПДКовчег(Реализация, ИмяФайлаУПД, НомерЗадания); 
                    Если ТабДокУПД = Неопределено Тогда
                        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать УПД по документу " + Реализация);
                    КонецЕсли;
                    Если НЕ ЗначениеЗаполнено(ИмяФайлаУПД) Тогда
                        ИмяФайлаУПД = "УПД.pdf";
                    КонецЕсли; 
                    ПолноеИмяФайлаУПД = КаталогСохраненияФайлов + "\" + ИмяФайлаУПД;
                    
                    //СчетНаОплату
                    ТабДокСчетНаОплату = смартСформироватьСчетНаОплатуКовчег(Реализация, ИмяФайлаСчетНаОплату, НомерЗадания); 
                    Если ТабДокСчетНаОплату = Неопределено Тогда
                        ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать Счёт на оплату по документу " + Реализация);
                    КонецЕсли;
                    Если НЕ ЗначениеЗаполнено(ИмяФайлаСчетНаОплату) Тогда
                        ИмяФайлаСчетНаОплату = "Счёт на оплату.pdf";
                    КонецЕсли; 
                    ПолноеИмяФайлаСчетНаОплату = КаталогСохраненияФайлов + "\" + ИмяФайлаСчетНаОплату;
					
                КонецЕсли;   
                
            КонецЕсли;
			
			Успех = Истина;

			Попытка
				
				Если ТабДокТН <> Неопределено Тогда
					ТабДокТН.Записать(ПолноеИмяФайлаТН, ТипФайлаТабличногоДокумента.PDF);
					ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаТН);
				КонецЕсли;
				
				Если ТабДокЭтикетка <> Неопределено И ТабДокЭтикетка <> "Этикетка не требуется" Тогда
					ТабДокЭтикетка.Записать(ПолноеИмяФайлаЭтикетка, ТипФайлаТабличногоДокумента.PDF);
					ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаЭтикетка);
				КонецЕсли;
				
                Если ТабДокУПД <> Неопределено Тогда
					ТабДокУПД.Записать(ПолноеИмяФайлаУПД,ТипФайлаТабличногоДокумента.PDF);
					ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаУПД);
                КонецЕсли;     
                
                 Если ТабДокСчетНаОплату <> Неопределено Тогда
					ТабДокСчетНаОплату.Записать(ПолноеИмяФайлаСчетНаОплату,ТипФайлаТабличногоДокумента.PDF);
					ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаСчетНаОплату);
				КонецЕсли;
                
			Исключение
				Успех = Ложь;
				ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось сохранить печатные формы:" + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
			
			
			Если Успех Тогда
				
				НайденныеФайлы = НайтиФайлы(КаталогСохраненияФайлов, "*");
				
				Для Каждого ТекФайл Из НайденныеФайлы Цикл
					
					ТекСтруктура = Новый Структура;
                    
                    ТекФайлЗаявка = "";
                    Если СтрНайти(ТекФайл.Имя, "Заявка на отгрузку по заказу клиента") Тогда
                        ТекФайлЗаявка = СтрЗаменить(ТекФайл.Имя, ".xlsx", " рейс_" + ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Объект.Номер, Истина, Истина) + ".xlsx"); 
                        ТекСтруктура.Вставить("ИмяФайла", ТекФайлЗаявка);
                    Иначе
                        ТекСтруктура.Вставить("ИмяФайла", ТекФайл.Имя);
                    КонецЕсли; 
                    
					АдресХранилища = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ТекФайл.ПолноеИмя), Новый УникальныйИдентификатор); 
					ТекСтруктура.Вставить("АдресХранилища", АдресХранилища);
					МассивСтруктур.Добавить(ТекСтруктура);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МассивСтруктур.Количество() > 0 Тогда
		смартОбщегоНазначения.ОтправитьПакетДокументовНаПочту(МассивСтруктур, Объект.Ссылка,, СкладАтлант);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СформироватьXMLПоЗаявкаНаОтгрузкуАтлант(Документ, ЗаданиеНаПеревозку, Каталог, ИмяФайла)
       
    АдресФайла = СформироватьXMLПоЗаявкаНаОтгрузкуАтлантСервер(Документ, ЗаданиеНаПеревозку, ИмяФайла);
	
	ПолноеИмяФайла = Каталог + ИмяФайла;
	
    Если ТипЗнч(АдресФайла ) = Тип("Число") Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "В строке: " + АдресФайла+Символы.ПС+"Не заполнен один из реквизитов(Номер машины, " + Символы.ПС + " марка автомобиля, желаемая дата отгрузки, ФИО водителя)! xml сформирован не будет!";
        Сообщение.Сообщить();
        Возврат Ложь;
    КонецЕсли; 
    
	Описание = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, АдресФайла);
	МассивОписаний = Новый Массив;
	МассивОписаний.Добавить(Описание);
	ПолучитьФайлы(МассивОписаний,,, Ложь);
	Файл = Новый Файл(ПолноеИмяФайла); 
    Возврат Файл.Существует();
    
КонецФункции

&НаСервереБезКонтекста
Функция СформироватьXMLПоЗаявкаНаОтгрузкуАтлантСервер(Документ, ЗаданиеНаПеревозку, ИмяФайла)
	
	Возврат Документы.ЗаданиеНаПеревозку.СформироватьЗаявкуНаОтгрузкуXMLАтлант(Документ, ЗаданиеНаПеревозку, ИмяФайла);
	
КонецФункции

&НаСервере
Процедура ОтправитьЗаявкуВАтлантСервер(Документ, Склад, ИмяФайла, АдресВХранилище)
	
	МассивНоменклатуры = Документ.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	смартИнтеграцияАтлант.ВыгрузитьМассивНоменклатурыНаFTP(МассивНоменклатуры, Склад.смартНастройкаОбменомСАтлант);
	
	Соединение = смартИнтеграцияАтлант.ПолучитьFTPСоединение(Склад.смартНастройкаОбменомСАтлант);
	Если Соединение = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Не удалось установить FTP соединение с сервером Атлант");
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Если Б_ОбменССайтомСервер.смарт_ЭтоКопияБазы() Тогда
		ПутьНаФТП = "OUT1";
	Иначе
		ПутьНаФТП = "OUT";
	КонецЕсли;
	
	Если НЕ	смартИнтеграцияАтлант.ЗаписатьФайлВКаталог(Соединение, ПутьНаФТП, ИмяВременногоФайла, ИмяФайла) Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Не удалось установить записать файл %1 на FTP", ИмяФайла));
	КонецЕсли;
	
	УдалитьФайлы(ИмяВременногоФайла);
		
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("На FTP Атлант выгружен файл %1", ИмяФайла));
	
КонецПроцедуры
