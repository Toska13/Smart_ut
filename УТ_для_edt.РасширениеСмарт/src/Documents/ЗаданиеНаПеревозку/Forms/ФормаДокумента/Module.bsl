			Если ТабДокТН = Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ транспортной накладной по клиенту " + Реализация.Контрагент);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИмяФайлаТН) Тогда
				ИмяФайлаТН = "ТранспортнаяНакладная.pdf";
			КонецЕсли;
			
			ПолноеИмяФайлаТН = КаталогСохраненияФайлов + "\" + ИмяФайлаТН;
			
			//++ смарт:ММ 572 18.08.2021
			// Этикетка
			
			ИмяФайлаЭтикетка = "";
			
			//++ #1353 смарт: Фролов 24.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)
			//ТабДокЭтикетка = смартСформироватьТабличныйДокументЭтикетка(Реализация, ИмяФайлаЭтикетка);
