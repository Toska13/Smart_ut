
//++ смарт:ММ 572 28.07.2021
&НаКлиенте
Процедура смартСформироватьПакетДокументовНажатие(Команда)

	//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(Неопределено, "Документ не записан!" + Символы.ПС + "Операция невозможна");
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(Команда.Имя, "Атлант") > 0 Тогда
		ЭтаФорма.смартВидСкладаПриФормированииПакета = "Атлант";
	Иначе
		ЭтаФорма.смартВидСкладаПриФормированииПакета = "Адмирал";
	КонецЕсли;
	
	Если смартЕстьЗаказыКлиентовВРаспоряжениях() Тогда 
		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("Задание", Объект.Ссылка);
		ПараметрыПроверки.Вставить("ВидСкладаПриФормированииПакета", ЭтаФорма.смартВидСкладаПриФормированииПакета);
		
		ОткрытьФорму("Документ.ЗаданиеНаПеревозку.Форма.смартПроверкаВозможностиОтправкиПакетаДокументов", 
			ПараметрыПроверки, 
			ЭтаФорма,,,, 
			Новый ОписаниеОповещения("смартПослеПроверкиВозможностиФормированияПакета", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		смартВыполнениеКомандыСформироватьПакетДокументов(); 
		
	КонецЕсли;
	
	//-- #1766 смарт: Мосолов 09.04.2024 
		
КонецПроцедуры //-- смарт:ММ 28.07.2021  

//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке
&НаСервере
Функция смартЕстьЗаказыКлиентовВРаспоряжениях()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задание", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаданиеНаПеревозкуРаспоряжения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
	|ГДЕ
	|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение ССЫЛКА Документ.ЗаказКлиента
	|	И ЗаданиеНаПеревозкуРаспоряжения.Ссылка = &Задание"; 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка.Следующий(); 
		
КонецФункции //-- #1766 смарт: Мосолов 09.04.2024

//++ #1766 смарт: Мосолов 09.04.2024 //Создать предварительный шаг по контролю созданных документов в БП при отгрузке
&НаКлиенте
Процедура смартПослеПроверкиВозможностиФормированияПакета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено И Результат Тогда 
		
		смартВыполнениеКомандыСформироватьПакетДокументов();
		
	КонецЕсли;

КонецПроцедуры //-- #1766 смарт: Мосолов 09.04.2024

&НаКлиенте
Процедура смартВыполнениеКомандыСформироватьПакетДокументов()
	
	//++ #1353 смарт: Фролов 22.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
	СкладыАдмирал = смартПолучитьСкладыАдмиралВДокументе(); 
	
	Для Каждого СкладАдмирал Из СкладыАдмирал Цикл   
		
		Если ЭтаФорма.смартВидСкладаПриФормированииПакета = "Адмирал" Тогда
			Если ЭтоСкладАтлант(СкладАдмирал) Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли ЭтаФорма.смартВидСкладаПриФормированииПакета = "Атлант" Тогда
			Если НЕ ЭтоСкладАтлант(СкладАдмирал) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		//МассивЗаказовКлиентов = смартПолучитьЗаказыКлиентаАдмирал();
		МассивЗаказовКлиентов = смартПолучитьЗаказыКлиентаАдмирал(СкладАдмирал);
	//-- #1353 смарт: Фролов 22.05.2023	
		
		//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 08.12.2021 10:45:41 задача 806 
		КоличествоЗаказов = 0;
		
		Для каждого ЭлементМассива Из МассивЗаказовКлиентов Цикл
			
			Если ТипЗнч(ЭлементМассива) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
				КоличествоЗаказов = КоличествоЗаказов + 1;
			КонецЕсли; 
			
		КонецЦикла; 
		
		//++ #1353 смарт: Фролов 22.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
		//СтруктураПараметров=Новый Структура("КоличествоРеализаций,СписокДокументов,МассивЗаказовКлиентов",К,Новый СписокЗначений,МассивЗаказовКлиентов);
		СтруктураПараметров = Новый Структура("КоличествоРеализаций, СписокДокументов, МассивЗаказовКлиентов, СкладАдмирал", КоличествоЗаказов, Новый СписокЗначений, МассивЗаказовКлиентов, СкладАдмирал);
		//-- #1353 смарт: Фролов 22.05.2023 
		
		Для каждого СтрокаЗаказ Из МассивЗаказовКлиентов Цикл 
			
			СписокДокументов = ОтборДокументовРеализации(СтрокаЗаказ, СкладАдмирал); 
			
			Если СписокДокументов.Количество() > 1 Тогда 
				
				ОповещениеПослеВыбора = Новый ОписаниеОповещения("ОбработатьДокументы", ЭтотОбъект, СтруктураПараметров);  
				
				//++ смарт:Подкин #1136 25.08.2022 17:36:07
				//СписокДокументов.ПоказатьВыборЭлемента(ОповещениеПослеВыбора, "Выберите реализацию по заказу: "+СтрЗаказ);
				СписокДокументов.ПоказатьОтметкуЭлементов(ОповещениеПослеВыбора, "Выберите реализацию по заказу: " + СтрокаЗаказ);
				//-- смарт:Подкин #1136 25.08.2022 17:36:07
				
			ИначеЕсли ТипЗнч(СтрокаЗаказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда   
				
				Если СписокДокументов.Количество() = 0 Тогда 
					
					ОбщегоНазначенияКлиент.СообщитьПользователю("Внимание: Для " + СтрокаЗаказ + " не введена реализация.", СтрокаЗаказ,, СтрокаЗаказ); 
					
					//++ смарт:Подкин #1136 24.08.2022 12:54:38
					Возврат;
					//-- смарт:Подкин #1136 24.08.2022 12:54:38  
					
				КонецЕсли;  
				
				СтруктураПараметров.СписокДокументов.Добавить(СписокДокументов[0].Значение);  
				
			КонецЕсли;  
			
		КонецЦикла;  
		
		Если КоличествоЗаказов <> СтруктураПараметров.СписокДокументов.Количество() Тогда
			Возврат;
		КонецЕсли; 
		
	//++ #1353 смарт: Фролов 22.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
		//СформироватьПакетДалее(МассивЗаказовКлиентов,СтруктураПараметров.СписокДокументов);
		СформироватьПакетДалее(МассивЗаказовКлиентов, СтруктураПараметров.СписокДокументов, СкладАдмирал);
    //Смарт }Подкин Алексей Иванович 08.12.2021 10:45:41  
	
	КонецЦикла;
	//-- #1353 смарт: Фролов 22.05.2023  
	
КонецПроцедуры

//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 09.12.2021 16:38:58 задача 806
&НаКлиенте
Процедура СформироватьПакетДалее(МассивЗаказовКлиентов, СписокДокументовРеализации = Неопределено, СкладАдмирал)
	
	//++ #Б3572 смарт: Шляпников 17.06.2025 / Интеграция с WMS. Атлант. Отгрузка. Разработка
	Если ЭтоСкладАтлант(СкладАдмирал) Тогда
		
