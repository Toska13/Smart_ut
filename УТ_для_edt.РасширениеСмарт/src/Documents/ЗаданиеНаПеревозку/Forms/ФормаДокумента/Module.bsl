                            //Соответств.Вставить(ВыборкаДетальныеЗаписи.Регистратор,ВыборкаДетальныеЗаписи.Регистратор); 
                            
                            Если ЗначениеЗаполнено(Реализация) И КоличествоРеализации > 0 Тогда
                                Соответств.Вставить(Реализация,Реализация); 
                                Реализация = Неопределено;
                            КонецЕсли;    
                            
                            КоличествоРеализации = КоличествоРеализации + ВыборкаДетальныеЗаписи.Приход;
                            Реализация = ВыборкаДетальныеЗаписи.Регистратор; 
                            КоличествоВРеализации = ВыборкаДетальныеЗаписи.Приход;
                        КонецЕсли; 
                        
                        Если ТипЗНЧ(ВыборкаДетальныеЗаписи.Регистратор)=Тип("ДокументСсылка.РасходныйОрдерНаТовары") 
                            И ЗначениеЗаполнено(Реализация) 
                            И КоличествоРеализации > 0 Тогда
                            Если (КоличествоРеализации - ВыборкаДетальныеЗаписи.Расход) = 0 Тогда
                                Реализация=Неопределено;
                                Соответств = Новый Соответствие; 
                            ИначеЕсли КоличествоВРеализации > 0 И (КоличествоВРеализации - ВыборкаДетальныеЗаписи.Расход) = 0 Тогда
                                Реализация = Неопределено;
                                КоличествоРеализации = 0;
                            Иначе
