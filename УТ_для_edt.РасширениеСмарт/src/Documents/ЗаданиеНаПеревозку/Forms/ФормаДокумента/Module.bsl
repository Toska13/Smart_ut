            Пока ВыборкаСерия.Следующий() Цикл
                Если ВыборкаСерия.Приход - ВыборкаСерия.Расход<>0 Тогда
                    ВыборкаДетальныеЗаписи = ВыборкаСерия.Выбрать(); 
                    Реализация = Неопределено;
                    КоличествоРеализации = 0;  
                    КоличествоВРеализации = 0;
