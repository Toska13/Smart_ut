	//
	//КаталогСкладаАдмирал = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("КаталогСкладаАдмирал", Ложь);
	//
	////++ смарт:Подкин #1121 03.08.2022 16:03:51 доработка для выгрузки на склад Адмирал ЮЛ Ковчег 
	//СкладАдмиралКовчег = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("СкладАдмиралКовчег", Ложь);
	//КаталогСкладаАдмиралКовчег = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("КаталогСкладаАдмиралКовчег", Ложь);
	//Если Объект.Склад = СкладАдмиралКовчег Тогда
	//    КаталогСкладаАдмирал = КаталогСкладаАдмиралКовчег;	
	//КонецЕсли; 
    //-- смарт:Подкин #1121 03.08.2022 16:03:51
	ТабДокЗаявкаНаМашину = смартСформироватьТабличныйДокументЗаявкаНаМашину(МассивЗаказовКлиентов, Объект.Ссылка, ИмяФайлаЗаявкаНаМашину, "xlsx",СкладАдмирал);
	смартАвтоматическиФормироватьДокументы=Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(СкладАдмирал,"смартАвтоматическиФормироватьДокументы");
	Если смартАвтоматическиФормироватьДокументы Тогда
	    КаталогСкладаАдмирал = Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(СкладАдмирал,"смартКаталогСклада");	
	КонецЕсли;
    //-- #1353 смарт: Фролов 17.05.2023
    
	ПолноеИмяФайлаЗаявкаНаМашину = КаталогСкладаАдмирал + "\Заявки на отгрузку по доставкам\" + ИмяФайлаЗаявкаНаМашину;
	
	Успех = Истина;
	
	Попытка
		
		ТабДокЗаявкаНаМашину.Записать(ПолноеИмяФайлаЗаявкаНаМашину, ТипФайлаТабличногоДокумента.XLSX);
		ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаЗаявкаНаМашину);
	Исключение
		Успех = Ложь;
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось сохранить Заявку на машину:" + Символы.ПС + ОписаниеОшибки());	
	КонецПопытки;
	
	Если НЕ Успех Тогда
		Возврат;
	КонецЕсли;
	
	
	МассивСтруктур = Новый Массив; // Для вложений в письмо (одна заявка на машину и все файлы из подпапок, в т.ч. те, которые были сформированы ранее из БП)
	
