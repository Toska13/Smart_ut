//++#1241 смарт: Лопато 09.12.2022 //Доработать алгоритм вычисления статуса заказа для сайта.
Функция смартСформироватьТаблицуРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс(ЗаданиеОбъект)

	ТаблицаРаспоряжений = ЗаданиеОбъект.Распоряжения.Выгрузить(, "Распоряжение");

	ТаблицаРаспоряженийПрошлая = ЗаданиеОбъект.Ссылка.Распоряжения;
	
	Для Каждого СтрРаспоряжение Из ТаблицаРаспоряженийПрошлая Цикл
		НоваяСтрРаспоряжение = ТаблицаРаспоряжений.Добавить();
		НоваяСтрРаспоряжение.Распоряжение = СтрРаспоряжение.Распоряжение;
	КонецЦикла;	
	
	Возврат ТаблицаРаспоряжений;

КонецФункции //--#1241 смарт: Лопато 09.12.2022

//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
Процедура смартРассчитатьПараметрДоставкиПоЗаказам(Объект, ДопСвойства)
	
	Если ДопСвойства.Свойство("ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс") Тогда
		ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс = ДопСвойства.ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс;
	Иначе
		ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс = ЭтотОбъект.Распоряжения.Выгрузить(, "Распоряжение");
	КонецЕсли;	

	ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс.Свернуть("Распоряжение");
	
	МассивРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс = Новый Массив;
	
	Для Каждого СтрокаРаспоряжения Из ТаблицаРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс Цикл
		
		Если ТипЗнч(СтрокаРаспоряжения.Распоряжение) = Тип("ДокументСсылка.ЗаказКлиента") 
			И Б_ОбменССайтомСервер.смартПроверкаЗаказНужноВыгружатьНаСайт(СтрокаРаспоряжения.Распоряжение, Истина) Тогда
			
			МассивРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс.Добавить(СтрокаРаспоряжения.Распоряжение);
			
		КонецЕсли;
		
	КонецЦикла;	
	
	СтруктураДействийРасчета = Новый Структура("Заказ");
	смарт_РаботаССтатусамиЗаказа.смартРассчитатьПараметрыСтатусовЗаказовБитрикс(МассивРаспоряженийДляРасчетаПараметровСтатусовЗаказовБитрикс, СтруктураДействийРасчета);
		
КонецПроцедуры //--#1241 смарт: Лопато 25.01.2023

//++ #1669 смарт: Мосолов 07.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаданиеНаПеревозку  
&ИзменениеИКонтроль("ОбработкаПроведения")
Процедура смарт_ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведенПередЗаписью = ДополнительныеСвойства.ПроведенПередЗаписью;
	СтатусПередЗаписью = ДополнительныеСвойства.СтатусПередЗаписью;
	
	// Проверка можно ли устанавливать статус
	Если Операция = Перечисления.ВидыДоставки.СоСклада
		И (Статус = Перечисления.СтатусыЗаданийНаПеревозку.Отправлено 
			Или Статус = Перечисления.СтатусыЗаданийНаПеревозку.Закрыто) Тогда
		
		// Проверка на все ли количество по заданию на перевозку оформлены расходные ордера,
		// только для складов с ФО НачинатьОтгрузкуПослеФормированияЗаданияНаПеревозку.
		КонтрольОформленныхОрдеровПоЗаданиюНаПеревозку(Ссылка, Отказ);
		
		// Проверка готовности расходных ордеров
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасходныйОрдерНаТовары.Ссылка
		|ИЗ
		|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
		|ГДЕ
		|	РасходныйОрдерНаТовары.ЗаданиеНаПеревозку = &ЗаданиеНаПеревозку
		|	И НЕ(РасходныйОрдерНаТовары.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.КОтгрузке)
		|				ИЛИ РасходныйОрдерНаТовары.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.Отгружен))
		|	И РасходныйОрдерНаТовары.Проведен";
		Запрос.УстановитьПараметр("ЗаданиеНаПеревозку", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ТекстСообщения = НСтр("ru = 'Расходный ордер ""%Ссылка%"" по заданию на перевозку не готов к отгрузке.'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Ссылка%", Выборка.Ссылка);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,Выборка.Ссылка,,,Отказ);
			
		КонецЦикла;
	
	// Запуск автоматического создания расходных ордеров
	// для складов с ФО НачинатьОтгрузкуПослеФормированияЗаданияНаПеревозку.
	ИначеЕсли Операция = Перечисления.ВидыДоставки.СоСклада
		И Константы.РежимФормированияРасходныхОрдеров.Получить() = Перечисления.РежимыФормированияРасходныхОрдеров.Автоматически
		
		И (		Статус = Перечисления.СтатусыЗаданийНаПеревозку.КПогрузке
				И Не ПроведенПередЗаписью
				
			Или 
			
				Статус = Перечисления.СтатусыЗаданийНаПеревозку.КПогрузке
				И СтатусПередЗаписью = Перечисления.СтатусыЗаданийНаПеревозку.Формируется
				
			Или
			
				Статус = Перечисления.СтатусыЗаданийНаПеревозку.Формируется
				И СтатусПередЗаписью <> Перечисления.СтатусыЗаданийНаПеревозку.Формируется
				И ПроведенПередЗаписью
			) Тогда
			
		Документы.ЗаданиеНаПеревозку.СформироватьОчередьПереоформленияРасходныхОрдеров(Ссылка, Отказ);
		
	КонецЕсли;
	
	Если ДополнительныеСвойства.ЭтоНовый
		Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Изменить статус расходных ордеров на "Отгружен" по отправленным заданиям на перевозку,
	// если все ордера оформлены и находятся в статусе не ниже КОтгрузке (это проверяется выше).
	Если Операция = Перечисления.ВидыДоставки.СоСклада
		И (Статус = Перечисления.СтатусыЗаданийНаПеревозку.Закрыто
			ИЛИ Статус = Перечисления.СтатусыЗаданийНаПеревозку.Отправлено)
		И (Не ПроведенПередЗаписью
			Или 
				(СтатусПередЗаписью <> Перечисления.СтатусыЗаданийНаПеревозку.Закрыто
				И СтатусПередЗаписью <> Перечисления.СтатусыЗаданийНаПеревозку.Отправлено
				И Статус <> СтатусПередЗаписью)) Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РасходныйОрдерНаТовары.Ссылка
		|ИЗ
		|	Документ.РасходныйОрдерНаТовары КАК РасходныйОрдерНаТовары
		|ГДЕ
		|	РасходныйОрдерНаТовары.ЗаданиеНаПеревозку = &ЗаданиеНаПеревозку
		|	И РасходныйОрдерНаТовары.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.КОтгрузке)
		|	И РасходныйОрдерНаТовары.Проведен";
		Запрос.УстановитьПараметр("ЗаданиеНаПеревозку", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
			
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			СкладыСервер.ЗапускВыполненияФоновогоПереводаСтатусаРасходногоОрдераВОтгружено(Ссылка);
			
		КонецЕсли;
		
	КонецЕсли;  
	
	#Вставка  
	
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 23.07.2020 17:20:15 задача 522
    //Подготовка свойства Идентификатор отправления, для заполнения по реализациям
    МенеджерВременныхТаблицСвойств 	= Новый МенеджерВременныхТаблиц;
    СвойствоСтрокой="Идентификатор отправления";
    
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицСвойств;
    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
    |	ДополнительныеРеквизитыИСведения.Ссылка,
    |	ДополнительныеРеквизитыИСведения.ТипЗначения,
    |	ДополнительныеРеквизитыИСведения.ЭтоДополнительноеСведение,
    |	ДополнительныеРеквизитыИСведения.Заголовок  КАК Заголовок
    |ПОМЕСТИТЬ ВремДопРеквизиты
    |ИЗ
    |	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизитыИСведения
    |ГДЕ
    |	НЕ ДополнительныеРеквизитыИСведения.ПометкаУдаления
    |
    |ИНДЕКСИРОВАТЬ ПО
    |	Заголовок";
    Запрос.Выполнить();
    
    Запрос = Новый Запрос;
    Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицСвойств;
    Запрос.УстановитьПараметр("СоздаватьРеквизит", Истина);
    Запрос.Текст ="ВЫБРАТЬ *
    |ИЗ
    |	ВремДопРеквизиты КАК ВремДопРеквизиты
    |ГДЕ
    |	ВремДопРеквизиты.Заголовок Подобно &Заголовок
    |	И ВремДопРеквизиты.ЭтоДополнительноеСведение = &СоздаватьРеквизит";
    Запрос.УстановитьПараметр("Заголовок", СвойствоСтрокой+"%");
    
    СвойствоЗаказа = НеОпределено;
    Свойство = НеОпределено;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если Выборка.Ссылка.НаборСвойств.ИмяПредопределенныхДанных="Документ_РеализацияТоваровУслуг" Тогда
            Свойство = Выборка.Ссылка;
        ИначеЕсли Выборка.Ссылка.НаборСвойств.ИмяПредопределенныхДанных="Документ_ЗаказКлиента" Тогда
            СвойствоЗаказа = Выборка.Ссылка;
        КонецЕсли; 
    КонецЦикла;
    //------------------------------------------------------------------------------------ 
    Для Каждого стрТЗ из ЭтотОбъект.Распоряжения Цикл
        Если ЗначениеЗаполнено(стрТЗ.смартТрекНомер) Тогда
            Если СвойствоЗаказа <> НеОпределено И ТипЗнч(стрТЗ.Распоряжение)=ТИП("ДокументСсылка.ЗаказКлиента") Тогда
                // НаборЗаписейЗаказ.Отбор.Объект.Установить(стрТЗ.Распоряжение);
                //НаборЗаписейЗаказ.Отбор.Свойство.Установить(стрТЗ.СвойствоЗаказа);
                // НаборЗаписейЗаказ.Прочитать();
                МенеджерЗаписиЗаказ = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
                МенеджерЗаписиЗаказ.Объект 		    = стрТЗ.Распоряжение;
                МенеджерЗаписиЗаказ.Значение    	= стрТЗ.смартТрекНомер;
                МенеджерЗаписиЗаказ.Свойство 	    = СвойствоЗаказа;
                МенеджерЗаписиЗаказ.Записать();
            КонецЕсли; 
            НаборЗаписей = РегистрыСведений.СмартСтатусОтслеживаниеОтправления.СоздатьНаборЗаписей();
            НаборЗаписей.Отбор.ЗаданиеНаПеревозку.Установить(ЭтотОбъект.Ссылка);
            НаборЗаписей.Отбор.Заказ.Установить(стрТЗ.Распоряжение);
            //НаборЗаписей.Отбор.СтатусЗадания.Установить(ЭтотОбъект.Статус);
            //НаборЗаписей.Отбор.ТрэкНомер.Установить(стрТЗ.ТрекНомер);
            НаборЗаписей.Прочитать();
            
            ДобавлятьЗапись=Ложь;
            СтруктураОтбора=Новый Структура;
            СтруктураОтбора.Вставить("ЗаданиеНаПеревозку",ЭтотОбъект.Ссылка);
            СтруктураОтбора.Вставить("Заказ",стрТЗ.Распоряжение);
            ТзПоследние=РегистрыСведений.СмартСтатусОтслеживаниеОтправления.СрезПоследних(ТекущаяДата(),СтруктураОтбора);
            Для Каждого СтрЗнч из ТзПоследние Цикл
                Если СтрЗнч.ЗаданиеНаПеревозку = ЭтотОбъект.Ссылка И СтрЗнч.Заказ = стрТЗ.Распоряжение И
                    СтрЗнч.ТрекНомер = стрТЗ.смартТрекНомер И СтрЗнч.СтатусЗадания = ЭтотОбъект.Статус Тогда
                иначе
                    ДобавлятьЗапись=Истина;	
                КонецЕсли;
            КонецЦикла;
            
            Если НаборЗаписей.Количество()=0 Тогда
                ДобавлятьЗапись=Истина;
            КонецЕсли;
            
            Если ДобавлятьЗапись Тогда
                //	НаборЗаписей.Отбор.Период.Установить(ТекущаяДата());
                НоваяЗапись = НаборЗаписей.Добавить();
                НоваяЗапись.ЗаданиеНаПеревозку=ЭтотОбъект.Ссылка;
                НоваяЗапись.Заказ=стрТЗ.Распоряжение;
                НоваяЗапись.СтатусЗадания= ЭтотОбъект.Статус;
                НоваяЗапись.ТрекНомер=стрТЗ.смартТрекНомер;
                НоваяЗапись.Период=ТекущаяДата();
                НаборЗаписей.Записать();
				//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
				//Если Константы.смартЗаказыСтатусНаСайтБитрикс.Получить() Тогда
                //    смарт_РаботаССтатусамиЗаказа.ОтразитьСостояниеЗаказаБитрикс(стрТЗ.Распоряжение.ПолучитьОбъект());
                //КонецЕсли;
				//--#1241 смарт: Лопато 25.01.2023
            КонецЕсли;
            
            //Запись доп. сведения документа реализации
            Если Свойство<>Неопределено И ТипЗнч(стрТЗ.Распоряжение)=ТИП("ДокументСсылка.ЗаказКлиента") Тогда
                
                Запрос=Новый Запрос;
                Запрос.Текст="ВЫБРАТЬ
                |	СвязанныеДокументы.Ссылка КАК Ссылка
                |ИЗ
                |	КритерийОтбора.СвязанныеДокументы(&ОбъектЗаказ) КАК СвязанныеДокументы
                |ГДЕ
                |	СвязанныеДокументы.Ссылка ССЫЛКА Документ.РеализацияТоваровУслуг";
                Запрос.УстановитьПараметр("ОбъектЗаказ",стрТЗ.Распоряжение);
                РезультатЗапроса=Запрос.Выполнить();
                Если РезультатЗапроса.Пустой() Тогда
                    Продолжить;
                Иначе
                    НаборЗаписей = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
                    ВыборкаРезультат=РезультатЗапроса.Выбрать(); 
                    Пока ВыборкаРезультат.Следующий() Цикл
                        НаборЗаписей.Отбор.Объект.Установить(ВыборкаРезультат.Ссылка);
                        НаборЗаписей.Отбор.Свойство.Установить(Свойство);
                        НаборЗаписей.Прочитать();
                        Если НаборЗаписей.Количество()=0 Тогда
                            НоваяЗапись = НаборЗаписей.Добавить(); 
                            НоваяЗапись.Объект 		= ВыборкаРезультат.Ссылка;
                            НоваяЗапись.Значение 	= стрТЗ.смартТрекНомер;
                            НоваяЗапись.Свойство 	= Свойство;
                        Иначе
                            НаборЗаписей[0].Значение 	= стрТЗ.смартТрекНомер; 
                        КонецЕсли; 
                        //Зарегистрируем реализацию и заказ, возможно до внесения трек номера, документ будет отправлен на сайт.
                        ОбъектДок=ВыборкаРезультат.Ссылка.ПолучитьОбъект();
                        Б_ОбменССайтомСервер.ЗарегистрироватьИзмененияПриЗаписиСправочникаДокументаДляОбменаССайтами(ОбъектДок,Ложь);
                    КонецЦикла; 
                    НаборЗаписей.Записать();
                    
                КонецЕсли; 
            КонецЕсли;
        КонецЕсли; 		
	КонецЦикла;

	//++#1241 смарт: Лопато 25.01.2023 //Доработать алгоритм вычисления статуса заказа для сайта.  
	Если НЕ Отказ И Константы.смартЗаказыСтатусНаСайтБитрикс.Получить() Тогда
		смартРассчитатьПараметрДоставкиПоЗаказам(ЭтотОбъект, ДополнительныеСвойства);
	КонецЕсли;
	//--#1241 смарт: Лопато 25.01.2023

