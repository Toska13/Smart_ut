					|	И смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.СозвонитьсяСКлиентом)");
					Запрос.УстановитьПараметр("Предмет", Ссылка);
					
					Выборка = Запрос.Выполнить().Выбрать();
					Пока Выборка.Следующий() Цикл
						
						ОбъектЗадача = Выборка.Ссылка.ПолучитьОбъект();
						ОбъектЗадача.Исполнитель = Ответственный;
						ОбъектЗадача.Записать();
						
					КонецЦикла;	
					
				КонецЕсли;	
				//-- #Б-1214 смарт: Фролов 29.10.2024
					
			КонецЕсли;		
			//-- #1988 смарт: Фролов 14.08.2024
			
			//-- #1778 смарт: Фролов 17.04.2024
			
		КонецЕсли;
		
	//++ #1778 смарт: Фролов 17.04.2024 //Оповещений менеджеров о назначенных Интересах.
	ИначеЕсли ДополнительныеСвойства.ЭтоНовый И ЗначениеЗаполнено(Лид) Тогда 	
		
		УстановитьПривилегированныйРежим(Истина);
		
		смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(Перечисления.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес,
