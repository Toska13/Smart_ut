		|	(Заметки.смартПартнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
		|			ИЛИ Заметки.смартПартнер <> &ТекПартнер)
		|	И Заметки.Предмет = &Интерес");
		
		Запрос.УстановитьПараметр("ТекПартнер", ТекПартнер);
		Запрос.УстановитьПараметр("Интерес", Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОбъектЗаметка = Выборка.Заметка.ПолучитьОбъект();
			ОбъектЗаметка.смартПартнер = ТекПартнер;
			ОбъектЗаметка.Записать();
			
		КонецЦикла;	
		
	КонецЕсли;
	//-- #1981 смарт: Фролов 21.08.2024
	
	//++ #Б-3860 смарт: Фролов 15.08.2025 //CRM. Продажа оборудования. Дополнительные условия на этапе
	Если ДополнительныеСвойства.ПредыдущаяДатаОтправкиДоговора <> смартДатаОтправкиДоговора 
		И ЗначениеЗаполнено(смартДатаОтправкиДоговора) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
		ЗадачаОбъект.Дата = ТекущаяДатаСеанса();
		ЗадачаОбъект.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
