				ОбъектЛид = Лид.ПолучитьОбъект();
				ОбъектЛид.Ответственный = Ответственный;
				ОбъектЛид.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли;	
			//-- #1904 смарт: Фролов 08.07.2024
			
			//++ #Б-1116 смарт: Фролов 17.10.2024 //Создание общей очереди в механизме распределения Интересов
			НаборЗаписей = РегистрыСведений.смартОбщаяОчередьВыдачиЛидов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Менеджер.Установить(смартПредыдущийОтветственный);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			СтрокаНаборЗаписей = НаборЗаписей.Добавить();
			СтрокаНаборЗаписей.Менеджер = смартПредыдущийОтветственный;
			СтрокаНаборЗаписей.ДатаНачала = ТекущаяДата();
			
			НаборЗаписей.Записать(Истина);
			//-- #Б-1116 смарт: Фролов 17.10.2024

			
			//++ #1988 смарт: Фролов 14.08.2024 //Ошибка, приходит оповещение о новом интересе сотруднику блокирующему выдачу.
			// добавлена проверка на пустого ответственного
			Если ЗначениеЗаполнено(Ответственный) Тогда
				
				смартСобытияВзаимодействий.ЗарегистрироватьСобытиеВзаимодействия(Перечисления.смартВидыСобытийВзаимодействий.СозданиеДокументаИнтерес,
					"СозданНовыйИнтерес", Ссылка);
					
				//++ #Б-1116 смарт: Фролов 17.10.2024 //Создание общей очереди в механизме распределения Интересов
				смартСервер.УдалитьМенеджераИзОбщейОчереди(Ответственный);
				//-- #Б-1116 смарт: Фролов 17.10.2024
				
				//++ #Б-1214 смарт: Фролов 29.10.2024 //Регистрация в ИМ. Лид-Интерес. Проверка взаимодействия перед подтверждением
				Если смартИтоговаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте Тогда
					
