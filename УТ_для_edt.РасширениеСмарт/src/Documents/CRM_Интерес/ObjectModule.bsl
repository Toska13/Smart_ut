				НаборЗаписей.Отбор.Источник.Установить(Выборка.Источник);
				НаборЗаписей.Прочитать();
				НаборЗаписей.Очистить();
				НаборЗаписей.Записать();
				
			КонецЦикла;	
			
			//++ #1778 смарт: Фролов 17.04.2024 //Оповещений менеджеров о назначенных Интересах.
			
