
#Область ПеренесеноСДоработкамиСмарт

&После("ПриЗаписи")
//++ #1698 смарт: Фролов 27.03.2024 //Оповещение Маркетинга и Коммерции о результатах обработки интереса менеджером.
Процедура смарт_ПриЗаписи(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Лид = Ссылка.ДокументОснование;
	
	Если ЗначениеЗаполнено(Лид) И ТипЗнч(Лид) = Тип("ДокументСсылка.смартЛид") Тогда
		
		Если ДополнительныеСвойства.ПредыдущееСостояниеИнтереса <> СостояниеИнтереса Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания
			|ПОМЕСТИТЬ НомерКвалификации
			|ИЗ
			|	Справочник.CRM_СостоянияИнтересов
			|ГДЕ
			|	Родитель = &Родитель
			|	И ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.смартКвалификация)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CRM_СостоянияИнтересов.Ссылка КАК Квалификация
			|ИЗ
			|	Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НомерКвалификации КАК НомерКвалификации
			|		ПО CRM_СостоянияИнтересов.РеквизитДопУпорядочивания < НомерКвалификации.РеквизитДопУпорядочивания
			|ГДЕ
			|	CRM_СостоянияИнтересов.Родитель = &Родитель
			|	И НЕ CRM_СостоянияИнтересов.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	CRM_СостоянияИнтересов.Ссылка КАК Квалификация
			|ИЗ
			|	Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НомерКвалификации КАК НомерКвалификации
			|		ПО CRM_СостоянияИнтересов.РеквизитДопУпорядочивания >= НомерКвалификации.РеквизитДопУпорядочивания
			|ГДЕ
			|	CRM_СостоянияИнтересов.Родитель = &Родитель
			|	И НЕ CRM_СостоянияИнтересов.ВидСостояния = ЗНАЧЕНИЕ(Перечисление.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение)
			|;
			//++ #Б-3480 смарт: Фролов 02.06.2025 //Добавить нескольких получателей рассылки при закрытии интересов.
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Значение КАК Контролер
			|ИЗ
			|	Справочник.смартПредопределенныеЗначения.Значения
			|ГДЕ
			|	Ссылка = &Контролеры
			|;
			//-- #Б-3480 смарт: Фролов 02.06.2025
			//++ #1772 смарт: Фролов 11.04.2024 //Отправка сообщений о квалификации Интересов успешных и не успешных конкретному получателю по указанным менеджерам
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Значение КАК Менеджер
			|ИЗ
			|	Справочник.смартПредопределенныеЗначения.Значения
			|ГДЕ
			|	Ссылка = &ПредопределенноеЗначение");
			Запрос.УстановитьПараметр("ПредопределенноеЗначение", Справочники.смартПредопределенныеЗначения.КонтролируемыеМенеджеры);
			//-- #1772 смарт: Фролов 11.04.2024
			Запрос.УстановитьПараметр("Родитель", СостояниеИнтереса.Родитель);
			//++ #Б-3480 смарт: Фролов 02.06.2025 //Добавить нескольких получателей рассылки при закрытии интересов.
			Запрос.УстановитьПараметр("Контролеры", Справочники.смартПредопределенныеЗначения.КонтролерРезультатовОбрабооткиИнтересов);
			//-- #Б-3480 смарт: Фролов 02.06.2025
			
			МассивРезультатов = Запрос.ВыполнитьПакет();
			МасссивДо = МассивРезультатов[1].Выгрузить().ВыгрузитьКолонку("Квалификация");
			МасссивПосле = МассивРезультатов[2].Выгрузить().ВыгрузитьКолонку("Квалификация");
			//++ #Б-3480 смарт: Фролов 02.06.2025 //Добавить нескольких получателей рассылки при закрытии интересов.
			//++ #1772 смарт: Фролов 11.04.2024 //Отправка сообщений о квалификации Интересов успешных и не успешных конкретному получателю по указанным менеджерам
			//МассивКонтролируемых = МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Менеджер");
			//-- #1772 смарт: Фролов 11.04.2024
			МассивКонтролеров = МассивРезультатов[3].Выгрузить().ВыгрузитьКолонку("Контролер");
			МассивКонтролируемых = МассивРезультатов[4].Выгрузить().ВыгрузитьКолонку("Менеджер");
			//-- #Б-3480 смарт: Фролов 02.06.2025
			
			Вариант = "";
			
			Если СостояниеИнтереса.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение
				И НЕ ДополнительныеСвойства.ПредыдущееСостояниеИнтереса.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение Тогда
				
				//Отправляем письмо о неудаче
				Вариант = "ПисьмоОНеудачномЗавершении";
				
				//++ #Б-2140 смарт: Фролов 11.02.2025 //Ввод нового регламента. Убрать автоматическое создание заметок при квалификации Интереса
				//++ #1833 смарт: Фролов 27.05.2024 //Автоматическое создание заметок при квалификации интереса.
				//смартСоздатьЗаметкуОКвалификации(Вариант);
				//-- #1833 смарт: Фролов 27.05.2024
				//-- #Б-2140 смарт: Фролов 11.02.2025 
				
				//++ #Б-4872 смарт: Фролов 05.11.2025 //Текущие задачи по CRM.
				МассивПричин = Справочники.смартПредопределенныеЗначения.Настройки.ПричиныОтказаДляВозвратаВОчередь.ВыгрузитьКолонку("ПричинаОтказа");
				
				//++ #Б-3650 смарт: Фролов 27.06.2025 //При закрытии Интереса с причиной "Дубль", возвращать очередь менеджера.
				//Если ПричинаОтказа = Справочники.смартПредопределенныеЗначения.Настройки.ПричинаОтказаДубль Тогда
				Если НЕ МассивПричин.Найти(ПричинаОтказа) = Неопределено Тогда
				//-- #Б-4872 смарт: Фролов 05.11.2025	
					
					НаборЗаписей = РегистрыСведений.смартВыдачаЛидов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Менеджер.Установить(Ответственный);
					НаборЗаписей.Отбор.Квалификация.Установить(смартПредварительнаяКвалификация);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						
						ИзменениеВыдачи = НаборЗаписей[0].ВыданоЛидов - 1;
						Если ИзменениеВыдачи < 0 Тогда
							ИзменениеВыдачи = 0;
						ИначеЕсли ИзменениеВыдачи > НаборЗаписей[0].ВыдатьЛидов Тогда
							ИзменениеВыдачи = НаборЗаписей[0].ВыдатьЛидов;
						КонецЕсли;	
						НаборЗаписей[0].ВыданоЛидов = ИзменениеВыдачи;
						
						НаборЗаписей.Записать(Истина);
						
					КонецЕсли;
					
					НаборЗаписей = РегистрыСведений.смартОбщаяОчередьВыдачиЛидов.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Менеджер.Установить(Ответственный);
					НаборЗаписей.Прочитать();
					НаборЗаписей.Очистить();
					
					СтрокаНаборЗаписей = НаборЗаписей.Добавить();
					СтрокаНаборЗаписей.Менеджер = Ответственный;
					СтрокаНаборЗаписей.ДатаНачала = ТекущаяДата();
					
					НаборЗаписей.Записать(Истина);
					
				КонецЕсли;	
				//-- #Б-3650 смарт: Фролов 27.06.2025
				
			ИначеЕсли НЕ МасссивДо.Найти(ДополнительныеСвойства.ПредыдущееСостояниеИнтереса) = Неопределено 
				И НЕ МасссивПосле.Найти(СостояниеИнтереса) = Неопределено Тогда
				
				//Отправляем письмо о квалификации
				Вариант = "ПисьмоОКвалификации";
				
				//++ #Б-2140 смарт: Фролов 11.02.2025 //Ввод нового регламента. Убрать автоматическое создание заметок при квалификации Интереса
				//++ #1833 смарт: Фролов 27.05.2024 //Автоматическое создание заметок при квалификации интереса.
				//смартСоздатьЗаметкуОКвалификации(Вариант);
				//-- #1833 смарт: Фролов 27.05.2024
				//-- #Б-2140 смарт: Фролов 11.02.2025
				
			КонецЕсли;	
			
			Если НЕ Вариант = "" Тогда
				
				УчетнаяЗапись=смартОбщегоНазначения.смартПолучитьУчетнуюЗаписьЭППользователя(Ответственный);
				
				ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
				ТестовыеАдресаСтрока = "";
				ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
				
				АдресаДляОтправкиСтрокой = "";
				
				//++ #Б-6630 смарт: Фролов 28.05.2026 //Сделать механизм оповещений о новых Инцидентах.
				//++ #Б-3858 смарт: Фролов 18.07.2025 //Расширение настройки отправки оповещений о обработке Интересов.
				//Если Вариант = "ПисьмоОКвалификации" Тогда
				//	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомленийПоТипуПродукта(
				//		?(ЗначениеЗаполнено(смартИтоговаяКвалификация), смартИтоговаяКвалификация, смартПредварительнаяКвалификация), Ответственный, АдресаДляОтправкиСтрокой, "Квалификация"); 
				//Иначе
				//	МассивАдресовДляОтправки = смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомленийПоТипуПродукта(
				//		?(ЗначениеЗаполнено(смартИтоговаяКвалификация), смартИтоговаяКвалификация, смартПредварительнаяКвалификация), Ответственный, АдресаДляОтправкиСтрокой, "Завершенные");	
				//КонецЕсли;
				
				Если Вариант = "ПисьмоОКвалификации" Тогда
					МассивПользователей = смартОбщегоНазначения.ПолучитьПользователейПоНастройкамОбОповещениях("Интересы", Ответственный.Подразделение, 
						?(ЗначениеЗаполнено(смартИтоговаяКвалификация), смартИтоговаяКвалификация.ТипПродукта, смартПредварительнаяКвалификация.ТипПродукта), "Квалификация");
				Иначе
					МассивПользователей = смартОбщегоНазначения.ПолучитьПользователейПоНастройкамОбОповещениях("Интересы", Ответственный.Подразделение, 
						?(ЗначениеЗаполнено(смартИтоговаяКвалификация), смартИтоговаяКвалификация.ТипПродукта, смартПредварительнаяКвалификация.ТипПродукта), "Завершенные");
						
					//++ #Б-7838 смарт: Фролов 12.08.2026 //Уведомления для Беловой Т.
					ЗапросКонтролируемые = Новый Запрос(
					"ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.Пользователи.смартКонтролируемыеМенеджеры
					|ГДЕ
					|	Пользователь = &Ответственный");
					ЗапросКонтролируемые.УстановитьПараметр("Ответственный", Ответственный);
					
					ВыборкаКонтролируемые = ЗапросКонтролируемые.Выполнить().Выбрать();
					
					Пока ВыборкаКонтролируемые.Следующий() Цикл
						
						Если МассивПользователей.Найти(ВыборкаКонтролируемые.Ссылка) = Неопределено Тогда
							МассивПользователей.Добавить(ВыборкаКонтролируемые.Ссылка);
						КонецЕсли;	
						
					КонецЦикла;	
					//-- #Б-7838 смарт: Фролов 12.08.2026
						
				КонецЕсли;
					
				МассивАдресовДляОтправки = Новый Массив;	
				
				Если НЕ МассивПользователей = Неопределено Тогда
					
					Для Каждого Пользователь Из МассивПользователей Цикл
						
						МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
						АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
						
					КонецЦикла;
					
				КонецЕсли;
				//-- #Б-6630 смарт: Фролов 28.05.2026
	
				Если МассивАдресовДляОтправки.Количество() = 0 Тогда
					
					МассивАдресовДляОтправки=смартОбщегоНазначения.смартПолучитьАдресаПолучателейУведомлений(Справочники.смартПредопределенныеЗначения.ПолучателиОтчетаПоРаспределениюЛидов, АдресаДляОтправкиСтрокой);
					
				КонецЕсли;
				//-- #Б-3858 смарт: Фролов 21.07.2025
				
				//++ #Б-2042 смарт: Фролов 04.02.2025 //Уведомления о Лидах и Интересах
				//++ #1790 смарт: Фролов 23.04.2024 //Оповещение руководителей подразделений о неудачно завершенных Интересах их сотрудников по почте.
				//ЦФО=Справочники.смартПредопределенныеЗначения.ЦентральныйФО.Значение;
				ГоловнойОфисМосква=Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение;
				ПодразделениеПользователя = Ответственный.Подразделение;
				МассивАдресовРуководителей = Новый Массив;
				
				//Если ЗначениеЗаполнено(ПодразделениеПользователя) И НЕ ПодразделениеПользователя = ЦФО И Вариант = "ПисьмоОНеудачномЗавершении" Тогда
				Если ЗначениеЗаполнено(ПодразделениеПользователя) И НЕ ПодразделениеПользователя = ГоловнойОфисМосква Тогда	
				//-- #Б-2042 смарт: Фролов 04.02.2025	
					
					Если ЗначениеЗаполнено(ПодразделениеПользователя.ТекущийРуководитель) Тогда
						
						МассивАдресовРуководителей = смартОбщегоНазначения.ПолучитьАдресПользователяПоФизЛицу(ПодразделениеПользователя.ТекущийРуководитель, АдресаДляОтправкиСтрокой);	
						
					КонецЕсли;	
					
				КонецЕсли;
				
				ТекКвалификация = ?(ЗначениеЗаполнено(смартИтоговаяКвалификация), смартИтоговаяКвалификация, смартПредварительнаяКвалификация);
				
				МассивАдресовПоКвалифиации = смартОбщегоНазначения.ПолучитьАдресаПолучателейУведомленийПоКвалификации(ТекКвалификация, АдресаДляОтправкиСтрокой);
				
				Для Каждого СтрМассивАдресовПоКвалифиации Из МассивАдресовПоКвалифиации Цикл
					МассивАдресовДляОтправки.Добавить(СтрМассивАдресовПоКвалифиации);	
				КонецЦикла;	
				//-- #1790 смарт: Фролов 23.04.2024
				
				ТекстПисьма = "";
				
				НавСсылка=ПолучитьНавигационнуюСсылку(Ссылка);
				
				Если ТипЗнч(Лид.ДокументОснование) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее") Тогда
					
					Если Лид.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
						ТекстСодержания = Взаимодействия.ПолучитьОбычныйТекстИзHTML(Лид.ТекстИсточника);
					Иначе	
						ТекстСодержания = Лид.ТекстИсточника;
					КонецЕсли;
					
				Иначе
					
					ТекстСодержания = Лид.ТекстИсточника;
					
				КонецЕсли;
				
				Если Вариант = "ПисьмоОНеудачномЗавершении" Тогда
					
					ТемаПисьма = "Интерес завершен неудачно";
					
					ТекстПисьма = ТекстПисьма + "/--------------------------------------------------------------/" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Интерес завершен неудачно: " + Символы.ПС + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " | " + Тема + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Тип услуги: " + ТипУслуги + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Навигационная ссылка на документ: " + НавСсылка + "" + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Текущий этап: " + СостояниеИнтереса + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Менеджер: " + Ответственный + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Причина: " + ПричинаОтказа + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Комметарий менеджера: " + ПричинаОтказаКомментарий + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "=================================================================================" + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + ТекстСодержания + Символы.ПС;
					
				Иначе
					
					ТемаПисьма = "Интерес квалифицирован";
					
					ТекстПисьма = ТекстПисьма + "/--------------------------------------------------------------/" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Интерес квалифицирован: " + Символы.ПС + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy") + " | " + Тема + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Тип услуги: " + ТипУслуги + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Навигационная ссылка на документ: " + НавСсылка + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Текущий этап: " + СостояниеИнтереса + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Менеджер: " + Ответственный + "" + Символы.ПС;
					//++ #1909 смарт: Фролов 09.07.2024 //Организовать корректный пересчет валют в Интересе.
					ТекстПисьма = ТекстПисьма + "Ожидаемая выручка: " + смартОжидаемаяВыручкаВВалютеДокумента + " " + Валюта + Символы.ПС;
					//-- #1909 смарт: Фролов 09.07.2024
					ТекстПисьма = ТекстПисьма + "Ожидаемая дата продажи: " + Формат(ОжидаемаяДатаПродажи, "ДФ=dd.MM.yyyy") + "" + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "Описание потребности: " + Описание + "" + Символы.ПС;
					ТекстПисьма = ТекстПисьма + "=================================================================================" + Символы.ПС + Символы.ПС;
					ТекстПисьма = ТекстПисьма + ТекстСодержания + Символы.ПС;
					
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(УчетнаяЗапись)
					И (ТестовыеАдресаМассив.Количество() > 0
					ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
					
					ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
					ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, МассивАдресовРуководителей, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
					
					УстановитьПривилегированныйРежим(Истина);
					
					Попытка
						
						//++ #1772 смарт: Фролов 11.04.2024 //Отправка сообщений о квалификации Интересов успешных и не успешных конкретному получателю по указанным менеджерам
						Если НЕ МассивКонтролируемых.Найти(Ответственный) = Неопределено Тогда
							
							//++ #Б-3480 смарт: Фролов 02.06.2025 //Добавить нескольких получателей рассылки при закрытии интересов.
							//АдресКонтролера = Справочники.смартПредопределенныеЗначения.КонтролерРезультатовОбрабооткиИнтересов.Значение;
							//
							//Если ЗначениеЗаполнено(АдресКонтролера) Тогда
							//	
							//	МассивАдресов = Новый Массив;
							//	
							//	МассивАдресов.Добавить(Новый Структура("Адрес,Представление", АдресКонтролера, АдресКонтролера));
							//	
							//	ПараметрыПисьма.Вставить("СкрытыеКопии", МассивАдресов);
							//
							//КонецЕсли;
							
							МассивАдресов = Новый Массив;
							
							Для Каждого Пользователь Из МассивКонтролеров Цикл
								
								МассивАдресов.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, 
									Пользователь.смартРабочаяПочта));

							КонецЦикла;
								
							ПараметрыПисьма.Вставить("СкрытыеКопии", МассивАдресов);
							//-- #Б-3480 смарт: Фролов 02.06.2025
								
						КонецЕсли;	
						//-- #1772 смарт: Фролов 11.04.2024
						
						ИдентификаторОснования = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
						
						НаборЗаписей = РегистрыСведений.смартСвязьИнтересаСПочтовымиСообщениями.СоздатьНаборЗаписей();
						НаборЗаписей.Отбор.Интерес.Установить(Ссылка);
						НаборЗаписей.Отбор.ИдентификаторОснования.Установить(ИдентификаторОснования);
						НаборЗаписей.Прочитать();
						
						Если НаборЗаписей.Количество() = 0 Тогда
							
							СтрНаборЗаписей = НаборЗаписей.Добавить();
							СтрНаборЗаписей.Интерес = Ссылка;
							СтрНаборЗаписей.ИдентификаторОснования = ИдентификаторОснования;
							СтрНаборЗаписей.Отправитель = УчетнаяЗапись;
							
							НаборЗаписей.Записать();
							
						КонецЕсли;	
						
						Если ПараметрыПисьма.ТестоваяБаза Тогда
							ТекстСообщения = "Отправлено письмо, " + ?(Вариант="ПисьмоОНеудачномЗавершении", " о не удачном завершении интереса", " о квалафикации интереса") 
							+ ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
						Иначе
							ТекстСообщения = "Отправлено письмо, " + ?(Вариант="ПисьмоОНеудачномЗавершении", " о не удачном завершении интереса", " о квалафикации интереса") + АдресаДляОтправкиСтрокой;
						КонецЕсли;
						
						ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
						
					Исключение
						
