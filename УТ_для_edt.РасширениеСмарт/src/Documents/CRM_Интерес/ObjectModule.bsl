		//	
		//КонецЦикла;	
		//
		//ЗадачаОбъект.СрокИсполнения = ДатаПроверки;
		//++ #Б-4374 смарт: Фролов 17.09.2025 //Ошибка ЖР. Документ Интерес 
 		ЗадачаОбъект.СрокИсполнения = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ТекущаяДата(), 3, "Вперед");
		//ЗадачаОбъект.СрокИсполнения = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноТекущей(ТекущаяДата(), 3, "Вперед");
		//-- #Б-4374 смарт: Фролов 17.09.2025
		//-- #Б-4290 смарт: Фролов 11.09.2025
		
		ЗадачаОбъект.смартВидЗадачи = Справочники.смартВидыЗадач.ПолучитьПодписанныйДоговор;
		
