//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
&НаСервере
Процедура смартСохранитьРеквизитыФормы(Настройки)

	Если смартИспользоватьСохраненныеНастройки(ЭтотОбъект.Параметры) Тогда

		МассивСохраняемыхРеквизитов = Новый Массив;
		
		МассивСохраняемыхРеквизитов.Добавить("смартКвалификация");
		МассивСохраняемыхРеквизитов.Добавить("смартНаблюдает");
		МассивСохраняемыхРеквизитов.Добавить("смартНаКонтроле");
		МассивСохраняемыхРеквизитов.Добавить("смартНовые");
		МассивСохраняемыхРеквизитов.Добавить("смартСтарые");
		МассивСохраняемыхРеквизитов.Добавить("смартТипУслуги");
		МассивСохраняемыхРеквизитов.Добавить("ОтборПользователь");
		МассивСохраняемыхРеквизитов.Добавить("ОтборКонтрагент");

		Для Каждого СохраняемыйРеквизит Из МассивСохраняемыхРеквизитов Цикл

			Если ТипЗнч(ЭтотОбъект[СохраняемыйРеквизит]) = Тип("СписокЗначений") Тогда
				Настройки.Вставить(СохраняемыйРеквизит, ЭтотОбъект[СохраняемыйРеквизит].ВыгрузитьЗначения());
			Иначе
				Настройки.Вставить(СохраняемыйРеквизит, ЭтотОбъект[СохраняемыйРеквизит]);
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;	

КонецПроцедуры //-- #1910 смарт: Лопато 07.08.2024

//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
&НаСервере
Процедура смартВосстановитьРеквизитыФормы(Настройки)

	Если смартИспользоватьСохраненныеНастройки(ЭтотОбъект.Параметры) Тогда

		МассивСохраняемыхРеквизитов = Новый Массив;
		
		МассивСохраняемыхРеквизитов.Добавить("смартКвалификация");
		МассивСохраняемыхРеквизитов.Добавить("смартНаКонтроле");
		МассивСохраняемыхРеквизитов.Добавить("смартНаблюдает");
		МассивСохраняемыхРеквизитов.Добавить("смартНовые");
		МассивСохраняемыхРеквизитов.Добавить("смартСтарые");
		МассивСохраняемыхРеквизитов.Добавить("смартТипУслуги");
		МассивСохраняемыхРеквизитов.Добавить("ОтборПользователь");
		МассивСохраняемыхРеквизитов.Добавить("ОтборКонтрагент");

		Для Каждого СохраняемыйРеквизит Из МассивСохраняемыхРеквизитов Цикл
			
			НастройкаСохраняемыйРеквизит = Настройки.Получить(СохраняемыйРеквизит);
			
			Если ТипЗнч(ЭтотОбъект[СохраняемыйРеквизит]) = Тип("СписокЗначений") Тогда
				
				Если ТипЗнч(НастройкаСохраняемыйРеквизит) = Тип("Массив") Тогда
					ЭтотОбъект[СохраняемыйРеквизит].ЗагрузитьЗначения(НастройкаСохраняемыйРеквизит);
				КонецЕсли;	
				
			Иначе

				ЭтотОбъект[СохраняемыйРеквизит] = НастройкаСохраняемыйРеквизит;
				
			КонецЕсли;	

		КонецЦикла;	
		
	Иначе

		ЭтотОбъект["смартНаблюдает"] 	= Неопределено;
		ЭтотОбъект["ОтборПользователь"] = Неопределено;
		
	КонецЕсли;	

КонецПроцедуры //-- #1910 смарт: Лопато 07.08.2024

//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
&НаКлиентеНаСервереБезКонтекста
Функция смартИспользоватьСохраненныеНастройки(Знач ПараметрыФормы)

	Возврат НЕ ((ПараметрыФормы.Свойство("Отбор") И ПараметрыФормы.Отбор.Свойство("Партнер"))
				 ИЛИ (ПараметрыФормы.Свойство("РежимВыбора") И ПараметрыФормы.РежимВыбора));
				
КонецФункции //-- #1910 смарт: Лопато 07.08.2024

//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
&НаКлиенте
Процедура смартУстановитьОтборы()
	
	Список.Параметры.УстановитьЗначениеПараметра("смартНаКонтроле", ЭтотОбъект.смартНаКонтроле);
	Список.Параметры.УстановитьЗначениеПараметра("смартНаблюдает",  ЭтотОбъект.смартНаблюдает);
	
	Если ЭтотОбъект.смартКвалификация.Количество() Тогда
		
		смартКвалификацияГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
										Список.Отбор,
										"смартКвалификацияГруппаИли",
										ТипГруппыЭлементовОтбораКомпоновкиДанных .ГруппаИли);
										
		смартКвалификацияГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
										смартКвалификацияГруппаИли,
										"смартКвалификацияГруппаИ",
										ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
			смартКвалификацияГруппаИ,
			"смартИтоговаяКвалификация",
			Неопределено,
			ВидСравненияКомпоновкиДанных.НеЗаполнено, 
			"смартИтоговаяКвалификация_НеЗаполнено",
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
			смартКвалификацияГруппаИ,
			"смартПредварительнаяКвалификация",
			ЭтотОбъект.смартКвалификация,
			ВидСравненияКомпоновкиДанных.ВСписке, 
			,
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);						
			
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
			смартКвалификацияГруппаИли,
			"смартИтоговаяКвалификация",
			ВидСравненияКомпоновкиДанных.ВСписке, 
			ЭтотОбъект.смартКвалификация,
			"смартИтоговаяКвалификация_ВСписке",
			Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);								
			
	КонецЕсли;
	
	Если Не (ЭтотОбъект.смартНовые И ЭтотОбъект.смартСтарые)
		И (ЭтотОбъект.смартНовые Или ЭтотОбъект.смартСтарые) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"смартВоронкаНовые",
			ЭтотОбъект.смартНовые,
			ВидСравненияКомпоновкиДанных.Равно, 
			,
			ЭтотОбъект.смартНовые,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"смартВоронкаСтарые",
			ЭтотОбъект.смартСтарые,
			ВидСравненияКомпоновкиДанных.Равно, 
			,
			ЭтотОбъект.смартСтарые,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

	КонецЕсли;

	Если ЭтотОбъект.смартТипУслуги.Количество() Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "ТипУслуги", ЭтотОбъект.смартТипУслуги, Истина, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборКонтрагент) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Партнер", ОтборКонтрагент, Истина);
	Иначе	
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Партнер");
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборПользователь) Тогда
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Ответственный", ОтборПользователь, Истина);
	Иначе	
		CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Список, "Ответственный");
	КонецЕсли;
	
КонецПроцедуры //-- #1910 смарт: Лопато 07.08.2024

