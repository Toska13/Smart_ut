//++ #Б-976 смарт: Фролов 22.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. CRM_Интерес
Процедура смартЗаполнитьТаблицуЗаметок(Партнер, Автор = Неопределено)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Заметки.ДатаЗаметки КАК ДатаЗаметки,
	|	Заметки.Автор КАК Автор,
	|	Заметки.ТекстСодержания КАК Содержания,
	|	CRM_Интерес.Партнер КАК Предмет,
	|	Заметки.Ссылка КАК Ссылка,
	|	CRM_Интерес.Ссылка КАК Интерес
	|ИЗ
	|	Документ.CRM_Интерес КАК CRM_Интерес
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Заметки КАК Заметки
	|		ПО CRM_Интерес.Партнер = Заметки.Предмет
	|ГДЕ
	|	CRM_Интерес.Партнер = &Партнер
	|	И 1 = 1
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаметки УБЫВ");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Если НЕ Автор = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "Заметки.Автор = &Автор");
		Запрос.УстановитьПараметр("Автор", Автор);
	КонецЕсли;	
	
	ЭтаФорма.смартЗаметки.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры //-- #Б-976 смарт: Фролов 22.10.2024

