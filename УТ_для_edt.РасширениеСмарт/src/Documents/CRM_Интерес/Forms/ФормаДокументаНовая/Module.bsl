	#Вставка
	//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
	смартСформироватьЗаголовокДополнительнойГарантии();
	//-- #1944 смарт: Мосолов 26.07.2024 
	#КонецВставки

КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
&ИзменениеИКонтроль("ТоварыПриОкончанииРедактирования")
Процедура смарт_ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	РассчитатьИтоговыеПоказателиКоммерческогоПредложения(ЭтаФорма);
	
	#Вставка
	//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
	смартСформироватьЗаголовокДополнительнойГарантии();
	//-- #1944 смарт: Мосолов 26.07.2024 
	#КонецВставки

КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Процедура смартСформироватьЗаголовокДополнительнойГарантии()

	ЭтапКвалифицирован = Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000041");
	
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И ТекущаяДата() >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение
		И Объект.ТипУслуги = ПредопределенноеЗначение("Справочник.CRM_ТипУслуги.ПоставкаТоварыУслуги")
		И ЗначениеЗаполнено(Объект.СостояниеИнтереса)
		И Объект.СостояниеИнтереса.Родитель = Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000035")
		И Объект.СостояниеИнтереса.РеквизитДопУпорядочивания >= ?(ЗначениеЗаполнено(ЭтапКвалифицирован), ЭтапКвалифицирован.РеквизитДопУпорядочивания, 0) 
		И Объект.СостояниеИнтереса <> Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000037") 
		И Объект.СостояниеИнтереса <> Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000038") Тогда
		
		смартОбщегоНазначения.ИзменитьВидимостьЗаголовокДополнительнойГарантии(ЭтаФорма, 
			Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС"),
			Объект.Ссылка,
			Объект.Валюта);
		
	КонецЕсли;  
		
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И ТекущаяДата() >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение
		И Не Объект.Завершен
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов")
		И ЗначениеЗаполнено(Объект.ДокументОснование.ДокументОснование)
		И ЗначениеЗаполнено(Объект.ДокументОснование.ДокументОснование.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование.ДокументОснование.ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") 
		И (Объект.Дата - Объект.ДокументОснование.ДатаПодписанияАктаНаПНР) / 24/ 60 / 60 < 365 Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Серия", Объект.ДокументОснование.Серия);
		Запрос.УстановитьПараметр("Заказ", Объект.ДокументОснование.ДокументОснование.ДокументОснование);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	0 КАК НомерСтроки,
		|	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
		|	ЗаказКлиентаТовары.СуммаСНДС КАК СуммаСНДС,
		|	ЗаказКлиентаТовары.Ссылка.Валюта КАК Валюта
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Серия = &Серия
		|	И ЗаказКлиентаТовары.Ссылка = &Заказ";   
		
		ТаблицаДокумента = Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС");
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТовара = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, Выборка);
			
			Если Объект.Валюта <> Выборка.Валюта Тогда
				
				СтрокаТовара.СуммаСНДС = РаботаСКурсамиВалют.ПересчитатьВВалюту(СтрокаТовара.СуммаСНДС,
					Выборка.Валюта,
					Объект.Валюта,
					Объект.ДокументОснование.Дата);
					
			КонецЕсли;
			
		КонецЦикла;

		смартОбщегоНазначения.ИзменитьВидимостьЗаголовокДополнительнойГарантии(ЭтаФорма, ТаблицаДокумента, Объект.Ссылка, Объект.Валюта); 
		
	КонецЕсли;

КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024   

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
Процедура смартТекстДопУсловийОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//++ #2059 смарт: Мосолов 19.09.2024 // Подсказка для документов Интерес и Заказ клиента при первоначальной продажи Доп. гарантии 
	Если СокрЛП(НавигационнаяСсылкаФорматированнойСтроки) = "?" Тогда  
		Элементы.смартГруппаПодсказкаДопГарантии.Показать();
		Возврат;
	КонецЕсли;
	//-- #2059 смарт: Мосолов 19.09.2024  
	
	МассивСтрок = СтрРазделить(НавигационнаяСсылкаФорматированнойСтроки, ";");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НомерСтроки", Число(МассивСтрок[0]));
	СтруктураПараметров.Вставить("МесяцевГарантии", МассивСтрок[1]);
	СтруктураПараметров.Вставить("Цена", МассивСтрок[2]);
	
	Оповещение = Новый ОписаниеОповещения("смартЗавершениеВопросаДобавлениеГарантии", 
		ЭтотОбъект,
		СтруктураПараметров);
		
	Товар = смартПолучитьНоменклатуруИзСтроки(Число(МассивСтрок[0]));   
	
	ТекстВопроса = "Вы хотите добавить дополнительную гарантию для номенклатуры "
		+ Товар
		+ " сроком на "
		+ МассивСтрок[1] 
		+ " месяцев?";
		
	ПоказатьВопрос(Оповещение,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
Процедура смартЗавершениеВопросаДобавлениеГарантии(Результат, ПараметрыВопроса) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

   смартДобавитьСтрокуГарантии(ПараметрыВопроса.НомерСтроки, ПараметрыВопроса.МесяцевГарантии, ПараметрыВопроса.Цена);
   
   смартСформироватьЗаголовокДополнительнойГарантии(); 
   ОбновитьЗаголовокГруппыТовары();
   
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Функция смартПолучитьНоменклатуруИзСтроки(НомерСтроки) 
	
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов") Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Серия", Объект.ДокументОснование.Серия);
		Запрос.УстановитьПараметр("Заказ", Объект.ДокументОснование.ДокументОснование.ДокументОснование);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Серия = &Серия
		|	И ЗаказКлиентаТовары.Ссылка = &Заказ"; 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Возврат Выборка.Номенклатура;
			
		КонецЕсли;   
		
	Иначе
		
		Отбор = Новый Структура("НомерСтроки", НомерСтроки);
		
		СтрокиТоваров = Объект.Товары.НайтиСтроки(Отбор);
		
		Возврат СтрокиТоваров[0].Номенклатура; 
		
	КонецЕсли;
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Процедура смартДобавитьСтрокуГарантии(НомерСтроки, МесяцевГарантии, Цена) 
	
	СтрокаГарантии = Объект.Товары.Добавить();
	СтрокаГарантии.Номенклатура = Справочники.смартПредопределенныеЗначения.НоменклатураДополнительнойГарантии.Значение;
	
	Товар = смартПолучитьНоменклатуруИзСтроки(НомерСтроки);  
	
	Цена = СтрЗаменить(Цена, " ", "");
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(
		Товар.Наименование + " - " + МесяцевГарантии + " мес. " + "(" + Товар.Код + ")"
		,
		,
		,
		СтрокаГарантии.Номенклатура.ВидНоменклатуры);
		
	Если Характеристика.Пустая() Тогда   
			
		Характеристика = смартСоздатьХарактеристикуДопГарантии(СтрокаГарантии.Номенклатура, 
			Товар.Наименование + " - " + МесяцевГарантии + " мес. " + "(" + Товар.Код + ")",
			МесяцевГарантии,
			Товар.Наименование + " - " + МесяцевГарантии + " мес.");   
			
			
		смартОбщегоНазначения.СоздатьУстановкуЦенДляДопГарантии(СтрокаГарантии.Номенклатура, Характеристика, Число(Цена), Объект.Дата);
			
	КонецЕсли;
		
	СтрокаГарантии.Характеристика = Характеристика;
	СтрокаГарантии.ВидЦены = Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяRUB");
	СтрокаГарантии.КоличествоУпаковок = 1;
	СтрокаГарантии.Количество = 1;

	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	КэшированныеЗначения = Новый Структура;
    КэшированныеЗначения.Вставить("ИспользоватьРучныеСкидкиВПродажах", Истина);
    КэшированныеЗначения.Вставить("ИспользоватьАвтоматическиеСкидкиВПродажах", Неопределено);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаГарантии.Характеристика);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", СтрокаГарантии.Упаковка);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияЦеныВСтрокеТЧ(Объект));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата", Объект.НалогообложениеНДС, Объект.Дата));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());

	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ЭтаФорма.ИмяФормы, "Товары"));
	
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаГарантии, СтруктураДействий, КэшированныеЗначения); 
	
	СтрокаГарантии.Сумма = Число(Цена);
	
	СтруктураПересчетаЦены  = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект, 
		ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.ПередачаНаКомиссию"));
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах", СтруктураПересчетаЦены);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаГарантии, СтруктураДействий, КэшированныеЗначения);
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Функция смартСоздатьХарактеристикуДопГарантии(Товар, НаименованиеХарактеристики, МесяцевГарантии, НаименованиеДляПечати)  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Товар.ВидНоменклатуры;
	Характеристика.Наименование = НаименованиеХарактеристики;
	Характеристика.НаименованиеПолное = НаименованиеДляПечати;
	Характеристика.смартСрокГарантии = Число(МесяцевГарантии);
	Характеристика.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Характеристика.Ссылка;
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024

//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
&НаСервере
&ИзменениеИКонтроль("ПолучитьСписокСостоянийСервер")
Функция смарт_ПолучитьСписокСостоянийСервер(ТекСостояние)

	СписокСостояний = Новый СписокЗначений;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	CRM_СостоянияИнтересов.Ссылка КАК Ссылка,
	|	CRM_СостоянияИнтересов.ВероятностьСделки КАК ВероятностьСделки,
	|	CRM_СостоянияИнтересов.Наименование КАК Наименование,
	|	CRM_СостоянияИнтересов.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания,
	|	CRM_СостоянияИнтересов.Представление КАК Представление,
	|	CRM_СостоянияИнтересов.Завершено КАК Завершено,
	|	CRM_СостоянияИнтересов.ВидСостояния КАК ВидСостояния
	|ИЗ
	|	Справочник.CRM_СостоянияИнтересов КАК CRM_СостоянияИнтересов
	|ГДЕ
	|	CRM_СостоянияИнтересов.ПометкаУдаления = ЛОЖЬ
	|	И CRM_СостоянияИнтересов.ВидДела = ЗНАЧЕНИЕ(Справочник.CRM_ВидыДелВзаимодействий.Документ_CRM_Интерес)
	|	И CRM_СостоянияИнтересов.Родитель = &Родитель
	|	И CRM_СостоянияИнтересов.Используется
	#Вставка
	//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
	|	И НЕ CRM_СостоянияИнтересов.смартТипыУслуг.ТипУслуги = &ТипУслугиИнтерес
	//-- #1945 смарт: Лопато 06.08.2024
	#КонецВставки
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеквизитДопУпорядочивания";
	
	Запрос.УстановитьПараметр("Родитель", ТекСостояние.Родитель);
	
	#Вставка
	//++ #1945 смарт: Лопато 06.08.2024 //Убрать видимость определенных этапов в интересе при продаже запчастей.  
	Запрос.УстановитьПараметр("ТипУслугиИнтерес", Объект.ТипУслуги);
	//-- #1945 смарт: Лопато 06.08.2024
	#КонецВставки
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТекСостояние = Неопределено Тогда
			СписокСостояний.Добавить(Выборка.Ссылка, Выборка.Представление);
		Иначе
			Если Выборка.Ссылка = ТекСостояние Тогда
				КартинкаСостояния = БиблиотекаКартинок.сфпКлиентОжидание;
			ИначеЕсли Выборка.РеквизитДопУпорядочивания<ТекСостояние.РеквизитДопУпорядочивания И НЕ Выборка.Завершено Тогда
				КартинкаСостояния = БиблиотекаКартинок.CRM_Выполнено;
			ИначеЕсли Выборка.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.УспешноеЗавершение Тогда
				КартинкаСостояния = БиблиотекаКартинок.CRM_УспешноеЗавершение;
			ИначеЕсли Выборка.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение Тогда
				КартинкаСостояния = БиблиотекаКартинок.CRM_НеудачноеЗавершение;
			Иначе
				КартинкаСостояния = Неопределено;
			КонецЕсли;
			СписокСостояний.Добавить(Выборка.Ссылка, Выборка.Представление,, КартинкаСостояния);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокСостояний;
	
КонецФункции

//++ #1960 смарт: Мосолов 08.08.2024 // Создание механизма для учета продаж по Доп. гарантии и спец предложений&НаСервере
&НаСервере
&ИзменениеИКонтроль("ПослеЗаписиНаСервере")
Процедура смарт_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// +CRM_Модуль
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ЗаполнитьПризнакХарактеристикиИспользуются", Новый Структура("Номенклатура", "ХарактеристикиИспользуются"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	НоменклатураСервер.ЗаполнитьСлужебныеРеквизитыПоНоменклатуреВКоллекции(Объект.Товары, СтруктураДействий);
	НаборыСервер.ЗаполнитьСлужебныеРеквизиты(ЭтаФорма);

	ОбщегоНазначенияУТ.ЗаполнитьДубликатыЗависимыхРеквизитовВКоллекции(Объект.Товары, ЗависимыеРеквизиты());

	ДанныеВыбранногоСостоянияИнтереса = Неопределено;
	// -CRM_Модуль

	// +CRM
	Элементы.ГруппаПричинаОтказа.Видимость = (Объект.СостояниеИнтереса.ВидСостояния = Перечисления.CRM_ВидыСостоянияИнтереса.НеудачноеЗавершение);
	CRM_СобытияФорм.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// -CRM
	
	#Вставка
	//++ #1960 смарт: Мосолов 08.08.2024 // Создание механизма для учета продаж по Доп. гарантии и спец предложений&НаСервере
	ЭтапКвалифицирован = Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000041");
	
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И ТекущаяДата() >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение
		И Объект.ТипУслуги = ПредопределенноеЗначение("Справочник.CRM_ТипУслуги.ПоставкаТоварыУслуги")
		И ЗначениеЗаполнено(Объект.СостояниеИнтереса)
		И Объект.СостояниеИнтереса.Родитель = Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000035")
		И Объект.СостояниеИнтереса.РеквизитДопУпорядочивания >= ?(ЗначениеЗаполнено(ЭтапКвалифицирован), ЭтапКвалифицирован.РеквизитДопУпорядочивания, 0) 
		И Объект.СостояниеИнтереса <> Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000037") 
		И Объект.СостояниеИнтереса <> Справочники.CRM_СостоянияИнтересов.НайтиПоКоду("00000038") Тогда  
		
		РегистрыСведений.смартУчетСпециальныхПредложенийКлиентам.ЗаписатьНаборЗаписейПоГарантии(
			Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС"),
			Объект.Ссылка,
			Объект.Валюта);  
			
		смартСформироватьЗаголовокДополнительнойГарантии();     
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И ТекущаяДата() >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение
		И Не Объект.Завершен
		И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов")
		И ЗначениеЗаполнено(Объект.ДокументОснование.ДокументОснование)
		И ЗначениеЗаполнено(Объект.ДокументОснование.ДокументОснование.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование.ДокументОснование.ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") 
		И (Объект.Дата - Объект.ДокументОснование.ДатаПодписанияАктаНаПНР) / 24/ 60 / 60 < 365 Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Серия", Объект.ДокументОснование.Серия);
		Запрос.УстановитьПараметр("Заказ", Объект.ДокументОснование.ДокументОснование.ДокументОснование);
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	0 КАК НомерСтроки,
		|	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
		|	ЗаказКлиентаТовары.СуммаСНДС КАК СуммаСНДС
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Серия = &Серия
		|	И ЗаказКлиентаТовары.Ссылка = &Заказ"; 

		ТаблицаДокумента = Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС");
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТовара = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, Выборка);
			
		КонецЦикла;

		РегистрыСведений.смартУчетСпециальныхПредложенийКлиентам.ЗаписатьНаборЗаписейПоГарантии(ТаблицаДокумента, Объект.Ссылка, Объект.Валюта);  
		
		смартСформироватьЗаголовокДополнительнойГарантии();     
	
	КонецЕсли;
	//-- #1960 смарт: Мосолов 08.08.2024
	#КонецВставки   
	
КонецПроцедуры //-- #1960 смарт: Мосолов 08.08.2024

