//++ #Б-1218 смарт: Фролов 28.10.2024 //Регистрация в ИМ. Лид-Интерес. Проверка наличия контрагента
Функция смартПолучитьМассивСвязанныхПартнеров(Партнер)
	
	Пока ЗначениеЗаполнено(Партнер.Родитель) Цикл
		
		Партнер = Партнер.Родитель;
		
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Партнеры
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&Партнер)");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	
	МассивПартнеров = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивПартнеров;
	
КонецФункции //-- #Б-1218 смарт: Фролов 28.10.2024	

&НаКлиенте
//++ #Б-986 смарт: Фролов 23.09.2024 //ИМ. Регистрация пользователя на сайте
Процедура смартПодтвердитьПользователя(Команда)

	МожноПодтвердить = Истина;
	
	//++ #Б-1216 смарт: Фролов 28.10.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
	ВыбраноКонтактноеЛицо = Истина;
	//-- #Б-1216 смарт: Фролов 28.10.2024
	
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен партнер, подтверждение невозможно!", , "Объект.Партнер");
		МожноПодтвердить = Ложь;
		
	Иначе
		
		//++ #Б-1216 смарт: Фролов 28.10.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
		НужнаяЭлектроннаяПочта = CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ЭлектроннаяПочта"); 
		//++ #Б-4186 смарт: Фролов 27.08.2025 //ОШИБКА. При открытии интереса с типом - Регистрация пользователя ИМ.
		//НужныйТелефон = CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Телефон");
		НужныйТелефон = ОбщегоНазначенияБПКлиентСервер.ОставитьВСтрокеТолькоЦифры(CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Телефон"));
		//-- #Б-4186 смарт: Фролов 27.08.2025
		
		МассивКонтактныхЛицИмеющихсяНаСайте = смартНайтиКонтактПоЭлПочтеИТелефону(Новый 
			Структура("НужнаяЭлектроннаяПочта, НужныйТелефон, ОтобратьИмеющиесяНаСайте", НужнаяЭлектроннаяПочта, НужныйТелефон, Истина));
		
		Если МассивКонтактныхЛицИмеющихсяНаСайте.Количество() = 0 Тогда
			
			МассивКонтактныхЛиц = смартНайтиКонтактПоЭлПочтеИТелефону(Новый 
				Структура("НужнаяЭлектроннаяПочта, НужныйТелефон, ОтобратьИмеющиесяНаСайте", НужнаяЭлектроннаяПочта, НужныйТелефон, Ложь));
			
			Если МассивКонтактныхЛиц.Количество() = 0 Тогда
				
				ТекстСообщения = "Не найдено ни одного контактного лица Клиента с таким телефоном " 
					+ НужныйТелефон + " и почтой " + НужнаяЭлектроннаяПочта + "Пожалуйста откройте список контактных лиц клиента и 
					|создайте новое контактное лицо, либо дополните контактную информацию в имеющемся.";
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Объект.КонтактноеЛицо");
				
				МожноПодтвердить = Ложь;
				
			ИначеЕсли МассивКонтактныхЛиц.Количество() > 1 Тогда
				
				СписокВыборкаКонтактныхЛиц = Новый СписокЗначений;
				СписокВыборкаКонтактныхЛиц.ЗагрузитьЗначения(МассивКонтактныхЛиц);
				ТекстСообщения = "Найдено более одного контактного лица с такими телефон и почта. 
					|Пожалуйста выберите корректное контактное лицо в качестве пользователя Интернет-магазина. 
					|Либо очистите контактные данные у второго, чтобы не было одинаковых карточек с парой телефон + почта.";
				
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				
				ВыбранноеКонтактноеЛицо = СписокВыборкаКонтактныхЛиц.ВыбратьЭлемент("Выберите контактное лицо");
				
				Если ВыбранноеКонтактноеЛицо = Неопределено Тогда
					
					ТекстСообщения = "Не найдено ни одного контактного лица Клиента с таким телефоном и почтой. 
						|Пожалуйста откройте список контактных лиц клиента и создайте новое контактное лицо,
						|либо дополните контактную информацию в имеющемся";
					
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
					
					ВыбраноКонтактноеЛицо = Ложь;
					
				Иначе
					
					Объект.КонтактноеЛицо = ВыбранноеКонтактноеЛицо.Значение;
					
				КонецЕсли;
				
			ИначеЕсли МассивКонтактныхЛиц.Количество() = 1 Тогда	
				
				Объект.КонтактноеЛицо = МассивКонтактныхЛиц[0];	
				
			КонецЕсли;
			
		ИначеЕсли МассивКонтактныхЛицИмеющихсяНаСайте.Количество() > 1 Тогда
			
			ТекстСообщения = "Найдены пользователи с такими регисрационными 
				|данными, которые уже присутствуют в качестве пользователей Интернет-магазина. 
				|Найдено Контактные лица:";
			Для Каждого Стр Из МассивКонтактныхЛицИмеющихсяНаСайте Цикл
				ТекстСообщения = ТекстСообщения + Стр + " у Клиента " + 
					CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Стр, "Владелец");
			КонецЦикла;
			ТекстСообщения = ТекстСообщения + "Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
			МожноПодтвердить = Ложь;
				
			Элементы.смартПодтвердить.Видимость = Ложь;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
		Иначе	
			
			Если CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(МассивКонтактныхЛицИмеющихсяНаСайте[0], "Владелец") = Объект.Партнер Тогда
				
				ТекстСообщения = "Пользователь с такими регисрационными данными уже присутствует в качестве пользователя Интернет-магазина. 
					|Найдено Контактное лицо " + МассивКонтактныхЛицИмеющихсяНаСайте[0] + " у данного Клиента." + Символы.ПС + 
					"Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
				
			Иначе
				
				ТекстСообщения = "Пользователь с такими регисрационными данными уже присутствует в качестве пользователя Интернет-магазина. 
					|Найдено Контактное лицо " + МассивКонтактныхЛицИмеющихсяНаСайте[0] + " у Клиента " +
					CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(МассивКонтактныхЛицИмеющихсяНаСайте[0], "Владелец") + "." + Символы.ПС + 
					"Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
			
			КонецЕсли;
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			Элементы.смартПодтвердить.Видимость = Ложь;
			
			МожноПодтвердить = Ложь;
			
		КонецЕсли;
		//-- #Б-1216 смарт: Фролов 28.10.2024
		
		//++ #Б-1214 смарт: Фролов 24.10.2024 //Регистрация в ИМ. Лид-Интерес. Проверка взаимодействия перед подтверждением
		РезультатПроверкиЗадачи = смартПроверитьНаличиеВыполненнойЗадачи();
		
		Если НЕ РезультатПроверкиЗадачи Тогда
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Не найдена выполненная задача ""Созвониться с клиентом"", подтверждение невозможно!");
			МожноПодтвердить = Ложь;
			
		КонецЕсли;
		//-- #Б-1214 смарт: Фролов 24.10.2024
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнен контрагент, подтверждение невозможно!", , "Объект.Контрагент");
		МожноПодтвердить = Ложь;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Контрагент) И ЗначениеЗаполнено(Объект.Партнер) Тогда
		
		//++ #Б-1218 смарт: Фролов 28.10.2024 //Регистрация в ИМ. Лид-Интерес. Проверка наличия контрагента
		МассивПартнеров = смартПолучитьМассивСвязанныхПартнеров(Объект.Партнер);
		
		Если МассивПартнеров.Найти(CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "Партнер")) = Неопределено Тогда
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Выбранный контрагент не соответствует партнеру!");
			МожноПодтвердить = Ложь;
			
		КонецЕсли;	
		//-- #Б-1218 смарт: Фролов 28.10.2024
		
	КонецЕсли;	
	
	Если МожноПодтвердить И ВыбраноКонтактноеЛицо Тогда //++ #Б-1216 смарт: Фролов 28.10.2024 //Добавлена проверка
		
		ТекстJSON = CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "JSON_ИМ_Регистрация");
		
		СтруктураПараметров = Новый Структура;СтруктураПараметров.Вставить("JSON", ТекстJSON);
		СтруктураПараметров.Вставить("РегистрацияПодтверждена", Истина);
		СтруктураПараметров.Вставить("ПричинаОтклоненияРегистрации", "");
		СтруктураПараметров.Вставить("КонтактноеЛицо", Объект.КонтактноеЛицо);
		СтруктураПараметров.Вставить("Партнер", Объект.Партнер);
		СтруктураПараметров.Вставить("Контрагент", Объект.Контрагент);
		СтрокаОшибки = смартИнтернетМагазин.ПодтвердитьРегистрациюПользователяНаСайте(СтруктураПараметров);
		
		Если СтрокаОшибки = "" Тогда
			
			Объект.смартСтатусРегистрацияПользователяНаСайте = 1;
			
			Записать();
			Элементы.смартПодтвердить.Видимость = Ложь;
			Элементы.смартОтклонить.Видимость = Ложь;
			
		Иначе
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаОшибки);
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры //-- #Б-986 смарт: Фролов 23.09.2024

