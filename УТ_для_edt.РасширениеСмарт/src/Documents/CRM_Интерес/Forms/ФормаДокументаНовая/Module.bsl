&НаСервере
&ИзменениеИКонтроль("ОбновитьЭлементыДополнительныхРеквизитов")
//++ #Б-976 смарт: Фролов 21.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. CRM_Интерес
Процедура смарт_ОбновитьЭлементыДополнительныхРеквизитов()

	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства")
		И ЭтотОбъект.Свойства_ИспользоватьСвойства И ЭтотОбъект.Свойства_ИспользоватьДопРеквизиты Тогда

		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);

		МассивОбъектовСДопРеквизитами = Новый Массив;

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаКонтейнерДопРеквизитовКлиента");
		ДополнительныеПараметры.Вставить("НеУчитыватьЗависимости", Истина);
		ДополнительныеПараметры.Вставить("Объект", Клиент_Объект);
		МассивОбъектовСДопРеквизитами.Добавить(ДополнительныеПараметры);

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаКонтейнерДопРеквизитовКонтакта");
		ДополнительныеПараметры.Вставить("НеУчитыватьЗависимости", Истина);
		ДополнительныеПараметры.Вставить("Объект", Контакт_Объект);
		МассивОбъектовСДопРеквизитами.Добавить(ДополнительныеПараметры);

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
		ДополнительныеПараметры.Вставить("Объект", Объект);
		МассивОбъектовСДопРеквизитами.Добавить(ДополнительныеПараметры);

		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("CRM_УправлениеСвойствами");
		#Удаление
		МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект, МассивОбъектовСДопРеквизитами);
		#КонецУдаления
		
		#Вставка
		//++ #1442 смарт: Фролов 04.10.2023 //Исправить добавление клиента в уже записанном Интересе (без клиента)
		//МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект, МассивОбъектовСДопРеквизитами);
		//++ #1571 смарт: Мосолов 11.12.2023 //Рефакторинг. Вызов переадресован на CRM_УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов_Расширенная
		//МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект, МассивОбъектовСДопРеквизитами,,Истина);
		МодульУправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов_Расширенная(ЭтотОбъект, МассивОбъектовСДопРеквизитами,,Истина);
		//-- #1571 смарт: Мосолов 11.12.2023
		//-- #1442 смарт: Фролов 04.10.2023
		#КонецВставки

		РазложитьДопРеквизитыПоКолонкам(МассивОбъектовСДопРеквизитами);
		ИзменитьСоставРеквизитов();
	КонецЕсли;
	// +CRM
	CRM_УправлениеСвойствами.ПослеОтрисовкиДополнительныхРеквизитов(ЭтотОбъект);
	// -CRM

КонецПроцедуры //-- #Б-Задача смарт: Фролов 21.10.2024

&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	//++ #Б1174 смарт: Шляпников 21.10.2024 / При открытии карточки партнера или интереса, проверять по телефонам контактов наличие дублей
	Если НЕ Объект.Партнер.Пустая() Тогда
		
		ДобавляемыеРеквизиты = Новый Массив; //Определяем массив добавляемых реквизитов
		НовыйРеквизит = Новый РеквизитФормы("АдресВременногоХранилища", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		НовыйРеквизит = Новый РеквизитФормы("ИдентификаторЗаданияПроверкиПартнера", ОбщегоНазначения.ОписаниеТипаСтрока(100));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		ЭтаФорма.АдресВременногоХранилища = ПоместитьВоВременноеХранилище("", УникальныйИдентификатор);
		
		ПараметрыФункции = Новый Массив;
		ПараметрыФункции.Добавить(Объект.Партнер);
		ПараметрыФункции.Добавить(ЭтаФорма.АдресВременногоХранилища);
		
		ЭтаФорма.ИдентификаторЗаданияПроверкиПартнера = ФоновыеЗадания.Выполнить("смартПроверкаПартнеров.НайтиДублиПартнераПоТелефонуИПочте",
																					ПараметрыФункции).УникальныйИдентификатор;
		
	КонецЕсли;
	//-- #Б1174 смарт: Шляпников 21.10.2024
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначения.СоздатьЭлементыПризнакаVIPКлиента(ЭтаФорма, Истина, "Партнер");
	смартСервер.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	
КонецПроцедуры

//++ #Б1174 смарт: Шляпников 21.10.2024 / При открытии карточки партнера или интереса, проверять по телефонам контактов наличие дублей
&НаКлиенте
Процедура ПроверитьЗавершениеФоновогоЗаданияПроверкиПартнера() Экспорт
	
	ЗаданиеВыполнено = ПроверитьЗавершениеФоновогоЗаданияПроверкиПартнераСервер();
	Если ЗаданиеВыполнено Тогда
		ОтключитьОбработчикОжидания("ПроверитьЗавершениеФоновогоЗаданияПроверкиПартнера");
	КонецЕсли;
	
КонецПроцедуры

//++ #Б1174 смарт: Шляпников 21.10.2024 / При открытии карточки партнера или интереса, проверять по телефонам контактов наличие дублей
&НаСервере
Функция ПроверитьЗавершениеФоновогоЗаданияПроверкиПартнераСервер() Экспорт
	
	ПродолжатьРаботу = Ложь;
	Реквизиты = ЭтаФорма.ПолучитьРеквизиты();
	Для каждого стрРеквизит Из Реквизиты Цикл
		Если стрРеквизит.Имя = "ИдентификаторЗаданияПроверкиПартнера" Тогда
			ПродолжатьРаботу = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ПродолжатьРаботу Тогда
		Возврат Истина;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Новый УникальныйИдентификатор(ЭтаФорма.ИдентификаторЗаданияПроверкиПартнера));
	Если Задание = Неопределено Тогда
		Возврат Истина;
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		
		Дубли = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресВременногоХранилища);
		
		Если Дубли.Количество() > 0 Тогда
			
			ПолучитьСообщенияПользователю(Истина);
			
			МассивСообщений = смартПроверкаПартнеров.СформироватьМассивСообщенийПоТаблицеДублейПартнеров(Дубли);
			Для каждого стрСообщение Из МассивСообщений Цикл
				ОбщегоНазначения.СообщитьПользователю(стрСообщение.Сообщение, стрСообщение.Ключ);
			КонецЦикла;
			
		//++ #Б-1216 смарт: Фролов 01.11.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
		    Если (Объект.смартИтоговаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте
				ИЛИ Объект.смартПредварительнаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте)
				И Объект.смартСтатусРегистрацияПользователяНаСайте = 0 Тогда
				
				Элементы.смартПодтвердить.Видимость = Ложь;
				Элементы.смартОтклонить.Видимость = Ложь;
				
				ОбщегоНазначения.СообщитьПользователю("Найдены дубли контактной информации, указанной при регистрации. Ваши действия:
					|1. Убедитесь, что выбрали правильного клиента, с которым будет связан пользователь Интернет-магазина.
					|2. Устраните дубли контактной информации (почта, телефон) во всех объектах, связанных с другими клиентами. 
					|	После этого выбирете повторна Клиента в интересе для повторной проверки.
					|Вы можете сделать это самостоятельно, или обратиться в поддержку 1С ИТ Департамента СМАРТ-Т.");
				
			Иначе	
				
				ОбщегоНазначения.СообщитьПользователю("Необходимо оставить телефон только у одного Партнера! Иначе телефонные звонки на эти номера не будут отображаться в 1С!");
				
			КонецЕсли;
			
		ИначеЕсли (Объект.смартИтоговаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте
			ИЛИ Объект.смартПредварительнаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте)
			И Объект.смартСтатусРегистрацияПользователяНаСайте = 0 Тогда
			
			Элементы.смартПодтвердить.Видимость = Истина;
			Элементы.смартОтклонить.Видимость = Истина;
			
			смартПроверитьНаличиеИмеющихсяНаСайтеПользователей();
			
		//-- #Б-1316 смарт: Фролов 01.11.2024
			
		КонецЕсли;
		
		Возврат Истина;
		
	ИначеЕсли НЕ Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
&ИзменениеИКонтроль("ПартнерПриИзменении")
Процедура смарт_ПартнерПриИзменении(Элемент)

	Если Элемент<>Неопределено Тогда
		КаналПервичногоИнтереса	= Неопределено;
		ИсточникПервичногоИнтереса	= Неопределено;
	КонецЕсли;
	ПартнерПередИзменением = Партнер;
	Партнер = Объект.Партнер;

	Если ПартнерПередИзменением <> Объект.Партнер Тогда
		
		Если ЗначениеЗаполнено(Объект.Партнер) Тогда
			Если ЗначениеЗаполнено(Объект.ТипУслуги) 
				И НЕ CRM_ОбщегоНазначенияКлиент.ПроверитьВозможностьЗаписиИнтереса(Объект) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Обнаружен активный интерес клиента по выбранному типу услуги!'"));
			КонецЕсли;	
		КонецЕсли;
		СтруктураДанные = ПолучитьДанныеПартнерПриИзменении(Объект.Дата, Объект.Валюта, Объект.Партнер, Объект.Организация, Объект.Проект);

		Объект.КонтактноеЛицо = СтруктураДанные.ОсновноеКонтактноеЛицо;

		Если ЗначениеЗаполнено(Объект.КонтактноеЛицо) Тогда
			КонтактыОбработкаВыбораСервер(Объект.КонтактноеЛицо, Истина);
		КонецЕсли;		

		СформироватьОписаниеКаналаИсточника();
		ДоступностьПервичногоИнтереса();

		ОбновитьЗаголовокФормы();
		ОбновленПартнерКонтакт = Истина;

		ПартнерПриИзмененииНаСервере();

		// ИнтернетПоддержкаПользователей.СПАРКРиски, ОбновитьОтображениеИндексов.
		// Отображать не по ссылке, а по ИНН, НЕ сохраняя в кэше.
		ЭтотОбъект.ИндексыСПАРКРиски = Неопределено; // Сбросить полученные значения.
		ОбновитьОтображениеИндексыСПАРК();
		// Конец ИнтернетПоддержкаПользователей.СПАРКРиски, ОбновитьОтображениеИндексов.

		// +CRM_Модуль
		ПартнерПриИзмененииСервер();

		СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);

		Если ИспользоватьСоглашенияСКлиентами И ЗначениеЗаполнено(Объект.Соглашение) Тогда
			ПродажиКлиент.ОповеститьОбОкончанииЗаполненияУсловийПродажПоУмолчанию();
		КонецЕсли;
		Если НЕ CRM_ОбщегоНазначенияПовтИсп.ЭтоCRM() Тогда
			СоглашениеПриИзменении(Элемент);
		КонецЕсли;	
		// -CRM_Модуль
		
	КонецЕсли;
	
	#Вставка
	//++ #Б-1216 смарт: Фролов 01.11.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
	ПодключитьОбработчикОжидания("ПроверитьЗавершениеФоновогоЗаданияПроверкиПартнера",1);
	
	смартПроверитьНаДублиКонтактнойИнформацииВыбранногоПартнера();
	//-- #Б-1216 смарт: Фролов 01.11.2024
	
	//++ #Б-2470 смарт: Фролов 24.02.2025 //Вывод состояния Партнера в Интересе.
	смартОтразитьСостояниеПартнера();
	//-- #Б-2470 смарт: Фролов 24.02.2025
	
	//++ #Б3960 смарт: Шляпников 16.09.2025 / Добавление признака VIP клиента во все документы и в карточку партнера
	смартОбщегоНазначенияКлиент.УстановитьОтображениеПризнакаВИП(ЭтаФорма, Объект.Партнер);
	//-- #Б3960 смарт: Шляпников 16.09.2025
	#КонецВставки

КонецПроцедуры

&НаСервере
//++ #Б-1216 смарт: Фролов 05.11.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
Процедура смартПроверитьНаличиеИмеющихсяНаСайтеПользователей()
	
	НужнаяЭлектроннаяПочта = Объект.ДокументОснование.ЭлектроннаяПочта;
	
	//++ #Б-4186 смарт: Фролов 27.08.2025 //ОШИБКА. При открытии интереса с типом - Регистрация пользователя ИМ.
	//НужныйТелефон = Объект.ДокументОснование.Телефон;
	НужныйТелефон = ОбщегоНазначенияБПКлиентСервер.ОставитьВСтрокеТолькоЦифры(Объект.ДокументОснование.Телефон);
	
	МожноПодтвердить = Истина;
	
	Если НЕ ЗначениеЗаполнено(НужнаяЭлектроннаяПочта) Тогда
		
		ТекстСообщения = "Не заполнена электронная почта пользователя!" + Символы.ПС;
				
		МожноПодтвердить = Ложь;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НужныйТелефон) Тогда
		
		ТекстСообщения = "Не заполнен телефон пользователя!";
		
		МожноПодтвердить = Ложь;
		
	КонецЕсли;
	
	Если НЕ МожноПодтвердить Тогда
		
		ТекстСообщения = ТекстСообщения + "Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
	
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
		Элементы.смартПодтвердить.Видимость = Ложь;
		
	Иначе	
	//-- #Б-4186 смарт: Фролов 27.08.2025
	
		МассивКонтактныхЛицИмеющихсяНаСайте = смартНайтиКонтактПоЭлПочтеИТелефону(Новый 
			Структура("НужнаяЭлектроннаяПочта, НужныйТелефон, ОтобратьИмеющиесяНаСайте", НужнаяЭлектроннаяПочта, НужныйТелефон, Истина));
			
		Если МассивКонтактныхЛицИмеющихсяНаСайте.Количество() > 1 Тогда
			
			ТекстСообщения = "Найдены пользователи с такими регисрационными 
				|данными, которые уже присутствуют в качестве пользователей Интернет-магазина. 
				|Найдено Контактные лица:";
			Для Каждого Стр Из МассивКонтактныхЛицИмеющихсяНаСайте Цикл
				ТекстСообщения = ТекстСообщения + Стр + " у Клиента " + Стр.Владелец;
			КонецЦикла;
			ТекстСообщения = ТекстСообщения + "Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Элементы.смартПодтвердить.Видимость = Ложь;
			
			МожноПодтвердить = Ложь;
			
		ИначеЕсли МассивКонтактныхЛицИмеющихсяНаСайте.Количество() = 1 Тогда	
			
			Если МассивКонтактныхЛицИмеющихсяНаСайте[0].Владелец = Объект.Партнер Тогда
				
				ТекстСообщения = "Пользователь с такими регисрационными данными уже присутствует в качестве пользователя Интернет-магазина. 
					|Найдено Контактное лицо " + МассивКонтактныхЛицИмеющихсяНаСайте[0] + " у данного Клиента." + Символы.ПС + 
					"Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
				
			Иначе	
			
				ТекстСообщения = "Пользователь с такими регисрационными данными уже присутствует в качестве пользователя Интернет-магазина. 
					|Найдено Контактное лицо " + МассивКонтактныхЛицИмеющихсяНаСайте[0] + " у Клиента " +
					МассивКонтактныхЛицИмеющихсяНаСайте[0].Владелец + "." + Символы.ПС + 
					"Дальнейшая регистрация не возможна, пожалуйста Отклоните заявку или обратитесь в поддержку 1С ИТ Департамента СМАРТ-Т.";
			
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
			Элементы.смартПодтвердить.Видимость = Ложь;
			
			МожноПодтвердить = Ложь;
			
		КонецЕсли;
		
	//++ #Б-4186 смарт: Фролов 27.08.2025 //ОШИБКА. При открытии интереса с типом - Регистрация пользователя ИМ.
	КонецЕсли;
	//-- #Б-4186 смарт: Фролов 27.08.2025
			
КонецПроцедуры //-- #Б-1216 смарт: Фролов 05.11.2024			

&НаСервере
//++ #Б-1216 смарт: Фролов 01.11.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
Процедура смартПроверитьНаДублиКонтактнойИнформацииВыбранногоПартнера()
	
	Если НЕ Объект.Партнер.Пустая() И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.смартЛид") Тогда
			
		Если (Объект.смартИтоговаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте
			ИЛИ Объект.смартПредварительнаяКвалификация = Справочники.смартКвалификацииМенеджеров.РегистрацияПользователяНаСайте) Тогда
			
			Попытка
				Если Элементы.Найти("ИдентификаторЗаданияПроверкиПартнера") = Неопределено
					И Элементы.Найти("АдресВременногоХранилища") = Неопределено Тогда
					ДобавляемыеРеквизиты = Новый Массив; //Определяем массив добавляемых реквизитов
					НовыйРеквизит = Новый РеквизитФормы("АдресВременногоХранилища", ОбщегоНазначения.ОписаниеТипаСтрока(100));
					ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
					НовыйРеквизит = Новый РеквизитФормы("ИдентификаторЗаданияПроверкиПартнера", ОбщегоНазначения.ОписаниеТипаСтрока(100));
					ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
					ИзменитьРеквизиты(ДобавляемыеРеквизиты);
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			ЭтаФорма.АдресВременногоХранилища = ПоместитьВоВременноеХранилище("", УникальныйИдентификатор);
			
			ПараметрыФункции = Новый Массив;
			ПараметрыФункции.Добавить(Объект.Партнер);
			ПараметрыФункции.Добавить(ЭтаФорма.АдресВременногоХранилища);
			ПараметрыФункции.Добавить(Объект.ДокументОснование.Телефон);
			ПараметрыФункции.Добавить(Объект.ДокументОснование.ЭлектроннаяПочта);
			
			ЭтаФорма.ИдентификаторЗаданияПроверкиПартнера = ФоновыеЗадания.Выполнить("смартПроверкаПартнеров.НайтиДублиПартнераПоТелефонуИПочте",
			ПараметрыФункции).УникальныйИдентификатор;
			
			Если Объект.ДокументОснование.ИНН <> "" Тогда
				Объект.Контрагент = CRM_Модуль_РаботаСКонтрагентами.смартНайтиКонтрагентаПоИННиКПП(
				Новый Структура("ИНН, КПП", Объект.ДокументОснование.ИНН, Объект.ДокументОснование.КПП));
				
				Если Объект.Соглашение.Контрагент <> Объект.Контрагент Тогда
					Объект.Соглашение = Неопределено;	
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;

КонецПроцедуры //-- #Б-1216 смарт: Фролов 01.11.2024

&НаКлиенте
&ИзменениеИКонтроль("ТоварыПередНачаломДобавления")
//++ #Б-1690 смарт: Фролов 13.12.2024 //Доработка Интереса - при выборе товара подставлять автоматом значения.
Процедура смарт_ТоварыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)

	Если Копирование Тогда
		НаборыКлиент.ПередУдалениемСтрокиТабличнойЧасти(ЭтаФорма, "Товары", Отказ, Истина);
		Возврат;
	КонецЕсли;

	Если ФлагРекурсии Тогда

		ФлагРекурсии = Ложь;
		Возврат;

	КонецЕсли;

	Отказ        = Истина;
	ФлагРекурсии = Истина;

	Элементы.Товары.ДобавитьСтроку();

	НоваяСтрока  = Элементы.Товары.ТекущиеДанные;
	НоваяСтрока.Склад = Объект.Склад;
	
	#Вставка
	//++ #Б-1690 смарт: Фролов 13.12.2024 //Доработка Интереса - при выборе товара подставлять автоматом значения.
	НоваяСтрока.Количество = 1;
	НоваяСтрока.КоличествоУпаковок = 1;
	НоваяСтрока.ВидЦены = смартОбщегоНазначения.ВернутьЗначениеНастройкиПредопределенногоСмарт("ВидЦеныРозничнаяUSD");
	//-- #Б-1690 смарт: Фролов 13.12.2024
	#КонецВставки
	
	СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);

КонецПроцедуры //-- #Б-1690 смарт: Фролов 13.12.2024

&НаКлиенте
&ИзменениеИКонтроль("БыстрыйВвод_ДатаНачалаПриИзменении")
//++ #Б-2208 смарт: Фролов 25.02.2025 //Ввод нового регламента. Сделать возможным согласование Взаимодействий менеджеров
Процедура смарт_БыстрыйВвод_ДатаНачалаПриИзменении(Элемент)

	Если БыстрыйВвод_ДатаНачала = НачалоДня(БыстрыйВвод_ДатаНачала) И БыстрыйВвод_КэшированноеВремя > 0 Тогда
		БыстрыйВвод_ДатаНачала = БыстрыйВвод_ДатаНачала + БыстрыйВвод_КэшированноеВремя;
		БыстрыйВвод_КэшированноеВремя = 0;
	КонецЕсли;

	Если НачалоДня(БыстрыйВвод_КэшированнаяДатаНачала) = НачалоДня(БыстрыйВвод_ДатаОкончания) Тогда
		ВремяЗавершения = БыстрыйВвод_ДатаОкончания - НачалоДня(БыстрыйВвод_ДатаОкончания);
		БыстрыйВвод_ДатаОкончания = НачалоДня(БыстрыйВвод_ДатаНачала) + ВремяЗавершения;
	КонецЕсли;

	Если БыстрыйВвод_ДатаНачала > БыстрыйВвод_ДатаОкончания Тогда

		СрокПоУмолчанию = 3600;
		Если БыстрыйВвод_ТекущийТипОбъекта = "Взаимодействие" Тогда
			СрокПоУмолчанию = 1800;
		КонецЕсли;

		БыстрыйВвод_ДатаОкончания = БыстрыйВвод_ДатаНачала + СрокПоУмолчанию;
		БыстрыйВвод_ЗадачаВариантСрока = ПредопределенноеЗначение("Перечисление.CRM_ВариантыУстановкиДаты.ЧерезЧас");
	КонецЕсли;

	БыстрыйВвод_КэшированнаяДатаНачала = БыстрыйВвод_ДатаНачала;
	ПроверитьКорректностьДатыОкончания();
	
	#Вставка
	//++ #Б-5002 смарт: Фролов 17.11.2025 //Ограничение количества планируемых взаимодействий на день.
	Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Видимость = Ложь;
	//-- #Б-5002 смарт: Фролов 17.11.2025
	
	//++ #Б-2208 смарт: Фролов 25.02.2025 //Ввод нового регламента. Сделать возможным согласование Взаимодействий менеджеров
	Если CRM_ОбщегоНазначенияСервер.ЗначениеРеквизитаОбъекта(Объект.Партнер, "ОсновнойМенеджер") = БыстрыйВвод_ВзаимодействиеОтправитель Тогда
		
		ПредельныйСрок = смартОбщегоНазначения.ПулучитьПредельныйСрокВзаимодействияПоПартнеру(Объект.Партнер);
		Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Заголовок = "Выбранная дата больше " 
			+ ПредельныйСрок + " дней. Взаимодействие будет согласовано РОПом.";
		Если ПредельныйСрок > 0 И БыстрыйВвод_ДатаНачала > ТекущаяДата() + 3600 * 24 * ПредельныйСрок Тогда
			Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Видимость = Истина;
		Иначе	
			Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Видимость = Ложь;
		КонецЕсли;
		
		//++ #Б-5042 смарт: Фролов 24.11.2025 //Ошибка. Контроль максимального срока взаимодействий только для основных менеджеров! 
		СрокМаксимальногоПланированияВзаимодействийВДнях = смартОбщегоНазначения.ПолучитьЗначениеСправочникаПредопределенныеПоНовому(
			"СрокМаксимальногоПланированияВзаимодействийВДнях");
		
		Если СрокМаксимальногоПланированияВзаимодействийВДнях > 0 
			И БыстрыйВвод_ДатаНачала > ТекущаяДата() + 3600 * 24 * СрокМаксимальногоПланированияВзаимодействийВДнях Тогда
			
			Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Заголовок = 
				"Нельзя планировать взаимодействия на срок более " + СрокМаксимальногоПланированияВзаимодействийВДнях + " дней!";
			
			Элементы.смартПредупреждениеОПревышенииПредельногоСрока.Видимость = Истина;
			БыстрыйВвод_ДатаНачала = Неопределено;
			
		КонецЕсли;
		//-- #Б-5042 смарт: Фролов 24.11.2025	
	
	КонецЕсли;
	//-- #Б-2208 смарт: Фролов 25.02.2025
		
	//++ #Б-2600 смарт: Фролов 07.03.2025 //Доработка планирования взаимодействий.
	Если ЭтаФорма.смартПереключательСтатусаВзаимодействия = 2 И НЕ НачалоДня(БыстрыйВвод_ДатаНачала) = НачалоДня(ТекущаяДата()) Тогда
		
		ЭтаФорма.смартПереключательСтатусаВзаимодействия = 1;
		смартПереключательСтатусаВзаимодействияПриИзменении(Элементы.БыстрыйВвод_ПереключательСтатусаВзаимодействия);
		
	КонецЕсли; 
	//-- #Б-2600 смарт: Фролов 07.03.2025
	#КонецВставки

КонецПроцедуры //-- #Б-2208 смарт: Фролов 25.02.2025

