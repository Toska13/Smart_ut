&НаКлиенте
Процедура смартПоказатьМаркетинговыеМероприятия(Команда)
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ПолучитьМассивДополнительныхМаркетинговыхМероприятий());
	
	Если Список.Количество() > 0 Тогда
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("смартПоказатьМаркетинговыеМероприятияВыбор", ЭтаФорма), Список);
						  
	КонецЕсли;
	
КонецПроцедуры

//++ #Б7290 смарт: Шляпников 09.07.2026 / Документ "Маркетинговое мероприятие". Связь к Интересу "один ко многим".
&НаСервере
Функция ПолучитьМассивДополнительныхМаркетинговыхМероприятий()
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МаркетинговыеМероприятияДокумент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент КАК МаркетинговыеМероприятияДокумент
	|ГДЕ
	|	МаркетинговыеМероприятияДокумент.смартИнтерес = &Интерес
	|	И НЕ МаркетинговыеМероприятияДокумент.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Интерес", Объект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

//++ #Б7290 смарт: Шляпников 09.07.2026 / Документ "Маркетинговое мероприятие". Связь к Интересу "один ко многим".
&НаКлиенте
Процедура смартПоказатьМаркетинговыеМероприятияВыбор(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		ПоказатьЗначение(, ВыбранноеЗначение.Значение);
	КонецЕсли;
	
КонецПроцедуры

