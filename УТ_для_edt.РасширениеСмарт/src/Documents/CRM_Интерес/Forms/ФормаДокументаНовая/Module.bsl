		ЗадачаОбъект.ПринятаКИсполнению = Истина;
		ЗадачаОбъект.СостояниеБизнесПроцесса = Перечисления.СостоянияБизнесПроцессов.Активен;
 		ЗадачаОбъект.СрокИсполнения = смартОбщегоНазначения.ПолучитьРабочуюДатуОтносительноИсходной(ТекущаяДата(), 1, "Вперед");
		
		ЗадачаОбъект.смартВидЗадачи = Справочники.смартВидыЗадач.РазобратьсяСИнцидентом;
		
		ЗадачаОбъект.Описание = ЭтаФорма.смартИнцидентУточнение;
		ЗадачаОбъект.Наименование = "Необходимо разобраться с инцидентом";
		ЗадачаОбъект.Записать();
		
		ДокументИнцидент = Документы.смартИнцидент.СоздатьДокумент();
		ДокументИнцидент.ОбъектИнцидента = Объект.Ссылка;
		ДокументИнцидент.Задача = ЗадачаОбъект.Ссылка;
