		СтруктураПараметров.Вставить("ПричинаОтклоненияРегистрации", "Учетная запись НЕ подтверждена");
		//++ #Б-5728 смарт: Фролов 12.02.2026 //Исправить ошибку в Интересе. Регистрация пользователя на сайте
		СтруктураПараметров.Вставить("КонтактноеЛицо", Неопределено);
		//-- #Б-5728 смарт: Фролов 12.02.2026
		СтрокаОшибки = смартИнтернетМагазин.ПодтвердитьРегистрациюПользователяНаСайте(СтруктураПараметров);
		
		Если СтрокаОшибки = "" Тогда
			
			Объект.смартСтатусРегистрацияПользователяНаСайте = 2;
			
			Записать();
			Элементы.смартПодтвердить.Видимость = Ложь;
			Элементы.смартОтклонить.Видимость = Ложь;
			
		Иначе
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтрокаОшибки);
			
		КонецЕсли;

КонецПроцедуры //-- #Б-986 смарт: Фролов 23.09.2024 
	
