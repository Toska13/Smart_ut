	"ВЫБРАТЬ
	|	смартИнцидент.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.смартИнцидент КАК смартИнцидент
	|ГДЕ
	|	смартИнцидент.ОбъектИнцидента = &ОбъектИнцидента
	|	И НЕ смартИнцидент.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	смартВидыИнцидентов.Ссылка КАК Ссылка,
	|	смартВидыИнцидентов.Наименование КАК Наименование,
	|	смартВидыИнцидентов.Код КАК Код
	|ИЗ
	|	Справочник.смартВидыИнцидентов КАК смартВидыИнцидентов
	|ГДЕ
	|	смартВидыИнцидентов.Использовать
	//++ #Б-5762 смарт: Фролов 18.02.2026 //Добавить механизм Инцидентов в справочник Партнеры.
	|	И смартВидыИнцидентов.Ссылка В ИЕРАРХИИ(ЗНАЧЕНИЕ(Справочник.смартВидыИнцидентов.ДляИнтересов))
	//-- #Б-5762 смарт: Фролов 18.02.2026
	|
	|УПОРЯДОЧИТЬ ПО
	|	смартВидыИнцидентов.Порядок");
	Запрос.УстановитьПараметр("ОбъектИнцидента", Объект.Ссылка);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Если МассивРезультатов[0].Пустой() Тогда
		
		ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
		ЗадачаОбъект.Дата = ТекущаяДата();
		ЗадачаОбъект.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
		ЗадачаОбъект.Исполнитель = ЭтаФорма.смартИнцидентКтоБудетОповещен;
