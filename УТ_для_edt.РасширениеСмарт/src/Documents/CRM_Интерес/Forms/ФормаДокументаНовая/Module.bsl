&НаСервере
//++ #Б-3588 смарт: Фролов 20.06.2025 //Реализовать инструмент для работы отдела контроля качества.
Процедура смартСохранитьРезультатыАудитаНаСервере()

	НаборЗаписей = РегистрыСведений.смартАудитИнтересов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Интерес.Установить(Объект.Ссылка);
	НаборЗаписей.Отбор.Период.Установить(НачалоДня(ТекущаяДата()));
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Запись = НаборЗаписей.Добавить();
	Запись.Интерес = Объект.Ссылка;
	Запись.Период = ТекущаяДата();
	Запись.КвалификацияПройдена = ЭтаФорма.смартКвалификацияПройдена;
	Запись.ЗакрытСКорректногоЭтапа = ЭтаФорма.смартЗакрытСКорректногоЭтапа;
	Запись.ВозраженияОтработаны = ЭтаФорма.смартВозраженияОтработаны;
	Запись.КомментарийСоответствуетСутиЗвонка = ЭтаФорма.смартКомментарийСоответствуетСутиЗвонка;
	Запись.ПричинаПровалаКорректна = ЭтаФорма.смартПричинаПровалаКорректна;
	Запись.ВернутьНаДоработку = ЭтаФорма.смартВернутьНаДоработку;
	Запись.КвалификацияОборудования = ЭтаФорма.смартКвалификацияОборудования;
	//++ #Б-3718 смарт: Фролов 09.07.2025 //Расширение механизма Аудита Интересов. Аудит на разных этапах.
	//Запись.ЧтоСталоПричинойПровала = ЭтаФорма.смартЧтоСталоПричинойПровала;
	Запись.СледующееКасаниеЗапланировано = ЭтаФорма.смартСледующееКасаниеЗапланировано;
	Запись.КомментарийАудитораЭтапКвалификации = ЭтаФорма.смартКомментарийАудитораЭтапКвалификации;
	Запись.СделкаНаКорректномЭтапе = ЭтаФорма.смартСделкаНаКорректномЭтапе;
	Запись.ПрезентацияПроведена = ЭтаФорма.смартПрезентацияПроведена;
