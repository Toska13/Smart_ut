					ТекстПисьма = ТекстПисьма + Выборка.Наименование + Символы.ПС;
					//-- #Б-5762 смарт: Фролов 20.02.2026
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
		
		ДокументИнцидент.Записать(РежимЗаписиДокумента.Запись);
		
		//++ #Б-5762 смарт: Фролов 20.02.2026 //Добавить механизм Инцидентов в справочник Партнеры.
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
		
		ТестовыеАдресаСтрока = "";
		ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока); 
		
		АдресаДляОтправкиСтрокой = "";
		МассивАдресовДляОтправки = смартОбщегоНазначения.ПолучитьАдресаПользователей(ЭтаФорма.смартИнцидентКтоБудетОповещен, АдресаДляОтправкиСтрокой);
		
		//++ #Б-6630 смарт: Фролов 13.05.2026 //Сделать механизм оповещений о новых Инцидентах.
		Квалификация = ?(ЗначениеЗаполнено(Объект.смартИтоговаяКвалификация), Объект.смартИтоговаяКвалификация, Объект.смартПредварительнаяКвалификация);
		
		МассивПользователей = смартОбщегоНазначения.ПолучитьПользователейПоНастройкамОбОповещениях("Инциденты", Объект.Подразделение, Квалификация.ТипПродукта);
		
		Если НЕ МассивПользователей = Неопределено Тогда
			
			Для Каждого Пользователь Из МассивПользователей Цикл
				
				МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.смартРабочаяПочта, Пользователь.смартРабочаяПочта));
				АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + Пользователь.смартРабочаяПочта;
				
			КонецЦикла;
		
		КонецЕсли;
		//-- #Б-6630 смарт: Фролов 13.05.2026

		НавСсылка = ПолучитьНавигационнуюСсылку(Объект.Ссылка);
		ТекстПисьма = ТекстПисьма + Символы.ПС + "Ссылка на объект инцидента: " + НавСсылка;
		
		ТемаПисьма = "Новый инцидент, требует вашего внимания!";
		
		Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
			ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			ДанныеОтправки = Новый Структура("Тема, Заголовок", ТемаПисьма, ТекстПисьма);
			ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, , ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
			
			Попытка
				ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Исключение
				ТекстСообщения = "Не удалось отправить письмо ответственному " + ЭтаФорма.смартИнцидентКтоБудетОповещен 
					+ " по инциденту " + ДокументИнцидент.Ссылка + Символы.ПС + ОписаниеОшибки(); 
				ЗаписьЖурналаРегистрации("ОтправкаПисьма", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			КонецПопытки;
			
		КонецЕсли;
		//-- #Б-5762 смарт: Фролов 20.02.2026
		
		Элементы.смартГруппаОповеститьОбИнцидентеВертикальная.ТолькоПросмотр = Истина;
		Элементы.смартКнопкаОповеститьОбИнциденте.Доступность = Ложь;
	
	КонецЕсли;

