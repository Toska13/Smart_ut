		ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя выбирать ММ, который прикреплен уже к другому интересу",, "смартМаркетинговоеМероприятие");
		Объект.смартМаркетинговоеМероприятие = Неопределено;
