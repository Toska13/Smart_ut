//++ #Б-1216 смарт: Фролов 28.10.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
Функция смартНайтиКонтактПоЭлПочтеИТелефону(СтруктураПоиска)
	
	Запрос = Новый Запрос;
	
	Если СтруктураПоиска.ОтобратьИмеющиесяНаСайте Тогда
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	(КонтактныеЛицаПартнеров.смартТелефонНаСайте = &НомерТелефона
		|			ИЛИ КонтактныеЛицаПартнеров.смартЭлектроннаяПочтаНаСайте = &АдресЭП)";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ НайденныеПоПочте
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
		|ГДЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец = &Владелец
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.АдресЭП = &АдресЭП
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.смартЛогинНаСайте = """"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
		|ГДЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец = &Владелец
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.НомерТелефона = &НомерТелефона
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка В
		|			(ВЫБРАТЬ
		|				НайденныеПоПочте.Ссылка
		|			ИЗ
		|				НайденныеПоПочте)
		|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.смартЛогинНаСайте = """"";
		Запрос.УстановитьПараметр("Владелец", Объект.Партнер);
	КонецЕсли;	
	Запрос.УстановитьПараметр("АдресЭП", СтруктураПоиска.НужнаяЭлектроннаяПочта);
	Запрос.УстановитьПараметр("НомерТелефона", СтруктураПоиска.НужныйТелефон);
	
	МассиКонтактныхЛиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Возврат МассиКонтактныхЛиц;
	
