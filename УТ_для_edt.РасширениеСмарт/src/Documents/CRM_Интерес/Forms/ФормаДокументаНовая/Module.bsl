//++ #Б-4854 смарт: Фролов 31.10.2025 //Вывод информации по сценариям DEERAY в интересе.
Процедура ВывестиТабличныйДокументРасщифровкаРазговора(Данные)
	
	ТабДок = ЭтаФорма.смартРасшифровкаРазговораDEERAY;
	
	ТабДок.Очистить();
	
	Макет = Документы.CRM_Интерес.ПолучитьМакет("смартРасшифровкаРазговора");
		
	Если НЕ Данные = Неопределено Тогда
		
		РазделДанные = Данные.Получить("data")[0];
		
		Сообщения = РазделДанные.Получить("messages");
		
		ПредыдущийАвтор = "";
		
		Для Каждого СтрСообщения Из Сообщения Цикл
			
			АвторСообщения = СтрСообщения.Получить("author");
			АвторСообщенияИмя = АвторСообщения.Получить("name");
			МассивСообщений = СтрСообщения.Получить("sentences");
			УчастникЗвонка = СтрСообщения.Получить("originator");
			
			Если УчастникЗвонка = "customer" Тогда
				ОбластьНиз = Макет.ПолучитьОбласть("НизОператор");
			Иначе
				ОбластьНиз = Макет.ПолучитьОбласть("НизКлиент");
			КонецЕсли;	
			
			Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
				
				Если НЕ ПредыдущийАвтор = "" Тогда
					ТабДок.Вывести(ОбластьНиз);
				КонецЕсли;	
				
				ОбластьРазделитель = Макет.ПолучитьОбласть("РазделительБлоков");
				ТабДок.Вывести(ОбластьРазделитель);
				
			КонецЕсли;
			
			Если УчастникЗвонка = "customer" Тогда
				
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаКлиент");
				ОбластьШапка.Параметры.Клиент = АвторСообщенияИмя;
				Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
					ТабДок.Вывести(ОбластьШапка);
				КонецЕсли;	
				ОбластьСтрока = Макет.ПолучитьОбласть("ТекстКлиент");
	
			Иначе
				
				ОбластьШапка = Макет.ПолучитьОбласть("ШапкаОператор");
				ОбластьШапка.Параметры.Оператор = АвторСообщенияИмя;
				Если НЕ ПредыдущийАвтор = АвторСообщенияИмя Тогда
					ТабДок.Вывести(ОбластьШапка);
				КонецЕсли;	
				ОбластьСтрока = Макет.ПолучитьОбласть("ТекстОператор");
				
			КонецЕсли;	
				
			ДанныеВремени = СтрСообщения.Получить("time");
			Начало = ДанныеВремени.Получить("from");
			
			Если НЕ МассивСообщений = Неопределено Тогда
				
				Для Каждого СтрМассивСообщений Из МассивСообщений Цикл
					
					ОбластьСтрока.Параметры.Текст = СтрМассивСообщений.Получить("body"); 
					ОбластьСтрока.Параметры.Начало = Начало;
					
					ТабДок.Вывести(ОбластьСтрока);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ПредыдущийАвтор = АвторСообщенияИмя;
			
		КонецЦикла;	
		
	КонецЕсли;

	Если УчастникЗвонка = "customer" Тогда
		ОбластьНиз = Макет.ПолучитьОбласть("НизКлиент");
	Иначе
		ОбластьНиз = Макет.ПолучитьОбласть("НизОператор");
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьНиз);
	
КонецПроцедуры //-- #Б-4854 смарт: Фролов 31.10.2025

&НаКлиенте
//++ #Б-4854 смарт: Фролов 31.10.2025 //Вывод информации по сценариям DEERAY в интересе.
Процедура смартПрослушатьРазговорНажатие(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок) Тогда
	
		ДанныеЗвонка = смартПолучитьДанныеДляЗвонка(ЭтаФорма.смартВыбранныйДляПрослушиванияЗвонок);
		
		Если НЕ ДанныеЗвонка = Неопределено Тогда
			
			ПараметрыЗвонка = Новый Структура("ИдентификаторЗвонка, ИдентификаторЗаписи, Ответственный, Входящий, НомерТелефона, ВнутреннийНомер, ДатаНачала, ДатаОкончания, Звонок",
				ДанныеЗвонка.сфпИдентификаторЗвонка, ДанныеЗвонка.сфпИдентификаторЗаписи, ДанныеЗвонка.Ответственный, 
				ДанныеЗвонка.Входящий, ДанныеЗвонка.АбонентКакСвязаться, ДанныеЗвонка.сфпВнутреннийНомер, ДанныеЗвонка.сфпДатаНачала, 
				ДанныеЗвонка.сфпДатаОкончания, ДанныеЗвонка.Ссылка);
			
			сфпСофтФонПроКлиент.НачатьПрослушиваниеЗаписиРазговора(ПараметрыЗвонка, ЭтаФорма, Элементы.смартПрослушатьРазговорDEERAY);
			
		КонецЕсли;
		
	КонецЕсли;	

КонецПроцедуры //-- #Б-4854 смарт: Фролов 31.10.2025

&НаСервере
//++ #Б-4854 смарт: Фролов 31.10.2025 //Вывод информации по сценариям DEERAY в интересе.
Функция смартПолучитьДанныеДляЗвонка(ОбъектЗвонка)
	
	Если НЕ ОбъектЗвонка.Ссылка.Пустая() Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	сфпИсторияЗвонков.ВнутреннийНомер КАК ВнутреннийНомер,
		|	сфпИсторияЗвонков.ДатаНачала КАК ДатаНачала,
		|	сфпИсторияЗвонков.ДатаОтвета КАК ДатаОтвета,
		|	сфпИсторияЗвонков.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.сфпИсторияЗвонков КАК сфпИсторияЗвонков
		|ГДЕ
		|	сфпИсторияЗвонков.Звонок = &Звонок
		|	И сфпИсторияЗвонков.ИдентификаторЗвонка = &ИдентификаторЗвонка");
		Запрос.УстановитьПараметр("Звонок", ОбъектЗвонка.Ссылка);
		Запрос.УстановитьПараметр("ИдентификаторЗвонка", ОбъектЗвонка.сфпИдентификаторЗвонка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда   			
			
			СтруктураНужныхДанных = Новый Структура();
