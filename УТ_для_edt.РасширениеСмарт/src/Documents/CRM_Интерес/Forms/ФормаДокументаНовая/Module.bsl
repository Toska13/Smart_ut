//++ #Б-1214 смарт: Фролов 24.10.2024 //Регистрация в ИМ. Лид-Интерес. Проверка взаимодействия перед подтверждением
Функция смартПроверитьНаличиеВыполненнойЗадачи()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя
	|ГДЕ
	|	Предмет = &Предмет
	|	И Выполнена
	|	И смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.СозвонитьсяСКлиентом)");
	Запрос.УстановитьПараметр("Предмет", Объект.Ссылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции //-- #Б-1214 смарт: Фролов 24.10.2024	

