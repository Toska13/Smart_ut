	//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
	Запрос.УстановитьПараметр("ТаблицаКонтейнеров", ПолучитьТаблицуКонтейнеров(ДокументСсылка));
	
	Груз = ?(ТипЗнч(Запрос.Параметры.Распоряжение) = Тип("ДокументСсылка.ЗаказПоставщику"),
				Запрос.Параметры.Распоряжение.Груз,
