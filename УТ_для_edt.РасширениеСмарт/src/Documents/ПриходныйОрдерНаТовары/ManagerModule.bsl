Функция ТекстЗапросаТаблицаДвиженияГарантийныхЗапасныхЧастей(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартДвиженияГарантийныхЗапасныхЧастей";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ПроведениеСерверУТ.ЕстьТаблицаЗапроса("ВтТоварыПоPRE", ТекстыЗапроса) Тогда
		ТекстЗапросаТаблицаВтТоварыПоPRE(Запрос, ТекстыЗапроса);
	КонецЕсли;
			
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
		|	&Период 							   КАК Период,
		|	ВтТоварыПоPRE.Заявка				   КАК Заявка,
		|	ТаблицаТовары.Номенклатура             КАК Номенклатура,		
		|	&Склад 								   КАК Склад,
		|	ЗНАЧЕНИЕ(Перечисление.смартВидыКонтроляГарантийныхЗапчастей.СдачаЗапчастиКлиентаНаСклад) КАК ВидКонтроля,
		|	ТаблицаТовары.Количество               КАК Количество
		|ИЗ
		|	Документ.ПриходныйОрдерНаТовары.Товары КАК ТаблицаТовары
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВтТоварыПоPRE КАК ВтТоварыПоPRE
		|	ПО
		|		ВтТоварыПоPRE.НомерСтроки = ТаблицаТовары.НомерСтроки
		|		И ВтТоварыПоPRE.Номенклатура = ТаблицаТовары.Номенклатура
		|ГДЕ
		|	ТаблицаТовары.Ссылка = &Ссылка
		|	И &УсловиеДляДвиженияРегистраДвиженияГарантийныхЗапасныхЧастей
		|";
		
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;

КонецФункции
