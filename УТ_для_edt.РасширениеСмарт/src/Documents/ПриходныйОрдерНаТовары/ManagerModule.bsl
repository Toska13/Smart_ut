Функция ПолучитьТаблицуКонтейнеров(ДокументСсылка)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	Таблица.Колонки.Добавить("Контейнер", 	Новый ОписаниеТипов("СправочникСсылка.смартКонтейнеры"));
	
	Если ДокументСсылка.ХозяйственнаяОперация 
			= Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика 
		Тогда
		Возврат Таблица;
	КонецЕсли;
		
	Для Каждого СтрокаТовары Из ДокументСсылка.Товары Цикл
		
		МассивКонтейнеров = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрокаТовары.смартКонтейнер);
		Для Каждого ЭлементМассиваКонтейнеров Из МассивКонтейнеров Цикл
			
			Если Не ЭлементМассиваКонтейнеров.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТаблицы = Таблица.Добавить();
			
			НоваяСтрокаТаблицы.НомерСтроки = СтрокаТовары.НомерСтроки;
			НоваяСтрокаТаблицы.Контейнер 
				= Справочники.смартКонтейнеры.ПолучитьСсылку(Новый УникальныйИдентификатор(ЭлементМассиваКонтейнеров.Ссылка))
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции
