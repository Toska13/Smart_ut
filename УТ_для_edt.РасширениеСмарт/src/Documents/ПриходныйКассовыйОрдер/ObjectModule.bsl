
#Область ПеренесеноСДоработкамиСмарт
&После("ОбработкаПроведения")
Процедура смарт_ОбработкаПроведенияПосле(Отказ, РежимПроведения)
   //++ #1116 смарт: Фролов 17.01.2023 //Авторезервирование оплаченных заказов перевод в статус Резервирование на складе.  
   Если ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение 
        И НЕ ОбменДанными.Загрузка 
        И НЕ Отказ Тогда 
        
        Если Справочники.смартПредопределенныеЗначения.ПроцентОплатыЗаказаДляИерархииПоОплате.Значение=Неопределено Тогда
            ПределПроцента = 0;
        Иначе
            ПределПроцента = Справочники.смартПредопределенныеЗначения.ПроцентОплатыЗаказаДляИерархииПоОплате.Значение;
        КонецЕсли; 
        
        Если РасшифровкаПлатежа.Количество() И ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента Тогда
            Для каждого Стр Из РасшифровкаПлатежа Цикл
                //Добавляем запись в регистр смартОплатыПоЗаказам по Заказам клиента(ЗК) в Документах Поступления БДС.
                //ЗК - не в статусе Закрыт, не помечен на Удаление, Проведен
                Отбор = Новый Структура;
                Отбор.Вставить("Заказ", Стр.Заказ);
                ПроцентОплаты = 0;
                ВыборкаРег = РегистрыСведений.СостоянияЗаказовКлиентов.Выбрать(Отбор);
                
                Если ВыборкаРег.Следующий() Тогда
                    ПроцентОплаты = ВыборкаРег.ПроцентОплаты;
                КонецЕсли;
                
                Если ТипЗнч(Стр.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") 
                    И Стр.Заказ.Проведен И НЕ Стр.Заказ.ПометкаУдаления 
                    И НЕ Стр.Заказ.Статус = Перечисления.СостоянияЗаказовКлиентов.Закрыт 
                    И ПроцентОплаты >= ПределПроцента Тогда
                    НаборЗаписей = РегистрыСведений.смартОплатыПоЗаказам.СоздатьНаборЗаписей(); 
                    НаборЗаписей.Отбор.ЗаказКлиента.Установить(Стр.Заказ); 
                    НоваяЗапись = НаборЗаписей.Добавить(); 
                    НоваяЗапись.ЗаказКлиента = Стр.Заказ; 
                    НоваяЗапись.ПоступлениеБДС = Ссылка; 
                    НаборЗаписей.Записать();
                КонецЕсли;
				//++ #1349 смарт: Фролов 03.05.2023 //Добавить оповещение при оплате 30% при поступлении оплаты. Продолжение задачи 1134
				Если ТипЗнч(Стр.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") 
                    И Стр.Заказ.Проведен И НЕ Стр.Заказ.ПометкаУдаления 
                    И НЕ Стр.Заказ.Статус = Перечисления.СостоянияЗаказовКлиентов.Закрыт Тогда
					смартСервер.ОтправитьПисьмоПоОплатеЗаказа(Стр.Заказ);
				Конецесли;	
				//-- #1349 смарт: Фролов 03.05.2023
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;  
//-- #1116 смарт: Фролов 17.01.2023
КонецПроцедуры 
#КонецОбласти
