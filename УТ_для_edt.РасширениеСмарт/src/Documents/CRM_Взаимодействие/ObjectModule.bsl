//++ #Б-2354 смарт: Фролов 17.02.2025 //Ввод нового регламента. Вывод данных из регистра состояние партнеров.
Процедура смарт_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	ДополнительныеСвойства.Вставить("ЗаписьНовогоВзаимодействия", ЭтоНовый());
	ДополнительныеСвойства.Вставить("СтатусВзаимодействияПередЗаписью", Ссылка.СтатусВзаимодействия);

