		НоваяСтрока.ВведенНаОсновании	= Ложь;
		НоваяСтрока.ОсновнойИнтерес		= Истина;
		ДополнительныеСвойства.Вставить("CRM_ТаблицаИнтересов", ТаблицаСвязей);
	КонецЕсли;
	
	#Вставка
	//++ #Б-2354 смарт: Фролов 17.02.2025 //Ввод нового регламента. Вывод данных из регистра состояние партнеров.
	Если ЗначениеЗаполнено(Партнер) И НЕ ЗначениеЗаполнено(ДокументОснование)
