&НаСервере
&ИзменениеИКонтроль("ПередЗаписьюНаСервере")
//++ #Б-4382 смарт: Фролов 22.09.2025 //Доработка документа Взаимодействие в интересах планируемых Акций.
Процедура смарт_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	#Вставка
	//++ #Б-6638 смарт: Фролов 19.06.2026 //Указание причины переноса взаимодействия. Пока только для СЦ.
	Если НЕ ТекущийОбъект.Ссылка.Пустая() Тогда
		
		Если НЕ ТекущийОбъект.ПлановаяДата = ТекущийОбъект.Ссылка.ПлановаяДата И НЕ ЗначениеЗаполнено(ТекущийОбъект.смартПричинаПереносаСрока) Тогда
			
			Если ЗначениеЗаполнено(ТекущийОбъект.Партнер) И ТекущийОбъект.Партнер.смартОсновнойМенеджерСервисЦентра = ТекущийОбъект.Ответственный Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Заполните причину переноса сроков!", , "Объект.смартПричинаПереносаСрока");
				Отказ = Истина;
				Возврат;
			
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	//-- #Б-6638 смарт: Фролов 19.06.2026
	#КонецВставки
	
	ЭтоНовыйОбъект = ТекущийОбъект.Ссылка.Пустая();
	ПризнакНовогоМероприятия = ЭтоНовыйОбъект;
	Если ТекущийОбъект.СтатусВзаимодействия.ТипСостояния = Перечисления.CRM_ТипыСостоянийСобытий.Завершено И ТекущийОбъект.СтатусВзаимодействия<>ТекущийОбъект.Ссылка.СтатусВзаимодействия Тогда
		Если ЗначениеЗаполнено(ТекущийОбъект.ДокументОснование) И ТипЗнч(ТекущийОбъект.ДокументОснование) = Тип("ДокументСсылка.CRM_Интерес") Тогда
			УстановитьПривилегированныйРежим(Истина);
			ТекущийОбъект.СостояниеИнтереса = ТекущийОбъект.ДокументОснование.СостояниеИнтереса;
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли; 
		ТекущийОбъект.ДатаЗавершенияВзаимодействия = ТекущаяДатаСеанса();
		ТекущийОбъект.ЗавершившийПользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;	
	Если ТекущийОбъект.СтатусВзаимодействия.ТипСостояния <> Перечисления.CRM_ТипыСостоянийСобытий.Завершено И ЗначениеЗаполнено(ТекущийОбъект.ДатаЗавершенияВзаимодействия) Тогда
		ТекущийОбъект.ДатаЗавершенияВзаимодействия = Дата(1,1,1);
	КонецЕсли;
	ТекущийОбъект.ОрганизаторGApi = ТекущийОбъект.Ответственный;
	ТекущийОбъект.СторонниеЛица.Свернуть("Партнер,КонтактноеЛицо,ПотенциальныйКлиент,Адрес,ПредставлениеАдреса,Принадлежность,Телефон,ПосетитМероприятие,АдресОфиса","ОтправлятьСМС,ОтправлятьПоПочте");
	// Периодичность
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ПериодическоеСобытиеСпособИзмененияРяда",ПериодическоеСобытиеСпособИзмененияРяда);
	Если ЗначениеЗаполнено(ТекущийОбъект.РядСобытий) Тогда
		Если (ПризнакПериодическоеСобытиеИнициализация Или ПризнакИзмененоРасписание) И ТекущийОбъект.Периодическое Тогда
			Если ПризнакПериодическоеСобытиеИнициализация Тогда
				ПериодическоеСобытиеСпособИзмененияРяда = "ВесьРяд";
			КонецЕсли;
			Если ПериодическоеСобытиеСпособИзмененияРяда = "ВесьРяд" Тогда
				МассивДатРасписания = Справочники.CRM_РядыСобытий.ПолучитьМассивДатРасписания(ТекущийОбъект.РядСобытий.ДатаНачала, ТекущийОбъект.РядСобытий.ДатаОкончания, ТекущийОбъект.РядСобытий);
			ИначеЕсли ПериодическоеСобытиеСпособИзмененияРяда = "ДоКонцаРяда" Тогда
				МассивДатРасписания = Справочники.CRM_РядыСобытий.ПолучитьМассивДатРасписания(ТекущийОбъект.ПлановаяДата, ТекущийОбъект.РядСобытий.ДатаОкончания, ТекущийОбъект.РядСобытий);
			Иначе
				МассивДатРасписания = Справочники.CRM_РядыСобытий.ПолучитьМассивДатРасписания(ТекущийОбъект.РядСобытий.ДатаНачала, ТекущийОбъект.РядСобытий.ДатаОкончания, ТекущийОбъект.РядСобытий);
			КонецЕсли;
			Если МассивДатРасписания.Количество() = 0 Тогда
				Если ПризнакПериодическоеСобытиеИнициализация Или ПериодическоеСобытиеСпособИзмененияРяда = "ВесьРяд" Тогда
					Отказ = Истина;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Расписание периодического события настроенно некорректно - в указанный период не попадает ни одного события!';en='The schedule of periodic event are adjust incorrectly - to the specified period did not get any event!'"));
					Элементы.РядСобытийНаименование.Доступность = (Объект.Периодическое И ЗначениеЗаполнено(Объект.РядСобытий) И Не Объект.ИзмененоВРяде);
					Элементы.РядСобытийНаименование.Видимость = Объект.Периодическое;
					Возврат;
				КонецЕсли;
			Иначе
				ДатаВремяПервоеСобытие = МассивДатРасписания[0];
				ТекущийОбъект.ПлановаяДата = НачалоДня(ДатаВремяПервоеСобытие) + (ТекущийОбъект.ПлановаяДата - НачалоДня(ТекущийОбъект.ПлановаяДата)) ;
				ТекущийОбъект.ПлановаяДатаЗавершение = НачалоДня(ДатаВремяПервоеСобытие) + (ТекущийОбъект.ПлановаяДатаЗавершение - НачалоДня(ТекущийОбъект.ПлановаяДатаЗавершение));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Признаки. по которым в дальнейшем после записи будем определять, надо ли	оповестить участников мероприятия.
	ЭтоНовыйОбъект = ТекущийОбъект.Ссылка.Пустая();
	ПризнакНовогоМероприятия = ЭтоНовыйОбъект;
	Если НЕ ЭтоНовыйОбъект Тогда
		Если НЕ (ТекущийОбъект.ПлановаяДата = ТекущийОбъект.Ссылка.ПлановаяДата) ИЛИ НЕ (ТекущийОбъект.ПлановаяДатаЗавершение = ТекущийОбъект.Ссылка.ПлановаяДатаЗавершение) Тогда
			ПризнакИзмененаДата = Истина;
		КонецЕсли;
		Если НЕ (ТекущийОбъект.Место = ТекущийОбъект.Ссылка.Место) Тогда
			ПризнакИзмененоМестоМероприятия = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ (Год(ТекущийОбъект.Дата) = Год(ТекущийОбъект.Ссылка.Дата)) Тогда
		ТекущийОбъект.УстановитьНовыйНомер();
	КонецЕсли;
	ПроверитьНаличиеНовыхУчастников(ТекущийОбъект);
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ОбъектЗаписанПользователем");
	Если ТекущийПользователь = Объект.Ответственный Или Не ПризнакНовогоМероприятия Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("НеСоздаватьОповещенияПоУмолчанию");
	КонецЕсли;
	CRM_СобытияФорм.ПередЗаписьюНаСервере(ЭтотОбъект, Отказ, ТекущийОбъект, ПараметрыЗаписи);
	// СтандартныеПодсистемы.Свойства
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Свойства") Тогда
		МодульУправлениеСвойствами = ОбщегоНазначения.ОбщийМодуль("УправлениеСвойствами");
		МодульУправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства 
	
	#Вставка
	//++ #Б-4382 смарт: Фролов 22.09.2025 //Доработка документа Взаимодействие в интересах планируемых Акций.
	Если ЗначениеЗаполнено(ТекущийОбъект.смартВидЗадачи) И ТекущийОбъект.смартВидЗадачи.Акция Тогда
		
		Если НЕ ТекущийОбъект.СтатусВзаимодействия = ТекущийОбъект.Ссылка.СтатусВзаимодействия
			И (ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Завершено
			ИЛИ ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Отменено) Тогда
			
			Если СокрЛП(ТекущийОбъект.Результат) = "" Тогда
				
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю("Обязательно заполните результат!", , "Результат");
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если ТекущийОбъект.ПлановаяДата > ТекущийОбъект.смартВидЗадачи.ДатаОкончанияАкции 
			//++ #Б-4522 смарт: Фролов 01.10.2025 //Ошибка при завершении Акционного взаимодействия. 
			И НЕ (ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Завершено
			ИЛИ ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Отменено) Тогда
			//-- #Б-4522 смарт: Фролов 01.10.2025
			
			Отказ = Истина;
			ОбщегоНазначения.СообщитьПользователю("Дата окончание акции " + Формат(ТекущийОбъект.смартВидЗадачи.ДатаОкончанияАкции, "ДФ=dd.MM.yyyy")
				+ ", вы пытаетесь запланировать взаимодействие позже!", , "ДатаНачала");
			
		КонецЕсли;	
		
	КонецЕсли;
	//-- #Б-4382 смарт: Фролов 22.09.2025	
	
	//++ #Б-6346 смарт: Фролов 14.05.2026 //Взаимодействие. Внедрение контроля за встречами со связями к интересам.
	Если ТекущийОбъект.ВидВзаимодействия = Справочники.CRM_ВидыВзаимодействий.ВыезднаяВстречаИнтерес
		ИЛИ ТекущийОбъект.ВидВзаимодействия = Справочники.CRM_ВидыВзаимодействий.ВыезднаяВстречаПартнер Тогда
				
		Если ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Запланировано
			ИЛИ ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.ВРаботе Тогда
			
			Если СокрЛП(ТекущийОбъект.Содержание) = "" Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнено описание",,, "Объект.Содержание", Отказ);	
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекущийОбъект.КонтактноеЛицо) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнено Контактное лицо",,, "Объект.КонтактноеЛицо", Отказ);	
				
			КонецЕсли;	
			
		ИначеЕсли ТекущийОбъект.СтатусВзаимодействия = Справочники.CRM_СостоянияСобытий.Завершено Тогда	
			
			Если СокрЛП(ТекущийОбъект.Результат) = "" Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнено описание",,, "Объект.Результат", Отказ);	
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекущийОбъект.смартРезультатВстречи) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнен Результат встречи",,, "Объект.смартРезультатВстречи", Отказ);	
				
			КонецЕсли;
			
			//++ #Б-7440 смарт: Фролов 15.07.2026 //Взаимодействие. Выездная встреча. Доработка.
			Если ЗначениеЗаполнено(ТекущийОбъект.смартРезультатВстречи) 
				И ТекущийОбъект.смартРезультатВстречи = Перечисления.смартРезультатыВстреч.Положительный 
				И НЕ ЗначениеЗаполнено(ТекущийОбъект.ДокументОснование) Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Не заполнен Интерес",,, "Объект.ДокументОснование", Отказ);	
				
			КонецЕсли;
			//-- #Б-7440 смарт: Фролов 15.07.2026
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #Б-6346 смарт: Фролов 14.05.2026
	#КонецВставки
	
КонецПроцедуры //-- #Б-4382 смарт: Фролов 22.09.2025

&НаКлиенте
&ИзменениеИКонтроль("ДатаНачалаПриИзменении")
//++ #Б-5476 смарт: Фролов 28.01.2026 //Добавить проверку на максимальный срок взаимодействия в другие формы
Процедура смарт_ДатаНачалаПриИзменении(Элемент)
	
	#Вставка
	//++ #Б-5476 смарт: Фролов 28.01.2026 //Добавить проверку на максимальный срок взаимодействия в другие формы
	СрокМаксимальногоПланированияВзаимодействийВДнях = смартОбщегоНазначения.ПолучитьЗначениеСправочникаПредопределенныеПоНовому(
			"СрокМаксимальногоПланированияВзаимодействийВДнях");
		
	Если СрокМаксимальногоПланированияВзаимодействийВДнях > 0 
		И ДатаНачала > Объект.Дата + 3600 * 24 * СрокМаксимальногоПланированияВзаимодействийВДнях Тогда
			
		ОбщегоНазначенияКлиент.СообщитьПользователю("Нельзя планировать взаимодействия на срок более " + СрокМаксимальногоПланированияВзаимодействийВДнях + " дней!");
		ДатаНачала = Объект.ПлановаяДата;
		Возврат;	
			
	КонецЕсли;
	//-- #Б-5476 смарт: Фролов 28.01.2026
	#КонецВставки
	
	Если ЭтоВстречаЖурнала Тогда
		Если НЕ ПроверитьКорректностьДаты(ДатаНачала, "ДатаНачала") Тогда
			ДатаНачала = Объект.ПлановаяДата;
			Возврат;
		КонецЕсли;	
	КонецЕсли;
	СтараяДатаНачала	= Объект.ПлановаяДата; 
	Объект.ПлановаяДата	= CRM_ОбщегоНазначенияКлиентСервер.СформироватьДатуИзДатыИВремени(ДатаНачала, ВремяНачала);
	Если НачалоДня(Объект.ПлановаяДата) > НачалоДня(Объект.ПлановаяДатаЗавершение) Тогда
		Если НачалоДня(СтараяДатаНачала) = ДатаОкончанияПлан Тогда
			ДатаОкончанияПлан	= ДатаНачала;
		Иначе	
			ДатаОкончанияПлан	= НачалоДня(ДатаНачала + (Объект.ПлановаяДатаЗавершение - СтараяДатаНачала));
		КонецЕсли;	
		Объект.ПлановаяДатаЗавершение	= CRM_ОбщегоНазначенияКлиентСервер.СформироватьДатуИзДатыИВремени(ДатаОкончанияПлан, ВремяОкончанияПлан);
	КонецЕсли;
	Если Объект.Периодическое Тогда
		ПризнакИзмененоРасписание = Истина;
	КонецЕсли;
	ПересчитатьДатыОповещений();
КонецПроцедуры //-- #Б-5476 смарт: Фролов 28.01.2026

#КонецОбласти 