#Область ПеренесеноСДоработками

//++ #1646 смарт: Мосолов 20.02.2024 // Контроль разобранного оборудования и снятых запчастей	
&ИзменениеИКонтроль("ОбработкаЗаполнения")
Процедура смарт_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьДокументПоОтбору(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		ЗаполнитьПоЗаказуКлиента(ДанныеЗаполнения); 
		
	#Вставка
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		
		ДокументОснование = ДанныеЗаполнения;
	//-- #1989 смарт: Лопато 15.08.2024
	
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования") Тогда
		
		//++ #1901 смарт: Ермаков 21.08.2024 / Создание документа Заявка на разборку оборудования	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Заявка", ДанныеЗаполнения);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура
		|ПОМЕСТИТЬ НоменклатураОборудование
		|ИЗ
		|	РегистрСведений.НоменклатураСегмента
		|ГДЕ
		|	Сегмент.смартИдентификаторДляФормул = ""СегментАппаратноеОбеспечение""	
		|; 
		|////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура, Серия, Склад, 
		|	КРазборкеОстаток КАК Количество,
		|	КРазборкеОстаток КАК КоличествоУпаковок			
		|ИЗ
		|	РегистрНакопления.смартОборудованиеКРазборке.Остатки(
		|		,
		|		Заявка = &Заявка 
		|		И Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ НоменклатураОборудование)
		|	)
		|; 
		|////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Номенклатура,
		|	ВЫБОР
		|		КОГДА Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ НоменклатураОборудование) 
		|		ТОГДА Серия
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
		|	КОНЕЦ КАК Серия,
		|	КПолучениюОстаток КАК Количество,
		|	КПолучениюОстаток КАК КоличествоУпаковок		
		|ИЗ
		|	РегистрНакопления.смартОборудованиеКРазборке.Остатки(
		|		,
		|		Заявка = &Заявка
		|	)
		|";
		ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
		
		Выборка = ПакетРезультатовЗапроса[1].Выбрать();
		Если Не Выборка.Следующий() Тогда
			
			// Выслать нахер
			Возврат;
			
		КонецЕсли;
		
		ДокументОснование = ДанныеЗаполнения;
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, Подразделение");
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка, "Склад, Номенклатура, Серия, Количество, КоличествоУпаковок");
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров;
		
		ЭтотОбъект.Товары.Загрузить(ПакетРезультатовЗапроса[2].Выгрузить());
		//-- #1901 смарт: Ермаков 21.08.2024
		
	#КонецВставки
		
	КонецЕсли;

	ИнициализироватьДокумент(ДанныеЗаполнения);

	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ДанныеЗаполнения));
	Если НЕ ОбъектМетаданных = Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", ОбъектМетаданных) Тогда
			ЭтотОбъект.смартЗапчастиГарантийные = ДанныеЗаполнения.смартЗапчастиГарантийные;
		КонецЕсли;
	КонецЕсли;
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки

КонецПроцедуры //-- #1646 смарт: Мосолов 20.02.2024 

//++ смарт:ММ #059 327 02.08.2020 - Перенос даты резерва, спр. Грузы
&ИзменениеИКонтроль("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда

		Возврат;

	КонецЕсли;

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);

	ЗаказыСервер.УстановитьКлючВСтрокахТабличнойЧасти(ЭтотОбъект, "Товары");

	ПараметрыСерий = НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ЗаказНаСборку);
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыСерий);

	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);

	ПараметрыОкругления = ОбщегоНазначенияУТ.ПараметрыОкругленияКоличестваШтучныхТоваров();
	ПараметрыОкругления.ИмяТЧ = "Объект";
	ОбщегоНазначенияУТ.ОкруглитьКоличествоШтучныхТоваров(ЭтотОбъект, РежимЗаписи, ПараметрыОкругления);

	ОбщегоНазначенияУТ.ОкруглитьКоличествоШтучныхТоваров(ЭтотОбъект, РежимЗаписи);

	#Удаление
	ШаблонНазначения = Документы.ЗаказНаСборку.ШаблонНазначения(ЭтотОбъект);
	ПерегенерацияНазначения = Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(
	?(ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров, НазначениеТовары, Назначение),
	ШаблонНазначения, ЭтотОбъект, "НаправлениеДеятельности", Отказ);
	#КонецУдаления
	#Вставка
	//++ #Б2934 смарт: Шляпников 01.04.2025 / Заявка на разборку оборудования. Дополнение. Последующие разборки.
	Если НЕ ТипЗнч(ЭтотОбъект.ДокументОснование) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования") ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект.ДокументОснование) Тогда
		
		ШаблонНазначения = Документы.ЗаказНаСборку.ШаблонНазначения(ЭтотОбъект);
		ПерегенерацияНазначения = Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(
									?(ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров, НазначениеТовары, Назначение),
									ШаблонНазначения, ЭтотОбъект, "НаправлениеДеятельности", Отказ);
									
	Иначе
									
		ПерегенерацияНазначения = Ложь;
		
		Если ЭтотОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РазборкаТоваров Тогда
			ЭтотОбъект.Назначение = ЭтотОбъект.ДокументОснование.Назначение;
		КонецЕсли;
		
	КонецЕсли;
	//-- #Б2934 смарт: Шляпников 01.04.2025
	#КонецВставки

	Если ПерегенерацияНазначения Тогда
		ОбосабливатьПоНазначениюЗаказа = Константы.ВариантОбособленияТоваровВСборке.Получить()
		<> Перечисления.ВариантыОбособленияТоваровВСборке.НазначениеСобираемогоКомплекта;
	КонецЕсли;  
	
	#Вставка
	
	//++ смарт:КМД #2_4 327 01.02.2021
	//++ смарт:ММ #059 327 02.08.2020 - Перенос даты резерва, спр. Грузы 
	//проверка на новый документ и на факт проведения
	Если ЗначениеЗаполнено(Ссылка) И РежимЗаписи = РежимЗаписиДокумента.Проведение тогда
		
		// Проверка, изменились ли даты начала и окончания сборки
		
		ДатыДоИзмененияСтруктура = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "НачалоСборкиРазборки, ОкончаниеСборкиРазборки");
		
		Если ДатыДоИзмененияСтруктура.ОкончаниеСборкиРазборки <> ЭтотОбъект.ОкончаниеСборкиРазборки тогда
			
			ДополнительныеСвойства.Вставить("смартИзмениласьДатаПоступленияДокумента", Истина);
			
			ТаблицаИзменившихсяДатПоступления = смартСтруктураТаблицыИзменилисьДаты();
			
			Если ЭтотОбъект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.СборкаТоваров") тогда
				//в этом проверяем собранный товар из шапки
				НовСтр = ТаблицаИзменившихсяДатПоступления.Добавить();
				НовСтр.Номенклатура = ЭтотОбъект.Номенклатура;
				НовСтр.Характеристика = ЭтотОбъект.Характеристика;
				НовСтр.ДатаПоступления = ЭтотОбъект.ОкончаниеСборкиРазборки;
				НовСтр.Количество = ЭтотОбъект.Количество;
				НовСтр.Склад = ЭтотОбъект.Склад;
				НовСтр.ДатаПоступленияНачальная = ДатыДоИзмененияСтруктура.ОкончаниеСборкиРазборки;
			Иначе
				//разборка товаров
				//проверяем разобранный товар из ТЧ Товары
				Для каждого стр из ЭтотОбъект.Товары цикл
					НовСтр = ТаблицаИзменившихсяДатПоступления.Добавить();
					НовСтр.Номенклатура = стр.Номенклатура;
					НовСтр.Характеристика = стр.Характеристика;
					НовСтр.ДатаПоступления = ЭтотОбъект.ОкончаниеСборкиРазборки;
					НовСтр.Количество = стр.Количество;
					НовСтр.Склад = ЭтотОбъект.Склад;
					НовСтр.ДатаПоступленияНачальная = ДатыДоИзмененияСтруктура.ОкончаниеСборкиРазборки;
				КонецЦикла;
			КонецЕсли;
			
			ДополнительныеСвойства.Вставить("смартТаблицаИзменившихсяДатПоступления", ТаблицаИзменившихсяДатПоступления);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//++ смарт:КМД #2_4 327 24.12.2020
	//сбор таблицы для проверки отрицательных остатков
	Если ДополнительныеСвойства.Свойство("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений") = Ложь тогда
		
		//++ смарт:Демичев №1133 28.09.2022
		Если ЭтотОбъект.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.СборкаТоваров") тогда
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЗаказНаСборку.Номенклатура КАК Номенклатура,
			|	ЗаказНаСборку.Характеристика КАК Характеристика,
			|	ЗаказНаСборку.Склад КАК Склад
			|ИЗ
			|	Документ.ЗаказНаСборку КАК ЗаказНаСборку
			|ГДЕ
			|	ЗаказНаСборку.Ссылка = &Ссылка";
			
			ТаблицаДляПроверкиОтрицательныхОстатков = Запрос.Выполнить().Выгрузить();
			ДополнительныеСвойства.Вставить("смартТаблицаДляПроверкиОтрицательныхОстатков", ТаблицаДляПроверкиОтрицательныхОстатков);
			
		Иначе//++ смарт:Демичев №1133 28.09.2022((В результате разборки на комплектующие
			
			//сбор таблицы для проверки отрицательных остатков по ТЧ
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			Запрос.Текст = "ВЫБРАТЬ
			|	ЗаказНаСборкуТовары.Номенклатура КАК Номенклатура,
			|	ЗаказНаСборкуТовары.Характеристика КАК Характеристика,
			|	ЗаказНаСборкуТовары.Ссылка.Склад КАК Склад
			|ИЗ
			|	Документ.ЗаказНаСборку.Товары КАК ЗаказНаСборкуТовары
			|ГДЕ
			|	ЗаказНаСборкуТовары.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗаказНаСборкуТовары.Характеристика,
			|	ЗаказНаСборкуТовары.Номенклатура,
			|	ЗаказНаСборкуТовары.Ссылка.Склад";
			
			ТаблицаДляПроверкиОтрицательныхОстатковСкладОтправитель = Запрос.Выполнить().Выгрузить();
			ДополнительныеСвойства.Вставить("смартТаблицаДляПроверкиОтрицательныхОстатковТовары", ТаблицаДляПроверкиОтрицательныхОстатковСкладОтправитель);
			
		КонецЕсли;
		//-- смарт:Демичев №1133 28.09.2022
	КонецЕсли; 
	
	//++ #1901 смарт: Ермаков 21.08.2024 / Создание документа Заявка на разборку оборудования	
	// Отключил ниже 
	
	//++ #1646 смарт: Мосолов 20.02.2024 // Контроль разобранного оборудования и снятых запчастей 
	
	//Если ЭтоНовый() Тогда  
	//	
	//	Если ЗначениеЗаполнено(Номенклатура) 
	//		И Номенклатура.ВидНоменклатуры = Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение
	//		И Номенклатура.ВидНоменклатуры.ИспользоватьСерии 
	//		И (Не ЗначениеЗаполнено(ДокументОснование) 
	//			ИЛИ НЕ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы")) Тогда
	//		
	//		ТипДокумента = ?(ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров, "сборки", "разборки");
	//		ТекстСообщения = "Для " + ТипДокумента + " оборудования необходимо обязательно делать документ на основании Заявки на ремонтные работы"; 
	//		
	//		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);  
	//		
	//	КонецЕсли;   
	//	
	//КонецЕсли;
	
	//-- #1646 смарт: Мосолов 20.02.2024 
	//-- #1901 смарт: Ермаков 21.08.2024
	
	#КонецВставки

КонецПроцедуры

&ИзменениеИКонтроль("ПриЗаписи")
Процедура смарт_ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Добавление заказа для расчета состояний необходимо для тех случаев когда, например, для всех товаров указан способ
	// обеспечения "Не обеспечивать". При таком способе обеспечения документ не делает движений по тем регистрам, которые
	// добавили бы заказ для расчета самостоятельно.
	ПроведениеСерверУТ.ДобавитьЗаказДляРасчетаСостояний(ДополнительныеСвойства, Ссылка);

	#Удаление
	ШаблонНазначения = Документы.ЗаказНаСборку.ШаблонНазначения(ЭтотОбъект);
	Справочники.Назначения.ПриЗаписиДокумента(
	?(ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров, НазначениеТовары, Назначение),
	ШаблонНазначения, ЭтотОбъект, Склад, СборкаПодДеятельность);
	#КонецУдаления
	#Вставка
	//++ #Б2934 смарт: Шляпников 01.04.2025 / Заявка на разборку оборудования. Дополнение. Последующие разборки.
	Если НЕ ТипЗнч(ЭтотОбъект.ДокументОснование) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования") ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект.ДокументОснование) Тогда
		
		ШаблонНазначения = Документы.ЗаказНаСборку.ШаблонНазначения(ЭтотОбъект);
		Справочники.Назначения.ПриЗаписиДокумента(
										?(ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СборкаТоваров, НазначениеТовары, Назначение),
										ШаблонНазначения, ЭтотОбъект, Склад, СборкаПодДеятельность);
									
	КонецЕсли;
	//-- #Б2934 смарт: Шляпников 01.04.2025
	#КонецВставки

	Если Не Отказ
		И Не ДополнительныеСвойства.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда

		РегистрыСведений.РеестрДокументов.ИнициализироватьИЗаписатьДанныеДокумента(Ссылка, ДополнительныеСвойства, Отказ);

	КонецЕсли;

	// При отмене проведения или установке пометки на удаление проведенного документа необходим вызов пересчета состояний,
