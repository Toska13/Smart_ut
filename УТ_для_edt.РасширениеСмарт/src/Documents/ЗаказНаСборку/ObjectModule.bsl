//++ смарт:КМД #2_4 327 28.12.2020
Функция смарт_НайтиОтрицательныйОстатокДоступныеОстаткиПланируемыхПоступлений(Номенклатура, Характеристика, Склад)
	ОтрицательныйОстаток = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ДоступныеОстаткиПланируемыхПоступлений.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.ДоступныеОстаткиПланируемыхПоступлений КАК ДоступныеОстаткиПланируемыхПоступлений
	|ГДЕ
	|	ДоступныеОстаткиПланируемыхПоступлений.Номенклатура = &Номенклатура
	|	И ДоступныеОстаткиПланируемыхПоступлений.Характеристика = &Характеристика
	|	И ДоступныеОстаткиПланируемыхПоступлений.Склад = &Склад
	|	И ДоступныеОстаткиПланируемыхПоступлений.Количество < 0
	|	И ДоступныеОстаткиПланируемыхПоступлений.ДатаДоступности = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|";
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Если ЗначениеЗаполнено(Выборка.Количество) тогда
			ОтрицательныйОстаток = Выборка.Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОтрицательныйОстаток;

КонецФункции

//++ смарт:КМД #2_4 327 28.12.2020
Функция смарт_ТекстЗапросаГрафики()
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГрафикПоступленияТоваровОбороты.ДатаСобытия КАК ДатаСобытия,
	|	ГрафикПоступленияТоваровОбороты.КоличествоИзЗаказовПриход КАК КоличествоПоступление
	|ИЗ
	|	РегистрНакопления.ГрафикПоступленияТоваров.Обороты(
	|			,
	|			,
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Склад = &Склад) КАК ГрафикПоступленияТоваровОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСобытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГрафикОтгрузкиТоваровОбороты.ДатаОтгрузки КАК ДатаОтгрузки,
	|	ГрафикОтгрузкиТоваровОбороты.КоличествоИзЗаказовПриход КАК КоличествоОтгрузка,
	|	ГрафикОтгрузкиТоваровОбороты.Регистратор КАК Документ
	|ИЗ
	|	РегистрНакопления.ГрафикОтгрузкиТоваров.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Склад = &Склад) КАК ГрафикОтгрузкиТоваровОбороты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОтгрузки
	|";

	
	Возврат Текст;

КонецФункции

//++ смарт:КМД #2_4 327 28.12.2020
Процедура смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, Склад, МассивТиповДокументов, СдвигатьРекурсивноЗаказыНаПеремещение, СдвигатьНазад)

	//найдем таблица по графикам отгрузки и поступления
	//распланируем даты отгрузки в зависимости от дат поступления
	
	Запрос = Новый Запрос;
	Запрос.Текст = смарт_ТекстЗапросаГрафики();
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТЗГрафикПоступления = МассивРезультатов[0].Выгрузить();
	ТЗГрафикОтгрузки = МассивРезультатов[1].Выгрузить();
	
	ТЗГрафикОтгрузки.Колонки.Добавить("ДатаСдвига", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	//для каждого документа из ТЗГрафикОтгрузки найдем даты, на которые надо перенести документ для того, чтобы график был корректным
	//разбивка строк в документах графика отгрузки не предусмотрена согласно условиям задачи!
	Для каждого стр_отгрузка из ТЗГрафикОтгрузки цикл
		КоличествоОтгрузка = стр_отгрузка.КоличествоОтгрузка;
		ДатаОтгрузки = стр_отгрузка.ДатаОтгрузки;
		
		//найдем соответсвующую строку графика поступления
		КоличествоГрафикПриемки = 0; //для поиска строк
		
		ДатаСдвига = Дата("00010101000000");
		
		Для каждого стр_поступление из ТЗГрафикПоступления цикл
			КоличествоГрафикПриемки = КоличествоГрафикПриемки + стр_поступление.КоличествоПоступление;
			Если КоличествоОтгрузка <= КоличествоГрафикПриемки тогда
				ДатаСдвига = стр_поступление.ДатаСобытия;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//обработка таблицы ТЗГрафикПоступления, удаляем уже "занятые" количества
		МассивСтрокУдалить = Новый Массив;
		ОсталосьРаспределить = КоличествоОтгрузка;
		Для каждого стр_поступление из ТЗГрафикПоступления цикл
			Если ОсталосьРаспределить <= 0 тогда
				Прервать;
			КонецЕсли;
			
			РаспределитьТекущаяИтерация = Мин(стр_поступление.КоличествоПоступление, ОсталосьРаспределить);
			
			стр_поступление.КоличествоПоступление = стр_поступление.КоличествоПоступление - РаспределитьТекущаяИтерация;
			ОсталосьРаспределить = ОсталосьРаспределить - РаспределитьТекущаяИтерация;
			
			Если стр_поступление.КоличествоПоступление = 0 тогда
				МассивСтрокУдалить.Добавить(стр_поступление);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивСтрокУдалить.Количество() > 0 тогда
			Для каждого стр_удалить из МассивСтрокУдалить цикл
				ТЗГрафикПоступления.Удалить(стр_удалить);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСдвига) тогда
			//нашли дату сдвига
			Если СдвигатьНазад = Истина тогда
				Если НачалоДня(ДатаСдвига) < НачалоДня(ДатаОтгрузки) тогда
					//в этом случае надо сдвигать дату в документе отгрузки
					стр_отгрузка.ДатаСдвига = ДатаСдвига;
				КонецЕсли;
			Иначе
				Если НачалоДня(ДатаСдвига) > НачалоДня(ДатаОтгрузки) тогда
					//в этом случае надо сдвигать дату в документе отгрузки
					стр_отгрузка.ДатаСдвига = ДатаСдвига;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//по наличию дат сдвигов сдвигаем документы
	//поддерживается сдвиг следующий документов:
	//1. ЗаказКлиента
	//2. ЗаказНаПеремещение
	//3. ЗаказНаСборку
	//4. ЗаказНаВнутреннееПотребление
	
	МассивИзмененныхЗаказовНаПеремещение = Новый Массив;
	
	Для каждого стр_отгрузка из ТЗГрафикОтгрузки цикл
		Если ЗначениеЗаполнено(стр_отгрузка.ДатаСдвига) тогда
			смарт_СдвинутьДокументИзменениеДокумента(МассивТиповДокументов, стр_отгрузка.Документ, стр_отгрузка.ДатаСдвига, Номенклатура, Характеристика, Склад, МассивИзмененныхЗаказовНаПеремещение);
		КонецЕсли;
	КонецЦикла;
	
	//рекурсивно сдвигаем даты "подчиненных" документов по складам получателям в заказах на перемещение
	//глубина вложенности - 1, то есть если будет несколько перемещений (Склад 1 - Склад 2 - Склад 3 - Заказ клипента склад 3), то заказ клиента исправлен не будет
	Если СдвигатьРекурсивноЗаказыНаПеремещение = Истина тогда
		Для каждого ЗаказНаПеремещение из МассивИзмененныхЗаказовНаПеремещение цикл
			СкладПеремещение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказНаПеремещение, "СкладПолучатель");
			Если ЗначениеЗаполнено(СкладПеремещение) тогда
				Если СдвигатьНазад = Истина тогда
					смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, СкладПеремещение, МассивТиповДокументов, Ложь, СдвигатьНазад);
				Иначе
					ОтрицательныйОстаток = смарт_НайтиОтрицательныйОстатокДоступныеОстаткиПланируемыхПоступлений(Номенклатура, Характеристика, СкладПеремещение);
					Если ОтрицательныйОстаток < 0 тогда
						смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, СкладПеремещение, МассивТиповДокументов, Ложь, СдвигатьНазад);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

//++ смарт:КМД #2_4 327 28.12.2020
Процедура смарт_СдвинутьДокументИзменениеДокумента(МассивТиповДокументов, Док, ДатаСдвига, Номенклатура, Характеристика, Склад, МассивИзмененныхЗаказовНаПеремещение)
	ТипДок = ТипЗнч(Док);
	
	Если МассивТиповДокументов.Найти(ТипДок) <> Неопределено тогда
		//меняем данные в документах и проводим
		Об = Док.ПолучитьОбъект();
		
		Попытка
			Об.Заблокировать();
		Исключение			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Строка(Док) + " не возможно изменить, он заблокирован: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		ОбъектИзменен = Ложь;
		
		Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") ИЛИ
			ТипДок = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") тогда
			//отгрузить одной датой
			Если Об.НеОтгружатьЧастями = Истина тогда
				//если заказ отгружается одной датой, то снимаем этот признак, для того чтобы подвинуть дату по конкретному товару
				Об.НеОтгружатьЧастями = Ложь;
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Номенклатура);
			Отбор.Вставить("Характеристика", Характеристика);
			Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") тогда
				Отбор.Вставить("Склад", Склад);
			КонецЕсли;
			Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
			
			МассивСтрок = Об.Товары.НайтиСтроки(Отбор);
			Для каждого стр из МассивСтрок цикл
				стр.ДатаОтгрузки = ДатаСдвига;
				ОбъектИзменен = Истина;
			КонецЦикла;
		ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаСборку") тогда
			Об.НачалоСборкиРазборки = ДатаСдвига;
			Об.ОкончаниеСборкиРазборки = ДатаСдвига;
				
			ОбъектИзменен = Истина;
		ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаПеремещение") тогда
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Номенклатура);
			Отбор.Вставить("Характеристика", Характеристика);
			Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
			
			МассивСтрок = Об.Товары.НайтиСтроки(Отбор);
			Для каждого стр из МассивСтрок цикл
				стр.НачалоОтгрузки = ДатаСдвига;
				ОбъектИзменен = Истина;
			КонецЦикла;
		КонецЕсли;
		
		Если ОбъектИзменен Тогда
			//++ КМД 01.02.2021
			//добавим доп. свойство для отмены проверки на отрицательные остатки по регистру ДоступныеОстаткиПланируемыхПоступлений
			Об.ДополнительныеСвойства.Вставить("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений", Истина);
			
			Попытка
				Об.Записать(РежимЗаписиДокумента.Проведение);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменены даты резерва в документе """ + Строка(Док) + """", Док);
				
				НомерПоследнейВерсии = смартПолучитьНомерВерсииПоследний(Док);
				Если НомерПоследнейВерсии <> Неопределено Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(Док, НомерПоследнейВерсии, "Автоматический перенос резерва при изменении даты поступления товара");
				КонецЕсли;
				
				Если ТипДок = Тип("ДокументСсылка.ЗаказНаПеремещение") тогда
					МассивИзмененныхЗаказовНаПеремещение.Добавить(Док);
				КонецЕсли;
			Исключение				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ """ + Строка(Док) + """ не записан: " + ОписаниеОшибки());
				//Отказ = Истина;
				//ОтменитьТранзакцию();
				//Возврат;
			КонецПопытки;	
		КонецЕсли;
		
		Об.Разблокировать();
	КонецЕсли;
КонецПроцедуры

//++ смарт:КМД #2_4 327 28.12.2020
Функция смартПолучитьНомерВерсииПоследний(СсылкаНаОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Максимум(ВерсииОбъектов.НомерВерсии) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВерсииОбъектов.Объект";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);

	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НомерВерсии;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

//++ #1333 смарт: Фролов 28.03.2023 //Перестал работать контроль остатков резерва к дате (по задаче 327)  
Функция смартПроверитьВозникновениеОтрицательныхОстатков(смартТаблицаДляПроверкиОтрицательныхОстатков,Отказ,ПриПроведении=Ложь,Товары=Ложь)
	Запрос=Новый Запрос;	
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|			ВходящиеДанные.Номенклатура КАК Номенклатура,
	|			ВходящиеДанные.Характеристика КАК Характеристика,
	|			ВходящиеДанные.Склад КАК Склад,
	|			ВходящиеДанные.Количество КАК Количество
	|		ПОМЕСТИТЬ ВТТовары
	|		ИЗ
	|			&ВТДанные КАК ВходящиеДанные
	|		;
    |
	|		////////////////////////////////////////////////////////////////////////////////
	|		ВЫБРАТЬ
	|			Набор.Номенклатура КАК Номенклатура,
	|			Набор.Характеристика КАК Характеристика,
	|			Набор.Склад КАК Склад,
	|			СУММА(Набор.Количество) КАК Количество
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ГрафикПоступленияТоваровОбороты.Номенклатура КАК Номенклатура,
	|				ГрафикПоступленияТоваровОбороты.Характеристика КАК Характеристика,
	|				ГрафикПоступленияТоваровОбороты.Склад КАК Склад,
	|				СУММА(ГрафикПоступленияТоваровОбороты.КоличествоИзЗаказовПриход) КАК Количество
	|			ИЗ
	|				РегистрНакопления.ГрафикПоступленияТоваров.Обороты(
	|						,
	|						,
	|						Регистратор,
	|						(Номенклатура, Характеристика, Склад) В
	|							(ВЫБРАТЬ
	|								Отбор.Номенклатура КАК Номенклатура,
	|								Отбор.Характеристика КАК Характеристика,
	|								Отбор.Склад КАК Склад
	|							ИЗ
	|								ВтТовары КАК Отбор)) КАК ГрафикПоступленияТоваровОбороты
	|			ГДЕ
	|				НЕ ГрафикПоступленияТоваровОбороты.Регистратор = &Регистратор
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ГрафикПоступленияТоваровОбороты.Номенклатура,
	|				ГрафикПоступленияТоваровОбороты.Характеристика,
	|				ГрафикПоступленияТоваровОбороты.Склад
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ГрафикОтгрузкиТоваровОбороты.Номенклатура,
	|				ГрафикОтгрузкиТоваровОбороты.Характеристика,
	|				ГрафикОтгрузкиТоваровОбороты.Склад,
	|				СУММА(-1 * ГрафикОтгрузкиТоваровОбороты.КоличествоИзЗаказовПриход)
	|			ИЗ
	|				РегистрНакопления.ГрафикОтгрузкиТоваров.Обороты(
	|						,
	|						,
	|						Регистратор,
	|						(Номенклатура, Характеристика, Склад) В
	|							(ВЫБРАТЬ
	|								Отбор.Номенклатура КАК Номенклатура,
	|								Отбор.Характеристика КАК Характеристика,
	|								Отбор.Склад КАК Склад
	|							ИЗ
	|								ВтТовары КАК Отбор)) КАК ГрафикОтгрузкиТоваровОбороты
	|			ГДЕ
	|				НЕ ГрафикОтгрузкиТоваровОбороты.Регистратор = &Регистратор
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ГрафикОтгрузкиТоваровОбороты.Номенклатура,
	|				ГрафикОтгрузкиТоваровОбороты.Склад,
	|				ГрафикОтгрузкиТоваровОбороты.Характеристика
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ВТТовары.Номенклатура,
	|				ВТТовары.Характеристика,
	|				ВТТовары.Склад,
	|				СУММА(ВТТовары.Количество)
	|			ИЗ
	|				ВТТовары КАК ВТТовары
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ВТТовары.Номенклатура,
	|				ВТТовары.Склад,
	|				ВТТовары.Характеристика) КАК Набор
    |
	|		СГРУППИРОВАТЬ ПО
	|			Набор.Номенклатура,
	|			Набор.Характеристика,
	|			Набор.Склад
	|		ИМЕЮЩИЕ
	|		СУММА(Набор.Количество) < 0";
	Запрос.УстановитьПараметр("Регистратор",Этотобъект.Ссылка);

	смартТаблицаДляПроверкиОтрицательныхОстатков.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	Если Товары Тогда
		Для Каждого Стр Из смартТаблицаДляПроверкиОтрицательныхОстатков Цикл 
			КоличествоВСтр=0;
			Если ПриПроведении Тогда
				СтрокиТовары=ЭтотОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));	
				Для Каждого СтрТовары Из СтрокиТовары Цикл
					Если НЕ СтрТовары.Отменено Тогда
						КоличествоВСтр=КоличествоВСтр+СтрТовары.Количество;
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
			Стр.Количество=КоличествоВСтр;				
		КонецЦикла;	
	Иначе
		Для Каждого Стр Из смартТаблицаДляПроверкиОтрицательныхОстатков Цикл 
			КоличествоВСтр=0;
			Если ПриПроведении Тогда
            	КоличествоВСтр=КоличествоВСтр+ЭтотОбъект.Количество;
			КонецЕсли;
			Стр.Количество=КоличествоВСтр;				
		КонецЦикла;	
	КонецЕсли;
	Запрос.УстановитьПараметр("ВТДанные",смартТаблицаДляПроверкиОтрицательныхОстатков);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда
		Отказ = Истина;
		Если ПриПроведении тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По плану отгрузки товара возникают отрицательные остатки: ");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По плану отгрузки товара возникают отрицательные остатки при отмене проведения / пометке на удаление документа: ");
		КонецЕсли;
		
		Для Каждого Стр Из Рез Цикл
			ТекстОшибки = "По номенклатуре """ + Строка(Стр.Номенклатура) + """";
			Если ЗначениеЗаполнено(Стр.Характеристика) тогда
				ТекстОшибки = ТекстОшибки + "(" + Строка(Стр.Характеристика) + ")";
			КонецЕсли;
			
			ТекстОшибки = ТекстОшибки + " возникает отрицательный остаток " + Формат(Стр.Количество ) + " " + Строка(Стр.Номенклатура.ЕдиницаИзмерения) + " по складу """ + Строка(Стр.Склад) + """";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;	
	КонецЕсли;	
КонецФункции //-- #1333 смарт: Фролов 28.03.2023 

