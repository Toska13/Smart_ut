//++#1517 смарт: Лопато 20.12.2023 //Установка статуса указания серий по дате начала серийного учета номенклатуры
&НаКлиенте
Процедура смартЗаполнитьСтатусыУказанияСерий()

	ПодготовитьЗаполнитьУстановитьВидимостьСерий();
	
КонецПроцедуры //--#1517 смарт: Лопато 20.12.2023	

#КонецОбласти

#Область КонмандыИСобытияЭлементовФормы

&НаКлиенте
Процедура смартВыгрузитьВАтлант(Команда)
	
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Перед выгрузкой заказ необходимо записать !");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Документ", Объект.Ссылка);
	ОткрытьФорму("Документ.ЗаказНаСборку.Форма.смартВыгрузкаВАтлант", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

//++ #Б2972 смарт: Шляпников 07.11.2025 / Раздельный учет товаров. Гарантийные запчасти. Заказ на сборку.
&НаКлиенте
Процедура ТоварысмартЗапчастиГарантийныеПриИзменении(Элемент)
	
	Если НЕ Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
		ТекущаяСтрока.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Требуется");
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
&НаКлиенте
Процедура смартТоварыПриИзменении(Элемент)

	ЗаполнитьДанныеОМаркировкеНоменклатуры();

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция ПроверитьДоступностьВыгрузкиВАтлантПоЗаказу()
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат смартИнтеграцияАтлант.ЭтоСкладАтлант(Объект.Склад) И Пользователи.РолиДоступны("ИспользованиеРабочегоМестаДоставки,ИспользованиеРабочегоМестаРаботникаСклада");
		
КонецФункции

&НаСервере
&ИзменениеИКонтроль("ХозяйственнаяОперацияПриИзмененииСервер")
Процедура смарт_ХозяйственнаяОперацияПриИзмененииСервер()

	Объект.Назначение = Неопределено;
	Объект.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ПустаяСсылка();
	НаправлениеДеятельностиПриИзмененииСервер();

	ЗависимыеРеквизиты = ЗависимыеРеквизиты();
	ЗависимыеРеквизиты.ВариантОбеспечения = Истина;
	УстановитьСвойстваЭлементовФормыЗависимыхРеквизитов(ЗависимыеРеквизиты);
	ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.ЗаказНаСборку));
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.ТЧ);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект,ПараметрыУказанияСерий.Шапка);
	УстановитьВидимостьЭлементовНазначение();
	НастроитьЭлементыСерий();
	УстановитьСвойстваЭлементовФормыХозяйственнаяОперация();
