#Область СобытияФормы

&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	УстановитьТекстЗапросаСписка();

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПриСозданииНаСервере(ЭтаФорма, Элементы.ГруппаГлобальныеКоманды);
	// Конец ИнтеграцияС1СДокументооборотом

	УстановитьВидимость();

	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);

	СтандартныеПодсистемыСервер.УстановитьУсловноеОформлениеПоляДата(ЭтотОбъект, "Список.Дата", Элементы.Дата.Имя);

	#Вставка
	//++ #Б4130 смарт: Шляпников 21.08.2025 / Интеграция с WMS. Атлант. Заказы на сборку и разборку.
	смартФормированиеИнтерфейса.СоздатьКоманду(ЭтаФорма, "смартВыгрузитьВАтлант", "Сформировать пакет документов Атлант (смарт)", "смартВыгрузитьВАтлант");
	смартФормированиеИнтерфейса.СздКнопка(ЭтаФорма, "смартВыгрузитьВАтлант", Элементы.СписокКоманднаяПанель,, "смартВыгрузитьВАтлант", 1);
	//-- #Б4130 смарт: Шляпников 21.08.2025
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#Область КонмандыИСобытияЭлементовФормы

&НаКлиенте
Процедура смартВыгрузитьВАтлант(Команда)
	
	ПараметрыФормы = Новый Структура("Документ", Элементы.Список.ТекущаяСтрока);
	ОткрытьФорму("Документ.ЗаказНаСборку.Форма.смартВыгрузкаВАтлант", ПараметрыФормы,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("СписокПриАктивизацииСтроки")
Процедура смарт_СписокПриАктивизацииСтроки(Элемент)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	#Вставка
	//++ #Б4130 смарт: Шляпников 21.08.2025 / Интеграция с WMS. Атлант. Заказы на сборку и разборку.
	ЗаказНаСборку = Элементы.Список.ТекущаяСтрока;
	Элементы.смартВыгрузитьВАтлант.Доступность = ПроверитьДоступностьВыгрузкиВАтлантПоЗаказу(ЗаказНаСборку);
	//-- #Б4130 смарт: Шляпников 21.08.2025
	#КонецВставки

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция ПроверитьДоступностьВыгрузкиВАтлантПоЗаказу(Заказ)
	
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат смартИнтеграцияАтлант.ЭтоСкладАтлант(Заказ.Склад) И Пользователи.РолиДоступны("ИспользованиеРабочегоМестаДоставки,ИспользованиеРабочегоМестаРаботникаСклада");
		
КонецФункции

#КонецОбласти