	//Для Каждого стрТЗ Из ВрТЗ Цикл //собираем контейнеры в кучу
	//	ПараметрыОтбора = Новый Структура("Номенклатура, Характеристика");

	ТЗРеализаций.Свернуть("Номенклатура,Характеристика,Склад,Назначение,смартНомерЗаявкиНаГарантийныйРемонтСсылка,смартКонтейнер","Количество");
	
	ВрТЗ = Объект.Товары.Выгрузить(,"Номенклатура, Характеристика,Склад,Назначение,смартНомерЗаявкиНаГарантийныйРемонтСсылка");
	ВрТЗ.Свернуть("Номенклатура, Характеристика,Склад,Назначение,смартНомерЗаявкиНаГарантийныйРемонтСсылка");
	
	Для Каждого стрТЗ Из ВрТЗ Цикл //собираем контейнеры в кучу
		ПараметрыОтбора = Новый Структура("Номенклатура, Характеристика,Склад,Назначение,смартНомерЗаявкиНаГарантийныйРемонтСсылка");
	//--#360 смарт: Тимофеева 15.08.2025 	
	
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора,стрТЗ);
		СтрокиНоменклатуры = ТЗРеализаций.НайтиСтроки(ПараметрыОтбора);//Объект.Товары.НайтиСтроки(ПараметрыОтбора);
		СписокКонтейнеров = смартЗаполнитьСписокНаСервере(Новый Массив);
		Если Не СтрокиНоменклатуры.Количество() = 0 Тогда
			Для Каждого СтрНоменклатура Из СтрокиНоменклатуры Цикл
				Если ЗначениеЗаполнено(СтрНоменклатура.смартКонтейнер) Тогда
					ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрНоменклатура.смартКонтейнер);
					Для Каждого Контейнер Из ЗначениеДляКонтейнера Цикл
						Если Контейнер.Пометка Тогда                  
							НайденныйКонтейнер = СписокКонтейнеров.НайтиПоЗначению(Справочники.смартКонтейнеры.ПолучитьСсылку(Новый УникальныйИдентификатор(Контейнер.Ссылка)));
							Если Не НайденныйКонтейнер = Неопределено Тогда
								НайденныйКонтейнер.Пометка = истина;
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;	
			СтрокаJSONНоменклатуры = смартОбщегоНазначения.смартЗаписатьВыбраныеКонтейнерыВJSON(СписокКонтейнеров);
			//запишем в заказ поставщику
			НайденыеСтрокиЗаказа = ОбъектЗаказ.Товары.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаЗаказа Из НайденыеСтрокиЗаказа Цикл
				СтрокаЗаказа.смартКонтейнер = СтрокаJSONНоменклатуры;	
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	Если ОбъектЗаказ.Проведен Тогда Режим = РежимЗаписиДокумента.Проведение Иначе Режим = РежимЗаписиДокумента.Запись КонецЕсли;
	ОбъектЗаказ.Записать(Режим);	
