&НаКлиенте
Процедура ДопРасходыОтвет(РезультатВопроса, ДополнительныеПараметры) Экспорт 
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ДанныеЗаписи=смартДокРасходыВнесеныИзменениеСервер(Объект.Ссылка,смартДопРасходыВнесены);
        Если ДанныеЗаписи.Результат Тогда 
            смартОтветственныйЗаДопРасходы=ДанныеЗаписи.Ответственный;
            Оповестить("Запись_ПоступлениеТоваров");
        Иначе
            ОбщегоНазначенияКлиент.СообщитьПользователю(ДанныеЗаписи.Ошибка,,"смартДопРасходыВнесены");
        КонецЕсли;
    Иначе
        смартДопРасходыВнесены=Ложь;
    КонецЕсли;
    
КонецПроцедуры //-- смарт:Подкин #962 05.04.2022 17:14:49

//Смарт Фролов+ по заявке № 221 "Товары в пути"
&НаСервереБезКонтекста
Функция смартДокРасходыВнесеныИзменениеСервер(Ссылка,ДопРасходыВнесены)
	ДанныеВозврата=Новый Структура("Результат,Ответственный,Ошибка",Истина,Пользователи.ТекущийПользователь());
	Попытка
		смартСервер.ИзменитьДополнительноеСвойство(Ссылка,"смартДопРасходыВнесены",ДопРасходыВнесены);
		смартСервер.ИзменитьДополнительноеСвойство(Ссылка,"смартОтветственныйЗаДопРасходы",ДанныеВозврата.Ответственный);
	Исключение
		ДанныеВозврата.Результат=Ложь;
		ДанныеВозврата.Ошибка=ОписаниеОшибки();
	КонецПопытки;	
	Возврат ДанныеВозврата;	
КонецФункции	


