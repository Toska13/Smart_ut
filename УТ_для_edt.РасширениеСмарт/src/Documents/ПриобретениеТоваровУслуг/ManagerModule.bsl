//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
Функция смартТекстЗапросаТаблицаОборудованиеКРазборке(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "смартОборудованиеКРазборке";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Период 								КАК Период,
	|	ДокументТовары.Назначение.Заказ 		КАК Заявка,
	|	ДокументТовары.Номенклатура 			КАК Номенклатура,
	|	ДокументТовары.Назначение.Заказ.Серия	КАК Серия,
	|	&Склад	 								КАК Склад,
	|	&ПустойСклад	 						КАК СкладПолучатель,
	|	&НазначениеЗаявкаНаРазборку				КАК Назначение,
	|	ДокументТовары.Количество				КАК КЗаказуПоставщику,
	|	ДокументТовары.Количество				КАК КЗаказуПоставщикуЗаказано
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ДокументТовары
	|ГДЕ                                
	|	ДокументТовары.Ссылка = &Ссылка
	|	И ДокументТовары.Назначение.Заказ ССЫЛКА Документ.смартЗаявкаНаРазборкуОборудования
	|	И НЕ ДокументТовары.Назначение.Заказ = ЗНАЧЕНИЕ(Документ.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка)
	|	И ДокументТовары.Назначение.смартРазобранноеОборудованиеТипНазначения = 
	|		ЗНАЧЕНИЕ(Перечисление.смартТипыНазначенийРазобранногоОборудования.НаЗаменуСнятойЗапаснойЧасти)";
			
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

//++#360 смарт: Тимофеева 15.08.2025 / Формирование приходного ордера, учитывая аналитику Контейнер (ИСМ 1903)
Функция смартТекстЗапросаТаблицаГрузыКОформлению(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартГрузыКОформлению";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ПроведениеСерверУТ.ЕстьТаблицаЗапроса("ВтТаблицаКонтейнеры", ТекстыЗапроса) Тогда
		смартТекстЗапросаТаблицаВтКонтейнеры(Запрос, ТекстыЗапроса);
	КонецЕсли;
			
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&Период КАК Период,
	|	ТаблицаТовары.ЗаказПоставщику КАК Заказ,
	|	ТаблицаТовары.Склад КАК Склад,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ТаблицаТовары.Назначение.ДвиженияПоСкладскимРегистрам
	|						ТОГДА ТаблицаТовары.Назначение
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|	КОНЕЦ КАК Назначение,
	|	ТаблицаТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК ЗаявкаНаГарантийныйРемонт,
	|	&Груз КАК Груз,
	|	ЗНАЧЕНИЕ(Справочник.смартКонтейнеры.ПустаяСсылка) КАК Контейнер,
	|	ТаблицаТовары.Количество КАК КОформлению,
	|	0 КАК КПриемке
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ТаблицаТовары
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И НЕ &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)
	|	И ТаблицаТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	&Период,
	|	ТаблицаТовары.ЗаказПоставщику,
	|	ТаблицаТовары.Склад,
	|	ТаблицаТовары.Номенклатура,
	|	ТаблицаТовары.Характеристика,
	|	ТаблицаТовары.Серия,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ТаблицаТовары.Назначение.ДвиженияПоСкладскимРегистрам
	|						ТОГДА ТаблицаТовары.Назначение
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ТаблицаТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка,
	|	&Груз,
	|	ЕСТЬNULL(ВтТаблицаКонтейнеры.Контейнер, ЗНАЧЕНИЕ(Справочник.смартКонтейнеры.ПустаяСсылка)),
	|	0,
	|	ТаблицаТовары.Количество
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ТаблицаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтТаблицаКонтейнеры КАК ВтТаблицаКонтейнеры
	|		ПО (ВтТаблицаКонтейнеры.НомерСтроки = ТаблицаТовары.НомерСтроки)
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И НЕ &ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)
	|	И ТаблицаТовары.Склад.ИспользоватьОрдернуюСхемуПриПоступлении
	|	И ТаблицаТовары.Ссылка.Дата >= ТаблицаТовары.Склад.ДатаНачалаОрдернойСхемыПриПоступлении
	|	И ТаблицаТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))";
	  
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;

КонецФункции

Функция смартТекстЗапросаТаблицаВтКонтейнеры(Запрос, ТекстыЗапроса)
	
	ИмяРегистра = "ВтТаблицаКонтейнеры";
	
	ТекстЗапроса = "
		|ВЫБРАТЬ
		|	НомерСтроки 	КАК НомерСтроки,
		|	Контейнер	 	КАК Контейнер
		|ПОМЕСТИТЬ ВтТаблицаКонтейнеры
		|ИЗ
		|	&ТаблицаКонтейнеров КАК ТаблицаКонтейнеров
		|";

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);

	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьТаблицуКонтейнеров(ДокументСсылка)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0)));
	Таблица.Колонки.Добавить("Контейнер", 	Новый ОписаниеТипов("СправочникСсылка.смартКонтейнеры"));
	
	Если ДокументСсылка.ХозяйственнаяОперация 
			= Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика 
		Тогда
		Возврат Таблица;
	КонецЕсли;
		
	Для Каждого СтрокаТовары Из ДокументСсылка.Товары Цикл
		
		МассивКонтейнеров = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрокаТовары.смартКонтейнер);
		Для Каждого ЭлементМассиваКонтейнеров Из МассивКонтейнеров Цикл
			
			Если Не ЭлементМассиваКонтейнеров.Пометка Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаТаблицы = Таблица.Добавить();
			
			НоваяСтрокаТаблицы.НомерСтроки = СтрокаТовары.НомерСтроки;
			НоваяСтрокаТаблицы.Контейнер 
				= Справочники.смартКонтейнеры.ПолучитьСсылку(Новый УникальныйИдентификатор(ЭлементМассиваКонтейнеров.Ссылка))
			
		КонецЦикла;
		
	КонецЦикла;
	
