&НаКлиенте
Процедура смартДатаПродленияРезервовПриИзменении(Элемент)
	
	Если ЭтаФорма.смартПроцентОплаты > 0 Тогда 
		Возврат 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.смартДатаПродленияРезервов) Тогда 
		
		//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
		Если НачалоДня(Объект.смартДатаПродленияРезервов) < НачалоДня(ТекущаяДата()) Тогда
			Объект.смартДатаПродленияРезервов = КонецДня(ТекущаяДата());
		КонецЕсли;
		
		Объект.смартКонечнаяДатаРезерва = КонецДня(Объект.смартДатаПродленияРезервов);
		//--#1205 смарт: Лопато 05.10.2022  
		
	Иначе 
		
		ДатаДок=?(ЗначениеЗаполнено(Объект.Дата),Объект.Дата,ТекущаяДата());
		//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
		Объект.смартКонечнаяДатаРезерва = КонецДня(смартСервер.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ДатаДок, 7));
		//--#1205 смарт: Лопато 05.10.2022 
		
	КонецЕсли;
	
	Элементы.смартРезервДо.Заголовок="Резерв продлен до: "+Формат(Объект.смартКонечнаяДатаРезерва,"ДЛФ=D");
	//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
	//Объект.смартРезервЗаканчивается=Объект.смартКонечнаяДатаРезерва-ТекущаяДата()<=86400;
	ЭтаФорма.смартРезервЗаканчивается = смартОбщегоНазначения.смартЦелыхДнейМеждуДатами(ТекущаяДата(), Объект.смартКонечнаяДатаРезерва) < 1;
	//--#1205 смарт: Лопато 05.10.2022
	
КонецПроцедуры

&НаКлиенте
Процедура смарт_смартПродлитьРезервВместо(Команда)
	
	Если ЭтаФорма.смартПроцентОплаты > 0 Тогда 
		Возврат 
	КонецЕсли;
	
	//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
	Объект.смартКонечнаяДатаРезерва = КонецДня(смартСервер.ПолучитьПрибавитьКДатеКоличествоРабочихДней(Объект.смартКонечнаяДатаРезерва,7));
	//--#1205 смарт: Лопато 05.10.2022
	Объект.смартДатаПродленияРезервов = Объект.смартКонечнаяДатаРезерва;
	Элементы.смартРезервДо.Заголовок = "Резерв продлен до: "+Формат(Объект.смартКонечнаяДатаРезерва,"ДЛФ=D");
	//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
	//Объект.смартРезервЗаканчивается=Объект.смартКонечнаяДатаРезерва-ТекущаяДата()<=86400;
	ЭтаФорма.смартРезервЗаканчивается = смартОбщегоНазначения.смартЦелыхДнейМеждуДатами(ТекущаяДата(), Объект.смартКонечнаяДатаРезерва) < 1;
	//--#1205 смарт: Лопато 05.10.2022
	Элементы.смартПродлитьРезерв.Доступность = Ложь;
	ЭтотОбъект.Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроцентОплатыЗаказа(ЗаказКлиента,ЗаказНаПеремещение)
	Результат=Новый Структура("смартПроцентОплаты,смартПроцентОтгрузки",0,0);
	
	Запрос=Новый Запрос;
	Если ЗначениеЗаполнено(ЗаказКлиента) И ТипЗнч(ЗаказКлиента)=Тип("ДокументСсылка.ЗаказКлиента") Тогда 		
		Запрос.УстановитьПараметр("Заказ",ЗаказКлиента);
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	СостоянияЗаказовКлиентов.Заказ КАК Заказ,
		|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК смартПроцентОплаты,
		|	СостоянияЗаказовКлиентов.ПроцентОтгрузки КАК смартПроцентОтгрузки
		|ИЗ
		|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|ГДЕ
		|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
	Иначе
		Запрос.УстановитьПараметр("ЗаказНаПеремещение",ЗаказНаПеремещение);
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	0 КАК смартПроцентОплаты,
		|	ВЫБОР
		|		КОГДА ЗаказыНаПеремещениеОстатки.ЗаказаноОстаток = 0
		|			ТОГДА 100
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК смартПроцентОтгрузки
		|ИЗ
		|	РегистрНакопления.ЗаказыНаПеремещение.Остатки(, ЗаказНаПеремещение = &ЗаказНаПеремещение) КАК ЗаказыНаПеремещениеОстатки";
	КонецЕсли;
	//++ #1193 смарт: Фролов 25.11.2022 //Исправить ошибки в журнале регистрации  
	УстановитьПривилегированныйРежим(Истина);
	Рез=Запрос.Выполнить().Выбрать();        
	Если Рез.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(Результат,Рез);
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
	//-- #1193 смарт: Фролов 25.11.2022
	Возврат Результат;
КонецФункции	
