//++#1357 смарт: Балашов 18.05.2023
&НаСервере
Функция смартПолучитьПотребностьНаСервере()
	МассивСтруктур = Новый Массив;
	Если ЭтотОбъект.Элементы.Товары.ПодчиненныеЭлементы.Найти("Потребность") <> Неопределено Тогда
		//Очистим предидущие значения 
		СтруктураДокумента = Новый Структура;    
		Если ЗначениеЗаполнено(ЭтаФорма.смартМесяцевАнализа) и ЭтаФорма.смартМесяцевАнализа <> 3 Тогда
			СтруктураДокумента.Вставить("МесяцевАнализ",ЭтаФорма.смартМесяцевАнализа);
		Иначе
			СтруктураДокумента.Вставить("МесяцевАнализ",Неопределено);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ЭтаФорма.смартДнейЗаказа) и ЭтаФорма.смартДнейЗаказа <> 10 Тогда
			СтруктураДокумента.Вставить("ДнейЗаказа",ЭтаФорма.смартДнейЗаказа);
		Иначе
			СтруктураДокумента.Вставить("ДнейЗаказа",Неопределено);
		КонецЕсли;	
		
		СтруктураДокумента.Вставить("Склад",Объект.СкладПолучатель);
		СписокНоменклатуры = Новый Массив;
		Для Каждого СтрТовар Из Объект.Товары Цикл
			СписокНоменклатуры.Добавить(СтрТовар.Номенклатура);
		КонецЦикла;	                                           
		СтруктураДокумента.Вставить("ДатаЗаказа",Объект.Дата);
		Адрес = ПоместитьВоВременноеХранилище(СписокНоменклатуры, Новый УникальныйИдентификатор);
		СтруктураДокумента.Вставить("Адрес",Адрес);
		
		ТабПК = смартОбщегоНазначенияСКэш.смартЗаполнитьКолонкуПотребность(СтруктураДокумента);
		Для Каждого СтрТаб Из ТабПК Цикл
			Если СтрТаб.КЗаказуРегСклады > 0 Тогда               
				Структура = Новый Структура("Номенклатура, Потребность");
				Структура.Номенклатура = СтрТаб.Номенклатура;     
				Структура.Потребность = Число(СтрТаб.КЗаказу) + Число(СтрТаб.РезервОплаченный);
				//Структура.Потребность = СтрТаб.КЗаказуРегСклады;
				МассивСтруктур.Добавить(Структура);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	Возврат МассивСтруктур;
КонецФункции
//--#1357 смарт: Балашов 18.05.2023

//++#1357 смарт: Балашов 18.05.2023
&НаКлиенте
Процедура смартПолучитьПотребность()
	МассивТЧ = смартПолучитьПотребностьНаСервере();
	Если МассивТЧ.Количество() > 0 Тогда
		ТЧ_Товары = Объект.Товары;
		Для Каждого СтрокаПотребности Из ТЧ_Товары Цикл
			СтрокаПотребности.Потребность = 0;
		КонецЦикла;	
		Для каждого ЭлМассива Из МассивТЧ Цикл
			Для Каждого СтрТовар Из ТЧ_Товары Цикл
				Если СтрТовар.Номенклатура = ЭлМассива.Номенклатура Тогда
					СтрТовар.Потребность = ЭлМассива.Потребность;
				КонецЕсли;	
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры 
