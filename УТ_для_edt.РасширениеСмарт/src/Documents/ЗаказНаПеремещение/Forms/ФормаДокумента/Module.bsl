
#Область ПеренесеноСДоработками

&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	// Фролов+
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ПолучитьПроцентОплатыЗаказа(Объект.ДокументОснование,Объект.Ссылка));
	
	Элементы.смартДатаПродленияРезервов.Доступность = (ЭтаФорма.смартПроцентОплаты = 0) И (Пользователи.РолиДоступны("ПолныеПрава,смартПродлениеРезервовТоваров"));
	
	Элементы.смартПродлитьРезерв.Доступность=ПравоДоступа("Изменение",Метаданные.Документы.ЗаказНаПеремещение) 
	//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
											//И Объект.смартКонечнаяДатаРезерва-ТекущаяДата()<=86400 И смартПроцентОплаты=0;
											И ЭтаФорма.смартПроцентОплаты = 0
											И смартОбщегоНазначения.смартЦелыхДнейМеждуДатами(ТекущаяДата(), Объект.смартКонечнаяДатаРезерва) < 1;
	//--#1205 смарт: Лопато 05.10.2022
	
	Если Объект.Ссылка.Пустая() Тогда 
		//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
		Объект.смартКонечнаяДатаРезерва = КонецДня(смартСервер.ПолучитьПрибавитьКДатеКоличествоРабочихДней(ТекущаяДата(), 7));
		//--#1205 смарт: Лопато 05.10.2022
	КонецЕсли;
	
	Если ЭтаФорма.смартПроцентОплаты = 0 И ЗначениеЗаполнено(Объект.смартКонечнаяДатаРезерва) Тогда
		ТекстРезерв = ?(ЗначениеЗаполнено(Объект.смартДатаПродленияРезервов),"Резерв продлен до: ","Резерв до: ");
		Элементы.смартРезервДо.Заголовок = ТекстРезерв+Формат(Объект.смартКонечнаяДатаРезерва,"ДЛФ=D");
	Иначе
		Элементы.смартРезервДо.Заголовок = "Оплачено. Резерв не ограничен";
	КонецЕсли;
	Элементы.смартГруппаРезервов.Видимость = ЗначениеЗаполнено(Объект.смартКонечнаяДатаРезерва) И ЭтаФорма.смартПроцентОтгрузки < 100 И Объект.Проведен;
	
	//++#1205 смарт: Лопато 05.10.2022 //Не учитывается конец дня даты резерва  
	НовыеРеквизиты = Новый Массив;
	Реквизит_смартРезервЗаканчивается = Новый РеквизитФормы("смартРезервЗаканчивается", Новый ОписаниеТипов("Булево"));
	НовыеРеквизиты.Добавить(Реквизит_смартРезервЗаканчивается);
	ИзменитьРеквизиты(НовыеРеквизиты);
	//Объект.смартРезервЗаканчивается=смартПроцентОплаты=0 И Объект.смартКонечнаяДатаРезерва-ТекущаяДата()<=86400;
	ЭтаФорма.смартРезервЗаканчивается = ЭтаФорма.смартПроцентОплаты = 0 И смартОбщегоНазначения.смартЦелыхДнейМеждуДатами(ТекущаяДата(), Объект.смартКонечнаяДатаРезерва) < 1;
	//--#1205 смарт: Лопато 05.10.2022
	ДобавитьУсловноеОформление();
	// Фролов-
	
	Если Объект.Ссылка.Пустая() Тогда
		Для Каждого Стр Из Объект.Товары Цикл 
			Стр.ВариантОбеспечения=ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.НеТребуется");
			
			//++ смарт:ММ #040 217 21.03.2020 - проверка рулонов
			Если смартОбщегоНазначения.НоменклатураВРулонахПоХарактеристикам(Стр.Номенклатура) Тогда	
				Стр.Характеристика = Неопределено;
				Стр.Количество = 0;
				Стр.КоличествоУпаковок = 0;	
			КонецЕсли;
			//-- смарт:ММ 21.03.2020
			
		КонецЦикла;
	КонецЕсли;
	
	//++ смарт:ММ #006 144 05.12.2019
	НастроитьВидимостьДоступностьЭлементов();
	//-- смарт:ММ 05.12.2019

	//++ смарт:ММ #044 224 29.12.2020 - Заявка на гарантийный ремонт 
	// Реквизит смартСкладПолучательПредыдущий
	ДобавляемыеРеквизиты = Новый Массив;
    смартСкладПолучательПредыдущий = Новый РеквизитФормы("смартСкладПолучательПредыдущий",	Новый ОписаниеТипов("СправочникСсылка.Склады"),	, "смартСкладПолучательПредыдущий");
    ДобавляемыеРеквизиты.Добавить(смартСкладПолучательПредыдущий);
	
	//++ #Б-710 смарт: Фролов 20.11.2024 //Запрет на редактирование заказов на перемещение
	Элементы.Товары.УстановитьДействие("ПередУдалением", "смартТоварыПередУдалением");
	Элементы.Товары.УстановитьДействие("ПередНачаломДобавления", "смартТоварыПередНачаломДобавления");
	
    смартЗапрещеноМенятьТовары = Новый РеквизитФормы("смартЗапрещеноМенятьТовары",	Новый ОписаниеТипов("Булево"));
    ДобавляемыеРеквизиты.Добавить(смартЗапрещеноМенятьТовары);
	//-- #Б-710 смарт: Фролов 20.11.2024

	//++ #Б-648 смарт: Лопато 29.07.2025 //Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)  
	//смартПользовательПроинформированОНаличииНоменклатурыНаСкладахГарантии = 
	//	Новый РеквизитФормы("смартПользовательПроинформированОНаличииНоменклатурыНаСкладахГарантии", Новый ОписаниеТипов("Булево"));
	//ДобавляемыеРеквизиты.Добавить(смартПользовательПроинформированОНаличииНоменклатурыНаСкладахГарантии);
	//-- #Б-648 смарт: Лопато 29.07.2025
	
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ЭтаФорма.смартСкладПолучательПредыдущий = Объект.СкладПолучатель;
	//-- смарт:ММ 29.12.2020
	
	//смарт+ Вахов Владимир /426 / 18.06.2021
	ДопСвойствоБлокировка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Блокировка документа");
	ДопСвойствоПользователь = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Автор блокированного документа");
	
	ПризнакБлокировкиДокумента =  УправлениеСвойствами.ЗначениеСвойства(Объект.Ссылка, ДопСвойствоБлокировка);
	ПользовательБлокировкиДокумента = УправлениеСвойствами.ЗначениеСвойства(Объект.Ссылка, ДопСвойствоПользователь);
	ТекПользователь = Пользователи.ТекущийПользователь();
	
	Если ПризнакБлокировкиДокумента <> Неопределено Тогда
		
		Если (ПризнакБлокировкиДокумента И ТекПользователь <> ПользовательБлокировкиДокумента) И Не РольДоступна("ПолныеПрава") Тогда
			
			ОбщегоНазначения.СообщитьПользователю("Данный документ блокирован пользователем " + Строка(ПользовательБлокировкиДокумента));
			
			Если ЭтаФорма.Элементы.Найти("БлокировкаДокумента") <> Неопределено  Тогда
				ЭтаФорма.Элементы.БлокировкаДокумента.Доступность = Ложь;
			КонецЕсли;
			
			ЭтаФорма.ТолькоПросмотр = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;	
	//смарт- Вахов Владимир /426 / 18.06.2021	
	
	//++ #1228 смарт: Фролов 25.11.2022 //Заказ клиента Раздел Доставка - доработать  
	//++ Смарт:rnp 625 07.09.2021
	Элементы.СпособДоставки.СписокВыбора.Добавить(Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал,"Самовывоз со склада Адмирал/Атлант");
	
	смартГруппаДоставка = Элементы.Добавить("смартГруппаДоставкаДоп", Тип("ГруппаФормы"), Элементы.СтраницаСамовывоз);
	смартГруппаДоставка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаДоставка.Заголовок = "Транспортное средство и доставка";
	смартГруппаДоставка.ОтображатьЗаголовок = Истина;
	смартГруппаДоставка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Элементы.Добавить("смартВидТранспорта", Тип("ПолеФормы"),смартГруппаДоставка);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартВидТранспорта";

	НовыйЭлемент = Элементы.Добавить("смартНомерМашины", Тип("ПолеФормы"),смартГруппаДоставка);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартНомерМашины";
	
	НовыйЭлемент = Элементы.Добавить("смартНомерПрицепа", Тип("ПолеФормы"),смартГруппаДоставка);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартНомерПрицепа";
	
	смартГруппаДоставка2 = Элементы.Добавить("смартГруппаДоставкаДоп2", Тип("ГруппаФормы"), смартГруппаДоставка);
	смартГруппаДоставка2.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаДоставка2.ОтображатьЗаголовок = Ложь;
	смартГруппаДоставка2.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;

	НовыйЭлемент = Элементы.Добавить("смартЖелаемаяДатаОтгрузкиАдмирал", Тип("ПолеФормы"),смартГруппаДоставка2);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартЖелаемаяДатаОтгрузкиАдмирал";

	НовыйЭлемент = Элементы.Добавить("смартЖелаемоеВремяОтгрузки", Тип("ПолеФормы"),смартГруппаДоставка2);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартЖелаемоеВремяОтгрузки";

	
	смартГруппаВодители = Элементы.Добавить("смартГруппаВодители", Тип("ГруппаФормы"), смартГруппаДоставка);
	смартГруппаВодители.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаВодители.Заголовок = "Данные водителей";
	смартГруппаВодители.ОтображатьЗаголовок = Истина;
	смартГруппаВодители.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда; 
	
	смартГруппаПервыйВодитель = Элементы.Добавить("смартГруппаПервыйВодитель", Тип("ГруппаФормы"), смартГруппаВодители);
	смартГруппаПервыйВодитель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаПервыйВодитель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Элементы.Добавить("смартФИОВодителя", Тип("ПолеФормы"),смартГруппаПервыйВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартФИОВодителя";

	НовыйЭлемент = Элементы.Добавить("смартНомерСерияПаспортВодителя", Тип("ПолеФормы"),смартГруппаПервыйВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартНомерСерияПаспортВодителя";

	НовыйЭлемент = Элементы.Добавить("смартДатаВыдачиПаспортаВодителя", Тип("ПолеФормы"),смартГруппаПервыйВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартДатаВыдачиПаспортаВодителя"; 
	
	смартГруппаВторойВодитель = Элементы.Добавить("смартГруппаВторойВодитель", Тип("ГруппаФормы"), смартГруппаВодители);
	смартГруппаВторойВодитель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	смартГруппаВторойВодитель.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
	НовыйЭлемент = Элементы.Добавить("смартФИОВторогоВодителя", Тип("ПолеФормы"),смартГруппаВторойВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартФИОВторогоВодителя";

	НовыйЭлемент = Элементы.Добавить("смартНомерСерияПаспортВторогоВодителя", Тип("ПолеФормы"),смартГруппаВторойВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартНомерСерияПаспортВторогоВодителя";

	НовыйЭлемент = Элементы.Добавить("смартДатаВыдачиПаспортаВторогоВодителя", Тип("ПолеФормы"),смартГруппаВторойВодитель);
    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
    НовыйЭлемент.ПутьКДанным = "Объект.смартДатаВыдачиПаспортаВторогоВодителя";
	//-- #1228 смарт: Фролов 25.11.2022
	
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
		Элементы.смартГруппаДоставкаДоп.Видимость = Истина;
	Иначе
		Элементы.смартГруппаДоставкаДоп.Видимость = Ложь;  
	КонецЕсли;
	ДобавитьЭлементыПрограммно();  
	//-- Смарт:rnp 625 07.09.2021
	
	//++#1357 смарт: Балашов 18.05.2023
	Если (РольДоступна("смартДоступностьПоляПотребностиЗаказНаПеремещение")) или (РольДоступна("ПолныеПрава")) Тогда
		МассивДобавляемыхРеквизитов = Новый Массив; 
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("Потребность", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(15,3)),"Объект.Товары" , "Потребность")); 

		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("смартМесяцевАнализа", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(2,0)))); 
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы("смартДнейЗаказа", Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(2,0)))); 
		
		ИзменитьРеквизиты(МассивДобавляемыхРеквизитов); 
		
		НоваяКолонка = Элементы.Добавить("Потребность", Тип("ПолеФормы"), Элементы.Товары); 
		НоваяКолонка.Заголовок = "Потребность"; 
		НоваяКолонка.ПутьКДанным = "Объект.Товары.Потребность"; 
		НоваяКолонка.Вид = ВидПоляФормы.ПолеВвода;  
		
		ГруппаНастройкиПотребности = Элементы.Вставить("смартГруппаНастройкиПотребности", Тип("ГруппаФормы"), ЭтаФорма.Элементы.ГруппаТовары, ЭтаФорма.Элементы.Товары);
		
		ГруппаНастройкиПотребности.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаНастройкиПотребности.ОтображатьЗаголовок = ложь;
		ГруппаНастройкиПотребности.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда; 
		ГруппаНастройкиПотребности.ГоризонтальноеПоложениеВГруппе=ГоризонтальноеПоложениеЭлемента.Право;
		
	
		НовыйЭлемент = Элементы.Добавить("смартМесяцевАнализа",Тип("ПолеФормы"),ГруппаНастройкиПотребности);
	    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	    НовыйЭлемент.ПутьКДанным = "смартМесяцевАнализа";
	    НовыйЭлемент.Заголовок = "Кол-во месяцев для анализа";
		НовыйЭлемент.ЦветТекстаЗаголовка=WebЦвета.Фиолетовый;
		НовыйЭлемент.ШрифтЗаголовка = Новый Шрифт(,,Истина); 
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартПолучитьПотребность");

		НовыйЭлемент = Элементы.Добавить("смартМесяцевАнализаДекор",Тип("ДекорацияФормы"),ГруппаНастройкиПотребности);
	    НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	    НовыйЭлемент.Заголовок = "мес.";
		
		НовыйЭлемент = Элементы.Добавить("смартДнейЗаказа",Тип("ПолеФормы"),ГруппаНастройкиПотребности);
	    НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	    НовыйЭлемент.ПутьКДанным = "смартДнейЗаказа";
	    НовыйЭлемент.Заголовок = "Кол-во рабочих дней для планирования";
