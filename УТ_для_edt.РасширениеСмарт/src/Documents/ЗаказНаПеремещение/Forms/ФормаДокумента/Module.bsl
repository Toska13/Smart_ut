//++ #Б-1482 смарт: Фролов 29.11.2024 //Дополнение. Запрет на редактирование заказов на перемещение
Процедура смартУстановитьДоступностьЭлементовПоСтатусу()
	
	//++ #Б-2444 смарт: Лопато 21.02.2025 //Запрет на редактирование заказов на перемещение. Дополнение.  
	Если Пользователи.РолиДоступны("смартМенеджерБэкОфис") Тогда
		Возврат;
	КонецЕсли;	
	//-- #Б-2444 смарт: Лопато 21.02.2025
	
	Если Объект.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению 
		И Объект.СкладОтправитель.смартНазначениеСклада = Перечисления.смартНазначенияСкладов.ТорговыйСклад
		И Объект.СкладПолучатель.смартНазначениеСклада = Перечисления.смартНазначенияСкладов.ТорговыйСклад 
		И Объект.СкладОтправитель.БизнесРегион = Справочники.смартПредопределенныеЗначения.БизнесРегионМосква.Значение Тогда
		
		Попытка
			ЭтаФорма.смартЗапрещеноМенятьТовары = Истина;
		Исключение
		КонецПопытки;
		Элементы.Статус.ТолькоПросмотр = Истина;
		Элементы.ТоварыПодобратьТовары.Доступность = Ложь;
		Элементы.ТоварыОтменитьВыделенныеСтроки.Доступность = Ложь;
		Элементы.ТоварыОтменитьНеотработанные.Доступность = Ложь;
		Элементы.ТоварыРазбитьСтроку.Доступность = Ложь;
		Элементы.ТоварыПоискПоШтрихкоду.Доступность = Ложь;
		Элементы.ТоварыСкопироватьСтроки.Доступность = Ложь;
