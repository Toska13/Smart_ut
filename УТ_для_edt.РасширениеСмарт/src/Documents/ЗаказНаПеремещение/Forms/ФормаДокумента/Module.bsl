//++ #Б-648 смарт: Лопато 29.07.2025 //Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)  
&НаКлиенте
&ИзменениеИКонтроль("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ, ПараметрыЗаписи)
    	
	Если НеВыполнятьПроверкуПередЗаписью Тогда
		НеВыполнятьПроверкуПередЗаписью = Ложь;
		Возврат;
	КонецЕсли;
	
	#Вставка	
	//++ #Б-648 смарт: Лопато 29.07.2025 //Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)  
	Если //НЕ ЭтаФорма.смартПользовательПроинформированОНаличииНоменклатурыНаСкладахГарантии
		 (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Запись
		   ИЛИ ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение) Тогда
		
		МассивНоменклатурыПроверки = Новый Массив;
		
		Для Каждого СтрТовары Из Объект.Товары Цикл
			
			Если НЕ СтрТовары.Отменено
				И СтрТовары.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить")
				И ЗначениеЗаполнено(СтрТовары.Номенклатура) Тогда

				СтруктураПроверки = Новый Структура;
				СтруктураПроверки.Вставить("Номенклатура", 	  	 СтрТовары.Номенклатура);
				СтруктураПроверки.Вставить("Характеристика", 	 СтрТовары.Характеристика);
				СтруктураПроверки.Вставить("ВариантОбеспечения", СтрТовары.ВариантОбеспечения);
				СтруктураПроверки.Вставить("Отменено", 		     СтрТовары.Отменено);

				МассивНоменклатурыПроверки.Добавить(СтруктураПроверки);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивНоменклатурыПроверки.Количество() > 0 Тогда
				
			ТекстПредупреждения = смартПроверитьОстаткиНоменклатурыНаСкладахГарантииНаСервере(МассивНоменклатурыПроверки);
					
			Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
				
				Отказ = Истина;

				//++ #648 смарт: Тимофеева 18.08.2025 / Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)
				//ЭтаФорма.смартПользовательПроинформированОНаличииНоменклатурыНаСкладахГарантии = Истина;
                //-- #648 смарт: Тимофеева 18.08.2025
				
				ПоказатьПредупреждение(, ТекстПредупреждения);

			КонецЕсли;	

		КонецЕсли;	
		
	КонецЕсли;	
	//-- #Б-648 смарт: Лопато 29.07.2025
	#КонецВставки

	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Отказ = Истина;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
		МногооборотнаяТараКлиент.ПредложитьПодобратьМногооборотнуюТару(
			ЭтаФорма,
			"Товары",
			"Номенклатура,Характеристика,Количество,,НачалоОтгрузки",
			Новый ОписаниеОповещения("ПередЗаписьюПредложитьПодобратьМногооборотнуюТаруЗавершение", ЭтотОбъект, ДополнительныеПараметры));
	КонецЕсли;
	
	ОбщегоНазначенияУТКлиент.ЗаписатьОбъектПриНеобходимости(ЭтотОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

//++ #Б-648 смарт: Лопато 29.07.2025 //Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)  
&НаСервере
Функция смартПроверитьОстаткиНоменклатурыНаСкладахГарантииНаСервере(МассивНоменклатурыПроверки)
	
	ТекстПредупреждения = "";
	
	Если НЕ (Объект.СкладОтправитель.смартНазначениеСклада = Перечисления.смартНазначенияСкладов.ТорговыйСклад
			 И Объект.СкладПолучатель.смартНазначениеСклада = Перечисления.смартНазначенияСкладов.ФизическоеЛицо) Тогда
		Возврат	ТекстПредупреждения;
	КонецЕсли;
	
	МассивСкладов = Новый Массив;
	
	ИННОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "ИНН", Истина);
	
	Если ИННОрганизации = "7709461879" Тогда //СМАРТ-Т
		МассивСкладов.Добавить(Справочники.Склады.ПолучитьСсылку(
			Новый УникальныйИдентификатор("8c7d4802-ce4e-11e5-b77b-00155d000500"))); //Гарантийные запчасти - не для продажи	
		МассивСкладов.Добавить(Справочники.Склады.ПолучитьСсылку(
			Новый УникальныйИдентификатор("49c89fc4-accc-11eb-5a96-9a091c6056b7"))); //Запчасти ФСО	
	ИначеЕсли ИННОрганизации = "7722457913" Тогда // КОВЧЕГ
		МассивСкладов.Добавить(Справочники.Склады.ПолучитьСсылку(
			Новый УникальныйИдентификатор("258d5948-4a0e-11ed-8e73-9a091c6056b7"))); //Гарантийные запчасти - не для продажи КОВЧЕГ	
		МассивСкладов.Добавить(Справочники.Склады.ПолучитьСсылку(
			Новый УникальныйИдентификатор("f9274f64-f8a2-11ed-8906-9a091c6056b7"))); //Запчасти ФСО КОВЧЕГ	
	Иначе		
		Возврат	ТекстПредупреждения;
	КонецЕсли;
	
	Если МассивСкладов.Количество() = 0 Тогда
		Возврат	ТекстПредупреждения;
	КонецЕсли;
	
	СегментЗапчасти = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментЗапчасти");

	Если НЕ ЗначениеЗаполнено(СегментЗапчасти) Тогда
		Возврат	ТекстПредупреждения;
	КонецЕсли;	
	
	ТоварыПред = Объект.Ссылка.Товары.Выгрузить();
	
	МассивРазличных = Новый Массив;
	
	Для Каждого СтруктураПроверки Из МассивНоменклатурыПроверки Цикл
		
		//++ #648 смарт: Тимофеева 18.08.2025 / Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)
		//СтрокиПред = ТоварыПред.НайтиСтроки(СтруктураПроверки);
				
		//Если СтрокиПред.Количество() = 0 Тогда
		//	МассивРазличных.Добавить(СтруктураПроверки);
		//КонецЕсли; 
		
		СтрокиПред = МассивРазличных.Найти(СтруктураПроверки);
		Если СтрокиПред = Неопределено Тогда
			МассивРазличных.Добавить(СтруктураПроверки);	
		КонецЕсли;
		//-- #648 смарт: Тимофеева 18.08.2025 
	КонецЦикла;	
	
	Если МассивРазличных.Количество() = 0 Тогда	
		Возврат	ТекстПредупреждения;
	КонецЕсли;	
	
	МассивЗапчасти = СегментыСервер.МассивЭлементов(СегментЗапчасти);
	
	Если МассивЗапчасти.Количество() = 0 Тогда
		Возврат	ТекстПредупреждения;
	КонецЕсли;
	
	ТЗПроверки = Новый ТаблицаЗначений;
	ТЗПроверки.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗПроверки.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	
	Для Каждого СтруктураПроверки Из МассивРазличных Цикл
		
		Если МассивЗапчасти.Найти(СтруктураПроверки.Номенклатура) <> Неопределено Тогда
		
			НоваяСтрокаПроверки = ТЗПроверки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПроверки, СтруктураПроверки);

		КонецЕсли;
			
	КонецЦикла;	

	Если ТЗПроверки.Количество() = 0 Тогда
		Возврат	ТекстПредупреждения;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗПроверки.Номенклатура КАК Номенклатура,
	|	ТЗПроверки.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТЗПроверки КАК ТЗПроверки
	|;
	|
	|ВЫБРАТЬ
	|	Т.Организация    КАК Организация,
	|	Т.Номенклатура   КАК Номенклатура,
	|	Т.Характеристика КАК Характеристика,
	|	Т.Склад          КАК Склад,
	|
	|	Т.ВНаличииОстаток
	|		- Т.ВРезервеСоСкладаОстаток
	|		- Т.ВРезервеПодЗаказОстаток КАК Количество,
	|	Т.смартВНаличииГарантийныеОстаток
	|		- Т.смартВРезервеСоСкладаГарантийныеОстаток
	|		- Т.смартВРезервеПодЗаказГарантийныеОстаток КАК КоличествоГарантийные
	|
	|ИЗ
	|	РегистрНакопления.смартСвободныеОстаткиОрганизаций.Остатки(,
	|		Организация = &Организация 
	|		И Склад В(&МассивСкладов) 
	|		И (Номенклатура, Характеристика) В(
	|			ВЫБРАТЬ
	|				Номенклатура,
	|				Характеристика
	|			ИЗ
	|				ВТ_Товары)) КАК Т
	|ГДЕ
	|	(Т.ВНаличииОстаток
	|		- Т.ВРезервеСоСкладаОстаток
	|		- Т.ВРезервеПодЗаказОстаток) > 0
	|   ИЛИ
	|	(Т.смартВНаличииГарантийныеОстаток
	|		- Т.смартВРезервеСоСкладаГарантийныеОстаток
	|		- Т.смартВРезервеПодЗаказГарантийныеОстаток) > 0
	|
	|УПОРЯДОЧИТЬ ПО	
	|	Организация,	
	|	Склад,	
	|   Номенклатура,
	|   Характеристика";
	
	Запрос.УстановитьПараметр("ТЗПроверки",    ТЗПроверки);
	Запрос.УстановитьПараметр("Организация",   Объект.Организация);
	Запрос.УстановитьПараметр("МассивСкладов", МассивСкладов);
	
	ВыборкаРезультатаЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаРезультатаЗапроса.Следующий() Цикл
		
		КоличествоПредупреждение = 0;
		
		Если Объект.смартЗапчастиГарантийные 
			И ВыборкаРезультатаЗапроса.КоличествоГарантийные > 0 Тогда

			КоличествоПредупреждение = ВыборкаРезультатаЗапроса.КоличествоГарантийные;
			
		ИначеЕсли НЕ Объект.смартЗапчастиГарантийные	
			И ВыборкаРезультатаЗапроса.Количество > 0 Тогда

			КоличествоПредупреждение = ВыборкаРезультатаЗапроса.Количество;
			
		КонецЕсли;
		
		Если КоличествоПредупреждение > 0 Тогда
		
			ТекстПредупреждения = ТекстПредупреждения + "По организации """ + СокрЛП(Объект.Организация) + """"
													  + " на складе """ + СокрЛП(ВыборкаРезультатаЗапроса.Склад) + """" 
													  + " по номенклатуре """ + СокрЛП(ВыборкаРезультатаЗапроса.Номенклатура) + """" 
													  + " остаток: " + КоличествоПредупреждение
													  + Символы.ПС;
													  
		КонецЕсли;
													  
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда
		
		ТекстПредупреждения 
			= ТекстПредупреждения + "При необходимости за консультацией по получению З/Ч обратитесь к Акимову Федору (вн. тел. 128)";	
							  
	КонецЕсли;	
	
	//++ #648 смарт: Тимофеева 18.08.2025 / Доработка гарантийного блока / Информирования Инженеров при создании Заказа на перемещение (ИТСМ 1946)
	Возврат ТекстПредупреждения;
	//-- #648 смарт: Тимофеева 18.08.2025
КонецФункции //-- #Б-648 смарт: Лопато 29.07.2025	

//++ #Б4674 смарт: Шляпников 23.10.2025 / Маркировка радиоэлектронной продукции. Запрет на перемещение между складами.
&НаКлиенте
Процедура смарт_ЗаписатьДокументПродолжение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Истина Тогда
		ОбщегоНазначенияУТКлиент.Записать(ЭтаФорма, Истина);
	КонецЕсли;
	
КонецПроцедуры
	
//++ #Б4674 смарт: Шляпников 23.10.2025 / Маркировка радиоэлектронной продукции. Запрет на перемещение между складами.
&НаКлиенте
Процедура смарт_ПровестиДокументПродолжение(Результат, ДопПараметры) Экспорт
	
	Если Результат = Истина Тогда
		ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма, Истина);
	КонецЕсли;
	
КонецПроцедуры

//++ #Б4674 смарт: Шляпников 23.10.2025 / Маркировка радиоэлектронной продукции. Запрет на перемещение между складами.
