//++ #5734 смарт: Тимофеева 18.02.26 / Создать роль для создания перемещений со склада Гарантийные запчасти - не для продажи
&НаКлиенте
Процедура смарт_СкладОтправительПриИзмененииПосле(Элемент)	
	УстановитьВидимостьНомераЗаявкиНаГарантийныйРемонт();
КонецПроцедуры 

&НаСервере
Процедура УстановитьВидимостьНомераЗаявкиНаГарантийныйРемонт()	
	Если НЕ Элементы.Найти("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка") = Неопределено Тогда  
		СкладДляЗапчастейПодЗаказ = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ОсновнойСкладДляЗапчастейПодЗаказ", Ложь);
	    Элементы["ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка"].Видимость = Объект.СкладОтправитель = СкладДляЗапчастейПодЗаказ
																				ИЛИ Объект.СкладПолучатель = СкладДляЗапчастейПодЗаказ
																				ИЛИ НЕ Объект.Товары.Количество() = Объект.Товары.НайтиСтроки(
																					Новый Структура("смартНомерЗаявкиНаГарантийныйРемонтСсылка", 
																					Документы.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка())).Количество();	
	КонецЕсли;
КонецПроцедуры 
//-- #5734 смарт: Тимофеева 18.02.26 

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
&НаСервере
Процедура ЗаполнитьДанныеОМаркировкеНоменклатуры()
	
	смартМаркировка.ЗаполнитьИнформациюОМаркировкеВТаблицуНоменклатуры(Объект.Товары);
	
КонецПроцедуры

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
&НаКлиенте
Процедура смартТоварыПриИзменении(Элемент)

	ЗаполнитьДанныеОМаркировкеНоменклатуры();

КонецПроцедуры

//++ смарт: 24.08.2026 / Заполнить по назначению (вывод из оборота)
&НаКлиенте
Процедура смартЗаполнитьПоНазначению(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.СкладОтправитель) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите склад-отправитель.'"),
			,
			"Объект.СкладОтправитель");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Склад", Объект.СкладОтправитель);
	ПараметрыФормы.Вставить("смартЗапчастиГарантийные", Объект.смартЗапчастиГарантийные);
	ПараметрыФормы.Вставить("ДокументВладелец", Объект.Ссылка);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("смартЗаполнитьПоНазначениюЗавершение", ЭтотОбъект);
	ОткрытьФорму(
		"Обработка.смартЗаполнениеТоваровПоНазначению.Форма.Форма",
		ПараметрыФормы,
		ЭтотОбъект,
		,
		,
		,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура смартЗаполнитьПоНазначениюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	смартЗаполнитьПоНазначениюНаСервере(Результат);
	
КонецПроцедуры

&НаСервере
Процедура смартЗаполнитьПоНазначениюНаСервере(Знач АдресВХранилище)
	
	ТаблицаПереноса = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Если ТипЗнч(ТаблицаПереноса) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПереноса Из ТаблицаПереноса Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура", СтрокаПереноса.Номенклатура);
		Отбор.Вставить("Характеристика", СтрокаПереноса.Характеристика);
		
		Если Объект.Товары.НайтиСтроки(Отбор).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПереноса, "Номенклатура, Характеристика");
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры
//-- смарт: 24.08.2026

#КонецОбласти
