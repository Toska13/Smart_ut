							ИмяФайлаЗаявкаНаОтгрузку = "ЗаявкаНаПриемку.XLSX";
						Иначе
						//-- смарт:ММ 03.11.2021
						ИмяФайлаЗаявкаНаОтгрузку = "ЗаявкаНаОтгрузку.XLSX";
						//++ смарт:ММ 698 03.11.2021 
						КонецЕсли;
						//-- смарт:ММ 03.11.2021
					КонецЕсли;
					
					ПолноеИмяФайлаЗаявкаНаОтгрузку = КаталогСохраненияФайлов + "\" + ИмяФайлаЗаявкаНаОтгрузку;
			
					Успех = Истина;

					Попытка
						Если ТабДокТН <> Неопределено Тогда
							ТабДокТН.Записать(ПолноеИмяФайлаТН, ТипФайлаТабличногоДокумента.PDF);
							ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаТН);
						КонецЕсли;
						
						Если ТабДокЗаявкаНаОтгрузку <> Неопределено И ТабДокЗаявкаНаОтгрузку <> "Заявка на отгрузку формируется из Бух базы" Тогда
							ТабДокЗаявкаНаОтгрузку.Записать(ПолноеИмяФайлаЗаявкаНаОтгрузку,ТипФайлаТабличногоДокумента.XLSX);
							ОбщегоНазначенияКлиент.СообщитьПользователю("Сохранен файл " + ПолноеИмяФайлаЗаявкаНаОтгрузку);
						КонецЕсли;
					Исключение
						Успех = Ложь;
						ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось сохранить печатные формы:" + Символы.ПС + ОписаниеОшибки());
					КонецПопытки;
			
					
					Если Успех Тогда
						// Во вложения необходимо добавить все файлы из каталога				
						НайденныеФайлы = НайтиФайлы(КаталогСохраненияФайлов, "*");
						Для Каждого ТекФайл Из НайденныеФайлы Цикл					
							ТекСтруктура = Новый Структура;
							ТекСтруктура.Вставить("ИмяФайла", ТекФайл.Имя);
							АдресХранилища = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ТекФайл.ПолноеИмя), Новый УникальныйИдентификатор); 
							ТекСтруктура.Вставить("АдресХранилища", АдресХранилища);
							МассивСтруктур.Добавить(ТекСтруктура);
						КонецЦикла;
					КонецЕсли;

				КонецЦикла;
			КонецЦикла;
	        //Отправка пакетов
			Если МассивСтруктур.Количество() > 0 Тогда
				смартОбщегоНазначения.ОтправитьПакетДокументовНаПочту(МассивСтруктур, Объект.Ссылка);
			КонецЕсли;
	иначе
		//++ смарт:ММ 698 02.11.2021 
		//ОбщегоНазначенияКлиент.СообщитьПользователю("У заказа на перемещение склад отправитель не соответсвует указанному в предопределенных параметрах Адмирал! ");
		ОбщегоНазначенияКлиент.СообщитьПользователю("У заказа на перемещение склад отправитель и склад получатель не соответсвуют указанному в предопределенных параметрах Адмирал! ");
		//-- смарт:ММ 02.11.2021
	КонецЕсли;
КонецПроцедуры //-- смарт:kornushenko 625 07.09.2021

