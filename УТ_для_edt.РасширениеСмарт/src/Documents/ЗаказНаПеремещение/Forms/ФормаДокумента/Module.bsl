    ДопСвойствоПользователь = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Автор блокированного документа");
	
	Если  ДопСвойствоБлокировка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка()
		Или ДопСвойствоПользователь = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ПустаяСсылка() 
		Тогда
		Возврат;
	КонецЕсли;	
	
	ТекПользователь = Пользователи.ТекущийПользователь(); 
    
    ТаблицаДопРеквизитов = Новый ТаблицаЗначений;
    ТаблицаДопРеквизитов.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
    ТаблицаДопРеквизитов.Колонки.Добавить("Значение");
    
    НовыйРекизит = ТаблицаДопРеквизитов.Добавить();
    НовыйРекизит.Свойство = ДопСвойствоБлокировка;
    НовыйРекизит.Значение = ЭтаФорма.БлокировкаДокумента;
    НовыйРекизит = ТаблицаДопРеквизитов.Добавить();
    НовыйРекизит.Свойство = ДопСвойствоПользователь;
    НовыйРекизит.Значение = ТекПользователь;
    
    УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Объект.Ссылка, ТаблицаДопРеквизитов);
	
КонецПроцедуры

