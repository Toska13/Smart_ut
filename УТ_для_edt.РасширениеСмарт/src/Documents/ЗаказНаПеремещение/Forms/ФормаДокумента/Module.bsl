					//++ смарт:ММ 698 03.11.2021 
					//ТабДокЗаявкаНаОтгрузку = смартСформироватьТабличныйДокументЗаявкаНаОтгрузку(Реализация, ИмяФайлаЗаявкаНаОтгрузку);
					ТабДокЗаявкаНаОтгрузку = смартСформироватьТабличныйДокументЗаявкаНаОтгрузку(Реализация, ИмяФайлаЗаявкаНаОтгрузку, ПолучательАдмирал);
					//-- смарт:ММ 03.11.2021
						
					Если ТабДокЗаявкаНаОтгрузку = Неопределено Тогда
						//++ смарт:ММ 698 03.11.2021 
						//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ этикетки доставки по документу " + Реализация);
						Если ПолучательАдмирал Тогда
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось сформировать ПФ Заявка на приемку по документу " + Реализация);
						Иначе
