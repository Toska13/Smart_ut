&НаСервере
Процедура смарт_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ВыполнятьПроверкуСклада = Истина; // Чтобы была возможность вносить изменения в уже существующий документ
	
	Если Объект.Ссылка.СкладОтправитель = ТекущийОбъект.СкладОтправитель
		И Объект.Ссылка.СкладПолучатель = ТекущийОбъект.СкладПолучатель Тогда
		ВыполнятьПроверкуСклада = Ложь;	
	КонецЕсли;
	
	Если ВыполнятьПроверкуСклада Тогда
		
		СкладГарантийнаяАрендаМимаки = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("СкладГарантийнаяАрендаМимаки", Ложь);
		
		Если ЗначениеЗаполнено(СкладГарантийнаяАрендаМимаки) 
			И ТекущийОбъект.СкладОтправитель = СкладГарантийнаяАрендаМимаки Тогда
			
			// С этого склада можно перемещать только номенклатуру с артикулом, содержащим LOA
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура
			|ПОМЕСТИТЬ ВТ_Товары
			|ИЗ
			|	&Товары КАК ЗаказНаПеремещениеТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВТ_Товары.Номенклатура КАК Номенклатура,
			|	НоменклатураСпр.Артикул КАК Артикул
			|ИЗ
			|	ВТ_Товары КАК ВТ_Товары
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСпр
			|		ПО ВТ_Товары.Номенклатура = НоменклатураСпр.Ссылка
			|ГДЕ
			|	НЕ НоменклатураСпр.Артикул ПОДОБНО ""%LOA%""";
			
			Запрос.УстановитьПараметр("Товары", ТекущийОбъект.Товары.Выгрузить());
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл			
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю("Номенклатуру " + Выборка.Номенклатура + " нельзя перемещать со склада " + СкладГарантийнаяАрендаМимаки);
			КонецЦикла;		
			
		КонецЕсли;
		
		//++ #5332 смарт: Тимофеева 20.01.26 / Создать новую роль разрешающую создавать документ Заказ на перемещение со склада ГНДП
		//Если НЕ РольДоступна("ПолныеПрава") Тогда
		Если НЕ Пользователи.РолиДоступны("смартРазрешитьСозданиеЗаказаНаПеремещениеСоСкладаГарантияНеДляПродажи") Тогда
		//-- #5332 смарт: Тимофеева 20.01.26
			ОсновнойСкладДляЗапчастейПодЗаказ = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ОсновнойСкладДляЗапчастейПодЗаказ", Ложь);
			
			Если ЗначениеЗаполнено(ОсновнойСкладДляЗапчастейПодЗаказ)
				И (ТекущийОбъект.СкладОтправитель = ОсновнойСкладДляЗапчастейПодЗаказ ИЛИ ТекущийОбъект.СкладПолучатель = ОсновнойСкладДляЗапчастейПодЗаказ) Тогда
				Отказ = Истина;
				ОбщегоНазначения.СообщитьПользователю("Запрещено перемещать номенклатуру на склад (со склада) " + ОсновнойСкладДляЗапчастейПодЗаказ + ". Воспользуйтесь кнопкой """"Взять на складе"""" в заявке на гарантийный ремонт." +
				Символы.ПС + "Если необходимо временно взять запчасть на другие цели, следует пользоваться кнопкой """"Взять запчасть с PRE"""" в списке заявок на гарантийный ремонт.");
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 13.11.2021

