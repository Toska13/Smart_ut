	ТаблицаИзменившихсяДатПоступления = Неопределено;
	Если ДополнительныеСвойства.Свойство("смартТаблицаИзменившихсяДатПоступления", ТаблицаИзменившихсяДатПоступления) И
		ЗначениеЗаполнено(ТаблицаИзменившихсяДатПоступления) тогда
		
		МассивТиповДокументов = смарт_ПолучитьМассивТиповСдвинутьДокументы();
		
		Для каждого стр из ТаблицаИзменившихсяДатПоступления цикл
			//проверка наличия отрицательных остатков в регистре сведений ДоступныеОстаткиПланируемыхПоступлений
			
			//дата поступления сдвинулась вперед, возможно образовался отрицательный остаток
			Если стр.ДатаПоступления > стр.ДатаПоступленияНачальная тогда
				ОтрицательныйОстаток = смарт_НайтиОтрицательныйОстатокДоступныеОстаткиПланируемыхПоступлений(стр.Номенклатура, стр.Характеристика, стр.Склад);
				
				Если ОтрицательныйОстаток < 0 тогда
					смарт_СдвинутьДокументыОтгрузки(стр.Номенклатура, стр.Характеристика, стр.Склад, МассивТиповДокументов, Истина, Ложь);
				КонецЕсли;
			//дата поступления сдвинулась вперед, отрицательный остаток не образовывается, но необходимо даты связанные документов тоже сдвинуть назад
			ИначеЕсли стр.ДатаПоступления < стр.ДатаПоступленияНачальная тогда
				смарт_СдвинутьДокументыОтгрузки(стр.Номенклатура, стр.Характеристика, стр.Склад, МассивТиповДокументов, Истина, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//++ смарт:КМД #2_4 327 28.12.2020
Функция смарт_ПолучитьМассивТиповСдвинутьДокументы()
	Массив = Новый Массив;
	Массив.Добавить(Тип("ДокументСсылка.ЗаказКлиента"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказНаПеремещение"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказНаСборку"));
	Массив.Добавить(Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление"));
	
	Возврат Массив;
КонецФункции
                       
//++ смарт:КМД #2_4 327 28.12.2020
Функция смарт_НайтиОтрицательныйОстатокДоступныеОстаткиПланируемыхПоступлений(Номенклатура, Характеристика, Склад)
	ОтрицательныйОстаток = 0;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ДоступныеОстаткиПланируемыхПоступлений.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.ДоступныеОстаткиПланируемыхПоступлений КАК ДоступныеОстаткиПланируемыхПоступлений
	|ГДЕ
	|	ДоступныеОстаткиПланируемыхПоступлений.Номенклатура = &Номенклатура
	|	И ДоступныеОстаткиПланируемыхПоступлений.Характеристика = &Характеристика
	|	И ДоступныеОстаткиПланируемыхПоступлений.Склад = &Склад
	|	И ДоступныеОстаткиПланируемыхПоступлений.Количество < 0
	|	И ДоступныеОстаткиПланируемыхПоступлений.ДатаДоступности = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|";
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Если ЗначениеЗаполнено(Выборка.Количество) тогда
			ОтрицательныйОстаток = Выборка.Количество;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОтрицательныйОстаток;

КонецФункции

//++ смарт:КМД #2_4 327 28.12.2020
