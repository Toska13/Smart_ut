//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
&ИзменениеИКонтроль("ОбработкаЗаполнения")
Процедура смарт_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОбособленныеПодразделенияВыделенныеНаБаланс") Тогда
		ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Основание") Тогда
		
		Если ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			ЗаполнитьПоЗаказуКлиента(ДанныеЗаполнения);
		ИначеЕсли ТипЗнч(ДанныеЗаполнения.Основание) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
			Тогда
			
			ЗаполнитьПоПриобретениюТоваров(ДанныеЗаполнения);
			
		Иначе
			ВызватьИсключение НСтр("ru = 'Неверные параметры создания документа на основании'");
		КонецЕсли;
		
		#Вставка
		//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ДанныеЗаполнения.Основание));
		Если НЕ ОбъектМетаданных = Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", ОбъектМетаданных) Тогда
				ЭтотОбъект.смартЗапчастиГарантийные = ДанныеЗаполнения.Основание.смартЗапчастиГарантийные;
			КонецЕсли;
		КонецЕсли;
		//-- #Б1376 смарт: Шляпников 19.11.2024
		#КонецВставки
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда   
		
		#Удаление //++ #1901 смарт: Ермаков 21.08.2024 / Создание документа Заявка на разборку оборудования 
		ЗаполнитьДокументПоОтбору(ДанныеЗаполнения);
		#КонецУдаления //-- #1901 смарт: Ермаков 21.08.2024

		#Вставка
		//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
		//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
		//Каратеев + 
		//Кусок кода для работы процедуры формирования документа заказа из отчета планирование закупок
		Если ДанныеЗаполнения.Свойство("ТоварыКЗаказу") Тогда
			смартЗаполнитьДокументНаОснованииОтчета(ДанныеЗаполнения);
		Иначе
			ЗаполнитьДокументПоОтбору(ДанныеЗаполнения);//Эта строка из типовой конфигурации
		КонецЕсли;
		//Каратеев -
		//-- смарт:ММ 27.03.2020
		//-- #1670 смарт: Мосолов 14.03.2024
		#КонецВставки 
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента") Тогда
		ЗаполнитьПоЗаявкеНаВозвратТоваровОтКлиента(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") Тогда
		ЗаполнитьПоЗаказуНаВнутреннееПотребление(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаСборку") Тогда
		ЗаполнитьПоЗаказуНаСборку(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеТоваровНаСклад") Тогда
		ЗаполнитьПоПоступлениюТоваров(ДанныеЗаполнения); 
		
	#Вставка
	//++ #Б-1136 смарт: Мосолов 15.10.2024 //Доработка Воронки РТО
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		ДокументОснование = ДанныеЗаполнения; 
		Организация = ДанныеЗаполнения.Организация;
	//-- #Б-1136 смарт: Мосолов 15.10.2024 
	//++ #Б3700 смарт: Шляпников 22.07.2025 / Заявка на разборку оборудования. Дополнения. Версия 2.
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРазборкуОборудования") Тогда
		ДокументОснование = ДанныеЗаполнения; 
		Организация = ДанныеЗаполнения.Организация;
	//-- #Б3700 смарт: Шляпников 22.07.2025
	#КонецВставки
		
	КонецЕсли;
	
	ЕстьВариантОбеспечения = ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг")
		Или ТипЗнч(ДанныеЗаполнения) = Тип("Структура")
			И ДанныеЗаполнения.Свойство("Товары")
			И ТипЗнч(ДанныеЗаполнения.Товары) = Тип("ТаблицаЗначений")
			И ДанныеЗаполнения.Товары.Колонки.Найти("ВариантОбеспечения") <> Неопределено;
			
	#Вставка 
	//++ #1989 смарт: Лопато 15.08.2024 //Сделать ввод на основании Задач, Заказов на перемещение, Заказов на Сборку/Разборку для документов СЦ  
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ЗадачаСсылка.ЗадачаИсполнителя") Тогда
		ДокументОснование = ДанныеЗаполнения;
	КонецЕсли;	
	//-- #1989 смарт: Лопато 15.08.2024
	#КонецВставки 
	
	#Вставка
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ДанныеЗаполнения));
	Если НЕ ОбъектМетаданных = Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", ОбъектМетаданных) Тогда
			ЭтотОбъект.смартЗапчастиГарантийные = ДанныеЗаполнения.смартЗапчастиГарантийные;
		КонецЕсли;
	КонецЕсли;
	//-- #Б1376 смарт: Шляпников 19.11.2024
	#КонецВставки
	
	ИнициализироватьДокумент(ДанныеЗаполнения, Не ЕстьВариантОбеспечения);
	
	ЗаполнениеСвойствПоСтатистикеСервер.ЗаполнитьСвойстваОбъекта(ЭтотОбъект, ДанныеЗаполнения);
	
КонецПроцедуры //-- #1670 смарт: Мосолов 14.03.2024

//++ смарт:ММ #044 224 12.01.2021 - Заявка на гарантийный ремонт 
&После("ПриКопировании")
Процедура смарт_ПриКопировании(ОбъектКопирования)
	
	Если ОбъектКопирования.СкладПолучатель = Справочники.смартПредопределенныеЗначения.СкладГарантийныхЗапчастейПоУмолчанию.Значение Тогда
		СкладПолучатель = Неопределено;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 12.01.2021

//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение  
&ИзменениеИКонтроль("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		
		Возврат;
		
	КонецЕсли;

	#Вставка
	//++ #Б1992 смарт: Шляпников 31.01.2025 / Заказ на перемещение. Демозал.
	СкладДемозалМоскваСмарт = Справочники.смартПредопределенныеЗначения.Настройки.СкладДемозалМоскваСмарт;
	Если НЕ Пользователи.РолиДоступны("ПолныеПрава, смартИнженерДемозала, АдминистраторДемоЗала, смартМнеджерДемозала") 
	     И (СкладОтправитель = СкладДемозалМоскваСмарт
	   	    ИЛИ СкладПолучатель = СкладДемозалМоскваСмарт
		 	ИЛИ Ссылка.СкладОтправитель = СкладДемозалМоскваСмарт
	   	    ИЛИ Ссылка.СкладПолучатель = СкладДемозалМоскваСмарт) Тогда
		   
		ОбщегоНазначения.СообщитьПользователю("У вас нет прав на перемещение товаров по демо залу Москва !",,,, Отказ);
		Возврат;
		
	КонецЕсли;
	//-- #Б1992 смарт: Шляпников 31.01.2025
	#КонецВставки

	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПроведениеСерверУТ.УстановитьРежимПроведения(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ЗаказыСервер.УстановитьКлючВСтрокахТабличнойЧасти(ЭтотОбъект, "Товары");
	
	ДополнительныеСвойства.Вставить("ЭтоНовый",    ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
	Если Не ИспользоватьДлительностьПеремещения Тогда
		Товары.ЗагрузитьКолонку(Товары.ВыгрузитьКолонку("НачалоОтгрузки"), "ОкончаниеПоступления");
	КонецЕсли;
	
	ОбщегоНазначенияУТ.ОкруглитьКоличествоШтучныхТоваров(ЭтотОбъект, РежимЗаписи);
	
	НоменклатураСервер.ОчиститьНеиспользуемыеСерии(
		ЭтотОбъект,
		НоменклатураСервер.ПараметрыУказанияСерий(
			ЭтотОбъект,
			Документы.ЗаказНаПеремещение));
	
	// Очистим реквизиты документа не используемые для хозяйственной операции.
	МассивВсехРеквизитов = Новый Массив;
	МассивРеквизитовОперации = Новый Массив;
	Документы.ЗаказНаПеремещение.ЗаполнитьИменаРеквизитовПоХозяйственнойОперации(
		ХозяйственнаяОперация,
		МассивВсехРеквизитов,
		МассивРеквизитовОперации);
	ДенежныеСредстваСервер.ОчиститьНеиспользуемыеРеквизиты(
		ЭтотОбъект,
		МассивВсехРеквизитов,
		МассивРеквизитовОперации);
	
	ШаблонНазначения = Документы.ЗаказНаПеремещение.ШаблонНазначения(ЭтотОбъект);
	ПерегенерацияНазначения = Справочники.Назначения.ПроверитьЗаполнитьПередЗаписью(Назначение, ШаблонНазначения,
		ЭтотОбъект, "НаправлениеДеятельности", Отказ);
	
	Если ПерегенерацияНазначения Тогда
		ОбосабливатьПоНазначениюЗаказа = Константы.ВариантОбособленияТоваровВПеремещении.Получить()
			<> Перечисления.ВариантыОбособленияТоваровВПеремещении.НазначениеПолучателя;
	КонецЕсли;
	
	#Вставка 
	//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
	
	//++ смарт:КМД #2_4 327 28.12.2020
	//перенесено из предыдущей разработки
	//++ смарт:ММ #059 327 02.08.2020 - Перенос даты резерва, спр. Грузы 
	
	//проверка на новый документ и на факт проведения
	Если ЗначениеЗаполнено(Ссылка) И РежимЗаписи = РежимЗаписиДокумента.Проведение тогда
		
		// Проверка, изменились ли даты поступления в табличной части
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
		|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
		|	ЗаказНаПеремещениеТовары.ОкончаниеПоступления КАК ДатаПоступления,
		|	ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
		|	ЗаказНаПеремещениеТовары.Количество КАК Количество,
		|	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК Склад
		|ПОМЕСТИТЬ ВТ_ДанныеПоСсылке
		|ИЗ
		|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		|ГДЕ
		|	ЗаказНаПеремещениеТовары.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
		|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
		|	ЗаказНаПеремещениеТовары.ОкончаниеПоступления КАК ДатаПоступления,
		|	ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
		|	ЗаказНаПеремещениеТовары.Количество КАК Количество,
		|	&СкладПолучатель КАК Склад
		|ПОМЕСТИТЬ ВТ_ДанныеОбъекта
		|ИЗ
		|	&Товары КАК ЗаказНаПеремещениеТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ДанныеПоСсылке.Номенклатура КАК Номенклатура,
		|	ВТ_ДанныеОбъекта.Характеристика КАК Характеристика,
		|	ВТ_ДанныеОбъекта.ДатаПоступления КАК ДатаПоступления,
		|	ВТ_ДанныеОбъекта.Количество КАК Количество,
		|	ВТ_ДанныеОбъекта.Склад КАК Склад,
		|	ВТ_ДанныеПоСсылке.ДатаПоступления КАК ДатаПоступленияНачальная
		|ИЗ
		|	ВТ_ДанныеПоСсылке КАК ВТ_ДанныеПоСсылке
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ДанныеОбъекта КАК ВТ_ДанныеОбъекта
		|		ПО ВТ_ДанныеПоСсылке.НомерСтроки = ВТ_ДанныеОбъекта.НомерСтроки
		|			И ВТ_ДанныеПоСсылке.Номенклатура = ВТ_ДанныеОбъекта.Номенклатура
		|			И ВТ_ДанныеПоСсылке.Характеристика = ВТ_ДанныеОбъекта.Характеристика
		|			И ВТ_ДанныеПоСсылке.ДатаПоступления <> ВТ_ДанныеОбъекта.ДатаПоступления
		|			И ВТ_ДанныеПоСсылке.Склад = ВТ_ДанныеОбъекта.Склад";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("Товары", Товары.Выгрузить());
		Запрос.УстановитьПараметр("СкладПолучатель", СкладПолучатель);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ДополнительныеСвойства.Вставить("смартИзмениласьДатаПоступленияДокумента", Истина);
			ТаблицаИзменившихсяДатПоступления = РезультатЗапроса.Выгрузить();
			ДополнительныеСвойства.Вставить("смартТаблицаИзменившихсяДатПоступления", ТаблицаИзменившихсяДатПоступления);
		КонецЕсли;				
		
	КонецЕсли;
	
	//++ смарт:КМД #2_4 327 24.12.2020
	//сбор таблицы для проверки отрицательных остатков
	Если ДополнительныеСвойства.Свойство("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений") = Ложь тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
		               |	ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
		               |	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК Склад
		               |ИЗ
		               |	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
		               |ГДЕ
		               |	ЗаказНаПеремещениеТовары.Ссылка = &Ссылка
		               //++ #1333 смарт: Фролов 27.03.2023 //Перестал работать контроль остатков резерва к дате (по задаче 327)  
					   |	И ЗаказНаПеремещениеТовары.ВариантОбеспечения В(&ВариантыОбеспечения)
		               //-- #1333 смарт: Фролов 27.03.2023
					   |
		               |СГРУППИРОВАТЬ ПО
		               |	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель,
		               |	ЗаказНаПеремещениеТовары.Номенклатура,
		               |	ЗаказНаПеремещениеТовары.Характеристика";
		//++ #1333 смарт: Фролов 27.03.2023 //Перестал работать контроль остатков резерва к дате (по задаче 327)  
		ВариантыОбеспечения=Новый Массив;
		ВариантыОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.СоСклада); 
		ВариантыОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);
		Запрос.УстановитьПараметр("ВариантыОбеспечения",ВариантыОбеспечения); 
		//-- #1333 смарт: Фролов 27.03.2023
		
		ТаблицаДляПроверкиОтрицательныхОстатков = Запрос.Выполнить().Выгрузить();
		ДополнительныеСвойства.Вставить("смартТаблицаДляПроверкиОтрицательныхОстатков", ТаблицаДляПроверкиОтрицательныхОстатков);
		
