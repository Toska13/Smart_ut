КонецФункции

//++ смарт:КМД #2_4 327 28.12.2020
Процедура смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, Склад, МассивТиповДокументов, СдвигатьРекурсивноЗаказыНаПеремещение, СдвигатьНазад)

	//найдем таблица по графикам отгрузки и поступления
	//распланируем даты отгрузки в зависимости от дат поступления
	
	Запрос = Новый Запрос;
	Запрос.Текст = смарт_ТекстЗапросаГрафики();
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	Запрос.УстановитьПараметр("Склад", Склад);
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТЗГрафикПоступления = МассивРезультатов[0].Выгрузить();
	ТЗГрафикОтгрузки = МассивРезультатов[1].Выгрузить();
	
	ТЗГрафикОтгрузки.Колонки.Добавить("ДатаСдвига", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	
	//для каждого документа из ТЗГрафикОтгрузки найдем даты, на которые надо перенести документ для того, чтобы график был корректным
	//разбивка строк в документах графика отгрузки не предусмотрена согласно условиям задачи!
	Для каждого стр_отгрузка из ТЗГрафикОтгрузки цикл
		КоличествоОтгрузка = стр_отгрузка.КоличествоОтгрузка;
		ДатаОтгрузки = стр_отгрузка.ДатаОтгрузки;
		
		//найдем соответсвующую строку графика поступления
		КоличествоГрафикПриемки = 0; //для поиска строк
		
		ДатаСдвига = Дата("00010101000000");
		
		Для каждого стр_поступление из ТЗГрафикПоступления цикл
			КоличествоГрафикПриемки = КоличествоГрафикПриемки + стр_поступление.КоличествоПоступление;
			Если КоличествоОтгрузка <= КоличествоГрафикПриемки тогда
				ДатаСдвига = стр_поступление.ДатаСобытия;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		//обработка таблицы ТЗГрафикПоступления, удаляем уже "занятые" количества
		МассивСтрокУдалить = Новый Массив;
		ОсталосьРаспределить = КоличествоОтгрузка;
		Для каждого стр_поступление из ТЗГрафикПоступления цикл
			Если ОсталосьРаспределить <= 0 тогда
				Прервать;
			КонецЕсли;
			
			РаспределитьТекущаяИтерация = Мин(стр_поступление.КоличествоПоступление, ОсталосьРаспределить);
			
			стр_поступление.КоличествоПоступление = стр_поступление.КоличествоПоступление - РаспределитьТекущаяИтерация;
			ОсталосьРаспределить = ОсталосьРаспределить - РаспределитьТекущаяИтерация;
			
			Если стр_поступление.КоличествоПоступление = 0 тогда
				МассивСтрокУдалить.Добавить(стр_поступление);
			КонецЕсли;
		КонецЦикла;
		
		Если МассивСтрокУдалить.Количество() > 0 тогда
			Для каждого стр_удалить из МассивСтрокУдалить цикл
				ТЗГрафикПоступления.Удалить(стр_удалить);
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаСдвига) тогда
			//нашли дату сдвига
			Если СдвигатьНазад = Истина тогда
				Если НачалоДня(ДатаСдвига) < НачалоДня(ДатаОтгрузки) тогда
					//в этом случае надо сдвигать дату в документе отгрузки
					стр_отгрузка.ДатаСдвига = ДатаСдвига;
				КонецЕсли;
			Иначе
				Если НачалоДня(ДатаСдвига) > НачалоДня(ДатаОтгрузки) тогда
					//в этом случае надо сдвигать дату в документе отгрузки
					стр_отгрузка.ДатаСдвига = ДатаСдвига;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//по наличию дат сдвигов сдвигаем документы
	//поддерживается сдвиг следующий документов:
	//1. ЗаказКлиента
	//2. ЗаказНаПеремещение
	//3. ЗаказНаСборку
	//4. ЗаказНаВнутреннееПотребление
	
	МассивИзмененныхЗаказовНаПеремещение = Новый Массив;
	
	Для каждого стр_отгрузка из ТЗГрафикОтгрузки цикл
		Если ЗначениеЗаполнено(стр_отгрузка.ДатаСдвига) тогда
			смарт_СдвинутьДокументИзменениеДокумента(МассивТиповДокументов, стр_отгрузка.Документ, стр_отгрузка.ДатаСдвига, Номенклатура, Характеристика, Склад, МассивИзмененныхЗаказовНаПеремещение);
		КонецЕсли;
	КонецЦикла;
	
	//рекурсивно сдвигаем даты "подчиненных" документов по складам получателям в заказах на перемещение
	//глубина вложенности - 1, то есть если будет несколько перемещений (Склад 1 - Склад 2 - Склад 3 - Заказ клипента склад 3), то заказ клиента исправлен не будет
	Если СдвигатьРекурсивноЗаказыНаПеремещение = Истина тогда
		Для каждого ЗаказНаПеремещение из МассивИзмененныхЗаказовНаПеремещение цикл
			СкладПеремещение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказНаПеремещение, "СкладПолучатель");
			Если ЗначениеЗаполнено(СкладПеремещение) тогда
				Если СдвигатьНазад = Истина тогда
					смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, СкладПеремещение, МассивТиповДокументов, Ложь, СдвигатьНазад);
				Иначе
					ОтрицательныйОстаток = смарт_НайтиОтрицательныйОстатокДоступныеОстаткиПланируемыхПоступлений(Номенклатура, Характеристика, СкладПеремещение);
					Если ОтрицательныйОстаток < 0 тогда
						смарт_СдвинутьДокументыОтгрузки(Номенклатура, Характеристика, СкладПеремещение, МассивТиповДокументов, Ложь, СдвигатьНазад);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

//++ смарт:КМД #2_4 327 28.12.2020
Процедура смарт_СдвинутьДокументИзменениеДокумента(МассивТиповДокументов, Док, ДатаСдвига, Номенклатура, Характеристика, Склад, МассивИзмененныхЗаказовНаПеремещение)
	ТипДок = ТипЗнч(Док);
	
	Если МассивТиповДокументов.Найти(ТипДок) <> Неопределено тогда
		//меняем данные в документах и проводим
		Об = Док.ПолучитьОбъект();
		
		Попытка
			Об.Заблокировать();
		Исключение			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ " + Строка(Док) + " не возможно изменить, он заблокирован: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		ОбъектИзменен = Ложь;
		
		Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") ИЛИ
			ТипДок = Тип("ДокументСсылка.ЗаказНаВнутреннееПотребление") тогда
			//отгрузить одной датой
			Если Об.НеОтгружатьЧастями = Истина тогда
				//если заказ отгружается одной датой, то снимаем этот признак, для того чтобы подвинуть дату по конкретному товару
				Об.НеОтгружатьЧастями = Ложь;
			КонецЕсли;
			
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Номенклатура);
			Отбор.Вставить("Характеристика", Характеристика);
			Если ТипДок = Тип("ДокументСсылка.ЗаказКлиента") тогда
				Отбор.Вставить("Склад", Склад);
			КонецЕсли;
			Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
			
			МассивСтрок = Об.Товары.НайтиСтроки(Отбор);
			Для каждого стр из МассивСтрок цикл
				стр.ДатаОтгрузки = ДатаСдвига;
				ОбъектИзменен = Истина;
			КонецЦикла;
		ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаСборку") тогда
			Об.НачалоСборкиРазборки = ДатаСдвига;
			Об.ОкончаниеСборкиРазборки = ДатаСдвига;
				
			ОбъектИзменен = Истина;
		ИначеЕсли ТипДок = Тип("ДокументСсылка.ЗаказНаПеремещение") тогда
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура", Номенклатура);
			Отбор.Вставить("Характеристика", Характеристика);
			Отбор.Вставить("ВариантОбеспечения", ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ИзЗаказов")); //резервировать к дате
			
			МассивСтрок = Об.Товары.НайтиСтроки(Отбор);
			Для каждого стр из МассивСтрок цикл
				стр.НачалоОтгрузки = ДатаСдвига;
				ОбъектИзменен = Истина;
			КонецЦикла;
		КонецЕсли;
		
		Если ОбъектИзменен Тогда
			//++ КМД 01.02.2021
			//добавим доп. свойство для отмены проверки на отрицательные остатки по регистру ДоступныеОстаткиПланируемыхПоступлений
			Об.ДополнительныеСвойства.Вставить("смартНеПроверятьДоступныеОстаткиПланируемыхПоступлений", Истина);
			
			Попытка
				Об.Записать(РежимЗаписиДокумента.Проведение);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Изменены даты резерва в документе """ + Строка(Док) + """", Док);
				
				НомерПоследнейВерсии = ПолучитьНомерВерсииПоследний(Док);
				Если НомерПоследнейВерсии <> Неопределено Тогда
					ВерсионированиеОбъектов.ДобавитьКомментарийКВерсии(Док, НомерПоследнейВерсии, "Автоматический перенос резерва при изменении даты поступления товара");
				КонецЕсли;
				
				Если ТипДок = Тип("ДокументСсылка.ЗаказНаПеремещение") тогда
					МассивИзмененныхЗаказовНаПеремещение.Добавить(Док);
				КонецЕсли;
			Исключение				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Документ """ + Строка(Док) + """ не записан: " + ОписаниеОшибки());
				//Отказ = Истина;
				//ОтменитьТранзакцию();
				//Возврат;
			КонецПопытки;	
		КонецЕсли;
		
		Об.Разблокировать();
	КонецЕсли;
КонецПроцедуры

//++ смарт:КМД #2_4 327 28.12.2020
Функция ПолучитьНомерВерсииПоследний(СсылкаНаОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Максимум(ВерсииОбъектов.НомерВерсии) КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	|ГДЕ
	|	ВерсииОбъектов.Объект = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ВерсииОбъектов.Объект";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);

	Результат = Неопределено;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НомерВерсии;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
