//Кусок кода для работы процедуры формирования документа заказа из отчета планирование закупок
Процедура смартЗаполнитьДокументНаОснованииОтчета(ДанныеЗаполнения)
	
	Для Каждого Строка Из ДанныеЗаполнения.ТоварыКЗаказу Цикл
		
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), Строка);
		
	КонецЦикла;
	
	ЭтотОбъект.Организация = Справочники.Организации.НайтиПоНаименованию("Смарт-Т ООО");
	ЭтотОбъект.СкладОтправитель = Справочники.Склады.НайтиПоНаименованию("Первый Этаж");
		
КонецПроцедуры //Каратеев - //-- #1670 смарт: Мосолов 14.03.2024

//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
//++ смарт 688 Корнющенко 21.10.21
Процедура смарт_ОбработатьГрафик(Движения,Отказ)
	
	Рег=Движения.ГрафикОтгрузкиТоваров;
	Таб=Рег.Выгрузить();
	
	Для каждого Стр Из Товары Цикл
		Если НЕ (Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить ИЛИ Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ИзЗаказов ИЛИ Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада) Тогда
			Для Каждого Стр2 ИЗ Таб Цикл
				Если Стр.Номенклатура = Стр2.Номенклатура И Стр.Характеристика = Стр2.Характеристика Тогда
					Если (Стр2.КоличествоИзЗаказов + Стр2.КоличествоНеобеспечено + Стр2.КоличествоПодЗаказ) - Стр.Количество <= 0 ИЛИ Стр2.КоличествоИзЗаказов = 0 Тогда
						Таб.Удалить(Стр2);
						Рег.Записывать=Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Рег.Загрузить(Таб);
	
КонецПроцедуры //-- смарт 688 Корнющенко 21.10.21 //-- #1670 смарт: Мосолов 14.03.2024

//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение  
// Перенес из &Вместо
&ИзменениеИКонтроль("ЗаполнитьПоЗаказуКлиента")
Процедура смарт_ЗаполнитьПоЗаказуКлиента(ДанныеЗаполнения)

	ЗаказКлиента = ДанныеЗаполнения.Основание;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЗаказКлиента.Статус                  КАК СтатусДокумента,
	|	ЗаказКлиента.Проведен                КАК Проведен,
	|	ЗаказКлиента.Организация             КАК Организация,
	|	ВЫБОР КОГДА ЗаказКлиента.Сделка.ОбособленныйУчетТоваровПоСделке ТОГДА
	|				ЗаказКлиента.Сделка
	|		КОНЕЦ                            КАК Сделка,
	|	ЗаказКлиента.Подразделение           КАК Подразделение,
	
	#Вставка  
	//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
	
	//++ #1228 смарт: Фролов 25.11.2022 //Заказ клиента Раздел Доставка - доработать  
	|	ЗаказКлиента.СпособДоставки КАК СпособДоставки,
	|	ЗаказКлиента.смартВидТранспорта КАК смартВидТранспорта,
	|	ЗаказКлиента.смартНомерМашины КАК смартНомерМашины,
	|	ЗаказКлиента.смартНомерПрицепа КАК смартНомерПрицепа,
	|	ЗаказКлиента.смартФИОВодителя КАК смартФИОВодителя,
	|	ЗаказКлиента.смартНомерСерияПаспортВодителя КАК смартНомерСерияПаспортВодителя,
	|	ЗаказКлиента.смартДатаВыдачиПаспортаВодителя КАК смартДатаВыдачиПаспортаВодителя,
	|	ЗаказКлиента.смартЖелаемоеВремяОтгрузки КАК смартЖелаемоеВремяОтгрузки,
	|	ЗаказКлиента.смартЖелаемаяДатаОтгрузкиАдмирал КАК смартЖелаемаяДатаОтгрузкиАдмирал,
	|	ЗаказКлиента.смартФИОВторогоВодителя КАК смартФИОВторогоВодителя,
	|	ЗаказКлиента.смартНомерСерияПаспортВторогоВодителя КАК смартНомерСерияПаспортВторогоВодителя,
	|	ЗаказКлиента.смартДатаВыдачиПаспортаВторогоВодителя КАК смартДатаВыдачиПаспортаВторогоВодителя,
	//-- #1228 смарт: Фролов 25.11.2022   
	
	//-- #1670 смарт: Мосолов 14.03.2024  
	#КонецВставки
	
	|	ЗаказКлиента.НаправлениеДеятельности КАК НаправлениеДеятельности
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &ЗаказКлиента");
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Реквизиты = Запрос.Выполнить().Выбрать();
	Реквизиты.Следующий();
	
	Документы.ЗаказКлиента.ПроверитьВозможностьВводаНаОсновании(
		ЗаказКлиента,
		Реквизиты.СтатусДокумента,
		НЕ Реквизиты.Проведен);
	
	// Заполнение шапки
	Организация             = Реквизиты.Организация;
	Сделка                  = Реквизиты.Сделка;
	ДокументОснование       = ЗаказКлиента;
	Подразделение           = Реквизиты.Подразделение;
	НаправлениеДеятельности = Реквизиты.НаправлениеДеятельности; 
	
	#Вставка
	//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
	
	//++ #1228 смарт: Фролов 25.11.2022 //Заказ клиента Раздел Доставка - доработать  
	смартВидТранспорта 						= Реквизиты.смартВидТранспорта;
	смартНомерМашины 						= Реквизиты.смартНомерМашины;
	смартНомерПрицепа 						= Реквизиты.смартНомерПрицепа;
	смартФИОВодителя 						= Реквизиты.смартФИОВодителя;
	смартНомерСерияПаспортВодителя 			= Реквизиты.смартНомерСерияПаспортВодителя;
	смартДатаВыдачиПаспортаВодителя 		= Реквизиты.смартДатаВыдачиПаспортаВодителя;
	смартЖелаемоеВремяОтгрузки 				= Реквизиты.смартЖелаемоеВремяОтгрузки;
	смартЖелаемаяДатаОтгрузкиАдмирал 		= Реквизиты.смартЖелаемаяДатаОтгрузкиАдмирал;
	смартФИОВторогоВодителя 				= Реквизиты.смартФИОВторогоВодителя;
	смартНомерСерияПаспортВторогоВодителя 	= Реквизиты.смартНомерСерияПаспортВторогоВодителя;
	смартДатаВыдачиПаспортаВторогоВодителя 	= Реквизиты.смартДатаВыдачиПаспортаВторогоВодителя;
	//-- #1228 смарт: Фролов 25.11.2022   
	
	//-- #1670 смарт: Мосолов 14.03.2024  
	#КонецВставки   
	
	СкладПолучатель         = ДанныеЗаполнения.Склад;
	
	// Заполнение табличной части.
	
	ПараметрыТаблицыТовары = ОбеспечениеСервер.ПараметрыТаблицыОстатковПоЗаказу();
	ПараметрыТаблицыТовары.ПолучатьУслуги = Ложь;
	ПараметрыТаблицыТовары.ПолучатьРаботы = Ложь;
	ПараметрыТаблицыТовары.Отбор          = СкладПолучатель;
	
	ТаблицаТовары = ОбеспечениеСервер.ТаблицаОстатковКЗаказу(ЗаказКлиента, ПараметрыТаблицыТовары);
	Товары.Загрузить(ТаблицаТовары);
	
КонецПроцедуры //-- #1670 смарт: Мосолов 14.03.2024

#КонецОбласти 

#КонецЕсли
  
