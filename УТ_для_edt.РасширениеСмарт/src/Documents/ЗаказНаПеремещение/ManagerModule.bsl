	|	"""" КАК БанковскийСчетПлательщика,
	|	"""" КАК Перевозчик,
	|	ЗаказКлиентаСсылка.смартФИОВодителя КАК Водитель,
	|	ЗаказКлиентаСсылка.смартВидТранспорта КАК МаркаАвтомобиля,
	|	ЗаказКлиентаСсылка.смартНомерМашины КАК ГосНомерАвтомобиля,
	|	ЕСТЬNULL(СкладыКонтактнаяОтправитель.Представление, """") КАК ПунктПогрузки,
	|	ЕСТЬNULL(СкладыКонтактнаяПолучатель.Представление, """") КАК ПунктРазгрузки,
