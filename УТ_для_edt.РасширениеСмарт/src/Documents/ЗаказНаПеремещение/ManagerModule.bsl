//++ #1901 смарт: Ермаков 21.08.2024 / Создание документа Заявка на разборку оборудования
Функция смартТекстЗапросаТаблицаОборудованиеКРазборке(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "смартОборудованиеКРазборке";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период 						КАК Период,
	|	&ЗаявкаНаРазборкуОборудования 	КАК Заявка,
	|	ДокументТовары.Номенклатура 	КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ДокументТовары.Серия = ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)
	|		ТОГДА &Серия
	|		ИНАЧЕ ДокументТовары.Серия
	|	КОНЕЦ 							КАК Серия,
	|	&НазначениеЗаявкаНаРазборку		КАК Назначение,
	|	&СкладОтправитель 				КАК Склад,
	|	&СкладПолучатель 				КАК СкладПолучатель,
	|	ДокументТовары.Количество 		КАК КПеремещениюЗаказано	
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ДокументТовары
	|ГДЕ
	|	&ЭтоРазборкаОборудования
	|	И ДокументТовары.Ссылка = &Ссылка
	|	И ДокументТовары.Ссылка.смартЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)";
			
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

