	Запрос.УстановитьПараметр("ЗаказКлиента", 		МассивЗаказовКлиентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭтоПервый = Истина;
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	МаркаАвто = "";
	ДатаОтгрузки = "";
		
	Пока Выборка.Следующий() Цикл
				
		
		смартЖелаемоеВремяОтгрузки = Выборка.смартЖелаемоеВремяОтгрузки;
		ДатаВремя = Формат(Выборка.ЖелаемаяДатаОтгрузки, "ДФ=dd.MM.yyyy");
		
		Если ЗначениеЗаполнено(смартЖелаемоеВремяОтгрузки) Тогда
			ДатаВремя = ДатаВремя + " " + Формат(смартЖелаемоеВремяОтгрузки, "ДФ=HH:mm");	
		КонецЕсли;
		
		Если ЭтоПервый Тогда

			ОбластьШапка.Параметры.ДатаОтгрузки = Формат(Выборка.ЖелаемаяДатаОтгрузки, "ДФ=dd.MM.yyyy");
			ОбластьШапка.Параметры.ДеньНедели 	= ВРег(Сред(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"),1,1)) + Сред(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"),2,СтрДлина(формат(Выборка.ЖелаемаяДатаОтгрузки,"ДФ=дддд"))+1);
