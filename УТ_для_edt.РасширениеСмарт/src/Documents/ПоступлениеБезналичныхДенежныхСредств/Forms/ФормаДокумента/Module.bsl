#Область ДоработкиСмарт

// Фролов+
&НаКлиенте
Процедура смарт_РасшифровкаПлатежаСуммаОбработкаВыбораПеред(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если смартКэшСуммыРасшифровкиПлатежа=0 Тогда 
		смартКэшСуммыРасшифровкиПлатежа=Элементы.РасшифровкаПлатежа.ТекущиеДанные.Сумма;
	КонецЕсли; 	
КонецПроцедуры

&НаКлиенте
Процедура смарт_РасшифровкаПлатежаСуммаАвтоПодборПеред(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	Если смартКэшСуммыРасшифровкиПлатежа=0 Тогда 
		смартКэшСуммыРасшифровкиПлатежа=Элементы.РасшифровкаПлатежа.ТекущиеДанные.Сумма;
	КонецЕсли;		
КонецПроцедуры
// Фролов-

&НаСервере
Процедура УстановитьДоступностьПоПризнакуОплатыЧерезКассу()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьДоступностьПлатежныхРеквизитов(Объект.смарт_ОплаченоЧерезКассуБанка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьПлатежныхРеквизитов(РазрешитьИзменения)
	
	Элементы.Контрагент.ТолькоПросмотр = Не РазрешитьИзменения;
	Элементы.БанковскийСчетКонтрагента.ТолькоПросмотр = Не РазрешитьИзменения;
	
КонецПроцедуры

&НаКлиенте
Процедура смарт_смарт_ОплаченоЧерезКассуБанкаПриИзмененииПосле(Элемент)
	РазрешитьРедактированиеПлатежныхРеквизитов = Объект.смарт_ОплаченоЧерезКассуБанка;
	
	Если Не РазрешитьРедактированиеПлатежныхРеквизитов Тогда
		
		Режим = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗакрытияВопроса",ЭтаФорма,Новый Структура("РазрешитьИзменения",РазрешитьРедактированиеПлатежныхРеквизитов)),
						"Внимание!
						|После снятия признака,
						|при повторной загрузке данных из клиент-банка
						|документ будет помечен как непроведенный банком!
						|Продолжить выполнение операции?", Режим);		
	Иначе
		УстановитьДоступностьПлатежныхРеквизитов(РазрешитьРедактированиеПлатежныхРеквизитов);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат,ДопПараметры)Экспорт 
	Если Результат=КодВозвратаДиалога.Нет Тогда 
		Объект.смарт_ОплаченоЧерезКассуБанка=Истина;
	Иначе
		УстановитьДоступностьПлатежныхРеквизитов(ДопПараметры.РазрешитьИзменения);
	КонецЕсли;	
КонецПроцедуры	

// Фролов+
&НаКлиенте
Процедура РасшифровкаПлатежаКурсПриИзменении(Элемент)
	ПересчитатьСуммуВзаиморасчетовИКурс(Элементы.РасшифровкаПлатежа.ТекущиеДанные.ПолучитьИдентификатор(),Элемент.Имя);
КонецПроцедуры	

&НаСервере
Процедура смартПересчитатьКурс()
	Для Каждого Стр Из Объект.РасшифровкаПлатежа Цикл 
		//++#1320 смарт: Лопато 01.03.2023 //Изменить порядок вычисленя Курса и Суммы взаиморасчета в валюте  
		Если Объект.смартРасчетОтКурса И НЕ Стр.смартКурсДокумента = 0 Тогда
			Стр.СуммаВзаиморасчетов = ?(Стр.смартКурсДокумента = 0, 0, Стр.Сумма / Стр.смартКурсДокумента);
		Иначе
			Стр.смартКурсДокумента = ?(Стр.СуммаВзаиморасчетов = 0, 0, Стр.Сумма / Стр.СуммаВзаиморасчетов);
		КонецЕсли;	
		//--#1320 смарт: Лопато 01.03.2023
	КонецЦикла;
КонецПроцедуры	
// Фролов-

&НаКлиенте
Процедура смартДействиеПоказатьИнформацию(Команда)
//++#1320 смарт: Лопато 01.03.2023 //Изменить порядок вычисленя Курса и Суммы взаиморасчета в валюте  
	
	Если СтрНайти(Команда.Имя, "смартРасчетОтКурса") <> 0 Тогда

		ИнформацияЗаголовок = "Расчет от курса";

		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'Выберите это значение, если нужно изменить порядок вычисления.'")
			+ Символы.ПС
			+ Символы.ПС
			+ НСтр("ru = 'По-умолчанию курс рассчитывается как'")
			+ Символы.ПС
			+ НСтр("ru = '<b>Сумма оплаты (руб) / Сумма взаиморасчетов = Курс</b>'")
			);

	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
	КонецЕсли;

КонецПроцедуры //--#1320 смарт: Лопато 01.03.2023

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
// Смарт Фролов+
// Смарт Функция проверки возможности изменения табличной части "Расшифровка платежа"
// Входной параметр Стр - строка табличной части в которой происходт изменение; ИмяЭлемента - имя элемента формы
// Возвращаемое значение Булево
&НаКлиенте
Функция смартВозможностьИзмененияРасшифровкиПлатежа(Стр, ИмяЭлемента = "")
	
	ИзменятьМожно = Истина;
	
	Если ТипЗнч(Стр.ОснованиеПлатежа) = Тип("ДокументСсылка.ЗаказКлиента") Тогда 
		
		ДанныеЗаказа =смартПолучитьДанныеЗаказа(Стр.ОснованиеПлатежа, ?(Объект.ПроведеноБанком, Объект.ДатаПроведенияБанком, Объект.Дата), Объект.Валюта);
		
		Если ДанныеЗаказа.ПолныеПрава Тогда 
			Возврат Истина;
		КонецЕсли;	
		
		Если ДанныеЗаказа.Закрыт Тогда  // Пока только по "Закрытым заказам"
			ИзменятьМожно = Ложь; 
			смартВывестиСообщениеИОбновитьЭлементыФормы("Изменение оплаты по закрытому заказу запрещено!", ИмяЭлемента, Стр.ПолучитьИдентификатор());	
		КонецЕсли;	  
		
	КонецЕсли;
	
	Возврат ИзменятьМожно; 
	
КонецФункции // Фролов- //-- #Б-960 смарт: Мосолов 23.09.2024 

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
// Смарт Фролов+
&НаСервере
Процедура смартДозаполнитьДанныеСтроки(ИД) 
	
	Стр = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ИД);
	
	Если Объект.Валюта = Стр.ВалютаВзаиморасчетов Тогда
		Стр.СуммаВзаиморасчетов = Стр.Сумма;
	Иначе	
		//++#1320 смарт: Лопато 01.03.2023 //Изменить порядок вычисленя Курса и Суммы взаиморасчета в валюте  
		Если Объект.смартРасчетОтКурса Тогда
			Стр.СуммаВзаиморасчетов = ?(Стр.смартКурсДокумента = 0, 0, Стр.Сумма / Стр.смартКурсДокумента);
		Иначе
			ДанныеВалютыДок = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, ?(Объект.ПроведеноБанком, Объект.ДатаПроведенияБанком, Объект.Дата));
			ДанныеВалютыВзаиморасчетов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Стр.ВалютаВзаиморасчетов, ?(Объект.ПроведеноБанком, Объект.ДатаПроведенияБанком, Объект.Дата));
			Стр.смартКурсДокумента = ДанныеВалютыВзаиморасчетов.Курс;
			Стр.СуммаВзаиморасчетов = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Сумма, ДанныеВалютыДок, ДанныеВалютыВзаиморасчетов);
		КонецЕсли;	
		//--#1320 смарт: Лопато 01.03.2023
	КонецЕсли;		
	
	ПересчитатьСуммуВзаиморасчетовИКурс(ИД, "РасшифровкаПлатежаСумма");
	
	Если Не ЗначениеЗаполнено(Стр.СтатьяДвиженияДенежныхСредств) Тогда 
		Стр.СтатьяДвиженияДенежныхСредств = ДенежныеСредстваСервер.СтатьяДвиженияДенежныхСредствОбъектаРасчетов(Стр.ОснованиеПлатежа, Объект.ХозяйственнаяОперация);
	КонецЕсли;
	
КонецПроцедуры // Фролов- //-- #Б-960 смарт: Мосолов 23.09.2024	

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
// Смарт Фролов+
&НаСервере
Процедура ПересчитатьСуммуВзаиморасчетовИКурс(ИдСтроки, ЭлементОснование)
	
	Стр = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(ИдСтроки);   
	
	Если ЭлементОснование = "РасшифровкаПлатежаСумма" 
		Или ЭлементОснование = "РасшифровкаПлатежаСуммаВзаиморасчетов" 
		//++#1320 смарт: Лопато 01.03.2023 //Изменить порядок вычисленя Курса и Суммы взаиморасчета в валюте  
		Или ЭлементОснование = "РасшифровкаБезРазбиенияСуммаВзаиморасчетов"
		Или ЭлементОснование = "РасшифровкаБезРазбиенияОснованиеПлатежа" 
		Или ЭлементОснование = "РасшифровкаПлатежаОснованиеПлатежа" Тогда  
		
		Если Объект.смартРасчетОтКурса Тогда
			Стр.СуммаВзаиморасчетов = ?(Стр.смартКурсДокумента = 0, 0, Стр.Сумма / Стр.смартКурсДокумента);
		Иначе
			Стр.смартКурсДокумента = ?(Стр.СуммаВзаиморасчетов = 0, 0, Стр.Сумма / Стр.СуммаВзаиморасчетов);
		КонецЕсли;	
		//--#1320 смарт: Лопато 01.03.2023   
		
	ИначеЕсли ЭлементОснование = "РасшифровкаПлатежаКурс" Или ЭлементОснование = "РасшифровкаБезРазбиенияКурс" Тогда 	
		Стр.СуммаВзаиморасчетов = ?(Стр.смартКурсДокумента = 0, 0, Стр.Сумма / Стр.смартКурсДокумента);
	КонецЕсли;	      
	
КонецПроцедуры // Фролов- //-- #Б-960 смарт: Мосолов 23.09.2024

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо)
// Смарт Фролов+
// Функция получает данные по заказу клиента
// Входные параметры: Заказ - Ссылка на на Заказ клиента; ДатаОплаты - Дата документа оплаты; Валюта - валюта документа оплаты
// Возвращаемое значение: Структура
&НаСервереБезКонтекста
Функция смартПолучитьДанныеЗаказа(Заказ, ДатаОплаты, Валюта)	
	ДанныеЗаказа = Новый Структура("ПолныеПрава, Закрыт, Сальдо, СуммаОтгрузки, СуммаОплатыВВалютеЗаказа, СуммаОплатыВВалютеОплаты", РольДоступна("ПолныеПрава"), Ложь);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Дата", ДатаОплаты);
	Запрос.УстановитьПараметр("Валюта", Валюта);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СостоянияЗаказовКлиентов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт) КАК Закрыт,
	|	ВЫРАЗИТЬ((СостоянияЗаказовКлиентов.СуммаОплаты - СостоянияЗаказовКлиентов.СуммаОтгрузки) * (ЕСТЬNULL(КурсЗаказа.Курс, 1) * ЕСТЬNULL(КурсЗаказа.Кратность, 1)) / (ЕСТЬNULL(КурсОплаты.Курс, 1) * ЕСТЬNULL(КурсОплаты.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК Сальдо,
	|	СостоянияЗаказовКлиентов.СуммаОтгрузки КАК СуммаОтгрузки,
	|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплатыВВалютеЗаказа,
	|	ВЫРАЗИТЬ(СостоянияЗаказовКлиентов.СуммаОплаты * (ЕСТЬNULL(КурсЗаказа.Курс, 1) * ЕСТЬNULL(КурсЗаказа.Кратность, 1)) / (ЕСТЬNULL(КурсОплаты.Курс, 1) * ЕСТЬNULL(КурсОплаты.Кратность, 1)) КАК ЧИСЛО(15, 2)) КАК СуммаОплатыВВалютеОплаты
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, Валюта = &Валюта) КАК КурсОплаты
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсЗаказа
	|		ПО (СостоянияЗаказовКлиентов.Заказ.Валюта = КурсЗаказа.Валюта)
	|ГДЕ
	|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
	
	Рез = Запрос.Выполнить().Выбрать(); 
	
	Если Рез.Следующий() Тогда 
		ЗаполнитьЗначенияСвойств(ДанныеЗаказа, Рез);
	КонецЕсли;
	
	Возврат ДанныеЗаказа;  
	
КонецФункции // Фролов- //-- #Б-960 смарт: Мосолов 23.09.2024

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо)
// Смарт Процедура вывода сообщения об ошибке и обновления элементов формы
// Входные параметры: ТекстСообщения - текст; ИмяЭлемента - имя элемента формы; ИДСтр - идентификатор строки табличной части "Расшифровка платежа"
&НаКлиенте
Процедура смартВывестиСообщениеИОбновитьЭлементыФормы(ТекстСообщения,ИмяЭлемента,ИДСтр) 
	
	Если ПереключательРасшифровки = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , ИмяЭлемента);
		ЭтаФорма.ОбновитьОтображениеДанных(Элементы.РасшифровкаБезРазбиения);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , , "Объект.РасшифровкаПлатежа[" + ИДСтр + "].ОснованиеПлатежа");
		Элементы.РасшифровкаПлатежа.ЗакончитьРедактированиеСтроки(Истина);
		Элементы.РасшифровкаПлатежа.Обновить();
	КонецЕсли;	 
	
КонецПроцедуры // Фролов- //-- #Б-960 смарт: Мосолов 23.09.2024

//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо)
// Смарт Процедура вывода сообщения об ошибке и обновления элементов формы
// Входные параметры: ТекстСообщения - текст; ИмяЭлемента - имя элемента формы; ИДСтр - идентификатор строки табличной части "Расшифровка платежа"
&НаКлиенте
&ИзменениеИКонтроль("РасшифровкаПлатежаОснованиеПлатежаОбработкаВыбора")
Процедура смарт_РасшифровкаПлатежаОснованиеПлатежаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь; 
	
	СтрокаТаблицы = Элементы.РасшифровкаПлатежа.ТекущиеДанные; 
	
	#Вставка
	//++ #Б-960 смарт: Мосолов 23.09.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ПоступлениеБезналичныхДенежныхСредств
