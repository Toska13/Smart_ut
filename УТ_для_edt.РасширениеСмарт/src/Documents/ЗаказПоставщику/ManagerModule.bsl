//++ #Б-1458 смарт: Лопато 12.02.2025 //Заполнение поля Желаемая дата поступления в документе Заказ поставщику  
Процедура ЗаполнитьЖелаемуюДатуПоступленияИзГруза(ЖелаемаяДатаПоступления, Груз) Экспорт
	
	Если ЗначениеЗаполнено(Груз) Тогда
		
		ПланируемаяДатаПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Груз, "ПланируемаяДатаПоступления", Истина);
		
		Если ЗначениеЗаполнено(ПланируемаяДатаПоступления)
			И ЖелаемаяДатаПоступления <> ПланируемаяДатаПоступления Тогда
			
			ЖелаемаяДатаПоступления = ПланируемаяДатаПоступления;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры //-- #Б-1458 смарт: Лопато 12.02.2025

//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
Функция смартТекстЗапросаТаблицаОборудованиеКРазборке(Запрос, ТекстыЗапроса, Регистры)

	ИмяРегистра = "смартОборудованиеКРазборке";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	&Период 								КАК Период,
	|	ДокументТовары.Назначение.Заказ 		КАК Заявка,
	|	ДокументТовары.Номенклатура 			КАК Номенклатура,
	|	ДокументТовары.Назначение.Заказ.Серия	КАК Серия,
	|	&НазначениеЗаявкаНаРазборку				КАК Назначение,
	|	&Склад	 								КАК Склад,
	|	&ПустойСклад	 						КАК СкладПолучатель,
	|	ДокументТовары.Количество				КАК КЗаказуПоставщикуЗаказано
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ДокументТовары
	|ГДЕ                                
	|	ДокументТовары.Ссылка = &Ссылка
	|	И ДокументТовары.Назначение.Заказ ССЫЛКА Документ.смартЗаявкаНаРазборкуОборудования
	|	И НЕ ДокументТовары.Назначение.Заказ = ЗНАЧЕНИЕ(Документ.смартЗаявкаНаРазборкуОборудования.ПустаяСсылка)
	|	И ДокументТовары.Назначение.смартРазобранноеОборудованиеТипНазначения = 
	|		ЗНАЧЕНИЕ(Перечисление.смартТипыНазначенийРазобранногоОборудования.НаЗаменуСнятойЗапаснойЧасти)";
			
	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

