//++#1894 смарт: Лопато 09.07.2024 //Процент выполнения предзаказа  
Функция ТекстЗапросаТаблицаПредзаказыПоставщикам(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартПредзаказыПоставщикам";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	Ссылка.Дата							   КАК Период,
	|	Ссылка.Ссылка						   КАК Регистратор,
	|	Номенклатура						   КАК Номенклатура,
	|	Характеристика						   КАК Характеристика,
	|	смартПредзаказПоставщику			   КАК ПредзаказПоставщику,
	|	Ссылка.Организация					   КАК Организация,
	|	Ссылка.Партнер						   КАК Партнер,
	//++ #Б2138 смарт: Шляпников 19.02.2025 / Заявка на разборку оборудования. Обратная сборка оборудования.
	|	Назначение							   КАК Назначение,
	//-- #Б2138 смарт: Шляпников 19.02.2025
	|	Количество							   КАК Заказано
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары
	|ГДЕ
	|	Ссылка = &Ссылка
	|	И НЕ смартПредзаказПоставщику = ЗНАЧЕНИЕ(Документ.смартПредзаказПоставщику.ПустаяСсылка)
	|";

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции //--#1894 смарт: Лопато 09.07.2024

//++#1894 смарт: Лопато 09.07.2024 //Процент выполнения предзаказа  
Функция ТекстЗапросаГрузыКОформлению(Запрос, ТекстыЗапроса, Регистры)
	
	ИмяРегистра = "смартГрузыКОформлению";
	
	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли; 

	//++#360 смарт: Тимофеева 15.08.2025 / Формирование приходного ордера, учитывая аналитику Контейнер (ИСМ 1903)
	//ТекстЗапроса = 
	//"ВЫБРАТЬ
	//|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	//|	Ссылка.Дата							   КАК Период,
	//|	Ссылка.Ссылка						   КАК Регистратор,
	//|	Номенклатура						   КАК Номенклатура,
	//|	Ссылка.Груз					   		   КАК Груз,
	//|	КоличествоУпаковок			   		   КАК КОформлению,
	//|	КоличествоУпаковок					   КАК КПриемке
	//|ИЗ
	//|	Документ.ЗаказПоставщику.Товары
	//|ГДЕ
	//|	Ссылка = &Ссылка
	//|	И НЕ Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)
	//|";  
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаТовары.Ссылка.Дата КАК Период,
	|	ТаблицаТовары.Склад КАК Склад,
	|	ТаблицаТовары.Ссылка КАК Заказ,
	|	ТаблицаТовары.Номенклатура КАК Номенклатура,
	|	ТаблицаТовары.Характеристика КАК Характеристика,
	|	ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка) КАК Серия,
	|	ВЫБОР
	|		КОГДА ТаблицаТовары.Назначение <> ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ТаблицаТовары.Назначение.ДвиженияПоСкладскимРегистрам
	|						ТОГДА ТаблицаТовары.Назначение
	|					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|	КОНЕЦ КАК Назначение,
	|	ТаблицаТовары.смартНомерЗаявкиНаГарантийныйРемонтСсылка КАК ЗаявкаНаГарантийныйРемонт,
	|	ТаблицаТовары.Ссылка.Груз КАК Груз,
	|	ТаблицаТовары.Количество КАК КОформлению,
	|	0 КАК КПриемке
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ТаблицаТовары
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И НЕ ТаблицаТовары.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ЗакупкаУПоставщика)
	|	И ТаблицаТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
	|	И НЕ ТаблицаТовары.Отменено
	|	И &Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Подтвержден), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт))";	
	//--#360 смарт: Тимофеева 15.08.2025	

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции //--#1894 смарт: Лопато 09.07.2024

