//++ смарт:ММ #092 389 17.01.2021 - Конструктор оборудования
&НаКлиенте
Процедура смартОбработкаВыбораСпецификации(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) И ТипЗнч(РезультатЗакрытия) = Тип("ДокументСсылка.смартIECHOСпецификация") Тогда	
		
		СкидкаНаЗакупку = Неопределено;
		СкидкаНаЗакупкуИспользована = смартСкидкаНаЗакупкуИспользована(РезультатЗакрытия, СкидкаНаЗакупку);
		
		Если СкидкаНаЗакупкуИспользована И ЗначениеЗаполнено(СкидкаНаЗакупку) Тогда
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Спецификация", РезультатЗакрытия);
			Оповещение = Новый ОписаниеОповещения("смартВопросВыборСкидкиЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			ТекстВопроса = НСтр("ru = 'Нет свободных скидок " + СкидкаНаЗакупку + ". Выбрать другую скидку?'");
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);	
			
		Иначе
			смартЗаполнитьТоварыПоСпецификацииНаКлиенте(РезультатЗакрытия, СкидкаНаЗакупку);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 17.01.2021

//++ смарт:ММ #092 389 18.01.2021 - Конструктор оборудования
&НаКлиенте
Процедура смартВопросВыборСкидкиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда	
		
		ИсключаемыеЭлементы = Новый Массив;
		Для Каждого Строка Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(Строка.смартСкидкаНаЗакупку) 
				И ИсключаемыеЭлементы.Найти(Строка.смартСкидкаНаЗакупку) = Неопределено Тогда
				ИсключаемыеЭлементы.Добавить(Строка.смартСкидкаНаЗакупку);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура;
		Отбор = Новый Структура;
		Отбор.Вставить("Использована", Ложь);
		ПараметрыФормы.Вставить("Отбор", Отбор);
		ПараметрыФормы.Вставить("смартИсключаемыеЭлементы", ИсключаемыеЭлементы);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("смартОбработкаВыбораСкидкиНаЗакупку", ЭтотОбъект, ДополнительныеПараметры);
		ОткрытьФорму("Справочник.смартIECHOСкидкиНаЗакупку.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОписаниеОповещения);
	Иначе
		смартЗаполнитьТоварыПоСпецификацииНаКлиенте(ДополнительныеПараметры.Спецификация, Неопределено);
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 18.01.2021

//++ смарт:ММ #092 389 17.01.2021 - Конструктор оборудования
&НаКлиенте
Процедура смартОбработкаВыбораСкидкиНаЗакупку(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатЗакрытия) И ТипЗнч(РезультатЗакрытия) = Тип("СправочникСсылка.смартIECHOСкидкиНаЗакупку") Тогда	
		
		СкидкаНаЗакупку = РезультатЗакрытия;
		смартЗаполнитьТоварыПоСпецификацииНаКлиенте(ДополнительныеПараметры.Спецификация, СкидкаНаЗакупку);
			
