//++ #Б-6768 смарт: Фролов 01.06.2026 //Заказ поставщику. Доработка документа.
Функция ПолучитьЗначенияПошлиныИТаможенногоСбора(Номенклатура)
	Результат = Новый Структура("смартСтавкаПошлины, смартПовышенныйТаможенныйСбор", "", Ложь);
	
	КодТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КодТНВЭД");
	Если ЗначениеЗаполнено(КодТНВЭД) Тогда
		ЗначенияРеквизитов 					= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КодТНВЭД, "смартБазоваяСтавка,смартПовышенныйТаможенныйСбор");
		Результат.смартСтавкаПошлины 			= ЗначенияРеквизитов.смартБазоваяСтавка;
		Результат.смартПовышенныйТаможенныйСбор 	= ЗначенияРеквизитов.смартПовышенныйТаможенныйСбор;
	КонецЕсли;
	Возврат Результат;
