//++ смарт:ММ #092 389 17.01.2021 - Конструктор оборудования
&НаСервере
Процедура смартЗаполнитьТоварыПоСпецификацииНаСервере(Спецификация, СкидкаНаЗакупку)
		
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.Номенклатура = Спецификация.Номенклатура;
	НоваяСтрока.Количество = 1;
	НоваяСтрока.КоличествоУпаковок = 1;
	НоваяСтрока.Цена = Спецификация.Итого;
	НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
	
	СкидкаПроцент = Ложь;
	СкидкаСумма = Ложь;
	Если ЗначениеЗаполнено(СкидкаНаЗакупку) И ЗначениеЗаполнено(СкидкаНаЗакупку.Размер) Тогда
		Если СкидкаНаЗакупку.ЕдиницаИзмерения = Перечисления.смартСпособыПредоставленияСкидок.Сумма Тогда
			НоваяСтрока.СуммаРучнойСкидки = СкидкаНаЗакупку.Размер;
			СкидкаСумма = Истина;
		ИначеЕсли СкидкаНаЗакупку.ЕдиницаИзмерения = Перечисления.смартСпособыПредоставленияСкидок.Процент Тогда
			НоваяСтрока.ПроцентРучнойСкидки = СкидкаНаЗакупку.Размер;
			СкидкаПроцент = Истина;
		КонецЕсли;
		
		НоваяСтрока.смартСкидкаНаЗакупку = СкидкаНаЗакупку;
	КонецЕсли;
	
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("ПересчитыватьСуммуРучнойСкидки", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());

	КэшированныеЗначения = Неопределено;
	Если СкидкаСумма Тогда
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьПроцентРучнойСкидкиВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;
	Если СкидкаПроцент Тогда
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуРучнойСкидкиВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
	КонецЕсли;

	НоваяСтрока.Склад = Объект.Склад;
	НоваяСтрока.БезВозвратнойТары = Истина;
	НоваяСтрока.Сумма = НоваяСтрока.Сумма - НоваяСтрока.СуммаРучнойСкидки;
	НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	//ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);

	//ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСУчетомРучнойСкидкиВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
	НоваяСтрока.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
		НоваяСтрока.Сумма,
		УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС),
		Объект.ЦенаВключаетНДС,
		Объект.НалогообложениеНДС);
	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСНДСВСтрокеТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);

	НоваяСтрока.СуммаСНДСБезВозвратнойТары = НоваяСтрока.СуммаСНДС;
	ОбработкаТабличнойЧастиКлиентСервер.ЗаполнитьДубликатыЗависимыхРеквизитов(НоваяСтрока, СтруктураДействий);
	
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	
	Модифицированность = Истина;
	
КонецПроцедуры //-- смарт:ММ 17.01.2021

//++ смарт:ММ #092 389 18.01.2021 - Конструктор оборудования
&НаСервере
Процедура смарт_ПередЗаписьюНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	МассивСкидокДляИзменения = Новый Массив;
	
	Для Каждого Строка Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Строка.смартСкидкаНаЗакупку) Тогда			
			МассивСкидокДляИзменения.Добавить(Строка.смартСкидкаНаЗакупку);			
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСкидокДляИзменения.Количество() > 0 Тогда
		// Запись перенесена в модуль объекта, чтобы при неудачной попытки записи справочник не менялся (перенесено в транзакцию)
		ТекущийОбъект.ДополнительныеСвойства.Вставить("смартМассивСкидокДляИзменения", МассивСкидокДляИзменения);
	КонецЕсли;

КонецПроцедуры //-- смарт:ММ 18.01.2021

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смартЗаполнитьКонтейнеры(Элемент)
	Если смартИспользуютсяКонтейнеры() Тогда 
		Если Элементы.Товары.ВыделенныеСтроки.Количество() > 1 Тогда
			СписокКонтейнеров = смартПолучитСписокКонтейнеров(Объект.Груз);
		Иначе	
			ТекДанные = Элементы.Товары.ТекущиеДанные;
			Если Не ТекДанные = Неопределено Тогда
				Если ЗначениеЗаполнено(ТекДанные.смартКонтейнер) Тогда
					ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(ТекДанные.смартКонтейнер);
					СписокКонтейнеров = смартЗаполнитьСписокНаСервере(ЗначениеДляКонтейнера)
				Иначе
					СписокКонтейнеров = смартПолучитСписокКонтейнеров(Объект.Груз);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	    смартОткрытьФормуВыбораКонтейнеров(СписокКонтейнеров);
	КонецЕсли;	
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023 

//++#1374 смарт: Балашов 04.07.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Функция смартПроверитьВозможностьИзмененияКонтейнеров()
	//проверим есть ли ПТУ по данному документу
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриобретениеТоваровУслуг.Ссылка КАК ПТУ
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	               |ГДЕ
	               |	ПриобретениеТоваровУслуг.ЗаказПоставщику = &СсылкаЗаказ  И ПриобретениеТоваровУслуг.Проведен
				   |";
	Запрос.УстановитьПараметр("СсылкаЗаказ",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ПТУ;
	Иначе
		Результат = Неопределено;
	КонецЕсли;	          
	Возврат Результат;
КонецФункции//--#1374 смарт: Балашов 04.07.2023	

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смартОткрытьФормуВыбораКонтейнеров(СписокКонтейнеров)
   	ПТУ = смартПроверитьВозможностьИзмененияКонтейнеров();
	Если ПТУ = Неопределено Тогда
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных;
		Если Не СписокКонтейнеров = Неопределено Тогда
		    ГруппаОтбора = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ЭлементОтбора = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных")); 
			ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
			ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
			ЭлементОтбора.Использование  = Истина;
			ЭлементОтбора.ПравоеЗначение = СписокКонтейнеров;
		КонецЕсли;	
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("СписокКонтейнеров", СписокКонтейнеров);
	 	ПараметрыФормы.Вставить("МножественныйВыбор", истина);

		ОбработкаВыбора = Новый ОписаниеОповещения("смартПриЗакрытииФормыВыбораКонтейнеров", ЭтаФорма,"Подбор");
		ОткрытьФорму("Справочник.смартКонтейнеры.Форма.ФормаВыбораКонтейнеров", ПараметрыФормы,
		        ЭтаФорма, , , , ОбработкаВыбора);
	Иначе
		
		ТекстСообщения = Новый ФорматированнаяСтрока("По данному документу создан: ", 
	    Новый ФорматированнаяСтрока(Строка(ПТУ),,,,ПолучитьНавигационнуюСсылку(ПТУ)), 
	    " Изменение контейнеров возможно только в нем");		
			
		ПоказатьПредупреждение(, ТекстСообщения,, "Предупреждение");
		
	КонецЕсли;			
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023	

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смартПриЗакрытииФормыВыбораКонтейнеров(Значение, ДопПараметры) Экспорт
    Если Значение = Неопределено Тогда
        Возврат;
	КонецЕсли; 
	
	СтрокаJSON = смартОбщегоНазначения.смартЗаписатьВыбраныеКонтейнерыВJSON(Значение);
	
	ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрокаJSON);

	СписокСтрок = Элементы.Товары.ВыделенныеСтроки;
	Для Каждого Строка_ТЧ Из СписокСтрок Цикл
		ТекСтрока = Объект.Товары.НайтиПоИдентификатору(Строка_ТЧ);
		ТекСтрока.смартКонтейнер = СтрокаJSON;
		ТекСтрока.Контейнеры = смартОбщегоНазначения.смартКонтейнерыВСтроку(ЗначениеДляКонтейнера);
	КонецЦикла;
    ЭтотОбъект.Модифицированность = истина;
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023                                                   

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Функция смартПолучитСписокКонтейнеров(Груз)
	Запрос = Новый Запрос;	
	Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	смартСобытияКонтейнеров.Груз КАК Груз,
		|	смартСобытияКонтейнеров.Контейнер КАК Контейнер
		|ИЗ
		|	РегистрСведений.смартСобытияКонтейнеров КАК смартСобытияКонтейнеров
		|ГДЕ
		|	смартСобытияКонтейнеров.Груз = &Груз
		|";
	Запрос.УстановитьПараметр("Груз",Груз);
	СписокКонтейнеров = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокКонтейнеров.Добавить(Выборка.Контейнер,,ложь);
	КонецЦикла;	                           
	Возврат СписокКонтейнеров;
КонецФункции//--#1374 смарт: Балашов 15.06.2023

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаСервере
Функция смартЗаполнитьСписокНаСервере(ЗначениеДляКонтейнера)
	СписокКонтейнеров = Новый СписокЗначений;
	Если ЗначениеДляКонтейнера.Количество() = 0 Тогда
		СписокКонтейнеров = смартПолучитСписокКонтейнеров(Объект.Груз);	
	Иначе	
		Для Каждого СтрКонтейнера Из ЗначениеДляКонтейнера Цикл
			НовыйGUID = Новый УникальныйИдентификатор(СтрКонтейнера.Ссылка);
			СсылкаКонтейнер = Справочники.смартКонтейнеры.ПолучитьСсылку(НовыйGUID);
			СписокКонтейнеров.Добавить(СсылкаКонтейнер,,СтрКонтейнера.Пометка);
		КонецЦикла;
	КонецЕсли;	  
	Возврат СписокКонтейнеров;
КонецФункции//--#1374 смарт: Балашов 15.06.2023

//++#1374 смарт: Балашов 13.07.2023 //Разработать учет закупок в разрезе Контейнеров
// надо перенести в смартОбщегоНазначения если его когда нибудь освободят...
&НаСервере
Функция смартИспользуютсяКонтейнеры()
	Результат = ложь;
	Если Не Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика Тогда
		// проверим наличие груза
		Если ЗначениеЗаполнено(Объект.Груз) Тогда 
			СписокКонтейнеров = смартПолучитСписокКонтейнеров(Объект.Груз);
			Если СписокКонтейнеров.Количество() <> 0 Тогда
				Результат = истина;                      
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	          
	Возврат Результат;
КонецФункции//--#1374 смарт: Балашов 13.07.2023	

//++#1374 смарт: Балашов 13.07.2023 //Разработать учет закупок в разрезе Контейнеров
// надо перенести в смартОбщегоНазначения если его когда нибудь освободят...
&НаСервере
Процедура смартПриИзмененииГрузаИКонтейнеров()
	Если смартИспользуютсяКонтейнеры() Тогда
		Для Каждого СтрТовары Из Объект.Товары Цикл
			СтрТовары.смартКонтейнер = "";
			СтрТовары.Контейнеры = "";
		КонецЦикла;	
	КонецЕсли;
    ЭтотОбъект.Модифицированность = истина;
КонецПроцедуры//--#1374 смарт: Балашов 13.07.2023

