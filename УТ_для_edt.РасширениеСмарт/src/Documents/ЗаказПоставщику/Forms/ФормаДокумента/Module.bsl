&НаКлиенте
Процедура ПослеВыбораИзПредзаказов(РезультатВыбора,ДопПараметры)Экспорт 
	Если ТипЗнч(РезультатВыбора)=Тип("Структура") И РезультатВыбора.Свойство("Товары") И РезультатВыбора.Товары.Количество()>0 Тогда
		Если Объект.Партнер=РезультатВыбора.Партнер Тогда 
			Для Каждого Эл Из РезультатВыбора.Товары Цикл
				Стр=Объект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(Стр,Эл);
				ПересчитатьСтроку(Стр);
			КонецЦикла;
			ОтображениеДанныхПоПредзаказам();
			//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
			ЭтаФорма.Модифицированность = Истина;	
			//--#1227 смарт: Лопато 31.10.2022
		Иначе	
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопроса",ЭтотОбъект,РезультатВыбора),"Табличная часть 'Товары' буде очищена
			|Продолжить?",РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопроса(Результат,ДопПараметры) Экспорт 
	Если Результат=КодВозвратаДиалога.Да Тогда
		Если Не ДопПараметры.Партнер=Объект.Партнер Тогда 
			Объект.Партнер=ДопПараметры.Партнер;
			ПартнерПриИзменении(Неопределено);
		КонецЕсли;	
		Объект.Товары.Очистить();
		Для Каждого Эл Из ДопПараметры.Товары Цикл
			Стр=Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Эл);
			ПересчитатьСтроку(Стр);
		КонецЦикла;
		ОтображениеДанныхПоПредзаказам();
		//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
		ЭтаФорма.Модифицированность = Истина;	
		//--#1227 смарт: Лопато 31.10.2022
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОтображениеДанныхПоПредзаказам()
	
	Предзаказы = Объект.Товары.Выгрузить(, "смартПредзаказПоставщику");
	Предзаказы.Свернуть("смартПредзаказПоставщику");
	ПустаяСтр = Предзаказы.Найти(ПредопределенноеЗначение("Документ.смартПредзаказПоставщику.ПустаяСсылка"));  
	
	Если Не ПустаяСтр = Неопределено Тогда 
		Предзаказы.Удалить(ПустаяСтр);
	КонецЕсли;
	
	ЭтаФорма.СписокПредзаказов.ЗагрузитьЗначения(Предзаказы.ВыгрузитьКолонку("смартПредзаказПоставщику"));
	
	ИспользоватьЗаказПоНесколькимПредзаказам = ЭтаФорма.СписокПредзаказов.Количество() > 1;
	
	Объект.ДокументОснование = ?(ИспользоватьЗаказПоНесколькимПредзаказам, Неопределено, Объект.ДокументОснование);
	ЭтаФорма.НадписьДокументыОснования = СтрСоединить(ЭтаФорма.СписокПредзаказов.ВыгрузитьЗначения(), ", ");

	//Элементы.ТоварысмартПредзаказПоставщику.Видимость=ИспользоватьЗаказПоНесколькимПредзаказам;
	Элементы.ГруппаОснования.Видимость = ИспользоватьЗаказПоНесколькимПредзаказам;
	Элементы.ГруппаОснование.Видимость = Не ИспользоватьЗаказПоНесколькимПредзаказам;
КонецПроцедуры	

