&НаКлиенте
Функция ТЧТоварыЗаполненаКорректно(ТчТовары)
	
	ТЧЗаполненаКорректно = Истина;
	
	ТЧТоварыЗаполненаКорректноНаСервере(ТчТовары);
	
	Возврат ТЧЗаполненаКорректно;
	
КонецФункции

&НаСервере
Функция ТЧТоварыЗаполненаКорректноНаСервере(ТчТовары)

	Для Каждого Строка Из ТчТовары Цикл
		Если НоменклатураВРулонахПоХарактеристикам(Строка.Номенклатура) 
			И УпаковкаСоответствуетЕдиницеИзмерения(Строка.Номенклатура, Строка.Упаковка) Тогда
			Если Не ПроверитьПравильностьЗаполненияКоличестваВСтроке(Строка) Тогда
				ТЧЗаполненаКорректно = Ложь;
				ВывестиСообщениеОбОшибкеПользователю(Строка.НомерСтроки);				
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;

	Возврат ТЧЗаполненаКорректно;
	
КонецФункции // ТЧТоварыЗаполненаКорректноНаСервере()

&НаСервере
Функция ПроверитьПравильностьЗаполненияКоличестваВСтроке(ИД)
	Строка=Объект.Товары.НайтиПоИдентификатору(ИД);
	Намотка = СтрокуВЧисло(Строка.Характеристика);
	КоличествоКОтгрузке = Строка.Количество;
	
	Если Не УпаковкаСоответствуетЕдиницеИзмерения(Строка.Номенклатура, Строка.Упаковка) Тогда
		Возврат Истина;
	Иначе
		Возврат ОтгрузкаВРулонахКратнаНамотке(Намотка, КоличествоКОтгрузке);
	КонецЕсли;
	
КонецФункции

Процедура ВывестиСообщениеОбОшибкеПользователю(НомерСтроки);
	
	ТекстСообщения = "Строка №" + НомерСтроки + Символы.ПС
								+ "Количество погонных метров должно быть кратно намотке рулона!" + Символы.ПС
								+ "Укажите другое количество погонных метров.";
		
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				,,,); 
	
КонецПроцедуры	

&НаСервере
Функция ОтгрузкаВРулонахКратнаНамотке(Намотка, КоличествоКОтгрузке)
	
	Возврат (КоличествоКОтгрузке%Намотка) = 0;
	
КонецФункции

&НаСервере
Функция УпаковкаСоответствуетЕдиницеИзмерения(Номенклатура, Упаковка)
	
	ЕдиницаХранения = Номенклатура.ЕдиницаИзмерения;
	
	Возврат ЕдиницаХранения = Упаковка;
	
КонецФункции

