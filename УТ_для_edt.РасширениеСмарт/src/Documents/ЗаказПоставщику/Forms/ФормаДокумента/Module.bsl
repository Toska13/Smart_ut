
#Область ПеренесеноСДоработками

// Фролов+
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	НовКнопка=ЭтаФорма.Элементы.Добавить("НеОтгруженныеТовары",Тип("КнопкаФормы"),Элементы.ПодменюОтчетыСмТакже);
	НовКнопка.ИмяКоманды="НеОтгруженныеТоварыПоставщика";
	НовКнопка=ЭтаФорма.Элементы.Добавить("СоставГруза",Тип("КнопкаФормы"),Элементы.ПодменюОтчетыСмТакже);
	НовКнопка.ИмяКоманды="СоставГруза";
	
	ОтображениеДанныхПоПредзаказам();
	
	ДоступностьЭлементаГруз();
	
	//++ смарт:ММ #006 144 04.12.2019
	НастроитьВидимостьДоступностьЭлементов();
	//-- смарт:ММ 04.12.2019
	//++ смарт:ММ #092 389 17.01.2021 - Конструктор оборудования
	ДобавитьЭлементыПрограммно();
	//-- смарт:ММ 17.01.2021
	
	//++ #Б7206 смарт: Шляпников 30.06.2026 / Реквизит Повышенный таможенный сбор в документах Предзаказ поставщику и Заказ поставщику. Доработка.
	УстановитьУсловноеОформлениеПовышенногоТаможенногоСбора();
	//-- #Б7206 смарт: Шляпников 30.06.2026
	
КонецПроцедуры

&НаКлиенте
Процедура смарт_ТоварыПриОкончанииРедактированияПосле(Элемент, НоваяСтрока, ОтменаРедактирования)	
	ОтображениеДанныхПоПредзаказам();
КонецПроцедуры
// Фролов-

&НаКлиенте
Процедура РасшСмарт_ТоварыКоличествоУпаковокПриИзмененииПеред(Элемент)
	
	Строка = Элементы.Товары.ТекущиеДанные;
	
	Если НоменклатураВРулонахПоХарактеристикам(Строка.Номенклатура) Тогда		
		Если Не ПроверитьПравильностьЗаполненияКоличестваВСтроке(Строка.ПолучитьИдентификатор()) Тогда 			
			ВывестиСообщениеОбОшибкеПользователю(Строка.НомерСтроки);	
		КонецЕсли;			
	КонецЕсли;
	// Фролов+
	Если ЗначениеЗаполнено(Строка.смартПредзаказПоставщику) Тогда
		Данные=Новый Структура("ПредзаказПоставщику,Номенклатура,Характеристика,Требуется,Заказано",
			   Строка.смартПредзаказПоставщику,Строка.Номенклатура,Строка.Характеристика,Строка.КоличествоУпаковок,ТоварыКешТекущейСтроки.КоличествоУпаковок);
		ДанныеПоПредзаказу=ПревышеноКоличествПоПредзаказу(Данные);
		Если ДанныеПоПредзаказу.Превышено Тогда
			Строка.КоличествоУпаковок=Макс(ДанныеПоПредзаказу.Остаток,ТоварыКешТекущейСтроки.КоличествоУпаковок);
			ПересчитатьСтроку(Строка);
			
			Стр=Объект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(Стр,Строка,"НоменклатураПартнера,Номенклатура,Характеристика,ВидЦеныПоставщика,СтавкаНДС,Цена");
			Стр.КоличествоУпаковок=Данные.Требуется-Строка.КоличествоУпаковок;
			ПересчитатьСтроку(Стр);
		КонецЕсли;	
	КонецЕсли;
	//РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	// Фролов-
КонецПроцедуры

&НаКлиенте
Процедура РасшСмарт_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	
	Если Не ТЧТоварыЗаполненаКорректно(Объект.Товары) Тогда  
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смарт_ТоварыВыборПосле(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если смартИспользуютсяКонтейнеры() Тогда
		Если Поле.ГиперссылкаЯчейки и Поле.Имя = "Контейнеры" Тогда
			СтандартнаяОбработка = Ложь;              
			ТекДанные = Элементы.Товары.ТекущиеДанные;
			ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(ТекДанные.смартКонтейнер);
			СписокКонтейнеров = смартЗаполнитьСписокНаСервере(ЗначениеДляКонтейнера);
			смартОткрытьФормуВыбораКонтейнеров(СписокКонтейнеров);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смарт_ПриОткрытииПосле(Отказ)
	Если смартИспользуютсяКонтейнеры() Тогда
		Для Каждого СтрТовары Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(СтрТовары.смартКонтейнер) Тогда
				ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрТовары.смартКонтейнер);
				СтрТовары.Контейнеры = смартОбщегоНазначения.смартКонтейнерыВСтроку(ЗначениеДляКонтейнера);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023

//++#1374 смарт: Балашов 15.06.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смарт_ПослеЗаписиПосле(ПараметрыЗаписи)
	
	Для Каждого СтрТовары Из Объект.Товары Цикл
		
		Если ЗначениеЗаполнено(СтрТовары.смартКонтейнер) Тогда
			
			ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(СтрТовары.смартКонтейнер);
			Если СтрТовары.Свойство("Контейнеры") Тогда 
				СтрТовары.Контейнеры = смартОбщегоНазначения.смартКонтейнерыВСтроку(ЗначениеДляКонтейнера);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	//++ #Б3790 смарт: Шляпников 12.08.2025 / Маркировка радиоэлектронной продукции. Доработка документов
	смартМаркировкаКлиент.ВывестиПредупреждениеОНаличииТоваровСМаркировкой(Объект);
	//-- #Б3790 смарт: Шляпников 12.08.2025
	
	//++ #Б6778 смарт: Шляпников 04.05.2026 / Маркировка товара. Экспериментальный режим маркировки.
	смартМаркировкаКлиент.ВывестиСообщениеОНаличииТоваровСЭкспериментальнойМаркировкой(Объект);
	//-- #Б6778 смарт: Шляпников 04.05.2026
	
	//++ #Б6822 смарт: Шляпников 26.05.2026 / Маркировка. Приемка товара в 1С УТ РФ.
	смартМаркировкаКлиент.ВывестиСообщениеОНаличииТоваровСОбязательнойМаркировкой(Объект);
	//-- #Б6822 смарт: Шляпников 26.05.2026

	//++ #Б6948 смарт: Шляпников 11.06.2026 / Маркировка. Алгоритм действий системы и БП при заказе нового товара при наличии остатков на складах.
	смартМаркировкаКлиент.ВывестиСообщениеОБудущейМаркировкеНоменклатурыПоДокументу(Объект);
	//-- #Б6948 смарт: Шляпников 11.06.2026

	//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	//-- #Б6794 смарт: Шляпников 07.05.2026
	
КонецПроцедуры//--#1374 смарт: Балашов 15.06.2023

//++#1374 смарт: Балашов 04.07.2023 //Разработать учет закупок в разрезе Контейнеров
&НаКлиенте
Процедура смарт_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеДанныхПТУ" Тогда
		
		ЭтотОбъект.Прочитать();
		СписокСтрок = Объект.Товары;
		
		Для Каждого Строка_ТЧ Из СписокСтрок Цикл
			
			ЗначениеДляКонтейнера = смартОбщегоНазначения.смартПолучитьМассивКонтейнеров(Строка_ТЧ.смартКонтейнер);
			//++ исправлен в рабочей базе Балашов 27.07.2023
			Если Строка_ТЧ.Свойство("Контейнеры") Тогда
				Строка_ТЧ.Контейнеры  = смартОбщегоНазначения.смартКонтейнерыВСтроку(ЗначениеДляКонтейнера);
			КонецЕсли;	
			//-- исправлен в рабочей базе Балашов 27.07.2023
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры
