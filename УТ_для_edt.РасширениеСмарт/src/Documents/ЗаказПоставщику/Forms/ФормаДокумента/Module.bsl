&НаСервереБезКонтекста
Функция ПревышеноКоличествПоПредзаказу(Данные)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("ПредзаказПоставщику",Данные.ПредзаказПоставщику);
	Запрос.УстановитьПараметр("Номенклатура",Данные.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Данные.Характеристика);
	Запрос.УстановитьПараметр("Требуется",Данные.Требуется);
	Запрос.УстановитьПараметр("Заказано",Данные.Заказано);
	
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	             |	ЕСТЬNULL(смартПредзаказыПоставщикамОстатки.ЗаказаноОстаток, 0) + ЕСТЬNULL(смартПредзаказыПоставщикамОбороты.ЗаказаноРасход, 0) < &Требуется КАК Превышено,
	             |	ЕСТЬNULL(смартПредзаказыПоставщикамОстатки.ЗаказаноОстаток, 0) + ЕСТЬNULL(смартПредзаказыПоставщикамОбороты.ЗаказаноРасход, 0) КАК Остаток
	             |ИЗ
	             |	РегистрНакопления.смартПредзаказыПоставщикам.Остатки(
	             |			,
	             |			ПредзаказПоставщику = &ПредзаказПоставщику
	             |				И Номенклатура = &Номенклатура
	             |				И Характеристика = &Характеристика) КАК смартПредзаказыПоставщикамОстатки
	             |		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.смартПредзаказыПоставщикам.Обороты(
	             |				,
	             |				,
	             |				,
	             |				ПредзаказПоставщику = &ПредзаказПоставщику
	             |					И Номенклатура = &Номенклатура
	             |					И Характеристика = &Характеристика) КАК смартПредзаказыПоставщикамОбороты
	             |		ПО (смартПредзаказыПоставщикамОбороты.ПредзаказПоставщику = смартПредзаказыПоставщикамОстатки.ПредзаказПоставщику)
	             |			И (смартПредзаказыПоставщикамОбороты.Номенклатура = смартПредзаказыПоставщикамОстатки.Номенклатура)
	             |			И (смартПредзаказыПоставщикамОбороты.Характеристика = смартПредзаказыПоставщикамОстатки.Характеристика)";
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() И Рез.Превышено Тогда 
		Возврат Новый Структура("Превышено,Остаток",Истина,Рез.Остаток);
	КонецЕсли;	
	Возврат Новый Структура("Превышено",Ложь);
КонецФункции

