
#Область СобытияФормыИЭлементовФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Партнер=Параметры.Партнер;
	ОбновитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Развернуть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПартнерПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Партнер) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен 'Партнер'",,"Партнет");
		Возврат;
	КонецЕсли;	
	ОбновитьТаблицуНаСервере();
	Развернуть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоПредзаказамВыбратьПриИзменении(Элемент)
	Стр=Элементы.ОстаткиПоПредзаказам.ТекущиеДанные;
	Если Стр.Выбрано>Стр.ВсегоДоступно Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Доступно для выбора: "+Стр.ВсегоДоступно,,"ОстаткиПоПредзаказам["+Формат(Стр.ПолучитьИдентификатор(),"ЧГ=")+"]."+Элемент.Имя,);
		Возврат;
	КонецЕсли;	
	//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	//Стр.Выб=Истина;
	Стр.Выб = Стр.Выбрано > 0;
	//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Свернуть(Команда)
	Для Каждого Стр Из ОстаткиПоПредзаказам.ПолучитьЭлементы() Цикл 
		Элементы.ОстаткиПоПредзаказам.Свернуть(Стр.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Развернуть(Команда)
	Для Каждого Стр Из ОстаткиПоПредзаказам.ПолучитьЭлементы() Цикл 
		Элементы.ОстаткиПоПредзаказам.Развернуть(Стр.ПолучитьИдентификатор(),Истина);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВЗаказ(Команда)
	Закрыть(Новый Структура("Партнер,Товары",Партнер,ПолучитьДанныеДляПереносаВЗаказ()));
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВЗаказВыделенныеСтроки(Команда)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	Закрыть(Новый Структура("Партнер,Товары",Партнер,ПолучитьДанныеДляПереносаВЗаказВыделенныеСтроки()));
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВЗаказПредзаказы(Команда)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	Закрыть(Новый Структура("Партнер,Товары",Партнер,ПолучитьДанныеДляПереносаВЗаказПредзаказы()));
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаКлиенте
Процедура СвернутьКопия(Команда)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	Для Каждого Стр Из ОстаткиПоПредзаказамКопия.ПолучитьЭлементы() Цикл 
		Элементы.ОстаткиПоПредзаказамКопия.Свернуть(Стр.ПолучитьИдентификатор());
	КонецЦикла;
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьКопия(Команда)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	Для Каждого Стр Из ОстаткиПоПредзаказамКопия.ПолучитьЭлементы() Цикл 
		Элементы.ОстаткиПоПредзаказамКопия.Развернуть(Стр.ПолучитьИдентификатор(),Истина);
	КонецЦикла;	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыФункции

&НаСервере
Процедура ОбновитьТаблицуНаСервере()	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Партнер",Партнер);
	Запрос.Текст="ВЫБРАТЬ
	             |	смартПредзаказыПоставщикамОстатки.Номенклатура КАК Номенклатура,
	             |	смартПредзаказыПоставщикамОстатки.Характеристика КАК Характеристика,
	             |	смартПредзаказыПоставщикамОстатки.ПредзаказПоставщику КАК ПредзаказПоставщику,
				 //++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	             |	ПРЕДСТАВЛЕНИЕ(смартПредзаказыПоставщикамОстатки.Номенклатура) КАК ПредставлениеНоменклатура,
	             |	смартПредзаказыПоставщикамОстатки.ПредзаказПоставщику.Менеджер КАК МенеджерПредзаказ,
	             |	ИСТИНА КАК ПризнакСтроки,
				 //--#1227 смарт: Лопато 31.10.2022
	             |	смартПредзаказПоставщикуТовары.Цена КАК Цена,
	             |	смартПредзаказПоставщикуТовары.ВидЦеныПоставщика КАК ВидЦеныПоставщика,
	             |	смартПредзаказПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
	             |	смартПредзаказПоставщикуТовары.КоличествоУпаковок КАК ВсегоВПредзаказе,
	             |	смартПредзаказПоставщикуТовары.КоличествоУпаковок - смартПредзаказыПоставщикамОстатки.ЗаказаноОстаток КАК ВсегоВыкуплено,
	             |	смартПредзаказыПоставщикамОстатки.ЗаказаноОстаток КАК ВсегоДоступно,
	             |	ЛОЖЬ КАК Выб,
	             |	0 КАК Выбрано
	             |ИЗ
	             |	РегистрНакопления.смартПредзаказыПоставщикам.Остатки(, Партнер = &Партнер) КАК смартПредзаказыПоставщикамОстатки
	             |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.смартПредзаказПоставщику.Товары КАК смартПредзаказПоставщикуТовары
	             |		ПО смартПредзаказыПоставщикамОстатки.Партнер = смартПредзаказПоставщикуТовары.Ссылка.Партнер
	             |			И смартПредзаказыПоставщикамОстатки.ПредзаказПоставщику = смартПредзаказПоставщикуТовары.Ссылка.Ссылка
	             |			И смартПредзаказыПоставщикамОстатки.Номенклатура = смартПредзаказПоставщикуТовары.Номенклатура
	             |			И смартПредзаказыПоставщикамОстатки.Характеристика = смартПредзаказПоставщикуТовары.Характеристика
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	смартПредзаказыПоставщикамОстатки.ПредзаказПоставщику.Дата
	             |ИТОГИ
	             |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПредзаказПоставщику),
	             |	СУММА(ВсегоВПредзаказе),
	             |	СУММА(ВсегоВыкуплено),
	             |	СУММА(ВсегоДоступно)
	             |ПО
	             |	Номенклатура";
				 
	//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам           
	РезультатЗапроса = Запрос.Выполнить();
	
	ЗначениеВРеквизитФормы(РезультатЗапроса.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам), "ОстаткиПоПредзаказам");
	
	Элементы.МенеджерПредзаказ.СписокВыбора.Очистить();
	ТаблицаМенеджеров = РезультатЗапроса.Выгрузить();
	ТаблицаМенеджеров.Свернуть("МенеджерПредзаказ");
	Элементы.МенеджерПредзаказ.СписокВыбора.ЗагрузитьЗначения(ТаблицаМенеджеров.ВыгрузитьКолонку("МенеджерПредзаказ"));
	Элементы.МенеджерПредзаказ.СписокВыбора.СортироватьПоПредставлению();
	
	Если Элементы.МенеджерПредзаказ.СписокВыбора.Количество() > 0 И Элементы.МенеджерПредзаказ.СписокВыбора[0].Представление = "" Тогда
		Элементы.МенеджерПредзаказ.СписокВыбора.Удалить(0);
	КонецЕсли;	
	//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры	

&НаСервере
Функция ПолучитьДанныеДляПереносаВЗаказ()
	//++#1227 смарт: Лопато 07.11.2022 //Групповое заполнение Заказа поставщику по предзаказам
	Если Элементы.ПрименитьОтбор.Заголовок = "Отменить отбор" Тогда
		ОтменитьОтбор();
	КонецЕсли;	
	//--#1227 смарт: Лопато 31.10.2022
	тДерево = РеквизитФормыВЗначение("ОстаткиПоПредзаказам");
	МассивСтрок=тДерево.Строки.НайтиСтроки(Новый Структура("Выб",Истина),Истина);
	МассивВыбора=Новый Массив;
	Для Каждого Стр Из МассивСтрок Цикл 
		МассивВыбора.Добавить(Новый Структура("Номенклатура,Характеристика,КоличествоУпаковок,Цена,ВидЦеныПоставщика,СтавкаНДС,смартПредзаказПоставщику",
		Стр.Номенклатура,
		Стр.Характеристика,
		Стр.Выбрано,
		Стр.Цена,
		Стр.ВидЦеныПоставщика,
		Стр.СтавкаНДС,
		Стр.ПредзаказПоставщику));
	КонецЦикла;
	Возврат МассивВыбора;
КонецФункции	

&НаКлиенте
Процедура ОстаткиПоПредзаказамПредзаказПоставщикуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоПредзаказамПредзаказПоставщикуНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеДляПереносаВЗаказВыделенныеСтроки()
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам

	МассивВыбора = Новый Массив;

	Если Элементы.ОстаткиПоПредзаказам.Видимость Тогда
		МассивСтрок = Элементы.ОстаткиПоПредзаказам.ВыделенныеСтроки;
	ИначеЕсли Элементы.ОстаткиПоПредзаказамКопия.Видимость Тогда
		МассивСтрок = Элементы.ОстаткиПоПредзаказамКопия.ВыделенныеСтроки;
	Иначе
		Возврат МассивВыбора;
	КонецЕсли;	
	
	Для Каждого ИдентификаторСтроки Из МассивСтрок Цикл 
		
		Если Элементы.ОстаткиПоПредзаказам.Видимость Тогда
	 		Стр = ОстаткиПоПредзаказам.НайтиПоИдентификатору(ИдентификаторСтроки);
		ИначеЕсли Элементы.ОстаткиПоПредзаказамКопия.Видимость Тогда
	 		Стр = ОстаткиПоПредзаказамКопия.НайтиПоИдентификатору(ИдентификаторСтроки);
		КонецЕсли;	
		
		МассивВыбора.Добавить(Новый Структура("Номенклатура,Характеристика,КоличествоУпаковок,Цена,ВидЦеныПоставщика,СтавкаНДС,смартПредзаказПоставщику",
		Стр.Номенклатура,
		Стр.Характеристика,
		Стр.ВсегоДоступно,
		Стр.Цена,
		Стр.ВидЦеныПоставщика,
		Стр.СтавкаНДС,
		Стр.ПредзаказПоставщику));
		
	КонецЦикла;
	
	Возврат МассивВыбора;
	
//--#1227 смарт: Лопато 31.10.2022
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляПереносаВЗаказПредзаказы()
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам

	МассивВыбора = Новый Массив;

	Если Элементы.ОстаткиПоПредзаказам.Видимость Тогда
		МассивСтрок = Элементы.ОстаткиПоПредзаказам.ВыделенныеСтроки;
	ИначеЕсли Элементы.ОстаткиПоПредзаказамКопия.Видимость Тогда
		МассивСтрок = Элементы.ОстаткиПоПредзаказамКопия.ВыделенныеСтроки;
	Иначе
		Возврат МассивВыбора;
	КонецЕсли;	
	
	МассивПредзаказов = Новый Массив;

	Для Каждого ИдентификаторСтроки Из МассивСтрок Цикл 
		
		Если Элементы.ОстаткиПоПредзаказам.Видимость Тогда
			Стр = ОстаткиПоПредзаказам.НайтиПоИдентификатору(ИдентификаторСтроки);
		ИначеЕсли Элементы.ОстаткиПоПредзаказамКопия.Видимость Тогда
			Стр = ОстаткиПоПредзаказамКопия.НайтиПоИдентификатору(ИдентификаторСтроки);
		Иначе
			Прервать;
		КонецЕсли;	
		
		Если МассивПредзаказов.Найти(Стр.ПредзаказПоставщику) = Неопределено Тогда
			МассивПредзаказов.Добавить(Стр.ПредзаказПоставщику);
		КонецЕсли;
		
	КонецЦикла;	
		
	Если Элементы.ОстаткиПоПредзаказам.Видимость Тогда
		тДерево = РеквизитФормыВЗначение("ОстаткиПоПредзаказам");
	ИначеЕсли Элементы.ОстаткиПоПредзаказамКопия.Видимость Тогда
		тДерево = РеквизитФормыВЗначение("ОстаткиПоПредзаказамКопия");
	Иначе
		Возврат МассивВыбора;
	КонецЕсли;	

	Для каждого ЭлементПредзаказ Из МассивПредзаказов Цикл
		
		ОтборПредзаказ = Новый Структура("ПредзаказПоставщику", ЭлементПредзаказ);
		
		НайденныеСтроки = тДерево.Строки.НайтиСтроки(ОтборПредзаказ, Истина);	
		
		Для Каждого Стр Из НайденныеСтроки Цикл
			
			МассивВыбора.Добавить(Новый Структура("Номенклатура,Характеристика,КоличествоУпаковок,Цена,ВидЦеныПоставщика,СтавкаНДС,смартПредзаказПоставщику",
			Стр.Номенклатура,
			Стр.Характеристика,
			Стр.ВсегоДоступно,
			Стр.Цена,
			Стр.ВидЦеныПоставщика,
			Стр.СтавкаНДС,
			Стр.ПредзаказПоставщику));
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат МассивВыбора;
	
//--#1227 смарт: Лопато 31.10.2022
КонецФункции

&НаКлиенте
Процедура УстановитьОтбор(Команда)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	
	Если Элементы.ПрименитьОтбор.Заголовок = "Применить отбор" Тогда
		ПрименитьОтбор();
	Иначе
		ОтменитьОтбор();
	КонецЕсли;	
	
	УстановитьВидимостьОтбора();
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтбор()
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	
	ДеревоИсточник = РеквизитФормыВЗначение("ОстаткиПоПредзаказам");
	ДеревоКопия = ДеревоИсточник.Скопировать();
	
	КолонкиКопия = ДеревоКопия.Колонки;
	КолонкиКопия.Добавить("Индекс");
	КолонкиКопия.Добавить("ИндексРодитель");
	
	СтрокиНоменклатураКУдалению = Новый Массив;
	
	СтрокиНоменклатура = ДеревоКопия.Строки;

	Для Каждого ТекСтрНоменклатура Из СтрокиНоменклатура Цикл
		
		ТекСтрНоменклатура.Индекс = СтрокиНоменклатура.Индекс(ТекСтрНоменклатура);
		
		СтрокиЗаказ = ТекСтрНоменклатура.Строки;
		Для Каждого ТекСтрЗаказ Из СтрокиЗаказ Цикл
            ТекСтрЗаказ.Индекс = СтрокиЗаказ.Индекс(ТекСтрЗаказ);
			ТекСтрЗаказ.ИндексРодитель = ТекСтрНоменклатура.Индекс; 
		КонецЦикла;	
		
		НоменклатураСоответствуетОтбору = Истина;
		
		Если ЗначениеЗаполнено(СтрокаПоискаНоменклатура) Тогда
			
			НоменклатураНаименование = СокрЛП(НРег(ТекСтрНоменклатура.ПредставлениеНоменклатура));

			Если СтрНайти(НоменклатураНаименование, СокрЛП(НРег(СтрокаПоискаНоменклатура))) = 0 Тогда

				НоменклатураСоответствуетОтбору = Ложь;
				СтрокиНоменклатураКУдалению.Добавить(ТекСтрНоменклатура.Индекс);
				
			КонецЕсли;
			
		КонецЕсли;	
				
		Если НоменклатураСоответствуетОтбору И ЗначениеЗаполнено(МенеджерПредзаказ) Тогда
			
			СтрокиЗаказКУдалению = Новый Массив;
			
			СтрокиЗаказ = ТекСтрНоменклатура.Строки;
			Для Каждого ТекСтрЗаказ Из СтрокиЗаказ Цикл
				Если ТекСтрЗаказ.МенеджерПредзаказ <> МенеджерПредзаказ Тогда
					СтрокиЗаказКУдалению.Добавить(СтрокиЗаказ.Индекс(ТекСтрЗаказ));
				КонецЕсли;	                                                 
			КонецЦикла;	

			ТекущийИндекс = СтрокиЗаказКУдалению.ВГраница();
			Пока ТекущийИндекс >= 0 Цикл
				СтрокиЗаказ.Удалить(СтрокиЗаказКУдалению[ТекущийИндекс]);
				ТекущийИндекс = ТекущийИндекс - 1;
			КонецЦикла;

			Если СтрокиЗаказ.Количество() = 0 Тогда
				СтрокиНоменклатураКУдалению.Добавить(ТекСтрНоменклатура.Индекс);
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	ТекущийИндекс = СтрокиНоменклатураКУдалению.ВГраница();
	Пока ТекущийИндекс >= 0 Цикл
		СтрокиНоменклатура.Удалить(СтрокиНоменклатураКУдалению[ТекущийИндекс]);
		ТекущийИндекс = ТекущийИндекс - 1;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоКопия, "ОстаткиПоПредзаказамКопия");	
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаСервере
Процедура ОтменитьОтбор()
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	
	ДеревоИсточник = РеквизитФормыВЗначение("ОстаткиПоПредзаказам");
	ДеревоКопия = РеквизитФормыВЗначение("ОстаткиПоПредзаказамКопия");
	
	Для Каждого ТекСтрНоменклатураКопия Из ДеревоКопия.Строки Цикл
		
		Для Каждого ТекСтрЗаказКопия Из ТекСтрНоменклатураКопия.Строки Цикл

			СтрокаНоменклатураИсточник = ДеревоИсточник.Строки[ТекСтрЗаказКопия.ИндексРодитель];
			
			СтрокаЗаказИсточник = СтрокаНоменклатураИсточник.Строки[ТекСтрЗаказКопия.Индекс];
			
			СтрокаЗаказИсточник.Выбрано = ТекСтрЗаказКопия.Выбрано;
			СтрокаЗаказИсточник.Выб = ТекСтрЗаказКопия.Выб;
			СтрокаЗаказИсточник.Цена = ТекСтрЗаказКопия.Цена;
			
		КонецЦикла;
			
	КонецЦикла;

	ЗначениеВРеквизитФормы(ДеревоИсточник, "ОстаткиПоПредзаказам");	
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьОтбора()
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	
	ЭтоПрименитьОтбор = Элементы.ПрименитьОтбор.Заголовок = "Применить отбор";
	
	Элементы.СтрокаПоискаНоменклатура.Доступность = НЕ ЭтоПрименитьОтбор;
	Элементы.МенеджерПредзаказ.Доступность = НЕ ЭтоПрименитьОтбор;
	
	Элементы.ОстаткиПоПредзаказам.Видимость = НЕ ЭтоПрименитьОтбор;
	Элементы.ОстаткиПоПредзаказамКопия.Видимость = ЭтоПрименитьОтбор;
		
	Если ЭтоПрименитьОтбор Тогда
		Элементы.ПрименитьОтбор.Заголовок = "Отменить отбор";
	Иначе
		Элементы.ПрименитьОтбор.Заголовок = "Применить отбор";
	КонецЕсли;	
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиПоПредзаказамКопияВыбратьПриИзменении(Элемент)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам

	Стр = Элементы.ОстаткиПоПредзаказамКопия.ТекущиеДанные;

	Если Стр.Выбрано > Стр.ВсегоДоступно Тогда 
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Доступно для выбора: " + Стр.ВсегоДоступно, , "ОстаткиПоПредзаказам[" + 
														   Формат(Стр.ПолучитьИдентификатор(),"ЧГ=")+"]." + Элемент.Имя,);
		Возврат;
		
	КонецЕсли;	
	
	Стр.Выб = Стр.Выбрано > 0;
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаНоменклатураПриИзменении(Элемент)
//++#1227 смарт: Лопато 31.10.2022 //Групповое заполнение Заказа поставщику по предзаказам
	
	Если ЗначениеЗаполнено(СтрокаПоискаНоменклатура) И Элементы.ПрименитьОтбор.Заголовок = "Применить отбор" Тогда
		УстановитьОтбор(Неопределено);
	КонецЕсли;	
	
//--#1227 смарт: Лопато 31.10.2022
КонецПроцедуры

#КонецОбласти