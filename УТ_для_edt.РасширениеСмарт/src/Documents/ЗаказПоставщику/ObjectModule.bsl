	Если ЭтоНовый() Тогда  
		
		//--#1298 смарт: Лопато 09.01.2023
		смартУстановкаРС();
		//++#1298 смарт: Лопато 09.01.2023 //Нет возможности поменять р/с в Заказе клиента  
		
