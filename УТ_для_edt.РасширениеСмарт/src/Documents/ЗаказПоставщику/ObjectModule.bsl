//++ #1333 смарт: Фролов 28.03.2023 //Перестал работать контроль остатков резерва к дате (по задаче 327)  
Функция смартПроверитьВозникновениеОтрицательныхОстатков(смартТаблицаДляПроверкиОтрицательныхОстатков,Отказ,ПриПроведении=Ложь)
	Запрос=Новый Запрос;	
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|			ВходящиеДанные.Номенклатура КАК Номенклатура,
	|			ВходящиеДанные.Характеристика КАК Характеристика,
	|			ВходящиеДанные.Склад КАК Склад,
	|			ВходящиеДанные.Количество КАК Количество
	|		ПОМЕСТИТЬ ВТТовары
	|		ИЗ
	|			&ВТДанные КАК ВходящиеДанные
	|		;
    |
	|		////////////////////////////////////////////////////////////////////////////////
	|		ВЫБРАТЬ
	|			Набор.Номенклатура КАК Номенклатура,
	|			Набор.Характеристика КАК Характеристика,
	|			Набор.Склад КАК Склад,
	|			СУММА(Набор.Количество) КАК Количество
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ГрафикПоступленияТоваровОбороты.Номенклатура КАК Номенклатура,
	|				ГрафикПоступленияТоваровОбороты.Характеристика КАК Характеристика,
	|				ГрафикПоступленияТоваровОбороты.Склад КАК Склад,
	|				СУММА(ГрафикПоступленияТоваровОбороты.КоличествоИзЗаказовПриход) КАК Количество
	|			ИЗ
	|				РегистрНакопления.ГрафикПоступленияТоваров.Обороты(
	|						,
	|						,
	|						Регистратор,
	|						(Номенклатура, Характеристика, Склад) В
	|							(ВЫБРАТЬ
	|								Отбор.Номенклатура КАК Номенклатура,
	|								Отбор.Характеристика КАК Характеристика,
	|								Отбор.Склад КАК Склад
	|							ИЗ
	|								ВтТовары КАК Отбор)) КАК ГрафикПоступленияТоваровОбороты
	|			ГДЕ
	|				НЕ ГрафикПоступленияТоваровОбороты.Регистратор = &Регистратор
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ГрафикПоступленияТоваровОбороты.Номенклатура,
	|				ГрафикПоступленияТоваровОбороты.Характеристика,
	|				ГрафикПоступленияТоваровОбороты.Склад
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ГрафикОтгрузкиТоваровОбороты.Номенклатура,
	|				ГрафикОтгрузкиТоваровОбороты.Характеристика,
	|				ГрафикОтгрузкиТоваровОбороты.Склад,
	|				СУММА(-1 * ГрафикОтгрузкиТоваровОбороты.КоличествоИзЗаказовПриход)
	|			ИЗ
	|				РегистрНакопления.ГрафикОтгрузкиТоваров.Обороты(
	|						,
	|						,
	|						Регистратор,
	|						(Номенклатура, Характеристика, Склад) В
	|							(ВЫБРАТЬ
	|								Отбор.Номенклатура КАК Номенклатура,
	|								Отбор.Характеристика КАК Характеристика,
	|								Отбор.Склад КАК Склад
	|							ИЗ
	|								ВтТовары КАК Отбор)) КАК ГрафикОтгрузкиТоваровОбороты
	|			ГДЕ
	|				НЕ ГрафикОтгрузкиТоваровОбороты.Регистратор = &Регистратор
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ГрафикОтгрузкиТоваровОбороты.Номенклатура,
	|				ГрафикОтгрузкиТоваровОбороты.Склад,
	|				ГрафикОтгрузкиТоваровОбороты.Характеристика
	|			
	|			ОБЪЕДИНИТЬ ВСЕ
	|			
	|			ВЫБРАТЬ
	|				ВТТовары.Номенклатура,
	|				ВТТовары.Характеристика,
	|				ВТТовары.Склад,
	|				СУММА(ВТТовары.Количество)
	|			ИЗ
	|				ВТТовары КАК ВТТовары
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ВТТовары.Номенклатура,
	|				ВТТовары.Склад,
	|				ВТТовары.Характеристика) КАК Набор
    |
	|		СГРУППИРОВАТЬ ПО
	|			Набор.Номенклатура,
	|			Набор.Характеристика,
	|			Набор.Склад
	|		ИМЕЮЩИЕ
	|		СУММА(Набор.Количество) < 0";
	Запрос.УстановитьПараметр("Регистратор",Этотобъект.Ссылка);

	смартТаблицаДляПроверкиОтрицательныхОстатков.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой)));
	Для Каждого Стр Из смартТаблицаДляПроверкиОтрицательныхОстатков Цикл 
		Количество=0;
		Если ПриПроведении Тогда
			СтрокиТовары=ЭтотОбъект.Товары.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));	
			Для Каждого СтрТовары Из СтрокиТовары Цикл
				Если НЕ СтрТовары.Отменено Тогда
					Количество=Количество+СтрТовары.Количество;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		Стр.Количество=Количество;				
	КонецЦикла;	
	
	Запрос.УстановитьПараметр("ВТДанные",смартТаблицаДляПроверкиОтрицательныхОстатков);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда
		Отказ = Истина;
		Если ПриПроведении тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По плану отгрузки товара возникают отрицательные остатки: ");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По плану отгрузки товара возникают отрицательные остатки при отмене проведения / пометке на удаление документа: ");
		КонецЕсли;
		
		Для Каждого Стр Из Рез Цикл
			ТекстОшибки = "По номенклатуре """ + Строка(Стр.Номенклатура) + """";
			Если ЗначениеЗаполнено(Стр.Характеристика) тогда
				ТекстОшибки = ТекстОшибки + "(" + Строка(Стр.Характеристика) + ")";
			КонецЕсли;
			
			ТекстОшибки = ТекстОшибки + " возникает отрицательный остаток " + Формат(Стр.Количество ) + " " + Строка(Стр.Номенклатура.ЕдиницаИзмерения) + " по складу """ + Строка(Стр.Склад) + """";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецЦикла;	
	КонецЕсли;	
КонецФункции //-- #1333 смарт: Фролов 28.03.2023 

//++ #1671 смарт: Мосолов 18.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказПоставщику 
//Богус++
Процедура смарт_ЗаполнитьДокументНаОснованииОтчета(ДанныеЗаполнения) Экспорт
	
	Для Каждого Строка Из ДанныеЗаполнения.ТоварыКЗаказу Цикл
		
		ЗаполнитьЗначенияСвойств(Товары.Добавить(), Строка);
		
	КонецЦикла;
	
	ЗаполнитьУсловияЗакупокПоУмолчанию();
	НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ЭтотОбъект);
	
	СтруктураДействий = Новый Структура;
	// Фролов+
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата", НалогообложениеНДС, Дата));
	// Фролов-
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	ОбработкаТабличнойЧастиСервер.ОбработатьТЧ(Товары, СтруктураДействий, Неопределено);
		
КонецПроцедуры  //Богус-- //-- #1671 смарт: Мосолов 18.03.2024  

