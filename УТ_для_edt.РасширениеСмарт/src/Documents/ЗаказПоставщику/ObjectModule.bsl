//++ #Б2766 смарт: Шляпников 24.03.2025 / Заявка на разборку оборудования. Заказ на перемещение.
Процедура СформироватьЗаказНаПеремещениеПриНеобходимости()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	|	ЗаказПоставщикуТовары.Характеристика КАК Характеристика,
	|	ЗаказПоставщикуТовары.Упаковка КАК Упаковка,
	|	ЗаказПоставщикуТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	|	ЗаказПоставщикуТовары.Количество КАК Количество,
	|	ЗаказПоставщикуТовары.Назначение КАК Назначение,
	|	ЗаказПоставщикуТовары.Ссылка.Склад КАК СкладОтправитель,
	|	смартЗаявкаНаРазборкуОборудования.Склад КАК СкладПолучатель,
	|	&Дата КАК НачалоОтгрузки,
	|	&Дата КАК ОкончаниеПоступления,
	|	смартЗаявкаНаРазборкуОборудования.Ссылка КАК ЗаявкаНаРазборкуОборудования
	|ИЗ
	|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.смартЗаявкаНаРазборкуОборудования КАК смартЗаявкаНаРазборкуОборудования
	|		ПО ЗаказПоставщикуТовары.Назначение.Заказ = смартЗаявкаНаРазборкуОборудования.Ссылка
	|			И ЗаказПоставщикуТовары.Ссылка.Склад <> смартЗаявкаНаРазборкуОборудования.Склад
	|ГДЕ
	|	ЗаказПоставщикуТовары.Ссылка = &Ссылка
	|	И ЗаказПоставщикуТовары.Назначение.смартРазобранноеОборудованиеТипНазначения = ЗНАЧЕНИЕ(Перечисление.смартТипыНазначенийРазобранногоОборудования.НаЗаменуСнятойЗапаснойЧасти)
	|ИТОГИ ПО
	|	ЗаявкаНаРазборкуОборудования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаПеремещение.Ссылка КАК Ссылка,
	|	ЗаказНаПеремещение.ДокументОснование КАК ДокументОснование
	|ИЗ
	|	Документ.ЗаказНаПеремещение КАК ЗаказНаПеремещение
	|ГДЕ
	|	НЕ ЗаказНаПеремещение.ПометкаУдаления
	|	И ЗаказНаПеремещение.смартЗаказПоставщику = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	
	Пакет = Запрос.ВыполнитьПакет();
	
	СтруктураЗаполнения = Новый Структура;
	СтруктураЗаполнения.Вставить("Организация", ЭтотОбъект.Организация);
	СтруктураЗаполнения.Вставить("Подразделение", ЭтотОбъект.Подразделение);
	СтруктураЗаполнения.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураЗаполнения.Вставить("Статус", Перечисления.СтатусыВнутреннихЗаказов.КВыполнению);
	
	ТаблицаСуществующихЗаказов = Пакет[1].Выгрузить();
	
	ВыборкаЗаявкаНаРазборку = Пакет[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	Пока ВыборкаЗаявкаНаРазборку.Следующий() Цикл
		
		СтруктураЗаполнения.Вставить("ДокументОснование", ВыборкаЗаявкаНаРазборку.ЗаявкаНаРазборкуОборудования);
		
		НайденныеСтроки = ТаблицаСуществующихЗаказов.НайтиСтроки(Новый Структура("ДокументОснование", ВыборкаЗаявкаНаРазборку.ЗаявкаНаРазборкуОборудования));
		Если НайденныеСтроки.Количество() = 0 Тогда
			ДокументЗаказ = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		Иначе
			ДокументЗаказ = НайденныеСтроки[0].Ссылка.ПолучитьОбъект();
			ДокументЗаказ.Товары.Очистить();
			ТаблицаСуществующихЗаказов.Удалить(НайденныеСтроки[0]);
		КонецЕсли;
		
		ВыборкаТоваров = ВыборкаЗаявкаНаРазборку.Выбрать();
		
		СтруктураЗаполнения.Вставить("Товары", ДокументЗаказ.Товары.Выгрузить());
		
		Пока ВыборкаТоваров.Следующий() Цикл
		
			СтруктураЗаполнения.Вставить("СкладОтправитель", ВыборкаТоваров.СкладОтправитель);
			СтруктураЗаполнения.Вставить("СкладПолучатель", ВыборкаТоваров.СкладПолучатель);
			
			НоваяСтрокаТовары = СтруктураЗаполнения.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТовары, ВыборкаТоваров);
			НоваяСтрокаТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Обособленно;
			
		КонецЦикла;
		
		ДокументЗаказ.Заполнить(СтруктураЗаполнения);
		ДокументЗаказ.смартЗаказПоставщику = Ссылка;
		ДокументЗаказ.ДокументОснование = ВыборкаЗаявкаНаРазборку.ЗаявкаНаРазборкуОборудования;
		Если НЕ ДокументЗаказ.Ссылка.Пустая() Тогда
			ДокументЗаказ.Дата = ДокументЗаказ.Ссылка.Дата;
		КонецЕсли;
		ДокументЗаказ.Ответственный = ВыборкаЗаявкаНаРазборку.ЗаявкаНаРазборкуОборудования.Ответственный;
		ДокументЗаказ.Комментарий = "#Документ создан автоматически#";
		ДокументЗаказ.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		
	КонецЦикла;
	
	Для каждого стрЗаказ Из ТаблицаСуществующихЗаказов Цикл
		стрЗаказ.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
	КонецЦикла;
	
КонецПроцедуры

