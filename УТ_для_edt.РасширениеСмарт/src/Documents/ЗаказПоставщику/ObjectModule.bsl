Процедура ПроверитьКонтрагентаПоРискам(Отказ)
	
	Если Ссылка.Контрагент.ЮрФизЛицо=Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
		
		//++ смарт:ММ #067 348 03.09.2020 - Исправление ошибки проверки ОП в СПАРК риски
		//ИндексыРисков=СПАРКРиски.ИндексыСПАРККонтрагента(Ссылка.Контрагент);
		
		КонтрагентДляПроверки = Ссылка.Контрагент;
		ВыполнятьПроверку = Истина;
		
		Если Ссылка.Контрагент.ОбособленноеПодразделение Тогда
			
			ГоловнойКонтрагент = Ссылка.Контрагент.ГоловнойКонтрагент;
			
			Если НЕ ГоловнойКонтрагент.смартНеПроверятьРиски
				И ГоловнойКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
				КонтрагентДляПроверки = ГоловнойКонтрагент;
			Иначе
				ВыполнятьПроверку = Ложь;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВыполнятьПроверку Тогда
			
			//ВидКонтрагента из регистра СвойстваКонтрагентовСПАРКРиски
			ВидКонтрагентаДляПроверки = ПредопределенноеЗначение("Перечисление.ВидыКонтрагентовСПАРКРиски.ЮридическоеЛицо"); //по умолчанию
			
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Контрагент", КонтрагентДляПроверки);
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвойстваКонтрагентовСПАРКРиски.ВидКонтрагента КАК ВидКонтрагента
			|ИЗ
			|	РегистрСведений.СвойстваКонтрагентовСПАРКРиски КАК СвойстваКонтрагентовСПАРКРиски
			|ГДЕ
			|	СвойстваКонтрагентовСПАРКРиски.Контрагент = &Контрагент
			|";       
			
			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() тогда
				Выборка = Результат.Выбрать();
				Выборка.Следующий();
				
				ВидКонтрагентаДляПроверки = Выборка.ВидКонтрагента;
			КонецЕсли;

			ИндексыРисков = СПАРКРиски.ИндексыСПАРККонтрагента(КонтрагентДляПроверки, ВидКонтрагентаДляПроверки);
		//-- смарт:ММ 03.09.2020
		
		Если ИндексыРисков.СводныйИндикатор<=0 
			Или ИндексыРисков.СводныйИндикаторГрадация=ПредопределенноеЗначение("Перечисление.ГрадацияИндексовСПАРКРиски.Высокий") Тогда 
			Текст=НСтр("ru = 'Документ не может быть проведен!
			|У контрагента высокая степень риска.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст,,,,Отказ);
		КонецЕсли;
		//++ смарт:ММ #067 348 03.09.2020 - Исправление ошибки проверки ОП в СПАРК риски
		КонецЕсли;
		//-- смарт:ММ 03.09.2020
	КонецЕсли;
КонецПроцедуры
