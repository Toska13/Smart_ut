//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
Функция смартСформироватьТабличныйДокументУПД(ДокСсылка, ИмяФайла, НомерЗадания=Неопределено) Экспорт 
    
    Идентификатор = "УПД";
    ВременнаяКоллекцияДляОднойПечатнойФормы = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(Идентификатор); 
    МассивОбъектов = Новый Массив(); 
    МассивОбъектов.Добавить(ДокСсылка);
    СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
    МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Обработка.ПечатьОбщихФорм");
    ОбъектыПечати = Новый СписокЗначений;
    ПараметрыПечати = Новый Структура("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
    
    ТабДок = Неопределено;  
    
    НомерЗаказа = "";
    Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокСсылка,"ЗаказКлиента") И СтрНайти(ДокСсылка.ЗаказКлиента.Номер,"ОПЦБ-")>0 Тогда
        НомерЗаказа = ДокСсылка.ЗаказКлиента.Номер;
    КонецЕсли;   
    
    МассивСчетФактураВыданный = Новый Массив;
    РезультатАнализа = Документы.СчетФактураВыданный.ПолучитьСчетаФактурыНаПечать(МассивОбъектов);
    ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетФактураВыданный, РезультатАнализа.СчетаФактурыНаПечать, Истина);
    
    Если МассивСчетФактураВыданный.Количество() Тогда
        СчетФактура = МассивСчетФактураВыданный[0];	
        ИмяФайла = "УПД № " + СчетФактура.Номер + " от " + Формат(СчетФактура.Дата, "ДФ='dd MMM yyyy ""г""'") +?(НомерЗаказа = "",""," (по сч. "+НомерЗаказа+")")+ ".pdf";
    КонецЕсли; 

    Если УправлениеПечатью.НужноПечататьМакет(ВременнаяКоллекцияДляОднойПечатнойФормы, "УПД") Тогда 
        ТабДок = МенеджерПечати.СформироватьПечатнуюФормуУПД(СтруктураТипов, ОбъектыПечати, ПараметрыПечати); 
    КонецЕсли;
    
    Если НЕ ТабДок = Неопределено Тогда
        
        ИмяОбласти = ТабДок.НайтиТекст("Руководитель организации
        |или иное уполномоченное лицо").Имя;
        НомерСимвола = СтрНайти(ИмяОбласти, "C");
        НачалоИмени = Лев(ИмяОбласти, НомерСимвола);
        НомерКолонки = Прав(ИмяОбласти, СтрДлина(ИмяОбласти) - НомерСимвола);
        Попытка
            НомерКолонкиРуководитель = Число(НомерКолонки) + 3;
            НомерКолонкиБухгалтер = Число(НомерКолонки) + 9;
            ТабДок.Область(НачалоИмени + НомерКолонкиРуководитель).Текст = "";
            ТабДок.Область(НачалоИмени + НомерКолонкиБухгалтер).Текст = "";
        Исключение
        КонецПопытки;
        
        ИмяОбласти = ТабДок.НайтиТекст("[10]").Имя;
        НомерСимвола = СтрНайти(ИмяОбласти, "C");
        НачалоИмени = Лев(ИмяОбласти, НомерСимвола);
        НомерКолонки = Прав(ИмяОбласти, СтрДлина(ИмяОбласти) - НомерСимвола);
        Попытка
            НомерКолонкиДолжность = Число(НомерКолонки) - 7;
            НомерКолонкиФИО = Число(НомерКолонки) - 1;
            ТабДок.Область(НачалоИмени + НомерКолонкиДолжность).Текст = "";
            ТабДок.Область(НачалоИмени + НомерКолонкиФИО).Текст = "";
        Исключение
        КонецПопытки;
        
        ИмяОбласти = ТабДок.НайтиТекст("[13]").Имя;
        НомерСимвола = СтрНайти(ИмяОбласти, "C");
        НачалоИмени = Лев(ИмяОбласти, НомерСимвола);
        НомерКолонки = Прав(ИмяОбласти, СтрДлина(ИмяОбласти) - НомерСимвола);
        Попытка
            НомерКолонкиДолжность = Число(НомерКолонки) - 7;
            НомерКолонкиФИО = Число(НомерКолонки) - 1;
            ТабДок.Область(НачалоИмени + НомерКолонкиДолжность).Текст = "";
            ТабДок.Область(НачалоИмени + НомерКолонкиФИО).Текст = "";
        Исключение
        КонецПопытки;  
        
        ИмяОбласти = ТабДок.НайтиТекст("Дата отгрузки, передачи (сдачи)").Имя;
        НомерСимвола = СтрНайти(ИмяОбласти, "C");
        НачалоИмени = Лев(ИмяОбласти, НомерСимвола);
        НомерКолонки = Прав(ИмяОбласти, СтрДлина(ИмяОбласти) - НомерСимвола);
        Попытка
            НомерКолонкиУдалить = Число(НомерКолонки) + 3;
            ТабДок.Область(НачалоИмени + НомерКолонкиУдалить).Текст = "";
        Исключение
        КонецПопытки;  	
    КонецЕсли;
    
    Возврат ТабДок;
    
КонецФункции  //-- #1353 смарт: Фролов 04.09.2023 

//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)  
Функция смартСформироватьТабличныйДокументСчетНаОплату(ДокСсылка, ИмяФайла) Экспорт
    
    Счет = ДокСсылка.ЗаказКлиента;
    
    Если НЕ ЗначениеЗаполнено(Счет) ИЛИ НЕ ТипЗнч(Счет) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    Идентификатор = "СчетНаОплату";
    ВременнаяКоллекцияДляОднойПечатнойФормы = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(Идентификатор); 
    МассивОбъектов = Новый Массив(); 
    МассивОбъектов.Добавить(Счет);
    СтруктураТипов = ОбщегоНазначенияУТ.СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
    МенеджерПечати = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Обработка.ПечатьСчетовНаОплату");
    ОбъектыПечати = Новый СписокЗначений;
    ПараметрыПечати = Новый Структура("ДополнитьКомплектВнешнимиПечатнымиФормами", Ложь);
    
    ТабДок = Неопределено;
    
    НомерЗаказа = "";
    
    Если СтрНайти(Счет.Номер,"ОПЦБ-")>0 Тогда
        НомерЗаказа = Счет.Номер;
    КонецЕсли;
    
    ИмяФайла = "Счет № " + Счет.Номер + " от " + Формат(Счет.Дата, "ДФ='dd MMM yyyy ""г""'") +?(НомерЗаказа = "",""," (по сч. "+НомерЗаказа+")")+ ".pdf";

    Если УправлениеПечатью.НужноПечататьМакет(ВременнаяКоллекцияДляОднойПечатнойФормы, "СчетНаОплату") Тогда 
        ТабДок = МенеджерПечати.СформироватьПечатнуюФормуСчетНаОплату(СтруктураТипов, ОбъектыПечати, ПараметрыПечати); 
    КонецЕсли;
    
    Возврат ТабДок;
    
КонецФункции  //-- #1353 смарт: Фролов 04.09.2023  

//++ #1353 смарт: Фролов 04.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП) 
Функция смартСформироватьТабличныйДокументТранспортнаяНакладная(ДокСсылка, ИмяФайла = "", НазваниеАвто = "", НомерАвто = "") Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ТРАНСПОРТНАЯ_НАКЛАДНАЯ";
	
	ДанныеДляПечати = смартПолучитьДанныеДляПечатнойФормыТранспортнаяНакладная(ДокСсылка.ЗаказКлиента, ДокСсылка);
	
	ОбъектыПечати = Новый СписокЗначений;
	КомплектыПечати = Неопределено;
	
	Обработки.ПечатьТранспортнойНакладной.ЗаполнитьТабличныйДокументТН(
			ТабДок,
			ДанныеДляПечати,
			ОбъектыПечати,
			КомплектыПечати, Истина);
	
	Возврат ТабДок;
	
КонецФункции  //-- #1353 смарт: Фролов 04.09.2023

//++ #1353 смарт: Фролов 05.09.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)
Функция смартПолучитьДанныеДляПечатнойФормыТранспортнаяНакладная(ЗаказКлиента, Реализация)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЗаказКлиентаСсылка.Ссылка КАК Ссылка,
		|	ЗаказКлиентаСсылка.Номер КАК ЗаказКлиентаНомер,
		|	ЗаказКлиентаСсылка.Дата КАК ЗаказКлиентаДата,
		|	Реализация.Номер КАК Номер,
		|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ЗаказКлиентаСсылка.смартЖелаемаяДатаОтгрузкиАдмирал, ЧАС, ЧАС(ЗаказКлиентаСсылка.смартЖелаемоеВремяОтгрузки)), МИНУТА, МИНУТА(ЗаказКлиентаСсылка.смартЖелаемоеВремяОтгрузки)) КАК Дата,
		|	ЗаказКлиентаСсылка.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаСсылка.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаСсылка.Грузополучатель
		|		ИНАЧЕ ЗаказКлиентаСсылка.Контрагент
		|	КОНЕЦ КАК Грузополучатель,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаСсылка.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаСсылка.Грузоотправитель
		|		ИНАЧЕ ЗаказКлиентаСсылка.Организация
		|	КОНЕЦ КАК Грузоотправитель,
		|	ЗаказКлиентаСсылка.Контрагент КАК ЗаказчикПеревозки,
		|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя КАК БанковскийСчетЗаказчикаПеревозки,
		|	"""" КАК Кладовщик,
		|	"""" КАК ДолжностьКладовщика,
		|	ЗаказКлиентаСсылка.Контрагент КАК Плательщик,
		|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя КАК БанковскийСчетПлательщика,
		|	"""" КАК Перевозчик,
		|	ЗаказКлиентаСсылка.смартФИОВодителя КАК Водитель,
		|	"""" КАК ВидПеревозки,
		|	ЗаказКлиентаСсылка.смартВидТранспорта КАК МаркаАвтомобиля,
		|	ЗаказКлиентаСсылка.смартНомерМашины КАК ГосНомерАвтомобиля,
		|	ЕСТЬNULL(ЗаказКлиентаСсылка.АдресДоставки, """") КАК ПунктПогрузки,
		|	"""" КАК ПунктРазгрузки,
		|	НЕОПРЕДЕЛЕНО КАК СрокДоставки,
		|	"""" КАК ГрузоподъемностьВТоннахАвтомобиля,
		|	"""" КАК ВместимостьВКубическихМетрахАвтомобиля,
		|	ЗНАЧЕНИЕ(Справочник.ТипыТранспортныхСредств.ПустаяСсылка) КАК ТипАвтомобиля,
		|	0 КАК МассаБрутто,
		|	1 КАК ПорядковыйНомер,
		|	ЛОЖЬ КАК ЕстьНепроведенныеДокументыОснования,
		|	НЕОПРЕДЕЛЕНО КАК СкладПолучатель,
		|	Реализация.Склад КАК СкладОтправитель
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаСсылка
		|		ПО (ЗаказКлиентаСсылка.Ссылка = Реализация.ЗаказКлиента)
		|ГДЕ
		|	ЗаказКлиентаСсылка.Ссылка = &ЗаказКлиента
		|	И Реализация.Ссылка = &Реализация
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаСсылка.Ссылка,
		|	Реализация.Номер,
		|	Реализация.Склад,
		|	ЗаказКлиентаСсылка.Номер,
		|	ЗаказКлиентаСсылка.Дата,
		|	ЗаказКлиентаСсылка.Организация,
		|	ЗаказКлиентаСсылка.Контрагент,
		|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя,
		|	ЗаказКлиентаСсылка.смартФИОВодителя,
		|	ЗаказКлиентаСсылка.смартВидТранспорта,
		|	ЗаказКлиентаСсылка.смартНомерМашины,
		|	ЗаказКлиентаСсылка.АдресДоставки,
		|	ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(ЗаказКлиентаСсылка.смартЖелаемаяДатаОтгрузкиАдмирал, ЧАС, ЧАС(ЗаказКлиентаСсылка.смартЖелаемоеВремяОтгрузки)), МИНУТА, МИНУТА(ЗаказКлиентаСсылка.смартЖелаемоеВремяОтгрузки)),
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаСсылка.Грузополучатель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаСсылка.Грузополучатель
		|		ИНАЧЕ ЗаказКлиентаСсылка.Контрагент
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаСсылка.Грузоотправитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаСсылка.Грузоотправитель
		|		ИНАЧЕ ЗаказКлиентаСсылка.Организация
		|	КОНЕЦ,
		|	ЕСТЬNULL(ЗаказКлиентаСсылка.АдресДоставки, """"),
		|	ЗаказКлиентаСсылка.Контрагент,
		|	ЗаказКлиентаСсылка.БанковскийСчетГрузополучателя
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&ЗаказКлиента КАК Ссылка,
		|	1 КАК ПорядковыйНомер,
		|	&НаименованиеДляПечатиВидовНоменклатуры КАК НаименованиеВидаНоменклатуры
		|";

	Запрос.УстановитьПараметр("Реализация", 	Реализация);
	Запрос.УстановитьПараметр("ЗаказКлиента", 	ЗаказКлиента);
	Запрос.УстановитьПараметр("НаименованиеДляПечатиВидовНоменклатуры", Константы.НаименованиеДляПечатиВидовНоменклатуры.Получить());

	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("ТаблицаРезультата", РезультатЗапроса[0].Выгрузить());
	СтруктураРезультата.Вставить("РезультатИменаТоваров", РезультатЗапроса[1]);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураРезультата

КонецФункции  //-- #1353 смарт: Фролов 05.09.2023

