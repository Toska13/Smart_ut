&НаКлиенте
Процедура смарт_ПриОткрытииПосле(Отказ)
	
	Если Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз") Тогда
		ЭтаФорма.Элементы.ГруппаШапкаДопПраво.Видимость = Ложь;
	Иначе
		ПереименоватьСтатусыДоставки(ПолучитьСтатусДоставки());
		ЭтаФорма.Элементы.ГруппаШапкаДопПраво.Видимость = Истина;
	КонецЕсли;
	
	//++ смарт:КМД #2_2 461 23.03.2021
	Если ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") 
		И СтрНайти(ЭтаФорма.ВладелецФормы.ИмяФормы, "КОформлениюНакладных") > 0 тогда
		//создание с помощью обработки Накладные к оформлению
		ПодключитьОбработчикОжидания("смарт_ПроверитьПраваСозданиеБезвозмезднойПередачи", 3, Истина);
	Иначе
		смарт_ПроверитьПраваСозданиеБезвозмезднойПередачи();
	КонецЕсли;
	
	//-- смарт:КМД #2_2 461 23.03.2021
	
