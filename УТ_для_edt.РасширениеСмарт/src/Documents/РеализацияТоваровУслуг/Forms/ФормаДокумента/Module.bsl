//Статус доставки на форме
&НаСервере
Функция ПолучитьСтатусДоставки()

	СтруктураПодчиненности = Новый ТаблицаЗначений;
	СтруктураПодчиненности.Колонки.Добавить("Ссылка",,"Документ");
	СтруктураПодчиненности.Колонки.Добавить("Уровень",,"Уровень подчиенности");
	
	Стр = СтруктураПодчиненности.Добавить();
	Стр.Ссылка = Объект.Ссылка;
	Стр.Уровень = 0;
	
	// Получаем все подчиненные документы
	Для Каждого Строка Из СтруктураПодчиненности Цикл
		
		ЗначениеКритерияОтбора = Строка.Получить(0);
		
		Если Строка.Уровень <= 3 Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеДокументы.Ссылка
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&ЗначениеКритерияОтбора) КАК СвязанныеДокументы
			|ГДЕ
			|	ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ЗаказПоставщику)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ЗаказНаПеремещение)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ПриобретениеТоваровУслуг)
			|	И ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) <> ТИП(Документ.ПриобретениеУслугПрочихАктивов)";
			
			Запрос.УстановитьПараметр("ЗначениеКритерияОтбора", ЗначениеКритерияОтбора);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Стр = СтруктураПодчиненности.Добавить(); 
				Стр.Ссылка = ВыборкаДетальныеЗаписи.Ссылка;
				Стр.Уровень = Строка.Уровень + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из СтруктураПодчиненности Цикл
		Если Не Стр.Уровень = 0 Тогда      
			Документ = Стр.Получить(0);
			Если Документ.Проведен И ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ЗаданиеНаПеревозку") Тогда
				ДокументОбъект = Документ.ПолучитьОбъект();
				Попытка // Получить статус доставки
					ДанныеЗаявкиНаДоставку = Новый Структура(); 
					ДанныеЗаявкиНаДоставку.Вставить("Статус", ДокументОбъект.Статус);
					ДанныеЗаявкиНаДоставку.Вставить("Водитель", ДокументОбъект.Водитель);
					ДанныеЗаявкиНаДоставку.Вставить("ТранспортноеСредство", ДокументОбъект.ТранспортноеСредство);
					ДанныеЗаявкиНаДоставку.Вставить("ДатаДоставки", ДокументОбъект.ДатаВремяРейсаПланС);
					Возврат ДанныеЗаявкиНаДоставку;
				Исключение
					Продолжить;
				КонецПопытки;
			//Иначе
			//	Статус = "Не распределено на доставку"; 
			КонецЕсли;
		//Иначе
		//	Статус = "Не распределено на доставку";
		КонецЕсли;                 
	КонецЦикла;

	Возврат ДанныеЗаявкиНаДоставку;
	
КонецФункции // ПолучитьСтатусДоставки()

&НаКлиенте
Процедура ПереименоватьСтатусыДоставки(Структура)

	Если Не Структура = Неопределено Тогда
		Статус 					= Структура.Статус;
		Водитель 				= Структура.Водитель;
		ТранспортноеСредство 	= Структура.ТранспортноеСредство;
		ДатаДоставки 			= Лев(Строка(Структура.ДатаДоставки), 10);
	Иначе
		Статус = Неопределено;
	КонецЕсли; 
	
	Если Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаданийНаПеревозку.Формируется") Тогда
		ЭтаФорма.Элементы.НадписьСтатусДоставки.Заголовок = "В процессе формирования";
		ЭтаФорма.Элементы.НадписьСтатусДоставки.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьВодитель.Заголовок = "Водитель не утвержден";
		ЭтаФорма.Элементы.НадписьВодитель.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.Заголовок = Строка(ТранспортноеСредство);
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьДатаДоставки.Заголовок = "Дата доставки не утверждена";
		ЭтаФорма.Элементы.НадписьДатаДоставки.ЦветТекста = WebЦвета.ТемноОранжевый;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаданийНаПеревозку.КПогрузке") Тогда
		ЭтаФорма.Элементы.НадписьСтатусДоставки.Заголовок = "В процессе погрузки";
		ЭтаФорма.Элементы.НадписьСтатусДоставки.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьВодитель.Заголовок = Строка(Водитель);
		ЭтаФорма.Элементы.НадписьВодитель.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.Заголовок = Строка(ТранспортноеСредство);
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.ЦветТекста = WebЦвета.ТемноОранжевый;
		ЭтаФорма.Элементы.НадписьДатаДоставки.Заголовок = Строка(ДатаДоставки);
		ЭтаФорма.Элементы.НадписьДатаДоставки.ЦветТекста = WebЦвета.ТемноОранжевый;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаданийНаПеревозку.Отправлено") Тогда
		ЭтаФорма.Элементы.НадписьСтатусДоставки.Заголовок = "В пути";
		ЭтаФорма.Элементы.НадписьСтатусДоставки.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьВодитель.Заголовок = Строка(Водитель);
		ЭтаФорма.Элементы.НадписьВодитель.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.Заголовок = Строка(ТранспортноеСредство);
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьДатаДоставки.Заголовок = Строка(ДатаДоставки);
		ЭтаФорма.Элементы.НадписьДатаДоставки.ЦветТекста = WebЦвета.Зеленый;
	ИначеЕсли Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаданийНаПеревозку.Закрыто") Тогда
		ЭтаФорма.Элементы.НадписьСтатусДоставки.Заголовок = "Доставлен";
		ЭтаФорма.Элементы.НадписьСтатусДоставки.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьВодитель.Заголовок = Строка(Водитель);
		ЭтаФорма.Элементы.НадписьВодитель.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.Заголовок = Строка(ТранспортноеСредство);
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.ЦветТекста = WebЦвета.Зеленый;
		ЭтаФорма.Элементы.НадписьДатаДоставки.Заголовок = Строка(ДатаДоставки);
		ЭтаФорма.Элементы.НадписьДатаДоставки.ЦветТекста = WebЦвета.Зеленый;
	Иначе
		ЭтаФорма.Элементы.НадписьСтатусДоставки.Заголовок = "Не поступило в доставку";
		ЭтаФорма.Элементы.НадписьСтатусДоставки.ЦветТекста = WebЦвета.ОранжевоКрасный;
		ЭтаФорма.Элементы.НадписьВодитель.Видимость = Ложь;
		ЭтаФорма.Элементы.НадписьТранспортноеСредство.Видимость = Ложь;
		ЭтаФорма.Элементы.НадписьДатаДоставки.Видимость = Ложь;
	КонецЕсли; 

	ЗапретРедактированияДоставкиВРаботе(Статус);
	
КонецПроцедуры // ПереименоватьСтатусыДоставки()

&НаКлиенте
Процедура ЗапретРедактированияДоставкиВРаботе(Статус)

	ЭтаФорма.Элементы.СтраницыДоставки.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);
	ЭтаФорма.Элементы.ДатаДоставки.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);
	ЭтаФорма.Элементы.ПропускнаяСистема.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);
	Если Не ДоступноНаличиеСчетаВБухгалтерии() Тогда
		ЭтаФорма.Элементы.НаличиеСчетаВБухгалтерии.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);
	КонецЕсли;
	ЭтаФорма.Элементы.ДополнительнаяОбработкаГрузаТранспортнойКомпанией.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);
	ЭтаФорма.Элементы.СпособДоставкиТовара.ТолькоПросмотр = ?(Статус = Неопределено, Ложь, Истина);

КонецПроцедуры // ЗапретРедактированияДоставкиВРаботе() 

