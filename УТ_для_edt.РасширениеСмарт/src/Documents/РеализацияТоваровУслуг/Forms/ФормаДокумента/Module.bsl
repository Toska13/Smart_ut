Процедура смартУстановитьСнятьПодписанаТН(Реализация, Заказ, ПодписанаТН) 
	
	УстановитьПривилегированныйРежим(Истина); 
	
	МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Реализация;
	МенеджерЗаписи.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ПодписанаТН");
	МенеджерЗаписи.Значение = ПодписанаТН;
	
	МенеджерЗаписи.Записать();

	Если ЗначениеЗаполнено(Заказ) Тогда

		РегистрыСведений.СостоянияЗаказовКлиентов.ОтразитьСостояниеЗаказа(Заказ, Ложь);
		
	КонецЕсли; 
	
КонецПроцедуры //-- #Б-4672 смарт: Фролов 22.10.2025

&НаСервере
//++ #Б-4672 смарт: Фролов 22.10.2025 //Контроль возврата УПД с подписью клиента
Процедура смартУстановитьУбратьПодписавшегоДокументТН(Ссылка, ПодписанаТН, Подписавший) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Ссылка;
	Если НЕ ЗначениеЗаполнено(Подписавший) Тогда
		Подписавший = Пользователи.ТекущийПользователь();
	КонецЕсли;
	МенеджерЗаписи.Значение = ?(ПодписанаТН, Подписавший, Неопределено);
	МенеджерЗаписи.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ОтветственныйЗаПодписаниеТН");
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры //-- #Б-4672 смарт: Фролов 22.10.2025

