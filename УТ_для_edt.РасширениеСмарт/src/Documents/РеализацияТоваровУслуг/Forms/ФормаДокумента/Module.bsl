&НаСервере
//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
//Функция ПроверитьИПодготовитьДанныеДляКопированияВБуферОбмена()
Функция ПроверитьИПодготовитьДанныеДляКопированияВБуферОбмена(ПодписанаТН = Ложь)
//-- #Б-4672 смарт: Фролов 21.10.2025	
	
	ОперацияВыполнена = Ложь;
	
	Если смартСчетФактура = Неопределено Тогда 
		
		смартСчетФактура = УчетНДСРФВызовСервера.СчетФактураВыданныйПоОснованию(Объект.Ссылка, Объект.Организация);
		смартИмяФайла = смартСервер.ПолучитьИмяФайлаДляБуфераОбмена(Объект.ЗаказКлиента, смартСчетФактура);
		
		
	КонецЕсли;
	
	//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
	Если ЭтаФорма.смартИмяФайлаТН = "" Тогда
		
		ЭтаФорма.смартИмяФайлаТН = смартСервер.ПолучитьИмяФайлаТНДляБуфераОбмена(Объект.ЗаказКлиента, смартСчетФактура);
		
	КонецЕсли;
	//-- #Б-4672 смарт: Фролов 21.10.2025
	
	//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
	//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
	//ДанныеПроверки=смартСервер.ЕстьВозможностьПодписатьДокумент(Объект.Ссылка,Объект.ЗаказКлиента,смартСчетФактура);
	//ДанныеПроверки = смартСервер.ЕстьВозможностьПодписатьДокумент(Объект.Ссылка, Объект.ЗаказКлиента, смартСчетФактура, смартОтветственныйЗаПодпись);
	ДанныеПроверки = смартСервер.ЕстьВозможностьПодписатьДокумент(Объект.Ссылка, Объект.ЗаказКлиента, смартСчетФактура, смартОтветственныйЗаПодпись, ПодписанаТН);
	//-- смарт:ММ 02.09.2020
	//-- #Б-4672 смарт: Фролов 21.10.2025
	
	Если ДанныеПроверки.Результат Тогда
		
		//++ #Б-5916 смарт: Фролов 17.03.2026 //Отметка о получении документов в реализации товаров и услуг. Слетает ответственный
