//++ смарт:ММ #066 336 02.09.2020 - Доработка изменения поля "Документ подписан" в Реализации
&НаКлиенте
//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
//Процедура смартПодписьПриИзмененииПродолжение()
Процедура смартПодписьПриИзмененииПродолжение(ПодписанаТН = Ложь)
	
	//Если смартПодписан Тогда
	Если смартПодписан И НЕ ПодписанаТН Тогда
		
		//Если ПроверитьИПодготовитьДанныеДляКопированияВБуферОбмена() Тогда
		Если ПроверитьИПодготовитьДанныеДляКопированияВБуферОбмена(ПодписанаТН) Тогда 
			
			смартСкопировать(Неопределено);
			
		КонецЕсли;
		
	ИначеЕсли ЭтаФорма.смартПодписанаТН И ПодписанаТН Тогда
		
		Если ПроверитьИПодготовитьДанныеДляКопированияВБуферОбмена(ПодписанаТН) Тогда 
	//-- #Б-4672 смарт: Фролов 21.10.2025	
			
			//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента
			смартСкопироватьТН(Неопределено);
			Если ПодписанаТН Тогда
				смартУстановитьСнятьПодписанаТН(Объект.Ссылка, Объект.ЗаказКлиента, ЭтаФорма.смартПодписанаТН);
				смартУстановитьУбратьПодписавшегоДокументТН(Объект.Ссылка, ЭтаФорма.смартПодписанаТН, ЭтаФорма.смартОтветственныйЗаПодписаниеТН);
			КонецЕсли;	
			//-- #Б-4672 смарт: Фролов 21.10.2025
			
		КонецЕсли;
		
	Иначе	
		
		//++ #Б-4672 смарт: Фролов 21.10.2025 //Контроль возврата УПД с подписью клиента 
		Если ПодписанаТН Тогда
			смартУстановитьСнятьПодписанаТН(Объект.Ссылка, Объект.ЗаказКлиента, ЭтаФорма.смартПодписанаТН);
			смартУстановитьУбратьПодписавшегоДокументТН(Объект.Ссылка, ЭтаФорма.смартПодписанаТН, ЭтаФорма.смартОтветственныйЗаПодписаниеТН);
		КонецЕсли;	
		//-- #Б-4672 смарт: Фролов 21.10.2025
		
		СнятьПодписьСДокумента();
		УстановитьВидимостьПодписиДокумента();
		
	КонецЕсли;
	
	//++ #Б-4672 смарт: Фролов 22.10.2025 //Контроль возврата УПД с подписью клиента
	Если ПодписанаТН Тогда
		
		Оповестить("ПодписанаТН", ПодписанаТН, Объект.Ссылка);
		
	Иначе 	
		
		Оповестить("ПодписьДокумента",смартПодписан,Объект.Ссылка);
		
	КонецЕсли;
	//-- #Б-4672 смарт: Фролов 22.10.2025
	
КонецПроцедуры //-- смарт:ММ 02.09.2020

