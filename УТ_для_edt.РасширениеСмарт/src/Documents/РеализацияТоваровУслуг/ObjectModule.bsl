			НоваяСтрокаДЗ.Заказ = ЗаказКлиента;
			НоваяСтрокаДЗ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			
			СуммаРегл = СуммаРегл + НоваяСтрокаКЗ.СуммаРегл;
			СуммаУпр = СуммаУпр + НоваяСтрокаКЗ.СуммаУпр;
		Иначе
			Прервать;
