//++ #1246 смарт: Фролов 18.11.2022 //Доработка Грузоотправитель УПД 1С УТ Ковчег склад Адмирал Ковчег  
Процедура смартЗаполнитьГрузоотправителя(Организация, Склад, ЗаказКлиентаОснование) 
	
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                    |	ОрганизациисмартГрузоотправители.Грузоотправитель КАК Грузоотправитель
	                    |ИЗ
	                    |	Справочник.Организации.смартГрузоотправители КАК ОрганизациисмартГрузоотправители
	                    |ГДЕ
	                    |	ОрганизациисмартГрузоотправители.Ссылка = &Организация
	                    |	И ОрганизациисмартГрузоотправители.Склад = &Склад");
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Грузоотправитель = Выборка.Грузоотправитель;
	ИначеЕсли ЗначениеЗаполнено(ЗаказКлиентаОснование) Тогда
		
		Запрос=Новый Запрос("ВЫБРАТЬ
		                    |	ОрганизациисмартГрузоотправители.Грузоотправитель КАК Грузоотправитель
		                    |ИЗ
		                    |	Справочник.Организации.смартГрузоотправители КАК ОрганизациисмартГрузоотправители
		                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		                    |		ПО ОрганизациисмартГрузоотправители.Склад = ЗаказКлиентаТовары.Склад
		                    |ГДЕ
		                    |	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
		                    |	И ОрганизациисмартГрузоотправители.Ссылка = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация); 
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиентаОснование);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Грузоотправитель = Выборка.Грузоотправитель;	
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры
