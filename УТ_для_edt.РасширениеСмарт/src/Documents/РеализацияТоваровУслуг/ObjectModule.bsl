Функция смартПроверкаНаГруппуСкладов(Организация, Склад, МассивСкладов)
    
    СоответствиеСв = Новый Соответствие;  
    НовыйМассив = Новый Массив;
    Для каждого Эл_Строка Из МассивСкладов Цикл
        СоответствиеСв.Вставить(Эл_Строка);
	КонецЦикла;  
	
    Для каждого КлючИЗначение Из СоответствиеСв Цикл
        НовыйМассив.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
    Если НовыйМассив.Количество() = 1 Тогда
        Возврат НовыйМассив[0];
    ИначеЕсли НовыйМассив.Количество() > 1 Тогда
        Возврат "Предупреждение! Один документ = один склад отгрузки."
        +Символы.ПС+"Просьба внести корректировку в документ, на вкладке Основное выберите НЕ группу складов.";
    КонецЕсли; 
    
    Возврат Неопределено;   
    
КонецФункции //-- смарт:Подкин #1100 15.07.2022 10:40:20  

