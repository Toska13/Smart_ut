
#Область ПеренесеноСДоработками

//++ #Б956 смарт: Шляпников 20.09.2024 / Рефакторинг кода 1С. База УТ СМАРТ. Документы. РеализацияТоваровУслуг
&ИзменениеИКонтроль("ОбработкаПроведения")
Процедура смарт_ОбработкаПроведения(Отказ, РежимПроведения)

	#Вставка
	//++ смарт:ММ #062 334 13.08.2020 - Заказ клиента - не зачитывается аванс при указании договора
	Если Справочники.смартПредопределенныеЗначения.СоздаватьВзаимозачетПриПроведенииРеализации.Значение Тогда
			
		// Автоматическое создание взаимозачета задолженности (если есть авансы по договору)	
		Если ТипЗнч(ЗаказКлиента) = Тип("ДокументСсылка.ЗаказКлиента") 
			И ЗначениеЗаполнено(ЗаказКлиента) 
			И ЗначениеЗаполнено(Договор) Тогда
			//сначала проверим, возможно, взаимозачеты для этой реализации уже созданы
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			//|	СУММА(ВзаимозачетЗадолженностиДебиторскаяЗадолженность.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов,
			|	ВзаимозачетЗадолженностиДебиторскаяЗадолженность.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ВзаимозачетЗадолженности.ДебиторскаяЗадолженность КАК ВзаимозачетЗадолженностиДебиторскаяЗадолженность
			|ГДЕ
			|	ВзаимозачетЗадолженностиДебиторскаяЗадолженность.Ссылка.Комментарий ПОДОБНО &Комментарий
			|	И ВзаимозачетЗадолженностиДебиторскаяЗадолженность.Ссылка.Проведен";
			
			Запрос.УстановитьПараметр("Комментарий", "#Создан автоматически при проведении Реализации ТиУ №" + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"));
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			ДокументыВзаимозачетаУжеСозданы = Ложь;
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				//документы взаимозачета уже созданы, ничего не делаем
				//!!!добавить сравнение суммы и в случае недостаточности или избытка зачтенной суммы - переформировать документы
				//Возврат;
				ДокументыВзаимозачетаУжеСозданы = Истина;
			КонецЕсли;
			
			Если НЕ ДокументыВзаимозачетаУжеСозданы Тогда
				
				//выберем остатки авансов
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
				|	РасчетыСКлиентами.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
				|	РасчетыСКлиентами.ОбъектРасчетов КАК ЗаказКлиента,
				|	РасчетыСКлиентами.Валюта КАК Валюта,
				|	РасчетыСКлиентами.ПредоплатаОстаток КАК СуммаАванса,
				|	РасчетыСКлиентами.ПредоплатаРеглОстаток КАК СуммаРегл,
				|	РасчетыСКлиентами.ПредоплатаУпрОстаток КАК СуммаУпр,
				|	РасчетыСКлиентами.ДатаВозникновения
				|ИЗ
				|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
				|			&Дата,
				|			АналитикаУчетаПоПартнерам.Договор = &Договор
				//|				И ОбъектРасчетов <> &ОбъектРасчетов //учитываем аванс по текущему заказу, чтобы не зачесть лишнюю сумму 
				|				) КАК РасчетыСКлиентами
				|ГДЕ
				//и не учитываем предоплатыоплаты позже реализации
				|	РасчетыСКлиентами.ПредоплатаОстаток > 0 И РасчетыСКлиентами.ДатаВозникновения < &ДатаНачалаДня
				|	И РасчетыСКлиентами.ОбъектРасчетов <> НЕОПРЕДЕЛЕНО 
				|УПОРЯДОЧИТЬ ПО
				|	РасчетыСКлиентами.ДатаВозникновения";
				
				Запрос.УстановитьПараметр("Дата", Дата);
				Запрос.УстановитьПараметр("ДатаНачалаДня", НачалоДня(Дата));
				Запрос.УстановитьПараметр("ОбъектРасчетов", ЗаказКлиента);
				Запрос.УстановитьПараметр("Договор", Договор);
				РезультатЗапроса = Запрос.Выполнить();
				
				Если НЕ РезультатЗапроса.Пустой() Тогда
					Выборка = РезультатЗапроса.Выбрать();		
					смартСоздатьВзаимозачетЗадолженности(Выборка);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	//-- смарт:ММ 13.08.2020
	#КонецВставки
	
	ПроведениеСерверУТ.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);

	Документы.РеализацияТоваровУслуг.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСерверУТ.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	ЗаказыСервер.ОтразитьЗаказыКлиентов(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьСвободныеОстатки(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьОбеспечениеЗаказов(ДополнительныеСвойства, Движения, Отказ);
	ЗаказыСервер.ОтразитьТоварыКОтгрузке(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьТоварыНаСкладах(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьТоварыОрганизаций(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьТоварыОрганизацийКПередаче(ДополнительныеСвойства, Движения, Отказ);
	Если ДополнительныеСвойства.Свойство("ЗаписыватьРезервыТоваровОрганизацийВместеСоВсеми")
		И ДополнительныеСвойства.ЗаписыватьРезервыТоваровОрганизацийВместеСоВсеми Тогда
		ЗапасыСервер.ОтразитьРезервыТоваровОрганизаций(ДополнительныеСвойства, Движения, Отказ);
	КонецЕсли;
	ЗапасыСервер.ОтразитьТоварыПереданныеНаКомиссию(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьУслугиКОформлениюОтчетовПринципалу(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьДатыПередачиТоваровНаКомиссию(ДополнительныеСвойства, Отказ);
	ЗапасыСервер.ОтразитьТоварыКОформлениюОтчетовКомитента(ДополнительныеСвойства, Движения, Отказ);
	ЗапасыСервер.ОтразитьОбеспечениеЗаказовРаботами(ДополнительныеСвойства, Движения, Отказ);
	ДоходыИРасходыСервер.ОтразитьСебестоимостьТоваров(ДополнительныеСвойства, Движения, Отказ);
	ДоходыИРасходыСервер.ОтразитьВыручкуИСебестоимостьПродаж(ДополнительныеСвойства, Движения, Отказ);
	ВзаиморасчетыСервер.ОтразитьРасчетыСКлиентами(ДополнительныеСвойства, Движения, Отказ);
	МногооборотнаяТараСервер.ОтразитьПереданнуюВозвратнуюТару(ДополнительныеСвойства, Движения, Отказ);	

	СкладыСервер.ОтразитьДвиженияСерийТоваров(ДополнительныеСвойства, Движения, Отказ);

	ВзаиморасчетыСервер.ОтразитьСуммыДокументаВВалютеРегл(ДополнительныеСвойства, Движения, Отказ);

	ЗатратыСервер.ОтразитьМатериалыИРаботыВПроизводстве(ДополнительныеСвойства, Движения, Отказ);

	УчетНДСУП.СформироватьДвиженияВРегистры(ДополнительныеСвойства, Движения, Отказ);

	// Движения по оборотным регистрам управленческого учета
	УправленческийУчетПроведениеСервер.ОтразитьДвиженияНоменклатураНоменклатура(ДополнительныеСвойства, Движения, Отказ);

	// На случай, когда реализация раньше делала движения по ТоварамОрганизаций, а сейчас не делает.
	ЗапасыСервер.ПодготовитьЗаписьТоваровОрганизаций(ЭтотОбъект, РежимЗаписиДокумента.Проведение);
	РегистрыСведений.РеестрДокументов.ЗаписатьДанныеДокумента(Ссылка, ДополнительныеСвойства, Отказ);

	СформироватьСписокРегистровДляКонтроля();

	РеализацияТоваровУслугЛокализация.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);

	Если ДополнительныеСвойства.Свойство("ИзменилосьТолькоСостояниеПереходаПраваСобственности")
		И ДополнительныеСвойства.ИзменилосьТолькоСостояниеПереходаПраваСобственности Тогда
		ПропуститьПроверкуЗапретаИзмененияРегистров(Движения);
	КонецЕсли;

	ПроведениеСерверУТ.ЗаписатьНаборыЗаписей(ЭтотОбъект);

	#Вставка
	//++ смарт:rnp  #64 316 23.09.2020
	//вызовем пересчет сумм как если бы печатали УПД, иначе при печати УПД выполняется пересчет
	Если ПолучитьФункциональнуюОпцию("НоваяАрхитектураВзаиморасчетов") И (Ссылка.ВалютаВзаиморасчетов<>Ссылка.Валюта ИЛИ Ссылка.Валюта <> Константы.ВалютаРегламентированногоУчета.Получить())  Тогда
		МассивДокументов = Новый Массив;
		МассивДокументов.Добавить(Ссылка);
		РегистрыСведений.СуммыДокументовВВалютеРегл.РассчитатьСуммыДокументовВВалютеРегл(МассивДокументов);
	КонецЕсли;
	//-- смарт:rnp  #64 316 23.09.2020
	#КонецВставки

	// На случай, когда реализация раньше делала движения по ТоварамОрганизаций, а сейчас не делает.
	ПараметрыЗаполнения = ПараметрыЗаполненияВидовЗапасов(Истина);
	ЗапасыСервер.СформироватьРезервыПоТоварамОрганизаций(ЭтотОбъект, Отказ, ПараметрыЗаполнения);	

	ПроведениеСерверУТ.ВыполнитьКонтрольРезультатовПроведения(ЭтотОбъект, Отказ);

	РегистрыСведений.СостоянияЗаказовКлиентов.ОтразитьСостояниеЗаказа(ЭтотОбъект, Отказ);

	ДоставкаТоваров.ОтразитьСостояниеДоставки(Ссылка, Отказ);
	ПроведениеСерверУТ.СформироватьЗаписиРегистровЗаданий(ЭтотОбъект);
	ПроведениеСерверУТ.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

	Если Не ДополнительныеСвойства.ИзменилосьТолькоСостояниеПереходаПраваСобственности Тогда
		ПараметрыРегистрации = Документы.РеализацияТоваровУслуг.ПараметрыРегистрацииСчетовФактурВыданных(ЭтотОбъект);
		УчетНДСУП.АктуализироватьСчетаФактурыВыданныеПриПроведении(ПараметрыРегистрации);
	КонецЕсли;
	
	#Вставка
	// Фролов+
	ВыполнитьДвиженияПоУслугамСЦ(Отказ, РежимПроведения, смартСервер.ПолучитьДатуВнедренияФункционала());
	// Фролов-
	#КонецВставки 
	
	#Вставка
	//++ #Б-2484 смарт: Фролов 06.03.2025 //Ввод нового регламента СЦ. Доработка механизма заполнения регистра Состояние партнеров.
	Если НачалоДня(ТекущаяДата()) = НачалоДня(Дата) Тогда
	
		Если ЗначениеЗаполнено(ЗаказКлиента) И НЕ Отказ Тогда
			
			Если ЗаказКлиента.Менеджер = ЗаказКлиента.Партнер.смартОсновнойМенеджерСервисЦентра Тогда
				
				ЗапчастиСЦ = Справочники.смартПредопределенныеЗначения.Настройки.ВидНоменклатурыЗапчастиСервисногоЦентра;
				
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	Номенклатура КАК Номенклатура
				|ИЗ
				|	Документ.РеализацияТоваровУслуг.Товары
				|ГДЕ
				|	Номенклатура.ВидНоменклатуры = &ЗапчастиСЦ
				|	И Ссылка = &Ссылка");
				Запрос.УстановитьПараметр("ЗапчастиСЦ", ЗапчастиСЦ);
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				
				Если НЕ Запрос.Выполнить().Пустой() Тогда
					
					НаборЗаписей = РегистрыСведений.смартСостояниеПартнеров.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Партнер.Установить(Партнер);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						
						//++ #Б-2852 смарт: Фролов 08.04.2025 //Реализовать возможность присваивать Архивное "Состояние СЦ" Менеджерами СЦ
						//Добавил ограничение по статусу, Архивный не трогаем
						Если НЕ НаборЗаписей[0].СостояниеСЦ = Перечисления.смартСостоянияПартнеров.Архивный Тогда
						
							НаборЗаписей[0].СостояниеСЦ  = Перечисления.смартСостоянияПартнеров.НеСвободен;
							НаборЗаписей.Записать(Истина); 
							
						КонецЕсли;
						 //-- #Б-2852 смарт: Фролов 09.04.2025
						
					КонецЕсли;	
					
				КонецЕсли;	
				
			КонецЕсли;
			
			//++ #Б-2782 смарт: Фролов 25.03.2025 //Ввод нового регламента РМ. Доработка механизма заполнения регистра Состояние партнеров.
			Если ЗаказКлиента.Менеджер = ЗаказКлиента.Партнер.смартМенеджерПоРасходнымМатериалам Тогда
				
				МассивГруппРасходка = Новый Массив;
				
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	ГруппаНоменклатуры КАК ГруппаНоменклатуры
				|ИЗ
				|	Справочник.смартПредопределенныеЗначения.ГруппыНоменклатурыРасходка");
				
				Выборка = Запрос.Выполнить().Выбрать();
				Пока Выборка.Следующий() Цикл
					
					МассивГруппРасходка.Добавить(Выборка.ГруппаНоменклатуры);	
					
				КонецЦикла;	
				
				Запрос = Новый Запрос(
				"ВЫБРАТЬ
				|	Номенклатура КАК Номенклатура
				|ИЗ
				|	Документ.РеализацияТоваровУслуг.Товары
				|ГДЕ
				|	Номенклатура В ИЕРАРХИИ(&МассивГруппРасходка)
				|	И Ссылка = &Ссылка");
				Запрос.УстановитьПараметр("МассивГруппРасходка", МассивГруппРасходка);
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				
				Если НЕ Запрос.Выполнить().Пустой() Тогда
					
					НаборЗаписей = РегистрыСведений.смартСостояниеПартнеров.СоздатьНаборЗаписей();
					НаборЗаписей.Отбор.Партнер.Установить(Партнер);
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						
						НаборЗаписей[0].СостояниеРМ  = Перечисления.смартСостоянияПартнеров.НеСвободен;
						НаборЗаписей.Записать(Истина);
						
					КонецЕсли;	
					
				КонецЕсли;	
				
			КонецЕсли;
			//-- #Б-2782 смарт: Фролов 25.03.2025
			
		КонецЕсли;	
		
	КонецЕсли;
	//-- #Б-2484 смарт: Фролов 06.03.2025
	#КонецВставки

КонецПроцедуры

//++ #Б956 смарт: Шляпников 20.09.2024 / Рефакторинг кода 1С. База УТ СМАРТ. Документы. РеализацияТоваровУслуг
&ИзменениеИКонтроль("ПередЗаписью")
Процедура смарт_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	#Вставка
	//Богус++
	Если РеализацияПоЗаказам И ЗначениеЗаполнено(ЗаказКлиента) Тогда		 
		Если Валюта <> ЗаказКлиента.Валюта Тогда
			Сообщить("Валюта в заказе отличается от валюты документа.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;			
	КонецЕсли;
	//Богус--
	
	//++ смарт:ММ #047 228 05.05.2020 - у строк со ставкой НДС 0% д.б. заполнен код ТН ВЭД 
	СтавкаНДС0 = Перечисления.СтавкиНДС.НДС0;
	
	Для ТекИндекс = 0 По Товары.Количество() - 1 Цикл
		
		ТекСтрока = Товары[ТекИндекс]; 
		Номнклатура = ТекСтрока.Номенклатура;
		СтавкаНДС = ТекСтрока.СтавкаНДС;
		
		Если СтавкаНДС = СтавкаНДС0 И
			НЕ ЗначениеЗаполнено(Номнклатура.КодТНВЭД) Тогда
			
			ТекстОшибки = НСтр("ru='В строке %НомерСтроки% списка ""Товары"" у номенклатуры """ + Номнклатура + """ не заполнен код ТН ВЭД'");
			ТекстОшибки =  СтрЗаменить(ТекстОшибки, "%НомерСтроки%", Товары[ТекИндекс].НомерСтроки);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстОшибки,
			ЭтотОбъект,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Товары", Товары[ТекИндекс].НомерСтроки, "Номенклатура"),
			,
