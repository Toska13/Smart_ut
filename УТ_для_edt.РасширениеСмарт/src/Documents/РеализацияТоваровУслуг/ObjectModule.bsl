//++ смарт:ММ #062 334 13.08.2020 - Заказ клиента - не зачитывается аванс при указании договора 
Процедура смартСоздатьВзаимозачетЗадолженности(Выборка)
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаУправленческогоУчета     = Константы.ВалютаУправленческогоУчета.Получить();

	НовыйДокумент = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
	НовыйДокумент.Дата 					= НачалоДня(Дата);
	НовыйДокумент.Организация 			= Организация;
	НовыйДокумент.КонтрагентДебитор 	= Контрагент;
	НовыйДокумент.КонтрагентКредитор	= Контрагент;
	НовыйДокумент.Комментарий 			= "#Создан автоматически при проведении Реализации ТиУ №" + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy");
	НовыйДокумент.Ответственный 		= ПараметрыСеанса.ТекущийПользователь;
	НовыйДокумент.ВидОперации 			= Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Клиента;
	НовыйДокумент.ТипДебитора          	= Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	НовыйДокумент.ТипКредитора         	= Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	НовыйДокумент.ДокументОснование 	= ЗаказКлиента;
	
	СуммаРегл = 0;
	СуммаУпр = 0;
	
	//зачесть необходимо не больше, чем сумма текущего документа реализации
	//т.к. отбор остатков авансов выполнен по договору, то валюта взаиморасчетов одинаковая, пересчет не требуется
	СуммаОсталосьЗачесть  = ЭтотОбъект.СуммаВзаиморасчетов;
	Пока Выборка.Следующий() Цикл
		
		Если СуммаОсталосьЗачесть > 0 Тогда
			
			Если Выборка.ЗаказКлиента = ЗаказКлиента Тогда
				//уменьшаем сумму аванса для зачета, но строка во взаиморасчете при этом не требуется
				СуммаОсталосьЗачесть = СуммаОсталосьЗачесть - Выборка.СуммаАванса;
				//проблема: если к заказу привязан авансовый платеж,то взаимозачет в день реализации зачитывается по очереди после такого авансового платежа, 
				//т.е. с приоритетом по дате документа; т.к. требуется, чтобы зачет был в той последовательности, в которой отобраны остатки авансов, 
				//взаимозачет надо записывать ранее авансового платежа, привязанного к заказу
				//поэтому переназначаем дату взаимозачета с авансами, которые были ранее и записываем документ,если не пустой
				Если НовыйДокумент.ДебиторскаяЗадолженность.Количество()>0 и НовыйДокумент.КредиторскаяЗадолженность.Количество()> 0 Тогда 
					НовыйДокумент.Дата = НачалоДня(Выборка.ДатаВозникновения);
					//свернем дебиторскую задолженность
					НовыйДокумент.ДебиторскаяЗадолженность.Свернуть("ТипРасчетов,Партнер,Заказ,ВалютаВзаиморасчетов,Организация","СуммаВзаиморасчетов,СуммаУпр,СуммаРегл");
					Для Каждого СтрокаДЗ из НовыйДокумент.ДебиторскаяЗадолженность Цикл
						СтрокаДЗ.ИдентификаторСтроки = Новый УникальныйИдентификатор;
					КонецЦикла;		
					НовыйДокумент.СуммаРегл = СуммаРегл;
					НовыйДокумент.СуммаУпр = СуммаУпр;				
					Попытка
						УстановитьПривилегированныйРежим(Истина); //т.к. можем попасть в закрытый период
						НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
						УстановитьПривилегированныйРежим(Ложь);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + НовыйДокумент.Ссылка, НовыйДокумент.Ссылка);
					Исключение
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось создать взаимозачет задолженности по договору " + Договор + Символы.ПС + ОписаниеОшибки());
					КонецПопытки;
				КонецЕсли;
				
				НовыйДокумент = Неопределено;
				
				Продолжить;
				
			КонецЕсли;
			
			//если потребовался еще один взаимозачет
			Если НовыйДокумент = Неопределено Тогда
				
				НовыйДокумент = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
				НовыйДокумент.Дата 					= НачалоДня(Дата);
				НовыйДокумент.Организация 			= Организация;
				НовыйДокумент.КонтрагентДебитор 	= Контрагент;
