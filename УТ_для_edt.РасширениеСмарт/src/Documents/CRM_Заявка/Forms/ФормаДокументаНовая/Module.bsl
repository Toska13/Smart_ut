
#Область ПеренесеноСДоработкамиСмарт

&НаСервере
&После("ПриСозданииНаСервере")
//++ #1845 смарт: Фролов 04.06.2024 //Замена Лидов на Заявки для первичной фиксации интересов.
Процедура смарт_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ГруппаДанныеЛидаЛево = Элементы.Добавить("смартГруппаТекстыГоризонтальная", Тип("ГруппаФормы"), ЭтаФорма);
	ГруппаДанныеЛидаЛево.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДанныеЛидаЛево.ОтображатьЗаголовок = Ложь;
	ГруппаДанныеЛидаЛево.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	НовыйЭлемент = Элементы.Добавить("смартРезультатыПоискаПоКИ", Тип("ПолеФормы"), Элементы.смартГруппаТекстыГоризонтальная); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартРезультатыПоискаПоКИ";
	НовыйЭлемент.Заголовок = "Результаты поиска по конт. информации";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.МногострочныйРежим = Истина;
	
	НовыйЭлемент = Элементы.Вставить("смартБизнесРегионТекст", Тип("ПолеФормы"), Элементы.ГруппаЛевая, Элементы.ГруппаИнтерес); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартБизнесРегионТекст";
	НовыйЭлемент.Заголовок = "Бизнес регион по телефону";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Вставить("смартТипТовара", Тип("ПолеФормы"), Элементы.ГруппаЛевая, Элементы.ГруппаИнтерес); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартТипТовара";
	НовыйЭлемент.Заголовок = "Тип товара";
	НовыйЭлемент.ТолькоПросмотр = Истина;

	НовыйЭлемент = Элементы.Вставить("смартПродукт", Тип("ПолеФормы"), Элементы.ГруппаЛевая, Элементы.ГруппаИнтерес); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартПродукт";
	НовыйЭлемент.Заголовок = "Продукт";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Вставить("смартБизнесРегион", Тип("ПолеФормы"), Элементы.ГруппаПравая, Элементы.ГруппаКонтакта); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартБизнесРегион";
	НовыйЭлемент.Заголовок = "Бизнес регион";

	НовыйЭлемент = Элементы.Вставить("смартКвалификация", Тип("ПолеФормы"), Элементы.ГруппаПравая, Элементы.ГруппаКонтакта); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартКвалификация";
	НовыйЭлемент.Заголовок = "Квалификация";
	
	НовыйЭлемент = Элементы.Вставить("смартСостояниеЛида", Тип("ПолеФормы"), Элементы.ГруппаДатаСтатус, Элементы.ГруппаСостояниеЛида); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартСостояниеЛида";
	НовыйЭлемент.Заголовок = "Состояние";
	
	//++ #1941 смарт: Фролов 22.07.2024 //Добавить реквизит "yclid" к Лиду и Заявкам
	НовыйЭлемент = Элементы.Вставить("смартYclid_Метка", Тип("ПолеФормы"), Элементы.ГруппаДатаСтатус, Элементы.ГруппаСостояниеЛида); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартYclid_Метка";
	НовыйЭлемент.Заголовок = "Yclid-Метка";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	//-- #1941 смарт: Фролов 22.07.2024

	//++#1958 смарт: Лопато 05.08.2024 //Добавить реквизит "ClientID" к Лиду и Заявкам
	НовыйЭлемент = Элементы.Вставить("смартClientID", Тип("ПолеФормы"), Элементы.ГруппаДатаСтатус, Элементы.ГруппаСостояниеЛида); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.смартClientID";
	НовыйЭлемент.Заголовок = "ClientID";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	//--#1958 смарт: Лопато 05.08.2024
	
	Элементы.Переместить(Элементы.Комментарий, Элементы.смартГруппаТекстыГоризонтальная, Элементы.смартРезультатыПоискаПоКИ);
	Элементы.Переместить(Элементы.Тема, Элементы.ГруппаЛевая, Элементы.Наименование);
	Элементы.Переместить(Элементы.Автор, Элементы.ГруппаПравая, Элементы.КаналПервичногоИнтереса);
	Элементы.Переместить(Элементы.ГруппаОтветственный, Элементы.ГруппаПравая, Элементы.Автор);
	
	Элементы.Организация.Видимость = Ложь;
	Элементы.СостояниеЛида.Видимость = Ложь;
	Элементы.ОбщаяКомандаCRM_УстановитьНовогоОтветственного.Видимость = Ложь;
	Элементы.ОбщаяКомандаCRM_УстановитьНовогоОтветственногоРоль.Видимость = Ложь;
	
	Элементы.Комментарий.Заголовок = "Текст запроса";
	
	Элементы.Ответственный.РежимВыбораИзСписка = Истина;
	смартЗаполнитьСписокВыбораОтветственных();
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Новый РеквизитФормы("смартТекстЗапросаHTML", Новый ОписаниеТипов("Строка")));
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	НовыйЭлемент = Элементы.Вставить("смартТекстЗапросаПолеHTML", Тип("ПолеФормы"), Элементы.смартГруппаТекстыГоризонтальная, Элементы.смартРезультатыПоискаПоКИ); 	
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеHTMLДокумента;
	НовыйЭлемент.ПутьКДанным = "смартТекстЗапросаHTML";
	НовыйЭлемент.Заголовок = "Текст запроса";
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЭлектронноеПисьмоВходящее") 
			И Объект.ДокументОснование.ТипТекста = Перечисления.ТипыТекстовЭлектронныхПисем.HTML Тогда
			
			HTMLТекст = "<!DOCTYPE html>
			|<html lang=""ru"">
			|<head>
			|
			|</head>
			|<body>" + Объект.Комментарий+"</body>
			|</html>";
			
			ЭтаФорма.смартТекстЗапросаHTML = HTMLТекст;
			Элементы.Комментарий.Видимость = Ложь;
			Элементы.смартТекстЗапросаПолеHTML.Видимость = Истина;
			
		Иначе
			
			Элементы.Комментарий.Видимость = Истина;
			Элементы.смартТекстЗапросаПолеHTML.Видимость = Ложь;
			Элементы.Комментарий.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.Комментарий.Видимость = Истина;
		Элементы.смартТекстЗапросаПолеHTML.Видимость = Ложь;
		
	КонецЕсли;	
	
КонецПроцедуры //-- #1845 смарт: Фролов 04.06.2024

#КонецОбласти

#Область ДоработкиСмарт

&НаСервере
//++ #1845 смарт: Фролов 05.06.2024 //Замена Лидов на Заявки для первичной фиксации интересов.
Процедура смартЗаполнитьСписокВыбораОтветственных()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Пользователи 
	|ГДЕ
	|	НЕ Пользователь В
	|				(ВЫБРАТЬ
	|					Менеджер КАК Менеджер
	|				ИЗ
	|					РегистрСведений.смартКоэффициентыМенеджеров.СрезПоследних(, 
	|						ВидКоэффициента = ЗНАЧЕНИЕ(Перечисление.смартВидыКоэффициентовМенеджеров.ИтоговыйКоэффициент))
	|				ГДЕ
	|					ВыдачаЗаблокирована) И Ссылка = &Квалификация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователь.Наименование");
	Запрос.УстановитьПараметр("Квалификация", ?(ЗначениеЗаполнено(Объект.смартКвалификация), Объект.смартКвалификация, Справочники.смартКвалификацииМенеджеров.ПустаяСсылка()));
	
	
	Элементы.Ответственный.СписокВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пользователь"));
	
КонецПроцедуры	//-- #1845 смарт: Фролов 05.06.2024

&НаКлиенте
//++ #1845 смарт: Фролов 05.06.2024 //Замена Лидов на Заявки для первичной фиксации интересов.
Процедура смартКвалификацияПриИзменении(Элемент)
	
	смартЗаполнитьСписокВыбораОтветственных();
	
КонецПроцедуры //-- #1845 смарт: Фролов 05.06.2024

#КонецОбласти