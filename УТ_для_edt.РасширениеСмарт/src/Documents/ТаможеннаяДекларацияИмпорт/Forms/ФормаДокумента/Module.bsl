
#Область ПеренесеноСДоработками

// Фролов+
&НаСервере
Процедура смарт_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	//++ #6094 смарт: Тимофеева 17.03.26 / Документ "Предварительная таможенная декларация". Доработки заполнения и гарантии
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ ЗначениеЗаполнено(Объект.смартПредварительнаяТаможеннаяДекларацияИмпорт) Тогда 	
		Если ЗначениеЗаполнено(Объект.Подразделение) И НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			Объект.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Подразделение, "смартОрганизацияВладелец");
			ОрганизацияПриИзмененииСервер();
		КонецЕсли;
		Объект.ВариантОформления = Перечисления.ХозяйственныеОперации.ОформлениеГТДСамостоятельно;
		Объект.Контрагент = Справочники.смартПредопределенныеЗначения.КонтрагентПоУмолчаниюДляТаможеннойДекларации.Значение;
		Если ЗначениеЗаполнено(Объект.Контрагент) Тогда 
			Объект.Партнер 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "Партнер"); 
			ЗаполнитьДоговорПоУмолчанию();
			Объект.БанковскийСчетКонтрагента = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетКонтрагентаПоУмолчанию(Объект.Контрагент, , Объект.БанковскийСчетКонтрагента);
			
			ЗаполнитьДанныеФормы(Истина);
			НастроитьЭлементыФормы();
			ОчиститьРасшифровкуПлатежа();
		КонецЕсли; 
		
		//++ #6934 смарт: Тимофеева 28.05.2026 / Доработать загрузку ПТД и ТД
		Объект.СтатьяРасходовСбор 	= Справочники.смартПредопределенныеЗначения.СтатьяРасходовПоСборамПоУмолчаниюДляТаможеннойДекларации.Значение;
		СтатьяРасходовПриИзмененииНаСервере("Сбор");
		Объект.ДатаПлатежа 			= ТекущаяДатаСеанса();
		//-- #6934 смарт: Тимофеева 28.05.2026
	КонецЕсли;
	//-- #6094 смарт: Тимофеева 17.03.26

	ДоступностьЭлементаГруз();
	ДобавитьЭлементыПрограммно();
	
КонецПроцедуры

//++ #Б-972 смарт: Лопато 01.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ТаможеннаяДекларацияИмпорт  
&НаКлиенте
&ИзменениеИКонтроль("ПодобратьИзПоступленийЗавершение")
Процедура смарт_ПодобратьИзПоступленийЗавершение(Результат, ДополнительныеПараметры)

	ДанныеРаздела = ДанныеТекущегоРаздела(Элементы.Разделы);

	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("Партнер",          Объект.Поставщик);
	ПараметрыПодбора.Вставить("Организация",      Объект.Организация);
	ПараметрыПодбора.Вставить("Склад",            ДанныеРаздела.Склад);
	ПараметрыПодбора.Вставить("ЗакупкаПоИмпорту", Истина);
	ПараметрыПодбора.Вставить("ПоказыватьТару",   Ложь);
	ПараметрыПодбора.Вставить("ПоказыватьТовары", Истина);
	ПараметрыПодбора.Вставить("ЦенаВключаетНДС",  Ложь);
	ПараметрыПодбора.Вставить("Валюта",           Объект.Валюта);
	ПараметрыПодбора.Вставить("Дата",             ДатаДокумента(Объект.Дата));

	#Вставка //#Б-972 смарт: Лопато 01.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ТаможеннаяДекларацияИмпорт
	//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
	// Фролов+
	Если ЗначениеЗаполнено(Объект.Груз) Тогда 
		ПараметрыПодбора.Вставить("Груз", Объект.Груз);  
	КонецЕсли;	
	// Фролов-
	//-- смарт:ММ 27.03.2020

	//++ Смарт:  Демичев №1022 09.08.2022 ((Укажем, что форму вызываем из Таможенной декларации, чтобы не сворачивать строки только для нее
	ПараметрыПодбора.Вставить("Смарт_ТаможеннаяДекларация", Истина);  	
	//-- Смарт:  Демичев №1022 09.08.2022 
	#КонецВставки

	ОткрытьФорму("ОбщаяФорма.ПодборТоваровПоПоступлениям", ПараметрыПодбора, ЭтаФорма);

	ОбновитьИнформациюПоПоступлениям();

КонецПроцедуры

//++ #Б-972 смарт: Лопато 01.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ТаможеннаяДекларацияИмпорт  
&НаСервере
&ИзменениеИКонтроль("РаспределитьНаТоварыСервер")
Процедура смарт_РаспределитьНаТоварыСервер()
	Отбор = Новый Структура("НомерРаздела");
	Разделы = ОбщегоНазначенияУТКлиентСервер.ВыделенныеЭлементыКоллекции(Объект.Разделы, Элементы.Разделы.ВыделенныеСтроки);
	Для Каждого Раздел Из Разделы Цикл
		Отбор.НомерРаздела = Раздел.НомерРаздела;
		ТоварыРаздела = Объект.Товары.Выгрузить(Отбор);
		
		Если ТоварыРаздела.Количество() > 0 Тогда
			Коэффициенты = ТоварыРаздела.ВыгрузитьКолонку("ТаможеннаяСтоимость");
			НовыеСуммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Раздел.ТаможеннаяСтоимость, Коэффициенты);
			Если НовыеСуммы <> Неопределено Тогда
				ТоварыРаздела.ЗагрузитьКолонку(НовыеСуммы, "ТаможеннаяСтоимость");
			КонецЕсли;
			НовыеСуммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Раздел.СуммаПошлины, Коэффициенты);
			Если НовыеСуммы <> Неопределено Тогда
				ТоварыРаздела.ЗагрузитьКолонку(НовыеСуммы, "СуммаПошлины");
			КонецЕсли;
			НовыеСуммы = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(Раздел.СуммаНДС, Коэффициенты);
			Если НовыеСуммы <> Неопределено Тогда
				ТоварыРаздела.ЗагрузитьКолонку(НовыеСуммы, "СуммаНДС");
			КонецЕсли;
		КонецЕсли;
		
		Для каждого Товар Из ТоварыРаздела Цикл
			ОбъектТовар = Объект.Товары[Товар.НомерСтроки-1];
			Объект.Товары[Товар.НомерСтроки-1].ТаможеннаяСтоимость = ?(Раздел.ТаможеннаяСтоимость > 0., Товар.ТаможеннаяСтоимость, 0.);
			Объект.Товары[Товар.НомерСтроки-1].СуммаПошлины = ?(Раздел.СуммаПошлины > 0., Товар.СуммаПошлины, 0.);
			Объект.Товары[Товар.НомерСтроки-1].СуммаНДС = ?(Раздел.СуммаНДС > 0., Товар.СуммаНДС, 0.);

			#Вставка //#Б-972 смарт: Лопато 01.10.2024 //Рефакторинг кода 1С. База УТ СМАРТ. Документы. ТаможеннаяДекларацияИмпорт
			//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
			// Фролов+
			Объект.Товары[Товар.НомерСтроки-1].СтранаПроисхождения = Раздел.СтранаПроисхождения;
			// Фролов-
			//-- смарт:ММ 27.03.2020
			#КонецВставки
			
		КонецЦикла;
	КонецЦикла;
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, РазностиИтогов(Объект.Разделы, Объект.Товары));
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

// Фролов+
&НаСервере
Процедура ДоступностьЭлементаГруз()
	Элементы.ДекорацияГруз.Заголовок=Объект.Груз.СтатусГруза;
	Если Объект.Груз.СтатусГруза=ПредопределенноеЗначение("Перечисление.СтатусыГрузов.Принят") Тогда 
		Элементы.Груз.ТолькоПросмотр=Не РольДоступна("ПолныеПрава");
		Элементы.ДекорацияГруз.ЦветТекста=WebЦвета.Зеленый;
	Иначе
		Элементы.ДекорацияГруз.ЦветТекста=WebЦвета.ТемноОранжевый;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура смарт_РазделыПеретаскиваниеВместо(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка=Ложь;
	Если ТипЗнч(ПараметрыПеретаскивания.Значение)=Тип("Массив") Тогда 
		Для Каждого Стр Из ПараметрыПеретаскивания.Значение Цикл 
			Стр.НомерРаздела=Объект.Разделы.НайтиПоИдентификатору(Строка).НомерРаздела;
		КонецЦикла;
		Элемент.ВыделенныеСтроки.Добавить(Строка);
		РаспределитьНаТоварыСервер();
		Элемент.ВыделенныеСтроки.Удалить(Элемент.ВыделенныеСтроки.Найти(Строка));
		Модифицированность=Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура смартЗаполнитьПоГрузу(Команда)
	Если Не ЗначениеЗаполнено(Объект.Груз) Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Поле 'Груз' не заполнено.",,"Объект.Груз");
		Возврат;
	КонецЕсли;	
	Если Объект.Товары.Количество() Тогда
		ТекстВопроса="Табличные части будут очищены!
						|Продолжить?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаЗагрузитьПоГрузу",ЭтотОбъект),ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	Иначе 
		ЗаполнитьПоГрузуНаСервере();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗагрузитьПоГрузу(Рез,ДопПараметры)Экспорт 
	Если Рез=КодВозвратаДиалога.Да Тогда 
		ЗаполнитьПоГрузуНаСервере();
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоГрузуНаСервере()
	Объект.Разделы.Очистить();
	Объект.Товары.Очистить();
	Элементы.ТоварыНомерРаздела.СписокВыбора.Очистить();
	Элементы.ТоварыНомерРаздела.СписокВыбора.Добавить(0,"-");
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Груз",Объект.Груз);
	Запрос.Текст="ВЫБРАТЬ
	             |	ПриобретениеТоваровУслугТовары.Номенклатура.КодТНВЭД КАК КодТНВЭД,
	             |	ПриобретениеТоваровУслугТовары.Ссылка КАК ДокументПоступления,
	             |	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	             |	ПриобретениеТоваровУслугТовары.Характеристика КАК Характеристика,
	             |	ПриобретениеТоваровУслугТовары.Серия КАК Серия,
	             |	ПриобретениеТоваровУслугТовары.Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	             |	ПриобретениеТоваровУслугТовары.Упаковка КАК Упаковка,
	             |	ПриобретениеТоваровУслугТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	             |	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Склад, ПриобретениеТоваровУслугТовары.Ссылка.Склад) КАК Склад
	             |ИЗ
	             |	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	             |ГДЕ
	             |	ПриобретениеТоваровУслугТовары.Ссылка.Груз = &Груз
	             |ИТОГИ ПО
	             |	КодТНВЭД,Склад,СтранаПроисхождения";
	КодыТНВЭД=Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерРаздела=1;
	Пока КодыТНВЭД.Следующий() Цикл 
		Склады=КодыТНВЭД.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Склады.Следующий() Цикл
			Страны=Склады.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Страны.Следующий() Цикл 
				Раздел=Объект.Разделы.Добавить();
				Раздел.СтранаПроисхождения=Страны.СтранаПроисхождения;
				Раздел.Склад=Склады.Склад;
				Раздел.НомерРаздела=НомерРаздела;
				
				Данные=Страны.Выбрать();
				Пока Данные.Следующий() Цикл 
					Стр=Объект.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(Стр,Данные);
					Стр.НомерРаздела=НомерРаздела;
					ПересчитатьСтрокуПослеЗаполненияИзГруза(Стр);
				КонецЦикла;
				Элементы.ТоварыНомерРаздела.СписокВыбора.Добавить(НомерРаздела,Формат(НомерРаздела,"ЧГ="));
				НомерРаздела=НомерРаздела+1;

				смартЗаполнитьНомерДляСФ(Раздел);
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;
	ЗаполнитьЗначенияСвойств(ЭтаФорма, РазностиИтогов(Объект.Разделы, Объект.Товары));
КонецПроцедуры

&НаСервере
Процедура смартЗаполнитьНомерДляСФ(ТекущийРаздел)
	//Табчасть = ?(Объект.НумероватьПоТоварам, Объект.Товары, Объект.Разделы);//rnp закомментировано 10052021, т.к. в релизе 13.47 удален реквизит Нумеровать по товарам
	Табчасть = Объект.Товары;
	//ИмяПоляДополнения = ?(Объект.НумероватьПоТоварам, "НомерСтроки",  "НомерРаздела");//rnp закомментировано 10052021, т.к. в релизе 13.47 удален реквизит Нумеровать по товарам
	ИмяПоляДополнения = "НомерСтроки";
	НомерДекларации = СокрЛП(Объект.НомерДекларации);
	Для Каждого Строка Из Табчасть Цикл
		Строка.НомерДляСФ = НомерДляСФ(НомерДекларации, Строка[ИмяПоляДополнения]);
	КонецЦикла;
	// изменились номера для с/ф - очистим ссылки на номера ГТД
	//ОтборТоваров = ?(Объект.НумероватьПоТоварам, Новый Структура("НомерРаздела", ТекущийРаздел), Новый Структура); /rnp закомментировано 10052021, т.к. в релизе 13.47 удален реквизит Нумеровать по товарам
	ОтборТоваров = Новый Структура("НомерРаздела", ТекущийРаздел);
	ЗаполнитьПоляТабчасти("Товары", Новый Структура("НомерГТД", Неопределено), ОтборТоваров);
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуПослеЗаполненияИзГруза(Стр)
	Действия = Новый Структура;

	Действия.Вставить("ПроверитьХарактеристикуПоВладельцу", Стр.Характеристика);
	Действия.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", Стр.Упаковка);
	Действия.Вставить("ПересчитатьКоличествоЕдиниц");
	Действия.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	Действия.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	Действия.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Стр.Склад, ПараметрыУказанияСерий));

	Действия.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
		ЭтаФорма.ИмяФормы, "Товары"));

	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(Стр, Действия, Неопределено);
КонецПроцедуры	

&НаКлиенте
Процедура смарт_РазделыПослеУдаленияПосле(Элемент)
	УпорядочитьНомераРазделовПослеУдаления(КешРазделов);
КонецПроцедуры

&НаСервере
Процедура УпорядочитьНомераРазделовПослеУдаления(КешРазделов)
	Если Не КешРазделов.Количество() Тогда 
		Возврат;
	КонецЕсли;

	Элементы.ТоварыНомерРаздела.СписокВыбора.Очистить();
	Элементы.ТоварыНомерРаздела.СписокВыбора.Добавить(0,"-");
	
	Для с=0 По Объект.Разделы.Количество()-1 Цикл
		Раздел=Объект.Разделы[с];
		Если Не Раздел.НомерРаздела=с+1 Тогда 		
			МассивСтрокТоваров=Объект.Товары.НайтиСтроки(Новый Структура("НомерРаздела",Раздел.НомерРаздела));
			Для Каждого Стр Из МассивСтрокТоваров Цикл 
				Стр.НомерРаздела=с+1;
			КонецЦикла;	
			Раздел.НомерРаздела=с+1;
			смартЗаполнитьНомерДляСФ(Раздел);
		КонецЕсли;
