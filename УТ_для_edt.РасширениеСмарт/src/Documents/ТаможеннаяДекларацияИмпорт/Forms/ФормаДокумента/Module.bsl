&НаСервере
Процедура смарт_ЗаполнитьПоXMLПослеНаСервере(ДвоичныеДанные, СтрокаОшибки)
	//++ смарт:ЩукинВВ #27806 623 17.09.2021
	ФайлШаблона = ПолучитьИмяВременногоФайла("xml");		
	
	ДвоичныеДанные.Записать(ФайлШаблона);
	ПараметрыЧтенияXML = Новый ПараметрыЧтенияXML(,,,,,,,Ложь);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлШаблона, ПараметрыЧтенияXML);
	
	ОсновнойРаздел = Новый Соответствие;
	РазделРасчеты = Новый Соответствие;
	
	РазделыГТД = Объект.Разделы.Выгрузить();
	РазделыГТД.Очистить();
	
	ТаблицаАртикулов = Новый ТаблицаЗначений;
	ТаблицаАртикулов.Колонки.Добавить("Артикул");
	ТаблицаАртикулов.Колонки.Добавить("НомерРаздела");
	
	СтекИмен = Новый СписокЗначений;
	НомерРаздела = 0;
	Номер = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			Если ЧтениеXML.Имя = "ContainerDoc" Тогда 
				
				НомерРаздела = НомерРаздела + 1;
				
			КонецЕсли;	
			
			СтекИмен.Добавить(ЧтениеXML.Имя);
			ПутьКСтроке = смарт_ПостроитьПуть(СтекИмен);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ИскомоеЗначение = смарт_ПолучитьЗначениеСоответствия(ОсновнойРаздел,ПутьКСтроке);
			
			Если СтрНайти(ПутьКСтроке, "EECEDocHeaderAddInfo/RUScat_ru:EDocDateTime") <> 0 Тогда 
				
				ДатаСтрокой = СтрЗаменить(ЧтениеXML.Значение, "-","");
				ДатаСтрокой = СтрЗаменить(ДатаСтрокой, ":","");
				ДатаСтрокой = СтрЗаменить(ДатаСтрокой, "T","");
				ПозицияСтрокиПоиска = СтрНайти(ДатаСтрокой, "+");
				Если ПозицияСтрокиПоиска <> 0 Тогда 
					ДатаСтрокой = Лев(ДатаСтрокой, ПозицияСтрокиПоиска-1);
				КонецЕсли;	
				ОсновнойРаздел.Вставить("Дата", Дата(ДатаСтрокой));
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUConsignor/cat_ru:OrganizationName") <> 0 Тогда 
				
				Контрагент = смарт_ПолучитьКонтрагента(ЧтениеXML.Значение);
				
				Если Контрагент <> Справочники.Контрагенты.ПустаяСсылка() Тогда 
					ОсновнойРаздел.Вставить("КонтрагентПоставщика", Контрагент);
					Поставщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
					Если ЗначениеЗаполнено(Поставщик) Тогда 
						ОсновнойРаздел.Вставить("Поставщик", Поставщик);
					КонецЕсли;
				Иначе	
					ОсновнойРаздел.Вставить("КонтрагентПоставщика", Неопределено);
					ОсновнойРаздел.Вставить("Поставщик", Неопределено);
				КонецЕсли;
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUDeclarant/cat_ru:RFOrganizationFeatures/cat_ru:INN") <> 0 Тогда 
				
				Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", ЧтениеXML.Значение);
				Если Организация <> Справочники.Организации.ПустаяСсылка() Тогда 
					ОсновнойРаздел.Вставить("Организация", Организация);
				Иначе
					ОсновнойРаздел.Вставить("Организация", Неопределено);
				КонецЕсли;
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUCustomsPaymentCalculation/catESAD_cu:PaymentModeCode") <> 0 Тогда
				
				ЗаполнитьТаможенныйСбор = Ложь;
				ЗаполнитьСтавкуСуммуПошлины = Ложь;
				ЗаполнитьСтавкуСуммуНДС = Ложь;
				
				Если ЧтениеXML.Значение = "1010" Тогда 
					ЗаполнитьТаможенныйСбор = Истина;
				КонецЕсли;
				
				Если ЧтениеXML.Значение = "2010" Тогда 
					ЗаполнитьСтавкуСуммуПошлины = Истина;
				КонецЕсли;
				
				Если ЧтениеXML.Значение = "5010" Тогда 
					ЗаполнитьСтавкуСуммуНДС = Истина;
				КонецЕсли;
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUGoods/catESAD_cu:GoodsNumeric") Тогда 
				
				НомерРазделаГТД = Число(ЧтениеXML.Значение); 
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "НомерРаздела", Число(ЧтениеXML.Значение), РазделыГТД);	
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUCustomsPaymentCalculation/catESAD_cu:PaymentAmount") <> 0 И ЗаполнитьТаможенныйСбор И НомерРаздела = 1 Тогда 	
				
				РазделРасчеты.Вставить("ТаможенныйСбор", Число(ЧтениеXML.Значение));
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUCustomsPaymentCalculation/catESAD_cu:PaymentAmount") <> 0 И ЗаполнитьСтавкуСуммуПошлины Тогда 	
				
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "СуммаПошлины", Число(ЧтениеXML.Значение), РазделыГТД);	
				
			ИначеЕсли ПутьКСтроке = "/ED_Container/ContainerDoc/DocBody/ESADout_CU/ESADout_CUGoodsShipment/ESADout_CUGoods/ESADout_CUCustomsPaymentCalculation/catESAD_cu:Rate" И ЗаполнитьСтавкуСуммуПошлины Тогда 	
				
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "СтавкаПошлины", Число(ЧтениеXML.Значение), РазделыГТД);
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUCustomsPaymentCalculation/catESAD_cu:PaymentAmount") <> 0 И ЗаполнитьСтавкуСуммуНДС Тогда 	
				
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "СуммаНДС", Число(ЧтениеXML.Значение), РазделыГТД);	
				
			ИначеЕсли ПутьКСтроке = "/ED_Container/ContainerDoc/DocBody/ESADout_CU/ESADout_CUGoodsShipment/ESADout_CUGoods/ESADout_CUCustomsPaymentCalculation/catESAD_cu:Rate" И ЗаполнитьСтавкуСуммуНДС Тогда 	
				
				СтавкаНДС = смарт_ПолучитьСтавкуНДС_ПеречислениемСсылка(Число(ЧтениеXML.Значение));
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "СтавкаНДС", СтавкаНДС, РазделыГТД);	
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "ESADout_CUGoods/catESAD_cu:OriginCountryCode") Тогда
				
				Страна = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа2", ЧтениеXML.Значение);
				
				Если Страна = Справочники.СтраныМира.ПустаяСсылка() Тогда 
					Страна = Справочники.СтраныМира.НайтиПоРеквизиту("КодАльфа3", ЧтениеXML.Значение);
				КонецЕсли;
				
				Если Страна <> Справочники.СтраныМира.ПустаяСсылка() Тогда 
					смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "СтранаПроисхождения", Страна, РазделыГТД);
				КонецЕсли;
				
			ИначеЕсли ПутьКСтроке = "/ED_Container/ContainerDoc/DocBody/ESADout_CU/ESADout_CUGoodsShipment/ESADout_CUGoods/catESAD_cu:CustomsCost" Тогда
				
				смарт_ЗаполнитьРазделыГТД(НомерРазделаГТД, "ТаможеннаяСтоимость", Число(ЧтениеXML.Значение), РазделыГТД);
				
			ИначеЕсли СтрНайти(ПутьКСтроке, "catESAD_cu:GoodsGroupInformation/catESAD_cu:GoodsMarking") <> 0 И НомерРаздела = 1 Тогда
				
				НоваяСтрока = ТаблицаАртикулов.Добавить();	
				НоваяСтрока.Артикул = ЧтениеXML.Значение;
				НоваяСтрока.НомерРаздела = НомерРазделаГТД;
				
			КонецЕсли;				
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда	
			
			СтекИмен.Удалить(СтекИмен.Количество() - 1);
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Комментарий Тогда 
			
			Если СтрНайти(ЧтениеXML.Значение, "ND") <> 0 Тогда 
				НомерНачальногоСимвола = СтрНайти(ЧтениеXML.Значение, "=")+1;
				НомерДляПоиска = Сред(ЧтениеXML.Значение,НомерНачальногоСимвола, СтрДлина(ЧтениеXML.Значение));
				ОсновнойРаздел.Вставить("НомерДляПоиска", НомерДляПоиска);
				Номер = СтрЗаменить(НомерДляПоиска, "/", "");
			КонецЕсли;	
				
		КонецЕсли;	
		
	КонецЦикла;	 
	
	ТаблицаАртикулов.Свернуть("Артикул, НомерРаздела");
	
	Груз = смарт_НайтиГрузПоНомеруДекларации(ОсновнойРаздел.Получить("НомерДляПоиска"), СтрокаОшибки);
	
	Если Груз = Неопределено Тогда 
		Возврат;
	Иначе
		ОсновнойРаздел.Вставить("Груз", Груз);
	КонецЕсли;
	
	Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Груз, "СкладПолучатель");
	
	Если ЗначениеЗаполнено(Склад) Тогда 
		
		Для Каждого СтрокаТаблицыРазделов Из РазделыГТД Цикл 		
			СтрокаТаблицыРазделов.Склад = Склад;
		КонецЦикла;	
		
	КонецЕсли;	
	
	ОсновнойРаздел.Вставить("Статус", Перечисления.СтатусыТаможенныхДеклараций.ВыпущеноСТаможни);
	ОсновнойРаздел.Вставить("Валюта", Справочники.Валюты.НайтиПоКоду("643"));
	ОсновнойРаздел.Вставить("Комментарий", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Груз, "Наименование"));
	
	РазделРасчеты.Вставить("ВариантОформления", Перечисления.ХозяйственныеОперации.ОформлениеГТДСамостоятельно);
	КонтрагентТаможни = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", "7730176610");
	
	Если КонтрагентТаможни <> Справочники.Контрагенты.ПустаяСсылка() Тогда 
		РазделРасчеты.Вставить("Контрагент", КонтрагентТаможни);
		Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонтрагентТаможни, "Партнер");
		
		Если ЗначениеЗаполнено(Партнер) Тогда 
			РазделРасчеты.Вставить("Партнер", Партнер);
		КонецЕсли;
		
		Договор = смарт_ПолучитьДействующийДоговорКонтрагента(КонтрагентТаможни);
		
		Если Договор <> Неопределено Тогда 
			РазделРасчеты.Вставить("Договор", Договор);
		КонецЕсли;
		
	Иначе
		
		РазделРасчеты.Вставить("Контрагент", Неопределено);
		РазделРасчеты.Вставить("Партнер", Неопределено);
		РазделРасчеты.Вставить("Договор", Неопределено);
		
	КонецЕсли;
	
	РазделРасчеты.Вставить("СтатьяРасходовСбор", ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("ЦБ-000183"));
	
	Для Каждого ТекРеквизит Из Объект.Ссылка.Метаданные().Реквизиты Цикл 
		
		РеквизитОсновногоРаздела = ОсновнойРаздел.Получить(ТекРеквизит.Имя);
		РеквизитРазделаРасчеты = РазделРасчеты.Получить(ТекРеквизит.Имя);
		Если РеквизитОсновногоРаздела <> Неопределено Тогда 
			Объект[ТекРеквизит.Имя] = РеквизитОсновногоРаздела;
		ИначеЕсли РеквизитРазделаРасчеты <> Неопределено Тогда 
			Объект[ТекРеквизит.Имя] = РеквизитРазделаРасчеты;
		Иначе
			Объект[ТекРеквизит.Имя] = Неопределено;			
		КонецЕсли;
		
	КонецЦикла;	
	
	Объект.Дата = ОсновнойРаздел.Получить("Дата");
	Объект.НомерДекларации = Номер;
	Объект.ДатаПлатежа = ОсновнойРаздел.Получить("Дата");
	Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	Объект.ВалютаВзаиморасчетов = ОсновнойРаздел.Получить("Валюта");
	ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
		
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда 
		Объект.Менеджер = ТекущийПользователь;
		Объект.Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийПользователь, "Подразделение");
	КонецЕсли;
	
	Объект.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
	Объект.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
	
	
	ЗаполнитьПоГрузуНаСервере();
	КоличествоРазделовПоГрузу = Объект.Разделы.Количество();
	
	Если КоличествоРазделовПоГрузу > 1 Тогда 
		
		Индекс = КоличествоРазделовПоГрузу - 1;
	
		Пока Индекс > 0 Цикл    
			Объект.Разделы.Удалить(Индекс);
			Индекс = Индекс - 1;
		КонецЦикла;
			
	КонецЕсли;
	
	Объект.Разделы[0].НомерРаздела = 999;
	
	МассивСтрокНаУдаление = Новый Массив;
	
	Контрагент = Неопределено;
	
	
	
	 //++ смарт:ЩукинВВ #0-000033073 623 02.11.2021
	
	
	

	
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		СтрокаТоваров.НомерРаздела = 999;
		
				Если Не ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(СтрокаТоваров.ДокументПоступления) И ЗначениеЗаполнено(СтрокаТоваров.ДокументПоступления.Контрагент) Тогда
			Контрагент = СтрокаТоваров.ДокументПоступления.Партнер;
			Объект.Поставщик = Контрагент.Ссылка;
			ПартнерыИКонтрагенты.ЗаполнитьКонтрагентаПартнераПоУмолчанию(Объект.Поставщик, Объект.КонтрагентПоставщика);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда 			
			АртикулБазы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТоваров.Номенклатура, "Артикул");
			
			
			СтрокаТоваров.Артикул = ВРег(АртикулБазы); 
			
			Для Каждого СтрокаАртикулов Из ТаблицаАртикулов Цикл				
				СтрокаНайдена = 0 <> СтрНайти(СтрокаТоваров.Артикул, ВРег(СтрокаАртикулов.Артикул));
				
				Если СтрокаНайдена Тогда
					СтрокаТоваров.НомерРаздела = СтрокаАртикулов.НомерРаздела;
					Прервать;
				КонецЕсли;	
				
								
				
				СтрокаНайдена = 0 <> СтрНайти(ВРег(СтрокаАртикулов.Артикул),СтрокаТоваров.Артикул);
				
				Если СтрокаНайдена Тогда
					СтрокаТоваров.НомерРаздела = СтрокаАртикулов.НомерРаздела;
					Прервать;
				КонецЕсли;	
				
				
				
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтрокаТоваров.ДокументПоступления) Тогда 
				Стоимость = смарт_ПолучитьСтоимостьНоменклатуры(СтрокаТоваров.Номенклатура, СтрокаТоваров.ДокументПоступления);
				СтрокаТоваров.ТаможеннаяСтоимость = СтрокаТоваров.КоличествоУпаковок * Стоимость;
			КонецЕсли;	
			
		КонецЕсли;
		
		СтрокаТоваров.ПорядковыйНомерТовара = СтрокаТоваров.НомерРаздела;
		
	КонецЦикла;
	
	 //-- смарт:ЩукинВВ #0-000033073 623 02.11.2021

	
	
	Для Каждого СтрокаРазделыГТД Из РазделыГТД Цикл 
		
		НоваяСтрокаРазделы = Объект.Разделы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРазделы, СтрокаРазделыГТД);
		
	КонецЦикла;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("НомерРаздела", 999);
	НераспределенныеСтроки = Объект.Товары.НайтиСтроки(ПараметрыПоиска);
	
	Если НераспределенныеСтроки.Количество() > 0 Тогда 
		СтрокаОшибки = "Имеются нераспределенные строки. Информация по ним содержится в разделе с номеро 999";	
	Иначе
		Объект.Разделы.Удалить(0);
