&После("ПриЗаписи")
Процедура смарт_ПриЗаписи(Отказ)
	
	смартЭтоНовый = Неопределено;
	
	Если ДополнительныеСвойства.Свойство("смартЭтоНовый", смартЭтоНовый) И НЕ Отказ Тогда
		
		Если смартЭтоНовый = Истина Тогда
			
			// Отправка уведомления о создании нового документа на почту
			//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
			//МассивАдресовДляОтправки = смартПолучитьАдресаПолучателейУведомлений();
			АдресаДляОтправкиСтрокой = "";
			МассивАдресовДляОтправки = смартПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой);
			//-- смарт:ММ 04.03.2021
			
			УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
			
			//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
			//Если ЗначениеЗаполнено(УчетнаяЗапись) И МассивАдресовДляОтправки.Количество() > 0 Тогда
			ТестовыеАдресаСтрока = "";
			ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
			
			//++ #Б-6072 смарт: Фролов 20.03.2026 //Настроить автоматическое уведомление для сотрудников склада при создании документа "таможенная декларация".
			МассивАдресов = Справочники.смартПредопределенныеЗначения.Настройки.АдресаДляРассылкиПоТаможеннойДекларации.ВыгрузитьКолонку("Адрес");	
			
			Для Каждого ЭлементАдрес Из МассивАдресов Цикл

				АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(ЭлементАдрес);
				
				Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
					
					Если НЕ ЗначениеЗаполнено(ЭлементСтруктуры.ОписаниеОшибки) Тогда
						МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
						АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЦикла;
			
			СсылкаНаДокумент = ПолучитьНавигационнуюСсылку(Ссылка);
			//-- #Б-Задача смарт: Фролов 20.03.2026
			
			ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
			
			Если ЗначениеЗаполнено(УчетнаяЗапись)
				И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
			//-- смарт:ММ 03.03.2021
			
				ТемаПисьма = "Создан новый документ " + Ссылка;
				ТекстПисьма = "Создан новый документ " + Ссылка + " 
				//++ #Б-6072 смарт: Фролов 20.03.2026 //Настроить автоматическое уведомление для сотрудников склада при создании документа "таможенная декларация".
				|
				|Поставщик: """ + Ссылка.Поставщик + "
				|
				|Номер декларации: """ + Ссылка.НомерДекларации + "
				//-- #Б-Задача смарт: Фролов 20.03.2026
				|
				|Комментарий: """ + Ссылка.Комментарий + """";
				
				//++ #Б-6072 смарт: Фролов 20.03.2026 //Настроить автоматическое уведомление для сотрудников склада при создании документа "таможенная декларация".
				ТекстПисьма = ТекстПисьма + Символы.ПС + "Ссылка на документ: " + СсылкаНаДокумент;
				//-- #Б-Задача смарт: Фролов 20.03.2026
				
				ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
				
				//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
				//ПараметрыПисьма = ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки);
				ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки,, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
				//-- смарт:ММ 04.03.2021
				
				Попытка
					ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
					//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
					Если ПараметрыПисьма.ТестоваяБаза Тогда
						ТекстСообщения = "Отправлено уведомление о создании документа " + Ссылка + Символы.ПС + " НА ТЕСТОВУЮ ПОЧТУ " +  ПараметрыПисьма.ТестовыеАдреса + " (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";	
					Иначе				
						ТекстСообщения = "Отправлено уведомление о создании документа " + Ссылка + Символы.ПС + " на почту: " + АдресаДляОтправкиСтрокой;				
					КонецЕсли;
					
					ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Информация,,, ТекстСообщения);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					//-- смарт:ММ 03.03.2021
				Исключение 
					//++ #1416 смарт: Фролов 30.08.2023 //Механизм формирования заявок на склад Адмирал Внуково и Адмирал Внуково КОВЧЕГ 
					смартОбщегоНазначения.смартЗафиксироватьНеОтправленноеПисьмо(ПараметрыПисьма,Ссылка,ТекстПисьма);
					//-- #1416 смарт: Фролов 30.08.2023
					ЗаписьЖурналаРегистрации("ОтправкаУведомления", УровеньЖурналаРегистрации.Ошибка,,, "Не удалось отправить уведомление о создании документа " + Ссылка + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
			
КонецПроцедуры //-- смарт:ММ 02.12.2019

//++ смарт:ММ #002 123 02.12.2019
//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
//Функция смартПолучитьАдресаПолучателейУведомлений()
Функция смартПолучитьАдресаПолучателейУведомлений(АдресаДляОтправкиСтрокой)
//-- смарт:ММ 04.03.2021
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	смартПредопределенныеЗначения.Значение КАК Пользователь
	|ПОМЕСТИТЬ ВТ_СписокПользователей
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения КАК смартПредопределенныеЗначения
	|ГДЕ
	|	смартПредопределенныеЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначения.СписокЗначений = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	смартПредопределенныеЗначенияЗначения.Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &Ссылка
	|	И смартПредопределенныеЗначенияЗначения.Ссылка.СписокЗначений = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПользователиСпр.смартРабочаяПочта КАК смартРабочаяПочта
	|ИЗ
	|	ВТ_СписокПользователей КАК ВТ_СписокПользователей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиСпр
	|		ПО ВТ_СписокПользователей.Пользователь = ПользователиСпр.Ссылка
	|ГДЕ 
	|	ЕСТЬNULL(ПользователиСпр.смартРабочаяПочта, """") <> """"";
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.смартПредопределенныеЗначения.ПользовательДляУведомленийОСозданииТаможеннойДекларации);
	
	МассивАдресов = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		АдресаТекущегоПоля = ОбщегоНазначенияКлиентСервер.АдресаЭлектроннойПочтыИзСтроки(Выборка.смартРабочаяПочта);
		
		Для Каждого ЭлементСтруктуры Из АдресаТекущегоПоля Цикл
			МассивАдресов.Добавить(Новый Структура("Адрес,Представление", ЭлементСтруктуры.Адрес, ЭлементСтруктуры.Адрес));
			//++ смарт:ММ #098 464 04.03.2021 Доработка рассылок на тестовые адреса
			АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") + ЭлементСтруктуры.Адрес;
			//-- смарт:ММ 04.03.2021
		КонецЦикла;
		
	КонецЦикла;
		
	Возврат МассивАдресов;
	
КонецФункции //-- смарт:ММ 02.12.2019

