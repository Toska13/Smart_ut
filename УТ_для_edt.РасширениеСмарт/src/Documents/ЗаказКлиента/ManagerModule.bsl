// Фролов+
Процедура СнятьСогласованиеБухВЧастичноОтгруженныхЗаказах(Заказы,Комментарий="")Экспорт  
	Запрос=Новый Запрос("ВЫБРАТЬ
	|ЗаказыКлиентовОстатки.ЗаказКлиента КАК Заказ
	|ИЗ
	|РегистрНакопления.ЗаказыКлиентов.Остатки(
	|		,
	|		ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
	|			И ЗаказКлиента В (&Заказ)) КАК ЗаказыКлиентовОстатки
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки(
	|			,
	|			ДокументОтгрузки ССЫЛКА Документ.ЗаказКлиента
	|				И ДокументОтгрузки В (&Заказ)) КАК ТоварыКОтгрузкеОстатки
	|	ПО (ТоварыКОтгрузкеОстатки.ДокументОтгрузки = ЗаказыКлиентовОстатки.ЗаказКлиента)
	|ГДЕ ЕСТЬNULL(ЗаказыКлиентовОстатки.ЗаказаноОстаток,0)>0
	|И (&ПроверятьПоРеализации ИЛИ
	|	ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток,0) - ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КСборкеОстаток,0) - ЕСТЬNULL(ТоварыКОтгрузкеОстатки.СобираетсяОстаток,0) - ЕСТЬNULL(ТоварыКОтгрузкеОстатки.СобраноОстаток,0)>0)");
	
	Запрос.УстановитьПараметр("Заказ",Заказы);
	Запрос.УстановитьПараметр("ПроверятьПоРеализации",Константы.ПорядокОформленияНакладныхРасходныхОрдеров.Получить()=Перечисления.ПорядокОформленияНакладныхРасходныхОрдеров.СначалаНакладные);
	Рез=Запрос.Выполнить().Выбрать();
	Пока Рез.Следующий() Цикл 
		ЗаказОбъект=Рез.Заказ.ПолучитьОбъект();
		ЗаказОбъект.СогласованоБух=Ложь;
		ЗаказОбъект.ДополнительныеСвойства.Вставить("ВерсионированиеОбъектовКомментарийКВерсии",Комментарий);
		
		Попытка
			ЗаказОбъект.Записать();
		Исключение
			Сообщить("В заказе "+Рез.Заказ+" не удалось снять галочку 'Согласовано Фин'. "+ОписаниеОшибки());
		КонецПопытки;	
	КонецЦикла;	
КонецПроцедуры

Функция ЕстьСервисныеУслуги(Заказ)Экспорт
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Заказ);
	Запрос.УстановитьПараметр("ВидНоменклатуры",Справочники.ВидыНоменклатуры.ПолучитьВидыНоменклатурыСЦ());
	Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
	             |	ИСТИНА КАК ЕстьУслугаСЦ
	             |ИЗ
	             |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	             |ГДЕ
	             |	ЗаказКлиентаТовары.Ссылка = &Ссылка
	             |	И ЗаказКлиентаТовары.Номенклатура.ВидНоменклатуры В(&ВидНоменклатуры)
	             |	И НЕ ЗаказКлиентаТовары.Отменено
				 |	И ЗаказКлиентаТовары.Ссылка.Дата >= ДАТАВРЕМЯ(2019,7,1)";
	Рез=Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда 
		Возврат Рез.ЕстьУслугаСЦ;
	КонецЕсли;	
	Возврат Ложь;
КонецФункции

// Смарт Процедура записи ответственного за установку галочки "Оригиналы документов получены"
Процедура УстановитьПодписавшегоДокумент(Ссылка)Экспорт 
	МЗ=РегистрыСведений.ДополнительныеСведения.СоздатьМенеджерЗаписи();
	МЗ.Объект=Ссылка;
	МЗ.Значение=Пользователи.ТекущийПользователь();
	МЗ.Свойство=ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя","ПодписавшийДокумент");
	
	УстановитьПривилегированныйРежим(Истина);
	МЗ.Записать();
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Смарт 
// Функция проверяет выставлен ли Счет на оплату (распечатан, сохранет или отправлен по почте) по переданному заказу
// Входной параметр Заказ - Тип("СсылкаДокументЗаказКлиента")
// Возвращаемое значение Тип("Булево")
Функция СчетНаОплатуУжеВыставлен(Заказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Данные=РегистрыСведений.смартРегистрацияОтправкиСчета.Получить(Новый Структура("Заказ",Заказ));
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Данные.Свойство("Пользователь") И Не Данные.Пользователь=Неопределено Тогда 
		Возврат Истина;
	КонецЕсли;	
	Возврат Ложь;
КонецФункции

// Смарт
// Процедура устанавливает признак "Счет на оплату выставлен"
// Входной параметр МассивЗаказов Тип("Массив") ссылки на заказы
Процедура УстановитьПризнакСчетНаОплатуВыставлен(МассивЗаказов,ИмяУстроуства="",Действие) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Для Каждого Заказ Из МассивЗаказов Цикл
		Если ТипЗнч(Заказ)=Тип("ДокументСсылка.ЗаказКлиента") Тогда 
			МЗ=РегистрыСведений.смартРегистрацияОтправкиСчета.СоздатьМенеджерЗаписи();
			МЗ.Заказ=Заказ;
			МЗ.ДатаПечати=ТекущаяДатаСеанса();
			МЗ.Пользователь=Пользователи.ТекущийПользователь();
			МЗ.Устройство=?(ПустаяСтрока(ИмяУстроуства),ИмяКомпьютера(),ИмяУстроуства);
			МЗ.Действие=Действие;
			МЗ.Записать();
		КонецЕсли;
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

// Смарт
// Процедура очищает запись в регистре сведений "смарт_РегистрацияОтправкиСчета" если заказ уже закрыт
Процедура СнятьПризнакСчетНаОплатуВыставлен(Заказ) Экспорт 
	УстановитьПривилегированныйРежим(Истина);
	
	МЗ=РегистрыСведений.смартРегистрацияОтправкиСчета.СоздатьМенеджерЗаписи();
	МЗ.Заказ=Заказ;
	МЗ.Прочитать();
	МЗ.Удалить();
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры	
// Фролов-

&ИзменениеИКонтроль("ЗаполнитьВариантОбеспечения")
Функция смарт_ЗаполнитьВариантОбеспечения(Объект, Форма, Операция, ДанныеЗаполнения, ПараметрыУказанияСерий, ЗависимыеРеквизиты)
	
	#Вставка
	//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
	ЗаполнитьДатыОтгрузки = Ложь;
	ДатаПоУмолчанию = Макс(НачалоДня(ТекущаяДатаСеанса()), Объект.ЖелаемаяДатаОтгрузки);

	ПараметрыОбновленияДатыОтгрузки = ОбеспечениеСервер.ПараметрыОбновленияДатыОтгрузкиВДокументе();
	ПараметрыОбновленияДатыОтгрузки.ОтгружатьОднойДатой    = Объект.НеОтгружатьЧастями;
	ПараметрыОбновленияДатыОтгрузки.ЖелаемаяДатаОтгрузки   = Объект.ЖелаемаяДатаОтгрузки;
	ПараметрыОбновленияДатыОтгрузки.ДатаОтгрузкиВДокументе = Объект.ДатаОтгрузки;
	
	ОбеспечениеСервер.СдвинутьДатыИСвернутьДублиСтрок(ДанныеЗаполнения, Операция, ПараметрыОбновленияДатыОтгрузки);
	
	Для Каждого СтрокаОбеспечения Из ДанныеЗаполнения Цикл

		Идентификатор = СтрокаОбеспечения.Идентификатор;
		Если Операция = "СтрокаТовары" Или Операция = "СтрокиТовары" Или Операция = "Заказ" Тогда
			СтрокаТовары = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
		ИначеЕсли Операция = "ИндексыСтрок" Тогда
			СтрокаТовары = Объект.Товары[Идентификатор];
		КонецЕсли;

		Если СтрокаОбеспечения.ВариантОбеспечения <> Перечисления.ВариантыОбеспечения.ИзЗаказов Тогда
			//++ смарт:ММ #055 315 14.07.2020 - Текущая дата отгрузки (игнорирование настроек)  
			СтрокаТовары.ДатаОтгрузки = ТекущаяДата();
			//-- смарт:ММ 14.07.2020
			СтрокаОбеспечения.ДатаОтгрузки = СтрокаТовары.ДатаОтгрузки;
		КонецЕсли;	
		
		Если Объект.НеОтгружатьЧастями Тогда
			ДатаПоУмолчанию = Макс(СтрокаОбеспечения.ДатаОтгрузки, ДатаПоУмолчанию);
			Если Операция = "Заказ" Или Операция = "ИндексыСтрок" Или ДатаПоУмолчанию > Объект.ДатаОтгрузки И СтрокаОбеспечения.Отгружено = 0 Тогда
				Объект.ДатаОтгрузки = ДатаПоУмолчанию;
				ЗаполнитьДатыОтгрузки = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

	Если ЗаполнитьДатыОтгрузки Тогда
		ОбеспечениеСервер.ЗаполнитьРеквизитВКоллекции(Объект.Товары, "ДатаОтгрузки", Объект.ДатаОтгрузки);
	КонецЕсли;
	
	ДанныеЗаполнения = смартОбщегоНазначения.смартЗаполнитьОбеспечениеСериямиПоFEFO(Объект, Форма, Операция, ДанныеЗаполнения, ПараметрыУказанияСерий);
	//--#1547 смарт: Лопато 20.11.2023
	#КонецВставки
	
	ЭтоВыборОбеспеченияСУчетомСерий = Операция = "СтрокаТовары"
		И ПолучитьФункциональнуюОпцию("ИспользоватьРасширеннуюФормуПодбораКоличестваИВариантовОбеспечения");
	СкладГруппа = Справочники.Склады.ЭтоГруппаИСкладыИспользуютсяВТЧДокументовПродажи(Объект.Склад);
	СтруктураДействий = Новый Структура;

	Реквизиты = "КоличествоУпаковок";
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.СтруктураПересчетаСуммы(Реквизиты);
	ИзмененныеСтроки = Новый Массив();

	Если Форма <> Неопределено Тогда
		СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект, СкладГруппа));
		СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
			Новый Структура("ЕстьРаботы, ЕстьОтменено", Истина, Истина));
	КонецЕсли;
	
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();

	ЗаполнитьДатыОтгрузки = Ложь;
	ДатаПоУмолчанию = Макс(НачалоДня(ТекущаяДатаСеанса()), Объект.ЖелаемаяДатаОтгрузки);

	ТекСтрокаТовары = Неопределено;
	Идентификатор   = Неопределено;
	СтарыеЗначения = ОбеспечениеКлиентСервер.КлючОбеспечения();
	НовыеЗначения  = ОбеспечениеКлиентСервер.КлючОбеспечения();
	Счетчик = 0;
	Добавлено = 0;
	
	ПараметрыОбновленияДатыОтгрузки = ОбеспечениеСервер.ПараметрыОбновленияДатыОтгрузкиВДокументе();
	ПараметрыОбновленияДатыОтгрузки.ОтгружатьОднойДатой    = Объект.НеОтгружатьЧастями;
	ПараметрыОбновленияДатыОтгрузки.ЖелаемаяДатаОтгрузки   = Объект.ЖелаемаяДатаОтгрузки;
	ПараметрыОбновленияДатыОтгрузки.ДатаОтгрузкиВДокументе = Объект.ДатаОтгрузки;
	
	ОбеспечениеСервер.СдвинутьДатыИСвернутьДублиСтрок(ДанныеЗаполнения, Операция, ПараметрыОбновленияДатыОтгрузки);
	
	Для Каждого СтрокаОбеспечения Из ДанныеЗаполнения Цикл

		// Выбор существующей, либо добавление новой строки.
		Если Идентификатор <> СтрокаОбеспечения.Идентификатор Тогда

			Идентификатор = СтрокаОбеспечения.Идентификатор;
			Если Операция = "СтрокаТовары" Или Операция = "СтрокиТовары" Или Операция = "Заказ" Тогда
				СтрокаТовары = Объект.Товары.НайтиПоИдентификатору(Идентификатор);
			ИначеЕсли Операция = "ИндексыСтрок" Тогда
				СтрокаТовары = Объект.Товары[Идентификатор + Добавлено];
			КонецЕсли;
			ТекСтрокаТовары = СтрокаТовары;

			ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммы(СтруктураПересчетаСуммы);
			ОбработкаТабличнойЧастиКлиентСервер.ЗаполнитьСтруктуруПересчетаСуммы(СтруктураПересчетаСуммы, ТекСтрокаТовары);

		Иначе
			ТекСтрокаТовары = Объект.Товары.Вставить(Объект.Товары.Индекс(ТекСтрокаТовары) + 1);
			ЗаполнитьЗначенияСвойств(ТекСтрокаТовары, СтрокаТовары);
			ТекСтрокаТовары.КодСтроки = 0;
			Добавлено = Добавлено + 1;
		КонецЕсли;
		
		ИзмененныеСтроки.Добавить(Новый Структура("Идентификатор,Строка", Идентификатор, ТекСтрокаТовары));
		
		// Заполнение полей обеспечения.
		ЗаполнитьЗначенияСвойств(СтарыеЗначения, ТекСтрокаТовары);
		
		ЗаполнитьЗначенияСвойств(ТекСтрокаТовары, СтрокаОбеспечения, "Количество, ВариантОбеспечения, Склад, ДатаОтгрузки");
		#Удаление
		Если ЭтоВыборОбеспеченияСУчетомСерий Тогда
	    #КонецУдаления
		#Вставка
		//++#1547 смарт: Лопато 20.11.2023 //Автоматическое заполнение серий чернил в заказах
		//++#1815 смарт: Лопато 13.05.2024 //Проблема со сбросом серийных номеров при изменении обеспечения  
		Если ТекСтрокаТовары.СтатусУказанияСерий <> 0
			И НЕ (Форма = Неопределено И Операция = "ИндексыСтрок")
			И смартОбщегоНазначения.смартДействуетОсобыйУчетСерий(ТекСтрокаТовары.Номенклатура) Тогда
		//--#1815 смарт: Лопато 13.05.2024
		//--#1547 смарт: Лопато 20.11.2023
	    #КонецВставки
			ТекСтрокаТовары.Серия = СтрокаОбеспечения.Серия;
		КонецЕсли;
		#Удаление
		Если Объект.НеОтгружатьЧастями Тогда
			ДатаПоУмолчанию = Макс(СтрокаОбеспечения.ДатаОтгрузки, ДатаПоУмолчанию);
			Если Операция = "Заказ" Или Операция = "ИндексыСтрок" Или ДатаПоУмолчанию > Объект.ДатаОтгрузки И СтрокаОбеспечения.Отгружено = 0 Тогда
				Объект.ДатаОтгрузки = ДатаПоУмолчанию;
				ЗаполнитьДатыОтгрузки = Истина;
			КонецЕсли;
		КонецЕсли;
	    #КонецУдаления

		ЗаполнитьЗначенияСвойств(НовыеЗначения, ТекСтрокаТовары);
		ОбеспечениеКлиентСервер.СчетИзменений(Счетчик, СтарыеЗначения, НовыеЗначения);

		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекСтрокаТовары, СтруктураДействий, КэшированныеЗначения);
		ОбработкаТабличнойЧастиКлиентСервер.ДобавитьСтрокуДляПересчетаСуммы(СтруктураПересчетаСуммы, ТекСтрокаТовары);

	КонецЦикла;

	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммы(СтруктураПересчетаСуммы);

	СтруктураПересчета = ОбработкаТабличнойЧастиКлиентСервер.СтруктураПересчетаСуммы(
		"Сумма,СуммаНДС,СуммаСНДС,СуммаРучнойСкидки,СуммаАвтоматическойСкидки",
		ЗависимыеРеквизиты,
		"КоличествоУпаковок");
	ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьРеквизитыВИзмененныхСтроках(ИзмененныеСтроки, СтруктураПересчета);

	Если ПараметрыУказанияСерий = Неопределено Тогда
		ПараметрыУказанияСерий = Новый ФиксированнаяСтруктура(НоменклатураСервер.ПараметрыУказанияСерий(Объект, Документы.ЗаказКлиента));
	КонецЕсли;
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	#Удаление
	Если ЗаполнитьДатыОтгрузки Тогда
		ОбеспечениеСервер.ЗаполнитьРеквизитВКоллекции(Объект.Товары, "ДатаОтгрузки", Объект.ДатаОтгрузки);
	КонецЕсли;
    #КонецУдаления
	Если Операция = "СтрокаТовары" Или Операция = "СтрокиТовары" Или Операция = "Заказ" Тогда
		Форма.Модифицированность = Истина;
	КонецЕсли;
	Возврат ОбеспечениеКлиентСервер.ТекстОбработаноСтрок(Счетчик);
	
КонецФункции

&ИзменениеИКонтроль("ПолучитьДанныеДляПечатнойФормыСчетаНаОплату")
//++ #1794 смарт: Фролов 24.04.2024 //Запрет печати счета из Заказа клиента если в нем есть оборудование и он создан не на основании Интереса.
Функция смарт_ПолучитьДанныеДляПечатнойФормыСчетаНаОплату(ПараметрыПечати, МассивОбъектов)
	
	#Удаление
	Возврат ДанныеДляПечатныхФормСчетаНаОплатуИзвещения(ПараметрыПечати, МассивОбъектов);
	#КонецУдаления
	
	#Вставка
	Если Справочники.смартПредопределенныеЗначения.КонтролироватьНаличиеИнтересаВЗаказеКлиента.Значение = Истина Тогда
		
		МассивОбъектовДляПечати = Новый Массив;
		
		СегментОборудование=Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул","СегментАппаратноеОбеспечение"); 
		ТЗНоменклатураСегмента = СегментыСервер.СписокЭлементовСКД(СегментОборудование);
		МасОборудование=ТЗНоменклатураСегмента.ВыгрузитьКолонку("ЭлементСписка");
		
		Для Каждого СтрМассивОбъектов Из МассивОбъектов Цикл
			
			//++ #1863 смарт: Фролов 14.06.2024 //Доработка механизма запрета печати счета без привязанного Интереса
			Если СтрМассивОбъектов.Дата < Дата("20240501") Тогда
				
				МассивОбъектовДляПечати.Добавить(СтрМассивОбъектов);
				Продолжить;
				
			КонецЕсли;
			//-- #1863 смарт: Фролов 14.06.2024
			
			//++ #Б-3430 смарт: Фролов 29.05.2025 //Документ "Заказ клиента". Ограничение продажи СНПЧ.
			СписокИсполнителей = CRM_БизнесПроцессыСервер.ПолучитьВозможныхИсполнителейПоРоли(
									Справочники.РолиИсполнителей.смартСогласователиПродажСНПЧ);
									
			Если СписокИсполнителей.НайтиПоЗначению(Пользователи.ТекущийПользователь()) = Неопределено Тогда
				
				Если Не СтрМассивОбъектов.смартСогласованиеПродажиСНПЧ = Перечисления.РезультатыСогласования.Согласовано
					И Не СтрМассивОбъектов.смартСогласованиеПродажиСНПЧ = Перечисления.РезультатыСогласования.НаСогласовании Тогда
					
					Запрос = Новый Запрос(
					"ВЫБРАТЬ
					|	1 КАК ПлоттерыМимаки,
					|	0 КАК СистемаНепрерывнойПодачиЧернил
					|ПОМЕСТИТЬ Предварительная
					|ИЗ
					|	Документ.ЗаказКлиента.Товары
					|ГДЕ
					|	Ссылка = &Ссылка
					|	И Номенклатура В ИЕРАРХИИ(&ПлоттерыМимаки)
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	0,
					|	1
					|ИЗ
					|	Документ.ЗаказКлиента.Товары
					|ГДЕ
					|	Ссылка = &Ссылка
					|	И Номенклатура В ИЕРАРХИИ(&СистемаНепрерывнойПодачиЧернил)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	СУММА(Предварительная.ПлоттерыМимаки) КАК ПлоттерыМимаки,
					|	СУММА(Предварительная.СистемаНепрерывнойПодачиЧернил) КАК СистемаНепрерывнойПодачиЧернил
					|ИЗ
					|	Предварительная КАК Предварительная");
					Запрос.УстановитьПараметр("ПлоттерыМимаки", Справочники.смартПредопределенныеЗначения.Настройки.ПлоттерыМимаки);
					Запрос.УстановитьПараметр("СистемаНепрерывнойПодачиЧернил", Справочники.смартПредопределенныеЗначения.Настройки.СистемаНепрерывнойПодачиЧернил);
					Запрос.УстановитьПараметр("Ссылка", СтрМассивОбъектов.Ссылка);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Если Выборка.Следующий() Тогда
						
						Если Выборка.СистемаНепрерывнойПодачиЧернил > 0 И Выборка.ПлоттерыМимаки = 0 Тогда
							
							ОбщегоНазначения.СообщитьПользователю("Внимание! В заказе № " + СтрМассивОбъектов.Номер + " присутствуют системы непрерывной подачи чернил,
							|и отсутствует оборудование МИМАКИ. Требуется согласование!
							|Для согласования, войдите в документ и на закладке Товары, нажмите кнопку ""Отпрравить на согласование СНПЧ.""");
							Продолжить;
							
						КонецЕсли;	
						
					КонецЕсли;	
				
				КонецЕсли;
				
			КонецЕсли;	
			//-- #Б-3430 смарт: Фролов 29.05.2025
			
			Если НЕ (СтрМассивОбъектов.Партнер.Дилер ИЛИ СтрМассивОбъектов.Партнер.смартДилерСервисЦентра) 
				И НЕ смартОбщегоНазначения.ПроверитьНаличиеИнтересаПоЗаказу(СтрМассивОбъектов) Тогда
				
				ЕстьОборудование = Ложь;
				
				Для Каждого Стр Из СтрМассивОбъектов.Товары Цикл
					
					Если НЕ МасОборудование.Найти(Стр.Номенклатура)=Неопределено Тогда
						ЕстьОборудование = Истина;
					КонецЕсли;
					
				КонецЦикла;
				
				Если ЕстьОборудование Тогда
					
					ОбщегоНазначения.СообщитьПользователю("Внимание! В заказе № " + СтрМассивОбъектов.Номер + " есть оборудование! Печать счета возможна только из заказов с привязанным Интересом!");
					
				Иначе	
					
					МассивОбъектовДляПечати.Добавить(СтрМассивОбъектов);
					
				КонецЕсли;
				
			Иначе
				
				МассивОбъектовДляПечати.Добавить(СтрМассивОбъектов);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивОбъектовДляПечати.Количество() > 0 Тогда
			
			Возврат ДанныеДляПечатныхФормСчетаНаОплатуИзвещения(ПараметрыПечати, МассивОбъектовДляПечати);
			
		Иначе	
			
			Возврат Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Возврат ДанныеДляПечатныхФормСчетаНаОплатуИзвещения(ПараметрыПечати, МассивОбъектов);
		
	КонецЕсли;
	#КонецВставки

КонецФункции //-- #1794 смарт: Фролов 24.04.2024

