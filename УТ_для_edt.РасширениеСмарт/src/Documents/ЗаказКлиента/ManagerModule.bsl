	Возврат СтруктураДанныхДляПечати;

КонецФункции //-- #Б-1810 смарт: Фролов 28.01.2025

//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
Функция ВЗаказеТолькоРасходныеМатериалы(Заказ) Экспорт
	
	СегментРасходка = смартОбщегоНазначенияСКэш.ПолучитьСегментНоменклатурыПоИдентификатору("СегментРасходныеМатериалы");
	СпособФормирования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СегментРасходка, "СпособФормирования");
	Динамический = НЕ СпособФормирования = Перечисления.СпособыФормированияСегментов.ФормироватьВручную;
	ТолькоРасходка = Истина;
	
	Для каждого стрТовары Из Заказ.Товары Цикл
		
		ТолькоРасходка = ТолькоРасходка И СегментыСервер.ВходитВСегмент(стрТовары.Номенклатура, СегментРасходка,, Динамический);
		
		Если НЕ ТолькоРасходка Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТолькоРасходка;
		
КонецФункции

//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
&НаСервере
Функция ДанныеСостоянияЗаказа(Заказ) Экспорт

	Результат = Новый Структура("Оплачен,ОплаченПолностью,Отгружен,ОтгруженПолностью", Ложь, Ложь, Ложь, Ложь);
	
	Если Заказ.Пустая() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
	|	СостоянияЗаказовКлиентов.СуммаОтгрузки КАК СуммаОтгрузки,
	|	СостоянияЗаказовКлиентов.ПроцентОтгрузки КАК ПроцентОтгрузки,
	|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|ГДЕ
	|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Заказ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат.Оплачен = (Выборка.СуммаОплаты > 0);
		Результат.ОплаченПолностью = (Выборка.ПроцентОплаты = 100);
		Результат.Отгружен = (Выборка.СуммаОтгрузки > 0);
		Результат.ОтгруженПолностью = (Выборка.ПроцентОтгрузки = 100);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
&НаСервере
Функция ДоставкаРассчитана(Заказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.СкидкаНаценка КАК СкидкаНаценка,
	|	Т.Сумма КАК Сумма
	|ПОМЕСТИТЬ ВТСкидкиНаценки
	|ИЗ
	|	&СкидкиНаценки КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
	|	СУММА(ВТСкидкиНаценки.Сумма) КАК Сумма
	|ИЗ
	|	ВТСкидкиНаценки КАК ВТСкидкиНаценки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.смартТарифыНаДоставку.СрезПоследних(&ДатаЗаказа, ) КАК смартТарифыНаДоставкуСрезПоследних
	|		ПО ВТСкидкиНаценки.СкидкаНаценка = смартТарифыНаДоставкуСрезПоследних.СкидкаНаценка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСкидкиНаценки.СкидкаНаценка";
	
	Запрос.УстановитьПараметр("ДатаЗаказа", Заказ.Дата);
	Запрос.УстановитьПараметр("СкидкиНаценки", Заказ.СкидкиНаценки.Выгрузить());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&ИзменениеИКонтроль("ТекстЗапросаТаблицаГрафикОтгрузкиТоваров")
Функция смарт_ТекстЗапросаТаблицаГрафикОтгрузкиТоваров(Запрос, ТекстыЗапроса, Регистры)
	ИмяРегистра = "ГрафикОтгрузкиТоваров";

	Если НЕ ПроведениеСерверУТ.ТребуетсяТаблицаДляДвижений(ИмяРегистра, Регистры) Тогда
		Возврат "";
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаТовары.ДатаОтгрузки           КАК Период,
	|	ТаблицаТовары.ДатаОтгрузки           КАК ДатаОтгрузки,
	|
	|	ТаблицаТовары.Номенклатура           КАК Номенклатура,
	|	ТаблицаТовары.Характеристика         КАК Характеристика,
	|	ТаблицаТовары.Склад                  КАК Склад,
	|
	|	ВЫБОР КОГДА ТаблицаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно) ТОГДА
	|			&Назначение
	|		КОНЕЦ                                            КАК Назначение,
	|
	|	ВЫБОР КОГДА ТаблицаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ИзЗаказов) ТОГДА
	|			ТаблицаТовары.Количество
	|		КОНЕЦ                                            КАК КоличествоИзЗаказов,
	|
	|	ВЫБОР КОГДА ТаблицаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно) ТОГДА
	|			ТаблицаТовары.Количество
	|		КОНЕЦ                                            КАК КоличествоПодЗаказ,
	|
	|	ВЫБОР КОГДА ТаблицаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется) ТОГДА
	|			ТаблицаТовары.Количество
	|		КОНЕЦ                                            КАК КоличествоНеобеспечено
	#Вставка
	//++ #5004 смарт: Тимофеева 24.11.2025 / Проверить алгоритм автоматической установки резервов по приходу товаров. 
	|	,ТаблицаТовары.НомерСтроки                  		 КАК  смартНомерСтрокиЗаказа
	//-- #5004 смарт: Тимофеева 24.11.2025
	#КонецВставки
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ТаблицаТовары
	|ГДЕ
	|	ТаблицаТовары.Ссылка = &Ссылка
	|	И НЕ ТаблицаТовары.Отменено
	|
	|	И ТаблицаТовары.Номенклатура.ТипНоменклатуры В(
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар),
	|		ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
	|
	|	И (&Статус В(
	|			ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.КОбеспечению),
	|			ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.КОтгрузке),
	|			ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт))
	|
	|			И ТаблицаТовары.ВариантОбеспечения В(
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Требуется),
	|				ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно))
	|
	|		ИЛИ ТаблицаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ИзЗаказов))";

	ТекстыЗапроса.Добавить(ТекстЗапроса, ИмяРегистра);
	Возврат ТекстЗапроса;

КонецФункции

//++ #5014 смарт: Тимофеева 01.12.2025 / Документ Заказ клиента. Способ доставки. Блокировка изменения.
Функция ЕстьЗаданиеНаПеревозку(Заказ) Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаданиеНаПеревозкуРаспоряжения.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаданиеНаПеревозку.Распоряжения КАК ЗаданиеНаПеревозкуРаспоряжения
	|ГДЕ
	|	ЗаданиеНаПеревозкуРаспоряжения.Распоряжение = &Распоряжение
	|	И ЗаданиеНаПеревозкуРаспоряжения.Ссылка.Проведен
	|	И НЕ ЗаданиеНаПеревозкуРаспоряжения.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийНаПеревозку.Закрыто)"; 
	Запрос.УстановитьПараметр("Распоряжение", Заказ);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Функция ВсеТоварыЗаказаСВариантомОбеспеченияОтгрузить(Товары) Экспорт	
	Результат = Истина;
	Для Каждого СтрокаТовары Из Товары Цикл
		Если СтрокаТовары.Отменено Тогда
			Продолжить;	
		КонецЕсли; 
		Если НЕ СтрокаТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда
			Результат = Ложь;	
		КонецЕсли; 	
	КонецЦикла;
	Возврат Результат;
КонецФункции  

Функция ЕстьНоменклатураСТипомТовар(Товары) Экспорт	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	ЗаказКлиентаТовары.Отменено КАК Отменено
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК ЗаказКлиентаТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО ВТ_Товары.Номенклатура = СпрНоменклатура.Ссылка
	|ГДЕ
	|	НЕ ВТ_Товары.Отменено
	|	И СпрНоменклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)";
	Запрос.УстановитьПараметр("Товары", Товары.Выгрузить());
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции  
