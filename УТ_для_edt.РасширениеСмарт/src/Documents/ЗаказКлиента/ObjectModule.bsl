Процедура ВыполнитьДвиженияПоРаботамСервисногоЦентра(Отказ,РежимПроведения,ДатаВнедренияФункционала)	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("ВидНоменклатуры",Справочники.ВидыНоменклатуры.ПолучитьВидыНоменклатурыСЦ());
	Запрос.УстановитьПараметр("ДатаВнедрения",ДатаВнедренияФункционала);
	Запрос.Текст="
	             |ВЫБРАТЬ
	             |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	             |	Таблица.Ссылка.Дата КАК Период,
	             |	Таблица.Ссылка КАК Регистратор,
	             |	Таблица.Ссылка КАК Заказ,
	             |	Таблица.Ссылка.ДатаЗакрытия КАК ДатаЗакрытия,
	             |	Таблица.Ссылка.смартИсполнительРаботПоЗаказу КАК Инженер,
	             |	Таблица.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт) КАК ЗаказЗакрыт,
	             |	Таблица.Номенклатура КАК Номенклатура,
	             |	Таблица.КоличествоУпаковок КАК Количество,
	             |	Таблица.СуммаСНДС КАК Сумма,
	             |	Таблица.Ссылка.Валюта КАК Валюта
	             |ИЗ
	             |	Документ.ЗаказКлиента.Товары КАК Таблица
	             |ГДЕ
	             |	Таблица.Ссылка = &Ссылка
				 |  И Таблица.Ссылка.Дата >= &ДатаВнедрения
	             |	И Таблица.Номенклатура.ВидНоменклатуры В(&ВидНоменклатуры)
	             |	И Таблица.Ссылка.смартЗаявкаВыполненаПоАкту
	             |	И НЕ Таблица.Отменено";
	
	Движение=Движения.смартРаботыСервисногоЦентра;
	Движение.Записывать=Истина;
	Движение.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры // Фролов-	

// Фролов+
Процедура смартПроверитьЗаполнениеСтатьиДДС(Отказ)
	Если ЗначениеЗаполнено(Соглашение) Тогда 
		Если Не ЗначениеЗаполнено(Соглашение.СтатьяДвиженияДенежныхСредств) Тогда 
			ТекстОшибки = НСтр("ru='В Соглашении не заполнена Статья ДДС.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстОшибки,
				ЭтотОбъект,
				"Соглашение",
				,
				Отказ);
		КонецЕсли;
