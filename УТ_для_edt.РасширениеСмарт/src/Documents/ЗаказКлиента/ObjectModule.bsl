// ЯшниковДА 20180404 +++
 // Процедура проверяет корректность заполнения реквизитов контрагента
 // Добавлено по заданию от бухгалтерии для корректного выставления платежных документов
 //
 // Проверяемые реквизиты:
 //
 // ФизЛицо - Не проверяем.
 // ЮрЛицо - ИНН/КПП/ЮрАдрес.
 // Нерезидент - ЮрАдрес;
 // Индивидуальный предприниматель- ИНН
Процедура ПроверитьКорректностьЗаполненияКонтрагента(Отказ)
	
	ТекстСообщения = "";
		
	// Кэшируемые значения
	КонтрагентСсылка = Контрагент;
	КонтрагентИНН    = КонтрагентСсылка.ИНН;
	КонтрагентКПП	 = КонтрагентСсылка.КПП;
	СтрокаЮрАдрес    = КонтрагентСсылка.КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, "Вид");
	
	// Определяем вид контрагента и вспомогательные переменные для проверки реквизитов.	
	ЭтоЮрЛицо = (КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо);
	ЭтоФизЛицо = (КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
	ЭтоНерезидент = (КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент);
	ЭтоИндивидуальныйПредпрениматель = (КонтрагентСсылка.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель);			
	ВидДляПроверкиТребованийИНН = ОбщегоНазначенияУТКлиентСервер.ЭтоЮрЛицо(КонтрагентСсылка.ЮрФизЛицо);
	
	// Переменные значения
	ИННЗаполненКорректно     = Истина;
	КППЗаполненКорректно     = Истина;
	ЮрАдресЗаполненКорректно = Истина;
	
	// Выполнить проверки
	/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	Если ЭтоФизЛицо Тогда
		
		// Ничего не проверяем
		
	ИначеЕсли ЭтоЮрЛицо Тогда
		
		// ИНН
		Если ПустаяСтрока(КонтрагентИНН)
			Или Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(КонтрагентИНН, ВидДляПроверкиТребованийИНН, ТекстСообщения) Тогда
				ИННЗаполненКорректно = Ложь;
		КонецЕсли;
		// КПП
		Если ПустаяСтрока(КонтрагентКПП) Тогда
			КППЗаполненКорректно = Ложь;
		КонецЕсли;
		// ЮрАдрес
		Если СтрокаЮрАдрес = Неопределено Тогда
			ЮрАдресЗаполненКорректно = Ложь;
		ИначеЕсли СтрокаЮрАдрес <> Неопределено
			И ПустаяСтрока(СтрокаЮрАдрес.Представление) Тогда
			ЮрАдресЗаполненКорректно = Ложь;
		КонецЕсли;
		
	ИначеЕсли ЭтоНерезидент Тогда
		
		// ЮрАдрес
		Если СтрокаЮрАдрес = Неопределено Тогда
			ЮрАдресЗаполненКорректно = Ложь;
		ИначеЕсли СтрокаЮрАдрес <> Неопределено
			И ПустаяСтрока(СтрокаЮрАдрес.Представление) Тогда
			ЮрАдресЗаполненКорректно = Ложь;
		КонецЕсли;

	ИначеЕсли ЭтоИндивидуальныйПредпрениматель Тогда
		
		// ИНН
		Если ПустаяСтрока(КонтрагентИНН)
			Или Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(КонтрагентИНН, ВидДляПроверкиТребованийИНН, ТекстСообщения) Тогда
				ИННЗаполненКорректно = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Сформировать выводы на основании проверок и сообщить ошибки пользователю
	//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	Если Не ИННЗаполненКорректно Тогда
		
		Отказ = Истина;
		
		ТекстСообщения = "Неверный ИНН контрагента";
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			,"Объект.Контрагент",,);
			
	КонецЕсли;
			
	Если Не КППЗаполненКорректно Тогда
		
		Отказ = Истина;
				
		ТекстСообщения = НСтр("ru = 'Неверный КПП контрагента'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ТекстСообщения,,
		"Объект.Контрагент",,);
	
	КонецЕсли;
	
	Если Не ЮрАдресЗаполненКорректно Тогда
		
		Отказ = Истина;
		
		ТекстСообщения = "Неверный юр. адрес контрагента";
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			,"Объект.Контрагент",,);
		
	КонецЕсли;
		
КонецПроцедуры
