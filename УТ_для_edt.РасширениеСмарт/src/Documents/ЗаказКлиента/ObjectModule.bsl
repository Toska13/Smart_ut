				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
				|		ПО (СостоянияЗаказовКлиентов.Заказ = ЗаказКлиента.Ссылка)
				|ГДЕ
				|	ЗаказКлиента.Партнер = &Партнер
				|	И ЗаказКлиента.АдресДоставки = &АдресДоставки
				|	И ЗаказКлиента.ЖелаемаяДатаОтгрузки = &ЖелаемаяДатаОтгрузки
				|	И ЗаказКлиента.СпособДоставки = ЗНАЧЕНИЕ(Перечисление.СпособыДоставки.ДоКлиента)
				|	И ЗаказКлиента.Ссылка <> &Ссылка
				|	И ЗаказКлиента.Проведен
				|	И НЕ СостоянияЗаказовКлиентов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт)
				|	И НЕ СостоянияЗаказовКлиентов.ПроцентОтгрузки = 100";
				
				Запрос.УстановитьПараметр("Партнер", ЭтотОбъект.Партнер);
				Запрос.УстановитьПараметр("АдресДоставки", ЭтотОбъект.АдресДоставки);
				Запрос.УстановитьПараметр("ЖелаемаяДатаОтгрузки", ЭтотОбъект.ЖелаемаяДатаОтгрузки);
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				
