			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется;
			НоваяСтрока.Цена = РаботаСКурсамиВалют.ПересчитатьВВалюту(Выборка.Цена, ВалютаЦены, Валюта, ТекущаяДата());
			
			Если НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС Тогда
				НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			Иначе 
				//++ #Б6462 смарт: Шляпников 13.04.2026 / Ошибка! Срочно! При создании заказа из спецификации IECHo ставиться ндс 20%.
				Если (ЗначениеЗаполнено(ЭтотОбъект.Дата) И ЭтотОбъект.Дата < Дата(2026, 1, 1)) ИЛИ (НЕ ЗначениеЗаполнено(ЭтотОбъект.Дата) И ТекущаяДата() < Дата(2026, 1, 1)) Тогда
					НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
				Иначе
					НоваяСтрока.СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
				КонецЕсли;
				//-- #Б6462 смарт: Шляпников 13.04.2026
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока.КоличествоУпаковок = НоваяСтрока.КоличествоУпаковок + Выборка.Количество;
			НоваяСтрока.Количество = НоваяСтрока.Количество + Выборка.Количество;
			
		КонецЕсли;
		
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		
		СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ЭтотОбъект);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
		СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
		
		НоваяСтрока.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
			НоваяСтрока.Сумма,
			УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС),
			ЦенаВключаетНДС,
			НалогообложениеНДС);

		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСНДСВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено); 			
		ОбработкаТабличнойЧастиКлиентСервер.ПересчитатьСуммуСУчетомРучнойСкидкиВСтрокеТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
				
	КонецЦикла;
	
	ИтоговаяСумма = РаботаСКурсамиВалют.ПересчитатьВВалюту(Спецификация.ИтогоДляКлиента, Спецификация.Валюта, Валюта, ТекущаяДата());
	СуммаДокумента = ПолучитьСуммуЗаказанныхСтрок();
	Разница = ИтоговаяСумма - СуммаДокумента;
	
	Если СуммаДокумента <> 0 Тогда
		
		Для каждого стрТовары Из Товары Цикл
			
			Если стрТовары.СуммаСНДС = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Дельта = Окр(стрТовары.СуммаСНДС * Разница / СуммаДокумента, 2);
			стрТовары.СуммаРучнойСкидки = - Дельта;
			стрТовары.ПроцентРучнойСкидки = - Дельта * 100 / стрТовары.СуммаСНДС;
			Разница = Разница + стрТовары.СуммаРучнойСкидки;
			СуммаДокумента = СуммаДокумента - стрТовары.СуммаСНДС;
			
			Если ЦенаВключаетНДС Тогда
				
				стрТовары.Сумма = стрТовары.Сумма + Дельта;
				стрТовары.СуммаСНДС = стрТовары.СуммаСНДС + Дельта;
				
				стрТовары.СуммаНДС = УчетНДСУПКлиентСервер.РассчитатьСуммуНДС(
															стрТовары.Сумма,
															УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(стрТовары.СтавкаНДС),
															ЦенаВключаетНДС,
															НалогообложениеНДС);
				
			Иначе
				
				стрТовары.СуммаСНДС = стрТовары.СуммаСНДС + Дельта;
				СтавкаНДСЧислом = УчетНДСУПКлиентСервер.ПолучитьСтавкуНДС(стрТовары.СтавкаНДС);
				стрТовары.Сумма = стрТовары.СуммаСНДС / (1 + СтавкаНДСЧислом / (100 + СтавкаНДСЧислом));
				стрТовары.СуммаНДС = стрТовары.СуммаСНДС - стрТовары.Сумма;
															
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СуммаДокумента = ПолучитьСуммуЗаказанныхСтрок();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
