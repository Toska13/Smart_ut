	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		Для Каждого Строка Из Товары Цикл
			Строка.Номенклатура = Неопределено;
		КонецЦикла;
		
	КонецЕсли;
    
    //++ смарт:Подкин # 01.03.2022 10:00:00 
	Если ДанныеЗаполнения<>Неопределено И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДанныеЗаполнения,"Организация") Тогда
		ЭтотОбъект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ДанныеЗаполнения.Организация); 
	Иначе	
		ЭтотОбъект.БанковскийСчет = Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ЭтотОбъект.Организация);
	КонецЕсли;
	//-- смарт:Подкин # 01.03.2022 10:00:00  
    
КонецПроцедуры //-- смарт:ММ 28.02.2021

&Перед("ПередЗаписью")
