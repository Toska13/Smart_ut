&НаСервере
Функция смартУстановитьЗначениеЖелаемойДатеОтгрузки(ТекОбъект) Экспорт
	
	мЖелаемаяДатаОтгрузки = Дата(1,1,1);

	Если ТекОбъект.НеОтгружатьЧастями Тогда
		
		мЖелаемаяДатаОтгрузки = ТекОбъект.ДатаОтгрузки;
		
	ИначеЕсли НЕ НеОтгружатьЧастями Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.ДатаОтгрузки КАК ДатаОтгрузки,
		|	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения,
		|	ЗаказКлиентаТовары.Отменено КАК Отменено
		|ПОМЕСТИТЬ ВТ_ТЗ
		|ИЗ
		|	&Товары КАК ЗаказКлиентаТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВТ_ТЗ.ДатаОтгрузки) КАК ДатаОтгрузки
		|ИЗ
		|	ВТ_ТЗ КАК ВТ_ТЗ
		|ГДЕ
		|	ВТ_ТЗ.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
		|	И ВТ_ТЗ.Отменено = ЛОЖЬ
		|	И ВТ_ТЗ.ДатаОтгрузки >= &ТекущаяДатаНачалоДня";
		
		Запрос.УстановитьПараметр("ТекущаяДатаНачалоДня", НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("Товары", ТекОбъект.Товары.Выгрузить());
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.ДатаОтгрузки) Тогда
				мЖелаемаяДатаОтгрузки = Выборка.ДатаОтгрузки;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	

 Возврат мЖелаемаяДатаОтгрузки;	
	
КонецФункции	
