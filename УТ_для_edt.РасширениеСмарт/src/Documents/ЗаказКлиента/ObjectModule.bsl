			И ТаблицаОборудования.Количество() > 0 Тогда
			
			КаталогСсылка = смартСервер.ПолучитьКаталогДляКомплектацииОборудования();
			
			Если ЗначениеЗаполнено(КаталогСсылка) 
				И НЕ ЗначениеЗаполнено(смартСервер.ПолучитьЗаказНаВнутренееПотребление(Ссылка, КаталогСсылка)) Тогда 		
				
				МассивСкладов = ТаблицаОборудования.ВыгрузитьКолонку("Склад");
				ОстаткиКаталогаНаСкладах = смартСервер.ПолучитьОстаткиНоменклатурыНаСкладах(КаталогСсылка, МассивСкладов, Дата);
				Для Каждого СтрокаОборудование Из ТаблицаОборудования Цикл
					Если (СтрокаОборудование.ЭтоВнутреннийСклад ИЛИ СтрокаОборудование.ЭтоСкладОтветственногоХранения)
						И НЕ ОстаткиКаталогаНаСкладах.Найти(СтрокаОборудование.Склад, "Склад") = Неопределено Тогда                        
						УстановитьПривилегированныйРежим(Истина);
						ЗаказНаВнутренееПотреблениеСсылка = смартСервер.СоздатьЗаказНаВнутренееПотребление(Ссылка, Партнер, КаталогСсылка, СтрокаОборудование.Склад, СтрокаОборудование.ЭтоСкладОтветственногоХранения);
						УстановитьПривилегированныйРежим(Ложь);
						Если ЗначениеЗаполнено(ЗаказНаВнутренееПотреблениеСсылка) Тогда
							ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Для комплектования оборудования каталогом сформирован документ %1", ЗаказНаВнутренееПотреблениеСсылка));
						КонецЕсли;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			//++ #5202 смарт: Тимофеева 22.12.2025 / Списание каталога. Формирование документа Расходного ордера при отгрузке со складов ответ. хранения.
			Если Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт 
				И ЗначениеЗаполнено(КаталогСсылка)				
				И НЕ ТаблицаОборудования.Найти(Истина, "ЭтоСкладОтветственногоХранения") = Неопределено
				И ТаблицаОборудования.Найти(Ложь, "ЭтоСкладОтветственногоХранения") = Неопределено Тогда 
				
				ЗаказНаВнутренееПотребление = смартСервер.ПолучитьЗаказНаВнутренееПотребление(Ссылка, КаталогСсылка);
				ВнутренееПотреблениеПоЗаказу = смартСервер.НайтиВнутренееПотреблениеПоЗаказу(ЗаказНаВнутренееПотребление);
				
				Если ЗначениеЗаполнено(ЗаказНаВнутренееПотребление) 
					И ЗначениеЗаполнено(ВнутренееПотреблениеПоЗаказу)
					И НЕ ЗначениеЗаполнено(смартСервер.НайтиРасходныйОрдерНаТоварыПоЗаказу(ЗаказНаВнутренееПотребление)) Тогда
					УстановитьПривилегированныйРежим(Истина);
					РасходныйОрдерНаТоварыСсылка = смартСервер.СоздатьРасходныйОрдерНаТовары(ДатаЗакрытия, ЗаказНаВнутренееПотребление);
					УстановитьПривилегированныйРежим(Ложь);
					Если ЗначениеЗаполнено(РасходныйОрдерНаТоварыСсылка) Тогда
						ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Для комплектования оборудования каталогом сформирован документ %1", РасходныйОрдерНаТоварыСсылка));
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			//-- #5202 смарт: Тимофеева 22.12.2025
		КонецЕсли;	
	КонецЕсли;
	//-- #2552 смарт: Тимофеева 20.10.2025

КонецПроцедуры //-- смарт:ММ 08.10.2020

//++ #Б-7226 смарт: Фролов 15.07.2026 //Поле "Автоматическая квалификация" заполнять автоматически
Функция смартОпределитьПоПродуктуКвалификацию(Продукт)
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	Ссылка КАК Квалификация,
	|	ДЛИНАСТРОКИ(Продукт) КАК ДлинаНаименования
	|ИЗ
	|	Справочник.смартКвалификацииМенеджеров.Продукты
	|ГДЕ
	|	Ссылка.ТипПродукта.АнализироватьПродукт
	|	И &Продукт ПОДОБНО ""%"" + Продукт + ""%""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДлинаНаименования УБЫВ,
	|	Ссылка.Наименование УБЫВ");
	
	Запрос.УстановитьПараметр("Продукт", Продукт);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Квалификация;
	КонецЕсли;	
	
	Возврат Справочники.смартКвалификацииМенеджеров.ПустаяСсылка();
	
КонецФункции //-- #Б-7226 смарт: Фролов 15.07.2026

//++ смарт:ММ #092 389 19.01.2021 - Конструктор оборудования
Процедура ВыполнитьЗадачуСоздатьЗаказПоБизнесПроцессу()

	// Поиск невыполненной задачи СоздатьЗаказ по бизнес процессу
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка,
	|	ЗадачаИсполнителя.БизнесПроцесс
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	НЕ ЗадачаИсполнителя.Выполнена
	|	И НЕ ЗадачаИсполнителя.ПометкаУдаления
	|	И ЗадачаИсполнителя.Предмет = &Предмет
	|	И ЗадачаИсполнителя.ТочкаМаршрута = &ТочкаМаршрута";
	
	Запрос.УстановитьПараметр("Предмет", ДокументОснование);
	Запрос.УстановитьПараметр("ТочкаМаршрута", БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.СоздатьЗаказ);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		БП = Выборка.БизнесПроцесс.ПолучитьОбъект();
		БП.ЗаказКлиента = Ссылка;
		БП.Записать();
		
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗадачаОбъект.ВыполнитьЗадачу();
	КонецЦикла;

КонецПроцедуры //-- смарт:ММ 19.01.2021

//++ смарт:ММ #092 389 21.01.2021 - Конструктор оборудования
Процедура ВыполнитьЗадачиПриОтменеЗаказаПоБизнесПроцессу()
	
	// Проверка, являются ли нужные точки маршрута текущими, и выполнение соответствующих задач
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка,
	|	ЗадачаИсполнителя.ТочкаМаршрута
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	НЕ ЗадачаИсполнителя.Выполнена
	|	И НЕ ЗадачаИсполнителя.ПометкаУдаления
	|	И ЗадачаИсполнителя.Предмет = &Предмет
	|	И ЗадачаИсполнителя.ТочкаМаршрута В (&ТочкаМаршрута)";
	
	ТочкаМаршрута = Новый Массив;
	ТочкаМаршрута.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОжиданиеОплатыОтКлиента);
	ТочкаМаршрута.Добавить(БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОтменитьЗаказ);
	
	Запрос.УстановитьПараметр("Предмет", ДокументОснование);
	Запрос.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрута);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.ТочкаМаршрута = БизнесПроцессы.смартIECHOПродажа.ТочкиМаршрута.ОжиданиеОплатыОтКлиента Тогда
			ЗадачаОбъект.КлиентОтказалсяОтЗаказаНаЭтапеОплаты = Истина;
		КонецЕсли;
		
		ЗадачаОбъект.ВыполнитьЗадачу();
	КонецЦикла;
	
КонецПроцедуры //-- смарт:ММ 21.01.2021

