    //|
    //|СГРУППИРОВАТЬ ПО
    //|   ТоварыКОтгрузкеОстаткиИОбороты.Номенклатура
    //|;
    //|
    //|////////////////////////////////////////////////////////////////////////////////
    //|ВЫБРАТЬ
    //|   РасходНедельный.НоменклатураРасход КАК НоменклатураРасход,
    //|   РасходНедельный.КоличествоРасход КАК КоличествоРасход,
    //|   ТоварыОграничения.Номенклатура КАК Номенклатура,
    //|   ТоварыОграничения.Количество КАК Количество,
    //|   ТоварыОграничения.КоличествоВДокументе КАК КоличествоВДокументе
    //|ИЗ
    //|   ТоварыОграничения КАК ТоварыОграничения
    //|       ЛЕВОЕ СОЕДИНЕНИЕ РасходНедельный КАК РасходНедельный
    //|       ПО (РасходНедельный.НоменклатураРасход = ТоварыОграничения.Номенклатура)
    //|ГДЕ
    //|   РасходНедельный.КоличествоРасход + ТоварыОграничения.КоличествоВДокументе > ТоварыОграничения.Количество";
    Запрос.Текст =  "ВЫБРАТЬ
    |	ВТТовары.Номенклатура КАК Номенклатура,
    |	ВТТовары.Количество КАК Количество,
    |	ВТТовары.КоличествоВДокументе КАК КоличествоВДокументе
    |ПОМЕСТИТЬ ТоварыОграничения
    |ИЗ
    |	&ВТТовары КАК ВТТовары
    |;
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	ЗаказыКлиентовОстаткиИОбороты.Номенклатура КАК НоменклатураРасход,
    |	СУММА(ЗаказыКлиентовОстаткиИОбороты.ЗаказаноПриход) КАК КоличествоРасход
    |ПОМЕСТИТЬ РасходНедельный
    |ИЗ
    |	РегистрНакопления.ЗаказыКлиентов.ОстаткиИОбороты(&ДатаН, &ДатаК, , , ЗаказКлиента.Партнер = &Партнер И НЕ ЗаказКлиента=&ЗаказКлиента) КАК ЗаказыКлиентовОстаткиИОбороты
    |СГРУППИРОВАТЬ ПО
    |	ЗаказыКлиентовОстаткиИОбороты.Номенклатура
    |;
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	РасходНедельный.НоменклатураРасход КАК НоменклатураРасход,
    |	РасходНедельный.КоличествоРасход КАК КоличествоРасход,
    |	ТоварыОграничения.Номенклатура КАК Номенклатура,
    |	ТоварыОграничения.Количество КАК Количество,
    |	ТоварыОграничения.КоличествоВДокументе КАК КоличествоВДокументе
    |ИЗ
    |	ТоварыОграничения КАК ТоварыОграничения
    |		ЛЕВОЕ СОЕДИНЕНИЕ РасходНедельный КАК РасходНедельный
    |		ПО (РасходНедельный.НоменклатураРасход = ТоварыОграничения.Номенклатура)
    |ГДЕ
    |	РасходНедельный.КоличествоРасход + ТоварыОграничения.КоличествоВДокументе > ТоварыОграничения.Количество";

    Запрос.УстановитьПараметр("ДатаН", НачалоНедели(Дата)); 
    Запрос.УстановитьПараметр("ДатаК", КонецНедели(Дата));
    Запрос.УстановитьПараметр("Партнер",Партнер);
    Запрос.УстановитьПараметр("ВТТовары", ТзНомОграниченияЗаказа);
    Запрос.УстановитьПараметр("ЗаказКлиента", Ссылка);
    
    РезультатЗапроса = Запрос.Выполнить();
    Если РезультатЗапроса.Пустой() Тогда
        Возврат Неопределено;	
    КонецЕсли;
    
    Возврат РезультатЗапроса.Выгрузить();    
    
КонецФункции //-- смарт:Подкин #1009 29.04.2022 12:26:15

