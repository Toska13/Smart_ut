&После("ИнициализироватьДокумент")
Процедура смарт_ИнициализироватьДокумент(ДанныеЗаполнения)
	
	//++ смарт:ММ #048 234 30.05.2020 - Заявка на пусконаладку  
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда
		
		Организация 		= ДанныеЗаполнения.Организация;
		Партнер 			= ДанныеЗаполнения.Партнер;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		ДокументОснование 	= ДанныеЗаполнения;
		
		НоменклатураПоУмолчанию = Справочники.смартПредопределенныеЗначения.НоменклатураДляЗаказаКлиентаИзЗаявкиНаПускоНаладкуПоУмолчанию.Значение;
		Соглашение = Справочники.смартПредопределенныеЗначения.СоглашениеДляЗаказаКлиентаИзЗаявкиНаПускоНаладкуПоУмолчанию.Значение;
		
		// ++ 01.12.2020
		ЗаполнитьУсловияПродажПоСоглашению();
		// --
		
		Если ЗначениеЗаполнено(НоменклатураПоУмолчанию) Тогда
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Номенклатура = НоменклатураПоУмолчанию;
			НоваяСтрока.КоличествоУпаковок = 1;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		КонецЕсли;
		
	//++ смарт:ММ #082 397 14.11.2020 - Заявка на ремонт
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		
		Организация 		= ДанныеЗаполнения.Организация;
		Партнер 			= ДанныеЗаполнения.Партнер;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		ДокументОснование 	= ДанныеЗаполнения;
		
		//НоменклатураПоУмолчанию = Справочники.смартПредопределенныеЗначения.НоменклатураДляЗаказаКлиентаИзЗаявкиНаПускоНаладкуПоУмолчанию.Значение;
		НоменклатураПоУмолчанию = Справочники.Номенклатура.НайтиПоНаименованию("Организация ремонтных работ", Истина);
		Соглашение = Справочники.смартПредопределенныеЗначения.СоглашениеДляЗаказаКлиентаИзЗаявкиНаПускоНаладкуПоУмолчанию.Значение;
		
		// ++ 01.12.2020
		ЗаполнитьУсловияПродажПоСоглашению();
		// --
		
		Если ЗначениеЗаполнено(НоменклатураПоУмолчанию) Тогда
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Номенклатура = НоменклатураПоУмолчанию;
			НоваяСтрока.КоличествоУпаковок = 1;
			НоваяСтрока.Количество = 1;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		КонецЕсли;

	//-- смарт:ММ 14.11.2020
	
	//++ смарт:ММ #099 409 28.03.2021 Регламентное обслуживание
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартРегламентноеОбслуживаниеКлиентов") Тогда
		
		Настройка = Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт;
		Организация 		= смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);
		Партнер 			= ДанныеЗаполнения.Клиент;
		Контрагент 			= ДанныеЗаполнения.Контрагент;
		ДокументОснование 	= ДанныеЗаполнения;
		
		//++ смарт:ММ #099 409 06.06.2021
		//Соглашение = Справочники.смартПредопределенныеЗначения.СоглашениеДляЗаказаКлиентаИзЗаявкиНаПускоНаладкуПоУмолчанию.Значение;
		Настройка = Справочники.смартПредопределенныеЗначения.СоглашениеДляЗаказаКлиентаИзРегламентногоРемонтногоОбслуживания;
		Соглашение = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение(Настройка, Ложь);
		//-- смарт:ММ 06.06.2021
		
		Если ЗначениеЗаполнено(Соглашение) Тогда
			ЗаполнитьУсловияПродажПоСоглашению();
			Валюта = Соглашение.Валюта;
		КонецЕсли;

		Для Каждого Строка Из ДанныеЗаполнения.Запчасти Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Номенклатура = Строка.Запчасть;
			НоваяСтрока.КоличествоУпаковок = Строка.Количество;
			НоваяСтрока.Количество = Строка.Количество;
			НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить;
		КонецЦикла;
		
	//-- смарт:ММ 28.03.2021
	
	//++ смарт:ММ #092 389 16.01.2021 - Конструктор оборудования
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартIECHOСпецификация") Тогда
		
		Организация 		= Справочники.смартПредопределенныеЗначения.ОрганизацияДляЗаявкиНаГарантийныйРемонт.Значение;
		Партнер 			= ДанныеЗаполнения.Клиент;
		Контрагент 			= ПолучитьКонтрагентаПоКлиенту();
		ДокументОснование 	= ДанныеЗаполнения;
		
		//++ #Б1402 смарт: Шляпников 19.11.2024 / Дополнения по задаче создание Заказа клиента из конструктора КП
		Соглашение = Справочники.смартПредопределенныеЗначения.Настройки.СоглашениеТиповоеUSD;
		//-- #Б1402 смарт: Шляпников 19.11.2024
		
		Если ЗначениеЗаполнено(Соглашение) Тогда
			ЗаполнитьУсловияПродажПоСоглашению();
			Валюта = Соглашение.Валюта;
		КонецЕсли;
		
		//++ #Б1252 смарт: Шляпников 12.11.2024 / Создание Заказа клиента из Спецификации IECHO
		ЗаполнитьТабличнуюЧастьТоварыПоСпецификации(ДанныеЗаполнения);
		//-- #Б1252 смарт: Шляпников 12.11.2024

	//-- смарт:ММ 16.01.2021
	КонецЕсли;
	//-- смарт:ММ 30.05.2020
	
КонецПроцедуры

