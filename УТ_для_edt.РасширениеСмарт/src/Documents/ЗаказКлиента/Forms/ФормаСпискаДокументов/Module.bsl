// Смарт Фролов+
// Процедура для установки галочки "Оригиналы документов получены"
&НаКлиенте
Процедура смартДокументыПолучены(Команда)
	Если Не РазрешеноСтавитьГалочкуДокументыПодписаны() Тогда 
		Возврат;
	КонецЕсли;	
	МассивСтрок=Элементы.Список.ВыделенныеСтроки;
	МассивДокументов=Новый Массив;
	Для Каждого Док Из МассивСтрок Цикл 
		Стр=Элементы.Список.ДанныеСтроки(Док);
		Если Стр.ПроцентОтгрузки>0 Тогда 
			МассивДокументов.Добавить(Док);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для докумнта: "+Док+" нет отгрузки. Документы не могут быть получены.");
		КонецЕсли;	
	КонецЦикла;
	Если МассивДокументов.Количество() Тогда 
		ДокументыПолученыСервер(МассивДокументов);
	КонецЕсли;
КонецПроцедуры

// Смарт Процедура установки галочки "Оригиналы документов получены"
// Выполняется на сервере
&НаСервере
Процедура ДокументыПолученыСервер(Доки)	
	
	Для Каждого Ссылка Из Доки Цикл 
		
		Если НЕ Ссылка.Проведен Тогда
			Продолжить;
		Иначе
			
			Если Ссылка.смартДокументыПодписаны Тогда 
				Продолжить;
			КонецЕсли;
			
			Док = Ссылка.ПолучитьОбъект();
			Док.ОбменДанными.Загрузка = Истина;
			Док.смартДокументыПодписаны = Истина;
			
			УстановитьПривилегированныйРежим(Истина);
			Узел = ПланыОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.НайтиПоНаименованию("СМАРТ-Т ООО", Истина);
			ОтменитьРегистацию = НЕ ПланыОбмена.ИзменениеЗарегистрировано(Узел, Док);
			
			Попытка
				
				Док.Заблокировать();
				Док.Записать();
				Док.Разблокировать();
				Документы.ЗаказКлиента.УстановитьПодписавшегоДокумент(Ссылка);
				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При попытке записи произошли ошибки:" + ОписаниеОшибки());
			КонецПопытки;	
			
			Если ОтменитьРегистацию Тогда 
				ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Ссылка);
			КонецЕсли;
			
			УстановитьПривилегированныйРежим(Ложь);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры	

// Смарт Функция проверки разрешания на галочку "Оригиналы документов получены"
&НаСервереБезКонтекста
