    ПараметрыВыбораВидаЦены.Добавить(ЦеныСтруктура);  
    
    ЦеныСтруктура=Новый Структура;
    ЦеныСтруктура.Вставить("Ключ","ИспользоватьПриПродаже");
    ЦеныСтруктура.Вставить("Значение",Истина);
    ПараметрыВыбораВидаЦены.Добавить(ЦеныСтруктура);
    
    ЦеныСтруктура=Новый Структура;
    ЦеныСтруктура.Вставить("Ключ","ЦенаВключаетНДС");
    ЦеныСтруктура.Вставить("Значение",Объект.ЦенаВключаетНДС);
    ПараметрыВыбораВидаЦены.Добавить(ЦеныСтруктура);

    //-- смарт:Подкин #1025 п3 22.05.2022 14:12:42
    
    Если НЕ СтруктураПроверки = Неопределено И СтруктураПроверки.РезультатПроверки 
        И (ТИПЗНЧ(СтруктураПроверки.ВалютаСегмент)=Тип("СправочникСсылка.Валюты") ИЛИ СтруктураПроверки.ВалютаСегмент) Тогда
        
               
        //++ смарт:Подкин #1025 п3 22.05.2022 14:04:08   
        Если ПродажаВРублях Тогда
            СписокЦен.Добавить(Константы.ВалютаРегламентированногоУчета.Получить()); 
            ЦеныСтруктура=Новый Структура;
            ЦеныСтруктура.Вставить("Ключ","ВалютаЦены");
            ЦеныСтруктура.Вставить("Значение",СписокЦен);
            
            ПараметрыВыбораВидаЦены.Добавить(ЦеныСтруктура);
            Элементы.ТоварыВидЦены.ПараметрыВыбора= Новый ФиксированныйМассив(Новый Массив);
            СписокВидовЦен=смартДоступныеВидыЦен(ПараметрыВыбораВидаЦены);
            Элементы.ТоварыВидЦены.РежимВыбораИзСписка=Истина;
            Элементы.ТоварыВидЦены.СписокВыбора.ЗагрузитьЗначения(СписокВидовЦен);
        Иначе
            СписокЦен.Добавить(Справочники.Валюты.НайтиПоКоду("000")); 
            ЦеныСтруктура=Новый Структура;
            ЦеныСтруктура.Вставить("Ключ","ВалютаЦены");
            ЦеныСтруктура.Вставить("Значение",СписокЦен);
            
            ПараметрыВыбораВидаЦены.Добавить(ЦеныСтруктура);
            Элементы.ТоварыВидЦены.ПараметрыВыбора= Новый ФиксированныйМассив(Новый Массив);
            СписокВидовЦен=смартДоступныеВидыЦен(ПараметрыВыбораВидаЦены);
            Элементы.ТоварыВидЦены.РежимВыбораИзСписка=Истина;
            Элементы.ТоварыВидЦены.СписокВыбора.ЗагрузитьЗначения(СписокВидовЦен);
        КонецЕсли;    
        //-- смарт:Подкин #1025 п3 22.05.2022 14:04:08
        
    КонецЕсли; 
    
    Возврат СтруктураПроверки;  
    //-- смарт:Подкин #914 02.03.2022 17:12:54
