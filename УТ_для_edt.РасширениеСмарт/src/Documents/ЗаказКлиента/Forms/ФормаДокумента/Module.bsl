&НаСервере
//++ #Б-6672 смарт: Фролов 18.05.2026 //При создании заказа клиента подставлять Рекламное воздействие из посещенных мероприятий.
Функция смартПолучитьИсточникРекламногоВоздействия(Номенклатура)
	
	Если НЕ Номенклатура.ВидНоменклатуры = Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение Тогда
		
		Возврат Неопределено;	
		
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартИсточникиРекламногоВоздействияАвтоматическоеПроставлениеВЗаказеКлиента.Ссылка КАК Ссылка,
	|	смартИсточникиРекламногоВоздействияАвтоматическоеПроставлениеВЗаказеКлиента.Ссылка.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Справочник.смартИсточникиРекламногоВоздействия.АвтоматическоеПроставлениеВЗаказеКлиента КАК смартИсточникиРекламногоВоздействияАвтоматическоеПроставлениеВЗаказеКлиента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|		ПО (смартИсточникиРекламногоВоздействияАвтоматическоеПроставлениеВЗаказеКлиента.Оборудование = СпрНоменклатура.Ссылка
	|				ИЛИ смартИсточникиРекламногоВоздействияАвтоматическоеПроставлениеВЗаказеКлиента.Оборудование = СпрНоменклатура.Марка)
	|ГДЕ
	|	СпрНоменклатура.Ссылка = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОкончания УБЫВ");
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции //-- #Б-6672 смарт: Фролов 18.05.2026	

&НаСервере
Процедура смартРассчитатьРучнуюСкидкуСУчетомАкции(ИДСтроки)
	
	стрТовары = Объект.Товары.НайтиПоИдентификатору(ИДСтроки);
	
	НайденныеСтроки = Объект.смартАкции.НайтиСтроки(Новый Структура("КодСтроки", стрТовары.КодСтроки));
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ЦенаСоСкидкой = РаботаСКурсамиВалют.ПересчитатьВВалюту(НайденныеСтроки[0].ЦенаАкция, НайденныеСтроки[0].ВалютаАкция, Объект.Валюта, Объект.Дата);
		СуммаСоСкидкой = стрТовары.Количество * ЦенаСоСкидкой;
		
		стрТовары.СуммаРучнойСкидки = СуммаСоСкидкой * стрТовары.ПроцентРучнойСкидки / 100;
		стрТовары.СуммаРучнойСкидкиБезВозвратнойТары = стрТовары.СуммаРучнойСкидки;
		
		СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		КэшированныеЗначения = Новый Структура;
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
		СтруктураДействий.Вставить("ПересчитатьСумму");
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать,ПересчитыватьСуммуРучнойСкидки", Ложь, Ложь));
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
		СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(стрТовары, СтруктураДействий, КэшированныеЗначения);
			
	КонецЕсли;
	
КонецПроцедуры

//++ #7106 смарт: Тимофеева 29.06.2026 / Списание каталогов. Оповещение пользователей при смене склада отгрузки.

&НаКлиенте
Процедура смарт_СкладПриИзмененииПосле(Элемент)
	ПроверитьИОповеститьОКомлектацииЗаказаСублимационнымОборудованием();
КонецПроцедуры

&НаСервере
Процедура ПроверитьИОповеститьОКомлектацииЗаказаСублимационнымОборудованием(ИдентификаторТекущейСтроки = -1)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;   
	
	СегментСублимационногоОборудования 		= Справочники.смартПредопределенныеЗначения.СегментОборудованияДляКомплектации.Значение;
	ЕстьСублимационноеОборудованиеКОтгрузке = Ложь; 
	
	Если ИдентификаторТекущейСтроки = -1 Тогда
		Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
			Если СегментыСервер.ВходитВСегмент(ТекущаяСтрока.Номенклатура, СегментСублимационногоОборудования, , Ложь) 
				И НЕ ТекущаяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда
				ЕстьСублимационноеОборудованиеКОтгрузке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
		Если СегментыСервер.ВходитВСегмент(ТекущаяСтрока.Номенклатура, СегментСублимационногоОборудования, , Ложь) 
			И НЕ ТекущаяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить Тогда
			ЕстьСублимационноеОборудованиеКОтгрузке = Истина;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЕстьСублимационноеОборудованиеКОтгрузке Тогда
		Возврат;
	КонецЕсли; 
	
	КаталогОтгружается 	= Ложь;
	КаталогСсылка 		= смартСервер.ПолучитьКаталогДляКомплектацииОборудования();		
	Если ЗначениеЗаполнено(КаталогСсылка) Тогда
		ЗаказНаВнутренееПотребление = смартСервер.ПолучитьЗаказНаВнутренееПотребление(Объект.Ссылка, КаталогСсылка);
		РеквизитыЗаказа 			= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаказНаВнутренееПотребление, 
													"Номер, Дата, ПометкаУдаления, Товары");
		Если НЕ РеквизитыЗаказа.ПометкаУдаления Тогда 			
			Выборка = РеквизитыЗаказа.Товары.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.Номенклатура = КаталогСсылка
					И Выборка.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить 
					Тогда
					КаталогОтгружается = Истина;
				КонецЕсли;				
			КонецЦикла;
		КонецЕсли; 
		
		Если КаталогОтгружается Тогда 
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Внимание! Данный заказ в обязательном порядке комплектуется %1. 
			|У Заказа клиента есть зависимый документ Заказ на внутреннее потребление %2 от %3, в котором также необходимо изменить склад отгрузки или отменить его!"
			, КаталогСсылка, РеквизитыЗаказа.Номер, Формат(РеквизитыЗаказа.Дата, "ДЛФ=D")));
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

