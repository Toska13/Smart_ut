	Если Объект.Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.смартИДРазрешенияНаДоставкуВнеЗоны) Тогда
		Возврат "Нет информации о разрешении";
	Иначе
		
		ДанныеОРазрешении = РегистрыСведений.смартИсторияИзмененияРазрешений.ПолучитьИнформациюПоРазрешению(Объект.Ссылка, Объект.смартИДРазрешенияНаДоставкуВнеЗоны, "ДоставкаВнеЗоны");
		
		Если ДанныеОРазрешении <> Неопределено Тогда
			Возврат СтрШаблон("Разрешение %1 пользователем %2 %3", ?(ДанныеОРазрешении.Разрешено, "установлено", "снято"), ДанныеОРазрешении.Ответственный, ДанныеОРазрешении.ДатаИзменения);
		КонецЕсли;
		
		Возврат "Нет информации о разрешении";
		
	КонецЕсли;
	
КонецФункции

