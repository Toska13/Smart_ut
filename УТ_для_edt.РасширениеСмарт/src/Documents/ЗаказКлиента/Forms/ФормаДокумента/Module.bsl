		Объект.АдресДоставки 			  = "";
		Объект.АдресДоставкиЗначение 	  = ""; 
		Объект.АдресДоставкиЗначенияПолей = "";	
		ОбщегоНазначения.СообщитьПользователю("Адрес доставки до клиента не найден!!!");
	КонецЕсли; 
	
КонецПроцедуры 
