//++ #Б-3276 смарт: Фролов 12.05.2025 //Создание Интереса после создания Заказа клиента.
Процедура смартПоказатьПривязанныйИнтерес(Интерес)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	CRM_Интерес.Дата КАК Дата,
	|	CRM_Интерес.Номер КАК Номер,
	|	CRM_Интерес.Тема КАК Тема,
	|	CRM_Интерес.Партнер КАК Партнер,
	|	CRM_Интерес.Ответственный КАК Ответственный,
	|	CRM_Интерес.Подразделение КАК Подразделение,
	|	CRM_Интерес.Организация КАК Организация,
	|	CRM_Интерес.Ссылка КАК Ссылка,
	|	CRM_Интерес.СостояниеИнтереса КАК СостояниеИнтереса,
	|	ИСТИНА КАК ВведенНаОсновании,
	|	ЛОЖЬ КАК ОсновнойИнтерес
	|ИЗ
	|	Документ.CRM_Интерес КАК CRM_Интерес
	|ГДЕ
	|	CRM_Интерес.Ссылка = &Интерес");
	Запрос.УстановитьПараметр("Интерес", Интерес);
	
	ЭтаФорма.CRM_ТаблицаИнтересов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ЭтаФорма.CRM_ИнтересСтрокой = CRM_МетодыФормДокументовСервер.СформироватьПредставлениеИнтересаСтрокой(Интерес);
	
КонецПроцедуры //-- #Б-3276 смарт: Фролов 12.05.2025

