			ЭтаФорма.смартВопросПроСкидкиЗадан = Истина;
			ЭтаФорма.смартЖдемОтветаНаВопросПроСкидки = Истина; 
			
			//++ #Б-1234 смарт: Мосолов 29.10.2024 //Уведомление об автоматических скидках выводить только один раз
			ЭтаФорма.смартСуммаДокументаИзменилась = Ложь;
			//-- #Б-1234 смарт: Мосолов 29.10.2024  
			
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить(КодВозвратаДиалога.Да, "Заполнить автоматические скидки");
			СписокКнопок.Добавить(КодВозвратаДиалога.Нет, "Продолжить без скидок");
			
			Оповещение = Новый ОписаниеОповещения("смартЗавершениеВопросаОПримененииСкидок", ЭтотОбъект, Параметры);
			ПоказатьВопрос(Оповещение, 
				"В Заказе клиента есть товары, которые соответствуют условию предоставления автоматической скидки.
					|Заполнить скидки по товарам?",
			    СписокКнопок);  
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #1807 смарт: Мосолов 05.07.2024 

	Если ПараметрыЗаписи.РежимЗаписи=РежимЗаписиДокумента.Проведение И ЗначениеЗаполнено(Объект.Договор)
		И НЕ Объект.Валюта=Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Договор,"ВалютаВзаиморасчетов")
		И НЕ ЭтаФорма.смартВопросПроВалютуЗадан ТОгда
		Отказ=Истина;
		СписокЗначенийОтветов = Новый СписокЗначений;
		//++ #1436 смарт: Лопато 11.10.2023 //Проверка валюты в Заказе и Договоре при проведении 
		Если НЕ Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Договор, "смартДоговорПодписан") = Истина Тогда
			СписокЗначенийОтветов.Добавить("Установить в договоре валюту "+Объект.Валюта+"");
		КонецЕсли;	
		//-- #1436 смарт: Лопато 11.10.2023
		СписокЗначенийОтветов.Добавить("Установить в заказе валюту "+Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Договор,"ВалютаВзаиморасчетов")+""); 
		СписокЗначенийОтветов.Добавить("Вернуться к редактированию заказа");
				
		Оповещение = Новый ОписаниеОповещения("смартВыборВариантаИзменениеВалют", ЭтотОбъект,);
		ТекстВопроса = НСтр("ru = 'Валюта заказе клиента отличается от договора'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, СписокЗначенийОтветов, , "Вернуться к редактированию заказа");
		ЭтаФорма.смартВопросПроВалютуЗадан=Истина; 
		ЭтаФорма.смартЖдемответаНаВопрос=Истина;
		Возврат;
	КонецЕсли;
	
	//++ #2552 смарт: Тимофеева 20.10.2025 / Сделать обязательную комплектацию оборудования каталогом   
	Если НЕ смартНеВыполнятьПроверкуПередЗаписью И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И Объект.Дата >= Дата("20251106") Тогда
		
		РезультатПроверки = ПроверитьТребованияДополнительнойКомплектацииСублимационногоОборудования();
		
		Если РезультатПроверки.ТребуетсяВывестиУведомлениеМенеджеру Тогда			
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПроверки.ТекстУведомления,,,, Отказ);
		КонецЕсли;

	КонецЕсли;
	//-- #2552 смарт: Тимофеева 20.10.2025
	
	//++ #5082 смарт: Тимофеева 01.12.2025 / Настройка правил продаж (Ковчег). Дополнительная проверка.
	//Если НЕ смартНеВыполнятьПроверкуПередЗаписью Тогда
