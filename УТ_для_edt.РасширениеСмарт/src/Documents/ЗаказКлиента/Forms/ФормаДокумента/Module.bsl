//++ #1334 смарт: Фролов 12.04.2023 //Заявка на формирование и подписание договора из 1С
&НаСервере
Процедура ПроверитьВозможностьВыбораДоговора()
	Если ЗначениеЗаполнено(Объект.Договор.смартЗаказКлиента) И 	НЕ Объект.Договор.смартЗаказКлиента=Объект.Ссылка ТОгда
		Объект.Договор=Неопределено;
		Сообщить("Данный договор привязан к другому Заказу клиента!"); 
	КонецЕсли;	
	Если Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНаЭкспорт") Тогда
		Элементы.смартЗаполнитьЗаявкуНаДоговор.Видимость=Ложь;
		Элементы.КнопкасмартИнформация_СформироватьЗаявкуНаПодготовкуДоговора.Видимость=ложь;
	Иначе
		Элементы.смартЗаполнитьЗаявкуНаДоговор.Видимость= Элементы.Договор.Видимость И НЕ ЗначениеЗаполнено(Объект.Договор);
		Элементы.КнопкасмартИнформация_СформироватьЗаявкуНаПодготовкуДоговора.Видимость= Элементы.Договор.Видимость И НЕ ЗначениеЗаполнено(Объект.Договор);
	КонецЕсли;	
КонецПроцедуры //-- #1334 смарт: Фролов 03.04.2023

//++ #1334 смарт: Фролов 19.04.2023 //Заявка на формирование и подписание договора из 1С
&НаСервере
Процедура смартЗаполнитьЭтапыОплаты(ТекДоговор)
	Объект.ЭтапыГрафикаОплаты.Очистить();
	Если ТекДоговор.смартПредоплата100Процентов Тогда
		Если ЗначениеЗаполнено(ТекДоговор.смартДатаПредоплата100) Тогда
			СтрГрафика=Объект.ЭтапыГрафикаОплаты.Добавить();
			СтрГрафика.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
			СтрГрафика.ПроцентПлатежа=100;
			СтрГрафика.СуммаПлатежа=Объект.СуммаДокумента;
			СтрГрафика.ДатаПлатежа=ТекДоговор.смартДатаПредоплата100;
		КонецЕсли;
	ИначеЕсли ТекДоговор.смартЧастичнаяОплатаВариант1 Тогда
		Если ТекДоговор.смартПроцентОкончательныйПлатежВариант1+ТекДоговор.смартПроцентПредоплатыВариант1=100 Тогда
			Если ТекДоговор.смартПроцентОкончательныйПлатежВариант1>0 Тогда 
				Если ТекДоговор.смартПроцентПредоплатыВариант1>0 И ТекДоговор.смартПроцентОкончательныйПлатежВариант1>0 
					И ЗначениеЗаполнено(ТекДоговор.смартДнейНаДоплатуВариант1) И ЗначениеЗаполнено(ТекДоговор.смартДатаПредоплатаВариант1) Тогда
					СтрГрафика=Объект.ЭтапыГрафикаОплаты.Добавить();
					СтрГрафика.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
					СтрГрафика.ПроцентПлатежа=ТекДоговор.смартПроцентПредоплатыВариант1;
					СтрГрафика.СуммаПлатежа=Окр(Объект.СуммаДокумента*ТекДоговор.смартПроцентПредоплатыВариант1/100,2);
					СуммаОстаток=Объект.СуммаДокумента-СтрГрафика.СуммаПлатежа;
					СтрГрафика.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант1;
					СтрГрафика2=Объект.ЭтапыГрафикаОплаты.Добавить();
					СтрГрафика2.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
					СтрГрафика2.ПроцентПлатежа=ТекДоговор.смартПроцентОкончательныйПлатежВариант1;
					СтрГрафика2.СуммаПлатежа=СуммаОстаток;
					СтрГрафика2.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант1; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;			
	ИначеЕсли ТекДоговор.смартЧастичнаяОплатаВариант2 Тогда
		Если ТекДоговор.смартПроцентПредоплатыВариант2+ТекДоговор.смартПроцентДоплатыВариант2+ТекДоговор.смартПроцентОкончательныйПлатежВариант2 = 100 Тогда
			Если ТекДоговор.смартПроцентПредоплатыВариант2>0 И ТекДоговор.смартПроцентДоплатыВариант2>0 И ТекДоговор.смартПроцентОкончательныйПлатежВариант2>0 
				И ЗначениеЗаполнено(ТекДоговор.смартДнейНаДоплатуВариант2) И ЗначениеЗаполнено(ТекДоговор.смартДатаПредоплатаВариант2) Тогда
				СтрГрафика=Объект.ЭтапыГрафикаОплаты.Добавить();
				СтрГрафика.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
				СтрГрафика.ПроцентПлатежа=ТекДоговор.смартПроцентПредоплатыВариант2;
				СтрГрафика.СуммаПлатежа=Окр(Объект.СуммаДокумента*ТекДоговор.смартПроцентПредоплатыВариант2/100,2);
				СтрГрафика.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант2;
				СтрГрафика2=Объект.ЭтапыГрафикаОплаты.Добавить();
				СтрГрафика2.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
				СтрГрафика2.ПроцентПлатежа=ТекДоговор.смартПроцентДоплатыВариант2;
				СтрГрафика2.СуммаПлатежа=Окр(Объект.СуммаДокумента*ТекДоговор.смартПроцентДоплатыВариант2/100,2);
				СтрГрафика2.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант2;  
				СтрГрафика3=Объект.ЭтапыГрафикаОплаты.Добавить();
				СтрГрафика3.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.КредитСдвиг");
				СтрГрафика3.ПроцентПлатежа=ТекДоговор.смартПроцентОкончательныйПлатежВариант2;
				СтрГрафика3.СуммаПлатежа=Объект.СуммаДокумента-СтрГрафика.СуммаПлатежа-СтрГрафика2.СуммаПлатежа;
				СтрГрафика3.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант2+86400*ТекДоговор.смартСрокПоставки; 
			КонецЕсли;	
		КонецЕсли;
	ИначеЕсли ТекДоговор.смартЧастичнаяОплатаВариант3 Тогда
		Если ТекДоговор.смартПроцентОкончательныйПлатежВариант3+ТекДоговор.смартПроцентПредоплатыВариант3=100 Тогда
			Если ТекДоговор.смартПроцентОкончательныйПлатежВариант3>0 Тогда 
				Если ТекДоговор.смартПроцентПредоплатыВариант3>0 И ТекДоговор.смартПроцентОкончательныйПлатежВариант3>0 
					И ЗначениеЗаполнено(ТекДоговор.смартДнейНаДоплатуВариант3) И ЗначениеЗаполнено(ТекДоговор.смартДатаПредоплатаВариант3) Тогда
					СтрГрафика=Объект.ЭтапыГрафикаОплаты.Добавить();
					СтрГрафика.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
					СтрГрафика.ПроцентПлатежа=ТекДоговор.смартПроцентПредоплатыВариант3;
					СтрГрафика.СуммаПлатежа=Окр(Объект.СуммаДокумента*ТекДоговор.смартПроцентПредоплатыВариант3/100,2);
					СуммаОстаток=Объект.СуммаДокумента-СтрГрафика.СуммаПлатежа;
					СтрГрафика.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант3;
					СтрГрафика2=Объект.ЭтапыГрафикаОплаты.Добавить();
					СтрГрафика2.ВариантОплаты=ПредопределенноеЗначение("Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки");
					СтрГрафика2.ПроцентПлатежа=ТекДоговор.смартПроцентОкончательныйПлатежВариант3;
					СтрГрафика2.СуммаПлатежа=СуммаОстаток;
					СтрГрафика2.ДатаПлатежа=ТекДоговор.смартДатаПредоплатаВариант3; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;
	НадписьЭтапыОплаты = ЭтапыОплатыКлиентСервер.НадписьЭтапыОплаты(ЭтаФорма, Истина, Объект.СуммаДокумента);	
КонецПроцедуры //-- #1334 смарт: Фролов 19.04.2023	

//++#1323 смарт: Лопато 29.09.2023 //Восстановить и переделать механизм индивидуальных скидок
&НаКлиенте
Процедура смартСохранитьРучныеСкидкиКлиента(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Партнер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не заполнен клиент!'"));
		Возврат;	
	КонецЕсли;
	
	Если НЕ смартОбщегоНазначения.смартПравоРедактированияИндивидуальныхСкидокПартнера(Объект.Партнер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Недостаточно прав для редактирования индивидуальных скидок клиента!'"));
		Возврат;	
	КонецЕсли;
	
	Если Команда.Имя = "смартКомандаСохранитьРучныеСкидкиКлиентаИзВыделенныхСтрок" Тогда
		СписокСкидокДляСохранения = смартПолучитьСписокРучныхСкидокКлиентаДляСохранения(Элементы.Товары.ВыделенныеСтроки);
	Иначе
		СписокСкидокДляСохранения = смартПолучитьСписокРучныхСкидокКлиентаДляСохранения();
	КонецЕсли;
	
	Если СписокСкидокДляСохранения.Количество() > 0 Тогда
	
		ПараметрыСохраненияСкидок = Новый Структура;
		ПараметрыСохраненияСкидок.Вставить("Клиент", 					Объект.Партнер);
		ПараметрыСохраненияСкидок.Вставить("СписокСкидокДляСохранения", СписокСкидокДляСохранения);
		
		ОткрытьФорму("Документ.смартУстановкаИндивидуальныхСкидокКлиентов.ФормаОбъекта", ПараметрыСохраненияСкидок, ЭтаФорма);

	КонецЕсли;	
		
КонецПроцедуры //--#1323 смарт: Лопато 29.09.2023

//++#1323 смарт: Лопато 25.09.2023 //Восстановить и переделать механизм индивидуальных скидок
&НаСервере
Функция смартПолучитьСписокРучныхСкидокКлиентаДляСохранения(Знач ВыделенныеСтроки = Неопределено)
	
	СкидкиДляСохранения = Новый Массив;
	
	ДатаСкидки = ТекущаяДата();
	
	МассивНоменклатура = Объект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
	
	ТаблицаИндивидуальныеСкидкиКлиентов = смартОбщегоНазначения.смартПолучитьИндивидуальныеСкидкиКлиентов(ДатаСкидки, Объект.Партнер, МассивНоменклатура);
	
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл

		Если СтрокаТЧ.ПроцентРучнойСкидки <> 0 
			И (ВыделенныеСтроки = Неопределено ИЛИ (ВыделенныеСтроки <> Неопределено И ВыделенныеСтроки.Найти(СтрокаТЧ.НомерСтроки-1) <> Неопределено)) Тогда
			
			ТекущаяСкидка = 0;
			
			Если ТаблицаИндивидуальныеСкидкиКлиентов.Количество() > 0 Тогда
				
				ОтборИндивидуальныеСкидкиКлиентов = Новый Структура("Номенклатура", СтрокаТЧ.Номенклатура);
				СтрокиИндивидуальныеСкидкиКлиентов = ТаблицаИндивидуальныеСкидкиКлиентов.НайтиСтроки(ОтборИндивидуальныеСкидкиКлиентов);
				
				Если СтрокиИндивидуальныеСкидкиКлиентов.Количество() > 0 Тогда 
					ТекущаяСкидка = СтрокиИндивидуальныеСкидкиКлиентов[0].ПроцентСкидки;
				КонецЕсли;
				
			КонецЕсли;	
				
			Если СтрокаТЧ.ПроцентРучнойСкидки <> ТекущаяСкидка Тогда
				СкидкиДляСохранения.Добавить(Новый Структура("Номенклатура, ПроцентСкидки, НачалоДействия", 
															 СтрокаТЧ.Номенклатура, СтрокаТЧ.ПроцентРучнойСкидки, ДатаСкидки));
			ИначеЕсли ТекущаяСкидка <> 0 Тогда	
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По строке " + СокрЛП(СтрокаТЧ.НомерСтроки) + " для номенклатуры " + СокрЛП(СтрокаТЧ.Номенклатура) 
																  + " скидка " + СокрЛП(СтрокаТЧ.ПроцентРучнойСкидки) + "% уже действует с " + Формат(СтрокиИндивидуальныеСкидкиКлиентов[0].НачалоДействия, "ДФ=dd.MM.yyyy"));
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат СкидкиДляСохранения;
	
КонецФункции //--#1323 смарт: Лопато 25.09.2023 

//++#1517 смарт: Лопато 20.12.2023 //Установка статуса указания серий по дате начала серийного учета номенклатуры
