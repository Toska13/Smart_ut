Процедура смарт_СпособМестоДоставкиПеревозчикПриИзменении(Элемент)
	//смартКаратеев ++
	смартПереименоватьКнопкуБыстраяРеализацияПоДоставке();
	//Каратеев --
	
	//++ смарт:Подкин #896 11.02.2022 10:20:57 
	Если НЕ Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз") Тогда
        Объект.ЗонаДоставки = смартПолучитьЗонуДоставкиМосква();
	КонецЕсли;
	//-- смарт:Подкин #896 11.02.2022 10:20:57  

	
	//++ Смарт: Белоусова 566 27.06.2021
	Если Объект.СпособДоставки = ПредопределенноеЗначение("Перечисление.СпособыДоставки.смартСамовывозСоСкладаАдмирал") Тогда
	//если объект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз тогда
		Элементы.смартГруппаДоставкаДоп.видимость = истина;
		Элементы.смартЗаполнитьДоставкуПоКлиенту.Видимость = Ложь;
		Элементы.СтраницаДополнительныеРеквизитыДоставки.Видимость = Ложь;
