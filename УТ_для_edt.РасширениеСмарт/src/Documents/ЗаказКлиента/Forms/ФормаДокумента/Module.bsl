//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Процедура смартСформироватьЗаголовокДополнительнойГарантии()

	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И Объект.Дата >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение Тогда
		
		смартОбщегоНазначения.ИзменитьВидимостьЗаголовокДополнительнойГарантии(ЭтаФорма, 
			Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС"),
			Объект.Ссылка,
			Объект.Валюта);   
		
	КонецЕсли;
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024 

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
Процедура смартТекстДопУсловийОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//++ #2059 смарт: Мосолов 19.09.2024 // Подсказка для документов Интерес и Заказ клиента при первоначальной продажи Доп. гарантии 
	Если СокрЛП(НавигационнаяСсылкаФорматированнойСтроки) = "?" Тогда  
		Элементы.смартГруппаПодсказкаДопГарантии.Показать();
		Возврат;
	КонецЕсли;
	//-- #2059 смарт: Мосолов 19.09.2024  
	
	МассивСтрок = СтрРазделить(НавигационнаяСсылкаФорматированнойСтроки, ";");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НомерСтроки", Число(МассивСтрок[0]));
	СтруктураПараметров.Вставить("МесяцевГарантии", МассивСтрок[1]);
	СтруктураПараметров.Вставить("Цена", МассивСтрок[2]);
	
	Оповещение = Новый ОписаниеОповещения("смартЗавершениеВопросаДобавлениеГарантии", 
		ЭтотОбъект,
		СтруктураПараметров);
		
	Товар = смартПолучитьНоменклатуруИзСтроки(Число(МассивСтрок[0]));
	
	ТекстВопроса = "Вы хотите добавить дополнительную гарантию для номенклатуры "
		+ Товар
		+ " сроком на "
		+ МассивСтрок[1] 
		+ " месяцев?";
		
	ПоказатьВопрос(Оповещение,
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
Процедура смартЗавершениеВопросаДобавлениеГарантии(Результат, ПараметрыВопроса) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

   смартДобавитьСтрокуГарантии(ПараметрыВопроса.НомерСтроки, ПараметрыВопроса.МесяцевГарантии, ПараметрыВопроса.Цена);
   
   смартСформироватьЗаголовокДополнительнойГарантии();   
   
   РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
   
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Функция смартПолучитьНоменклатуруИзСтроки(НомерСтроки) 
	
	Отбор = Новый Структура("НомерСтроки", НомерСтроки);
	
	СтрокиТоваров = Объект.Товары.НайтиСтроки(Отбор);
	
	Возврат СтрокиТоваров[0].Номенклатура;
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Процедура смартДобавитьСтрокуГарантии(НомерСтроки, МесяцевГарантии, Цена) 
	
	СтрокаГарантии = Объект.Товары.Добавить();
	СтрокаГарантии.Номенклатура = Справочники.смартПредопределенныеЗначения.НоменклатураДополнительнойГарантии.Значение;
	
	Товар = смартПолучитьНоменклатуруИзСтроки(НомерСтроки);
	
	Цена = СтрЗаменить(Цена, " ", "");
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(
		Товар.Наименование + " - " + МесяцевГарантии + " мес. " + "(" + Товар.Код + ")"
		,
		,
		,
		СтрокаГарантии.Номенклатура.ВидНоменклатуры);
		
	Если Характеристика.Пустая() Тогда   
			
		Характеристика = смартСоздатьХарактеристикуДопГарантии(СтрокаГарантии.Номенклатура, 
			Товар.Наименование + " - " + МесяцевГарантии + " мес. " + "(" + Товар.Код + ")",
			МесяцевГарантии,
			Товар.Наименование + " - " + МесяцевГарантии + " мес."); 
			
		смартОбщегоНазначения.СоздатьУстановкуЦенДляДопГарантии(СтрокаГарантии.Номенклатура, Характеристика, Число(Цена), Объект.Дата);
			
	КонецЕсли;
		
	СтрокаГарантии.Характеристика = Характеристика;
	СтрокаГарантии.ВидЦены = Справочники.ВидыЦен.НайтиПоРеквизиту("Идентификатор", "РозничнаяRUB");
	СтрокаГарантии.КоличествоУпаковок = 1;
	СтрокаГарантии.Количество = 1;

	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект); 
	
	КэшированныеЗначения = Новый Структура;
    КэшированныеЗначения.Вставить("ИспользоватьРучныеСкидкиВПродажах", Истина);
    КэшированныеЗначения.Вставить("ИспользоватьАвтоматическиеСкидкиВПродажах", Неопределено);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПроверитьХарактеристикуПоВладельцу", СтрокаГарантии.Характеристика);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьУпаковкуПоВладельцу", СтрокаГарантии.Упаковка);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект, СкладГруппа));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, ПоДатеОтгрузки", Объект.НалогообложениеНДС, Объект.Дата, Истина));
	СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияЦеныВСтрокеТЧ(Объект));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
	СтруктураДействий.Вставить("ЗаполнитьПризнакВариантОформленияПродажи", Новый Структура("Номенклатура", "ВариантОформленияПродажи"));
	СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(Объект, Ложь));
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ЗаполнитьПризнакОтмененоБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
	СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", СтрокаГарантии.Склад, ПараметрыУказанияСерий));
	ПараметрыДействия = ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечение(ВариантыОбеспечения, Объект.ЖелаемаяДатаОтгрузки);
	СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечениеВДокументеПродажи", ПараметрыДействия);
	СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
		Новый Структура("ЕстьРаботы, ЕстьОтменено", Истина, Истина));
	
	СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
	ЭтаФорма.ИмяФормы, "Товары"));
	
	СтруктураДействий.Вставить("ЗаполнитьНоменклатуруПартнераПоНоменклатуре", Объект.Партнер);
	
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаГарантии, СтруктураДействий, КэшированныеЗначения);   
	
	СтрокаГарантии.Сумма = Число(Цена);
	
	ОперацииПередачи = ПродажиСервер.ОперацииПередачиТоваров();
	ПередачаТоваров = ОперацииПередачи.Найти(Объект.ХозяйственнаяОперация) <> Неопределено;

	СтруктураПересчетаЦены  = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект,
		ПередачаТоваров);
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах", СтруктураПересчетаЦены);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
	
	ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаГарантии, СтруктураДействий, КэшированныеЗначения);   
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаСервере
Функция смартСоздатьХарактеристикуДопГарантии(Товар, НаименованиеХарактеристики, МесяцевГарантии, НаименованиеДляПечати)  
	
	УстановитьПривилегированныйРежим(Истина);
	
	Характеристика = Справочники.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Характеристика.Владелец = Товар.ВидНоменклатуры;
	Характеристика.Наименование = НаименованиеХарактеристики;
	Характеристика.НаименованиеПолное = НаименованиеДляПечати;
	Характеристика.смартСрокГарантии = Число(МесяцевГарантии);
	Характеристика.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Характеристика.Ссылка;
	
КонецФункции //-- #1944 смарт: Мосолов 26.07.2024

//++ #1960 смарт: Мосолов 08.08.2024 // Создание механизма для учета продаж по Доп. гарантии и спец предложений&НаСервере
&ИзменениеИКонтроль("ПослеЗаписиНаСервере")
Процедура смарт_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	УстановитьДоступностьЭлементовПоСтатусуСервер();

	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();

	ОбновитьДубликатыЗависимыхРеквизитов();
	ПараметрыЗаполнения = Новый Структура("ЕстьРаботы, ЕстьОтменено", Истина, Истина);
	ОбеспечениеСервер.ЗаполнитьСлужебныеРеквизиты(Объект.Товары, ПараметрыЗаполнения, ДатаОтгрузкиОбязательна, СкладОбязателен);

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.ДекорацияСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;

	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

	// ИнтернетПоддержкаПользователей.СПАРКРиски
	СПАРКРиски.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски

	ОбновитьСостояниеСервер();
	ОбновитьСостояниеЭлементовУправленияИтоговПоРасчетам();
	ОбновитьОграничениеЗадолженности();

	МодификацияКонфигурацииПереопределяемый.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	
	#Вставка 
	//++ #1960 смарт: Мосолов 08.08.2024 // Создание механизма для учета продаж по Доп. гарантии и спец предложений&НаСервере
	Если ЗначениеЗаполнено(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение)
		И ТипЗнч(Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение) = Тип("Дата")
		И Объект.Дата >= Справочники.смартПредопределенныеЗначения.ДатаСтартаПредложенийДополнительнойГарантии.Значение Тогда
		
		РегистрыСведений.смартУчетСпециальныхПредложенийКлиентам.ЗаписатьНаборЗаписейПоГарантии(
			Объект.Товары.Выгрузить(, "НомерСтроки, Номенклатура, Характеристика, СуммаСНДС"),
			Объект.Ссылка,
			Объект.Валюта);   
		
	КонецЕсли;
	//-- #1960 смарт: Мосолов 08.08.2024   
	
	//++ #Б-1044 смарт: Мосолов 25.10.2024 //Закрыть бухгалтерии корректировку заказа клиента (ИТСМ 1270) 
	УстановитьВидимостьДоработанныхЭлементов();
	//-- #Б-1044 смарт: Мосолов 25.10.2024 
	#КонецВставки
	
	#Вставка
	//++ #2005 смарт: Фролов 26.08.2024 //Оповещение о необходимости привязать Интерес к Заказу срабатывает после привязки Интереса.
	Если Справочники.смартПредопределенныеЗначения.КонтролироватьНаличиеИнтересаВЗаказеКлиента.Значение = Истина
		И Объект.Дата > Дата("20240501") Тогда
		
		Если НЕ смартОбщегоНазначения.ПроверитьНаличиеИнтересаПоЗаказу(Объект.Ссылка) Тогда
			
			ЕстьОборудование = Ложь;
			
			СегментОборудование = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментАппаратноеОбеспечение"); 
			ТЗНоменклатураСегмента = СегментыСервер.СписокЭлементовСКД(СегментОборудование);
			МасОборудование = ТЗНоменклатураСегмента.ВыгрузитьКолонку("ЭлементСписка");
			
			Для Каждого Стр Из Объект.Товары Цикл
				
				Если НЕ МасОборудование.Найти(Стр.Номенклатура) = Неопределено Тогда
					ЕстьОборудование = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			
			Если ЕстьОборудование Тогда
				
				ОбщегоНазначения.СообщитьПользователю("Внимание! В данном заказе есть оборудование! Заказ должен быть создан на основании Интереса! 
				|Если вы не привяжете Интерес к заказу то не сможете напечатать счет!");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #2005 смарт: Фролов 26.08.2024
	
	//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
	Элементы.смартРазрешенаБесплатнаяДоставка.Подсказка = ПолучитьТекстИнформацииОСогласованииБесплатнойДоставки();
	//-- #Б4002 смарт: Шляпников 26.08.2025
	
	//++ #Б4868 смарт: Шляпников 12.11.2025 / Документ заказ клиента. Разделение контроля доставки. 
	Элементы.смартРазрешенаДоставкаЗаПределыУстановленнойЗоны.Подсказка = ПолучитьТекстИнформацииОСогласованииДоставкиВнеЗоны();
	//-- #Б4868 смарт: Шляпников 12.11.2025
	
	//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	//-- #Б4002 смарт: Шляпников 26.08.2025
	
	//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	//-- #Б6794 смарт: Шляпников 07.05.2026
	#КонецВставки
	
КонецПроцедуры //-- #1960 смарт: Мосолов 08.08.2024

//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
&НаКлиенте
&ИзменениеИКонтроль("ТоварыПриОкончанииРедактирования")
Процедура смарт_ТоварыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если Не ОтменаРедактирования Тогда
		КешСтроки = ?(НоваяСтрока, Неопределено, ТоварыКешТекущейСтроки);
		Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ДатаОтгрузки) И Объект.НеОтгружатьЧастями
			И (КешСтроки = Неопределено Или КешСтроки.ДатаОтгрузки <> ТекущиеДанные.ДатаОтгрузки) Тогда
			ПриИзмененииДатыОтгрузкиВТабЧасти(); // вызов сервера.
		КонецЕсли;
		СкладыКлиент.ОбновитьТаблицуСкладов(ТаблицаСкладов, ТекущиеДанные, КешСтроки, СкладГруппа);
		ВсегоСкладов = ТаблицаСкладов.Количество();
		СкладыКлиентСервер.ОбновитьКартинкуГруппыСкладов(НадписьНесколькоСкладов, Элементы.КартинкаНесколькоСкладов, ВсегоСкладов);
		#Вставка
		//++#5006 смарт: Тимофеева 24.11.2025 / Отчет "Кто передал"
		Если Элемент.ТекущийЭлемент.Имя = "ТоварысмартКтоПередал" Тогда 
			Если НЕ ТекущиеДанные = Неопределено 
				И ЗначениеЗаполнено(Объект.Менеджер) 
				И ЗначениеЗаполнено(ТекущиеДанные.смартКтоПередал) 
				И Объект.Менеджер = ТекущиеДанные.смартКтоПередал Тогда
				
				ТекущиеДанные.смартКтоПередал = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
				ОбщегоНазначенияКлиент.СообщитьПользователю("В колонку ""Кто передал"" нельзя установить менеджера заказа", , "ТоварысмартКтоПередал", ТекущиеДанные);
				
			КонецЕсли;
		КонецЕсли;
        //--#5006 смарт: Тимофеева 24.11.2025 
		
		//++ #1319 смарт: Фролов 01.03.2023 //Ограничение количества продаж и отмена скидок
		Если НЕ (Элемент.ТекущийЭлемент.Имя="ТоварыХарактеристика" ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварыСерия" ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварыВариантОбеспечения" ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварысмартКтоПередал" ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварысмартКтоКонсультировал" //++ #1936 смарт: Шляпников 20.01.2025 / Добавить колонку в заказ клиента "кто консультировал" и вывод в отчет
			ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварыСклад" ИЛИ Элемент.ТекущийЭлемент.Имя="ТоварыРекламноеВоздействие" ИЛИ Элемент.ТекущийЭлемент.Имя="ДатаОтгрузки" ИЛИ Элемент.ТекущийЭлемент.Имя="ЖелаемаяДатаОтгрузки") Тогда 
			//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
			смартПроверитьОтменитьСкидкуНаТоварКлиент(Объект, ТекущиеДанные);
		КонецЕсли;
		//-- #1319 смарт: Фролов 01.03.2023
		//--#1868 смарт: Лопато 19.06.2024 
		#КонецВставки
	КонецЕсли;

	Если ТекущиеДанные <> Неопределено И Объект.НеОтгружатьЧастями Тогда
		ТекущиеДанные.ДатаОтгрузки = Объект.ДатаОтгрузки;
	КонецЕсли;

	МногооборотнаяТараКлиент.ОбновитьСостояниеЗаполненияМногооборотнойТары(Объект.СостояниеЗаполненияМногооборотнойТары);
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);

	#Вставка
	//++ #1944 смарт: Мосолов 26.07.2024 // Реализовать механизм предложения доп гарантии при покупке оборудования. 
	смартСформироватьЗаголовокДополнительнойГарантии();
	//-- #1944 смарт: Мосолов 26.07.2024 
    #КонецВставки   
	
	#Вставка
	//++ #1807 смарт: Мосолов 05.07.2024 //Расчет автоматических скидок при записи
	смартВопросПроСкидкиЗадан = Ложь;
	смартЖдемОтветаНаВопросПроСкидки = Ложь;
	//-- #1807 смарт: Мосолов 05.07.2024 
    #КонецВставки
	
КонецПроцедуры //-- #1944 смарт: Мосолов 26.07.2024

&НаКлиенте
&ИзменениеИКонтроль("ОбработкаВыбора")
Процедура смарт_ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	// &ЗамерПроизводительности
	ОценкаПроизводительностиКлиент.НачатьЗамерВремени(
	Истина, "Документ.ЗаказКлиента.Форма.ФормаДокумента.Событие.ОбработкаВыбора");

	Если ИсточникВыбора.ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ИсполнениеЗаказа" Тогда

		Детали = ЗаполнитьОбеспечениеВУстановленномПорядке(ВыбранноеЗначение);
		Если Детали.Ошибки <> Неопределено Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Детали.Ошибки);
		Иначе
			ПоказатьОповещениеПользователя(ОбеспечениеКлиентСервер.ТекстЗаполнениеОбеспечения(), , Детали.Оповещение);
			СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);
		КонецЕсли;

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Перечисление.ВариантыОбеспечения.Форма.ВыборВариантаОбеспечения" Тогда

		Оповещение = ЗаполнитьВариантОбеспечения(ВыбранноеЗначение);
		ПоказатьОповещениеПользователя(ОбеспечениеКлиентСервер.ТекстЗаполнениеОбеспечения(), , Оповещение);

		СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.СостояниеОбеспечения.Форма.Форма" Тогда

		Оповещение = ЗаполнитьОбеспечениеЗаказа(ВыбранноеЗначение);
		ПоказатьОповещениеПользователя(ОбеспечениеКлиентСервер.ТекстЗаполнениеОбеспечения(), , Оповещение);

		СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.ЗаказКлиента.Форма.РеквизитыПечати" Тогда

		Если ВыбранноеЗначение <> Неопределено Тогда
			Модифицированность = Истина;
			ЗаполнитьЗначенияСвойств(Объект, ВыбранноеЗначение);
		КонецЕсли;

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ПодборТоваровВДокументПродажи.Форма.Форма" Тогда

		ОбработкаВыбораПодборНаКлиенте(ВыбранноеЗначение);
		
		#Вставка
		//++ #3946 смарт: Шляпников 31.07.2025 / Настройка правил продаж чернил МАРАБУ (Ковчег)
		ПравильныеДанныеПоОрганизации = смартСервер.ПолучитьПравильнуюОрганизациюИСоглашениеПоЗаказу(Объект);
		Если ПравильныеДанныеПоОрганизации.Организация <> Объект.Организация Тогда
			УстановитьПравильнуюОрганизациюИСоглашение(ПравильныеДанныеПоОрганизации);
		КонецЕсли;
		//-- #3946 смарт: Шляпников 31.07.2025
		#КонецВставки

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ПодборМногооборотнойТары.Форма.Форма" Тогда

		ЗаполнитьМногооборотнуюТаруИзХранилищаСервер(ВыбранноеЗначение.АдресМногооборотнойТарыВХранилище);
		МногооборотнаяТараКлиент.ОповеститьПользователяОЗаполненииМногооборотнойТарой();
		СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);

	ИначеЕсли НоменклатураКлиент.ЭтоУказаниеСерий(ИсточникВыбора) Тогда

		НоменклатураКлиент.ОбработатьУказаниеСерии(ЭтаФорма, ПараметрыУказанияСерий, ВыбранноеЗначение);

	ИначеЕсли ИсточникВыбора.ИмяФормы = "Обработка.ЗагрузкаДанныхИзВнешнихФайлов.Форма.Форма" Тогда

