    Если смартПроверять() Тогда 
        ВходитВСегмент=смартПроверитьВхождениеНоменклатурыВсегмент();
        Если НЕ ВходитВСегмент = Неопределено И ВходитВСегмент.Количество() Тогда
            Если ВходитВСегмент.Количество()=Объект.Товары.Количество() Тогда 
                //все товары ТЧ в сегменте 
                МассивСписок = СмартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ВалютыСоглашенийБитрикс",Истина); 
                СписокЗн=Новый СписокЗначений;
                Если НЕ Элементы.Валюта.СписокВыбора.Количество()=2 Тогда
                    Для каждого Стр  Из МассивСписок Цикл
                        Элементы.Валюта.СписокВыбора.Добавить(Стр,Строка(Стр));
                    КонецЦикла;   
