//++ #Б-3430 смарт: Фролов 01.06.2025 //Документ "Заказ клиента". Ограничение продажи СНПЧ
Процедура смартОтправитьНаСогласованиеСНПЧНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	
	СписокИсполнителей = CRM_БизнесПроцессыСервер.ПолучитьВозможныхИсполнителейПоРоли(
							Справочники.РолиИсполнителей.смартСогласователиПродажСНПЧ);
							
	Для Каждого Пользователь Из СписокИсполнителей Цикл						
		
		смартПоставитьЗадачуСогласованияСНПЧ(Пользователь.Значение);
		
	КонецЦикла;
	
	
	МассивАдресовДляОтправки = Новый Массив;
	АдресаДляОтправкиСтрокой = "";
	
	Для Каждого Пользователь Из СписокИсполнителей Цикл
		
		МассивАдресовДляОтправки.Добавить(Новый Структура("Адрес, Представление", Пользователь.Значение.смартРабочаяПочта, 
			Пользователь.Значение.смартРабочаяПочта));
		АдресаДляОтправкиСтрокой = АдресаДляОтправкиСтрокой + ?(ЗначениеЗаполнено(АдресаДляОтправкиСтрокой), ", ", "") 
			+ Пользователь.Значение.смартРабочаяПочта;
		
	КонецЦикла;
		
	УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	
	ТестовыеАдресаСтрока = "";
	ТестовыеАдресаМассив = смартОбщегоНазначения.ПолучитьТестовыеАдресаДляРассылок(ТестовыеАдресаСтрока);
	
	ЭтоТестоваяБаза = НЕ смартОбщегоНазначения.смартРабочаяБаза();
	
	Если ЗначениеЗаполнено(УчетнаяЗапись)
			И (ТестовыеАдресаМассив.Количество() > 0
				ИЛИ (МассивАдресовДляОтправки.Количество() > 0 И НЕ ЭтоТестоваяБаза)) Тогда
				
		ОбъектЗаказ = Объект.Ссылка.ПолучитьОбъект();
		НавСсылка = ПолучитьНавигационнуюСсылку(ОбъектЗаказ);
				
		ТемаПисьма = "Согласование продажи СНПЧ по заказу №" + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ='dd.MM.yyyy ""г.""'");
		
		ТекстПисьма = "В заказе: " + Объект.Номер + Символы.ПС +
		"Ссылка на заказ: " + НавСсылка + Символы.ПС +
		"Присутствует СНПЧ продаваемая отдельно от плоттера MIMAKI. требуется ваше согласование!";
		 		
		ДанныеОтправки = Новый Структура("Тема,Заголовок", ТемаПисьма, ТекстПисьма);
		
		ПараметрыПисьма = смартОбщегоНазначения.ПолучитьПараметрыОтправки(МассивАдресовДляОтправки, ДанныеОтправки, 
			, ТестовыеАдресаМассив, ТестовыеАдресаСтрока, ЭтоТестоваяБаза);
		
		Попытка
			
			ИдентификаторПисьма = РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыПисьма);
			Если ПараметрыПисьма.ТестоваяБаза Тогда
				ТекстСообщения = "Отправлено письмо о согласовании СНПЧ по заказу " + Объект.Номер + " НА ТЕСТОВУЮ ПОЧТУ " + ПараметрыПисьма.ТестовыеАдреса + 
					" (в рабочей базе отправилось бы на почту " +  АдресаДляОтправкиСтрокой + ")";				
			Иначе
				ТекстСообщения = "Отправлено письмо о согласовании СНПЧ по заказу " + Объект.Номер + " на почту " +  АдресаДляОтправкиСтрокой;				
			КонецЕсли;
			ЗаписьЖурналаРегистрации("ОтправкаСогласованияПоСНПЧ", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		Исключение 
			
			ТекстСообщения = "Не удалось отправить письмо о согласовании СНПЧ по заказу " + Объект.Номе + Символы.ПС + ОписаниеОшибки();
			ЗаписьЖурналаРегистрации("ОтправкаСогласованияПоСНПЧ", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		КонецПопытки;
		
	КонецЕсли;
		
КонецПроцедуры //-- #Б-3430 смарт: Фролов 01.06.2025	

&НаСервере
//++ #Б-3430 смарт: Фролов 01.06.2025 //Документ "Заказ клиента". Ограничение продажи СНПЧ
Процедура смартПоставитьЗадачуСогласованияСНПЧ(Исполнитель)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗадачаОбъект = Задачи.ЗадачаИсполнителя.СоздатьЗадачу();
	ЗадачаОбъект.Дата = ТекущаяДатаСеанса();
