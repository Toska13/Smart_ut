	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо = &ФизическоеЛицо
	|	И ОтветственныеЛицаОрганизаций.Владелец = &Организация
	|	И ОтветственныеЛицаОрганизаций.ДатаНачала <= &Период
	|	И ВЫБОР
	|			КОГДА ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ &Период <= ОтветственныеЛицаОрганизаций.ДатаОкончания
	|		КОНЕЦ
	|	И ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизаций.Ссылка,
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо,
	|	2
	|ИЗ
	|	Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.Владелец = &Организация
	|	И ОтветственныеЛицаОрганизаций.ДатаНачала <= &Период
	|	И ВЫБОР
	|			КОГДА ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ &Период <= ОтветственныеЛицаОрганизаций.ДатаОкончания
	|		КОНЕЦ
	|	И ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|	И НЕ ОтветственныеЛицаОрганизаций.ПравоПодписиПоДоверенности
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизаций.Ссылка,
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо,
	|	1
	|ИЗ
	|	Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.ФизическоеЛицо = &ФизическоеЛицо
	|	И ОтветственныеЛицаОрганизаций.Владелец = &Организация
	|	И ОтветственныеЛицаОрганизаций.ДатаНачала <= &Период
	|	И ВЫБОР
	|			КОГДА ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ &Период <= ОтветственныеЛицаОрганизаций.ДатаОкончания
	|		КОНЕЦ
	|	И ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизаций.Ссылка,
	|	ОтветственныеЛицаОрганизаций.ОтветственноеЛицо,
	|	2
	|ИЗ
	|	Справочник.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
	|ГДЕ
	|	ОтветственныеЛицаОрганизаций.Владелец = &Организация
	|	И ОтветственныеЛицаОрганизаций.ДатаНачала <= &Период
	|	И ВЫБОР
	|			КОГДА ОтветственныеЛицаОрганизаций.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ &Период <= ОтветственныеЛицаОрганизаций.ДатаОкончания
	|		КОНЕЦ
	|	И ОтветственныеЛицаОрганизаций.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)
	|	И НЕ ОтветственныеЛицаОрганизаций.ПравоПодписиПоДоверенности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеОтветственные.ОтветственноеЛицо КАК ОтветственноеЛицо,
	|	МИНИМУМ(ВТ_ВсеОтветственные.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВТ_Приоритеты
	|ИЗ
	|	ВТ_ВсеОтветственные КАК ВТ_ВсеОтветственные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВсеОтветственные.ОтветственноеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеОтветственные.Ссылка КАК Ссылка,
	|	ВТ_ВсеОтветственные.ОтветственноеЛицо КАК ОтветственноеЛицо,
	|	ВТ_ВсеОтветственные.Приоритет КАК Приоритет
	|ИЗ
	|	ВТ_ВсеОтветственные КАК ВТ_ВсеОтветственные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Приоритеты КАК ВТ_Приоритеты
	|		ПО ВТ_ВсеОтветственные.ОтветственноеЛицо = ВТ_Приоритеты.ОтветственноеЛицо
	|			И ВТ_ВсеОтветственные.Приоритет = ВТ_Приоритеты.Приоритет";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ПараметрыСеанса.ТекущийПользователь.ФизическоеЛицо);
	Запрос.УстановитьПараметр("Период", 		ТекущаяДата());
	Запрос.УстановитьПараметр("Организация", 	Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Руководитель = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель;
	ГлавныйБухгалтер = Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ОтветственноеЛицо = Руководитель Тогда
			СтруктураВозврата.Вставить("Руководитель", Выборка.Ссылка);
		ИначеЕсли Выборка.ОтветственноеЛицо = ГлавныйБухгалтер Тогда
			СтруктураВозврата.Вставить("ГлавныйБухгалтер", Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции //-- смарт:ММ 13.02.2020

