	//	Если ПравильныеДанныеПоОрганизации.Организация <> Объект.Организация Тогда
	//		УстановитьПравильнуюОрганизациюИСоглашение(ПравильныеДанныеПоОрганизации);
	//		ОбщегоНазначенияКлиент.СообщитьПользователю("Повторите запись документа",,,, Отказ);
	//	КонецЕсли; 
	//КонецЕсли;
	//-- #5082 смарт: Тимофеева 01.12.2025
	
	//++ #5358 смарт: Тимофеева 12.01.26 / Заказ клиента. Запретить отгрузку от ООО Ковчег   
	Если НЕ смартНеВыполнятьПроверкуПередЗаписью И НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		РезультатПроверки = ПроверитьВозможностьЗаписиПоОрганизации();
		
		Если РезультатПроверки.ТребуетсяВывестиУведомлениеМенеджеру Тогда			
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатПроверки.ТекстУведомления,,,, Отказ);
		КонецЕсли;

	КонецЕсли;
	//-- #5358 смарт: Тимофеева 12.01.26

КонецПроцедуры //-- #1436 смарт: Фролов 25.08.2023

//++ #1807 смарт: Мосолов 05.07.2024 //Расчет автоматических скидок при записи
&НаСервере 
Функция смартПроверитьВозможностьАвтоматическихСкидок()
	
	СтруктураПараметры = Новый Структура;
	СтруктураПараметры.Вставить("ПрименятьКОбъекту",                Ложь);
	СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет",      Истина);
	СтруктураПараметры.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
	СтруктураПараметры.Вставить("УправляемыеСкидки", УправляемыеСкидки);
	
	РезультатПредварительногоРасчета = СкидкиНаценкиСервер.Рассчитать(Объект, СтруктураПараметры);
	
	СтрокиСкидок = РезультатПредварительногоРасчета.ДеревоСкидок.Строки.НайтиСтроки(Новый Структура("Управляемая", Ложь), Истина); 
	
	Для Каждого СтрокаСкидок Из СтрокиСкидок Цикл
		
		Если СтрокаСкидок.ПараметрыУсловий.УсловияВыполнены Тогда
			
			//++ #Б-1234 смарт: Мосолов 29.10.2024 //Уведомление об автоматических скидках выводить только один раз 
			Если СтрокаСкидок.ПараметрыУсловий.КодыСтрок.Количество() Тогда 
				
				Для Каждого КодСтроки Из СтрокаСкидок.ПараметрыУсловий.КодыСтрок Цикл
					
					Отбор = Новый Структура;
					Отбор.Вставить("КлючСвязи", КодСтроки);
					СтрокиТоваров  = Объект.Товары.НайтиСтроки(Отбор);
					
					Если НЕ СтрокиТоваров.Количество() = 0
						И СтрокиТоваров[0].СуммаАвтоматическойСкидки = 0 Тогда
						
						Возврат Истина;
						
					КонецЕсли;   
					
				КонецЦикла;
				
			Иначе
				
				Для Каждого СтрокаТовара Из Объект.Товары Цикл
					
					Если СтрокаТовара.СуммаАвтоматическойСкидки = 0 Тогда
						
						Возврат Истина;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			//-- #Б-1234 смарт: Мосолов 29.10.2024 
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;

КонецФункции //-- #1807 смарт: Мосолов 05.07.2024 

