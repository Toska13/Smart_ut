&НаКлиенте
Функция ПроверитьПравильностьЗаполненияКоличестваВСтроке(Строка)
	
	Намотка = СтрокуВЧисло(Строка(Строка.Характеристика));
	
	Если Не Намотка = 1 Тогда
		КоличествоКОтгрузке = Строка.КоличествоУпаковок;
	Иначе
		КоличествоКОтгрузке = Истина;
	КонецЕсли;
		
	Возврат ОтгрузкаВРулонахКратнаНамотке(Намотка, КоличествоКОтгрузке);
	
КонецФункции

