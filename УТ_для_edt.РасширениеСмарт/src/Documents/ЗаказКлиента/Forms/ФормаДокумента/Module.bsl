Процедура РассчитатьАкции()

	смартАкцииИСкидки.РассчитатьАкцииВФормеЗаказеКлиента(ЭтаФорма);
	ОбновитьДубликатыЗависимыхРеквизитов();
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаСервере
Процедура ЗаполнитьДействующиеАкцииПоСтрокамТоваров()
	
	Для каждого стрТовары Из Объект.Товары Цикл
		
		НайденныеСтроки = Объект.смартАкции.НайтиСтроки(Новый Структура("КодСтроки", стрТовары.КодСтроки));
		Если НайденныеСтроки.Количество() > 0 Тогда
			стрТовары.смартДействующаяАкцияСтроки = НайденныеСтроки[0].ВидАкции;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаСервере
Функция ПолучитьНовыйКодСтроки()
	
	МаксКодСтроки = 0;
	Для каждого стрТовары Из Объект.Товары Цикл
		МаксКодСтроки = Макс(МаксКодСтроки, стрТовары.КодСтроки);
	КонецЦикла;
	
	Возврат МаксКодСтроки + 1;
	
КонецФункции

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаСервере
Процедура УдалитьАкцииБезТоваровИзДокумента()
	
	Количество = Объект.смартАкции.Количество();
	Для н = 1 По Количество Цикл
		
		стрАкция = Объект.смартАкции[Количество - н];
		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КодСтроки", стрАкция.КодСтроки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Объект.смартАкции.Удалить(стрАкция);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаКлиенте
Процедура смартНазначитьАкциюНаНоменклатуру(Команда)
	
	Если Элементы.Товары.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(Элементы.Товары.ТекущаяСтрока);
	
	Если ТекущаяСтрока.КодСтроки = 0 Тогда
		
		ТекущаяСтрока.КодСтроки = ПолучитьНовыйКодСтроки();
		Объект.МаксимальныйКодСтроки = ТекущаяСтрока.КодСтроки;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ПараметрыФормы.Вставить("КодСтроки", ТекущаяСтрока.КодСтроки);
	
	ОткрытьФорму("Документ.смартУправлениеАкциями.Форма.ДействующиеАкцииПоНоменклатуре", ПараметрыФормы, ЭтаФорма,,,, Новый ОписаниеОповещения("смартНазначитьАкциюНаНоменклатуруЗавершение", ЭтаФорма));
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаКлиенте
Процедура смартНазначитьАкциюНаНоменклатуруЗавершение(Значение, ДопПараметры) Экспорт
	
	Если НЕ Значение = Неопределено Тогда
		
		Если ЭтоАдресВременногоХранилища(Значение) Тогда
			
			МасивНовыхСтрок = смартНазначитьАкциюНаНоменклатуруЗавершениеСервер(Значение);
			
			Для каждого НоваяСтрока Из МасивНовыхСтрок Цикл 
				
				Элементы.Товары.ТекущаяСтрока = НоваяСтрока;
				
				ТоварыНоменклатураПриИзменении(Элементы.ТоварыНоменклатура);
				смарт_ТоварыНоменклатураПриИзмененииПосле(Элементы.ТоварыНоменклатура);
				
				ТоварыСерияПриИзменении(Элементы.ТоварыСерия);
				
				смарт_ТоварыКоличествоУпаковокПриИзмененииПеред(Элементы.ТоварыКоличествоУпаковок);
				ТоварыКоличествоУпаковокПриИзменении(Элементы.ТоварыКоличествоУпаковок);
				
			КонецЦикла;
			
			РассчитатьАкции();
			ПересчитатьСуммуГрафикаОплаты();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаСервере
Функция смартНазначитьАкциюНаНоменклатуруЗавершениеСервер(Адрес) Экспорт
	
	ТЗ = ПолучитьИзВременногоХранилища(Адрес);
	МасивНовыхСтрок = Новый Массив;
	
	Для каждого стрТЗ Из ТЗ Цикл
		
		НайденныеАкции = Объект.смартАкции.НайтиСтроки(Новый Структура("КодСтроки", стрТЗ.КодСтроки));
		Если НайденныеАкции.Количество() > 0 Тогда
			стрАкция = НайденныеАкции[0];
		Иначе
			стрАкция = Объект.смартАкции.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(стрАкция, стрТЗ);
		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КодСтроки", стрАкция.КодСтроки));
		Если НайденныеСтроки.Количество() = 0 Тогда
			Объект.смартАкции.Удалить(стрАкция);
		Иначе
			МасивНовыхСтрок.Добавить(НайденныеСтроки[0].ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МасивНовыхСтрок;
	
КонецФункции


