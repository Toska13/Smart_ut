		Элементы.смартГруппаДоставкаДоп.видимость = Ложь;
		Элементы.смартЗаполнитьДоставкуПоКлиенту.Видимость = Истина;
		Элементы.СтраницаДополнительныеРеквизитыДоставки.Видимость = Истина;
	КонецЕсли;
	  
	//-- Смарт: Белоусова 566 27.06.2021
	
