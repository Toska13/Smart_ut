//++ #Б4002 смарт: Шляпников 26.08.2025 / Документ Заказ клиента. Запрет проведения при несоблюдении требований платной доставки
&НаСервере
Функция ПолучитьТекстИнформацииОСогласованииБесплатнойДоставки()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.смартИДРазрешенияНаБесплатнуюДоставку) Тогда
		Возврат "Нет информации о разрешении";
	Иначе
		
		ДанныеОРазрешении = РегистрыСведений.смартИсторияИзмененияРазрешений.ПолучитьИнформациюПоРазрешению(Объект.Ссылка, Объект.смартИДРазрешенияНаБесплатнуюДоставку, "БесплатнаяДоставка");
		
		Если ДанныеОРазрешении <> Неопределено Тогда
			Возврат СтрШаблон("Разрешение %1 пользователем %2 %3", ?(ДанныеОРазрешении.Разрешено, "установлено", "снято"), ДанныеОРазрешении.Ответственный, ДанныеОРазрешении.ДатаИзменения);
		КонецЕсли;
		
		Возврат "Нет информации о разрешении";
		
	КонецЕсли;
	
КонецФункции

//++ #Б4868 смарт: Шляпников 12.11.2025 / Документ заказ клиента. Разделение контроля доставки. 
