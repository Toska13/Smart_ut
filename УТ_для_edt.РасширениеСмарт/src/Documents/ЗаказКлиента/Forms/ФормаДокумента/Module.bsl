Процедура смарт_ТоварыПроцентРучнойСкидкиПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	#Вставка
	//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
	смартПроверитьОтменитьСкидкуНаТоварКлиент(Объект, ТекущаяСтрока);
	//--#1868 смарт: Лопато 19.06.2024

	//++ смарт:Подкин #914 01.03.2022 15:51:40 ограничения применения скидки больше максимальной, указанной в соглашении
	Если НЕ смартДоступностьРоли("смартРазрешитьСкидкуБольшеМаксимальной,ПолныеПрава") Тогда

		//++#1868 смарт: Лопато 19.06.2024 //Доработать механизм индивидуальных скидок (прод 1323)  
		СтруктураПараметровДопустимаяСкидка = Новый Структура;
		СтруктураПараметровДопустимаяСкидка.Вставить("Номенклатура", 			  ТекущаяСтрока.Номенклатура);
		СтруктураПараметровДопустимаяСкидка.Вставить("Цена",  					  ТекущаяСтрока.Цена);
		СтруктураПараметровДопустимаяСкидка.Вставить("Количество", 				  ТекущаяСтрока.КоличествоУпаковок);
		СтруктураПараметровДопустимаяСкидка.Вставить("ПовышеннаяСкидкаРазрешена", Объект.смартРазрешитьПовышеннуюСкидку);
		СтруктураПараметровДопустимаяСкидка.Вставить("ПроцентПовышеннойСкидки",   Объект.смартПроцентРазрешеннойМаксимальнойСкидки);
		СтруктураПараметровДопустимаяСкидка.Вставить("Дата",					  Объект.Дата);
		СтруктураПараметровДопустимаяСкидка.Вставить("Партнер", 				  Объект.Партнер);

		СтруктураКонтроля = смартОбщегоНазначения.смартПолучитьДопустимуюСуммуСкидки(СтруктураПараметровДопустимаяСкидка); 
		//--#1868 смарт: Лопато 19.06.2024

		Если НЕ СтруктураКонтроля=Неопределено И СтруктураКонтроля.ПроцентРучнойСкидки<ТекущаяСтрока.ПроцентРучнойСкидки Тогда
			ТекстСообщения = НСтр("ru = 'Процент скидки превышает максимальное возможное значение:'") + " " + СтруктураКонтроля.ПроцентРучнойСкидки;
			СтруктураКонтроля.Вставить("ПолеВызова","Процент");
			ПоказатьВопрос(Новый ОписаниеОповещения("смартОКЗавершениеПревышение", ЭтотОбъект, СтруктураКонтроля), ТекстСообщения + ". ", РежимДиалогаВопрос.ОК); 

			Возврат;	

		КонецЕсли; 

	КонецЕсли;
	//-- смарт:Подкин #914 01.03.2022 15:51:40  
	
	//++ #Б6458 смарт: Шляпников 15.04.2026 / Проверить механизм назначения скидок
	ЗаполнитьДанныеОМаксимальнойСкидке(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекущаяСтрока.ПолучитьИдентификатор()));
	ПроверитьВозможностьНазначенияРучнойСкидки(ТекущаяСтрока.ПолучитьИдентификатор(), Истина);
	//-- #Б6458 смарт: Шляпников 15.04.2026
	#КонецВставки

	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);

	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());

	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);

	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);

КонецПроцедуры

#КонецОбласти


