//++ #Б5008 смарт: Шляпников 20.11.2025 / Создание механизма контроля максимальных скидок.
&НаСервере
Процедура ЗаполнитьДанныеОМаксимальнойСкидке(МассивСтрок = Неопределено)
	
	Если МассивСтрок = Неопределено Тогда
		Строки = Объект.Товары;
	Иначе
		
		Строки = Новый Массив;
		Для каждого стрМассивСтрок Из МассивСтрок Цикл
			Строки.Добавить(Объект.Товары.НайтиПоИдентификатору(стрМассивСтрок));
		КонецЦикла;
		
	КонецЕсли;
	
	МассивНоменклатуры = Новый Массив;
	Для каждого стр Из Строки Цикл
		МассивНоменклатуры.Добавить(стр.Номенклатура);
	КонецЦикла;
	
	ДанныеОСкидках = смартАкцииИСкидки.ПолучитьМаксимальныеСкидкиДляМассиваНоменклатуры(Объект.Дата, МассивНоменклатуры, Объект.Организация, Объект.Партнер);
	
	Для каждого стр Из Строки Цикл
		
		НайденныеСтроки = ДанныеОСкидках.НайтиСтроки(Новый Структура("Номенклатура", стр.Номенклатура));
		
		Если НайденныеСтроки.Количество() > 0 И НЕ НайденныеСтроки[0].Отменена Тогда
			
			Если НЕ НайденныеСтроки[0].СкидкаЗапрещена Тогда
				
				стр.смартТекстМаксимальнаяСкидка = СтрШаблон("Мак. скидка %1%%", НайденныеСтроки[0].МаксимальнаяСкидка);
				стр.смартМаксимальнаяСкидка = НайденныеСтроки[0].МаксимальнаяСкидка;
				
			Иначе
				
				стр.смартТекстМаксимальнаяСкидка = "Финальная цена";
				стр.смартМаксимальнаяСкидка = 0;
				
			КонецЕсли;
			
		Иначе
			
			стр.смартТекстМаксимальнаяСкидка = "";
			стр.смартМаксимальнаяСкидка = 10000;
			
		КонецЕсли;
		
	КонецЦикла;
	
	РассчитатьПревышенияМаксимальнойСкидки(МассивСтрок);
	
КонецПроцедуры

//++ #Б5008 смарт: Шляпников 20.11.2025 / Создание механизма контроля максимальных скидок.
&НаСервере
Процедура РассчитатьПревышенияМаксимальнойСкидки(МассивСтрок = Неопределено)
	
	Если МассивСтрок = Неопределено Тогда
		Строки = Объект.Товары;
	Иначе
		
		Строки = Новый Массив;
		Для каждого стрМассивСтрок Из МассивСтрок Цикл
			Строки.Добавить(Объект.Товары.НайтиПоИдентификатору(стрМассивСтрок));
		КонецЦикла;
		
	КонецЕсли;
	
	Для каждого стр Из Строки Цикл
		
		стр.смартМаксимальнаяСкидкаПревышена = (стр.ПроцентРучнойСкидки > стр.смартМаксимальнаяСкидка);
		
	КонецЦикла;
	
КонецПроцедуры

//++ #Б6458 смарт: Шляпников 15.04.2026 / Проверить механизм назначения скидок
&НаСервере
Процедура ПроверитьВозможностьНазначенияРучнойСкидки(ИДСтроки, НеПересчитыватьСкидку = Ложь)
	
	Если Объект.смартРазрешитьПовышеннуюСкидку ИЛИ Пользователи.РолиДоступны("смартРазрешитьСкидкуБольшеМаксимальной") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ИДСтроки);
	Если ТекущаяСтрока.ПроцентРучнойСкидки > ТекущаяСтрока.смартМаксимальнаяСкидка Тогда
		
		ТекущаяСтрока.ПроцентРучнойСкидки = ТекущаяСтрока.смартМаксимальнаяСкидка;
		ТекущаяСтрока.смартМаксимальнаяСкидкаПревышена = Ложь; 
		
		Если НЕ НеПересчитыватьСкидку Тогда
			
			КэшированныеЗначения = Неопределено;
			
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
		
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
			СтруктураДействий.Вставить("ПересчитатьСумму");
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
			СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
			
			ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
			
			РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//++ #5006 смарт: Тимофеева 24.11.2025 / Отчет "Кто передал"
&НаКлиенте
Процедура смарт_МенеджерПриИзмененииПосле(Элемент)
	Для Каждого СтрокаТовары Из Объект.Товары Цикл     	
		Если ЗначениеЗаполнено(Объект.Менеджер)
			И ЗначениеЗаполнено(СтрокаТовары.смартКтоПередал) 
			И Объект.Менеджер = СтрокаТовары.смартКтоПередал Тогда 
			СтрокаТовары.смартКтоПередал = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");
			ОбщегоНазначенияКлиент.СообщитьПользователю("В колонке ""Кто передал"" очищено значение, совпадающее с менеджером заказа");
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры

