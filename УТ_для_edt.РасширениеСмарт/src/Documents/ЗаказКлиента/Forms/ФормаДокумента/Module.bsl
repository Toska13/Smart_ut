//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаКлиенте
Процедура смартПодборАкцийЗавершение(Значение, ДопПараметры) Экспорт
	
	Если НЕ Значение = Неопределено Тогда
		
		Если ЭтоАдресВременногоХранилища(Значение) Тогда
			
			МасивНовыхСтрок = смартПодборАкцийЗавершениеСервер(Значение);
			
			Для каждого НоваяСтрока Из МасивНовыхСтрок Цикл 
				
				Элементы.Товары.ТекущаяСтрока = НоваяСтрока;
				
				ТоварыНоменклатураПриИзменении(Элементы.ТоварыНоменклатура);
				смарт_ТоварыНоменклатураПриИзмененииПосле(Элементы.ТоварыНоменклатура);
				
				ТоварыСерияПриИзменении(Элементы.ТоварыСерия);
				
				смарт_ТоварыКоличествоУпаковокПриИзмененииПеред(Элементы.ТоварыКоличествоУпаковок);
				ТоварыКоличествоУпаковокПриИзменении(Элементы.ТоварыКоличествоУпаковок);
				
			КонецЦикла;
			
			РассчитатьАкции();
			ПересчитатьСуммуГрафикаОплаты();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
&НаСервере
Функция смартПодборАкцийЗавершениеСервер(Адрес) Экспорт
	
	ТЗ = ПолучитьИзВременногоХранилища(Адрес);
	Объект.смартАкции.Загрузить(ТЗ);
	
	МасивНовыхСтрок = Новый Массив;
	
	Количество = Объект.смартАкции.Количество();
	Для н = 1 По Количество Цикл
		
		стрАкция = Объект.смартАкции[Количество - н];
		
		Если НЕ ЗначениеЗаполнено(стрАкция.КодСтроки) Тогда
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Номенклатура = стрАкция.Номенклатура;
			НоваяСтрока.КодСтроки = ПолучитьНовыйКодСтроки();
			НоваяСтрока.смартДействующаяАкцияСтроки = стрАкция.ВидАкции;
			НоваяСтрока.Количество = стрАкция.Количество;
			НоваяСтрока.КоличествоУпаковок = стрАкция.Количество;
			
			Объект.МаксимальныйКодСтроки = НоваяСтрока.КодСтроки;
			
			стрАкция.КодСтроки = НоваяСтрока.КодСтроки;
			
			МасивНовыхСтрок.Добавить(НоваяСтрока.ПолучитьИдентификатор());
			
		Иначе
			
			НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("КодСтроки", стрАкция.КодСтроки));
			Если НайденныеСтроки.Количество() = 0 Тогда
				Объект.смартАкции.Удалить(стрАкция);
			Иначе
				
				Если стрАкция.Количество <> НайденныеСтроки[0].Количество Тогда
					
					НайденныеСтроки[0].Количество = стрАкция.Количество;
					НайденныеСтроки[0].КоличествоУпаковок = стрАкция.Количество;
					
					МасивНовыхСтрок.Добавить(НайденныеСтроки[0].ПолучитьИдентификатор());
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МасивНовыхСтрок;
	
КонецФункции

//++ #Б4818 смарт: Шляпников 17.11.2025 / Создание механизма учета скидок и акций по оборудованию.
