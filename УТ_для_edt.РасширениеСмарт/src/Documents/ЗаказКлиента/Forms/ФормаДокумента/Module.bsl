			НСтр("ru = '  Выберите пожалуйста оператора ЭДО, которым предпочитает пользоваться клиент.'")
			+ Символы.ПС
			+НСтр("ru = '  Указание предпочитаемого оператора ЭДО поможет не тратить время на выяснение, каким оператором пользуется клиент'")
			+ Символы.ПС
			+НСтр("ru = '  Эта информация будет полезна как менеджерам, так и бухгалтерам, юристам и т.д.'")
			);
	//-- смарт: #1438 Корбутов 04.09.2023  добавление выбора основного ЭДО контрагента 
	Иначе
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
		ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), ЭтаФорма);
