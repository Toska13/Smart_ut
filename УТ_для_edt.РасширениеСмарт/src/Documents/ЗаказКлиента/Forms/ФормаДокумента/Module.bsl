//++ #4822 смарт: Тимофеева 02.04.2026 / Контроль дебиторской задолженности. Реализация блокировки клиента. Отгрузка с отсрочкой платежа (по договору). Этап 2
&НаСервере
Процедура смартУстановитьПараметрыВыбораДоговора()
	
	Если НЕ ЗначениеЗаполнено(Объект.Соглашение) Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Договор.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
	ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "Статус", Перечисления.СтатусыДоговоровКонтрагентов.Действует);
	ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "ПометкаУдаления", Ложь);
	
	//++ #7676 смарт: Тимофеева 31.07.2026 / Контроль дебиторской задолженности. Выбор кредитного договора. Дополнение.
	//ЭтоИндивидуальноеСоглашение = НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Соглашение, "Типовое");
	РеквизитыСоглашения 		= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Соглашение, "Типовое, ЭтапыГрафикаОплаты");
	ЭтоИндивидуальноеСоглашение = НЕ РеквизитыСоглашения.Типовое;
	ЭтоКредитноеСоглашение 		= Ложь;
	ВыборкаЭтапов				= РеквизитыСоглашения.ЭтапыГрафикаОплаты.Выбрать(); 
	Пока ВыборкаЭтапов.Следующий() Цикл
		Если ВыборкаЭтапов.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.КредитПослеОтгрузки
			ИЛИ ВыборкаЭтапов.ВариантОплаты = Перечисления.ВариантыОплатыКлиентом.КредитСдвиг Тогда
			ЭтоКредитноеСоглашение = Истина;	
		КонецЕсли;
	КонецЦикла;
	//-- #7676 смарт: Тимофеева 31.07.2026
	Если ЭтоИндивидуальноеСоглашение
		//++ #7676 смарт: Тимофеева 31.07.2026 / Контроль дебиторской задолженности. Выбор кредитного договора. Дополнение.
		И ЭтоКредитноеСоглашение 
		//-- #7676 смарт: Тимофеева 31.07.2026
		Тогда 
		ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "ТипДоговора", Перечисления.ТипыДоговоров.СПокупателем);
		ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "ОграничиватьСуммуЗадолженности", Истина); 
		ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "смартВидДоговора", Перечисления.смартВидыДоговоров.РасходныеМатериалыОтсрочка);  
	//++ #7448 смарт: Тимофеева 14.07.2026 / Контроль дебиторской задолженности. Выбор кредитного договора.
	Иначе
	    ОбщегоНазначенияУТКлиентСервер.ДобавитьПараметрВыбора(Элементы.Договор, "ИсключитьКредитныеДоговорыПоРасходнымМатериалам", Истина);
	//-- #7448 смарт: Тимофеева 14.07.2026
	КонецЕсли;
	
КонецПроцедуры
//-- #4822 смарт: Тимофеева 02.04.2026

//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
