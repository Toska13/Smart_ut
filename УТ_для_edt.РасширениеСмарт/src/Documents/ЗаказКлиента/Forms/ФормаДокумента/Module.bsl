//++ #Б-2554 смарт: Лопато 04.03.2025 //Исправить алгоритм создания Интереса по онлайн заказам  
Функция ЭтоОнлайнЗаказБезИнтереса(ЗаказОбъект)
	
	Результат = Ложь;

	//Проверка активности функционала распределения и оповещения
	ФункционалВключен = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаВключено;
	
	Если НЕ ФункционалВключен Тогда
		Возврат Результат;
	КонецЕсли;	
	
	//Проверка, что заказ не помечен на удаление и не отменен
	Если ЗаказОбъект.ПометкаУдаления
		 ИЛИ (ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт
			 	И ЗаказОбъект.СуммаДокумента = 0) Тогда
				
		Возврат Результат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) КАК Заказ
	|ПОМЕСТИТЬ ОнлайнЗаказы
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения
	|ГДЕ
	|   ВЫРАЗИТЬ(Объект КАК Документ.ЗаказКлиента) = &Заказ
	|	И Свойство = &Свойство
	|	И Значение = &Значение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента) КАК Заказ
	|ПОМЕСТИТЬ Обработанные
	|ИЗ
	|	Документ.смартЛид
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОнлайнЗаказы 
	|		ПО ((ВЫРАЗИТЬ(ДокументОснование КАК Документ.ЗаказКлиента)) = ОнлайнЗаказы.Заказ)
	|			И (НЕ ПометкаУдаления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Заказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОнлайнЗаказы.Заказ КАК Заказ
	|ИЗ
	|	ОнлайнЗаказы КАК ОнлайнЗаказы	
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обработанные КАК Обработанные
	|		ПО (ОнлайнЗаказы.Заказ = Обработанные.Заказ)
	|ГДЕ		
	|	Обработанные.Заказ ЕСТЬ NULL";
	
	СвойствоОффлайнЗаказ = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", "ОффлайнЗаказ");
    ЗначениеОффлайнЗаказ = "N";
	
	Запрос.УстановитьПараметр("Свойство", СвойствоОффлайнЗаказ);
	Запрос.УстановитьПараметр("Значение", ЗначениеОффлайнЗаказ);
	Запрос.УстановитьПараметр("Заказ", 	  ЗаказОбъект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ЦФО 	 = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаБизнесРегионЦФО;
		СуммаЦФО = Справочники.смартПредопределенныеЗначения.Настройки.РаспределениеЗаказовСайтаСуммаЦФО;

		ЗаказБизнесРегион = ЗаказОбъект.Партнер.БизнесРегион;
		
		Если НЕ (ЗаказОбъект.СуммаДокумента <= СуммаЦФО
				 И (ЗаказБизнесРегион = ЦФО ИЛИ ЗаказБизнесРегион.ПринадлежитЭлементу(ЦФО))) Тогда
				 
			Результат = Истина;
			
		КонецЕсли;	
				 
	КонецЕсли;	

	Возврат Результат;
				
КонецФункции //-- #Б-2554 смарт: Лопато 04.03.2025

//++ #3946 смарт: Шляпников 31.07.2025 / Настройка правил продаж чернил МАРАБУ (Ковчег)
&НаСервере
Процедура УстановитьПравильнуюОрганизациюИСоглашение(ПравильныеДанныеПоОрганизации)
	
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Произведена замена организации С %1 на %2 и замена соглашения с %3 на %4", 
													 Объект.Организация, 
													 ПравильныеДанныеПоОрганизации.Организация, 
													 Объект.Соглашение, 
													 ПравильныеДанныеПоОрганизации.Соглашение));
													 
	Объект.Организация = ПравильныеДанныеПоОрганизации.Организация;
	Объект.Соглашение = ПравильныеДанныеПоОрганизации.Соглашение;
	
	ОрганизацияПриИзмененииСервер();
	
	Если Не ЗначениеЗаполнено(Объект.Соглашение) Тогда
		ПоСоглашениюИспользуютсяДоговорыКонтрагентов = Ложь;
		Возврат;
	КонецЕсли;
	
	СоглашениеПриИзмененииСервер();
	
КонецПроцедуры
