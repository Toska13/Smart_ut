&НаСервереБезКонтекста
Функция ПолучитьОстатокКОформлению(ЗаказКлиента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыКОтгрузкеОстатки.КОформлениюОстаток КАК КОформлениюОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(&Период, ДокументОтгрузки = &ЗаказКлиента) КАК ТоварыКОтгрузкеОстатки";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
	Запрос.УстановитьПараметр("Период", ЗаказКлиента.ДатаОтгрузки + 1);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ТипЗнч(Выборка.КОформлениюОстаток) = Тип("Число") Тогда
			Возврат Выборка.КОформлениюОстаток;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции //-- смарт:ММ 11.02.2020

