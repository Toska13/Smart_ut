Процедура смартВидимостьСрокаПоставки()
	//смарт+ Вахов Владимир /568 / 28.06.2021 
	
	ЭлементСрокПоставки = Элементы.Найти("смартСрокПоставки");
	
	Если ЭлементСрокПоставки = Неопределено И Элементы.Договор.Видимость Тогда
		
		//++ #1334 смарт: Фролов 03.04.2023 //Заявка на формирование и подписание договора из 1С 
		//НовыйЭлемент = Элементы.Добавить("смартСрокПоставки", Тип("ПолеФормы"), Элементы.ГруппаНадписьДоговор);  
		НовыйЭлемент = Элементы.Добавить("смартСрокПоставки", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.смартСрокПоставки";
		НовыйЭлемент.КнопкаРегулирования = Истина; 
		НовыйЭлемент.Видимость = Ложь;
		//НовыйЭлемент.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Лево;
		//-- #1334 смарт: Фролов 03.04.2023

		
	КонецЕсли;	
	
	Если ЭлементСрокПоставки <> Неопределено Тогда
			
		//++ #1334 смарт: Фролов 18.04.2023 //Заявка на формирование и подписание договора из 1С 
		//ЭлементСрокПоставки.Видимость = Элементы.Договор.Видимость; 
		ЭлементСрокПоставки.Видимость = Ложь;
		
		 
		//Если Объект.Ссылка.Договор <> Объект.Договор Тогда
		//	Объект.смартСрокПоставки = 0;
		//КонецЕсли;
		//-- #1334 смарт: Фролов 03.04.2023
		
	КонецЕсли;	
	//++ #1334 смарт: Фролов 04.04.2023 //Заявка на формирование и подписание договора из 1С 
	ЭлементсмартЗаполнитьЗаявкуНаДоговор=Элементы.Найти("смартЗаполнитьЗаявкуНаДоговор"); 
	Если ЭлементсмартЗаполнитьЗаявкуНаДоговор = Неопределено Тогда
		НоваяКоманда		= ЭтаФорма.Команды.Добавить("СформироватьЗаявкуНаПодготовкуДоговора");
		НоваяКоманда.Действие	= "смартЗаполнитьЗаявкуНаДоговорКоманда";
		
		НовыйЭлемент = Элементы.Вставить("смартЗаполнитьЗаявкуНаДоговор", Тип("КнопкаФормы"),Элементы.ГруппаНадписьДоговор);
		НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НовыйЭлемент.ИмяКоманды = "СформироватьЗаявкуНаПодготовкуДоговора";
		НовыйЭлемент.Заголовок="Заявка на договор"; 
		
		смартСервер.смартДобавитьКнопкуИнформацииНаФорму("СформироватьЗаявкуНаПодготовкуДоговора", "поле ""Заполнение заявки на договор""", 
													 Элементы.ГруппаНадписьДоговор, ЭтаФорма);
	КонецЕсли; 
	Если Объект.НалогообложениеНДС=ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНаЭкспорт") Тогда
		Элементы.смартЗаполнитьЗаявкуНаДоговор.Видимость=Ложь;
		Элементы.КнопкасмартИнформация_СформироватьЗаявкуНаПодготовкуДоговора.Видимость=ложь;
	Иначе
		Элементы.смартЗаполнитьЗаявкуНаДоговор.Видимость= Элементы.Договор.Видимость И НЕ ЗначениеЗаполнено(Объект.Договор);
		Элементы.КнопкасмартИнформация_СформироватьЗаявкуНаПодготовкуДоговора.Видимость= Элементы.Договор.Видимость И НЕ ЗначениеЗаполнено(Объект.Договор);
	КонецЕсли;	
	//-- #1334 смарт: Фролов 04.04.2023
КонецПроцедуры

