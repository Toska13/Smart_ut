&НаСервере
Функция смартПроверитьВхождениеНоменклатурыВсегмент() 
    
    МассивНоменклатуры=Объект.Товары.Выгрузить(,"Номенклатура");  
    Если МассивНоменклатуры.Количество() Тогда
        Запрос = Новый Запрос;
        
        Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        |	НоменклатураСегмента.Номенклатура
        |ИЗ
        |	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
        |ГДЕ
        |	НоменклатураСегмента.Сегмент = &СегментСсылка
        |	И НоменклатураСегмента.Номенклатура В (&ОбъектСсылка)";
        
        Запрос.УстановитьПараметр("ОбъектСсылка",МассивНоменклатуры);
        Запрос.УстановитьПараметр("СегментСсылка",Справочники.СегментыНоменклатуры.НайтиПоНаименованию("ТоварыДляЗаказаВВалюте"));
        Если НЕ Запрос.Выполнить().Пустой() Тогда
        
        	 ТЗ= Запрос.Выполнить().Выгрузить();
             МассивНом=ТЗ.ВыгрузитьКолонку("Номенклатура"); 
             
             Возврат МассивНом; 
             
         Иначе            
             
            Возврат Неопределено;   
            
        КонецЕсли;
                 
    КонецЕсли;
    
    Возврат Неопределено;
        
КонецФункции //-- смарт:Подкин #946 23.03.2022 9:27:05

