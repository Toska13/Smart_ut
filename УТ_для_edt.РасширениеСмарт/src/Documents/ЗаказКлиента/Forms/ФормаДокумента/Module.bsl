&НаСервере
Процедура НастроитьВидимостьДоступность()
	
	ВидимостьДатаОплаты = Ложь;
	
	ЮрЛицоНеРезидент = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент;
	
	Если РольДоступна("ПолныеПрава") 
		Или Объект.Контрагент.ЮрФизЛицо = ЮрЛицоНеРезидент Тогда
		ВидимостьДатаОплаты = Истина;
	КонецЕсли;
	
	Если Объект.Контрагент.ЮрФизЛицо <> ЮрЛицоНеРезидент Тогда
		Если ЗначениеЗаполнено(Объект.смартДатаОплаты) Тогда
			ЭтаФорма.Модифицированность = Истина;
		КонецЕсли;
		Объект.смартДатаОплаты = Неопределено;
	КонецЕсли;
	
	Элементы.смартДатаОплаты.Видимость = ВидимостьДатаОплаты;
	
	//++ смарт:ММ #093 450 04.02.2021 - Доработка Заказа клиента
	Элементы.смартКонечныйПокупатель.ТолькоПросмотр = НЕ Объект.смартПродажаЧерезДилера;
	//-- смарт:ММ 04.02.2021
	
КонецПроцедуры //-- смарт:ММ 16.12.2020


