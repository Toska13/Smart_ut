&НаКлиенте
Процедура смартПроцентРазрешеннойМаксимальнойСкидкиКоманда()   
	
	//++ #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
	ДанныеРуководителяСтруктура = смартДанныеРуководителяСПравомПовышеннойСкидкой(); 
	
	Если ДанныеРуководителяСтруктура.ПравоПредоставлено Тогда
	//-- #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
	
		//++ #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
		Если Объект.смартПроцентРазрешеннойМаксимальнойСкидки > ДанныеРуководителяСтруктура.К2 Тогда
		//-- #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
			
			Сообщение = Новый СообщениеПользователю;
			
			//++ #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
			Сообщение.Текст = "Внимание! Скидка не может превышать: " + ДанныеРуководителяСтруктура.К2 + "%"; 
			//-- #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
			
            Сообщение.ПутьКДанным = "Объект.смартПроцентРазрешеннойМаксимальнойСкидки";
            Сообщение.Сообщить(); 
			
			Объект.смартПроцентРазрешеннойМаксимальнойСкидки = 0;
            
            Объект.смартРазрешитьПовышеннуюСкидку=Истина; 
            смартРазрешитьПовышеннуюСкидкуКоманда();
			
		КонецЕсли;
		
    КонецЕсли; 
    
	Если НЕ Объект.смартПроцентРазрешеннойМаксимальнойСкидки = 0 Тогда
		
        Объект.смартРазрешитьПовышеннуюСкидку = Истина; 
        смартРазрешитьПовышеннуюСкидкуКоманда(); 
		
    КонецЕсли;
    
