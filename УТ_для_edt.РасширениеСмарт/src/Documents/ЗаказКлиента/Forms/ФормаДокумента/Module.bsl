//++ #1434 смарт: Фролов 25.08.2023 //Исправить ошибку "Не заполнены цены в документе!"  
&НаКлиенте
Процедура  смартПроверитьВозможностьФормированияДоговораДалее(СтруктураПроверки) 
	
	Если СтруктураПроверки.ДоговорКонтрагента = Неопределено Тогда 
		
		Если СтруктураПроверки.ОборудованиеДляДоговора.Количество() И СтруктураПроверки.ПроверкаСуммы Тогда 
			
			ПараметрыДляДоговора = Новый Структура("ОборудованиеДляДоговора, Организация", СтруктураПроверки.ОборудованиеДляДоговора, Объект.Организация);  
			
			Если ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "смартЛизинговаяКомпания") Тогда 
				
				ОткрытьФорму("ОбщаяФорма.смартСозданиеДоговораЛизинга", ПараметрыДляДоговора, ЭтаФорма);  
				
			Иначе	                                                                                       
				
				ОткрытьФорму("ОбщаяФорма.смартЗаданиеНаПодготовкуПроектаДоговораПоставки", ПараметрыДляДоговора, ЭтаФорма);  
				
			КонецЕсли;  
			
		Иначе 
			
			Если СтруктураПроверки.ОборудованиеДляДоговора.Количество() = 0 ТОгда 
				
				Сообщить("Данная функция применяется только для договоров на оборудование!");
				
			Иначе  
				
				Сообщить("Не заполнены цены в документе!");
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе   
		
		Сообщить("Для данного документа уже есть договор " + СтруктураПроверки.ДоговорКонтрагента + ""); 
		
		Объект.Договор = СтруктураПроверки.ДоговорКонтрагента;
		
	КонецЕсли;  
	
КонецПроцедуры  //-- #1434 смарт: Фролов 25.08.2023

//++ #1334 смарт: Фролов 03.04.2023 //Заявка на формирование и подписание договора из 1С 
&НаСервере
Функция смартПроверитьВозможностьФормированияДоговора()
	
	ПроверкаСуммы = Истина;
	ОборудованиеДляДоговора = Новый Массив;
	//++ #Б-2074 смарт: Лопато 21.02.2025 //Создать сегмент "Обязательное заключение договора"  
	СегментОборудование = Справочники.СегментыНоменклатуры.НайтиПоРеквизиту("смартИдентификаторДляФормул", "СегментПродажиПоДоговору"); 
	//-- #Б-2074 смарт: Лопато 21.02.2025
	ТЗНоменклатураСегмента = СегментыСервер.СписокЭлементовСКД(СегментОборудование);
	МасОборудование = ТЗНоменклатураСегмента.ВыгрузитьКолонку("ЭлементСписка");
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		
		Если НЕ МасОборудование.Найти(СтрокаТовары.Номенклатура) = Неопределено Тогда 
			
			ОборудованиеДляДоговора.Добавить(СтрокаТовары.Номенклатура); 
			
		КонецЕсли;
		
		Если СтрокаТовары.Сумма = 0 Тогда 
			
			ОбщегоНазначения.СообщитьПользователю("В строке " + СтрокаТовары.НомерСтроки + " " + СтрокаТовары.Номенклатура +"  не заполнена сумма.",,,, Истина);
			
			ПроверкаСуммы = Ложь;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления 
	//++ #1744 смарт: Мосолов 04.04.2024 //Добавить проверку в Заказ клиента при изменении Контрагента  
	|	И ДоговорыКонтрагентов.Контрагент = &Контрагент 
	//-- #1744 смарт: Мосолов 04.04.2024 
	|	И ДоговорыКонтрагентов.смартЗаказКлиента = &ЗаказКлиента");  
	
	Запрос.УстановитьПараметр("ЗаказКлиента", Объект.Ссылка); 
	
	//++ #1744 смарт: Мосолов 04.04.2024 //Добавить проверку в Заказ клиента при изменении Контрагента  
	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент); 
	//-- #1744 смарт: Мосолов 04.04.2024 
	
	Выборка = Запрос.Выполнить().Выбрать();   
	
	Если Выборка.Следующий() Тогда  
		
		ДоговорКонтрагента = Выборка.Ссылка; 
		
	Иначе  
		
		ДоговорКонтрагента = Неопределено; 
		
	КонецЕсли;	
	
	Возврат Новый Структура("ОборудованиеДляДоговора, ПроверкаСуммы, ДоговорКонтрагента", ОборудованиеДляДоговора, ПроверкаСуммы, ДоговорКонтрагента);  
	
КонецФункции //-- #1334 смарт: Фролов 03.04.2023	

//++ #1334 смарт: Фролов 12.04.2023 //Заявка на формирование и подписание договора из 1С 
&НаКлиенте
Процедура смартДействиеПоказатьИнформацию(Команда)
	
	Если СтрНайти(Команда.Имя, "СформироватьЗаявкуНаПодготовкуДоговора") <> 0 Тогда
		ИнформацияЗаголовок = "Заполнение заявки на договор";
		ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
			  НСтр("ru = 'Все заявки на договоры в юр. отдел, <b>с 13 апреля 2023г.</b> оформляются только из 1С.'")
			+ Символы.ПС 
			+ НСтр("ru = 'Так же теперь все сканы подписанных договоров прикрепляются к договору, а не к заказу клиента.'")
			+ Символы.ПС 
			+ НСтр("ru = 'Если у вас сделка с участием лизинговой компании, необходимо в карточке контрагента установить признак Лизинговая компания (смарт). В этом случае форма заявки будет другой.'")
			+ Символы.ПС 
			+ Символы.ПС
			+ НСтр("ru = 'При оформлении заявки будет автоматически создан договор и прикреплен к заказу клиента.'")
			+ Символы.ПС
			+ НСтр("ru = 'Пожалуйста не изменяйте договор в заказе, так как после заполнения заявки, юристы начинают работать над подготовкой договора.'") 
			+ Символы.ПС
			+ НСтр("ru = 'В договоре, созданном при помощи кнопки <b>""Заявка на договор""</b>, на вкладке <b>""Печать договоров""</b> можно посмотреть текст с параметрами заявки на договор.'") 
			);
	//++ смарт: #1438 Корбутов 04.09.2023  добавление выбора основного ЭДО контрагента 
	ИначеЕсли СтрНайти(Команда.Имя, "смартИнформация_смартВыборОсновногоЭДО") <> 0 Тогда
		ИнформацияЗаголовок = "Выбор предпочтительного оператора ЭДО контрагента";
