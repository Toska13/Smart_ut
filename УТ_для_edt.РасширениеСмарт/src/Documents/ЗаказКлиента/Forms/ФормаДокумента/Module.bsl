	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("АдресТаблицыАкций", ПоместитьТаблицуАкцийДокументаВоВременноеХранилище());
	
	ОткрытьФорму("Документ.смартУправлениеАкциями.Форма.ТекущиеАкции", ПараметрыФормы, ЭтаФорма,,,, Новый ОписаниеОповещения("смартПодборАкцийЗавершение", ЭтаФорма));
	
