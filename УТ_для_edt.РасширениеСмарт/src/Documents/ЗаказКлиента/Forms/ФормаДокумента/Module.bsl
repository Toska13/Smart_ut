//++#1547 смарт: Лопато 02.04.2024 //Автоматическое заполнение серий чернил в заказах
&НаКлиенте
&После("ДатаОтгрузкиПриИзменении")
Процедура смарт_ДатаОтгрузкиПриИзмененииПосле(Элемент)

	ЗаполнитьСтатусыУказанияСерий();

	смартЗаполнитьСтрокиОбеспечениеОтгрузитьСериямиПоFEFOКлиент();
	
КонецПроцедуры //--#1547 смарт: Лопато 02.04.2024

//++#1547 смарт: Лопато 02.04.2024 //Автоматическое заполнение серий чернил в заказах
&НаКлиенте
Процедура смартЗаполнитьСтрокиОбеспечениеОтгрузитьСериямиПоFEFOКлиент(ТекущаяСтрока = Неопределено)

	ВыделенныеСтрокиДляЗаполнения = Новый Массив;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Если смартСтрокаТовараПодходитДляПерезаполненияСерийПоFEFO(Элементы.Товары.ТекущиеДанные) Тогда
			
			ВыделенныеСтрокиДляЗаполнения.Добавить(ТекущаяСтрока);
			
		КонецЕсли;	
		
	Иначе
		
		Для Каждого СтрокаТовары Из Объект.Товары Цикл
			
			Если смартСтрокаТовараПодходитДляПерезаполненияСерийПоFEFO(СтрокаТовары) Тогда
				
				ВыделенныеСтрокиДляЗаполнения.Добавить(Объект.Товары.Индекс(СтрокаТовары));
				
			КонецЕсли;
			
		КонецЦикла;	

	КонецЕсли;		
		
	Если ВыделенныеСтрокиДляЗаполнения.Количество() Тогда
		
		Детали = смартЗаполнитьСтрокиОбеспечениеОтгрузитьСериямиПоFEFOСервер(ВыделенныеСтрокиДляЗаполнения);

		Если Детали.Ошибки <> Неопределено Тогда
			ОчиститьСообщения();
			ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Детали.Ошибки);
		Иначе
			ПоказатьОповещениеПользователя(ОбеспечениеКлиентСервер.ТекстЗаполнениеОбеспечения(), , Детали.Оповещение);
			СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры //--#1547 смарт: Лопато 02.04.2024

//++#1547 смарт: Лопато 27.05.2024 //Автоматическое заполнение серий чернил в заказах
&НаКлиенте
Функция смартСтрокаТовараПодходитДляПерезаполненияСерийПоFEFO(СтрокаТовара)

	Возврат СтрокаТовара.СтатусУказанияСерий <> 0
			И смартДействуетОсобыйУчетСерий(СтрокаТовара.Номенклатура)
			И (СтрокаТовара.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.Отгрузить") 
			   ИЛИ СтрокаТовара.ВариантОбеспечения = ПредопределенноеЗначение("Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно"));

КонецФункции //--#1547 смарт: Лопато 27.05.2024

