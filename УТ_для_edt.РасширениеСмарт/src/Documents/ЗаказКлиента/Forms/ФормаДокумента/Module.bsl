//++ #5358 смарт: Тимофеева 12.01.26 / Заказ клиента. Запретить отгрузку от ООО Ковчег
&НаСервере
Функция ПроверитьВозможностьЗаписиПоОрганизации()
	Результат = Новый Структура;
	Результат.Вставить("ТребуетсяВывестиУведомлениеМенеджеру", Ложь);
	Результат.Вставить("ТекстУведомления", "");
	
	Если НЕ Пользователи.РолиДоступны("смартМенеджерБэкОфис") И 
		Объект.Организация = Справочники.смартПредопределенныеЗначения.Настройки.ОрганизацияКовчег Тогда
		Результат.ТребуетсяВывестиУведомлениеМенеджеру = Истина;
		Результат.ТекстУведомления = СтрШаблон("Запрещена отгрузка от организации %1", Объект.Организация);
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции
