//++ #Б5736 смарт: Шляпников 06.03.2026 / Разрешить редактировать заказы клиента не смотря на установленную Финальную скидку
&НаСервере
Процедура ЗаблокироватьИзменениеДокументаПриПревышенииМаксимальнойСкидки()
	
	Если НЕ Пользователи.РолиДоступны("смартРазрешитьСкидкуБольшеМаксимальной") Тогда
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		МассивПолей = Новый Массив;
		МассивПолей.Добавить("ТоварыНоменклатура");
		МассивПолей.Добавить("ТоварыХарактеристика");
		МассивПолей.Добавить("ТоварыСерия");
		МассивПолей.Добавить("ТоварыКоличествоУпаковок");
		МассивПолей.Добавить("ТоварыУпаковка");
		МассивПолей.Добавить("ТоварыНоменклатураЕдиницаИзмерения");
		МассивПолей.Добавить("ТоварыВидЦены");
		МассивПолей.Добавить("ТоварыЦена");
		МассивПолей.Добавить("ТоварыЦенаВВалюте");
		МассивПолей.Добавить("ТоварыСмартКонвертацияЦены");
		МассивПолей.Добавить("ТоварыПроцентАвтоматическойСкидки");
		МассивПолей.Добавить("ТоварыСуммаАвтоматическойСкидки");
		МассивПолей.Добавить("ТоварыПроцентРучнойСкидки");
		МассивПолей.Добавить("ТоварыСуммаРучнойСкидки");
		МассивПолей.Добавить("ТоварыЦенаСоСкидкой");
		МассивПолей.Добавить("ТоварыСумма");
		МассивПолей.Добавить("ТоварыСуммаНДС");
		МассивПолей.Добавить("ТоварыСуммаСНДС");
		МассивПолей.Добавить("ТоварыСтавкаНДС");
		
		Для каждого стрПоле Из МассивПолей Цикл
			ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(стрПоле);
		КонецЦикла;
			
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Товары.смартМаксимальнаяСкидкаПревышена");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Истина;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		ЕстьПревышение = Ложь;
		
		МассивНоменклатуры = Объект.Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура");
		
		ДанныеОСкидках = смартАкцииИСкидки.ПолучитьМаксимальныеСкидкиДляМассиваНоменклатуры(Объект.Дата, МассивНоменклатуры, Объект.Организация, Объект.Партнер);
		
		Для каждого стр Из Объект.Товары Цикл
			
			НайденныеСтроки = ДанныеОСкидках.НайтиСтроки(Новый Структура("Номенклатура", стр.Номенклатура));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если (НайденныеСтроки[0].МаксимальнаяСкидка < стр.ПроцентРучнойСкидки ИЛИ (НайденныеСтроки[0].СкидкаЗапрещена И стр.ПроцентРучнойСкидки > 0)) И НЕ НайденныеСтроки[0].Отменена Тогда
					ЕстьПревышение = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЕстьПревышение Тогда
			
			Элементы.ГруппаШапка.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


//++ #4792 смарт: Тимофеева 17.03.26 / Контроль дебиторской задолженности. Реализация блокировки клиента. Техническая отсрочка. Этап 1 
&НаКлиенте
&ИзменениеИКонтроль("НадписьЭтапыОплатыНажатие")
Процедура смарт_НадписьЭтапыОплатыНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Попытка
		ЗаблокироватьДанныеФормыДляРедактирования();
	Исключение
		ПоказатьПредупреждение(Неопределено, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТолькоПросмотр",             ТолькоПросмотр 
	Или Не РедактированиеРеквизитовEDIКлиентСервер.РеквизитДоступенДляРедактирования(ЭтотОбъект, "ЭтапыГрафикаОплаты"));
	ПараметрыФормы.Вставить("СуммаОплатыПоДокументу",     СуммаЗаказано);
	ПараметрыФормы.Вставить("СуммаЗалогаПоДокументу",     СуммаЗалогаЗаТару);
	ПараметрыФормы.Вставить("СуммаОтклоненияПоДокументу", Объект.ЭтапыГрафикаОплаты.Итог("СуммаОтклоненияМерныхТоваров"));
	ПараметрыФормы.Вставить("СуммаДопустимогоОтклоненияПоДокументу",
	ПолучитьСуммуДопустимогоОтклоненияПредоплатыПоДокументу());
	ПараметрыФормы.Вставить("ТребуетсяЗалогЗаТару",       Объект.ВернутьМногооборотнуюТару И Объект.ТребуетсяЗалогЗаТару);
	ПараметрыФормы.Вставить("ГрафикОплаты",               Объект.ГрафикОплаты);
	Если ПроверитьПравоНаЧтениеСоглашения() Тогда
		ПараметрыФормы.Вставить("Соглашение",             Объект.Соглашение);
	КонецЕсли;

	ПараметрыФормы.Вставить("ЖелаемаяДатаОтгрузки",       ?(ЗначениеЗаполнено(Объект.ЖелаемаяДатаОтгрузки), Объект.ЖелаемаяДатаОтгрузки, Объект.ДатаОтгрузки));
	ПараметрыФормы.Вставить("Дата",                       Объект.Дата);
	ПараметрыФормы.Вставить("Валюта",                     Объект.Валюта);
	ПараметрыФормы.Вставить("УникальныйИдентификатор",    УникальныйИдентификатор);
	ПараметрыФормы.Вставить("АдресВоВременномХранилище",  ПоместитьВоВременноеХранилищеНаСервере("ЭтапыГрафикаОплаты"));
	ПараметрыФормы.Вставить("ФормаОплаты",                Объект.ФормаОплаты);
	ПараметрыФормы.Вставить("Касса",                      Объект.Касса);
	ПараметрыФормы.Вставить("БанковскийСчет",             Объект.БанковскийСчет);
	ПараметрыФормы.Вставить("Организация",                Объект.Организация);
	ПараметрыФормы.Вставить("ПараметрыВыбораРеквизитов",  ПараметрыВыбораРеквизитов);
	ПараметрыФормы.Вставить("ИдентификаторПлатежа",       Объект.ИдентификаторПлатежа);
	ПараметрыФормы.Вставить("ПорядокРасчетов",            Объект.ПорядокРасчетов);
	ПараметрыФормы.Вставить("ДоступныеПорядкиРасчетов",   ДоступныеПорядкиРасчетов);
	ПараметрыФормы.Вставить("ЭтоЗаказ",                   Истина);
	ПараметрыФормы.Вставить("Ключ",                       Объект.Ссылка);
	ПараметрыФормы.Вставить("НаправлениеДеятельности",    Объект.НаправлениеДеятельности);
	ПараметрыФормы.Вставить("Договор",                    Объект.Договор);
	ПараметрыФормы.Вставить("ПорядокОплаты",              Объект.ПорядокОплаты);
	ПараметрыФормы.Вставить("ВалютаВзаиморасчетов",       Объект.Валюта);
	ПараметрыФормы.Вставить("УпрощенныйРежим",            ИспользоватьУпрощеннуюСхемуОплатыВПродажах); 
	#Вставка
	ПараметрыФормы.Вставить("СостояниеПоТехническойОтсрочке", СостояниеПоТехническойОтсрочке(Объект.Партнер, Объект.Дата));
	#КонецВставки

	Оповещение = Новый ОписаниеОповещения("НадписьЭтапыОплатыНажатиеЗавершение", ЭтотОбъект);

	ОткрытьФорму("ОбщаяФорма.ЭтапыОплатыКлиентом", 
	ПараметрыФормы, 
	ЭтаФорма,,,, 
	Оповещение, 
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры 

