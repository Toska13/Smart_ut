//++ #4426 смарт: Тимофеева 24.09.2025 / Заказ клиента. Обработка Заполнить доставку по клиенту. Доработка. Этап 2.
&НаСервере
Процедура ЗаполнитьСпискиВыбораАдресовДоставки()
	Элементы.АдресДоставкиПолучателя.СписокВыбора.Очистить();
	Элементы.АдресДоставкиПолучателя1.СписокВыбора.Очистить();
	Элементы.АдресДоставкиПолучателя2.СписокВыбора.Очистить();
	
	Для Каждого СтрокаАдреса Из ПолучитьТаблицуАдресовДоставки() Цикл		
		СтруктураВыбора = Новый Структура;
		СтруктураВыбора.Вставить("АдресДоставки", "");
		СтруктураВыбора.Вставить("АдресДоставкиЗначенияПолей", "");
		СтруктураВыбора.Вставить("ЗонаДоставки", Справочники.ЗоныДоставки.ПустаяСсылка());
		СтруктураВыбора.Вставить("ВремяДоставкиС", Дата(1,1,1));
		СтруктураВыбора.Вставить("ВремяДоставкиПо", Дата(1,1,1));
		СтруктураВыбора.Вставить("ДополнительнаяИнформацияПоДоставке", "");
		
		ЗаполнитьЗначенияСвойств(СтруктураВыбора, СтрокаАдреса);
		ПредставлениеАдресаДоставки = СтрШаблон("%1: %2", СтрокаАдреса.Вид, СтрокаАдреса.АдресДоставки);
		Элементы.АдресДоставкиПолучателя.СписокВыбора.Добавить(СтруктураВыбора, ПредставлениеАдресаДоставки);
		Элементы.АдресДоставкиПолучателя1.СписокВыбора.Добавить(СтруктураВыбора, ПредставлениеАдресаДоставки);
		Элементы.АдресДоставкиПолучателя2.СписокВыбора.Добавить(СтруктураВыбора, ПредставлениеАдресаДоставки);
	КонецЦикла;
КонецПроцедуры 

&НаСервере
Функция ПолучитьТаблицуАдресовДоставки()	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Партнер);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Партнеры.смартПартнерАдресДоставки КАК АдресДоставки,
	//++ #Б4248 смарт: Шляпников 16.09.2025 / Доставка товаров по заказу клиента, корректность заполнения, печать Этикетки доставки
	|	Партнеры.смартПартнерАдресДоставкиЗначение КАК АдресДоставкиЗначение,
	|	Партнеры.смартПартнерАдресДоставкиЗначенияПолей КАК АдресДоставкиЗначенияПолей,
	//-- #Б4248 смарт: Шляпников 16.09.2025
	|	0 КАК Приоритет,
	|	""Адрес доставки (по умолчанию)"" КАК Вид,
	|   ИСТИНА КАК ПоУмолчанию
	|ИЗ
	|	Справочник.Партнеры КАК Партнеры
	|ГДЕ
	|	НЕ Партнеры.смартПартнерАдресДоставки = """"
	|	И Партнеры.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПартнерыКонтактнаяИнформация.Представление,
	|	ПартнерыКонтактнаяИнформация.Значение,
	|	ПартнерыКонтактнаяИнформация.ЗначенияПолей,
	|	ВЫБОР
	|		КОГДА ПартнерыКонтактнаяИнформация.Вид = &АдресДоставки
	|			ТОГДА 1
	|		КОГДА ПартнерыКонтактнаяИнформация.Вид = &АдресДоставкиАльтернативный
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ,
	|	ПартнерыКонтактнаяИнформация.Вид,
	|   ЛОЖЬ КАК ПоУмолчанию
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	|ГДЕ
	|	ПартнерыКонтактнаяИнформация.Ссылка = &Ссылка
	|	И ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	Запрос.УстановитьПараметр("АдресДоставки", Справочники.ВидыКонтактнойИнформации.НайтиПоРеквизиту("ИдентификаторДляФормул", "АдресДоставки", 
													Справочники.ВидыКонтактнойИнформации.СправочникПартнеры));
	Запрос.УстановитьПараметр("АдресДоставкиАльтернативный", Справочники.ВидыКонтактнойИнформации.НайтиПоРеквизиту("ИдентификаторДляФормул", "АдресДоставкиАльтернативный", 
													Справочники.ВидыКонтактнойИнформации.СправочникПартнеры));
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаАдресов = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрокаАдреса Из ТаблицаАдресов Цикл
		
		//++ #Б4248 смарт: Шляпников 16.09.2025 / Доставка товаров по заказу клиента, корректность заполнения, печать Этикетки доставки
		Если СтрокаАдреса.Приоритет = 0 И НЕ ЗначениеЗаполнено(СтрокаАдреса.АдресДоставкиЗначение) Тогда
		//-- #Б4248 смарт: Шляпников 16.09.2025
			
			НайденныеСтроки = ТаблицаАдресов.НайтиСтроки(Новый Структура("АдресДоставки, ПоУмолчанию", СтрокаАдреса.АдресДоставки, Ложь));
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				СтрокаАдреса.АдресДоставкиЗначение 		= НайденныеСтроки[0].АдресДоставкиЗначение;
				СтрокаАдреса.АдресДоставкиЗначенияПолей = НайденныеСтроки[0].АдресДоставкиЗначенияПолей;
				
			Иначе
				
				АдресПоПолям = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияПоПредставлению(СтрокаАдреса.АдресДоставки, 
																	Перечисления.ТипыКонтактнойИнформации.Адрес);
				СтрокаАдреса.АдресДоставкиЗначение = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(АдресПоПолям);
				СтрокаАдреса.АдресДоставкиЗначенияПолей = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзJSONВXML(СтрокаАдреса.АдресДоставкиЗначение, 
																	Перечисления.ТипыКонтактнойИнформации.Адрес);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаАдресов;
	
КонецФункции //-- #4426 смарт: Тимофеева 24.09.2025

//++ #4590 смарт: Тимофеева 08.10.2025 / Цена в долларах, информационно, в заказах клиента
&НаСервере
Процедура УстановитьВидимостьКолонокЦенВВалютеНаСервере()
	
	ПродажаВРублях = НЕ Справочники.смартПредопределенныеЗначения.ПереходНаПродажуВРублях.Значение = Неопределено 
							И Справочники.смартПредопределенныеЗначения.ПереходНаПродажуВРублях.Значение; 
	
	Если ПродажаВРублях И (НЕ ПользовательПолный() И НЕ Пользователи.РолиДоступны("смартРазрешитьПросмотрВсехВидовЦенВВалюте")) Тогда
		Элементы.ТоварыСмартКонвертацияЦены.Видимость = Ложь;		
		Элементы.ТоварыЦенаВВалюте.Видимость = Ложь; 
	КонецЕсли; 
	
	Если НЕ ПродажаВРублях ИЛИ ПользовательПолный() ИЛИ Пользователи.РолиДоступны("смартРазрешитьПросмотрВсехВидовЦенВВалюте") Тогда
		ВалютаUSD = Справочники.Валюты.НайтиПоКоду("840"); 	
		Элементы.ТоварыСмартКонвертацияЦены.Видимость = Объект.Валюта = ВалютаUSD;
		Элементы.ТоварыЦенаВВалюте.Видимость = НЕ Объект.Валюта = ВалютаUSD;				
    КонецЕсли; 

КонецПроцедуры
