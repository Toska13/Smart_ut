&НаСервере
Функция смартДанныеРуководителяСПравомПовышеннойСкидкой() 
	
	//++ #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
	// Провел полный рефакторинг функции
	// Поля структуры:
	//  * Значение - СправочникСсылка.Пользователи
	// 	* К2 - Число, процент скидки
	// 	* К3 - Булево, Вкл/Выкл
	// 	* К4 - СправочникСсылка.СтруктураПредприятия (Подразделение)
	// 	* ПравоПредоставлено - Булево, назначается в функции
	
	СтруктураВозврата = Новый Структура("Значение, К2, К3, К4, ПравоПредоставлено",
											Справочники.Пользователи.ПустаяСсылка(),
											0,
											Ложь,
											Справочники.СтруктураПредприятия.ПустаяСсылка(),
											Ложь
										);
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		
		СтруктураВозврата.Значение = Пользователи.ТекущийПользователь();
		СтруктураВозврата.К2 = 99;
		СтруктураВозврата.К3 = Истина;
		СтруктураВозврата.К4 = Объект.Подразделение;
		СтруктураВозврата.ПравоПредоставлено = Истина;
		
		Возврат СтруктураВозврата;
		
	КонецЕсли;
	
    МассивСтруктурРуководителейРегионов = 
		смартОбщегоНазначенияСКэш.смартПредопределенныеЗначенияКэш(
			Справочники.смартПредопределенныеЗначения.смартПользователиПредоставленияПовышеннойСкидки); 
		
	Для каждого СтруктураМассива Из МассивСтруктурРуководителейРегионов Цикл
				
		Если СтруктураМассива.Значение = Пользователи.ТекущийПользователь() 
			 И СтруктураМассива.К2 > 0
			 И СтруктураМассива.К3 = Истина
			 И СтруктураМассива.К4 = Объект.Подразделение
			Тогда
			
			ЗаполнитьЗначенияСвойств(СтруктураВозврата, СтруктураМассива);
			СтруктураВозврата.ПравоПредоставлено = Истина;
			
			Возврат СтруктураВозврата;
		   
	   КонецЕсли;	
	                                             
    КонецЦикла;      
    
    Возврат СтруктураВозврата;
	//-- #1477 смарт: Ермаков 06.02.2024 / Скидка до 10% для руководителей подразделений
       
КонецФункции //-- смарт:Подкин #1047 06.06.2022 14:25:01

