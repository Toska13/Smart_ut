	КонецЕсли;
	//-- #Б4002 смарт: Шляпников 26.08.2025
	
	//++ #Б4868 смарт: Шляпников 12.11.2025 / Документ заказ клиента. Разделение контроля доставки. 
	Объект.смартРазрешенаДоставкаЗаПределыУстановленнойЗоны = Ложь;
	Объект.смартИДРазрешенияНаДоставкуВнеЗоны = "";
