Функция ПроверитьВозможностьЗакрытияЗаказа()
	
	Отказ = Ложь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказКлиента", Объект.Ссылка);
	Запрос.УстановитьПараметр("Период",       КонецДня(ТекущаяДата()));
	
	Запрос.Текст =
	//Богус++
	"ВЫБРАТЬ
	|	ТоварыКОтгрузкеОстатки.Склад КАК Склад,
	|	ТоварыКОтгрузкеОстатки.Получатель КАК Получатель,
	|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК ДокументОтгрузки,
	|	ТоварыКОтгрузкеОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыКОтгрузкеОстатки.Характеристика КАК Характеристика,
	|	ТоварыКОтгрузкеОстатки.Назначение КАК Назначение,
	|	ТоварыКОтгрузкеОстатки.Серия КАК Серия,
	|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток КАК КОтгрузкеОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(&Период, ДокументОтгрузки = &ЗаказКлиента) КАК ТоварыКОтгрузкеОстатки
	|ГДЕ
	|	ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток > 0
	|	И ТоварыКОтгрузкеОстатки.Склад.ИспользоватьОрдернуюСхемуПриОтгрузке";
	
	//Запрос.Текст = Запрос.Текст +  Модуль_Б1Сервер.ТекстЗапросаПроверитьДолгКлиента();
	//Запрос.УстановитьПараметр("Документы", Объект.Ссылка);
	//Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата());
	//Богус--
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Выборка.Следующий();
		Отказ = Истина;
		Объект.Статус = Выборка.ДокументОтгрузки.Статус;
	КонецЕсли;
	Возврат Отказ;
	
