//++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах  
&НаСервере
Функция смартУстановитьЗаголовокОстаткиПоОрганизациям(ПоРегистру=Ложь)
	ТекстОтвета="";
	Если Объект.Статус=Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
		Возврат ТекстОтвета;
	КонецЕсли;	
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
         |	ВложенныйЗапрос.Организация КАК Организация,
         |	ВложенныйЗапрос.Склад КАК Склад,
         |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
         |	ВложенныйЗапрос.Характеристика КАК Характеристика,
         |	СУММА(ВЫБОР
         |			КОГДА ВложенныйЗапрос.Своб >= ВложенныйЗапрос.Орг - ВложенныйЗапрос.Резерв
         |				ТОГДА ВложенныйЗапрос.Орг - ВложенныйЗапрос.Резерв
         |			ИНАЧЕ ВложенныйЗапрос.Своб
         |		КОНЕЦ) КАК Остаток,
         |	СУММА(ВложенныйЗапрос.Своб) КАК СвобОстаток,
         |	СУММА(ВложенныйЗапрос.Орг) КАК ОргОстаток,
         |	СУММА(ВложенныйЗапрос.ОжидаемыйПриход) КАК ОжидаемыйПриход,
         |	СУММА(ВложенныйЗапрос.ОжидаемыйРасход) КАК ОжидаемыйРасход,
         |	СУММА(ВложенныйЗапрос.Резерв) КАК Резерв
         |ИЗ
         |	(ВЫБРАТЬ
         |		ОстаткиОрганизаций.Организация КАК Организация,
         |		ОстаткиОрганизаций.МестоХранения КАК Склад,
         |		ОстаткиОрганизаций.Номенклатура КАК Номенклатура,
         |		ОстаткиОрганизаций.Характеристика КАК Характеристика,
         |		СУММА(0) КАК Остаток,
         |		СУММА(ЕСТЬNULL(СвободныеОстатки.Остаток, 0)) КАК Своб,
         |		СУММА(ЕСТЬNULL(ОстаткиОрганизаций.КоличествоОстаток, 0)) КАК Орг,
         |		СУММА(0) КАК ОжидаемыйПриход,
         |		СУММА(0) КАК ОжидаемыйРасход,
         |		СУММА(0) КАК Резерв
         |	ИЗ
         |		(ВЫБРАТЬ
         |			ТоварыОрганизацийОстатки.Организация КАК Организация,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК МестоХранения,
         |			СУММА(ТоварыОрганизацийОстатки.КоличествоОстаток) КАК КоличествоОстаток
         |		ИЗ
         |			РегистрНакопления.ТоварыОрганизаций.Остатки(
         |					,
         |					АналитикаУчетаНоменклатуры.Номенклатура В (&СпсНоменклатуры)
         |						И АналитикаУчетаНоменклатуры.МестоХранения В (&СпсСкладов)) КАК ТоварыОрганизацийОстатки
         |		
         |		СГРУППИРОВАТЬ ПО
         |			ТоварыОрганизацийОстатки.Организация,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура,
         |			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения) КАК ОстаткиОрганизаций
         |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
         |				СвободныеОстаткиОстатки.Номенклатура КАК Номенклатура,
         |				СвободныеОстаткиОстатки.Характеристика КАК Характеристика,
         |				СвободныеОстаткиОстатки.Склад КАК Склад,
         |				СУММА(СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток) КАК Остаток
         |			ИЗ
         |				РегистрНакопления.СвободныеОстатки.Остатки(
         |						,
         |						Номенклатура В (&СпсНоменклатуры)
         |							И Склад В (&СпсСкладов)) КАК СвободныеОстаткиОстатки
         |			
         |			СГРУППИРОВАТЬ ПО
         |				СвободныеОстаткиОстатки.Номенклатура,
         |				СвободныеОстаткиОстатки.Характеристика,
         |				СвободныеОстаткиОстатки.Склад) КАК СвободныеОстатки
         |			ПО ОстаткиОрганизаций.Номенклатура = СвободныеОстатки.Номенклатура
         |				И ОстаткиОрганизаций.Характеристика = СвободныеОстатки.Характеристика
         |				И ОстаткиОрганизаций.МестоХранения = СвободныеОстатки.Склад
         |	
         |	СГРУППИРОВАТЬ ПО
         |		ОстаткиОрганизаций.Организация,
         |		ОстаткиОрганизаций.МестоХранения,
         |		ОстаткиОрганизаций.Номенклатура,
         |		ОстаткиОрганизаций.Характеристика
         |	
         |	ОБЪЕДИНИТЬ ВСЕ
         |	
         |	ВЫБРАТЬ
         |		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
         |		ТоварыКПоступлениюОстатки.Склад,
         |		ТоварыКПоступлениюОстатки.Номенклатура,
         |		ТоварыКПоступлениюОстатки.Характеристика,
         |		СУММА(0),
         |		СУММА(0),
         |		СУММА(0),
         |		СУММА(ТоварыКПоступлениюОстатки.КОформлениюОрдеровОстаток),
         |		СУММА(0),
         |		СУММА(0)
         |	ИЗ
         |		РегистрНакопления.ТоварыКПоступлению.Остатки(
         |				,
         |				Номенклатура В (&СпсНоменклатуры)
         |					И Склад В (&СпсСкладов)) КАК ТоварыКПоступлениюОстатки
         |	
         |	СГРУППИРОВАТЬ ПО
         |		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
         |		ТоварыКПоступлениюОстатки.Склад,
         |		ТоварыКПоступлениюОстатки.Номенклатура,
         |		ТоварыКПоступлениюОстатки.Характеристика
         |	
         |	ОБЪЕДИНИТЬ ВСЕ
         |	
         |	ВЫБРАТЬ
         |		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
         |		ТоварыКОтгрузкеОстатки.Склад,
         |		ТоварыКОтгрузкеОстатки.Номенклатура,
         |		ТоварыКОтгрузкеОстатки.Характеристика,
         |		СУММА(0),
         |		СУММА(0),
         |		СУММА(0),
         |		СУММА(0),
         |		СУММА(ТоварыКОтгрузкеОстатки.КОформлениюОстаток + ТоварыКОтгрузкеОстатки.ВРезервеОстаток),
         |		СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток)
         |	ИЗ
         |		РегистрНакопления.ТоварыКОтгрузке.Остатки(
         |				,
         |				Номенклатура В (&СпсНоменклатуры)
         |					И НЕ ДокументОтгрузки.Ссылка = &ЗаказКлиента
         |					И Склад В (&СпсСкладов)) КАК ТоварыКОтгрузкеОстатки
         |	
         |	СГРУППИРОВАТЬ ПО
         |		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
         |		ТоварыКОтгрузкеОстатки.Склад,
         |		ТоварыКОтгрузкеОстатки.Номенклатура,
         |		ТоварыКОтгрузкеОстатки.Характеристика) КАК ВложенныйЗапрос
         |
         |СГРУППИРОВАТЬ ПО
         |	ВложенныйЗапрос.Организация,
         |	ВложенныйЗапрос.Склад,
         |	ВложенныйЗапрос.Номенклатура,
         |	ВложенныйЗапрос.Характеристика
         |
         |УПОРЯДОЧИТЬ ПО
         |	Номенклатура,
         |	Склад,
         |	Организация"); 
	Запрос.УстановитьПараметр("СпсНоменклатуры",Объект.Товары.Выгрузить(,"Номенклатура"));
	Запрос.УстановитьПараметр("ЗаказКлиента",Объект.Ссылка); 
	Запрос.УстановитьПараметр("СпсСкладов",ЭтаФорма.смартСписокСкладов); 
	Рез=Запрос.Выполнить().Выгрузить();
	Если ПоРегистру Тогда
		ЗапросЗаказ=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
			|	ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
			|	ЗаказыКлиентовОстатки.Склад КАК Склад,
			|	СУММА(ЗаказыКлиентовОстатки.ЗаказаноОстаток) КАК КоличествоУпаковок
			|ИЗ
			|	РегистрНакопления.ЗаказыКлиентов.Остатки(, ЗаказКлиента = &ЗаказКлиента) КАК ЗаказыКлиентовОстатки
			|СГРУППИРОВАТЬ ПО
			|	ЗаказыКлиентовОстатки.Номенклатура,
			|	ЗаказыКлиентовОстатки.Характеристика,
			|	ЗаказыКлиентовОстатки.Склад");
		ЗапросЗаказ.УстановитьПараметр("ЗаказКлиента",Объект.Ссылка);
		ТабТовары=ЗапросЗаказ.Выполнить().Выгрузить();
	Иначе
		//Для Каждого СтрОстДок Из ЭтаФорма.смартТаблицаСвобОстатков Цикл
		//	СтрРез=Рез.Добавить();
		//	СтрРез.Организация=СтрОстДок.Организация;
		//	СтрРез.Склад=СтрОстДок.Склад;
		//	СтрРез.Номенклатура=СтрОстДок.Номенклатура;
		//	СтрРез.Характеристика=СтрОстДок.Характеристика;
		//	СтрРез.Остаток=СтрОстДок.ВлияниеНаОстатки;
		//КонецЦикла;	
		Рез.Свернуть("Организация,Склад,Номенклатура,Характеристика","Остаток,СвобОстаток,ОргОстаток,ОжидаемыйПриход,ОжидаемыйРасход");
		ТабТовары=Объект.Товары.Выгрузить();
		ТабТовары.Свернуть("Склад,Номенклатура,Характеристика","КоличествоУпаковок");
	Конецесли;
	НомСтр=1;
	Для Каждого Стр Из ТабТовары Цикл
		Если НЕ (ЗначениеЗаполнено(Стр.Склад) И ЗначениеЗаполнено(Стр.Номенклатура)) Тогда
			Продолжить;	
		КонецЕсли;	
		СтрокиРез=Рез.НайтиСтроки(Новый Структура("Организация,Номенклатура,Характеристика",Объект.Организация,Стр.Номенклатура,Стр.Характеристика));		
		Если СтрокиРез.Количество()=0 Тогда
			СтрокиРезСклад=Рез.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));		
			Если СтрокиРезСклад.Количество()>0 Тогда 
				Нашли=Ложь;
				Для Каждого СтрРезСклад Из СтрокиРезСклад Цикл 
					Если (СтрРезСклад.Остаток+СтрРезСклад.ОжидаемыйПриход)>0 И СтрРезСклад.Организация<>Объект.Организация Тогда
						ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Номенклатура "+Стр.Номенклатура+" есть на складе "+СтрРезСклад.Склад+", организации "+СтрРезСклад.Организация+" в количестве "+СтрРезСклад.Остаток+" ожидается "+СтрРезСклад.ОжидаемыйПриход+"";
						Нашли=Истина;
					КонецЕсли;
				КонецЦикла;
				Если НЕ Нашли Тогда
					//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";	
				КонецЕсли;	
			Иначе	
				//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";
			КонецЕсли;	
		Иначе
			Если СтрокиРез[0].Остаток=0 Тогда
				СтрокиРезСклад=Рез.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));		
				Если СтрокиРезСклад.Количество()>0 Тогда
					Нашли=Ложь;
					Для Каждого СтрРезСклад Из СтрокиРезСклад Цикл 
						Если (СтрРезСклад.Остаток+СтрРезСклад.ОжидаемыйПриход)>0 И СтрРезСклад.Организация<>Объект.Организация Тогда
							ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Номенклатура "+Стр.Номенклатура+" есть на складе "+СтрРезСклад.Склад+", организации "+СтрРезСклад.Организация+" в количестве "+СтрРезСклад.Остаток+" ожидается "+СтрРезСклад.ОжидаемыйПриход+"";
							Нашли=Истина;
						КонецЕсли;
					КонецЦикла;
					Если НЕ Нашли Тогда
						//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";	
					КонецЕсли;	
				Иначе	
					//ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Для номенклатуры "+Стр.Номенклатура+" отсутствуют остатки на складе "+Стр.Склад+"";
				КонецЕсли;	
			Иначе
				СтрокиРезОрг=Рез.НайтиСтроки(Новый Структура("Организация,Номенклатура,Характеристика",Объект.Организация,Стр.Номенклатура,Стр.Характеристика));
				Если СтрокиРезОрг.Количество()>0 ТОгда 
					НашлиОстатки=0;
					Для Каждого СтрРезОрг Из СтрокиРезОрг Цикл
						НашлиОстатки=НашлиОстатки+СтрРезОрг.Остаток;	
					КонецЦикла;                                     
					Если НашлиОстатки<Стр.КоличествоУпаковок Тогда
						СтрокиРезСклад=Рез.НайтиСтроки(Новый Структура("Номенклатура,Характеристика",Стр.Номенклатура,Стр.Характеристика));		
						Для Каждого СтрРезСклад Из СтрокиРезСклад Цикл 
							Если (СтрРезСклад.Остаток+СтрРезСклад.ОжидаемыйПриход)>0 И СтрРезСклад.Организация<>Объект.Организация Тогда
								ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Номенклатура "+Стр.Номенклатура+" есть на складе "+СтрРезСклад.Склад+", организации "+СтрРезСклад.Организация+" в количестве "+СтрРезСклад.Остаток+" ожидается "+СтрРезСклад.ОжидаемыйПриход+"";
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;	
				Иначе
					СтрокиРез=Рез.НайтиСтроки(Новый Структура("Организация,Номенклатура,Характеристика",Объект.Организация,Стр.Номенклатура,Стр.Характеристика));
					Для Каждого СтрРезСклад Из СтрокиРез Цикл 
						Если (СтрРезСклад.Остаток+СтрРезСклад.ОжидаемыйПриход)>0 И СтрРезСклад.Склад<>Стр.Склад Тогда
							ТекстОтвета=ТекстОтвета+?(ТекстОтвета="","",Символы.ПС)+"Номенклатура "+Стр.Номенклатура+" есть на складе "+СтрРезСклад.Склад+", организации "+СтрРезСклад.Организация+" в количестве "+СтрРезСклад.Остаток+" ожидается "+СтрРезСклад.ОжидаемыйПриход+"";
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		НомСтр=НомСтр+1;
	КонецЦикла;	
	
	Возврат ТекстОтвета;	
КонецФункции //-- #1351 смарт: Фролов 05.05.2023  

//++ #1351 смарт: Фролов 05.05.2023 //Разделение остатков по организациям в заказах
&НаСервере
Процедура смартЗаполнитьТаблицуСвобождныхОстатковДляДокумента()
	Если НЕ Объект.Ссылка.Пустая() ТОгда
		Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	СвободныеОстаткиОбороты.Регистратор.Организация КАК Организация,
			|	СвободныеОстаткиОбороты.Номенклатура КАК Номенклатура,
			|	СвободныеОстаткиОбороты.Характеристика КАК Характеристика,
			|	СвободныеОстаткиОбороты.Склад КАК Склад,
			|	СУММА(СвободныеОстаткиОбороты.ВРезервеПодЗаказОборот + СвободныеОстаткиОбороты.ВРезервеСоСкладаОборот - СвободныеОстаткиОбороты.ВНаличииРасход) КАК ВлияниеНаОстатки
			|ИЗ
			|	РегистрНакопления.СвободныеОстатки.Обороты(, , Регистратор, ) КАК СвободныеОстаткиОбороты
			|ГДЕ
			|	СвободныеОстаткиОбороты.Регистратор = &ЗаказКлиента
			|
			|СГРУППИРОВАТЬ ПО
			|	СвободныеОстаткиОбороты.Регистратор.Организация,
			|	СвободныеОстаткиОбороты.Номенклатура,
			|	СвободныеОстаткиОбороты.Характеристика,
			|	СвободныеОстаткиОбороты.Склад"); 
		Запрос.УстановитьПараметр("ЗаказКлиента",Объект.Ссылка);
		ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "смартТаблицаСвобОстатков");
	КонецЕсли;
КонецПроцедуры //-- #1351 смарт: Фролов 05.05.2023 	

//++ #1351 смарт: Фролов 12.05.2023 //Разделение остатков по организациям в заказах 
&НаКлиенте
Процедура смартСвернутьРазвернутьОстаткиПоОрганизациям() Экспорт
	Если ЭтаФорма.смартГруппаОстаткиРазвернута Тогда
	    Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Развернуть предупреждение. ВНИМАНИЕ! Есть ограничения по товарам организации";
		ЭтаФорма.смартГруппаОстаткиРазвернута=Ложь;
	Иначе
		Элементы.смартНадписьОстаткиПоОрганизациям.Заголовок="Свернуть предупреждение"; 
		ЭтаФорма.смартГруппаОстаткиРазвернута=Истина;
	КонецЕсли;
	Элементы.смартОстаткиПоОрганизациям.Видимость=ЭтаФорма.смартГруппаОстаткиРазвернута;
КонецПроцедуры //-- #1351 смарт: Фролов 12.05.2023	

//++ #1351 смарт: Фролов 15.05.2023 //Разделение остатков по организациям в заказах  
&НаСервере
Функция смартПроверитьСериюПоОрганизации(Серия)
	Запрос=Новый Запрос("  ВЫБРАТЬ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия КАК Серия,
			|	ТоварыОрганизацийОбороты.Организация КАК Организация,
			|	СУММА(ТоварыОрганизацийОбороты.КоличествоПриход) КАК Количество
			|ИЗ
			|	РегистрНакопления.ТоварыОрганизаций.Обороты КАК ТоварыОрганизацийОбороты
			|ГДЕ
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия = &Серия
			|
			|СГРУППИРОВАТЬ ПО
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия,
			|	ТоварыОрганизацийОбороты.Организация");
	Запрос.УстановитьПараметр("Серия",Серия);
	Рез=Запрос.Выполнить().Выгрузить(); 
	Если Рез.Количество()>0 Тогда
		Нашли=Ложь;
		Для Каждого Стр Из Рез Цикл
			Если Стр.Организация=Объект.Организация ТОгда
				Нашли=Истина;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Нашли ТОгда
			Возврат Ложь; 
		Иначе	
			Возврат Истина;
		КонецЕсли;	
	КонецЕсли;	
	Возврат Истина;	
КонецФункции //-- #1351 смарт: Фролов 15.05.2023

//++ #1351 смарт: Фролов 25.05.2023 //Разделение остатков по организациям в заказах 
&НаСервере
Функция смартПроверитьОстаткиПоСтрокеПоОрганизации(Номенклатура,Характеристика)
	Если Номенклатура.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Услуга 
		ИЛИ Номенклатура.ТипНоменклатуры=Перечисления.ТипыНоменклатуры.Работа ТОгда
		Возврат 10000000;
	КонецЕсли;	
		
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ВложенныйЗапрос.Организация КАК Организация,
			|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
			|	ВложенныйЗапрос.Характеристика КАК Характеристика,
			|	СУММА(ВЫБОР
			|			КОГДА ВложенныйЗапрос.Своб >= ВложенныйЗапрос.Орг
			|				ТОГДА ВложенныйЗапрос.Орг
			|			ИНАЧЕ ВложенныйЗапрос.Своб
			|		КОНЕЦ) КАК Остаток,
			|	СУММА(ВложенныйЗапрос.Своб) КАК СвобОстаток,
			|	СУММА(ВложенныйЗапрос.Орг) КАК ОргОстаток,
			|	СУММА(ВложенныйЗапрос.ОжидаемыйПриход) КАК ОжидаемыйПриход,
			|	СУММА(ВложенныйЗапрос.ОжидаемыйРасход) КАК ОжидаемыйРасход,
			|	СУММА(ВложенныйЗапрос.Резерв) КАК Резерв
			|ИЗ
			|	(ВЫБРАТЬ
			|		ОстаткиОрганизаций.Организация КАК Организация,
			|		ОстаткиОрганизаций.Номенклатура КАК Номенклатура,
			|		ОстаткиОрганизаций.Характеристика КАК Характеристика,
			|		СУММА(0) КАК Остаток,
			|		СУММА(ЕСТЬNULL(СвободныеОстатки.Остаток, 0)) КАК Своб,
			|		СУММА(ЕСТЬNULL(ОстаткиОрганизаций.КоличествоОстаток, 0)) КАК Орг,
			|		СУММА(0) КАК ОжидаемыйПриход,
			|		СУММА(0) КАК ОжидаемыйРасход,
			|		СУММА(0) КАК Резерв
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ТоварыОрганизацийОстатки.Организация КАК Организация,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК МестоХранения,
			|			СУММА(ТоварыОрганизацийОстатки.КоличествоОстаток) КАК КоличествоОстаток
			|		ИЗ
			|			РегистрНакопления.ТоварыОрганизаций.Остатки(
			|					,
			|					АналитикаУчетаНоменклатуры.Номенклатура = &Номенклатура
			|						И АналитикаУчетаНоменклатуры.Характеристика = &Характеристика
			|						И АналитикаУчетаНоменклатуры.МестоХранения В (&СпсСкладов)
			|						И Организация = &Организация) КАК ТоварыОрганизацийОстатки
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ТоварыОрганизацийОстатки.Организация,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Характеристика,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура,
			|			ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения) КАК ОстаткиОрганизаций
			|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
			|				ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
			|				ТоварыНаСкладахОстатки.Склад КАК Склад,
			|				СУММА(ТоварыНаСкладахОстатки.ВНаличииОстаток) КАК Остаток
			|			ИЗ
			|				РегистрНакопления.ТоварыНаСкладах.Остатки(
			|						,
			|						Номенклатура = &Номенклатура
			|							И Характеристика = &Характеристика
			|							И Склад В (&СпсСкладов)) КАК ТоварыНаСкладахОстатки
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ТоварыНаСкладахОстатки.Номенклатура,
			|				ТоварыНаСкладахОстатки.Характеристика,
			|				ТоварыНаСкладахОстатки.Склад) КАК СвободныеОстатки
			|			ПО ОстаткиОрганизаций.Номенклатура = СвободныеОстатки.Номенклатура
			|				И ОстаткиОрганизаций.Характеристика = СвободныеОстатки.Характеристика
			|				И ОстаткиОрганизаций.МестоХранения = СвободныеОстатки.Склад
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ОстаткиОрганизаций.Организация,
			|		ОстаткиОрганизаций.Номенклатура,
			|		ОстаткиОрганизаций.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
			|		ТоварыКПоступлениюОстатки.Номенклатура,
			|		ТоварыКПоступлениюОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ТоварыКПоступлениюОстатки.КОформлениюОрдеровОстаток),
			|		СУММА(0),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ТоварыКПоступлению.Остатки(
			|				,
			|				ДокументПоступления ССЫЛКА Документ.ЗаказПоставщику
			|					И Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И Склад В (&СпсСкладов)
			|					И ДокументПоступления.Организация = &Организация) КАК ТоварыКПоступлениюОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ТоварыКПоступлениюОстатки.ДокументПоступления.Организация,
			|		ТоварыКПоступлениюОстатки.Номенклатура,
			|		ТоварыКПоступлениюОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
			|		ТоварыКОтгрузкеОстатки.Номенклатура,
			|		ТоварыКОтгрузкеОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ТоварыКОтгрузкеОстатки.ВРезервеОстаток),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ТоварыКОтгрузке.Остатки(
			|				,
			|				Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И НЕ ДокументОтгрузки.Ссылка = &ЗаказКлиента
			|					И Склад В (&СпсСкладов)
			|					И ДокументОтгрузки.Организация = &Организация) КАК ТоварыКОтгрузкеОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Организация,
			|		ТоварыКОтгрузкеОстатки.Номенклатура,
			|		ТоварыКОтгрузкеОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ЗаказыНаСборкуОстатки.ЗаказНаСборку.Организация,
			|		ЗаказыНаСборкуОстатки.Номенклатура,
			|		ЗаказыНаСборкуОстатки.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ЗаказыНаСборкуОстатки.ЗаказаноОстаток),
			|		СУММА(0),
			|		СУММА(0)
			|	ИЗ
			|		РегистрНакопления.ЗаказыНаСборку.Остатки(
			|				,
			|				Номенклатура = &Номенклатура
			|					И Характеристика = &Характеристика
			|					И ЗаказНаСборку.Склад В (&СпсСкладов)
			|					И ЗаказНаСборку.Организация = &Организация) КАК ЗаказыНаСборкуОстатки
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ЗаказыНаСборкуОстатки.ЗаказНаСборку.Организация,
			|		ЗаказыНаСборкуОстатки.Номенклатура,
			|		ЗаказыНаСборкуОстатки.Характеристика
			|	
			|	ОБЪЕДИНИТЬ ВСЕ
			|	
			|	ВЫБРАТЬ
			|		ОстаткиПоЗаказам.ЗаказКлиента.Организация,
			|		ОстаткиПоЗаказам.Номенклатура,
			|		ОстаткиПоЗаказам.Характеристика,
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(0),
			|		СУММА(ВЫБОР
			|				КОГДА ОстаткиПоЗаказам.ЗаказаноОстаток > Заказы.КоличествоУпаковок
			|					ТОГДА Заказы.КоличествоУпаковок
			|				ИНАЧЕ ОстаткиПоЗаказам.ЗаказаноОстаток
			|			КОНЕЦ)
			|	ИЗ
			|		(ВЫБРАТЬ
			|			ЗаказыКлиентовОстатки.ЗаказКлиента КАК ЗаказКлиента,
			|			ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
			|			ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
			|			ЗаказыКлиентовОстатки.ЗаказКлиента.Организация КАК ЗаказКлиентаОрганизация,
			|			СУММА(ЗаказыКлиентовОстатки.ЗаказаноОстаток) КАК ЗаказаноОстаток,
			|			ЗаказыКлиентовОстатки.Склад КАК Склад
			|		ИЗ
			|			РегистрНакопления.ЗаказыКлиентов.Остатки(
			|					,
			|					Номенклатура = &Номенклатура
			|						И Характеристика = &Характеристика
			|						И НЕ ЗаказКлиента.Ссылка = &ЗаказКлиента
			|						И Склад В (&СпсСкладов)
			|						И ЗаказКлиента.Организация = &Организация) КАК ЗаказыКлиентовОстатки
			|		
			|		СГРУППИРОВАТЬ ПО
			|			ЗаказыКлиентовОстатки.ЗаказКлиента,
			|			ЗаказыКлиентовОстатки.Номенклатура,
			|			ЗаказыКлиентовОстатки.Характеристика,
			|			ЗаказыКлиентовОстатки.ЗаказКлиента.Организация,
			|			ЗаказыКлиентовОстатки.Склад) КАК ОстаткиПоЗаказам
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|				ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
			|				ЗаказКлиентаТовары.Характеристика КАК Характеристика,
			|				ЗаказКлиентаТовары.Ссылка КАК Ссылка,
			|				СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоУпаковок,
			|				ЗаказКлиентаТовары.Склад КАК Склад
			|			ИЗ
			|				Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|			ГДЕ
			|				ЗаказКлиентаТовары.ВариантОбеспечения В(&ВариантыОбеспечения)
			|			
			|			СГРУППИРОВАТЬ ПО
			|				ЗаказКлиентаТовары.Номенклатура,
			|				ЗаказКлиентаТовары.Характеристика,
			|				ЗаказКлиентаТовары.Ссылка,
			|				ЗаказКлиентаТовары.Склад) КАК Заказы
			|			ПО ОстаткиПоЗаказам.Номенклатура = Заказы.Номенклатура
			|				И ОстаткиПоЗаказам.Характеристика = Заказы.Характеристика
			|				И ОстаткиПоЗаказам.ЗаказКлиента = Заказы.Ссылка
			|				И ОстаткиПоЗаказам.Склад = Заказы.Склад
			|	
			|	СГРУППИРОВАТЬ ПО
			|		ОстаткиПоЗаказам.ЗаказКлиента.Организация,
			|		ОстаткиПоЗаказам.Номенклатура,
			|		ОстаткиПоЗаказам.Характеристика) КАК ВложенныйЗапрос
			|
			|СГРУППИРОВАТЬ ПО
			|	ВложенныйЗапрос.Организация,
			|	ВложенныйЗапрос.Номенклатура,
			|	ВложенныйЗапрос.Характеристика
			|
			|УПОРЯДОЧИТЬ ПО
			|	Номенклатура,
			|	Организация
			|");
	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ЗаказКлиента",Объект.Ссылка); 
	Запрос.УстановитьПараметр("СпсСкладов",ЭтаФорма.смартСписокСкладов);
	МасВаиантовОбеспечения=Новый Массив;
	МасВаиантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.СоСклада);
	МасВаиантовОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.ИзЗаказов);
	Запрос.УстановитьПараметр("ВариантыОбеспечения",МасВаиантовОбеспечения);
	Выборка=Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() ТОгда
		Возврат Выборка.Остаток+Выборка.ОжидаемыйПриход-Выборка.Резерв;
	Иначе	
		Возврат 0;
	КонецЕсли;	
КонецФункции	//-- #1351 смарт: Фролов 25.05.2023

//++#1382 смарт: Лопато 21.06.2023 //Заполнение параметров заказа при самовывозе  
&НаСервере
Процедура смартОбновитьАдресДоставкиСамовывоз()

	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз 
	 ИЛИ Объект.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда

		СтруктураНовыйАдресДоставки = смартОбщегоНазначения.смартПолучитьАдресСклада(Объект.Склад, Объект.Товары, Объект.АдресДоставки, Объект.СпособДоставки);
		
		//++#1578 смарт: Лопато 15.12.2023 //Ошибка в заказе клиента при изменении адреса доставки  
		СписокВыбора = Новый СписокЗначений;
		
		Для Каждого Стр Из СтруктураНовыйАдресДоставки.СкладыАдреса Цикл
			
			НайденныйЭлементСЗ = ДоставкаТоваровКлиентСервер.НайтиВСпискеСтруктур(СписокВыбора, "АдресДоставки", Стр.АдресДоставки);
			
			Если НайденныйЭлементСЗ = Неопределено Тогда
				СтруктураВыбора = смартОбщегоНазначения.смартСтруктураВыбораАдресДоставки();
				ЗаполнитьЗначенияСвойств(СтруктураВыбора, Стр);
				СписокВыбора.Добавить(СтруктураВыбора, Стр.Вид + ": " + Стр.АдресДоставки);
			Иначе
				смартОбщегоНазначения.смартДозаполнитьПустыеСвойстваАдресДоставки(НайденныйЭлементСЗ.Значение, Стр);
			КонецЕсли;
			
		КонецЦикла;
		
		СписокВыбораАдресДоставки = ЭтаФорма.Элементы.АдресДоставкиСамовывоз.СписокВыбора;
		
		СписокВыбораАдресДоставки.Очистить();
		Для Каждого Элемент Из СписокВыбора Цикл
			СписокВыбораАдресДоставки.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
		ТекущегоАдресаДоставкиНетВСписке = Истина;
		Для Каждого ЭлементСписка Из СписокВыбораАдресДоставки Цикл
			Если Объект.АдресДоставки = ЭлементСписка.Значение.АдресДоставки Тогда
           		ТекущегоАдресаДоставкиНетВСписке = Ложь;
			КонецЕсли;
		КонецЦикла;	
			
		Если СписокВыбораАдресДоставки.Количество() > 0 
			И ЗначениеЗаполнено(СтруктураНовыйАдресДоставки.АдресДоставки) 
			 И Объект.Статус <> Перечисления.СтатусыЗаказовКлиентов.Закрыт
			 И (НЕ ЗначениеЗаполнено(Объект.АдресДоставки) ИЛИ ТекущегоАдресаДоставкиНетВСписке) Тогда
			
			Объект.АдресДоставки 			  = СтруктураНовыйАдресДоставки.АдресДоставки;
			Объект.АдресДоставкиЗначение 	  = СтруктураНовыйАдресДоставки.АдресДоставкиЗначение; 
			Объект.АдресДоставкиЗначенияПолей = СтруктураНовыйАдресДоставки.АдресДоставкиЗначенияПолей;
			
			Сообщить("Адрес самовывоза (адрес доставки для печати) изменен на: " + СтруктураНовыйАдресДоставки.АдресДоставки);
			
		КонецЕсли;
