    смартУстановитьДоступностьЭтаповОплаты();
    //смарт 914 Каратеев --: Блокировка ЭтапыГрафикаОплаты   
    
    //++ смарт:Подкин #946 24.03.2022 14:27:44 
    Если РазницаТаблиц() Тогда  
        смартПроизвестиПроверкиВалюты();
