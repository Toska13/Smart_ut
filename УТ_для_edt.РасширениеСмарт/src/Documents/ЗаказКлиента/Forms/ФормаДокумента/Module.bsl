//++ #Б4316 смарт: Шляпников 14.10.2025 / Доставка в 1С. Расчет тарифа. Корректировка алгоритма в 1С.
&НаСервере
Процедура РассчитатьПараметрыДоставки()
	
	ВесЗаказа = смартОбщегоНазначения.ПолучитьВесЗаказа(Объект);
	ЭтаФорма.смартВесЗаказа = Макс(ВесЗаказа.ВесНетто, ВесЗаказа.ВесБрутто);
	ПараметрыАдресаЗаполнены = Ложь;
	ЭтаФорма.смартБылаОшибкаРасчетаДоставки = Ложь;
	
	Если Объект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента Тогда
	
		Если ЗначениеЗаполнено(Объект.АдресДоставки) Тогда
			
			ДанныеАдреса = смартИнтеграцияDaData.ВыполнитьЗапросПолучитьИнформациюПоАдресу(Объект.АдресДоставки);
			Если ТипЗнч(ДанныеАдреса) = Тип("Массив") И ДанныеАдреса.Количество() > 0 Тогда
				
				Если ТипЗнч(ДанныеАдреса[0]) = Тип("Структура") Тогда
					
					Если ДанныеАдреса[0].Свойство("beltway_hit") И ЗначениеЗаполнено(ДанныеАдреса[0].beltway_hit) Тогда
						ЭтаФорма.смартРегион = ДанныеАдреса[0].beltway_hit;
						ПараметрыАдресаЗаполнены = Истина;
					ИначеЕсли ДанныеАдреса[0].Свойство("region") И ЗначениеЗаполнено(ДанныеАдреса[0].region) Тогда
						ЭтаФорма.смартРегион = ДанныеАдреса[0].region;
						ПараметрыАдресаЗаполнены = Истина;
					Иначе
						ЭтаФорма.смартРегион = "";
					КонецЕсли;
					
					Если ДанныеАдреса[0].Свойство("city") Тогда
						ЭтаФорма.смартГород = ДанныеАдреса[0].city;
						ПараметрыАдресаЗаполнены = Истина;
					Иначе
						ЭтаФорма.смартГород = "";
					КонецЕсли;
					
					Если ДанныеАдреса[0].Свойство("beltway_distance") Тогда
						ЭтаФорма.смартРасстояние = ДанныеАдреса[0].beltway_distance;
						ПараметрыАдресаЗаполнены = Истина;
					Иначе
						ЭтаФорма.смартРасстояние = 0;
					КонецЕсли;
					
				Иначе
					ЭтаФорма.смартБылаОшибкаРасчетаДоставки = Истина;
				КонецЕсли;
				
			Иначе
				ЭтаФорма.смартБылаОшибкаРасчетаДоставки = Истина;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Если НЕ ПараметрыАдресаЗаполнены Тогда
		
		ЭтаФорма.смартРегион = "";
		ЭтаФорма.смартГород = "";
		ЭтаФорма.смартРасстояние = 0;
		
	КонецЕсли;
	
	Если ЭтаФорма.смартБылаОшибкаРасчетаДоставки Тогда
		ОбщегоНазначения.СообщитьПользователю("Была ошибка получения информации для расчета доставки от сервиса DaData. Обновите принудительно информацию для расчета доставки",, "смартОбновитьПараметрыДляРасчетаДоставки");
	КонецЕсли;
	
КонецПроцедуры

//++ #2552 смарт: Тимофеева 20.10.2025 / Сделать обязательную комплектацию оборудования каталогом
&НаСервере
Функция ПроверитьТребованияДополнительнойКомплектацииСублимационногоОборудования()
	Результат = Новый Структура;
	Результат.Вставить("ТребуетсяВывестиУведомлениеМенеджеру", Ложь);
	Результат.Вставить("ТекстУведомления", "");
	
	ТаблицаОборудования = смартСервер.ПолучитьТаблицуСублимационногоОборудования(Объект.Товары.Выгрузить(, "Номенклатура, Склад"), Объект.Склад);
	Если ТаблицаОборудования.Количество() > 0 Тогда
		КаталогСсылка = смартСервер.ПолучитьКаталогДляКомплектацииОборудования();
		Если ЗначениеЗаполнено(КаталогСсылка) Тогда 		
			МассивСкладов = ТаблицаОборудования.ВыгрузитьКолонку("Склад");
					
			ЗаказНаВнутреннееПотребление = Неопределено;
			Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
				ЗаказНаВнутреннееПотребление = смартСервер.ПолучитьЗаказНаВнутренееПотребление(Объект.Ссылка, КаталогСсылка);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ЗаказНаВнутреннееПотребление) Тогда 			
				ОстаткиКаталогаНаСкладах = смартСервер.ПолучитьОстаткиНоменклатурыНаСкладах(КаталогСсылка, МассивСкладов, 
																?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса())); 
				Если ОстаткиКаталогаНаСкладах.Количество() = 0 Тогда 
					Результат.ТребуетсяВывестиУведомлениеМенеджеру = Истина;
					Результат.ТекстУведомления = СтрШаблон("Оформите передачу каталога ""%1"" на склад %2", КаталогСсылка, МассивСкладов[0]);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции

