//++#1356 смарт: Лопато 18.05.2023 //Исправление автоматического расчета скидок в заказах клиентов  
Процедура смартПриведениеСуммыДляПересчетаБезОкругленияКлиент(ТекСтрока, ВыводитьСообщение = Ложь, ПересчитыватьСумму = Истина)
//--#1356 смарт: Лопато 18.05.2023
 	//ТекСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено тогда
		
		Если (ТекСтрока.ПроцентАвтоматическойСкидки <> 0 ИЛИ ТекСтрока.ПроцентРучнойСкидки <> 0) И ТекСтрока.КоличествоУпаковок <> 0 тогда
			
			//++#1356 смарт: Лопато 18.05.2023 //Исправление автоматического расчета скидок в заказах клиентов  
			СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);

			СтруктураДействий = Новый Структура;
			Если ПересчитыватьСумму Тогда
				СтруктураДействий.Вставить("ПересчитатьСуммуРучнойСкидки");
				СтруктураДействий.Вставить("ПересчитатьСуммуАвтоматическойСкидки");
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
				СтруктураДействий.Вставить("ПересчитатьСумму");
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Ложь));
				СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
			КонецЕсли;	
			ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекСтрока, СтруктураДействий, КэшированныеЗначения);
			//--#1356 смарт: Лопато 18.05.2023
			
			//анализируем сумму, которая получилась в итоге, если после деления суммы на количество в цене получаются тысячные доли, то приводим сумму
			//по следующей формуле, СамаяБлизкаяЦенаБезТысячных * КоличествоУпаковок
			СуммаДляПроверки = ТекСтрока.Сумма;
			ЦенаДляПроверки = ТекСтрока.Сумма / ТекСтрока.КоличествоУпаковок;
			ЦенаДляПроверкиОкр = Окр(ЦенаДляПроверки, 2, РежимОкругления.Окр15как10);
			
			Если ЦенаДляПроверки <> ЦенаДляПроверкиОкр тогда
				//для расчета суммы используем цену, округленную по правилам математики
				ЦенаДляРасчетаСуммы = Окр(ЦенаДляПроверки, 2); //если использовать цену из документа будет "большой разбег" с первоначальной суммой
				СуммаПослеРасчета = Окр(ЦенаДляРасчетаСуммы * ТекСтрока.КоличествоУпаковок, 2);
				
				Если ТекСтрока.Сумма <> СуммаПослеРасчета тогда
					Если ВыводитьСообщение = Истина тогда
						Сообщить("Для номенклатуры """ + Строка(ТекСтрока.Номенклатура) + """ сумма по строке изменена с " + Строка(ТекСтрока.Сумма) + " на " + Строка(СуммаПослеРасчета) + "!");
					КонецЕсли;

					//++#1356 смарт: Лопато 18.05.2023 //Исправление автоматического расчета скидок в заказах клиентов  
					СуммаБезСкидки = Окр(ТекСтрока.КоличествоУпаковок * ТекСтрока.Цена, 2);
					
					ТекСтрока.ЦенаСоСкидкой = Окр(СуммаПослеРасчета / ТекСтрока.КоличествоУпаковок, 2);
					
					Если ТекСтрока.ПроцентРучнойСкидки <> 0 Тогда
						Если ТекСтрока.ПроцентАвтоматическойСкидки = 0 Тогда
							ТекСтрока.СуммаРучнойСкидки = СуммаБезСкидки - СуммаПослеРасчета;
						КонецЕсли;	
					Иначе
						ТекСтрока.СуммаРучнойСкидки = 0;
					КонецЕсли;
					
					Если ТекСтрока.ПроцентАвтоматическойСкидки <> 0 Тогда
						ТекСтрока.СуммаАвтоматическойСкидки = СуммаБезСкидки - СуммаПослеРасчета - ТекСтрока.СуммаРучнойСкидки;
					Иначе
						ТекСтрока.СуммаАвтоматическойСкидки = 0;
					КонецЕсли;
					//--#1356 смарт: Лопато 18.05.2023
					
					ТекСтрока.Сумма = СуммаПослеРасчета;

					//стандартные операции при изменении суммы
					//ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
					
					//++#1356 смарт: Лопато 18.05.2023 //Исправление автоматического расчета скидок в заказах клиентов  
					//ОперацииПередачи = ОперацииПередачиТоваров();
					//ПередачаТоваров = ОперацииПередачи.Найти(Объект.ХозяйственнаяОперация) <> Неопределено;
					//
					//СтруктураПересчетаЦены  = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаЦеныСкидкиВПродажахВТЧ(Объект,
					//ПередачаТоваров);
					//СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
					
					СтруктураДействий = Новый Структура;
					//СтруктураДействий.Вставить("ПересчитатьЦенуСкидкуПоСуммеВПродажах", СтруктураПересчетаЦены);
					//--#1356 смарт: Лопато 18.05.2023
					СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
					СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
					
					ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекСтрока, СтруктураДействий, КэшированныеЗначения);
					
					//СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		смартРассчитатьРучнуюСкидкуСУчетомАкции(ТекСтрока.ПолучитьИдентификатор());
		РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
		 
	КонецЕсли;
	
	//++ #Б5016 смарт: Шляпников 02.12.2025 / Снова не обновляется график платежей при добавлении наценки по доставке
	ПересчитатьСуммуГрафикаОплаты();
	//-- #Б5016 смарт: Шляпников 02.12.2025
	
КонецПроцедуры
//-- смарт:КМД 717 01.12.2021

