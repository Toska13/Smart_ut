&НаСервере
Функция смарт_ЕстьОтгрузкиПоЗаказу()
	ЕстьОтгрузка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказыКлиентовОбороты.ЗаказаноРасход КАК ЗаказаноРасход
	|ИЗ
	|	РегистрНакопления.ЗаказыКлиентов.Обороты(, , Регистратор, ЗаказКлиента = &Заказ) КАК ЗаказыКлиентовОбороты
	|ГДЕ
	|	ЗаказыКлиентовОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|";
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Если Выборка.ЗаказаноРасход > 0 тогда
			//были реализации по заказу клиента
			ЕстьОтгрузка = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьОтгрузка;
КонецФункции
