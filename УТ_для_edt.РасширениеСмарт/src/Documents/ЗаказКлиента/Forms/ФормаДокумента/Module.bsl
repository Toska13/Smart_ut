&НаКлиенте
Процедура ОтменитьЗакрытие(Результат, Параметры) Экспорт

	Если Результат = Неопределено ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Объект.СогласованоБух = Ложь;
		УстановитьЦветИСтатусСогласования();
		ЭтотОбъект.Элементы.НадписьСогласованоФинОтделом.Заголовок = "Снято! Отличаются ЮрЛица";
		Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаказовКлиентов.КОбеспечению");
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Установлен статус Закрыт, но остались документы с ошибочными заначениями",
		,"Объект.Статус");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура смарт_СоздатьРеализациюПосле(Команда)
	
	//++ смарт:ММ #020 183 11.02.2020 - Кнопка "Быстрая реализация" в Заказе клиента
	// 0. Проверки
	// 1. Печать Счета на оплату
	// 2. Создание Реализации ТиУ
	// 3. Создание Счет-фактуры
	// 4. Печать УПД
	// 5. Печать этикетки доставки
	
	Если НЕ ЕстьПравоСозданияРеализаций() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Недостаточно прав для создания документа реализации");
		Возврат;
	КонецЕсли;
	
	Если Объект.НалогообложениеНДС = ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаНаЭкспорт") Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Экспортная отгрузка, необходимо оформить документ самостоятельно");
		Возврат;
	КонецЕсли;
		
	ЗаполнитьОбеспечениеАвтоматически();
	// Фролов+
	НеВыполнятьПроверкуПередЗаписью=Истина;
	ЭтотОбъект.Записать(Новый Структура("РежимЗаписи",РежимЗаписиДокумента.Проведение)); // Фролов добавил режим записи Проведение
	// Фролов-
	
	//++ смарт:ММ #020 183 13.02.2020 - Кнопка "Быстрая реализация" в Заказе клиента
	// В регистре накопления с отбором ТоварыКОтгрузке.ДокументОтгрузки = Объект.Ссылка 
	// по ресурсу "КОформлению" должен быть положительный остаток.

	ОстатокКОформлению = ПолучитьОстатокКОформлению(Объект.Ссылка);	
	Если ОстатокКОформлению <= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет товаров к отгрузке");
		Возврат;
	КонецЕсли;
	
	// 1. Печать Счета на оплату
	МассивОбъектов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка);
	
	Идентификатор = "СчетнаОплату";
	Если Объект.СпособДоставки <> ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз") Тогда
		Идентификатор = "СчетнаОплату,СчетнаОплату";
	КонецЕсли;	
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("ЗаголовокФормы", "Счет на оплату");
	ПараметрыПечати.Вставить("Представление", "Счет на оплату");
	//ПараметрыПечати.Вставить("КоличествоЭкземпляров", 2); // - не работает!
	//ПараметрыПечати.Вставить("Экземпляров", 2); // - не работает
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьСчетовНаОплату", Идентификатор, МассивОбъектов, ЭтаФорма, ПараметрыПечати); 


	//-- смарт:ММ 13.02.2020
	
	Если ЭтотОбъект.ПроцентОтгрузки < 100 Тогда
		ДокументОбъект = Объект.Ссылка;

		ФормаРеализации = ПолучитьФорму("Документ.РеализацияТоваровУслуг.ФормаОбъекта", Новый Структура("Основание", ДокументОбъект));
		Если ФормаРеализации.Объект.Товары.Количество() Тогда 
			
			//++ смарт:ММ #020 183 13.02.2020 - Кнопка "Быстрая реализация" в Заказе клиента
			//ФормаРеализации.Записать();
			
			// 2. Создание Реализации ТиУ
			
			СтруктураОтветственныеЛица = ПолучитьОтветственныеЛица();
			ФормаРеализации.Объект.Руководитель 	= СтруктураОтветственныеЛица.Руководитель;
			ФормаРеализации.Объект.ГлавныйБухгалтер = СтруктураОтветственныеЛица.ГлавныйБухгалтер;
			ФормаРеализации.Объект.Отпустил 		= ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Склад, "ТекущийОтветственный");
			
			Если ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Соглашение, "ИспользуютсяДоговорыКонтрагентов") = Истина Тогда
				// Основанием Реализации должен подставиться договор, а не Заказ клиента
				ФормаРеализации.Объект.ОснованиеДата = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Договор, "Дата");
				ФормаРеализации.Объект.ОснованиеНомер = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Договор, "Номер");
				ФормаРеализации.Объект.Основание = Строка(Объект.Договор) + " №" + ФормаРеализации.Объект.ОснованиеНомер + " от " + Формат(ФормаРеализации.Объект.ОснованиеДата, "ДФ='dd.MM.yyyy ""г.""'");
			КонецЕсли;			
			
			Попытка
				ФормаРеализации.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));				
			Исключение 
				ФормаРеализации.Открыть();
				
			КонецПопытки;
			//-- смарт:ММ 13.02.2020
			
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет доступных товаров для создания реализации");
			Возврат;
		КонецЕсли;
		РеализацияСсылка = ФормаРеализации.Объект.Ссылка;
		
				
		//++ смарт:ММ #020 183 13.02.2020 - Кнопка "Быстрая реализация" в Заказе клиента
		
		//ВызватьСоздатьНаОсновании(РеализацияСсылка);

		Если ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(РеализацияСсылка, "Проведен") Тогда 
			
			// 3. Создание Счет-фактуры
			
			ПараметрыРегистрации = ПараметрыРегистрацииСчетовФактурВыданныхСервер(ФормаРеализации.Объект);
			ВвестиСчетФактуруВыданный(ФормаРеализации, ПараметрыРегистрации);
			
			ФормаРеализации.ФискальнаяОперацияЗавершение(Неопределено, Неопределено);			
			ФормаРеализации.Открыть();
			
			ОбъектыНазначения = Новый Массив;
			ОбъектыНазначения.Добавить(РеализацияСсылка);

			// 4. Печать УПД
			
			Идентификатор = "УПД,УПД";
			Если Объект.СпособДоставки <> ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз") Тогда
				Идентификатор = "УПД,УПД,УПД,УПД";
			КонецЕсли;	
			
			ПараметрыПечати = Новый Структура;
			ПараметрыПечати.Вставить("ЗаголовокФормы", "УПД");
			ПараметрыПечати.Вставить("Представление", "УПД");
			//ПараметрыПечати.Вставить("КоличествоЭкземпляров", 4);  // - не работает!
			//ПараметрыПечати.Вставить("Экземпляров", 4);  // - не работает!
	
			УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьОбщихФорм", Идентификатор, ОбъектыНазначения, ЭтаФорма, ПараметрыПечати);
			
			// 5. Печать этикетки доставки
			Идентификатор = "ЭтикеткаДоставки";
			Если Объект.СпособДоставки <> ПредопределенноеЗначение("Перечисление.СпособыДоставки.Самовывоз") Тогда 
				ОписаниеКоманды = Новый Структура;
				ОписаниеКоманды.Вставить("ОбъектыПечати", ОбъектыНазначения);
				ОписаниеКоманды.Вставить("Идентификатор", Идентификатор);
				
