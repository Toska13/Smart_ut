// Фролов+
&НаСервере
Процедура ПересчитатьТЧ_ТоварыВ_ВалютуУУ(ВалютаУУ=Неопределено)
	
	//смартКаратеев +- // Изменил процедуру под новые требования
	ВалютаУУ = ?(ВалютаУУ=Неопределено,Константы.ВалютаУправленческогоУчета.Получить(),ВалютаУУ); 
	
    //++ смарт:Минаева #1003 18.04.2022 15:19:16 внесено изменение в Заголовок "Цена в EUR"
  	Элементы.ТоварыСмартКонвертацияЦены.Заголовок = ?(Объект.Валюта = ВалютаУУ, "Цена РУБ", "Цена в EUR");
	
	ДанныеВалютыДок=РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта,Объект.Дата);
	ДанныеВалютыУУ=РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаУУ,Объект.Дата);
	
	Для Каждого Стр Из Объект.Товары Цикл 
		ПересчитатьСтрокуТЧ_ТоварыВ_ВалютуУУ(Стр,ДанныеВалютыДок,ДанныеВалютыУУ);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуТЧ_ТоварыВ_ВалютуУУ(Знач Стр,ДанныеВалютыДок=Неопределено,ДанныеВалютыУУ=Неопределено)
	
	//смартКаратеев +- // Изменил процедуру под новые требования
	Если ДанныеВалютыДок=Неопределено ИЛИ ДанныеВалютыУУ=Неопределено Тогда
		ДанныеВалютыДок=РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта,Объект.Дата);
		ДанныеВалютыУУ=РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаУправленческогоУчета.Получить(),Объект.Дата);
	КонецЕсли;
	
	ДанныеВалютыНов = Новый Структура;
	
	Если ДанныеВалютыДок.Валюта = ДанныеВалютыУУ.Валюта Тогда
		ДанныеВалютыНов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Константы.ВалютаРегламентированногоУчета.Получить(), Объект.Дата);
	ИначеЕсли ТипЗнч(ДанныеВалютыУУ) = Тип("Структура") Тогда
		ДанныеВалютыНов = ДанныеВалютыУУ;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Стр)=Тип("Число") Тогда 
		Стр=Объект.Товары.НайтиПоИдентификатору(Стр);
	КонецЕсли;	

	Стр.смартКонвертацияЦены=РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Цена,ДанныеВалютыДок,ДанныеВалютыНов);
	
	//++ #4590 смарт: Тимофеева 08.10.2025 / Цена в долларах, информационно, в заказах клиента
	ВалютаUSD		= Справочники.Валюты.НайтиПоКоду("840");
	ДанныеВалютыUSD	= РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаUSD, Объект.Дата);
	Стр.ЦенаВВалюте = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(Стр.Цена, ДанныеВалютыДок, ДанныеВалютыUSD);
	//-- #4590 смарт: Тимофеева 08.10.2025
	
КонецПроцедуры	

