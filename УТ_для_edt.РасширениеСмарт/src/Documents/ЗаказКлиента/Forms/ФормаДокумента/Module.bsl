//++ #1436 смарт: Фролов 25.08.2023 //Проверка валюты в Заказе и Договоре при проведении 
&НаКлиенте
Процедура смартВыборВариантаИзменениеВалют(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = "Установить в договоре валюту "+Объект.Валюта+"" Тогда	
		смартИзменитьВалютуВДоговоре(Объект.Валюта);	
	ИначеЕсли Ответ = "Установить в заказе валюту "+Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Договор,"ВалютаВзаиморасчетов")+"" Тогда
		Объект.Валюта=Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Объект.Договор,"ВалютаВзаиморасчетов");
		Если ЗначениеЗаполнено(Объект.Валюта) Тогда
			ВалютаПриИзмененииСервер(
				Объект.Валюта,
				ЦенообразованиеКлиент.НеобходимПересчетВВалюту(Объект,ВалютаДокумента));
			ЦенообразованиеКлиент.ОповеститьОбОкончанииПересчетаСуммВВалюту(ВалютаДокумента, Объект.Валюта);
		КонецЕсли;
		СкидкиНаценкиКлиент.СброситьФлагСкидкиРассчитаны(ЭтаФорма);
		ВалютаДокумента = Объект.Валюта;
		ЗаполнитьПорядокОплатыПоУмолчанию(); 
		смарт_ПриЧтенииСозданииНаСервере();
		ТолькоВалютаРеглУчета= смарт_ПроверкаВалютыСоглашения();
		Если НЕ ТолькоВалютаРеглУчета И Объект.смартБезвозмезднаяПередача Тогда
			ПредупреждениеБезвозНаКлиенте();
		КонецЕсли; 
		смартПроверитьИзменениеВалютыВЗаказеСайта();
		//++ #1436 смарт: Лопато 25.09.2023 //Проверка валюты в Заказе и Договоре при проведении 
		ЗаполнитьГруппуФинУчета();
		ОбщегоНазначенияКлиент.СообщитьПользователю("В заказ установлена валюта """ + СокрЛП(ВалютаДокумента) + """ из договора """ + СокрЛП(Объект.Договор));
		//-- #1436 смарт: Лопато 25.09.2023
	ИначеЕсли Ответ="Вернуться к редактированию заказа"	Тогда
		
	КонецЕсли;
	ЭтаФорма.смартВопросПроВалютуЗадан=Ложь; 
	ЭтаФорма.смартЖдемответаНаВопрос=Ложь;
КонецПроцедуры //-- #1436 смарт: Фролов 25.08.2023

//++ #1436 смарт: Фролов 25.08.2023 //Проверка валюты в Заказе и Договоре при проведении 
&НаСервере
Процедура смартИзменитьВалютуВДоговоре(Валюта)
	Об=Объект.Договор.ПолучитьОбъект();
	Об.ВалютаВзаиморасчетов=Валюта;
	//++ #1436 смарт: Лопато 25.09.2023 //Проверка валюты в Заказе и Договоре при проведении 
	ВалютаОплатыРегл = ?(Об.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВВалютеОплатаВВалюте ИЛИ 
						 Об.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВВалюте, Ложь ,Неопределено);
	Об.ПорядокОплаты = Перечисления.ПорядокОплатыПоСоглашениям.ПолучитьПорядокОплатыПоУмолчанию(Об.ВалютаВзаиморасчетов,,ВалютаОплатыРегл);
	Справочники.ДоговорыКонтрагентов.смартПроставитьГруппуФинансовогоУчета(Об);
	Попытка
		Об.Записать();
		ОбщегоНазначения.СообщитьПользователю("В договор """ + СокрЛП(Об.Ссылка) + """ установлена валюта """ + СокрЛП(Валюта) + """");
	Исключение
		ОбщегоНазначения.СообщитьПользователю("Не удалось записать договор """ + СокрЛП(Об.Ссылка) + """!");
	КонецПопытки	
	//-- #1436 смарт: Лопато 25.09.2023
КонецПроцедуры  //-- #1436 смарт: Фролов 25.08.2023

//++#1261 смарт: Лопато 15.01.2024 //Доработка изменения Заказа клиента для ИМ  
&НаСервере
Функция смартПроверитьКонтрагентаЗаказВыгруженНаСайт(Контрагент);
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(Объект.Б_Идентификатор) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Ссылка = &Ссылка
			|	И Контрагенты.Партнер = &Партнер";
		
		Запрос.УстановитьПараметр("Ссылка",  Контрагент);
		Запрос.УстановитьПараметр("Партнер", Объект.Партнер);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			
	   		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заказ выгружен на сайт, контрагента можно менять только на принадлежащего этому же партнеру """ 
															  + СокрЛП(Объект.Партнер) + """!", , "Объект.Контрагент");
			
			Результат = Ложь;
			
		КонецЕсли;	

	КонецЕсли;	
		
	Возврат Результат;	
	
КонецФункции //--#1261 смарт: Лопато 15.01.2024

