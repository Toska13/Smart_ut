Процедура СнятьПризнакСогласованоФинЗаказа(Объект) Экспорт

	//++ смарт:ММ #005 132 04.12.2019
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента") 
		И Объект.Организация.Предопределенный Тогда
		Возврат;
	КонецЕсли;
	//-- смарт:ММ 04.12.2019
	
	Если ЗаказОтгруженНеПолностью(Объект.Ссылка) Тогда
	
		Попытка
			Объект.Заблокировать();
			Объект.СогласованоБух = Ложь;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
		Исключение
			ТекстОшибки = "Заказ по которому производится отгрузка, в данный момент открыт.
			|Необходимо закрыть документ: "+Объект+".";
			ВызватьИсключение ТекстОшибки + ОписаниеОшибки();					
			//ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры

Функция ЗаказОтгруженНеПолностью(Ссылка)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказыКлиентовОстаткиИОбороты.ЗаказКлиента.Ссылка КАК ЗаказКлиентаСсылка,
		|	ЗаказыКлиентовОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|	ЗаказыКлиентовОстаткиИОбороты.Характеристика КАК Характеристика,
		|	ЗаказыКлиентовОстаткиИОбороты.КодСтроки КАК КодСтроки,
		|	ЗаказыКлиентовОстаткиИОбороты.Склад КАК Склад,
		|	ЗаказыКлиентовОстаткиИОбороты.ЗаказаноКонечныйОстаток КАК ЗаказаноКонечныйОстаток
		|ИЗ
		|	РегистрНакопления.ЗаказыКлиентов.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ) КАК ЗаказыКлиентовОстаткиИОбороты
		|ГДЕ
		|	ЗаказыКлиентовОстаткиИОбороты.ЗаказКлиента.Ссылка = &Ссылка
		|	И ЗаказыКлиентовОстаткиИОбороты.ЗаказаноКонечныйОстаток <> 0";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("НачалоПериода", Ссылка.Дата);
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДата()));

	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ЗаказОтгруженНеПолностью()

