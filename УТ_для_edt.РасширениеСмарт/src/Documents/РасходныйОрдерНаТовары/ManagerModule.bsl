//++ смарт:ММ #042 222 27.03.2020 Рефакторинг. Перенесено из расширения (отмена &Вместо) 
// Фролов+
Функция ПолучитьМассивДополнительныхСкладов(Распоряжения,СкладИсключение)
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжения",Распоряжения);
	Запрос.УстановитьПараметр("СкладИсключить",СкладИсключение);
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ЗаказКлиентаТовары.Склад.Наименование КАК Склад
	             |ИЗ
	             |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	             |ГДЕ
	             |	ЗаказКлиентаТовары.Ссылка В(&Распоряжения)
	             |	И НЕ ЗаказКлиентаТовары.Склад В (&СкладИсключить, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");
КонецФункции // Фролов-	

