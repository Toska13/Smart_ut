//++ #6602 смарт: Тимофеева 23.04.2026 / Маркировка радиоэлектронной продукции. Системные уведомления пользователей. 
&НаСервере
Процедура смарт_ПередЗаписьюНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение 
		И смартМаркировка.КонтроллироватьОтгрузкуМаркированнойПродукции(ТекущийОбъект.Дата) 
		Тогда 		
		ТаблицаМаркируемыйТовар = смартМаркировка.ПолучитьМаркируемыйТоварИзКоллекции(ТекущийОбъект.ТоварыПоРаспоряжениям.Выгрузить(), Объект.Дата);
		Если ТаблицаМаркируемыйТовар.Количество() > 0 Тогда
			РеализацииСНеподобраннымиШтрихкодамиУпаковок = смартМаркировка.ПолучитьРеализацииСНеподобраннымиШтрихкодамиУпаковок(ТаблицаМаркируемыйТовар);
			Для Каждого РеализацияТоваровУслугСсылка Из РеализацииСНеподобраннымиШтрихкодамиУпаковок Цикл
				ТекстСообщения = СтрШаблон("В документе содержится маркируемый товар. Необходимо в %1 указать коды маркировки отгружаемого товара с помощью механизма ""Подбор маркировки""", 
										РеализацияТоваровУслугСсылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, РеализацияТоваровУслугСсылка, , );
				Если ТекущийОбъект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыРасходныхОрдеров.Отгружен") Тогда
					Отказ = Истина;
				КонецЕсли;
			КонецЦикла;				
		КонецЕсли;		
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
&ИзменениеИКонтроль("ПослеЗаписи")
Процедура смарт_ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_РасходныйОрдерНаТовары", ПараметрыЗаписи, Объект.Ссылка);

	МодификацияКонфигурацииКлиентПереопределяемый.ПослеЗаписи(ЭтаФорма, ПараметрыЗаписи);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПодключаемыеКоманды") Тогда
		МодульПодключаемыеКомандыКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПодключаемыеКомандыКлиент");
		МодульПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	#Вставка
	//++ #Б6778 смарт: Шляпников 04.05.2026 / Маркировка товара. Экспериментальный режим маркировки.
	смартМаркировкаКлиент.ВывестиСообщениеОНаличииТоваровСЭкспериментальнойМаркировкой(Объект);
	//-- #Б6778 смарт: Шляпников 04.05.2026
	
	//++ #Б6824 смарт: Шляпников 08.06.2026 / Маркировка. Внутреннее движение товара в 1С УТ РФ.
	смартМаркировкаКлиент.ВывестиСообщениеОНеобходимостиСканированияТоваровСОбязательнойМаркировкой(Объект);
	//-- #Б6824 смарт: Шляпников 08.06.2026

	//++ #Б6794 смарт: Шляпников 07.05.2026 / Маркировка. Корректировка алгоритма определения Обязательной маркировки в карточке Номенклатура.
	ЗаполнитьДанныеОМаркировкеНоменклатуры();
	//-- #Б6794 смарт: Шляпников 07.05.2026
	#КонецВставки
	
КонецПроцедуры
