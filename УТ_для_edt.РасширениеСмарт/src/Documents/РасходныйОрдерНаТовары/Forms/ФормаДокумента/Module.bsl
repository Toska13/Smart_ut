//++#1517 смарт: Лопато 03.11.2023 //Установка статуса указания серий по дате начала серийного учета номенклатуры  
&НаСервере
Процедура смарт_УстановитьДатуПроверкиСерий()

	Если ЗначениеЗаполнено(Объект.ДатаОтгрузки) Тогда
		ДатаСерий = Объект.ДатаОтгрузки;
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСерий = Объект.Дата;
	Иначе	
		ДатаСерий = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	ПараметрыУказанияСерий.ТоварыПоРаспоряжениям.Дата = ДатаСерий;
	ПараметрыУказанияСерий.ОтгружаемыеТовары.Дата 	  = ДатаСерий;

КонецПроцедуры //--#1617 смарт: Лопато 03.11.2023

