&ИзменениеИКонтроль("ТекстЗапросаТоварыДокумента")
Функция смарт_ТекстЗапросаТоварыДокумента(Отбор)

	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Таблица.Ссылка                       КАК ЗаказНаВнутреннееПотребление,
	|	Таблица.Номенклатура                 КАК Номенклатура,
	|	Таблица.Характеристика               КАК Характеристика,
	#Удаление
	|	ВЫБОР КОГДА Таблица.ВариантОбеспечения В(
	|		ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно),
	|		ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно)) ТОГДА
	|				Таблица.Ссылка.Назначение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		КОНЕЦ                            КАК Назначение,
	#КонецУдаления
	#Вставка
	//++ #Б4636 смарт: Шляпников 14.10.2025 / Заказ на внутреннее потребление. Доработка. Возможность указания Назначения.
	|	ВЫБОР КОГДА Таблица.ВариантОбеспечения В(
	|		ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно),
	|		ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.ОтгрузитьОбособленно)) ТОГДА
	|				ВЫБОР КОГДА Таблица.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка) ТОГДА Таблица.Ссылка.Назначение ИНАЧЕ Таблица.Назначение КОНЕЦ
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)
	|		КОНЕЦ                            КАК Назначение,
	//-- #Б4636 смарт: Шляпников 14.10.2025
	#КонецВставки
	|	Таблица.КодСтроки                    КАК КодСтроки,
	|	Таблица.Серия                        КАК Серия,
	|	Таблица.Количество                   КАК Количество,
	|	Таблица.Упаковка                     КАК Упаковка,
	|	Таблица.ДатаОтгрузки                 КАК ДатаОтгрузки,
	|	Таблица.СтатьяРасходов               КАК СтатьяРасходов,
	|	Таблица.АналитикаРасходов            КАК АналитикаРасходов,
	|	Таблица.ГруппаПродукции              КАК ГруппаПродукции,
	|	Таблица.Ссылка.Склад                 КАК Склад,
	|	ЕСТЬNULL(ДанныеУчета.КОформлению, 0) КАК КОформлению,
	|	ЕСТЬNULL(ДанныеУчета.Заказано, 0)    КАК Заказано,
	|	&ЗаказНаВнутреннееПотребление_ТоварыЛокализация
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК Таблица
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВтДанныеУчета КАК ДанныеУчета
	|	ПО Таблица.Ссылка = ДанныеУчета.ЗаказНаВнутреннееПотребление
	|	И Таблица.КодСтроки = ДанныеУчета.КодСтроки
	|ГДЕ
	|	НЕ ДанныеУчета.ЗаказНаВнутреннееПотребление ЕСТЬ NULL
	|//&Отбор";

	Если ЗначениеЗаполнено(Отбор) Тогда

		ТекстОтбора = "";

		Для Каждого КлючЗначение Из Отбор Цикл

			Ключ = КлючЗначение.Ключ;

			Если Ключ = "Склад" Тогда
				Ключ = "Таблица.Ссылка.Склад";
			КонецЕсли;

			ТекстОтбора = 
			ТекстОтбора
			+ " И "
			+ Ключ
			+ " В(&"
			+ КлючЗначение.Значение
			+ ")";

		КонецЦикла;

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "//&Отбор", ТекстОтбора);

	КонецЕсли;

	ЗаказНаВнутреннееПотреблениеЛокализация.ДобавитьВТекстЗапросаРеквизитыТаблицыТовары(ТекстЗапроса, "Таблица");

	Возврат ТекстЗапроса;

КонецФункции

#КонецОбласти

#Область ДоработкиСмарт
//++ #1263 смарт: Фролов 06.12.2022 //Служебная записка на списание ПФ (Заказ на внутреннее потребление)  
Функция смартПечатьСлужебнойЗаписки(МассивОбъектов, ОбъектыПечати)
Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДанныеЗаказа.Серия КАК СерийныйНомер,
	|	ДанныеЗаказа.Ссылка.Контрагент КАК Клиент,
	|	ЗаказНаВнутреннееПотребление.Склад КАК Склад,
	|	ДанныеЗаказа.Оборудование КАК Оборудование,
	|	ЗаказНаВнутреннееПотребление.Ссылка КАК Ссылка,
	|	ЗаказНаВнутреннееПотребление.Дата КАК Дата,
	|	ЗаказНаВнутреннееПотребление.Ответственный.ФизическоеЛицо.смартДолжность КАК Должность,
	|	ЗаказНаВнутреннееПотребление.Ответственный.ФизическоеЛицо.Наименование КАК Ответственный
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление КАК ЗаказНаВнутреннееПотребление
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			смартЗаявкаНаРемонтныеРаботыОборудование.Ссылка КАК Ссылка,
	|			смартЗаявкаНаРемонтныеРаботыОборудование.Серия КАК Серия,
	|			смартЗаявкаНаРемонтныеРаботыОборудование.ОборудованиеКлиентов КАК Оборудование
	|		ИЗ
	|			Документ.смартЗаявкаНаРемонтныеРаботы.Оборудование КАК смартЗаявкаНаРемонтныеРаботыОборудование) КАК ДанныеЗаказа
	|		ПО ЗаказНаВнутреннееПотребление.ДокументОснование = ДанныеЗаказа.Ссылка
	|ГДЕ
	|	ЗаказНаВнутреннееПотребление.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка КАК Заказ,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.Артикул КАК Артикул,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.Наименование КАК Наименование,
	|	ЗаказНаВнутреннееПотреблениеТовары.Количество КАК Количество,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ЗаказНаВнутреннееПотреблениеТовары
	|ГДЕ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	МасРез=Запрос.ВыполнитьПакет();
	ВыборкаДокументы = МасРез[0].Выбрать();
	РезультатПоСтрокам = МасРез[1].Выгрузить();
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказНаВнутреннееПотребление.смартСлужебнаяЗаписка");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_смарт_СлужебнаяЗаписка";
	Пока ВыборкаДокументы.Следующий() Цикл
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры, ВыборкаДокументы);
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		ТабДокумент.Вывести(ОбластьЗаголовок);	
		ТабДокумент.Вывести(ОбластьШапка); 
		СтрокиРезультатПоСтрокам=РезультатПоСтрокам.НайтиСтроки(Новый Структура("Заказ",ВыборкаДокументы.Ссылка));
		Для Каждого СтрРезультатПоСтрокам Из СтрокиРезультатПоСтрокам Цикл
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрРезультатПоСтрокам); 
			ТабДокумент.Вывести(ОбластьСтрока); 
		КонецЦикла;
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ФИО=ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ВыборкаДокументы.Ответственный, ВыборкаДокументы.Дата); 
		ОбластьПодвал.Параметры.Дата=Формат(ВыборкаДокументы.Дата,"ДФ=dd.MM.yyyy");
		ОбластьПодвал.Параметры.Должность=ВыборкаДокументы.Должность;
		ТабДокумент.Вывести(ОбластьПодвал);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,НомерСтрокиНачало, ОбъектыПечати,ВыборкаДокументы.Ссылка);
	КонецЦикла;	
	Возврат ТабДокумент;
КонецФункции

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	//++ #3918 смарт: Тимофеева 21.08.2025 / Создать ПФ Служебной записки на списание Каталогов 
	//Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартСлужебнаяЗаписка") Тогда

	//	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартСлужебнаяЗаписка",
	//			НСтр("ru = 'Служебная записка'"),
	//			смартПечатьСлужебнойЗаписки(МассивОбъектов, ОбъектыПечати));

	//КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартСлужебнаяЗапискаНаРемонтныеРаботы") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартСлужебнаяЗапискаНаРемонтныеРаботы",
				НСтр("ru = 'Служебная записка на ремонтные работы'"),
				смартПечатьСлужебнойЗаписки(МассивОбъектов, ОбъектыПечати));

			КонецЕсли;
			
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "смартСлужебнаяЗапискаНаСписаниеКаталогов") Тогда

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "смартСлужебнаяЗапискаНаСписаниеКаталогов",
				НСтр("ru = 'Служебная записка на списание каталогов'"),
				смартПечатьСлужебнойЗапискиНаСписаниеКаталогов(МассивОбъектов, ОбъектыПечати));

	КонецЕсли;
	//-- #3918 смарт: Тимофеева 21.08.2025

КонецПроцедуры 
//-- #1263 смарт: Фролов 06.12.2022

//++ #3918 смарт: Тимофеева 21.08.2025 / Создать ПФ Служебной записки на списание Каталогов
Функция смартПечатьСлужебнойЗапискиНаСписаниеКаталогов(МассивОбъектов, ОбъектыПечати)
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_смарт_ПФ_MXL_СлужебнаяЗапискаНаСписаниеКаталогов";

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗаказНаВнутреннееПотребление.Ссылка КАК Ссылка,
	|	ЗаказНаВнутреннееПотребление.Организация КАК Организация,
	|	ЗаказНаВнутреннееПотребление.Организация.НаименованиеСокращенное КАК НаименованиеОрганизации,
	|	ЗаказНаВнутреннееПотребление.Склад КАК Склад,
	|	ЗаказНаВнутреннееПотребление.Дата КАК Дата,
	|	ЕСТЬNULL(Пользователи.ФизическоеЛицо.Наименование, """") КАК Ответственный,
	|	ЕСТЬNULL(Пользователи.ФизическоеЛицо.смартДолжность, """") КАК Должность
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление КАК ЗаказНаВнутреннееПотребление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ЗаказНаВнутреннееПотребление.Ответственный = Пользователи.Ссылка
	|ГДЕ
	|	ЗаказНаВнутреннееПотребление.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка КАК Заказ,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.Артикул КАК Артикул,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.Наименование КАК Наименование,
	|	ЗаказНаВнутреннееПотреблениеТовары.Количество КАК Количество,
	|	ЗаказНаВнутреннееПотреблениеТовары.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.ЗаказНаВнутреннееПотребление.Товары КАК ЗаказНаВнутреннееПотреблениеТовары
	|ГДЕ
	|	ЗаказНаВнутреннееПотреблениеТовары.Ссылка В(&МассивОбъектов)";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаДокументы = РезультатЗапроса[0].Выбрать();
	ТаблицаТовары 	 = РезультатЗапроса[1].Выгрузить();
	Макет 			 = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаказНаВнутреннееПотребление.ПФ_MXL_СлужебнаяЗапискаНаСписаниеКаталогов");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка 	 = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока 	 = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал 	 = Макет.ПолучитьОбласть("Подвал");
	
	ПервыйДокумент 	 = Истина;
	Пока ВыборкаДокументы.Следующий() Цикл
		Если ПервыйДокумент Тогда
			ПервыйДокумент = Ложь;
		Иначе
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НачалоТекущегоФрагмента = ТабДокумент.ВысотаТаблицы + 1;
		
		ЗаполнитьЗначенияСвойств(ОбластьЗаголовок.Параметры, ВыборкаДокументы);
		ОтветственныеЛица 	  	= ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(ВыборкаДокументы.Организация); 
		ДолжностьРуководителя 	= ОтветственныеЛица.РуководительДолжность;
		Д_ДолжностьРуководителя = ПолучитьСклоненияСтроки(ДолжностьРуководителя, "ПЛ=Мужской", "ПД=Дательный");
		ФИОРуководителя	  	  	= ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ОтветственныеЛица.Руководитель);
		Д_ФИОРуководителя     	= ПолучитьСклоненияСтроки(ФИОРуководителя, 
                            	?(ОтветственныеЛица.Руководитель.Пол = Перечисления.ПолФизическогоЛица.Женский, "ПЛ=Женский", "ПЛ=Мужской"), 
								"ПД=Дательный");
		ОбластьЗаголовок.Параметры.ДолжностьРуководителя = ?(Д_ДолжностьРуководителя.Количество() > 0, Д_ДолжностьРуководителя[0], 
																										"Генеральному директору");
		ОбластьЗаголовок.Параметры.ФИОРуководителя 		 = ?(Д_ФИОРуководителя.Количество() > 0, Д_ФИОРуководителя[0], "");
	    ТабДокумент.Вывести(ОбластьЗаголовок);	
		ТабДокумент.Вывести(ОбластьШапка); 
		
		ТаблицаТоварыЗаказа = ТаблицаТовары.НайтиСтроки(Новый Структура("Заказ", ВыборкаДокументы.Ссылка));
		Для Каждого СтрокаТаблицыТовары Из ТаблицаТоварыЗаказа Цикл
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, СтрокаТаблицыТовары); 
			ТабДокумент.Вывести(ОбластьСтрока); 
		КонецЦикла; 
		
		ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры, ВыборкаДокументы);
		ОбластьПодвал.Параметры.ФИО = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ВыборкаДокументы.Ответственный, ВыборкаДокументы.Дата); 
		
		ТабДокумент.Вывести(ОбластьПодвал);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НачалоТекущегоФрагмента, ОбъектыПечати, ВыборкаДокументы.Ссылка);
	КонецЦикла;	
	Возврат ТабДокумент;
КонецФункции 
//-- #3918 смарт: Тимофеева 21.08.2025

#КонецОбласти

#КонецЕсли


