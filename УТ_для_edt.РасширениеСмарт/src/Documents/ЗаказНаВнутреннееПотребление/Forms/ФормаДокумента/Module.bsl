КонецПроцедуры //--#1547 смарт: Лопато 22.03.2024

//++ #6676  смарт: Тимофеева 27.04.2026 / Маркировка радиоэлектронной продукции. Запрет проведения документа Заказ на внутреннее потребление.
&НаСервере
&ИзменениеИКонтроль("ПередЗаписьюНаСервере")
Процедура смарт_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
	#Вставка
	ТекстСообщения = "";
	Если НЕ Объект.смартЗапчастиГарантийные Тогда
		ТекстОшибки = смартМаркировка.ПроверитьВозможностьВнутреннегоПотребления(ТекущийОбъект, ТекстСообщения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,, Отказ);
	КонецЕсли; 
	
	//++ #6996 смарт: Тимофеева 20.07.2026 / Создавать заказ на внутреннее потребление из заказа на перемещение  
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.Склад = Справочники.смартПредопределенныеЗначения.СкладПросрочкиНеликвид.Значение
		И НЕ ЗначениеЗаполнено(Объект.смартПричинаВозврата) Тогда
		ОбщегоНазначения.СообщитьПользователю("Укажите причину возврата",,,"Объект.смартПричинаВозврата", Отказ);
		Элементы["смартПричинаВозврата"].ОтметкаНезаполненного = Истина;
	КонецЕсли;
	//-- #6996 смарт: Тимофеева 20.07.2026
	#КонецВставки
КонецПроцедуры
//-- #6676  смарт: Тимофеева 27.04.2026 

