
#Область ПеренесеноСДоработкамиСмарт

&Перед("ОбработкаЗаполнения")
Процедура смарт_ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//смартКаратеев ++
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.МаркетинговыеМероприятияДокумент") Тогда
		ЗаполнитьДокументНаОснованииМаркетинговогоМероприятия(ДанныеЗаполнения);
	//++ смарт:ММ #073 352 22.09.2020 - Доработка заявки на пусконаладку
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаПускоНаладку") Тогда
		ЗаполнитьДокументНаОснованиисмартЗаявкаНаПускоНаладку(ДанныеЗаполнения);
	//-- смарт:ММ 22.09.2020
	//++ смарт:ММ #082 397 14.11.2020 - Заявка на ремонт
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.смартЗаявкаНаРемонтныеРаботы") Тогда
		ЗаполнитьДокументНаОснованиисмартЗаявкаНаРемонтныеРаботы(ДанныеЗаполнения);
	//-- смарт:ММ 14.11.2020
	
	//++ #6996 смарт: Тимофеева 20.07.2026 / Создавать заказ на внутреннее потребление из заказа на перемещение
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаПеремещение") Тогда
		ЗаполнитьДокументНаОснованииЗаказаНаПеремещение(ДанныеЗаполнения);
	//-- #6996 смарт: Тимофеева 20.07.2026
	КонецЕсли;
	//Каратеев --
	
	//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(ДанныеЗаполнения));
	Если НЕ ОбъектМетаданных = Неопределено И Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("смартЗапчастиГарантийные", ОбъектМетаданных) Тогда
			ЭтотОбъект.смартЗапчастиГарантийные = ДанныеЗаполнения.смартЗапчастиГарантийные;
		КонецЕсли;
	КонецЕсли;
	//-- #Б1376 смарт: Шляпников 19.11.2024
	
КонецПроцедуры

&После("ПриКопировании")
Процедура смарт_ПриКопировании(ОбъектКопирования)
	//смартКаратеев ++
	ДокументОснование=?(ТипЗнч(ДокументОснование)=Тип("ДокументСсылка.МаркетинговыеМероприятияДокумент"),Неопределено,ДокументОснование);
	//Каратеев --
КонецПроцедуры

#КонецОбласти 

