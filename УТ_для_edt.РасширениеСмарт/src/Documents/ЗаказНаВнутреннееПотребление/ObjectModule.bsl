//++ смарт:ММ #073 352 22.09.2020 - Доработка заявки на пусконаладку
Процедура ЗаполнитьДокументНаОснованиисмартЗаявкаНаПускоНаладку(ДанныеЗаполнения)

	ДокументОснование 	= ДанныеЗаполнения;
	Организация 		= ДанныеЗаполнения.Организация; 
	Статус 				= Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
	ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеТоваровПоТребованию;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.НазначенныйНаЗапускИнженер) Тогда
		//Склад по пользователю
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Пользователи.ФизическоеЛицо КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ВТ_ФизлицоПользователя
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	Пользователи.Ссылка = &Пользователь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ФизлицоПользователя КАК ВТ_ФизлицоПользователя
		|		ПО Склады.ТекущийОтветственный = ВТ_ФизлицоПользователя.ФизическоеЛицо
		|ГДЕ
		|	НЕ Склады.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Пользователь", ДанныеЗаполнения.НазначенныйНаЗапускИнженер);
				
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			Склад = Выборка.Ссылка;	
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Представительство) Тогда
		Подразделение = ДанныеЗаполнения.Представительство;
	Иначе
		Подразделение = Справочники.смартПредопределенныеЗначения.ПодразделениеГоловнойОфисМосква.Значение;
	КонецЕсли;
	
	НоваяСтрока = Товары.Добавить();
	НоваяСтрока.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Требуется; // К обеспечению
	НоваяСтрока.СтатьяРасходов = Справочники.смартПредопределенныеЗначения.СтатьяРасходовРасходыНаПусконаладкуОборудования.Значение;
	НоваяСтрока.АналитикаРасходов = ДанныеЗаполнения.ДокументОснование; // Заказ клиента

КонецПроцедуры //-- смарт:ММ 22.09.2020

