
&НаКлиенте
&ИзменениеИКонтроль("ОтветственныйПриИзменении")
Процедура смарт_ОтветственныйПриИзменении(Элемент)
    #Удаление
	Если НЕ ПроверитьДоступностьРоли("смартДобавлениеИзменениеКвалификацийМенеджеров") Тогда

		ПредыдущийОтветственный = ВернутьПредыдущегоОтветственного();

		Если НЕ Объект.Ответственный = ПредыдущийОтветственный Тогда

			ПараметрыФормы = Новый Структура("Ответственный, ПредыдущийОтветственный", Объект.Ответственный, ПредыдущийОтветственный);	
			ОткрытьФорму("Документ.смартЛид.Форма.ФормаПередачиДругомуОтветственному", ПараметрыФормы, ЭтаФорма, , , , Новый ОписаниеОповещения("ПослеВыбораНовогоОтветственного", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

		КонецЕсли;

	КонецЕсли;
	#КонецУдаления

КонецПроцедуры

