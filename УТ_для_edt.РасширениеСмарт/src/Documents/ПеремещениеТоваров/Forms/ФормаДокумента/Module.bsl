//++#1800 смарт: Лопато 03.05.2024 //Доработка перемещение товара (продолжение 1775) серийный учет чернил  
&НаКлиенте
Процедура смартЗаполнитьСтатусыУказанияСерийТовары()

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;

	ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
		
	ЗаполнитьСтатусыУказанияСерийПриОкончанииРедактированияСтрокиТЧ(ТекущаяСтрокаИдентификатор, КэшированныеЗначения);	
	
	НоменклатураКлиент.ОбновитьКешированныеЗначенияДляУчетаСерий(Элементы.Товары, КэшированныеЗначения, ПараметрыУказанияСерий);

КонецПроцедуры //--#1800 смарт: Лопато 03.05.2024					

//++ #5734 смарт: Тимофеева 18.02.26 / Создать роль для создания перемещений со склада Гарантийные запчасти - не для продажи

&НаСервере
Процедура УстановитьВидимостьНомераЗаявкиНаГарантийныйРемонт()	
	Если НЕ Элементы.Найти("ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка") = Неопределено Тогда  
		СкладДляЗапчастейПодЗаказ = смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ОсновнойСкладДляЗапчастейПодЗаказ", Ложь);
	    Элементы["ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка"].Видимость = Объект.СкладОтправитель = СкладДляЗапчастейПодЗаказ
																				ИЛИ Объект.СкладПолучатель = СкладДляЗапчастейПодЗаказ
																				ИЛИ НЕ Объект.Товары.Количество() = Объект.Товары.НайтиСтроки(
																					Новый Структура("смартНомерЗаявкиНаГарантийныйРемонтСсылка", 
																					Документы.смартЗаявкаНаГарантийныйРемонт.ПустаяСсылка())).Количество();	
	КонецЕсли;
КонецПроцедуры 

