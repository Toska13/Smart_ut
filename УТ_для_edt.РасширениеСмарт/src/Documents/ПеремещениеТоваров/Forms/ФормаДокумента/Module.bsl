&НаСервере
&ИзменениеИКонтроль("ПередЗаписьюНаСервере")
//++ #Б-5574 смарт: Фролов 03.02.2026 //Документ Перемещение товаров. Печатная форма ТОРГ13. Вывод себестоимости.
Процедура смарт_ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Обработчик механизма "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);

	Документы.ТранспортнаяНакладная.СохранитьРеквизитыТОРГ12ПередЗаписью(ЭтаФорма);

	ЗапасыСервер.УстановитьПараметрПерезаполнитьВидыЗапасовПриРучномИзмененииВидовЗапасов(ЭтотОбъект, ТекущийОбъект);

	МодификацияКонфигурацииПереопределяемый.ПередЗаписьюНаСервере(ЭтаФорма, Отказ, ТекущийОбъект, ПараметрыЗаписи);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборот.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
	#Вставка
	//++ #Б-5574 смарт: Фролов 03.02.2026 //Документ Перемещение товаров. Печатная форма ТОРГ13. Вывод себестоимости.
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ПеремещениеТоваровТовары.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ ТоварыИзДокумента
		|ИЗ
		|	&ТаблицаТоваров КАК ПеремещениеТоваровТовары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыИзДокумента.Номенклатура КАК Номенклатура,
		|	ТоварыИзДокумента.Характеристика КАК Характеристика,
		|	СУММА(СебестоимостьТоваровОстатки.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(СебестоимостьТоваровОстатки.СтоимостьБезНДСОстаток + СебестоимостьТоваровОстатки.ДопРасходыБезНДСОстаток) КАК СтоимостьБезНДСОстаток
		|ИЗ
		|	ТоварыИзДокумента КАК ТоварыИзДокумента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СебестоимостьТоваров.Остатки(, ВидЗапасов.ТипЗапасов = ЗНАЧЕНИЕ(Перечисление.ТипыЗапасов.Товар)) КАК СебестоимостьТоваровОстатки
		|		ПО ТоварыИзДокумента.Номенклатура = СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.Номенклатура
		|			И ТоварыИзДокумента.Характеристика = СебестоимостьТоваровОстатки.АналитикаУчетаНоменклатуры.Характеристика
		|ГДЕ
		|	СебестоимостьТоваровОстатки.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыИзДокумента.Номенклатура,
		|	ТоварыИзДокумента.Характеристика");
		
		ТаблицаТоваров = ТекущийОбъект.Товары.Выгрузить(, "Номенклатура, Характеристика");
		
		Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
		Запрос.УстановитьПараметр("Организация", ТекущийОбъект.Организация);
		
		ТаблицаСебестоимости = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрТовары Из ТекущийОбъект.Товары Цикл
			
			Если СтрТовары.смартСебестоимостьЗаЕдиницу = 0 Тогда
				
				СтрокиТаблицаСебестоимости = ТаблицаСебестоимости.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", 
					СтрТовары.Номенклатура, СтрТовары.Характеристика));
					
				Если СтрокиТаблицаСебестоимости.Количество() > 0 Тогда
					
					СтрТовары.смартСебестоимостьЗаЕдиницу = ?(СтрокиТаблицаСебестоимости[0].КоличествоОстаток > 0, 
						СтрокиТаблицаСебестоимости[0].СтоимостьБезНДСОстаток / СтрокиТаблицаСебестоимости[0].КоличествоОстаток, 0)			
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЦикла;
	
	КонецЕсли;
	//-- #Б-5574 смарт: Фролов 03.02.2026
	#КонецВставки

КонецПроцедуры //-- #Б-5574 смарт: Фролов 03.02.2026

