//++ смарт:ММ #040 217 21.03.2020 - проверка рулонов
&НаКлиенте
Процедура смарт_ТоварыКоличествоУпаковокПриИзмененииПеред(Элемент)
	
	Строка = Элементы.Товары.ТекущиеДанные;
	
	Если смартОбщегоНазначения.НоменклатураВРулонахПоХарактеристикам(Строка.Номенклатура) Тогда		
		Если Не смартОбщегоНазначенияКлиент.ПроверитьПравильностьЗаполненияКоличестваВСтроке(Строка) Тогда 			
			ВывестиСообщениеОбОшибкеПользователю(Строка.НомерСтроки);
			Строка.КоличествоУпаковок = 0;
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 21.03.2020

//++ смарт:ММ #040 217 21.03.2020 - проверка рулонов
&НаКлиенте
Процедура смарт_ТоварыХарактеристикаПриИзмененииПосле(Элемент)
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если смартОбщегоНазначения.НоменклатураВРулонахПоХарактеристикам(ТекущаяСтрока.Номенклатура) Тогда	
		ТекущаяСтрока.КоличествоУпаковок = 0;
		ТекущаяСтрока.Количество = 0;
	КонецЕсли;
	
КонецПроцедуры //-- смарт:ММ 21.03.2020

