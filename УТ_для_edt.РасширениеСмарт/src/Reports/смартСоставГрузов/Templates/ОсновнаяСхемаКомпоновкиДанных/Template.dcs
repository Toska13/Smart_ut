<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанныхЗапрос</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Груз</dataPath>
			<field>Груз</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Груз</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Партнер</dataPath>
			<field>Партнер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Партнер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоУпаковок</dataPath>
			<field>КоличествоУпаковок</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Количество</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказПоставщику</dataPath>
			<field>ЗаказПоставщику</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цена</dataPath>
			<field>Цена</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументПоступления</dataPath>
			<field>ДокументПоступления</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Упаковка</dataPath>
			<field>Упаковка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Серия</dataPath>
			<field>Серия</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусГруза</dataPath>
			<field>СтатусГруза</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус груза</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыКПоступлению.Регистратор КАК ДокументРегистратор,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ТоварыКПоступлению.Регистратор) = ТИП(Документ.ПриобретениеТоваровУслуг)
				И НЕ ТоварыКПоступлению.Регистратор.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
			ТОГДА ТоварыКПоступлению.Регистратор.ЗаказПоставщику
		КОГДА ТИПЗНАЧЕНИЯ(ТоварыКПоступлению.Регистратор) = ТИП(Документ.ПриобретениеТоваровУслуг)
				И ТоварыКПоступлению.Регистратор.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
			ТОГДА ТоварыКПоступлению.ДокументПоступления
		ИНАЧЕ ТоварыКПоступлению.Регистратор
	КОНЕЦ КАК ЗаказПоставщику,
	ТоварыКПоступлению.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ОтборПоГрузу
ИЗ
	РегистрНакопления.ТоварыКПоступлению КАК ТоварыКПоступлению
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	МАКСИМУМ(ОтборПоГрузу.ДокументРегистратор) КАК ДокументРегистратор,
	ОтборПоГрузу.ЗаказПоставщику КАК ЗаказПоставщику,
	ОтборПоГрузу.Номенклатура КАК Номенклатура
ПОМЕСТИТЬ ГруппировкаПоПоступлению
ИЗ
	ОтборПоГрузу КАК ОтборПоГрузу

СГРУППИРОВАТЬ ПО
	ОтборПоГрузу.ЗаказПоставщику,
	ОтборПоГрузу.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Груз, ЗаказПоставщикуТовары.Ссылка.Груз) КАК Груз,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Партнер, ЗаказПоставщикуТовары.Ссылка.Груз) КАК Партнер,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Номенклатура, ЗаказПоставщикуТовары.Номенклатура) КАК Номенклатура,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Цена, ЗаказПоставщикуТовары.Цена) КАК Цена,
	СУММА(ЕСТЬNULL(ПриобретениеТоваровУслугТовары.КоличествоУпаковок, ЗаказПоставщикуТовары.КоличествоУпаковок)) КАК КоличествоУпаковок,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Упаковка, ЗаказПоставщикуТовары.Упаковка) КАК Упаковка,
	СУММА(ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Сумма, ЗаказПоставщикуТовары.Сумма)) КАК Сумма,
	ГруппировкаПоПоступлению.ЗаказПоставщику КАК ЗаказПоставщику,
	ВЫБОР
		КОГДА ГруппировкаПоПоступлению.ДокументРегистратор = ГруппировкаПоПоступлению.ЗаказПоставщику
			ТОГДА ЗНАЧЕНИЕ(Документ.ПриобретениеТоваровУслуг.ПустаяСсылка)
		ИНАЧЕ ГруппировкаПоПоступлению.ДокументРегистратор
	КОНЕЦ КАК ДокументПоступления,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)) КАК Серия,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Груз.СтатусГруза, ЗаказПоставщикуТовары.Ссылка.Груз.СтатусГруза) КАК СтатусГруза
ИЗ
	ГруппировкаПоПоступлению КАК ГруппировкаПоПоступлению
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		ПО ГруппировкаПоПоступлению.ДокументРегистратор = ПриобретениеТоваровУслугТовары.Ссылка
			И ГруппировкаПоПоступлению.Номенклатура = ПриобретениеТоваровУслугТовары.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		ПО ГруппировкаПоПоступлению.ЗаказПоставщику = ЗаказПоставщикуТовары.Ссылка
			И ГруппировкаПоПоступлению.Номенклатура = ЗаказПоставщикуТовары.Номенклатура

СГРУППИРОВАТЬ ПО
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Груз, ЗаказПоставщикуТовары.Ссылка.Груз),
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Партнер, ЗаказПоставщикуТовары.Ссылка.Груз),
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Номенклатура, ЗаказПоставщикуТовары.Номенклатура),
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Упаковка, ЗаказПоставщикуТовары.Упаковка),
	ГруппировкаПоПоступлению.ЗаказПоставщику,
	ВЫБОР
		КОГДА ГруппировкаПоПоступлению.ДокументРегистратор = ГруппировкаПоПоступлению.ЗаказПоставщику
			ТОГДА ЗНАЧЕНИЕ(Документ.ПриобретениеТоваровУслуг.ПустаяСсылка)
		ИНАЧЕ ГруппировкаПоПоступлению.ДокументРегистратор
	КОНЕЦ,
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Серия, ЗНАЧЕНИЕ(Справочник.СерииНоменклатуры.ПустаяСсылка)),
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Цена, ЗаказПоставщикуТовары.Цена),
	ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.Груз.СтатусГруза, ЗаказПоставщикуТовары.Ссылка.Груз.СтатусГруза)</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоУпаковок</dataPath>
		<expression>Сумма(КоличествоУпаковок)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Сумма(Цена)</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Состав груза</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>ПользовательскиеПоля.Поле1</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказ поставщику</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>ЗаказПоставщику.Партнер.Наименование + ", Заказ поставщику" + ЗаказПоставщику.Номер + Выбор
	Когда (Не ЗаказПоставщику.Дата Есть Null)
		Тогда " от "
	Иначе ""
Конец + Формат(ЗаказПоставщику.Дата, "ДФ=дд.ММ.гггг")</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>[Заказ поставщику.Клиент.Наименование] + ", Заказ поставщику" + [Заказ поставщику.Номер] + Выбор
	Когда (Не [Заказ поставщику.Дата] Есть Null)
		Тогда " от "
	Иначе ""
Конец + Формат([Заказ поставщику.Дата], "ДФ=дд.ММ.гггг")</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression/>
					<dcsset:totalExpressionPresentation/>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>ПользовательскиеПоля.Поле2</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказ по данным поставщика</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>ЗаказПоставщику.НомерПоДаннымПоставщика + Выбор
	Когда ЗаказПоставщику.ДатаПоДаннымПоставщика = ДатаВремя(1, 1, 1)
		Тогда " "
	Иначе " от "
Конец + Формат(ЗаказПоставщику.ДатаПоДаннымПоставщика, "ДФ=дд.ММ.гггг")</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>[Заказ поставщику.Номер по данным поставщика] + Выбор
	Когда [Заказ поставщику.Дата по данным поставщика] = ДатаВремя(1, 1, 1)
		Тогда " "
	Иначе " от "
Конец + Формат([Заказ поставщику.Дата по данным поставщика], "ДФ=дд.ММ.гггг")</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression/>
					<dcsset:totalExpressionPresentation/>
				</dcsset:item>
			</dcsset:userFields>
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Номенклатура</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КоличествоУпаковок</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Цена</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
