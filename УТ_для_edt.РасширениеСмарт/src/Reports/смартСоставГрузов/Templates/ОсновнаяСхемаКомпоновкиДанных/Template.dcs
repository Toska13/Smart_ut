					<dcsset:left xsi:type="dcscor:Field">СтатусГруза</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Перечисление.СтатусыГрузов.Принят</dcsset:right>
					<dcsset:userSettingID>d6b925d1-fc80-4275-8b33-de7eb00b5c6c</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
