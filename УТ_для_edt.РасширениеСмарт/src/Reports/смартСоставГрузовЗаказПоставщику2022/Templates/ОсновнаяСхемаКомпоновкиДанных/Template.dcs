		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цена</dataPath>
			<field>Цена</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Упаковка</dataPath>
			<field>Упаковка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерСтроки</dataPath>
			<field>НомерСтроки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусГруза</dataPath>
			<field>СтатусГруза</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Статус груза</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВесГруза</dataPath>
			<field>ВесГруза</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вес груза</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВесБрутто</dataPath>
			<field>ВесБрутто</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вес брутто</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПоставщикуТовары.Ссылка.Груз КАК Груз,
	ЗаказПоставщикуТовары.Ссылка.Партнер КАК Партнер,
	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
	ЗаказПоставщикуТовары.Цена КАК Цена,
	СУММА(ЗаказПоставщикуТовары.КоличествоУпаковок) КАК КоличествоУпаковок,
	ЗаказПоставщикуТовары.Упаковка КАК Упаковка,
	СУММА(ЗаказПоставщикуТовары.Сумма) КАК Сумма,
	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
	ЗаказПоставщикуТовары.НомерСтроки КАК НомерСтроки
ПОМЕСТИТЬ тч
ИЗ
	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
ГДЕ
	ЗаказПоставщикуТовары.Ссылка.Груз &lt;&gt; ЗНАЧЕНИЕ(Справочник.смартГрузы.ПустаяСсылка)
	И НЕ ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления

СГРУППИРОВАТЬ ПО
	ЗаказПоставщикуТовары.Ссылка.Груз,
	ЗаказПоставщикуТовары.Ссылка.Партнер,
	ЗаказПоставщикуТовары.Цена,
	ЗаказПоставщикуТовары.Ссылка,
	ЗаказПоставщикуТовары.Упаковка,
	ЗаказПоставщикуТовары.Номенклатура,
	ЗаказПоставщикуТовары.НомерСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	тч.Груз КАК Груз,
	тч.Партнер КАК Партнер,
	тч.Номенклатура КАК Номенклатура,
	тч.Цена КАК Цена,
	СУММА(тч.КоличествоУпаковок) КАК КоличествоУпаковок,
	тч.Упаковка КАК Упаковка,
	СУММА(тч.Сумма) КАК Сумма,
	тч.ЗаказПоставщику КАК ЗаказПоставщику,
	тч.НомерСтроки КАК НомерСтроки,
	тч.Груз.СтатусГруза КАК СтатусГруза,
	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0) КАК ВесБрутто,
	СУММА(ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0) * тч.КоличествоУпаковок) КАК ВесГруза
ИЗ
	тч КАК тч
	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
		ПО тч.Номенклатура = УпаковкиЕдиницыИзмерения.Владелец
			И тч.Номенклатура.ЕдиницаИзмерения = УпаковкиЕдиницыИзмерения.ЕдиницаИзмерения

СГРУППИРОВАТЬ ПО
	тч.Номенклатура,
	тч.Цена,
	тч.ЗаказПоставщику,
	тч.Груз,
	тч.Партнер,
	тч.Упаковка,
	тч.НомерСтроки,
	ЕСТЬNULL(УпаковкиЕдиницыИзмерения.Вес, 0)</query>
	</dataSet>
	<totalField>
		<dataPath>КоличествоУпаковок</dataPath>
		<expression>Сумма(КоличествоУпаковок)</expression>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
	<totalField>
		<dataPath>Цена</dataPath>
		<expression>Сумма(Цена)</expression>
	</totalField>
	<totalField>
		<dataPath>ВесГруза</dataPath>
		<expression>Сумма(ВесГруза)</expression>
	</totalField>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Состав груза (По заказам поставщику)</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:userFields>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>ПользовательскиеПоля.Поле1</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказ поставщику</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>ЗаказПоставщику.Партнер.Наименование + ", Заказ поставщику" + ЗаказПоставщику.Номер + Выбор
	Когда (Не ЗаказПоставщику.Дата Есть Null)
		Тогда " от "
	Иначе ""
Конец + Формат(ЗаказПоставщику.Дата, "ДФ=дд.ММ.гггг")</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>[Заказ поставщику.Партнер.Наименование] + ", Заказ поставщику" + [Заказ поставщику.Номер] + Выбор
	Когда (Не [Заказ поставщику.Дата] Есть Null)
		Тогда " от "
	Иначе ""
Конец + Формат([Заказ поставщику.Дата], "ДФ=дд.ММ.гггг")</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression/>
					<dcsset:totalExpressionPresentation/>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:UserFieldExpression">
					<dcsset:dataPath>ПользовательскиеПоля.Поле2</dcsset:dataPath>
					<dcsset:lwsTitle>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Заказ по данным поставщика</v8:content>
						</v8:item>
					</dcsset:lwsTitle>
					<dcsset:detailExpression>ЗаказПоставщику.НомерПоДаннымПоставщика + Выбор
	Когда ЗаказПоставщику.ДатаПоДаннымПоставщика = ДатаВремя(1, 1, 1)
		Тогда " "
	Иначе " от "
Конец + Формат(ЗаказПоставщику.ДатаПоДаннымПоставщика, "ДФ=дд.ММ.гггг")</dcsset:detailExpression>
					<dcsset:detailExpressionPresentation>[Заказ поставщику.НомерПоДаннымПоставщика] + Выбор
	Когда [Заказ поставщику.ДатаПоДаннымПоставщика] = ДатаВремя(1, 1, 1)
		Тогда " "
	Иначе " от "
Конец + Формат([Заказ поставщику.ДатаПоДаннымПоставщика], "ДФ=дд.ММ.гггг")</dcsset:detailExpressionPresentation>
					<dcsset:totalExpression/>
					<dcsset:totalExpressionPresentation/>
				</dcsset:item>
			</dcsset:userFields>
