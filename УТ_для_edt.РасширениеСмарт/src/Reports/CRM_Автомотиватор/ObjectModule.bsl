#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеренесеноСДоработкамиСмарт

&После("ПриКомпоновкеРезультата")
Процедура смарт_ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	//++ #1756 смарт: Ермаков 12.04.2024 / Добавить в CRM отчет "Мой автомотиватор" отборы по группам пользователей.
	СтандартнаяОбработка = Ложь;                                       
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();	
	
	смартВключитьОтборПоГруппамПользователей(НастройкиОтчета);	
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , ДанныеРасшифровки, Истина);

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	//-- #1756 смарт: Ермаков 12.04.2024
	
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

Функция смартВключитьОтборПоГруппамПользователей(ОбъектНастройки, ИспользоватьТолькоНастройки = Ложь)
	
	//++ #1756 смарт: Ермаков 12.04.2024 / Добавить в CRM отчет "Мой автомотиватор" отборы по группам пользователей.
	ПараметрГруппыПользователей  = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(
		ОбъектНастройки, 
		"ГруппаПользователей");	

	Если ПараметрГруппыПользователей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрИспользуетсяОтборПоГруппеПользователей  = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(
		ОбъектНастройки, 
		"ИспользуетсяОтборПоГруппеПользователей");
		
	Если ПараметрИспользуетсяОтборПоГруппеПользователей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрИспользуетсяОтборПоГруппеПользователей.Значение      = Ложь;
	ПараметрИспользуетсяОтборПоГруппеПользователей.Использование = Ложь;
	
	ОтборПоГруппамПользователей = ПараметрГруппыПользователей.Использование;
	
	КомпоновкаДанныхКлиентСервер.УстановитьПараметр(ОбъектНастройки, "ИспользуетсяОтборПоГруппеПользователей", Истина, ОтборПоГруппамПользователей);
	
	Для Каждого Вариант Из СхемаКомпоновкиДанных.ВариантыНастроек Цикл
		
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Вариант.Настройки, "ИспользуетсяОтборПоГруппеПользователей", Истина, ОтборПоГруппамПользователей);		
		КомпоновкаДанныхКлиентСервер.УстановитьПараметр(Вариант.Настройки, "ГруппаПользователей", ПараметрГруппыПользователей.Значение, ОтборПоГруппамПользователей);		
		
	КонецЦикла;
	
	Возврат ОтборПоГруппамПользователей;
	//-- #1756 смарт: Ермаков 12.04.2024
	
КонецФункции

Процедура смартПрименитьНачальныеПараметры()
	
	//++ #1756 смарт: Ермаков 12.04.2024 / Добавить в CRM отчет "Мой автомотиватор" отборы по группам пользователей.
	МассивПодстрок = Новый Массив;
	МассивПодстрок.Добавить("(CRM_Взаимодействие.Ответственный В (&Менеджеры))");
	МассивПодстрок.Добавить("(ТелефонныйЗвонок.Ответственный В (&Менеджеры))"); 
	МассивПодстрок.Добавить("(Пользователи.Ссылка В (&Менеджеры))");
	МассивПодстрок.Добавить("(CRM_ИспользуемыеКлючевыеПоказатели.Менеджер В (&Менеджеры))");
	
	Для Каждого НаборДанных Из СхемаКомпоновкиДанных.НаборыДанных Цикл
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Пользователь КАК Пользователь,
		|	ИСТИНА КАК ИспользуетсяОтборПоГруппеПользователей
		|ПОМЕСТИТЬ ОтборПоГруппеПользователей
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав
		|
		|{ГДЕ
		|	(Ссылка В (&ГруппаПользователей))}
		|ИНДЕКСИРОВАТЬ ПО
		|	Пользователь, 
		|	ИспользуетсяОтборПоГруппеПользователей
		|
		|;
		|" + НаборДанных.Запрос;
		
		Для Каждого ЭлементМассива Из МассивПодстрок Цикл
			
			СтрокаЗамены = 
				""
				+ Сред(ЭлементМассива, 1, СтрНайти(ЭлементМассива, " В "))
				+ " В "
				+ "(ВЫБРАТЬ Пользователь ИЗ ОтборПоГруппеПользователей ГДЕ ИспользуетсяОтборПоГруппеПользователей = &ИспользуетсяОтборПоГруппеПользователей)),";
				
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
											ЭлементМассива,
											СтрокаЗамены
											+ ЭлементМассива);
			
		КонецЦикла;
		
		НаборДанных.Запрос = ТекстЗапроса;
		
	КонецЦикла;
	
	Параметр = СхемаКомпоновкиДанных.Параметры.Добавить();
	Параметр.Имя = "ГруппаПользователей";
	Параметр.ДоступенСписокЗначений = Истина;
	Параметр.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ГруппыПользователей");	
	
	Параметр = СхемаКомпоновкиДанных.Параметры.Добавить();
	Параметр.Имя = "ИспользуетсяОтборПоГруппеПользователей";
	Параметр.ТипЗначения = Новый ОписаниеТипов("Булево");
	
	Для Каждого Вариант ИЗ СхемаКомпоновкиДанных.ВариантыНастроек Цикл
		
		Параметр = "ГруппаПользователей";
		ПараметрГруппаПользователей = Вариант.Настройки.ПараметрыДанных.Элементы.Добавить();
		ПараметрГруппаПользователей.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;
		ПараметрГруппаПользователей.Значение = Справочники.ГруппыПользователей.ПустаяСсылка();
		ПараметрГруппаПользователей.Параметр = Новый ПараметрКомпоновкиДанных(Параметр);
		ПараметрГруппаПользователей.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		
		Параметр = "ИспользуетсяОтборПоГруппеПользователей";
		ПараметрИспользуетсяОтборПоГруппеПользователей = Вариант.Настройки.ПараметрыДанных.Элементы.Добавить();
		ПараметрИспользуетсяОтборПоГруппеПользователей.ИдентификаторПользовательскойНастройки = Новый УникальныйИдентификатор;
		ПараметрИспользуетсяОтборПоГруппеПользователей.Значение = Ложь;
		ПараметрИспользуетсяОтборПоГруппеПользователей.Параметр = Новый ПараметрКомпоновкиДанных(Параметр);
		ПараметрИспользуетсяОтборПоГруппеПользователей.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	КонецЦикла;
	//-- #1756 смарт: Ермаков 12.04.2024
	
КонецПроцедуры

//++ #1756 смарт: Ермаков 12.04.2024 / Добавить в CRM отчет "Мой автомотиватор" отборы по группам пользователей.
смартПрименитьНачальныеПараметры();
//-- #1756 смарт: Ермаков 12.04.2024

#КонецОбласти 

