
&После("ВыполнитьПереопределяемуюКоманду")
Процедура смарт_ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры)

	//++ #1448 смарт: Ермаков 26.09.2023 // Копировать КИ контактного лица.
	// Перенес исполнение в переопределяемый модуль
	// Копирование контактной информации
	МассивФормСЭлементамиКопированияКИ = Новый Массив;
	МассивФормСЭлементамиКопированияКИ.Добавить("Документ.CRM_Интерес.Форма.ФормаДокументаНовая");
	МассивФормСЭлементамиКопированияКИ.Добавить("Документ.CRM_Взаимодействие.Форма.ФормаДокумента");
	МассивФормСЭлементамиКопированияКИ.Добавить("Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая");
	МассивФормСЭлементамиКопированияКИ.Добавить("Справочник.Партнеры.Форма.CRM_Модуль_ФормаСписка");
	МассивФормСЭлементамиКопированияКИ.Добавить("Справочник.КонтактныеЛицаПартнеров.Форма.CRM_ФормаЭлементаНовая");
	
	Если Не МассивФормСЭлементамиКопированияКИ.Найти(Форма.ИмяФормы) = Неопределено Тогда
		
		Если СтрНачинаетсяС(Команда.Имя, "КопированиеКИ") Тогда
			
			СистемнаяИнформация = Новый СистемнаяИнформация;
			Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 
				 Или СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 
				Тогда 
				
				ТекстДляВставки = "";
				Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая" Тогда

					ИндексКИСтрокой = СтрЗаменить(Форма.ТекущийЭлемент.Имя, "КопированиеКИ", "");
					Если Не Форма.Элементы.Найти("ЭлементСпискаКИ" + ИндексКИСтрокой) = Неопределено Тогда
						ТекстДляВставки = Форма.Элементы.Найти("ЭлементСпискаКИ" + ИндексКИСтрокой).Заголовок;
					ИначеЕсли Не Форма.Элементы.Найти("ЭлементТипаКИ" + ИндексКИСтрокой) = Неопределено Тогда
					    ТекстДляВставки = Форма.Элементы.Найти("ЭлементТипаКИ" + ИндексКИСтрокой).Заголовок;
					КонецЕсли;
					
				ИначеЕсли Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаСписка"  Тогда
					
					ИндексКИСтрокой = СтрЗаменить(Форма.ТекущийЭлемент.Имя, "КопированиеКИ", "");
					ТекстДляВставки = Форма["ВидКИ_" + ИндексКИСтрокой];
					
				//++ #1448 смарт: Фролов 17.01.2024 //Копировать номер контактного лица
				ИначеЕсли Форма.ИмяФормы = "Справочник.КонтактныеЛицаПартнеров.Форма.CRM_ФормаЭлементаНовая" Тогда
					
					ТекстДляВставки=Форма.Элементы.Найти("ЭлементСпискаКИКонтактнаяИнформацияПоле"+СтрЗаменить(Форма.ТекущийЭлемент.Имя,"КопированиеКИКонтактнаяИнформацияПоле","")).Заголовок;
				//-- #1448 смарт: Фролов 17.01.2024	
				Иначе	
					Итерация1 = СтрЗаменить(Форма.ТекущийЭлемент.Имя, "КопированиеКИ", ""); 
					Итерация2 = СтрЗаменить(Итерация1, "АдресЭлектроннойПочты", "");  
					Итерация3 = СтрЗаменить(Итерация2, "Телефон", "");                          
					
					ТекстДляВставки = Форма.Элементы.Найти("ЭлементТипаКИ" + Итерация1).Заголовок;					
					
				КонецЕсли;
				
				Если Не ПустаяСтрока(ТекстДляВставки) Тогда
					ЭлектронноеВзаимодействиеСлужебныйКлиент.СкопироватьВБуферОбмена(ТекстДляВставки, "Скопировано");
				КонецЕсли;
				
			КонецЕсли;
											
		КонецЕсли;
		
	КонецЕсли;
	//-- #1448 смарт: Ермаков 26.09.2023 // Копировать КИ контактного лица.
	
	//++ #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
	Если Форма.ИмяФормы = "Документ.CRM_Интерес.Форма.ФормаДокументаНовая" Тогда
		
		Если Команда.Имя = "смартСоздатьЗаметку" Тогда
			
			ПредметИнтереса = Б_ОбщиеПроцедурыИФункцииСервер.ПолучитьРеквизитОбъекта(Форма.Объект.Ссылка, "Партнер");
			ПредметИнтереса = ?(ПредметИнтереса.Пустая(), Форма.Объект.Ссылка, ПредметИнтереса); 
			ОткрытьФорму("Справочник.Заметки.ФормаОбъекта", Новый Структура("Предмет, ЗаметкаЛенты", ПредметИнтереса, Истина), Форма);				
			
		КонецЕсли;
		
	КонецЕсли;
	//-- #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
	
	//++ #1761 смарт: Ермаков 17.04.2024 / Оптимизация и доработка CRM Канбан "Мои продажи"
	Если Форма.ИмяФормы = "Обработка.CRM_АРМ_МоиПродажи.Форма.Форма" Тогда
		
		//++ #1761 смарт: Ермаков 17.04.2024 / Оптимизация и доработка CRM Канбан "Мои продажи"
		// Фактически, команда - это поле формы (поле флажка), создается на форме программно/ 
		// см. РасширениеСмарт.ОбщиеМодули.CRM_МодификацияКонфигурацииПереопределяемый.смарт_ПриСозданииНаСервере
		Если Команда.Имя = "смартКомпактно" Тогда 
			Форма.Масштаб = ?(Форма.смартКомпактно, 60, 100);
		КонецЕсли;	
		//-- #1761 смарт: Ермаков 17.04.2024
		
		//++ #1808 смарт: Ермаков 06.05.2024 / Доработка обработки Мои продажи - отбор по квалификациям.
		Если Команда.Имя = "смартКвалификация" 
			Или Команда.Имя = "смартПоискКлиент"
			Или Команда.Имя = "смартНовые"
			Или Команда.Имя = "смартСтарые" Тогда
			
			Форма.ОткрытьФильтрЗавершение(Истина, Неопределено)	
			
		КонецЕсли;
		//-- #1808 смарт: Ермаков 06.05.2024
		
	КонецЕсли;	
	//-- #1761 смарт: Ермаков 17.04.2024
	
	//++ #1809 смарт: Ермаков 13.05.2024 / Доработка списка документов Интересы - отбор по квалификациям.
	Если Форма.ИмяФормы = "Документ.CRM_Интерес.Форма.ФормаСписка" Тогда
		
		Если Команда.Имя = "смартКвалификация" Тогда
			
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(Форма.Список,, "смартКвалификацияГруппаИли");
			
			Если Форма.смартКвалификация.Количество() Тогда
				
				смартКвалификацияГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
												Форма.Список.Отбор,
												"смартКвалификацияГруппаИли",
												ТипГруппыЭлементовОтбораКомпоновкиДанных .ГруппаИли);
												
				смартКвалификацияГруппаИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
												смартКвалификацияГруппаИли,
												"смартКвалификацияГруппаИ",
												ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
					смартКвалификацияГруппаИ,
					"смартИтоговаяКвалификация",
					Неопределено,
					ВидСравненияКомпоновкиДанных.НеЗаполнено, 
					"смартИтоговаяКвалификация_НеЗаполнено",
					Истина,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
					
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
					смартКвалификацияГруппаИ,
					"смартПредварительнаяКвалификация",
					Форма.смартКвалификация,
					ВидСравненияКомпоновкиДанных.ВСписке, 
					,
					Истина,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);						
					
				ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(
					смартКвалификацияГруппаИли,
					"смартИтоговаяКвалификация",
					ВидСравненияКомпоновкиДанных.ВСписке, 
					Форма.смартКвалификация,
					"смартИтоговаяКвалификация_ВСписке",
					Истина,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);								
					
				// Структура группы фильтра
				// Группа ИЛИ
				//  - Группа И
				//  - - смартИтоговаяКвалификация Не Заполнено
				//  - - смартПредварительнаяКвалификация В Списке
				//	- смартИтоговаяКвалификация В Списке
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Команда.Имя = "смартНовые"
			Или Команда.Имя = "смартСтарые" Тогда
			
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
				Форма.Список,
				"смартВоронкаНовые");
				
			ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(
				Форма.Список,
				"смартВоронкаСтарые");

			Если Не (Форма.смартНовые И Форма.смартСтарые)
				И (Форма.смартНовые Или Форма.смартСтарые) Тогда
				
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
					Форма.Список,
					"смартВоронкаНовые",
					Форма.смартНовые,
					ВидСравненияКомпоновкиДанных.Равно, 
					,
					Форма.смартНовые,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
					
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
					Форма.Список,
					"смартВоронкаСтарые",
					Форма.смартСтарые,
					ВидСравненияКомпоновкиДанных.Равно, 
					,
					Форма.смартСтарые,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

			КонецЕсли;
			
		КонецЕсли;
		
		//++ #1867 смарт: Фролов 18.06.2024 //Доработка списка Интересов и Воронки продаж - отбор по взятым на контроль
		Если Команда.Имя = "смартНаКонтроле" Тогда
			
			Форма.Список.Параметры.УстановитьЗначениеПараметра("смартНаКонтроле", Форма.смартНаКонтроле);
			
		КонецЕсли;
		
		Если Команда.Имя = "смартНаблюдает" Тогда
			
			Форма.Список.Параметры.УстановитьЗначениеПараметра("смартНаблюдает", Форма.смартНаблюдает);
			
		КонецЕсли;	
		//-- #1867 смарт: Фролов 18.06.2024
		
		//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
		Если Команда.Имя = "смартТипУслуги" Тогда

			Если ЗначениеЗаполнено(Форма.смартТипУслуги) Тогда
				CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Форма.Список, "ТипУслуги", Форма.смартТипУслуги, Истина, ВидСравненияКомпоновкиДанных.ВСписке);
			Иначе	
				CRM_ОбщегоНазначенияКлиентСервер.ИзменитьЭлементОтбораСписка(Форма.Список, "ТипУслуги");
			КонецЕсли;
			
		КонецЕсли;

		Форма.СохраняемыеВНастройкахДанныеМодифицированы = Истина;
		//-- #1910 смарт: Лопато 07.08.2024
		
		CRM_ТегиКлиент.БыстрыйОтборИзменение(
			Форма, 
			?(Форма.ОтборЗавершен = "Все", "", Форма.ОтборЗавершен), 
			Форма.ОтборКонтрагент, 
			Форма.ОтборПользователь, 
			Форма.ОтборПроект, 
			Форма.ОтборТипОбращения, 
			Форма.смартКвалификация, 
			//++ #1910 смарт: Лопато 07.08.2024 //Сохранение настроек отбора списка интересов и их последующее применение при повторном входе в 1С.
			Форма.смартТипУслуги,
			//-- #1910 смарт: Лопато 07.08.2024
			?(Форма.смартНовые, Истина, ""), 
			?(Форма.смартСтарые, Истина, ""));
			
	КонецЕсли;
	//-- #1809 смарт: Ермаков 13.05.2024
	
КонецПроцедуры
