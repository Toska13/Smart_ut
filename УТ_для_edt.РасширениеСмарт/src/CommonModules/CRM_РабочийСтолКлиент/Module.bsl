
&ИзменениеИКонтроль("КомандаЗаметкиДобавить")
Процедура смарт_КомандаЗаметкиДобавить(Форма, Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПослеРедактированияЗаметок", 
		ЭтотОбъект, Новый Структура("Форма", Форма));
		
	#Удаление
	ОткрытьФорму("Справочник.Заметки.ФормаОбъекта",, 
		Форма,
		Форма.УникальныйИдентификатор,,, 
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);	
	#КонецУдаления
	#Вставка
	//++ #1443 смарт: Фролов 07.09.2023 //Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
	Параметры=Новый Структура; 
	Попытка	
		Если ЗначениеЗаполнено(Форма.смартТекущийПартнер) Тогда
			Параметры.Вставить("Предмет",Форма.смартТекущийПартнер);
		//++ #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
		ИначеЕсли ЗначениеЗаполнено(Форма.смартТекущийИнтерес) Тогда
			Параметры.Вставить("Предмет", Форма.смартТекущийИнтерес);
		//-- #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
		Иначе	
			Сообщить("Заметки можно создавать, только для интересов с заполненным клиентом"); 
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	//ОткрытьФорму("Справочник.Заметки.ФормаОбъекта",, 
	ОткрытьФорму("Справочник.Заметки.ФормаОбъекта",Параметры, 
		Форма,
		Форма.УникальныйИдентификатор,,, 
		Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
	);	
	//-- #1443 смарт: Фролов 07.09.2023
	#КонецВставки
	
КонецПроцедуры

//++ #1443 смарт: Фролов 20.09.2023 //Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
&ИзменениеИКонтроль("СформироватьПанельЗаметок")
Процедура смарт_СформироватьПанельЗаметок(Форма, ЗакрыватьПанель)
	Попытка
		ПоддерживаетРабочийСтол = Форма.ПоддерживаетРабочийСтол;
		Если Форма.Элементы.скОбластьЗаметки.Видимость И ЗакрыватьПанель Тогда
			Форма.Элементы.скОбластьЗаметки.Видимость = Ложь;
		Иначе	
			
			#Удаление
			МассивЭлементов = CRM_РабочийСтолСервер.ЗаметкиПользователя();
			#КонецУдаления
			
			#Вставка
			//++ #1443 смарт: Фролов 20.09.2023 //Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.	
			//++ #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
			// Формируем массив предметов, где может быть и документ и партнер одновременно
			МассивПредметов = Новый Массив;
			Если ЗначениеЗаполнено(Форма.смартТекущийИнтерес) Тогда
				МассивПредметов.Добавить(Форма.смартТекущийИнтерес);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Форма.смартТекущийПартнер) Тогда
				МассивПредметов.Добавить(Форма.смартТекущийПартнер);
			КонецЕсли;
			
			МассивЭлементов = CRM_РабочийСтолСервер.ЗаметкиПользователя_Расширенная(, МассивПредметов);
			//-- #1443 смарт: Фролов 20.09.2023
			//-- #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
			#КонецВставки
			
			Форма.скПолеHTMLЗаметок = HTMLПредставлениеСпискаЗаметок(МассивЭлементов);	
			Форма.Элементы.скОбластьЗаметки.Видимость = Истина;
			
			Форма.ТекущийЭлемент = Форма.Элементы.скПолеHTMLЗаметок;
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры
