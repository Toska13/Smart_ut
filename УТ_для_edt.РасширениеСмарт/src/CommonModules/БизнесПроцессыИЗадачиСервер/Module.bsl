
#Область ДоработкиСмарт

//++ #1514 смарт: Фролов 19.10.2023 //Доработка механизма оповещений по задачам
&ИзменениеИКонтроль("ОтправитьУведомлениеОНовыхЗадачах")
Функция смарт_ОтправитьУведомлениеОНовыхЗадачах(Исполнитель, ЗадачиПоИсполнителю)

	ПочтовыйАдресПолучателя = АдресЭлектроннойПочты(Исполнитель);
	Если ПустаяСтрока(ПочтовыйАдресПолучателя) Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы и задачи.Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Информация,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление не отправлено, так как не указан почтовый адрес у пользователя %1.'"), Строка(Исполнитель)));
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПисьма = "";
	Для Каждого Задача Из ЗадачиПоИсполнителю.Строки Цикл
		ТекстПисьма = ТекстПисьма + СформироватьПредставлениеЗадачи(Задача);
	КонецЦикла;
	#Удаление 
	ТемаПисьма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Направлены задачи - %1'"), Метаданные.КраткаяИнформация); 
	#КонецУдаления
	#Вставка
	//++ #1514 смарт: Фролов 19.10.2023 //Доработка механизма оповещений по задачам
	//Поменяли принцип формирования темы, в текст основной процедуры комментарии система вставлять не дает
	//Не внутрь конструкции #Удаление не снаружи
	ТемаПисьма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Направлены задачи из базы 1С - %1'"), Константы.ЗаголовокСистемы.Получить());
	//-- #1514 смарт: Фролов 19.10.2023
	#КонецВставки
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", ТемаПисьма);
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("Кому", ПочтовыйАдресПолучателя);
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	Попытка 
		УчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		Письмо = МодульРаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
		МодульРаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы и задачи.Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при отправке уведомления о новых задачах: %1'"), 
			   ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Бизнес-процессы и задачи.Уведомление о новых задачах'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомления успешно отправлены на адрес %1.'"), ПочтовыйАдресПолучателя));
	Возврат Истина;	

КонецФункции //-- #1514 смарт: Фролов 19.10.2023

//++ #1485 смарт: Фролов 19.10.2023 //Доработка механизма оповещений по просроченным задачам
&ИзменениеИКонтроль("СформироватьПредставлениеЗадачи")
Функция смарт_СформироватьПредставлениеЗадачи(ЗадачаСтруктура)

	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1
		|
		|Крайний срок: %2'") + Символы.ПС,
		ЗадачаСтруктура.Ссылка, 
		Формат(ЗадачаСтруктура.СрокИсполнения, НСтр("ru = 'ДЛФ=DD; ДП=''не указан'''")));
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Исполнитель) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Исполнитель: %1'"), ЗадачаСтруктура.Исполнитель) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.РольИсполнителя) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Роль: %1'"), ЗадачаСтруктура.РольИсполнителя) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ОсновнойОбъектАдресации) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Основной объект адресации: %1'"), ЗадачаСтруктура.ОсновнойОбъектАдресации) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ДополнительныйОбъектАдресации) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Доп. объект адресации: %1'"), ЗадачаСтруктура.ДополнительныйОбъектАдресации) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Автор) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Автор: %1'"), ЗадачаСтруктура.Автор) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Описание) Тогда
		Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"), ЗадачаСтруктура.Описание) + Символы.ПС;
	КонецЕсли; 
	#Вставка
	//++ #1485 смарт: Фролов 05.10.2023 //Доработка механизма оповещений по просроченным задачам
	Если ТипЗнч(ЗадачаСтруктура.Ссылка)=Тип("ЗадачаСсылка.ЗадачаИсполнителя") ТОгда
		Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Клиент: %1'"), ЗадачаСтруктура.Ссылка.CRM_Партнер);
		Если ТипЗнч(ЗадачаСтруктура.Ссылка.Предмет)=Тип("ДокументСсылка.CRM_Интерес") Тогда
			Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Интерес: %1'"), "№ "+ЗадачаСтруктура.Ссылка.Предмет.Номер+" от "+
			Формат(ЗадачаСтруктура.Ссылка.Предмет.Дата,"ДФ=dd.MM.yyyy")+", тема интереса: "+ЗадачаСтруктура.Ссылка.Предмет.Тема);
			Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Состояние интереса: %1'"), ЗадачаСтруктура.Ссылка.Предмет.СостояниеИнтереса)+Символы.ПС;
		Иначе	
			Результат = Результат + Символы.ПС;
		Конецесли;
		Если ЗначениеЗаполнено(ЗадачаСтруктура.Ссылка.CRM_КонтактноеЛицо) Тогда
			ТаблицаКИ=УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(ЗадачаСтруктура.Ссылка.CRM_КонтактноеЛицо,Перечисления.ТипыКонтактнойИнформации.Телефон,,ТекущаяДата());
			Если ТаблицаКИ.Количество()>0 ТОгда
				Результат = Результат + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Контактное лицо: %1'"), ЗадачаСтруктура.Ссылка.CRM_КонтактноеЛицо.Наименование) + Символы.ПС;	
				Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Телефон: %1'"), ТаблицаКИ[0].Представление) + Символы.ПС;
			КонецЕсли;	
		КонецЕсли;
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ссылка на задачу: %1'"), ПолучитьНавигационнуюСсылку(ЗадачаСтруктура.Ссылка)) + Символы.ПС;
	КонецЕсли;
	//-- #1485 смарт: Фролов 05.10.2023
	#КонецВставки
	
	Возврат Результат + Символы.ПС;

КонецФункции  //-- #1485 смарт: Фролов 19.10.2023

#КонецОбласти