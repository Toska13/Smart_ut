Функция НайтиЗаказ(НомерЗК,ДатаЗК,Организация,Контрагент)
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиента.Номер = &Номер
		|	И НАЧАЛОПЕРИОДА(ЗаказКлиента.Дата, ДЕНЬ) = &Дата
		|	И ЗаказКлиента.Организация = &Организация
		|	И ЗаказКлиента.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Дата", НачалоДня(ДатаЗК));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Номер", НомерЗК);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции

//++ #6650  смарт: Тимофеева 05.05.2026 / Взаиморасчеты. Часть3. Перенос задолженности.
Функция НайтиЗаказПоставщикуПоОстаткам(Организация, Контрагент, ДоговорСтрукутра)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеРегистра.ЗаказПоставщику КАК Ссылка
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщиками.Остатки(
	|			,
	|			АналитикаУчетаПоПартнерам.Организация = &Организация
	|				И АналитикаУчетаПоПартнерам.Контрагент = &Контрагент
	|				//%УсловиеПоДоговору%
	|			) КАК ДанныеРегистра";
	Запрос.УстановитьПараметр("Организация", Организация); 
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Если ДоговорСтрукутра.Свойство("Номер") И ЗначениеЗаполнено(ДоговорСтрукутра.Номер) Тогда
		Запрос.УстановитьПараметр("Номер", ДоговорСтрукутра.Номер);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%УсловиеПоДоговору%", " И ЗаказПоставщику.Договор.Номер = &Номер//%УсловиеПоДоговору%");
	КонецЕсли;
	
	Если ДоговорСтрукутра.Свойство("Дата") И ЗначениеЗаполнено(ДоговорСтрукутра.Дата) Тогда
		Запрос.УстановитьПараметр("Дата", ДоговорСтрукутра.Дата);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%УсловиеПоДоговору%", " И ЗаказПоставщику.Договор.Дата = &Дата//%УсловиеПоДоговору%");
	КонецЕсли;
	
	Если ДоговорСтрукутра.Свойство("Наименование") И ЗначениеЗаполнено(ДоговорСтрукутра.Наименование) Тогда
		Запрос.УстановитьПараметр("Наименование", ДоговорСтрукутра.Наименование);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//%УсловиеПоДоговору%", " И ЗаказПоставщику.Договор.Наименование = &Наименование");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли; 
	Возврат Неопределено;
КонецФункции
