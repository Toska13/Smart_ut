	РезультатЗапроса = Запрос.Выполнить();  
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();	
	Если ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;  
	Возврат Неопределено; 
КонецФункции
//-- #6652  смарт: Тимофеева 06.05.2026

Процедура ПКО_Документ_СписаниеЗадолженности_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	//ЗагрузитьДополнительныеСведения(?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка), 
	//	                            ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	Если ПолученныеДанные.ПометкаУдаления Тогда
		
		Если ДанныеИБ <> Неопределено Тогда
			ДанныеИБ.УстановитьПометкуУдаления(Истина);
			ДанныеИБ = Неопределено; // Иначе БСП исполнит алгоритм далее
		КонецЕсли;
		
		ПолученныеДанные = Неопределено; // типа Отказ=Истина из КД2
		Возврат;
	
	КонецЕсли;

	Если ДанныеИБ <> Неопределено Тогда
		ДанныеИБ.Проведен = ПолученныеДанные.Проведен;
	КонецЕсли;
	
	Если НЕ ПолученныеДанные=Неопределено  Тогда
		
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("Задолженность") и ПолученныеДанные.ДополнительныеСвойства.Задолженность.Количество()>0 Тогда
			Если ЗначениеЗаполнено(ПолученныеДанные.Организация) и ЗначениеЗаполнено(ПолученныеДанные.Контрагент) Тогда
				Для каждого Стр Из ПолученныеДанные.ДополнительныеСвойства.Задолженность Цикл
					ОтборСтруктура=Новый Структура("Сумма",Стр.Сумма);
					МассивНайденныхСтрок=ПолученныеДанные.Задолженность.НайтиСтроки(ОтборСтруктура);
					Если МассивНайденныхСтрок.Количество()>0 И Стр.Заказ.Значение.Свойство("Номер") И Стр.Заказ.Значение.Свойство("Дата") Тогда
						НомерЗК =     Стр.Заказ.Значение.Номер;
						ДатаЗК  =     Стр.Заказ.Значение.Дата; 
						//++ #6652  смарт: Тимофеева 06.05.2026 / Взаиморасчеты. Часть3. Перенос задолженности.
						Если Стр.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком Тогда 
							Если ПолученныеДанные.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеКредиторскойЗадолженности Тогда 
								СсылкаЗК = НайтиЗаказПоставщику(НомерЗК, ДатаЗК, ПолученныеДанные.Организация, ПолученныеДанные.Контрагент);
								МассивНайденныхСтрок[0].Заказ = СсылкаЗК;
							КонецЕсли;
						Иначе
						//-- #6652  смарт: Тимофеева 06.05.2026
							
							СсылкаЗК= НайтиЗаказ(НомерЗК,ДатаЗК,ПолученныеДанные.Организация,ПолученныеДанные.Контрагент);
							МассивНайденныхСтрок[0].Заказ=СсылкаЗК;
							
						//++ #6652  смарт: Тимофеева 06.05.2026 / Взаиморасчеты. Часть3. Перенос задолженности.
						КонецЕсли;
						//++ #6652  смарт: Тимофеева  06.05.2026
					КонецЕсли; 
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли; 
	
	КонецЕсли; 
	
	Если НЕ ДанныеИБ=Неопределено Тогда
		ДанныеИБ.Задолженность.Загрузить(ПолученныеДанные.Задолженность.Выгрузить());
	КонецЕсли; 
		
КонецПроцедуры

