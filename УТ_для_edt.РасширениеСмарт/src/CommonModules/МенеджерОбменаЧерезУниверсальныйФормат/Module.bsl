					Строка.СтавкаНДССтрокой = "НДС10_110";
				#Вставка
				//++ #1744 смарт: Шляпников 19.12.2024 / УТ. Добавить ставки НДС 5% и 7%
				ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
