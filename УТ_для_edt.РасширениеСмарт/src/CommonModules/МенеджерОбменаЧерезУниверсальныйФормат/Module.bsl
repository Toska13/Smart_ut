	ПолученныеДанные.Проведен = Истина;
	
	#Удаление
	Если ДанныеXDTO.ВидОперации.Значение = "ПроведениеВзаимозачета" Тогда
		ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
	Иначе
	#КонецУдаления 
	
	#Вставка
	//++ #Б1884 смарт: Шляпников 09.09.2025 / Синхронизация взаимозачетов из БП в УТ
	СостояниеДокумента = "";
	
	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") 
		И ДанныеXDTO.AdditionalInfo.Свойство("СостояниеДокумента") Тогда
		
		СостояниеДокумента = ВРег(ДанныеXDTO.AdditionalInfo.СостояниеДокумента);
		
	ИначеЕсли ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		
		СостояниеДокумента = ВРег(ДанныеXDTO.AdditionalInfo);
		
	КонецЕсли;
	
	Если СостояниеДокумента = ВРег("НеПроведен") Тогда
		ПолученныеДанные.Проведен = Ложь;
	ИначеЕсли СостояниеДокумента = ВРег("ПометкаУдаления") Тогда
		ПолученныеДанные.Проведен = Ложь;
		ПолученныеДанные.ПометкаУдаления = Истина;
	КонецЕсли;
	//-- #Б1884 смарт: Шляпников 09.09.2025
	
	//Смарт {[*](фрагмент ИЗМЕНЕН), Подкин Алексей Иванович 27.11.2020 10:26:25
	Если ДанныеXDTO.ВидОперации.Значение = "ПроведениеВзаимозачета" ИЛИ ДанныеXDTO.ВидОперации.Значение = "ПереносЗадолженности" Тогда
		
		Если ДанныеXDTO.Свойство("КонтрагентДебитор") и ДанныеXDTO.Свойство("КонтрагентКредитор") и ДанныеXDTO.КонтрагентДебитор<>ДанныеXDTO.КонтрагентКредитор Тогда  //25.03.2021 убрал проверку по ИНН
			ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.МеждуКлиентами;
		иначе
			//Был Произвольный
			ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Клиента;
		КонецЕсли;
		
		Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") 
			И ДанныеXDTO.AdditionalInfo.Свойство("ВидАвансаЗадолженности") И ДанныеXDTO.AdditionalInfo.Свойство("ТипАвансаЗадолженности") Тогда
		
			Если ДанныеXDTO.AdditionalInfo.ВидАвансаЗадолженности = "Авансы поставщику" И ДанныеXDTO.AdditionalInfo.ТипАвансаЗадолженности = "Самого контрагента" Тогда
				ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Поставщика;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ДанныеXDTO.ВидОперации.Значение = "ПрочиеКорректировки" Тогда  
		ВидРасчетов = "";    
        //++ смарт:ПА #844 27.12.2021 11:42:38
		Если ДанныеXDTO.Свойство("ДебиторскаяЗадолженность") И ЗначениеЗаполнено(ДанныеXDTO.ДебиторскаяЗадолженность) 
			И ДанныеXDTO.ДебиторскаяЗадолженность.Количество() > 0 И ДанныеXDTO.ДебиторскаяЗадолженность[0].ВидРасчетов<>Неопределено Тогда 
        //-- смарт:ПА #844 27.12.2021 11:42:38 ДанныеXDTO.ДебиторскаяЗадолженность[0].ВидРасчетов<>Неопределено
			ВидРасчетов = ДанныеXDTO.ДебиторскаяЗадолженность[0].ВидРасчетов.Значение; 
            //++ смарт:ПА #844 27.12.2021 11:43:15
		ИначеЕсли ДанныеXDTO.Свойство("КредиторскаяЗадолженность") И ЗначениеЗаполнено(ДанныеXDTO.КредиторскаяЗадолженность) 
			И ДанныеXDTO.КредиторскаяЗадолженность.Количество() > 0 И ДанныеXDTO.КредиторскаяЗадолженность[0].ВидРасчетов<>Неопределено Тогда
            //-- смарт:ПА #844 27.12.2021 11:43:15 ДанныеXDTO.КредиторскаяЗадолженность[0].ВидРасчетов<>Неопределено
			ВидРасчетов = ДанныеXDTO.КредиторскаяЗадолженность[0].ВидРасчетов.Значение;
        КонецЕсли;
		
		//++ #Б1884 смарт: Шляпников 09.09.2025 / Синхронизация взаимозачетов из БП в УТ
		ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
		//Если ВидРасчетов = "СПокупателем" и ПолученныеДанные.КонтрагентДебитор<>ПолученныеДанные.КонтрагентКредитор Тогда
		//	ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.МеждуКлиентами;
		//ИначеЕсли ВидРасчетов = "СПокупателем" Тогда
		//	ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Бартер;
		//ИначеЕсли ВидРасчетов = "СПоставщиком" Тогда
		//	ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.МеждуПоставщиками;
		//Иначе
		//	ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
		//КонецЕсли;
		//-- #Б1884 смарт: Шляпников 09.09.2025 
		
		//++ #6412 смарт: Тимофеева 13.04.2026 / Взаиморасчеты. Часть1. Прочие корректировки
		Если ВидРасчетов = "СПоставщиком"
			И ДанныеXDTO.Свойство("КонтрагентДебитор") И ДанныеXDTO.КонтрагентДебитор.Свойство("Ссылка") 
			И ДанныеXDTO.Свойство("КонтрагентКредитор") И ДанныеXDTO.КонтрагентКредитор.Свойство("Ссылка")  
			И ДанныеXDTO.КонтрагентДебитор.Ссылка.Значение = ДанныеXDTO.КонтрагентКредитор.Ссылка.Значение Тогда
			ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Поставщика; 
			
		//++ #6654  смарт: Тимофеева 19.05.2026 / Взаиморасчеты. Часть5. Взаимозачет между тремя юр лицами.
		ИначеЕсли ВидРасчетов = "СПоставщиком"
			И ДанныеXDTO.Свойство("КонтрагентДебитор") И ДанныеXDTO.КонтрагентДебитор.Свойство("Ссылка") 
			И ДанныеXDTO.Свойство("КонтрагентКредитор") И ДанныеXDTO.КонтрагентКредитор.Свойство("Ссылка")  
			И НЕ ДанныеXDTO.КонтрагентДебитор.Ссылка.Значение = ДанныеXDTO.КонтрагентКредитор.Ссылка.Значение Тогда
            ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.МеждуПоставщиками;
		//-- #6654  смарт: Тимофеева 19.05.2026	
		КонецЕсли;
		//-- #6412 смарт: Тимофеева 13.04.2026
	Иначе
		//Смарт }Подкин Алексей Иванович 27.11.2020 10:26:25
	#КонецВставки  
	
		// вид операции определяется по типу расчетов дебиторской или кредиторской задолженности.
		ВидРасчетов = "";
		Если ДанныеXDTO.Свойство("ДебиторскаяЗадолженность") И ЗначениеЗаполнено(ДанныеXDTO.ДебиторскаяЗадолженность) 
			И ДанныеXDTO.ДебиторскаяЗадолженность.Количество() > 0 Тогда
			ВидРасчетов = ДанныеXDTO.ДебиторскаяЗадолженность[0].ВидРасчетов.Значение;
		ИначеЕсли ДанныеXDTO.Свойство("КредиторскаяЗадолженность") И ЗначениеЗаполнено(ДанныеXDTO.КредиторскаяЗадолженность) 
			И ДанныеXDTO.КредиторскаяЗадолженность.Количество() > 0 Тогда
			ВидРасчетов = ДанныеXDTO.КредиторскаяЗадолженность[0].ВидРасчетов.Значение;
		КонецЕсли;
		Если ВидРасчетов = "СПокупателем" Тогда
			ПолученныеДанные.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.МеждуКлиентами;
