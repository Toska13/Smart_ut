	// Определяем, что база (юридическое лицо), в которую выгружаем данные, относится к РФ
	СтранаМираУзлаКорреспондентаРоссия = 
			//++ #1708 смарт: Ермаков 01.04.2024 / ВыгрузкаЗагрузкаEnterpriseData Ошибка
			// Если выгрузка произсходит без узла обмена (неопределено) - страна Россия.
			КомпонентыОбмена.УзелКорреспондента = Неопределено
			//-- #1708 смарт: Ермаков 01.04.2024
			Или КомпонентыОбмена.УзелКорреспондента.смартСтранаМира = 
					ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.СтраныМира.Россия")
			Или КомпонентыОбмена.УзелКорреспондента.смартСтранаМира = 
					Справочники.СтраныМира.ПустаяСсылка();

	Если Не СтранаМираУзлаКорреспондентаРоссия Тогда 
		
		КодСтраныУзлаКорреспондента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КомпонентыОбмена.УзелКорреспондента.смартСтранаМира, "Код");
		
		// Не выгружаем контрагента с в составе карточки номенклатуры
		ДанныеXDTO.Удалить("ПроизводительИмпортер");
		
	КонецЕсли; 
	//-- #1567 смарт: Ермаков / Проверить и исправить синхронизацию УТ-УТ и выгрузку БП2.0-УТ + исправить ошибки
	
	//++ #Б-1706 смарт: Лопато 18.12.2024 //Доработка синхронизации УТ СМАРТ-Т РФ - БП СМАРТ-Т РФ  
	НоменклатурнаяГруппаБП = Неопределено;

	ТаблицаНастроекСопоставления = Справочники.смартПредопределенныеЗначения.Настройки.СопоставлениеСегментовИНоменклатурныхГруппБП.Выгрузить();
	
	Для Каждого НастройкаСопоставления Из ТаблицаНастроекСопоставления Цикл
		
		Если ЗначениеЗаполнено(НастройкаСопоставления.ГруппаАналитическогоУчета)
			И ЗначениеЗаполнено(НастройкаСопоставления.СегментНоменклатуры)
			И ЗначениеЗаполнено(НастройкаСопоставления.НаименованиеНоменклатурнойГруппыБП)
			И ДанныеИБ.ГруппаАналитическогоУчета = НастройкаСопоставления.ГруппаАналитическогоУчета Тогда

			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			               |	Номенклатура
			               |ИЗ
			               |	РегистрСведений.НоменклатураСегмента
			               |ГДЕ
			               |	Сегмент = &СегментСсылка
			               |	И Номенклатура = &НоменклатураСсылка";
			
			Запрос.УстановитьПараметр("СегментСсылка",		НастройкаСопоставления.СегментНоменклатуры);
			Запрос.УстановитьПараметр("НоменклатураСсылка", ДанныеИБ.Ссылка);
			
			НоменклатураВходитВСегмент = НЕ Запрос.Выполнить().Пустой();
			
			Если НоменклатураВходитВСегмент Тогда

				НоменклатурнаяГруппаБП = НастройкаСопоставления.НаименованиеНоменклатурнойГруппыБП;
				
				Прервать;
				
			КонецЕсли;		
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НоменклатурнаяГруппаБП) Тогда

		AdditionalInfoВставить(ДанныеXDTO, "НоменклатурнаяГруппаБП", НоменклатурнаяГруппаБП);
		
	КонецЕсли;
