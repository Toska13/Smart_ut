        |ТОГДА &Источник.Упаковка.ЕдиницаИзмерения КОНЕЦ КАК УпаковкаЕдиницаИзмерения,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Высота КОНЕЦ КАК УпаковкаВысота,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Глубина КОНЕЦ КАК УпаковкаГлубина,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Объем КОНЕЦ КАК УпаковкаОбъем,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Ширина КОНЕЦ КАК УпаковкаШирина,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Знаменатель КОНЕЦ КАК УпаковкаЗнаменатель,
        |ВЫБОР
        |КОГДА НЕ &Источник.Упаковка.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
        |ТОГДА &Источник.Упаковка.Числитель КОНЕЦ КАК УпаковкаЧислитель";
        
        ТекстЗапросаКоличественныеПоказатели = "		
        |	,&Источник.КоличествоУпаковок КАК КоличествоУпаковок";
    КонецЕсли;
    
    Если КоличественныеПоказатели Тогда
        ТекстЗапроса = ТекстЗапроса + ТекстЗапросаКоличественныеПоказатели;
    КонецЕсли;
    
