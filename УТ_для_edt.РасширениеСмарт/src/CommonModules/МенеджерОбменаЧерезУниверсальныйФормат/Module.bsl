	Если ДанныеXDTO.Свойство("Склад") И НЕ ЗначениеЗаполнено(ДанныеXDTO.Склад) И НЕ ДанныеИБ.Склад.ЭтоГруппа И ДанныеИБ.Склад.смартАвтоматическиФормироватьДокументы Тогда 
	//-- #1353 смарт: Фролов 17.05.2023		
		ДанныеXDTO.Вставить("Склад", ДанныеИБ.Склад);
	КонецЕсли; 
	//Смарт }Подкин Алексей Иванович 19.07.2021 17:40:38
	
	//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 19.08.2021 11:58:44 задача 601
	Если ДанныеXDTO.Свойство("Склад") И НЕ ЗначениеЗаполнено(ДанныеXDTO.Склад) И ДанныеИБ.Товары.Количество()>0 Тогда
		ТзСклад=ДанныеИБ.Товары.Выгрузить();
		ТзСклад.Свернуть("Склад");
		//++ #1353 смарт: Фролов 17.05.2023 //Доработать логику взаимодействия с Адмирал по нескольким складам (УТ + БП)
