	AdditionalInfoВставить(ДанныеXDTO, "смартОбязательнаяМаркировка", ДанныеИБ.смартОбязательнаяМаркировка);
	AdditionalInfoВставить(ДанныеXDTO, "смартВидМаркировки", СокрЛП(ДанныеИБ.смартВидМаркировки));
	
КонецПроцедуры

//++ #Б5128 смарт: Шляпников 22.12.2025 / Маркировка радиоэлектронной продукции. Доработка справочника "Классификатор ТН ВЭД". 1С БП
Процедура смарт_Справочник_КлассификаторТНВЭД_ЭлементСправочника_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
