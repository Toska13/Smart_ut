	#Область МаркировкиУпаковки

	ТекстЗапросаМаркировкиУпаковки =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугШтрихкодыУпаковок.НомерСтроки КАК НомерСтрокиДокумента,
