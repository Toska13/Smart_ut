&ИзменениеИКонтроль("ПКО_Справочник_ФизическиеЛица_Получение_ПриКонвертацииДанныхXDTO")
//++ #1644 смарт: Ермаков 02.05.2024 / Изменить доступ к документам физических лиц
Процедура смарт_ПКО_Справочник_ФизическиеЛица_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ЗагрузитьДополнительныеРеквизиты(ПолученныеДанные, ДанныеXDTO, КомпонентыОбмена, Истина);

	ЗагрузитьКонтактнуюИнформацию(ДанныеXDTO, ПолученныеДанные, Справочники.ВидыКонтактнойИнформации.СправочникФизическиеЛица);

	Если СвойствоФорматаОбмена(КомпонентыОбмена, "Справочник.ФизическиеЛица.ДанныеФИО") Тогда
		Если ДанныеXDTO.Свойство("ДанныеФИО") И ДанныеXDTO.ДанныеФИО.Количество() > 0 Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПодробныеДанныеФИО", ДанныеXDTO.ДанныеФИО);
		КонецЕсли;
	КонецЕсли;
	
	#Вставка
	//++ #1644 смарт: Ермаков 02.05.2024 / Изменить доступ к документам физических лиц
	// Так как выгрузка данных из ЗУП прилетает без определения узла обмена, 
	// на стороне ЗУП был добавлен отличительный признак.
	// Считается, что если Физлицо приехало из ЗУП - это сотрудник (внутренний).
	Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда
		
		Если ДанныеXDTO.AdditionalInfo.Свойство("ЭтоВыгрузкаИзЗУП") Тогда
			
			Если ДанныеXDTO.AdditionalInfo.ЭтоВыгрузкаИзЗУП Тогда
				
				ПолученныеДанные.смартВидФизическогоЛица = Перечисления.смартВидыФизическихЛиц.Внутренний;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		//++ #Б3646 смарт: Шляпников 15.07.2025 / Синхронизация данных о должности из ЗУП в УТ
		Если ДанныеXDTO.AdditionalInfo.Свойство("смартДолжность") Тогда
			ПолученныеДанные.смартДолжность = ДанныеXDTO.AdditionalInfo.смартДолжность;	
		КонецЕсли;
		//-- #Б3646 смарт: Шляпников 15.07.2025
		
		//++ #Б7214 смарт: Шляпников 23.06.2026 / Загрузить Табельные номера из ЗУП в УТ и настроить синхрон этого параметра
		Если ДанныеXDTO.AdditionalInfo.Свойство("смартТабельныйНомер") Тогда
			ПолученныеДанные.смартТабельныйНомер = ДанныеXDTO.AdditionalInfo.смартТабельныйНомер;	
		КонецЕсли;
		//-- #Б7214 смарт: Шляпников 23.06.2026
			
	КонецЕсли;
	//-- #1644 смарт: Ермаков 02.05.2024
	#КонецВставки

КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных")
Процедура смарт_ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	ФизЛицоСсылка = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ЗагрузитьДополнительныеСведения(ФизЛицоСсылка, ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	ЗагрузитьПодробныеДанныеФИО(КомпонентыОбмена, ПолученныеДанные, ФизЛицоСсылка);
	
	#Вставка
	//++ #Б3646 смарт: Шляпников 15.07.2025 / Синхронизация данных о должности из ЗУП в УТ
	Если НЕ ДанныеИБ = Неопределено Тогда
		ДанныеИБ.смартДолжность = ПолученныеДанные.смартДолжность;
		ДанныеИБ.смартТабельныйНомер = ПолученныеДанные.смартТабельныйНомер;
	КонецЕсли;
	//-- #Б3646 смарт: Шляпников 15.07.2025
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#Область ДоработкиСмарт

//смартКаратеев ++
Процедура AdditionalInfoВставить(ДанныеXDTO, Имя, ДопЗначение)

	Если ДанныеXDTO.Свойство("AdditionalInfo") И ТипЗнч(ДанныеXDTO.AdditionalInfo)=Тип("Структура") Тогда
		ДопДанные = ДанныеXDTO.AdditionalInfo;
	Иначе
		ДопДанные = Новый Структура;
	КонецЕсли;

	ДопДанные.Вставить(Имя, ДопЗначение);
	ДанныеXDTO.Вставить("AdditionalInfo", ДопДанные);

КонецПроцедуры //Каратеев --     

