
#Область ПеренесеноСДоработкамиСмарт

&ИзменениеИКонтроль("СформироватьЛенту")
Функция смарт_СформироватьЛенту(Знач ПараметрыЛенты, ПолучателиЧата)
	
	Если ПараметрыЛенты.Пустая Тогда
		Возврат CRM_ЛентаСобытийПовтИсп.ТекстЗаглушкиЛенты();
	КонецЕсли;
	
	// Получатели чата для области ввода заполняются по итогам формирования ленты.
	ЗаполнитьПолучателейЧата = Ложь;
	Если ПолучателиЧата <> Неопределено Тогда
		ЗаполнитьПолучателейЧата = Истина;
		ПолучателиЧатаТаблица = Новый ТаблицаЗначений;
		ПолучателиЧатаТаблица.Колонки.Добавить("Идентификатор",);
		ПолучателиЧатаТаблица.Колонки.Добавить("Адрес",);
		ПолучателиЧатаТаблица.Колонки.Добавить("Представление");
		ПолучателиЧатаТаблица.Колонки.Добавить("Контакт");
		ПолучателиЧатаТаблица.Колонки.Добавить("УчетнаяЗапись");
		ПолучателиЧатаТаблица.Колонки.Добавить("Группа");
		// +Рарус alexpr
		ПолучателиЧатаТаблица.Колонки.Добавить("ВидКИ");
		// -Рарус alexpr		
	КонецЕсли;
	
	// Отборы и параметры формирования.
	ВключенныеТипыОбъектов = ТипыОбъектовЛентыПоОтбору(ПараметрыЛенты.Отбор);
	ВключеныДокументы = ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "Документы");
	Если ВключеныДокументы Тогда
		ПрочиеТипыОбъектов = CRM_ЛентаСобытийПовтИсп.ТипыОбъектовОтбораДокументов();
	Иначе
		ПрочиеТипыОбъектов = Новый Массив;
	КонецЕсли;
	ВключенныеТипыОбращений = ТипыОбращенийЛентыПоОтбору(ПараметрыЛенты.Отбор);
	
	ВключенныеВидыВзаимодействий = ВидыВзаимодействийЛентыПоОтбору(ПараметрыЛенты.Отбор); // Включают в себя направления.
	ВключенныеНаправленияЗвонков = НаправленияЗвонковПоОтбору(ПараметрыЛенты.Отбор);
	ВключенныеНаправленияЧатов = НаправленияЧатовПоОтбору(ПараметрыЛенты.Отбор);
	
	Прокрутить = ПараметрыЛенты.Прокрутить;
	ВывестиОбъектовИстории = ПараметрыЛенты.ОбъектовИстории;
	ВыведеноОбъектовИстории = 0;
	ВсегоОбъектовИстории = 0;
	
	ПараметрыЗапросаЛенты = Новый Структура;
	ПараметрыЗапросаЛенты.Вставить("Режим",					ПараметрыЛенты.Режим);
	ПараметрыЗапросаЛенты.Вставить("ВключенаИстория",		ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "История"));
	ПараметрыЗапросаЛенты.Вставить("ВключеныПримечания",	ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "Примечания"));
	ПараметрыЗапросаЛенты.Вставить("ВключеныФайлы",			ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "Файлы"));
	ПараметрыЗапросаЛенты.Вставить("ВключеноИзменениеСостояния",	ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "ИзменениеСостояния"));
	ПараметрыЗапросаЛенты.Вставить("ВключеноИзменениеОтветственного",	ВключенаНастройкаОтбораЛенты(ПараметрыЛенты.Отбор, "ИзменениеОтветственного"));
	ПараметрыЗапросаЛенты.Вставить("ОбъектовИстории",		ПараметрыЛенты.ОбъектовИстории);
	
	Запрос = Новый Запрос;
	Запрос.Текст = CRM_ЛентаСобытийПовтИсп.ТекстЗапросаДанныхЛенты(ПараметрыЗапросаЛенты);
	
	Запрос.Параметры.Вставить("ТекущаяДата",				ТекущаяДатаСеанса());
	Запрос.Параметры.Вставить("Объект",						ПараметрыЛенты.Объект);
	Запрос.Параметры.Вставить("ВключенныеТипыОбъектов",		ВключенныеТипыОбъектов);
	Запрос.Параметры.Вставить("ПрочиеТипыОбъектов",			ПрочиеТипыОбъектов);
	Запрос.Параметры.Вставить("ПустыеЗначенияКонтактов",	CRM_ЛентаСобытийПовтИсп.ПустыеЗначенияКонтактовВзаимодействий());
	Запрос.Параметры.Вставить("ТипИнтерес",					Тип("ДокументСсылка.CRM_Интерес"));
	Запрос.Параметры.Вставить("ВключенныеТипыОбращений",	ВключенныеТипыОбращений);
	Запрос.Параметры.Вставить("ВключенныеВидыВзаимодействий",	ВключенныеВидыВзаимодействий);
	Запрос.Параметры.Вставить("ВключенныеНаправленияЗвонков",	ВключенныеНаправленияЗвонков);
	Запрос.Параметры.Вставить("ВключенныеНаправленияЧатов",	ВключенныеНаправленияЧатов);
	#Вставка
	//++ #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.
	// Формируем МассивПредметов для отбора заметок. 
	// Предметами могут быть партнеры и документы CRM_Интерес
	МассивПредметов = Новый Массив;
	Если Запрос.Параметры.Свойство("Объект") Тогда
		
		ТекущийОбъект = Запрос.Параметры.Объект;
		Если ТипЗнч(ТекущийОбъект) = Тип("СправочникСсылка.Партнеры") 
			 Или ТипЗнч(ТекущийОбъект) = Тип("ДокументСсылка.CRM_Интерес") 
			Тогда
			
			МассивПредметов.Добавить(Запрос.Параметры.Объект);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПараметрыЛенты.Свойство("Партнер") Тогда
		МассивПредметов.Добавить(ПараметрыЛенты.Партнер);
	КонецЕсли;
	Запрос.Параметры.Вставить("МассивПредметов", МассивПредметов);
    //-- #1443 смарт: Ермаков 26.09.2023 // Добработать Интерес, чтобы было видно заметки по клиенту и возможность создать заметку по клиенту.

	//-- #1443 смарт: Фролов 18.09.2023
	#КонецВставки
	
	#Вставка 
	//++ #1865 смарт: Фролов 17.06.2024 //Вывод в интересе информации о звонке по номеру указанному в данных из обращения (если нет партнера)
	Если ПараметрыЛенты.Режим = "ЛентаИнтереса" Тогда
		
		ТелефонАбонента = "ХХХХХХХХХХ";
		
		Если НЕ ПараметрыЛенты.Свойство("Партнер") Тогда

			Если Запрос.Параметры.Свойство("Объект") Тогда
				
				ТекущийОбъект = Запрос.Параметры.Объект;
				
				Если ТипЗнч(ТекущийОбъект) = Тип("ДокументСсылка.CRM_Интерес") Тогда
					
					ДокументОснование = ТекущийОбъект.ДокументОснование;
					
					Если ЗначениеЗаполнено(ДокументОснование) 
						И (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.CRM_Заявка")
						ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.смартЛид")) Тогда
						
						Если НЕ ДокументОснование.Телефон = "" Тогда
							
							ТелефонАбонента = смартОбщегоНазначения.ТолькоЦифры(ДокументОснование.Телефон);
							
						КонецЕсли;	
						
					КонецЕсли;	
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;	
		
		Запрос.Параметры.Вставить("ТелефонАбонента", ТелефонАбонента);
		
		//++ #Б-3738 смарт: Фролов 08.07.2025 //Вывод событий в ленте Интереса, только по этому Интересу.
		ДатаИнтереса = ПараметрыЛенты.Объект.Дата;
		ОтветственныйИнтереса = ПараметрыЛенты.Объект.Ответственный;
		НуженОтборПоОтветственному = НЕ ПараметрыЛенты.Отбор.НайтиПоЗначению("смартПоВсемОтветственным").Пометка;
		//-- #Б-3738 смарт: Фролов 08.07.2025
		
	КонецЕсли;
	//-- #1865 смарт: Фролов 17.06.2024	
	#КонецВставки
	
	Если ПараметрыЛенты.Режим = "ЛентаКлиента" Тогда
		
		ЗапросКонтакты = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контакты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК Контакты
		|ГДЕ
		|	Контакты.Владелец = &Объект");
		ЗапросКонтакты.Параметры.Вставить("Объект", ПараметрыЛенты.Объект);
		ДоступныеКонтакты = ЗапросКонтакты.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		ДоступныеКонтакты.Добавить(Справочники.КонтактныеЛицаПартнеров.ПустаяСсылка());
		Запрос.Параметры.Вставить("ДоступныеКонтакты", ДоступныеКонтакты);
		
	КонецЕсли;
	
	// Получение данных.
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	РезультатЗапросаКоличество = РезультатЗапроса[9];
	Если Не РезультатЗапросаКоличество.Пустой() Тогда
		ВыборкаКоличество = РезультатЗапросаКоличество.Выбрать();
		ВыборкаКоличество.Следующий();
		ВсегоОбъектовИстории = ВыборкаКоличество.Количество;
	КонецЕсли;
	#Удаление //++ #Б-4092 смарт: Фролов 19.08.2025 //После рефакторинга загрузки звонков в 1С, некоторые звонки в ленте дублируются
	РезультатЗапросаОбъекты = РезультатЗапроса[10];
	#КонецУдаления
	#Вставка
	//++ #Б-4092 смарт: Фролов 19.08.2025 //После рефакторинга загрузки звонков в 1С, некоторые звонки в ленте дублируются
	РезультатЗапросаОбъекты = РезультатЗапроса[11];
	//-- #Б-4092 смарт: Фролов 19.08.2025
	#КонецВставки
	Если РезультатЗапросаОбъекты.Пустой() Тогда
		Возврат CRM_ЛентаСобытийПовтИсп.ТекстЗаглушкиЛенты();
	КонецЕсли;
	
	ШаблонЛенты = CRM_ЛентаСобытийПовтИсп.ТекстШаблонаЛенты();
	ШаблонЛенты = СтрЗаменить(ШаблонЛенты, "FILES_SPRITE_URL", ПараметрыЛенты.АдресКартинокФайлов);
	ШаблонЛенты = СтрЗаменить(ШаблонЛенты, "SPRITE_URL", ПараметрыЛенты.АдресКартинок);
	
	ЧтениеHTML = Новый ЧтениеHTML;
	
	ЧтениеHTML.УстановитьСтроку(ШаблонЛенты);
	ПостроительDOM = Новый ПостроительDOM;
	ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
	
	// Параметры вывода объектов.
	СекундВСутках = 86400;
	ДатаСегодня = НачалоДня(ТекущаяДатаСеанса());
	ДатаВчера = ДатаСегодня - СекундВСутках;
	ДатаЗавтра = ДатаСегодня + СекундВСутках;
	ТекущийГод = Год(ДатаСегодня);
	
	ДатаБезВремениПредыдущая = Дата("00010101");
	ПредставлениеДня = "";
	
	ТипОбъектаПредыдущий = "";
	БлокОбъектПредыдущий = Неопределено;
	РазделПредыдущий = 0;
	
	СчетчикГруппировки = 0;
	ВыведенЗаголовокЗапланировано = Ложь;
	
	БлокОбложкаЛенты = ДокументHTML.ПолучитьЭлементПоИдентификатору("wrapper");
	БлокРодительОбъекта = БлокОбложкаЛенты;
	НадписьПоказать = Неопределено;
	НадписьСкрыть = Неопределено;
	
	// Вывод сделан так исходя из необходимости вывести ленту за один обход выборки без итогов и группировок.
	ВыборкаОбъекты = РезультатЗапросаОбъекты.Выбрать();
	Пока ВыборкаОбъекты.Следующий() Цикл
		
		#Вставка
		//++ #Б-3738 смарт: Фролов 08.07.2025 //Вывод событий в ленте Интереса, только по этому Интересу.
		Если ПараметрыЛенты.Режим = "ЛентаИнтереса" Тогда
			
			//++ #Б-3830 смарт: Фролов 16.07.2025 //Ошибка. При планировании взаимодействия на основании Интереса не выводится в ленте.
			//Если ВыборкаОбъекты.Дата < ДатаИнтереса Тогда
			Если ВыборкаОбъекты.Дата < НачалоДня(ДатаИнтереса) Тогда
			//-- #Б-3830 смарт: Фролов 16.07.2025
				Продолжить;
			КонецЕсли;
			
			Если НуженОтборПоОтветственному Тогда
					
				Если НЕ (ТипЗнч(ВыборкаОбъекты.Ссылка) = Тип("ДокументСсылка.ЗаказКлиента")
					ИЛИ ТипЗнч(ВыборкаОбъекты.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
					ИЛИ ТипЗнч(ВыборкаОбъекты.Ссылка) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств")) Тогда
					
					Если НЕ ОтветственныйИнтереса = ВыборкаОбъекты.Отправитель
						И НЕ ОтветственныйИнтереса = ВыборкаОбъекты.Получатель Тогда
						Продолжить;	
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		//-- #Б-3738 смарт: Фролов 08.07.2025
		#КонецВставки
		
		ДатаБезВремени = ВыборкаОбъекты.ДатаБезВремени;
		ТипОбъекта = ВыборкаОбъекты.Тип;
		Раздел = ВыборкаОбъекты.Раздел;
		
		ДобавитьКнопкуРаскрыть = Ложь;
		
		// Вывод заголовка с датой или надписью "Запланировано".
		Если Раздел = 0 И Не ВыведенЗаголовокЗапланировано Тогда
			БлокЗаголовокОбложка = ДокументHTML.СоздатьЭлемент("div");
			БлокЗаголовокОбложка.УстановитьАтрибут("class", "interest__title-block");
			БлокОбложкаЛенты.ДобавитьДочерний(БлокЗаголовокОбложка);
			БлокЗапланировано = ДокументHTML.СоздатьЭлемент("div");
			БлокЗапланировано.УстановитьАтрибут("class", "interest__title interest__title--green");
			БлокЗапланировано.ТекстовоеСодержимое = НСтр("ru='Запланировано';en='Planned'");
			БлокЗаголовокОбложка.ДобавитьДочерний(БлокЗапланировано);
			ВыведенЗаголовокЗапланировано = Истина;
		КонецЕсли;
		
		Если ДатаБезВремени <> ДатаБезВремениПредыдущая Или Раздел <> РазделПредыдущий Тогда
			
			Если ВыборкаОбъекты.ДатаБезВремени = ДатаСегодня Тогда
				ПредставлениеДня = НСтр("ru='Сегодня';en='Today'");
			ИначеЕсли ВыборкаОбъекты.ДатаБезВремени = ДатаВчера Тогда
				ПредставлениеДня = НСтр("ru='Вчера';en='Yesterday'");
			ИначеЕсли ВыборкаОбъекты.ДатаБезВремени = ДатаЗавтра Тогда
				ПредставлениеДня = НСтр("ru='Завтра';en='Tomorrow'");
			Иначе
				Если ВыборкаОбъекты.Год = ТекущийГод Тогда
					ПредставлениеДня = ТРег(Формат(ДатаБезВремени, "ДФ='d MMMM'"));
				Иначе
					ПредставлениеДня = ТРег(Формат(ДатаБезВремени, "ДФ='d MMMM yyyy'"));
				КонецЕсли;
			КонецЕсли;
			
			Если ВыборкаОбъекты.Раздел = 1 Тогда
				БлокЗаголовокОбложка = ДокументHTML.СоздатьЭлемент("div");
				БлокЗаголовокОбложка.УстановитьАтрибут("class", "interest__title-block");
				БлокОбложкаЛенты.ДобавитьДочерний(БлокЗаголовокОбложка);
				БлокПериод = ДокументHTML.СоздатьЭлемент("div");
				Если ВыборкаОбъекты.ДатаБезВремени = ДатаСегодня Тогда
					БлокПериод.УстановитьАтрибут("class", "interest__title interest__title--blue");
				Иначе
					БлокПериод.УстановитьАтрибут("class", "interest__title interest__title--grey");
				КонецЕсли;
				БлокПериод.ТекстовоеСодержимое = ПредставлениеДня;
				БлокЗаголовокОбложка.ДобавитьДочерний(БлокПериод);
			КонецЕсли;
			
		КонецЕсли;
		
		// Добавление якоря для прокрутки документа при выводе.
		Если Прокрутить И ВыведеноОбъектовИстории = ВывестиОбъектовИстории - 50 Тогда
			ЭлементЯкорь = ДокументHTML.СоздатьЭлемент("a");
			ЭлементЯкорь.УстановитьАтрибут("id", "scrollmore");
			БлокОбложкаЛенты.ДобавитьДочерний(ЭлементЯкорь);
			ДокументHTML.Тело.УстановитьАтрибут("onload", "scrollToElement()");
		КонецЕсли;
		
		// Получение данных для заполнения объекта ленты.
		ДанныеОбъекта = СтруктураОбъектаЛенты();
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта, ВыборкаОбъекты);
		ПредставлениеВремени = Формат(ДанныеОбъекта.Дата, "ДФ=HH:mm");
		Если ТипОбъекта = "ЗадачаПланов" Тогда
			ДанныеОбъекта.ПредставлениеДаты = ПредставлениеДня + НСтр("ru=' до ';en=' to '") + ПредставлениеВремени;
		ИначеЕсли ТипОбъекта = "ВзаимодействиеПланов" Тогда
			ДанныеОбъекта.ПредставлениеДаты = ПредставлениеДня + " " + ПредставлениеВремени;
		ИначеЕсли ТипОбъекта = "ЗадачаИстории" Тогда
			ДанныеОбъекта.ПредставлениеДаты = НСтр("ru='Завершена ';en='Done'") + ПредставлениеВремени;
		Иначе
			ДанныеОбъекта.ПредставлениеДаты = ПредставлениеВремени;
		КонецЕсли;
		
