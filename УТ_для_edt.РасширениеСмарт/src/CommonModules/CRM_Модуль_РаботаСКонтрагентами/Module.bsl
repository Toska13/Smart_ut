
&ИзменениеИКонтроль("СоздатьКонтрагентаПриСозданииПартнера")
Процедура смарт_СоздатьКонтрагентаПриСозданииПартнера(Форма, Партнер)

	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Контрагент_Объект") Тогда

		#Вставка
		//++ #1398 смарт: Фролов 24.08.2023 //Доработать карточку интереса (исправить логику)  
		Если НЕ ЗначениеЗаполнено(Форма.Клиент_ИНН) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен ИНН, контрагент не будет создан!");
			Возврат;
		КонецЕсли;
		//-- #1398 смарт: Фролов 24.08.2023
		#КонецВставки
	
		ОбъектКонтрагент						= Форма.РеквизитФормыВЗначение("Контрагент_Объект");
		ОбъектКонтрагент.Партнер				= Партнер.Ссылка;
		ОбъектКонтрагент.Наименование			= Партнер.Наименование;
		ОбъектКонтрагент.НаименованиеПолное		= Партнер.НаименованиеПолное;

		ОбъектКонтрагент["ИНН"] = Форма.Клиент_ИНН;
		ОбъектКонтрагент["КПП"] = Форма.Клиент_КПП;

		Для Каждого Стр Из Партнер.КонтактнаяИнформация Цикл
			Если Стр.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
				УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ОбъектКонтрагент, Стр.Значение, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента, Перечисления.ТипыКонтактнойИнформации.Адрес);
				УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ОбъектКонтрагент, Стр.Значение, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента, Перечисления.ТипыКонтактнойИнформации.Адрес);
			КонецЕсли;
		КонецЦикла;

		Попытка
			ОбъектКонтрагент.Записать();
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;


КонецПроцедуры

#Область ДоработкиСмарт

//++ #Б-1216 смарт: Фролов 05.11.2024 //Регистрация в ИМ. Лид-Интерес. Выбор контактного лица.
Функция смартНайтиКонтрагентаПоИННиКПП(СтруктураПоиска) Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	1 КАК Вариант
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка,
	|	2
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	Вариант");
	Запрос.УстановитьПараметр("ИНН", СтруктураПоиска.ИНН);
	Запрос.УстановитьПараметр("КПП", СтруктураПоиска.КПП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	Иначе
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции //-- #Б-1216 смарт: Фролов 05.11.2024	

#КонецОбласти