Функция СформироватьСписокСерийныхНомеров(ПараматрыВходящие)
	СтруктураОтвет = Новый Структура("ДанныеОтвета,Отработало,ТекстОшибки,КодОтвета","",Ложь,"",400);	
	ТекстОшибки="";
	ТекстУспех="";
	
	КонтрагентИНН=ПараматрыВходящие.ПараметрыЗапроса.Получить("num");

	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	КлючиАналитикиУчетаПоПартнерам.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ АналитикаКонтрагент
	|ИЗ
	|	Справочник.КлючиАналитикиУчетаПоПартнерам КАК КлючиАналитикиУчетаПоПартнерам
	|ГДЕ
	|	КлючиАналитикиУчетаПоПартнерам.Контрагент.ИНН = &ИНН
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ НоменкатураСерия
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ВидНоменклатуры = &ВидНоменклатуры
	|;
	
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура КАК АналитикаУчетаНоменклатурыНоменклатура,
	|	ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Серия.Наименование КАК АналитикаУчетаНоменклатурыСерия,
	|	АналитикаКонтрагент.Ссылка КАК Ссылка
	|ИЗ
	|	АналитикаКонтрагент КАК АналитикаКонтрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ НоменкатураСерия КАК НоменкатураСерия
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(, , Регистратор, ) КАК ВыручкаИСебестоимостьПродажОбороты
	|			ПО (ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры.Номенклатура В (НоменкатураСерия.Ссылка))
	|		ПО (ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам В (АналитикаКонтрагент.Ссылка))
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(ВыручкаИСебестоимостьПродажОбороты.Регистратор) = ТИП(Документ.РеализацияТоваровУслуг)";
	
	Запрос.УстановитьПараметр("ИНН",КонтрагентИНН);
	Запрос.УстановитьПараметр("ВидНоменклатуры",Справочники.смартПредопределенныеЗначения.ВидНоменклатурыТоварПлоттерыСерии.Значение);
	
	РезультатЗапроса=Запрос.Выполнить();
	//Возврат СтруктураОтвет;
	
	МассивРезультата=Новый Массив;
	
	Выборка=РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивРезультата.Добавить(Выборка.АналитикаУчетаНоменклатурыСерия);
	КонецЦикла;
		//
	Если МассивРезультата.Количество() тогда
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,200,"",Истина,ДанныеВСтрокуJSON(МассивРезультата));
		Возврат СтруктураОтвет; 
	иначе
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,405,"Пустой массив серийных номеров!",Ложь,"");
		Возврат СтруктураОтвет; 
	КонецЕсли;
	
КонецФункции // СоздатьДокументПеремещения()

#Область ПрочиеПроцедурыФункции

Функция ДанныеВСтрокуJSON(Данные)
	Запись=Новый ЗаписьJSON;
	//Запись.УстановитьСтроку();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись,Данные);
	Возврат Запись.Закрыть();
КонецФункции	

Функция СтрокуJSONВДанные(Стр)
	Чтение=Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Стр);
	Данные=ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции	

#КонецОбласти

//Заполняем структуру ответа
Процедура ЗаполнитьСтруктуруОтвета(СтруктураОтвет,КодОтвета,ТекстОшибки,Отработало,ДанныеОтвета)
	СтруктураОтвет.КодОтвета 	= КодОтвета;
	СтруктураОтвет.ТекстОшибки	= ТекстОшибки;
	СтруктураОтвет.Отработало	= Отработало;
	СтруктураОтвет.ДанныеОтвета = ДанныеОтвета;	
КонецПроцедуры
