#Область ПеренесеноСДоработкамиСмарт

&ИзменениеИКонтроль("ВидПродукцииРодительный")
Функция смарт_ВидПродукцииРодительный(ВидПродукции)
	Если ВидПродукции = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияПодконтрольнаяВЕТИС Тогда
		Возврат НСтр("ru = 'молока и молочной продукции (ВетИС)'");
	ИначеЕсли ВидПродукции = Перечисления.ВидыПродукцииИС.МолочнаяПродукцияБезВЕТИС Тогда
		Возврат НСтр("ru = 'молока и молочной продукции (неподконтрольной ВетИС)'");
	КонецЕсли;
	
	#Вставка
	//++ #Б5764 смарт: Шляпников 24.02.2026 / Маркировка. Ошибка 1С УТ. при формировании документа Перемещение товаров
	Массив = ПолучитьСклоненияСтроки(ВидПродукции, "Л=ru_RU", "ПД=Родительный");
	
	Если Массив =  Неопределено ИЛИ Массив.Количество() = 0 Тогда
		Возврат СокрЛП(ВидПродукции);
	Иначе
		Возврат Массив[0];
	КонецЕсли;
	//-- #Б5764 смарт: Шляпников 24.02.2026
	#КонецВставки
	
	Возврат НРег(ПолучитьСклоненияСтроки(ВидПродукции, "Л=ru_RU", "ПД=Родительный")[0]);
КонецФункции

