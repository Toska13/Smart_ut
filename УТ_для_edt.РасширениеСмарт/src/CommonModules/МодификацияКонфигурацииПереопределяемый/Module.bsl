			Для Каждого ЭлементМассива Из МассивЗаказовИсключений Цикл
				Форма.Заказы.Удалить(ЭлементМассива);
			КонецЦикла;                              
			
			Форма.ЗначениеВРеквизитФормы(ДокументыСПризнаками, "ДокументыСПризнаками");
			
