Функция смартИмеетПравоБлокироватьДокументы(Пользователь)
//смарт Вахов Владимир /426 / 18.06.2021   
	ДопСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("ИмеетПравоБлокироватьДокументы");
	ИмеетПравоБлокироватьДокументы = УправлениеСвойствами.ЗначениеСвойства(Пользователь,ДопСвойство);
	
	Возврат ?(ИмеетПравоБлокироватьДокументы = Неопределено, Ложь, ИмеетПравоБлокироватьДокументы);
	
КонецФункции	

//++ смарт:ММ #030 210 05.03.2020 - добавление Причины возврата товаров
Функция ПолучитьМассивПричинВозврата()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	смартПредопределенныеЗначенияЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.смартПредопределенныеЗначения.Значения КАК смартПредопределенныеЗначенияЗначения
	|ГДЕ
	|	смартПредопределенныеЗначенияЗначения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение";
	
	Запрос.УстановитьПараметр("Ссылка", Справочники.смартПредопределенныеЗначения.ПричиныВозвратаТовара);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	
КонецФункции //-- смарт:ММ 05.03.2020

