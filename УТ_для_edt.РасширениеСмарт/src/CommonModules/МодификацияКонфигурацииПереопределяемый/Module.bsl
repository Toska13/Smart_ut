		НоваяКоманда.Действие = "смартЗаполнитьСтатусыУказанияСерий";
		
		Если Форма.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" 
			ИЛИ Форма.ИмяФормы = "Документ.ПеремещениеТоваров.Форма.ФормаДокумента" Тогда 

			ГруппаРодитель = Форма.Элементы.ТоварыГруппаЗаполнить;
			
		ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" 
			ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаСборку.Форма.ФормаДокумента" Тогда 
			
			ГруппаРодитель = Форма.Элементы.ГруппаЗаполнить;

