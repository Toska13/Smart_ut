						НовыйЭлемент = Форма.Элементы.Добавить(ЭлементМассива.Имя, Тип("ТаблицаФормы"), РодительскийЭлемент);
						НовыйЭлемент.ПутьКДанным = ЭлементМассива.Имя;
						НовыйЭлемент.Доступность = Истина;
						НовыйЭлемент.ТолькоПросмотр = Истина;
						НовыйЭлемент.Отображение = ОтображениеТаблицы.Список;
						НовыйЭлемент.ЧередованиеЦветовСтрок = Истина;
						НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
						НовыйЭлемент.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
						
					Иначе
						
						// Отрисовка колонок формы
						НовыйЭлемент = Форма.Элементы.Добавить(ЭлементМассива.Имя, Тип("ПолеФормы"), Форма.Элементы.ДокументыСПризнаками);
						НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;	
						НовыйЭлемент.ПутьКДанным = Форма.Элементы.ДокументыСПризнаками.Имя + "." + ЭлементМассива.Имя;							
						
					КонецЕсли;
					
				// Обработка иных элементов формы	
