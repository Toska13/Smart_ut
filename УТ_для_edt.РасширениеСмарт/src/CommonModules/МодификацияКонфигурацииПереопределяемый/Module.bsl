	//-- #Б4754 смарт: Шляпников 28.10.2025
	
	//++ #6212 смарт: Тимофеева 25.03.2026 / Перевод запчастей на серийный учет. Изменение логики формирования Приходного ордера.
	Если Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда
		Если ТипЗнч(Форма.Объект.Распоряжение) = Тип("ДокументСсылка.ЗаказНаПеремещение")
			И смартСервер.ЭтоСкладФизическогоЛица(Форма.Объект.Отправитель)
			И НЕ смартСервер.ЭтоСкладФизическогоЛица(Форма.Объект.Склад) Тогда
			
			смартФормированиеИнтерфейса.СоздатьКоманду(Форма, "смартЗаполнитьПоРаспоряжению", "Заполнить по распоряжению", "смартЗаполнитьПоРаспоряжению");
			смартФормированиеИнтерфейса.СздКнопка(Форма, "смартЗаполнитьПоРаспоряжению", "ЗаполнитьПоРаспоряжению",, "смартЗаполнитьПоРаспоряжению", 1, Новый Структура);
		
		КонецЕсли;
	КонецЕсли;
	//-- #6212 смарт: Тимофеева 25.03.2026

КонецПроцедуры

&После("ПередЗаписьюНаСервере")
Процедура смарт_ПередЗаписьюНаСервере(Форма, Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	//++ смарт:ММ #030 210 05.03.2020 - добавление Причины возврата товаров
	Если Форма.ИмяФормы = "Документ.ЗаявкаНаВозвратТоваровОтКлиента.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.ВозвратТоваровОтКлиента.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.КорректировкаРеализации.Форма.ФормаДокумента" Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекущийОбъект.смартПричинаВозврата) 
			И ТекущийОбъект.Дата > Дата(2020, 03, 01) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Необходимо заполнить причину возврата", ТекущийОбъект.Ссылка, "смартПричинаВозврата", "Объект", Отказ);
		КонецЕсли;

	КонецЕсли;
	//-- смарт:ММ 05.03.2020

	//++#1316 смарт: Лопато 06.10.2023 //Запретить использование в документах подразделения другой организации  
	Если НЕ ТекущийОбъект.ОбменДанными.Загрузка 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект") 
		И Форма.Объект.Свойство("Ссылка") Тогда
	
		ОбъектМетаданных = Форма.Объект.Ссылка.Метаданные();
		
		Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда

			Если ОбъектМетаданных.Реквизиты.Найти("Организация") <> Неопределено 
				И ОбъектМетаданных.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
				
				ПодразделениеОбязательно = Ложь;
				
				Если ОбъектМетаданных.Имя = "ЗаказКлиента" 
					ИЛИ ОбъектМетаданных.Имя = "РеализацияТоваровУслуг" Тогда
					
					ПодразделениеОбязательно = Истина;
					
				КонецЕсли;	
				
				смартОбщегоНазначения.смартПроверитьОрганизациюПодразделения(Отказ, ТекущийОбъект.Подразделение, ТекущийОбъект.Организация, ПодразделениеОбязательно);
				
			КонецЕсли;

			Для Каждого ОбъектМетаданныхТабЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл

				Если ОбъектМетаданныхТабЧасть.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
					
                    РеквизитОрганизация = "";
					РеквизитОрганизацияВШапке = Ложь;
					ЗначениеРеквизитаОрганизация = Неопределено;
					
					Если ОбъектМетаданныхТабЧасть.Имя = "РасшифровкаПлатежа" И ОбъектМетаданныхТабЧасть.Реквизиты.Найти("АналитикаДоходов") <> Неопределено Тогда
						РеквизитОрганизация = "АналитикаДоходов";
					ИначеЕсли ОбъектМетаданныхТабЧасть.Имя = "РасшифровкаПлатежа" И ОбъектМетаданныхТабЧасть.Реквизиты.Найти("АналитикаРасходов") <> Неопределено Тогда
						РеквизитОрганизация = "АналитикаРасходов";
					ИначеЕсли ОбъектМетаданныхТабЧасть.Имя = "РасшифровкаПлатежа" И ОбъектМетаданных.Реквизиты.Найти("Организация") <> Неопределено Тогда	
						РеквизитОрганизация = "Организация";
						РеквизитОрганизацияВШапке = Истина;
					ИначеЕсли ОбъектМетаданныхТабЧасть.Реквизиты.Найти("Организация") <> Неопределено Тогда	
						РеквизитОрганизация = "Организация";
					Иначе
						Продолжить;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(РеквизитОрганизация) Тогда

						Для Каждого СтрокаТабЧастиОбъекта Из ТекущийОбъект[ОбъектМетаданныхТабЧасть.Имя] Цикл
						
							Если РеквизитОрганизацияВШапке Тогда
								ЗначениеРеквизитаОрганизация = ТекущийОбъект[РеквизитОрганизация];
							Иначе
								Если ТипЗнч(СтрокаТабЧастиОбъекта[РеквизитОрганизация]) = Тип("СправочникСсылка.Организации") Тогда
									ЗначениеРеквизитаОрганизация = СтрокаТабЧастиОбъекта[РеквизитОрганизация];
								Иначе
									Продолжить;
								КонецЕсли;	
							КонецЕсли;
						
							смартОбщегоНазначения.смартПроверитьОрганизациюПодразделения(Отказ, СтрокаТабЧастиОбъекта.Подразделение, ЗначениеРеквизитаОрганизация);
						
						КонецЦикла;	
					
					КонецЕсли;	

				КонецЕсли;
					
			КонецЦикла;
			
		КонецЕсли;

	КонецЕсли;
	//--#1316 смарт: Лопато 06.10.2023

	//++#1530 смарт: Лопато 27.10.2023 //Отмена напоминания при повторной записи Заявка на расходование ДС  
	Если Форма.ИмяФормы = "Документ.ЗаявкаНаРасходованиеДенежныхСредств.Форма.ФормаДокумента"
		И НЕ Отказ 
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ЗначениеЗаполнено(ТекущийОбъект.Ссылка)
		И ТекущийОбъект.Статус = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.Отклонена
		И ТекущийОбъект.КтоЗаявил <> Пользователи.АвторизованныйПользователь()
		И ТекущийОбъект.смартОшибкиВРеквизитах.Количество() > 0
		Тогда
		
		ПредыдущийСтатус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Ссылка, "Статус");
		
		Если ТекущийОбъект.Статус <> ПредыдущийСтатус Тогда
			смартОбработкаПодписокНаСобытия.смартЗаявкаНаРасходованиеДСНапоминанияПриЗаписи(ТекущийОбъект);
		КонецЕсли;	
			
	КонецЕсли;
	//--#1530 смарт: Лопато 27.10.2023
	
	//++#1905 смарт: Лопато 09.07.2024 //Намотка. Ошибка преобразования строки к числу  
	Если Форма.ИмяФормы = "Справочник.ХарактеристикиНоменклатуры.Форма.ФормаЭлемента" Тогда
		
		Если ТипЗнч(ТекущийОбъект.Владелец) = Тип("СправочникСсылка.ВидыНоменклатуры") Тогда
			ВидНоменклатуры = ТекущийОбъект.Владелец;
		Иначе
			ВидНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийОбъект.Владелец, "ВидНоменклатуры");
		КонецЕсли;
		
		ВидНоменклатурыТоварРулоныХарактеристики = 
			смартОбщегоНазначения.ПолучитьСмартПредопределенноеЗначение("ВидНоменклатурыТоварРулоныХарактеристики", Ложь);
		
		Если НЕ ЗначениеЗаполнено(ВидНоменклатурыТоварРулоныХарактеристики) Тогда
			
			ВидНоменклатурыТоварРулоныХарактеристики = 
				Справочники.ВидыНоменклатуры.НайтиПоНаименованию("ТоварРулоныХарактеристики", Истина);
				
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидНоменклатурыТоварРулоныХарактеристики)
			И ВидНоменклатуры = ВидНоменклатурыТоварРулоныХарактеристики Тогда 
			
			Попытка
				
				Намотка = Число(СокрЛП(ТекущийОбъект.Наименование));
				
			Исключение
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					НСтр("ru='Это характеристика номенклатуры с видом ""ТоварРулоныХарактеристики""." 
					+ Символы.ПС
					+ "Значение поля ""Рабочее наименование"" должно быть числом!'"), 
					, 
					"Наименование", 
					"Объект", 
					Отказ);
					
			КонецПопытки;	
				
		КонецЕсли;	

	КонецЕсли;	
	//--#1905 смарт: Лопато 09.07.2024
	
КонецПроцедуры

&После("ПослеЗаписиНаСервере")
Процедура смарт_ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи)
    
	//++ смарт: #1438 Корбутов 04.09.2023  добавление выбора основного ЭДО контрагента 
	Если Форма.ИмяФормы = "Справочник.Контрагенты.Форма.ФормаЭлемента" 
	Тогда
		Если Форма.Модифицированность
		Тогда
			//Запишем выбор пользователя
			ВыбЗнач = Форма.ОсновнойЭДО;
			смартОбщегоНазначения.ЗаписатьВыборОсновногоЭДО(ТекущийОбъект.Ссылка,ВыбЗнач);
		Иначе
		КонецЕсли;	
	Иначе
	КонецЕсли;
	//++ смарт: #1438 Корбутов 04.09.2023
	
	//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
	Если Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда  
		
		смартСервер.смартПеречитатьДанныеКонтейнеров(Форма.Объект);
		
	КонецЕсли;
	//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
	
	//++ #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
	//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
	Если Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ВозвратТоваровПоставщику.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ВнутреннееПотреблениеТоваров.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПеремещениеТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.РасходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда
	//-- #Б-1434 смарт: Лопато 22.11.2024
		
		смартОбщегоНазначения.НастроитьВидимостьЭлементовФормы(Форма);
		
	КонецЕсли;
	//-- #1480 смарт: Ермаков 04.10.2023 //Чистка старых данных для корректности работы отчета Контроль сдачи на склад снятых З/Ч  
	
	//++ смарт: 24.08.2026 / Заполнить по назначению (вывод из оборота)
	Если Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" Тогда
		
		НоваяКоманда = Форма.Команды.Добавить("смартЗаполнитьПоНазначению");
		НоваяКоманда.Заголовок = "Заполнить по назначению";
		НоваяКоманда.Действие = "смартЗаполнитьПоНазначению";
		
		НовыйЭлемент = Форма.Элементы.Добавить("смартЗаполнитьПоНазначению", Тип("КнопкаФормы"), Форма.Элементы.ГруппаЗаполнить);
		НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НовыйЭлемент.ИмяКоманды = "смартЗаполнитьПоНазначению";
		НовыйЭлемент.Заголовок = "Заполнить по назначению";
		
	ИначеЕсли Форма.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.ФормаДокумента" Тогда
		
		НоваяКоманда = Форма.Команды.Добавить("смартЗаполнитьПоНазначению");
		НоваяКоманда.Заголовок = "Заполнить по назначению";
		НоваяКоманда.Действие = "смартЗаполнитьПоНазначению";
		
		НовыйЭлемент = Форма.Элементы.Добавить("смартЗаполнитьПоНазначению", Тип("КнопкаФормы"), Форма.Элементы.ТоварыПодменюЗаполнить);
		НовыйЭлемент.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		НовыйЭлемент.ИмяКоманды = "смартЗаполнитьПоНазначению";
		НовыйЭлемент.Заголовок = "Заполнить по назначению";
		
	КонецЕсли;
	//-- смарт: 24.08.2026
	
КонецПроцедуры

