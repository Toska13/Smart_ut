
&После("ПриСозданииНаСервере")
Процедура смарт_ПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка)
	// Фролов+
	Если Не РольДоступна("ПолныеПрава") Тогда 
		Если Форма.ИмяФормы="Документ.ЗаказКлиента.Форма.ФормаДокумента" 
			Или Форма.ИмяФормы="Документ.ЗаказПоставщику.Форма.ФормаДокумента" 
			Или Форма.ИмяФормы="Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" 
			Или Форма.ИмяФормы="Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
			
			Форма.Элементы.Дата.ТолькоПросмотр=Истина;
			Форма.Элементы.Номер.ТолькоПросмотр=Истина;
			
			//++ смарт:ММ #029 209 05.03.2020 - доступность даты для изменения
			Если УправлениеДоступом.ЕстьРоль("смартИзменениеДатыДокументов") Тогда  
				Если Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента"
					ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента" 
					Тогда
					Форма.Элементы.Дата.ТолькоПросмотр = Ложь;
				КонецЕсли;
			КонецЕсли;
			//-- смарт:ММ 05.03.2020
			
		КонецЕсли;	
	КонецЕсли;
	// Фролов-
	
	//++ смарт:ММ #030 210 05.03.2020 - добавление Причины возврата товаров
	Если Форма.ИмяФормы = "Документ.ЗаявкаНаВозвратТоваровОтКлиента.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.ВозвратТоваровОтКлиента.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.КорректировкаРеализации.Форма.ФормаДокумента" Тогда
			
		Если Форма.ИмяФормы = "Документ.ЗаявкаНаВозвратТоваровОтКлиента.Форма.ФормаДокумента" Тогда
			
			ЭлементСмартПричинаВозврата = Форма.Элементы.Вставить("смартПричинаВозврата", Тип("ПолеФормы"), 
												Форма.Элементы.ГруппаДополнительно, Форма.Элементы.ДополнительнаяИнформация); 	
												
			//++ #Б2802 смарт: Шляпников 15.04.2025 / Изменение справочника "Претензия клиента"
			Форма.Элементы.ГруппаРеализации.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			
			НовыйЭлемент = Форма.Элементы.Добавить("смартПретензияКлиента", Тип("ПолеФормы"), Форма.Элементы.ГруппаРеализации);
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			НовыйЭлемент.ПутьКДанным = "Объект.смартПретензияКлиента";
			//-- #Б2802 смарт: Шляпников 15.04.2025
			
		ИначеЕсли Форма.ИмяФормы = "Документ.ВозвратТоваровОтКлиента.Форма.ФормаДокумента" Тогда
			
			ЭлементСмартПричинаВозврата = Форма.Элементы.Вставить("смартПричинаВозврата", Тип("ПолеФормы"), 
												Форма.Элементы.ГруппаДополнительно, Форма.Элементы.ГруппаПечать); 		
			
		ИначеЕсли Форма.ИмяФормы = "Документ.КорректировкаРеализации.Форма.ФормаДокумента" Тогда

			ЭлементСмартПричинаВозврата = Форма.Элементы.Добавить("смартПричинаВозврата", Тип("ПолеФормы"), 
												Форма.Элементы.ГруппаПараметрыПраво);
			
		КонецЕсли;	
		
		ЭлементСмартПричинаВозврата.Вид 						= ВидПоляФормы.ПолеВвода;
		ЭлементСмартПричинаВозврата.ПутьКДанным 				= "Объект.смартПричинаВозврата";
		ЭлементСмартПричинаВозврата.РежимВыбораИзСписка 		= Истина;
		ЭлементСмартПричинаВозврата.РедактированиеТекста 		= Ложь;
		ЭлементСмартПричинаВозврата.АвтоОтметкаНезаполненного 	= Истина;
		ЭлементСмартПричинаВозврата.КнопкаОчистки 				= Истина;
		
		ЭлементСмартПричинаВозврата.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивПричинВозврата());

	КонецЕсли;
	//-- смарт:ММ 05.03.2020
	
	// Смарт Фролов+ Доп. расходы внесены 
	Если Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаСписка" 
		Или Форма.ИмяФормы = "Обработка.ЖурналДокументовЗакупки.Форма.СписокДокументов" Тогда 
		ДобавитьЭлементыУправленияНаФормыСписковДокументов(Форма, Отказ, СтандартнаяОбработка);
	КонецЕсли;	
	// Фролов-
	
	//++ смарт:ММ #095 458 14.02.2021 На основании заказа на сборку создавать предзаказ поставщику
	Если Форма.ИмяФормы = "Документ.ЗаказНаСборку.Форма.ФормаДокумента" 
		Или Форма.ИмяФормы = "Документ.ЗаказНаСборку.Форма.ФормаСписка" Тогда 
		
		// Спрятать типовую кнопку из подменю Создать на основании
		ЭлементСоздатьНаОсновании = Форма.Элементы.Найти("ФормаДокументсмартПредзаказПоставщикуСоздатьНаОсновании");
		Если ЭлементСоздатьНаОсновании <> Неопределено Тогда
			ЭлементСоздатьНаОсновании.Видимость = Ложь;
		КонецЕсли;

	КонецЕсли;	
	//-- смарт:ММ 14.02.2021
	
	//смарт+ Вахов Владимир /426 / 18.06.2021   
	Если Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" Тогда
		
		Если  РольДоступна("ПолныеПрава") Или смартИмеетПравоБлокироватьДокументы(Пользователи.ТекущийПользователь()) Тогда
			
			ДобавляемыеРеквизиты = Новый Массив;
			
			ТипРеквизита = Новый ОписаниеТипов("Булево");
			
			РеквизитФормы = Новый РеквизитФормы(
				"БлокировкаДокумента",  //Имя реквизита формы
				ТипРеквизита,     //Тип
				"",               //Путь  (Пусто, "Объект", ИмяТЧ)
								  // например "Объект.Товары"	
				"Блокировка документа");//Заголовок
								  							 
			ДобавляемыеРеквизиты.Добавить(РеквизитФормы);
			
			Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
			ПолеВвода = Форма.Элементы.Добавить("БлокировкаДокумента", Тип("ПолеФормы"), Форма.Элементы.Организации);
			ПолеВвода.Вид = ВидПоляФормы.ПолеФлажка;
			ПолеВвода.ПутьКДанным = "БлокировкаДокумента";		
			ПолеВвода.УстановитьДействие("ПриИзменении", "смартБлокировкаДокументаПриИзменении");
			
		    ДопСвойствоБлокировка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Блокировка документа");
			ПризнакБлокировкиДокумента =  УправлениеСвойствами.ЗначениеСвойства(Форма.Объект.Ссылка, ДопСвойствоБлокировка);
			Форма.БлокировкаДокумента = ?(ПризнакБлокировкиДокумента = Неопределено, Ложь, ПризнакБлокировкиДокумента);
		
		КонецЕсли;  
		
		//++ #1670 смарт: Мосолов 14.03.2024 // Рефакторинг кода 1С. База УТ СМАРТ. Документы. ЗаказНаПеремещение 
		
		ОписаниеТипаЧисло = Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3,0));
		НовыйРеквизитПроцентОплаты = Новый РеквизитФормы("смартПроцентОплаты", ОписаниеТипаЧисло);
		НовыйРеквизитПроцентОтгрузки = Новый РеквизитФормы("смартПроцентОтгрузки", ОписаниеТипаЧисло);

		НовыеРеквизиты = Новый Массив;
		НовыеРеквизиты.Добавить(НовыйРеквизитПроцентОплаты);
		НовыеРеквизиты.Добавить(НовыйРеквизитПроцентОтгрузки);
		Форма.ИзменитьРеквизиты(НовыеРеквизиты);
		
		НоваяКоманда = Форма.Команды.Добавить("смартПродлитьРезерв");
		НоваяКоманда.Заголовок = "Продлить резерв";
		НоваяКоманда.Действие = "смарт_смартПродлитьРезервВместо";    
		
		НоваяГруппа = Форма.Элементы.Добавить("смартГруппаРезервов", Тип("ГруппаФормы"), Форма.Элементы.ГруппаСтатусЗакрыть);
		НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		НоваяГруппа.ОтображатьЗаголовок = Ложь;  
		
		НоваяДекорация = Форма.Элементы.Добавить("смартРезервДо", Тип("ДекорацияФормы"), НоваяГруппа); 
		НоваяДекорация.Вид = ВидДекорацииФормы.Надпись;
		НоваяДекорация.Заголовок = "";
		НоваяДекорация.ЦветТекста = ЦветаСтиля.ЦветТекстаЗаголовокОтчетаВТакси;
 		
		НовыйЭлемент = Форма.Элементы.Добавить("смартПродлитьРезерв", Тип("КнопкаФормы"), НоваяГруппа);
		НовыйЭлемент.Вид = ВидКнопкиФормы.Гиперссылка;
		НовыйЭлемент.ИмяКоманды = "смартПродлитьРезерв";
		НовыйЭлемент.Заголовок = "Продлить резерв";
		
		НовыйЭлемент = Форма.Элементы.Добавить("смартДатаПродленияРезервов", Тип("ПолеФормы"), НоваяГруппа);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.смартДатаПродленияРезервов";
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "смартДатаПродленияРезервовПриИзменении");
		
		//-- #1670 смарт: Мосолов 14.03.2024  
		
		//++ #Б1376 смарт: Шляпников 19.11.2024 / Раздельный учет товаров. Гарантийные запчасти. Разработка документов и регистров.
		НовыйЭлемент = Форма.Элементы.Добавить("смартЗапчастиГарантийные", Тип("ПолеФормы"), Форма.Элементы.ШапкаПраво);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.ПутьКДанным = "Объект.смартЗапчастиГарантийные";
		
		Если ЗначениеЗаполнено(Форма.Объект.ДокументОснование) И ТипЗнч(Форма.Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") И НЕ РольДоступна("ПолныеПрава") Тогда
			НовыйЭлемент.Видимость = Ложь;
		КонецЕсли;
		//-- #Б1376 смарт: Шляпников 19.11.2024
		
	КонецЕсли;	
	//смарт- Вахов Владимир /426 / 18.06.2021
	
	//++#1457 смарт: Ермаков 14.09.2023 // Добавил новую форму к обработке
	Если Форма.ИмяФормы = "Обработка.ПомощникЗакрытияЗаказов.Форма.ФормаЗакрытия" Тогда
		
		////////////////////////////////////////////////////////////////////////////////////////////////////
		// Обработка документов Заказы Клиентов (важно, т.к., форма работает и с другими видами заказов)
		Если Форма.Заказы.Количество() > 0 И ТипЗнч(Форма.Заказы[0].Значение) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
			
			//++#1457 смарт: Ермаков 14.09.2023 // Выполняет проверку возможности закрытия заказов с дополнительным информированием пользователя
			// Концепция:
			// - Менеджер оформляет заказ
			// - Бухгалтер (или иное лицо) берет заказ в работу, устанавливает в документе признак "Согласовать ФИН" и начинает готовить документы отгрузки
			// - Менеджер понимает, что если признак "Согласовать ФИН" установлен, значит заказ изменять нельзя (форма закрытия запрещает это делать).
			// - Когда отгрузка осуществится, и будут подписаны первичные документы, бухгалтер (или менеджер) устанавливают признак "Оригиналы документов подписаны".
			// - Если признаки "Согласовать ФИН" и "Оригиналы документов подписаны" положительные, а процент отгрузки по заказу больше 0, то форма разрешит закрыть такой заказ, даже если он отгружен частично.
			// - Форма разрешит закрыть заказ если по заказу нет движений и ни один из признаков не установлен.
			
			// Реквизиты и наполнение данными
			МассивРеквизитов = Новый Массив; 
			
			// Таблица фоормы и ее колонки
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнаками", Новый ОписаниеТипов("ТаблицаЗначений"), "", "Финансовые признаки документов"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамиЗаказ", Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"), "ДокументыСПризнаками", "Заказ"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамиСогласованоБух", Новый ОписаниеТипов("Булево"), "ДокументыСПризнаками", "Согл. ФИН"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамисмартДокументыПодписаны", Новый ОписаниеТипов("Булево"), "ДокументыСПризнаками", "Ориг. получ."));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамиПроцентОплаты", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3, 0)), "ДокументыСПризнаками", "% оплаты"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамиПроцентОтгрузки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(3, 0)), "ДокументыСПризнаками", "% отгрузки"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("ДокументыСПризнакамиЗакрытие", Новый ОписаниеТипов("Булево"), "ДокументыСПризнаками", "Закрытие"));
			
			// Реквизиты формы
			МассивРеквизитов.Добавить(Новый РеквизитФормы("СогласованоБух", Новый ОписаниеТипов("Булево"), "", "Согл. ФИН"));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("смартДокументыПодписаны", Новый ОписаниеТипов("Булево"), "", "Ориг. получ."));
			МассивРеквизитов.Добавить(Новый РеквизитФормы("Закрытие", Новый ОписаниеТипов("Булево"), "", "Закрытие заказа возможно"));
				
			Форма.ИзменитьРеквизиты(МассивРеквизитов);
			
			// Массив собирает заказы, которые следует исключить из стандартной обработки закрытия
			МассивЗаказовИсключений = Новый Массив;
			
			// Наполнение таблицы формы
			ДокументыСПризнаками = Форма.РеквизитФормыВЗначение("ДокументыСПризнаками"); 
			Для Каждого ЭлементСписка Из Форма.Заказы Цикл
				
				// Если заказ в статусе Закрыт, он исключается из обработки
				Если ЭлементСписка.Значение.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
					МассивЗаказовИсключений.Добавить(ЭлементСписка);
					Продолжить;
				КонецЕсли;
				
				НоваяСтрокаТаблицы = ДокументыСПризнаками.Добавить();
				НоваяСтрокаТаблицы.ДокументыСПризнакамиЗаказ = ЭлементСписка.Значение;
				НоваяСтрокаТаблицы.ДокументыСПризнакамиСогласованоБух = ЭлементСписка.Значение.СогласованоБух; 
				НоваяСтрокаТаблицы.ДокументыСПризнакамисмартДокументыПодписаны = ЭлементСписка.Значение.смартДокументыПодписаны; 
				
				СтруктураСостоянияРасчетов = Новый Структура();
				СтруктураСостоянияРасчетов.Вставить("Состояние", Перечисления.СостоянияЗаказовКлиентов.ПустаяСсылка());
				СтруктураСостоянияРасчетов.Вставить("СостояниеПросрочено", Ложь);
				СтруктураСостоянияРасчетов.Вставить("СуммаОплаты",		0);
				СтруктураСостоянияРасчетов.Вставить("СуммаОтгрузки",	0);
				СтруктураСостоянияРасчетов.Вставить("ПроцентОплаты", 	0);
				СтруктураСостоянияРасчетов.Вставить("ПроцентОтгрузки", 	0);
				СтруктураСостоянияРасчетов.Вставить("СуммаДолга", 		0);
				СтруктураСостоянияРасчетов.Вставить("ПроцентДолга", 	0);
				СтруктураСостоянияРасчетов.Вставить("СуммаКОплате", 	0);
				
				РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементСписка.Значение, "Договор, Валюта");
				Документы.ЗаказКлиента.РассчитатьСостояние(ЭлементСписка.Значение, РеквизитыЗаказа.Договор, СтруктураСостоянияРасчетов);
				
				НоваяСтрокаТаблицы.ДокументыСПризнакамиПроцентОплаты = СтруктураСостоянияРасчетов.ПроцентОплаты;
				НоваяСтрокаТаблицы.ДокументыСПризнакамиПроцентОтгрузки = СтруктураСостоянияРасчетов.ПроцентОтгрузки;
				
				// На форме документа ЗаказКлиента - это флаг "Согласовать ФИН"
				ДокументСогласованБухгалтерией = ЭлементСписка.Значение.СогласованоБух;
				// На форме документа ЗаказКлиента - это флаг "Оригиналы документов получены"
				ПервичныеДокументыПодписаны = ЭлементСписка.Значение.смартДокументыПодписаны;
				ТоварыОтгружены = СтруктураСостоянияРасчетов.ПроцентОтгрузки > 0;
				
				// Условия закрытия
				МожноЗакрыть = (ДокументСогласованБухгалтерией И ПервичныеДокументыПодписаны И ТоварыОтгружены)
								Или (Не ДокументСогласованБухгалтерией И Не ПервичныеДокументыПодписаны И Не ТоварыОтгружены);
					
				НоваяСтрокаТаблицы.ДокументыСПризнакамиЗакрытие = МожноЗакрыть;
				
				// Если заказ нельзя закрыть, добавляем его в массив исключений
				Если Не МожноЗакрыть Тогда
					МассивЗаказовИсключений.Добавить(ЭлементСписка);	
				КонецЕсли;
				
			КонецЦикла;
			
			// Определяет, что в выборке только один заказ. Требуется для условий отрисовки формы
			ОбработкаЕдиничногоЗаказа = Форма.Заказы.Количество() = 1;
			
