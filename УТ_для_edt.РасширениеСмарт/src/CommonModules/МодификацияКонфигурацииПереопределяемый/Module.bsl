//++ #5046 смарт: Тимофеева 27.11.2025 / Оператор ЭДО в карточке контрагента
Функция СформироватьТекстПодсказкиОператоровЭДО(Ссылка)	
	Результат = "";		
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) КАК КодОператора,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) = ""2BE""
		|			ТОГДА ""СБИС  (Тензор)""
		|		КОГДА ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) = ""2AE""
		|			ТОГДА ""1С ЭДО (Калуга Астрал)""
		|		КОГДА ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) = ""2BM""
		|			ТОГДА ""Диадок (Контур)""
		|		ИНАЧЕ ОператорыЭДО.Представление
		|	КОНЕЦ КАК Оператор
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|		ПО (ПОДСТРОКА(ВЫРАЗИТЬ(ДополнительныеСведения.Значение КАК СТРОКА(50)), 1, 3) = ОператорыЭДО.ИдентификаторОператора)
		|ГДЕ
		|	ДополнительныеСведения.Объект = &Контрагент
		|	И ДополнительныеСведения.Свойство.Имя = &ИмяСвойства"; 	
		Запрос.УстановитьПараметр("ИмяСвойства", "id_ЭДО");
		Запрос.УстановитьПараметр("Контрагент", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Оператор;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции  
