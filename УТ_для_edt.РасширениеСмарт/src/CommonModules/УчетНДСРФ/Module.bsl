#Область ПеренесеноСДоработками

&ИзменениеИКонтроль("ТекстВыбораПроцентаНДС")
Функция смарт_ТекстВыбораПроцентаНДС(ИсточникСтавкаНДС)

	Возврат СтрШаблон(
	"ВЫБОР %1
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|		ТОГДА 20
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20_120)
	|		ТОГДА 20
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|		ТОГДА 18
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118)
	|		ТОГДА 18
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|		ТОГДА 10
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10_110)
	|		ТОГДА 10
	#Вставка
	//++ #1744 смарт: Шляпников 19.12.2024 / УТ. Добавить ставки НДС 5% и 7%
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС5)
	|		ТОГДА 5
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС5_105)
	|		ТОГДА 5
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7)
	|		ТОГДА 7
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7_107)
	|		ТОГДА 7
	//-- #1744 смарт: Шляпников 19.12.2024
	//++ #4804 смарт: Тимофеева 12.11.2025 / Добавить ставку НДС22
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22)
	|		ТОГДА 22
	|	КОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22_122)
	|		ТОГДА 22
	//-- #4804 смарт: Тимофеева 12.11.2025
	#КонецВставки
	|	ИНАЧЕ 0
	|КОНЕЦ", ИсточникСтавкаНДС);


