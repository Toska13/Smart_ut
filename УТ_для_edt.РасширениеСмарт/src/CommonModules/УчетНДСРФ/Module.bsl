	|		КОГДА НДСПредъявленный.СуммаБезНДС = 0 И НДСПредъявленный.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС7_107)
	|			ТОГДА НДСПредъявленный.НДС * 100 / 7
	//-- #1744 смарт: Шляпников 19.12.2024 
	//++ #4804 смарт: Тимофеева 12.11.2025 / Добавить ставку НДС22
	|		КОГДА НДСПредъявленный.СуммаБезНДС = 0 И НДСПредъявленный.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС22_122)
	|			ТОГДА НДСПредъявленный.НДС * 100 / 22
