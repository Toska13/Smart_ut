Функция смартПолучитьДанныеБлижайшихВзаимодействий(Партнер, Ответственный, ВзаимодействиеСсылка, ДатаВзаимодействия)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	CRM_Взаимодействие.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА CRM_Взаимодействие.смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.ПустаяСсылка)
	|			ТОГДА CRM_Взаимодействие.ВидВзаимодействия
	|		ИНАЧЕ ВЫБОР
	|				КОГДА CRM_Взаимодействие.смартВидЗадачи.Акция
	|					ТОГДА ""АКЦИЯ""
	|				ИНАЧЕ CRM_Взаимодействие.ВидВзаимодействия
	|			КОНЕЦ
	|	КОНЕЦ КАК Акция,
	|	ВЫБОР
	|		КОГДА CRM_Взаимодействие.смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.ПустаяСсылка)
	|			ТОГДА CRM_Взаимодействие.Тема
	|		ИНАЧЕ ВЫБОР
	|				КОГДА CRM_Взаимодействие.смартВидЗадачи.Акция
	|					ТОГДА CRM_Взаимодействие.смартВидЗадачи.Наименование
	|				ИНАЧЕ CRM_Взаимодействие.Тема
	|			КОНЕЦ
	|	КОНЕЦ КАК Тема,
	|	ВЫБОР
	|		КОГДА CRM_Взаимодействие.смартВидЗадачи = ЗНАЧЕНИЕ(Справочник.смартВидыЗадач.ПустаяСсылка)
	|			ТОГДА ПОДСТРОКА(CRM_Взаимодействие.Содержание, 0, 250)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА CRM_Взаимодействие.смартВидЗадачи.Акция
	|					ТОГДА CRM_Взаимодействие.смартВидЗадачи.Наименование
	|				ИНАЧЕ ПОДСТРОКА(CRM_Взаимодействие.Содержание, 0, 250)
	|			КОНЕЦ
	|	КОНЕЦ КАК Содержание,
	|	РАЗНОСТЬДАТ(&ТекущаяДата, CRM_Взаимодействие.ПлановаяДата, ДЕНЬ) КАК Дней,
	|	CRM_Взаимодействие.ПлановаяДата КАК ПлановаяДата
	|ИЗ
	|	Документ.CRM_Взаимодействие КАК CRM_Взаимодействие
	|ГДЕ
	|	НЕ CRM_Взаимодействие.ПометкаУдаления
	|	И CRM_Взаимодействие.Партнер = &Партнер
	|	И CRM_Взаимодействие.Ответственный = &Ответственный
	|	И НЕ CRM_Взаимодействие.Ссылка = &ВзаимодействиеСсылка
	|	И (CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.ВРаботе)
	|			ИЛИ CRM_Взаимодействие.СтатусВзаимодействия = ЗНАЧЕНИЕ(Справочник.CRM_СостоянияСобытий.Запланировано))
	|	И CRM_Взаимодействие.ПлановаяДата МЕЖДУ &ТекущаяДата И ДОБАВИТЬКДАТЕ(&ТекущаяДата, ДЕНЬ, &КоличествоДней)");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("ТекущаяДата", ДатаВзаимодействия);
	Запрос.УстановитьПараметр("Ответственный", Ответственный);
	Запрос.УстановитьПараметр("КоличествоДней", 10);
	Запрос.УстановитьПараметр("ВзаимодействиеСсылка", ВзаимодействиеСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции //-- #Б-4382 смарт: Фролов 24.09.2025	

//++ #Б7290 смарт: Шляпников 09.07.2026 / Документ "Маркетинговое мероприятие". Связь к Интересу "один ко многим".
Функция ПолучитьЗаголовокКомандыСпискаМркетинговыхМероприятий(Интерес)
	
	Если НЕ ЗначениеЗаполнено(Интерес) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ МаркетинговыеМероприятияДокумент.Ссылка) КАК Количество
	|ИЗ
	|	Документ.МаркетинговыеМероприятияДокумент КАК МаркетинговыеМероприятияДокумент
	|ГДЕ
	|	МаркетинговыеМероприятияДокумент.смартИнтерес = &Интерес
	|	И НЕ МаркетинговыеМероприятияДокумент.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Интерес", Интерес);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Количество <> NULL Тогда
		Возврат СтрШаблон("Дополнительно создано (%1) маркетинговых мероприятий", Выборка.Количество);
	КонецЕсли;
	
	Возврат "Дополнительных маркетинговых мероприятий нет";
	
КонецФункции

#КонецОбласти