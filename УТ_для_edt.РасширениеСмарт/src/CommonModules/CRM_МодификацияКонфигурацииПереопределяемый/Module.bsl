		ЗаметкиКоманда.Отображение = ОтображениеКнопки.Текст;
		
		Заметки = Форма.Элементы.Вставить("смартЗаметки", Тип("КнопкаФормы"), Форма.Элементы.ГруппаКоманднаяПанель, Форма.Элементы.Декорация5);
		Заметки.ИмяКоманды = "смартЗаметки";
		Заметки.Заголовок = "Заметки (смарт)";
		//-- #1830 смарт: Фролов 24.05.2024
		
		//++#1542 смарт: Лопато 03.11.2023 //Рефакторинг кода 1С. Расширение CRM. Перевести в расширение Смарт.  
