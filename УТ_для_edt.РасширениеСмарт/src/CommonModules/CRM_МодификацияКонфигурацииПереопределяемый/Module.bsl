//++ #Б-3286 смарт: Фролов 13.05.2025 //Закрывать процесс согласования при отмене взаимодействия.
Процедура смарт_ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи)
	
	//++ #Б-3286 смарт: Фролов 13.05.2025 //Закрывать процесс согласования при отмене взаимодействия.
	Если Форма.ИмяФормы = "Документ.CRM_Взаимодействие.Форма.ФормаДокумента" Тогда
		
		Если ТекущийОбъект.СтатусВзаимодействия=Справочники.CRM_СостоянияСобытий.Отменено
			ИЛИ ТекущийОбъект.СтатусВзаимодействия=Справочники.CRM_СостоянияСобытий.Завершено
			ИЛИ ТекущийОбъект.ПометкаУдаления Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Ссылка КАК Ссылка
			|ИЗ
			|	Задача.ЗадачаИсполнителя
			|ГДЕ
			|	Предмет = &Предмет
			|	И НЕ Выполнена");
			Запрос.УстановитьПараметр("Предмет", ТекущийОбъект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				ОбъектЗадача = Выборка.Ссылка.ПолучитьОбъект();
				ОбъектЗадача.Выполнена = Истина;
				ОбъектЗадача.ДатаИсполнения = ТекущаяДата();
				ОбъектЗадача.Записать();
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;	
	//-- #Б-3286 смарт: Фролов 13.05.2025
	
КонецПроцедуры //-- #Б-3286 смарт: Фролов 13.05.2025

