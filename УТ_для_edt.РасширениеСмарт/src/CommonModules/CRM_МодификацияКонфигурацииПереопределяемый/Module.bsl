		Форма.Элементы.ДекорацияКомментарийОценки.Видимость = Ложь;
		
		НовыйЭлемент = Форма.Элементы.Добавить("extCRM_ДекорацияОценки", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаОценка);
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.Заголовок = "";
		НовыйЭлемент.УстановитьДействие("ОбработкаНавигационнойСсылки", "extCRM_ДекорацияОценкиОбработкаНавигационнойСсылки");
		
		//++ #Б-3566 смарт: Фролов 25.06.2025 //Описание
		//НовыйЭлемент = Форма.Элементы.Добавить("extCRM_ДекорацияЗаказ", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаДатаПродажи);
		НовыйЭлемент = Форма.Элементы.Вставить("extCRM_ДекорацияЗаказ", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаВыручка);
		//-- #Б-3566 смарт: Фролов 25.06.2025
		НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
		НовыйЭлемент.Заголовок = "";
		//--#1542 смарт: Лопато 03.11.2023
		
		//++Перенесено из расширения CRM
		// Поддержка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	CRM_ДанныеОбратнойСвязи.Оценка КАК Оценка,
		               |	CRM_ДанныеОбратнойСвязи.Шаблон КАК Шаблон,
		               |	CRM_ДанныеОбратнойСвязи.Комментарий КАК Комментарий
		               |ИЗ
		               |	РегистрСведений.extCRM_ДанныеОбратнойСвязи КАК CRM_ДанныеОбратнойСвязи
		               |ГДЕ
		               |	CRM_ДанныеОбратнойСвязи.Объект = &Объект
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Шаблон,
		               |	CRM_ДанныеОбратнойСвязи.ДатаОценки УБЫВ
		               |ИТОГИ ПО
		               |	Шаблон";
		Запрос.УстановитьПараметр("Объект", Форма.Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Форма.Элементы.ГруппаОценка.Видимость = (Выборка.Количество()>0);
		МассивОценок = Новый Массив;
		Пока Выборка.Следующий() Цикл
			ВыборкаОценка = Выборка.Выбрать();
			Если ВыборкаОценка.Следующий() Тогда
				Оценка = ВыборкаОценка.Оценка;
				КомментарийОценки = СокрЛП(ВыборкаОценка.Комментарий);
				ПозицияПС = СтрНайти(КомментарийОценки, Символы.ПС);
				Если ПозицияПС > 0 Тогда
					КомментарийСокр = Лев(КомментарийОценки, ПозицияПС - 1);
				Иначе
					КомментарийСокр = КомментарийОценки;
				КонецЕсли;
				КомментарийСокр = ?(СтрДлина(КомментарийСокр) > 45, Лев(КомментарийСокр, 42)+"...", КомментарийСокр);
				Если МассивОценок.Количество()>0 Тогда
					МассивОценок.Добавить(Символы.ПС);
				КонецЕсли;
				МассивОценок.Добавить(Новый ФорматированнаяСтрока(ВыборкаОценка.Шаблон.Наименование + ": " 
					+ Строка(Оценка)+ "   " ,
					Новый ФорматированнаяСтрока(КомментарийСокр,, ЦветаСтиля.ЦветГиперссылки,,КомментарийОценки)));
			КонецЕсли;
			Форма.Элементы.extCRM_ДекорацияОценки.Заголовок = Новый ФорматированнаяСтрока(МассивОценок);
			Форма.Элементы.extCRM_ДекорацияОценки.Высота = (МассивОценок.Количество()+1)/2;
		КонецЦикла;	
		// Конец Поддержка
		
		//++ #Б-3860 смарт: Фролов 15.08.2025 //CRM. Продажа оборудования. Дополнительные условия на этапе
		НовыйЭлемент = Форма.Элементы.Добавить("смартДатаОтправкиДоговора", Тип("ПолеФормы"), Форма.Элементы.ГруппаДатаПродажи); 	
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = "Объект.смартДатаОтправкиДоговора";
		НовыйЭлемент.Заголовок = "Дата отправки договора"; 
		//-- #Б-3860 смарт: Фролов 15.08.2025
		
		//+ Отображение заказа в интересе
		//++ #1690 смарт: Фролов 26.03.2024 //Небольшие доработки CRM по результатам эксплуатации.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	CRM_ЖурналДокументов.Объект КАК Объект,
		|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентОплаты, 0) КАК ПроцентОплаты,
		|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентОтгрузки, 0) КАК ПроцентОтгрузки,
		|	ЕСТЬNULL(СостоянияЗаказовКлиентов.ПроцентДолга, 0) КАК ПроцентДолга
		|ИЗ
		|	РегистрСведений.CRM_ЖурналДокументов КАК CRM_ЖурналДокументов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|		ПО CRM_ЖурналДокументов.Объект = СостоянияЗаказовКлиентов.Заказ
		|ГДЕ
		|	CRM_ЖурналДокументов.CRM_Интерес = &CRM_Интерес
		|	И CRM_ЖурналДокументов.ГлавнаяЗапись
		|	И CRM_ЖурналДокументов.Объект ССЫЛКА Документ.ЗаказКлиента");
		
		//-- #1690 смарт: Фролов 26.03.2024
		
		Запрос.УстановитьПараметр("CRM_Интерес", Форма.Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Форма.Элементы.extCRM_ДекорацияЗаказ.Заголовок = Новый ФорматированнаяСтрока(Строка(Выборка.Объект),,,, ПолучитьНавигационнуюСсылку(Выборка.Объект));
			
			//++ #1690 смарт: Фролов 22.03.2024 //Небольшие доработки CRM по результатам эксплуатации.
			Если ЗначениеЗаполнено(Выборка.Объект.Договор) Тогда
				
				НовыйЭлемент = Форма.Элементы.Добавить("смартДекорацияДоговорПодписан", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаДатаПродажи);
				НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
				НовыйЭлемент.Шрифт = Новый Шрифт(НовыйЭлемент.Шрифт, , , Истина);
				
				Если Выборка.Объект.Договор.смартДоговорПодписан Тогда
					НовыйЭлемент.Заголовок = "   Договор подписан";
