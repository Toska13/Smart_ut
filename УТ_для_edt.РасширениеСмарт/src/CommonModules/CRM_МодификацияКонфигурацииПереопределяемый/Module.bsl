			НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");				
			
		КонецЦикла;
		//-- #1808 смарт: Ермаков 06.05.2024
		
	КонецЕсли;
	
	Если Форма.ИмяФормы = "Документ.CRM_Интерес.Форма.ФормаДокументаНовая" Тогда
		
		//++ #1830 смарт: Фролов 24.05.2024 //Приведение механизма Заметок в Интересе и Партнере к общему виду.
