		НовыйЭлемент.КнопкаОткрытия = Ложь;
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		НовыйЭлемент.ПодсказкаВвода = "Квалификация"; 
		НовыйЭлемент.МаксимальнаяШирина = 24;
		НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;	
		
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_ВыполнитьПереопределяемуюКоманду");		
		
		// Добавляем фильтр по новым и старым воронкам
		Форма.Команды.Добавить("смартНовые");
		Форма.Команды.Добавить("смартСтарые");
		
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить(Новый РеквизитФормы("смартНовые", Новый ОписаниеТипов("Булево"),, "Новые", Истина));
		МассивРеквизитов.Добавить(Новый РеквизитФормы("смартСтарые", Новый ОписаниеТипов("Булево"),, "Старые", Истина));
		
		Форма.ИзменитьРеквизиты(МассивРеквизитов);
		
		Для Каждого Реквизит Из МассивРеквизитов Цикл
			
			НовыйЭлемент = Форма.Элементы.Вставить(Реквизит.Имя, Тип("ПолеФормы"), Форма.Элементы.ГруппаКомандыОтбораНовая, Форма.Элементы.ОткрытьФильтр);
