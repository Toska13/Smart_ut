				Иначе
					НовыйЭлемент.Заголовок = "   Договор не подписан";
					НовыйЭлемент.ЦветТекста = Новый Цвет(255,0,0);
				КонецЕсли;
			
			КонецЕсли;
			
			НовыйЭлемент = Форма.Элементы.Добавить("смартДекорацияСостоянияЗаказа", Тип("ДекорацияФормы"), Форма.Элементы.ГруппаВыручка);
			НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
