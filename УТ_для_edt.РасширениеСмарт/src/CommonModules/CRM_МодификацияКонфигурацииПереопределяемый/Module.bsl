		//ЗаметкиКоманда.Действие = "Подключаемый_ВыполнитьПереопределяемуюКоманду";
		//ЗаметкиКоманда.Отображение = ОтображениеКнопки.Текст;
		//
		//Заметки = Форма.Элементы.Вставить("смартСоздатьЗаметку", Тип("КнопкаФормы"), Форма.Элементы.ГруппаКоманднаяПанель, Форма.Элементы.Декорация5);
		//Заметки.ИмяКоманды = "смартСоздатьЗаметку";
		//Заметки.Заголовок = "Создать заметку (смарт)";  
