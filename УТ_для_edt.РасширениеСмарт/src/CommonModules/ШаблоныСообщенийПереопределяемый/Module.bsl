#Область ПрограммныйИнтерфейс

// Определяет состав назначений и общие реквизиты в шаблонах сообщений 
//
// Параметры:
//  Настройки - Структура:
//    * ПредметыШаблонов - ТаблицаЗначений - содержит варианты предметов для шаблонов. Колонки:
//         ** Имя           - Строка - уникальное имя назначения.
//         ** Представление - Строка - представление варианта.
//         ** Макет         - Строка - имя макета СКД, если состав реквизитов определяется посредством СКД.
//         ** ЗначенияПараметровСКД - Структура - значения параметров СКД для текущего предмета шаблона сообщения.
//    * ОбщиеРеквизиты - ДеревоЗначений - содержит описание общих реквизитов доступных во всех шаблонах. Колонки:
//         ** Имя            - Строка - уникальное имя общего реквизита.
//         ** Представление  - Строка - представление общего реквизита.
//         ** Тип            - Тип    - тип общего реквизита. По умолчанию строка.
//    * ИспользоватьПроизвольныеПараметры  - Булево - указывает, можно ли использовать произвольные пользовательские
//                                                    параметры в шаблонах сообщений.
//    * ЗначенияПараметровСКД - Структура - общие значения параметров СКД, для всех макетов, где состав реквизитов
//                                          определяется средствами СКД.
//
&ИзменениеИКонтроль("ПриОпределенииНастроек")
Процедура смарт_ПриОпределенииНастроек(Настройки)
	
	//++ НЕ ГОСИС
	Настройки.ИспользоватьПроизвольныеПараметры = Истина;
	Настройки.ЗначенияПараметровСКД.Вставить("ОбращениеМужскойРод", НСтр("ru='Уважаемый'"));
	Настройки.ЗначенияПараметровСКД.Вставить("ОбращениеЖенскийРод", НСтр("ru='Уважаемая'"));
	Настройки.ЗначенияПараметровСКД.Вставить("ОбращениеПолНеопределен", НСтр("ru='Уважаемый(ая)'"));
	Настройки.ЗначенияПараметровСКД.Вставить("СтрокаБезОграничений", НСтр("ru='Без ограничений'"));
	Настройки.ЗначенияПараметровСКД.Вставить("МожетВыкупатьсяЧастично", НСтр("ru='Может выкупаться частично'"));
	Настройки.ЗначенияПараметровСКД.Вставить("НеМожетВыкупатьсяЧастично", НСтр("ru='Не может выкупаться частично'"));
	
	Для Каждого ЗначениеПеречисления ИЗ Перечисления.ТипыСобытийОповещений.ИзменениеСостоянияЗаказа.Метаданные().ЗначенияПеречисления Цикл
	
		Если НЕ Перечисления.ТипыСобытийОповещений.ДанныеДляОбработкиОчередиОповещений(Перечисления.ТипыСобытийОповещений[ЗначениеПеречисления.Имя]).ДоступноДляИспользования Тогда
			Продолжить;
		КонецЕсли;
		
		Предмет = Настройки.ПредметыШаблонов.Добавить();
		Предмет.Имя = ЗначениеПеречисления.Имя;
		Предмет.Представление = НСтр("ru = 'Оповещение клиента'") + " """ + ЗначениеПеречисления.Синоним +"""";
		Предмет.Макет = ЗначениеПеречисления.Имя;
	
	КонецЦикла;
	//-- НЕ ГОСИС
	
	#Вставка
	//++ #Б7250 смарт: Шляпников 06.07.2026 / Цены и акции. Уведомления об изменении.
	// Добавляем документ УстановкаЦенНоменклатуры в предметы шаблонов
	Предмет = Настройки.ПредметыШаблонов.Добавить();
	Предмет.Имя = "Документ.УстановкаЦенНоменклатуры";
	Предмет.Представление = НСтр("ru = 'Установка цен номенклатуры'");
	Предмет.Макет = "ДанныеШаблонаСообщений";
	//-- #Б7250 смарт: Шляпников 06.07.2026
	#КонецВставки
	
КонецПроцедуры

//++ #Б7250 смарт: регистрация [Товары.*] в дереве параметров при записи шаблона
&После("ПриПодготовкеШаблонаСообщения")
Процедура смарт_ПриПодготовкеШаблонаСообщения(Реквизиты, Вложения, НазначениеШаблона, ДополнительныеПараметры)
	
	Если НазначениеШаблона <> "Документ.УстановкаЦенНоменклатуры" Тогда
		Возврат;
	КонецЕсли;
	
	Документы.УстановкаЦенНоменклатуры.ДобавитьРеквизитыСтрокТоваровВШаблонСообщения(Реквизиты);
	
КонецПроцедуры
//-- #Б7250

// Вызывается в момент создания сообщений по шаблону для заполнения значений реквизитов и вложений.
//
// Параметры:
//  Сообщение - Структура:
//    * ЗначенияРеквизитов - Соответствие - список используемых в шаблоне реквизитов:
//      ** Ключ     - Строка - имя реквизита в шаблоне;
//      ** Значение - Строка - значение заполнения в шаблоне.
//    * ЗначенияОбщихРеквизитов - Соответствие - список используемых в шаблоне общих реквизитов:
//      ** Ключ     - Строка - имя реквизита в шаблоне;
//      ** Значение - Строка - значение заполнения в шаблоне.
//    * Вложения - Соответствие:
//      ** Ключ     - Строка - имя вложения в шаблоне;
//      ** Значение - ДвоичныеДанные
//                  - Строка - двоичные данные или адрес во временном хранилище вложения.
//    * ДополнительныеПараметры - Структура - дополнительные параметры сообщения. 
//  НазначениеШаблона - Строка -  полное имя назначения шаблон сообщения.
//  ПредметСообщения - ЛюбаяСсылка - ссылка на объект являющийся источником данных.
//  ПараметрыШаблона - Структура -  дополнительная информация о шаблоне сообщения.
//
&ИзменениеИКонтроль("ПриФормированииСообщения")
Процедура смарт_ПриФормированииСообщения(Сообщение, НазначениеШаблона, ПредметСообщения, ПараметрыШаблона)
	
	//++ НЕ ГОСИС
	МассивНазначенийШаблона = Новый Массив;
	Для Каждого ЗначениеПеречисления ИЗ Перечисления.ТипыСобытийОповещений.ИзменениеСостоянияЗаказа.Метаданные().ЗначенияПеречисления Цикл
		Если НЕ Перечисления.ТипыСобытийОповещений.ДанныеДляОбработкиОчередиОповещений(Перечисления.ТипыСобытийОповещений[ЗначениеПеречисления.Имя]).ДоступноДляИспользования Тогда
			Продолжить;
		КонецЕсли;
		МассивНазначенийШаблона.Добавить(ЗначениеПеречисления.Имя);
	КонецЦикла;
	
	Если МассивНазначенийШаблона.Найти(НазначениеШаблона) <> Неопределено Тогда
		ШаблоныСообщений.ЗаполнитьРеквизитыПоСКД(Сообщение.ЗначенияРеквизитов, ПредметСообщения, ПараметрыШаблона);
	КонецЕсли;
	
	ШаблоныСообщенийЛокализация.ПриФормированииСообщения(Сообщение, НазначениеШаблона, ПредметСообщения, ПараметрыШаблона);
	//-- НЕ ГОСИС

	#Вставка
	//++ #Б7250 смарт: Шляпников 06.07.2026 / Цены и акции. Уведомления об изменении.
	Если НазначениеШаблона = "Документ.УстановкаЦенНоменклатуры" Тогда
		// БСП заполняет ЗначенияРеквизитов только если в тексте есть [УстановкаЦенНоменклатуры.*].
		// Шаблон с одними [Товары.*] приходит сюда с пустым Соответствием — СКД тогда не выбирает поля.
		ЗаполнитьРеквизитыУстановкиЦенНоменклатуры(Сообщение, ПредметСообщения, ПараметрыШаблона);
		ОбработатьТаблицыВТекстеСообщения(ПредметСообщения, Сообщение, ПараметрыШаблона);
	КонецЕсли;
	//-- #Б7250 смарт: Шляпников 06.07.2026
	#КонецВставки
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

// Заполняет Сообщение.ЗначенияРеквизитов для документа УстановкаЦенНоменклатуры.
// Если БСП не создала ключи (в шаблоне нет [УстановкаЦенНоменклатуры.*]) — создаём их сами.
//
Процедура ЗаполнитьРеквизитыУстановкиЦенНоменклатуры(Сообщение, ПредметСообщения, ПараметрыШаблона)
	
	Если ПредметСообщения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПараметрыШаблона.Макет) Тогда
		ПараметрыШаблона.Макет = "ДанныеШаблонаСообщений";
	КонецЕсли;
	
	Реквизиты = Сообщение.ЗначенияРеквизитов;
	Если ТипЗнч(Реквизиты) <> Тип("Соответствие") Тогда
		Реквизиты = Новый Соответствие;
		Сообщение.ЗначенияРеквизитов = Реквизиты;
	КонецЕсли;
	
	Если Реквизиты.Количество() = 0 Тогда
		Для Каждого ИмяПоля Из ИменаПолейМакетаДанныеШаблонаСообщений() Цикл
			Реквизиты.Вставить(ИмяПоля, "");
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		ШаблоныСообщений.ЗаполнитьРеквизитыПоСКД(Реквизиты, ПредметСообщения, ПараметрыШаблона);
	Исключение
		ЗаполнитьПустыеРеквизитыДокументаПоОбъекту(Реквизиты, ПредметСообщения);
	КонецПопытки;
	
	ЗаполнитьПустыеРеквизитыДокументаПоОбъекту(Реквизиты, ПредметСообщения);
	
	// СКД/объект дают короткие имена (Дата); в шаблоне стандарт — [УстановкаЦенНоменклатуры.Дата]
	Сообщение.ЗначенияРеквизитов = РеквизитыШаблонаСПрефиксомОбъекта(
		Реквизиты,
		ПредметСообщения.Метаданные().Имя);
	
КонецПроцедуры

// Преобразует ключи "Дата" → "УстановкаЦенНоменклатуры.Дата" для условий шапки и подстановки.
Функция РеквизитыШаблонаСПрефиксомОбъекта(Реквизиты, ИмяОбъекта)
	
	Префикс = ИмяОбъекта + ".";
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из Реквизиты Цикл
		
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = КлючЗначение.Ключ;
		Если СтрНачинаетсяС(ИмяПоля, Префикс) Тогда
			Результат.Вставить(ИмяПоля, КлючЗначение.Значение);
		ИначеЕсли СтрНайти(ИмяПоля, ".") = 0 Тогда
			Результат.Вставить(Префикс + ИмяПоля, КлючЗначение.Значение);
		Иначе
			Результат.Вставить(ИмяПоля, КлючЗначение.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИменаПолейМакетаДанныеШаблонаСообщений()
	
	Результат = Новый Массив;
	Результат.Добавить("Ссылка");
	Результат.Добавить("Дата");
	Результат.Добавить("Номер");
	Результат.Добавить("Проведен");
	Результат.Добавить("ПометкаУдаления");
	Результат.Добавить("Ответственный");
	Результат.Добавить("Комментарий");
	Результат.Добавить("Согласован");
	Результат.Добавить("ДокументОснование");
	Результат.Добавить("Статус");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПустыеРеквизитыДокументаПоОбъекту(Реквизиты, ПредметСообщения)
	
	ИменаКЗаполнению = Новый Массив;
	Для Каждого КлючЗначение Из Реквизиты Цикл
		
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаКЗаполнению.Добавить(КлючЗначение.Ключ);
		
	КонецЦикла;
	
	Если ИменаКЗаполнению.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ПредметСообщения,
			СтрСоединить(ИменаКЗаполнению, ","));
	Исключение
		ЗначенияРеквизитов = Неопределено;
	КонецПопытки;
	
	Если ЗначенияРеквизитов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл
		Реквизиты.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьТаблицыВТекстеСообщения(ПредметСообщения, Сообщение, ПараметрыШаблона) Экспорт

	ДокументОбъект = ОбъектПредмета(ПредметСообщения);
	Если ДокументОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Пишем только в Текст/Тема — иначе портятся ПолноеИмяТипаНазначения, Макет и т.д.
	Если ПараметрыШаблона.Свойство("Текст")
		И ТипЗнч(ПараметрыШаблона.Текст) = Тип("Строка")
		И ЗначениеЗаполнено(ПараметрыШаблона.Текст) Тогда

		ПараметрыШаблона.Текст = ОбработатьТекстШаблона(ДокументОбъект, ПараметрыШаблона.Текст, Сообщение);

	КонецЕсли;

	Если ПараметрыШаблона.Свойство("Тема")
		И ТипЗнч(ПараметрыШаблона.Тема) = Тип("Строка")
		И ЗначениеЗаполнено(ПараметрыШаблона.Тема) Тогда

		ПараметрыШаблона.Тема = ОбработатьТекстШаблона(ДокументОбъект, ПараметрыШаблона.Тема, Сообщение);

	КонецЕсли;

КонецПроцедуры

Функция ОбработатьТекстШаблона(ДокументОбъект, ТекстШаблона, Сообщение)

	ТекстСообщения = ЗаменитьПользовательскиеТегиТаблицы(ТекстШаблона);

	// Сначала повторы строк ТЧ (внутри — условия строки и подстановка [ТЧ.*])
	ТекстСообщения = ОбработатьБлокиПовторения(ДокументОбъект, ТекстСообщения, Сообщение);

	// Затем условия уровня документа
	ТекстСообщения = ОбработатьУсловныеБлоки(ДокументОбъект, ТекстСообщения, Сообщение);

	Возврат ТекстСообщения;

КонецФункции

Функция ЗаменитьПользовательскиеТегиТаблицы(ТекстСообщения)

	Результат = ТекстСообщения;

	// HTML-редактор шаблона часто кодирует скобки тегов {Повтор} / {Если}
	Результат = СтрЗаменить(Результат, "&#123;", "{");
	Результат = СтрЗаменить(Результат, "&#125;", "}");
	Результат = СтрЗаменить(Результат, "&#x7b;", "{");
	Результат = СтрЗаменить(Результат, "&#x7d;", "}");
	Результат = СтрЗаменить(Результат, "&#X7B;", "{");
	Результат = СтрЗаменить(Результат, "&#X7D;", "}");
	Результат = СтрЗаменить(Результат, "&lcub;", "{");
	Результат = СтрЗаменить(Результат, "&rcub;", "}");
	// Неразрывный пробел / сущности / «невидимые» символы — иначе теряется "{Если"
	Результат = СтрЗаменить(Результат, "&nbsp;", " ");
	Результат = СтрЗаменить(Результат, "&NBSP;", " ");
	Результат = СтрЗаменить(Результат, Символы.НПП, " ");
	Результат = СтрЗаменить(Результат, Символ(8239), " "); // узкий НПП
	Результат = СтрЗаменить(Результат, Символ(8201), " "); // тонкий пробел
	Результат = СтрЗаменить(Результат, Символ(8203), "");  // zero-width space
	Результат = СтрЗаменить(Результат, Символ(8204), "");  // ZWNJ
	Результат = СтрЗаменить(Результат, Символ(8205), "");  // ZWJ
	Результат = СтрЗаменить(Результат, Символ(173), "");   // soft hyphen
	Результат = СтрЗаменить(Результат, "｛", "{");
	Результат = СтрЗаменить(Результат, "｝", "}");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&amp;", "&");

	Результат = СтрЗаменить(Результат, "<Таблица>", "<table>");
	Результат = СтрЗаменить(Результат, "</Таблица>", "</table>");
	Результат = СтрЗаменить(Результат, "<Таблица.Строка>", "<tr>");
	Результат = СтрЗаменить(Результат, "</Таблица.Строка>", "</tr>");
	Результат = СтрЗаменить(Результат, "<Таблица.Колонка>", "<td>");
	Результат = СтрЗаменить(Результат, "</Таблица.Колонка>", "</td>");
	Результат = СтрЗаменить(Результат, "<Таблица.Заголовок>", "<th>");
	Результат = СтрЗаменить(Результат, "</Таблица.Заголовок>", "</th>");

	Результат = СтрЗаменить(Результат, "&lt;Таблица&gt;", "<table>");
	Результат = СтрЗаменить(Результат, "&lt;/Таблица&gt;", "</table>");
	Результат = СтрЗаменить(Результат, "&lt;Таблица.Строка&gt;", "<tr>");
	Результат = СтрЗаменить(Результат, "&lt;/Таблица.Строка&gt;", "</tr>");
	Результат = СтрЗаменить(Результат, "&lt;Таблица.Колонка&gt;", "<td>");
	Результат = СтрЗаменить(Результат, "&lt;/Таблица.Колонка&gt;", "</td>");
	Результат = СтрЗаменить(Результат, "&lt;Таблица.Заголовок&gt;", "<th>");
	Результат = СтрЗаменить(Результат, "&lt;/Таблица.Заголовок&gt;", "</th>");

	Возврат Результат;

КонецФункции

Функция ОбработатьБлокиПовторения(ДокументОбъект, ТекстСообщения, Сообщение) Экспорт

	Результат = ТекстСообщения;

	ТегНачалаПовтора = "{Повтор.";
	ДлинаТегаНачалаПовтора = СтрДлина(ТегНачалаПовтора);
	ПозицияНачала = СтрНайти(Результат, ТегНачалаПовтора);

	Пока ПозицияНачала > 0 Цикл

		ТекстДляПоиска = Сред(Результат, ПозицияНачала);
		ПозицияТочки = СтрНайти(ТекстДляПоиска, "}");
		Если ПозицияТочки > 0 Тогда
			ПозицияТочки = ПозицияТочки + ПозицияНачала - 1;
		КонецЕсли;

		Если ПозицияТочки = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоИмени = ПозицияНачала + ДлинаТегаНачалаПовтора;
		ИмяТЧ = СокрЛП(Сред(Результат, НачалоИмени, ПозицияТочки - НачалоИмени));

		ТегКонца = "{/Повтор." + ИмяТЧ + "}";
		ТекстДляПоиска = Сред(Результат, ПозицияТочки + 1);
		ПозицияКонца = СтрНайти(ТекстДляПоиска, ТегКонца);
		Если ПозицияКонца > 0 Тогда
			ПозицияКонца = ПозицияКонца + ПозицияТочки;
		КонецЕсли;

		Если ПозицияКонца = 0 Тогда
			Прервать;
		КонецЕсли;

		НачалоСодержимого = ПозицияТочки + 1;
		КонецСодержимого = ПозицияКонца - 1;
		СодержимоеБлока = Сред(Результат, НачалоСодержимого, КонецСодержимого - НачалоСодержимого + 1);
		// Переводы строк сразу внутри тегов {Повтор}...{/Повтор} — служебные
		СодержимоеБлока = УбратьОдинПереводСтрокиСлева(СодержимоеБлока);
		СодержимоеБлока = УбратьОдинПереводСтрокиСправа(СодержимоеБлока);

		ТабличнаяЧасть = ТабличнаяЧастьДокумента(ДокументОбъект, ИмяТЧ);
		ТекстДоБлока = Лев(Результат, ПозицияНачала - 1);
		ТекстПослеБлока = Сред(Результат, ПозицияКонца + СтрДлина(ТегКонца));

		Если ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Количество() > 0 Тогда

			СтрокиПовторения = Новый Массив;

			Для Каждого СтрокаТЧ Из ТабличнаяЧасть Цикл

				// Сырые значения: условия → литералы BSL; текст → представление
				ПараметрыСтроки = ПараметрыСтрокиТЧ(СтрокаТЧ, ТабличнаяЧасть, ДокументОбъект, ИмяТЧ, Сообщение);

				ВременноеСообщение = Новый Структура("ЗначенияРеквизитов");
				ВременноеСообщение.ЗначенияРеквизитов = ПараметрыСтроки;

				HTMLСтрока = ОбработатьУсловныеБлоки(ДокументОбъект, СодержимоеБлока, ВременноеСообщение);
				HTMLСтрока = ЗаполнитьПараметрыВШаблоне(
					HTMLСтрока,
					ПараметрыДляОтображения(ПараметрыСтроки),
					"");

				// Пустая строка после ложных {Если} — артефакт замены, не из шаблона
				Если СтрокаШаблонаПустаяПослеЗамены(HTMLСтрока) Тогда
					Продолжить;
				КонецЕсли;

				СтрокиПовторения.Добавить(HTMLСтрока);

			КонецЦикла;

			ТекстВставки = СтрСоединить(СтрокиПовторения, "");
			РезультатЗамены = РезультатЗаменыБлокаШаблона(ТекстДоБлока, ТекстВставки, ТекстПослеБлока);
			Результат = РезультатЗамены.Текст;
			ПозицияПоискаСледующего = РезультатЗамены.ПозицияПослеВставки;

		Иначе

			РезультатЗамены = РезультатЗаменыБлокаШаблона(ТекстДоБлока, "", ТекстПослеБлока);
			Результат = РезультатЗамены.Текст;
			ПозицияПоискаСледующего = РезультатЗамены.ПозицияПослеВставки;

		КонецЕсли;

		ТекстДляПоиска = Сред(Результат, ПозицияПоискаСледующего);
		ПозицияВСледующемТексте = СтрНайти(ТекстДляПоиска, ТегНачалаПовтора);
		Если ПозицияВСледующемТексте > 0 Тогда
			ПозицияНачала = ПозицияПоискаСледующего + ПозицияВСледующемТексте - 1;
		Иначе
			ПозицияНачала = 0;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТабличнаяЧастьДокумента(ДокументОбъект, ИмяТЧ) Экспорт

	ИмяМакетаСКД = ИмяМакетаСКДДляТЧ(ДокументОбъект, ИмяТЧ);

	Если ИмяМакетаСКД <> Неопределено Тогда

		ТаблицаРезультат = ВыполнитьСКДДляТЧ(ДокументОбъект, ИмяМакетаСКД);
		// Пустая таблица СКД ≠ ошибка: иначе {Повтор} вырезается целиком при отсутствии старых цен
		Если ТаблицаРезультат <> Неопределено И ТаблицаРезультат.Количество() > 0 Тогда
			Возврат ТаблицаРезультат;
		КонецЕсли;

	КонецЕсли;

	Попытка
		Возврат ДокументОбъект[ИмяТЧ];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ОбъектПредмета(ПредметСообщения) Экспорт

	Если ПредметСообщения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипПредмета = ТипЗнч(ПредметСообщения);
	ВидОбъекта = ОбщегоНазначения.ВидОбъектаПоТипу(ТипПредмета);

	Если ВидОбъекта = "Документ" Или ВидОбъекта = "Справочник" Тогда

		Попытка
			Возврат ПредметСообщения.ПолучитьОбъект();
		Исключение
			Возврат Неопределено;
		КонецПопытки;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПараметрыСтрокиТЧ(СтрокаТЧ, ТабличнаяЧасть, ДокументОбъект, ИмяТЧ, Сообщение) Экспорт

	Параметры = Новый Соответствие;

	// Реквизиты документа (сырые значения) — для условий и текста внутри повтора
	ПрефиксДокумента = ДокументОбъект.Метаданные().Имя + ".";
	Если Сообщение.Свойство("ЗначенияРеквизитов") Тогда

		Для Каждого КлючЗначение Из Сообщение.ЗначенияРеквизитов Цикл

			Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;

			ИмяКлюча = КлючЗначение.Ключ;
			Если СтрНачинаетсяС(ИмяКлюча, ПрефиксДокумента) Тогда
				Параметры.Вставить(ИмяКлюча, КлючЗначение.Значение);
			ИначеЕсли СтрНайти(ИмяКлюча, ".") = 0 Тогда
				Параметры.Вставить(ПрефиксДокумента + ИмяКлюча, КлючЗначение.Значение);
			Иначе
				Параметры.Вставить(ИмяКлюча, КлючЗначение.Значение);
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Если ТипЗнч(СтрокаТЧ) = Тип("СтрокаТаблицыЗначений") Тогда

		Для Каждого Колонка Из ТабличнаяЧасть.Колонки Цикл
			Параметры.Вставить(ИмяТЧ + "." + Колонка.Имя, СтрокаТЧ[Колонка.Имя]);
		КонецЦикла;

	Иначе

		МетаданныеТЧ = ДокументОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ);
		Если МетаданныеТЧ <> Неопределено Тогда

			Для Каждого РеквизитТЧ Из МетаданныеТЧ.Реквизиты Цикл
				Параметры.Вставить(ИмяТЧ + "." + РеквизитТЧ.Имя, СтрокаТЧ[РеквизитТЧ.Имя]);
			КонецЦикла;

		КонецЕсли;

	КонецЕсли;

	// Нет старой цены (ЛЕВОЕ соединение / сырая ТЧ / пустая строка СКД) — число 0 для {Если}
	КлючСтаройЦены = ИмяТЧ + ".СтараяЦена";
	ЗначениеСтаройЦены = Параметры.Получить(КлючСтаройЦены);
	Если ТипЗнч(ЗначениеСтаройЦены) <> Тип("Число") Тогда
		Параметры.Вставить(КлючСтаройЦены, 0);
	КонецЕсли;

	Возврат Параметры;

КонецФункции

Функция ВыполнитьСКДДляТЧ(ДокументОбъект, ИмяМакета) Экспорт

	Попытка

		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(
			ДокументОбъект.Метаданные().ПолноеИмя());
		МакетСКД = МенеджерОбъекта.ПолучитьМакет(ИмяМакета);

		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		КомпоновщикНастроек.ЗагрузитьНастройки(МакетСКД.НастройкиПоУмолчанию);

		Настройки = КомпоновщикНастроек.Настройки;
		ПараметрыДанных = Настройки.ПараметрыДанных;

		ПараметрДокумента = ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Ссылка"));
		Если ПараметрДокумента <> Неопределено Тогда
			ПараметрДокумента.Значение = ДокументОбъект.Ссылка;
			ПараметрДокумента.Использование = Истина;
		КонецЕсли;

		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			МакетСКД,
			Настройки,
			,
			,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

		ТаблицаРезультат = Новый ТаблицаЗначений;
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(ТаблицаРезультат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);

		Возврат ТаблицаРезультат;

	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ИмяМакетаСКДДляТЧ(ДокументОбъект, ИмяТЧ) Экспорт

	ИмяМакета = ИмяТЧ + "_СКД";
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(
		ДокументОбъект.Метаданные().ПолноеИмя());

	МакетНайден = Ложь;
	Попытка
		Макет = МенеджерОбъекта.ПолучитьМакет(ИмяМакета);
		МакетНайден = Макет <> Неопределено;
	Исключение
		МакетНайден = Ложь;
	КонецПопытки;

	Если МакетНайден Тогда
		Возврат ИмяМакета;
	КонецЕсли;

	Макет = ДокументОбъект.Метаданные().Макеты.Найти(ИмяМакета);
	Если Макет <> Неопределено Тогда
		Возврат ИмяМакета;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПреобразоватьЗначениеВСтроку(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=DD");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		// Без ЧН ноль даёт "" — в шаблоне «Старая цена: <s></s>»
		Возврат Формат(Значение, "ЧДЦ=2; ЧН=0,00");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда

		Если Значение Тогда
			Возврат "Да";
		Иначе
			Возврат "Нет";
		КонецЕсли;

	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	Иначе

		ВидОбъектаЗначения = ОбщегоНазначения.ВидОбъектаПоТипу(ТипЗначения);

		Если ВидОбъектаЗначения = "Справочник"
			Или ВидОбъектаЗначения = "Документ"
			Или ВидОбъектаЗначения = "Перечисление" Тогда
			Возврат СокрЛП(Строка(Значение));
		КонецЕсли;

		Возврат Строка(Значение);

	КонецЕсли;

КонецФункции

// Литералы для Вычислить в условиях шаблона: Истина/Ложь, XMLСтрока(число), "строка".
Функция ПредставлениеЗначенияДляУсловия(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "0";
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Булево") Тогда

		Если Значение Тогда
			Возврат "Истина";
		Иначе
			Возврат "Ложь";
		КонецЕсли;

	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат СтрШаблон("Дата(%1,%2,%3)", Формат(Год(Значение), "ЧГ=0"), Месяц(Значение), День(Значение));
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат СтроковыйЛитералДляУсловия(Значение);
	Иначе
		Возврат СтроковыйЛитералДляУсловия(Строка(Значение));
	КонецЕсли;

КонецФункции

Функция СтроковыйЛитералДляУсловия(ЗначениеСтрокой)

	Кавычка = """";
	Возврат Кавычка + СтрЗаменить(ЗначениеСтрокой, Кавычка, Кавычка + Кавычка) + Кавычка;

КонецФункции

Функция ПараметрыДляВычисленияУсловий(ЗначенияРеквизитов)

	Результат = Новый Соответствие;

	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл

		Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
			Результат.Вставить(КлючЗначение.Ключ, ПараметрыДляВычисленияУсловий(КлючЗначение.Значение));
		Иначе
			Результат.Вставить(КлючЗначение.Ключ, ПредставлениеЗначенияДляУсловия(КлючЗначение.Значение));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПараметрыДляОтображения(ЗначенияРеквизитов)

	Результат = Новый Соответствие;

	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КлючЗначение Из ЗначенияРеквизитов Цикл

		Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
			Результат.Вставить(КлючЗначение.Ключ, ПараметрыДляОтображения(КлючЗначение.Значение));
		Иначе
			Результат.Вставить(КлючЗначение.Ключ, ПреобразоватьЗначениеВСтроку(КлючЗначение.Значение));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗаполнитьПараметрыВШаблоне(Шаблон, Параметры, Префикс) Экспорт

	Возврат ШаблоныСообщений.ВставитьПараметрыВСтрокуСогласноТаблицеПараметров(Шаблон, Параметры, Префикс);

КонецФункции

Функция ОбработатьУсловныеБлоки(ДокументОбъект, ТекстСообщения, Сообщение) Экспорт

	Результат = ТекстСообщения;
	ТегКонца = "{КонецЕсли}";
	ПозицияПоискаТега = 1;

	Пока ПозицияПоискаТега <= СтрДлина(Результат) Цикл

		ПозицияНачала = ПозицияОткрывающегоТегаЕсли(Результат, ПозицияПоискаТега);
		Если ПозицияНачала = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияУсловия = ПозицияПослеКлючевогоСловаЕсли(Результат, ПозицияНачала);
		Если ПозицияУсловия = 0 Тогда
			ПозицияПоискаТега = ПозицияНачала + 1;
			Продолжить;
		КонецЕсли;

		// "}" после условия; если нет — не брать "}" от {КонецЕсли}, а конец первой строки
		ПозицияКонцаУсловия = ПозицияЗакрывающейСкобкиТегаЕсли(Результат, ПозицияУсловия);
		Если ПозицияКонцаУсловия = 0 Тогда
			ПозицияКонцаУсловия = ПозицияКонцаУсловияПоПервойСтроке(Результат, ПозицияУсловия);
		КонецЕсли;

		Если ПозицияКонцаУсловия = 0 Тогда
			ПозицияПоискаТега = ПозицияНачала + 1;
			Продолжить;
		КонецЕсли;

		Условие = СокрЛП(Сред(Результат, ПозицияУсловия, ПозицияКонцаУсловия - ПозицияУсловия));
		НачалоСодержимогоПослеУсловия = НачалоСодержимогоПослеУсловияЕсли(
			Результат,
			ПозицияКонцаУсловия);

		УровеньВложенности = 1;
		ПозицияПоиска = НачалоСодержимогоПослеУсловия;
		ПозицияКонцаБлока = 0;

		Пока УровеньВложенности > 0 И ПозицияПоиска > 0 Цикл

			ПозицияСледующегоЕсли = ПозицияОткрывающегоТегаЕсли(Результат, ПозицияПоиска);
			ПозицияСледующегоКонца = СтрНайти(Результат, ТегКонца, НаправлениеПоиска.СНачала, ПозицияПоиска);

			Если ПозицияСледующегоЕсли = 0 И ПозицияСледующегоКонца = 0 Тогда
				Прервать;
			КонецЕсли;

			Если ПозицияСледующегоЕсли > 0
				И (ПозицияСледующегоКонца = 0 Или ПозицияСледующегоЕсли < ПозицияСледующегоКонца) Тогда

				УровеньВложенности = УровеньВложенности + 1;
				ПозицияПоиска = ПозицияСледующегоЕсли + 1;

			ИначеЕсли ПозицияСледующегоКонца > 0 Тогда

				УровеньВложенности = УровеньВложенности - 1;
				Если УровеньВложенности = 0 Тогда
					ПозицияКонцаБлока = ПозицияСледующегоКонца;
				КонецЕсли;
				ПозицияПоиска = ПозицияСледующегоКонца + СтрДлина(ТегКонца);

			Иначе
				Прервать;
			КонецЕсли;

		КонецЦикла;

		Если ПозицияКонцаБлока = 0 Тогда
			ПозицияПоискаТега = ПозицияНачала + 1;
			Продолжить;
		КонецЕсли;

		НачалоСодержимого = НачалоСодержимогоПослеУсловия;
		КонецСодержимого = ПозицияКонцаБлока - 1;
		Если КонецСодержимого >= НачалоСодержимого Тогда
			СодержимоеБлока = Сред(Результат, НачалоСодержимого, КонецСодержимого - НачалоСодержимого + 1);
		Иначе
			СодержимоеБлока = "";
		КонецЕсли;

		ПараметрыУсловия = Новый Соответствие;
		Если Сообщение.Свойство("ЗначенияРеквизитов") Тогда
			ПараметрыУсловия = ПараметрыДляВычисленияУсловий(Сообщение.ЗначенияРеквизитов);
		КонецЕсли;

		УсловиеСПараметрами = ВставитьПараметрыВУсловиеШаблона(Условие, ПараметрыУсловия);
		УсловиеСПараметрами = НормализоватьВыражениеУсловияШаблона(УсловиеСПараметрами);

		// Вычислить — DSL условий шаблона ({Если ...}); без него выражения из текста шаблона не выполнить.
		Попытка
			РезультатУсловия = Вычислить(УсловиеСПараметрами);
		Исключение
			РезультатУсловия = Ложь;
		КонецПопытки;

		ТекстДоБлока = Лев(Результат, ПозицияНачала - 1);
		ТекстПослеБлока = Сред(Результат, ПозицияКонцаБлока + СтрДлина(ТегКонца));

		Если ТипЗнч(РезультатУсловия) = Тип("Булево") И РезультатУсловия Тогда
			ТекстВставки = СодержимоеБлока;
		Иначе
			ТекстВставки = "";
		КонецЕсли;

		РезультатЗамены = РезультатЗаменыБлокаШаблона(ТекстДоБлока, ТекстВставки, ТекстПослеБлока);
		Результат = РезультатЗамены.Текст;
		ПозицияПоискаТега = РезультатЗамены.ПозицияПослеВставки;
		Если ПозицияПоискаТега < 1 Тогда
			ПозицияПоискаТега = 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ищет "{Если" даже если между "{" и "Если" есть пробелы; старт — с НачальнаяПозиция.
Функция ПозицияОткрывающегоТегаЕсли(Текст, НачальнаяПозиция)
	
	Позиция = НачальнаяПозиция;
	ДлинаТекста = СтрДлина(Текст);
	
	Пока Позиция <= ДлинаТекста Цикл
		
		ПозЕсли = СтрНайти(Текст, "Если", НаправлениеПоиска.СНачала, Позиция);
		Если ПозЕсли = 0 Тогда
			Возврат 0;
		КонецЕсли;
		
		// Не принимаем фрагмент внутри "{КонецЕсли}"
		Если ПозЕсли >= 6 И Сред(Текст, ПозЕсли - 5, 5) = "Конец" Тогда
			Позиция = ПозЕсли + 1;
			Продолжить;
		КонецЕсли;
		
		Поз = ПозЕсли - 1;
		Пока Поз >= 1 И ЭтоПробельныйСимволШаблона(Сред(Текст, Поз, 1)) Цикл
			Поз = Поз - 1;
		КонецЦикла;
		
		Если Поз >= 1 И Сред(Текст, Поз, 1) = "{" Тогда
			Возврат Поз;
		КонецЕсли;
		
		Позиция = ПозЕсли + 1;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция ПозицияПослеКлючевогоСловаЕсли(Текст, ПозицияОткрывающейСкобки)
	
	ПозЕсли = СтрНайти(Текст, "Если", НаправлениеПоиска.СНачала, ПозицияОткрывающейСкобки);
	Если ПозЕсли = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Позиция = ПозЕсли + СтрДлина("Если");
	Пока Позиция <= СтрДлина(Текст) И ЭтоПробельныйСимволШаблона(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	
	Возврат Позиция;
	
КонецФункции

// "}" закрывает тег {Если ...}, игнорируя "}" внутри [Параметр{ЧДЦ=2}].
// "}" от {КонецЕсли} / {/Повтор.*} не считается — иначе условие «съедает» весь блок.
Функция ПозицияЗакрывающейСкобкиТегаЕсли(Текст, НачалоУсловия)
	
	ГлубинаКвадратных = 0;
	ДлинаТекста = СтрДлина(Текст);
	ТегКонцаЕсли = "{КонецЕсли}";
	ДлинаТегаКонцаЕсли = СтрДлина(ТегКонцаЕсли);
	
	Для Индекс = НачалоУсловия По ДлинаТекста Цикл
		
		Если ГлубинаКвадратных = 0
			И Индекс + ДлинаТегаКонцаЕсли - 1 <= ДлинаТекста
			И Сред(Текст, Индекс, ДлинаТегаКонцаЕсли) = ТегКонцаЕсли Тогда
			Возврат 0;
		КонецЕсли;
		
		Если ГлубинаКвадратных = 0
			И Индекс + 8 <= ДлинаТекста
			И Сред(Текст, Индекс, 8) = "{/Повтор" Тогда
			Возврат 0;
		КонецЕсли;
		
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "[" Тогда
			ГлубинаКвадратных = ГлубинаКвадратных + 1;
		ИначеЕсли Символ = "]" Тогда
			Если ГлубинаКвадратных > 0 Тогда
				ГлубинаКвадратных = ГлубинаКвадратных - 1;
			КонецЕсли;
		ИначеЕсли Символ = "}" И ГлубинаКвадратных = 0 Тогда
			Если ЭтоЗакрывающаяСкобкаСлужебногоТегаШаблона(Текст, Индекс) Тогда
				Возврат 0;
			КонецЕсли;
			Возврат Индекс;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

// Нет "}" после условия: граница — перевод строки или начало {КонецЕсли} на этой же строке.
Функция ПозицияКонцаУсловияПоПервойСтроке(Текст, НачалоУсловия)
	
	ДлинаТекста = СтрДлина(Текст);
	ТегКонцаЕсли = "{КонецЕсли}";
	ДлинаТегаКонцаЕсли = СтрДлина(ТегКонцаЕсли);
	
	Для Индекс = НачалоУсловия По ДлинаТекста Цикл
		
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Тогда
			Возврат Индекс;
		КонецЕсли;
		
		Если Индекс + ДлинаТегаКонцаЕсли - 1 <= ДлинаТекста
			И Сред(Текст, Индекс, ДлинаТегаКонцаЕсли) = ТегКонцаЕсли Тогда
			Возврат Индекс;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция НачалоСодержимогоПослеУсловияЕсли(Текст, ПозицияКонцаУсловия)
	
	СимволКонца = Сред(Текст, ПозицияКонцаУсловия, 1);
	
	Если СимволКонца = "}" Тогда
		Возврат ПозицияКонцаУсловия + 1;
	КонецЕсли;
	
	Если СимволКонца = Символы.ВК Тогда
		
		Если ПозицияКонцаУсловия < СтрДлина(Текст)
			И Сред(Текст, ПозицияКонцаУсловия + 1, 1) = Символы.ПС Тогда
			Возврат ПозицияКонцаУсловия + 2;
		КонецЕсли;
		
		Возврат ПозицияКонцаУсловия + 1;
		
	КонецЕсли;
	
	Если СимволКонца = Символы.ПС Тогда
		Возврат ПозицияКонцаУсловия + 1;
	КонецЕсли;
	
	// Указатель на "{КонецЕсли}" — содержимого нет
	Возврат ПозицияКонцаУсловия;
	
КонецФункции

Функция ЭтоЗакрывающаяСкобкаСлужебногоТегаШаблона(Текст, ПозицияСкобки)
	
	ТегКонцаЕсли = "{КонецЕсли}";
	ДлинаТега = СтрДлина(ТегКонцаЕсли);
	Если ПозицияСкобки >= ДлинаТега
		И Сред(Текст, ПозицияСкобки - ДлинаТега + 1, ДлинаТега) = ТегКонцаЕсли Тогда
		Возврат Истина;
	КонецЕсли;
	
	Поз = ПозицияСкобки - 1;
	Пока Поз >= 1 Цикл
		
		Символ = Сред(Текст, Поз, 1);
		Если Символ = "{" Тогда
			Возврат Сред(Текст, Поз, 2) = "{/";
		КонецЕсли;
		Если Символ = "}" Тогда
			Прервать;
		КонецЕсли;
		Поз = Поз - 1;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоПробельныйСимволШаблона(Символ)
	
	Возврат Символ = " "
		Или Символ = Символы.Таб
		Или Символ = Символы.НПП
		Или Символ = Символы.ПС
		Или Символ = Символы.ВК;
	
КонецФункции

// Подстановка в условие: ключи уже "Товары.Цена", значения — литералы для Вычислить.
// Поддерживает и [Товары.Цена], и [Товары.Цена{ЧДЦ=2}] (формат в условии не нужен).
Функция ВставитьПараметрыВУсловиеШаблона(Условие, ПараметрыУсловия)
	
	Результат = Условие;
	
	Для Каждого КлючЗначение Из ПараметрыУсловия Цикл
		
		Если ТипЗнч(КлючЗначение.Значение) = Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = СтрЗаменить(Результат, "[" + КлючЗначение.Ключ + "]", КлючЗначение.Значение);
		
	КонецЦикла;
	
	Возврат ЗаменитьПараметрыСФорматомВУсловии(Результат, ПараметрыУсловия);
	
КонецФункции

Функция ЗаменитьПараметрыСФорматомВУсловии(Условие, ПараметрыУсловия)
	
	Результат = "";
	Длина = СтрДлина(Условие);
	Индекс = 1;
	
	Пока Индекс <= Длина Цикл
		
		Если Сред(Условие, Индекс, 1) <> "[" Тогда
			Результат = Результат + Сред(Условие, Индекс, 1);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		
		ПозЗакр = СтрНайти(Условие, "]", НаправлениеПоиска.СНачала, Индекс + 1);
		Если ПозЗакр = 0 Тогда
			Результат = Результат + Сред(Условие, Индекс);
			Прервать;
		КонецЕсли;
		
		СодержимоеСкобок = Сред(Условие, Индекс + 1, ПозЗакр - Индекс - 1);
		ПозФормата = СтрНайти(СодержимоеСкобок, "{");
		ИмяПараметра = ?(ПозФормата = 0, СодержимоеСкобок, Лев(СодержимоеСкобок, ПозФормата - 1));
		
		ЗначениеПараметра = ПараметрыУсловия.Получить(ИмяПараметра);
		Если ЗначениеПараметра = Неопределено Или ТипЗнч(ЗначениеПараметра) = Тип("Соответствие") Тогда
			Результат = Результат + Сред(Условие, Индекс, ПозЗакр - Индекс + 1);
		Иначе
			Результат = Результат + ЗначениеПараметра;
		КонецЕсли;
		
		Индекс = ПозЗакр + 1;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Убирает артефакты HTML из выражения перед Вычислить (НПП, сущности).
Функция НормализоватьВыражениеУсловияШаблона(Условие)
	
	Результат = Условие;
	Результат = СтрЗаменить(Результат, Символы.НПП, "");
	Результат = СтрЗаменить(Результат, Символ(8239), "");
	Результат = СтрЗаменить(Результат, Символ(8201), "");
	Результат = СтрЗаменить(Результат, "&nbsp;", "");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&amp;", "&");
	
	Возврат Результат;
	
КонецФункции

// Склеивает текст после удаления служебных тегов ({Повтор}, {Если} …).
// Убирает один перевод строки сразу после открывающего и после закрывающего тега —
// это пустые строки от замены, а не пустые строки исходного шаблона.
//
Функция РезультатЗаменыБлокаШаблона(ТекстДо, ТекстВставка, ТекстПосле)
	
	Вставка = УбратьОдинПереводСтрокиСлева(ТекстВставка);
	После = УбратьОдинПереводСтрокиСлева(ТекстПосле);
	
	Если СтрокаШаблонаПустаяПослеЗамены(Вставка) Тогда
		Вставка = "";
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Текст", ТекстДо + Вставка + После);
	Результат.Вставить("ПозицияПослеВставки", СтрДлина(ТекстДо) + СтрДлина(Вставка));
	
	Возврат Результат;
	
КонецФункции

Функция УбратьОдинПереводСтрокиСлева(Текст)
	
	Если СтрНачинаетсяС(Текст, Символы.ВК + Символы.ПС) Тогда
		Возврат Сред(Текст, 3);
	ИначеЕсли СтрНачинаетсяС(Текст, Символы.ПС) Тогда
		Возврат Сред(Текст, 2);
	ИначеЕсли СтрНачинаетсяС(Текст, Символы.ВК) Тогда
		Возврат Сред(Текст, 2);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция УбратьОдинПереводСтрокиСправа(Текст)
	
	Если СтрЗаканчиваетсяНа(Текст, Символы.ВК + Символы.ПС) Тогда
		Возврат Лев(Текст, СтрДлина(Текст) - 2);
	ИначеЕсли СтрЗаканчиваетсяНа(Текст, Символы.ПС) Тогда
		Возврат Лев(Текст, СтрДлина(Текст) - 1);
	ИначеЕсли СтрЗаканчиваетсяНа(Текст, Символы.ВК) Тогда
		Возврат Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция СтрокаШаблонаПустаяПослеЗамены(Текст)
	
	Проверка = СокрЛП(Текст);
	Проверка = СтрЗаменить(Проверка, Символы.ПС, "");
	Проверка = СтрЗаменить(Проверка, Символы.ВК, "");
	Проверка = СтрЗаменить(Проверка, Символы.Таб, "");
	Проверка = СтрЗаменить(Проверка, Символы.НПП, "");
	
	Возврат ПустаяСтрока(Проверка);
	
КонецФункции

#КонецОбласти