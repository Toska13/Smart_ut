#Область ДоработкиСмарт

&ИзменениеИКонтроль("СформироватьСодержаниеДляПечати")
Функция смарт_СформироватьСодержаниеДляПечати(Номенклатура, Характеристика)
	
	#Вставка
	//++ #Б2734 смарт: Шляпников 25.03.2025 / Конструктор КП. - Документ "Коммерческое предложение".
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.смартКонструкторОборудования") Тогда
		Возврат Номенклатура.Наименование;
	КонецЕсли;
	//-- #Б2734 смарт: Шляпников 25.03.2025
	#КонецВставки
	
	НаименованиеНоменклатуры = ?(Пустаястрока(Номенклатура.НаименованиеПолное), Номенклатура.Наименование, Номенклатура.НаименованиеПолное);
	Если ЗначениеЗаполнено(Характеристика) Тогда
		НаименованиеХарактеристики = ?(Пустаястрока(Характеристика.НаименованиеПолное), Характеристика.Наименование, Характеристика.НаименованиеПолное);
	Иначе
		НаименованиеХарактеристики = "";
	КонецЕсли;	
	Содержание = НаименованиеНоменклатуры + ?(Пустаястрока(НаименованиеХарактеристики), "", " ("+НаименованиеХарактеристики+")");
	Возврат Содержание;
КонецФункции

#КонецОбласти