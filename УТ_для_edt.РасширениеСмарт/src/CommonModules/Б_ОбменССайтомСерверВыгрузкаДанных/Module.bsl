	ИначеЕсли ТекСтр.НаименованиеПоля1С = "Высота" тогда
		лЗначение = ИнформациОТоваре.ВысотаБ;
	ИначеЕсли ТекСтр.НаименованиеПоля1С = "Глубина" тогда
