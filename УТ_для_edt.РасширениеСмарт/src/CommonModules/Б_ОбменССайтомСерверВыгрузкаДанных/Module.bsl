Функция ПолучитьТоварыСАкциямиДляВыгрузкиНаСайт(ТЗТоваров = Неопределено)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ВидАкции", Перечисления.смартВидыАкций.ДемоЗал);
	Отбор.Вставить("Организация", Справочники.смартПредопределенныеЗначения.ОрганизацияБитрикс.Значение);
	
	Если НЕ ТЗТоваров = Неопределено Тогда
		Отбор.Вставить("Номенклатура", ТЗТоваров.ВыгрузитьКолонку("Номенклатура"));
	КонецЕсли;
	
	Данные = смартАкцииИСкидки.ПолучитьДействующиеАкции(ТекущаяДата(), Отбор);
	
	Возврат Данные;
	
КонецФункции

//++ #Б6844 смарт: Шляпников 15.05.2026 / Проект smart-t.ru. Акции. Выгрузка товара, представленного в демо-зале
Функция СформироватьИДАкционногоТовараДляВыгрузки(Номенклатура, Склад, Серия)
	
	ИДНоменклатура = "";
	ИДСерия = "";
	ИДСклад = "";
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ИДНоменклатура = СокрЛП(Номенклатура.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Серия) Тогда
		ИДСерия = СокрЛП(Серия.УникальныйИдентификатор());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Склад) Тогда
		ИДСклад = СокрЛП(Склад.УникальныйИдентификатор());
	КонецЕсли;
	
	Возврат СтрШаблон("%1^%2^%3", ИДНоменклатура, ИДСклад, ИДСерия);
	
КонецФункции

