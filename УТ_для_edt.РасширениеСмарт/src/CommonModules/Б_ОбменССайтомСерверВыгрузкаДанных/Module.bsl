	XDTOМаркировкаТип 	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Маркировка", Истина, XDTOМаркировкиТип);

	XDTOГруппаМаркировкиТип	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "ГруппаМаркировки", Истина, XDTOТоварТип);	

	Для каждого ТекНоменклатура из МассивНоменклатуры Цикл 	

		#Удаление
		Если ТекНоменклатура.Отменено Тогда
		#КонецУдаления
		#Вставка
		//++ #1993 смарт: Лопато 02.09.2024 //Обработка онлайн заказов (переделка)  
		Если ТекНоменклатура.Отменено И НЕ Документ.Отменен Тогда
		//-- #1993 смарт: Лопато 02.09.2024
		#КонецВставки
			Продолжить;
		КонецЕсли;

		XDTOТовар	= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOТоварТип);

		#Удаление
		Если ЗначениеЗаполнено(ТекНоменклатура.Характеристика)  тогда
			лИд = XMLСтрока(ТекНоменклатура.ИдентификаторНоменклатуры) + "#" + XMLСтрока(ТекНоменклатура.ИдентификаторХарактеристики); 
