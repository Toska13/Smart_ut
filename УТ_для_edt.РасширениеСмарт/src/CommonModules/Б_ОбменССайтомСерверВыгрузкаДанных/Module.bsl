Функция ПолучитьДанныеКонтакта(ПарамОтбор,КонтрагентОтбора,СправочникОтбор)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	Справочник."+СправочникОтбор+".КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка = &Контрагент
	|И КонтрагентыКонтактнаяИнформация.Вид = &Вид";
	
	//++#1201 смарт: Лопато 03.10.2022 //Не выгружается действующий адрес из контактной информации
	Если УправлениеКонтактнойИнформациейСлужебныйПовтИсп.КонтактнаяИнформацияОбъектаСодержитКолонкуДействуетС(КонтрагентОтбора) Тогда
		Запрос.Текст = Запрос.Текст + "
		|УПОРЯДОЧИТЬ ПО
		|КонтрагентыКонтактнаяИнформация.ДействуетС УБЫВ";
	КонецЕсли;
	//--#1201 смарт: Лопато 03.10.2022
	
	Запрос.УстановитьПараметр("Вид", ПарамОтбор);
	Запрос.УстановитьПараметр("Контрагент", КонтрагентОтбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если  ВыборкаДетальныеЗаписи.Следующий() тогда
		Возврат ВыборкаДетальныеЗаписи.Представление;
	КонецЕсли;
	
	Возврат Неопределено;
	
