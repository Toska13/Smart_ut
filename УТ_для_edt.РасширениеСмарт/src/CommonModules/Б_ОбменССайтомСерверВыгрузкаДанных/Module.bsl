	Б_ОбменССайтомСервер.СообщитьПодробно("Выгрузка складов в XML.", ПараметрыОбмена);
	Итератор = 0;

	XDTOСкладыТип	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Склады", Истина, ВладелецТип);	
