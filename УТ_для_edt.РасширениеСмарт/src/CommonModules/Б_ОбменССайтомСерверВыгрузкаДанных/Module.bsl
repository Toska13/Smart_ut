Функция ПолучениеСтатусаОтгружен(Заказ,Номенклатура)
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|		Выбор КОГДА КОЛИЧЕСТВО(*) > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Отгружен
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.ОстаткиИОбороты(
	|			,
	|			,
	|			Регистратор,
	|			,
	|			ДокументОтгрузки = &Заказ
	|				И Номенклатура = &Номенклатура) КАК ТоварыКОтгрузкеОстаткиИОбороты
	|ГДЕ
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстаткиИОбороты.Регистратор КАК Документ.РасходныйОрдерНаТовары).Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.Отгружен)";
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	РезЗапроса=Запрос.Выполнить();
	Если РезЗапроса.Пустой() тогда
		Возврат ложь;
	КонецЕсли;
	
	Выборка=РезЗапроса.Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.Отгружен 
	КонецЕсли;
	
КонецФункции

Функция ПолучениеСтатусаЧастичноОтгружен(Заказ,Номенклатура)
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ТоварыКОтгрузкеОстаткиИОбороты.КОтгрузкеРасход КАК КОтгрузкеРасход,
	|	ЗаказКлиентаТовары.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ТоварыКОтгрузкеОстаткиИОбороты.КОтгрузкеРасход < ЗаказКлиентаТовары.Количество
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЧастичноОтгружен ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.ОстаткиИОбороты(
	|				,
	|				,
	|				Регистратор,
	|				,
	|				ДокументОтгрузки = &Заказ
	|					И Номенклатура = &Номенклатура) КАК ТоварыКОтгрузкеОстаткиИОбороты
	|		ПО (ЗаказКлиентаТовары.Ссылка = ТоварыКОтгрузкеОстаткиИОбороты.ДокументОтгрузки)
	|			И (ЗаказКлиентаТовары.Номенклатура = ТоварыКОтгрузкеОстаткиИОбороты.Номенклатура)
	|ГДЕ
	|	ВЫРАЗИТЬ(ТоварыКОтгрузкеОстаткиИОбороты.Регистратор КАК Документ.РасходныйОрдерНаТовары).Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыРасходныхОрдеров.Отгружен)
	|И ЗаказКлиентаТовары.Ссылка = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	РезЗапроса=Запрос.Выполнить();
	Если РезЗапроса.Пустой() тогда
		Возврат ложь;
	КонецЕсли;
	
	Выборка=РезЗапроса.Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.ЧастичноОтгружен; 
	КонецЕсли;
	
КонецФункции

Функция ПолучениеСтатусаСрокПоставки(Заказ,Номенклатура)
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ГрафикОтгрузкиТоваровОбороты.Период КАК Период,
	|	ГрафикОтгрузкиТоваровОбороты.Регистратор КАК Регистратор,
	|	ГрафикОтгрузкиТоваровОбороты.Номенклатура КАК Номенклатура,
	|	ГрафикОтгрузкиТоваровОбороты.ДатаОтгрузки КАК ДатаОтгрузки
	|ИЗ
	|	РегистрНакопления.ГрафикОтгрузкиТоваров.Обороты(, , Регистратор, Номенклатура=&Номенклатура) КАК ГрафикОтгрузкиТоваровОбороты
	|ГДЕ
	|	ГрафикОтгрузкиТоваровОбороты.Регистратор = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ",Заказ);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	РезЗапроса=Запрос.Выполнить();
	Если РезЗапроса.Пустой() тогда
		Возврат '00010101';
	КонецЕсли;
	
	Выборка=РезЗапроса.Выбрать();
	Если Выборка.Следующий() тогда
		Возврат Выборка.Период; 
	КонецЕсли;
КонецФункции

