			Владелец.Склады = XDTOСклады;
		КонецЕсли;
	КонецЕсли;
	#КонецУдаления
	#Вставка
	Если ЗапросПоСкладам.Пустой() тогда
		Возврат;
	Иначе
		
		//++ #Б5778 смарт: Шляпников 24.02.2026 / Проект smart-t.ru. Доработать выгрузку складов
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Идентификатор КАК Родитель
		|ИЗ
		|	ВремСклады КАК ВремСклады";
		ЗапросПоСкладам = Запрос.Выполнить();
		
