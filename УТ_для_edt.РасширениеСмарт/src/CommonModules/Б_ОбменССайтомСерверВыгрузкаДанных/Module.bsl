		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Статуса заказа ИД" ,Рез.ИДСтатуса);
	КонецЕсли;	
	
	
	Если Оффлайн Тогда
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Оффлайн заказ" , "Y");
	иначе
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Оффлайн заказ" , "N");//?(ЗначениеЗаполнено(Документ.Объект.смартИдБитрикс),"N","Y"));
	КонецЕсли; 
	
	//++#1261 смарт: Лопато 22.03.2023 //Доработка изменения Заказа клиента для ИМ  
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Контрагент" , XMLстрока(Документ.Объект.Контрагент));
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"НаименованиеКонтрагента" , СокрЛП(Документ.Объект.Контрагент));
	//--#1261 смарт: Лопато 22.03.2023
	
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Партнер" , xmlСтрока(Документ.Объект.Партнер));
	
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Грузополучатель" , ?(ЗначениеЗаполнено(Документ.Объект.Грузополучатель),XMLстрока(Документ.Объект.Грузополучатель),XMLстрока(Документ.Объект.Контрагент)));

	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Ответственный" , Документ.Объект.Менеджер.Наименование);
    
    //++ смарт:Подкин #552 22.09.2022 19:44:17 внес изменения в способы доставки выгружаемые на сайт
    СпособДоставки=Неопределено;
    Если Документ.СпособДоставки=Перечисления.СпособыДоставки.Самовывоз тогда
        СпособДоставки="Самовывоз";
    ИначеЕсли Документ.СпособДоставки=Перечисления.СпособыДоставки.ДоКлиента тогда
        СпособДоставки="Доставка до адреса";
    ИначеЕсли Документ.СпособДоставки=Перечисления.СпособыДоставки.СиламиПеревозчикаПоАдресу тогда
        СпособДоставки="Доставка до терминала транспортной компании";
    КонецЕсли;  
    //-- смарт:Подкин #552 22.09.2022 19:44:17
	
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Способ доставки" , СпособДоставки);
	
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Выбранная доставка" , СпособДоставки);
	
    Если ЗначениеЗаполнено(Документ.Перевозчик) Тогда
        ТК=Справочники.СмартТранспортныеКомпанииБитрикс.НайтиПоРеквизиту("Партнер",Документ.Перевозчик);
        Если ТК<>Справочники.СмартТранспортныеКомпанииБитрикс.ПустаяСсылка() Тогда
           Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Транспортная компания" , XMLСтрока(ТК));
        КонецЕсли; 
    КонецЕсли;
    
	ФормаОплаты=Неопределено;
	//++#1382 смарт: Лопато 11.07.2023 //Заполнение параметров заказа  
	МетодОплатыИд = Неопределено;
	//--#1382 смарт: Лопато 11.07.2023
	Если Документ.ФормаОплаты=Перечисления.ФормыОплаты.Наличная тогда
		//++#1382 смарт: Лопато 11.07.2023 //Заполнение параметров заказа  
		//ФормаОплаты="Оплата наличными";
		ФормаОплаты="Наличными при получении";
		МетодОплатыИд = "1";
		//--#1382 смарт: Лопато 11.07.2023
	ИначеЕсли Документ.ФормаОплаты=Перечисления.ФормыОплаты.ПлатежнаяКарта тогда
		ФормаОплаты="Оплата картой";
	Иначе
		//++#1382 смарт: Лопато 11.07.2023 //Заполнение параметров заказа  
		//ФормаОплаты="Банковский перевод";
		ФормаОплаты="Оплата по счету";
		МетодОплатыИд = "7";
		//--#1382 смарт: Лопато 11.07.2023
	КонецЕсли;

	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Метод оплаты" , ФормаОплаты);
	//++#1382 смарт: Лопато 11.07.2023 //Заполнение параметров заказа  
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"Метод оплаты ИД" , МетодОплатыИд);
	//--#1382 смарт: Лопато 11.07.2023
	
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена,XDTOДокумент.ЗначенияРеквизитов,XDTOЗначениеРеквизитаТип,"ГУИД" , XMLСтрока(Документ.Заказ));
	
	//++#1241 смарт: Лопато 23.01.2023 //Добавить выгрузку реквизита Трек номер
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Идентификатор отправления"	, XMLСтрока(Документ.ИдентификаторОтправленияЗаказ));
	//--#1241 смарт: Лопато 23.01.2023
	
	//++ #Б3686 смарт: Шляпников 03.07.2025 / Проект smart-t.ru. API. Выгрузка "Личный кабинет" 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЗаказовКлиентов.Заказ КАК Заказ,
	|	СостоянияЗаказовКлиентов.смартНаценкаПоДоставкеСумма КАК смартНаценкаПоДоставкеСумма,
	|	ЕСТЬNULL(ДополнительныеСведения.Значение, 0) КАК СтоимостьДоставкиСайта
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ПО СостоянияЗаказовКлиентов.Заказ = ДополнительныеСведения.Объект
	|			И (ДополнительныеСведения.Свойство.Имя = ""СтоимостьДоставки"")
	|ГДЕ
	|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
	
	Запрос.УстановитьПараметр("Заказ", Документ.Объект);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.смартНаценкаПоДоставкеСумма <> 0 Тогда
			СтоимостьДоставки = Выборка.смартНаценкаПоДоставкеСумма;
		Иначе
			СтоимостьДоставки = Выборка.СтоимостьДоставкиСайта;
		КонецЕсли;
		
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOДокумент.ЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Стоимость доставки", XMLСтрока(СтоимостьДоставки));
		
	КонецЕсли;
	//-- #Б3686 смарт: Шляпников 03.07.2025
	#КонецВставки

	Возврат XDTOДокумент;

КонецФункции

&ИзменениеИКонтроль("ВыгрузитьОплатуXDTO")
Функция смарт_ВыгрузитьОплатуXDTO(ПараметрыОбмена, МенеджерВременныхТаблиц, Документ, КоличествоОплат)

	XDTOДокументТип		= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Документ");
	XDTOДокумент		= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOДокументТип);

	XDTOНалогиТип 		= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Налоги"		, Истина, XDTOДокументТип);	
	XDTOНалогТип   		= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Налог"		, Истина, XDTOНалогиТип);

	XDTOКонтрагентыТип	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Контрагенты"	, Истина, XDTOДокументТип);  	
	XDTOКонтрагентТип	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Контрагент"	, Истина, XDTOКонтрагентыТип); 


	XDTOЗначенияРеквизитовТип 	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "ЗначенияРеквизитов", Истина, XDTOДокументТип);
	XDTOЗначениеРеквизитаТип 	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "ЗначениеРеквизита");


	XDTOДокумент.Ид 			= XMLСтрока(Документ.ИдентификаторДокумента);
	XDTOДокумент.Номер1С 		= Документ.Номер;
	XDTOДокумент.Дата1С 		= XMLСтрока(Формат(Документ.Дата,"ДФ=yyyy-MM-dd"));

	#Удаление
	XDTOДокумент.Номер 			= Документ.НомерССайта;
	#КонецУдаления
	#Вставка
	//Смарт {[*](фрагмент ИЗМЕНЕН), Подкин Алексей Иванович 15.10.2020 12:26:09  передаем Ид текущего документа в поле Номер задача 552
	XDTOДокумент.Номер 			= ?(Документ.НомерССайта="",XMLСтрока(Документ.ИдентификаторДокумента),Документ.НомерССайта);
	//Смарт }Подкин Алексей Иванович 15.10.2020 12:26:09
	#КонецВставки

	лДатаВремяЭлДокумента  		= ?(ЗначениеЗаполнено(Документ.ДатаССайта), Документ.ДатаССайта, Дата(1, 1,1, 0,0,1));
	XDTOДокумент.Дата 			= XMLСтрока(Формат(лДатаВремяЭлДокумента,"ДФ=yyyy-MM-dd"));
	XDTOДокумент.Время			= XMLСтрока(Формат(лДатаВремяЭлДокумента,"ДФ=ЧЧ:мм:сс"));	

	XDTOДокумент.ПометкаУдаления= XMLСтрока(Документ.ПометкаУдаления);
	XDTOДокумент.НомерВерсии 	= Б_ОбменССайтомСервер.ПолучитьВерсиюОбъекта(ПараметрыОбмена, Документ.ВерсияДанных, "Документов"); 
	XDTOДокумент.Комментарий 	= Документ.Комментарий;

	КоличествоОплат 			= КоличествоОплат + 1;

	Если Документ.ТипДокумента  = "Оплата безналичными" тогда
		XDTOДокумент.ХозОперация= "Выплата безналичных денег";
	ИначеЕсли Документ.ТипДокумента  = "Оплата наличными" тогда
		XDTOДокумент.ХозОперация= "Выплата наличных денег";	
	ИначеЕсли Документ.ТипДокумента  = "Эквайринг" тогда
		XDTOДокумент.ХозОперация= "Эквайринговая операция";	
	КонецЕсли;

	XDTOДокумент.Основание	= XMLСтрока(Документ.ИдентификаторОснования);

	XDTOДокумент.Роль 			= "Продавец";
	Если НЕ ЗначениеЗаполнено(Документ.ВалютаКод) тогда
		Б_ОбменССайтомСервер.СообщитьПодробно("У документа: " + Документ.Номер + " не заполнена валюта." , ПараметрыОбмена);
	Иначе	
		XDTOДокумент.Валюта			= Лев(Документ.ВалютаКод, 3);
	КонецЕсли;

	XDTOДокумент.Курс			= Формат(Документ.Курс, "ЧЦ=10; ЧДЦ=4; ЧРД=.");
	XDTOДокумент.Сумма			= Формат(Документ.СуммаВзаиморасчетов , ПараметрыОбмена.ФорматСуммы); 


	Если ПараметрыОбмена.ИспользоватьПартнеровИКонтрагентов тогда

		Если Документ.Контрагент <> Null тогда

			XDTOКонтрагенты	= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOКонтрагентыТип);
			XDTOКонтрагенты.Контрагент.Добавить(ВыгрузитьКонтрагентаВДокументXDTO(ПараметрыОбмена, XDTOКонтрагентыТип, Документ.Контрагент));

			XDTOДокумент.Контрагенты 	= XDTOКонтрагенты;
		Иначе
			Б_ОбменССайтомСервер.СообщитьПодробно("Не найден контрагент в документе: " + Строка(Документ.Объект), ПараметрыОбмена);
		КонецЕсли;

	Иначе

		Если Документ.Партнер <> Null тогда

			XDTOКонтрагенты	= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOКонтрагентыТип);
			XDTOКонтрагенты.Контрагент.Добавить(ВыгрузитьКонтрагентаВДокументXDTO(ПараметрыОбмена, XDTOКонтрагентыТип, Документ.Партнер));

			XDTOДокумент.Контрагенты 	= XDTOКонтрагенты;
		Иначе
			Б_ОбменССайтомСервер.СообщитьПодробно("Не найден контрагент в документе: " + Строка(Документ.Объект), ПараметрыОбмена);
		КонецЕсли;

	КонецЕсли;	

	XDTOЗначенияРеквизитов 		= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOЗначенияРеквизитовТип); 

	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Проведен", XMLСтрока(Документ.Проведен));
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Отменен"	, Документ.Отменен);
	Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Оплачен"	, Документ.Оплачен);

	Если Документ.Оплачен Тогда   			
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Номер оплаты по 1С", Документ.Номер);
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Дата оплаты по 1С"	, XMLСтрока(Формат(Документ.Дата,"ДФ=yyyy-MM-dd")));
	КонецЕсли;

	лИдПлатежнойСистемы = "";

	Если ПараметрыОбмена.СоответствиеПлатежныхСистемИКасс <> Неопределено И ЗначениеЗаполнено(Документ.КассаТерминал) тогда 

		Если Документ.ТипДокумента  = "Оплата наличными" ИЛИ Документ.ТипДокумента  = "Эквайринг" тогда

			НайденныйСтатус = ПараметрыОбмена.СоответствиеПлатежныхСистемИКасс.Найти(Документ.КассаТерминал);
			Если НайденныйСтатус <> Неопределено тогда
				лИдПлатежнойСистемы =  НайденныйСтатус.ИдПлатежнойСистемы;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если лИдПлатежнойСистемы = "" И ЗначениеЗаполнено(Документ.ИдМетодаОплатыССайта) тогда
		лИдПлатежнойСистемы = Документ.ИдМетодаОплатыССайта;
	КонецЕсли;

	Если ЗначениеЗаполнено(лИдПлатежнойСистемы) тогда
		Б_ОбменССайтомСервер.ДобавитьЗначениеРеквизитаXDTO(ПараметрыОбмена, XDTOЗначенияРеквизитов, XDTOЗначениеРеквизитаТип, "Метод оплаты ИД"	, лИдПлатежнойСистемы);
	КонецЕсли;

	XDTOДокумент.ЗначенияРеквизитов = XDTOЗначенияРеквизитов;

	Если Документ.ТипДокумента  = "Оплата наличными" ИЛИ Документ.ТипДокумента  = "Эквайринг" 
		И Константы.Б_ИспользоватьМеханизмПечатиЧеков.Получить() И ЗначениеЗаполнено(Документ.НомерССайта) тогда
		ЗаполнитьИнформациюОЧеке(ПараметрыОбмена, МенеджерВременныхТаблиц, XDTOДокумент, Документ, XDTOДокументТип);		
	КонецЕсли;

	Возврат XDTOДокумент;

КонецФункции

&ИзменениеИКонтроль("ЗаписьИОтправкаXMLДанныхНаСайт")
Функция смарт_ЗаписьИОтправкаXMLДанныхНаСайт(ПараметрыОбмена, XDTOКоммерческаяИнформация, ИмяКаталога, ИмяФайла, ПараметрHTTP, Пакет)

