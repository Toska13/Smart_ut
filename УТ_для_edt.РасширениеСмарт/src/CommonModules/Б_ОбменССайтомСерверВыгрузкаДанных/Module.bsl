								XDTOРеквизитСправочника.ТипЗначений = "Булево";	
								XDTOРеквизитСправочника.Наименование = ТекРек.Поле;
							ИначеЕсли ТекРек.Поле = "Владелец" тогда
								XDTOРеквизитСправочника.ТипЗначений = "Строка";	
								XDTOРеквизитСправочника.Наименование = ТекРек.Поле;
