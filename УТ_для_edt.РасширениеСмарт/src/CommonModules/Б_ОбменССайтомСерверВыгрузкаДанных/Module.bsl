//++#1323 смарт: Лопато 02.10.2023 //Восстановить и переделать механизм индивидуальных скидок
Функция ПолучитьМассивДанныхИндивидуальныхСкидокКлиентов(ПараметрыОбмена)
	
	смартВыгружатьИндивидуальныеСкидки = Ложь;
	Если ПараметрыОбмена.Свойство("смартВыгружатьИндивидуальныеСкидки") Тогда
		смартВыгружатьИндивидуальныеСкидки = ПараметрыОбмена.смартВыгружатьИндивидуальныеСкидки;
	КонецЕсли;	

	смартВыгружатьАвтоматическиеСкидки = Ложь;
	Если ПараметрыОбмена.Свойство("смартВыгружатьАвтоматическиеСкидки") Тогда
		смартВыгружатьАвтоматическиеСкидки = ПараметрыОбмена.смартВыгружатьАвтоматическиеСкидки;
	КонецЕсли;	
	
	Если НЕ (смартВыгружатьИндивидуальныеСкидки = Истина ИЛИ смартВыгружатьАвтоматическиеСкидки = Истина) Тогда

		ТаблицаРезультат = Новый ТаблицаЗначений;
		ТаблицаРезультат.Колонки.Добавить("Пакет",						Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(2, 0)));
		ТаблицаРезультат.Колонки.Добавить("ПользовательскийСправочник",	Новый ОписаниеТипов("Число",,, Новый КвалификаторыСтроки(50)));
		ТаблицаРезультат.Колонки.Добавить("Клиент", 					Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
		ТаблицаРезультат.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаРезультат.Колонки.Добавить("ПроцентСкидки", 				Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2)));
		ТаблицаРезультат.Колонки.Добавить("НачалоДействия", 			Новый ОписаниеТипов("Дата"));
		ТаблицаРезультат.Колонки.Добавить("СрокДействия", 				Новый ОписаниеТипов("Дата"));
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
		ТаблицаРезультат.Колонки.Добавить("Комментарий", 				Новый ОписаниеТипов("Строка",,, Новый КвалификаторыСтроки(1000)));
		//-- #1870 смарт: Лопато 25.08.2024
		
		НоваяСтрокаРезультат = ТаблицаРезультат.Добавить();
		НоваяСтрокаРезультат.Пакет 						= 1;
		НоваяСтрокаРезультат.ПользовательскийСправочник = "СмартИндивидуальныеСкидкиКлиентов";
		НоваяСтрокаРезультат.Клиент 					= Справочники.Партнеры.ПустаяСсылка();
		НоваяСтрокаРезультат.Номенклатура 				= Справочники.Номенклатура.ПустаяСсылка();
		НоваяСтрокаРезультат.ПроцентСкидки 				= 0;
		НоваяСтрокаРезультат.НачалоДействия 			= Неопределено;
		НоваяСтрокаРезультат.СрокДействия 				= Неопределено;
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
		НоваяСтрокаРезультат.Комментарий 				= "";
		//-- #1870 смарт: Лопато 25.08.2024
		
		Возврат ТаблицаРезультат;
		
	КонецЕсли;	
	
	ДатаСкидок = ТекущаяДата();

	//МассивНоменклатурыСайта = ТаблицаНоменклатурыСайта.ВыгрузитьКолонку("Объект");
	МассивНоменклатурыСайта = Неопределено;
	
	// Получение индивидуальных скидок
	Если смартВыгружатьИндивидуальныеСкидки = Истина Тогда
		ТаблицаИндивидуальныеСкидкиКлиентов = смартОбщегоНазначения.смартПолучитьИндивидуальныеСкидкиКлиентов(ДатаСкидок, , МассивНоменклатурыСайта);
	Иначе
		ТаблицаИндивидуальныеСкидкиКлиентов = Новый ТаблицаЗначений;
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("Клиент", 						Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("ПроцентАвтоматическойСкидки",	Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2)));
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("НачалоДействия", 				Новый ОписаниеТипов("Дата"));
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("СрокДействия", 				Новый ОписаниеТипов("Дата"));
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
		ТаблицаИндивидуальныеСкидкиКлиентов.Колонки.Добавить("Комментарий", 				Новый ОписаниеТипов("Строка",,, Новый КвалификаторыСтроки(1000)));
		//-- #1870 смарт: Лопато 25.08.2024
	КонецЕсли;
	
	// Получение автоматических скидок
	ТаблицаАвтоматическиеСкидкиКлиентов = Новый ТаблицаЗначений;
	ТаблицаАвтоматическиеСкидкиКлиентов.Колонки.Добавить("Клиент", 						Новый ОписаниеТипов("СправочникСсылка.Партнеры"));
	ТаблицаАвтоматическиеСкидкиКлиентов.Колонки.Добавить("Номенклатура", 				Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаАвтоматическиеСкидкиКлиентов.Колонки.Добавить("ПроцентАвтоматическойСкидки",	Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2)));
	
	Если смартВыгружатьАвтоматическиеСкидки = Истина Тогда
	
		// Рассчитываем автоматические скидки только по дилерам
		ДилерскийСегмент = Справочники.СегментыПартнеров.НайтиПоКоду("ЦБ-00000003");
		МассивПартнеровСегмента = СегментыСервер.МассивЭлементов(ДилерскийСегмент);

		СтруктураРасчета = Новый Структура("ТолькоПредварительныйРасчет, ВосстанавливатьУправляемыеСкидки, ПрименятьКОбъекту", Ложь, Истина, Истина);
		
		// Подготовка документа заказа для расчета
		ЗаказКлиентаОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
		ЗаказКлиентаОбъект.Дата       = ДатаСкидок;

		Для Каждого ЭлементНоменклатуры Из МассивНоменклатурыСайта Цикл
			
			СтрокаТовары = ЗаказКлиентаОбъект.Товары.Добавить();
			
			СтрокаТовары.Номенклатура 		= ЭлементНоменклатуры;
			СтрокаТовары.Количество 		= 1;
			СтрокаТовары.КоличествоУпаковок = 1; 
			СтрокаТовары.Цена 				= 1;
			СтрокаТовары.Сумма 				= 1; 
			СтрокаТовары.СуммаСНДС 			= 1;
			
		КонецЦикла;	

		ТЗТовары = ЗаказКлиентаОбъект.Товары.Выгрузить();
		
		// Выбираем все действующие соглашения с клиентами, которые ссылаются на дилерский сегмент
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоглашенияСКлиентами.Ссылка КАК Ссылка,
		|	СоглашенияСКлиентами.ВидЦен КАК ВидЦен,
		|	СоглашенияСКлиентами.ВидЦен.ВалютаЦены КАК ВалютаЦены
		|ИЗ
		|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
		|ГДЕ
		|	СоглашенияСКлиентами.СегментПартнеров = &ДилерскийСегмент
		|	И СоглашенияСКлиентами.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСоглашенийСКлиентами.Действует)";
		
		Запрос.УстановитьПараметр("ДилерскийСегмент", ДилерскийСегмент);
		
		РезультатСоглашений = Запрос.Выполнить();
	    ВыборкаСоглашений = РезультатСоглашений.Выбрать();
		
		Пока ВыборкаСоглашений.Следующий() Цикл

			ЗаказКлиентаОбъект.Соглашение = ВыборкаСоглашений.Ссылка; 
			ЗаказКлиентаОбъект.Валюта	  = ВыборкаСоглашений.ВалютаЦены;
			
			// Вид цены из соглашения
			ТЗТовары.ЗаполнитьЗначения(ВыборкаСоглашений.ВидЦен, "ВидЦены");
			ЗаказКлиентаОбъект.Товары.Загрузить(ТЗТовары);
			
			Для Каждого ВыбранныйПартнер Из МассивПартнеровСегмента Цикл
			
				ЗаказКлиентаОбъект.Партнер = ВыбранныйПартнер;
				
				// Расчет автоматических скидок
				СкидкиРассчитаны = СкидкиНаценкиСервер.РассчитатьПоЗаказуКлиента(ЗаказКлиентаОбъект, СтруктураРасчета);
				
				// Добавляем скидки клиента в итоговую таблицу автоматических скидок
				Для Каждого СтрокаТовары Из ЗаказКлиентаОбъект.Товары Цикл

					Если СтрокаТовары.ПроцентАвтоматическойСкидки <> 0 Тогда

						НоваяСтрокаСкидки = ТаблицаАвтоматическиеСкидкиКлиентов.Добавить();

						НоваяСтрокаСкидки.Клиент 					  = ВыбранныйПартнер;
						НоваяСтрокаСкидки.Номенклатура 				  = СтрокаТовары.Номенклатура; 
						НоваяСтрокаСкидки.ПроцентАвтоматическойСкидки = СтрокаТовары.ПроцентАвтоматическойСкидки;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;

		КонецЦикла;
		
	КонецЕсли;
	
	// Формируем таблицу результата
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИндСкидки.Клиент КАК Клиент,
	|	ИндСкидки.Номенклатура КАК Номенклатура,
	|	ИндСкидки.ПроцентСкидки КАК ПроцентСкидки,
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
	|	ИндСкидки.Комментарий КАК Комментарий,
		//-- #1870 смарт: Лопато 25.08.2024
	|	ИндСкидки.НачалоДействия КАК НачалоДействия,
	|	ИндСкидки.СрокДействия КАК СрокДействия
	|ПОМЕСТИТЬ ВТ_ИндСкидки
	|ИЗ
	|	&ТаблицаИндивидуальныеСкидкиКлиентов КАК ИндСкидки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Клиент,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АвтоСкидки.Клиент КАК Клиент,
	|	АвтоСкидки.Номенклатура КАК Номенклатура,
	|	АвтоСкидки.ПроцентАвтоматическойСкидки
	|ПОМЕСТИТЬ ВТ_АвтоСкидки_Исх
	|ИЗ
	|	&ТаблицаАвтоматическиеСкидкиКлиентов КАК АвтоСкидки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Клиент КАК Клиент,
	|	Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ПроцентАвтоматическойСкидки) КАК ПроцентАвтоматическойСкидки
	|ПОМЕСТИТЬ ВТ_АвтоСкидки
	|ИЗ
	|	ВТ_АвтоСкидки_Исх
	|
	|СГРУППИРОВАТЬ ПО
	|	Клиент,
	|	Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Клиент,
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ВТ_ИндСкидки.Клиент, ВТ_АвтоСкидки.Клиент) КАК Клиент,
	|	ЕСТЬNULL(ВТ_ИндСкидки.Номенклатура, ВТ_АвтоСкидки.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(ВТ_ИндСкидки.ПроцентСкидки, 0) КАК ПроцентСкидки,
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
	|	ЕСТЬNULL(ВТ_ИндСкидки.Комментарий, """") КАК Комментарий,
		//-- #1870 смарт: Лопато 25.08.2024
	|	ЕСТЬNULL(ВТ_ИндСкидки.НачалоДействия, НЕОПРЕДЕЛЕНО) КАК НачалоДействия,
	|	ЕСТЬNULL(ВТ_ИндСкидки.СрокДействия, НЕОПРЕДЕЛЕНО) КАК СрокДействия,
	|	ЕСТЬNULL(ВТ_АвтоСкидки.ПроцентАвтоматическойСкидки, 0) КАК ПроцентАвтоматическойСкидки
	|ПОМЕСТИТЬ ВТ_СкидкиВсе
	|ИЗ
	|	ВТ_ИндСкидки КАК ВТ_ИндСкидки
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_АвтоСкидки КАК ВТ_АвтоСкидки
	|		ПО ВТ_ИндСкидки.Клиент = ВТ_АвтоСкидки.Клиент
	|			И ВТ_ИндСкидки.Номенклатура = ВТ_АвтоСкидки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1 КАК Пакет,
	|	""СмартИндивидуальныеСкидкиКлиентов"" КАК ПользовательскийСправочник,
	|	Клиент КАК Клиент,
	|	Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ПроцентАвтоматическойСкидки > ПроцентСкидки
	|			ТОГДА ПроцентАвтоматическойСкидки
	|		ИНАЧЕ ПроцентСкидки
	|	КОНЕЦ КАК ПроцентСкидки,
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
	|	Комментарий КАК Комментарий,
		//-- #1870 смарт: Лопато 25.08.2024
	|	НачалоДействия КАК НачалоДействия,
	|	СрокДействия КАК СрокДействия
	|ИЗ
	|	ВТ_СкидкиВсе
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пакет,
	|	ПользовательскийСправочник,
	|	Клиент,
	|	Номенклатура,
	|	ПроцентСкидки
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ТаблицаИндивидуальныеСкидкиКлиентов", ТаблицаИндивидуальныеСкидкиКлиентов);
	Запрос.УстановитьПараметр("ТаблицаАвтоматическиеСкидкиКлиентов", ТаблицаАвтоматическиеСкидкиКлиентов);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить(); 
	
	Если ТаблицаРезультат.Количество() = 0 Тогда
		
		НоваяСтрокаРезультат = ТаблицаРезультат.Добавить();
		НоваяСтрокаРезультат.Пакет 						= 1;
		НоваяСтрокаРезультат.ПользовательскийСправочник = "СмартИндивидуальныеСкидкиКлиентов";
		НоваяСтрокаРезультат.Клиент 					= Справочники.Партнеры.ПустаяСсылка();
		НоваяСтрокаРезультат.Номенклатура 				= Справочники.Номенклатура.ПустаяСсылка();
		НоваяСтрокаРезультат.ПроцентСкидки 				= 0;
		НоваяСтрокаРезультат.НачалоДействия 			= Неопределено;
		НоваяСтрокаРезультат.СрокДействия 				= Неопределено;
		//++ #1870 смарт: Лопато 25.08.2024 //Доработать механизм выгрузки индивидуальных скидок  
		НоваяСтрокаРезультат.Комментарий 				= "";
		//-- #1870 смарт: Лопато 25.08.2024

	КонецЕсли;
	
	Возврат ТаблицаРезультат;	
	 
КонецФункции //--#1323 смарт: Лопато 02.10.2023

//++#1763 смарт: Лопато 15.04.2024 //Выгрузка КИ менеджеров в ИМ  
Функция смартПолучитьТелефонПользователяДляСайта(ПользовательСсылка)

	ТелефонПользователя = "";
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ПользовательСсылка", ПользовательСсылка);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Ссылка КАК Пользователь,
	|	КонтактнаяИнформация.Вид КАК Вид,
	|	КонтактнаяИнформация.Представление КАК Представление
	|ПОМЕСТИТЬ ВТ_КонтактнаяИнформация
	|ИЗ
	|	Справочник.Пользователи.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &ПользовательСсылка
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_КонтактнаяИнформация.Пользователь КАК Пользователь,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(КИ_МобильныйТелефон.Представление, """") <> """"
	|			ТОГДА КИ_МобильныйТелефон.Представление
	|		КОГДА ЕСТЬNULL(КИ_Телефон.Представление, """") <> """"
	|			ТОГДА КИ_Телефон.Представление
	|		КОГДА ЕСТЬNULL(КИ_РабочийТелефон.Представление, """") <> """"
	|			ТОГДА ВЫБОР
	|					КОГДА ДЛИНАСТРОКИ(ЕСТЬNULL(КИ_РабочийТелефон.Представление, """")) > 3
	|						ТОГДА КИ_РабочийТелефон.Представление
	|					ИНАЧЕ ""+7 (495) 663-91-11 (доб. "" + КИ_РабочийТелефон.Представление + "")""
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерТелефона
	|ИЗ
	|	ВТ_КонтактнаяИнформация КАК ВТ_КонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтактнаяИнформация КАК КИ_МобильныйТелефон
	|		ПО (КИ_МобильныйТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.CRM_МобильныйТелефонПользователя))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтактнаяИнформация КАК КИ_Телефон
	|		ПО (КИ_Телефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПользователя))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КонтактнаяИнформация КАК КИ_РабочийТелефон
	|		ПО (КИ_РабочийТелефон.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.смартРабочийТелефон))";
	
	ВыборкаРезультата = Запрос.Выполнить().Выбрать();

	Если ВыборкаРезультата.Следующий() Тогда
		
		ТелефонПользователя = ВыборкаРезультата.НомерТелефона;
		
	КонецЕсли;	
	
	Возврат ТелефонПользователя;
	
КонецФункции //--#1763 смарт: Лопато 15.04.2024

//Смарт {[+](фрагмент ДОБАВЛЕН), Подкин Алексей Иванович 23.03.2021 10:58:13 подменяется ИД контрагента на ИД контактного лица задача 552
Функция ВыгрузитьКонтрагентаВДокументXDTOсПодменойНаКонтактное(ПараметрыОбмена, ВладелецТип, Покупатель, КонтактноеЛ)
	
	XDTOКонтрагентТип				= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Контрагент", Истина, ВладелецТип); 
	
	XDTOКонтактнаяИнформацияТип 	= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "КонтактнаяИнформация");
	XDTOКонтактТип 					= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Контакт", Истина, XDTOКонтактнаяИнформацияТип);
	
	XDTOПредставителиТип 			= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Представители", Истина, XDTOКонтрагентТип);
	XDTOПредставительТип 			= Б_ОбменССайтомСервер.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Представитель");
	
	XDTOКонтрагент	= ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOКонтрагентТип); 
	
	МенеджерВременныхТаблицКонтрагентов = Новый МенеджерВременныхТаблиц;
	
	ОбщийЗапрос = Новый Запрос;
	ОбщийЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицКонтрагентов;
	
	ОбщийЗапрос.УстановитьПараметр("Покупатель",Покупатель);
	
	Если ПараметрыОбмена.ИспользоватьПартнеровИКонтрагентов тогда
		
		НачалоЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Покупатель.Ссылка КАК Контрагент,
		|	ВЫБОР
		|		КОГДА Покупатель.Б_Идентификатор = """"
		|			ТОГДА Покупатель.Ссылка
		|		ИНАЧЕ Покупатель.Б_Идентификатор
		|	КОНЕЦ КАК Идентификатор
		|ПОМЕСТИТЬ ВремКонтрагенты
		|ИЗ
		|	Справочник.Контрагенты КАК Покупатель
		|ГДЕ
		|	Покупатель.Ссылка = &Покупатель
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
	Иначе
		
		НачалоЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Покупатель.Ссылка КАК Партнер
		|ПОМЕСТИТЬ ВремПартнеры
		|ИЗ
		|	Справочник.Партнеры КАК Покупатель
		|ГДЕ
		|	Покупатель.Ссылка = &Покупатель
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Партнер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Контрагент,
		|	ВЫБОР
		|		КОГДА Контрагенты.Б_Идентификатор = """"
		|			ТОГДА Контрагенты.Ссылка
		|		ИНАЧЕ Контрагенты.Б_Идентификатор
		|	КОНЕЦ КАК Идентификатор
		|
		|ПОМЕСТИТЬ ВремКонтрагенты
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремПартнеры КАК ВремПартнеры
		|		ПО (ВремПартнеры.Партнер = Контрагенты.Партнер)
		|ГДЕ
		|	Контрагенты.Партнер В
		|			(ВЫБРАТЬ
		|				ВремПартнеры.Партнер
		|			ИЗ
		|				ВремПартнеры)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|";
		
	КонецЕсли;
	
	КонецЗапроса = "ВЫБРАТЬ
	|	БанковскиеСчетаКонтрагентов.НомерСчета,
	|	БанковскиеСчетаКонтрагентов.Банк,
	|	БанковскиеСчетаКонтрагентов.Банк.Код КАК БИКБанка,
	|	БанковскиеСчетаКонтрагентов.Банк.КоррСчет КАК КоррСчетБанка,
	|	БанковскиеСчетаКонтрагентов.Банк.Адрес КАК АдресБанка,
	|	БанковскиеСчетаКонтрагентов.Банк.Город КАК ГородБанка,
	|	БанковскиеСчетаКонтрагентов.БанкДляРасчетов,
	|	БанковскиеСчетаКонтрагентов.БанкДляРасчетов.Код КАК БИКБанкаДляРасчетов,
