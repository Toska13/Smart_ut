&ИзменениеИКонтроль("ПолучитьТаблицуДанныхДляПакетовКонтейнеровДокументов")
Функция смарт_ПолучитьТаблицуДанныхДляПакетовКонтейнеровДокументов(ПараметрыОбмена, Операция)

	Запрос = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, ПараметрыОбмена.СтруктураСхемКомпоновки.Заказы, ПараметрыОбмена.НастройкиКомпоновкиДанныхЗаказов, ПараметрыОбмена.ПолнаяВыгрузка, Неопределено);
	#Вставка
	//++ смарт:Подкин #1189 21.09.2022 14:54:13 обор заказов где Заказ.Контрагент.Партнер = Партнер
    Запрос.Текст = СтрЗаменить( Запрос.Текст,"КАК ЗаказКлиента
    |ГДЕ","КАК ЗаказКлиента ГДЕ ЗаказКлиента.Партнер = ЗаказКлиента.Контрагент.Партнер И ");
    //-- смарт:Подкин #1189 21.09.2022 14:54:13
	#КонецВставки
	ТаблицаВыгрузкиЗаказов = Запрос.Выполнить().Выгрузить();

	ТаблицаВыгрузкиОплат 	= ТаблицаВыгрузкиЗаказов.СкопироватьКолонки();
	ТаблицаВыгрузкиОтгрузок = ТаблицаВыгрузкиЗаказов.СкопироватьКолонки();

	Если ПараметрыОбмена.ВыгрузкаОплат тогда

		Запрос = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, ПараметрыОбмена.СтруктураСхемКомпоновки.Оплаты, ПараметрыОбмена.НастройкиКомпоновкиДанныхОплат, ПараметрыОбмена.ПолнаяВыгрузка, Неопределено);
		ТаблицаВыгрузкиОплат = Запрос.Выполнить().Выгрузить();

	КонецЕсли;

	Если ПараметрыОбмена.ВыгрузкаОтгрузок тогда

		Запрос = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, ПараметрыОбмена.СтруктураСхемКомпоновки.Отгрузки, ПараметрыОбмена.НастройкиКомпоновкиДанныхОтгрузок, ПараметрыОбмена.ПолнаяВыгрузка, Неопределено);
		ТаблицаВыгрузкиОтгрузок = Запрос.Выполнить().Выгрузить();

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("ВыгружаемыеЗаказыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеЗаказыПоОтборам);
	Запрос.УстановитьПараметр("ВыгружаемыеОплатыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам);
	Запрос.УстановитьПараметр("ВыгружаемыеОтгрузкиПоОтборам"	, ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам);

	Запрос.УстановитьПараметр("ИспользоватьОтборПоЗаказам"		, ?(ПараметрыОбмена.ВыгружаемыеЗаказыПоОтборам = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("ИспользоватьОтборПоОплатам"		, ?(ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("ИспользоватьОтборПоОтгрузкам"	, ?(ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам = Неопределено, Ложь, Истина));

	Запрос.Текст = "ВЫБРАТЬ
	|	ВремЗаказы.Объект,
	|	ВремЗаказы.Заказ,
	|	ВремЗаказы.ТипОбъекта
	|ПОМЕСТИТЬ ВремЗаказы
	|ИЗ
	|	&ВремЗаказы КАК ВремЗаказы
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремЗаказы.Объект В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремОплаты.Объект,
	|	ВремОплаты.Заказ,
	|	ВремОплаты.ТипОбъекта
	|ПОМЕСТИТЬ ВремОплаты
	|ИЗ
	|	&ВремОплаты КАК ВремОплаты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОплатам
	|				ТОГДА  ВремОплаты.Объект В (&ВыгружаемыеОплатыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|И
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремОплаты.Заказ В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремОтгрузки.Объект,
	|	ВремОтгрузки.Заказ,
	|	ВремОтгрузки.ТипОбъекта
	|ПОМЕСТИТЬ ВремОтгрузки
	|ИЗ
	|	&ВремОтгрузки КАК ВремОтгрузки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОтгрузкам
	|				ТОГДА  ВремОтгрузки.Объект В (&ВыгружаемыеОтгрузкиПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|И
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремОтгрузки.Заказ В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
