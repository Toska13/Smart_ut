			СтрокаКаталога = СтрокаКаталога + 1;	
			Б_ОбменССайтомСервер.СообщитьПодробно("Выгрузка пакета свойства каталога: " + СтрокаТаблицыКаталогов.Каталог + " завершена.", ПараметрыОбмена, Истина);

