
#Область ПрограммныйИнтерфейс

&После("ВыполнитьПереопределяемуюКоманду")
Процедура смарт_ВыполнитьПереопределяемуюКоманду(Форма, Команда, ДополнительныеПараметры)

	//++#1323 смарт: Лопато 31.10.2023 //Восстановить и переделать механизм индивидуальных скидок
	Если Форма.ИмяФормы = "Справочник.СоглашенияСКлиентами.Форма.ФормаСпискаТиповыхСоглашений" Тогда
		
		Если Команда.Имя = "смартМаксимальныйПроцентИндивидуальнойРучнойСкидки" Тогда
			смартОбщегоНазначения.смартЗаписатьМаксимальныйПроцентРучнойСкидки(Форма.смартМаксимальныйПроцентИндивидуальнойРучнойСкидки);
		КонецЕсли;
		
	КонецЕсли;	

	Если СтрНайти(Команда.Имя, "смартИнформация_") <> 0 Тогда
		
		ИнформацияЗаголовок = "";
		ИнформацияТекст = "";	
		
		Если СтрНайти(Команда.Имя, "смартМаксимальныйПроцентИндивидуальнойРучнойСкидки") <> 0 Тогда

			ИнформацияЗаголовок = "Максимальный процент индивидуальной ручной скидки";

			ИнформацияТекст = СтроковыеФункцииКлиент.ФорматированнаяСтрока(
				НСтр("ru = 'В поле <b>Максимальный процент индивидуальной ручной скидки</b> указывается максимальный процент скидки, действующий на все индивидуальные скидки клиентов.'")
				);

		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИнформацияЗаголовок) И ЗначениеЗаполнено(ИнформацияТекст) Тогда
			ОткрытьФорму("ОбщаяФорма.смартФормаИнформацияПоДоработкам", Новый Структура("Заголовок, Информация", ИнформацияЗаголовок, ИнформацияТекст), Форма);
		КонецЕсли;
		
	КонецЕсли;
	//--#1323 смарт: Лопато 31.10.2023
	
	//++ #Б-1434 смарт: Лопато 22.11.2024 //Изменить представление наименования ссылки на Заявку на гарантийный ремонт  
	Если Форма.ИмяФормы = "Документ.ЗаказПоставщику.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ВозвратТоваровПоставщику.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаВнутреннееПотребление.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ВнутреннееПотреблениеТоваров.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ЗаказНаПеремещение.Форма.ФормаДокумента" 
		ИЛИ Форма.ИмяФормы = "Документ.ПеремещениеТоваров.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.ПриходныйОрдерНаТовары.Форма.ФормаДокумента"
		ИЛИ Форма.ИмяФормы = "Документ.РасходныйОрдерНаТовары.Форма.ФормаДокумента" Тогда

		Если Команда.Имя = "ТоварысмартНомерЗаявкиНаГарантийныйРемонтСсылка" Тогда

			ИмяТЧ = ?(Форма.ИмяФормы = "Документ.РасходныйОрдерНаТовары.Форма.ФормаДокумента", "ТоварыПоРаспоряжениям", "Товары");
			
			ТекущиеДанные = Форма.Элементы[ИмяТЧ].ТекущиеДанные;
		
			Если ТекущиеДанные <> Неопределено Тогда
				
				СоответствиеПредставленийЗаявок = 
					смартОбщегоНазначения.СоответствияПредставленийЗаявокНаГарантийныйРемонт(ТекущиеДанные.смартНомерЗаявкиНаГарантийныйРемонтСсылка);
					
				ТекущиеДанные.смартНомерЗаявкиНаГарантийныйРемонтСсылкаПредставление = 
					СоответствиеПредставленийЗаявок[ТекущиеДанные.смартНомерЗаявкиНаГарантийныйРемонтСсылка];
				
			КонецЕсли;	

		КонецЕсли;	
			
	КонецЕсли;
	//-- #Б-1434 смарт: Лопато 22.11.2024
	
КонецПроцедуры

#КонецОбласти