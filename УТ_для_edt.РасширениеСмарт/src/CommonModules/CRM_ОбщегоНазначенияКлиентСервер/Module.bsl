// Процедура обновления таблицы формы в попытке
// программное обновление скрытой пользователем таблицы приводит к ошибке
Процедура ОбновлениеТаблицыФормы(Элемент) Экспорт

	Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
		// BSLLS:MissingCodeTryCatchEx-off
		Попытка
			Элемент.Обновить();
		Исключение
			// Обработка исключения не требуется
		КонецПопытки;
		// BSLLS:MissingCodeTryCatchEx-on
	Иначе	
		Элемент.Обновить();
	КонецЕсли;
	
КонецПроцедуры

// -Рарус alexpr
