// Рефакторинг. Перенес из модуля формы.
&Вместо("КонтактныеЛицаВыбор")
Процедура смарт_КонтактныеЛицаВыбор(Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	//++ #1448 смарт: Ермаков 26.09.2023 //Копировать КИ контактного лица
	Если Форма.ИмяФормы = "Справочник.Партнеры.Форма.CRM_Модуль_ФормаЭлементаРеквизитыКонтрагентаНовая" Тогда
		
		// На форме, при попытке нажать на поле контактной информации, делаем возможность ее скопировать
		// или воспользоваться (позвонить, написать письмо)
		
		Если СтандартнаяОбработка = Неопределено Тогда
			
			ПродолжитьВызов(Форма, Элемент, ВыбраннаяСтрока, Поле, Истина);
			Возврат;
			
		КонецЕсли;
		
		СписокКнопокДиалогаВопрос = Новый СписокЗначений;
		СписокКнопокДиалогаВопрос.Добавить("СкопироватьКИ", "Копировать"); 
		
		Если СтрНайти(Поле.Имя, "АдресЭлектроннойПочты") > 0 Тогда 
		
			СписокКнопокДиалогаВопрос.Добавить("Открыть", "Отправить сообщение");  
			СтандартнаяОбработка = Ложь;     
			
		ИначеЕсли СтрНайти(Поле.Имя, "Телефон") > 0 Тогда 
			
			СписокКнопокДиалогаВопрос.Добавить("Открыть", "Позвонить");
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли;
		
		Если Не СтандартнаяОбработка Тогда
			
			СписокКнопокДиалогаВопрос.Добавить("Отмена");
			
			ПараметрыОповещения = Новый Структура("Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка", Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
			Оповещение = Новый ОписаниеОповещения("смартКопированиеКИВопросЗавершение", CRM_КлиентыКлиент, ПараметрыОповещения);
			
			ПоказатьВопрос(Оповещение, НСтр("ru = 'Выберите вариант'"), СписокКнопокДиалогаВопрос, , "Отмена"); 
			
		Иначе 
			ПродолжитьВызов(Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);	
		КонецЕсли;
	//-- #1448 смарт: Ермаков 26.09.2023 //Копировать КИ контактного лица	
	Иначе
		ПродолжитьВызов(Форма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	КонецЕсли;
	
	
КонецПроцедуры
//-- #1448 смарт: Ермаков 26.09.2023 //Копировать КИ контактного лица

//++ #1448 смарт: Ермаков 26.09.2023 //Копировать КИ контактного лица
// Рефакторинг. Перенес из модуля формы
Процедура смартКопированиеКИВопросЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ="Открыть" Тогда
		
		// Так как вызываем ту же процедуру, откуда пришли, параметр СтандартнаяОбработка равняем на Неопределено
		CRM_КлиентыКлиент.КонтактныеЛицаВыбор(ДополнительныеПараметры.Форма, ДополнительныеПараметры.Элемент,
													ДополнительныеПараметры.ВыбраннаяСтрока, ДополнительныеПараметры.Поле, 
													Неопределено);
													
	ИначеЕсли Ответ="СкопироватьКИ" Тогда
													
		СистемнаяИнформация = Новый СистемнаяИнформация;
		Если СистемнаяИнформация.ТипПлатформы=ТипПлатформы.Windows_x86 Или СистемнаяИнформация.ТипПлатформы=ТипПлатформы.Windows_x86_64 Тогда
			
			ТекстДляВставки="";
			Если Не ДополнительныеПараметры.Поле.Имя = СтрЗаменить(ДополнительныеПараметры.Поле.Имя,"АдресЭлектроннойПочты", "") Тогда
				ТекстДляВставки = ДополнительныеПараметры.Элемент.ТекущиеДанные.КИТипаАдресЭлектроннойПочты;
			ИначеЕсли Не ДополнительныеПараметры.Поле.Имя = СтрЗаменить(ДополнительныеПараметры.Поле.Имя,"Телефон", "") Тогда   
				ТекстДляВставки = ДополнительныеПараметры.Элемент.ТекущиеДанные.КИТипаТелефон
			КонецЕсли;
			
			ЭлектронноеВзаимодействиеСлужебныйКлиент.СкопироватьВБуферОбмена(ТекстДляВставки,"Скопировано");
			
		КонецЕсли;	

	КонецЕсли;		
	
КонецПроцедуры
//++ #1448 смарт: Ермаков 26.09.2023 //Копировать КИ контактного лица