Функция смартОбработкаМетодовPOST(ПараматрыВходящие) экспорт
	
	Если ПараматрыВходящие.ИмяМетода="mov" тогда
		Возврат СоздатьДокументПеремещения(ПараматрыВходящие);
	ИначеЕсли ПараматрыВходящие.ИмяМетода="implem" тогда
		Возврат ВыгрузитьДокументРеализации(ПараматрыВходящие);
	ИначеЕсли ПараматрыВходящие.ИмяМетода="offset" тогда
		Возврат СоздатьДокКорректировкиСписания(ПараматрыВходящие); 
	ИначеЕсли ПараматрыВходящие.ИмяМетода="operation" тогда
		Возврат СоздатьДокКорректировкиРегистров(ПараматрыВходящие);
	//++ #Б5136 смарт: Шляпников 27.01.2026 / Маркировка радиоэлектронной продукции. Синхронизация данных. Приемка товара.
	ИначеЕсли ПараматрыВходящие.ИмяМетода="universaldata" тогда
		Возврат ЗагрузитьДанныеЧерезУниверсальныйОбменДанными(ПараматрыВходящие);
	//-- #Б5136 смарт: Шляпников 27.01.2026
	КонецЕсли;
		
КонецФункции // смартОбработкаМетодовPOST()

Функция СоздатьДокументПеремещения(ПараматрыВходящие)
	СтруктураОтвет = Новый Структура("ДанныеОтвета,Отработало,ТекстОшибки,КодОтвета","",Истина,"",200);	
	ТекстОшибки="";
	ТекстУспех="";
	//1.десериализуем данные о клиенте из JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ПараматрыВходящие.ТелоЗапроса);
	ДанныеНоменклатуры = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	//2. Задаем значения реквизитам поиска
	ОтправительИНН=ПараматрыВходящие.ПараметрыЗапроса.Получить("INNout");
	ПолучательИНН=ПараматрыВходящие.ПараметрыЗапроса.Получить("INNin");
	ДатаФормирования =Дата(ПараматрыВходящие.ПараметрыЗапроса.Получить("Data"));
	
	ТЗноменклатура=Новый ТаблицаЗначений;
	ТЗноменклатура.Колонки.Добавить("Код",ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповСтроки(20));
	ТЗноменклатура.Колонки.Добавить("Наименование",ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповСтроки(200));
	ТЗноменклатура.Колонки.Добавить("Количество",ОбщегоНазначенияБПКлиентСервер.ПолучитьОписаниеТиповЧисла(15,3));
	Для Каждого СтрМасс из ДанныеНоменклатуры Цикл
		НоваяСтрока=ТЗноменклатура.Добавить(); 
		НоваяСтрока.Код= СтрМасс.код;
		НоваяСтрока.Наименование=СтрМасс.Номенклатура;
		НоваяСтрока.Количество=СтрМасс.Количество;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Наименование КАК Наименование,
	|	ТЗ.Код КАК Код,
	|	ТЗ.Количество КАК Количество
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	ВременнаяТаблица.Количество КАК Количество
	|ПОМЕСТИТЬ СписокНоменклатуры
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ВременнаяТаблица.Наименование = Номенклатура.Наименование
	|			И ВременнаяТаблица.Код = Номенклатура.Код
	|			И (НЕ Номенклатура.ЭтоГруппа)
	|			И (НЕ Номенклатура.ПометкаУдаления)
	|";
	Запрос.УстановитьПараметр("ТЗ",ТЗноменклатура);
	РезультатЗапроса=Запрос.ВыполнитьПакет();
	ТЗСписокСписания=ВывестиРезультатМенеджераВременныхТаблиц(Запрос.МенеджерВременныхТаблиц, "СписокНоменклатуры");
	
	Если ТЗСписокСписания.Количество()<0 тогда
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,405,"Не найдена номенклатура в УТ",ложь,"");
		Возврат СтруктураОтвет;
	КонецЕсли;
	
	Запрос.Текст=
	"ВЫБРАТЬ
	|	ТоварыОрганизацийОстатки.КоличествоОстаток КАК Количество,
	//++ смарт:ММ #016 161 23.01.2020 - обновление 11.4.7.150
	//|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Склад КАК Склад,
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.МестоХранения КАК Склад,
	//-- смарт:ММ 23.01.2020
	|	ТоварыОрганизацийОстатки.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ТоварыОрганизаций.Остатки(
	|			&Период,
	|			Организация.ИНН = &ОрганизацияИНН
	|				И АналитикаУчетаНоменклатуры.Номенклатура.Ссылка В
	|					(ВЫБРАТЬ
	|						СписокНоменклатуры.Номенклатура
	|					ИЗ
	|						СписокНоменклатуры КАК СписокНоменклатуры)) КАК ТоварыОрганизацийОстатки
	|ИТОГИ
	|	СУММА(Количество)
	|ПО
	|	Склад";
	
	Запрос.УстановитьПараметр("ОрганизацияИНН", ОтправительИНН);
	Запрос.УстановитьПараметр("Период", Новый Граница(ДатаФормирования,ВидГраницы.Включая));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() тогда
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,405,"Не найдены остатки в УТ",ложь,"");
		Возврат СтруктураОтвет;
	КонецЕсли;
	
	//Получение вида цены по наименованию
	ЗапросВидЦены=Новый Запрос; 
	ЗапросВидЦены.Текст="ВЫБРАТЬ
	|	ВидыЦен.Ссылка КАК ВидЦены
	|ИЗ
	|	Справочник.ВидыЦен КАК ВидыЦен
	|ГДЕ
	|	ВидыЦен.Наименование = &Наименование";
	ЗапросВидЦены.УстановитьПараметр("Наименование","Себестоимость");
	ВыборкаВидЦены=ЗапросВидЦены.Выполнить().Выбрать();
	Если ВыборкаВидЦены.Следующий() тогда
		ВидЦены=ВыборкаВидЦены.ВидЦены;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокПередачи=Документы.ПередачаТоваровМеждуОрганизациями.СоздатьДокумент();
		ДокПередачи.ХозяйственнаяОперация=Перечисления.ХозяйственныеОперации.РеализацияТоваровВДругуюОрганизацию;
		ДокПередачи.Дата=ДатаФормирования;
		ДокПередачи.ДатаПлатежа=ДатаФормирования;
		ДокПередачи.Организация=Справочники.Организации.НайтиПоРеквизиту("ИНН",ОтправительИНН);
		ДокПередачи.ОрганизацияПолучатель=Справочники.Организации.НайтиПоРеквизиту("ИНН",ПолучательИНН);
		ДокПередачи.Подразделение=Справочники.СтруктураПредприятия.НайтиПоНаименованию("Головной офис Москва");
		ДокПередачи.Склад=ВыборкаДетальныеЗаписи.Склад;
		ДокПередачи.ЦенаВключаетНДС=Истина;
		ДокПередачи.Валюта=Константы.ВалютаУправленческогоУчета.Получить();
		ДокПередачи.ВалютаВзаиморасчетов=Константы.ВалютаУправленческогоУчета.Получить();
		ДокПередачи.ПорядокОплаты=Перечисления.ПорядокОплатыПоСоглашениям.РасчетыВРубляхОплатаВРублях;
		ДокПередачи.НалогообложениеНДС=Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		ДокПередачи.ВариантОформленияПродажи=Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
		ДокПередачи.Комментарий="Синхронизация остатков товаров";
		ВыборкаНоменклатуры=ВыборкаДетальныеЗаписи.Выбрать();
		Пока ВыборкаНоменклатуры.Следующий() цикл
			ОтборСтрокиТЗ=Новый Структура("Номенклатура",ВыборкаНоменклатуры.Номенклатура);
			МассивНашли=ТЗСписокСписания.НайтиСтроки(ОтборСтрокиТЗ);
			Если МассивНашли[0].Количество>0 тогда
				СтрокаТЧ=ДокПередачи.Товары.Добавить();
				СтрокаТЧ.Номенклатура=ВыборкаНоменклатуры.Номенклатура;
				СтрокаТЧ.ВидЦены=ВидЦены;
				Списать= Мин(ВыборкаНоменклатуры.Количество,МассивНашли[0].Количество);
				СтрокаТЧ.Количество=Списать; 
				СтрокаТЧ.КоличествоУпаковок=Списать;
				СтруктураДействий = Новый Структура;
				СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияЦеныВСтрокеТЧ(ДокПередачи));
				СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС",   Новый Структура("НалогообложениеНДС, Дата", ДокПередачи.НалогообложениеНДС, ДокПередачи.Дата));
				СтруктураДействий.Вставить("ПересчитатьСуммуНДС",  ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(ДокПередачи));
				СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", Новый Структура("ЦенаВключаетНДС", ДокПередачи.ЦенаВключаетНДС));
				СтруктураДействий.Вставить("ПересчитатьСумму");
				СтруктураДействий.Вставить("ПроверитьСтатьюАналитикуРасходов", СтрокаТЧ.Номенклатура);
				СтруктураДействий.Вставить("ОчиститьСуммуВзаиморасчетов");
				КэшированныеЗначения=Неопределено;
				ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТЧ, СтруктураДействий, КэшированныеЗначения);
				МассивНашли[0].Количество=МассивНашли[0].Количество-Списать;
			КонецЕсли;
		КонецЦикла;
		//*************************************************************************
		Успешно=Ложь;
		Если ДокПередачи.Товары.Количество()>0 тогда 
			// ДокПередачи.ОбменДанными.Загрузка=Истина;
			Попытка 
				ДокПередачи.Записать(РежимЗаписиДокумента.Запись);
				
				Успешно=Истина;
			исключение
				ЗаписьЖурналаРегистрации("Проблема с записью документа",УровеньЖурналаРегистрации.Ошибка,ДокПередачи,ОписаниеОшибки(),);
				ТекстОшибки=ТекстОшибки+ "Не записался документ!"+Строка(ОписаниеОшибки());
				Успешно=Ложь;
			КонецПопытки;
			Если Успешно тогда
				Попытка
					ДокПередачи.Записать(РежимЗаписиДокумента.Проведение);
					ТекстУспех=ТекстУспех+"Проведен документ:"+Строка(ДокПередачи)+";";
				Исключение
					ТекстОшибки= ТекстОшибки+ "Не провелся документ!"+Строка(ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		//*************************************************************************
	КонецЦикла;
	
	Если ТекстОшибки="" тогда
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,200,"",Истина,ТекстУспех);
		Возврат СтруктураОтвет; 
	иначе
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,405,ТекстОшибки,Ложь,"");
		Возврат СтруктураОтвет; 
	КонецЕсли;
	
КонецФункции // СоздатьДокументПеремещения()

Функция ВыгрузитьДокументРеализации(ПараматрыВходящие)
	
	СтруктураОтвет = Новый Структура("ДанныеОтвета,Отработало,ТекстОшибки,КодОтвета","",Истина,"",200);	
	ТекстОшибки="";
	ТекстУспех="";
	//1.десериализуем данные о клиенте из JSON
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ПараматрыВходящие.ТелоЗапроса);
	ДанныеДокумента = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();	
	Если ПараматрыВходящие.ПараметрыЗапроса.Количество()>0 тогда
		ТипДока="ПриобретениеТоваровУслуг";
	иначе
		ТипДока="РеализацияТоваровУслуг";
	КонецЕсли;
	
	ТЗдок=Новый ТаблицаЗначений;
	ТЗдок.Колонки.Добавить("Номер",ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТЗдок.Колонки.Добавить("Дата",ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	Для Каждого СтрМасс из ДанныеДокумента Цикл
		НоваяСтрока=ТЗдок.Добавить(); 
		НоваяСтрока.Номер= СтрМасс.Номер;
		НоваяСтрока.Дата=Дата(СтрМасс.Дата);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТЗ.Дата КАК Дата,
		|	ТЗ.Номер КАК Номер
		|ПОМЕСТИТЬ Временная
		|ИЗ
		|	&ТЗ КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	"+ТипДока+".Ссылка КАК Ссылка
		|ИЗ
		|	Временная КАК Временная
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ."+ТипДока+" КАК "+ТипДока+"
		|		ПО Временная.Дата = "+ТипДока+".Дата
		|			И Временная.Номер = "+ТипДока+".Номер
		|ГДЕ
		|	"+ТипДока+".Проведен";
	
	Запрос.УстановитьПараметр("ТЗ", ТЗдок);
	СписокДокументов=новый СписокЗначений;
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СписокДокументов.Добавить(ВыборкаДетальныеЗаписи.ссылка);
	КонецЦикла;
	
СтруктураПараметров=Новый Структура;

СтруктураПараметров.Вставить("ВерсияФормата","1.5");
ТзДополнительнаяРегистрация=Новый ТаблицаЗначений;
ТзДополнительнаяРегистрация.Колонки.Добавить("ВыборПериода",Новый ОписаниеТипов("Булево"));
ТзДополнительнаяРегистрация.Колонки.Добавить("Количество",ОбщегоНазначения.ОписаниеТипаСтрока(100));
ТзДополнительнаяРегистрация.Колонки.Добавить("Отбор");
ТзДополнительнаяРегистрация.Колонки.Добавить("ОтборСтрокой",ОбщегоНазначения.ОписаниеТипаСтрока(100));
ТзДополнительнаяРегистрация.Колонки.Добавить("Период",ОбщегоНазначения.ОписаниеТипаСтрока(100));
ТзДополнительнаяРегистрация.Колонки.Добавить("ПолноеИмяМетаданных",ОбщегоНазначения.ОписаниеТипаСтрока(100));
ТзДополнительнаяРегистрация.Колонки.Добавить("Представление",ОбщегоНазначения.ОписаниеТипаСтрока(100));

ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
ПользовательскиеОтборы = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
ЭлементОтбора=ПользовательскиеОтборы.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
ЭлементОтбора.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("Ссылка");
ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
ЭлементОтбора.ПравоеЗначение = СписокДокументов;
ЭлементОтбора.Использование = Истина;
ЭлементОтбора.Применение=ТипПримененияОтбораКомпоновкиДанных.Элементы;

СтандартПериод=Новый СтандартныйПериод;
СтандартПериод.Вариант=ВариантСтандартногоПериода.ПроизвольныйПериод;

НоваяСтрокаТЗрегистрации=ТзДополнительнаяРегистрация.Добавить();
НоваяСтрокаТЗрегистрации.ВыборПериода=Ложь;
НоваяСтрокаТЗрегистрации.Количество="";
НоваяСтрокаТЗрегистрации.Отбор=ПользовательскиеОтборы;
НоваяСтрокаТЗрегистрации.ОтборСтрокой=строка(ПользовательскиеОтборы);
НоваяСтрокаТЗрегистрации.Период=СтандартПериод;
НоваяСтрокаТЗрегистрации.ПолноеИмяМетаданных="Документ."+ТипДока;
НоваяСтрокаТЗрегистрации.Представление=ТипДока;


СтруктураПараметров.Вставить("МестоВыгрузки",1);
СтруктураПараметров.Вставить("ПериодОтбораВсехДокументов",СтандартПериод);
