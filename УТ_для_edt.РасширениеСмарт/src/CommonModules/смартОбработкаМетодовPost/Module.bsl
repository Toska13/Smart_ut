Функция СоздатьДокКорректировкиРегистров(ПараматрыВходящие)
	
	СтруктураОтвет = Новый Структура("ДанныеОтвета,Отработало,ТекстОшибки,КодОтвета","",Истина,"",400);	
	ТекстОшибки="";
	ТекстУспех="";
	
	НомерКорректировкиДолга=ПараматрыВходящие.ПараметрыЗапроса.Получить("Number");
	ДатаКорректировкиДолга=Дата(ПараматрыВходящие.ПараметрыЗапроса.Получить("Date"));
	ДатаОперации = Дата(ПараматрыВходящие.ПараметрыЗапроса.Получить("DateOperation"));
	
	Запрос= Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	|	ВзаимозачетЗадолженности.Ссылка КАК Ссылка,
	|	0 КАК Порядок
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК ВзаимозачетЗадолженности
	|ГДЕ
	|	ВзаимозачетЗадолженности.Номер = &Номер
	|	И НАЧАЛОПЕРИОДА(ВзаимозачетЗадолженности.Дата, ДЕНЬ) = &Дата
	
	|ОБЪЕДИНИТЬ ВСЕ
	
	|ВЫБРАТЬ
	|	ВзаимозачетЗадолженности.Ссылка,
	|	1
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК ВзаимозачетЗадолженности
	|ГДЕ
	|	ВзаимозачетЗадолженности.Комментарий ПОДОБНО &Номер
	
	|ОБЪЕДИНИТЬ ВСЕ
	
	|ВЫБРАТЬ
	|	СписаниеЗадолженности.Ссылка,
	|	2
	|ИЗ
	|	Документ.СписаниеЗадолженности КАК СписаниеЗадолженности
	|ГДЕ
	|	СписаниеЗадолженности.Номер = &Номер
	|	И НАЧАЛОПЕРИОДА(СписаниеЗадолженности.Дата, ДЕНЬ) = &Дата
	
	|ОБЪЕДИНИТЬ ВСЕ
	
	|ВЫБРАТЬ
	|	СписаниеЗадолженности.Ссылка,
	|	3
	|ИЗ
	|	Документ.СписаниеЗадолженности КАК СписаниеЗадолженности
	|ГДЕ
	|	СписаниеЗадолженности.Комментарий ПОДОБНО &Номер
	|	И НАЧАЛОПЕРИОДА(СписаниеЗадолженности.Дата, ДЕНЬ) = &Дата";
	Запрос.УстановитьПараметр("Номер",НомерКорректировкиДолга);
	Запрос.УстановитьПараметр("Дата",НачалоДня(ДатаКорректировкиДолга));
	Выборка=Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДокументКорректировки=Выборка.Ссылка;
	иначе
		ДокументКорректировки=Неопределено;
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,400,"Не найден документ корректировки в УТ!",Ложь,"");
		Возврат СтруктураОтвет; 
	КонецЕсли; 
			
	ДокументКорректировка = Документы.КорректировкаРегистров.СоздатьДокумент();
	
	ДокументКорректировка.Дата = ?(ЗначениеЗаполнено(ДатаОперации),ДатаОперации,ТекущаяДата());
	ДокументКорректировка.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДокументКорректировка.Организация=ДокументКорректировки.Организация;	
	ДокументОбъект = ДокументКорректировки.ПолучитьОбъект();
	
	МетаданныеДвижений = ДокументОбъект.Метаданные().Движения;
	
	Для Каждого ТаблицаДвижений Из МетаданныеДвижений Цикл
		
		ИмяТаблицы = ТаблицаДвижений.Имя;
		ДокументОбъект.Движения[ИмяТаблицы].Прочитать();
		
		Если ДокументОбъект.Движения[ИмяТаблицы].Количество() > 0 Тогда
			ДокументКорректировка.ТаблицаРегистров.Добавить().Имя = ИмяТаблицы;
			ТаблицаДвиженийВыгруженная = ДокументОбъект.Движения[ИмяТаблицы].Выгрузить();
			СторнироватьТаблицу(ТаблицаДвиженийВыгруженная);
			ДокументКорректировка.Движения[ИмяТаблицы].Загрузить(ТаблицаДвиженийВыгруженная);
		КонецЕсли;
		Для каждого СтрКорр Из ДокументОбъект.Движения[ИмяТаблицы] Цикл
			Попытка
				Если  Метаданные.РегистрыНакопления[ИмяТаблицы].Измерения.Найти("АналитикаУчетаПоПартнерам")<>Неопределено тогда
					АналитикаУчПоПартнерам=СтрКорр.АналитикаУчетаПоПартнерам;
					ЗаказКлиента= СтрКорр.ЗаказКлиента;
				КонецЕсли; 
			Исключение
			КонецПопытки;
		КонецЦикла; 
		
	КонецЦикла;
	
	ДокументКорректировка.Комментарий = "Сторно документа " + ДокументОбъект; 
	
	РегистраторРасчета=Неопределено;
	Если ЗначениеЗаполнено(АналитикаУчПоПартнерам) Тогда
		ЗапросРег=Новый Запрос;
		ЗапросРег.Текст="ВЫБРАТЬ
		|	РегистраторРасчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РегистраторРасчетов КАК РегистраторРасчетов
		|ГДЕ
		|	РегистраторРасчетов.АналитикаУчетаПоПартнерам = &АналитикаУчетаПоПартнерам
		|	И РегистраторРасчетов.ОбъектРасчетов = &ОбъектРасчетов";
		ЗапросРег.УстановитьПараметр("АналитикаУчетаПоПартнерам",АналитикаУчПоПартнерам);
		ЗапросРег.УстановитьПараметр("ОбъектРасчетов",ЗаказКлиента);
		Результат=ЗапросРег.Выполнить();
		Если Не Результат.Пустой() Тогда  
			Выборка=Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				РегистраторРасчета=Выборка.Ссылка;
			КонецЕсли; 
		КонецЕсли; 
		
		Если РегистраторРасчета<>Неопределено Тогда
			ДокументОбъектКорр = РегистраторРасчета.ПолучитьОбъект();
			
			МетаданныеДвижений = ДокументОбъектКорр.Метаданные().Движения;
			
			Для Каждого ТаблицаДвижений Из МетаданныеДвижений Цикл
				
				ИмяТаблицы = ТаблицаДвижений.Имя;
				ДокументОбъектКорр.Движения[ИмяТаблицы].Прочитать();
				
				Если ДокументОбъектКорр.Движения[ИмяТаблицы].Количество() > 0 Тогда
					ДокументКорректировка.ТаблицаРегистров.Добавить().Имя = ИмяТаблицы;
					ТаблицаДвиженийВыгруженная = ДокументОбъектКорр.Движения[ИмяТаблицы].Выгрузить();
					СторнироватьТаблицу(ТаблицаДвиженийВыгруженная);
					ДокументКорректировка.Движения[ИмяТаблицы].Загрузить(ТаблицаДвиженийВыгруженная);
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ДокументКорректировка.Комментарий = ДокументКорректировка.Комментарий+"; "+ДокументОбъектКорр+" "+Символы.ПС+"#Загружен из базы 1с бухгалтерии.";
	СинонимДокумента = ДокументКорректировка.Метаданные().Синоним;
	
	Попытка
		ДокументКорректировка.Записать();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан документ " + ДокументКорректировка.Ссылка, ДокументКорректировка.Ссылка);
		ТекстУспех=ТекстУспех+"Записан документ:"+Строка(ДокументКорректировка)+";";

	Исключение
		ТекстОшибки="Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не удалось записать документ """ + СинонимДокумента + """ по причине
			|" + ОписаниеОшибки()); 
	КонецПопытки;
		
	Если ТекстОшибки="" тогда
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,200,"",Истина,ТекстУспех);
		Возврат СтруктураОтвет; 
	иначе
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет,405,ТекстОшибки,Ложь,"");
		Возврат СтруктураОтвет; 
	КонецЕсли;
	
КонецФункции // СоздатьДокументПеремещения()

Процедура СторнироватьТаблицу(Таблица)
	
	Для Каждого ТекСтрока Из Таблица Цикл
		
		ТекСтрока["Активность"] = Истина;
		
		Для Каждого ТекКолонка Из Таблица.Колонки Цикл
			
			Если ТекКолонка.Имя = "НомерСтроки" ИЛИ ТекКолонка.Имя = "КодСтроки" Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ТекКолонка.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				Продолжить;
			КонецЕсли;
			
			ТекСтрока[ТекКолонка.Имя] = - ТекСтрока[ТекКолонка.Имя];	
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

//++ #Б5136 смарт: Шляпников 27.01.2026 / Маркировка радиоэлектронной продукции. Синхронизация данных. Приемка товара.
Функция ЗагрузитьДанныеЧерезУниверсальныйОбменДанными(ПараматрыВходящие)
	
	СтруктураОтвет = Новый Структура("ДанныеОтвета,Отработало,ТекстОшибки,КодОтвета", "", Истина, "", 400);
	ТекстОшибки = "";
	ТекстУспех = "";
	ТекстXML="";
	
	ЗаписьЖурналаРегистрации("смартЗагрузитьДанныеЧерезУниверсальныйОбменДанными.Начало", УровеньЖурналаРегистрации.Предупреждение,,,);
	Если ПараматрыВходящие.Свойство("ТелоЗапроса") И ЗначениеЗаполнено(ПараматрыВходящие.ТелоЗапроса) Тогда
		ТекстXML = ПараматрыВходящие.ТелоЗапроса;
		ЗаписьЖурналаРегистрации("смартЗагрузитьДанныеЧерезУниверсальныйОбменДанными.Данные", УровеньЖурналаРегистрации.Информация,, ТекстXML,);
	Иначе
		ЗаполнитьСтруктуруОтвета(СтруктураОтвет, 400, "Не найдены данные для загрузки в УТ", Ложь, "");
		Возврат СтруктураОтвет;
	КонецЕсли; 
	
	ИмяФайлаЗагрузки = ПолучитьИмяВременногоФайла("xml");
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку(ТекстXML);
	Текст.Записать(ИмяФайлаЗагрузки);
	
	Обработка = Обработки.УниверсальныйОбменДаннымиXML.Создать();
	Обработка.ИмяФайлаОбмена = ИмяФайлаЗагрузки;
    Обработка.РежимОбмена = "Загрузка";
	Обработка.ЗагружатьДанныеВРежимеОбмена = Истина;
    Обработка.ОткрытьФайлЗагрузки(Истина);
    Обработка.АрхивироватьФайл = Ложь;
	
    Обработка.ВыполнитьЗагрузку();
	
	УдалитьФайлы(ИмяФайлаЗагрузки);
    Обработка = Неопределено;
	
	ЗаполнитьСтруктуруОтвета(СтруктураОтвет, 200, "", Истина, "Данные загружены");
	
	Возврат СтруктураОтвет;

КонецФункции

//Заполняем структуру ответа
Процедура ЗаполнитьСтруктуруОтвета(СтруктураОтвет,КодОтвета,ТекстОшибки,Отработало,ДанныеОтвета)
	СтруктураОтвет.КодОтвета 	= КодОтвета;
	СтруктураОтвет.ТекстОшибки	= ТекстОшибки;
	СтруктураОтвет.Отработало	= Отработало;
	СтруктураОтвет.ДанныеОтвета = ДанныеОтвета;	
КонецПроцедуры

Функция ВывестиРезультатМенеджераВременныхТаблиц(МенеджерВременныхТаблиц, ИмяТаблицы) Экспорт
	
	//Получаем таблицу из менеджера временных таблиц запроса
	Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ "+ИмяТаблицы);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции