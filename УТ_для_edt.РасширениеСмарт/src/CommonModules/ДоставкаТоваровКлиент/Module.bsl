

#Область ПеренесеноСДоработкамиСмарт

&После("ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение")
Процедура смарт_ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение(Результат, ДополнительныеПараметры)
	
	//смартКаратеев ++
	Элемент 					= ДополнительныеПараметры.Элемент;
	Объект 						= ДополнительныеПараметры.Объект;
	ИмяРеквизитаАдресаДоставки	= ДополнительныеПараметры.ИмяРеквизитаАдресаДоставки;

	Если ТипЗнч(Результат) = Тип("Структура") Тогда // КИ введена
		
		Родитель = Элемент.Родитель;
		
		//++ смарт:ММ #048 234 10.05.2020 - Заявка на пусконаладку 
		// Ругалось, т.к. Родитель элемента - не всегда форма
		Пока ТипЗнч(Родитель) <> Тип("УправляемаяФорма") Цикл
			Родитель = Родитель.Родитель;
		КонецЦикла;
		//-- смарт:ММ 10.05.2020
		
		//Обновляем название кнопки Быстрая реализация в документе Заказ клиента
		Если Родитель.ИмяФормы = "Документ.ЗаказКлиента.Форма.ФормаДокумента" Тогда
			
			Родитель.Элементы.СоздатьРеализацию.Заголовок = Строка("Быстрая реализация: " 
												+ "Способ доставки """ + Объект.СпособДоставки + """: "
												+ "Адрес доставки """ + Объект.АдресДоставки + """."
												);
			Родитель.ОбновитьОтображениеДанных();
			
			//++ #Б4868 смарт: Шляпников 12.11.2025 / Документ заказ клиента. Разделение контроля доставки. 
			Если Элемент.Имя = "АдресДоставкиПолучателя" Тогда
				Родитель.смарт_АдресДоставкиПриИзменении(Элемент);
			КонецЕсли;
			//-- #Б4868 смарт: Шляпников 12.11.2025
			
		КонецЕсли;
	КонецЕсли;
	//Каратеев --
	
КонецПроцедуры

#КонецОбласти 

