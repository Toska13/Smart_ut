#Область ПеренесеноСДоработками

&ИзменениеИКонтроль("РазобратьКодМаркировки")
Функция смарт_РазобратьКодМаркировки(Знач ДанныеДляРазбора, ВидыПродукции, ПримечаниеКРезультатуРазбора, Знач Настройки, ПроверятьАлфавитЭлементов, РасширеннаяДетализация)

	#Вставка
	//++ #Б7868 смарт: Шляпников 17.08.2026 / Маркировка. Синхронизация УТ - БР РФ
	Возврат РазобратьКодМаркировкиАльтернативный(ДанныеДляРазбора);
	//-- #Б7868 смарт: Шляпников 17.08.2026
	#КонецВставки
	
	Если Настройки = Неопределено Тогда
		Настройки = РазборКодаМаркировкиИССлужебныйПовтИсп.НастройкиРазбораКодаМаркировки();
	КонецЕсли;

	Возврат РазборКодаМаркировкиИССлужебныйКлиентСервер.РазобратьКодМаркировки(
	ДанныеДляРазбора, ВидыПродукции, ПримечаниеКРезультатуРазбора, Настройки, ПроверятьАлфавитЭлементов, РазборКодаМаркировкиИССлужебный, РасширеннаяДетализация);

КонецФункции

#КонецОбласти

#Область Служебные

// Альтернативный разбор кода маркировки без проверки шаблонов.
// Извлекает GTIN и серийный номер из строки формата (01)GTIN(21)СерийныйНомер.
//
// Параметры:
//  КодМаркировки - Строка - Исходный код маркировки.
//
// Возвращаемое значение:
//  Структура:
//    * КодМаркировки                - Строка - Исходный код маркировки.
//    * НормализованныйКодМаркировки - Строка - Код после СокрЛП.
//    * ТипШтрихкода                 - ПеречислениеСсылка.ТипыШтрихкодов - GS1_DataMatrix.
//    * ВидУпаковки                  - ПеречислениеСсылка.ВидыУпаковокИС - Потребительская.
//    * ВидыПродукции                - Массив из ПеречислениеСсылка.ВидыПродукцииИС - Учитываемые виды.
//    * ВидыУпаковокПоВидамПродукции - Соответствие из:
//        Ключ    - ПеречислениеСсылка.ВидыПродукцииИС,
//        Значение - Массив с единственным значением Потребительская.
//    * СоставКодаМаркировки - Структура:
//        ** GTIN            - Строка - Значение между (01) и (21).
//        ** СерийныйНомер   - Строка - Значение после (21).
//        ** МРЦ             - Строка - "".
//        ** МРЦСтрокой      - Строка - "".
//        ** КодПроверки     - Строка - "".
//        ** КодТНВЭД        - Строка - "".
//        ** КлючПроверки    - Строка - "".
//        ** Подпись         - Строка - "".
//
Функция РазобратьКодМаркировкиАльтернативный(КодМаркировки) Экспорт

	ВидыПродукции = ИнтеграцияИС.УчитываемыеВидыМаркируемойПродукции();

	СоставКодаМаркировки = Новый Структура;
	СоставКодаМаркировки.Вставить("GTIN",          "");
	СоставКодаМаркировки.Вставить("СерийныйНомер", "");
	СоставКодаМаркировки.Вставить("МРЦ",           "");
	СоставКодаМаркировки.Вставить("МРЦСтрокой",    "");
	СоставКодаМаркировки.Вставить("КодПроверки",   "");
	СоставКодаМаркировки.Вставить("КодТНВЭД",      "");
	СоставКодаМаркировки.Вставить("КлючПроверки",  "");
	СоставКодаМаркировки.Вставить("Подпись",       "");

	Результат = Новый Структура;
	Результат.Вставить("КодМаркировки",                КодМаркировки);
	Результат.Вставить("НормализованныйКодМаркировки", СокрЛП(КодМаркировки));
	Результат.Вставить("ТипШтрихкода",                 Перечисления.ТипыШтрихкодов.GS1_DataMatrix);
	Результат.Вставить("ВидУпаковки",                  Перечисления.ВидыУпаковокИС.Потребительская);
	Результат.Вставить("ВидыПродукции",                ВидыПродукции);
	Результат.Вставить("ВидыУпаковокПоВидамПродукции", Новый Соответствие);
	Результат.Вставить("СоставКодаМаркировки",         СоставКодаМаркировки);

	Для Каждого ВидПродукции Из ВидыПродукции Цикл
		МассивУпаковок = Новый Массив;
		МассивУпаковок.Добавить(Перечисления.ВидыУпаковокИС.Потребительская);
		Результат.ВидыУпаковокПоВидамПродукции.Вставить(ВидПродукции, МассивУпаковок);
	КонецЦикла;

	ПозицияНачалаGTIN            = СтрНайти(КодМаркировки, "(01)");
	ПозицияНачалаСерийногоНомера = СтрНайти(КодМаркировки, "(21)");

	Если ПозицияНачалаGTIN > 0
		И ПозицияНачалаСерийногоНомера > ПозицияНачалаGTIN Тогда

		НачалоЗначенияGTIN    = ПозицияНачалаGTIN + СтрДлина("(01)");
		ДлинаGTIN             = ПозицияНачалаСерийногоНомера - НачалоЗначенияGTIN;
		НачалоСерийногоНомера = ПозицияНачалаСерийногоНомера + СтрДлина("(21)");

		Результат.СоставКодаМаркировки.GTIN          = Сред(КодМаркировки, НачалоЗначенияGTIN, ДлинаGTIN);
		Результат.СоставКодаМаркировки.СерийныйНомер = Сред(КодМаркировки, НачалоСерийногоНомера);

	КонецЕсли;

	Возврат Результат;

КонецФункции


#КонецОбласти