
#Область ПеренесеноСДоработкамиСмарт

&ИзменениеИКонтроль("СтавкаНДСПоУмолчанию")
//++ #Б-5568 смарт: Фролов 03.02.2026 //Ставка НДС в документах "Поступление ДС " справить с 20 на 22 %.
Функция смарт_СтавкаНДСПоУмолчанию(Дата, РасчетнаяСтавка, НалогообложениеНДС)

	ДатаПолучения = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	
	#Вставка
	Если ДатаПолучения >= '20260101' Тогда
		Возврат ?(РасчетнаяСтавка, Перечисления.СтавкиНДС.НДС22_122, Перечисления.СтавкиНДС.НДС22);
	ИначеЕсли ДатаПолучения >= '20190101' Тогда
		Возврат ?(РасчетнаяСтавка, Перечисления.СтавкиНДС.НДС20_120, Перечисления.СтавкиНДС.НДС20);
	Иначе
		Возврат ?(РасчетнаяСтавка, Перечисления.СтавкиНДС.НДС18_118, Перечисления.СтавкиНДС.НДС18);
	КонецЕсли;
	#КонецВставки
	
	#Удаление
	Если ДатаПолучения >= '20190101' Тогда
		Возврат ?(РасчетнаяСтавка, Перечисления.СтавкиНДС.НДС20_120, Перечисления.СтавкиНДС.НДС20);
	Иначе
		Возврат ?(РасчетнаяСтавка, Перечисления.СтавкиНДС.НДС18_118, Перечисления.СтавкиНДС.НДС18);
	КонецЕсли;
	#КонецУдаления

КонецФункции //-- #Б-5568 смарт: Фролов 03.02.2026

#КонецОбласти

