

#Область ДоработкиСмарт

// Функция - Получить структуру подчиненности
//
// Параметры:
//  Ссылка			 Ссылка на документ для которого будет получена структура подчиненности 
//  СТекущимДокументом			 Булево. По умолчанию Истина. Формирует таблицу с переданной ссылкой   
//  МассивИсключений Массив типов документов для исключения из подчиненности. 
// 
// Возвращаемое значение:
//   Таблица значений со структурой подчиненности, где в колонке "Ссылка" ссылки на докумены.   
//   А в колонке "Уровень" уровень их подчиненности
Функция ПолучитьСтруктуруПодчиненности(Ссылка,СТекущимДокументом=Истина,МассивИсключений=Неопределено)Экспорт 
	СтруктураПодчиненности = Новый ТаблицаЗначений;
	СтруктураПодчиненности.Колонки.Добавить("Ссылка",,"Документ");
	СтруктураПодчиненности.Колонки.Добавить("Уровень",,"Уровень подчиенности");
	
	Стр = СтруктураПодчиненности.Добавить();
	Стр.Ссылка = Ссылка;
	Стр.Уровень = 0;
	
	МассивИсключений=?(МассивИсключений=Неопределено,Новый Массив,МассивИсключений);
	
	// Получаем все подчиненные документы
	Для Каждого Строка Из СтруктураПодчиненности Цикл
		
		ЗначениеКритерияОтбора = Строка.Ссылка;
		
		Если Строка.Уровень <= 3 Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ЗначениеКритерияОтбора", ЗначениеКритерияОтбора);
			Запрос.УстановитьПараметр("МассивИсключений",МассивИсключений);
			
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	СвязанныеДокументы.Ссылка КАК Ссылка
			|ИЗ
			|	КритерийОтбора.СвязанныеДокументы(&ЗначениеКритерияОтбора) КАК СвязанныеДокументы
			|ГДЕ
			|	СвязанныеДокументы.Ссылка.Проведен
			|	И (НЕ ТИПЗНАЧЕНИЯ(СвязанныеДокументы.Ссылка) В(&МассивИсключений) ИЛИ ЛОЖЬ)";
			
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
				
			Пока РезультатЗапроса.Следующий() Цикл
				Стр = СтруктураПодчиненности.Добавить(); 
				Стр.Ссылка = РезультатЗапроса.Ссылка;
				Стр.Уровень = Строка.Уровень + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если Не СТекущимДокументом Тогда
		Стр=СтруктураПодчиненности.Найти(Ссылка);
		Если Не Стр=Неопределено Тогда 
			СтруктураПодчиненности.Удалить(Стр);
		КонецЕсли;
	КонецЕсли;	
	
	Возврат СтруктураПодчиненности;
КонецФункции	

//Проверяем что во всех подчиненных документах указаны одинаковые реквизиты.
Функция ПроверитьЗаполнениеРеквизитовВСвязанныхДокументах(Ссылка,Отказ)Экспорт
	МассивИсключений=Новый Массив;
	МассивИсключений.Добавить(Тип("ДокументСсылка.ЗаказПоставщику"));
	МассивИсключений.Добавить(Тип("ДокументСсылка.ПриобретениеУслугПрочихАктивов"));
	МассивИсключений.Добавить(Тип("ДокументСсылка.ЗаказНаПеремещение"));
	МассивИсключений.Добавить(Тип("ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств"));
	
	СтруктураПодчиненности=ПолучитьСтруктуруПодчиненности(Ссылка,Ложь,МассивИсключений);
	
	Для Каждого Стр Из СтруктураПодчиненности Цикл 
		Если Не Стр.Уровень=0 Тогда 
			Документ=Стр.Ссылка;
			
			Попытка
				Если Не Документ.Организация=Ссылка.Организация Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" необходимо изменить Организацию",,,,Отказ);
				КонецЕсли;
				
				Если Не Документ.Партнер = Справочники.Партнеры.ПустаяСсылка() Тогда
					Если Не (Документ.Партнер=Ссылка.Партнер Или Документ.Партнер.Родитель=Ссылка.Партнер Или Документ.Партнер=Ссылка.Партнер.Родитель) Тогда 
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" необходимо изменить Партнера",,,,Отказ);
					КонецЕсли;
				ИначеЕсли ТипЗнч(Документ.Ссылка) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
					НайденныеСтроки = Документ.РасшифровкаПлатежа.НайтиСтроки(Новый Структура("ОснованиеПлатежа", Ссылка));
					Для каждого Строка Из НайденныеСтроки Цикл
						Если Не (Строка.Партнер=Ссылка.Партнер Или Строка.Партнер.Родитель=Ссылка.Партнер Или Строка.Партнер=Ссылка.Партнер.Родитель) Тогда 
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" необходимо изменить Партнера",,,,Отказ);
						КонецЕсли;
					КонецЦикла;
				Иначе
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" не указан Партнер",,,,Отказ);
				КонецЕсли;
				
				Если Не Документ.Контрагент=Ссылка.Контрагент Тогда 
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" необходимо изменить Контрагента",,,,Отказ);
				КонецЕсли;
				//Если Не Документ.Валюта=Ссылка.Валюта Тогда 
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе: "+Документ+" необходимо изменить Валюту",,,,Отказ);
				//КонецЕсли;
			Исключение
				Продолжить;
			КонецПопытки;	
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Отказ;
КонецФункции	

#КонецОбласти