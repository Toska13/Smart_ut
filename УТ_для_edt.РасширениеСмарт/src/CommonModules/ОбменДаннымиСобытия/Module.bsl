

#Область ПеренесеноСДоработкамиСмарт
&После("ВыполнитьПравилаРегистрацииОбъектовДляПланаОбменаПопыткаИсключение")
//++ #1303 смарт: Фролов 23.01.2023 //Настройка и доработка синхронизации номенклатуры из УТ России в УТ Узбекистан  
Процедура смарт_CRM_ВыполнитьПравилаРегистрацииОбъектовДляПланаОбменаПопыткаИсключение(МассивУзловРезультат, Объект, ИмяПланаОбмена, ДополнительныеПараметры)
	
	Если ИмяПланаОбмена="СинхронизацияДанныхЧерезУниверсальныйФормат" Тогда
		
		Если НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.Номенклатура") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.УпаковкиЕдиницыИзмерения") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ВидыНоменклатуры") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ГруппыДоступаНоменклатуры") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.Марки") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.НаборыУпаковок") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ГруппыФинансовогоУчетаНоменклатуры") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.Производители") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ТоварныеКатегории") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ХарактеристикиНоменклатуры") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.ГруппыАналитическогоУчетаНоменклатуры") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.КлассификаторТНВЭД") И
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.СтраныМира") И 
			НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.СерииНоменклатуры") Тогда
			
			Для каждого ТекУзел Из МассивУзловРезультат Цикл
				Если ТипЗнч(ТекУзел.Ссылка) = Тип("ПланОбменаСсылка."+ИмяПланаОбмена) И ТекУзел=Справочники.смартПредопределенныеЗначения.УзелДляОбменаУТУзбекистан.Значение Тогда
					ПОСсылка = ТекУзел.Ссылка;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ МассивУзловРезультат.Найти(ПОСсылка)=Неопределено Тогда
				МассивУзловРезультат.Удалить(МассивУзловРезультат.Найти(ПОСсылка));	
			КонецЕсли;
			
		КонецЕсли;
		
		//++ #Б868 смарт: Шляпников 12.05.2025 / Настроить обмен УТ_РФ -> УТ_БР
		Если НЕ ТипЗнч(Объект)=Тип("СправочникОбъект.Номенклатура") Тогда
			
			Узел = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("УзелДляОбменаУТБеларусь");
			Индекс = МассивУзловРезультат.Найти(Узел);
			Если НЕ Индекс = Неопределено Тогда
				МассивУзловРезультат.Удалить(Индекс);
			КонецЕсли;
			
			//++ #Б5074 смарт: Шляпников 02.12.2025 / КЗ. Внедрение УТ. Выгрузка номенклатуры СМАРТ
			Узел = смартОбщегоНазначенияСКэш.ПолучитьЗначениеПредопределеннойНастройки("УзелДляОбменаУТКазахстан");
			Индекс = МассивУзловРезультат.Найти(Узел);
			Если НЕ Индекс = Неопределено Тогда
				МассивУзловРезультат.Удалить(Индекс);
			КонецЕсли;
			//-- #Б5074 смарт: Шляпников 02.12.2025

		ИначеЕсли ТипЗнч(Объект)=Тип("СправочникСсылка.Номенклатура") ИЛИ ТипЗнч(Объект)=Тип("СправочникОбъект.Номенклатура") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Номенклатура.Ссылка КАК Ссылка,
			               |	Номенклатура.Родитель КАК Родитель,
			               |	Номенклатура.Родитель.Родитель КАК Родитель1,
			               |	Номенклатура.Родитель.Родитель.Родитель КАК Родитель2,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель КАК Родитель3,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель КАК Родитель4,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель КАК Родитель5,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель КАК Родитель6,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель КАК Родитель7,
			               |	Номенклатура.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель.Родитель КАК Родитель8
			               |ПОМЕСТИТЬ ВТНоменклатура
			               |ИЗ
			               |	Справочник.Номенклатура КАК Номенклатура
			               |ГДЕ
			               |	Номенклатура.Ссылка = &Номенклатура
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	Узлы.Ссылка КАК Ссылка
			               |ПОМЕСТИТЬ ВТПодходящиеУзлы
			               |ИЗ
			               |	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.смартВыгружаемаяНоменклатура КАК Узлы
			               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНоменклатура КАК ВТНоменклатура
			               |		ПО (Узлы.Номенклатура = ВТНоменклатура.Ссылка
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель1
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель2
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель3
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель4
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель5
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель6
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель7
			               |				ИЛИ Узлы.Номенклатура = ВТНоменклатура.Родитель8)
			               |
			               |ОБЪЕДИНИТЬ ВСЕ
			               |
			               |ВЫБРАТЬ
			               |	Узлы.Ссылка
			               |ИЗ
			               |	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК Узлы
			               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.смартВыгружаемаяНоменклатура КАК ТЧ
			               |		ПО (ТЧ.Ссылка = Узлы.Ссылка)
			               |ГДЕ
			               |	ТЧ.Ссылка ЕСТЬ NULL
			               |;
			               |
			               |////////////////////////////////////////////////////////////////////////////////
			               |ВЫБРАТЬ
			               |	Узлы.Ссылка КАК Ссылка
			               |ИЗ
			               |	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК Узлы
			               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПодходящиеУзлы КАК ВТПодходящиеУзлы
			               |		ПО (ВТПодходящиеУзлы.Ссылка = Узлы.Ссылка)
			               |ГДЕ
			               |	ВТПодходящиеУзлы.Ссылка ЕСТЬ NULL";
			
			Запрос.УстановитьПараметр("Номенклатура", Объект.Ссылка);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				Индекс = МассивУзловРезультат.Найти(Выборка.Ссылка);
				Если НЕ Индекс = Неопределено Тогда
					МассивУзловРезультат.Удалить(Индекс);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		//-- #Б868 смарт: Шляпников 12.05.2025
		
	КонецЕсли;
	
КонецПроцедуры
//-- #1303 смарт: Фролов 23.01.2023

//++ #2058 смарт: Шляпников 18.09.2024 / Настроить новые договора с клиентами обязательным к синхронизации, ИТСМ 2058
&ИзменениеИКонтроль("ОпределитьПолучателейПоУсловию")
Процедура смарт_ОпределитьПолучателейПоУсловию(МассивУзловРезультат, ПРО, Объект, ИмяПланаОбмена, ДополнительныеПараметры)

	ОбъектМетаданных = ДополнительныеПараметры.ОбъектМетаданных;
	Выгрузка = ДополнительныеПараметры.Выгрузка;

	// {Обработчик: Перед обработкой} Начало.
	Отказ = Ложь;

	ВыполнитьОбработчикПРОПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// {Обработчик: Перед обработкой} Окончание.

	Получатели = Новый Массив;

	ВыполнитьПравилоРегистрацииОбъектаДляСсылочногоТипа(Получатели, ПРО, Объект, ИмяПланаОбмена, ДополнительныеПараметры);

	// {Обработчик: После обработки} Начало.
	Отказ = Ложь;

	ВыполнитьОбработчикПРОПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	// {Обработчик: После обработки} Окончание.

	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивУзловРезультат, Получатели, Истина);
	
	#Вставка
	//++ #2058 смарт: Шляпников 18.09.2024 / Настроить новые договора с клиентами обязательным к синхронизации, ИТСМ 2058
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.ДоговорыКонтрагентов")
		 ИЛИ ТипЗнч(Объект) = Тип("СправочникОбъект.ДоговорыКонтрагентов") Тогда
		
		ЗначенияСвойствОбъекта = ЗначенияСвойствДляОбъекта(Объект, ПРО);
		
		НайденоУсловиеПоОрганизации = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("СинхронизацияДанныхЧерезУниверсальныйФорматЭтотУзел", ОбменДаннымиПовтИсп.ПолучитьЭтотУзелПланаОбмена(ИмяПланаОбмена));
		
		Для каждого Элемент Из ЗначенияСвойствОбъекта Цикл
			Запрос.УстановитьПараметр("СвойствоОбъекта_" + Элемент.Ключ, Элемент.Значение);
			Если "СвойствоОбъекта_" + Элемент.Ключ = "СвойствоОбъекта_Организация" Тогда
				НайденоУсловиеПоОрганизации = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ НайденоУсловиеПоОрганизации Тогда
			Запрос.УстановитьПараметр("СвойствоОбъекта_Организация", Неопределено);
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПланыОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат КАК ПланыОбмена
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланОбмена.СинхронизацияДанныхЧерезУниверсальныйФормат.Организации КАК ПланыОбменаОрганизации
		|		ПО ПланыОбмена.Ссылка = ПланыОбменаОрганизации.Ссылка
		|ГДЕ
		|	(ПланыОбменаОрганизации.Организация = &СвойствоОбъекта_Организация
		|			ИЛИ ПланыОбмена.ИспользоватьОтборПоОрганизациям = ЛОЖЬ
		|				И (ПланыОбмена.УправленческаяОрганизация <> &СвойствоОбъекта_Организация
		|					ИЛИ ПланыОбмена.ВыгружатьУправленческуюОрганизацию = ИСТИНА))
		|	И ПланыОбмена.ВариантНастройки <> ""ОбменУП2ЗУП3""
		|	И ПланыОбмена.ВариантНастройки <> ""ОбменКасса""
		|	И ПланыОбмена.Ссылка <> &СинхронизацияДанныхЧерезУниверсальныйФорматЭтотУзел
		|	И НЕ ПланыОбмена.ПометкаУдаления";
		
		МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивУзловРезультат, МассивСсылок, Истина);
		
	КонецЕсли;
	//-- #2058 смарт: Шляпников 18.09.2024
	#КонецВставки

КонецПроцедуры

#КонецОбласти
 
