		"ТаблицыИсточника.Вес            КАК Вес,";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
		
		
		ТекстВставки = 
		"	ТаблицыИсточника.ВесБрутто                    КАК ВесБрутто,
		|";
		
		ТекстЗамены =
		"ТаблицыИсточника.Вес                    КАК Вес,";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ТекстЗамены, СтрШаблон("%1%2%3", ТекстЗамены, Символы.ПС, ТекстВставки));
		
		
		//объем брутто
		
		//++ #Б4724 смарт: Шляпников 16.10.2025 / Задание на перевозку. Вывести суммированные показатели Объема.
		ТекстВставки = 
		"КОНЕЦ / (ВЫРАЗИТЬ(1 КАК ЧИСЛО(15, 7))) КАК ЧИСЛО(15, 7)) КАК ОбъемТиповой
		|";
		
