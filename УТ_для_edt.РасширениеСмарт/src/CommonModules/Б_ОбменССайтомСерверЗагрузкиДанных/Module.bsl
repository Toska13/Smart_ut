				ГородТК = ДокументXML.ЗначенияРеквизитов.Найти("Город доставки (транспортная компания)"); 
				Если НЕ ГородТК = Неопределено И ЗначениеЗаполнено(ГородТК.Значение) Тогда
					Документ.АдресДоставки = "Пункт выдачи в городе " + СокрЛП(ГородТК.Значение);
					НадписьДопИнформацияДоставка = НадписьДопИнформацияДоставка + Символы.ПС + " в городе " + СокрЛП(ГородТК.Значение); 
				Иначе
					Если ЗначениеЗаполнено(Документ.АдресДоставки) Тогда
						АдресПоПолям = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияПоПредставлению(Документ.АдресДоставки, 
																		Перечисления.ТипыКонтактнойИнформации.Адрес);
						Документ.АдресДоставкиЗначение = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(АдресПоПолям);
						Документ.АдресДоставкиЗначенияПолей = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзJSONВXML(Документ.АдресДоставкиЗначение, 
																			Перечисления.ТипыКонтактнойИнформации.Адрес);
					КонецЕсли;
				КонецЕсли;                                                         

			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НадписьДопИнформацияДоставка) И СтрНайти(Документ.ОсобыеУсловияПеревозкиОписание, НадписьДопИнформацияДоставка) = 0 Тогда
			Если ЗначениеЗаполнено(Документ.ОсобыеУсловияПеревозкиОписание) Тогда
				Документ.ОсобыеУсловияПеревозкиОписание = Документ.ОсобыеУсловияПеревозкиОписание + Символы.ПС + НадписьДопИнформацияДоставка;
			Иначе	
				Документ.ОсобыеУсловияПеревозкиОписание = НадписьДопИнформацияДоставка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

    Если Обрешётка = Истина Тогда 
		Если СтрНайти(Документ.ОсобыеУсловияПеревозкиОписание, "Обрешётка") = 0 Тогда
			Если ЗначениеЗаполнено(Документ.ОсобыеУсловияПеревозкиОписание) Тогда
				Документ.ОсобыеУсловияПеревозкиОписание = Документ.ОсобыеУсловияПеревозкиОписание + Символы.ПС + "Обрешётка";
			Иначе	
				Документ.ОсобыеУсловияПеревозкиОписание = "Обрешётка";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 

    Если Тепло = Истина Тогда 
		Если СтрНайти(Документ.ОсобыеУсловияПеревозкиОписание, "Тепло") = 0 Тогда
			Если ЗначениеЗаполнено(Документ.ОсобыеУсловияПеревозкиОписание) Тогда
				Документ.ОсобыеУсловияПеревозкиОписание = Документ.ОсобыеУсловияПеревозкиОписание + Символы.ПС + "Тепло";
			Иначе	
				Документ.ОсобыеУсловияПеревозкиОписание = "Тепло";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 

    Если Страховка = Истина Тогда 
		Если СтрНайти(Документ.ОсобыеУсловияПеревозкиОписание, "Страховка") = 0 Тогда
			Если ЗначениеЗаполнено(Документ.ОсобыеУсловияПеревозкиОписание) Тогда
				Документ.ОсобыеУсловияПеревозкиОписание = Документ.ОсобыеУсловияПеревозкиОписание + Символы.ПС + "Страховка";
			Иначе	
				Документ.ОсобыеУсловияПеревозкиОписание = "Страховка";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 

	Документ.ОсобыеУсловияПеревозки = ЗначениеЗаполнено(Документ.ОсобыеУсловияПеревозкиОписание);
	//--#1265 смарт: Лопато 07.03.2023

	//++#1382 смарт: Лопато 21.06.2023 //Заполнение параметров заказа при самовывозе  
	Если Документ.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз 
	 ИЛИ Документ.СпособДоставки = Перечисления.СпособыДоставки.смартСамовывозСоСкладаАдмирал Тогда
	 
		Если НЕ ЗначениеЗаполнено(Документ.АдресДоставки) Тогда 
			
			СтруктураНовыйАдресДоставки = смартОбщегоНазначения.смартПолучитьАдресСклада(Документ.Склад, Документ.Товары, Документ.АдресДоставки, Документ.СпособДоставки);
		
			//++#1578 смарт: Лопато 15.12.2023 //Ошибка в заказе клиента при изменении адреса доставки  
			Документ.АдресДоставки 			    = СтруктураНовыйАдресДоставки.АдресДоставки;
			Документ.АдресДоставкиЗначение 	    = СтруктураНовыйАдресДоставки.АдресДоставкиЗначение; 
			Документ.АдресДоставкиЗначенияПолей = СтруктураНовыйАдресДоставки.АдресДоставкиЗначенияПолей;
            //--#1578 смарт: Лопато 15.12.2023
			
		КонецЕсли;
		
	КонецЕсли;	
	//--#1382 смарт: Лопато 21.06.2023
	
    //}
    Документ.ДополнительныеСвойства.Вставить("ЭтоНовыйБитрикс",Истина);
	Документ.смартИдБитрикс=ДокументXML.Ид;
	
	//++ #Б6022 смарт: Шляпников 17.03.2026 / Проект smart-t.ru. Обмен заказами. Выгрузка группы склада, вместо элемента
	Для каждого стрТовары Из Документ.Товары Цикл
		
		Если (ЗначениеЗаполнено(стрТовары.Склад) И стрТовары.Склад.ЭтоГруппа) Тогда
			стрТовары.Склад = ПолучитьСкладДляНоменклатуры(стрТовары.Склад, стрТовары.Номенклатура, стрТовары.Характеристика);
		ИначеЕсли Документ.Склад.ЭтоГруппа И НЕ ЗначениеЗаполнено(стрТовары.Склад)  Тогда
			стрТовары.Склад = ПолучитьСкладДляНоменклатуры(Документ.Склад, стрТовары.Номенклатура, стрТовары.Характеристика);
		КонецЕсли;
		
	КонецЦикла;
	//-- #Б6022 смарт: Шляпников 17.03.2026
	
КонецПроцедуры

