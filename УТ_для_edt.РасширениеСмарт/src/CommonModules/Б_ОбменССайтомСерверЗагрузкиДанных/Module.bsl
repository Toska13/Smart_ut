//++ #Б6022 смарт: Шляпников 17.03.2026 / Проект smart-t.ru. Обмен заказами. Выгрузка группы склада, вместо элемента
Функция ПолучитьСкладДляНоменклатуры(СкладГруппа, Номенклатура, Характеристика)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СкладысмартСкладыОстатковДляСайта.Склад КАК Склад
	|ПОМЕСТИТЬ ВТСклады
	|ИЗ
	|	Справочник.Склады.смартСкладыОстатковДляСайта КАК СкладысмартСкладыОстатковДляСайта
	|ГДЕ
	|	СкладысмартСкладыОстатковДляСайта.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СвободныеОстаткиОстатки.Склад КАК Склад
	|ИЗ
	|	РегистрНакопления.СвободныеОстатки.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика
	|				И Склад В
	|					(ВЫБРАТЬ
	|						Т.Склад
	|					ИЗ
	|						ВТСклады КАК Т)) КАК СвободныеОстаткиОстатки
	|ГДЕ
	|	СвободныеОстаткиОстатки.ВНаличииОстаток - СвободныеОстаткиОстатки.ВРезервеСоСкладаОстаток - СвободныеОстаткиОстатки.ВРезервеПодЗаказОстаток > 0";
	
	Запрос.УстановитьПараметр("Ссылка", СкладГруппа);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Характеристика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И Выборка.Склад <> NULL Тогда
		Возврат Выборка.Склад;
	КонецЕсли;
	
	Если СкладГруппа.смартСкладыОстатковДляСайта.Количество() > 0 Тогда
		Возврат СкладГруппа.смартСкладыОстатковДляСайта[0].Склад;
	КонецЕсли;
	
	Возврат СкладГруппа;
	
КонецФункции
	
#КонецОбласти

#Область ПеренесеноСДоработками

//++ #1993 смарт: Лопато 02.09.2024 //Обработка онлайн заказов (переделка)
&ИзменениеИКонтроль("ПолучитьЗначениеРеквизитаДокументаПоСоответствию")
Функция смарт_ПолучитьЗначениеРеквизитаДокументаПоСоответствию(ПараметрыОбмена, ДокументXML, Документ, ОсновныеНастройкиДокумента, ТекущийРеквизит, СтрокаXML, СтрокаТабличнойЧасти, СтрараяТабличнаяЧасть)
	
	Если СтрокаТабличнойЧасти = Неопределено тогда
		лРеквизит = Документ.Метаданные().Реквизиты.Найти(ТекущийРеквизит.НаименованиеРеквизита1С);
	Иначе
		лРеквизит = Метаданные.НайтиПоТипу(Тип(СтрокаТабличнойЧасти)).Реквизиты.Найти(ТекущийРеквизит.НаименованиеРеквизита1С);	
	КонецЕсли;
	
	Если лРеквизит = Неопределено тогда
		
		Массив = Новый Массив;
		Если СтрокаТабличнойЧасти = Неопределено тогда
			Массив.Добавить(ТипЗнч(Документ[ТекущийРеквизит.НаименованиеРеквизита1С]));
		Иначе
			Массив.Добавить(ТипЗнч(СтрокаТабличнойЧасти[ТекущийРеквизит.НаименованиеРеквизита1С]));
		КонецЕсли;  
		лТипРеквизита = Новый ОписаниеТипов(Массив);
		
	Иначе
		
		лТипРеквизита = лРеквизит.Тип;
		
	КонецЕсли;
	
	мПростыеТипы = Новый Массив;
	мПростыеТипы.Добавить(Тип("Строка"));	
	мПростыеТипы.Добавить(Тип("Число"));	
	мПростыеТипы.Добавить(Тип("Булево"));	
	мПростыеТипы.Добавить(Тип("Дата"));	
	
	Результат = Неопределено;
	
	Если ТекущийРеквизит.ТипДанных = "Из поля XML документа" тогда
		
		Если ТекущийРеквизит.Значение = "Дата с сайта с учетом настройки обмена" тогда
			
			ДатаДокументаНаСайте 	= XMLЗначение(Тип("Дата"),ДокументXML.Дата + "T" + ДокументXML.Время);
			
			Если ОсновныеНастройкиДокумента.ДатаДокументов = "Текущая дата" тогда
				Результат = ТекущаяДатаСеанса();
			Иначе
				Результат = ДатаДокументаНаСайте;
			КонецЕсли;
			
			
		ИначеЕсли ТекущийРеквизит.Значение = "Дата отгрузки" тогда
			
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.ДатаОтгрузки) тогда
				Результат = СтрокаТабличнойЧасти.ДатаОтгрузки;	
			Иначе
				
				ДатаДокументаНаСайте 	= XMLЗначение(Тип("Дата"),ДокументXML.Дата + "T" + ДокументXML.Время);
				
				Если ОсновныеНастройкиДокумента.ДатаДокументов = "Текущая дата" тогда
					Результат = ТекущаяДатаСеанса();
				Иначе
					Результат = ДатаДокументаНаСайте;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТекущийРеквизит.Значение = "Дата с сайта" тогда
			
			Результат 	= XMLЗначение(Тип("Дата"),ДокументXML.Дата + "T" + ДокументXML.Время);
			
		ИначеЕсли ТекущийРеквизит.Значение = "Дата 1С" тогда
			
			Результат =  ТекущаяДатаСеанса();
			
		ИначеЕсли ТекущийРеквизит.Значение = "Номер с сайта" тогда
			
			Результат =  ДокументXML.Номер;	
			
		ИначеЕсли ТекущийРеквизит.Значение = "Ид с сайта" тогда
			
			Результат =  ДокументXML.Ид;	
			
