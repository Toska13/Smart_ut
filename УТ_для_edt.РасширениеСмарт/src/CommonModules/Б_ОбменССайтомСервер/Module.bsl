//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
Функция смартПолучитьИзПартнераДатуНачалаОбменаДокументамиИМ(Партнер, ТекущаяДатаНачалаОбмена = Неопределено) Экспорт
	
	Если ТекущаяДатаНачалаОбмена = Неопределено Тогда
	
		ТекущаяДатаНачалаОбмена	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Партнер, "смартДатаНачалаОбменаДокументамиИМ");
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущаяДатаНачалаОбмена) Тогда

		ДатаНачалаОбмена = ТекущаяДатаНачалаОбмена;

	Иначе
		
		//Записываем партнеру текущую дату как дату начала обмена 
		ДатаНачалаОбмена = ТекущаяДата();
		
		смартЗаписатьПартнеруДатуНачалаОбменаДокументамиИМ(Партнер, ДатаНачалаОбмена);
		
	КонецЕсли;
	
	Возврат ДатаНачалаОбмена;
	
КонецФункции //-- #Б-1138 смарт: Лопато 15.10.2024

//++#1296 смарт: Лопато 12.04.2023 //Исправить регистрацию на узле КонтрагентыПартнеры  
Функция смартПолучитьМассивУзловДляРегистрации(ВыбиратьУзлыОбменаТоварами = Ложь, ВыбиратьУзлыОбменаЗаказами = Ложь, 
											   ВыбиратьУзлыОбменаПользовательскимиСправочниками = Ложь, ВыбиратьУзлыОбменаЗагрузкаПодписок = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПланОбмена.Ссылка КАК Ссылка
	|ИЗ
	|	ПланОбмена.Б_ОбменССайтом КАК ПланОбмена
	|ГДЕ
	|	НЕ ПланОбмена.ЭтотУзел
	|	И НЕ ПланОбмена.ПометкаУдаления
	|	И (ВЫБОР
	|				КОГДА &ВыбиратьУзлыОбменаТоварами
	|					ТОГДА ПланОбмена.ОбменТоварами
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА &ВыбиратьУзлыОбменаЗаказами
	|					ТОГДА ПланОбмена.ОбменДокументами
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА &ВыбиратьУзлыОбменаПользовательскимиСправочниками
	|					ТОГДА ПланОбмена.ОбменПользовательскимиСправочниками
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА &ВыбиратьУзлыОбменаЗагрузкаПодписок
	|					ТОГДА ПланОбмена.смартЗагрузкаПодписок
	|			КОНЕЦ)
	|";
	
	Запрос.УстановитьПараметр("ВыбиратьУзлыОбменаТоварами", 					  ВыбиратьУзлыОбменаТоварами);
	Запрос.Установитьпараметр("ВыбиратьУзлыОбменаЗаказами", 					  ВыбиратьУзлыОбменаЗаказами);
	Запрос.УстановитьПараметр("ВыбиратьУзлыОбменаПользовательскимиСправочниками", ВыбиратьУзлыОбменаПользовательскимиСправочниками);
	Запрос.Установитьпараметр("ВыбиратьУзлыОбменаЗагрузкаПодписок", 			  ВыбиратьУзлыОбменаЗагрузкаПодписок);
	
	ТаблицаУзлов = Запрос.Выполнить().Выгрузить();
	
	Если ВыбиратьУзлыОбменаТоварами Тогда

		МассивУзлов = Новый Массив;

		Для Каждого СтрокаУзел Из ТаблицаУзлов Цикл

			СохраненныеНастройки = СтрокаУзел.Ссылка.СохраненныеНастройки.Получить();

			Если СохраненныеНастройки.Свойство("ИнформацияОНоменклатуре") 
				И СохраненныеНастройки.ИнформацияОНоменклатуре.Свойство("ВыгружатьТовары") 
				И СохраненныеНастройки.ИнформацияОНоменклатуре.ВыгружатьТовары Тогда
				
				МассивУзлов.Добавить(СтрокаУзел.Ссылка);
				
			КонецЕсли;	
			
		КонецЦикла;
		
		Возврат МассивУзлов;
		
	Иначе
		
		Возврат ТаблицаУзлов.ВыгрузитьКолонку("Ссылка");
		
	КонецЕсли;
	
КонецФункции //--#1296 смарт: Лопато 12.04.2023

//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
//++ #1261 смарт: Лопато 25.01.2023 //Доработка изменения Заказа клиента для ИМ  
Функция смартПроверкаЗаказНужноВыгружатьНаСайт(ЗаказСсылка, ПроверятьЗаказВыгруженНаСайт = Истина) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ВыгружатьЗаказ = Ложь;
	
	ЗаказВыгруженНаСайт 					 = Ложь;
	ЗаказПрошелПроверкуПоДатеНачалаОбмена 	 = Ложь;
	ЗаказПрошелПроверкуПоПартнеруКонтрагенту = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 

	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиента.Ссылка КАК ЗаказСсылка,
	|	ЗаказКлиента.Дата КАК ЗаказДата,
	|	ЗаказКлиента.Б_Идентификатор КАК Б_Идентификатор,
	|	ЗаказКлиента.Партнер КАК Партнер,
	|	Партнеры.смартДатаНачалаОбменаДокументамиИМ КАК смартДатаНачалаОбменаДокументамиИМ,
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.Партнер КАК ПартнерКонтрагента,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА КонтактныеЛицаПартнеров.смартЛогинНаСайте = """"
	|					ИЛИ КонтактныеЛицаПартнеров.смартЛогинНаСайте ЕСТЬ NULL
	|				ТОГДА ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ) КАК ЕстьКЛсЛогином
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
	|		ПО ЗаказКлиента.Партнер = КонтактныеЛицаПартнеров.Владелец
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	|		ПО ЗаказКлиента.Партнер = Партнеры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ЗаказКлиента.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	ЗаказКлиента.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиента.Ссылка,
	|	ЗаказКлиента.Дата,
	|	ЗаказКлиента.Б_Идентификатор,
	|	ЗаказКлиента.Партнер,
	|	Партнеры.смартДатаНачалаОбменаДокументамиИМ,
	|	Контрагенты.Ссылка,
	|	Контрагенты.Партнер";
	
	Запрос.УстановитьПараметр("Ссылка", ЗаказСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		//Проверка заказ уже выгружен в ИМ
		Если ПроверятьЗаказВыгруженНаСайт Тогда
			ЗаказВыгруженНаСайт = ЗначениеЗаполнено(Выборка.Б_Идентификатор);
		КонецЕсли;	

		//Проверка партнера и контрагента
		ЕстьПартнерСЛогином = ЗначениеЗаполнено(Выборка.Партнер) И Выборка.ЕстьКЛсЛогином;
		
		КонтрагентПринадлежитПартнеру = ЗначениеЗаполнено(Выборка.Контрагент) 
										И ЗначениеЗаполнено(Выборка.ПартнерКонтрагента) 
										И Выборка.Партнер = Выборка.ПартнерКонтрагента;
										
		ЗаказПрошелПроверкуПоПартнеруКонтрагенту = ЕстьПартнерСЛогином И КонтрагентПринадлежитПартнеру;
		
		//Если заказ уже выгружен на сайт или прошел проверку по партнеру, то
		//проверяем (устанавливаем) дату начала обмена документами
		Если ЗаказВыгруженНаСайт 
			ИЛИ ЗаказПрошелПроверкуПоПартнеруКонтрагенту Тогда

			//Получение даты начала обмена 
			ДатаНачалаОбменаДокументамиИМ = смартПолучитьИзПартнераДатуНачалаОбменаДокументамиИМ(
												Выборка.Партнер, Выборка.смартДатаНачалаОбменаДокументамиИМ);
			
			//Если дата заказа равна или больше даты начала обмена документами ИМ, то проверка пройдена
			Если Выборка.ЗаказДата >= ДатаНачалаОбменаДокументамиИМ Тогда

				ЗаказПрошелПроверкуПоДатеНачалаОбмена = Истина;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
		Если ЗаказВыгруженНаСайт 
			ИЛИ (ЗаказПрошелПроверкуПоПартнеруКонтрагенту 
				 И ЗаказПрошелПроверкуПоДатеНачалаОбмена) Тогда
			
			ВыгружатьЗаказ = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ВыгружатьЗаказ;
	
КонецФункции //-- #Б-1138 смарт: Лопато 15.10.2024

//++ #Б-1138 смарт: Лопато 15.10.2024 //ИМ. Выгрузка заказов на сайт. Ограничение по дате  
Процедура смартЗаписатьПартнеруДатуНачалаОбменаДокументамиИМ(Партнер, ДатаНачалаОбмена) Экспорт

	Если НЕ ЗначениеЗаполнено(Партнер) Тогда
		Возврат;
	КонецЕсли;	

	УстановитьПривилегированныйРежим(Истина);
	
	ПартнерОбъект = Партнер.ПолучитьОбъект();
	
	ПартнерОбъект.ОбменДанными.Загрузка = Истина;
	
	ПартнерОбъект.ДополнительныеСвойства.Вставить("НеРегистрироватьИзмененияДляСайта", Истина);
	ПартнерОбъект.ДополнительныеСвойства.Вставить("ПропуститьОтправкуНаСайтПриЗаписи", Истина);
	
	ПартнерОбъект.смартДатаНачалаОбменаДокументамиИМ = ДатаНачалаОбмена;

	Попытка
		
		ПартнерОбъект.Записать();
		
	Исключение
		
		ЗаписьЖурналаРегистрации("Установка даты начала", УровеньЖурналаРегистрации.Ошибка,,, 
								 "Не удалось записать дату начала обмена документами ИМ партнеру " + СокрЛП(Партнер));
		
	КонецПопытки	
	
КонецПроцедуры //-- #Б-1138 смарт: Лопато 15.10.2024

Процедура смартПроверитьЗарегистрироватьЗаказ(МассивУзловЗаказы, ЗаказКлиента)
//++#1261 смарт: Лопато 25.01.2023 //Доработка изменения Заказа клиента для ИМ  
	
	Если Б_ОбменССайтомСервер.смартПроверкаЗаказНужноВыгружатьНаСайт(ЗаказКлиента, Истина) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(МассивУзловЗаказы, ЗаказКлиента);
    Иначе
		ПланыОбмена.УдалитьРегистрациюИзменений(МассивУзловЗаказы, ЗаказКлиента);
	КонецЕсли;	

КонецПроцедуры //--#1261 смарт: Лопато 25.01.2023

#КонецОбласти