						Если ТекСправочник.Справочник="НоменклатураПродаваемаяСовместно" или ТекСправочник.Справочник="СмартФактОтчетБитрикс" 
							или ТекСправочник.Справочник="СмартДебиторскаяЗадолженностьБитрикс" или ТекСправочник.Справочник="СмартИндивидуальныеСкидкиКлиентов" тогда
						//--#1323 смарт: Лопато 23.03.2023	
						ИначеЕсли ТипОбъекта = Тип("СправочникОбъект." + ТекСправочник.Справочник) тогда 
							ПланыОбмена.ЗарегистрироватьИзменения(Выборка.Ссылка, Объект.Ссылка);
						КонецЕсли;
					Исключение
						Если ТипОбъекта = Тип("СправочникОбъект." + ТекСправочник.Справочник) тогда 
							ПланыОбмена.ЗарегистрироватьИзменения(Выборка.Ссылка, Объект.Ссылка);
						КонецЕсли;
					КонецПопытки;
					//Смарт }Подкин Алексей Иванович 07.07.2020 10:31:48
					
				КонецЦикла;

			КонецЦикла;
			#КонецВставки
			
		Исключение
			Сообщить("Не удалось зарегистрировать изменение для элемента " + Строка(Объект.Ссылка) + ". Элемент не будет отправлен на сайт Битрикс в режиме изенений.");
			Сообщить(ОписаниеОшибки()); 
		КонецПопытки;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

&ИзменениеИКонтроль("ДобавитьОсновныеНастройкиВПараметры")
Функция смарт_ДобавитьОсновныеНастройкиВПараметры(УзелОбмена, Параметры)

	МассивРеквизитов = ПолучитьМассивРеквизитов5ВерсииМодуля();

	//добавляем реквизиты узла обмена
