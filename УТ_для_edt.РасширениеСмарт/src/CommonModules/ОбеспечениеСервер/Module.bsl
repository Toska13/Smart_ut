&ИзменениеИКонтроль("ТаблицаЗаполнениеОбеспеченияДокумента")
Функция смарт_ТаблицаЗаполнениеОбеспеченияДокумента(Объект, ПереченьВариантов, Параметры, ИндексыСтрок)

	Перем СтатусКВыполнению, ГруппаСкладов, МенеджерРегистра, ТаблицаДляПроведения, ОтборПоИзмерениям;
	ПрименитьПараметрыДокумента(Параметры, СтатусКВыполнению, ГруппаСкладов, МенеджерРегистра, ТаблицаДляПроведения, ОтборПоИзмерениям);

	ТабЧасть = Объект[Параметры.ИмяТабличнойЧасти];
	ПутиКДанным = Параметры.ПутиКДанным;

	// Таблица выделенных строк табличной части.
	ТаблицаВыделенныеСтроки = ТабличнуюЧастьВТаблицу(ТабЧасть, Объект, ПутиКДанным, ИндексыСтрок);
	ЗаполнитьТипНоменклатурыВТаблице(ТаблицаВыделенныеСтроки);

	ОтборОформлено = ТаблицаПоОписаниюПолей(Новый Структура("Ссылка, КодСтроки",
	ОбеспечениеКлиентСервер.ОписаниеТиповЗаказыКОбеспечению(), ОбщегоНазначенияУТ.ПолучитьОписаниеТиповЧисла(15, 0)));
	Для Каждого Индекс Из ИндексыСтрок Цикл

		Строка = ТабЧасть[Индекс];
		Строка.Количество = 0;

		СтрокаОтбора = ОтборОформлено.Добавить();
		СтрокаОтбора.Ссылка = Объект.Ссылка;
		ЗаполнитьЗначенияСвойств(СтрокаОтбора, Строка);

	КонецЦикла;
	ОформитьПоНакладным = МенеджерРегистра.ТаблицаОформлено(ОтборОформлено, ОтборПоИзмерениям, Истина);

	// Таблица невыделенных строк табличной части.
	ТаблицаНевыделенныеСтроки = ТабличнуюЧастьВТаблицу(ТабЧасть, Объект, ПутиКДанным);
	ЗаполнитьТипНоменклатурыВТаблице(ТаблицаНевыделенныеСтроки);

	Для Каждого ВыделеннаяСтрока Из ТаблицаВыделенныеСтроки Цикл
		Строка = ТабЧасть[ВыделеннаяСтрока.Идентификатор];
		Строка.Количество = ВыделеннаяСтрока.Количество;
	КонецЦикла;

	ПараметрыЗаполнения = Новый Структура("ПереченьВариантов, ИзменятьОбособление", ПереченьВариантов, Ложь);
    #Вставка
	//++ #5378 смарт: Тимофеева 19.01.26 / Автоматическое резервирование запасов. Ошибка при изменении даты прихода в грузе
	Если (ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") И Объект.Свойство("смартЗапчастиГарантийные") И Объект.смартЗапчастиГарантийные)
		ИЛИ (НЕ ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") И НЕ Объект.Метаданные().Реквизиты.Найти("смартЗапчастиГарантийные") = Неопределено И Объект.смартЗапчастиГарантийные) Тогда
		ПараметрыЗаполнения.Вставить("смартЗапчастиГарантийные", Истина);
	Иначе
		ПараметрыЗаполнения.Вставить("смартЗапчастиГарантийные", Ложь);
	КонецЕсли;
	//-- #5378 смарт: Тимофеева 19.01.26
	#КонецВставки
	
	Результат = ТаблицаЗаполнениеОбеспеченияУниверсальный(
		ТаблицаВыделенныеСтроки,
		ОформитьПоНакладным,
		ТаблицаНевыделенныеСтроки,
		Объект.Ссылка,
		ГруппаСкладов,
		ТаблицаДляПроведения,
		ПараметрыЗаполнения);

	Возврат Результат;

КонецФункции

&ИзменениеИКонтроль("РассчитатьПриращенияКоличестваВТаблице")
Процедура смарт_РассчитатьПриращенияКоличестваВТаблице(Таблица, КлючСтроки)

	МаксИндекс = Таблица.Количество() - 1;
	Индекс = МаксИндекс;
	ЕстьЗаписи = Индекс >= 0;

	Пока ЕстьЗаписи Цикл

		Строка = Таблица[Индекс];
		ЗаполнитьЗначенияСвойств(КлючСтроки, Строка);

		ИзмениласьЗапись = Ложь;

		#Вставка
		//++ #Б5378 смарт: Шляпников 20.01.2026 / Автоматическое резервирование запасов. Ошибка при изменении даты прихода в грузе
		Если Таблица.Колонки.Найти("смартКоличествоГарантийные") <> Неопределено Тогда
			смартГарантийныеНарастающийИтог = 0;
		КонецЕсли;
		//-- #Б5378 смарт: Шляпников 20.01.2026
		#КонецВставки
		
		НарастающийИтог = 0;
		// Цикл по сочетанию номенклатура\характеристика\склад.
		Пока Не ИзмениласьЗапись Цикл

			Строка = Таблица[Индекс];
			Строка.Количество = Строка.Количество - НарастающийИтог;
			НарастающийИтог = НарастающийИтог + Строка.Количество;
			
			#Вставка
			//++ #Б5378 смарт: Шляпников 20.01.2026 / Автоматическое резервирование запасов. Ошибка при изменении даты прихода в грузе
			Если Таблица.Колонки.Найти("смартКоличествоГарантийные") <> Неопределено Тогда
				
