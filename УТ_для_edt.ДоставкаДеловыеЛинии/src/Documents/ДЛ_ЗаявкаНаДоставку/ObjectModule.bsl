
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	ДокументыОснования.Добавить().Документ = ДанныеЗаполнения;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Счетчик = 0;
	
	Пока Счетчик < ДокументыОснования.Количество() Цикл
		
		ТекущаяСтрока = ДокументыОснования[Счетчик];
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.Документ) Тогда
			
			Счетчик = Счетчик + 1; 	
			
		Иначе
			
			ДокументыОснования.Удалить(Счетчик);
			
		Конецесли;
		
	КонецЦикла;
	
КонецПроцедуры
