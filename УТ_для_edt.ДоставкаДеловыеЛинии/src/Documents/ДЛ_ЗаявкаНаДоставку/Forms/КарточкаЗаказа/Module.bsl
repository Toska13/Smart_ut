Процедура ВидДоставкиПриИзменении(Элемент)  	
	
	Если ВидДоставки = "letter" Тогда		
		
		ПереключательРасшифровки = 0;		
		ЕдиницаДлина = "м";
		ЕдиницаШирина = "м"; 
		ЕдиницаВысота = "м"; 
		ГрузМаксимальнаяДлина = 0.3;
		ГрузМаксимальнаяШирина = 0.21;
		ГрузМаксимальнаяВысота = 0.01;
		ГрузВес = 0.5; 
		ГрузСтоимость = 0;
		
		ПересчетВГХПриИзмененииУсловийДоставки();
		ДоступностьЭлементовВГХ(Ложь, Ложь); 
		
	ИначеЕсли ВидДоставки = "small" Тогда
		
		ПереключательРасшифровки = 0; 		
		ЕдиницаДлина = "м";
		ЕдиницаШирина = "м"; 
		ЕдиницаВысота = "м"; 
		ГрузМаксимальнаяДлина = 0.54;
		ГрузМаксимальнаяШирина = 0.39;
		ГрузМаксимальнаяВысота = 0.39;
		ГрузВес = ?(ГрузВес < 0.01, 1, ГрузВес); 
		
		ПересчетВГХПриИзмененииУсловийДоставки();
		ДоступностьЭлементовВГХ(Ложь, Истина); 
		
	Иначе	
			
		ДоступностьЭлементовВГХ(Истина, Истина); 
		
