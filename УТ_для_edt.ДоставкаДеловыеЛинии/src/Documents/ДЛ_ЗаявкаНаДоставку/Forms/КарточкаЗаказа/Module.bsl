&НаСервере
Процедура ДополнительныеТребованияЗаблокироватьНесовместимыеПоля(Префикс) 
	
	ТЗ_ДополнительныеТребования = ЭтотОбъект[Префикс + "ДополнительныеТребования"]; 
	                                     
	ТЗ = ТЗ_ДополнительныеТребования.Выгрузить();
	ТЗ.ЗаполнитьЗначения(Ложь, "Заблокировано");
	ТЗ_ДополнительныеТребования.Загрузить(ТЗ);	
	
	Для Каждого СтрТЗ Из ТЗ_ДополнительныеТребования Цикл 
		
		Если СтрТЗ.Использовать Тогда
			
			Для Каждого Несовместимость Из СтрТЗ.ДополнительноеТребование.Несовместимость Цикл
				
				Для Каждого СтрТЗ_Блокировка Из ТЗ_ДополнительныеТребования Цикл		
					
					Если СтрТЗ_Блокировка.ДополнительноеТребование.UID = Несовместимость.UID Тогда
						
						СтрТЗ_Блокировка.Заблокировано = Истина;	
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПовернутьГруз(Команда)
	
	СтараяДлина = ГрузМаксимальнаяДлина;
	СтараяДлинаЕдиница = ЕдиницаДлина; 
	ГрузМаксимальнаяДлина = ГрузМаксимальнаяВысота;
	ЕдиницаДлина = ЕдиницаВысота;	
	ГрузМаксимальнаяВысота = ГрузМаксимальнаяШирина;
	ЕдиницаВысота = ЕдиницаШирина;	
	ГрузМаксимальнаяШирина =  СтараяДлина;
	ЕдиницаШирина = СтараяДлинаЕдиница;
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьСписокПоследнихШаблонов() 
	
	Элементы.Шаблон.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 10
	|	ДЛ_Шаблоны.Автор КАК Автор,
	|	ДЛ_Шаблоны.ДатаСоздания КАК ДатаСоздания,
	|	ДЛ_Шаблоны.Наименование КАК Наименование
	|ИЗ
	|	РегистрСведений.ДЛ_Шаблоны КАК ДЛ_Шаблоны
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛ_Шаблоны.ДатаИспользования УБЫВ";   
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл		
		
		Элементы.Шаблон.СписокВыбора.Добавить(СформироватьКлючШаблонаСтрокой(Выборка), СтрШаблон("%1 Дата создания: %2", Выборка.Наименование, Выборка.ДатаСоздания));
		
	КонецЦикла;
	
	Элементы.Шаблон.СписокВыбора.Добавить("ОткрытьВсеШаблоны", "--- Открыть все шаблоны ---");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоШаблонуНаСервере()	
	
	УпрощеннаяФормаЗаказа = Ложь;
	
	ЗаполнитьПоКлючуШаблона(ПолучитьСтруктуруКлючаШаблона(Шаблон));	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоКлючуШаблона(СтруктураКлюча) 
	
	ШаблонРегистра = РегистрыСведений.ДЛ_Шаблоны.СоздатьМенеджерЗаписи();
	ШаблонРегистра.Автор = СтруктураКлюча.Автор;
	ШаблонРегистра.ДатаСоздания = СтруктураКлюча.ДатаСоздания;
	ШаблонРегистра.Прочитать();   
	
	СтруктураДокумета = ШаблонРегистра.Данные.Получить();
	
	Если ЗначениеЗаполнено(СтруктураДокумета) Тогда
	
		ЗаполнитьДокументПоСтруктуреШаблона(СтруктураДокумета, ШаблонРегистра.СпособЗаполнения);
		
	КонецЕсли;
	
	ШаблонРегистра.ДатаИспользования = ТекущаяДатаСеанса();
	ШаблонРегистра.Записать(Истина);
	
	ЗаполнитьСписокПоследнихШаблонов();  			
		
	Шаблон = СформироватьКлючШаблонаСтрокой(СтруктураКлюча);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументПоСтруктуреШаблона(СтруктураШаблона, СпособЗаполнения)  	
	
	Если СпособЗаполнения = 0 Тогда 
	
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураШаблона);
		ВосстановитьЗначенияТаблицы(СтруктураШаблона, "ДополнительныеУслуги");
		ВосстановитьЗначенияТаблицы(СтруктураШаблона, "ДоставкаДополнительныеТребования");
		ВосстановитьЗначенияТаблицы(СтруктураШаблона, "ОтгрузкаДополнительныеТребования");
		ВосстановитьЗначенияТаблицы(СтруктураШаблона, "НаложенныйПлатежТовары");
		
	ИначеЕсли СпособЗаполнения = 1 Тогда 
		
		Для Каждого ЭлементШаблона Из СтруктураШаблона Цикл  
			
			Если Лев(ЭлементШаблона.Ключ, 8) = "Таблица_" Тогда
				
				ИмяТаблицы = СтрЗаменить(ЭлементШаблона.Ключ, "Таблица_", "");
				
				Если Не ЭтоТаблицаСДанными(ЭтаФорма, ИмяТаблицы) Тогда  
					
					ВосстановитьЗначенияТаблицы(СтруктураШаблона, ИмяТаблицы);
					
				КонецЕсли;
				
			ИначеЕсли Не ЗначениеЗаполнено(ЭтаФорма[ЭлементШаблона.Ключ]) Тогда 
				
				ЭтаФорма[ЭлементШаблона.Ключ] = ЭлементШаблона.Значение;	
				
			КонецЕсли;		
			
		КонецЦикла;
		
	ИначеЕсли СпособЗаполнения = 2 Тогда
		
		Для Каждого ЭлементШаблона Из СтруктураШаблона Цикл 
			
			Если Лев(ЭлементШаблона.Ключ, 8) = "Таблица_" Тогда				
				
				Если ЭтоТаблицаСДанными(СтруктураШаблона, ЭлементШаблона.Ключ) Тогда  
					
					ВосстановитьЗначенияТаблицы(СтруктураШаблона, СтрЗаменить(ЭлементШаблона.Ключ, "Таблица_", ""));
					
				КонецЕсли; 
				
			ИначеЕсли ЗначениеЗаполнено(ЭлементШаблона.Значение) Тогда 
				
				ЭтаФорма[ЭлементШаблона.Ключ] = ЭлементШаблона.Значение;	
				
			КонецЕсли; 	
			
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриВыбореШаблона(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	ЗаполнитьПоКлючуШаблона(Результат); 	
		
	ОбновитьФормуПриВыбореШаблона();
	
	ШаблонПриИзменении(Неопределено);
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьФормуПриВыбореШаблона() 
		
	УстановитьВидимостьДоступностьНаСтраницеОсновная();  
	УстановитьВидимостьДоступностьГруппыВГХ();
	ВидДоставкиПриИзменении(Неопределено);
	ПогрузочноРазгрузочныеРаботыПриИзменении(Неопределено);
	ДоставкаПогрузочноРазгрузочныеРаботыПриИзменении(Неопределено);
	ДополнительныеТребованияЗаблокироватьНесовместимыеПоля("Отгрузка");
	ДополнительныеТребованияЗаблокироватьНесовместимыеПоля("Доставка");
	УстановитьВидимостьРучнойВводКонтрагентов("Отправитель");
	УстановитьВидимостьРучнойВводКонтрагентов("Получатель");
	
	ОбновитьВыбранныеВидыДоставки(); 
	
	Если Не ФайловыйВариант Тогда
		
		ПредварительныйРасчет(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры 
                                    
&НаКлиенте
Процедура ШаблонПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Шаблон) Тогда 
		
		Элементы.ЗаполнитьПоШаблону.Видимость = Ложь;  
		Элементы.Шаблон.КнопкаОткрытия = Ложь;
		
	ИначеЕсли Шаблон = "ОткрытьВсеШаблоны" Тогда
		
		Элементы.ЗаполнитьПоШаблону.Видимость = Истина;
		Элементы.ЗаполнитьПоШаблону.Заголовок = "Открыть"; 
		Элементы.Шаблон.КнопкаОткрытия = Ложь;
		
	Иначе 
		
		Элементы.ЗаполнитьПоШаблону.Видимость = Истина; 
		Элементы.ЗаполнитьПоШаблону.Заголовок = "Заполнить";
		Элементы.Шаблон.КнопкаОткрытия = Истина;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ШаблонОчистка(Элемент, СтандартнаяОбработка)
	
	ШаблонПриИзменении(Элемент);
	
КонецПроцедуры

&НаСервере
Функция ЭтоТаблицаСДанными(Источник, ИмяТаблицы)
	
	Результат = Ложь;
	
	Если ИмяТаблицы = "НаложенныйПлатежТовары" Тогда
		
		Результат = Источник[ИмяТаблицы].Количество() > 0;
		
	Иначе 
		
		Для Каждого СтрокаДанных Из Источник[ИмяТаблицы] Цикл
			
			Если СтрокаДанных["Использовать"] = Истина Тогда
				
				Результат = Истина;
				
				Прервать;
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции    

&НаКлиенте
Процедура ШаблонОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтруктураКлюча = ПолучитьСтруктуруКлючаШаблона(Шаблон); 	
	ПарметрыОткрытия = Новый Структура("Ключ", СтруктураКлюча.КлючЗаписи);
	
	ОткрытьФорму("РегистрСведений.ДЛ_Шаблоны.ФормаЗаписи", ПарметрыОткрытия);
	
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруКлючаШаблона(Шаблон)
	
	Результат = Новый Структура("Автор, ДатаСоздания");
	
	СтруктураКлюча = ДЛ_ДеловыеЛинии.ДесериализоватьСтруктуруПараметров(Шаблон);  
	
	Результат.Автор = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(СтруктураКлюча["Автор"]));
	Результат.ДатаСоздания = ДЛ_ДеловыеЛинии.ПреобразоватьВДату(СтруктураКлюча["ДатаСоздания"]); 
	
	КлючЗаписи = РегистрыСведений.ДЛ_Шаблоны.СоздатьКлючЗаписи(Результат);
	
	Результат.Вставить("КлючЗаписи", КлючЗаписи);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СформироватьКлючШаблонаСтрокой(ДанныеШаблона)	
	
	СтруктураКлюча = Новый Структура; 
	СтруктураКлюча.Вставить("Автор", XMLСтрока(ДанныеШаблона.Автор));
	СтруктураКлюча.Вставить("ДатаСоздания", ДанныеШаблона.ДатаСоздания);
	
	Возврат ДЛ_ДеловыеЛинии.СериализоватьСтруктуруПараметров(СтруктураКлюча);
	
КонецФункции

&НаКлиенте
Процедура УпрощеннаяФормаЗаказаПриИзменении(Элемент)
	
	Если УпрощеннаяФормаЗаказа Тогда
		
		СпособОтгрузки = 1;	
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("При оформлении заказа из упрощенной формы, стоимость перевозки будет объявлена после замера груза на терминале"); 
		
	Иначе
		
		ПереключательРасшифровкиПриИзменении(Неопределено);	
		
	КонецЕсли;  
	
	УстановитьВидимостьДоступностьНаСтраницеОсновная();
	ЗаблокироватьОтправкуЗаказа(); 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементовУпрощеннаяФормаЗаказа()  
	
	Элементы.СпособОтгрузки.Доступность = Не УпрощеннаяФормаЗаказа;		
	Элементы.днВГХ.Видимость = Не УпрощеннаяФормаЗаказа;
	Элементы.ГруппаПерезаполнитьПоОснованиям.Видимость = Не УпрощеннаяФормаЗаказа;	
