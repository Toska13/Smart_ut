&НаСервере
Функция СообщениеОбОшибкеЗаказа(ОшибкаЗаказа) 
	
	Сообщение = "";  
	
	Если ТипЗнч(ОшибкаЗаказа["fields"]) = Тип("Массив") И ОшибкаЗаказа["fields"].Количество() > 0 Тогда
		
		ПолеСОшибкой = ОшибкаЗаказа["fields"][0];	
		
		Если ОшибкаЗаказа["title"] = "Ошибка типизации" Тогда 
			
			Если ПолеСОшибкой = "delivery.deliveryType.type" Тогда
				
				Сообщение = "Не заполнен Вид доставки";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.time.worktimeStart" Тогда
				
				Сообщение = "Не заполнено Время начала работы Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.time.worktimeEnd" Тогда
				
				Сообщение = "Не заполнено Время окончания работы Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.produceDate" Тогда
				
				Сообщение = "Дата отгрузки заполнена некорректно";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeStart" Тогда
				
				Сообщение = "Не заполнено Время начала работы Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeEnd" Тогда
				
				Сообщение = "Не заполнено Время окончания работы Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "payment.type" Тогда
				
				Сообщение = "Не заполнена Форма оплаты";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.serial" Тогда
				
				Сообщение = "Проверьте правильность заполнения паспортных данных Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "payment.primaryPayer" Тогда
				
				Сообщение = "Не заполнен Плательщик";
				
			ИначеЕсли ПолеСОшибкой = "payment.cashOnDelivery.cashOnDeliveryItem.orderDate" Тогда
				
				Сообщение = "Не заполнена Дата внутреннего заказа";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.terminalID" Тогда
				
				Сообщение = "Не заполнен Терминал Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.terminalID" Тогда
				
				Сообщение = "Не заполнен Терминал Получателя";	 
				
			ИначеЕсли ПолеСОшибкой = "delivery.packages.package.count" Тогда
				
				Сообщение = "Убедитесь, что количество грузовых мест больше или равно 1";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Убедитесь, что в номере телефона Отправителя не больше 15 символов.";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Убедитесь, что в номере телефона Получателя не больше 15 символов.";
				
			ИначеЕсли ПолеСОшибкой = "produce_date" Тогда
				
				Сообщение = "Неправильный формат даты. Используйте формат YYYY-MM-DD";
				
			ИначеЕсли ПолеСОшибкой = "time.worktimeStart" Тогда
				
				Сообщение = "Неправильный формат времени. Используйте один формат hh:mm.";
				
			ИначеЕсли ПолеСОшибкой = "time.worktimeEnd" Тогда
				
				Сообщение = "Неправильный формат времени. Используйте один формат hh:mm.";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.number" Тогда
				
				Сообщение = ОшибкаЗаказа["detail"];	
				
			КонецЕсли;  
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Отсутствует обязательный параметр" Тогда
			
			Если ПолеСОшибкой = "delivery.derival.address.search" Тогда
				
				Сообщение = "Не заполнен Адрес доставки Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Не заполнен Адрес доставки Получателя";
				
			ИначеЕсли ПолеСОшибкой = "cargo.freightUID" Тогда
				
				Сообщение = "Не заполнен Характер груза";
				
			ИначеЕсли ПолеСОшибкой = "payment.paymentCity" Тогда
				
				Сообщение = "Не заполнено Место оплаты";
				
			ИначеЕсли ПолеСОшибкой = "members.requester.role" Тогда
				
				Сообщение = "Не заполнена роль Заказчика";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.contactPersons.contactPerson.name" Тогда
				
				Сообщение = "Не заполнено Контактное лицо Отправителя";
				
