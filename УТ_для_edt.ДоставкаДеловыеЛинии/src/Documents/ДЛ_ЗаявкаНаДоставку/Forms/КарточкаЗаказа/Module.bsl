&НаСервереБезКонтекста
Функция ПолучитьМинимальныеЗначенияВГХ()
	
	Результат = Новый Структура;
	
	МинимальнаяДлина = Константы.ДЛ_МинимальнаяДлина.Получить();
	Результат.Вставить("МинимальнаяДлина", ?(ЗначениеЗаполнено(МинимальнаяДлина), МинимальнаяДлина, 0.1)); 
	МинимальнаяШирина = Константы.ДЛ_МинимальнаяШирина.Получить();
	Результат.Вставить("МинимальнаяШирина", ?(ЗначениеЗаполнено(МинимальнаяШирина), МинимальнаяШирина, 0.1));
	МинимальнаяВысота = Константы.ДЛ_МинимальнаяВысота.Получить();
	Результат.Вставить("МинимальнаяВысота", ?(ЗначениеЗаполнено(МинимальнаяВысота), МинимальнаяВысота, 0.1));
	МинимальныйОбъем = Константы.ДЛ_МинимальныйОбъем.Получить();
	Результат.Вставить("МинимальныйОбъем", ?(ЗначениеЗаполнено(МинимальныйОбъем), МинимальныйОбъем, 0.01));
	МинимальныйВес = Константы.ДЛ_МинимальныйВес.Получить();  
	Результат.Вставить("МинимальныйВес", ?(ЗначениеЗаполнено(МинимальныйВес), МинимальныйВес, 1));	
	
	Возврат Результат;	
	
КонецФункции

