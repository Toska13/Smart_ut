&НаКлиенте
Процедура КонтрагентОПФНачалоВыбора(Префикс, СтандартнаяОбработка)
	
	Если ЭтаФорма[Префикс + "РучнойВвод"] = 1 Тогда
		
		СтандартнаяОбработка = Ложь;
		ОО = Новый ОписаниеОповещения("КонтрагентОПФРВВыбор", ЭтаФорма, Префикс); 
		ЗначениеОтбора = Новый Структура("СтранаUID", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ЭтаФорма[Префикс + "КонтрагентСтрана"], "UID"));
		ОткрытьФорму("Справочник.ДЛ_ОПФ.ФормаВыбора",  Новый Структура("РежимВыбора, Отбор", Истина, ЗначениеОтбора), ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентОПФРВВыбор(Результат, Префикс) Экспорт 
	
	Если Результат <> Неопределено Тогда
		
		ЭтаФорма[Префикс + "КонтрагентОПФ"] = Результат;	
		
	КонецЕсли;  
	
КонецПроцедуры   

&НаКлиенте
Процедура КонтрагентВыборКонтрагентаИзСписка(Результат, Префикс) Экспорт 
	
	Если Результат <> Неопределено Тогда
		
		ЭтаФорма[Префикс + "КонтрагентНаименование"] = Результат.Значение.Наименование;
		ЭтаФорма[Префикс + "КонтрагентИНН"] = Результат.Значение.ИНН;
		
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Префикс)
	
	Если ЭтаФорма[Префикс + "РучнойВвод"] = 1 И СокрЛП(ЭтаФорма[Префикс + "КонтрагентСтрана"]) = "Россия" Тогда
		
		СписокКонтрагентов = ПолучитьСписокКонтрагентовAPI(Префикс);
		
		Если СписокКонтрагентов.Количество() = 1 Тогда
			
			ЭтаФорма[Префикс + "КонтрагентНаименование"] = СписокКонтрагентов[0].Значение.Наименование; 
			ЭтаФорма[Префикс + "КонтрагентИНН"] = СписокКонтрагентов[0].Значение.ИНН;		
			
		ИначеЕсли СписокКонтрагентов.Количество() > 1 Тогда 
			
			ОО = Новый ОписаниеОповещения("КонтрагентВыборКонтрагентаИзСписка", ЭтаФорма, Префикс); 
			
			ПоказатьВыборИзСписка(ОО, СписокКонтрагентов, Элементы[Префикс + "Контрагент"]); 	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры  

