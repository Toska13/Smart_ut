
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	ДатаОтгрузки = ТекущаяДатаСеанса() + 24 * 60 * 60; 
	ГрузКоличествоГрузовыхМест = 1; 
	ИспользоватьРазличныхПлательщиков = Истина; 
	ФормаОплатыПредставление = "noncash";
	ВремяДоставкиС = '00010101090000';
	ВремяДоставкиПо = '00010101180000';	
	ВремяОтгрузкиС = '00010101090000';
	ВремяОтгрузкиПо = '00010101180000'; 
	ЗаказчикКонтрагентСсылка = Константы.ДЛ_Заказчик.Получить();
	НашаРольВПеревозке = Константы.ДЛ_РольВЗаказе.Получить(); 
	ФайловыйВариант = ДЛ_ДеловыеЛинииПовтИсп.ФайловыйРежимЗапускаБазы();
	
	Объект.ДокументыОснования.Очистить();
	
	Если Параметры.Свойство("ДокументОснование") Тогда 		
		 
		НоваяСтрока = Объект.ДокументыОснования.Добавить();
		НоваяСтрока.Документ = Параметры.ДокументОснование;
		
	КонецЕсли; 
	
	Если Параметры.Свойство("ДанныеЗаказаСтрокой") Тогда 
		
		ЗаполнитьПоДаннымСуществующегоЗаказа(ДЛ_ДеловыеЛинии.ДесериализоватьСтруктуруПараметров(Параметры.ДанныеЗаказаСтрокой));	
		
	КонецЕсли;
	
	ЗаполнитьПоДокументамОснованиям();	
	ЗаполнитьДополнительныеУслуги();
	ЗаполнитьДополнительныеТребования(); 
	ЗаполнитьПервичноРезультатПредрсчета();
	ЗаполнитьСписокПоследнихШаблонов();
	
	ВосстановитьИзЧерновика();
	
	ВремяОткрытияФормы = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеОбязательныхРеквизитов(НомерШага, Отказ, ВыводитьПредупреждения = Истина, ПолучитьТарифыАвтоматически = Ложь)
	
	ОчиститьСообщения();
	
	Если НомерШага <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	ОбязательныеРеквизиты = ОбязательныеРеквизитыДляПереходаНаСтраницу(НомерШага);
	
	ТекстОшибки = НСтр("ru = 'Поле ""%1"" на шаге ""%2"" не заполнено';
						|en = 'Field ""%1"" is not filled in on the step ""%2""'");
	
	ШагОшибки = 10;
	
	ПроверитьЗаполнениеРеквизитовНаСервере(ШагОшибки, Отказ, ВыводитьПредупреждения);
	
	ЕстьОшибки = Ложь;
	ПроверитьТелефоныКонтактныхЛиц(ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 0;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ПроверитьEmailКонтактныхЛиц(ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 0;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	Если НомерШага = 4 Тогда
		ЕстьОшибки = Ложь;
		ТекущийШагОшибки = ПроверитьВремяОтгрузки(ЕстьОшибки, Истина);
		Если ЕстьОшибки Тогда
			ШагОшибки = Мин(ШагОшибки, ТекущийШагОшибки);
			Отказ = Истина;
		КонецЕсли;		
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ПроверитьВГХ("",ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 1;
	КонецЕсли;	
	
	Для Каждого ТекущийРеквизит Из ОбязательныеРеквизиты Цикл
		
		ПараметрыРеквизита = СтрРазделить(ТекущийРеквизит.Значение, ".");
		ШагТекущейОшибки = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ПараметрыРеквизита[0]);
		Значение = ПараметрыРеквизита[1];
		
		Если ШагТекущейОшибки > ШагОшибки Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ЭтотОбъект[Значение]) Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, 
										ТекущийРеквизит.Представление, 
										Элементы.ГруппаСтраницы.ПодчиненныеЭлементы[ШагТекущейОшибки].Заголовок);
										
			Отказ = Истина;
			Если ВыводитьПредупреждения Тогда
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,Значение,,Отказ);
			КонецЕсли;
			
			ШагОшибки = Мин(ШагОшибки, ШагТекущейОшибки);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НомерШага = 5 И НЕ Отказ Тогда
		ТекущийШагОшибки = ПроверитьВремяОтгрузки(ЕстьОшибки, Истина);
		
		Если ЕстьОшибки Тогда
			ШагОшибки = Мин(ШагОшибки, ТекущийШагОшибки);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;	
			
КонецПроцедуры

&НаКлиенте
Функция ОбязательныеРеквизитыДляПереходаНаСтраницу(НомерШага)
	
	ОбязательныеРеквизиты = Новый СписокЗначений();
	
	Если НомерШага <= 1 Тогда
		Возврат ОбязательныеРеквизиты;
	КонецЕсли;
	
	ОбязательныеРеквизиты.Добавить("0.ОтправительКонтрагентНаименование", НСтр("ru = 'Отправитель';
																				|en = 'Sender'"));
	
	Если ЗначениеЗаполнено(ОтправительКонтрагентНаименование) Тогда
		Если НомерШага > 3  Тогда
			ОбязательныеРеквизиты.Добавить("0.ОтправительКонтактноеЛицоНаименование",
				НСтр("ru = 'Контактное лицо отправителя';
					|en = 'Sender contact person'"));
			ОбязательныеРеквизиты.Добавить("0.ОтправительКонтактноеЛицоТелефонПредставление",
				НСтр("ru = 'Телефон контактного лица отправителя';
					|en = 'Phone number of sender contact person'"));			
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОбязательныеРеквизиты.Добавить("0.ПолучательКонтрагентНаименование", НСтр("ru = 'Получатель';
																				|en = 'Recipient'"));
	
	Если ЗначениеЗаполнено(ПолучательКонтрагентНаименование) Тогда
		Если НомерШага > 3 Тогда
			ОбязательныеРеквизиты.Добавить("0.ПолучательКонтактноеЛицоНаименование",
				НСтр("ru = 'Контактное лицо получателя';
					|en = 'Recipient contact person'"));
			ОбязательныеРеквизиты.Добавить("0.ПолучательКонтактноеЛицоТелефонПредставление",
				НСтр("ru = 'Телефон контактного лица получателя';
					|en = 'Phone number of recipient contact person'"));  		
				
		КонецЕсли;
		
	КонецЕсли;
	
	ОбязательныеРеквизиты.Добавить("0.ПлательщикРоль", НСтр("ru = 'Роль плательщика';
															|en = 'Payer role'"));

	Если ПлательщикРоль = 3 Тогда
		ОбязательныеРеквизиты.Добавить("0.ПлательщикКонтрагентНаименование", НСтр("ru = 'Плательщик';
																					|en = 'Payer'"));
		Если ЗначениеЗаполнено(ПлательщикКонтрагентНаименование) Тогда
			Если НомерШага > 3 Тогда
				ОбязательныеРеквизиты.Добавить("0.ПлательщикКонтактноеЛицоНаименование",
					НСтр("ru = 'Контактное лицо плательщика';
						|en = 'Payer contact person'"));
				ОбязательныеРеквизиты.Добавить("0.ПлательщикКонтактноеЛицоТелефонПредставление",
					НСтр("ru = 'Телефон контактного лица плательщика';
						|en = 'Phone number of payer contact person'"));
					
				Если ПлательщикКонтактноеЛицоТелефонДополнительныйДоступен Тогда
					ОбязательныеРеквизиты.Добавить("0.ПлательщикКонтактноеЛицоТелефонДополнительныйПредставление",
						НСтр("ru = 'Дополнительный телефон контактного лица плательщика';
							|en = 'Additional phone number of payer contact person'"));
				КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	ОбязательныеРеквизиты.Добавить("0.ДатаОтгрузки", НСтр("ru = 'Дата отгрузки';
															|en = 'Shipment date'"));		
	
	ОбязательныеРеквизиты.Добавить("1.ГрузКоличествоГрузовыхМест", НСтр("ru = 'Количество мест';
																		|en = 'Unit load quantity'"));
	Если ГрузКоличествоГрузовыхМест > 1 Тогда
		ОбязательныеРеквизиты.Добавить("1.ГрузВес", НСтр("ru = 'Общий вес';
														|en = 'Total weight'"));
	КонецЕсли;	
	
	ОбязательныеРеквизиты.Добавить("1.ГрузМаксимальныйВес", НСтр("ru = 'Вес';
																|en = 'Weight'"));
	ОбязательныеРеквизиты.Добавить("1.ГрузОбъем", НСтр("ru = 'Объем';
														|en = 'Volume'"));
	ОбязательныеРеквизиты.Добавить("1.ГрузМаксимальнаяВысота", НСтр("ru = 'Высота';
																	|en = 'Height'"));
	ОбязательныеРеквизиты.Добавить("1.ГрузМаксимальнаяШирина", НСтр("ru = 'Ширина';
																	|en = 'Width'"));
	ОбязательныеРеквизиты.Добавить("1.ГрузМаксимальнаяДлина", НСтр("ru = 'Длина';
																	|en = 'Length'"));	
	
	Возврат ОбязательныеРеквизиты;
	
КонецФункции

&НаСервере
Процедура ПроверитьЗаполнениеРеквизитовНаСервере(ШагОшибки, Отказ, ВыводитьПредупреждения = Истина)
	
	ЕстьОшибки = Ложь;
	ПроверитьРеквизитыКонтрагентов(ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 0;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ПроверитьРеквизитыАдресов(ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 0;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ПроверитьДатуОтгрузки(ЕстьОшибки, ВыводитьПредупреждения);
	Если ЕстьОшибки Тогда
		Отказ = Истина;
		ШагОшибки = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТелефоныКонтактныхЛиц(ЕстьОшибки, ВыводитьПредупреждения)
	
	ПроверитьНомерТелефона("ОтправительКонтактноеЛицоТелефон", ЕстьОшибки, ВыводитьПредупреждения); 

	ПроверитьНомерТелефона("ПолучательКонтактноеЛицоТелефон", ЕстьОшибки, ВыводитьПредупреждения); 	
	
	Если ПлательщикРоль = 3 Тогда
		ПроверитьНомерТелефона("ПлательщикКонтактноеЛицоТелефон", ЕстьОшибки, ВыводитьПредупреждения);
		
		Если ПлательщикКонтактноеЛицоТелефонДополнительныйДоступен Тогда
			ПроверитьНомерТелефона("ПлательщикКонтактноеЛицоТелефонДополнительный", ЕстьОшибки, ВыводитьПредупреждения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьEmailКонтактныхЛиц(ЕстьОшибки, ВыводитьПредупреждения)
	
	ПроверитьEmail("ПлательщикКонтактноеЛицоEmail", ЕстьОшибки, ВыводитьПредупреждения);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРеквизитыКонтрагентов(ЕстьОшибки, ВыводитьПредупреждения = Истина)
	
	ПроверитьРеквизитыКонтрагента("ОтправительКонтрагент", ЕстьОшибки, ВыводитьПредупреждения);
	ПроверитьРеквизитыКонтрагента("ПолучательКонтрагент", ЕстьОшибки, ВыводитьПредупреждения);
	
	Если ПлательщикРоль = 3 Тогда
		ПроверитьРеквизитыКонтрагента("ПлательщикКонтрагент", ЕстьОшибки, ВыводитьПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРеквизитыКонтрагента(Префикс, ЕстьОшибки, ВыводитьПредупреждения = Истина)   
	
	Если ЭтотОбъект[Префикс + "Иностранец"] Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИмяРеквизита = Префикс + "Наименование";
	КонтрагентСсылка = ЭтотОбъект[Префикс + "Ссылка"];
	КонтрагентНаименование = ЭтотОбъект[Префикс + "Наименование"];
	КонтрагентЮрФизЛицо = ЭтотОбъект[Префикс + "ЮрФизЛицо"];
	КонтрагентИНН = ЭтотОбъект[Префикс + "ИНН"];
	КонтрагентКПП = ЭтотОбъект[Префикс + "КПП"];
	
	ЭтоОтправитель = (СтрНайти(Префикс, "Отправитель") > 0);
	
	Если Не ЗначениеЗаполнено(КонтрагентСсылка) 
		И КонтрагентНаименование = "" Тогда
		Возврат;
	КонецЕсли;
	
	УчастникГрузоперевозки = СтрЗаменить(Префикс, "Контрагент", "");
	
	ТекстОшибки = НСтр("ru = 'Некорректный реквизит ""%1"" у участника грузоперевозки в поле ""%2"".';
						|en = 'Cargo transportation participant has Incorrect attributes ""%1"" in the field ""%2""'");
	
	Если ЗначениеЗаполнено(КонтрагентСсылка) 
		И КонтрагентНаименование = "" Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ТекстОшибки,
			НСтр("ru = 'Наименование';
				|en = 'Description'"),
			УчастникГрузоперевозки);
		
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
		КонецЕсли;
		
	КонецЕсли; 
	
	Если КонтрагентЮрФизЛицо <> 2 Тогда
	
		Если Не ЗначениеЗаполнено(КонтрагентИНН) Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстОшибки,
				НСтр("ru = 'ИНН';
					|en = 'TIN'"),
				УчастникГрузоперевозки);
			
			ЕстьОшибки = Истина;
			Если ВыводитьПредупреждения Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда
				
				ТекстСообщения = "";
				Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(КонтрагентИНН, КонтрагентЮрФизЛицо = 1,
					ТекстСообщения) Тогда
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						ТекстОшибки,
						НСтр("ru = 'ИНН';
							|en = 'TIN'"),
						УчастникГрузоперевозки)
						+ Символы.ПС + ТекстСообщения;
				
					ЕстьОшибки = Истина;
					Если ВыводитьПредупреждения Тогда
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
					КонецЕсли;
					
				КонецЕсли;
			
			Иначе 
				
				ТекстСообщения = "";
				Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(КонтрагентИНН, Ложь,
					ТекстСообщения) Тогда 
					
					ТекстСообщения = ""; 
					Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(КонтрагентИНН, Истина,
						ТекстСообщения) Тогда
					
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							ТекстОшибки,
							НСтр("ru = 'ИНН';
								|en = 'TIN'"),
							УчастникГрузоперевозки)
							+ Символы.ПС + ТекстСообщения;
					
						ЕстьОшибки = Истина;
						Если ВыводитьПредупреждения Тогда
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЕсли;
	
	КонтрагентЮридическийАдрес = ЭтотОбъект[Префикс + "ЮридическийАдресПредставление"];  		
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьПаспортныеДанные(КонтрагентСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
	|			,
	|			Физлицо = &Физлицо
	|				И ВидДокумента = &ВидДокумента) КАК ДокументыФизическихЛицСрезПоследних"; 
	Запрос.УстановитьПараметр("Физлицо", КонтрагентСсылка);
	Запрос.УстановитьПараметр("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Новый Структура("Серия, Номер", "", "");
		
	Иначе
		
		Возврат Результат.Выгрузить()[0];
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПроверитьРеквизитыАдресов(ЕстьОшибки, ВыводитьПредупреждения)
	
	ПроверитьРеквизитыАдреса("ОтправительАдрес", ЕстьОшибки, ВыводитьПредупреждения);
	ПроверитьРеквизитыАдреса("ПолучательАдрес", ЕстьОшибки, ВыводитьПредупреждения);
	Если ПлательщикРоль = 3 Тогда
		ПроверитьРеквизитыАдреса("ПлательщикАдрес", ЕстьОшибки, ВыводитьПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьРеквизитыАдреса(ИмяРеквизита, ЕстьОшибки, ВыводитьПредупреждения)	
	
	ЗначениеРеквизита = ЭтотОбъект[ИмяРеквизита + "Значение"];
	ЗначениеПредставление = ЭтотОбъект[ИмяРеквизита + "Представление"];
	
	ИмяПоля = ИмяРеквизита;
	ЗаголовокПоля = ИмяРеквизита;
	ПутьКДанным = "";
	
	Если Найти(ИмяРеквизита, "ЮридическийАдрес") Тогда
		ИмяПоля = СтрЗаменить(ИмяРеквизита, "ЮридическийАдрес", "");
		ВладелецАдреса = ЭтотОбъект[ИмяПоля + "Наименование"];
		
		ТекстОшибкиПустогоАдреса = НСтр("ru = 'Не заполнен юридический адрес у участника грузоперевозки ""%1"".
										|Добавьте юридический адрес участнику ""%1"".';
										|en = 'The legal address of the cargo transportation participant is not filled in. ""%1"".
										|Add legal address to the participant ""%1"".'");
		
		ТекстОшибкиНекорректногоАдреса = НСтр("ru = 'Некорректный формат юридического адреса у участника грузоперевозки ""%1"". 
											|Проверьте корректность адреса вручную.';
											|en = 'Incorrect format of the legal address of the cargo transportation participant ""%1"". 
											|Check address manually.'");
		
		Если Найти(ИмяРеквизита, "Отправитель") Тогда
			ЗаголовокПоля = "Отправитель";
		ИначеЕсли Найти(ИмяРеквизита, "Получатель") Тогда
			ЗаголовокПоля = "Получатель";
		ИначеЕсли Найти(ИмяРеквизита, "Плательщик") Тогда
			ЗаголовокПоля = "Плательщик";
		КонецЕсли;
		
		ЭлементФормы = ЭтотОбъект.Элементы.Найти(ИмяПоля);
		Если ЭлементФормы <> Неопределено Тогда
			ПутьКДанным = ЭлементФормы.ПутьКДанным;
		КонецЕсли;
		
	Иначе
		ВладелецАдреса = ЭтотОбъект[ИмяРеквизита + "Владелец"];
		
		ТекстОшибкиПустогоАдреса = НСтр("ru = 'У выбранного в поле ""%1"" владельца адреса не заполнен адрес доставки/склада.
										|Добавьте адрес доставки/склада для этого владельца или введите произвольный адрес.';
										|en = 'Warehouse/delivery address is not filled in the field ""%1"" of selected owner.
										|Add a delivery/warehouse address for this owner or enter arbitrary address.'");
		
		ТекстОшибкиНекорректногоАдреса = НСтр("ru = 'Некорректный формат адреса в поле ""%1"". 
											|Проверьте корректность адреса вручную.';
											|en = 'Incorrect address format in the field ""%1"". 
											|Check address manually.'");
		
		ЭлементФормы = ЭтотОбъект.Элементы.Найти(ИмяПоля);
		
		Если ЭлементФормы <> Неопределено Тогда
			ЗаголовокПоля = ЭлементФормы.Заголовок;
			ПутьКДанным = ЭлементФормы.ПутьКДанным;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВладелецАдреса)
		И Не ЗначениеЗаполнено(ЗначениеПредставление) Тогда
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстОшибкиПустогоАдреса,
				ЗаголовокПоля)
				,,ПутьКДанным);
		КонецЕсли;
		Возврат;
	КонецЕсли;
				
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		
		ЕстьОшибки = Истина;
		Если ЗначениеЗаполнено(ЗначениеПредставление) Тогда
			
			Если ВыводитьПредупреждения Тогда
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекстОшибкиНекорректногоАдреса,
					ЗаголовокПоля)
					,,ПутьКДанным);
			КонецЕсли;
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	СтруктураАдреса = Адрес_ЗначениеИзСтрокиJSON(ЗначениеРеквизита);
	
	Если Не ЗначениеЗаполнено(СтруктураАдреса) Тогда
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстОшибкиНекорректногоАдреса,
				ЗаголовокПоля)
				,,ПутьКДанным);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СписокОшибок = РаботаСАдресами.ПроверитьАдрес(ЗначениеРеквизита).СписокОшибок;
	
	Если СписокОшибок.Количество() <> 0 Тогда
		ЕстьОшибки = Истина;
		
		Если НЕ СписокОшибок[0].Пометка Тогда
			Если ВыводитьПредупреждения Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиНекорректногоАдреса,
					ЗаголовокПоля)
					,,ПутьКДанным);
			КонецЕсли;
				
		Иначе
			
			Если ВыводитьПредупреждения Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					ТекстОшибкиНекорректногоАдреса,
					ЗаголовокПоля);
					
				Для Каждого ТекущаяОшибка Из СписокОшибок Цикл
					ТекстОшибки = ТекстОшибки + Символы.ПС + ТекущаяОшибка.Представление;
				КонецЦикла;
				
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,ПутьКДанным);
			КонецЕсли;
			
		КонецЕсли;                                  
	ИначеЕсли СтруктураАдреса.Свойство("Id") И Не ЗначениеЗаполнено(СтруктураАдреса.Id) Тогда
		
		ЕстьОшибки = Истина;
		
		Если ВыводитьПредупреждения Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстОшибкиНекорректногоАдреса,
				ЗаголовокПоля)
				,,ПутьКДанным);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьДатуОтгрузки(ЕстьОшибки, ВыводитьПредупреждения)
	
	Если ЗначениеЗаполнено(ДатаОтгрузки) Тогда
	
		ТекущаяДата = '00010101';
		УстановитьДатуОтгрузки(ТекущаяДата);
		
		Если ТекущаяДата > ДатаОтгрузки Тогда
			
			ЕстьОшибки = Истина;
			Если ВыводитьПредупреждения Тогда
				ТекстОшибки = НСтр("ru = 'Выбранная дата отгрузки недоступна. Укажите актуальную дату.';
									|en = 'Selected shipment date is not available. Specify actual date.'");
				ТекстСообщения = ТекстОшибки;
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,"ДатаОтгрузки");
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Процедура УстановитьДатуОтгрузки(ДатаОтгрузки)
	
	ТекущаяДата = ТекущаяДатаСеанса();
	
	ДатаОтгрузки = НачалоДня(ДатаОтгрузки);
	
	Если ДатаОтгрузки < НачалоДня(ТекущаяДата) Тогда
		ДатаОтгрузки = НачалоДня(ТекущаяДата);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВремяОтгрузки(ЕстьОшибки, ВыводитьПредупреждения)
	
	ШагОшибки = 0;
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	НачалоТекущегоДня = НачалоДня(ТекущаяДата);
	ТекущееВремя = Дата(1,1,1) + (ТекущаяДата - НачалоТекущегоДня);
	НачалоДняОтгрузки = НачалоДня(ДатаОтгрузки); 
	
	Если НачалоТекущегоДня = НачалоДняОтгрузки
		И ВремяОтгрузкиПо <> Дата(1,1,1,0,0,0)
		И ТекущееВремя > ВремяОтгрузкиПо Тогда
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ТекстОшибки = НСтр("ru = 'Невозможно оформить доставку на указанное время отгрузки. Время отгрузки меньше, чем текущее.';
			|en = 'Cannot register delivery for the specified shipment time. The shipment time is less than the current one.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,"ОтправительВремяПлановойОтгрузки");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ШагОшибки;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьНомерТелефона(Префикс, ЕстьОшибки, ВыводитьПредупреждения = Истина)
	
	ИмяРеквизита = Префикс + "Представление";
	
	ИмяГруппы = "";
	Если СтрНайти(ИмяРеквизита, "Отправитель") > 0 Тогда
		ИмяГруппы = "Отправитель";
	ИначеЕсли СтрНайти(ИмяРеквизита, "Получатель") > 0 Тогда
		ИмяГруппы = "Получатель";
	ИначеЕсли СтрНайти(ИмяРеквизита, "Плательщик") > 0 Тогда
		ИмяГруппы = "Плательщик";
	КонецЕсли;
	
	Представление = ЭтотОбъект[ИмяРеквизита];
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Возврат;
	КонецЕсли;
	
	СписокОшибок = ОшибкиЗаполненияТелефона(Префикс);
	
	ЕстьОшибки = СписокОшибок.Количество();
	
	ТекстСообщения = "";
	Для Каждого ТекущаяОшибка Из СписокОшибок Цикл
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекущаяОшибка.Представление;
	КонецЦикла;
	
	ТекстСообщения = СокрЛП(ТекстСообщения);
	
	Если ВыводитьПредупреждения 
		И ЕстьОшибки Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Некорректный формат номера телефона в поле ""Телефон"" группы ""%1"".';
				|en = 'Incorrect format of phone number in the ""Phone"" field of the ""%1"" group.'"),
			ИмяГруппы);
		ТекстСообщения = ТекстОшибки + Символы.ПС + ТекстСообщения;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьEmail(Префикс, ЕстьОшибки, ВыводитьПредупреждения = Истина)
	
	ИмяРеквизита = Префикс;
	ЭтоEmailОтправителя = (СтрНайти(ИмяРеквизита, "Отправитель") > 0);
	
	Представление = ЭтотОбъект[ИмяРеквизита];
	
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Не ОбщегоНазначенияКлиентСервер.АдресЭлектроннойПочтыСоответствуетТребованиям(Представление);
	
	ТекстСообщения = "";
	
	Если ВыводитьПредупреждения 
		И ЕстьОшибки Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Адрес электронной почты группы ""%1"" содержит ошибки.';
				|en = 'The group ""%1"" email address contains errors.'"),
			?(ЭтоEmailОтправителя, "Отправитель", "Получатель"));
		ТекстСообщения = ТекстОшибки + Символы.ПС + ТекстСообщения;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,ИмяРеквизита);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОшибкиЗаполненияТелефона(Префикс)
	
	Представление = ЭтотОбъект[Префикс + "Представление"];
	Значение = ЭтотОбъект[Префикс + "Значение"];
	
	СписокОшибок = Новый СписокЗначений;
	
	Если Представление = "" Тогда
		Возврат СписокОшибок;
	КонецЕсли;
	
	СтруктураТелефона = Неопределено;
	
	Если Значение <> "" Тогда
		
		Отказ = Ложь;
		ТекстОшибки = "";
		СтруктураТелефона = ЗначениеИзСтрокиJSON(Значение, Отказ, ТекстОшибки);
		
	КонецЕсли;
	
	Если СтруктураТелефона = Неопределено Тогда
		
		Значение = КонтактнаяИнформацияПоПредставлению(Представление, "Телефон");
		ЭтотОбъект[Префикс + "Значение"] = Значение;
		Отказ = Ложь;
		ТекстОшибки = "";
		СтруктураТелефона = ЗначениеИзСтрокиJSON(Значение, Отказ, ТекстОшибки);
		
	КонецЕсли;
	
	ПолныйНомерТелефона = "";
	Если СтруктураТелефона.Свойство("countryCode") Тогда
		ПолныйНомерТелефона = ПолныйНомерТелефона + СтруктураТелефона.countryCode;
	КонецЕсли;
	
	Если СтруктураТелефона.Свойство("areaCode") Тогда
		ПолныйНомерТелефона = ПолныйНомерТелефона + СтруктураТелефона.areaCode;
	КонецЕсли;
	
	Если СтруктураТелефона.Свойство("number") Тогда
		ПолныйНомерТелефона = ПолныйНомерТелефона + СтруктураТелефона.number;
	КонецЕсли;
	
	НомерТелефонаТолькоЦифры = ТолькоЦифры(ПолныйНомерТелефона);
	
	Если СтрДлина(НомерТелефонаТолькоЦифры) < 10 Тогда
		СписокОшибок.Добавить("НомерТелефона", НСтр("ru = 'Номер телефона слишком короткий (менее 10 цифр)';
													|en = 'Too short phone number (less than 10 digits)'"));
	КонецЕсли;
	
	Если СтрДлина(НомерТелефонаТолькоЦифры) > 15 Тогда
		СписокОшибок.Добавить("НомерТелефона", НСтр("ru = 'Номер телефона слишком длинный';
													|en = 'Phone number is too long.'"));
	КонецЕсли;
	
	Если НомерТелефонаСодержитНедопустимыеСимволы(ПолныйНомерТелефона) Тогда
		СписокОшибок.Добавить("НомерТелефона", НСтр("ru = 'Номер телефона содержит недопустимые символы';
													|en = 'Phone number contains illegal characters.'"));
	КонецЕсли;
	
	Возврат СписокОшибок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗначениеИзСтрокиJSON(Значение, Отказ, ТекстОшибки)	
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	ПервыйСимвол = Лев(Значение, 1);
	Если ПервыйСимвол <> "[" И ПервыйСимвол <> "{" Тогда
		Возврат Значение;
	КонецЕсли;
	
	Результат = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(Значение);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ЕстьОшибка = Истина;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Сервис доставки.Преобразование данных.';
										|en = 'Delivery service. Data conversion.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТолькоЦифры(Знач СтрокаДляПроверки)
	
	ЛишниеСимволы = СтрСоединить(СтрРазделить(СтрокаДляПроверки, "0123456789"), "");
	Результат     = СтрСоединить(СтрРазделить(СтрокаДляПроверки, ЛишниеСимволы), "");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НомерТелефонаСодержитНедопустимыеСимволы(Знач СтрокаПроверки)
	
	СписокДопустимыхСимволов = "+-.,() wp1234567890";
	Возврат СтрРазделить(СтрокаПроверки, СписокДопустимыхСимволов, Ложь).Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьВГХ(ИмяРеквизита = "", ЕстьОшибки = Ложь, ВыводитьПредупреждения = Истина)
	
	ПроверитьВсе = (ИмяРеквизита = "");  	 
	
	Если (ПроверитьВсе ИЛИ ИмяРеквизита = "ГрузВес")
		И ЗначениеЗаполнено(ГрузВес) 
		И ЗначениеЗаполнено(ГрузМаксимальныйВес)
		И ГрузМаксимальныйВес > ГрузВес Тогда
		
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ТекстОшибки = НСтр("ru = 'Общий вес меньше значения самого тяжелого места';
								|en = 'General weight is less than the value of the most heavy place'");
			ТекстСообщения = ТекстОшибки;
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ГрузВес");
		КонецЕсли;
		
	КонецЕсли;  			
	
	Если ПереключательРасшифровки = 1 Тогда
	
		Если (ИмяРеквизита = "ГрузМаксимальныйВес")
			И ЗначениеЗаполнено(ГрузВес) 
			И ЗначениеЗаполнено(ГрузМаксимальныйВес)
			И ГрузМаксимальныйВес > ГрузВес Тогда
			
			ЕстьОшибки = Истина;
			Если ВыводитьПредупреждения Тогда
				ТекстОшибки = НСтр("ru = 'Общий вес меньше значения самого тяжелого места.';
									|en = 'General weight is less than the value of the most heaviest place.'");
				ТекстСообщения = ТекстОшибки;
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ГрузМаксимальныйВес");
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ОтправительКонтрагентСсылка");	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ПолучательКонтрагентСсылка");	
	
КонецПроцедуры 

&НаКлиенте
Процедура ПлательщикКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ПлательщикКонтрагентСсылка");	
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозки(УчастникГрузоперевозки)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Организация", 	"Справочник: Организации"); 
	СписокВыбора.Добавить("Контрагент",		"Справочник: Контрагенты");	
	
	Если УчастникГрузоперевозки <> "ПлательщикКонтрагентСсылка" Тогда
		
		СписокВыбора.Добавить("ВручнуюЮЛ",		"Ввести данные юр. лица");
		СписокВыбора.Добавить("ВручнуюФЛ",		"Ввести данные физ. лица");
		
	КонецЕсли;
	
	ОО = Новый ОписаниеОповещения("НачалоВыбораУчастникаГрузоперевозкиПродолжить", ЭтаФорма, УчастникГрузоперевозки);  
	
	СписокВыбора.ПоказатьВыборЭлемента(ОО, "Выберите способ заполнения данных");	
	
КонецПроцедуры  

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозкиПродолжить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ИмяРеквизита = СтрЗаменить(ДополнительныеПараметры, "Ссылка", ""); 
		ИмяРеквизитаИНН = ИмяРеквизита + "ИНН";
		Префикс = СтрЗаменить(ИмяРеквизита, "Контрагент", "");		
		
		Если Результат.Значение = "ВручнуюЮЛ" Или Результат.Значение = "ВручнуюФЛ" Тогда 			
			
			ЭтаФорма[Префикс + "КонтрагентИностранец"] = Ложь;
			ЭтаФорма[ДополнительныеПараметры] = Неопределено; 
			ЭтаФорма[Префикс + "РучнойВвод"] = ?(Результат.Значение = "ВручнуюЮЛ", 1, 2);
			ЭтаФорма[Префикс + "КонтрагентЮрФизЛицо"] = ЭтаФорма[Префикс + "РучнойВвод"]; 			
			
			Если Не ЗначениеЗаполнено(ЭтаФорма[Префикс + "КонтрагентСтрана"]) Тогда
				
				ЭтаФорма[Префикс + "КонтрагентСтрана"] = ПолучитьСтрануПоУмолчанию();
				
			КонецЕсли;
			
			Если ЭтаФорма[Префикс + "РучнойВвод"] = 2 Тогда
				
				Если Не ЗначениеЗаполнено(ЭтаФорма[Префикс + "КонтрагентОПФ"]) Тогда
					
					ЭтаФорма[Префикс + "КонтрагентОПФ"] = ПолучитьОПФПоУмолчанию();
					
				КонецЕсли;
				
				УстановитьВидимостьГруппаЭлектронныйЧек();
				
			КонецЕсли; 	
			
			УстановитьВидимостьРучнойВводКонтрагентов(Префикс);
			
		Иначе 			
					
			Если Префикс <> "Плательщик" Тогда
				
				ЭтаФорма[Префикс + "РучнойВвод"] = 0; 
				
				УстановитьВидимостьРучнойВводКонтрагентов(Префикс);	
				
			КонецЕсли;
			
			ПараметрыОткрытия = Новый Структура;			
			ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
			
			ОО = Новый ОписаниеОповещения("ОбработатьВыборЗначения", ЭтотОбъект, ДополнительныеПараметры);
			
			Если Результат.Значение = "Организация" Тогда 
				
				ИмяФормыВыбора = "Справочник.Организации.ФормаВыбора";				
				
			ИначеЕсли Результат.Значение = "Контрагент" Тогда
				
				ИмяФормыВыбора = "Справочник.Контрагенты.ФормаВыбора";
				
			Иначе
				
				Возврат;
				
			КонецЕсли; 
			
			ОткрытьФорму(ИмяФормыВыбора, ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументамОснованиям()
	
	Если Объект.ДокументыОснования.Количество() > 0 Тогда
		
		Документ = Объект.ДокументыОснования[0].Документ;
		ДокументТип = ТипЗнч(Документ); 
		
		ЭтоПеремещение = Ложь;
		ЭтоТранспортнаяНакладная = Ложь;  		
		РольСклада = ""; 	
		
		Если ДокументТип = Тип("ДокументСсылка.ЗаказКлиента") Или
			ДокументТип = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Или				 
			ДокументТип = Тип("ДокументСсылка.КорректировкаПриобретения") Или                          
			ДокументТип = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			Отправитель = Документ.Организация;				
			Получатель = Документ.Контрагент; 
			РольСклада = "Отправитель";
			
		ИначеЕсли ДокументТип = Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента") Или
			ДокументТип = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Или				 
			ДокументТип = Тип("ДокументСсылка.КорректировкаРеализации") Или
			ДокументТип = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			
			Отправитель = Документ.Контрагент; 				
			Получатель = Документ.Организация; 
			РольСклада = "Получатель";
			
		ИначеЕсли ДокументТип = Тип("ДокументСсылка.ЗаказНаПеремещение") Или
			ДокументТип = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
			
			Отправитель = Документ.Организация; 				
			Получатель = Документ.Организация; 
			
			ЭтоПеремещение = Истина; 
			
		ИначеЕсли ДокументТип = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
			
			Отправитель = Документ.Грузоотправитель; 				
			Получатель = Документ.Грузополучатель;	 
			
			ЭтоТранспортнаяНакладная = Истина;    
			
		ИначеЕсли ДокументТип = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда	
			
			РольСклада = "Отправитель";
			
			Если Документ.ТоварыПоРаспоряжениям.Количество() > 0 Тогда
				
				Распоряжение = Документ.ТоварыПоРаспоряжениям[0].Распоряжение;
				
				Если Распоряжение <> Неопределено Тогда				
					
					Попытка 
						
						Отправитель = Распоряжение.Организация;				
						Получатель = Распоряжение.Контрагент;											
						
					Исключение	
						
						Отправитель = Справочники.Организации.ПустаяСсылка();				
						Получатель = Справочники.Организации.ПустаяСсылка();
						
					КонецПопытки;
					
				КонецЕсли;	
				
			КонецЕсли; 
			
		ИначеЕсли ДокументТип = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
			
			РольСклада = "Получатель";
			
			Распоряжение = Документ.Распоряжение;
			
			Если Распоряжение <> Неопределено Тогда 			
				
				Попытка 
					
					Отправитель = Распоряжение.Контрагент;				
					Получатель = Распоряжение.Организация;								
					
				Исключение 
					
					Отправитель = Справочники.Организации.ПустаяСсылка();				
					Получатель = Справочники.Организации.ПустаяСсылка();
					
				КонецПопытки;
				
			КонецЕсли;
			
		Иначе
			
			Возврат;
			
		КонецЕсли;			
		
		ЗаполнитьУчастникаПеревозки("Отправитель", Отправитель);
		ЗаполнитьУчастникаПеревозки("Получатель", Получатель);
		
		Если ЭтоПеремещение Тогда			
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Документ.СкладОтправитель, Справочники.ВидыКонтактнойИнформации.АдресСклада, ТекущаяДата(), Ложь);
			
			Если КонтактнаяИнформация.Количество() Тогда					
				
				ЭтаФорма["ОтправительАдресПредставление"] = КонтактнаяИнформация[0].Представление;
				ЭтаФорма["ОтправительАдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
				
			КонецЕсли;
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Документ.СкладПолучатель, Справочники.ВидыКонтактнойИнформации.АдресСклада, ТекущаяДата(), Ложь);
			
			Если КонтактнаяИнформация.Количество() Тогда					
				
				ЭтаФорма["ПолучательАдресПредставление"] = КонтактнаяИнформация[0].Представление;
				ЭтаФорма["ПолучательАдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
				
			КонецЕсли;
			
		ИначеЕсли ЭтоТранспортнаяНакладная Тогда
			
			Если ЗначениеЗаполнено(Документ.АдресПогрузки) Тогда
				
				ЭтаФорма["ОтправительАдресПредставление"] = Документ.АдресПогрузки;
				ЭтаФорма["ОтправительАдресЗначение"] = Документ.АдресПогрузкиЗначенияПолей;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Документ.АдресДоставки) Тогда
				
				ЭтаФорма["ПолучательАдресПредставление"] = Документ.АдресДоставки;
				ЭтаФорма["ПолучательАдресЗначение"] = Документ.АдресДоставкиЗначенияПолей; 	
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(РольСклада) Тогда
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Документ.Склад, Справочники.ВидыКонтактнойИнформации.АдресСклада, ТекущаяДата(), Ложь);
			
			Если КонтактнаяИнформация.Количество() Тогда					
				
				ЭтаФорма[РольСклада + "АдресПредставление"] = КонтактнаяИнформация[0].Представление;
				ЭтаФорма[РольСклада + "АдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
				
			КонецЕсли;				
			
		КонецЕсли; 				
		
	КонецЕсли; 	
	
	ВариантЗаполненияВГХ = Константы.ДЛ_ЗаполнениеВГХ.Получить(); 
	
	Если ЗначениеЗаполнено(ВариантЗаполненияВГХ) Тогда
		
		ЗаполнитьВГХПоДокументамОснованиям(ВариантЗаполненияВГХ);	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьУчастникаПеревозки(Префикс, Участник)  
	
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Организации") Тогда 			
		
		Наименование = Участник.НаименованиеСокращенное;
		ЭтоОрганизация = Истина;  
		
	ИначеЕсли ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты") Тогда			
		
		Наименование = Участник.НаименованиеПолное;
		ЭтоОрганизация = Ложь;  
		
	Иначе
		
		Возврат; 
		
	КонецЕсли;
	
	ЭтаФорма[Префикс + "КонтрагентСсылка"] = Участник;
	ЭтаФорма[Префикс + "КонтрагентНаименование"] = Наименование;
	ЭтаФорма[Префикс + "КонтрагентИНН"] = Участник.ИНН;
	ЭтаФорма[Префикс + "КонтрагентКПП"] = Участник.КПП;
	ЭтаФорма[Префикс + "КонтрагентЭтоОрганизация"] = ЭтоОрганизация;
	
	ЮрФизЛицо = 0;
	
	Если Участник.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
		
		ЮрФизЛицо = 1;
		
	ИначеЕсли Участник.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда  
		
		ЮрФизЛицо = 2;
		
	ИначеЕсли Участник.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда  
		
		ЮрФизЛицо = 3;
		
	КонецЕсли;
	
	ЭтаФорма[Префикс + "КонтрагентЮрФизЛицо"] = ЮрФизЛицо; 
	
	Если ЮрФизЛицо <> 2 Тогда 
		
		ВидКИ = ?(ЭтоОрганизация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
		
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Участник, ВидКИ, ТекущаяДата(), Ложь);
		
		Если КонтактнаяИнформация.Количество() Тогда			
			
			ЭтаФорма[Префикс + "АдресПредставление"] = КонтактнаяИнформация[0].Представление;
			ЭтаФорма[Префикс + "АдресЗначение"] = КонтактнаяИнформация[0].Значение;  
			
		Иначе
			
			ВидКИ = ?(ЭтоОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
			
			КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Участник, ВидКИ, ТекущаяДата(), Ложь);
			
			Если КонтактнаяИнформация.Количество() Тогда
				
				ЭтаФорма[Префикс + "КонтрагентЮридическийАдресПредставление"] = КонтактнаяИнформация[0].Представление; 				
				ЭтаФорма[Префикс + "АдресПредставление"] = КонтактнаяИнформация[0].Представление;
				ЭтаФорма[Префикс + "АдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
				
			КонецЕсли;	
			
		КонецЕсли; 			
		
	КонецЕсли;
	
	Если ЭтоОрганизация Тогда  
		
		ЭтотОбъект[Префикс + "КонтактноеЛицоНаименование"] = СокрЛП(ПараметрыСеанса.ТекущийПользователь);	
		ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(ПараметрыСеанса.ТекущийПользователь);	
		
	Иначе
		
		ЭтаФорма[Префикс + "КонтрагентИностранец"] = Участник.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицоНеРезидент; 
		
		СписокКонтактныхЛиц = ПолучитьСписокКонтактныхЛиц(Префикс + "КонтрагентСсылка");
		
		Если СписокКонтактныхЛиц.Количество() > 0 Тогда
			
			ЭтотОбъект[Префикс + "КонтактноеЛицоНаименование"] = СокрЛП(СписокКонтактныхЛиц[0].Значение);	
			ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(СписокКонтактныхЛиц[0].Значение);	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеУслуги()	
	
	
	НаименованияИсключаемыхУслуг = Новый Массив;
	НаименованияИсключаемыхУслуг.Добавить("заезд на второй адрес");  
	НаименованияИсключаемыхУслуг.Добавить("страхование груза и срока"); 
	НаименованияИсключаемыхУслуг.Добавить("страхование груза");
	НаименованияИсключаемыхУслуг.Добавить("доставка груза до дверей получателя");  
	НаименованияИсключаемыхУслуг.Добавить("погрузка у отправителя"); 
	НаименованияИсключаемыхУслуг.Добавить("разгрузка у получателя");	
	НаименованияИсключаемыхУслуг.Добавить("отправка сопроводительных документов");
	НаименованияИсключаемыхУслуг.Добавить("возврат сопроводительных документов");	
	НаименованияИсключаемыхУслуг.Добавить("забор груза от дверей отправителя");	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаименованияИсключаемыхУслуг", НаименованияИсключаемыхУслуг);
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_ДополнительныеУслуги.Ссылка КАК Услуга,
	|	ЛОЖЬ КАК Использовать,
	|	1 КАК Количество,
	|	(ВЫРАЗИТЬ(ВРЕГ(ЛЕВ(ДЛ_ДополнительныеУслуги.Наименование, 1)) КАК СТРОКА(1))) + (ВЫРАЗИТЬ(НРЕГ(ПРАВ(ДЛ_ДополнительныеУслуги.Наименование, ДЛИНАСТРОКИ(ДЛ_ДополнительныеУслуги.Наименование) - 1)) КАК СТРОКА(254))) КАК Наименование
	|ИЗ
	|	Справочник.ДЛ_ДополнительныеУслуги КАК ДЛ_ДополнительныеУслуги
	|ГДЕ
	|	НЕ ДЛ_ДополнительныеУслуги.Наименование В (&НаименованияИсключаемыхУслуг)"; 				   
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДополнительныеУслуги.Загрузить(Результат);
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьДополнительныеТребования()	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_СпециальныеТребования.Наименование КАК Наименование,
	|	ДЛ_СпециальныеТребования.UID КАК UID
	|ИЗ
	|	Справочник.ДЛ_СпециальныеТребования КАК ДЛ_СпециальныеТребования
	|ГДЕ
	|	ДЛ_СпециальныеТребования.Наименование <> ""Растентовка""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДЛ_ВидыЗагрузки.Наименование,
	|	ДЛ_ВидыЗагрузки.UID
	|ИЗ
	|	Справочник.ДЛ_ВидыЗагрузки КАК ДЛ_ВидыЗагрузки";  
	
	Результат = Запрос.Выполнить().Выгрузить();              
	
	ЗаполнитьСписокВыбораДополнительныеТребования("Отгрузка", Результат);  
	ЗаполнитьСписокВыбораДополнительныеТребования("Доставка", Результат);
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидимостьДоступностьНаСтраницеОсновная()  
	
	Если ФайловыйВариант Тогда
		
		Элементы.ПредварительныйРасчет.Видимость = Истина;
		Элементы.ВидДоставки.Видимость = Истина;
		Элементы.ГруппаПраваяПанель.Видимость = Ложь;
		
	КонецЕсли;
	
	ДоставкаОтАдреса = СпособОтгрузки = 0;  
	ДоставкаДоАдреса = СпособДоставки = 0;
	
	Элементы.ОтправительКонтрагент.Заголовок = ?(ОтправительКонтрагентЭтоОрганизация, НСтр("ru = 'Организация';
																							|en = 'Company'"),
		НСтр("ru = 'Контрагент';
			|en = 'Counterparty'"));
	Элементы.ПолучательКонтрагент.Заголовок = ?(ПолучательКонтрагентЭтоОрганизация, НСтр("ru = 'Организация';
																						|en = 'Company'"),
		НСтр("ru = 'Контрагент';
			|en = 'Counterparty'"));
	Элементы.ПлательщикКонтрагент.Заголовок = ?(ПолучательКонтрагентЭтоОрганизация, НСтр("ru = 'Организация';
																						|en = 'Company'"),
		НСтр("ru = 'Контрагент';
			|en = 'Counterparty'"));  			 
	
	Элементы.ГруппаПлательщикВидимость.Видимость = (ПлательщикРоль = 3) Или (ИспользоватьРазличныхПлательщиков И ((ОтправительПлательщикРоль = 3) Или (ПолучательПлательщикРоль = 3))); 
	
	Элементы.ГруппаОтправительАдрес.Видимость = ДоставкаОтАдреса;	
	Элементы.ГруппаОтправительТерминал.Видимость = Не ДоставкаОтАдреса;   
	Элементы.ГруппаПолучательАдрес.Видимость = ДоставкаДоАдреса; 	
	Элементы.ГруппаПолучательТерминал.Видимость = Не ДоставкаДоАдреса; 
	Элементы.ГруппаОтгрузка.Видимость = ДоставкаОтАдреса;
	Элементы.ГруппаДоставка.Видимость = ДоставкаДоАдреса;
	Элементы.ОтправительПлательщикРольПредставление.Видимость = ДоставкаОтАдреса;
	
	Если ОтправительРучнойВвод = 0 Тогда
		
		УстановитьВидимостьЭлементовИностранец("Отправитель"); 
		
	Иначе
		
		УстановитьВидимостьРучнойВводКонтрагентов("Отправитель");
		
	КонецЕсли;
	
	Если ПолучательРучнойВвод = 0 Тогда
		
		УстановитьВидимостьЭлементовИностранец("Получатель");  
		
	Иначе
		
		УстановитьВидимостьРучнойВводКонтрагентов("Получатель");	
		
	КонецЕсли;
	
	УстановитьВидимостьГруппаЭлектронныйЧек();
	УстановитьВидимостьНаложенногоПлатежа(); 
	УстановитьВидимостьУпрощеннаяДоставка();
		
	Элементы.ГруппаОтправительПолучательПлательщикРоль.Видимость = ИспользоватьРазличныхПлательщиков;
	Элементы.ПлательщикРоль.Заголовок = ?(ИспользоватьРазличныхПлательщиков, "Основной плательщик", "Плательщик");
	
	УстановитьВидимостьЭлементовИностранец("Плательщик");	
	 
	Элементы.ПогрузочноРазгрузочныеРаботы.Видимость = ДоставкаОтАдреса;	 
	Элементы.ДоставкаПогрузочноРазгрузочныеРаботы.Видимость = ДоставкаДоАдреса;
	ПогрузочноРазгрузочныеРаботыПриИзменении(Неопределено);
	ДоставкаПогрузочноРазгрузочныеРаботыПриИзменении(Неопределено); 	
	
	УстановитьДоступностьВидовДоставки();
	
	УстановитьВидимостьЭлементовУпрощеннаяФормаЗаказа(); 	
	
	ЗаголовокГородПодсказка = "Населенный пункт (нужен для подсказок ввода адреса)";
	ЗаголовокГородБезПодсказки = "Населенный пункт"; 
	Элементы.ДЛ_ОтправительГород.Заголовок = ?(ДоставкаОтАдреса, ЗаголовокГородПодсказка, ЗаголовокГородБезПодсказки); 
	Элементы.ДЛ_ОтправительГород.ОтображениеПодсказки = ?(ДоставкаОтАдреса, ОтображениеПодсказки.Кнопка, ОтображениеПодсказки.Нет);
	Элементы.ДЛ_ПолучательГород.Заголовок = ?(ДоставкаДоАдреса, ЗаголовокГородПодсказка, ЗаголовокГородБезПодсказки);	
	Элементы.ДЛ_ПолучательГород.ОтображениеПодсказки = ?(ДоставкаДоАдреса, ОтображениеПодсказки.Кнопка, ОтображениеПодсказки.Нет);  
	
	Элементы.СопроводительныеДокументыПлательщик.ТолькоПросмотр = Не ЗначениеЗаполнено(СопроводительныеДокументы);
		
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьВидимостьЭлементовИностранец(Префикс)
	
	Элементы["гр" + Префикс + "Иностранец"].Видимость = Не ЭтаФорма[Префикс + "КонтрагентЭтоОрганизация"] 
		И ЭтаФорма[Префикс + "КонтрагентЮрФизЛицо"] = 2
		И ?(Префикс = "Получатель", Не УпрощеннаяДоставка, Истина);     	
	
	КонтрагентИностранецПриИзменении(Префикс);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппаЭлектронныйЧек()
	
	ВидимостьГруппыЧекПлательщик = (ПлательщикРоль = 3 И ПлательщикКонтрагентЮрФизЛицо = 2) Или 
		(ИспользоватьРазличныхПлательщиков И ПлательщикКонтрагентЮрФизЛицо = 2 
		И (ПолучательПлательщикРоль = 3 Или ОтправительПлательщикРоль = 3));  
	
	ВидимостьГруппыЧекОтправитель = (ПлательщикРоль = 1 И ОтправительКонтрагентЮрФизЛицо = 2) Или 
		(ИспользоватьРазличныхПлательщиков И ОтправительКонтрагентЮрФизЛицо = 2 
		И (ПолучательПлательщикРоль = 1 Или ОтправительПлательщикРоль = 1));  
		
	ВидимостьГруппыЧекПолучатель = (ПлательщикРоль = 2 И (ПолучательКонтрагентЮрФизЛицо = 2 Или УпрощеннаяДоставка)) Или 
		(ИспользоватьРазличныхПлательщиков И (ПолучательКонтрагентЮрФизЛицо = 2 Или УпрощеннаяДоставка) 
		И (ПолучательПлательщикРоль = 2 Или ОтправительПлательщикРоль = 2));			
		
	Элементы.ГруппаЭлектронныйЧек.Видимость = ВидимостьГруппыЧекПлательщик Или ВидимостьГруппыЧекПолучатель Или ВидимостьГруппыЧекОтправитель;	
	Элементы.ГруппаЭлектронныйЧекПлательщик.Видимость = ВидимостьГруппыЧекПлательщик;  
	Элементы.ГруппаЭлектронныйЧекПолучатель.Видимость = ВидимостьГруппыЧекПолучатель;
	Элементы.ГруппаЭлектронныйЧекОтправитель.Видимость = ВидимостьГруппыЧекОтправитель;  
	
	Если ВидимостьГруппыЧекПлательщик = Ложь Тогда
		
		ПлательщикСогласиеНаПолучениеЭлектронногоЧека = Ложь;
		
	КонецЕсли;   
	
	Если ВидимостьГруппыЧекОтправитель = Ложь Тогда
		
		ОтправительСогласиеНаПолучениеЭлектронногоЧека = Ложь;
		
	КонецЕсли;
	
	Если ВидимостьГруппыЧекПолучатель = Ложь Тогда
		
		ПолучательСогласиеНаПолучениеЭлектронногоЧека = Ложь;
		
	КонецЕсли;
	
	ВидимостьАдресовЭлектронногоЧека("Плательщик");
	ВидимостьАдресовЭлектронногоЧека("Отправитель");
	ВидимостьАдресовЭлектронногоЧека("Получатель");
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизит(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИмяРеквизита = Элемент.Имя + "Ссылка";
	ЭтотОбъект[ИмяРеквизита] = Неопределено;
	ОбработатьИзменениеРеквизитаФормы(ИмяРеквизита);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьДоступностьНаСтраницеОсновная(); 
	ПереключательРасшифровкиПриИзменении(Неопределено); 
	УправлениеДоступностьюОтправкиЗаказа();
	
	СтрахованиеСрокаДоставкиГруза = Истина;
	
	Если Не ИзЧерновика Тогда	
		
		ЗаполнитьНаселенныйПунктПоАдресу1С("Отправитель");
		ЗаполнитьНаселенныйПунктПоАдресу1С("Получатель");
		
	КонецЕсли;
	
	СформироватьПредставлениеВремениОтгрузки();
	СформироватьПредставлениеВремениДоставки();
		
КонецПроцедуры  

&НаСервереБезКонтекста
Функция Адрес_ЗначениеИзСтрокиJSON(Значение, ЕстьОшибка=Ложь, ТекстОшибки="") Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	ПервыйСимвол = Лев(Значение, 1);
	Если ПервыйСимвол <> "[" И ПервыйСимвол <> "{" Тогда
		Возврат Значение;
	КонецЕсли;
	
	Результат = Неопределено;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		ЧтениеJSON.УстановитьСтроку(Значение);
		Результат = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ЕстьОшибка = Истина;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Сервис доставки.Преобразование данных.';
										|en = 'Delivery service. Data conversion.'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеРеквизитаФормы(ИмяРеквизита)
	
	ОчиститьСообщения();
	Отказ = Ложь;
	ОбработатьИзменениеРеквизитаФормыНаСервере(ИмяРеквизита, Отказ);
	
	Если Отказ Тогда
		
		Возврат; 
		
	КонецЕсли;	
	
	УстановитьВидимостьДоступностьНаСтраницеОсновная();	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеРеквизитаФормыНаСервере(ИмяРеквизита, Отказ = Ложь)
	
	Модифицированность = Истина;
	
	Если ИмяРеквизита = "ОтправительКонтрагентСсылка" 
		ИЛИ ИмяРеквизита = "ПолучательКонтрагентСсылка"
		ИЛИ ИмяРеквизита = "ПлательщикКонтрагентСсылка" Тогда
		
		ПараметрыУчастника = ПараметрыУчастникаГрузоперевозки(ЭтотОбъект[ИмяРеквизита]);		
		
		ОбработатьПараметры(ПараметрыУчастника, СтрЗаменить(ИмяРеквизита, "КонтрагентСсылка", ""));		
		
		ИмяЭлемента = СтрЗаменить(ИмяРеквизита, "Ссылка", "");
		ЕстьОшибки = Ложь;
		ПроверитьРеквизитыКонтрагента(ИмяЭлемента, ЕстьОшибки, Истина);	
		
		Если ЕстьОшибки Тогда  
			
			ЭтотОбъект[ИмяЭлемента + "Ссылка"] = Неопределено;
			ЭтотОбъект[ИмяЭлемента + "ИНН"] = "";
			ЭтотОбъект[ИмяЭлемента + "Наименование"] = "";
			
		КонецЕсли;		
			
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция КонтактнаяИнформацияПоПредставлению(Представление, ТипКонтактнойИнформацииИмя) Экспорт
	
	Если ТипКонтактнойИнформацииИмя = "Телефон" Тогда
		ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
	Иначе
		ТипКонтактнойИнформации = Перечисления.ТипыКонтактнойИнформации.Адрес;
	КонецЕсли;
	
	Возврат УправлениеКонтактнойИнформацией.КонтактнаяИнформацияПоПредставлению(Представление, ТипКонтактнойИнформации);
	
КонецФункции

&НаСервере
Функция ПараметрыУчастникаГрузоперевозки(Значение)
	
	ПараметрыУчастника = НовыйПараметрыУчастникаГрузоперевозки();
	
	ПараметрыУчастника.Контрагент = ПараметрыКонтрагента(Значение);		
		
	Возврат ПараметрыУчастника;
	
КонецФункции 

&НаСервере
Функция НовыйПараметрыУчастникаГрузоперевозки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Контрагент", НовыйПараметрыКонтрагента());	
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Процедура ОбработатьПараметры(Параметры, Префикс = "")
	
	ПараметрыДляФормы = Новый Структура;
	
	ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, ПараметрыДляФормы, Префикс);		
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыДляФормы);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, Данные, Префикс = "") Экспорт
	
	Для Каждого Параметр Из Параметры Цикл  
		
		ИмяКолонки = Префикс + Параметр.Ключ;   
		
		Если ТипЗнч(Параметр.Значение) = Тип("Структура") Тогда
			
			ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметр.Значение, Данные, ИмяКолонки); 
			
		Иначе 
			
			Данные.Вставить(ИмяКолонки, Параметры[Параметр.Ключ]);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрыКонтрагента(Значение)
	
	ПараметрыКонтрагента = НовыйПараметрыКонтрагента();
	ПараметрыКонтрагента.Ссылка = Значение;
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента);		
		
	КонецЕсли;
	
	Возврат ПараметрыКонтрагента;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента) Экспорт
	
	ИмяСправочника = Неопределено;
	Если ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		ИмяСправочника = "Организации";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеСокращенное";
		ПараметрыКонтрагента.ЭтоОрганизация = Истина;
	ИначеЕсли ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		ИмяСправочника = "Контрагенты";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеПолное";
		ПараметрыКонтрагента.ЭтоОрганизация = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОсновнаяТаблица.Ссылка КАК Ссылка,
	|	ОсновнаяТаблица.ИНН КАК ИНН,
	|	ОсновнаяТаблица.КПП КАК КПП,
	|	&РеквизитНаименования КАК Наименование,
	|	ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент) КАК Иностранец,
	|	ВЫБОР
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА 1
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|			ТОГДА 2
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЮрФизЛицо
	|ИЗ
	|	&ТаблицаДляЗапроса КАК ОсновнаяТаблица
	|ГДЕ
	|	ОсновнаяТаблица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыКонтрагента.Ссылка);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДляЗапроса", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитНаименования", РеквизитНаименования);  
	
	Если ИмяСправочника = "Организации" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент)", "Ложь");	
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда  
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтрагента, РезультатЗапроса.Выгрузить()[0]);		
		
		Если ПараметрыКонтрагента.ЮрФизЛицо <> 2 Тогда
			
			ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
				
			ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 
					
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

