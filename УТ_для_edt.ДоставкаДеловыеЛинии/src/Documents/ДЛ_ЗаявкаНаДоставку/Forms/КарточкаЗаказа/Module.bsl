&НаКлиенте
Процедура КонтактноеЛицоНачалоВыбора(ИмяРеквизита) 
	
	ИмяРеквизитаКонтрагента = СтрЗаменить(ИмяРеквизита, "КонтактноеЛицо", "КонтрагентСсылка"); 
	
	ТипКонтрагента = ТипЗнч(ЭтотОбъект[ИмяРеквизитаКонтрагента]); 
	
	ОО = Новый ОписаниеОповещения("ВыборКонтактноеЛицоЗавершение", ЭтаФорма, ИмяРеквизита);
	
	ПараметрыОткрытия = Новый Структура;			
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
	
	Если ТипКонтрагента = Тип("СправочникСсылка.Контрагенты") Тогда		 
		
		ПараметрыОтбора = Новый Структура("Владелец", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ЭтотОбъект[ИмяРеквизитаКонтрагента], "Партнер"));
		
		ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
		
		ОткрытьФорму("Справочник.КонтактныеЛицаПартнеров.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТипКонтрагента = Тип("СправочникСсылка.Организации") Тогда 				
		
		ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьСписокКонтактныхЛиц(ИмяРеквизита)
	
	Результат = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизита]) И ЗначениеЗаполнено(ЭтотОбъект[СтрЗаменить(ИмяРеквизита, "Ссылка", "Наименование")]) 
		И ЗначениеЗаполнено(ЭтотОбъект[ИмяРеквизита].Партнер) Тогда  		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	НЕ КонтактныеЛицаПартнеров.ПометкаУдаления
		| 	И КонтактныеЛицаПартнеров.Владелец = &Владелец";   
		Запрос.УстановитьПараметр("Владелец", ЭтотОбъект[ИмяРеквизита].Партнер); 
		
		Выборка = Запрос.Выполнить().Выбрать(); 
		
		Результат.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")); 		 		
		
	КонецЕсли; 
	
	Возврат Результат;
	
Конецфункции 

&НаКлиенте
Процедура ВыборКонтактноеЛицоЗавершение(Результат, ИмяРеквизита) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
			
			Результат = Результат.Значение;	
			
		КонецЕсли;	
		
		ЭтотОбъект[ИмяРеквизита + "Наименование"] = СокрЛП(Результат);		
		ЭтотОбъект[ИмяРеквизита + "ТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(Результат); 
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьТелефоныКонтактногоЛица(КонтактноеЛицо)
	
	Результат = "";
	
