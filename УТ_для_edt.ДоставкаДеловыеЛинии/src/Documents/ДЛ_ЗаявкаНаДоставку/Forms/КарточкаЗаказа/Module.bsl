&НаКлиенте
Процедура УстановитьДоступностьВидовДоставки()       	
	
	ДоступностьМелкихГрузов = СпособОтгрузки = 0 И СпособДоставки = 0 И ПереключательРасшифровки = 0;    
	
	ПереключитьНаАвтодоставку = Ложь;
	
	ВерхнийУровень = РезультатПредрасчета.ПолучитьЭлементы(); 	
	
	Для Каждого СтрокаДоставки Из ВерхнийУровень Цикл  
		
		Если СтрокаДоставки.ИД = "letter" Или СтрокаДоставки.ИД = "small" Тогда  
			
			СтрокаДоставки.Заблокировано = Не ДоступностьМелкихГрузов;
			
			Если СтрокаДоставки.Выбрано Тогда
				
				СтрокаДоставки.Выбрано = Ложь;
				ПереключитьНаАвтодоставку = Истина;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаДоставки.ИД = "auto" Тогда 	
			
			СтрокаАвтодоставки = СтрокаДоставки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПереключитьНаАвтодоставку Тогда
		
		ВидДоставки = "auto";
		СтрокаАвтодоставки.Выбрано = Истина;
		
		ВидДоставкиПриИзменении(Неопределено);
		
	КонецЕсли;
	
КонецПроцедуры

