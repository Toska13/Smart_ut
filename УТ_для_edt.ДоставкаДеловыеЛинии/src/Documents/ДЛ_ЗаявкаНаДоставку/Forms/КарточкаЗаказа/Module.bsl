&НаСервере
Процедура ЗаполнитьПервичноРезультатПредрсчета()
	
	ВерхнийУровень = РезультатПредрасчета.ПолучитьЭлементы();
	
	ВидДоставки = "auto";
	
	Элемент = ВерхнийУровень.Добавить();	 
	Элемент.ИД = "express";
