	Элементы.ЕдиницаДлинаОдноМесто.Доступность = ЗначениеБлокировки;
	Элементы.ГрузОдноМестоШирина.Доступность = ЗначениеБлокировки;
	Элементы.ЕдиницаШиринаОдноМесто.Доступность = ЗначениеБлокировки;
	Элементы.ГрузОдноМестоВысота.Доступность = ЗначениеБлокировки;
	Элементы.ЕдиницаВысотаОдноМесто.Доступность = ЗначениеБлокировки;
	Элементы.ГрузОдноМестоВес.Доступность = ЗначениеБлокировки2; 
	Элементы.СуммаОбъявленнойЦенности.Доступность = ЗначениеБлокировки2;
	
