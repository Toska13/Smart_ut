	ВвестиДанныеТелефоновУчастникаПеревозки("Плательщик");
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиДанныеТелефоновУчастникаПеревозки(Префикс) 
	
	Телефоны = ЭтаФорма[Префикс + "КонтактноеЛицоТелефонПредставление"]; 
	
	ТекущиеТелефоны = Новый Массив;
	
	Если ЗначениеЗаполнено(Телефоны) Тогда	
		
		МассивТелефонов = СтрРазделить(Телефоны, ";");	
		
		Для Каждого НомерТелефона Из МассивТелефонов Цикл		
			
			НомерТелефонаСДобавочным = СтрРазделить(СтрЗаменить(СтрЗаменить(НомерТелефона, Символы.ПС, ""), ", доб. ", Символы.ПС), Символы.ПС, Ложь);			
			
			Если ЗначениеЗаполнено(НомерТелефонаСДобавочным[0]) Тогда
				
				СтруктураТелефона = Новый Структура;
				СтруктураТелефона.Вставить("Основной", СокрЛП(НомерТелефонаСДобавочным[0]));				
				
				Если НомерТелефонаСДобавочным.Количество() = 2  Тогда
					
					СтруктураТелефона.Вставить("Добавочный", СокрЛП(НомерТелефонаСДобавочным[1]));	
					
				КонецЕсли; 
				
				ТекущиеТелефоны.Добавить(СтруктураТелефона);		
				
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;
	
	ОО = Новый ОписаниеОповещения("ВвестиДанныеТелефоновУчастникаПеревозкиЗвершение", ЭтаФорма, Префикс); 
	ПараметрыФормы = Новый Структура("Телефоны", ТекущиеТелефоны);	
	
	ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ФормаВводаТелефонов", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

