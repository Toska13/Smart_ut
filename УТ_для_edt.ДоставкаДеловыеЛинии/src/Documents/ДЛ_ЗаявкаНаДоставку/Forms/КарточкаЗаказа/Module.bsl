КонецФункции

&НаСервере
Функция ЗаполнитьПараметрСруктураОплаты(ПредварительныйРасчет)  
	
	Результат = Новый Структура;
	Результат.Вставить("type", ФормаОплатыПредставление);
	//Результат.Вставить("paymentCity", МестоОплаты.КодКЛАДР);
	Результат.Вставить("paymentCity", "7700000000000000000000000"); //Всегда Москва
	
	Если Не ПредварительныйРасчет Тогда
		
		ПараметрПлательщик = "";
		
		Если ПлательщикРоль = 1 Тогда
			
			ПараметрПлательщик = "sender";
			
		ИначеЕсли ПлательщикРоль = 2 Тогда
			
			ПараметрПлательщик = "receiver";
			
		ИначеЕсли ПлательщикРоль = 3 Тогда 
			
			ПараметрПлательщик = "third";
			
		КонецЕсли;
		
		Результат.Вставить("primaryPayer", ПараметрПлательщик);  
		
		Если НаложенныйПлатеж Тогда
			
			Результат.Вставить("cashOnDelivery", ЗаполнитьПараметрНаложенныйПлатеж());
			
		ИначеЕсли ЗначениеЗаполнено(НаложенныйПлатежНомерЗаказа) Тогда
			
			Результат.Вставить("cashOnDelivery", ЗаполнитьПараметрВнутреннийНомерЗаказа());	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрНаложенныйПлатеж()
	
	Результат = Новый Массив;	
	СтруктураРезультата = Новый Структура;  
	
	СтруктураРезультата.Вставить("orderNumber", НаложенныйПлатежНомерЗаказа); 
	СтруктураРезультата.Вставить("orderDate", Формат(НаложенныйПлатежДатаЗаказа, "ДФ='гггг-ММ-дд'"));	
	СтруктураРезультата.Вставить("products", ЗаполнитьПараметрНаложенныйПлатежТовары());
	
	Результат.Добавить(СтруктураРезультата);  
	
	Возврат Результат;
	
КонецФункции   

&НаСервере
Функция ЗаполнитьПараметрНаложенныйПлатежТовары()
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаТовар Из НаложенныйПлатежТовары Цикл
		
		СтруктураРезультата = Новый Структура;  
		
		СтруктураРезультата.Вставить("productName", СтрокаТовар.Номенклатура.Наименование);  
		СтруктураРезультата.Вставить("productCode", СтрокаТовар.Номенклатура.Артикул);
		СтруктураРезультата.Вставить("productAmount", СтрокаТовар.Количество);
		СтруктураРезультата.Вставить("costWithVAT", СтрокаТовар.Цена);  
		
		Если СтрокаТовар.СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС Тогда 
		
			СтруктураРезультата.Вставить("VATRate", СтрокаТовар.СтавкаНДС.Ставка);
			
		КонецЕсли;
		
		Результат.Добавить(СтруктураРезультата);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрУчастникиПеревозки(ПредварительныйРасчет)
	
	Результат = Новый Структура; 
	
	СтруктураОтправительзапроса = Новый Структура;
	
	Если ЗначениеЗаполнено(НашаРольВПеревозке) Тогда
		
		СтруктураОтправительзапроса.Вставить("role", НашаРольВПеревозке);
		
	КонецЕсли; 
	
	НашИД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказчикКонтрагентСсылка, "UID");
	
	Если ЗначениеЗаполнено(НашИД) Тогда 
		
		СтруктураОтправительзапроса.Вставить("uid", НашИД);
		
	КонецЕсли;
	
	Если Не ПредварительныйРасчет Тогда 				
		
		Результат.Вставить("sender", ЗаполнитьПараметрУчастникПеревозки("Отправитель"));		
		Результат.Вставить("receiver", ЗаполнитьПараметрУчастникПеревозки("Получатель"));
		
		Если (ПлательщикРоль = 3) Или (ИспользоватьРазличныхПлательщиков И ((ОтправительПлательщикРоль = 3) Или (ПолучательПлательщикРоль = 3))) Тогда
			
			Результат.Вставить("third", ЗаполнитьПараметрУчастникПеревозки("Плательщик"));
			
		КонецЕсли;
		
	КонецЕсли;  
	
	Результат.Вставить("requester", СтруктураОтправительзапроса);
	
	Возврат Результат;
	
КонецФункции	

