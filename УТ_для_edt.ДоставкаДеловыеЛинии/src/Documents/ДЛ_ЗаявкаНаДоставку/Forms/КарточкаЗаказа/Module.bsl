&НаСервере
Процедура ОчиститьРезультатПедрасчета()
	
	ВерхнийУровень = РезультатПредрасчета.ПолучитьЭлементы();
	
	Для Каждого ЭлементВерхнегоУровня Из ВерхнийУровень Цикл
		
		ЭлементВерхнегоУровня.Сумма = ""; 		
		ВторойУровень = ЭлементВерхнегоУровня.ПолучитьЭлементы();
		ВторойУровень.Очистить();
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасшифровкуРезультатаВыбранногоВидаДоставки(СтрокиРезультата, ДанныеЗапроса) 
	
	Если ДанныеЗапроса["intercity"] <> Неопределено Тогда 
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["intercity"], "Автоперевозка"); 	
		
	КонецЕсли;   
	
	Если ДанныеЗапроса["small"] <> Неопределено Тогда 
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["small"], "Малогабаритный груз");		
		
	КонецЕсли;
	
	Если ДанныеЗапроса["air"] <> Неопределено Тогда	
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["air"], "Авиаперевозка");
				
	КонецЕсли; 
	
	Если ДанныеЗапроса["express"] <> Неопределено Тогда	
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["express"], "Экспресс-перевозка");
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["letter"] <> Неопределено Тогда  
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["letter"], "Письмо");
		
	КонецЕсли;
	
	Если ДанныеЗапроса["derival"] <> Неопределено Тогда	
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["derival"], "Доставка от отправителя");
		
	КонецЕсли;  
	
	Если ДанныеЗапроса["arrival"] <> Неопределено Тогда	
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["arrival"], "Доставка до получателя");
		
	КонецЕсли;
	
	Если ДанныеЗапроса["accompanyingDocuments"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["accompanyingDocuments"]["send"] <> Неопределено Тогда				 
			
			ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["accompanyingDocuments"]["send"], "Отправка сопроводительных документов");
			
		КонецЕсли;
		
		Если ДанныеЗапроса["accompanyingDocuments"]["return"] <> Неопределено Тогда 			 
			
			ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["accompanyingDocuments"]["return"], "Возврат сопроводительных документов");
						
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["notify"] <> Неопределено Тогда		 
		
		ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса["notify"], "Услуга 'Информация о статусе заказа'");
		
	КонецЕсли;
	
	Если ДанныеЗапроса["packages"] <> Неопределено Тогда 
		
		Цена = 0;
		Скидка = 0;
		Наценка = 0;
		
		Для Каждого Упаковка Из ДанныеЗапроса["packages"] Цикл 						
			 
			Если НЕ Упаковка.Значение["contractPrice"] Тогда								  			
				
				Цена = Цена + Упаковка.Значение["price"]; 				
				Наценка = Наценка + ПолучитьСуммуСкидокНаценокПоМассиву(Упаковка.Значение["premiumDetails"]);
				Скидка = Скидка + ПолучитьСуммуСкидокНаценокПоМассиву(Упаковка.Значение["discountDetails"]); 			
				
			КонецЕсли;    
			
		КонецЦикла;
		
		Если Цена > 0 Тогда	
			
			СтрокаРезультата = ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРезультата, "		Упаковка", СтрокаСумма(Цена));			 
			
			Если Наценка > 0 Или Скидка > 0 Тогда
				
				СтрокиРасшифровки = СтрокаРезультата.ПолучитьЭлементы();
				
				БазоваяЦена = Цена + Скидка - Наценка;	
				
				Если БазоваяЦена <> Цена Тогда
					
					ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРасшифровки, "			Базовая стоимость", СтрокаСумма(БазоваяЦена));	
					
				КонецЕсли;   
				
				Если Скидка > 0 Тогда
					
					ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРасшифровки, "			Скидка", СтрокаСумма(- Скидка));	
					
				КонецЕсли;
				
				Если Наценка > 0 Тогда
					
					ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРасшифровки, "			Надбавка", СтрокаСумма(Наценка));	
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДанныеЗапроса["insurance"]) Тогда 
		
		ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРезультата, "		Страховка", СтрокаСумма(ДанныеЗапроса["insurance"]));				
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ПредварительныйРасчетЗавершение()
	
	РезультатЗапроса = ПолучитьИзВременногоХранилища(АдресРезультатаПредварительногоРасчета);
	
	ОбработатьРезультатРасчетаИСозданияЗаказа(РезультатЗапроса, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГотовностьПредварительногоРасчета()  
	
	Если Не ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		
		ОтключитьОбработчикОжидания("ПроверитьГотовностьПредварительногоРасчета");
		
		Возврат;
		
	КонецЕсли;
	
	Если ПроверкаФоновогоЗаданияНаСервере() Тогда 		
		
		Элементы.кнОбновлениеДанных.Видимость = Ложь; 
		Элементы.кнОбновитьДанныеПредрасчета.Видимость = Истина; 
		
		Элементы.РезультатПредрасчета.Развернуть(ВидДоставкиДеревоИдентификатор, Ложь);
		
		УправлениеДоступностьюОтправкиЗаказа();
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ОтменитьФоновыйПроцесс() 
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	Задание.Отменить();	
	
КонецПроцедуры  

&НаСервере
Функция ПроверкаФоновогоЗаданияНаСервере()  
	
	Результат = Истина;
		
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);	
	
	Если Задание = Неопределено Тогда 
		
		ИдентификаторЗадания = Неопределено;	
		
	Иначе	
		
		Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда 			  
			
			ПредварительныйРасчетЗавершение(); 
			
			ИдентификаторЗадания = Неопределено;
			
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			
			Результат = Ложь;  
			
		Иначе
			
			ИдентификаторЗадания = Неопределено;
			
			УстановитьВидимостьЭлементовПриОшибкеПредварительногоРасчета();						  
			
			Элементы.днОшибкиПредрасчета.Заголовок = "• Ошибка получения данных. Повторите попытку.";
			
		КонецЕсли;						
	
	КонецЕсли;

	Возврат Результат; 
	
КонецФункции

