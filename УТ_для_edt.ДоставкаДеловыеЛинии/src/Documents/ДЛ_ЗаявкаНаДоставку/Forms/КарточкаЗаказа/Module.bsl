			ИначеЕсли ПолеСОшибкой = "delivery.packages" Тогда
					
				Сообщение = "Выбранная услуга недоступна для указанных параметров перевозки";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.accompanyingDocuments" Тогда
					
				Сообщение = "Действия с Сопроводительными документами не доступны при выбранных параметрах доставки";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.requirements" Тогда
					
				Сообщение = "Услуга не доступна на Терминале Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.requirements" Тогда
					
				Сообщение = "Услуга не доступна  на Терминале Получателя";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.handling" Тогда
					
				Сообщение = "Выбранная услуга не доступна для указанных параметров перевозки при отгрузке";	   
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.handling" Тогда
					
				Сообщение = "Выбранная услуга не доступна для указанных параметров перевозки при доставке";	
				
			КонецЕсли;	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Указан некорректный адрес" Тогда  
			
			Если ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Город или населенный пункт Получателя не найдены";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.address.search" Тогда	
				
				Сообщение = "Указан некорректный адрес Отправителя";	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Выбранная дата недоступна" Тогда	 
			
			Если ПолеСОшибкой = "delivery.derival.produceDate" Тогда
				
