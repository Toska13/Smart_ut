&НаСервере
Процедура ЗаполнитьПоДаннымСуществующегоЗаказа(СтруктураЗаказа) 
	
	ДанныеЗаказа = СтруктураЗаказа["orders"][0]; 	
	
	ЗаполнитьДанныеУчастникаПеревозкиПоСуществующемуЗаказу("Отправитель", ПолучитьСекциюДанныхУчастникаПеревозкиСуществующегоЗаказа(ДанныеЗаказа, "sender"));
	ЗаполнитьДанныеУчастникаПеревозкиПоСуществующемуЗаказу("Получатель", ПолучитьСекциюДанныхУчастникаПеревозкиСуществующегоЗаказа(ДанныеЗаказа, "receiver"));
	ЗаполнитьДанныеУчастникаПеревозкиПоСуществующемуЗаказу("Плательщик", ПолучитьСекциюДанныхУчастникаПеревозкиСуществующегоЗаказа(ДанныеЗаказа, "payer")); 
	ЗаполнитьДанныеКонтактногоЛицаПеревозкиПоСуществующемуЗаказу("Отправитель", ДанныеЗаказа["sender"]);
	ЗаполнитьДанныеКонтактногоЛицаПеревозкиПоСуществующемуЗаказу("Получатель", ДанныеЗаказа["receiver"]);
	ЗаполнитьДанныеКонтактногоЛицаПеревозкиПоСуществующемуЗаказу("Плательщик", ДанныеЗаказа["payer"]);
	ЗаполнитьАдресПоСуществующемуЗаказу("Отправитель", ДанныеЗаказа["derival"]);
	ЗаполнитьАдресПоСуществующемуЗаказу("Получатель", ДанныеЗаказа["arrival"]); 
	ЗаполнитьГрузПоСуществующемуЗаказу(ДанныеЗаказа["freight"]);
	
	Если (ЗначениеЗаполнено(ОтправительКонтрагентИНН) И ОтправительКонтрагентИНН = ПлательщикКонтрагентИНН)
		Или (ОтправительКонтрагентНомерИностранногоПаспорта <> "~" И ОтправительКонтрагентНомерИностранногоПаспорта = ПлательщикКонтрагентНомерИностранногоПаспорта) Тогда 
		
		ПлательщикРоль = 1;
		ПлательщикРольПредставление = "Совпадает с отправителем";   
		
	ИначеЕсли (ЗначениеЗаполнено(ПолучательКонтрагентИНН) И ПолучательКонтрагентИНН = ПлательщикКонтрагентИНН)
		Или (ПолучательКонтрагентНомерИностранногоПаспорта <> "~" И ПолучательКонтрагентНомерИностранногоПаспорта = ПлательщикКонтрагентНомерИностранногоПаспорта) Тогда 
		
		ПлательщикРоль = 2;
		ПлательщикРольПредставление = "Совпадает с получателем";	
		
	Иначе
		
		ПлательщикРоль = 3;
		ПлательщикРольПредставление = "Третье лицо";
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьДанныеУчастникаПеревозкиПоСуществующемуЗаказу(Префикс, СтруктураУчастника)
	
	ЭтаФорма[Префикс + "КонтрагентНаименование"] = СтруктураУчастника["name"];
	ЭтаФорма[Префикс + "КонтрагентИНН"] = СтруктураУчастника["inn"]; 
	ЭтаФорма[Префикс + "КонтрагентЮрФизЛицо"] = ?(СтруктураУчастника["isPhysical"] = Истина, 2, 1);
	ЭтаФорма[Префикс + "КонтрагентНомерИностранногоПаспорта"] = СокрЛП(СтруктураУчастника["documentSeries"]) + "~" + СокрЛП(СтруктураУчастника["documentNumber"]); 	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьАдресПоСуществующемуЗаказу(Префикс, СтруктураАдреса)
	
	ЭтаФорма[Префикс + "Город"] = Справочники.ДЛ_Города.НайтиПоРеквизиту("КодКЛАДР", СтруктураАдреса["cityCode"]);
	
	Если СтруктураАдреса["address"] = СтруктураАдреса["terminalAddress"] Тогда 
		
		ИмяРеквизитаСпособа = ?(Префикс = "Отправитель", "СпособОтгрузки", "СпособДоставки"); 
		
		ЭтаФорма[ИмяРеквизитаСпособа] = 1; 
		ЭтаФорма[Префикс + "Терминал"] = Справочники.ДЛ_Терминалы.НайтиПоРеквизиту("ИДтерминала", Строка(СтруктураАдреса["terminalId"]));
		
	Иначе
		
		ЭтаФорма[Префикс + "АдресПредставление"] = СтруктураАдреса["address"];	
				
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьГрузПоСуществующемуЗаказу(СтруктураГруза)
	
	Если СтруктураГруза["name"] <> Неопределено Тогда
	
		ХарактерГруза = Справочники.ДЛ_ХарактерГруза.НайтиПоНаименованию(СтруктураГруза["name"]); 
		
	КонецЕсли;
	
	ЕдиницаДлина = "м";
	ЕдиницаШирина = "м"; 
	ЕдиницаВысота = "м";
	
	МинВГХ = ПолучитьМинимальныеЗначенияВГХ();
	
	ГрузКоличествоГрузовыхМест = СтруктураГруза["places"];
	ПереключательРасшифровки = ?(ГрузКоличествоГрузовыхМест > 1, 1, 0);	
	ГрузВес = ?(СтруктураГруза["weight"] = Неопределено, 0, Число(СтруктураГруза["weight"])); 
	ГрузВес = ?(ГрузВес = 0, МинВГХ.МинимальныйВес, ГрузВес); 
	ГрузОбъем = ?(СтруктураГруза["volume"] = Неопределено, 0, Число(СтруктураГруза["volume"])); 
	ГрузОбъем = ?(ГрузОбъем = 0, МинВГХ.МинимальныйОбъем, ГрузОбъем);
	ГрузМаксимальнаяДлина = ?(СтруктураГруза["length"] = Неопределено, 0, Число(СтруктураГруза["length"])); 
	ГрузМаксимальнаяДлина = ?(ГрузМаксимальнаяДлина = 0, МинВГХ.МинимальнаяДлина, ГрузМаксимальнаяДлина);
	ГрузМаксимальнаяШирина = ?(СтруктураГруза["width"] = Неопределено, 0, Число(СтруктураГруза["width"])); 
	ГрузМаксимальнаяШирина = ?(ГрузМаксимальнаяШирина = 0, МинВГХ.МинимальнаяШирина, ГрузМаксимальнаяШирина);
	ГрузМаксимальнаяВысота = ?(СтруктураГруза["height"] = Неопределено, 0, Число(СтруктураГруза["height"])); 
	ГрузМаксимальнаяВысота = ?(ГрузМаксимальнаяВысота = 0, МинВГХ.МинимальнаяВысота, ГрузМаксимальнаяВысота);	
	ГрузНегабаритныйВес = ?(СтруктураГруза["oversizedWeight"] = Неопределено, 0, Число(СтруктураГруза["oversizedWeight"]));
	ГрузНегабаритныйОбъем = ?(СтруктураГруза["oversizedVolume"] = Неопределено, 0, Число(СтруктураГруза["oversizedVolume"]));
	
КонецПроцедуры  

&НаСервере
Процедура ОтправитьМетрикуРазмещенияЗаказа(НомерЗаказа) 	  
	
	ПараметрыВерсии = ДЛ_ДеловыеЛинииПовтИсп.ПолучитьПараметрыТекцущейВерсии();
	СистемнаяИнформация = Новый СистемнаяИнформация;
	
	СтруктураАтрибутов = Новый Структура;
	СтруктураАтрибутов.Вставить("extensionType", ПараметрыВерсии.Идентификатор);
	СтруктураАтрибутов.Вставить("extensionVersion", ПараметрыВерсии.Версия);
	СтруктураАтрибутов.Вставить("platformVersion", СистемнаяИнформация.ВерсияПриложения);
	СтруктураАтрибутов.Вставить("configurationVersion", Метаданные.Версия);
	СтруктураАтрибутов.Вставить("configurationName", Метаданные.Имя);
	СтруктураАтрибутов.Вставить("requestID", НомерЗаказа);
	СтруктураАтрибутов.Вставить("timeOrderSending", ВремяРазмещенияЗаказа - ВремяОткрытияФормы);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("appkey");
	СтруктураПараметров.Вставить("sessionID");
	СтруктураПараметров.Вставить("source", "dellin_1c_extension"); 
	СтруктураПараметров.Вставить("timestamp", Формат(ТекущаяДатаСеанса(), "ДФ='гггг-ММ-дд чч:мм:сс'"));
	СтруктураПараметров.Вставить("category", "order");
	СтруктураПараметров.Вставить("action", "form_order_opened");
	СтруктураПараметров.Вставить("label");
	СтруктураПараметров.Вставить("customAttributes", СтруктураАтрибутов);
	
	ДЛ_ДеловыеЛинии.ОтправитьМетрки(СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ОдинаковыеМестаПриИзменении(Элемент)
	
	Элементы.ГрузОбщийВес.ТолькоПросмотр = ОдинаковыеМеста;
	Элементы.ГрузОбщийОбъем.ТолькоПросмотр = ОдинаковыеМеста;
	
	РассчитатьОбщиеВГХНесколькихМест();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОбщиеВГХНесколькихМест() 
	
	Если ОдинаковыеМеста Тогда
		
		ГрузВес = ГрузМаксимальныйВес * ГрузКоличествоГрузовыхМест;
		ГрузОбъем = ГрузКоличествоГрузовыхМест * 
			ГрузМаксимальнаяВысота * КоэффициентЕдиницы(ЕдиницаВысота) *
			ГрузМаксимальнаяДлина * КоэффициентЕдиницы(ЕдиницаДлина) *
			ГрузМаксимальнаяШирина * КоэффициентЕдиницы(ЕдиницаШирина);			
		ГрузОбъем = Макс(ГрузОбъем, 0.01);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСекциюДанныхУчастникаПеревозкиСуществующегоЗаказа(ДанныеЗаказа, ИмяСекции) 
	
	ДанныеИзЗаказа = ДанныеЗаказа[ИмяСекции]; 
	
	Результат = ДанныеИзЗаказа;
	
	ДанныеДокументов = ДанныеЗаказа["documents"];
	
	Если ДанныеДокументов <> Неопределено И ДанныеДокументов.Количество() > 0 Тогда
		
		ДанныеИзНакладной = ДанныеДокументов[0][ИмяСекции];
		
		Если ДанныеИзНакладной <> Неопределено Тогда
			
			Если ЗначениеЗаполнено(ДанныеИзНакладной["inn"]) И Не ЗначениеЗаполнено(ДанныеИзЗаказа["inn"]) 
				Или ЗначениеЗаполнено(ДанныеИзНакладной["documentSeries"]) И Не ЗначениеЗаполнено(ДанныеИзЗаказа["documentSeries"])
				Или ЗначениеЗаполнено(ДанныеИзНакладной["documentNumber"]) И Не ЗначениеЗаполнено(ДанныеИзЗаказа["documentNumber"]) Тогда
				
				Результат = ДанныеИзНакладной;	
				
			КонецЕсли;
			
		КонецЕсли;		
		
	КонецЕсли;	
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Процедура РезультатПредрасчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РезультатПредрасчетаПредставление" Тогда
		
		Если СокрЛП(Элемент.ТекущиеДанные.Представление) = "Страховка" Тогда	
			
			МассивСтрок=Новый Массив;
			МассивСтрок.Добавить("Об услуге и условиях ее изменения ");
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока("Подробнее", , , ,"https://www.dellin.ru/insurance/"));		
			
			ПоказатьВопрос(Новый ОписаниеОповещения(), Новый ФорматированнаяСтрока(МассивСтрок), РежимДиалогаВопрос.ОК); 
			
		ИначеЕсли СокрЛП(Элемент.ТекущиеДанные.Представление) = "Услуга 'Информация о статусе заказа'" Тогда 
			
			СтрокаИнформации = "Когда груз прибудет в пункт назначения, мы уведомим получателя звонком, в sms или сообщением на email.
			|Изменить способ оповещения можно в личном кабинете.
			|Стоимость услуги фиксированная и не зависит от маршрута и параметров груза.";
			
			ПоказатьВопрос(Новый ОписаниеОповещения(), СтрокаИнформации, РежимДиалогаВопрос.ОК);	
			
		КонецЕсли; 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеКонтактногоЛицаПеревозкиПоСуществующемуЗаказу(Префикс, СтруктураУчастника)	
	 
	ЭтаФорма[Префикс + "КонтактноеЛицоНаименование"] = СтруктураУчастника["contacts"];
	ЭтаФорма[Префикс + "КонтактноеЛицоТелефонПредставление"] = ?(СтруктураУчастника["phones"] = Неопределено, "", СтрЗаменить(СтруктураУчастника["phones"], ",", ";"));
	
	Если Префикс = "Получатель" И СтруктураУчастника["anonym"] = Истина Тогда
		
		ПолучательКонтактноеЛицоТелефонПредставление = СтруктураУчастника["anonymPhone"]; 		
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТаблицуОшибок(Ошибки)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("fields"); 
	Результат.Колонки.Добавить("title");
	Результат.Колонки.Добавить("detail");
	
	ТерминалОтправленияНеНайден = Ложь;
	ТерминалПолученияНеНайден = Ложь;
	
	Для Каждого ОшибкаИзРезультата Из Ошибки Цикл
		
		Если ОшибкаИзРезультата["title"] = "Выбранная дата недоступна" 
			И ОшибкаИзРезультата["detail"] = "Невозможно проверить дату заказа" 
			И (ТерминалПолученияНеНайден Или ТерминалОтправленияНеНайден) Тогда
			
			Продолжить; 
			
		ИначеЕсли ТипЗнч(ОшибкаИзРезультата["fields"]) = Тип("Массив") И ОшибкаИзРезультата["fields"].Количество() > 0 Тогда
			
			Если  ОшибкаИзРезультата["fields"][0] = "delivery.derival.terminalID" Или ОшибкаИзРезультата["fields"][0] = "delivery.derival.address.search" Тогда
				
				ТерминалОтправленияНеНайден = Истина;	
				
			ИначеЕсли ТерминалОтправленияНеНайден И ОшибкаИзРезультата["fields"][0] = "delivery.derival.variant" Тогда  
				
				Продолжить;	
				
			ИначеЕсли ОшибкаИзРезультата["fields"][0] = "delivery.arrival.terminalID"  Или ОшибкаИзРезультата["fields"][0] = "delivery.arrival.address.search" Тогда 
				
				ТерминалПолученияНеНайден = Истина;  
				
			ИначеЕсли ТерминалПолученияНеНайден И ОшибкаИзРезультата["fields"][0] = "delivery.arrival.variant" Тогда  
				
				Продолжить;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОшибкаЗапроса = Результат.Добавить();
		ОшибкаЗапроса.title = ОшибкаИзРезультата["title"];  
		ОшибкаЗапроса.detail = ОшибкаИзРезультата["detail"];  
		ОшибкаЗапроса.fields = ОшибкаИзРезультата["fields"];
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СохранитьАдресаВАдреснуюКнигу()
	
	Если СпособОтгрузки = 0 Тогда 
		
		СохранитьАдресВАдреснуюКнигу("Отправитель");	
		
	КонецЕсли;
	
	Если СпособДоставки = 0 Тогда  
		
		СохранитьАдресВАдреснуюКнигу("Получатель");	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьАдресВАдреснуюКнигу(Префикс)
	
	УчастникГрузоперевозки = ЭтаФорма[Префикс + "КонтрагентСсылка"];
	СохраняемыйАдрес = СокрЛП(ЭтаФорма[Префикс + "АдресПредставление"]);
	
	Если ЗначениеЗаполнено(УчастникГрузоперевозки) И СтрДлина(СохраняемыйАдрес) < 400 Тогда
		
		Запись = РегистрыСведений.ДЛ_АдреснаяКнига.СоздатьМенеджерЗаписи();
		Запись.УчастникГрузоперевозки = УчастникГрузоперевозки;		
		Запись.Адрес = СохраняемыйАдрес; 
		Запись.НаселнныйПункт = ЭтаФорма[Префикс + "Город"];
		Запись.ДатаИспользования = ТекущаяДатаСеанса();
		Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		Запись.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаполнениеАдресаПродолжение(Результат, Префикс) Экспорт
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		
		ЗаполнениеАдреса = Результат.Значение;
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда 
		
		ЗаполнениеАдреса = Результат;
		
	Иначе      
		
		ЗаполнениеАдреса = ""; 
		
	КонецЕсли; 
	
	УчастникГрузоперевозки = ЭтаФорма[Префикс + "КонтрагентСсылка"];
	
	Если ЗаполнениеАдреса = Префикс Тогда 		
		
		Если ЗначениеЗаполнено(УчастникГрузоперевозки) и ТипЗнч(УчастникГрузоперевозки) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("НачатьЗаполнениеАдресаЗавершение", ЭтотОбъект, Префикс);
			
			КнопкиВопросаАдреса = Новый СписокЗначений;
			КнопкиВопросаАдреса.Вставить(0,"Контрагент","Контрагент");
			КнопкиВопросаАдреса.Вставить(1,"Партнер","Партнер");
			
			ПоказатьВыборИзСписка(ОписаниеОповещения, КнопкиВопросаАдреса);
			
		ИначеЕсли ЗначениеЗаполнено(УчастникГрузоперевозки) и ТипЗнч(УчастникГрузоперевозки) = Тип("СправочникСсылка.Организации") Тогда
			
			НачатьЗаполнениеАдресаЗавершение("Организация", Префикс);
			
		Иначе
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите контрагента, чей адрес должен быть заполнен.");
			
		КонецЕсли;  
		
	ИначеЕсли ЗаполнениеАдреса = "Адресная книга" Тогда
		
		НайденыйАдрес = ПолучитьАдресПоАдреснойКниге(Префикс);
		
		Если ЗначениеЗаполнено(НайденыйАдрес) Тогда 
			
			ЭтаФорма[Префикс + "АдресПредставление"] = НайденыйАдрес;
			
		Иначе
			
			ОО = Новый ОписаниеОповещения("ЗаполнениеАдресаАдрснаяКнигаЗавершение", ЭтаФорма, Префикс);
			
			Отборы = Новый Структура();
			Отборы.Вставить("УчастникГрузоперевозки", УчастникГрузоперевозки); 			
			
			Город = ЭтаФорма[Префикс + "Город"];
			
			Если ЗначениеЗаполнено(Город) Тогда
				
				Отборы.Вставить("НаселнныйПункт", Город);	
				
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", Отборы);		
			
			ОткрытьФорму("РегистрСведений.ДЛ_АдреснаяКнига.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеАдресаАдрснаяКнигаЗавершение(Результат, Префикс) Экспорт  	 
	
	Если Результат <> Неопределено Тогда 	
		
		ЭтаФорма[Префикс + "АдресПредставление"] = Результат["Адрес"];			
		
		Если Не ЗначениеЗаполнено(ЭтаФорма[Префикс + "Город"]) Тогда
			
			ЭтаФорма[Префикс + "Город"] = Результат["Город"];	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьАдресПоАдреснойКниге(Префикс)
	
	Результат = "";   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДЛ_АдреснаяКнига.Адрес КАК Адрес,
	               |	ДЛ_АдреснаяКнига.НаселнныйПункт КАК НаселнныйПункт
	               |ИЗ
	               |	РегистрСведений.ДЛ_АдреснаяКнига КАК ДЛ_АдреснаяКнига
	               |ГДЕ
	               |	ДЛ_АдреснаяКнига.УчастникГрузоперевозки = &УчастникГрузоперевозки	               
	               |	И ДЛ_АдреснаяКнига.НаселнныйПункт = &НаселнныйПункт";
	Запрос.УстановитьПараметр("УчастникГрузоперевозки", ЭтаФорма[Префикс + "КонтрагентСсылка"]);	  
	
	Если ЗначениеЗаполнено(ЭтаФорма[Префикс + "Город"]) Тогда
		
		Запрос.УстановитьПараметр("НаселнныйПункт", ЭтаФорма[Префикс + "Город"]);
		
	Иначе     
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДЛ_АдреснаяКнига.НаселнныйПункт = &НаселнныйПункт", "");	
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ЭтаФорма[Префикс + "Город"] = Выборка.НаселнныйПункт;
		Результат = Выборка.Адрес;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СохранитьШаблонПродолжение(Результат, ДополнительныеПараметры) Экспорт	
	
	Если Результат = "Создать новый" Тогда
		
		СтруктураПараметров = Новый Структура("СтруктураШаблона", СобратьСтруктуруДанныхДляШаблона()); 
		
		ОткрытьФорму("РегистрСведений.ДЛ_Шаблоны.Форма.СохранениеШаблона", СтруктураПараметров, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Результат = "Перезаписать существующий" Тогда   
		
		ПараметрыФормы = Новый Структура("РежимВыбора", Истина); 	
		ОО = Новый ОписаниеОповещения("ПриВыбореШаблонаДляЗаписи", ЭтаФорма, СобратьСтруктуруДанныхДляШаблона());
		
		ОткрытьФорму("РегистрСведений.ДЛ_Шаблоны.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриВыбореШаблонаДляЗаписи(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	ПерезаписатьШаблон(Результат, ДополнительныеПараметры);    
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Изменения шаблона сохранены");
	
КонецПроцедуры

&НаСервере
Процедура ПерезаписатьШаблон(СтруктураКлюча, СтруктураШаблона)
	
	ШаблонРегистра = РегистрыСведений.ДЛ_Шаблоны.СоздатьМенеджерЗаписи();
	ШаблонРегистра.Автор = СтруктураКлюча.Автор;
	ШаблонРегистра.ДатаСоздания = СтруктураКлюча.ДатаСоздания;
	ШаблонРегистра.Прочитать();  
	ШаблонРегистра.Данные = Новый ХранилищеЗначения(СтруктураШаблона);
	ШаблонРегистра.ДатаИспользования = ТекущаяДатаСеанса();
	ШаблонРегистра.Записать(Истина);		
	
КонецПроцедуры

