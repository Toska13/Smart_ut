&НаСервере
Функция ЗаполнитьПараметрУчастникПеревозки(Префикс)
	
	Результат = Новый Структура;
	
	КонтрагентСсылка = ЭтотОбъект[Префикс + "КонтрагентСсылка"];
	КонтрагентНаименование = ЭтотОбъект[Префикс + "КонтрагентНаименование"];
	КонтрагентЮрФизЛицо = ЭтотОбъект[Префикс + "КонтрагентЮрФизЛицо"];
	КонтрагентИНН = ЭтотОбъект[Префикс + "КонтрагентИНН"];
	КонтрагентЮридическийАдрес = ЭтотОбъект[Префикс + "КонтрагентЮридическийАдресПредставление"];
	КонтактноеЛицо = ЭтотОбъект[Префикс + "КонтактноеЛицоНаименование"]; 
	Телефон = ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонПредставление"];	
	Иностранец = ЭтотОбъект[Префикс + "КонтрагентИностранец"];
	ОПФ = ЭтотОбъект[Префикс + "КонтрагентОПФ"];
	НомерИностранногоПаспорта = СокрЛП(ЭтотОбъект[Префикс + "КонтрагентНомерИностранногоПаспорта"]);  
	СогласиеНаПолучениеЭлектронногоЧека = ЭтотОбъект[Префикс + "СогласиеНаПолучениеЭлектронногоЧека"]; 
	КонтактноеЛицоEmail = ЭтотОбъект[Префикс + "КонтактноеЛицоEmail"]; 
	КонтактноеЛицоТелефонДляЧека = ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонДляЧека"];
	
	ПараметрыКонтрагента = Новый Структура;		 
	
	Если  Префикс = "Получатель" И УпрощеннаяДоставка Тогда
		
		ПараметрыКонтрагента.Вставить("isAnonym", Истина);
		ПараметрыКонтрагента.Вставить("name", ПолучательКонтактноеЛицоНаименование); 
		ПараметрыКонтрагента.Вставить("form", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");
		ПараметрыКонтрагента.Вставить("phone", ТолькоЦифры(Телефон));  
		
		Результат.Вставить("counteragent", ПараметрыКонтрагента);  
		
		Возврат Результат;
		
	КонецЕсли; 		 
	
	Если Элементы["ГруппаЭлектронныйЧек" + Префикс].Видимость Тогда
		
		ДанныеДляЭлектронногоЧека = Новый Структура;
		ДанныеДляЭлектронногоЧека.Вставить("send", СогласиеНаПолучениеЭлектронногоЧека); 		  
		
		Если ЗначениеЗаполнено(КонтактноеЛицоEmail) Тогда  
			
			ДанныеДляЭлектронногоЧека.Вставить("email", КонтактноеЛицоEmail);	
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КонтактноеЛицоТелефонДляЧека) Тогда  
			
			ДанныеДляЭлектронногоЧека.Вставить("phone", КонтактноеЛицоТелефонДляЧека);	
			
		КонецЕсли;
		
		Результат.Вставить("dataForReceipt", ДанныеДляЭлектронногоЧека);
		
	КонецЕсли;
	
	Если КонтрагентЮрФизЛицо = 2 Тогда
		
		ПараметрыКонтрагента.Вставить("form", ?(Иностранец Или ЭтаФорма[Префикс + "РучнойВвод"] = 2, ОПФ.UID, "0xAB91FEEA04F6D4AD48DF42161B6C2E7A")); 
		
		Если Не УпрощеннаяДоставка Или Префикс <> "Получатель" Тогда 			
			
			Паспорт = Новый Структура;
			Паспорт.Вставить("type", "passport"); 
			
			Если Иностранец  Или ЭтаФорма[Префикс + "РучнойВвод"] = 2 Тогда 
				
				ПаспортныеДанные = ?(Иностранец, НомерИностранногоПаспорта, КонтрагентИНН);
				
				СерияНомер = СтрРазделить(ПаспортныеДанные, " ", Ложь);
				
				Если СерияНомер.Количество() > 1 Тогда
					
					Паспорт.Вставить("serial", СерияНомер[0]); 
					Паспорт.Вставить("number", СерияНомер[1]);	
					
				Иначе	
				
					Паспорт.Вставить("number", ПаспортныеДанные);	
					
				КонецЕсли;	
				
			Иначе
				
				Если ЗначениеЗаполнено(КонтрагентНаименование) И Не ЗначениеЗаполнено(КонтрагентСсылка) И ЗначениеЗаполнено(ЭтотОбъект[Префикс + "КонтрагентНомерИностранногоПаспорта"]) Тогда
					
					СерияНомер = СтрРазделить(ЭтотОбъект[Префикс + "КонтрагентНомерИностранногоПаспорта"], "~", Ложь); 
					
					Если СерияНомер.Количество() > 1 Тогда
						
						Паспорт.Вставить("serial", СерияНомер[0]); 
						Паспорт.Вставить("number", СерияНомер[1]);	
						
					Иначе	
						
						Паспорт.Вставить("number", КонтрагентСсылка.ДокументУдостоверяющийЛичность);	
						
					КонецЕсли;
					
				Иначе
					
					ПаспортныеДанные = ПолучитьПаспортныеДанные(КонтрагентСсылка);
					Паспорт.Вставить("serial", СтрЗаменить(ПаспортныеДанные.Серия, " ", "")); 
					Паспорт.Вставить("number", ПаспортныеДанные.Номер);  
					
				КонецЕсли;
				
			КонецЕсли;
			
			ПараметрыКонтрагента.Вставить("document", Паспорт); 
			
		КонецЕсли;
		
	Иначе 
		
		Если Префикс = "Плательщик" Тогда
			
			ПараметрыКонтрагента.Вставить("form", ?(Иностранец, ОПФ.UID, ДЛ_ДеловыеЛинии.ПолучитьОПФпоИНН(КонтрагентИНН)));		
			ПараметрыКонтрагента.Вставить("inn", ?(Иностранец, ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(КонтрагентСсылка, "НалоговыйНомер"), КонтрагентИНН)); 
			
		Иначе	
			
			ПараметрыКонтрагента.Вставить("form", ?(Иностранец Или (ЭтаФорма[Префикс + "РучнойВвод"] = 1 И СокрЛП(ЭтаФорма[Префикс + "КонтрагентСтрана"]) <> "Россия"), ОПФ.UID, ДЛ_ДеловыеЛинии.ПолучитьОПФпоИНН(КонтрагентИНН)));		
			ПараметрыКонтрагента.Вставить("inn", ?(Иностранец И ЭтаФорма[Префикс + "РучнойВвод"] = 0, ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(КонтрагентСсылка, "НалоговыйНомер"), КонтрагентИНН)); 
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КонтрагентЮридическийАдрес) Тогда
		
			ПараметрыКонтрагента.Вставить("juridicalAddress", Новый Структура("search", КонтрагентЮридическийАдрес));
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ПараметрыКонтрагента.Вставить("name", КонтрагентНаименование); 
	
	КонтактныеЛица = Новый Массив;
	КонтактныеЛица.Добавить(Новый Структура("name", КонтактноеЛицо));
	
	Телефоны = Новый Массив;
	
	Если ЗначениеЗаполнено(Телефон) Тогда	
		
		МассивТелефонов = СтрРазделить(Телефон, ";");
		ТелефоновДобавлено = 0;
		
		Для Каждого НомерТелефона Из МассивТелефонов Цикл
			
			Если ТелефоновДобавлено = 3 Тогда
				
				Прервать;
				
			КонецЕсли;
			
			НомерТелефонаСДобавочным = СтрРазделить(СтрЗаменить(СтрЗаменить(НомерТелефона, Символы.ПС, ""), ", доб. ", Символы.ПС), Символы.ПС, Ложь);
			
			НомерТелефонаОчищенный = ТолькоЦифры(НомерТелефонаСДобавочным[0]);
			
			Если ЗначениеЗаполнено(НомерТелефонаОчищенный) Тогда
				
				СтруктураТелефона = Новый Структура;
				СтруктураТелефона.Вставить("number", НомерТелефонаОчищенный);
				
				Если НомерТелефонаСДобавочным.Количество() = 2  Тогда
					
					СтруктураТелефона.Вставить("ext", ТолькоЦифры(НомерТелефонаСДобавочным[1]));	
					
				КонецЕсли; 
				
				Телефоны.Добавить(СтруктураТелефона);
				
				ТелефоновДобавлено = ТелефоновДобавлено + 1;	
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;	 
	
	Результат.Вставить("counteragent", ПараметрыКонтрагента); 
	Результат.Вставить("contactPersons", КонтактныеЛица); 
	Результат.Вставить("phoneNumbers", Телефоны); 	
	
	Возврат Результат;
	
КонецФункции

