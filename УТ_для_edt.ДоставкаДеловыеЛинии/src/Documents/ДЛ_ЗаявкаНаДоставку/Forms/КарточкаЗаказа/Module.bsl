&НаКлиенте
Процедура ОтправительПолучательПлательщикРольНачалоВыбораЗавершение(Результат, ИдентификаторРоли) Экспорт
	
	ПлательщикРольСтарое = ЭтаФорма[ИдентификаторРоли + "ПлательщикРоль"];
	
	Если Результат = Неопределено Тогда	
		
		ЭтаФорма[ИдентификаторРоли + "ПлательщикРоль"] = 0;
		ЭтаФорма[ИдентификаторРоли + "ПлательщикРольПредставление"] = ""; 
		
	Иначе  
		
		ЭтаФорма[ИдентификаторРоли + "ПлательщикРоль"]  = Результат.Значение;  
		
		Если ПлательщикРольСтарое <> ЭтаФорма[ИдентификаторРоли + "ПлательщикРоль"] Тогда  
			
			ЭтаФорма[ИдентификаторРоли + "ПлательщикРольПредставление"] = Результат.Представление; 
			
		КонецЕсли;  
		
	КонецЕсли;
	
	Если ПлательщикРольСтарое <> ПлательщикРоль Тогда 
		
		Модифицированность = Истина; 
		
	КонецЕсли; 	
	
	УстановитьВидимостьДоступностьНаСтраницеОсновная();	

КонецПроцедуры

