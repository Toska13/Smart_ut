			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Невозможно оформить заявку на указанное время" Тогда	 
			
			Если ПолеСОшибкой = "delivery.derival.time.worktimeStart" Тогда
				
