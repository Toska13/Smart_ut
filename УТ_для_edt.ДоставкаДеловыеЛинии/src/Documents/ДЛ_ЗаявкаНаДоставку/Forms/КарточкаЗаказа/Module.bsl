&НаКлиенте
Процедура РассчитатьОбъем()
	
	Если ГрузКоличествоГрузовыхМест = 1 Тогда
		
		ГрузОбъемРасчетный = ГрузМаксимальнаяВысота * КоэффициентЕдиницы(ЕдиницаВысота) *
			ГрузМаксимальнаяДлина * КоэффициентЕдиницы(ЕдиницаДлина) *
			ГрузМаксимальнаяШирина * КоэффициентЕдиницы(ЕдиницаШирина); 
			
		Если ГрузОбъемРасчетный > 0 Тогда 
				
			ГрузОбъем = Макс(ГрузОбъемРасчетный, 0.01); 
			
		КонецЕсли;
		
		Если ГрузНегабаритныйОбъем > 0 Или ГрузНегабаритныйВес > 0 Тогда
			
			ГрузНегабаритныйОбъем = ГрузОбъем;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ЗаблокироватьОтправкуЗаказа(); 
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьВес()
	
	Если ГрузКоличествоГрузовыхМест = 1 
		И ГрузМаксимальныйВес > 0 Тогда
		ГрузВес = Мин(ГрузВес, ГрузМаксимальныйВес);
	КонецЕсли;
	
КонецПроцедуры

