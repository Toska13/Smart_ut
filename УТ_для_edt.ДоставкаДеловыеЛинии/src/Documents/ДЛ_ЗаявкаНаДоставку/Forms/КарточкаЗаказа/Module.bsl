&НаСервере
Процедура ЗаполнитьВГХПоДокументамОснованиям(СпособГруппировкиТоваров)   
	
	ТаблицаТовары = ИнициализироватьТаблицуТоваров(); 	
	
	Для Каждого Документ Из Объект.ДокументыОснования Цикл
		
		Если ЗначениеЗаполнено(Документ.Документ) Тогда
		
			ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, Документ.Документ);		
			
		КонецЕсли;		
		
	КонецЦикла;	 
	
	Если ТаблицаТовары.Количество() > 0 Тогда
		
		ГрузВес = ТаблицаТовары.Итог("Вес");
		
		Если СпособГруппировкиТоваров = 1 Тогда
			
			ПереключательРасшифровки = 0;
			ГрузКоличествоГрузовыхМест = 1; 
			ГрузМаксимальныйВес = ГрузВес;
			
		Иначе	
			
			ГрузКоличествоГрузовыхМест = ?(СпособГруппировкиТоваров = 2, ТаблицаТовары.Количество(), ТаблицаТовары.Итог("Количество"));
			ПереключательРасшифровки = ?(ГрузКоличествоГрузовыхМест > 1, 1, 0); 			
			ТаблицаТовары.Сортировать("Вес Убыв"); 
			ГрузМаксимальныйВес = ТаблицаТовары[0].Вес;
			
		КонецЕсли; 		
		
		ГрузОбъем = ТаблицаТовары.Итог("Объем");
		ГрузСтоимость = ТаблицаТовары.Итог("Стоимость");  	
		ТаблицаТовары.Сортировать("Длина Убыв"); 
		ГрузМаксимальнаяДлина = ТаблицаТовары[0].Длина;
		ЕдиницаДлина = "м"; 		
		ТаблицаТовары.Сортировать("Ширина Убыв"); 
		ГрузМаксимальнаяШирина = ТаблицаТовары[0].Ширина;
		ЕдиницаШирина = "м";		
		ТаблицаТовары.Сортировать("Высота Убыв"); 
		ГрузМаксимальнаяВысота = ТаблицаТовары[0].Высота;
		ЕдиницаВысота = "м"; 
		
		ГрузНегабаритныйВес = 0;
		ГрузНегабаритныйОбъем = 0;
		
		Для Каждого СтрокаТовар Из ТаблицаТовары Цикл
			
			Если СтрокаТовар.Длина > 3 Или СтрокаТовар.Ширина > 3  Или СтрокаТовар.Высота > 3 Или СтрокаТовар.Вес > 800 Тогда
				
				ГрузНегабаритныйВес = ГрузНегабаритныйВес + СтрокаТовар.Вес;
				ГрузНегабаритныйОбъем = ГрузНегабаритныйОбъем + СтрокаТовар.Объем;
				
			КонецЕсли;
			
		КонецЦикла; 			
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнициализироватьТаблицуТоваров() 
	
	Строка250 = ОбщегоНазначения.ОписаниеТипаСтрока(250);
	Число15_3 = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3); 
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", Строка250);
	Результат.Колонки.Добавить("Количество", Число15_3);
	Результат.Колонки.Добавить("Длина", Число15_3);
	Результат.Колонки.Добавить("Ширина", Число15_3);
	Результат.Колонки.Добавить("Высота", Число15_3); 
	Результат.Колонки.Добавить("Объем", Число15_3);
	Результат.Колонки.Добавить("Вес", Число15_3);
	Результат.Колонки.Добавить("Стоимость", Число15_3);
	
	Возврат Результат;
	
КонецФункции  

&НаСервереБезКонтекста
Процедура ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, Документ)
		
	ДокументОбъект = Документ.ПолучитьОбъект();	
	МетаданныеОбъекта = ДокументОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя; 
	
	МинВГХ = ПолучитьМинимальныеЗначенияВГХ();
	
	Если ИмяДокумента = "ВозвратТоваровПоставщику" 
		Или ИмяДокумента = "ЗаказКлиента"
		Или ИмяДокумента = "РеализацияТоваровУслуг"
		Или ИмяДокумента = "ЗаказПоставщику"
		Или ИмяДокумента = "ЗаявкаНаВозвратТоваровОтКлиента"
		Или ИмяДокумента = "ПриобретениеТоваровУслуг"
		Или ИмяДокумента = "ПоступлениеТоваровНаСклад"
		Или ИмяДокумента = "ЗаказНаПеремещение"
		Или ИмяДокумента = "КорректировкаРеализации"
		Или ИмяДокумента = "КорректировкаПриобретения"
		Или ИмяДокумента = "РасходныйОрдерНаТовары" 
		Или ИмяДокумента = "ПриходныйОрдерНаТовары"
		Или ИмяДокумента = "ПеремещениеТоваров" Тогда
		
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("Ссылка", Документ); 
		Запрос.УстановитьПараметр("ЗаполненаЕдиницаИзмеренияВеса",   ЗначениеЗаполнено(Константы.ЕдиницаИзмеренияВеса.Получить()));
		Запрос.Текст = "ВЫБРАТЬ
		|	ТаблицаТоваров.Ссылка КАК Ссылка, 
		|	ТаблицаТоваров.Номенклатура.Наименование КАК Товар,
		|	ТаблицаТоваров.Количество КАК Количество, 
		|	ТаблицаТоваров.Количество * &ТекстЗапросаВес КАК МассаНетто,
		|	ВЫБОР
		|		КОГДА &ЗаполненаЕдиницаИзмеренияВеса
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаТоваров.Упаковка.Вес ЕСТЬ NULL 
		|						ТОГДА ТаблицаТоваров.Количество * &ТекстЗапросаВес1
		|					ИНАЧЕ ТаблицаТоваров.КоличествоУпаковок * &ТекстЗапросаВес1
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Вес,
		|	ТаблицаТоваров.Упаковка.Глубина КАК Длина,
		|	ТаблицаТоваров.Упаковка.Ширина КАК Ширина,
		|	ТаблицаТоваров.Упаковка.Высота КАК Высота,
		|	ТаблицаТоваров.Количество * &ТекстЗапросаОбъем КАК Объем,
		|	ТаблицаТоваров.СуммаСНДС КАК Стоимость
		|ИЗ
		|	Документ.&Документ.Товары КАК ТаблицаТоваров
		|ГДЕ
		|   ТаблицаТоваров.Ссылка = &Ссылка
		|	И  ТаблицаТоваров.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|	И  ТаблицаТоваров.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)";
		
		Если ИмяДокумента = "ЗаказНаПеремещение"
			Или ИмяДокумента = "ПеремещениеТоваров" 
			Или ИмяДокумента = "ПриходныйОрдерНаТовары"	Тогда	
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.СуммаСНДС", "0");
			
		ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.Расхождения");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.Ссылка = &Ссылка", "ТаблицаТоваров.Ссылка = &Ссылка
				|И (ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализацию) 
				|ИЛИ ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУчестьПриИнвентаризации))");
			
		ИначеЕсли ИмяДокумента = "КорректировкаПриобретения" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.Расхождения");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.Ссылка = &Ссылка", "ТаблицаТоваров.Ссылка = &Ссылка
				|И (ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУменьшитьСкладскиеОстатки) 
				|ИЛИ ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУчестьПриИнвентаризации))");
			
		ИначеЕсли ИмяДокумента = "РасходныйОрдерНаТовары" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.ОтгружаемыеТовары");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.СуммаСНДС", "0");
			
		ИначеЕсли ИмяДокумента = "ЗаявкаНаВозвратТоваровОтКлиента" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.ВозвращаемыеТовары");	
			
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Документ", ИмяДокумента);	
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаВес1",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки(
				"ТаблицаТоваров.Упаковка",
				"ТаблицаТоваров.Номенклатура"));	
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаВес",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки(
				"ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения",
				"ТаблицаТоваров.Номенклатура"));
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаОбъем",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаОбъемУпаковки(
				"ТаблицаТоваров.Упаковка",
				"ТаблицаТоваров.Номенклатура")); 		
			
	ИначеЕсли ИмяДокумента = "ТранспортнаяНакладная" Тогда 
		
		Для Каждого ДокументОснованиеТН Из Документ.ДокументыОснования Цикл
			
			ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, ДокументОснованиеТН.ДокументОснование);	
			
		КонецЦикла;   
		
		Возврат;
		
	Иначе
		
		Возврат;			
		
	КонецЕсли; 
	
	ПересчитыватьВалютуДокумента = Ложь;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Валюта", МетаданныеОбъекта) Тогда  		
		
		ВалютаРегламентированногоУчета 	= ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		
		Если Документ.Валюта <> ВалютаРегламентированногоУчета Тогда
			
			СтруктурыКурсов = ВзаиморасчетыСервер.КурсыВалютДляПересчета(
				ДокументОбъект, 
				Документ.Валюта, 
				ВалютаРегламентированногоУчета, 
				ВалютаРегламентированногоУчета, 
				Документ.Дата);
			
			ПересчитыватьВалютуДокумента = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Пока Выборка.Следующий() Цикл 
		
		СтрокаТовара = ТаблицаТовары.Добавить(); 
		ЗаполнитьЗначенияСвойств(СтрокаТовара, Выборка);
		СтрокаТовара.Стоимость = Макс(СтрокаТовара.Стоимость, - СтрокаТовара.Стоимость);
		
		Если ПересчитыватьВалютуДокумента Тогда
			
			СтрокаТовара.Стоимость = РаботаСКурсамиВалютУТ.ПересчитатьПоКурсу(
				СтрокаТовара.Стоимость,
				СтруктурыКурсов.СтруктураКурсовСтаройВалюты,
				СтруктурыКурсов.СтруктураКурсовНовойВалюты);
			
		КонецЕсли;
		
		НезаполненныеХарактеристики = Новый Массив;  
		
		Если Не ЗначениеЗаполнено(Выборка.Длина) Тогда 
			
			СтрокаТовара.Длина = МинВГХ.МинимальнаяДлина;
			
			НезаполненныеХарактеристики.Добавить("Глубина/Длина");
			
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(Выборка.Ширина) Тогда 
			
			СтрокаТовара.Ширина = МинВГХ.МинимальнаяШирина;
			
			НезаполненныеХарактеристики.Добавить("Ширина");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Высота) Тогда  
			
			СтрокаТовара.Высота = МинВГХ.МинимальнаяВысота;
			
			НезаполненныеХарактеристики.Добавить("Высота");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Объем) Тогда 
			
			СтрокаТовара.Объем = МинВГХ.МинимальныйОбъем;
			
			НезаполненныеХарактеристики.Добавить("Объем");
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Вес) Тогда  
			
			СтрокаТовара.Вес = МинВГХ.МинимальныйВес;
			
			НезаполненныеХарактеристики.Добавить("Вес"); 				
			
		КонецЕсли; 			
		
		Если НезаполненныеХарактеристики.Количество() Тогда
			
			СтрокаСообщения = СтрШаблон("⚠ В документе %1 не заполнены ВГХ (%2) для позиции: %3. Будут использованы Значения по умолчанию.",
				Документ,
				СтрСоединить(НезаполненныеХарактеристики, ", "),
				Выборка.Товар);
				
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения);	
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры  

