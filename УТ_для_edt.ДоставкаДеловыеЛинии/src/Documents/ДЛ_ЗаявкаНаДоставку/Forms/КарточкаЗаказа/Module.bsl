КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьОПФПоУмолчанию()	
	
	Возврат Справочники.ДЛ_ОПФ.НайтиПоРеквизиту("UID", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");	
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьРучнойВводКонтрагентов(Префикс) 
	
	Если ЭтаФорма[Префикс + "РучнойВвод"] = 0 Тогда     
		
		Элементы[Префикс + "КонтрагентИНН"].Заголовок = "ИНН"; 
		Элементы[Префикс + "КонтрагентИНН"].ПодсказкаВвода = "Введите ИНН";
		Элементы[Префикс + "КонтрагентИНН"].Маска = ""; 
		Элементы[Префикс + "КонтрагентИНН"].ТолькоПросмотр = Истина;
		Элементы[Префикс + "Контрагент"].РедактированиеТекста = Ложь;
		Элементы[Префикс + "Контрагент"].КнопкаОткрытия = Истина; 
		Элементы[Префикс + "Контрагент"].ПодсказкаВвода = "Выберите из справочника";
		Элементы[Префикс + "Контрагент"].МаксимальнаяШирина = 33;
		Элементы[Префикс + "Поиск"].Видимость = Ложь;
		Элементы[Префикс + "КонтактноеЛицо"].КнопкаОткрытия = Истина;
		Элементы[Префикс + "КонтактноеЛицо"].КнопкаВыбора = Истина;	
		
		Если Префикс <> "Плательщик" Тогда
			
			Элементы[Префикс + "КонтрагентСтранаРВ"].Видимость = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Элементы[Префикс + "КонтрагентИНН"].ТолькоПросмотр = Ложь;
		Элементы[Префикс + "Контрагент"].РедактированиеТекста = Истина; 
		Элементы[Префикс + "Контрагент"].КнопкаОткрытия = Ложь;						
		Элементы[Префикс + "КонтактноеЛицо"].КнопкаОткрытия = Ложь; 
		Элементы[Префикс + "КонтактноеЛицо"].КнопкаВыбора = Ложь; 
		Элементы["гр" + Префикс + "Иностранец"].Видимость = Ложь; 
		
		Если ЭтаФорма[Префикс + "РучнойВвод"] = 1 Тогда
			
			Элементы[Префикс + "Контрагент"].ПодсказкаВвода = "Поиск по Наименованию/ИНН"; 
			Элементы[Префикс + "Контрагент"].МаксимальнаяШирина = 29; 
			Элементы[Префикс + "Поиск"].Видимость = Истина;
			Элементы[Префикс + "КонтрагентСтранаРВ"].Видимость = Истина;  			
			Элементы[Префикс + "КонтрагентСтрана"].Видимость = Ложь;
			Элементы[Префикс + "КонтрагентИНН"].Маска = "";  
			
			КонтрагентСтранаРВПриИзменении(Префикс);
			
		Иначе
			
			Элементы[Префикс + "Контрагент"].ПодсказкаВвода = "ФИО";
			Элементы[Префикс + "Контрагент"].МаксимальнаяШирина = 33;
			Элементы[Префикс + "Поиск"].Видимость = Ложь;
			Элементы[Префикс + "КонтрагентСтранаРВ"].Видимость = Ложь;
			Элементы[Префикс + "КонтрагентСтрана"].Видимость = Истина;
			Элементы[Префикс + "КонтрагентИНН"].Заголовок = "Паспорт";
			Элементы[Префикс + "КонтрагентИНН"].ПодсказкаВвода = "Серия Номер";  
			Элементы[Префикс + "КонтрагентОПФ"].Видимость = Ложь;  			
			
			УстановитьМаскуПаспорта(Префикс);			
			
		КонецЕсли;		  
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДополнительныеТребования(Префикс, ТЗ_Требования) 
	
	Элементы[Префикс + "ДополнительныеТребованияТС"].СписокВыбора.Добавить("", "Отсутствуют");
	
	Для Каждого СтрТЗ Из ТЗ_Требования Цикл
		
		Элементы[Префикс + "ДополнительныеТребованияТС"].СписокВыбора.Добавить(СтрТЗ.UID, СтрТЗ.Наименование);	
		
	КонецЦикла;
	
КонецПроцедуры   


&НаКлиенте
Процедура ДополнительныеУслугиИспользоватьПриИзменении(Элемент) 	
	
	Элементы.ДополнительныеУслугиПлательщик.ТолькоПросмотр = ОпределеитьВозможностьИзменятьПлательщикаЗаДопУслуги();
	
КонецПроцедуры 

&НаСервере
Функция ОпределеитьВозможностьИзменятьПлательщикаЗаДопУслуги() 
	
	ПромТЗ = ДополнительныеУслуги.Выгрузить(, "Использовать");
	ПромТЗ.Сортировать("Использовать УБЫВ");
	
	Возврат Не ПромТЗ[0].Использовать;
	
КонецФункции 

&НаСервере
Процедура ДобавитьСтрокуРасшифровкиПредрасчета(СтрокиРезультата, ДанныеЗапроса, ТекстРасшифровки)  
	
	Если ДанныеЗапроса["contractPrice"] Тогда
		
		СтрокаРезультата =	СтрокиРезультата.Добавить();
		СтрокаРезультата.Представление = "		" + ТекстРасшифровки;
		СтрокаРезультата.Сумма = "договорная"; 
		
	ИначеЕсли ДанныеЗапроса["price"] > 0 Тогда 	
		
		СтрокаРезультата = ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРезультата, "		" + ТекстРасшифровки, СтрокаСумма(ДанныеЗапроса["price"]));		
		
		ЗаполнитьРасшифровкуПоСкидкамНадбавкам(СтрокаРезультата.ПолучитьЭлементы(), ДанныеЗапроса);
		
	КонецЕсли;                                                                           
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасшифровкуПоСкидкамНадбавкам(СтрокиРасшифровки, ДанныеЗапроса) 
	
	БазоваяЦена = ДанныеЗапроса["price"];
	
	ЗаполнитьРасшифровкуПоМассиву(СтрокиРасшифровки, ДанныеЗапроса["discountDetails"], -1);
	ЗаполнитьРасшифровкуПоМассиву(СтрокиРасшифровки, ДанныеЗапроса["premiumDetails"], 1); 
	
	Если ДанныеЗапроса["handling"] <> Неопределено И ДанныеЗапроса["handling"]["price"] <> Неопределено И ДанныеЗапроса["handling"]["price"] > 0 Тогда
		
		ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРасшифровки, "			Погрузо-разгрузочные работы", ДанныеЗапроса["handling"]["price"]);			
		
	КонецЕсли;
	
	Если СтрокиРасшифровки.Количество() > 0 Тогда
	
		Для Каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
			
			БазоваяЦена = БазоваяЦена - СтрокаРасшифровки.Сумма; 
			
			СтрокаРасшифровки.Сумма = СтрокаСумма(СтрокаРасшифровки.Сумма);
			
		КонецЦикла; 
		
		Если БазоваяЦена <> 0 Тогда
			
			СтрокаРасшифровки =	СтрокиРасшифровки.Вставить(0);
			СтрокаРасшифровки.Представление = "			Базовая стоимость";
			СтрокаРасшифровки.Сумма = СтрокаСумма(БазоваяЦена);	
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьРасшифровкуПоМассиву(СтрокиРасшифровки, ДанныеЗапроса, Коэффициент)    
	
	Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из ДанныеЗапроса Цикл
			
			ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиРасшифровки, "			" + ЭлементМассива["name"], ЭлементМассива["value"] * Коэффициент);			
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ДобавитьСтрокуСуммыВДеревоПредрасчета(СтрокиДерева, Представление, Сумма)  
	
	Результат = СтрокиДерева.Добавить();
	Результат.Представление = Представление;
	Результат.Сумма = Сумма;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСуммуСкидокНаценокПоМассиву(ДанныеЗапроса) 
	
	Результат = 0; 
	
	Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из ДанныеЗапроса Цикл
			
			Результат = Результат + ЭлементМассива["value"];
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НаложенныйПлатежПрименить(Команда)
	
	Элементы.грНаложенныйПлатежСостав.Скрыть();
		
КонецПроцедуры

&НаКлиенте
Процедура ПоискОтправителя(Команда)
	
	КонтрагентПриИзменении("Отправитель");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПолучателя(Команда)
	
	КонтрагентПриИзменении("Получатель");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМаскуПаспорта(Префикс)  
	
	Если ЭтаФорма[Префикс + "РучнойВвод"] > 0 Тогда 
		
		Если СокрЛП(ЭтаФорма[Префикс + "КонтрагентСтрана"]) = "Россия" Тогда 
			
			Элементы[Префикс + "КонтрагентИНН"].Маска = "9999 999999";
			
			ЦифрыПаспорта = ТолькоЦифры(ЭтаФорма[Префикс + "КонтрагентИНН"]);
			ЭтаФорма[Префикс + "КонтрагентИНН"] = ?(СтрДлина(ЦифрыПаспорта) > 4, Лев(Лев(ЦифрыПаспорта, 4) + " " + Сред(ЦифрыПаспорта, 5), 11), ЦифрыПаспорта);				
			
		Иначе
			
			Элементы[Префикс + "КонтрагентИНН"].Маска = "";
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПредварительныйРасчетФайловый(Команда)
	
	Результат = РасчетИСозданиеЗаказа(Истина);                                 
	
	Если Результат.Успешно Тогда
		
		ОО = Новый ОписаниеОповещения("ПредварительныйРасчетОкончание", ЭтаФорма);	
		
		ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.РезультатКалькулятора", Результат, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		
	КонецЕсли;	
	
	УстановитьДоступностьФормы(Ложь);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатРасчетаФайловыйВариант(РезультатЗапроса, Результат)
	
	Если РезультатЗапроса["data"] <> Неопределено Тогда  
		
		ВывестиДанныеПредварительногоРасчетаФайловыйВариант(РезультатЗапроса["data"], Результат);			
		
		УстановитьДоступностьФормы(Истина); 				
		
	ИначеЕсли РезультатЗапроса["errors"] <> Неопределено Тогда	
		
		ТаблицаОшибок = ЗаполнитьТаблицуОшибок(РезультатЗапроса["errors"]);
		
		Для Каждого ОшибкаЗапроса Из ТаблицаОшибок Цикл				
			
			ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибкеЗаказа(ОшибкаЗапроса)); 
			
		КонецЦикла; 
		
	Иначе
		
		ОбщегоНазначения.СообщитьПользователю("Ошибка выполнения запроса. Попробуйте еще раз");
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ВывестиДанныеПредварительногоРасчетаФайловыйВариант(ДанныеЗапроса, Результат)	
	
	ГрафикПеревозки = ДЛ_ДеловыеЛинии.ПрочитатьДанныеГрафикаПеревозки(ДанныеЗапроса["orderDates"]); 
	
	Результат.Вставить("ГрафикПеревозки", ГрафикПеревозки);
	Результат.Вставить("ЦенаЗаказа", ДанныеЗапроса["price"]);
	Результат.Вставить("Страховка", ДанныеЗапроса["insurance"]);
	
	Если ДанныеЗапроса["foundAddresses"] <> Неопределено И ДанныеЗапроса["foundAddresses"].Количество() > 0 Тогда
		
		СообщениеАдреса = "Проверьте автоматически найденные адреса:"; 
		
		Для Каждого НайденныйАдрес Из ДанныеЗапроса["foundAddresses"] Цикл
			
			СообщениеАдреса = СообщениеАдреса + Символы.ПС + НайденныйАдрес["result"];
			
		КонецЦикла;
		
		Результат.Вставить("Адреса", СообщениеАдреса);
		
	КонецЕсли; 
	
	СообщениеДетализация = ""; 	
	УслугаИнформацияОСтатусе = "";
	
	ЦенаДоговорная = "договорная";
	
	Если ДанныеЗапроса["intercity"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["intercity"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе   
			
			Цена = "" + ДанныеЗапроса["intercity"]["price"] + " руб.";
			
		КонецЕсли; 
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Автоперевозка: " + Цена;
		
	КонецЕсли;   
	
	Если ДанныеЗапроса["small"] <> Неопределено Тогда 		
		
		Если ДанныеЗапроса["small"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["small"]["price"] + " руб.";
			
		КонецЕсли;  
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Малогабаритный груз: " + Цена;
		
	КонецЕсли;
	
	Если ДанныеЗапроса["air"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["air"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["air"]["price"] + " руб.";
			
		КонецЕсли;  
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Авиаперевозка: " + Цена;
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["express"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["express"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["express"]["price"] + " руб.";
			
		КонецЕсли;
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Экспресс-перевозка: " + Цена;
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["letter"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["letter"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["letter"]["price"] + " руб.";
			
		КонецЕсли;
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Письмо: " + Цена;
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["derival"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["derival"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["derival"]["price"] + " руб.";
			
		КонецЕсли;
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Доставка от отправителя: " + Цена;
		
	КонецЕсли;  
	
	Если ДанныеЗапроса["arrival"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["arrival"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["arrival"]["price"] + " руб.";
			
		КонецЕсли;
		
		СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Доставка до получателя: " + Цена;
		
	КонецЕсли;
	
	Если ДанныеЗапроса["accompanyingDocuments"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["accompanyingDocuments"]["send"] <> Неопределено Тогда
			
			Если ДанныеЗапроса["accompanyingDocuments"]["send"]["contractPrice"] Тогда
				
				Цена = ЦенаДоговорная;	
				
			Иначе  
				
				Цена = "" + ДанныеЗапроса["accompanyingDocuments"]["send"]["price"] + " руб.";
				
			КонецЕсли;
			
			СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Отправка сопроводительных документов: " + Цена;
			
		КонецЕсли;
		
		Если ДанныеЗапроса["accompanyingDocuments"]["return"] <> Неопределено Тогда
			
			Если ДанныеЗапроса["accompanyingDocuments"]["return"]["contractPrice"] Тогда
				
				Цена = ЦенаДоговорная;	
				
			Иначе  
				
				Цена = "" + ДанныеЗапроса["accompanyingDocuments"]["return"]["price"] + " руб.";
				
			КонецЕсли;
			
			СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Возврат сопроводительных документов: " + Цена;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ДанныеЗапроса["notify"] <> Неопределено Тогда
		
		Если ДанныеЗапроса["notify"]["contractPrice"] Тогда
			
			Цена = ЦенаДоговорная;	
			
		Иначе  
			
			Цена = "" + ДанныеЗапроса["notify"]["price"] + " руб.";
			
		КонецЕсли;
		
		УслугаИнформацияОСтатусе = "Услуга 'Информация о статусе заказа': " + Цена;
		
	КонецЕсли;
	
	Если ДанныеЗапроса["packages"] <> Неопределено Тогда 
		
		Цена = 0;
		
		Для Каждого Упаковка Из ДанныеЗапроса["packages"] Цикл 						
			 
			Если НЕ Упаковка.Значение["contractPrice"] И ТипЗнч(Упаковка.Значение["price"]) = Тип("Число") Тогда				  			
				
				Цена = Цена + Упаковка.Значение["price"];
				
			КонецЕсли;    
			
		КонецЦикла;
		
		Если Цена > 0 Тогда
		
			СообщениеДетализация = СообщениеДетализация + Символы.ПС + "Упаковка: " + Цена + " руб."; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеДетализация) Тогда
		
		Результат.Вставить("Детализация", СокрЛП(СообщениеДетализация));
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(УслугаИнформацияОСтатусе) Тогда
		
		Результат.Вставить("УслугаИнформацияОСтатусе", УслугаИнформацияОСтатусе);
		
	КонецЕсли;
	
	Результат.Успешно = Истина;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьТерминалПоиском(ЭтоОтправка)
	
	Результат = Неопределено;
	
	ГородПоиска = ?(ЭтоОтправка, ОтправительГород, ПолучательГород);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("appKey");
	СтруктураЗапроса.Вставить("sessionID");
	СтруктураЗапроса.Вставить("code", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГородПоиска, "КодКЛАДР")); 
	СтруктураЗапроса.Вставить("direction", ?(ЭтоОтправка, "derival", "arrival")); 
	
	ДанныеТерминалы = ДЛ_ДеловыеЛинии.ПоискТерминалов(СтруктураЗапроса);
	
	Если ДанныеТерминалы["terminals"] <> Неопределено И ДанныеТерминалы["terminals"].Количество() > 0 Тогда
		
		НашлиПоУмолчанию = Ложь;
		
		Для Каждого НайденныйТерминал Из ДанныеТерминалы["terminals"] Цикл
			
			Если НайденныйТерминал["default"] = Истина Тогда
				
				НашлиПоУмолчанию = Истина;
				
				Результат = Справочники.ДЛ_Терминалы.НайтиПоРеквизиту("ИДтерминала", Строка(НайденныйТерминал["id"]));
				
				Прервать;
				
			КонецЕсли;			
			
		КонецЦикла;   
		
		Если Не НашлиПоУмолчанию Тогда
			
			Результат = Справочники.ДЛ_Терминалы.НайтиПоРеквизиту("ИДтерминала", Строка(ДанныеТерминалы["terminals"][0]["id"]));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

