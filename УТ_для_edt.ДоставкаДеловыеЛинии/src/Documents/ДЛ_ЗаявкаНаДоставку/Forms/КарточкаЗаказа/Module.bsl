	Таблица = ЭтаФорма[ИмяТаблицы];
	Таблица.Очистить();
	
	Попытка
		
		МассивЗначений = СтруктураДанных["Таблица_" + ИмяТаблицы]; 
		
	Исключение 
		
		Возврат;
		
	КонецПопытки;	
	
	Для Каждого ЭлементМассива Из МассивЗначений Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
		
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Процедура СохранитьЧерновик(Команда)
	
	СтруктураДокумета = СобратьСтруктуруДанныхДляШаблона();	
	СохранитьЧерновикНаСервере(СтруктураДокумета); 
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Черновик сохранен в разделе 'Неотправленные заказы'");
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьЧерновикНаСервере(СтруктураДокумета)	 
	
	Записать(); 
	
	МассивДокументовОснований = Новый Массив;
	
	Для Каждого СтрокаДокументыОснования Из Объект.ДокументыОснования Цикл   
		
		МассивДокументовОснований.Добавить(СтрокаДокументыОснования.Документ);
		
	КонецЦикла;
	
	СтруктураДокумета.Вставить("МассивДокументовОснований", МассивДокументовОснований);
	
	ЗаписьРегистра = РегистрыСведений.ДЛ_ДанныеЧерновиков.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Заявка = Объект.Ссылка;
	ЗаписьРегистра.Данные = Новый ХранилищеЗначения(СтруктураДокумета);   
	ЗаписьРегистра.Записать(Истина);	
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьИзЧерновика()
	
	ЗаписьРегистра = РегистрыСведений.ДЛ_ДанныеЧерновиков.СоздатьМенеджерЗаписи();
	ЗаписьРегистра.Заявка = Объект.Ссылка;
	ЗаписьРегистра.Прочитать();
	
	Если ЗначениеЗаполнено(ЗаписьРегистра.Заявка) Тогда
		
		СтруктураДокумета = ЗаписьРегистра.Данные.Получить();	
		
		ЗаполнитьДокументПоСтруктуреШаблона(СтруктураДокумета, 0);  
		
		ИзЧерновика = Истина;
		
		Объект.ДокументыОснования.Очистить();
		
		Для Каждого ЭлементМассива Из СтруктураДокумета["МассивДокументовОснований"] Цикл
			
			НоваяСтрока = Объект.ДокументыОснования.Добавить();
			НоваяСтрока.Документ = ЭлементМассива;
			
		КонецЦикла;		
		
	КонецЕсли; 	
	
КонецПроцедуры

