&НаКлиенте
Функция ПолучитьДанныеГруза()
	
	СтруктураВозврата = Новый Структура;
	
	ГрузМаксимальнаяДлинаМетры = ГрузМаксимальнаяДлина * КоэффициентЕдиницы(ЕдиницаДлина);
	ГрузМаксимальнаяШиринаМетры = ГрузМаксимальнаяШирина * КоэффициентЕдиницы(ЕдиницаШирина);
	ГрузМаксимальнаяВысотаМетры = ГрузМаксимальнаяВысота * КоэффициентЕдиницы(ЕдиницаВысота);
	
	//Проверка на превышение максимальных параметров
	
	ПревышениеДопустимыхПараметров = Ложь;
	ТекстПредупрежденияПревышенияПараметров = "Допустимые параметры: вес — не более 20000 кг, стороны (Д × Ш × В) не превышают 13,5 × 2,42 ×  2,45 м, объем  — не более 80 м^3";
	
	Если ГрузМаксимальнаяДлинаМетры > 13.5 Тогда
		ПревышениеДопустимыхПараметров = Истина;
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Текущая максимальная длина: " + ГрузМаксимальнаяДлинаМетры + " м."
	КонецЕсли;
	
	Если ГрузМаксимальнаяШиринаМетры > 2.42 Тогда
		ПревышениеДопустимыхПараметров = Истина;
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Текущая максимальная ширина: " + ГрузМаксимальнаяШиринаМетры + " м."
	КонецЕсли;
	
	Если ГрузМаксимальнаяВысотаМетры > 2.45 Тогда
		ПревышениеДопустимыхПараметров = Истина;	
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Текущая максимальная высота: " + ГрузМаксимальнаяВысотаМетры + " м."
	КонецЕсли;
	
	Если ГрузВес > 20000 Тогда
		ПревышениеДопустимыхПараметров = Истина;	
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Текущий вес: " + ГрузВес + " кг."
	КонецЕсли;
	
	Если ГрузОбъем > 80 Тогда
		ПревышениеДопустимыхПараметров = Истина;	
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Текущий объем: " + ГрузОбъем + " м^3"
	КонецЕсли;
	
    СтруктураВозврата.Вставить("ПревышениеДопустимыхПараметров",ПревышениеДопустимыхПараметров);
	Если ПревышениеДопустимыхПараметров Тогда
		ТекстПредупрежденияПревышенияПараметров = ТекстПредупрежденияПревышенияПараметров + Символы.ПС + "Параметры груза превышают параметры еврофуры. Для оформления заказа просьба связаться с менеджером по телефону +78124488888";	
   	 	СтруктураВозврата.Вставить("ТекстПредупрежденияПревышенияПараметров",ТекстПредупрежденияПревышенияПараметров);
	КонецЕсли;
	
	//Проверка на малогабаритный груз
	
	ЭтоМалогабаритныйГруз = Ложь;
	ТекстВопросаМалогабаритногоГруза = "";
	//ТекстВопросаМалогабаритногоГруза = "Параметры малогабаритного груза: вес — не более 30 кг, стороны (Д × Ш × В) не превышают 0,54 × 0,39 × 0,39 м, объем  — не более 0,1 м^3";
	
	Если ГрузМаксимальнаяДлинаМетры <= 0.54 и ГрузМаксимальнаяШиринаМетры <= 0.39 и ГрузМаксимальнаяВысотаМетры <= 0.39 и ГрузВес <= 30 и ГрузОбъем <= 0.1  и ГрузКоличествоГрузовыхМест = 1 Тогда
		ЭтоМалогабаритныйГруз = Истина;
		//ТекстВопросаМалогабаритногоГруза = ТекстВопросаМалогабаритногоГруза + Символы.ПС + "Текущие параметры (Д х Ш х В): " + ГрузМаксимальнаяДлинаМетры + " х " +  ГрузМаксимальнаяШиринаМетры + " х " + ГрузМаксимальнаяВысотаМетры
		//+ " м. Вес: " + ГрузВес + " кг. Объем: " + ГрузОбъем + " м^3";
	КонецЕсли;
	
	СтруктураВозврата.Вставить("ЭтоМалогабаритныйГруз",ЭтоМалогабаритныйГруз);	
	
	Если ЭтоМалогабаритныйГруз Тогда
		ТекстВопросаМалогабаритногоГруза = ТекстВопросаМалогабаритногоГруза + Символы.ПС + "Параметры груза соответствуют малогабаритному грузу. Рекомендуем изменить Вид доставки на Малогабаритный груз, чтобы снизить стоимость доставки.Изменить?";	
	    СтруктураВозврата.Вставить("ТекстВопросаМалогабаритногоГруза",ТекстВопросаМалогабаритногоГруза);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции // ()  

