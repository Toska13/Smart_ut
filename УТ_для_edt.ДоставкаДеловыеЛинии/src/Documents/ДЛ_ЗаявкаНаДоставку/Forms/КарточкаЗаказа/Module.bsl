&НаСервере 
Процедура ОчиститьГрафикПеревозки() 
	   
	Элементы.ГруппаГрафикПеревозки.Скрыть(); 
	
	ГруппаДинамическихЭлементовГрафика = Элементы.Найти("ГруппаДинамическихЭлементовГрафика");
	
	Если ГруппаДинамическихЭлементовГрафика <> Неопределено Тогда
		
		Элементы.Удалить(ГруппаДинамическихЭлементовГрафика); 		 		
		
	КонецЕсли;  
	
	ГруппаДинамическихЭлементовГрафика = Элементы.Добавить("ГруппаДинамическихЭлементовГрафика", Тип("ГруппаФормы"), Элементы.ГруппаГрафикПеревозки); 		
	ГруппаДинамическихЭлементовГрафика.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДинамическихЭлементовГрафика.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаДинамическихЭлементовГрафика.ОтображатьЗаголовок = Ложь; 
	ГруппаДинамическихЭлементовГрафика.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	
КонецПроцедуры  

&НаСервере 
Процедура ЗаполнитьГрафикПеревозки(ГрафикПеревозки)  
	
	Сч = 1;  
	
	КоличествоЗаписей = ГрафикПеревозки.Количество();
	
	Для Каждого Запись Из ГрафикПеревозки Цикл  
		
		ГруппаГрафика = Элементы.Добавить("ГруппаГрафика" + Сч, Тип("ГруппаФормы"), Элементы["ГруппаДинамическихЭлементовГрафика"]); 		
		ГруппаГрафика.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаГрафика.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаГрафика.ОтображатьЗаголовок = Ложь; 
		ГруппаГрафика.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;	
		
		КартинкаГрафик = ЭтаФорма.Элементы.Добавить("КартинкаТовара" + Сч, Тип("ДекорацияФормы"), ГруппаГрафика);
		КартинкаГрафик.Вид = ВидДекорацииФормы.Картинка;   
		
		Если Сч = 1 Тогда
			
			КартинкаГрафик.Картинка = БиблиотекаКартинок.ДЛ_График1; 
			
		ИначеЕсли Сч = КоличествоЗаписей Тогда 
			
			КартинкаГрафик.Картинка = БиблиотекаКартинок.ДЛ_График3;
			
		Иначе
			
			КартинкаГрафик.Картинка = БиблиотекаКартинок.ДЛ_График2;
			
		КонецЕсли;	   
		
		ЗначениеГрафикТекст1 = Новый ФорматированнаяСтрока(Формат(Запись.Значение, "ДФ='дд.ММ.гггг'"), Новый Шрифт(,, Истина));
		ЗначениеГрафикТекст2 = Символы.ПС + Запись.Представление;
		
		ЗначениеГрафик = ЭтаФорма.Элементы.Добавить("ЗначениеГрафик" + Сч, Тип("ДекорацияФормы"), ГруппаГрафика);
		ЗначениеГрафик.Вид = ВидДекорацииФормы.Надпись;
		ЗначениеГрафик.Заголовок = Новый ФорматированнаяСтрока(ЗначениеГрафикТекст1, ЗначениеГрафикТекст2);  
		
		Сч = Сч + 1;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДанныеПредварительногоРасчета(ДанныеЗапроса) 		
	
	Если ДанныеЗапроса["foundAddresses"] <> Неопределено И ДанныеЗапроса["foundAddresses"].Количество() > 0 Тогда 
		
		Элементы.ГруппаНайденныеАдреса.Видимость = Истина;
		Элементы.ГруппаНайденныйАдресОтправитель.Видимость = Ложь;
		Элементы.ГруппаНайденныйАдресПолучатель.Видимость = Ложь;  
		
		Для Каждого НайденныйАдрес Из ДанныеЗапроса["foundAddresses"] Цикл
			
			Если СтрНайти(НайденныйАдрес["field"], "derival") > 0 Тогда  
				
				Элементы.ГруппаНайденныйАдресОтправитель.Видимость = Истина;
				Элементы.днНайденныйАдресОтправитель.Заголовок = НайденныйАдрес["result"]; 
				
			ИначеЕсли СтрНайти(НайденныйАдрес["field"], "arrival") > 0 Тогда
				
				Элементы.ГруппаНайденныйАдресПолучатель.Видимость = Истина;
				Элементы.днНайденныйАдресПолучатель.Заголовок = НайденныйАдрес["result"];
				
			КонецЕсли; 			
			
		КонецЦикла;		 
		
	Иначе
		
		Элементы.ГруппаНайденныеАдреса.Видимость = Ложь;
		
	КонецЕсли; 	
	
	ВерхнийУровень = РезультатПредрасчета.ПолучитьЭлементы();  
	
	Для Каждого РезультатПоВидуДоставки Из ВерхнийУровень Цикл  
		
		Если ВидДоставки = РезультатПоВидуДоставки.ИД Тогда
			
			РезультатПоВидуДоставки.Выбрано = Истина; 				
			РезультатПоВидуДоставки.Сумма = ?(УпрощеннаяФормаЗаказа, "доступно", СтрокаСумма(ДанныеЗапроса["price"]));  
			
			Если Не УпрощеннаяФормаЗаказа Тогда 
			
				ЗаполнитьРасшифровкуРезультатаВыбранногоВидаДоставки(РезультатПоВидуДоставки.ПолучитьЭлементы(), ДанныеЗапроса); 
				
				ВидДоставкиДеревоИдентификатор = РезультатПоВидуДоставки.ПолучитьИдентификатор();
				
			КонецЕсли;	
			
		Иначе
			
			Если ДанныеЗапроса["availableDeliveryTypes"][РезультатПоВидуДоставки.ИД] = Неопределено Тогда
				
				РезультатПоВидуДоставки.Сумма = ?(УпрощеннаяФормаЗаказа, "не доступно", "-");
				
			Иначе 
				
				РезультатПоВидуДоставки.Сумма = ?(УпрощеннаяФормаЗаказа, "доступно", "от " + СтрокаСумма(ДанныеЗапроса["availableDeliveryTypes"][РезультатПоВидуДоставки.ИД]));	
				
			КонецЕсли;
			
		КонецЕсли;		
				
	КонецЦикла; 
	
	ОчиститьГрафикПеревозки();	
	
	ГрафикПеревозки = ДЛ_ДеловыеЛинии.ПрочитатьДанныеГрафикаПеревозки(ДанныеЗапроса["orderDates"], ?(СпособДоставки = 0, ДанныеЗапроса["deliveryTerm"], -1)); 
	
	ЗаполнитьГрафикПеревозки(ГрафикПеревозки);
	
КонецПроцедуры 

&НаСервере
Процедура СоздатьДокументВБазе(НомерЗаказа, Результат)     
	
	Объект.НомерЗаказа = НомерЗаказа; 	
		
	Записать();  
	
	РегистрЧерновиков = РегистрыСведений.ДЛ_ДанныеЧерновиков.СоздатьМенеджерЗаписи();
	РегистрЧерновиков.Заявка = Объект.Ссылка;
	РегистрЧерновиков.Удалить();
	
	Результат.Успешно = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатРасчетаИСозданияЗаказа(РезультатЗапроса, ПредварительныйРасчет, Результат = Неопределено)
	
	Если РезультатЗапроса["data"] <> Неопределено Тогда  
		
		Если ПредварительныйРасчет Тогда 			
			
			Элементы.ГруппаГрафикПеревозки.Видимость = Истина;  
			Элементы.ГруппаРазмещениеЗаказа.Видимость = Истина;
			Элементы.ГруппаПредрасчетОшибки.Видимость = Ложь;
			
			ВывестиДанныеПредварительногоРасчета(РезультатЗапроса["data"]);		
						
			Если ДоступностьОтправкиЗаказа = 1 Тогда
				
				ДоступностьОтправкиЗаказа = 2;	
				
			Конецесли;
			
		Иначе
			
			НомерЗаказа = СтрЗаменить(РезультатЗапроса["data"]["requestID"], Символы.НПП, "");
			
			СоздатьДокументВБазе(НомерЗаказа, Результат); 
			
			Если Результат.Успешно Тогда 			
				
				ОтправитьМетрикуРазмещенияЗаказа(НомерЗаказа);
				СохранитьАдресаВАдреснуюКнигу();
				
			КонецЕсли;
			
		КонецЕсли;		
		
	ИначеЕсли РезультатЗапроса["errors"] <> Неопределено Тогда
		
		ТаблицаОшибок = ЗаполнитьТаблицуОшибок(РезультатЗапроса["errors"]);		
		
		Если ПредварительныйРасчет Тогда
			
			УстановитьВидимостьЭлементовПриОшибкеПредварительногоРасчета();			
			
			ОшибкиПредрасчета = "";
			
			Для Каждого ОшибкаЗапроса Из ТаблицаОшибок Цикл
				
				ОшибкиПредрасчета = ОшибкиПредрасчета + СообщениеОбОшибкеЗаказа(ОшибкаЗапроса) + Символы.ПС + Символы.ПС;	
				
			КонецЦикла;  
			
			Элементы.днОшибкиПредрасчета.Заголовок = ОшибкиПредрасчета;			
			
		Иначе	
		
			Для Каждого ОшибкаЗапроса Из ТаблицаОшибок Цикл				
				
				ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибкеЗаказа(ОшибкаЗапроса)); 
				
			КонецЦикла; 
		
		КонецЕсли;
		
	Иначе
		
		ОшибкаЗапроса = "Ошибка выполнения запроса. Попробуйте еще раз";
		
		Если ПредварительныйРасчет Тогда  
			
			УстановитьВидимостьЭлементовПриОшибкеПредварительногоРасчета();
			
			Элементы.днОшибкиПредрасчета.Заголовок = ОшибкаЗапроса;			
			
		Иначе	
		
			ОбщегоНазначения.СообщитьПользователю(ОшибкаЗапроса);
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция РасчетИСозданиеЗаказа(ПредварительныйРасчет = Ложь, Мультизаказ = Ложь)	 
	
	Результат = Новый Структура("Успешно", Ложь);
	
	СтруктураПараметровЗаказа = Новый Структура;
	СтруктураПараметровЗаказа.Вставить("appkey");
	СтруктураПараметровЗаказа.Вставить("sessionID"); 
	
	Если Мультизаказ Тогда
		
		СтруктураПараметровЗаказа.Вставить("inOrder", Ложь);
		
	КонецЕсли;
	
	СтруктураПараметровЗаказа.Вставить("delivery", ЗаполнитьПараметрИнформацияОПреревозке(ПредварительныйРасчет));
	СтруктураПараметровЗаказа.Вставить("members", ЗаполнитьПараметрУчастникиПеревозки(ПредварительныйРасчет));
	СтруктураПараметровЗаказа.Вставить("cargo", ЗаполнитьПараметрСтруктураГруза());  
	СтруктураПараметровЗаказа.Вставить("payment", ЗаполнитьПараметрСруктураОплаты(ПредварительныйРасчет)); 
	СтруктураПараметровЗаказа.Вставить("productInfo", ЗаполнитьПараметрСтруктураИнформацияПоПродукту()); 
	
	Если ПредварительныйРасчет Тогда  
		
		Если ФайловыйВариант Тогда			
			
			РезультатЗапроса = ДЛ_ДеловыеЛинии.ПолучитьРасчетКалькулятораОформитьЗаказ(СтруктураПараметровЗаказа, "Калькулятор", Ложь);   
			
			ОбработатьРезультатРасчетаФайловыйВариант(РезультатЗапроса, Результат);
			
		Иначе
			
			ОчиститьРезультатПедрасчета(); 
			
			СтруктураПараметровЗаказа.appkey = ДЛ_ДеловыеЛинии.AppKey();
			СтруктураПараметровЗаказа.sessionID = ДЛ_ДеловыеЛинии.SessionID(); 
			
			Возврат ДлительныеОперации.ВыполнитьФункцию(ЭтаФорма.УникальныйИдентификатор, "ДЛ_ДеловыеЛинии.ПолучитьРасчетКалькулятораОформитьЗаказ", СтруктураПараметровЗаказа, "Калькулятор", Истина);		
			
		КонецЕсли;	
		
	Иначе
		
		ВремяРазмещенияЗаказа = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
		РезультатЗапроса = ДЛ_ДеловыеЛинии.ПолучитьРасчетКалькулятораОформитьЗаказ(СтруктураПараметровЗаказа, "РазмещениеЗаказа", Ложь);				
	
		ОбработатьРезультатРасчетаИСозданияЗаказа(РезультатЗапроса, Ложь, Результат);
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПредварительныйРасчет(Команда) 	  
	
	Если ЗначениеЗаполнено(ИдентификаторЗадания) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Элементы.ГруппаГрафикПеревозки.Видимость = Ложь; 
	Элементы.ГруппаНайденныеАдреса.Видимость = Ложь;
	Элементы.кнОбновлениеДанных.Видимость = Истина;
	Элементы.кнОбновитьДанныеПредрасчета.Видимость = Ложь;
	
	ДлительнаяОперация = РасчетИСозданиеЗаказа(Истина);		
	ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
	АдресРезультатаПредварительногоРасчета = ДлительнаяОперация.АдресРезультата; 
	
	ДоступностьОтправкиЗаказа = 1;
	УправлениеДоступностьюОтправкиЗаказа();
	
	ПодключитьОбработчикОжидания("ПроверитьГотовностьПредварительногоРасчета", 1, Ложь);  	
	
КонецПроцедуры 

&НаКлиенте	
Процедура ПредварительныйРасчетОкончание(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") И Результат.ОтправитьЗаказ = Истина Тогда  
		
		ОформитьЗаказ(Неопределено); 		
	
	ИначеЕсли Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("РазместитьДляМультизаказа") и Результат.РазместитьДляМультизаказа Тогда	
		
		РазместитьДляМультизаказа(Неопределено);	
		
	Иначе
		
		ИзменитьЗаказ(Неопределено);	
	
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПогрузочноРазгрузочныеРаботыПриИзменении(Элемент)
	
	Элементы.ГруппаОтгрузкаПогрузочноРазгрузочныеРаботы.Видимость = ОтгрузкаПогрузочноРазгрузочныеРаботы И СпособОтгрузки = 0;
	
	ЗаблокироватьОтправкуЗаказа(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ДоставкаПогрузочноРазгрузочныеРаботыПриИзменении(Элемент)
	
	Элементы.ГруппаДоставкаПогрузочноРазгрузочныеРаботы.Видимость = ДоставкаПогрузочноРазгрузочныеРаботы И СпособДоставки = 0;	
	
	ЗаблокироватьОтправкуЗаказа(); 
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПараметрВремя(ИдентификаторРеквизита)  

	Результат = Новый Структура;	
	Результат.Вставить("worktimeStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "С"], "ДФ='ЧЧ:мм'"));
	Результат.Вставить("worktimeEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "По"], "ДФ='ЧЧ:мм'"));
	
	Если ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"]) И 
		ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"]) Тогда
	
		Результат.Вставить("breakStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"], "ДФ='ЧЧ:мм'"));
		Результат.Вставить("breakEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"], "ДФ='ЧЧ:мм'"));
		
	КонецЕсли;	
	
	Результат.Вставить("exactTime", ЭтаФорма[?(ИдентификаторРеквизита = "Отгрузки", "Отправитель", "Получатель") + "ФиксированноеВремя"]);		
	
	Возврат Результат;
	
КонецФункции  

&НаСервере
Функция ЗаполнитьПараметрПогрузоРазгрузочныеРаботы(Префикс)  

	Результат = Новый Структура;
	Результат.Вставить("freightLift", ЭтаФорма[Префикс + "ПогрузочноРазгрузочныеРаботыЛифт"]);
	Результат.Вставить("toFloor", ЭтаФорма[Префикс + "ПогрузочноРазгрузочныеРаботыДоЭтажа"]);
	Результат.Вставить("carry", ЭтаФорма[Префикс + "ПогрузочноРазгрузочныеРаботыРасстояниеПроноса"]); 
	
	Плательщик = ЭтаФорма[Префикс + "ПогрузочноРазгрузочныеРаботыПлательщик"];   
	
	Если Плательщик = "Отправитель" Тогда 
		
		Результат.Вставить("payer", "sender");
		
	ИначеЕсли Плательщик = "Получатель" Тогда
		
		Результат.Вставить("payer", "receiver");	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрДополнительныеТребования(Префикс)
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ЭтаФорма[Префикс + "ДополнительныеТребованияТС"]) Тогда
		
		Результат.Добавить(ЭтаФорма[Префикс + "ДополнительныеТребованияТС"]);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

