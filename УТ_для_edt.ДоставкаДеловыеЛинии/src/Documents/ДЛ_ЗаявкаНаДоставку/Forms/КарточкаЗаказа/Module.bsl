Процедура УстановитьВидимостьНаложенногоПлатежа()            
	
	Элементы.НаложенныйПлатеж.Видимость = (НашаРольВПеревозке = "sender") 
		И (ПолучательКонтрагентЮрФизЛицо = 2) 
		И (ПлательщикРоль = 1 Или ПлательщикРоль = 2)
		И (ФормаОплатыПредставление = "cash");
	Элементы.грДекорацииНаложенныйПлатеж.Видимость = Элементы.НаложенныйПлатеж.Видимость;
	Элементы.днГруппаНаложенныПлатеж.Видимость = Элементы.НаложенныйПлатеж.Видимость;
	
	НаложенныйПлатеж = ?(Элементы.НаложенныйПлатеж.Видимость = Ложь, Ложь, НаложенныйПлатеж);	
	
	Элементы.грНаложенныйПлатеж.Видимость = НаложенныйПлатеж;
	
	Если НаложенныйПлатеж Тогда
		
		ПлательщикСогласиеНаПолучениеЭлектронногоЧека = Истина;		
		
	КонецЕсли;	
	
