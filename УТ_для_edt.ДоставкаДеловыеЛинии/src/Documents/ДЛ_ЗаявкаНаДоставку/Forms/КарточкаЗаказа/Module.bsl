				Сообщение = СтрЗаменить(ОшибкаЗаказа["detail"], "Характеристики груза превышают", "Высота превышает");	
				
			ИначеЕсли ПолеСОшибкой ="cargo.totalWeight" Тогда
				
				Сообщение = "Не заполнен Общий вес груза";	
				
			КонецЕсли;			 
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка упрощенной отправки" Тогда	
			
			Если ПолеСОшибкой = "delivery.accompanyingDocuments.accDoc.action" Тогда
				
				Сообщение = "Действия с Сопроводительными документами не доступны при выбранных параметрах доставки";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.phone" Тогда
				
				Сообщение = "Укажите номер телефона анонимного получателя в формате +7(9ХХ)ХХХХХХ";
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Упрощенная доставка не доступна вне территории РФ";	
				
			КонецЕсли;	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка наложенного платежа" Тогда
			
			Если ОшибкаЗаказа["detail"] = "Для получения разрешения на использование услуги необходимо обратиться к персональному менеджеру" Тогда
				
				Сообщение = "Для подключения услуги 'Наложенный платеж' обратитесь к вашему персональному менеджеру по телефону 8-800-100-8000.  Подробная информация об услуге - https://www.dellin.ru/articles/1146";
				
			Иначе
				
				Сообщение = ОшибкаЗаказа["detail"];	
				
			КонецЕсли;				 
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Не передан ни один из обязательных параметров" Тогда	
			
			Если ПолеСОшибкой = "members.receiver.dataForReceipt.phone" Тогда
				
				Сообщение = "В запросе должен присутствовать хотя бы один параметр Телефон, Email для электронного чека";
				
			ИначеЕсли ПолеСОшибкой = "length" Или ПолеСОшибкой = "width" Или ПолеСОшибкой = "height" Тогда	
				
				Сообщение = "В запросе должен присутствовать хотя бы один параметр из: Длина, Ширина, Высота";
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка параметров оплаты" Тогда
			
			Если ОшибкаЗаказа["detail"] = "Не допускается указание более двух плательщиков" Тогда
				
				Сообщение = "Не допускается указание более двух плательщиков";				
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка выполнения запроса" 
		Или ОшибкаЗаказа["title"] = "Указан некорректный документ, удостоверяющий личность" Тогда 
		
		Сообщение = ОшибкаЗаказа["detail"];
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сообщение) Тогда 
		
		Сообщение = СтрШаблон("Ошибка: %1
			|Описание: %2
			|Поле запроса: %3",
			ОшибкаЗаказа["title"],
			ОшибкаЗаказа["detail"],
			ПолеСОшибкой);		
		
	КонецЕсли; 	 
	
	Возврат "• " + Сообщение; 
	
КонецФункции  	

&НаКлиенте
Процедура ОтправительАдресНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораАдреса("Отправитель");
	
КонецПроцедуры 
                                                                   
&НаКлиенте
Процедура ОткрытьФормуВыбораАдреса(Префикс)
	
	ИмяРеквизитаАдреса = Префикс + "Адрес";	
	
	ДополнительныеПараметры = Новый Структура;	
	ДополнительныеПараметры.Вставить("ИмяРеквизитаАдреса", ИмяРеквизитаАдреса);
	
	Оповещение = Новый ОписаниеОповещения("ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение", 
		ЭтаФорма, ДополнительныеПараметры);
	
	ВидКонтактнойИнформации = Новый Структура;
	ВидКонтактнойИнформации.Вставить("Тип", ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.Адрес"));
	ВидКонтактнойИнформации.Вставить("ТолькоНациональныйАдрес", Ложь);
	ВидКонтактнойИнформации.Вставить("ВключатьСтрануВПредставление", Ложь);
	ВидКонтактнойИнформации.Вставить("СкрыватьНеактуальныеАдреса", Ложь);
	
	ПараметрыФормыКонтактнойИнформации = УправлениеКонтактнойИнформациейКлиент.ПараметрыФормыКонтактнойИнформации(
		ВидКонтактнойИнформации,
		ЭтаФорма[ИмяРеквизитаАдреса + "Значение"],
		ЭтаФорма[ИмяРеквизитаАдреса + "Представление"]);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормыКонтактнойИнформации,, Оповещение);
	
КонецПроцедуры   

&НаКлиенте	
Процедура ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда  
		
		Возврат; 
		
	КонецЕсли;
	
	ИмяРеквизитаАдреса = ДополнительныеПараметры.ИмяРеквизитаАдреса;
	
	ЭтаФорма[ИмяРеквизитаАдреса + "Представление"] = Результат.Представление;
	ЭтаФорма[ИмяРеквизитаАдреса + "Значение"] = Результат.Значение; 
	
	ЗаполнитьНаселенныйПунктПоАдресу1С(СтрЗаменить(ИмяРеквизитаАдреса, "Адрес", ""));
	
	ЗаблокироватьОтправкуЗаказа();

