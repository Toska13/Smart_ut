	СписокВыбора.Добавить(1, "Совпадает с отправителем");
	СписокВыбора.Добавить(2, "Совпадает с получателем");
	СписокВыбора.Добавить(3, "Третье лицо"); 
	
	ОО = Новый ОписаниеОповещения("ПлательщикРольНачалоВыбораЗавершение", ЭтаФорма);  
	
	СписокВыбора.ПоказатьВыборЭлемента(ОО, "Выберите роль плательщика");
	
