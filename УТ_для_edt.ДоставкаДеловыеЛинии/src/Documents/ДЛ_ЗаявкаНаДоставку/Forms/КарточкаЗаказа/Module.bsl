Процедура ДополнительныеУслугиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаСервере
Функция  ЗаполнитьПараметрДополнительныеУслуги()
	
	Результат = Новый Массив; 	
	
	ПлательщикДополнительныхУслугОтличается = Ложь;
	
	Если ДополнительныеУслугиПлательщик = "Отправитель" Тогда
		
		ПлательщикДополнительныхУслугОтличается = Истина;
		Плательщик = "sender";
		
	ИначеЕсли ДополнительныеУслугиПлательщик = "Получатель" Тогда  
		
		ПлательщикДополнительныхУслугОтличается = Истина;
		Плательщик = "receiver"
		
	КонецЕсли;
	
	Для Каждого ДополнительнаяУслуга Из ДополнительныеУслуги Цикл
		
		Если ДополнительнаяУслуга.Использовать Тогда
			
			СтруктураУслуги = Новый Структура;
			СтруктураУслуги.Вставить("uid", ДополнительнаяУслуга.Услуга.UID); 
			СтруктураУслуги.Вставить("count", ДополнительнаяУслуга.Количество); 
			
			Если ПлательщикДополнительныхУслугОтличается Тогда
				
				СтруктураУслуги.Вставить("payer", Плательщик);	
				
			КонецЕсли;
			
			Результат.Добавить(СтруктураУслуги);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция  ЗаполнитьПараметрСопроводительныеДокументы()
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(СопроводительныеДокументы) Тогда
		
		Если СопроводительныеДокументы = "both" Тогда 
			
			Если ЗначениеЗаполнено(СопроводительныеДокументыПлательщик) Тогда
				
				Результат.Добавить(Новый Структура("action, payer", "send", СопроводительныеДокументыПлательщик));
				Результат.Добавить(Новый Структура("action, payer", "return", СопроводительныеДокументыПлательщик));	
				
			Иначе
			
				Результат.Добавить(Новый Структура("action", "send"));
				Результат.Добавить(Новый Структура("action", "return"));
			
			КонецЕсли;
			
		Иначе 
			
			Если ЗначениеЗаполнено(СопроводительныеДокументыПлательщик) Тогда 
				
				Результат.Добавить(Новый Структура("action, payer", СопроводительныеДокументы, СопроводительныеДокументыПлательщик));
				
			Иначе	
			
				Результат.Добавить(Новый Структура("action", СопроводительныеДокументы));
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрИнформацияОПреревозке(ПредварительныйРасчет) 		
	
	Результат = Новый Структура;	
	Результат.Вставить("deliveryType", Новый Структура("type", ВидДоставки)); 
	Результат.Вставить("derival", ПолучитьСтруктуруОтправленияПолучение("Отправитель"));
	Результат.Вставить("arrival", ПолучитьСтруктуруОтправленияПолучение("Получатель")); 	
	Результат.Вставить("packages", ЗаполнитьПараметрДополнительныеУслуги());
	Результат.Вставить("accompanyingDocuments", ЗаполнитьПараметрСопроводительныеДокументы());  
	
	Если ЗначениеЗаполнено(ДополнительнаяИнформация) Тогда
	
		Результат.Вставить("comment", Лев(СокрЛП(ДополнительнаяИнформация), 500));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруОтправленияПолучение(Префикс) 
	
	Результат = Новый Структура; 
	
	Если Префикс = "Отправитель" Тогда
		
		Результат.Вставить("produceDate", Формат(ДатаОтгрузки, "ДФ='гггг-ММ-дд'"));  
		
		Идентификатор1 = "Отгрузки";
		Идентификатор2 = "Отгрузка";
		
	Иначе  
		
		Идентификатор1 = "Доставки";
		Идентификатор2 = "Доставка";		
		
	КонецЕсли;  
	
	Если Этаформа["Способ" + Идентификатор1] = 0 Тогда
		
		Результат.Вставить("variant", "address"); 
		Результат.Вставить("address", Новый Структура("search", ЭтаФорма[Префикс + "АдресПредставление"])); 		
		Результат.Вставить("time", ЗаполнитьПараметрВремя(Идентификатор1)); 
		Результат.Вставить("requirements", ЗаполнитьПараметрДополнительныеТребования(Идентификатор2));
		
		Если ЭтаФорма[Идентификатор2 + "ПогрузочноРазгрузочныеРаботы"] Тогда
			
			Результат.Вставить("handling", ЗаполнитьПараметрПогрузоРазгрузочныеРаботы(Идентификатор2));	
			
		КонецЕсли; 		
		
	ИначеЕсли Этаформа["Способ" + Идентификатор1] = 1 Тогда 
		
		Результат.Вставить("variant", "terminal"); 
		Результат.Вставить("terminalID", ЭтаФорма[Префикс + "Терминал"].ИДтерминала);
		
	КонецЕсли;
	
	Если ИспользоватьРазличныхПлательщиков И 
		Не (Префикс = "Отправитель" И СпособОтгрузки = 1) Тогда
	
		Если ЭтаФорма[Префикс + "ПлательщикРоль"] = 1 Тогда
			
			Результат.Вставить("payer", "sender"); 
			
		ИначеЕсли ЭтаФорма[Префикс + "ПлательщикРоль"] = 2 Тогда 
			
			Результат.Вставить("payer", "receiver");
			
		ИначеЕсли ЭтаФорма[Префикс + "ПлательщикРоль"] = 3 Тогда
			
			Результат.Вставить("payer", "third"); 
			
		КонецЕсли;	
	
	КонецЕсли;
	
	Возврат Результат;	 
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрСтруктураГруза()  	 
	
	Результат = Новый Структура;  
	
	Если УпрощеннаяФормаЗаказа Тогда 
		
		МинВГХ = ПолучитьМинимальныеЗначенияВГХ();					
		
		Результат.Вставить("length", МинВГХ.МинимальнаяДлина);
		Результат.Вставить("width", МинВГХ.МинимальнаяШирина);
		Результат.Вставить("height", МинВГХ.МинимальнаяВысота);
		Результат.Вставить("weight", МинВГХ.МинимальныйВес);
		Результат.Вставить("totalVolume", МинВГХ.МинимальныйОбъем);
		Результат.Вставить("totalWeight", МинВГХ.МинимальныйВес);
		Результат.Вставить("oversizedWeight", 0);
		Результат.Вставить("oversizedVolume", 0); 
		Результат.Вставить("insurance",  Новый Структура("statedValue", ?(ЗначениеЗаполнено(ГрузСтоимость), ГрузСтоимость, 1000)));		
		
	Иначе	
		
		Результат.Вставить("length", ГрузМаксимальнаяДлина * КоэффициентЕдиницы(ЕдиницаДлина));
		Результат.Вставить("width", ГрузМаксимальнаяШирина * КоэффициентЕдиницы(ЕдиницаШирина));
		Результат.Вставить("height", ГрузМаксимальнаяВысота * КоэффициентЕдиницы(ЕдиницаВысота));
		Результат.Вставить("weight", ГрузМаксимальныйВес);
		Результат.Вставить("totalVolume", ГрузОбъем);
		Результат.Вставить("totalWeight", ГрузВес);
		Результат.Вставить("oversizedWeight", ГрузНегабаритныйВес);
		Результат.Вставить("oversizedVolume", ГрузНегабаритныйОбъем); 
		
		Если ЗначениеЗаполнено(ГрузСтоимость) Тогда
		
			Результат.Вставить("insurance",  Новый Структура("statedValue", ГрузСтоимость));
			
		КонецЕсли;	
		
	КонецЕсли; 
	
	Результат.Вставить("freightUID", ХарактерГруза.UID);
	Результат.Вставить("quantity", ГрузКоличествоГрузовыхМест);
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрСтруктураИнформацияПоПродукту()  	 
	
	Результат = Новый Структура;
	Результат.Вставить("type", 7);
