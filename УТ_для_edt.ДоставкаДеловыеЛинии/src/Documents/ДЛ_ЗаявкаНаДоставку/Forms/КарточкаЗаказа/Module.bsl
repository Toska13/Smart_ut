	Если ПараметрыТекущейВерсии.Свойство("Версия") Тогда
		
		Массивinfo.Добавить(Новый Структура("param, value","module version", Лев(ПараметрыТекущейВерсии.Идентификатор, 1) + "_" + ПараметрыТекущейВерсии.Версия));	
		
	КонецЕсли;
	
	Результат.Вставить("info", Массивinfo); 
	
