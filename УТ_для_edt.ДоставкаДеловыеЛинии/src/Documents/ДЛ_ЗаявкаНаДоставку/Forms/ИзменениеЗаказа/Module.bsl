КонецПроцедуры  

&НаСервере
Процедура ОбработатьОшибки(Ошибки, ИмяГруппы = "")
	
	Если Ошибки = Неопределено Тогда 
		
		Если ЗначениеЗаполнено(ИмяГруппы) Тогда		
			
			Элементы[ИмяГруппы].Видимость = Ложь;			
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Запрос успешно отправлен"); 		
		
	Иначе      
		
		Если ТипЗнч(Ошибки) = Тип("Массив") Тогда
			
			Для Каждого Ошибка Из Ошибки Цикл			
		
				ВывестиСообщениеОбОшибке(Ошибка);
				
			КонецЦикла;	
			
		ИначеЕсли ТипЗнч(Ошибки) = Тип("Строка") Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Ошибки);				
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры	   


&НаСервере
Процедура ВывестиСообщениеОбОшибке(Ошибка) 
	
	Сообщение = "";  
	
	Если ТипЗнч(Ошибка["fields"]) = Тип("Массив") И Ошибка["fields"].Количество() > 0 Тогда
		
		ПолеСОшибкой = Ошибка["fields"][0];	
		
		Если Ошибка["title"] = "Отсутствует обязательный параметр" Тогда 
			
			Если ПолеСОшибкой = "receiver.counteragent.form" Или ПолеСОшибкой = "receiver.counteragent.name" Тогда
				
				Сообщение = "Не заполнен получатель";	
				
			ИначеЕсли ПолеСОшибкой = "receiver.counteragent.inn" Тогда
				
				Сообщение = "Не заполнен ИНН получателя";
				
			ИначеЕсли ПолеСОшибкой = "receiver.contactPersons.contactPerson.name" Тогда
				
				Сообщение = "Не заполнено контактное лицо получателя";	 
				
			ИначеЕсли ПолеСОшибкой = "receiver.phoneNumbers" Тогда
				
				Сообщение = "Не заполнены контактные телефоны получателя";	
				
			КонецЕсли;
			
		ИначеЕсли Ошибка["title"] = "По данному заказу изменение получателя недоступно" Тогда 
			
			Сообщение = Ошибка["title"]; 
			
		ИначеЕсли Ошибка["title"] = "Ошибка выполнения запроса" Тогда
			
			Если ПолеСОшибкой = "members.receiver" Тогда
				
				Сообщение = "Невозможно внести изменения Получателя";
				
			КонецЕсли;	
			
		ИначеЕсли Ошибка["title"] = "По данному заказу отмена доставки груза до адреса недоступна" 
			Или Ошибка["title"] = "Указан некорректный документ, удостоверяющий личность" Тогда 
			
			Сообщение = Ошибка["detail"];
			
		ИначеЕсли Ошибка["title"] = "Недопустимое значение параметра" Тогда
			
			Если ПолеСОшибкой = "address.search" Тогда
				
				Сообщение = "Смена адреса отправки возможна только в пределах указанного ранее региона";

			КонецЕсли;
			
		ИначеЕсли Ошибка["title"] = "Неверный формат параметра" Тогда  
			
			Если ПолеСОшибкой = "members.sender.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Укажите номер телефона Отправителя в формате +79XXXXXXXXX";							
				
			КонецЕсли;	
			
		ИначеЕсли Ошибка["title"] = "Ошибка типизации" Тогда
			
			Если ПолеСОшибкой = "members.sender.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Убедитесь, что в номере телефона Отправителя не больше 15 символов.";							
				
			КонецЕсли;
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сообщение) Тогда 
		
		Сообщение = СтрШаблон("Ошибка: %1
			|Описание: %2
			|Поле запроса: %3",
			Ошибка["title"],
			Ошибка["detail"],
			ПолеСОшибкой);		
		
	КонецЕсли; 
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
	
КонецПроцедуры  	

