&НаСервере
Функция ЗаполнитьПараметрВремя(ИдентификаторРеквизита)  

	Результат = Новый Структура;	
	Результат.Вставить("worktimeStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "С"], "ДФ='ЧЧ:мм'"));
	Результат.Вставить("worktimeEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "По"], "ДФ='ЧЧ:мм'"));
	
	Если ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"]) И 
		ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"]) Тогда
	
		Результат.Вставить("breakStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"], "ДФ='ЧЧ:мм'"));
		Результат.Вставить("breakEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"], "ДФ='ЧЧ:мм'"));
		
	КонецЕсли;	
	
	Результат.Вставить("exactTime", ЭтаФорма[?(ИдентификаторРеквизита = "Отгрузки", "Отправитель", "Получатель") + "ФиксированноеВремя"]);		
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Процедура ИзменитьПараметрыДоставкиНаСервере()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("appkey");
	СтруктураПараметров.Вставить("sessionID");
	СтруктураПараметров.Вставить("orderID", НомерЗаказа);	  	
	СтруктураПараметров.Вставить("members", Новый Структура("requester", Новый Структура("role", ИнициаторИзмененийДоставки)));  
	
	Если ИнициаторИзмененийДоставки = "sender" Тогда  
		
		СтруктураПараметров.Вставить("storePayer", ОтветственныйЗаХранение);
		
	КонецЕсли;
	
	СтруктураИзменяемыхПараметров = Новый Структура; 
	СтруктураИзменяемыхПараметров.Вставить("variant", ?(ДоставкаДоАдреса, "address", "terminal"));
	
	Если ДоставкаДоАдреса Тогда 
		
		СтруктураИзменяемыхПараметров.Вставить("address", Новый Структура("search", ПолучательАдресПредставление));	  
		
		Если ЗначениеЗаполнено(ВремяДоставкиС) И ЗначениеЗаполнено(ВремяДоставкиПо) Тогда 
		
			СтруктураИзменяемыхПараметров.Вставить("time", ЗаполнитьПараметрВремя("Доставки"));  
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаДоставки) Тогда
			
			СтруктураИзменяемыхПараметров.Вставить("produceDate", Формат(ДатаДоставки, "ДФ='гггг-ММ-дд'"));				
			
		КонецЕсли;
		
	Иначе    
		
		СтруктураИзменяемыхПараметров.Вставить("terminalID", Число(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПолучательТерминал, "ИДтерминала")));
		
	КонецЕсли; 	
	
	СтруктураПараметров.Вставить("delivery", Новый Структура("arrival", СтруктураИзменяемыхПараметров));  
	
	Результат = ДЛ_ДеловыеЛинии.ИзменитьПараметрыДоставки(СтруктураПараметров);
	
	ОбработатьОшибки(Результат["errors"], "грАдресВремяДоставки");
	
КонецПроцедуры

