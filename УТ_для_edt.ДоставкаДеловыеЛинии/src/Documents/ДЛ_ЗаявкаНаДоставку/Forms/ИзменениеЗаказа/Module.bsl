&НаСервере
Процедура ОтменаОтправкиДоставкиНаСервере(ИмяМетода, Префикс, ИмяГруппы) 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("appkey");
	СтруктураПараметров.Вставить("sessionID");
	СтруктураПараметров.Вставить("orderID", НомерЗаказа);	
	СтруктураПараметров.Вставить("requester", РольОтменяющего);
	
	Если РольОтменяющего = "customer" Тогда
		
		ДобавитьКонтактноеЛицоИТелефоны(СтруктураПараметров, Префикс); 
		
	КонецЕсли;	
	
	Результат = ДЛ_ДеловыеЛинии.ОтменаОтправкиДоставкиНаСервере(СтруктураПараметров, ИмяМетода);
	
	ОбработатьОшибки(Результат["errors"], ИмяГруппы);
	
КонецПроцедуры   

&НаСервере
Процедура ДобавитьКонтактноеЛицоИТелефоны(СтруктураПараметров, Префикс)
	
	КонтактныеЛица = Новый Массив;
	КонтактныеЛица.Добавить(Новый Структура("name", ЭтотОбъект[Префикс + "КонтактноеЛицоНаименование"])); 	  
	
	Телефоны = Новый Массив;  
	
	МассивТелефонов = СтрРазделить(ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонПредставление"], ";");
	ТелефоновДобавлено = 0;
	
	Для Каждого НомерТелефона Из МассивТелефонов Цикл
		
		Если ТелефоновДобавлено = 3 Тогда
			
			Прервать;
			
		КонецЕсли;
		
		НомерТелефонаОчищенный = ТолькоЦифры(НомерТелефона);
		
		Если ЗначениеЗаполнено(НомерТелефонаОчищенный) Тогда
			
			Телефоны.Добавить(Новый Структура("number", НомерТелефонаОчищенный));  
			
			ТелефоновДобавлено = ТелефоновДобавлено + 1;	
			
		КонецЕсли;
		
	КонецЦикла; 
	
	СтруктураПараметров.Вставить("contactPersons", КонтактныеЛица);
	СтруктураПараметров.Вставить("phoneNumbers", Телефоны); 	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТолькоЦифры(Знач СтрокаДляПроверки)
	
	ЛишниеСимволы = СтрСоединить(СтрРазделить(СтрокаДляПроверки, "0123456789"), "");
	Результат     = СтрСоединить(СтрРазделить(СтрокаДляПроверки, ЛишниеСимволы), "");
	
	Возврат Результат;
	
КонецФункции

