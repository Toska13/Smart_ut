
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  	
	
	Параметры.Свойство("НомерЗаказа", НомерЗаказа); 
	Параметры.Свойство("ОтправительКонтактноеЛицоНаименование", ОтправительКонтактноеЛицоНаименование);
	Параметры.Свойство("ОтправительКонтактноеЛицоТелефонПредставление", ОтправительКонтактноеЛицоТелефонПредставление); 
	Параметры.Свойство("ДоставкаДоАдреса", ДоставкаДоАдреса);
	
	Если Не ЗначениеЗаполнено(НомерЗаказа) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не передан номер заказа");
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
	Элементы.грПолучатель.Видимость = Параметры.Свойство("Получатель"); 
	Элементы.грПлательщик.Видимость = Параметры.Свойство("Плательщик");
	Элементы.грКонтактнаяИнформацияОтправитель.Видимость = Параметры.Свойство("КонтактнаяИнформацияОтправитель");
	Элементы.грКонтактнаяИнформацияПолучатель.Видимость = Параметры.Свойство("КонтактнаяИнформацияПолучатель");
	Элементы.грАдресВремяЗабора.Видимость = Параметры.Свойство("АдресВремяЗабора");
	Элементы.грАдресВремяДоставки.Видимость = Параметры.Свойство("АдресВремяДоставки");
	Элементы.грПриостановка.Видимость = Параметры.Свойство("Приостановка");
	Элементы.грВозобновление.Видимость = Параметры.Свойство("Возобновление");
	Элементы.грОтменаЗабора.Видимость = Параметры.Свойство("ОтменаЗабора");
	Элементы.грОтменаДоставки.Видимость = Параметры.Свойство("ОтменаДоставки"); 
	
	Если Элементы.грАдресВремяДоставки.Видимость Тогда
		
		Элементы.ПолучательАдрес.Видимость = ДоставкаДоАдреса;
		Элементы.ПолучательВремяПлановойДоставки.Видимость = ДоставкаДоАдреса; 
		Элементы.ПолучательДатаПлановойДоставки.Видимость = ДоставкаДоАдреса;
		Элементы.ПолучательТерминал.Видимость = Не ДоставкаДоАдреса;
		
	КонецЕсли;
	
	Если Элементы.грПриостановка.Видимость Тогда
		
		Элементы.ИнформацияПриостановка.Заголовок = Параметры.Приостановка;
		
	КонецЕсли; 
	
	Если Элементы.грВозобновление.Видимость Тогда
		
		Элементы.ИнформацияВозобновление.Заголовок = Параметры.Возобновление;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ПолучательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ПолучательКонтрагентСсылка");	
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозки(УчастникГрузоперевозки)
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.Добавить("Организация", 	"Справочник: Организации"); 
	СписокВыбора.Добавить("Контрагент",		"Справочник: Контрагенты");	 
	
	ОО = Новый ОписаниеОповещения("НачалоВыбораУчастникаГрузоперевозкиПродолжить", ЭтаФорма, УчастникГрузоперевозки);  
	
	СписокВыбора.ПоказатьВыборЭлемента(ОО, "Выберите способ заполнения данных");	
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозкиПродолжить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ИмяРеквизита = СтрЗаменить(ДополнительныеПараметры, "Ссылка", ""); 
		ИмяРеквизитаИНН = ИмяРеквизита + "ИНН"; 
		
		Если Результат.Значение = "Вручную" Тогда	
			
			Элементы[ИмяРеквизитаИНН].ТолькоПросмотр = Ложь;
			Элементы[ИмяРеквизита].РедактированиеТекста = Истина; 
			Элементы[ИмяРеквизита].КнопкаОткрытия = Ложь; 
			ЭтотОбъект[ДополнительныеПараметры] = Неопределено;
			
		Иначе  
			
			Элементы[ИмяРеквизитаИНН].ТолькоПросмотр = Истина;
			Элементы[ИмяРеквизита].РедактированиеТекста = Ложь;
			Элементы[ИмяРеквизита].КнопкаОткрытия = Истина;
			
			ПараметрыОткрытия = Новый Структура;			
			ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
			
			ОО = Новый ОписаниеОповещения("ОбработатьВыборЗначения", ЭтотОбъект, ДополнительныеПараметры);
			
			Если Результат.Значение = "Организация" Тогда 
				
				ИмяФормыВыбора = "Справочник.Организации.ФормаВыбора";				
				
			ИначеЕсли Результат.Значение = "Контрагент" Тогда
				
				ИмяФормыВыбора = "Справочник.Контрагенты.ФормаВыбора";
				
			Иначе
				
				Возврат;
				
			КонецЕсли; 
			
			ОткрытьФорму(ИмяФормыВыбора, ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЗначения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Или
		(ТипЗнч(Результат) = Тип("КодВозвратаДиалога")
		И Результат = КодВозвратаДиалога.Отмена) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда	
		
		ЭтотОбъект[ДополнительныеПараметры] = Результат;
		
		ОбработатьИзменениеРеквизитаФормы(ДополнительныеПараметры);
		
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРеквизитаФормы(ИмяРеквизита)
	
	Отказ = Ложь;
	ОбработатьИзменениеРеквизитаФормыНаСервере(ИмяРеквизита, Отказ);			
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеРеквизитаФормыНаСервере(ИмяРеквизита, Отказ = Ложь)
	
	Модифицированность = Истина;
	
	Если ИмяРеквизита = "ОтправительКонтрагентСсылка" 
		ИЛИ ИмяРеквизита = "ПолучательКонтрагентСсылка"
		ИЛИ ИмяРеквизита = "ПлательщикКонтрагентСсылка" Тогда
		
		ПараметрыУчастника = ПараметрыУчастникаГрузоперевозки(ЭтотОбъект[ИмяРеквизита]);		
		
		ОбработатьПараметры(ПараметрыУчастника, СтрЗаменить(ИмяРеквизита, "КонтрагентСсылка", ""));							
					
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьПараметры(Параметры, Префикс = "")
	
	ПараметрыДляФормы = Новый Структура;
	
	ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, ПараметрыДляФормы, Префикс);		
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыДляФормы);	 
	
	ЭтотОбъект[Префикс + "КонтактноеЛицоНаименование"] = "";
	ЭтотОбъект[Префикс + "КонтактноеЛицоТелефонПредставление"] = "";
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, Данные, Префикс = "") Экспорт
	
	Для Каждого Параметр Из Параметры Цикл 
		
		ИмяКолонки = Префикс + Параметр.Ключ; 
		
		Если ТипЗнч(Параметр.Значение) = Тип("Структура") Тогда  
			
			ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметр.Значение, Данные, ИмяКолонки);
			
		Иначе  
			
			Данные.Вставить(ИмяКолонки, Параметры[Параметр.Ключ]); 
			
		КонецЕсли;  
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НовыйПараметрыУчастникаГрузоперевозки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Контрагент", НовыйПараметрыКонтрагента());	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПараметрыУчастникаГрузоперевозки(Значение)
	
	ПараметрыУчастника = НовыйПараметрыУчастникаГрузоперевозки();
	
	ПараметрыУчастника.Контрагент = ПараметрыКонтрагента(Значение);		
		
	Возврат ПараметрыУчастника;
	
КонецФункции  

&НаСервереБезКонтекста
Функция ПараметрыКонтрагента(Значение)
	
	ПараметрыКонтрагента = НовыйПараметрыКонтрагента();
	ПараметрыКонтрагента.Ссылка = Значение;
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента);		
		
	КонецЕсли;
	
	Возврат ПараметрыКонтрагента;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента) Экспорт
	
	ИмяСправочника = Неопределено;
	Если ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		ИмяСправочника = "Организации";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеСокращенное";
		ПараметрыКонтрагента.ЭтоОрганизация = Истина;
	ИначеЕсли ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		ИмяСправочника = "Контрагенты";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеПолное";
		ПараметрыКонтрагента.ЭтоОрганизация = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ОсновнаяТаблица.Ссылка КАК Ссылка,
	               |	ОсновнаяТаблица.ИНН КАК ИНН,
	               |	ОсновнаяТаблица.КПП КАК КПП,
	               |	&РеквизитНаименования КАК Наименование,
	               |	ВЫБОР
	               |		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |			ТОГДА 1
	               |		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	               |			ТОГДА 2
	               |		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
	               |			ТОГДА 3
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ЮрФизЛицо
	               |ИЗ
	               |	&ТаблицаДляЗапроса КАК ОсновнаяТаблица
	               |ГДЕ
	               |	ОсновнаяТаблица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыКонтрагента.Ссылка);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДляЗапроса", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитНаименования", РеквизитНаименования);
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда  
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтрагента, РезультатЗапроса.Выгрузить()[0]);		
		
		Если ПараметрыКонтрагента.ЮрФизЛицо <> 2 Тогда
			
			ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
			
			ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйПараметрыКонтрагента() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("ЮрФизЛицо", 0);
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("ЮридическийАдресПредставление", "");
	Результат.Вставить("ЭтоОрганизация", Ложь);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучательОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтрагентОткрытие(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОткрытие(Элемент)
	
	ИмяРеквизита = Элемент.Имя + "Ссылка";
	ИмяРеквизитаЭтоОрганизация = Элемент.Имя + "ЭтоОрганизация";
	
	ЗначениеРеквизита = ЭтотОбъект[ИмяРеквизита];
	ЭтоОрганизация = ЭтотОбъект[ИмяРеквизитаЭтоОрганизация];
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда  
		
		ПараметрыОткрытия = Новый Структура("Ключ", ЭтотОбъект[ИмяРеквизита]);
		ОО = Новый ОписаниеОповещения("ОбработатьИзменениеРеквизитовОбъекта", ЭтотОбъект, ИмяРеквизита);		
		
		Если ЭтоОрганизация Тогда
			
			ИмяФормыКонтрагента = "Справочник.Организации.ФормаОбъекта"; 
			
		Иначе                                                      
			
			ИмяФормыКонтрагента = "Справочник.Контрагенты.ФормаОбъекта";
			
		КонецЕсли; 	
		
		ОткрытьФорму(ИмяФормыКонтрагента, ПараметрыОткрытия, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательКонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтактноеЛицоНачалоВыбора(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактноеЛицоНачалоВыбора(ИмяРеквизита) 
	
	ИмяРеквизитаКонтрагента = СтрЗаменить(ИмяРеквизита, "КонтактноеЛицо", "КонтрагентСсылка"); 
	
	ТипКонтрагента = ТипЗнч(ЭтотОбъект[ИмяРеквизитаКонтрагента]); 
	
	ОО = Новый ОписаниеОповещения("ВыборКонтактноеЛицоЗавершение", ЭтаФорма, ИмяРеквизита); 
	
	ПараметрыОткрытия = Новый Структура;			
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
	
	Если ТипКонтрагента = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ПараметрыОтбора = Новый Структура("Владелец", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ЭтотОбъект[ИмяРеквизитаКонтрагента], "Партнер"));
		
		ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
		
		ОткрытьФорму("Справочник.КонтактныеЛицаПартнеров.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
		
	ИначеЕсли ТипКонтрагента = Тип("СправочникСсылка.Организации") Тогда  		 		
		
		ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКонтактноеЛицоЗавершение(Результат, ИмяРеквизита) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
			
			Результат = Результат.Значение;	
			
		КонецЕсли;	
		
		ЭтотОбъект[ИмяРеквизита + "Наименование"] = СокрЛП(Результат);		
		ЭтотОбъект[ИмяРеквизита + "ТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(Результат); 
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ПолучитьТелефоныКонтактногоЛица(КонтактноеЛицо)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		
		Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(КонтактноеЛицо, Перечисления.ТипыКонтактнойИнформации.Телефон, ТекущаяДата(), Ложь); 	  
		
		Результат = СтрСоединить(Телефоны.ВыгрузитьКолонку("Представление"), "; ");		 		 		
		
	КонецЕсли; 
	
	Возврат Результат;
	
Конецфункции

