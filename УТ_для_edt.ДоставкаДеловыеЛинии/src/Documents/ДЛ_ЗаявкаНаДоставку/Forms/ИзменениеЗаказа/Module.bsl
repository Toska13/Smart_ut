&НаСервере
Функция ЗаполнитьПараметрУчастникПеревозки(Префикс)
	
	Результат = Новый Структура;
	
	КонтрагентСсылка = ЭтотОбъект[Префикс + "КонтрагентСсылка"];
	КонтрагентНаименование = ЭтотОбъект[Префикс + "КонтрагентНаименование"];
	КонтрагентЮрФизЛицо = ЭтотОбъект[Префикс + "КонтрагентЮрФизЛицо"];
	КонтрагентИНН = ЭтотОбъект[Префикс + "КонтрагентИНН"];
	КонтрагентЮридическийАдрес = ЭтотОбъект[Префикс + "КонтрагентЮридическийАдресПредставление"];	
	
	ПараметрыКонтрагента = Новый Структура;  
	
	Если Префикс = "Получатель" Тогда
		
		Если ПолучательНовыйПлательщик = 2 И  КонтрагентЮрФизЛицо = 2 Тогда
			
			ДанныеДляЭлектронногоЧека = Новый Структура;			
			
			Если ЗначениеЗаполнено(ПлательщикКонтактноеЛицоEmail) Тогда  
				
				ДанныеДляЭлектронногоЧека.Вставить("email", ПлательщикКонтактноеЛицоEmail);	
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ПлательщикКонтактноеЛицоТелефонДляЧека) Тогда  
				
				ДанныеДляЭлектронногоЧека.Вставить("phone", ПлательщикКонтактноеЛицоТелефонДляЧека);	
				
			КонецЕсли;
			
			Результат.Вставить("dataForReceipt", ДанныеДляЭлектронногоЧека);
			
		КонецЕсли; 		
		
	КонецЕсли; 	
	
	Если КонтрагентЮрФизЛицо = 2 Тогда
		
		ПараметрыКонтрагента.Вставить("form", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A"); 
		
		ПаспортныеДанные = ПолучитьПаспортныеДанные(КонтрагентСсылка);
		
		Если ПаспортныеДанные <> Неопределено Тогда
			
			Паспорт = Новый Структура;
			Паспорт.Вставить("type", "passport");
			Паспорт.Вставить("serial", СтрЗаменить(ПаспортныеДанные.Серия, " ", "")); 
			Паспорт.Вставить("number", ПаспортныеДанные.Номер);
			
			ПараметрыКонтрагента.Вставить("document", Паспорт);  
			
		КонецЕсли;
		
	Иначе 
		            
		ПараметрыКонтрагента.Вставить("form", ДЛ_ДеловыеЛинии.ПолучитьОПФпоИНН(КонтрагентИНН));		
		ПараметрыКонтрагента.Вставить("inn", КонтрагентИНН); 
		
		Если ЗначениеЗаполнено(КонтрагентЮридическийАдрес) Тогда
		
			ПараметрыКонтрагента.Вставить("juridicalAddress", Новый Структура("search", КонтрагентЮридическийАдрес));
			
		КонецЕсли;	
		
	КонецЕсли;
	
	ПараметрыКонтрагента.Вставить("name", КонтрагентНаименование);  		 
	
	Результат.Вставить("counteragent", ПараметрыКонтрагента); 
	
	ДобавитьКонтактноеЛицоИТелефоны(Результат, Префикс);
	
	Возврат Результат;
	
КонецФункции

