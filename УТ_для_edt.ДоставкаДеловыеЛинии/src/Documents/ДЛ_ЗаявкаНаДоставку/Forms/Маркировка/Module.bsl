
&НаКлиенте
Процедура днОбУслугеНажатие(Элемент)
	
	ПерейтиПоНавигационнойСсылке("https://www.dellin.ru/service/cargo_marking/");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	ФорматЭтикетки = "a4";
	
	МассивЗаказов = Неопределено;
	
	Если Не Параметры.Свойство("МассивЗаказов", МассивЗаказов) Тогда
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;	
	
	Для Каждого Заказ Из МассивЗаказов Цикл 
		
		СтрокаЗаказа = ТаблицаЗаказов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗаказа, Заказ);	
		
	КонецЦикла;   
	
	КоличествоЗаказов = МассивЗаказов.Количество();
	
	Если КоличествоЗаказов > 1 Тогда
		   
		Элементы.грИнфо.Видимость = Истина; 		
		
	КонецЕсли;
	
	ДанныеЭтикеток = ДЛ_ДеловыеЛинии.ПолучитьЭтикеткиНовая(ТаблицаЗаказов.Выгрузить().ВыгрузитьКолонку("НомерЗаказа"));  
	
	Если ДанныеЭтикеток["data"] = Неопределено Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Ошибка получения данных по текущим заказам. Попробуйте еще раз позднее");
		
		Отказ = Истина;		
		Возврат;
		
	Иначе 
		
		ОбновитьСпискиЗаказов(ДанныеЭтикеток["data"]);  
		
		Если КоличествоЗаказов > 1 Тогда 
			
			Элементы.днСостояние.Видимость = Истина;
			
			ОбновитьСтрокуСостоянияЗаказов();
			
		ИначеЕсли ЗаказыБезАртикулов.Количество() = 1 Тогда
			
			Элементы.УказатьАртикулы.Видимость = Истина;
			СтрокаАртикула = ТаблицаАртикулов.Добавить();
			СтрокаАртикула.Количество = ТаблицаЗаказов[0].КоличествоМест;
			Элементы.ФорматЭтикетки.Видимость = Истина;
			
		КонецЕсли;  
		
		ОбновитьВидимостьКнопок();
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Процедура ОбновитьСпискиЗаказов(ДанныеЭтикеток, ОчищатьВРаботе = Ложь, ОчищатьБезАртикулов = Ложь)
	
	Если ОчищатьВРаботе Тогда
		
		ЗаказыВРаботе.Очистить();		
		
	КонецЕсли; 
	
	Если ОчищатьБезАртикулов Тогда		
		
		ЗаказыБезАртикулов.Очистить();
		
	КонецЕсли; 	
	
	Для Каждого ДанныеПоЗаказу Из ДанныеЭтикеток Цикл
		
		Если ДанныеПоЗаказу["state"] = "processed" Тогда  
			
			ЗаказыГотовые.Добавить(ДанныеПоЗаказу["orderId"]);
			
			Для Каждого СсылкаНаФайлЭтикеток Из ДанныеПоЗаказу["files"] Цикл
				
				СсылкиНаФайлы.Добавить(СсылкаНаФайлЭтикеток);	
				
			КонецЦикла;
			
		ИначеЕсли ДанныеПоЗаказу["state"] = "enqueued" Или ДанныеПоЗаказу["state"] = "ordered" Тогда   
			
			ЗаказыВРаботе.Добавить(ДанныеПоЗаказу["orderId"]);			
			
		Иначе
			
			ЗаказыБезАртикулов.Добавить(ДанныеПоЗаказу["orderId"]);
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокуСостоянияЗаказов() 
	
	Элементы.днСостояние.Заголовок = "";
	
	Если ЗаказыГотовые.Количество() Тогда
		
		Элементы.днСостояние.Заголовок = Элементы.днСостояние.Заголовок + "Этикетки сформированы для заказов: " + ЗаказыГотовые.Количество() + "шт.";	
		
	КонецЕсли; 
	
	Если ЗаказыВРаботе.Количество() Тогда
		
		Элементы.днСостояние.Заголовок = Элементы.днСостояние.Заголовок + ?(СтрДлина(Элементы.днСостояние.Заголовок) = 0, "", Символы.ПС) + "Этикетки в процессе формирования для заказов: " + ЗаказыВРаботе.Количество() + "шт.";		
		
	КонецЕсли; 
	
	Если ЗаказыБезАртикулов.Количество() Тогда
		
		Элементы.днСостояние.Заголовок = Элементы.днСостояние.Заголовок + ?(СтрДлина(Элементы.днСостояние.Заголовок) = 0, "", Символы.ПС) + "Этикетки не сформированы для заказов: " + ЗаказыБезАртикулов.Количество() + "шт.";					    		
		
	КонецЕсли;  
	
	Элементы.ФорматЭтикетки.Видимость = ЗаказыБезАртикулов.Количество() > 0;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЗаказовВРаботе()
	
	ДанныеЭтикеток = ДЛ_ДеловыеЛинии.ПолучитьЭтикеткиНовая(ЗаказыВРаботе.ВыгрузитьЗначения());	
	
	Если ДанныеЭтикеток["data"] = Неопределено Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Ошибка получения данных по текущим заказам. Попробуйте еще раз позднее");		
		
	Иначе 
		
		ОбновитьСпискиЗаказов(ДанныеЭтикеток["data"], Истина); 
		
		Если ТаблицаЗаказов.Количество() > 1 Тогда 
			
			ОбновитьСтрокуСостоянияЗаказов(); 
			
		КонецЕсли;
		
		ОбновитьВидимостьКнопок();
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Процедура ОбновитьСостояниеЗаказовБезАртикулов()
	
	ДанныеЭтикеток = ДЛ_ДеловыеЛинии.ПолучитьЭтикеткиНовая(ЗаказыБезАртикулов.ВыгрузитьЗначения());	
	
	Если ДанныеЭтикеток["data"] = Неопределено Тогда
		
		ОбщегоНазначения.СообщитьПользователю("Ошибка получения данных по текущим заказам. Попробуйте еще раз позднее");		
		
	Иначе 
		
		ОбновитьСпискиЗаказов(ДанныеЭтикеток["data"],, Истина); 
		
		Если ТаблицаЗаказов.Количество() > 1 Тогда	
			
			ОбновитьСтрокуСостоянияЗаказов(); 
			
		КонецЕсли;
		
		ОбновитьВидимостьКнопок();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьКнопок() 	 	
	
	Элементы.СформироватьЭтикетки.Видимость = ЗаказыБезАртикулов.Количество() > 0; 
	
	Элементы.ПоказатьЭтикетки.Видимость = ЗаказыБезАртикулов.Количество() = 0 И (ЗаказыГотовые.Количество() > 0 Или ЗаказыВРаботе.Количество() > 0);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЭтикетки(Команда) 
	
	СформироватьЭтикеткиНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура СформироватьЭтикеткиНаСервере()  
	
	Если УказатьАртикулы Тогда
		
		ЗаполненоМест = ТаблицаАртикулов.Итог("Количество");   
		КоличествоМест = ТаблицаЗаказов[0].КоличествоМест;
		
		Если ЗаполненоМест <> КоличествоМест Тогда		
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("В таблице указано %1 мест, при количестве мест в заявке %2", ЗаполненоМест, КоличествоМест)); 
			
			Возврат;
			
		КонецЕсли;		
		
	КонецЕсли;
	
	МассивЗаказов = Новый Массив;
	
	Для Каждого Заказ Из ЗаказыБезАртикулов Цикл  
		
		МассивАртикулов = Новый Массив;	
		
		Если УказатьАртикулы Тогда 
			
			Для Каждого СтрокаАртикула Из ТаблицаАртикулов Цикл
				
				МассивАртикулов.Добавить(Новый Структура("cargoPlace, amount", СтрокаАртикула.Артикул, СтрокаАртикула.Количество));	
				
			КонецЦикла;
			
		Иначе	
			
			МассивАртикулов.Добавить(Новый Структура("cargoPlace, amount", Неопределено, ТаблицаЗаказов.Выгрузить().Найти(Заказ.Значение, "НомерЗаказа").КоличествоМест));
			
		КонецЕсли;	
		
		СтруктураЗаказСАртикулами = Новый Структура;
		СтруктураЗаказСАртикулами.Вставить("orderID", Заказ.Значение); 
		СтруктураЗаказСАртикулами.Вставить("cargoPlaces", МассивАртикулов);   
		
		МассивЗаказов.Добавить(СтруктураЗаказСАртикулами);
		
	КонецЦикла;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("appKey");
	СтруктураЗапроса.Вставить("sessionID");  
	СтруктураЗапроса.Вставить("format", ФорматЭтикетки);
	СтруктураЗапроса.Вставить("orders", МассивЗаказов);	 
	
	РезультатЗапроса = ДЛ_ДеловыеЛинии.ПередатьАртикулыЗаказаНовая(СтруктураЗапроса);   
	
	Если РезультатЗапроса["errors"] <> Неопределено Тогда
		
		Для Каждого Ошибка Из РезультатЗапроса["errors"] Цикл
			
			ОбщегоНазначения.СообщитьПользователю(Ошибка["detail"]);
			
		КонецЦикла;
		
	ИначеЕсли ТаблицаЗаказов.Количество() = 1 Тогда
		
		Элементы.УказатьАртикулы.Видимость = Ложь;
		Элементы.ТаблицаАртикулов.Видимость = Ложь;		
		Элементы.ФорматЭтикетки.Видимость = Ложь;
		
	КонецЕсли;     	
	
	ОбновитьСостояниеЗаказовБезАртикулов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЭтикетки(Команда) 	
	
	Если ЗаказыВРаботе.Количество() > 0 Тогда
		
		ОбновитьСостояниеЗаказовВРаботе();
		
	КонецЕсли; 
	
	Если ЗаказыВРаботе.Количество() = 0 Тогда  
		
		#Если ВебКлиент Тогда
			
		ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ФайлыМаркировкиWEB", Новый Структура("СсылкиНаФайлы", СсылкиНаФайлы.ВыгрузитьЗначения()), Этаформа,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
			
		Возврат;
			
		#КонецЕсли	
		
		Для Каждого СсылкаНаФайлЭтикеток Из СсылкиНаФайлы Цикл 				
			
			ПерейтиПоНавигационнойСсылке(?(Лев(СсылкаНаФайлЭтикеток, 4) = "http", СсылкаНаФайлЭтикеток, "https://" + СсылкаНаФайлЭтикеток));					
			
		КонецЦикла; 		
		
	ИначеЕсли ТаблицаЗаказов.Количество() = 1 Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю("Этикетки в процессе формирования");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьАртикулыПриИзменении(Элемент)
	
	Элементы.ТаблицаАртикулов.Видимость = УказатьАртикулы;
	
КонецПроцедуры

