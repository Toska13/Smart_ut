&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого Телефон Из Параметры.Телефоны Цикл
		
		НовыйТелефон = Телефоны.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовыйТелефон, Телефон);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)
	
	СтрокаТелефоны = ""; 
	
	Для Каждого Телефон Из Телефоны Цикл
		
		Если ЗначениеЗаполнено(Телефон.Основной) Тогда  
			
			Если СтрокаТелефоны = "" Тогда
				
				СтрокаТелефоны = Телефон.Основной + ДобавочныйСтрокой(Телефон);
				
			Иначе	
			
				СтрокаТелефоны = СтрокаТелефоны + "; " + Телефон.Основной + ДобавочныйСтрокой(Телефон); 	
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОповеститьОВыборе(СтрокаТелефоны);	
	
КонецПроцедуры 

&НаКлиенте
Функция ДобавочныйСтрокой(Телефон)
	
	Возврат ?(ЗначениеЗаполнено(Телефон.Добавочный), ", доб. " + Телефон.Добавочный, "");	
	
КонецФункции

