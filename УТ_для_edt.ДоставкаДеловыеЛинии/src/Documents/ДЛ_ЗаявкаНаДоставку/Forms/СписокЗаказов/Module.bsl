&НаКлиенте
Функция ПолучитьМассивНомеровЗаказовВыделенныхСтрок() 
	
	Результат = Новый Массив;
	
	Для Каждого ВыбраннаяСтрока Из Элементы.Список.ВыделенныеСтроки Цикл  
		
		СтрокаСписка = Список.НайтиПоИдентификатору(ВыбраннаяСтрока);
		
		Результат.Добавить(Новый Структура("НомерЗаказа, КоличествоМест", СтрокаСписка.НомерЗаказа, СтрокаСписка.КоличествоГрузовыхМест)); 		
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПередатьАртикулыДляЗаказов(МассивЗаказов)  	
	
	Если МассивЗаказов.Количество() > 0 Тогда	
		
		СтруктураПараметров = Новый Структура("НомерЗаказа, КоличествоМест");
		
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, МассивЗаказов[0]);
		
		МассивЗаказов.Удалить(0);
		
		ОО = Новый ОписаниеОповещения("ПослеПередачиАртикуловГрузовыхМест", ЭтотОбъект, МассивЗаказов);
	
		ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.АртикулыГрузовыхМест", СтруктураПараметров, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;
	
КонецПроцедуры

