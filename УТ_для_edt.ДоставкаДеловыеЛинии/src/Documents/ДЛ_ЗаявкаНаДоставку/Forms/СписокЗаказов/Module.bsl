
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	 
	
	Элементы.ОткрытьВзаиморасчеты.Видимость = РольДоступна("ДЛ_Взаиморасчеты") Или РольДоступна("АдминистраторСистемы");
	
	ИнициализироватьСтруктуруСтраниц(); 
	
	УстановитьУсловноеОформление();
	
	ПолучитьСписокЗаказов();
	
	ЗаполнитьСпискиОтборов();
	
КонецПроцедуры   

&НаСервере
Процедура ИнициализироватьСтруктуруСтраниц()
	
	Страницы = Новый Структура;
	Страницы.Вставить("ТекущаяСтраница", 1);
	Страницы.Вставить("КоличествоСтраниц",1);  
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокЗаказов()
	
	СтруктураПараметров = Новый Структура;
	
	Если ЗначениеЗаполнено(ПериодДатаСоздания.ДатаНачала) Тогда
		
		СтруктураПараметров.Вставить("НачалоПериода", НачалоДня(ПериодДатаСоздания.ДатаНачала));
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ПериодДатаСоздания.ДатаОкончания) Тогда
		
		СтруктураПараметров.Вставить("ОкончаниеПериода", КонецДня(ПериодДатаСоздания.ДатаОкончания));
	
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(ОтборСтатусЗаказа) Тогда
				
		СтатусыЗаказа = Новый Массив;   
		
		Для Каждого СтатусСсылка Из ОтборСтатусЗаказа Цикл 
			
			Статус = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтатусСсылка.Значение, "Статус");   
			
			Если ЗначениеЗаполнено(Статус) И СтатусыЗаказа.Найти(Статус) = Неопределено Тогда
				
				СтатусыЗаказа.Добавить(Статус);	
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураПараметров.Вставить("Статус", СтатусыЗаказа);
	
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ОтборОткуда) Тогда
		
		СтруктураПараметров.Вставить("Откуда", ОтборОткуда);
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ОтборКуда) Тогда
		
		СтруктураПараметров.Вставить("Куда", ОтборКуда);
	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ОтборОтправитель) Тогда
		
		СтруктураПараметров.Вставить("Отправитель", ОтборОтправитель);
	
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ОтборПолучатель) Тогда
		
		СтруктураПараметров.Вставить("Получатель", ОтборПолучатель);
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборВнутреннийНомерЗаказа) Тогда	
		
		СтруктураПараметров.Вставить("ВнутреннийНомер", ОтборВнутреннийНомерЗаказа);
	
	КонецЕсли;
	
	СтруктураПараметров.Вставить("Страница", Страницы.ТекущаяСтраница);
	
	ДанныеЗаказов =  ДЛ_ДеловыеЛинии.ПолучитьЖурналОтправок(СтруктураПараметров);    
	
	Если ДанныеЗаказов["error"] <> Неопределено Тогда 
		
		ОбщегоНазначения.СообщитьПользователю(ДанныеЗаказов["error"]["description"]);
		
		Возврат;  
		
	ИначеЕсли ДанныеЗаказов["errors"] <> Неопределено Тогда
			
		Для Каждого Ошибка Из ДанныеЗаказов["errors"] Цикл	
			
			Если Ошибка["detail"] = "Воспользуйтесь расширенным поиском" Тогда
				
				ОбщегоНазначения.СообщитьПользователю("С выбранным внутренним номером найдено более одного заказа. Используйте номер заказа для поиска.");	
				
			Иначе	
		
				ОбщегоНазначения.СообщитьПользователю(Ошибка["detail"]);   
			
			КонецЕсли;
			
		КонецЦикла;	
		
		Возврат;
		
	ИначеЕсли ДанныеЗаказов["status"] <> Неопределено И ДанныеЗаказов["status"] = "error" И ДанныеЗаказов["message"] <> Неопределено Тогда
		
		ОбщегоНазначения.СообщитьПользователю(ДанныеЗаказов["message"]);
		
		Возврат;
		
	КонецЕсли;
	
	Страницы.КоличествоСтраниц = Макс(ДанныеЗаказов["metadata"]["totalPages"], 1);  		
	
	Если Страницы.ТекущаяСтраница > Страницы.КоличествоСтраниц Тогда
		
		Страницы.ТекущаяСтраница = Страницы.КоличествоСтраниц;  
		
		ПолучитьСписокЗаказов();
		
		Возврат;
		
	КонецЕсли; 
	
	ОбновитьСписокЗаказов(ДанныеЗаказов["orders"]);		
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьСписокЗаказов(МассивЗаказов) 
	
	Список.Очистить();
	
	Для Каждого Заказ Из МассивЗаказов Цикл 		
		
		СтрокаЗаказа = Список.Добавить();
		СтрокаЗаказа.НомерЗаказа = Заказ["orderId"];
		СтрокаЗаказа.ДатаЗаказа = ДЛ_ДеловыеЛинии.ПреобразоватьВДату(Заказ["orderedAt"]);  
		СтрокаЗаказа.Состояние = Заказ["stateName"]; 
		СтрокаЗаказа.Сумма = Заказ["totalSum"];
		СтрокаЗаказа.ОтправительНаименование = ?(ЗначениеЗаполнено(Заказ["sender"]["name"]), СтрШаблон("%1 (ИНН %2)", Заказ["sender"]["name"], Заказ["sender"]["inn"]), ""); 
		СтрокаЗаказа.ПолучательНаименование = ?(ЗначениеЗаполнено(Заказ["receiver"]["name"]), СтрШаблон("%1 (ИНН %2)", Заказ["receiver"]["name"], Заказ["receiver"]["inn"]), "");	
		СтрокаЗаказа.ПлательщикНаименование = ?(ЗначениеЗаполнено(Заказ["payer"]["name"]), СтрШаблон("%1 (ИНН %2)", Заказ["payer"]["name"], Заказ["payer"]["inn"]), "");	
		СтрокаЗаказа.Оплачен = Заказ["isPaid"]; 
		СтрокаЗаказа.СуммаНаложенногоПлатежа = Заказ["webOrderItemsSum"];
		СтрокаЗаказа.КоличествоГрузовыхМест = ?(ЗначениеЗаполнено(Заказ["freight"]), Заказ["freight"]["places"], 0); 
		СтрокаЗаказа.ВнутреннийНомерЗаказа = Заказ["orderNumber"]; 		 
		
		Если Заказ["orderedDeliveryFromAddress"] = Истина Тогда  
			
			АдресОтправки = Заказ["derival"]["address"];
			
			СтрокаЗаказа.АдресОтгрузкиПредставление = ?(ЗначениеЗаполнено(АдресОтправки), АдресОтправки, Заказ["derival"]["city"]);
			
		Иначе
			
			СтрокаЗаказа.АдресОтгрузкиПредставление = Заказ["derival"]["terminalAddress"];
			
		КонецЕсли;
		
		Если Заказ["orderedDeliveryToAddress"] = Истина Тогда
			
			АдресДоставки = Заказ["arrival"]["address"];
			
			СтрокаЗаказа.АдресДоставкиПредставление = ?(ЗначениеЗаполнено(АдресДоставки), АдресДоставки, Заказ["arrival"]["city"]);
			
		Иначе			
			
			СтрокаЗаказа.АдресДоставкиПредставление = Заказ["arrival"]["terminalAddress"];
			
		КонецЕсли;		
		
		ГрафикПеревозки = Заказ["orderDates"]; 
		ДатаДоставки = ?(ЗначениеЗаполнено(ГрафикПеревозки["arrivalToReceiver"]), ГрафикПеревозки["arrivalToReceiver"], ГрафикПеревозки["arrivalToOspReceiver"]);		
		
		СтрокаЗаказа.ДатаОтгрузки = ДЛ_ДеловыеЛинии.ПреобразоватьВДату(Заказ["produceDate"]); 
		СтрокаЗаказа.ДатаДоставки = ДЛ_ДеловыеЛинии.ПреобразоватьВДату(ДатаДоставки);
		СтрокаЗаказа.НачалоПлатногоХранения = ДЛ_ДеловыеЛинии.ПреобразоватьВДату(ГрафикПеревозки["warehousing"]); 
		
		ДокументЗаказа = Документы.ДЛ_ЗаявкаНаДоставку.НайтиПоРеквизиту("НомерЗаказа", Заказ["orderId"]);
		
		Если ЗначениеЗаполнено(ДокументЗаказа) Тогда	
			
			СтрокаЗаказа.ДокументЗаказа = ДокументЗаказа;
			
			КоличествоОснований = ДокументЗаказа.ДокументыОснования.Количество();
			
			Если КоличествоОснований > 0 Тогда
				
				Для Каждого Основание Из ДокументЗаказа.ДокументыОснования Цикл
					
					СтрокаЗаказа.ДокументыОснования.Добавить(Основание.Документ);	
					
				КонецЦикла; 
				
				СтрокаЗаказа.ДокументОснованиеПредставление = ?(КоличествоОснований = 1, ДокументЗаказа.ДокументыОснования[0].Документ, "Несколько");								
				
			КонецЕсли;
			
		КонецЕсли;  
		
		ДанныеДокументов = Заказ["documents"]; 
		
		ЕстьНакладная = Ложь;
		
		Если ДанныеДокументов <> Неопределено Тогда 
			
			Для Каждого ДанныеДокумента Из  ДанныеДокументов Цикл
				
				Если ДанныеДокумента["type"] = "shipping" Тогда 
					
					ЕстьНакладная = Истина;
					
					СтрокаЗаказа.НомерНакладной = ?(СтрокаЗаказа.НомерНакладной = "", ДанныеДокумента["id"], СтрокаЗаказа.НомерНакладной + "; " + ДанныеДокумента["id"]);
					
					Если СтрокаЗаказа.ВидПеревозки = "" Тогда
						
						СтрокаЗаказа.ВидПеревозки = ДанныеДокумента["serviceKind"];
						
					КонецЕсли;	
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли; 
		
		Если Не ЕстьНакладная Тогда
			
			СтрокаЗаказа.Оплачен = Ложь;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция НайтиДокументЗаказаПоНомеру(НомерЗаказа)
	
	Возврат Документы.ДЛ_ЗаявкаНаДоставку.НайтиПоРеквизиту("НомерЗаказа", НомерЗаказа);		
	
КонецФункции  

&НаКлиенте
Процедура НавигацияСтраницаТекущаяСтраница(Команда)
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("МаксимальныйНомерСтраницы", Страницы.КоличествоСтраниц);
	ПараметрыОткрытияФормы.Вставить("НомерСтраницы",             Страницы.ТекущаяСтраница);
	
	ОО = Новый ОписаниеОповещения("ПослеВыбораНомераСтраницы", ЭтотОбъект); 
	
	ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ПереходКСтраницеПоНомеру", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОО);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНомераСтраницы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Страницы.ТекущаяСтраница = Результат; 
	
	ПолучитьСписокЗаказов();  
	
	ОбновитьНавигационноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтборы(Команда) 
	
	Элементы.ГруппаОтборы.Скрыть();
	
	Если ЗначениеЗаполнено(ОтборНомерЗаказа) Тогда 
		
		ДокументЗаказа = НайтиДокументЗаказаПоНомеру(ОтборНомерЗаказа);
		
		Если ЗначениеЗаполнено(ДокументЗаказа) Тогда
			
			ПоказатьЗначение(, ДокументЗаказа);	
			
		Иначе
			
			ПараметрыОткрытияФормы = Новый Структура;	
			ПараметрыОткрытияФормы.Вставить("НомерЗаказа", ОтборНомерЗаказа);		
			
			ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ФормаДокумента", ПараметрыОткрытияФормы); 
			
		КонецЕсли;  
		
	Иначе
		
		ПолучитьСписокЗаказов();
		
		ОбновитьНавигационноеМеню();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНавигационноеМеню()
	
	Элементы.ГруппаНавигация.Доступность = Страницы.КоличествоСтраниц > 1;	
	
	Элементы.НавигацияСтраницаТекущаяСтраница.Заголовок = СтрШаблон("Страница %1 из %2", 
		Страницы.ТекущаяСтраница, 
		Страницы.КоличествоСтраниц);
			
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	ОбновитьНавигационноеМеню(); 	
		
	ДанныеНовойВерсии = ДЛ_ДеловыеЛинииКлиент.ПроверитьНаличиеНовойВерсии(ЭтаФорма, Истина); 
	
	ВышлаНоваяВерсия = ДанныеНовойВерсии.Свойство("НоваяВерсия");
	
	Элементы.ДоступнаНоваяВерсия.Видимость = ВышлаНоваяВерсия;
	
	Если ВышлаНоваяВерсия Тогда
		
		АдресДанныеНовойВерсии = ПоместитьВоВременноеХранилище(ДанныеНовойВерсии, ЭтаФорма.УникальныйИдентификатор);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоНомеруСтраницы(НомерСтраницы)
	
	Если НомерСтраницы < 1
		ИЛИ НомерСтраницы > Страницы.КоличествоСтраниц
		ИЛИ НомерСтраницы = Страницы.ТекущаяСтраница Тогда 
		
		Возврат;
		
	КонецЕсли;
	
	Страницы.ТекущаяСтраница = НомерСтраницы;
	
	ПолучитьСписокЗаказов(); 
	
	ОбновитьНавигационноеМеню();
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияСтраницаПредыдущая(Команда)
	
	ПерейтиПоНомеруСтраницы(Страницы.ТекущаяСтраница - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияСтраницаСледующая(Команда)
	
	ПерейтиПоНомеруСтраницы(Страницы.ТекущаяСтраница + 1);
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияСтраницаПервая(Команда)
	
	ПерейтиПоНомеруСтраницы(1);
	
КонецПроцедуры

&НаКлиенте
Процедура НавигацияСтраницаПоследняя(Команда)
	
	ПерейтиПоНомеруСтраницы(Страницы.КоличествоСтраниц);
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьУсловноеОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокДокументОснованиеПредставление.Имя);
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.ДокументОснованиеПредставление");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветГиперссылкиБЭД); 	

КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	ОткрытьФормуЗаказа(Элементы.Список.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если Поле.Имя = "СписокДокументОснованиеПредставление" 
		И ТекущиеДанные.ДокументыОснования.Количество() Тогда 
		
		Если ТекущиеДанные.ДокументыОснования.Количество() = 1 Тогда 
			
			ПоказатьЗначение(, ТекущиеДанные.ДокументыОснования[0].Значение);
			
		Иначе
		
			Основания = Новый Массив;
			
			Для Каждого ТекЭлемент Из ТекущиеДанные.ДокументыОснования Цикл 
				
				Основания.Добавить(ТекЭлемент.Значение); 
				
			КонецЦикла;
			
			ОткрытьФорму("ОбщаяФорма.ДЛ_СписокПроизвольныхОбъектов",
				Новый Структура("МассивОбъектов, ЗаголовокФормы", Основания, НСтр("ru = 'Основания заказа на доставку';
																				|en = 'Delivery order bases'")),,,,,,
				РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
				
		КонецЕсли; 
		
	Иначе 
	
		ОткрытьФормуЗаказа(Список.НайтиПоИдентификатору(ВыбраннаяСтрока));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)	
	
	ПолучитьСписокЗаказов(); 
	
	ОбновитьНавигационноеМеню();

КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуЗаказа(ДанныеПоЗаказу)	
	
	Если ЗначениеЗаполнено(ДанныеПоЗаказу.ДокументЗаказа) Тогда
		
		ПоказатьЗначение(, ДанныеПоЗаказу.ДокументЗаказа);	
		
	Иначе
		
		ПараметрыОткрытияФормы = Новый Структура;	
		ПараметрыОткрытияФормы.Вставить("НомерЗаказа", ДанныеПоЗаказу.НомерЗаказа);		
		
		ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ФормаДокумента", ПараметрыОткрытияФормы); 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте 
Процедура СоздатьЗаказНаДоставкуБезОснования(Команда) 
	
	ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.КарточкаЗаказа");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодДатаСоздания(Команда)
	
	УстановитьИнтервал("ПериодДатаСоздания");
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьИнтервал(ПериодИмя)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = ЭтотОбъект[ПериодИмя];
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяРеквизита", ПериодИмя);
	
	Оповещение = Новый ОписаниеОповещения(
		"УстановитьИнтервалЗавершение", 
		ЭтаФорма, 
		ДополнительныеПараметры);
	
	Диалог.Показать(Оповещение);
	
КонецПроцедуры

