	Элементы.ГруппаОтборыДополнительные.Видимость = ВидимостьГруппы;
	Элементы.ДополнительныеОтборы.Заголовок = ?(ВидимостьГруппы, "˄ Скрыть доп. фильтры", "˅ Показать доп. фильтры");    	
	
	ПереместитьГруппуКнопокОтборов(ВидимостьГруппы); 
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьОтборы(Команда)
	
	ОтборНомерЗаказа = "";
	ОтборВнутреннийНомерЗаказа = "";
	ОтборСтатусЗаказа.Очистить();
	ПериодДатаСоздания.ДатаНачала = '00010101';
	ПериодДатаСоздания.ДатаОкончания = '00010101';
	ОтборКуда = "";
	ОтборОткуда = "";
	ОтборОтправитель = "";
	ОтборПолучатель = "";	
	
	ОбновитьОтображениеКнопкиСброситьОтборы();
	ПолучитьСписокЗаказов();	
	ОбновитьНавигационноеМеню();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьОтображениеКнопкиСброситьОтборы()	
	
	КоличествоОтборов = ?(ЗначениеЗаполнено(ОтборВнутреннийНомерЗаказа), 1, 0) 
		+ ?(ЗначениеЗаполнено(ОтборНомерЗаказа), 1, 0)
		+ ?(ОтборСтатусЗаказа.Количество() > 0, 1, 0)
		+ ?(ЗначениеЗаполнено(ПериодДатаСоздания.ДатаНачала) Или ЗначениеЗаполнено(ПериодДатаСоздания.ДатаОкончания), 1, 0)
		+ ?(ЗначениеЗаполнено(ОтборКуда), 1, 0)
		+ ?(ЗначениеЗаполнено(ОтборОткуда), 1, 0)
		+ ?(ЗначениеЗаполнено(ОтборОтправитель), 1, 0)
		+ ?(ЗначениеЗаполнено(ОтборПолучатель), 1, 0);
	
	Элементы.СброситьОтборы.Видимость = КоличествоОтборов <> 0; 	
	Элементы.СброситьОтборы.Заголовок = СтрШаблон("❌ Сбросить все (%1)", КоличествоОтборов); 
	
КонецПроцедуры

