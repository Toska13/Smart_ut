&НаКлиенте
Процедура ПослеВыбораФорматаЭтикетки(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ЗначениеЗаполнено(Результат) Тогда 
		
		#Если НЕ ВебКлиент Тогда		
				
		МассивBase64 = ПолучитьЭтикетки(Результат, ДополнительныеПараметры.ТипПечати, ДополнительныеПараметры.МассивЗаказов); 
		
		Если ЗначениеЗаполнено(МассивBase64) Тогда  
			
			Для Каждого ОтветBase64 Из МассивBase64 Цикл 
				
				ДвоичныеДанные = Base64Значение(ОтветBase64);
				
				ИмяФайла = ПолучитьИмяВременногоФайла("pdf");
				
				ДвоичныеДанные.Записать(ИмяФайла);
				
				ЗапуститьПриложение(ИмяФайла); 
				
			КонецЦикла; 						
			
		КонецЕсли;
		
		#КонецЕсли 
		
	КонецЕсли;			
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьЭтикетки(ФорматЭтикетки, ТипПечати, МассивЗаказов)  
	
	Результат = Новый Массив;
	
	Для Каждого Заказ Из МассивЗаказов Цикл
		
		СтруктураОтвета = ДЛ_ДеловыеЛинии.ПолучитьЭтикетки(Заказ.НомерЗаказа, ФорматЭтикетки, ТипПечати); 
		
		Если СтруктураОтвета["data"] <> Неопределено Тогда
			
			Если СтруктураОтвета["data"].Количество() > 0 Тогда				
				
				Для Каждого ЗаписьДанных Из СтруктураОтвета["data"] Цикл
					
					Результат.Добавить(ЗаписьДанных["base64"]);	
					
				КонецЦикла;    				
				
			КонецЕсли;	
			
		КонецЕсли; 
		
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции

