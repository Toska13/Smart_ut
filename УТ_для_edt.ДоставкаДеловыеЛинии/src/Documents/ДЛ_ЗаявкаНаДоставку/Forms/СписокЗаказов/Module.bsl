	ОткрытьФорму("ОбщаяФорма.ДЛ_ОповещениеОНовойВерсии", ДанныеНовойВерсии, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиОтборов()
	
	ДанныеКудаОткуда = ДЛ_ДеловыеЛинии.ПолучитьСписокГородовЗаказов();  
	
	Если ДанныеКудаОткуда["data"] <> Неопределено Тогда  
		
		Если ДанныеКудаОткуда["data"]["derival_cities"] <> Неопределено Тогда
		
			Элементы.ОтборОткуда.СписокВыбора.ЗагрузитьЗначения(ДанныеКудаОткуда["data"]["derival_cities"]);
		
		КонецЕсли; 
		
		Если ДанныеКудаОткуда["data"]["arrival_cities"] <> Неопределено Тогда
			
			Элементы.ОтборКуда.СписокВыбора.ЗагрузитьЗначения(ДанныеКудаОткуда["data"]["arrival_cities"]);			    
			
		КонецЕсли;	
		
	КонецЕсли;  
	
	ДанныеОтправительПолучатель = ДЛ_ДеловыеЛинии.ПолучитьСписокКонтрагентовЗаказов();
	
	Если ДанныеОтправительПолучатель["data"] <> Неопределено Тогда  
		
		Если ДанныеОтправительПолучатель["data"]["senders"] <> Неопределено Тогда
		
			Элементы.ОтборОтправитель.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивНаименованийКонтрагентов(ДанныеОтправительПолучатель["data"]["senders"]));
		
		КонецЕсли; 
		
		Если ДанныеОтправительПолучатель["data"]["receivers"] <> Неопределено Тогда
			
			Элементы.ОтборПолучатель.СписокВыбора.ЗагрузитьЗначения(ПолучитьМассивНаименованийКонтрагентов(ДанныеОтправительПолучатель["data"]["receivers"]));			    
			
		КонецЕсли;	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивНаименованийКонтрагентов(МассивСоответсвий)
	
	Результат = Новый Массив;
	
	Для Каждого Контрагент Из МассивСоответсвий Цикл  
		
		Результат.Добавить(Контрагент["name"]);	
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

