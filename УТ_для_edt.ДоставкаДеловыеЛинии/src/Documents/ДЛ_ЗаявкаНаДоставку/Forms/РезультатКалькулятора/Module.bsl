&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЦенаЗаказа") Тогда
			
		Элементы.днСтоимостьЗначение.Заголовок = СтрЗаменить(Параметры.ЦенаЗаказа, Символы.НПП, "") + " руб.";
		
	КонецЕсли; 
	
	Если Параметры.Свойство("Страховка") Тогда
			
		Элементы.днСтраховкаЗначение.Заголовок = СтрЗаменить(Параметры.Страховка, Символы.НПП, "") + " руб.";
		
	КонецЕсли;  
	
	Если Параметры.Свойство("Адреса") Тогда
			
		Элементы.днАдреса.Заголовок = Параметры.Адреса;
		
	КонецЕсли;   
	
	Если Параметры.Свойство("Детализация") Тогда
			
		Элементы.днДетализация.Заголовок = Параметры.Детализация;  
		
	Иначе
		
		Элементы.днДетализация.Видимость = Ложь;	
		
	КонецЕсли;
	
	Если Параметры.Свойство("УслугаИнформацияОСтатусе") Тогда
			
		Элементы.днИнформацияОСтатусе.Заголовок = Параметры.УслугаИнформацияОСтатусе;  
		
	Иначе
		
		Элементы.днИнформацияОСтатусе.Видимость = Ложь;	
		
	КонецЕсли; 
	
	Если Параметры.Свойство("ГрафикПеревозки") И Параметры.ГрафикПеревозки.Количество() > 0 Тогда
		
		Для Каждого Запись Из Параметры.ГрафикПеревозки Цикл
			
			СтрокаГрафика = ГрафикПеревозок.Добавить();			
			СтрокаГрафика.Дата = Запись.Значение;
			СтрокаГрафика.Состояние = Запись.Представление;
			
		КонецЦикла;
		
	Иначе
		
		Элементы.грПраво.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

