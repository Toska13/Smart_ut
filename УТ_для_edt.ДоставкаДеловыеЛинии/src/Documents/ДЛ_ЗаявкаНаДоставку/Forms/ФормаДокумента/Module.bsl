&НаСервере
Функция ВнестиИзмененияНаСервере()
	
	Результат = Новый Структура;
	
	ДоступныеИзменения = ДЛ_ДеловыеЛинии.ПолучитьДоступныеИзменения(Объект.НомерЗаказа);
	
	ДоступныеИзменения = ДоступныеИзменения["data"];
	
	Если ЗначениеЗаполнено(ДоступныеИзменения) Тогда 
		
		Если ДоступныеИзменения["receiver"]["available"] = Истина Тогда
			
			Результат.Вставить("Получатель", "");
			
		КонецЕсли; 
		
		Если ДоступныеИзменения["payer"]["available"] = Истина Тогда
			
			Результат.Вставить("Плательщик", ДоступныеИзменения["payer"]["info"]);
			
		КонецЕсли;  
		
		КонтактнаяИнформация = ДоступныеИзменения["contactInfo"];  
		
		Если КонтактнаяИнформация["changeSender"]["available"] = Истина Тогда
			
			Результат.Вставить("КонтактнаяИнформацияОтправитель", "");
			
		КонецЕсли;  
		
		Если КонтактнаяИнформация["changeReceiver"]["available"] = Истина Тогда
			
			Результат.Вставить("КонтактнаяИнформацияПолучатель", "");
			
		КонецЕсли;
		
		Если ДоступныеИзменения["pickupInfo"]["available"] = Истина Тогда
			
			Результат.Вставить("АдресВремяЗабора", "");
			
		КонецЕсли;  
		
		Если ДоступныеИзменения["deliveryInfo"]["available"] = Истина Тогда
			
			Результат.Вставить("АдресВремяДоставки", "");
			
		КонецЕсли; 
		
		Если ДоступныеИзменения["suspend"]["available"] = Истина Тогда  
			
			ПриостановкаИнформация = ДоступныеИзменения["suspend"]["info"]; 		
			ПриостановкаИнформация = "" + ПриостановкаИнформация["warning"] + Символы.ПС + ПриостановкаИнформация["stateInfo"];
			
			Результат.Вставить("Приостановка", ПриостановкаИнформация);
			
		КонецЕсли;
		
		Если ДоступныеИзменения["resume"]["available"] = Истина Тогда  
			
			ПриостановкаИнформация = ДоступныеИзменения["resume"]["info"]; 		
			ПриостановкаИнформация = "" + ПриостановкаИнформация["warning"] + Символы.ПС + ПриостановкаИнформация["stateInfo"];
			
			Результат.Вставить("Возобновление", ПриостановкаИнформация);
			
		КонецЕсли; 
		
		Если ДоступныеИзменения["cancelPickup"]["available"] = Истина Тогда
			
			Результат.Вставить("ОтменаЗабора", "");
			
		КонецЕсли;  
		
		Если ДоступныеИзменения["cancelDelivery"]["available"] = Истина Тогда
			
			Результат.Вставить("ОтменаДоставки", "");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВнестиИзменения(Команда) 
	
	СтруктураПараметров = ВнестиИзмененияНаСервере();
	
	Если СтруктураПараметров.Количество() > 0 Тогда 
		
		СтруктураПараметров.Вставить("НомерЗаказа", Объект.НомерЗаказа); 
		СтруктураПараметров.Вставить("ОтправительКонтактноеЛицоНаименование", ОтправительКонтактноеЛицоНаименование);
		СтруктураПараметров.Вставить("ОтправительКонтактноеЛицоТелефонПредставление", ОтправительКонтактноеЛицоТелефонПредставление); 
		СтруктураПараметров.Вставить("ДоставкаДоАдреса", ДоставкаДоАдреса);
		
		ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ИзменениеЗаказа", СтруктураПараметров, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	Иначе     
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствуют поля доступные для изменения");
		
	КонецЕсли;
	
КонецПроцедуры

