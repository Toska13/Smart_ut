&НаКлиенте
Процедура ОткрытьФормуВыбораВремениИДаты(ВариантВыбораВремени, ТолькоПросмотр)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьВыборДатыВремени", ЭтаФорма);
	
	ПараметрыОткрытияФормы = Новый Структура;
	
	Если ВариантВыбораВремени = 1 Тогда
		
		ПараметрыОткрытияФормы.Вставить("Дата", ДатаОтгрузки);
		ПараметрыОткрытияФормы.Вставить("ВремяРаботыС", ВремяОтгрузкиС);
		ПараметрыОткрытияФормы.Вставить("ВремяРаботыПо", ВремяОтгрузкиПо);
		ПараметрыОткрытияФормы.Вставить("ВремяОбедС", ВремяОтгрузкиОбедС);  
		ПараметрыОткрытияФормы.Вставить("ВремяОбедПо", ВремяОтгрузкиОбедПо);
		ПараметрыОткрытияФормы.Вставить("ВариантВыбораВремени", 1);		
		ПараметрыОткрытияФормы.Вставить("ФиксированноеВремя", ОтправительФиксированноеВремя);		
		
	//ИначеЕсли ВариантВыбораВремени = 2 Тогда
	//	
	//	ПараметрыОткрытияФормы.Вставить("Дата", ДатаДоставки);
	//	ПараметрыОткрытияФормы.Вставить("ВремяРаботыС", ВремяДоставкиС);
	//	ПараметрыОткрытияФормы.Вставить("ВремяРаботыПо", ВремяДоставкиПо);
	//	ПараметрыОткрытияФормы.Вставить("ВремяОбедС", ВремяДоставкиОбедС);  
	//	ПараметрыОткрытияФормы.Вставить("ВремяОбедПо", ВремяДоставкиОбедПо);
	//	ПараметрыОткрытияФормы.Вставить("ВариантВыбораВремени", 2);		
	//	ПараметрыОткрытияФормы.Вставить("ФиксированноеВремя", ПолучательФиксированноеВремя);		
		
	КонецЕсли;
	
	ПараметрыОткрытияФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);	
	
	ОткрытьФорму(
		"Документ.ДЛ_ЗаявкаНаДоставку.Форма.ВыборВремениПередачиГруза",
		ПараметрыОткрытияФормы,
		ЭтаФорма,,,,ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительВремяПлановойОтгрузкиОчистка(Элемент, СтандартнаяОбработка)
	
	ВремяОтгрузкиС = Неопределено;
	ВремяОтгрузкиПо = Неопределено;
	ВремяОтгрузкиОбедС = Неопределено;
	ВремяОтгрузкиОбедПо = Неопределено;
	ОтправительФиксированноеВремя = Неопределено;  
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбработатьВыборДатыВремени(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	ВариантВыбораВремени = 0;
	Если Результат.Свойство("ВариантВыбораВремени", ВариантВыбораВремени) Тогда 
		Если ВариантВыбораВремени = 1 Тогда
			
			Результат.Свойство("ВремяРаботыС", ВремяОтгрузкиС);
			Результат.Свойство("ВремяРаботыПо", ВремяОтгрузкиПо);
			Результат.Свойство("ВремяОбедС", ВремяОтгрузкиОбедС);  
			Результат.Свойство("ВремяОбедПо", ВремяОтгрузкиОбедПо);			
			Результат.Свойство("ФиксированноеВремя", ОтправительФиксированноеВремя);			
			
			СформироватьПредставлениеВремениОтгрузки();
			
		//ИначеЕсли ВариантВыбораВремени = 2 Тогда

		//	Результат.Свойство("ВремяРаботыС", ВремяДоставкиС);
		//	Результат.Свойство("ВремяРаботыПо", ВремяДоставкиПо);
		//	Результат.Свойство("ВремяОбедС", ВремяДоставкиОбедС);  
		//	Результат.Свойство("ВремяОбедПо", ВремяДоставкиОбедПо);			
		//	Результат.Свойство("ФиксированноеВремя", ПолучательФиксированноеВремя);			
		//	
		//	СформироватьПредставлениеВремениДоставки();
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ПроверитьВремяОтгрузки(ЕстьОшибки, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеВремениОтгрузки()
	
	ВремяОтгрузкиПредставление = ПредставлениеДатыВремени(ДатаОтгрузки, 
									ВремяОтгрузкиС, 
									ВремяОтгрузкиПо, 
									ВремяОтгрузкиОбедС, 
									ВремяОтгрузкиОбедПо, 1);
									
КонецПроцедуры 							

&НаКлиенте
Функция ПроверитьВремяОтгрузки(ЕстьОшибки, ВыводитьПредупреждения)
	
	ШагОшибки = 0;
	ТекущаяДата = ОбщегоНазначенияКлиент.ДатаСеанса();
	НачалоТекущегоДня = НачалоДня(ТекущаяДата);
	ТекущееВремя = Дата(1,1,1) + (ТекущаяДата - НачалоТекущегоДня);
	НачалоДняОтгрузки = НачалоДня(ДатаОтгрузки); 
	
	Если НачалоТекущегоДня = НачалоДняОтгрузки
		И ВремяОтгрузкиПо <> Дата(1,1,1,0,0,0)
		И ТекущееВремя > ВремяОтгрузкиПо Тогда
		ЕстьОшибки = Истина;
		Если ВыводитьПредупреждения Тогда
			ТекстОшибки = НСтр("ru = 'Невозможно оформить доставку на указанное время отгрузки. Время отгрузки меньше, чем текущее.';
			|en = 'Cannot register delivery for the specified shipment time. The shipment time is less than the current one.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,,"ОтправительВремяПлановойОтгрузки");
		КонецЕсли;
	КонецЕсли;
	
	Возврат ШагОшибки;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДатыВремени(ДатаДоставки, ВремяРаботыС, ВремяРаботыПо, ВремяОбедС, ВремяОбедПо, Режим)
	
	СтрокаПредставления = "";
	
	Если ЗначениеЗаполнено(ВремяРаботыС) ИЛИ ЗначениеЗаполнено(ВремяРаботыПо) Тогда
		СтрокаПредставления = СтрокаПредставления + Формат(ВремяРаботыС, "ДФ='ЧЧ:мм'; ДП=00:00")
			+ "-" + Формат(ВремяРаботыПо, "ДФ='ЧЧ:мм'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВремяОбедС) ИЛИ ЗначениеЗаполнено(ВремяОбедПо) Тогда
		СтрокаПредставления = СтрокаПредставления + " (обед " + Формат(ВремяОбедС, "ДФ='ЧЧ:мм'; ДП=00:00")
			+ "-" + Формат(ВремяОбедПо, "ДФ='ЧЧ:мм'") + ")";
	КонецЕсли;
	
	Возврат СтрокаПредставления;
	
КонецФункции

&НаКлиенте
Процедура ОтгрузкаДополнительныеУслугиНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ПараметрыОткрытияФормы = Новый Структура;	
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаДополнительныеТребованияТС", ОтгрузкаДополнительныеТребованияТС);
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаПогрузочноРазгрузочныеРаботы", ОтгрузкаПогрузочноРазгрузочныеРаботы);
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаПогрузочноРазгрузочныеРаботыДоЭтажа", ОтгрузкаПогрузочноРазгрузочныеРаботыДоЭтажа);
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаПогрузочноРазгрузочныеРаботыЛифт", ОтгрузкаПогрузочноРазгрузочныеРаботыЛифт);
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса", ОтгрузкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса);
	ПараметрыОткрытияФормы.Вставить("ОтгрузкаПогрузочноРазгрузочныеРаботыПлательщик", ОтгрузкаПогрузочноРазгрузочныеРаботыПлательщик);
	ПараметрыОткрытияФормы.Вставить("СпособОтгрузки", СпособОтгрузки); 	
	ПараметрыОткрытияФормы.Вставить("ЭтоОтгрузка", Истина);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ДополнительныеУслуги", Новый Структура("СтруктураДанных", ПараметрыОткрытияФормы), ЭтаФорма,,,, Новый ОписаниеОповещения("ДополнительныеУслугиЗавершениеВыбора", ЭтаФорма, Ложь), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиЗавершениеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда 	
		
		СтруктураПараметров = Результат.Значение; 		
		
		Если ДополнительныеПараметры Тогда 
			
			Элементы.ТаблицаЗаказы.ТекущиеДанные.ДопУслугиПредставление = Результат.Результат;
			
			ЗаполнитьЗначенияСвойств(Элементы.ТаблицаЗаказы.ТекущиеДанные, СтруктураПараметров);
			
			ТЗДопУслуги	= Элементы.ТаблицаЗаказы.ТекущиеДанные.ДопУслугиЗначения;
			ТЗДопУслуги.Очистить();
			
			Для Каждого ЭлементМассива Из СтруктураПараметров.МассивДополнительныеУслуги Цикл
				
				СтрДопУслуги = ТЗДопУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(СтрДопУслуги, ЭлементМассива);
				
			КонецЦикла;			
			
		Иначе 
			
			ОтгрузкаДополнительныеУслуги = Результат.Результат;
			
			ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураПараметров);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказыДопУслугиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ПараметрыОткрытияФормы = Новый Структура;
	ПараметрыОткрытияФормы.Вставить("ДоставкаДополнительныеТребованияТС", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаДополнительныеТребованияТС);
	ПараметрыОткрытияФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботы", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаПогрузочноРазгрузочныеРаботы);
	ПараметрыОткрытияФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа);
	ПараметрыОткрытияФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыЛифт", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаПогрузочноРазгрузочныеРаботыЛифт);
	ПараметрыОткрытияФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса);
	ПараметрыОткрытияФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыПлательщик", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДоставкаПогрузочноРазгрузочныеРаботыПлательщик);
	ПараметрыОткрытияФормы.Вставить("ДополнительнаяИнформация", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДополнительнаяИнформация);	
	ПараметрыОткрытияФормы.Вставить("СпособДоставки", Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки); 
	ПараметрыОткрытияФормы.Вставить("СопроводительныеДокументы", Элементы.ТаблицаЗаказы.ТекущиеДанные.СопроводительныеДокументы);
	ПараметрыОткрытияФормы.Вставить("СопроводительныеДокументыПлательщик", Элементы.ТаблицаЗаказы.ТекущиеДанные.СопроводительныеДокументыПлательщик);
	ПараметрыОткрытияФормы.Вставить("ДополнительныеУслугиПлательщик", Элементы.ТаблицаЗаказы.ТекущиеДанные.ДополнительныеУслугиПлательщик);
	ПараметрыОткрытияФормы.Вставить("ЭтоОтгрузка", Ложь); 
	
	МассивДополнительныеУслуги = Новый Массив;
	
	Для Каждого СтрТЗ Из Элементы.ТаблицаЗаказы.ТекущиеДанные.ДопУслугиЗначения Цикл
		
		ЭлементМассива = Новый Структура("Услуга, Использовать, Количество, Наименование");
		ЗаполнитьЗначенияСвойств(ЭлементМассива, СтрТЗ); 			
		МассивДополнительныеУслуги.Добавить(ЭлементМассива);	
		
	КонецЦикла;
	
	ПараметрыОткрытияФормы.Вставить("МассивДополнительныеУслуги", МассивДополнительныеУслуги);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ДополнительныеУслуги", Новый Структура("СтруктураДанных", ПараметрыОткрытияФормы), ЭтаФорма,,,, Новый ОписаниеОповещения("ДополнительныеУслугиЗавершениеВыбора", ЭтаФорма, Истина), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаЗаказыСпособДоставкиПриИзменении(Элемент)
	
	Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = ?(Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставкиПредставление = "Самовывоз", 1, 0);	
	
	Если Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = 1 Тогда
		
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательАдресПредставление = СокрЛП(Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательТерминал);
		
	Иначе
		
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательАдресПредставление =  "";	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаЗаказыПолучательГородПриИзменении(Элемент)
	
	ГородПриИзменении("Получатель");
	
	Если Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = 1 Тогда
		
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательАдресПредставление = СокрЛП(Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательТерминал);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказыПолучательАдресПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = 1 Тогда 
		
		ПараметрыОтбора = Новый Структура("Приемка", Истина);
		
		Если ЗначениеЗаполнено(Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательГород) Тогда
			
			ПараметрыОтбора.Вставить("Город", Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательГород);
			
		КонецЕсли;
		
		ПараметрыОткрытия = Новый Структура;			
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
		ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
			
		ОО = Новый ОписаниеОповещения("ОбработатьВыборТерминала", ЭтотОбъект);
			
		ОткрытьФорму("Справочник.ДЛ_Терминалы.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	Иначе
		
		НачатьЗаполнениеАдреса("Получатель");	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте	
Процедура ОбработатьВыборТерминала(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> Неопределено Тогда  
		
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательТерминал = Результат;
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ПолучательАдресПредставление = СокрЛП(Результат);
		
	КонецЕсли;  	

КонецПроцедуры

&НаКлиенте
Процедура ДЛ_ОтправительТерминалПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОтправительТерминал) Тогда
		
		ЗаполнитьГородПоТерминалу("Отправитель");	
		
	КонецЕсли; 	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьГородПоТерминалу(ПрефиксРеквизита) 
	
	ТекущиеДанные = ?(ПрефиксРеквизита = "Получатель", ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока), ЭтаФорма);
	
	ТекущиеДанные[ПрефиксРеквизита + "Город"] = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные[ПрефиксРеквизита + "Терминал"], "Город");	
	
КонецПроцедуры

&НаКлиенте
Процедура ДЛ_ОтправительТерминалНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыВыбораТерминала = Новый Массив; 
	ПараметрыВыбораТерминала.Добавить(Новый ПараметрВыбора("Отбор.Приемка", Истина));
	
	Если ЗначениеЗаполнено(ОтправительГород) Тогда
		
		ПараметрыВыбораТерминала.Добавить(Новый ПараметрВыбора("Отбор.Город", ОтправительГород));
				
	КонецЕсли;
	
	Элементы.ОтправительТерминал.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораТерминала); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказыПолучательАдресПредставлениеПриИзменении(Элемент)
	
	Если Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = 1 Тогда 
		
		ЗаполнитьГородПоТерминалу("Получатель");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДокументамОснованиям() 
	
	ТекущиеДанные = ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока);	
	
	Документ = ТекущиеДанные.ДокументыОснования[0].Документ;
	ДокументТип = ТипЗнч(Документ);  
	
	ВнутреннийНомер = "";
	
	Для Каждого ДокОснование Из ТекущиеДанные.ДокументыОснования Цикл
		
		ВнутреннийНомер = ВнутреннийНомер + ?(ВнутреннийНомер = "", "", "; ") + ДокОснование.Документ.Номер;	
		
	КонецЦикла;
	
	ТекущиеДанные.ВнутреннийНомер = ВнутреннийНомер;
	
	ЭтоПеремещение = Ложь;
	ЭтоТранспортнаяНакладная = Ложь;  		
	РольСклада = ""; 	
	
	Если ДокументТип = Тип("ДокументСсылка.ЗаказКлиента") Или
		ДокументТип = Тип("ДокументСсылка.ВозвратТоваровПоставщику") Или				 
		ДокументТип = Тип("ДокументСсылка.КорректировкаПриобретения") Или                          
		ДокументТип = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда		
		
		Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Документ, "Контрагент"); 		
		
	ИначеЕсли ДокументТип = Тип("ДокументСсылка.ЗаявкаНаВозвратТоваровОтКлиента") Или
		ДокументТип = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Или				 
		ДокументТип = Тип("ДокументСсылка.КорректировкаРеализации") Или
		ДокументТип = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		
		Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Документ, "Организация");  
		РольСклада = "Получатель";
		
	ИначеЕсли ДокументТип = Тип("ДокументСсылка.ЗаказНаПеремещение") Или
		ДокументТип = Тип("ДокументСсылка.ПеремещениеТоваров") Тогда
		
		Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Документ, "Организация"); 
		
		ЭтоПеремещение = Истина; 
		
	ИначеЕсли ДокументТип = Тип("ДокументСсылка.ТранспортнаяНакладная") Тогда
		
		Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Документ, "Грузополучатель");
		
		ЭтоТранспортнаяНакладная = Истина;    
		
	ИначеЕсли ДокументТип = Тип("ДокументСсылка.РасходныйОрдерНаТовары") Тогда			
		
		Если Документ.ТоварыПоРаспоряжениям.Количество() > 0 Тогда
			
			Распоряжение = Документ.ТоварыПоРаспоряжениям[0].Распоряжение;
			
			Если Распоряжение <> Неопределено Тогда				
				
				Попытка 
					
					Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Распоряжение, "Контрагент");											
					
				Исключение						
					
					Получатель = Справочники.Организации.ПустаяСсылка();
					
				КонецПопытки;
				
			КонецЕсли;	
			
		КонецЕсли; 
		
	ИначеЕсли ДокументТип = Тип("ДокументСсылка.ПриходныйОрдерНаТовары") Тогда
		
		РольСклада = "Получатель";
		
		Распоряжение = Документ.Распоряжение;
		
		Если Распоряжение <> Неопределено Тогда 			
			
			Попытка 
				
				Получатель = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Распоряжение, "Организация");								
				
			Исключение 				
				
				Получатель = Справочники.Организации.ПустаяСсылка();
				
			КонецПопытки;
			
		КонецЕсли;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;				
	
	ЗаполнитьУчастникаПеревозки("Получатель", Получатель);
	
	Если ЭтоПеремещение Тогда					
		
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Документ.СкладПолучатель, Справочники.ВидыКонтактнойИнформации.АдресСклада, ТекущаяДата(), Ложь);
		
		Если КонтактнаяИнформация.Количество() Тогда					
			
			ТекущиеДанные["ПолучательАдресПредставление"] = КонтактнаяИнформация[0].Представление;
			ТекущиеДанные["ПолучательАдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
			
		КонецЕсли;
		
	ИначеЕсли ЭтоТранспортнаяНакладная Тогда		
			
		Если ЗначениеЗаполнено(Документ.АдресДоставки) Тогда
			
			ТекущиеДанные["ПолучательАдресПредставление"] = Документ.АдресДоставки;
			ТекущиеДанные["ПолучательАдресЗначение"] = Документ.АдресДоставкиЗначенияПолей; 	
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(РольСклада) Тогда
		
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Документ.Склад, Справочники.ВидыКонтактнойИнформации.АдресСклада, ТекущаяДата(), Ложь);
		
		Если КонтактнаяИнформация.Количество() Тогда					
			
			ТекущиеДанные[РольСклада + "АдресПредставление"] = КонтактнаяИнформация[0].Представление;
			ТекущиеДанные[РольСклада + "АдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
			
		КонецЕсли;				
		
	КонецЕсли; 				
	
	Если ТекущиеДанные.СпособДоставки = 1 Тогда
		
		ТекущиеДанные["ПолучательАдресПредставление"] = "";	
		ТекущиеДанные["ПолучательАдресЗначение"] = "";
		
	КонецЕсли;
	
	ВариантЗаполненияВГХ = Константы.ДЛ_ЗаполнениеВГХ.Получить(); 
	
	Если ЗначениеЗаполнено(ВариантЗаполненияВГХ) Тогда
		
		ЗаполнитьВГХПоДокументамОснованиям(ВариантЗаполненияВГХ);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчастникаПеревозки(Префикс, Участник) 
	
	ТекущиеДанные = ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока);	
	
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Организации") Тогда 			
		
		Наименование = Участник.НаименованиеСокращенное;
		ЭтоОрганизация = Истина;  
		
	ИначеЕсли ТипЗнч(Участник) = Тип("СправочникСсылка.Контрагенты") Тогда			
		
		Наименование = Участник.НаименованиеПолное;
		ЭтоОрганизация = Ложь;  
		
	Иначе
		
		Возврат; 
		
	КонецЕсли;
	
	ТекущиеДанные[Префикс + "КонтрагентСсылка"] = Участник;
	ТекущиеДанные[Префикс + "КонтрагентНаименование"] = Наименование;
	ТекущиеДанные[Префикс + "КонтрагентИНН"] = Участник.ИНН;	
	ТекущиеДанные[Префикс + "КонтрагентЭтоОрганизация"] = ЭтоОрганизация;
	
	ЮрФизЛицо = 0; 
	
	УчастникЮрФизЛицо = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(Участник, "ЮрФизЛицо");
	
	Если УчастникЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
		
		ЮрФизЛицо = 1;
		
	ИначеЕсли УчастникЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда  
		
		ЮрФизЛицо = 2;
		
	ИначеЕсли УчастникЮрФизЛицо = Перечисления.ЮрФизЛицо.ИндивидуальныйПредприниматель Тогда  
		
		ЮрФизЛицо = 3;
		
	КонецЕсли;
	
	ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"] = ЮрФизЛицо; 
	
	Если ЮрФизЛицо <> 2 Тогда
		
		ВидКИ = ?(ЭтоОрганизация, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
		
		КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Участник, ВидКИ, ТекущаяДата(), Ложь);
		
		Если КонтактнаяИнформация.Количество() Тогда			
			
			ТекущиеДанные[Префикс + "АдресПредставление"] = КонтактнаяИнформация[0].Представление;
			ТекущиеДанные[Префикс + "АдресЗначение"] = КонтактнаяИнформация[0].Значение; 			
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ЭтоОрганизация Тогда  
		
		ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"] = СокрЛП(ПараметрыСеанса.ТекущийПользователь);	
		ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(ПараметрыСеанса.ТекущийПользователь);	
		
	Иначе	
		
		СписокКонтактныхЛиц = ПолучитьСписокКонтактныхЛиц(Префикс + "КонтрагентСсылка");
		
		Если СписокКонтактныхЛиц.Количество() > 0 Тогда
			
			ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"] = СокрЛП(СписокКонтактныхЛиц[0].Значение);	
			ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(СписокКонтактныхЛиц[0].Значение);	
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьТелефоныКонтактногоЛица(КонтактноеЛицо)
	
	Результат = "";
	
	Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда
		
		Телефоны = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(КонтактноеЛицо, Перечисления.ТипыКонтактнойИнформации.Телефон, ТекущаяДата(), Ложь); 	  
		
		Результат = СтрСоединить(Телефоны.ВыгрузитьКолонку("Представление"), "; ");		 		 		
		
	КонецЕсли; 
	
	Возврат Результат;
	
Конецфункции

&НаСервере
Функция ПолучитьСписокКонтактныхЛиц(ИмяРеквизита)
	
	Результат = Новый СписокЗначений; 
	
	ТекущиеДанные = ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока);
	
	Если ЗначениеЗаполнено(ТекущиеДанные[ИмяРеквизита]) И ЗначениеЗаполнено(ТекущиеДанные[СтрЗаменить(ИмяРеквизита, "Ссылка", "Наименование")]) 
		И ЗначениеЗаполнено(ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные[ИмяРеквизита], "Партнер")) Тогда  		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	КонтактныеЛицаПартнеров.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров
		|ГДЕ
		|	НЕ КонтактныеЛицаПартнеров.ПометкаУдаления
		| 	И КонтактныеЛицаПартнеров.Владелец = &Владелец";   
		Запрос.УстановитьПараметр("Владелец", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные[ИмяРеквизита], "Партнер")); 
		
		Выборка = Запрос.Выполнить().Выбрать(); 
		
		Результат.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")); 		 		
		
	КонецЕсли; 
	
	Возврат Результат;
	
Конецфункции

&НаСервере
Процедура ЗаполнитьВГХПоДокументамОснованиям(СпособГруппировкиТоваров)   
	
	ТаблицаТовары = ИнициализироватьТаблицуТоваров(); 
	
	ТекущиеДанные = ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока); 
	
	Для Каждого Документ Из ТекущиеДанные.ДокументыОснования Цикл
		
		Если ЗначениеЗаполнено(Документ.Документ) Тогда
		
			ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, Документ.Документ);		
			
		КонецЕсли;		
		
	КонецЦикла;		
	
	Если ТаблицаТовары.Количество() > 0 Тогда		
		
		ТекущиеДанные.ГрузВес = ТаблицаТовары.Итог("Вес");
		
		Если СпособГруппировкиТоваров = 1 Тогда		
			
			ТекущиеДанные.ГрузКоличествоГрузовыхМест = 1; 
			ТекущиеДанные.ГрузМаксимальныйВес = ТекущиеДанные.ГрузВес;
			
		Иначе	
			
			ТекущиеДанные.ГрузКоличествоГрузовыхМест = ?(СпособГруппировкиТоваров = 2, ТаблицаТовары.Количество(), ТаблицаТовары.Итог("Количество"));			
			ТаблицаТовары.Сортировать("Вес Убыв"); 
			ТекущиеДанные.ГрузМаксимальныйВес = ТаблицаТовары[0].Вес;
			
		КонецЕсли; 		
		
		ТекущиеДанные.ГрузОбъем = ТаблицаТовары.Итог("Объем");
		ТекущиеДанные.ГрузСтоимость = ТаблицаТовары.Итог("Стоимость");  	
		ТаблицаТовары.Сортировать("Длина Убыв"); 
		ТекущиеДанные.ГрузМаксимальнаяДлина = ТаблицаТовары[0].Длина;		
		ТаблицаТовары.Сортировать("Ширина Убыв"); 
		ТекущиеДанные.ГрузМаксимальнаяШирина = ТаблицаТовары[0].Ширина;		
		ТаблицаТовары.Сортировать("Высота Убыв"); 
		ТекущиеДанные.ГрузМаксимальнаяВысота = ТаблицаТовары[0].Высота;					
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнициализироватьТаблицуТоваров() 
	
	Строка250 = ОбщегоНазначения.ОписаниеТипаСтрока(250);
	Число15_3 = ОбщегоНазначения.ОписаниеТипаЧисло(15, 3); 
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар", Строка250);
	Результат.Колонки.Добавить("Количество", Число15_3);
	Результат.Колонки.Добавить("Длина", Число15_3);
	Результат.Колонки.Добавить("Ширина", Число15_3);
	Результат.Колонки.Добавить("Высота", Число15_3); 
	Результат.Колонки.Добавить("Объем", Число15_3);
	Результат.Колонки.Добавить("Вес", Число15_3);
	Результат.Колонки.Добавить("Стоимость", Число15_3);
	
	Возврат Результат;
	
КонецФункции 

&НаСервереБезКонтекста
Процедура ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, Документ)
		
	ДокументОбъект = Документ.ПолучитьОбъект();	
	МетаданныеОбъекта = ДокументОбъект.Метаданные();
	ИмяДокумента = МетаданныеОбъекта.Имя; 
	
	МинВГХ = ПолучитьМинимальныеЗначенияВГХ();
	
	Если ИмяДокумента = "ВозвратТоваровПоставщику" 
		Или ИмяДокумента = "ЗаказКлиента"
		Или ИмяДокумента = "РеализацияТоваровУслуг"
		Или ИмяДокумента = "ЗаказПоставщику"
		Или ИмяДокумента = "ЗаявкаНаВозвратТоваровОтКлиента"
		Или ИмяДокумента = "ПриобретениеТоваровУслуг"
		Или ИмяДокумента = "ПоступлениеТоваровНаСклад"
		Или ИмяДокумента = "ЗаказНаПеремещение"
		Или ИмяДокумента = "КорректировкаРеализации"
		Или ИмяДокумента = "КорректировкаПриобретения"
		Или ИмяДокумента = "РасходныйОрдерНаТовары" 
		Или ИмяДокумента = "ПриходныйОрдерНаТовары"
		Или ИмяДокумента = "ПеремещениеТоваров" Тогда
		
		Запрос = Новый Запрос; 
		Запрос.УстановитьПараметр("Ссылка", Документ); 
		Запрос.УстановитьПараметр("ЗаполненаЕдиницаИзмеренияВеса",   ЗначениеЗаполнено(Константы.ЕдиницаИзмеренияВеса.Получить()));
		Запрос.Текст = "ВЫБРАТЬ
		|	ТаблицаТоваров.Ссылка КАК Ссылка, 
		|	ТаблицаТоваров.Номенклатура.Наименование КАК Товар,
		|	ТаблицаТоваров.Количество КАК Количество, 
		|	ТаблицаТоваров.Количество * &ТекстЗапросаВес КАК МассаНетто,
		|	ВЫБОР
		|		КОГДА &ЗаполненаЕдиницаИзмеренияВеса
		|			ТОГДА ВЫБОР
		|					КОГДА ТаблицаТоваров.Упаковка.Вес ЕСТЬ NULL 
		|						ТОГДА ТаблицаТоваров.Количество * &ТекстЗапросаВес1
		|					ИНАЧЕ ТаблицаТоваров.КоличествоУпаковок * &ТекстЗапросаВес1
		|				КОНЕЦ
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Вес,
		|	ТаблицаТоваров.Упаковка.Глубина КАК Длина,
		|	ТаблицаТоваров.Упаковка.Ширина КАК Ширина,
		|	ТаблицаТоваров.Упаковка.Высота КАК Высота,
		|	ТаблицаТоваров.Количество * &ТекстЗапросаОбъем КАК Объем,
		|	ТаблицаТоваров.СуммаСНДС КАК Стоимость
		|ИЗ
		|	Документ.&Документ.Товары КАК ТаблицаТоваров
		|ГДЕ
		|   ТаблицаТоваров.Ссылка = &Ссылка
		|	И  ТаблицаТоваров.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
		|	И  ТаблицаТоваров.Номенклатура.ТипНоменклатуры <> ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)";
		
		Если ИмяДокумента = "ЗаказНаПеремещение"
			Или ИмяДокумента = "ПеремещениеТоваров" 			
			Или ИмяДокумента = "ПриходныйОрдерНаТовары"	Тогда	
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.СуммаСНДС", "0");
			
		ИначеЕсли ИмяДокумента = "КорректировкаРеализации" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.Расхождения");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.Ссылка = &Ссылка", "ТаблицаТоваров.Ссылка = &Ссылка
				|И (ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализацию) 
				|ИЛИ ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокРеализаций.УменьшитьРеализациюУчестьПриИнвентаризации))");
			
		ИначеЕсли ИмяДокумента = "КорректировкаПриобретения" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.Расхождения");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.Ссылка = &Ссылка", "ТаблицаТоваров.Ссылка = &Ссылка
				|И (ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУменьшитьСкладскиеОстатки) 
				|ИЛИ ТаблицаТоваров.ВариантОтражения = ЗНАЧЕНИЕ(Перечисление.ВариантыОтраженияКорректировокПоступлений.УменьшитьЗакупкуУчестьПриИнвентаризации))");
			
		ИначеЕсли ИмяДокумента = "РасходныйОрдерНаТовары" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.ОтгружаемыеТовары");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ТаблицаТоваров.СуммаСНДС", "0");
			
		ИначеЕсли ИмяДокумента = "ЗаявкаНаВозвратТоваровОтКлиента" Тогда
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.&Документ.Товары", "Документ.&Документ.ВозвращаемыеТовары");	
			
		КонецЕсли;
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Документ", ИмяДокумента);	
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаВес1",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки(
				"ТаблицаТоваров.Упаковка",
				"ТаблицаТоваров.Номенклатура"));	
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаВес",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки(
				"ТаблицаТоваров.Номенклатура.ЕдиницаИзмерения",
				"ТаблицаТоваров.Номенклатура"));
		Запрос.Текст = СтрЗаменить(
			Запрос.Текст,
			"&ТекстЗапросаОбъем",
			Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаОбъемУпаковки(
				"ТаблицаТоваров.Упаковка",
				"ТаблицаТоваров.Номенклатура")); 		
			
	ИначеЕсли ИмяДокумента = "ТранспортнаяНакладная" Тогда 
		
		Для Каждого ДокументОснованиеТН Из Документ.ДокументыОснования Цикл
			
			ДополнитьТаблицуТоваровПоДокументуОснованию(ТаблицаТовары, ДокументОснованиеТН.ДокументОснование);	
			
		КонецЦикла;   
		
		Возврат;
		
	Иначе
		
		Возврат;			
		
	КонецЕсли; 
	
	ПересчитыватьВалютуДокумента = Ложь;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Валюта", МетаданныеОбъекта) Тогда  		
		
		ВалютаРегламентированногоУчета 	= ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		
		Если Документ.Валюта <> ВалютаРегламентированногоУчета Тогда
			
			СтруктурыКурсов = ВзаиморасчетыСервер.КурсыВалютДляПересчета(
				ДокументОбъект, 
				Документ.Валюта, 
				ВалютаРегламентированногоУчета, 
				ВалютаРегламентированногоУчета, 
				Документ.Дата);
			
			ПересчитыватьВалютуДокумента = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
		
	Выборка = Запрос.Выполнить().Выбрать();  
	
	Пока Выборка.Следующий() Цикл 
		
		СтрокаТовара = ТаблицаТовары.Добавить(); 
		ЗаполнитьЗначенияСвойств(СтрокаТовара, Выборка);
		СтрокаТовара.Стоимость = Макс(СтрокаТовара.Стоимость, - СтрокаТовара.Стоимость);
		
		Если ПересчитыватьВалютуДокумента Тогда
			
			СтрокаТовара.Стоимость = РаботаСКурсамиВалютУТ.ПересчитатьПоКурсу(
				СтрокаТовара.Стоимость,
				СтруктурыКурсов.СтруктураКурсовСтаройВалюты,
				СтруктурыКурсов.СтруктураКурсовНовойВалюты);
			
		КонецЕсли;		
		
		Если Не ЗначениеЗаполнено(Выборка.Длина) Тогда 
			
			СтрокаТовара.Длина = МинВГХ.МинимальнаяДлина;		
			
		КонецЕсли;  
		
		Если Не ЗначениеЗаполнено(Выборка.Ширина) Тогда 
			
			СтрокаТовара.Ширина = МинВГХ.МинимальнаяШирина;			
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Высота) Тогда  
			
			СтрокаТовара.Высота = МинВГХ.МинимальнаяВысота;			
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Объем) Тогда 
			
			СтрокаТовара.Объем = МинВГХ.МинимальныйОбъем; 			
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Вес) Тогда  
			
			СтрокаТовара.Вес = МинВГХ.МинимальныйВес; 	 				
			
		КонецЕсли; 					
		                    	
	КонецЦикла;

КонецПроцедуры  

&НаСервереБезКонтекста
Функция ПолучитьМинимальныеЗначенияВГХ()
	
	Результат = Новый Структура;
	
	МинимальнаяДлина = Константы.ДЛ_МинимальнаяДлина.Получить();
	Результат.Вставить("МинимальнаяДлина", ?(ЗначениеЗаполнено(МинимальнаяДлина), МинимальнаяДлина, 0.1)); 
	МинимальнаяШирина = Константы.ДЛ_МинимальнаяШирина.Получить();
	Результат.Вставить("МинимальнаяШирина", ?(ЗначениеЗаполнено(МинимальнаяШирина), МинимальнаяШирина, 0.1));
	МинимальнаяВысота = Константы.ДЛ_МинимальнаяВысота.Получить();
	Результат.Вставить("МинимальнаяВысота", ?(ЗначениеЗаполнено(МинимальнаяВысота), МинимальнаяВысота, 0.1));
	МинимальныйОбъем = Константы.ДЛ_МинимальныйОбъем.Получить();
	Результат.Вставить("МинимальныйОбъем", ?(ЗначениеЗаполнено(МинимальныйОбъем), МинимальныйОбъем, 0.01));
	МинимальныйВес = Константы.ДЛ_МинимальныйВес.Получить();  
	Результат.Вставить("МинимальныйВес", ?(ЗначениеЗаполнено(МинимальныйВес), МинимальныйВес, 1));	
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Процедура ТаблицаЗаказыПлательщикНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	ТекущиеДанные = Элементы.ТаблицаЗаказы.ТекущиеДанные;
	
	ОО = Новый ОписаниеОповещения("ВвестиПлательщикаЗвершение", ЭтаФорма); 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПлательщикЗаЗабор", ТекущиеДанные.ПлательщикЗаЗабор);
	ПараметрыФормы.Вставить("ПлательщикЗаПеревозку", ТекущиеДанные.ПлательщикЗаПеревозку);
	ПараметрыФормы.Вставить("ПлательщикКонтактноеЛицоНаименование", ТекущиеДанные.ПлательщикКонтактноеЛицоНаименование);
	ПараметрыФормы.Вставить("ПлательщикКонтактноеЛицоТелефонПредставление", ТекущиеДанные.ПлательщикКонтактноеЛицоТелефонПредставление);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентИНН", ТекущиеДанные.ПлательщикКонтрагентИНН);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентНаименование", ТекущиеДанные.ПлательщикКонтрагентНаименование);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентСсылка", ТекущиеДанные.ПлательщикКонтрагентСсылка);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентЭтоОрганизация", ТекущиеДанные.ПлательщикКонтрагентЭтоОрганизация);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентЮрФизЛицо", ТекущиеДанные.ПлательщикКонтрагентЮрФизЛицо); 
	ПараметрыФормы.Вставить("СпособОтгрузки", СпособОтгрузки);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ВводПлательщика", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПлательщикаЗвершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = Элементы.ТаблицаЗаказы.ТекущиеДанные;		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗаказы(Команда)
	
	Результат = РасчетИСозданиеЗаказов(); 
	
	ОбновитьСтатусТаблицы();
	
	ПодключитьОбработчикОжидания("ПроверитьГотовностьЗаказов", 1, Ложь); 
	
КонецПроцедуры  

&НаСервере
Функция РасчетИСозданиеЗаказов()         
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказы Цикл  
		
		Если СокрЛП(СтрокаЗаказа.Статус) = "" Или Лев(СтрокаЗаказа.Статус, 6) = "Ошибка" Тогда
		
			ДлительнаяОперация = РасчетИСозданиеЗаказа(СтрокаЗаказа); 
			
			СтрокаЗаказа.Статус = "В процессе отправки";  
			
			СтрокаОтправки = ТаблицаОтправок.Добавить();
			СтрокаОтправки.ИДСтроки = ТаблицаЗаказы.Индекс(СтрокаЗаказа);
			СтрокаОтправки.ИдентификаторЗадания = ДлительнаяОперация.ИдентификаторЗадания;
			СтрокаОтправки.АдресРезультата = ДлительнаяОперация.АдресРезультата;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецФункции

&НаСервере
Функция РасчетИСозданиеЗаказа(СтрокаЗаказа)	 	
	
	СтруктураПараметровЗаказа = Новый Структура;
	СтруктураПараметровЗаказа.Вставить("appkey", ДЛ_ДеловыеЛинии.AppKey());
	СтруктураПараметровЗаказа.Вставить("sessionID", ДЛ_ДеловыеЛинии.SessionID());	
	СтруктураПараметровЗаказа.Вставить("delivery", ЗаполнитьПараметрИнформацияОПреревозке(СтрокаЗаказа));
	СтруктураПараметровЗаказа.Вставить("members", ЗаполнитьПараметрУчастникиПеревозки(СтрокаЗаказа));
	СтруктураПараметровЗаказа.Вставить("cargo", ЗаполнитьПараметрСтруктураГруза(СтрокаЗаказа));  
	СтруктураПараметровЗаказа.Вставить("payment", ЗаполнитьПараметрСруктураОплаты(СтрокаЗаказа)); 
	СтруктураПараметровЗаказа.Вставить("productInfo", ЗаполнитьПараметрСтруктураИнформацияПоПродукту());		
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ЭтаФорма.УникальныйИдентификатор, "ДЛ_ДеловыеЛинии.ПолучитьРасчетКалькулятораОформитьЗаказ", СтруктураПараметровЗаказа, "РазмещениеЗаказа", Истина);	
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрИнформацияОПреревозке(ТекущиеДанные)	
	
	Результат = Новый Структура;	
	Результат.Вставить("deliveryType", Новый Структура("type", ПолучитьВидДоставкиПоПредставлению(ТекущиеДанные.ВидДоставки))); 
	Результат.Вставить("derival", ПолучитьСтруктуруОтправленияПолучение("Отправитель", ТекущиеДанные));
	Результат.Вставить("arrival", ПолучитьСтруктуруОтправленияПолучение("Получатель", ТекущиеДанные)); 	
	Результат.Вставить("packages", ЗаполнитьПараметрДополнительныеУслуги(ТекущиеДанные));
	Результат.Вставить("accompanyingDocuments", ЗаполнитьПараметрСопроводительныеДокументы(ТекущиеДанные));  
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ДополнительнаяИнформация) Тогда
	
		Результат.Вставить("comment", Лев(СокрЛП(ТекущиеДанные.ДополнительнаяИнформация), 500));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

&НаСервере
Функция ПолучитьВидДоставкиПоПредставлению(ВидДоставки)
	
	Результат = "";
	
	Если ВидДоставки = "Экспресс-перевозка" Тогда
		
		Результат = "express"; 
		
	ИначеЕсли ВидДоставки = "Автоперевозка" Тогда
		
		Результат = "auto";
		
	ИначеЕсли ВидДоставки = "Авиаперевозка" Тогда
		
		Результат = "avia";
		
	ИначеЕсли ВидДоставки = "Доставка малогабаритного груза" Тогда
		
		Результат = "small";
		
	ИначеЕсли ВидДоставки = "Доставка документов" Тогда
		
		Результат = "letter";	
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ПолучитьСтруктуруОтправленияПолучение(Префикс, СтрокаЗаказа) 
	
	ТекущиеДанные = ?(Префикс = "Получатель", СтрокаЗаказа, ЭтаФорма);	
	
	Результат = Новый Структура; 
	
	Если Префикс = "Отправитель" Тогда
		
		Результат.Вставить("produceDate", Формат(ДатаОтгрузки, "ДФ='гггг-ММ-дд'"));  
		
		Идентификатор1 = "Отгрузки";
		Идентификатор2 = "Отгрузка";
		
	Иначе  
		
		Идентификатор1 = "Доставки";
		Идентификатор2 = "Доставка";		
		
	КонецЕсли;  
	
	Если ТекущиеДанные["Способ" + Идентификатор1] = 0 Тогда
		
		Результат.Вставить("variant", "address"); 
		Результат.Вставить("address", Новый Структура("search", ТекущиеДанные[Префикс + "АдресПредставление"])); 		
		Результат.Вставить("time", ЗаполнитьПараметрВремя(Идентификатор1)); 
		Результат.Вставить("requirements", ЗаполнитьПараметрДополнительныеТребования(Идентификатор2, ТекущиеДанные));
		
		Если ТекущиеДанные[Идентификатор2 + "ПогрузочноРазгрузочныеРаботы"] Тогда
			
			Результат.Вставить("handling", ЗаполнитьПараметрПогрузоРазгрузочныеРаботы(Идентификатор2, ТекущиеДанные));	
			
		КонецЕсли; 		
		
	ИначеЕсли ТекущиеДанные["Способ" + Идентификатор1] = 1 Тогда 
		
		Результат.Вставить("variant", "terminal"); 
		Результат.Вставить("terminalID", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные[Префикс + "Терминал"], "ИДтерминала"));
		
	КонецЕсли;
	
	Если Префикс = "Отправитель" И СпособОтгрузки = 0 И ЗначениеЗаполнено(СтрокаЗаказа["ПлательщикЗаЗабор"]) Тогда
	
		Результат.Вставить("payer", СтрокаЗаказа["ПлательщикЗаЗабор"]);
		
	КонецЕсли;	
	
	Возврат Результат;	 
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрВремя(ИдентификаторРеквизита)  

	Результат = Новый Структура;	
	Результат.Вставить("worktimeStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "С"], "ДФ='ЧЧ:мм'"));
	Результат.Вставить("worktimeEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "По"], "ДФ='ЧЧ:мм'"));
	
	Если ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"]) И 
		ЗначениеЗаполнено(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"]) Тогда
	
		Результат.Вставить("breakStart", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедС"], "ДФ='ЧЧ:мм'"));
		Результат.Вставить("breakEnd", Формат(ЭтаФорма["Время" + ИдентификаторРеквизита + "ОбедПо"], "ДФ='ЧЧ:мм'"));
		
	КонецЕсли;	
	
	Результат.Вставить("exactTime", ЭтаФорма[?(ИдентификаторРеквизита = "Отгрузки", "Отправитель", "Получатель") + "ФиксированноеВремя"]);		
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрДополнительныеТребования(Префикс, ТекущиеДанные) 	
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТекущиеДанные[Префикс + "ДополнительныеТребованияТС"]) Тогда
		
		Результат.Добавить(ТекущиеДанные[Префикс + "ДополнительныеТребованияТС"]);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрПогрузоРазгрузочныеРаботы(Префикс, ТекущиеДанные) 	

	Результат = Новый Структура;
	Результат.Вставить("freightLift", ТекущиеДанные[Префикс + "ПогрузочноРазгрузочныеРаботыЛифт"]);
	Результат.Вставить("toFloor", ТекущиеДанные[Префикс + "ПогрузочноРазгрузочныеРаботыДоЭтажа"]);
	Результат.Вставить("carry", ТекущиеДанные[Префикс + "ПогрузочноРазгрузочныеРаботыРасстояниеПроноса"]); 
	
	Плательщик = ТекущиеДанные[Префикс + "ПогрузочноРазгрузочныеРаботыПлательщик"];   
	
	Если Плательщик = "Отправитель" Тогда 
		
		Результат.Вставить("payer", "sender");
		
	ИначеЕсли Плательщик = "Получатель" Тогда
		
		Результат.Вставить("payer", "receiver");	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция  ЗаполнитьПараметрДополнительныеУслуги(ТекущиеДанные)
	
	ДополнительныеУслугиПлательщик = ТекущиеДанные.ДополнительныеУслугиПлательщик;  
	
	Результат = Новый Массив;  
	
	ПлательщикДополнительныхУслугОтличается = Ложь;
	
	Если ДополнительныеУслугиПлательщик = "Отправитель" Тогда
		
		ПлательщикДополнительныхУслугОтличается = Истина;
		Плательщик = "sender";
		
	ИначеЕсли ДополнительныеУслугиПлательщик = "Получатель" Тогда  
		
		ПлательщикДополнительныхУслугОтличается = Истина;
		Плательщик = "receiver"
		
	КонецЕсли;
	
	Для Каждого ДополнительнаяУслуга Из ТекущиеДанные.ДопУслугиЗначения Цикл
		
		Если ДополнительнаяУслуга.Использовать Тогда
			
			СтруктураУслуги = Новый Структура;
			СтруктураУслуги.Вставить("uid", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ДополнительнаяУслуга.Услуга, "UID")); 
			СтруктураУслуги.Вставить("count", ДополнительнаяУслуга.Количество); 
			
			Если ПлательщикДополнительныхУслугОтличается Тогда
				
				СтруктураУслуги.Вставить("payer", Плательщик);	
				
			КонецЕсли;
			
			Результат.Добавить(СтруктураУслуги);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция  ЗаполнитьПараметрСопроводительныеДокументы(ТекущиеДанные) 	
	
	Результат = Новый Массив;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СопроводительныеДокументы) Тогда
		
		Если ТекущиеДанные.СопроводительныеДокументы = "both" Тогда 
			
			Если ЗначениеЗаполнено(ТекущиеДанные.СопроводительныеДокументыПлательщик) Тогда
				
				Результат.Добавить(Новый Структура("action, payer", "send", ТекущиеДанные.СопроводительныеДокументыПлательщик));
				Результат.Добавить(Новый Структура("action, payer", "return", ТекущиеДанные.СопроводительныеДокументыПлательщик));	
				
			Иначе
			
				Результат.Добавить(Новый Структура("action", "send"));
				Результат.Добавить(Новый Структура("action", "return"));
			
			КонецЕсли;
			
		Иначе 
			
			Если ЗначениеЗаполнено(ТекущиеДанные.СопроводительныеДокументыПлательщик) Тогда 
				
				Результат.Добавить(Новый Структура("action, payer", ТекущиеДанные.СопроводительныеДокументы, ТекущиеДанные.СопроводительныеДокументыПлательщик));
				
			Иначе	
			
				Результат.Добавить(Новый Структура("action", ТекущиеДанные.СопроводительныеДокументы));
				
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция ЗаполнитьПараметрСтруктураИнформацияПоПродукту()  	 
	
	Результат = Новый Структура;
	Результат.Вставить("type", 7);
	Результат.Вставить("productType", 19);
	
	Массивinfo = Новый Массив;
	
	ПараметрыТекущейВерсии = ДЛ_ДеловыеЛинииПовтИсп.ПолучитьПараметрыТекцущейВерсии();
	
	Если ПараметрыТекущейВерсии.Свойство("Версия") Тогда
		
		Массивinfo.Добавить(Новый Структура("param, value","module version", Лев(ПараметрыТекущейВерсии.Идентификатор, 1) + "_" + ПараметрыТекущейВерсии.Версия));	
		
	КонецЕсли;
	
	Результат.Вставить("info", Массивinfo); 
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбработатьРезультатРасчетаИСозданияЗаказа(РезультатЗапроса, ТекущиеДанные) 	
	
	Если РезультатЗапроса["data"] <> Неопределено Тогда  		
		
		НомерЗаказа = СтрЗаменить(РезультатЗапроса["data"]["requestID"], Символы.НПП, "");
		
		СоздатьДокументВБазе(НомерЗаказа, ТекущиеДанные); 		 						
			
		СохранитьАдресаВАдреснуюКнигу(ТекущиеДанные);
		
		ТекущиеДанные.Статус = "Заказ №" + НомерЗаказа;
		
	ИначеЕсли РезультатЗапроса["errors"] <> Неопределено Тогда
		
		ТаблицаОшибок = ЗаполнитьТаблицуОшибок(РезультатЗапроса["errors"]);					
		
		ТекстОшибки = "";
		
		Для Каждого ОшибкаЗапроса Из ТаблицаОшибок Цикл
			
			ТекстОшибки = ТекстОшибки + СообщениеОбОшибкеЗаказа(ОшибкаЗапроса) + Символы.ПС + Символы.ПС;	
			
		КонецЦикла;  
		
		ТекущиеДанные.ТекстОшибки = ТекстОшибки;
		ТекущиеДанные.Статус = "Ошибка. " + ТекущиеДанные.ТекстОшибки;
		
	Иначе
		
		ТекущиеДанные.ТекстОшибки = "Ошибка выполнения запроса. Попробуйте еще раз";
		ТекущиеДанные.Статус = "Ошибка. " + ТекущиеДанные.ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументВБазе(НомерЗаказа, ТекущиеДанные) 	
	
	НовыйДок = Документы.ДЛ_ЗаявкаНаДоставку.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДатаСеанса();
	
	Если ТекущиеДанные.ДокументыОснования.Количество() > 0  Тогда
		
		Для Каждого ДокОснование Из ТекущиеДанные.ДокументыОснования Цикл
			
			ДокОсн = НовыйДок.ДокументыОснования.Добавить();
			ДокОсн.Документ = ДокОснование.Документ;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
	НовыйДок.НомерЗаказа = НомерЗаказа; 	
		
	НовыйДок.Записать();  
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьАдресаВАдреснуюКнигу(ТекущиеДанные) 	
	
	Если СпособОтгрузки = 0 Тогда 
		
		СохранитьАдресВАдреснуюКнигу("Отправитель", ТекущиеДанные);	
		
	КонецЕсли;
	
	Если ТекущиеДанные.СпособДоставки = 0 Тогда  
		
		СохранитьАдресВАдреснуюКнигу("Получатель", ТекущиеДанные);	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьАдресВАдреснуюКнигу(Префикс, СтрокаЗаказа) 
	
	ТекущиеДанные = ?(Префикс = "Получатель", СтрокаЗаказа, ЭтаФорма);
	
	УчастникГрузоперевозки = ТекущиеДанные[Префикс + "КонтрагентСсылка"];
	СохраняемыйАдрес = СокрЛП(ТекущиеДанные[Префикс + "АдресПредставление"]);
	
	Если ЗначениеЗаполнено(УчастникГрузоперевозки) И СтрДлина(СохраняемыйАдрес) < 400 Тогда
		
		Запись = РегистрыСведений.ДЛ_АдреснаяКнига.СоздатьМенеджерЗаписи();
		Запись.УчастникГрузоперевозки = УчастникГрузоперевозки;		
		Запись.Адрес = СохраняемыйАдрес; 
		Запись.НаселнныйПункт = ТекущиеДанные[Префикс + "Город"];
		Запись.ДатаИспользования = ТекущаяДатаСеанса();
		Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
		Запись.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПараметрСруктураОплаты(ТекущиеДанные) 	
	
	Если ТекущиеДанные.ПлательщикЗаПеревозку = "third" Тогда
		
		ЮрФизЛицо = ТекущиеДанные.ПлательщикКонтрагентЮрФизЛицо;
		
	ИначеЕсли ТекущиеДанные.ПлательщикЗаПеревозку = "sender" Тогда	
		
		ЮрФизЛицо = ОтправительКонтрагентЮрФизЛицо;
		
	ИначеЕсли ТекущиеДанные.ПлательщикЗаПеревозку = "receiver" Тогда
		
		ЮрФизЛицо = ТекущиеДанные.ПолучательКонтрагентЮрФизЛицо;
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("type", ?(ЮрФизЛицо =  2, "cash", "noncash"));	
	Результат.Вставить("paymentCity", "7700000000000000000000000"); //Всегда Москва 	
	
	Результат.Вставить("primaryPayer", ТекущиеДанные.ПлательщикЗаПеревозку);  
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ВнутреннийНомер) Тогда
		
		Результат.Вставить("cashOnDelivery", ЗаполнитьПараметрВнутреннийНомерЗаказа(ТекущиеДанные.ВнутреннийНомер));	
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции      

&НаСервере
Функция ЗаполнитьПараметрВнутреннийНомерЗаказа(ВнутреннийНомер)
	
	Результат = Новый Массив;	
	Результат.Добавить(Новый Структура("orderNumber", ВнутреннийНомер));  
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрСтруктураГруза(ТекущиеДанные) 
	
	Результат = Новый Структура;  	
	
	Результат.Вставить("length", ТекущиеДанные.ГрузМаксимальнаяДлина);
	Результат.Вставить("width", ТекущиеДанные.ГрузМаксимальнаяШирина);
	Результат.Вставить("height", ТекущиеДанные.ГрузМаксимальнаяВысота);
	Результат.Вставить("weight", ТекущиеДанные.ГрузМаксимальныйВес);
	Результат.Вставить("totalVolume", ТекущиеДанные.ГрузОбъем);
	Результат.Вставить("totalWeight", ТекущиеДанные.ГрузВес);  
	
	ЗапросВидДоставки = ПолучитьВидДоставкиПоПредставлению(ТекущиеДанные.ВидДоставки);	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_ПараметрыНГГ.Длина КАК Длина,
	|	ДЛ_ПараметрыНГГ.Ширина КАК Ширина,
	|	ДЛ_ПараметрыНГГ.Высота КАК Высота,
	|	ДЛ_ПараметрыНГГ.Вес КАК Вес,
	|	ДЛ_ПараметрыНГГ.Объем КАК Объем
	|ИЗ
	|	Справочник.ДЛ_ПараметрыНГГ КАК ДЛ_ПараметрыНГГ
	|ГДЕ
	|	НЕ ДЛ_ПараметрыНГГ.ПометкаУдаления
	|	И ДЛ_ПараметрыНГГ.UID = &UID
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛ_ПараметрыНГГ.Наименование";
	Запрос.УстановитьПараметр("UID", ?(ЗапросВидДоставки = "small", "cargo_small", ЗапросВидДоставки)); 
	
	ПараметрыНГГ = Запрос.Выполнить().Выгрузить();
	
	Если ПараметрыНГГ.Количество() > 0 Тогда  
		
		ПараметрНГГ = Новый Структура;
		ПараметрНГГ.Вставить("Длина", Число(ПараметрыНГГ[0].Длина));		  
		ПараметрНГГ.Вставить("Ширина",  Число(ПараметрыНГГ[0].Ширина));
		ПараметрНГГ.Вставить("Высота",  Число(ПараметрыНГГ[0].Высота));
		ПараметрНГГ.Вставить("Объем",  Число(ПараметрыНГГ[0].Объем));
		ПараметрНГГ.Вставить("Вес",  Число(ПараметрыНГГ[0].Вес));
		
		Если (ПараметрНГГ.Длина > 0 И ПараметрНГГ.Длина < ТекущиеДанные.ГрузМаксимальнаяДлина) Или
			(ПараметрНГГ.Ширина > 0 И ПараметрНГГ.Ширина < ТекущиеДанные.ГрузМаксимальнаяШирина) Или
			(ПараметрНГГ.Высота > 0 И ПараметрНГГ.Высота < ТекущиеДанные.ГрузМаксимальнаяВысота) Или
			(ПараметрНГГ.Вес > 0 И ПараметрНГГ.Вес < ТекущиеДанные.ГрузМаксимальныйВес) Или
			(ПараметрНГГ.Объем > 0 И ПараметрНГГ.Объем < ТекущиеДанные.ГрузОбъем) Тогда
			
			Результат.Вставить("oversizedVolume", ТекущиеДанные.ГрузОбъем);	
			Результат.Вставить("oversizedWeight", ТекущиеДанные.ГрузМаксимальныйВес);
			
		КонецЕсли; 		 			
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ГрузСтоимость) Тогда
		
		Результат.Вставить("insurance",  Новый Структура("statedValue", ТекущиеДанные.ГрузСтоимость));
		
	КонецЕсли;	
	
	Результат.Вставить("freightUID", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные.ХарактерГруза, "UID"));
	Результат.Вставить("quantity", ТекущиеДанные.ГрузКоличествоГрузовыхМест);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрУчастникиПеревозки(ТекущиеДанные) 	
	
	Результат = Новый Структура; 
	
	СтруктураОтправительзапроса = Новый Структура;
	
	Если ЗначениеЗаполнено(НашаРольВПеревозке) Тогда
		
		СтруктураОтправительзапроса.Вставить("role", НашаРольВПеревозке);
		
	КонецЕсли; 
	
	НашИД = ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ЗаказчикКонтрагентСсылка, "UID");
	
	Если ЗначениеЗаполнено(НашИД) Тогда 
		
		СтруктураОтправительзапроса.Вставить("uid", НашИД);
		
	КонецЕсли;	
	
	Результат.Вставить("sender", ЗаполнитьПараметрУчастникПеревозки("Отправитель", ТекущиеДанные));		
	Результат.Вставить("receiver", ЗаполнитьПараметрУчастникПеревозки("Получатель", ТекущиеДанные));
	
	Если ТекущиеДанные.ПлательщикЗаЗабор = "third" Или ТекущиеДанные.ПлательщикЗаПеревозку = "third" Тогда
		
		Результат.Вставить("third", ЗаполнитьПараметрУчастникПеревозки("Плательщик", ТекущиеДанные));
		
	КонецЕсли;
	
	Результат.Вставить("requester", СтруктураОтправительзапроса);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьПараметрУчастникПеревозки(Префикс, СтрокаЗаказа)
	
	ТекущиеДанные = ?(Префикс <> "Отправитель", СтрокаЗаказа, ЭтаФорма);
	
	Результат = Новый Структура;
	
	КонтрагентСсылка = ТекущиеДанные[Префикс + "КонтрагентСсылка"];
	КонтрагентНаименование = ТекущиеДанные[Префикс + "КонтрагентНаименование"];
	КонтрагентЮрФизЛицо = ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"];
	КонтрагентИНН = ТекущиеДанные[Префикс + "КонтрагентИНН"];	
	КонтактноеЛицо = ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"]; 
	Телефон = ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"];
	
	Если Префикс <> "Плательщик" Тогда
	
		ОПФ = ТекущиеДанные[Префикс + "КонтрагентОПФ"];
		
	КонецЕсли;	
	
	ПараметрыКонтрагента = Новый Структура;		 
	
	Если  Префикс = "Получатель" И ТекущиеДанные.УпрощеннаяОтправка Тогда
		
		ПараметрыКонтрагента.Вставить("isAnonym", Истина);
		ПараметрыКонтрагента.Вставить("name", ТекущиеДанные.ПолучательКонтактноеЛицоНаименование); 
		ПараметрыКонтрагента.Вставить("form", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");
		ПараметрыКонтрагента.Вставить("phone", ТолькоЦифры(Телефон));  
		
		Результат.Вставить("counteragent", ПараметрыКонтрагента);  
		
		Возврат Результат;
		
	КонецЕсли; 	
	
	ДанныеДляЭлектронногоЧека = Новый Структура;
	ДанныеДляЭлектронногоЧека.Вставить("send", Ложь);
	Результат.Вставить("dataForReceipt", ДанныеДляЭлектронногоЧека);  
	
	Если КонтрагентЮрФизЛицо = 2 Тогда 
		
		Если Префикс = "Плательщик" Тогда  
			
			ПараметрыКонтрагента.Вставить("form", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A"); 
			
		Иначе	
		
			ПараметрыКонтрагента.Вставить("form", ?(ТекущиеДанные[Префикс + "РучнойВвод"] = 2, ОПФ.UID, "0xAB91FEEA04F6D4AD48DF42161B6C2E7A")); 		
			
		КонецЕсли;	
		
		Паспорт = Новый Структура;
		Паспорт.Вставить("type", "passport"); 
		
		
		Если ТекущиеДанные[Префикс + "РучнойВвод"] = 2 Тогда 
			
			ПаспортныеДанные = КонтрагентИНН; 
			
			СерияНомер = СтрРазделить(ПаспортныеДанные, " ", Ложь);
			
			Если СерияНомер.Количество() > 1 Тогда
				
				Паспорт.Вставить("serial", СерияНомер[0]); 
				Паспорт.Вставить("number", СерияНомер[1]);	
				
			Иначе	
				
				Паспорт.Вставить("number", ПаспортныеДанные);	
				
			КонецЕсли;	
			
		Иначе			
			
			ПаспортныеДанные = ПолучитьПаспортныеДанные(КонтрагентСсылка);
			Паспорт.Вставить("serial", СтрЗаменить(ПаспортныеДанные.Серия, " ", "")); 
			Паспорт.Вставить("number", ПаспортныеДанные.Номер); 				
			
		КонецЕсли;
		
		ПараметрыКонтрагента.Вставить("document", Паспорт); 	
		
	Иначе 
		
		Если Префикс = "Плательщик" Тогда		
			 
			ПараметрыКонтрагента.Вставить("form", ДЛ_ДеловыеЛинии.ПолучитьОПФпоИНН(КонтрагентИНН));				
			
		Иначе			
			
			ПараметрыКонтрагента.Вставить("form", ?(ТекущиеДанные[Префикс + "РучнойВвод"] = 1 И СокрЛП(ТекущиеДанные[Префикс + "КонтрагентСтрана"]) <> "Россия", ОПФ.UID, ДЛ_ДеловыеЛинии.ПолучитьОПФпоИНН(КонтрагентИНН)));			
			
		КонецЕсли;	
		
		ПараметрыКонтрагента.Вставить("inn", КонтрагентИНН);
		
	КонецЕсли;
	
	ПараметрыКонтрагента.Вставить("name", КонтрагентНаименование); 
	
	КонтактныеЛица = Новый Массив;
	
	Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда 
		
		МассивКонтактныеЛица = СтрРазделить(КонтактноеЛицо, ";");
		
		Для Каждого ЭлементКонтактноеЛицо Из МассивКонтактныеЛица Цикл
			
			КонтактныеЛица.Добавить(Новый Структура("name", ЭлементКонтактноеЛицо));	
			
		КонецЦикла;	
		
	КонецЕсли;	
	
	Телефоны = Новый Массив;
	
	Если ЗначениеЗаполнено(Телефон) Тогда	
		
		МассивТелефонов = СтрРазделить(Телефон, ";");
		ТелефоновДобавлено = 0;
		
		Для Каждого НомерТелефона Из МассивТелефонов Цикл
			
			Если ТелефоновДобавлено = 3 Тогда
				
				Прервать;
				
			КонецЕсли;
			
			НомерТелефонаСДобавочным = СтрРазделить(СтрЗаменить(СтрЗаменить(НомерТелефона, Символы.ПС, ""), ", доб. ", Символы.ПС), Символы.ПС, Ложь);
			
			НомерТелефонаОчищенный = ТолькоЦифры(НомерТелефонаСДобавочным[0]);
			
			Если ЗначениеЗаполнено(НомерТелефонаОчищенный) Тогда
				
				СтруктураТелефона = Новый Структура;
				СтруктураТелефона.Вставить("number", НомерТелефонаОчищенный);
				
				Если НомерТелефонаСДобавочным.Количество() = 2  Тогда
					
					СтруктураТелефона.Вставить("ext", ТолькоЦифры(НомерТелефонаСДобавочным[1]));	
					
				КонецЕсли; 
				
				Телефоны.Добавить(СтруктураТелефона);
				
				ТелефоновДобавлено = ТелефоновДобавлено + 1;	
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;	 
	
	Результат.Вставить("counteragent", ПараметрыКонтрагента); 
	Результат.Вставить("contactPersons", КонтактныеЛица); 
	Результат.Вставить("phoneNumbers", Телефоны); 	
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьПаспортныеДанные(КонтрагентСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
	|			,
	|			Физлицо = &Физлицо
	|				И ВидДокумента = &ВидДокумента) КАК ДокументыФизическихЛицСрезПоследних"; 
	Запрос.УстановитьПараметр("Физлицо", КонтрагентСсылка);
	Запрос.УстановитьПараметр("ВидДокумента", Справочники.ВидыДокументовФизическихЛиц.ПаспортРФ);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Новый Структура("Серия, Номер", "", "");
		
	Иначе
		
		Возврат Результат.Выгрузить()[0];
		
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТолькоЦифры(Знач СтрокаДляПроверки)
	
	ЛишниеСимволы = СтрСоединить(СтрРазделить(СтрокаДляПроверки, "0123456789"), "");
	Результат     = СтрСоединить(СтрРазделить(СтрокаДляПроверки, ЛишниеСимволы), "");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаполнитьТаблицуОшибок(Ошибки)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("fields"); 
	Результат.Колонки.Добавить("title");
	Результат.Колонки.Добавить("detail");
	
	ТерминалОтправленияНеНайден = Ложь;
	ТерминалПолученияНеНайден = Ложь;
	
	Для Каждого ОшибкаИзРезультата Из Ошибки Цикл
		
		Если ОшибкаИзРезультата["title"] = "Выбранная дата недоступна" 
			И ОшибкаИзРезультата["detail"] = "Невозможно проверить дату заказа" 
			И (ТерминалПолученияНеНайден Или ТерминалОтправленияНеНайден) Тогда
			
			Продолжить; 
			
		ИначеЕсли ТипЗнч(ОшибкаИзРезультата["fields"]) = Тип("Массив") И ОшибкаИзРезультата["fields"].Количество() > 0 Тогда
			
			Если  ОшибкаИзРезультата["fields"][0] = "delivery.derival.terminalID" Или ОшибкаИзРезультата["fields"][0] = "delivery.derival.address.search" Тогда
				
				ТерминалОтправленияНеНайден = Истина;	
				
			ИначеЕсли ТерминалОтправленияНеНайден И ОшибкаИзРезультата["fields"][0] = "delivery.derival.variant" Тогда  
				
				Продолжить;	
				
			ИначеЕсли ОшибкаИзРезультата["fields"][0] = "delivery.arrival.terminalID"  Или ОшибкаИзРезультата["fields"][0] = "delivery.arrival.address.search" Тогда 
				
				ТерминалПолученияНеНайден = Истина;  
				
			ИначеЕсли ТерминалПолученияНеНайден И ОшибкаИзРезультата["fields"][0] = "delivery.arrival.variant" Тогда  
				
				Продолжить;	
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОшибкаЗапроса = Результат.Добавить();
		ОшибкаЗапроса.title = ОшибкаИзРезультата["title"];  
		ОшибкаЗапроса.detail = ОшибкаИзРезультата["detail"];  
		ОшибкаЗапроса.fields = ОшибкаИзРезультата["fields"];
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СообщениеОбОшибкеЗаказа(ОшибкаЗаказа) 
	
	Сообщение = "";  
	
	Если ТипЗнч(ОшибкаЗаказа["fields"]) = Тип("Массив") И ОшибкаЗаказа["fields"].Количество() > 0 Тогда
		
		ПолеСОшибкой = ОшибкаЗаказа["fields"][0];	
		
		Если ОшибкаЗаказа["title"] = "Ошибка типизации" Тогда 
			
			Если ПолеСОшибкой = "delivery.deliveryType.type" Тогда
				
				Сообщение = "Не заполнен Вид доставки";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.time.worktimeStart" Тогда
				
				Сообщение = "Не заполнено Время начала работы Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.time.worktimeEnd" Тогда
				
				Сообщение = "Не заполнено Время окончания работы Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.produceDate" Тогда
				
				Сообщение = "Дата отгрузки заполнена некорректно";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeStart" Тогда
				
				Сообщение = "Не заполнено Время начала работы Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeEnd" Тогда
				
				Сообщение = "Не заполнено Время окончания работы Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "payment.type" Тогда
				
				Сообщение = "Не заполнена Форма оплаты";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.serial" Тогда
				
				Сообщение = "Проверьте правильность заполнения паспортных данных Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "payment.primaryPayer" Тогда
				
				Сообщение = "Не заполнен Плательщик";
				
			ИначеЕсли ПолеСОшибкой = "payment.cashOnDelivery.cashOnDeliveryItem.orderDate" Тогда
				
				Сообщение = "Не заполнена Дата внутреннего заказа";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.terminalID" Тогда
				
				Сообщение = "Не заполнен Терминал Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.terminalID" Тогда
				
				Сообщение = "Не заполнен Терминал Получателя";	 
				
			ИначеЕсли ПолеСОшибкой = "delivery.packages.package.count" Тогда
				
				Сообщение = "Убедитесь, что количество грузовых мест больше или равно 1";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Убедитесь, что в номере телефона Отправителя не больше 15 символов.";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Убедитесь, что в номере телефона Получателя не больше 15 символов.";
				
			ИначеЕсли ПолеСОшибкой = "produce_date" Тогда
				
				Сообщение = "Неправильный формат даты. Используйте формат YYYY-MM-DD";
				
			ИначеЕсли ПолеСОшибкой = "time.worktimeStart" Тогда
				
				Сообщение = "Неправильный формат времени. Используйте один формат hh:mm.";
				
			ИначеЕсли ПолеСОшибкой = "time.worktimeEnd" Тогда
				
				Сообщение = "Неправильный формат времени. Используйте один формат hh:mm.";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.number" Тогда
				
				Сообщение = ОшибкаЗаказа["detail"];	
				
			КонецЕсли;  
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Отсутствует обязательный параметр" Тогда
			
			Если ПолеСОшибкой = "delivery.derival.address.search" Тогда
				
				Сообщение = "Не заполнен Адрес доставки Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Не заполнен Адрес доставки Получателя";
				
			ИначеЕсли ПолеСОшибкой = "cargo.freightUID" Тогда
				
				Сообщение = "Не заполнен Характер груза";
				
			ИначеЕсли ПолеСОшибкой = "payment.paymentCity" Тогда
				
				Сообщение = "Не заполнено Место оплаты";
				
			ИначеЕсли ПолеСОшибкой = "members.requester.role" Тогда
				
				Сообщение = "Не заполнена роль Заказчика";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.contactPersons.contactPerson.name" Тогда
				
				Сообщение = "Не заполнено Контактное лицо Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.phoneNumbers" Тогда
				
				Сообщение = "Не заполнен Номер телефона Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.contactPersons.contactPerson.name" Тогда
				
				Сообщение = "Не заполнено Контактное лицо Получателя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.phoneNumbers" Тогда
				
				Сообщение = "Не заполнен Номер телефона Получателя"; 
				
			ИначеЕсли ПолеСОшибкой = "delivery.comment" Тогда
				
				Сообщение = "Не заполнен Комментарий";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.juridicalAddress.search" Тогда
				
				Сообщение = "Не заполнен юридический адрес Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.juridicalAddress.search" Тогда
				
				Сообщение = "Не заполнен юридический адрес Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.form" Тогда
				
				Сообщение = "Некорректный ИНН Отправителя";     
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.form" Тогда
				
				Сообщение = "Некорректный ИНН Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "members.sender.dataForReceipt" Тогда
				
				Сообщение = "Не заполнены контактные данные для отправки электронного чека плательщику-физическому лицу";					
			
			ИначеЕсли ПолеСОшибкой = "members.requester.uid" Тогда
				
				Сообщение = "Не заполнен Заказчик";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.dataForReceipt.phone" Тогда
				
				Сообщение = "Не заполнен Номер телефона для электронного чека";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.dataForReceipt.email" Тогда
				
				Сообщение = "Не заполнен Email для электронного чека";	
				
			ИначеЕсли ПолеСОшибкой = "payment.cashOnDelivery.cashOnDeliveryItem.orderNumber" Тогда
				
				Сообщение = "Не заполнен Внутренний номер заказа";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.serial" Тогда
				
				Сообщение = "Не заполнена серия документа Получателя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.number" Тогда
				
				Сообщение = "Не заполнен номер документа Получателя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.dataForReceipt" Тогда
				
				Сообщение = "Не заполнены контактные данные для отправки электронного чека плательщику-физическому лицу";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.document.serial" Тогда
				
				Сообщение = "Не заполнена серия документа Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.document.number" Тогда
				
				Сообщение = "Не заполнен номер документа Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.document" Тогда
				
				Сообщение = "Отсутсвует документ Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document" Тогда
				
				Сообщение = "Отсутсвует документ Получателя";
				
			ИначеЕсли ПолеСОшибкой = "sessionID" Тогда
				
				Сообщение = "Не удалось выполнить Авторизацию. Неверные Логин или Пароль.";	
				
			ИначеЕсли ПолеСОшибкой = "members.third.counteragent.form" Тогда
				
				Сообщение = "Не заполнен Плательщик - Третье лицо";	  
				
			ИначеЕсли ПолеСОшибкой = "members.third.counteragent.name" Тогда
				
				Сообщение = "Не заполнено название Плательщика - Третьего лица";
				
			ИначеЕсли ПолеСОшибкой = "members.third.counteragent.inn" Тогда
				
				Сообщение = "Не заполнен ИНН Плательщика - Третьего лица";	
				
			ИначеЕсли ПолеСОшибкой = "members.third.dataForReceipt" Тогда
				
				Сообщение = "Не заполнены данные для отправки чека";
				
			ИначеЕсли ПолеСОшибкой = "members.third.contactPersons.contactPerson.name" Тогда
				
				Сообщение = "Не заполнены данные контактного лица Плательщика - Третьего лица";	  
				
			ИначеЕсли ПолеСОшибкой = "members.third.phoneNumbers" Тогда
				
				Сообщение = "Не заполнен номер телефона контактного лица Плательщика - Третьего лица";	
				
			ИначеЕсли ПолеСОшибкой = "address.search" Тогда
				
				Сообщение = "Не заполнен Адрес";   
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.name" Тогда
				
				Сообщение = "Не заполнен Получатель";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.inn" Тогда
				
				Сообщение = "Не заполнен ИНН Получателя";	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Услуга недоступна" Тогда	
			
			Если ПолеСОшибкой = "delivery.arrival.terminalID" Тогда
				
				Сообщение = "Перевозка при Самовывозе и Самопривозе в рамках населенного пункта недоступна";
				
			ИначеЕсли ПолеСОшибкой = "delivery.deliveryType" 
				Или ПолеСОшибкой = "delivery.deliveryType.type" Тогда
				
				Сообщение = "Выбранный вид доставки недоступен при выбранных параметрах перевозки";   
				
			ИначеЕсли СтрНайти(ПолеСОшибкой, "cargo.insurance") > 0 Тогда
				
				Сообщение = "Страховка недоступна для указанных параметров перевозки";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.address.search" Тогда
				
				Сообщение = ОшибкаЗаказа["detail"];			
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.variant" Тогда
					
				Сообщение = "Выбранная услуга недоступна для выбранного Способа доставки";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.packages" Тогда
					
				Сообщение = "Выбранная услуга недоступна для указанных параметров перевозки";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.accompanyingDocuments" Тогда
					
				Сообщение = "Действия с Сопроводительными документами не доступны при выбранных параметрах доставки";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.requirements" Тогда
					
				Сообщение = "Услуга не доступна на Терминале Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.requirements" Тогда
					
				Сообщение = "Услуга не доступна  на Терминале Получателя";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.handling" Тогда
					
				Сообщение = "Выбранная услуга не доступна для указанных параметров перевозки при отгрузке";	   
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.handling" Тогда
					
				Сообщение = "Выбранная услуга не доступна для указанных параметров перевозки при доставке";	
				
			КонецЕсли;	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Указан некорректный адрес" Тогда  
			
			Если ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Город или населенный пункт Получателя не найдены";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.address.search" Тогда	
				
				Сообщение = "Указан некорректный адрес Отправителя";	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Выбранная дата недоступна" Тогда	 
			
			Если ПолеСОшибкой = "delivery.derival.produceDate" Тогда
				
				Сообщение = "Выбранная Дата отгрузки недоступна";	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка оформления услуги" Тогда	
			
			Если ПолеСОшибкой = "delivery.arrival.requirements" 
				Или ПолеСОшибкой = "delivery.derival.requirements" Тогда
				
				Сообщение = "Перечисленные спец.требования к транспорту недоступны для одновременного заказа";
				
			ИначеЕсли ПолеСОшибкой = "delivery.packages" Тогда
				
				Сообщение = "Перечисленные упаковки недоступны на выбранном терминале";
				
			КонецЕсли;	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка в параметрах запроса" Тогда 
			
			Если ПолеСОшибкой = "cargo.oversizedWeight" Тогда
				
				Сообщение = "Не заполнен Вес негабаритной части груза на вкладке параметры груза";
				
			ИначеЕсли ПолеСОшибкой = "cargo.oversizedVolume" Тогда	
				
				Сообщение = "Не заполнен Объём негабаритной части груза на вкладке параметры груза";
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Значение превышает допустимое" Тогда	
			
			Если СтрНайти(ПолеСОшибкой, "cargo.") > 0 Тогда
				
				Сообщение = ОшибкаЗаказа["detail"];	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Выбран недопустимый терминал" Тогда
			
			Если ПолеСОшибкой = "delivery.arrival.terminalID" Тогда
				
				Сообщение = "Выбранный терминал не оказывает услуги по выдаче груза";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.terminalID" Тогда
				
				Сообщение = "Выбранный терминал не может принять груз с указанными ВГХ";	
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Невозможно оформить заявку на указанное время" Тогда	 
			
			Если ПолеСОшибкой = "delivery.derival.time.worktimeStart" Тогда
				
				Сообщение = "Невозможно оформить заявку на указанное время. Укажите другое время начало работы Отправителя";
				
			ИначеЕсли ПолеСОшибкой = "delivery.derival.time.worktimeEnd" Тогда
				
				Сообщение = "Невозможно оформить заявку на указанное время. Укажите другое время окончания работы Отправителя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeStart" Тогда
				
				Сообщение = "Невозможно оформить заявку на указанное время. Укажите другое время начало работы Получателя";	
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.time.worktimeEnd" Тогда
				
				Сообщение = "Невозможно оформить заявку на указанное время. Укажите другое время окончания работы Получателя";						
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Неверный формат параметра" Тогда	
			
			Если ПолеСОшибкой = "delivery.packages.package.uid" Тогда
				
				Сообщение = "Неверный формат UID'а упаковки. Обратитесь к администратору";    
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.phone" Тогда
				
				Сообщение = "Укажите номер телефона Получателя в формате +7(9XX)XXXXXXX"; 
				
			ИначеЕсли ПолеСОшибкой = "members.sender.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Укажите номер телефона Отправителя в формате +7(9XX)XXXXXXX";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.phoneNumbers.phoneNumber.number" Тогда
				
				Сообщение = "Укажите номер телефона Получателя в формате +7(9XX)XXXXXXX";	
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.dataForReceipt.phone" Тогда
				
				Сообщение = "Укажите номер телефона в формате +79XXXXXXXXX (9 цифр после +79, плюс обязателен)";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.dataForReceipt.email" Тогда
				
				Сообщение = "Введите корректный адрес электронной почты";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.serial" Тогда
				
				Сообщение = "Неверный формат серии паспорта Получателя";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.document.number" Тогда	
				
				Сообщение = "Неверный формат номера паспорта Получателя";    
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.document.serial" Тогда
				
				Сообщение = "Неверный формат серии паспорта Отправителя"; 
				
			ИначеЕсли ПолеСОшибкой = "members.sender.counteragent.document.number" Тогда
				
				Сообщение = "Неверный формат номера паспорта Отправителя";	
				
			КонецЕсли; 	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Недопустимое значение параметра" Тогда	
			
			Если ПолеСОшибкой = "members.requester.uid" Тогда
				
				Сообщение = "Заказчик не является клиентом ДЛ";	 
				
			ИначеЕсли ПолеСОшибкой = "cargo.weight" Тогда 							
				
				Сообщение = СтрЗаменить(ОшибкаЗаказа["detail"], "Характеристики груза превышают", "Вес превышает"); 
				
			ИначеЕсли ПолеСОшибкой = "cargo.length" Тогда
					
				Сообщение = СтрЗаменить(ОшибкаЗаказа["detail"], "Характеристики груза превышают", "Длина превышает");
					
			ИначеЕсли ПолеСОшибкой = "cargo.width" Тогда
					
				Сообщение = СтрЗаменить(ОшибкаЗаказа["detail"], "Характеристики груза превышают", "Ширина превышает");
					
			ИначеЕсли ПолеСОшибкой = "cargo.height" Тогда
					
				Сообщение = СтрЗаменить(ОшибкаЗаказа["detail"], "Характеристики груза превышают", "Высота превышает");	
				
			ИначеЕсли ПолеСОшибкой ="cargo.totalWeight" Тогда
				
				Сообщение = "Не заполнен Общий вес груза";	
				
			КонецЕсли;			 
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка упрощенной отправки" Тогда	
			
			Если ПолеСОшибкой = "delivery.accompanyingDocuments.accDoc.action" Тогда
				
				Сообщение = "Действия с Сопроводительными документами не доступны при выбранных параметрах доставки";
				
			ИначеЕсли ПолеСОшибкой = "members.receiver.counteragent.phone" Тогда
				
				Сообщение = "Укажите номер телефона анонимного получателя в формате +7(9ХХ)ХХХХХХ";
				
			ИначеЕсли ПолеСОшибкой = "delivery.arrival.address.search" Тогда
				
				Сообщение = "Упрощенная доставка не доступна вне территории РФ";	
				
			КонецЕсли;	
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка наложенного платежа" Тогда
			
			Если ОшибкаЗаказа["detail"] = "Для получения разрешения на использование услуги необходимо обратиться к персональному менеджеру" Тогда
				
				Сообщение = "Для подключения услуги 'Наложенный платеж' обратитесь к вашему персональному менеджеру по телефону 8-800-100-8000.  Подробная информация об услуге - https://www.dellin.ru/articles/1146";
				
			Иначе
				
				Сообщение = ОшибкаЗаказа["detail"];	
				
			КонецЕсли;				 
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Не передан ни один из обязательных параметров" Тогда	
			
			Если ПолеСОшибкой = "members.receiver.dataForReceipt.phone" Тогда
				
				Сообщение = "В запросе должен присутствовать хотя бы один параметр Телефон, Email для электронного чека";
				
			ИначеЕсли ПолеСОшибкой = "length" Или ПолеСОшибкой = "width" Или ПолеСОшибкой = "height" Тогда	
				
				Сообщение = "В запросе должен присутствовать хотя бы один параметр из: Длина, Ширина, Высота";
				
			КонецЕсли;
			
		ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка параметров оплаты" Тогда
			
			Если ОшибкаЗаказа["detail"] = "Не допускается указание более двух плательщиков" Тогда
				
				Сообщение = "Не допускается указание более двух плательщиков";				
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ОшибкаЗаказа["title"] = "Ошибка выполнения запроса" 
		Или ОшибкаЗаказа["title"] = "Указан некорректный документ, удостоверяющий личность" Тогда 
		
		Сообщение = ОшибкаЗаказа["detail"];
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сообщение) Тогда 
		
		Сообщение = СтрШаблон("Ошибка: %1
			|Описание: %2
			|Поле запроса: %3",
			ОшибкаЗаказа["title"],
			ОшибкаЗаказа["detail"],
			ПолеСОшибкой);		
		
	КонецЕсли; 	 
	
	Возврат "• " + Сообщение; 
	
КонецФункции  	

&НаКлиенте
Процедура ТаблицаЗаказыСтатусНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Лев(Элементы.ТаблицаЗаказы.ТекущиеДанные.Статус, 6) = "Ошибка" И ЗначениеЗаполнено(Элементы.ТаблицаЗаказы.ТекущиеДанные.ТекстОшибки) Тогда
		
		ОчиститьСообщения();
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(Элементы.ТаблицаЗаказы.ТекущиеДанные.ТекстОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЗаказыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)   	
	
	Если НоваяСтрока Тогда
		
		Элементы.ТаблицаЗаказы.ТекущиеДанные.Статус = "";
		
		Если Не Копирование Тогда  		
			
			ЗаполнитьЗначенияСвойств(Элементы.ТаблицаЗаказы.ТекущиеДанные, Этаформа,, "ДопУслугиЗначения");
			
			Для Каждого СтрТЗ Из ДопУслугиЗначения Цикл
				
				СтрДопУслуги = Элементы.ТаблицаЗаказы.ТекущиеДанные.ДопУслугиЗначения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрДопУслуги, СтрТЗ);	
				
			КонецЦикла;
			
			Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставкиПредставление = ?(Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки = 0, "Доставка до адреса", "Самовывоз");
			Элементы.ТаблицаЗаказы.ТекущиеДанные.ВидДоставки = ?(Элементы.ТаблицаЗаказы.ТекущиеДанные.ВидДоставки = "", "Автоперевозка", Элементы.ТаблицаЗаказы.ТекущиеДанные.ВидДоставки); 	
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ОбновитьСтатусТаблицы();
	
	Если ТаблицаЗаказы.Количество() = 16 И ОповещатьОПревышенииКоличестваСтрок() Тогда
		
		ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ПревышениеКоличестваСтрок",, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	 
		
	КонецЕсли;	
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция ОповещатьОПревышенииКоличестваСтрок()
	
	Возврат Не Константы.ДЛ_НеОповещатьОСтрокахМультиотправки.Получить();
	
КонецФункции

&НаКлиенте
Процедура ПроверитьГотовностьЗаказов() 
	
	Если ТаблицаОтправок.Количество() = 0 Тогда
		
		ОтключитьОбработчикОжидания("ПроверитьГотовностьЗаказов");
		
		Возврат;	
		
	КонецЕсли;	
	
	ПроверкаФоновыхЗаданийНаСервере();
	
	ОбновитьСтатусТаблицы();
	
КонецПроцедуры 

&НаСервере
Процедура ПроверкаФоновыхЗаданийНаСервере()  
	
	КоличествоЗаданий = ТаблицаОтправок.Количество();
	Сч = 0;
	
	Пока Сч < КоличествоЗаданий Цикл		
		
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ТаблицаОтправок[Сч].ИдентификаторЗадания);
		
		Если Задание = Неопределено Тогда 
			
			ТаблицаОтправок.Удалить(Сч);	
			
		Иначе	
			
			Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда 			  
				
				РасчетЗавершение(ТаблицаОтправок[Сч]); 
				
				ТаблицаОтправок.Удалить(Сч);
				
			ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
				
				Сч = Сч + 1;  
				
			Иначе				
				
				ТекущийЗаказ = ТаблицаЗаказы.Получить(ТаблицаОтправок[Сч].ИДСтроки);				
				ТекущийЗаказ.Статус = "Ошибка";
				ТекущийЗаказ.ТекстОшибки = "• Ошибка получения данных. Повторите попытку.";
				
				ТаблицаОтправок.Удалить(Сч);
				
			КонецЕсли;						
			
		КонецЕсли; 
		
		КоличествоЗаданий = ТаблицаОтправок.Количество();
		
	КонецЦикла;  	
	
КонецПроцедуры 

&НаСервере
Процедура РасчетЗавершение(СтрокаОтправки)
	
	РезультатЗапроса = ПолучитьИзВременногоХранилища(СтрокаОтправки.АдресРезультата);
	
	ОбработатьРезультатРасчетаИСозданияЗаказа(РезультатЗапроса, ТаблицаЗаказы.Получить(СтрокаОтправки.ИДСтроки));
	
КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьСтатусТаблицы()
	
	Создано = 0;
	КОтправке = 0;
	
	Для Каждого СтрокаЗаказа Из ТаблицаЗаказы Цикл
		
		Если СокрЛП(СтрокаЗаказа.Статус) = "" Или Лев(СтрокаЗаказа.Статус, 6) = "Ошибка" Или СтрокаЗаказа.Статус = "В процессе отправки" Тогда
		
			КОтправке = КОтправке + 1;
			
		Иначе 
			
			Создано = Создано + 1;
			
		КонецЕсли;	
		
	КонецЦикла; 
	
	Элементы.днСтатус.Заголовок =СтрШаблон("Создано: %1 
		|К отправке: %2", Создано, КОтправке);
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаЗаказыПослеУдаления(Элемент)
	
	ОбновитьСтатусТаблицы();
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаЗаказыПолучательКонтрагентНаименованиеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтрагентОткрытие(Элемент);	
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаЗаказыДокументОснованияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытияФормы = Новый Структура;
	
	ДокументыОснования = Новый Массив;
	
	Для Каждого СтрТЗ Из Элементы.ТаблицаЗаказы.ТекущиеДанные.ДокументыОснования Цикл
		
		Если ЗначениеЗаполнено(СтрТЗ.Документ) Тогда
		 			
			ДокументыОснования.Добавить(СтрТЗ.Документ);			
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ПараметрыОткрытияФормы.Вставить("ДокументыОснования", ДокументыОснования);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ДокументыОснования", ПараметрыОткрытияФормы, ЭтаФорма,,,, Новый ОписаниеОповещения("ДокументыОснованияЗавершениеВыбора", ЭтаФорма, Истина), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыОснованияЗавершениеВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда 		
				
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ДокументОснования = Результат.ДокументОснования; 
		Элементы.ТаблицаЗаказы.ТекущиеДанные.ДокументыОснования.Очистить();
		
		Для Каждого ЭлементМассива Из Результат.ДокументыОснования Цикл
			
			СтрДокументыОснования = Элементы.ТаблицаЗаказы.ТекущиеДанные.ДокументыОснования.Добавить();
			СтрДокументыОснования.Документ = ЭлементМассива; 
			
		КонецЦикла;	
		
		Если Элементы.ТаблицаЗаказы.ТекущиеДанные.ДокументыОснования.Количество() > 0 Тогда
			
			ЗаполнитьПоДокументамОснованиям();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьШаблон(Команда)	
	
	ОО = Новый ОписаниеОповещения("СохранитьШаблонПродолжение", ЭтаФорма);
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить("Создать новый");
	КнопкиВопроса.Добавить("Перезаписать существующий");
	
	ПоказатьВопрос(ОО, "Выберите способ сохранения", КнопкиВопроса);
	
КонецПроцедуры 

&НаКлиенте
Процедура СохранитьШаблонПродолжение(Результат, ДополнительныеПараметры) Экспорт	
	
	Если Результат = "Создать новый" Тогда
		
		СтруктураПараметров = Новый Структура("СтруктураШаблона", СобратьСтруктуруДанныхДляШаблона()); 
		
		ОткрытьФорму("РегистрСведений.ДЛ_ШаблоныМультизаявка.Форма.СохранениеШаблона", СтруктураПараметров, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Результат = "Перезаписать существующий" Тогда   
		
		ПараметрыФормы = Новый Структура("РежимВыбора", Истина); 	
		ОО = Новый ОписаниеОповещения("ПриВыбореШаблонаДляЗаписи", ЭтаФорма, СобратьСтруктуруДанныхДляШаблона());
		
		ОткрытьФорму("РегистрСведений.ДЛ_ШаблоныМультизаявка.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореШаблонаДляЗаписи(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	ПерезаписатьШаблон(Результат, ДополнительныеПараметры);    
	
	ОбщегоНазначенияКлиент.СообщитьПользователю("Изменения шаблона сохранены");
	
КонецПроцедуры

&НаСервере
Процедура ПерезаписатьШаблон(СтруктураКлюча, СтруктураШаблона)
	
	ШаблонРегистра = РегистрыСведений.ДЛ_ШаблоныМультизаявка.СоздатьМенеджерЗаписи();
	ШаблонРегистра.Автор = СтруктураКлюча.Автор;
	ШаблонРегистра.ДатаСоздания = СтруктураКлюча.ДатаСоздания;
	ШаблонРегистра.Прочитать();  
	ШаблонРегистра.Данные = Новый ХранилищеЗначения(СтруктураШаблона);	
	ШаблонРегистра.Записать(Истина);		
	
КонецПроцедуры

&НаКлиенте
Функция СобратьСтруктуруДанныхДляШаблона()
	
	СтруктураДанных = Новый Структура;	
	СтруктураДанных.Вставить("НашаРольВПеревозке", НашаРольВПеревозке); 
	СтруктураДанных.Вставить("ОтправительКонтрагентНаименование", ОтправительКонтрагентНаименование);
	СтруктураДанных.Вставить("ОтправительКонтрагентСсылка", ОтправительКонтрагентСсылка);
	СтруктураДанных.Вставить("ОтправительКонтрагентИНН", ОтправительКонтрагентИНН);
	СтруктураДанных.Вставить("ОтправительКонтрагентЭтоОрганизация", ОтправительКонтрагентЭтоОрганизация);
    СтруктураДанных.Вставить("ОтправительКонтрагентЮрФизЛицо", ОтправительКонтрагентЮрФизЛицо);
