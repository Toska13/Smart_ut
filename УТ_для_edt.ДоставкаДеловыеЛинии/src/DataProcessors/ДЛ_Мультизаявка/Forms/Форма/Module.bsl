&НаКлиенте
Процедура ЗаполнитьПоШаблону(Команда) 
	
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина); 	
	ОО = Новый ОписаниеОповещения("ПриВыбореШаблона", ЭтаФорма);
	
	ОткрытьФорму("РегистрСведений.ДЛ_ШаблоныМультизаявка.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореШаблона(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	ЗаполнитьПоКлючуШаблона(Результат); 
	
	УстановитьВидимостьДоступностьМестаОтправки();
	
КонецПроцедуры  

&НаСервере
Процедура ЗаполнитьПоКлючуШаблона(СтруктураКлюча) 
	
	ШаблонРегистра = РегистрыСведений.ДЛ_ШаблоныМультизаявка.СоздатьМенеджерЗаписи();
	ШаблонРегистра.Автор = СтруктураКлюча.Автор;
	ШаблонРегистра.ДатаСоздания = СтруктураКлюча.ДатаСоздания;
	ШаблонРегистра.Прочитать();   
	
	СтруктураДокумета = ШаблонРегистра.Данные.Получить();
	
	Если ЗначениеЗаполнено(СтруктураДокумета) Тогда
	
		ЗаполнитьДокументПоСтруктуреШаблона(СтруктураДокумета);
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьДокументПоСтруктуреШаблона(СтруктураШаблона) 
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураШаблона);
	ВосстановитьЗначенияТаблицы(СтруктураШаблона, "ДопУслугиЗначения");		
	
КонецПроцедуры 

&НаСервере
Процедура ВосстановитьЗначенияТаблицы(СтруктураДанных, ИмяТаблицы)
	
	Таблица = ЭтаФорма[ИмяТаблицы];
	Таблица.Очистить();
	
	Попытка
		
		МассивЗначений = СтруктураДанных["Таблица_" + ИмяТаблицы]; 
		
	Исключение 
		
		Возврат;
		
	КонецПопытки;	
	
	Для Каждого ЭлементМассива Из МассивЗначений Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементМассива);
		
	КонецЦикла;
	
КонецПроцедуры


