
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	ФайловыйВариант = ДЛ_ДеловыеЛинииПовтИсп.ФайловыйРежимЗапускаБазы();
	
	Если ФайловыйВариант Тогда
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	ДатаОтгрузки = ТекущаяДатаСеанса() + 24 * 60 * 60;
	ВремяДоставкиС = '00010101090000';
	ВремяДоставкиПо = '00010101180000';	
	ВремяОтгрузкиС = '00010101090000';
	ВремяОтгрузкиПо = '00010101180000'; 
	ЗаказчикКонтрагентСсылка = Константы.ДЛ_Заказчик.Получить();
	НашаРольВПеревозке = Константы.ДЛ_РольВЗаказе.Получить();
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьСписокКонтрагентов(Команда)

	ДЛ_ДеловыеЛинии.ОбновитьСправочникДЛ_Контрагенты();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредзаполнитьПараметрыПеревозки(Команда)
	
	ОО = Новый ОписаниеОповещения("ВвестиШаблонСтроки", ЭтаФорма); 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПлательщикЗаЗабор", ПлательщикЗаЗабор);
	ПараметрыФормы.Вставить("ПлательщикЗаПеревозку", ПлательщикЗаПеревозку);
	ПараметрыФормы.Вставить("ПлательщикКонтактноеЛицоНаименование", ПлательщикКонтактноеЛицоНаименование);
	ПараметрыФормы.Вставить("ПлательщикКонтактноеЛицоТелефонПредставление", ПлательщикКонтактноеЛицоТелефонПредставление);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентИНН", ПлательщикКонтрагентИНН);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентНаименование", ПлательщикКонтрагентНаименование);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентСсылка", ПлательщикКонтрагентСсылка);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентЭтоОрганизация", ПлательщикКонтрагентЭтоОрганизация);
	ПараметрыФормы.Вставить("ПлательщикКонтрагентЮрФизЛицо", ПлательщикКонтрагентЮрФизЛицо);
	
	ПараметрыФормы.Вставить("ДоставкаДополнительныеТребованияТС", ДоставкаДополнительныеТребованияТС);
	ПараметрыФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботы", ДоставкаПогрузочноРазгрузочныеРаботы);
	ПараметрыФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа", ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа);
	ПараметрыФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыЛифт", ДоставкаПогрузочноРазгрузочныеРаботыЛифт);
	ПараметрыФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса", ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса);
	ПараметрыФормы.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыПлательщик", ДоставкаПогрузочноРазгрузочныеРаботыПлательщик);	 
	ПараметрыФормы.Вставить("СопроводительныеДокументы", СопроводительныеДокументы);
	ПараметрыФормы.Вставить("СопроводительныеДокументыПлательщик", СопроводительныеДокументыПлательщик);
	ПараметрыФормы.Вставить("ДополнительныеУслугиПлательщик", ДополнительныеУслугиПлательщик);        
	
	ПараметрыФормы.Вставить("СпособДоставки", СпособДоставки);
	ПараметрыФормы.Вставить("СпособОтгрузки", СпособОтгрузки);
	ПараметрыФормы.Вставить("ВидДоставки", ВидДоставки);
	
	ПараметрыФормы.Вставить("ГрузМаксимальнаяВысота", ГрузМаксимальнаяВысота);
	ПараметрыФормы.Вставить("ГрузМаксимальнаяДлина", ГрузМаксимальнаяДлина);
	ПараметрыФормы.Вставить("ГрузМаксимальнаяШирина", ГрузМаксимальнаяШирина);
	ПараметрыФормы.Вставить("ГрузМаксимальныйВес", ГрузМаксимальныйВес);
	ПараметрыФормы.Вставить("ГрузОбъем", ГрузОбъем);
	ПараметрыФормы.Вставить("ГрузВес", ГрузВес);
	ПараметрыФормы.Вставить("ГрузКоличествоГрузовыхМест", ГрузКоличествоГрузовыхМест);	
	ПараметрыФормы.Вставить("ХарактерГруза", ХарактерГруза);
		
	МассивДополнительныеУслуги = Новый Массив;
	
	Для Каждого СтрТЗ Из ДопУслугиЗначения Цикл
		
		ЭлементМассива = Новый Структура("Услуга, Использовать, Количество, Наименование");
		ЗаполнитьЗначенияСвойств(ЭлементМассива, СтрТЗ); 			
		МассивДополнительныеУслуги.Добавить(ЭлементМассива);	
		
	КонецЦикла; 
	
	ПараметрыФормы.Вставить("МассивДополнительныеУслуги", МассивДополнительныеУслуги);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ШаблонСтроки", Новый Структура("СтруктураДанных", ПараметрыФормы), ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры 

&НаКлиенте
Процедура ВвестиШаблонСтроки(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда 	
		
		СтруктураПараметров = Результат.Значение; 				
		
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураПараметров);
		
		ТЗДопУслуги	= ДопУслугиЗначения;
		ТЗДопУслуги.Очистить();
		
		Для Каждого ЭлементМассива Из СтруктураПараметров.МассивДополнительныеУслуги Цикл
			
			СтрДопУслуги = ТЗДопУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДопУслуги, ЭлементМассива);
			
		КонецЦикла;			
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОтправительАдресИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	
	АдресИзменениеТекстаРедактирования("Отправитель", Текст);	
	
КонецПроцедуры

&НаКлиенте
Процедура АдресИзменениеТекстаРедактирования(Префикс, Текст)
	
	Если Текст = ЭтаФорма[Префикс + "АдресПредставление"] Тогда  
		
		Элементы["Группа" + Префикс + "АдресПодсказки"].Видимость = Ложь;  
		
	ИначеЕсли ЗначениеЗаполнено(ЭтаФорма[Префикс + "Город"]) И СтрДлина(Текст) > 2 Тогда		
		
		АдресИзменениеТекстаРедактированияНаСервере(Префикс, Текст);			
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура АдресИзменениеТекстаРедактированияНаСервере(Префикс, Текст)  	
	
	МассивНаУдаление = Новый Массив;   
	
	ГруппаПодсказки = Элементы["Группа" + Префикс + "АдресПодсказки"];
	
	Для Каждого Элемент Из ГруппаПодсказки.ПодчиненныеЭлементы Цикл 
		
		МассивНаУдаление.Добавить(Элемент); 
		
	КонецЦикла;  
	
	Для Каждого Элемент Из МассивНаУдаление Цикл
		
		Элементы.Удалить(Элемент);
		
	КонецЦикла;      
	
	Если СервисПодсказокНеПодключен Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ГруппаПодсказки.Видимость = Истина;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("appKey");
	СтруктураЗапроса.Вставить("sessionID");  
	СтруктураЗапроса.Вставить("query", Текст);
	СтруктураЗапроса.Вставить("mode", "raw"); 
	СтруктураЗапроса.Вставить("count", 4);
	СтруктураЗапроса.Вставить("city_code", ЭтаФорма[Префикс + "Город"].КодКЛАДР);  
	
	ДанныеАдресов = ДЛ_ДеловыеЛинии.ПолучитьПодсказкиПоискаАдреса(СтруктураЗапроса); 
	
	МассивАдресов = Новый Массив;
	
	Если ДанныеАдресов["suggestions"] <> Неопределено Тогда
	
		Для Каждого СтруктураАдреса Из ДанныеАдресов["suggestions"] Цикл
			
			МассивАдресов.Добавить(СтруктураАдреса["value"]);	
			
		КонецЦикла;
		
	ИначеЕсли ДанныеАдресов["error"] <> Неопределено 
		И ДанныеАдресов["error"]["description"] = "Отсутствует доступ к методу. Обратитесь в техническую поддержку." Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Отсутствует доступ к методу получения подсказок ручного ввода адреса. Обратитесь в техническую поддержку.");
		
		СервисПодсказокНеПодключен = Истина;	
		
	КонецЕсли;   
	
	Для Каждого НайденныйАдрес Из МассивАдресов цикл         
		
		ИндексЭлемента = МассивАдресов.Найти(НайденныйАдрес);  
		
		ИмяКоманды = Префикс + "ЗаполнениеАдресаПоПодсказке" + ИндексЭлемента; 
		
		НоваяКоманда = Команды.Найти(ИмяКоманды);  
		
		Если НоваяКоманда = Неопределено Тогда 
			
			НоваяКоманда = Команды.Добавить(ИмяКоманды);
			НоваяКоманда.Действие = "ЗаполнениеАдресаПоПодсказке"; 	
			
		КонецЕсли; 
		
		НоваяКоманда.Заголовок = НайденныйАдрес;
		
		НовыйЭлемент = Элементы.Добавить("Кнопка" + Префикс + "Подсказка" + ИндексЭлемента, Тип("КнопкаФормы"), ГруппаПодсказки);
		НовыйЭлемент.Вид = ВидКнопкиФормы.Гиперссылка;
		НовыйЭлемент.ИмяКоманды = НоваяКоманда.Имя;		
		
	КонецЦикла;	
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтправительАдресОчистка(Элемент, СтандартнаяОбработка)
	
	ОтправительАдресЗначение = "";	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеАдресаПоПодсказке(Команда) 
	
	КонецПрефикса = СтрНайти(Команда.Имя, "ЗаполнениеАдресаПоПодсказке") - 1;
	Префикс = Лев(Команда.Имя, КонецПрефикса);
	
	ЭтаФорма[Префикс + "АдресПредставление"] = ПолучитьЗаголовокКоманды(Команда.Имя);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительАдресНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка) 
	
	НачатьЗаполнениеАдреса("Отправитель");	
	
КонецПроцедуры 

&НаКлиенте
Процедура НачатьЗаполнениеАдреса(Префикс)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НачатьЗаполнениеАдресаПродолжение", ЭтотОбъект, Префикс);
	
	КнопкиВопросаАдреса = Новый СписокЗначений;
	КнопкиВопросаАдреса.Добавить("Ручной ввод");
	КнопкиВопросаАдреса.Добавить(Префикс);
	КнопкиВопросаАдреса.Добавить("Адресная книга");
	
	ПоказатьВыборИзСписка(ОписаниеОповещения, КнопкиВопросаАдреса); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ОткрытьФормуВыбораАдреса(Префикс)
	
	ИмяРеквизитаАдреса = Префикс + "Адрес";	
	
	ДополнительныеПараметры = Новый Структура;	
	ДополнительныеПараметры.Вставить("ИмяРеквизитаАдреса", ИмяРеквизитаАдреса);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение", ЭтаФорма, ДополнительныеПараметры); 
		
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);	
		
	ПараметрыОткрытияФормы = Новый Структура;	
	ПараметрыОткрытияФормы.Вставить("АдресЗначение", ТекущиеДанные[ИмяРеквизитаАдреса + "Значение"]);	
	ПараметрыОткрытияФормы.Вставить("АдресПредставление", ТекущиеДанные[ИмяРеквизитаАдреса + "Представление"]);
	ПараметрыОткрытияФормы.Вставить("Город", ТекущиеДанные[Префикс + "Город"]);
	ПараметрыОткрытияФормы.Вставить("КонтрагентСсылка", ТекущиеДанные[Префикс + "КонтрагентСсылка"]);
		
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ВводАдреса", ПараметрыОткрытияФормы, ЭтаФорма,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
	
КонецПроцедуры 

&НаКлиенте	
Процедура ОткрытьФормуВыбораАдресаИОбработатьРезультатЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда  
		
		Возврат; 
		
	КонецЕсли;  
	
	ИмяРеквизитаАдреса = ДополнительныеПараметры.ИмяРеквизитаАдреса;
	Префикс = СтрЗаменить(ИмяРеквизитаАдреса, "Адрес", "");
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	ТекущиеДанные[ИмяРеквизитаАдреса + "Представление"] = Результат.Представление;
	ТекущиеДанные[ИмяРеквизитаАдреса + "Значение"] = Результат.Значение;
	ТекущиеДанные[Префикс + "Город"] = Результат.Город; 
	
	ЗаполнитьНаселенныйПунктПоАдресу1С(Префикс);	

КонецПроцедуры

&НаСервере
Функция ПолучитьЗаголовокКоманды(ИмяКоманды) 
	
	Команда = Команды.Найти(ИмяКоманды);
	
	Возврат Команда.Заголовок;	
	
КонецФункции

&НаКлиенте
Процедура ОтправительАдресПриИзменении(Элемент)
	
	ОтправительАдресЗначение = ""; 
	
	ПодключитьОбработчикОжидания("СкрытьГруппаОтправительАдресПодсказки", 0.2, Истина);	
	
КонецПроцедуры 

&НаКлиенте
Процедура СкрытьГруппаОтправительАдресПодсказки()
	
	Элементы.ГруппаОтправительАдресПодсказки.Видимость = Ложь;	
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗаполнениеАдресаПродолжение(Результат, Префикс) Экспорт
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		
		ЗаполнениеАдреса = Результат.Значение;
		
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда 
		
		ЗаполнениеАдреса = Результат;
		
	Иначе      
		
		ЗаполнениеАдреса = ""; 
		
	КонецЕсли; 
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	УчастникГрузоперевозки = ТекущиеДанные[Префикс + "КонтрагентСсылка"];
	
	Если ЗаполнениеАдреса = Префикс Тогда 		
		
		Если ЗначениеЗаполнено(УчастникГрузоперевозки) и ТипЗнч(УчастникГрузоперевозки) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("НачатьЗаполнениеАдресаЗавершение", ЭтотОбъект, Префикс);
			
			КнопкиВопросаАдреса = Новый СписокЗначений;
			КнопкиВопросаАдреса.Вставить(0,"Контрагент","Контрагент");
			КнопкиВопросаАдреса.Вставить(1,"Партнер","Партнер");
			
			ПоказатьВыборИзСписка(ОписаниеОповещения, КнопкиВопросаАдреса);
			
		ИначеЕсли ЗначениеЗаполнено(УчастникГрузоперевозки) и ТипЗнч(УчастникГрузоперевозки) = Тип("СправочникСсылка.Организации") Тогда
			
			НачатьЗаполнениеАдресаЗавершение("Организация", Префикс);
			
		Иначе
			
			ОбщегоНазначенияКлиент.СообщитьПользователю("Укажите контрагента, чей адрес должен быть заполнен.");
			
		КонецЕсли;  
		
	ИначеЕсли ЗаполнениеАдреса = "Адресная книга" Тогда
		
		НайденыйАдрес = ПолучитьАдресПоАдреснойКниге(Префикс);
		
		Если ЗначениеЗаполнено(НайденыйАдрес) Тогда 
			
			ТекущиеДанные[Префикс + "АдресПредставление"] = НайденыйАдрес;
			
		Иначе
			
			ОО = Новый ОписаниеОповещения("ЗаполнениеАдресаАдрснаяКнигаЗавершение", ЭтаФорма, Префикс);
			
			Отборы = Новый Структура();
			Отборы.Вставить("УчастникГрузоперевозки", УчастникГрузоперевозки); 			
			
			Город = ТекущиеДанные[Префикс + "Город"];
			
			Если ЗначениеЗаполнено(Город) Тогда
				
				Отборы.Вставить("НаселнныйПункт", Город);	
				
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор", Отборы);		
			
			ОткрытьФорму("РегистрСведений.ДЛ_АдреснаяКнига.ФормаСписка", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли; 
		
	ИначеЕсли ЗаполнениеАдреса = "Ручной ввод" Тогда
		
		ОткрытьФормуВыбораАдреса(Префикс);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ОтправительКонтрагентСсылка");	
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозки(УчастникГрузоперевозки)  
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить("Справочник Организации");
	КнопкиВопроса.Добавить("Справочник Контрагенты");  		
	
	Если УчастникГрузоперевозки <> "ПлательщикКонтрагентСсылка" Тогда
		
		КнопкиВопроса.Добавить("Ввести данные юр. лица");
		КнопкиВопроса.Добавить("Ввести данные физ. лица");
		
		Если УчастникГрузоперевозки = "ПолучательКонтрагентСсылка" Тогда
			
			КнопкиВопроса.Добавить("Упрощенная отправка");		
			
		КонецЕсли;
		
	КонецЕсли;	
			
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("НачалоВыбораУчастникаГрузоперевозкиПродолжить", ЭтаФорма, УчастникГрузоперевозки), КнопкиВопроса);		
	
КонецПроцедуры 

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозкиПродолжить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ИмяРеквизита = СтрЗаменить(ДополнительныеПараметры, "Ссылка", ""); 
		ИмяРеквизитаИНН = ИмяРеквизита + "ИНН";
		Префикс = СтрЗаменить(ИмяРеквизита, "Контрагент", "");
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);	
		
		Если Префикс = "Получатель" Тогда
			
			ТекущиеДанные.УпрощеннаяОтправка = Ложь;	
			
		КонецЕсли;
		
		Если Результат.Значение = "Ввести данные юр. лица" Или Результат.Значение = "Ввести данные физ. лица" Тогда 						
			
			ТекущиеДанные[Префикс + "РучнойВвод"] = ?(Результат.Значение = "Ввести данные юр. лица", 1, 2);
			ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"] = ТекущиеДанные[Префикс + "РучнойВвод"]; 			
			
			Если Не ЗначениеЗаполнено(ТекущиеДанные[Префикс + "КонтрагентСтрана"]) Тогда
				
				ТекущиеДанные[Префикс + "КонтрагентСтрана"] = ПолучитьСтрануПоУмолчанию();
				
			КонецЕсли;
			
			Если ТекущиеДанные[Префикс + "РучнойВвод"] = 2 Тогда
				
				Если Не ЗначениеЗаполнено(ТекущиеДанные[Префикс + "КонтрагентОПФ"]) Тогда
					
					ТекущиеДанные[Префикс + "КонтрагентОПФ"] = ПолучитьОПФПоУмолчанию();
					
				КонецЕсли;			
				
			КонецЕсли; 	
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("КонтрагентЮрФизЛицо", ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"]);
			СтруктураПараметров.Вставить("КонтрагентСтрана", ТекущиеДанные[Префикс + "КонтрагентСтрана"]);
			СтруктураПараметров.Вставить("КонтрагентОПФ", ТекущиеДанные[Префикс + "КонтрагентОПФ"]);			
			
			ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.РучнойВводКонтрагента", СтруктураПараметров, ЭтаФорма,,,, Новый ОписаниеОповещения("ОкончаниеРучногоВыбораУчастникаГрузоперевозки", ЭтаФорма, Префикс), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
			
		ИначеЕсли Результат.Значение = "Упрощенная отправка" Тогда 		
			
			ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.УпрощеннаяОтправка",, ЭтаФорма,,,, Новый ОписаниеОповещения("ОкончаниеУпрощеннаяОтправка", ЭтаФорма), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе 			
					
			Если Префикс <> "Плательщик" Тогда
				
				ТекущиеДанные[Префикс + "РучнойВвод"] = 0; 				
				
			КонецЕсли;
			
			ПараметрыОткрытия = Новый Структура;			
			ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
			
			ОО = Новый ОписаниеОповещения("ОбработатьВыборЗначенияКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
			
			Если Результат.Значение = "Справочник Организации" Тогда 
				
				ИмяФормыВыбора = "Справочник.Организации.ФормаВыбора";				
				
			ИначеЕсли Результат.Значение = "Справочник Контрагенты" Тогда
				
				ИмяФормыВыбора = "Справочник.Контрагенты.ФормаВыбора";
				
			Иначе
				
				Возврат;
				
			КонецЕсли; 
			
			ОткрытьФорму(ИмяФормыВыбора, ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОкончаниеУпрощеннаяОтправка(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = Элементы.ТаблицаЗаказы.ТекущиеДанные; 			
		
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеРучногоВыбораУчастникаГрузоперевозки(Результат, Префикс) Экспорт
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма); 	
		
		ТекущиеДанные[Префикс + "КонтрагентСтрана"] = Результат.КонтрагентСтрана;	
		ТекущиеДанные[Префикс + "КонтрагентНаименование"] = Результат.КонтрагентНаименование;
		ТекущиеДанные[Префикс + "КонтрагентОПФ"] = Результат.КонтрагентОПФ;
		ТекущиеДанные[Префикс + "КонтрагентИНН"] = Результат.КонтрагентИНН;
		ТекущиеДанные[Префикс + "КонтрагентСсылка"] = Неопределено;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЗначенияКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Или
		(ТипЗнч(Результат) = Тип("КодВозвратаДиалога")
		И Результат = КодВозвратаДиалога.Отмена) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		
		ТекущиеДанные = ?(ДополнительныеПараметры = "ПолучательКонтрагентСсылка", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[ДополнительныеПараметры] = Результат;
		
		ОбработатьИзменениеРеквизитаФормыКонтрагента(ДополнительныеПараметры);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРеквизитаФормыКонтрагента(ИмяРеквизита)
	
	ОчиститьСообщения();
	Отказ = Ложь;
	ОбработатьИзменениеРеквизитаФормыКонтрагентаНаСервере(ИмяРеквизита, Отказ);
	
	Если Отказ Тогда
		
		Возврат; 
		
	КонецЕсли;		
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьИзменениеРеквизитаФормыКонтрагентаНаСервере(ИмяРеквизита, Отказ = Ложь)
	
	ТекущиеДанные = ?(ИмяРеквизита = "ПолучательКонтрагентСсылка", ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока), ЭтаФорма);
	
	ПараметрыУчастника = ПараметрыУчастникаГрузоперевозки(ТекущиеДанные[ИмяРеквизита]);		
	
	ОбработатьПараметры(ПараметрыУчастника, СтрЗаменить(ИмяРеквизита, "КонтрагентСсылка", ""));			
	
КонецПроцедуры 

&НаСервере
Функция ПараметрыУчастникаГрузоперевозки(Значение)
	
	ПараметрыУчастника = Новый Структура;
	ПараметрыУчастника.Вставить("Контрагент", ПараметрыКонтрагента());		
	ПараметрыУчастника.Контрагент.Ссылка = Значение;
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		ЗаполнитьПараметрыКонтрагента(ПараметрыУчастника.Контрагент);		
		
	КонецЕсли;	
	
		
	Возврат ПараметрыУчастника;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыКонтрагента() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("ЮрФизЛицо", 0);
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("ЮридическийАдресПредставление", "");
	Результат.Вставить("ЭтоОрганизация", Ложь);
	Результат.Вставить("Иностранец", Ложь); 
	Результат.Вставить("Страна", Неопределено);
	Результат.Вставить("ОПФ", Неопределено);
	Результат.Вставить("НомерИностранногоПаспорта", "");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента) Экспорт
	
	ИмяСправочника = Неопределено;
	Если ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		ИмяСправочника = "Организации";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеСокращенное";
		ПараметрыКонтрагента.ЭтоОрганизация = Истина;
	ИначеЕсли ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		ИмяСправочника = "Контрагенты";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеПолное";
		ПараметрыКонтрагента.ЭтоОрганизация = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОсновнаяТаблица.Ссылка КАК Ссылка,
	|	ОсновнаяТаблица.ИНН КАК ИНН,
	|	ОсновнаяТаблица.КПП КАК КПП,
	|	&РеквизитНаименования КАК Наименование,
	|	ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент) КАК Иностранец,
	|	ВЫБОР
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА 1
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|			ТОГДА 2
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЮрФизЛицо
	|ИЗ
	|	&ТаблицаДляЗапроса КАК ОсновнаяТаблица
	|ГДЕ
	|	ОсновнаяТаблица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыКонтрагента.Ссылка);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДляЗапроса", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитНаименования", РеквизитНаименования);  
	
	Если ИмяСправочника = "Организации" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент)", "Ложь");	
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда  
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтрагента, РезультатЗапроса.Выгрузить()[0]);		
		
		Если ПараметрыКонтрагента.ЮрФизЛицо <> 2 Тогда 
			
			ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);                          
			
			ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 			
			
			Если Не ЗначениеЗаполнено(ПараметрыКонтрагента.ЮридическийАдресПредставление) Тогда
				
				ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
				
				ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПараметры(Параметры, Префикс = "")
	
	ПараметрыДляФормы = Новый Структура;
	
	ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, ПараметрыДляФормы, Префикс);
	
	ТекущиеДанные = ?(Префикс = "Получатель", ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока), ЭтаФорма);
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ПараметрыДляФормы);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, Данные, Префикс = "") Экспорт
	
	Для Каждого Параметр Из Параметры Цикл  
		
		ИмяКолонки = Префикс + Параметр.Ключ;   
		
		Если ТипЗнч(Параметр.Значение) = Тип("Структура") Тогда
			
			ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметр.Значение, Данные, ИмяКолонки); 
			
		Иначе 
			
			Данные.Вставить(ИмяКолонки, Параметры[Параметр.Ключ]);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтрануПоУмолчанию()	
	
	Возврат Справочники.ДЛ_Страны.НайтиПоРеквизиту("UID", "0x8f51001438c4d49511dbd774581edb7a");	
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьОПФПоУмолчанию()	
	
	Возврат Справочники.ДЛ_ОПФ.НайтиПоРеквизиту("UID", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");	
	
КонецФункции

&НаКлиенте
Процедура ОтправительКонтрагентОчистка(Элемент, СтандартнаяОбработка)
	
	ОтправительКонтрагентИНН = "";
	ОтправительКонтрагентСсылка = Неопределено;
	ОтправительРучнойВвод = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КонтрагентОткрытие(Элемент);
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентОткрытие(Элемент) 
	
	Если СтрНайти(Элемент.Имя, "ТаблицаЗаказы") > 0 Тогда
		
		ИмяРеквизита = "ПолучательКонтрагентСсылка";
		ИмяРеквизитаЭтоОрганизация = "ПолучательКонтрагентЭтоОрганизация"; 
		ТекущиеДанные =  Элементы.ТаблицаЗаказы.ТекущиеДанные;
		
	Иначе
		
		ИмяРеквизита = Элемент.Имя + "Ссылка";
		ИмяРеквизитаЭтоОрганизация = Элемент.Имя + "ЭтоОрганизация";
		ТекущиеДанные = ЭтаФорма;
	
	КонецЕсли;
	
	ЗначениеРеквизита = ТекущиеДанные[ИмяРеквизита];
	ЭтоОрганизация = ТекущиеДанные[ИмяРеквизитаЭтоОрганизация];
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда  		 
		
		ОО = Новый ОписаниеОповещения("ОбработатьИзменениеУчастника", ЭтаФорма, ИмяРеквизита);		
		
		Если ЭтоОрганизация Тогда
			
			ИмяФормыКонтрагента = "Справочник.Организации.ФормаОбъекта"; 
			
		Иначе                                                      
			
			ИмяФормыКонтрагента = "Справочник.Контрагенты.ФормаОбъекта";
			
		КонецЕсли; 	
		
		ОткрытьФорму(ИмяФормыКонтрагента, Новый Структура("Ключ", ЗначениеРеквизита), ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбработатьИзменениеУчастника(Результат, ДополнительныеПараметры) Экспорт		
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) И ДополнительныеПараметры <> "ПолучательКонтрагентСсылка" Тогда		
		
		ОбработатьИзменениеРеквизитаФормыКонтрагента(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

