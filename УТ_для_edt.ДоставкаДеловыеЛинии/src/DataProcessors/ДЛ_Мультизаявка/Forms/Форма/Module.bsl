&НаКлиенте
Процедура ОтправительКонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//ВвестиДанныеКонтактныхЛиц("Отправитель");
	КонтактноеЛицоНачалоВыбора("Отправитель");
	
КонецПроцедуры  

&НаКлиенте
Процедура КонтактноеЛицоНачалоВыбора(Префикс)
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	ИмяРеквизитаКонтрагента = Префикс + "КонтрагентСсылка"; 
	
	ТипКонтрагента = ТипЗнч(ТекущиеДанные[ИмяРеквизитаКонтрагента]); 
	
	ОО = Новый ОписаниеОповещения("ВыборКонтактноеЛицоЗавершение", ЭтаФорма, Префикс);
	
	ПараметрыОткрытия = Новый Структура;			
	ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
	
	Если ТипКонтрагента = Тип("СправочникСсылка.Контрагенты") Тогда		 
		
		ПараметрыОтбора = Новый Структура("Владелец", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(ТекущиеДанные[ИмяРеквизитаКонтрагента], "Партнер"));
		
		ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
		
		ОткрытьФорму("Справочник.КонтактныеЛицаПартнеров.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли ТипКонтрагента = Тип("СправочникСсылка.Организации") Тогда 				
		
		ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВыборКонтактноеЛицоЗавершение(Результат, Префикс) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
			
			Результат = Результат.Значение;	
			
		КонецЕсли;
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"] = СокрЛП(Результат);		
		ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"] = ПолучитьТелефоныКонтактногоЛица(Результат); 
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ВвестиДанныеКонтактныхЛиц(Префикс)  
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	КонтактныеЛица = ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"]; 
	
	ТекущиеКонтактныеЛица = Новый Массив;
	
	Если ЗначениеЗаполнено(КонтактныеЛица) Тогда	
		
		МассивКонтактныеЛица = СтрРазделить(КонтактныеЛица, ";");	
		
		Для Каждого КонтактноеЛицо Из МассивКонтактныеЛица Цикл			 
				
			ТекущиеКонтактныеЛица.Добавить(КонтактноеЛицо);				
			
		КонецЦикла;  
		
	КонецЕсли;
	
	ОО = Новый ОписаниеОповещения("ВвестиДанныеКонтактныеЛицаЗвершение", ЭтаФорма, Префикс); 
	ПараметрыФормы = Новый Структура("КонтактныеЛица, КонтрагентСсылка", ТекущиеКонтактныеЛица, ТекущиеДанные[Префикс + "КонтрагентСсылка"]);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ВводКонтактныхЛиц", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  

&НаКлиенте
Процедура ВвестиДанныеКонтактныеЛицаЗвершение(Результат, Префикс) Экспорт 
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"] = Результат;	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТаблицаЗаказыПолучательКонтактноеЛицоНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	//ВвестиДанныеКонтактныхЛиц("Получатель");	
	КонтактноеЛицоНачалоВыбора("Получатель");
	
КонецПроцедуры

&НаКлиенте
Процедура СпособОтгрузкиПриИзменении(Элемент)
	
	УстановитьВидимостьДоступностьМестаОтправки();	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступностьМестаОтправки()  	
		
	ДоставкаОтАдреса = СпособОтгрузки = 0; 	
	
	Элементы.ОтправительАдрес.Видимость = ДоставкаОтАдреса;	  	
	Элементы.ОтправительВремяПлановойОтгрузки.Видимость = ДоставкаОтАдреса;
	Элементы.ОтправительТерминал.Видимость = Не ДоставкаОтАдреса;  
	Элементы.ОтгрузкаДополнительныеУслуги.Видимость = ДоставкаОтАдреса; 
		
КонецПроцедуры   

&НаКлиенте
Процедура ДЛ_ОтправительГородПриИзменении(Элемент)
	
	ГородПриИзменении("Отправитель");
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьДоступностьМестаОтправки();
	СформироватьПредставлениеВремениОтгрузки(); 
	ОбновитьСтатусТаблицы();
	
КонецПроцедуры 

&НаКлиенте
Процедура ГородПриИзменении(Префикс) 
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	ГородЗаполнен = ЗначениеЗаполнено(ТекущиеДанные[Префикс + "Город"]);
	
	Если ГородЗаполнен И ЗначениеЗаполнено(ТекущиеДанные[Префикс + "Терминал"]) Тогда
		
		ПроверитьНеобходимостьОчисткиТерминала(Префикс);	
		
	КонецЕсли;   
	
	ЭтоОтправка = (Префикс = "Отправитель");
	
	Способ = ?(ЭтоОтправка, СпособОтгрузки, Элементы.ТаблицаЗаказы.ТекущиеДанные.СпособДоставки);
	
	Если ГородЗаполнен Тогда
	
		ТерминалПоУмолчанию = ПолучитьТерминалПоУмолчанию(ЭтоОтправка); 		
		
		Если ЗначениеЗаполнено(ТерминалПоУмолчанию)  Тогда  
			
			ТекущиеДанные[Префикс + "Терминал"] = ТерминалПоУмолчанию;
			
		ИначеЕсли Способ = 1 Тогда    
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В выбранном населенном пункте нет доступных терминалов"); 				
			
		КонецЕсли;
		
		АдресПоАдреснойКниге = ПолучитьАдресПоАдреснойКниге(Префикс);
		
		Если ЗначениеЗаполнено(АдресПоАдреснойКниге) Тогда
			
			ТекущиеДанные[Префикс + "АдресПредставление"] = АдресПоАдреснойКниге;	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНеобходимостьОчисткиТерминала(Префикс)  
	
	ТекущиеДанные = ?(Префикс = "Получатель", ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока), ЭтаФорма);
	
	Если ТекущиеДанные[Префикс + "Город"] <> ТекущиеДанные[Префикс + "Терминал"].Город Тогда
		
		ТекущиеДанные[Префикс + "Терминал"] = Справочники.ДЛ_Терминалы.ПустаяСсылка();	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТерминалПоУмолчанию(ЭтоОтправка) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДЛ_Терминалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДЛ_Терминалы КАК ДЛ_Терминалы
	|ГДЕ
	|	НЕ ДЛ_Терминалы.ПометкаУдаления
	|	И ДЛ_Терминалы.Город = &Город
	|	И ДЛ_Терминалы.Выдача
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДЛ_Терминалы.ПоУмолчанию УБЫВ";
	Запрос.УстановитьПараметр("Город", ?(ЭтоОтправка, ОтправительГород, ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока).ПолучательГород));  
	
	Если ЭтоОтправка Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Выдача", "Приемка"); 
		
	КонецЕсли; 
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат ПолучитьТерминалПоиском(ЭтоОтправка);
		
	Иначе
		
		Возврат Результат.Выгрузить()[0].Ссылка;
		
	КонецЕсли;	
	
КонецФункции   

&НаСервере
Функция ПолучитьТерминалПоиском(ЭтоОтправка)
	
	Результат = Неопределено;
	
	ГородПоиска = ?(ЭтоОтправка, ОтправительГород, ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока).ПолучательГород);
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("appKey");
	СтруктураЗапроса.Вставить("sessionID");
	СтруктураЗапроса.Вставить("code", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГородПоиска, "КодКЛАДР")); 
	СтруктураЗапроса.Вставить("direction", ?(ЭтоОтправка, "derival", "arrival")); 
	
	ДанныеТерминалы = ДЛ_ДеловыеЛинии.ПоискТерминалов(СтруктураЗапроса);
	
	Если ДанныеТерминалы["terminals"] <> Неопределено И ДанныеТерминалы["terminals"].Количество() > 0 Тогда
		
		НашлиПоУмолчанию = Ложь;
		
		Для Каждого НайденныйТерминал Из ДанныеТерминалы["terminals"] Цикл
			
			Если НайденныйТерминал["default"] = Истина Тогда
				
				НашлиПоУмолчанию = Истина;
				
				Результат = Справочники.ДЛ_Терминалы.НайтиПоРеквизиту("ИДтерминала", Строка(НайденныйТерминал["id"]));
				
				Прервать;
				
			КонецЕсли;			
			
		КонецЦикла;   
		
		Если Не НашлиПоУмолчанию Тогда
			
			Результат = Справочники.ДЛ_Терминалы.НайтиПоРеквизиту("ИДтерминала", Строка(ДанныеТерминалы["terminals"][0]["id"]));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресПоАдреснойКниге(Префикс)
	
	Результат = ""; 
	
	ТекущиеДанные = ?(Префикс = "Получатель", ТаблицаЗаказы.НайтиПоИдентификатору(Элементы.ТаблицаЗаказы.ТекущаяСтрока), ЭтаФорма);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДЛ_АдреснаяКнига.Адрес КАК Адрес,
	               |	ДЛ_АдреснаяКнига.НаселнныйПункт КАК НаселнныйПункт
	               |ИЗ
	               |	РегистрСведений.ДЛ_АдреснаяКнига КАК ДЛ_АдреснаяКнига
	               |ГДЕ
	               |	ДЛ_АдреснаяКнига.УчастникГрузоперевозки = &УчастникГрузоперевозки	               
	               |	И ДЛ_АдреснаяКнига.НаселнныйПункт = &НаселнныйПункт";
	Запрос.УстановитьПараметр("УчастникГрузоперевозки", ТекущиеДанные[Префикс + "КонтрагентСсылка"]);	  
	
	Если ЗначениеЗаполнено(ТекущиеДанные[Префикс + "Город"]) Тогда
		
		Запрос.УстановитьПараметр("НаселнныйПункт", ТекущиеДанные[Префикс + "Город"]);
		
	Иначе     
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ДЛ_АдреснаяКнига.НаселнныйПункт = &НаселнныйПункт", "");	
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		ТекущиеДанные[Префикс + "Город"] = Выборка.НаселнныйПункт;
		Результат = Выборка.Адрес;
		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнениеАдресаАдрснаяКнигаЗавершение(Результат, Префикс) Экспорт  	 
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[Префикс + "АдресПредставление"] = Результат["Адрес"];			
		
		Если Не ЗначениеЗаполнено(ТекущиеДанные[Префикс + "Город"]) Тогда
			
			ТекущиеДанные[Префикс + "Город"] = Результат["Город"];	
			
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры 

&НаКлиенте
Процедура НачатьЗаполнениеАдресаЗавершение(Результат,Префикс) Экспорт   
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		ТипОтправителяПолучателя = Результат.Значение;
	ИначеЕсли ТипЗнч(Результат) = Тип("Строка") Тогда
		ТипОтправителяПолучателя = Результат; 
	Иначе
		ТипОтправителяПолучателя = "";
	КонецЕсли;
	
	ИнформацияОбАдресе = Неопределено;
	СсылкаНаСправочник = ТекущиеДанные[Префикс + "КонтрагентСсылка"]; 
	
	Если ТипОтправителяПолучателя = "Контрагент" Или ТипОтправителяПолучателя = "Организация" Тогда
		ИнформацияОбАдресе = ПолучитьИнформациюОбАдресеОтправителяПолучателя(СсылкаНаСправочник);	
	ИначеЕсли ТипОтправителяПолучателя = "Партнер" Тогда
		ПартнерСсылка = ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(СсылкаНаСправочник, "Партнер");
		ИнформацияОбАдресе = ПолучитьИнформациюОбАдресеОтправителяПолучателя(ПартнерСсылка);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияОбАдресе) Тогда
		ТекущиеДанные[Префикс + "АдресПредставление"] = ИнформацияОбАдресе.Представление;	
		ТекущиеДанные[Префикс + "АдресЗначение"] = ИнформацияОбАдресе.Значение;	
	Иначе
		ТекущиеДанные[Префикс + "АдресПредставление"] = "";	
		ТекущиеДанные[Префикс + "АдресЗначение"] = "";	
	КонецЕсли;
	
	Если Префикс = "Отправитель" Тогда
		СпособОтгрузки = 0;	
	ИначеЕсли Префикс = "Получатель" Тогда	
		СпособДоставки = 0;
	КонецЕсли; 
	
	ЗаполнитьНаселенныйПунктПоАдресу1С(Префикс);
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОбАдресеОтправителяПолучателя(Ссылка)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		
		ТаблицаАдресов = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Ссылка,Перечисления.ТипыКонтактнойИнформации.Адрес,ТекущаяДата(),Ложь);	
		
		Если ТаблицаАдресов.Количество() > 0 Тогда
			
			ИнформацияобАдресе = ПолучитьСтруктуруАдресаОтправителяПолучателя(Ссылка,ТаблицаАдресов);			
			Возврат ИнформацияобАдресе;
			
		КонецЕсли;
		
	КонецЕсли;

КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруАдресаОтправителяПолучателя(Ссылка,ТаблицаАдресов)
	
	ИнформацияОФактическомАдресе = Новый Структура;
	
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ОтборАдреса = Новый Структура("Вид",Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);
		ИнформацияОФактическомАдресе = НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Партнеры") Тогда
		
		ВидАдресДоставкиСсылка = ПолучитьВидАдресДоставкиПартнера();
		Если ЗначениеЗаполнено(ВидАдресДоставкиСсылка) Тогда
			ОтборАдреса = Новый Структура("Вид",ВидАдресДоставкиСсылка);
			ИнформацияОФактическомАдресе = НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса);

			Если Не ЗначениеЗаполнено(ИнформацияОФактическомАдресе) Тогда
				ОтборАдреса = Новый Структура("Вид",Справочники.ВидыКонтактнойИнформации.АдресПартнера);
				ИнформацияОФактическомАдресе = НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса);
			КонецЕсли;
			
		Иначе 	
			ОтборАдреса = Новый Структура("Вид",Справочники.ВидыКонтактнойИнформации.АдресПартнера);
			ИнформацияОФактическомАдресе = НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		
		ОтборАдреса = Новый Структура("Вид",Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
		ИнформацияОФактическомАдресе = НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса);
		
	КонецЕсли;	
	
	Возврат ИнформацияОФактическомАдресе;
	
КонецФункции 

&НаСервереБезКонтекста
Функция НайтиАдресПоОтбору(ТаблицаАдресов,ОтборАдреса)

	ИнформацияобАдресе = Неопределено;
	
	ИнформацияОФактическомАдресе = ТаблицаАдресов.НайтиСтроки(ОтборАдреса);
	Если ИнформацияОФактическомАдресе.Количество() > 0 Тогда
		ИнформацияобАдресе = Новый Структура;
		ИнформацияобАдресе.Вставить("Значение",ИнформацияОФактическомАдресе[0].Значение);		
		ИнформацияобАдресе.Вставить("Представление",ИнформацияОФактическомАдресе[0].Представление);		
	КонецЕсли;
	
	//Если фактический адрес у контрагента или организации пуст, подставляем юридический.
	Если Не ЗначениеЗаполнено(ИнформацияобАдресе) или Не ЗначениеЗаполнено(ИнформацияобАдресе.Представление) и 
		(ОтборАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента или ОтборАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации) Тогда
	
		ОтборЮрАдреса = Новый Структура;
		ВидАдреса = ?(ОтборАдреса.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента,Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ОтборЮрАдреса.Вставить("Вид",ВидАдреса);
		
		ИнформацияОЮрАдресе = ТаблицаАдресов.НайтиСтроки(ОтборЮрАдреса);
		Если ИнформацияОЮрАдресе.Количество() > 0 Тогда
			ИнформацияобАдресе = Новый Структура;
			ИнформацияобАдресе.Вставить("Значение",ИнформацияОЮрАдресе[0].Значение);		
			ИнформацияобАдресе.Вставить("Представление",ИнформацияОЮрАдресе[0].Представление);		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИнформацияобАдресе;
	
КонецФункции // ()

&НаСервереБезКонтекста
Функция ПолучитьВидАдресДоставкиПартнера()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыКонтактнойИнформации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.Наименование = ""Адрес доставки""
	|	И НЕ ВидыКонтактнойИнформации.ПометкаУдаления
	|	И ВидыКонтактнойИнформации.Родитель = &Родитель";
	
	Запрос.УстановитьПараметр("Родитель",Справочники.ВидыКонтактнойИнформации.СправочникПартнеры);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Возврат РезультатЗапроса.Выгрузить()[0].Ссылка;	
	КонецЕсли;

КонецФункции // ()

&НаКлиенте
Процедура ЗаполнитьНаселенныйПунктПоАдресу1С(Префикс) 
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	Адрес1С = ТекущиеДанные[Префикс + "АдресЗначение"];
	
	Если ЗначениеЗаполнено(Адрес1С) Тогда 
		
		СтруктураАдреса = ДЛ_ДеловыеЛинии.ДесериализоватьСтруктуруПараметров(Адрес1С); 
		
		ИмяГорода = "";
		
		Если ЗначениеЗаполнено(СтруктураАдреса["locality"]) Тогда 
			
			ИмяГорода = СтруктураАдреса["locality"]; 
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураАдреса["city"]) Тогда 
			
			ИмяГорода = СтруктураАдреса["city"];
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураАдреса["area"]) Тогда 
			
			ИмяГорода = СтруктураАдреса["area"];	
			
		КонецЕсли;		                                           
		
		Если ЗначениеЗаполнено(ИмяГорода) Тогда
			
			НаселенныйПункт = ПолучитьНаселенныйПункт(ИмяГорода);	
			
			Если ЗначениеЗаполнено(НаселенныйПункт) Тогда
				
				ТекущиеДанные[Префикс + "Город"] = НаселенныйПункт;			
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные[Префикс + "Город"]) Тогда
		
		ГородПриИзменении(Префикс);	
		
	КонецЕсли;
	
КонецПроцедуры   

&НаСервере
Функция ПолучитьНаселенныйПункт(ИмяГорода) 
	
	Возврат Справочники.ДЛ_Города.НайтиПоНаименованию(ИмяГорода, Истина);	
	
