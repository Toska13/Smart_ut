&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого КонтактноеЛицо Из Параметры.КонтактныеЛица Цикл
		
		НовоеКонтактноеЛицо = КонтактныеЛица.Добавить(); 
		НовоеКонтактноеЛицо.ФИО = КонтактноеЛицо;	
		
	КонецЦикла;
	
	КонтрагентСсылка = Параметры.КонтрагентСсылка;	
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)
	
	СтрокаКонтактныеЛица = ""; 
	
	Для Каждого КонтактноеЛицо Из КонтактныеЛица Цикл
		
		Если ЗначениеЗаполнено(КонтактноеЛицо.ФИО) Тогда			
			
			СтрокаКонтактныеЛица = ?(СтрокаКонтактныеЛица = "", КонтактноеЛицо.ФИО, СтрокаКонтактныеЛица + "; " + КонтактноеЛицо.ФИО);			
						
		КонецЕсли;
		
	КонецЦикла;
	
	ОповеститьОВыборе(СтрокаКонтактныеЛица);	
	
КонецПроцедуры   

&НаКлиенте
Процедура ТелефоныФИОНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда   
		
		ОО = Новый ОписаниеОповещения("ВыборКонтактноеЛицоЗавершение", ЭтаФорма);
		
		ТипКонтрагента = ТипЗнч(КонтрагентСсылка); 
		
		ПараметрыОткрытия = Новый Структура;			
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
		
		Если ТипКонтрагента = Тип("СправочникСсылка.Контрагенты") Тогда		 
			
			ПараметрыОтбора = Новый Структура("Владелец", ДЛ_ДеловыеЛинии.ПолучитьЗначениеРеквизита(КонтрагентСсылка, "Партнер"));
			
			ПараметрыОткрытия.Вставить("Отбор", ПараметрыОтбора);
			
			ОткрытьФорму("Справочник.КонтактныеЛицаПартнеров.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		ИначеЕсли ТипКонтрагента = Тип("СправочникСсылка.Организации") Тогда 				
			
			ОткрытьФорму("Справочник.Пользователи.ФормаВыбора", ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);		
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ВыборКонтактноеЛицоЗавершение(Результат, ИмяРеквизита) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
			
			Результат = Результат.Значение;	
			
		КонецЕсли;	
		
		Элементы.КонтактныеЛица.ТекущиеДанные.ФИО = СокрЛП(Результат);				 
		
	КонецЕсли;
	
КонецПроцедуры  




