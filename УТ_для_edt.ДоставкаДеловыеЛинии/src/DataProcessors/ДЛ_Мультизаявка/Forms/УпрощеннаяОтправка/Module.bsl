Процедура Завершить(Команда)
	
	ПараметрыЗакрытияФормы = Новый Структура();	
	
	ПараметрыЗакрытияФормы.Вставить("ПолучательКонтактноеЛицоНаименование", ФИО);
	ПараметрыЗакрытияФормы.Вставить("ПолучательКонтрагентНаименование", ФИО);
	ПараметрыЗакрытияФормы.Вставить("ПолучательКонтактноеЛицоТелефонПредставление", Телефон); 
	ПараметрыЗакрытияФормы.Вставить("УпрощеннаяОтправка", Истина);
	
	
	Закрыть(ПараметрыЗакрытияФормы);	
	
КонецПроцедуры