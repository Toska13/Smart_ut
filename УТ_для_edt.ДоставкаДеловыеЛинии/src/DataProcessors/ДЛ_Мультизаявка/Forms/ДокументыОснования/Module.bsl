
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)      
	
	Для Каждого ЭлементМассива Из Параметры.ДокументыОснования Цикл
		
		СтрДокументыОснования = ДокументыОснования.Добавить();
		СтрДокументыОснования.Документ = ЭлементМассива;
		
	КонецЦикла;
	
КонецПроцедуры  

&НаКлиенте
Процедура Завершить(Команда) 
	
	ПараметрыЗакрытияФормы = Новый Структура;	
	МассивДокументыОснования = Новый Массив; 
	ДокументОснования = "";	
	
	Для Каждого СтрТЗ Из ДокументыОснования Цикл
		
		Если ЗначениеЗаполнено(СтрТЗ.Документ) Тогда
		 			
			МассивДокументыОснования.Добавить(СтрТЗ.Документ);
			ДокументОснования = ДокументОснования + ?(ДокументОснования = "", "", "; ") + СокрЛП(СтрТЗ.Документ);
			
		КонецЕсли;	
		
	КонецЦикла; 
	
	ПараметрыЗакрытияФормы.Вставить("ДокументыОснования", МассивДокументыОснования);  
	ПараметрыЗакрытияФормы.Вставить("ДокументОснования", ДокументОснования);
	
	Закрыть(ПараметрыЗакрытияФормы);
	
КонецПроцедуры

