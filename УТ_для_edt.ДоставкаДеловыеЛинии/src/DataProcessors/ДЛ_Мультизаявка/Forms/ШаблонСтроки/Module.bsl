
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  
	
	ЗаполнитьДополнительныеТребования();  	
		
	СтруктураДанных = Параметры.СтруктураДанных;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураДанных); 	
	
	Если СтруктураДанных.МассивДополнительныеУслуги.Количество() > 0 Тогда 
		
		Для Каждого ЭлементМассива Из СтруктураДанных.МассивДополнительныеУслуги Цикл
			
			СтрДопУслуги = ДополнительныеУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(СтрДопУслуги, ЭлементМассива);
			
		КонецЦикла;
		
	Иначе	
		
		ЗаполнитьДополнительныеУслуги();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеУслуги()	
	
	НаименованияИсключаемыхУслуг = Новый Массив;
	НаименованияИсключаемыхУслуг.Добавить("заезд на второй адрес");  
	НаименованияИсключаемыхУслуг.Добавить("страхование груза и срока"); 
	НаименованияИсключаемыхУслуг.Добавить("страхование груза");
	НаименованияИсключаемыхУслуг.Добавить("доставка груза до дверей получателя");  
	НаименованияИсключаемыхУслуг.Добавить("погрузка у отправителя"); 
	НаименованияИсключаемыхУслуг.Добавить("разгрузка у получателя");	
	НаименованияИсключаемыхУслуг.Добавить("отправка сопроводительных документов");
	НаименованияИсключаемыхУслуг.Добавить("возврат сопроводительных документов");	
	НаименованияИсключаемыхУслуг.Добавить("забор груза от дверей отправителя");	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаименованияИсключаемыхУслуг", НаименованияИсключаемыхУслуг);
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_ДополнительныеУслуги.Ссылка КАК Услуга,
	|	ЛОЖЬ КАК Использовать,
	|	1 КАК Количество,
	|	(ВЫРАЗИТЬ(ВРЕГ(ЛЕВ(ДЛ_ДополнительныеУслуги.Наименование, 1)) КАК СТРОКА(1))) + (ВЫРАЗИТЬ(НРЕГ(ПРАВ(ДЛ_ДополнительныеУслуги.Наименование, ДЛИНАСТРОКИ(ДЛ_ДополнительныеУслуги.Наименование) - 1)) КАК СТРОКА(254))) КАК Наименование
	|ИЗ
	|	Справочник.ДЛ_ДополнительныеУслуги КАК ДЛ_ДополнительныеУслуги
	|ГДЕ
	|	НЕ ДЛ_ДополнительныеУслуги.Наименование В (&НаименованияИсключаемыхУслуг)"; 				   
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДополнительныеУслуги.Загрузить(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда) 
	
	РезультатСтруктура = Новый Структура;	
	
	РезультатСтруктура.Вставить("ПлательщикЗаЗабор", ПлательщикЗаЗабор);
	РезультатСтруктура.Вставить("ПлательщикЗаПеревозку", ПлательщикЗаПеревозку);
	РезультатСтруктура.Вставить("ПлательщикКонтактноеЛицоНаименование", ПлательщикКонтактноеЛицоНаименование); 
	РезультатСтруктура.Вставить("ПлательщикКонтактноеЛицоТелефонПредставление", ПлательщикКонтактноеЛицоТелефонПредставление);
	РезультатСтруктура.Вставить("ПлательщикКонтрагентИНН", ПлательщикКонтрагентИНН);
	РезультатСтруктура.Вставить("ПлательщикКонтрагентНаименование", ПлательщикКонтрагентНаименование);
	РезультатСтруктура.Вставить("ПлательщикКонтрагентСсылка", ПлательщикКонтрагентСсылка);
	РезультатСтруктура.Вставить("ПлательщикКонтрагентЭтоОрганизация", ПлательщикКонтрагентЭтоОрганизация);
	РезультатСтруктура.Вставить("ПлательщикКонтрагентЮрФизЛицо", ПлательщикКонтрагентЮрФизЛицо);
	
	РезультатСтруктура.Вставить("ДоставкаДополнительныеТребованияТС", ДоставкаДополнительныеТребованияТС);
	РезультатСтруктура.Вставить("ДоставкаПогрузочноРазгрузочныеРаботы", ДоставкаПогрузочноРазгрузочныеРаботы);
	РезультатСтруктура.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа", ДоставкаПогрузочноРазгрузочныеРаботыДоЭтажа);
	РезультатСтруктура.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыЛифт", ДоставкаПогрузочноРазгрузочныеРаботыЛифт);
	РезультатСтруктура.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса", ДоставкаПогрузочноРазгрузочныеРаботыРасстояниеПроноса);
	РезультатСтруктура.Вставить("ДоставкаПогрузочноРазгрузочныеРаботыПлательщик", ДоставкаПогрузочноРазгрузочныеРаботыПлательщик);	
	РезультатСтруктура.Вставить("СопроводительныеДокументы", СопроводительныеДокументы);
	РезультатСтруктура.Вставить("СопроводительныеДокументыПлательщик", СопроводительныеДокументыПлательщик); 
	РезультатСтруктура.Вставить("ДополнительныеУслугиПлательщик", ДополнительныеУслугиПлательщик); 
	
	РезультатСтруктура.Вставить("СпособДоставки", СпособДоставки);
	РезультатСтруктура.Вставить("ВидДоставки", ВидДоставки);
	
	РезультатСтруктура.Вставить("ГрузМаксимальнаяВысота", ГрузМаксимальнаяВысота);
	РезультатСтруктура.Вставить("ГрузМаксимальнаяДлина", ГрузМаксимальнаяДлина);
	РезультатСтруктура.Вставить("ГрузМаксимальнаяШирина", ГрузМаксимальнаяШирина);
	РезультатСтруктура.Вставить("ГрузМаксимальныйВес", ГрузМаксимальныйВес);
	РезультатСтруктура.Вставить("ГрузОбъем", ГрузОбъем);
	РезультатСтруктура.Вставить("ГрузВес", ГрузВес);
	РезультатСтруктура.Вставить("ГрузКоличествоГрузовыхМест", ГрузКоличествоГрузовыхМест);	
	РезультатСтруктура.Вставить("ХарактерГруза", ХарактерГруза); 
	
	Плательщик = "";
	
	Если СпособОтгрузки = 0 И ЗначениеЗаполнено(ПлательщикЗаЗабор) Тогда
		
		Плательщик = Плательщик + " Забор: " + ПолучитьПредставлениеПлательщика(ПлательщикЗаЗабор);	
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ПлательщикЗаПеревозку) Тогда
		
		Плательщик = Плательщик + " Перевозка: " + ПолучитьПредставлениеПлательщика(ПлательщикЗаПеревозку);	
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПлательщикКонтрагентНаименование) Тогда
		
		Плательщик = Плательщик + " Третье лицо: " + ПлательщикКонтрагентНаименование;	
		
	КонецЕсли;
	
	РезультатСтруктура.Вставить("Плательщик", Плательщик); 
	
	ЕстьДанные = Ложь;   
	
	Если ЗначениеЗаполнено(ДоставкаДополнительныеТребованияТС) Тогда
		
		ЕстьДанные = Истина;	
		
	КонецЕсли; 
	
	Если ДоставкаПогрузочноРазгрузочныеРаботы Тогда
		
		ЕстьДанные = Истина;				
		
	КонецЕсли;	
		
	Если Не ОпределитьВозможностьИзменятьПлательщикаЗаДопУслуги() Тогда  
		
		ЕстьДанные = Истина;		
		
	КонецЕсли;
	
	РезультатСтруктура.Вставить("ДопУслугиПредставление", ?(ЕстьДанные, "Присутствуют", ""));
	
	МассивДополнительныеУслуги = Новый Массив;
	
	Для Каждого СтрТЗ Из ДополнительныеУслуги Цикл
		
		ЭлементМассива = Новый Структура("Услуга, Использовать, Количество, Наименование");
		ЗаполнитьЗначенияСвойств(ЭлементМассива, СтрТЗ); 			
		МассивДополнительныеУслуги.Добавить(ЭлементМассива);	
		
	КонецЦикла;
	
	РезультатСтруктура.Вставить("МассивДополнительныеУслуги", МассивДополнительныеУслуги); 
	
	Закрыть(Новый Структура("Значение", РезультатСтруктура));
	
КонецПроцедуры

&НаКлиенте
Процедура СопроводительныеДокументыПриИзменении(Элемент)	 
	
	Элементы.СопроводительныеДокументыПлательщик.ТолькоПросмотр = Не ЗначениеЗаполнено(СопроводительныеДокументы);
	
КонецПроцедуры 

&НаКлиенте
Процедура СопроводительныеДокументыОчистка(Элемент, СтандартнаяОбработка)	
	
	Элементы.СопроводительныеДокументыПлательщик.ТолькоПросмотр = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура ДополнительныеУслугиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеУслугиИспользоватьПриИзменении(Элемент) 	
	
	Элементы.ДополнительныеУслугиПлательщик.ТолькоПросмотр = ОпределитьВозможностьИзменятьПлательщикаЗаДопУслуги();
	
КонецПроцедуры

&НаСервере
Функция ОпределитьВозможностьИзменятьПлательщикаЗаДопУслуги() 
	
	Если ДополнительныеУслуги.Количество() = 0 Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	ПромТЗ = ДополнительныеУслуги.Выгрузить(, "Использовать");
	ПромТЗ.Сортировать("Использовать УБЫВ");
	
	Возврат Не ПромТЗ[0].Использовать;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДополнительныеТребования()	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ДЛ_СпециальныеТребования.Наименование КАК Наименование,
	|	ДЛ_СпециальныеТребования.UID КАК UID
	|ИЗ
	|	Справочник.ДЛ_СпециальныеТребования КАК ДЛ_СпециальныеТребования
	|ГДЕ
	|	ДЛ_СпециальныеТребования.Наименование <> ""Растентовка""
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДЛ_ВидыЗагрузки.Наименование,
	|	ДЛ_ВидыЗагрузки.UID
	|ИЗ
	|	Справочник.ДЛ_ВидыЗагрузки КАК ДЛ_ВидыЗагрузки";  
	
	Результат = Запрос.Выполнить().Выгрузить();              	
	
	ЗаполнитьСписокВыбораДополнительныеТребования("Доставка", Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораДополнительныеТребования(Префикс, ТЗ_Требования) 
	
	Элементы[Префикс + "ДополнительныеТребованияТС"].СписокВыбора.Добавить("", "Отсутствуют");
	
	Для Каждого СтрТЗ Из ТЗ_Требования Цикл
		
		Элементы[Префикс + "ДополнительныеТребованияТС"].СписокВыбора.Добавить(СтрТЗ.UID, СтрТЗ.Наименование);	
		
	КонецЦикла;
	
КонецПроцедуры 


&НаКлиенте
Процедура ДоставкаПогрузочноРазгрузочныеРаботыПриИзменении(Элемент)
	
	Элементы.ГруппаДоставкаПогрузочноРазгрузочныеРаботы.Видимость = ДоставкаПогрузочноРазгрузочныеРаботы;		
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	
	ДоставкаПогрузочноРазгрузочныеРаботыПриИзменении(Неопределено); 
	СопроводительныеДокументыПриИзменении(Неопределено); 
	ДополнительныеУслугиИспользоватьПриИзменении(Неопределено); 
	ВидимостьТретьеЛицо();
	Элементы.ГруппаЗабор.Видимость = (СпособОтгрузки = 0);
	
КонецПроцедуры


&НаКлиенте
Функция ПолучитьПредставлениеПлательщика(Плательщик) 
	
	Результат = "";
	
	Если Плательщик = "sender" Тогда 
		
		Результат = "Отправитель";
		
	ИначеЕсли Плательщик = "receiver" Тогда 
		
		Результат = "Получатель";
		
	ИначеЕсли Плательщик = "third" Тогда 
		
		Результат = "Третье лицо";	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

