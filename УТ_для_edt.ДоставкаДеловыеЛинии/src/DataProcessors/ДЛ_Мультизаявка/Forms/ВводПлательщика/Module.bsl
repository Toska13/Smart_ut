
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПлательщикЗаЗабор = Параметры.ПлательщикЗаЗабор;
	ПлательщикЗаПеревозку = Параметры.ПлательщикЗаПеревозку;  
	ПлательщикКонтактноеЛицоНаименование = Параметры.ПлательщикКонтактноеЛицоНаименование;
	ПлательщикКонтактноеЛицоТелефонПредставление = Параметры.ПлательщикКонтактноеЛицоТелефонПредставление;
	ПлательщикКонтрагентИНН = Параметры.ПлательщикКонтрагентИНН;
	ПлательщикКонтрагентНаименование = Параметры.ПлательщикКонтрагентНаименование;
	ПлательщикКонтрагентСсылка = Параметры.ПлательщикКонтрагентСсылка;
	ПлательщикКонтрагентЭтоОрганизация = Параметры.ПлательщикКонтрагентЭтоОрганизация;
	ПлательщикКонтрагентЮрФизЛицо = Параметры.ПлательщикКонтрагентЮрФизЛицо; 
	СпособОтгрузки = Параметры.СпособОтгрузки;
	
КонецПроцедуры 

&НаКлиенте
Процедура Завершить(Команда)
	
	ПараметрыЗакрытияФормы = Новый Структура();	
	ПараметрыЗакрытияФормы.Вставить("ПлательщикЗаЗабор", ПлательщикЗаЗабор);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикЗаПеревозку", ПлательщикЗаПеревозку);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтактноеЛицоНаименование", ПлательщикКонтактноеЛицоНаименование); 
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтактноеЛицоТелефонПредставление", ПлательщикКонтактноеЛицоТелефонПредставление);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтрагентИНН", ПлательщикКонтрагентИНН);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтрагентНаименование", ПлательщикКонтрагентНаименование);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтрагентСсылка", ПлательщикКонтрагентСсылка);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтрагентЭтоОрганизация", ПлательщикКонтрагентЭтоОрганизация);
	ПараметрыЗакрытияФормы.Вставить("ПлательщикКонтрагентЮрФизЛицо", ПлательщикКонтрагентЮрФизЛицо);
	
	Плательщик = "";
	
	Если СпособОтгрузки = 0 И ЗначениеЗаполнено(ПлательщикЗаЗабор) Тогда
		
		Плательщик = Плательщик + " Забор: " + ПолучитьПредставлениеПлательщика(ПлательщикЗаЗабор);	
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ПлательщикЗаПеревозку) Тогда
		
		Плательщик = Плательщик + " Перевозка: " + ПолучитьПредставлениеПлательщика(ПлательщикЗаПеревозку);	
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПлательщикКонтрагентНаименование) Тогда
		
		Плательщик = Плательщик + " Третье лицо: " + ПлательщикКонтрагентНаименование;	
		
	КонецЕсли; 
	
	ПараметрыЗакрытияФормы.Вставить("Плательщик", Плательщик);
	
	Закрыть(ПараметрыЗакрытияФормы);	
	
КонецПроцедуры   

&НаКлиенте
Функция ПолучитьПредставлениеПлательщика(Плательщик) 
	
	Результат = "";
	
	Если Плательщик = "sender" Тогда 
		
		Результат = "Отправитель";
		
	ИначеЕсли Плательщик = "receiver" Тогда 
		
		Результат = "Получатель";
		
	ИначеЕсли Плательщик = "third" Тогда 
		
		Результат = "Третье лицо";	
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

 &НаКлиенте
Процедура ПлательщикКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	НачалоВыбораУчастникаГрузоперевозки("ПлательщикКонтрагентСсылка");	
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикКонтрагентОчистка(Элемент, СтандартнаяОбработка)
	
	ПлательщикКонтрагентИНН = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикКонтрагентОткрытие(Элемент, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	КонтрагентОткрытие(Элемент);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПлательщикКонтактноеЛицоТелефонНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВвестиДанныеТелефоновУчастникаПеревозки("Плательщик");
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикКонтактноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВвестиДанныеКонтактныхЛиц("Плательщик");
	
КонецПроцедуры 

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозки(УчастникГрузоперевозки)  
	
	КнопкиВопроса = Новый СписокЗначений;
	КнопкиВопроса.Добавить("Справочник Организации");
	КнопкиВопроса.Добавить("Справочник Контрагенты");  				
			
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("НачалоВыбораУчастникаГрузоперевозкиПродолжить", ЭтаФорма, УчастникГрузоперевозки), КнопкиВопроса);		
	
КонецПроцедуры 

&НаКлиенте
Процедура КонтрагентОткрытие(Элемент)
	
	ИмяРеквизита = Элемент.Имя + "Ссылка";
	ИмяРеквизитаЭтоОрганизация = Элемент.Имя + "ЭтоОрганизация";
	
	ЗначениеРеквизита = ЭтотОбъект[ИмяРеквизита];
	ЭтоОрганизация = ЭтотОбъект[ИмяРеквизитаЭтоОрганизация];
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда  
		
		ПараметрыОткрытия = Новый Структура("Ключ", ЭтотОбъект[ИмяРеквизита]);
		ОО = Новый ОписаниеОповещения("ОбработатьИзменениеУчастника", ЭтотОбъект, ИмяРеквизита);		
		
		Если ЭтоОрганизация Тогда
			
			ИмяФормыКонтрагента = "Справочник.Организации.ФормаОбъекта"; 
			
		Иначе                                                      
			
			ИмяФормыКонтрагента = "Справочник.Контрагенты.ФормаОбъекта";
			
		КонецЕсли; 	
		
		ОткрытьФорму(ИмяФормыКонтрагента, ПараметрыОткрытия, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ВвестиДанныеТелефоновУчастникаПеревозки(Префикс)  
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	Телефоны = ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"]; 
	
	ТекущиеТелефоны = Новый Массив;
	
	Если ЗначениеЗаполнено(Телефоны) Тогда	
		
		МассивТелефонов = СтрРазделить(Телефоны, ";");	
		
		Для Каждого НомерТелефона Из МассивТелефонов Цикл		
			
			НомерТелефонаСДобавочным = СтрРазделить(СтрЗаменить(СтрЗаменить(НомерТелефона, Символы.ПС, ""), ", доб. ", Символы.ПС), Символы.ПС, Ложь);			
			
			Если ЗначениеЗаполнено(НомерТелефонаСДобавочным[0]) Тогда
				
				СтруктураТелефона = Новый Структура;
				СтруктураТелефона.Вставить("Основной", СокрЛП(НомерТелефонаСДобавочным[0]));				
				
				Если НомерТелефонаСДобавочным.Количество() = 2  Тогда
					
					СтруктураТелефона.Вставить("Добавочный", СокрЛП(НомерТелефонаСДобавочным[1]));	
					
				КонецЕсли; 
				
				ТекущиеТелефоны.Добавить(СтруктураТелефона);		
				
			КонецЕсли;
			
		КонецЦикла;  
		
	КонецЕсли;
	
	ОО = Новый ОписаниеОповещения("ВвестиДанныеТелефоновУчастникаПеревозкиЗвершение", ЭтаФорма, Префикс); 
	ПараметрыФормы = Новый Структура("Телефоны", ТекущиеТелефоны);	
	
	ОткрытьФорму("Документ.ДЛ_ЗаявкаНаДоставку.Форма.ФормаВводаТелефонов", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура ВвестиДанныеТелефоновУчастникаПеревозкиЗвершение(Результат, Префикс) Экспорт 
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[Префикс + "КонтактноеЛицоТелефонПредставление"] = Результат;	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ВвестиДанныеКонтактныхЛиц(Префикс)  
	
	ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
	
	КонтактныеЛица = ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"]; 
	
	ТекущиеКонтактныеЛица = Новый Массив;
	
	Если ЗначениеЗаполнено(КонтактныеЛица) Тогда	
		
		МассивКонтактныеЛица = СтрРазделить(КонтактныеЛица, ";");	
		
		Для Каждого КонтактноеЛицо Из МассивКонтактныеЛица Цикл			 
				
			ТекущиеКонтактныеЛица.Добавить(КонтактноеЛицо);				
			
		КонецЦикла;  
		
	КонецЕсли;
	
	ОО = Новый ОписаниеОповещения("ВвестиДанныеКонтактныеЛицаЗвершение", ЭтаФорма, Префикс); 
	ПараметрыФормы = Новый Структура("КонтактныеЛица, КонтрагентСсылка", ТекущиеКонтактныеЛица, ТекущиеДанные[Префикс + "КонтрагентСсылка"]);
	
	ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.ВводКонтактныхЛиц", ПараметрыФормы, ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры  

&НаКлиенте
Процедура ВвестиДанныеКонтактныеЛицаЗвершение(Результат, Префикс) Экспорт 
	
	Если Результат <> Неопределено Тогда 
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[Префикс + "КонтактноеЛицоНаименование"] = Результат;	
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура НачалоВыбораУчастникаГрузоперевозкиПродолжить(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		
		ИмяРеквизита = СтрЗаменить(ДополнительныеПараметры, "Ссылка", ""); 
		ИмяРеквизитаИНН = ИмяРеквизита + "ИНН";
		Префикс = СтрЗаменить(ИмяРеквизита, "Контрагент", "");
		
		ТекущиеДанные = ?(Префикс = "Получатель", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);		
		
		Если Результат.Значение = "Ввести данные юр. лица" Или Результат.Значение = "Ввести данные физ. лица" Тогда 			
			
			ТекущиеДанные[Префикс + "КонтрагентИностранец"] = Ложь;			 
			ТекущиеДанные[Префикс + "РучнойВвод"] = ?(Результат.Значение = "Ввести данные юр. лица", 1, 2);
			ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"] = ТекущиеДанные[Префикс + "РучнойВвод"]; 			
			
			Если Не ЗначениеЗаполнено(ТекущиеДанные[Префикс + "КонтрагентСтрана"]) Тогда
				
				ТекущиеДанные[Префикс + "КонтрагентСтрана"] = ПолучитьСтрануПоУмолчанию();
				
			КонецЕсли;
			
			Если ТекущиеДанные[Префикс + "РучнойВвод"] = 2 Тогда
				
				Если Не ЗначениеЗаполнено(ТекущиеДанные[Префикс + "КонтрагентОПФ"]) Тогда
					
					ТекущиеДанные[Префикс + "КонтрагентОПФ"] = ПолучитьОПФПоУмолчанию();
					
				КонецЕсли;			
				
			КонецЕсли; 	
			
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("КонтрагентЮрФизЛицо", ТекущиеДанные[Префикс + "КонтрагентЮрФизЛицо"]);
			СтруктураПараметров.Вставить("КонтрагентСтрана", ТекущиеДанные[Префикс + "КонтрагентСтрана"]);
			СтруктураПараметров.Вставить("КонтрагентОПФ", ТекущиеДанные[Префикс + "КонтрагентОПФ"]);  			
			
			ОткрытьФорму("Обработка.ДЛ_Мультизаявка.Форма.РучнойВводКонтрагента", СтруктураПараметров, ЭтаФорма,,,, Новый ОписаниеОповещения("ОкончаниеРучногоВыбораУчастникаГрузоперевозки", ЭтаФорма, Префикс), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		Иначе 			
					
			Если Префикс <> "Плательщик" Тогда
				
				ТекущиеДанные[Префикс + "РучнойВвод"] = 0; 				
				
			КонецЕсли;
			
			ПараметрыОткрытия = Новый Структура;			
			ПараметрыОткрытия.Вставить("РежимВыбора", Истина); 
			
			ОО = Новый ОписаниеОповещения("ОбработатьВыборЗначенияКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
			
			Если Результат.Значение = "Справочник Организации" Тогда 
				
				ИмяФормыВыбора = "Справочник.Организации.ФормаВыбора";				
				
			ИначеЕсли Результат.Значение = "Справочник Контрагенты" Тогда
				
				ИмяФормыВыбора = "Справочник.Контрагенты.ФормаВыбора";
				
			Иначе
				
				Возврат;
				
			КонецЕсли; 
			
			ОткрытьФорму(ИмяФормыВыбора, ПараметрыОткрытия,	ЭтаФорма,,,, ОО, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьСтрануПоУмолчанию()	
	
	Возврат Справочники.ДЛ_Страны.НайтиПоРеквизиту("UID", "0x8f51001438c4d49511dbd774581edb7a");	
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьОПФПоУмолчанию()	
	
	Возврат Справочники.ДЛ_ОПФ.НайтиПоРеквизиту("UID", "0xAB91FEEA04F6D4AD48DF42161B6C2E7A");	
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборЗначенияКонтрагента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Или
		(ТипЗнч(Результат) = Тип("КодВозвратаДиалога")
		И Результат = КодВозвратаДиалога.Отмена) Тогда
		
		Возврат;
		
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(ДополнительныеПараметры) Тогда
		
		ТекущиеДанные = ?(ДополнительныеПараметры = "ПолучательКонтрагентСсылка", Элементы.ТаблицаЗаказы.ТекущиеДанные, ЭтаФорма);
		
		ТекущиеДанные[ДополнительныеПараметры] = Результат;
		
		ОбработатьИзменениеРеквизитаФормыКонтрагента(ДополнительныеПараметры);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеРеквизитаФормыКонтрагента(ИмяРеквизита)
	
	ОчиститьСообщения();
	Отказ = Ложь;
	ОбработатьИзменениеРеквизитаФормыКонтрагентаНаСервере(ИмяРеквизита, Отказ);
	
	Если Отказ Тогда
		
		Возврат; 
		
	КонецЕсли;		
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьИзменениеРеквизитаФормыКонтрагентаНаСервере(ИмяРеквизита, Отказ = Ложь)	
	
	ПараметрыУчастника = ПараметрыУчастникаГрузоперевозки(ЭтаФорма[ИмяРеквизита]);		
	
	ОбработатьПараметры(ПараметрыУчастника, СтрЗаменить(ИмяРеквизита, "КонтрагентСсылка", ""));			
	
КонецПроцедуры  

&НаСервере
Функция ПараметрыУчастникаГрузоперевозки(Значение)
	
	ПараметрыУчастника = Новый Структура;
	ПараметрыУчастника.Вставить("Контрагент", ПараметрыКонтрагента());		
	ПараметрыУчастника.Контрагент.Ссылка = Значение;
	
	Если ЗначениеЗаполнено(Значение) Тогда 
		
		ЗаполнитьПараметрыКонтрагента(ПараметрыУчастника.Контрагент);		
		
	КонецЕсли;	
	
		
	Возврат ПараметрыУчастника;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыКонтрагента() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Неопределено);
	Результат.Вставить("Наименование", "");
	Результат.Вставить("ЮрФизЛицо", 0);
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("ЮридическийАдресПредставление", "");
	Результат.Вставить("ЭтоОрганизация", Ложь);
	Результат.Вставить("Иностранец", Ложь); 
	Результат.Вставить("Страна", Неопределено);
	Результат.Вставить("ОПФ", Неопределено);
	Результат.Вставить("НомерИностранногоПаспорта", "");
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПараметрыКонтрагента(ПараметрыКонтрагента) Экспорт
	
	ИмяСправочника = Неопределено;
	Если ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Организации") Тогда
		ИмяСправочника = "Организации";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеСокращенное";
		ПараметрыКонтрагента.ЭтоОрганизация = Истина;
	ИначеЕсли ТипЗнч(ПараметрыКонтрагента.Ссылка) = Тип("СправочникСсылка.Контрагенты") Тогда
		ИмяСправочника = "Контрагенты";
		РеквизитНаименования = "ОсновнаяТаблица.НаименованиеПолное";
		ПараметрыКонтрагента.ЭтоОрганизация = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ОсновнаяТаблица.Ссылка КАК Ссылка,
	|	ОсновнаяТаблица.ИНН КАК ИНН,
	|	ОсновнаяТаблица.КПП КАК КПП,
	|	&РеквизитНаименования КАК Наименование,
	|	ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент) КАК Иностранец,
	|	ВЫБОР
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА 1
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|			ТОГДА 2
	|		КОГДА ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ИндивидуальныйПредприниматель)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЮрФизЛицо
	|ИЗ
	|	&ТаблицаДляЗапроса КАК ОсновнаяТаблица
	|ГДЕ
	|	ОсновнаяТаблица.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПараметрыКонтрагента.Ссылка);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТаблицаДляЗапроса", "Справочник." + ИмяСправочника);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&РеквизитНаименования", РеквизитНаименования);  
	
	Если ИмяСправочника = "Организации" Тогда
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ОсновнаяТаблица.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицоНеРезидент)", "Ложь");	
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда  
		
		ЗаполнитьЗначенияСвойств(ПараметрыКонтрагента, РезультатЗапроса.Выгрузить()[0]);		
		
		Если ПараметрыКонтрагента.ЮрФизЛицо <> 2 Тогда 
			
			ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента);                          
			
			ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 			
			
			Если Не ЗначениеЗаполнено(ПараметрыКонтрагента.ЮридическийАдресПредставление) Тогда
				
				ВидКИ = ?(ИмяСправочника = "Организации", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
				
				ПараметрыКонтрагента.ЮридическийАдресПредставление = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыКонтрагента.Ссылка, ВидКИ, ТекущаяДата(), Истина); 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПараметры(Параметры, Префикс = "")
	
	ПараметрыДляФормы = Новый Структура;
	
	ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, ПараметрыДляФормы, Префикс);	
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыДляФормы);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметры, Данные, Префикс = "") Экспорт
	
	Для Каждого Параметр Из Параметры Цикл  
		
		ИмяКолонки = Префикс + Параметр.Ключ;   
		
		Если ТипЗнч(Параметр.Значение) = Тип("Структура") Тогда
			
			ЗаполнитьЛинейныеДанныеПоСтруктуре(Параметр.Значение, Данные, ИмяКолонки); 
			
		Иначе 
			
			Данные.Вставить(ИмяКолонки, Параметры[Параметр.Ключ]);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаборГрузаПриИзменении(Элемент)
	
	ВидимостьТретьеЛицо();
	
КонецПроцедуры

&НаКлиенте
Процедура МежтерминальнаяПеревозкаПриИзменении(Элемент)
	
	ВидимостьТретьеЛицо();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьТретьеЛицо()
	
	Элементы.грПлательщик.Видимость = (ПлательщикЗаПеревозку = "third" Или (СпособОтгрузки = 0 И ПлательщикЗаЗабор = "third"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидимостьТретьеЛицо();
	Элементы.ГруппаЗабор.Видимость = (СпособОтгрузки = 0);
	
КонецПроцедуры










 



