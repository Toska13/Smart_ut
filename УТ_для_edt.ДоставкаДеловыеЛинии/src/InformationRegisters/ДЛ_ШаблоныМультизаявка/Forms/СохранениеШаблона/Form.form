        </value>
      </choiceList>
      <choiceList>
        <presentation>
          <key>ru</key>
          <value>Заполнять в заказе только те поля, которые заполнены в шаблоне.</value>
        </presentation>
        <value xsi:type="core:NumberValue">
          <value>2</value>
