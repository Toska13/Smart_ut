# Служебные файлы проекта (инструменты 1c-rules, MCP, IDE, OpenSpec)

# Параметры проекта / секреты (не коммитить)
.dev.env

# Инструменты AI-агентов (правила, агенты, команды, скиллы, конфиги)
.ai-rules.json
.cursor/
**/*.md

# MCP-серверы проекта: базы данных, логи, конфигурация Docker-стека
.mcp/

# Отчёты «ОтчетПоКонфигурации…» — генерируются MCP-индексацией
Report.mcp/

# OpenSpec workspace (изменения/спеки) — по решению команды не в git
openspec/

# Служебные скрипты (LM Studio и пр.)
scripts/

# =============================================================================
# Исходники конфигурации 1С (УТ_для_edt*, *.Расширение*, *.Доставка*)
# src/ — исходники (трекаются). Исключаем только служебные файлы 1С:EDT / Конфигуратора.
# =============================================================================

# 1С:EDT workspace metadata (Eclipse-based) — .project, .settings/, DT-INF/
**/.project
**/.settings/
**/DT-INF/

# Служебные файлы 1С:EDT / Конфигуратора
**/.classpath
**/.factorypath
**/.tern-project
**/*.bak
**/*.log
**/*.bin
**/*.distr
**/*.cf
**/*.cfe
**/*.epf
**/*.erf
